<?php
/** @var \Symfony\CS\Config\Config $config */
$config = require_once __DIR__ . "/.php_cs";
if (!defined('PHP_CS_SRC_DIR')) {
    define('PHP_CS_SRC_DIR', realpath(__DIR__ . '/../app'));
}
define('GIT_BASE_DIR', realpath(__DIR__.'/..'));
// change the $config to be a Finder instance that only selects staged git PHP files
$outputs = array();
$return = 0;
$exit_status = 0;
exec('git rev-parse --verify HEAD 2> /dev/null', $outputs, $return);
$against = $return == 0 ? 'HEAD' : '4b825dc642cb6eb9a060e54bf8d69288fbee4904'; // 4b825dc642cb6eb9a060e54bf8d69288fbee4904 = special "emtpy tree" sha1
exec("git diff-index --cached --name-only {$against}", $outputs);
$filename_pattern = '/\.php$/';
$changed_files = array_filter($outputs, function($filename) use ($filename_pattern) {
    return preg_match($filename_pattern, $filename) && file_exists($filename);
});
$changed_files = array_map(function($changed_file) {
    return realpath(GIT_BASE_DIR.'/'.$changed_file);
}, $changed_files);
$finder = Symfony\CS\Finder\DefaultFinder::create()
    ->files()
    ->in(PHP_CS_SRC_DIR)
    ->filter(function(\SplFileInfo $file_info) use ($changed_files) {
        return in_array($file_info->getRealPath(), $changed_files);
    })
;
$config->finder($finder);
return $config;
