#!/bin/bash
DIR_ROOT="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )/../.."
rm -rf $DIR_ROOT/var/logs/*.log

cd $DIR_ROOT/var/logs

touch agent-dev.log
touch agent-prod.log
touch agent-test.log
touch portal-dev.log
touch portal-prod.log
touch portal-test.log
touch api-dev.log
touch api-prod.log
touch api-test.log
touch install-dev.log
touch install-prod.log
touch install-test.log
touch error.log

tail -f *.log
