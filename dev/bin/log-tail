#!/bin/bash
# this only works if your cache dir is the default app/sys/cache
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd $SCRIPT_DIR
cd ..
cd ..

touch data/logs/agent-dev.log
touch data/logs/agent-prod.log
touch data/logs/agent-test.log
touch data/logs/portal-dev.log
touch data/logs/portal-prod.log
touch data/logs/portal-test.log
touch data/logs/api-dev.log
touch data/logs/api-prod.log
touch data/logs/api-test.log
touch data/logs/install-dev.log
touch data/logs/install-prod.log
touch data/logs/install-test.log
tail -f data/logs/*.log
