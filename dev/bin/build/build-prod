#!/usr/bin/env php
<?php

$DP_DIR = realpath(__DIR__.'/../../../');
chdir($DP_DIR);

function dp_build_runcmd($cmd) {
    $ret = null;

    echo "\$ $cmd\n";
    passthru($cmd, $ret);

    if ($ret) {
        echo "Command failed with status {$ret}\n";
        exit(1);
    }
}

$options = getopt('', [
    'quick',
    'with-build:',
    'with-build-time:',
]);

$is_quick = (bool) @$options['quick'];

########################################################################################################################
# Init project
########################################################################################################################

echo "Running init-project\n";
dp_build_runcmd('dev/bin/init-project');

########################################################################################################################
# Hacks
########################################################################################################################

$f = $DP_DIR.'/app/BUILD/vendor/zendframework/zend-ldap/src/Node.php';
file_put_contents($f, preg_replace(
    '/'.preg_quote('if (!Dn::isChildOf($this->_getDn(), $ldap->getBaseDn())) {').'.*?\}\s*/s',
    "/* DESKPRO EDIT: Removed isChildOf check */\n\n        ",
    file_get_contents($f)
));

########################################################################################################################
# Cache warmup
########################################################################################################################

echo "Cache warmup: dev\n";
dp_build_runcmd('bin/console cache:warmup --kernel dev --env prod --verbose --barg is-building');

echo "Cache warmup: dp\n";
dp_build_runcmd('bin/console cache:warmup --kernel dp --env prod --verbose --barg is-building');

echo "Cache warmup: portal\n";
// TODO: we need to fix this
//dp_build_runcmd('bin/console cache:warmup --kernel portal --env prod --verbose --barg is-building');

echo "Cache warmup: install\n";
dp_build_runcmd('bin/console cache:warmup --kernel install --env prod --verbose --barg is-building');

echo "Cache warmup: api\n";
dp_build_runcmd('bin/console cache:warmup --kernel api --env prod --verbose --barg is-building');

########################################################################################################################
# Legacy Assets
########################################################################################################################

echo "Legacy assets\n";
dp_build_runcmd('bin/console dp:assetic -r ALL --kernel dp --env prod --verbose');

####################################################################################################################php####
# Schema file
########################################################################################################################

echo "Generating schema file\n";
dp_build_runcmd('bin/console dpdev:gen:schema-file --env prod --barg is-building');

########################################################################################################################
# Template map
########################################################################################################################

if (!$is_quick) {
    echo "Generating template map\n";
    dp_build_runcmd('bin/console dpdev:gen:template-map --env prod');
}

########################################################################################################################
# Build time/versions
########################################################################################################################

echo "Placing versions\n";

$build_num = @$options['with-build'] ?: null;
$build_time = @$options['with-build-time'] ?: time();

file_put_contents($DP_DIR.'/app/BUILD/sys/config/build-time.php', "<?php define('DP_BUILD_TIME', {$build_time});\n");
file_put_contents($DP_DIR.'/app/BUILD/sys/config/build-time.txt', $build_time);

if ($build_num && $build_num !== '0.0') {
    if (strpos($build_num, '.')) {
        list ($build_num_base, $build_rev) = explode('.', $build_num, 2);
    } else {
        $build_num_base = $build_num;
        $build_rev = 0;
    }
    file_put_contents($DP_DIR.'/app/BUILD/sys/config/build-num.php',
        "<?php define('DP_BUILD_NUM', '$build_num');\n"
        ."define('DP_BUILD_NUM_BASE', $build_num_base);\n"
        ."define('DP_BUILD_NUM_REV', $build_rev);\n"
    );

    file_put_contents($DP_DIR.'/app/BUILD/sys/config/build-num.txt', $build_num);
}

########################################################################################################################
# Encode files
########################################################################################################################

dp_build_runcmd('dev/bin/build/encode-files');

########################################################################################################################
# Checksum file
########################################################################################################################

echo "Generating file integrity map\n";
dp_build_runcmd('bin/console dpdev:gen:integrity-map');
