#!/usr/bin/env php
<?php

namespace DpDev\Build;

/*
 * This script encodes/obfuscates certain files and then replaces their regular path
 * with a file that simple require()'s the encoded one.
 */

class EncodeFiles
{
    /**
     * @var string
     */
    private $baseDir;

    /**
     * @var string[]
     */
    private $fileList = [
        '/src/DeskPRO/Bundle/AppBundle/EventListener/LicenseCheckListener.php',
        '/sys/License.php'
    ];

    public function __construct()
    {
        $this->baseDir = realpath(__DIR__.'/../../../');
    }

    public function run()
    {
        $realTargetDir = $this->getAppFilePath('/sys/enc');

        if (!is_dir($realTargetDir)) {
            mkdir($realTargetDir);
            chmod($realTargetDir, 0755);
        }

        $encString = function($s) {
            return preg_replace_callback('/(.)/', function($m) {
                return sprintf('\\x%x', ord($m[1]));
            }, $s);
        };

        $fileSource = "<?php\n\n";
        $datPath = implode("\n", [
                '"'.$encString('compress.zlib://').'".',
                'constant("'.$encString('DP_APP_DIR').'").',
                'constant("'.$encString('DIRECTORY_SEPARATOR').'").',
                '"'.$encString('sys/enc/dat.bin').'"'
        ]);

        foreach ($this->fileList as $file) {
            $srcPath        = $this->getAppFilePath($file);

            $srcCode = file_get_contents($srcPath);
            $srcCode = str_replace('<?php', '', $srcCode);
            $srcCode = preg_replace('/namespace\s*(.*?);/', 'namespace $1 {', $srcCode);
            $srcCode = trim($srcCode);
            $srcCode = preg_replace('/\?>$/', '', $srcCode);
            $srcCode .= "\n}\n";

            $fileSource .= $srcCode;

            $loader = "<?php require_once(\n$datPath\n);\n";
            file_put_contents($srcPath, $loader);
        }

        $fileSource = gzencode($fileSource, 1);
        file_put_contents($realTargetDir.DIRECTORY_SEPARATOR.'dat.bin', $fileSource);
    }

    /**
     * @param string $file
     * @return string
     */
    private function getAppFilePath($file)
    {
        return $this->baseDir . '/app/BUILD' . $file;
    }
}

$x = new EncodeFiles();
$x->run();
