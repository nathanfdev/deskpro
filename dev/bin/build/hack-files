#!/usr/bin/env php
<?php

$DP_DIR = realpath(__DIR__.'/../../../');
chdir($DP_DIR);

echo "Patching zend-ldap/src/Node.php\n";

// This hack is necessary because it causes false negative in auth when using AD
// because of bad matching when the Base DN entered in admin is not a 100%
// match (including case) to that of the directory.
// E.g., OU=foo,DC=bar does not match ou=foo,dc=com when it actually should
//
// So we remove that check because it doesnt matter for us. We only search
// the specific base dn for accounts anyway, so we already know it's a child of it.

$f          = $DP_DIR.'/app/BUILD/vendor/zendframework/zend-ldap/src/Node.php';
$content    = file_get_contents($f);
$newContent = str_replace('if (! Dn::isChildOf($this->_getDn(), $ldap->getBaseDn())) {', 'if (/* DESKPRO EDIT: Removed isChildOf check */false) {', $content);

if (strpos($newContent, 'DESKPRO EDIT') === false) {
    echo "\n\n";
    echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!\n";
    echo "Failed to patch zend-ldap/src/Node.php\n";
    echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!\n";
    echo "\n\n";
    exit(1);
}

file_put_contents($f, $newContent);
unset($f, $content, $newContent);
echo ".. Done\n";


echo "Patching Doctrine/ORM/UnitOfWork.php\n";

// https://github.com/doctrine/doctrine2/issues/5605
// https://github.com/doctrine/doctrine2/issues/3468

$f          = $DP_DIR.'/app/BUILD/vendor/doctrine/orm/lib/Doctrine/ORM/UnitOfWork.php';
$content    = file_get_contents($f);
$newContent = str_replace(
    'new PreUpdateEventArgs($entity, $this->em, $this->entityChangeSets[$oid])',
    'new PreUpdateEventArgs($entity, $this->em, $this->getEntityChangeSet($entity))',
    $content
);
file_put_contents($f, $newContent);

$f          = $DP_DIR.'/app/BUILD/vendor/doctrine/orm/lib/Doctrine/ORM/Event/PreUpdateEventArgs.php';
$content    = file_get_contents($f);
$newContent = str_replace(
    '&$changeSet',
    '$changeSet',
    $content
);
file_put_contents($f, $newContent);

unset($f, $content, $newContent);
echo ".. Done\n";

// cloud platform is a little odd in that we use php7 on web servers
// but php5.6 on task servers
// so we end up in a sitch where templates combiled on web break
// on task servers due to ?? null coalescing operator operator
// this hack disables ?? use
echo "Patching twig null coalescing operator use";

$files = [
    $DP_DIR.'/app/BUILD/vendor/twig/twig/lib/Twig/Node/Expression/Name.php',
    $DP_DIR.'/app/BUILD/vendor/twig/twig/lib/Twig/Node/Expression/NullCoalesce.php',
];

foreach ($files as $f) {
    $content = file_get_contents($f);
    $newContent = str_replace('PHP_VERSION_ID >= 70000', 'false', $content);
    file_put_contents($f, $newContent);
}

unset($f, $content, $newContent);
echo ".. Done\n";

//
// Apply patch on zend-mail
// https://github.com/zendframework/zend-mail/issues/33
//
echo "Patching Zend\Mail\Header\HeaderWrap.php\n";
    $from = <<<'EOF'
    public static function canBeEncoded($value)
    {
        $encoded = iconv_mime_encode('x-test', $value, ['scheme' => 'Q']);

        return (false !== $encoded);
    }
EOF;
    $to = <<<'EOF'
    public static function canBeEncoded($value)
    {
        // avoid any wrapping by specifying line length long enough
        // "test" -> 4
        // "x-test: =?ISO-8859-1?B?dGVzdA==?=" -> 33
        //  8       +2          +3         +3  -> 16
        $charset = 'UTF-8';
        $lineLength = strlen($value) * 4 + strlen($charset) + 16;
        $preferences = [
            'scheme' => 'Q',
            'input-charset' => $charset,
            'output-charset' => $charset,
            'line-length' => $lineLength,
        ];
        $encoded = iconv_mime_encode('x-test', $value, $preferences);
        return (false !== $encoded);
    }
EOF;
$f          = $DP_DIR.'/app/BUILD/vendor/zendframework/zend-mail/src/Header/HeaderWrap.php';
$content    = file_get_contents($f);
$newContent = str_replace(
    $from,
    $to,
    $content
);
file_put_contents($f, $newContent);

unset($f, $content, $newContent);

// This hack is to resolve a vulnerability whereby "string" referenced callbacks may be passed to twig filters and functions
// or to any proxied method that accepts a native closure

$f          = $DP_DIR.'/app/BUILD/vendor/twig/twig/src/Extension/CoreExtension.php';
$content    = file_get_contents($f);

echo "Patching {$f}\n";

$from = <<<'EOF'
function twig_array_filter($array, $arrow)
{
    if (\is_array($array)) {
        if (\PHP_VERSION_ID >= 50600) {
            return array_filter($array, $arrow, \ARRAY_FILTER_USE_BOTH);
        }

        return array_filter($array, $arrow);
    }

    // the IteratorIterator wrapping is needed as some internal PHP classes are \Traversable but do not implement \Iterator
    return new \CallbackFilterIterator(new \IteratorIterator($array), $arrow);
}

function twig_array_map($array, $arrow)
{
    $r = [];
    foreach ($array as $k => $v) {
        $r[$k] = $arrow($v, $k);
    }

    return $r;
}

function twig_array_reduce($array, $arrow, $initial = null)
{
    if (!\is_array($array)) {
        $array = iterator_to_array($array);
    }

    return array_reduce($array, $arrow, $initial);
}
EOF;
$to = <<<'EOF'
function twig_array_filter($array, $arrow)
{
    if (is_string($arrow)) {
        throw new \RuntimeException("Arrow function cannot be a string");
    }

    if (\is_array($array)) {
        if (\PHP_VERSION_ID >= 50600) {
            return array_filter($array, $arrow, \ARRAY_FILTER_USE_BOTH);
        }

        return array_filter($array, $arrow);
    }

    // the IteratorIterator wrapping is needed as some internal PHP classes are \Traversable but do not implement \Iterator
    return new \CallbackFilterIterator(new \IteratorIterator($array), $arrow);
}

function twig_array_map($array, $arrow)
{
    if (is_string($arrow)) {
        throw new \RuntimeException("Arrow function cannot be a string");
    }

    $r = [];
    foreach ($array as $k => $v) {
        $r[$k] = $arrow($v, $k);
    }

    return $r;
}

function twig_array_reduce($array, $arrow, $initial = null)
{
    if (is_string($arrow)) {
        throw new \RuntimeException("Arrow function cannot be a string");
    }

    if (!\is_array($array)) {
        $array = iterator_to_array($array);
    }

    return array_reduce($array, $arrow, $initial);
}
EOF;
$content    = file_get_contents($f);
$newContent = str_replace(
    $from,
    $to,
    $content,
    $replacements
);

if (1 !== $replacements) {
    echo "\n\n";
    echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!\n";
    echo "Failed to patch {$f}, must be one and only one replacement\n";
    echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!\n";
    echo "\n\n";
    exit(1);
}

file_put_contents($f, $newContent);

// -------------

$f          = $DP_DIR.'/app/BUILD/vendor/symfony/symfony/src/Symfony/Component/HttpFoundation/ParameterBag.php';
$content    = file_get_contents($f);

echo "Patching {$f}\n";

$from = <<<'EOF'
    public function filter($key, $default = null, $filter = FILTER_DEFAULT, $options = array(), $deep = false)
    {
        static $filters = null;

        if (null === $filters) {
            foreach (filter_list() as $tmp) {
                $filters[filter_id($tmp)] = 1;
            }
        }
        if (\is_bool($filter) || !isset($filters[$filter]) || \is_array($deep)) {
            @trigger_error('Passing the $deep boolean as 3rd argument to the '.__METHOD__.' method is deprecated since Symfony 2.8 and will be removed in 3.0. Remove it altogether as the $deep argument will be removed in 3.0.', E_USER_DEPRECATED);
            $tmp = $deep;
            $deep = $filter;
            $filter = $options;
            $options = $tmp;
        }

        $value = $this->get($key, $default, $deep);

        // Always turn $options into an array - this allows filter_var option shortcuts.
        if (!\is_array($options) && $options) {
            $options = array('flags' => $options);
        }

        // Add a convenience check for arrays.
        if (\is_array($value) && !isset($options['flags'])) {
            $options['flags'] = FILTER_REQUIRE_ARRAY;
        }

        return filter_var($value, $filter, $options);
    }
EOF;
$to = <<<'EOF'
    public function filter($key, $default = null, $filter = FILTER_DEFAULT, $options = array(), $deep = false)
    {
        static $filters = null;

        if (isset($options['options']) && is_string($options['options'])) {
            throw new \RuntimeException('Options must not be a string');
        }

        if (null === $filters) {
            foreach (filter_list() as $tmp) {
                $filters[filter_id($tmp)] = 1;
            }
        }
        if (\is_bool($filter) || !isset($filters[$filter]) || \is_array($deep)) {
            @trigger_error('Passing the $deep boolean as 3rd argument to the '.__METHOD__.' method is deprecated since Symfony 2.8 and will be removed in 3.0. Remove it altogether as the $deep argument will be removed in 3.0.', E_USER_DEPRECATED);
            $tmp = $deep;
            $deep = $filter;
            $filter = $options;
            $options = $tmp;
        }

        $value = $this->get($key, $default, $deep);

        // Always turn $options into an array - this allows filter_var option shortcuts.
        if (!\is_array($options) && $options) {
            $options = array('flags' => $options);
        }

        // Add a convenience check for arrays.
        if (\is_array($value) && !isset($options['flags'])) {
            $options['flags'] = FILTER_REQUIRE_ARRAY;
        }

        return filter_var($value, $filter, $options);
    }
EOF;
$content    = file_get_contents($f);
$newContent = str_replace(
    $from,
    $to,
    $content,
    $replacements
);

if (1 !== $replacements) {
    echo "\n\n";
    echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!\n";
    echo "Failed to patch {$f}, must be one and only one replacement\n";
    echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!\n";
    echo "\n\n";
    exit(1);
}

file_put_contents($f, $newContent);

echo ".. Done\n";
