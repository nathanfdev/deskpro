#!/usr/bin/env node
// simulates a cron job on a real server by executing cron.php once per minute
// it is much better to use a real cronjob (or plist on mac), but this is a fallback option
var child_process = require('child_process');

var cron_script = __dirname + '/../../cron.php';
var php_exec = 'php';
var cmd = php_exec + ' ' + cron_script;
var env = process.env;


process.argv.forEach(function (val, index, array) {
  if (index == 2) {
    env.XDEBUG_CONFIG = "idekey=" + val;
  }
});

console.log('using ENV', env);
if (!"XDEBUG_CONFIG" in env) {
  console.log('you can use xdebug by passing in the session name as an argument (e.g. node cron.js PHPSTORM)');
}

var curr_time = function() {
  return new Date().toISOString().
    replace(/T/, ' ').      // replace T with a space
    replace(/\..+/, '');
};

var run_cron = function() {
  console.log('['+ curr_time() +'] starting cron "' + cmd + '"');
  child_process.exec(cmd, {env: env}, function (error, stdout, stderr) {
      console.log('[' + curr_time() + '] finished cron');
  });
};

//run cron.php
run_cron();
// and then run it every minute
setInterval(run_cron, 1000 * 60);
