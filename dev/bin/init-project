#!/bin/bash

DIR_ROOT="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )/../.."

echo ">> Cleaning"
$DIR_ROOT/dev/bin/clean-project
echo ".. done"
echo

echo ">> Installing vendors with composer"
cd $DIR_ROOT/app/BUILD
composer install --ignore-platform-reqs --prefer-dist
echo ".. done"
echo

echo ">> Installing web dependencies"
cd $DIR_ROOT/www/assets/BUILD/web
npm run bower-install
npm install
echo ".. done"

echo ">> Building web assets"
npm run build:prod
echo ".. done"
echo

echo ">> Installing new web dependencies (dev)"
cd $DIR_ROOT/www/assets/BUILD/pub
npm install
echo ".. done"
echo

echo ">> Building new web assets"
npm run gulp-prod
npm run test:visual:build
echo ".. done"
echo

echo ">> Building documentation"
npm run gulp-docs
echo ".. done"
echo
