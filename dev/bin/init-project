#!/bin/bash

DIR_ROOT="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )/../.."

echo ">> Cleaning"
$DIR_ROOT/dev/bin/clean-project
echo ".. done"
echo

echo ">> Update modules"
cd $DIR_ROOT
git submodule init
git submodule update
echo ".. done"
echo

echo ">> Installing vendors with composer"
cd $DIR_ROOT/app/BUILD
composer install --ignore-platform-reqs --prefer-dist --optimize-autoloader
echo ".. done"
echo

echo ">> Installing web dependencies"
cd $DIR_ROOT/www/assets/BUILD/web
npm install
npm run bower-install
echo ".. done"

echo ">> Installing new web dependencies (dev)"
cd $DIR_ROOT/www/assets/BUILD/pub
npm install
echo ".. done"
echo

rm -rf $DIR_ROOT/www/assets/BUILD/pub/node_modules/@deskpro/react-components/node_modules/react

echo ">> Building web assets"
cd $DIR_ROOT/www/assets/BUILD/web
npm run build:prod
echo ".. done"
echo

echo ">> Building new web assets"
cd $DIR_ROOT/www/assets/BUILD/pub
npm run gulp-prod
npm run test:visual:build
rm -rf node_modules
echo ".. done"
echo

# Mattersplus codeplugin
GIT_BRANCH=$(cd $DIR_ROOT; git rev-parse --abbrev-ref HEAD)
echo "CodePlugin check for $GIT_BRANCH"
if [[ $GIT_BRANCH == "mp-"* ]]; then
  echo "Installing MattersPlus"
  cd $DIR_ROOT
  mkdir $DIR_ROOT/app/scripts/codeplugins
  cd $DIR_ROOT/app/scripts/codeplugins
  git clone git@github.com:mattersplus/mattersplus
  cd mattersplus
  git checkout master
  echo "Init MattersPlus"
  ./dev/bin/init-project
  echo ".. done MattersPlus"
fi
