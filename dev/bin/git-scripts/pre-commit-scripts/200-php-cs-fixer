#!/usr/bin/env php
<?php
define('DEV_CODE_STYLE_FIXER', realpath(__DIR__ . '/../../fix-code-style'));

$outputs = null;
$return_status = null;

$cmd = DEV_CODE_STYLE_FIXER . ' dry-run';

exec($cmd, $outputs, $return_status);
if (0 !== $return_status) {
    echo implode(PHP_EOL, $outputs), PHP_EOL;
    echo PHP_EOL . PHP_EOL . "Run dev/bin/fix-code-style to fix, and then commit again", PHP_EOL, PHP_EOL;
    exit($return_status);
}

exit($return_status);
