#!/usr/bin/env php
<?php
define('DEV_CODE_STYLE_FIXER', realpath(__DIR__ . '/../../fix-code-style'));

$err_text = <<< END
1) run dev/bin/fix-code-style to fix
2) stage the code style changes, e.g. "git add ."
3) try to commit again
END;


$outputs = null;
$return_status = null;

$cmd = DEV_CODE_STYLE_FIXER . ' dry-run';

exec($cmd, $outputs, $return_status);
if (0 !== $return_status) {
    echo implode(PHP_EOL, $outputs), PHP_EOL;
    echo PHP_EOL . PHP_EOL . $err_text, PHP_EOL, PHP_EOL;
    exit($return_status);
}

exit($return_status);
