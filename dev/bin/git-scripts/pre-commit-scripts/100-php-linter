#!/usr/bin/env php
<?php
// alternate select command, includes non-staged changes: git diff --name-only --diff-filter=MA HEAD~1 | grep -e "\.php\|\.sh\|\.twig\|\.js\|\.css\|\.md$" | xargs
$output = array();
$return = 0;
$exit_status = 0;
exec('git rev-parse --verify HEAD 2> /dev/null', $output, $return);
$against = $return == 0 ? 'HEAD' : '4b825dc642cb6eb9a060e54bf8d69288fbee4904'; // 4b825dc642cb6eb9a060e54bf8d69288fbee4904 = special "emtpy tree" sha1
exec("git diff-index --cached --name-only {$against}", $output);
$filename_pattern = '/\.php$/';
foreach ($output as $file) {
    if (!(preg_match($filename_pattern, $file) && file_exists($file))) { continue; }
    $lint_output = array();
    echo "linting $file...";
    exec("php -l " . escapeshellarg($file), $lint_output, $return);
    if ($return == 0) {
        echo 'OK' . PHP_EOL;
    } else {
        echo implode(PHP_EOL, $lint_output), PHP_EOL;
        $exit_status = 1;
    }
}
exit($exit_status);
