#!/bin/bash
# the DeskPRO pre-commit hook
# this scripts simply executes all files in dev/bin/git-scripts/pre-commit-scripts
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
PRE_COMMIT_DIR="$SCRIPT_DIR/../../dev/bin/git-scripts/pre-commit-scripts"

for filename in $(ls $PRE_COMMIT_DIR); do
    FNAME="$PRE_COMMIT_DIR/$filename"
    $FNAME
    OUT=$?
    if [ $OUT -ne 0 ];then
        exit 1
    fi
done

exit 0
