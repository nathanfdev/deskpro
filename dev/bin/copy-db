#!/usr/bin/env php
<?php

$t_start = microtime(true);
$opt = getopt('s:t:h', ['source:', 'target:', 'help']);
$source_db = @$opt['s'] ?: @$opt['source'];

if (@$opt['h'] || @$opt['help'] || $source_db) {
    echo "Use this command to copy an existing database to a new database, and\n";
    echo "then switch the current database in config to the new one.\n\n";

    echo "Usage: echo dev/bin/copy-db -s SOURCE_DB -t NEW_DB\n\n";

    echo "\t-h, --help           Show this help message\n";
    echo "\t-s DBNAME,           The name of the source database to copy\n";
    echo "\t--source DBNAME\n";
    echo "\t-t DBNAME,           (optional) The name of the new target db to create\n";
    echo "\t--target DBNAME\n    If not specified, a name will be generated based on the source name.";
    echo "\n";
    exit;
}

$target_db = @$opt['t'] ?: @$opt['target'];
if (!$target_db) {
    $target_db = $source_db;
    $target_db = preg_replace('#\d+$#', '', $target_db);
    $target_db .= date('Ymd') . '_' . date('Hms');
}

require('../../config.php');

$make_db_cmd = sprintf(
    "%s -u%s -p%s -e %s",
    escapeshellarg($DP_CONFIG['mysql_path'] ?: 'mysql'),
    escapeshellarg(DP_DATABASE_USER),
    escapeshellarg(DP_DATABASE_PASSWORD),
    escapeshellarg('CREATE DATABASE `'.$target_db.'`')
);

$copy_cmd = sprintf(
    "%s -u%s -p%s %s | %s -u%s -p%s %s",
    escapeshellarg($DP_CONFIG['mysql_path'] ?: 'mysql'),
    escapeshellarg(DP_DATABASE_USER),
    escapeshellarg(DP_DATABASE_PASSWORD),
    escapeshellarg($source_db),
    escapeshellarg($DP_CONFIG['mysqldump_path'] ?: 'mysqldump'),
    escapeshellarg(DP_DATABASE_USER),
    escapeshellarg(DP_DATABASE_PASSWORD),
    escapeshellarg($target_db)
);

echo "Creating new database ...\n";
echo "$ $make_db_cmd\n\n";

$ret = null;
passthru($make_db_cmd, $ret);

if ($ret) {
    echo "Command exited with error status\n";
    die($ret);
}

echo "Copying database ...\n";
echo "$ $copy_cmd\n\n";

$ret = null;
passthru($copy_cmd, $ret);

if ($ret) {
    echo "Command exited with error status\n";
    die($ret);
}

echo "Installing new dbname into DB_NAME.txt ...\n";

// Enable it
$f = __DIR__.'/../dev_config/DB_NAME.txt';
if (is_file($f)) {
    $exist = trim(file_get_contents($f));
    $exist = explode("\n", $exist);
    // comments out previous values
    $exist = array_map(function($l) {
        if (!($l[0] === '#' || $l[0] === ';' || trim($l[0]) === '')) {
            return '#' . $l;
        } else {
            return $l;
        }
    }, $exist);

    $exist[] = $target_db;
    $exist[] = '';
    $exist = implode("\n", $exist);

    file_put_contents($f, $exist);
} else {
    echo "You are not using the dev_config/ scripts. You will need to manually edit your config.php file.\n\n";
}

echo "Done\n\n";

echo "Source DB: $source_db\n";
echo "New DB:    $target_db\n";
echo "Copy took: " . sprintf("%.4fs", microtime(true) - $t_start);
echo "\n";

die(0);
