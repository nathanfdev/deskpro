#!/bin/bash
# this only works if your cache dir is the default app/sys/cache
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd $SCRIPT_DIR

rm -rf ../../var/cache/*/
rm -rf ../../var/kernel_cache/*/
rm -rf ../../var/tmp/*/

chmod -R 0777 ../../var/cache/*/
chmod -R 0777 ../../var/kernel_cache/*/
chmod -R 0777 ../../var/tmp/*/
