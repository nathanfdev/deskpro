#!/bin/bash

environments[0]="dev"
environments[1]="test"

function __in_array {
    local haystack=${1}
    local needle=${2}
    for i in ${haystack}; do
        if [[ ${i} == ${needle} ]]; then
            return 0
        fi
    done
    return 1
}

function __fail {
    local EXIT_STATUS=${1}||1
    echo "
Usage:
 cache-clear [OPTIONS]

OPTIONS:
 -m         Clear mode. One of [all, api_permissions, api_limits, jms_serializer]
 -e         Environment. One if [dev, test]

EXAMPLE:
 cache-clear -m api_permissions -e dev         Clear api_permissions in dev environment
"
    exit ${EXIT_STATUS}

}


# this only works if your cache dir is the default var directory
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

ENV='dev'
MODE='all'
while getopts "e:m:h" opt
do
    case $opt in
        'e')
            ENV=$OPTARG
            ;;
        'h')
            __fail 0
            ;;
        'm')
            MODE=$OPTARG
            ;;
    esac
done

__in_array ${environments} ${ENV} || __fail

cd $SCRIPT_DIR

    case "$MODE" in
        'api_permissions' | 'jms_serializer' | 'api_limits')
            echo "clearing $MODE cache in $ENV environment"
            rm -rf ../../var/kernel_cache/BUILD/$ENV/api_permissions/*
            ;;
        'all')
            echo "clearing all caches in $ENV environment"
            rm -rf ../../var/cache/*
            rm -rf ../../var/kernel_cache/BUILD/$ENV/*
            rm -rf ../../var/tmp/*
            ;;
        *)
            __fail
            ;;
    esac

chmod -R 0777 ../../var/cache
chmod -R 0777 ../../var/kernel_cache/BUILD/$ENV
chmod -R 0777 ../../var/tmp
