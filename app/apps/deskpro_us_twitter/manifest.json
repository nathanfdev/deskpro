{
	"package_name": "deskpro_us_twitter",
	"is_native": true,
	"title": "Twitter Authentication",
	"description": "Allows users to log in using their twitter account.",
	"tags": ["usersources"],
	"api_version": 1,
	"version": 1,
	"version_name": "1.0.0",
	"is_single": false,
	"author": {
		"name": "DeskPRO",
		"email": "support@deskpro.com",
		"link": "https://www.deskpro.com/"
	},
	"settings_def": [
		{
			"name": "enable_usersource",
			"type": "checkbox",
			"label": "Enabled?",
			"description": "Enable this user source?",
			"checkbox_label": "Yes",
			"native_only": true
		},
		{
			"name": "consumer_key",
			"type": "text",
			"label": "Consumer Key",
			"description": "",
			"checkbox_label": "Yes",
			"native_only": true
		},
		{
			"name": "consumer_secret",
			"type": "text",
			"label": "Consumer Secret",
			"description": "",
			"checkbox_label": "Yes",
			"native_only": true
		},
		{
			"name": "auto_agent",
			"type": "checkbox",
			"label": "Auto Agent",
			"checkbox_label": "Automatically create agents if they do not already exist",
			"usersource_display": "agent",

			"inline_dependant": {
				"name": "auto_agent_permission_group",
				"type": "choice",
				"label": "Add new agents to this permission group",
				"options_variable": "permission_groups",
				"is_required": true
			}
		}
	]
}