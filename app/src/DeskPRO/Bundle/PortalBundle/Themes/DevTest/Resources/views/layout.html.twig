{% extends 'ThemeParent::layout.html.twig' %}
{% block body %}

    <div class="world">
        <section>
            <div class="column-full">
                {{ this_page_top()|raw }}
            </div>
        </section>

        <section>
            <div class="column-full">
                {{ this_page_search_box()|raw }}
            </div>
        </section>

        <section>
            <div class="column-full">
                {{ this_page_tabs()|raw }}
            </div>
        </section>

        <section>
            {{ this_flashes()|raw }}
            <div class="column-half-plus">
                {% block page_content %}
                    <h1>this theme's proprietary tags will appear below here</h1>
                    <h3>{{ this_hello_world()|raw }}</h3>
                    <h3>{{ this_hello_world({"name": "Christopher!"})|raw }}</h3>
                    <h3>{{ this_hello_henry()|raw }}</h3>
                    <section>
                        <div class="column-full">
                            {% block inner_content %}
                            {% endblock inner_content %}
                        </div>
                    </section>
                {% endblock page_content %}
            </div>

            <aside class="sidebar">
                {{ this_sidebar()|raw }}
            </aside>
        </section>

    </div>

{% endblock body %}
