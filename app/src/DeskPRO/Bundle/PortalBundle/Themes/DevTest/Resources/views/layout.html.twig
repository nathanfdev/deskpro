{% extends 'ThemeParent::layout.html.twig' %}
{% block body %}

    <div class="world">

        <section>
            <div class="column-full">
              {% show section alerts %}
              {% show section page_top %}
            </div>
        </section>

        <section>
            <div class="column-full">
              {% show section search_and_contact_bar %}
            </div>
        </section>

        <section>
            {% show section flashes %}
            <div class="column-half-plus">
                {% block page_content %}
                    <section>
                        <div class="column-full">
                            {% block inner_content %}
                            {% endblock inner_content %}
                        </div>
                    </section>
                {% endblock page_content %}
            </div>

            <aside class="sidebar">
              {% show section sidebar %}
            </aside>
        </section>

    </div>

{% endblock body %}
