{% extends 'ThemeParent::layout.html.twig' %}
{% block body %}

    {% show agent_bar %}

    <div class="world">
        <section>
            <div class="column-full">
              {% show section alerts %}
              {% show section page_top %}
            </div>
        </section>

        <section>
            <div class="column-full">
              {% show section page_search_box %}
            </div>
        </section>

        <section>
            {% show section flashes %}
            <div class="column-half-plus">
                {% block page_content %}
                    {% block content_header %}
                        <section class="welcome-news">
                            {% show section nav_buttons %}
                        </section>
                    {% endblock content_header %}
                    <section>
                        <div class="column-full">
                            {% block inner_content %}
                            {% endblock inner_content %}
                        </div>
                    </section>
                {% endblock page_content %}
            </div>

            <aside class="sidebar">
              {% show section sidebar %}
            </aside>
        </section>

        <section>
            <div class="column-full">
                {% show section footer %}
            </div>
        </section>
    </div>
{% endblock body %}
