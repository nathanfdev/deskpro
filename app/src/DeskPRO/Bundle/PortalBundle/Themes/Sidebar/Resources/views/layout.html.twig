{% extends 'ThemeParent::layout.html.twig' %}
{% block body %}

    {% show agent_bar %}

    <div class="world">
        <section>
            <div class="column-full">
              {% show section alerts %}
              {% show section page_top %}
            </div>
        </section>

        <section class="column-full">
            <div class="column-half-plus">
              {% show section search_bar %}
                <div class="column-full">

                <section>
                    {% show section flashes %}
                    <div class="column-full">
                        {% block page_content %}
                            {% block content_header %}
                                <section class="welcome-news">
                                    {% show section nav_buttons %}
                                </section>
                            {% endblock content_header %}
                            <section>
                                <div class="column-full">
                                    {% block inner_content %}
                                    {% endblock inner_content %}
                                </div>
                            </section>
                        {% endblock page_content %}
                    </div>
                </section>
                    </div>
            </div>

            <aside class="sidebar">
                {% show section sidebar %}
            </aside>
        </section>

        <section>
            <div class="column-full">
                {% show section footer %}
            </div>
        </section>
    </div>
{% endblock body %}
