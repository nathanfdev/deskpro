{% extends 'ThemeParent::layout.html.twig' %}
{% block body %}

    {% show agent_bar %}

    <div class="world">

        <section>
            <div class="column-full">
              {% show section alerts %}
              {% show section page_top %}
            </div>
        </section>

        <section>
            <div class="column-full">
              {% show section page_search_box %}
            </div>
        </section>

        <section>
            <div class="column-full">
              {% show section page_tabs %}
            </div>
        </section>

        <section>
            {% show section flashes %}
            <div class="column-full">
                {% block page_content %}
                    <section>
                        <div class="column-full">
                            {% block inner_content %}
                            {% endblock inner_content %}
                        </div>
                    </section>
                {% endblock page_content %}
            </div>
        </section>

        <section>
            <div class="column-full">
                {% show section footer %}
            </div>
        </section>
    </div>

{% endblock body %}
