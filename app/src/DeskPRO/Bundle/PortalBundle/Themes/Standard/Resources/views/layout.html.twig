{% extends 'ThemeParent::layout.html.twig' %}
{% block body %}

{% show agent_bar %}

<div class="world with-searchbox">
    <section>
        <div class="column-full">
          {% show section alerts %}
          {% show section page_top %}
        </div>
    </section>

    <section class="search-section">
        <div class="column-full">
          {% show section page_search_box %}
        </div>
    </section>

    {% show section flashes %}

    {% block page_content %}
        {% block content_header %}{% endblock content_header %}
        <section>
            <div class="column-full">
              {% block inner_content %}{% endblock inner_content %}
            </div>
        </section>
    {% endblock %}

  <section>
    <div class="column-full">
      {% show section footer %}
    </div>
  </section>
</div>

{% endblock body %}
