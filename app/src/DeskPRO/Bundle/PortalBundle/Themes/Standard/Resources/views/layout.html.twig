{% extends 'ThemeParent::layout.html.twig' %}
{% block body %}

{% show agent_bar %}

<div class="world with-searchbox">
    <section class="page-top-section">
        <div class="column-full">
          {% show section alerts %}
          {% show section page_top %}
        </div>
    </section>

    <section class="search-section">
        <div class="column-full">
          {% show section search_and_contact_bar %}
        </div>
    </section>

    {% show section flashes %}

    {% block page_content %}
        {% block content_header %}
            <section class="welcome-news">
                {% show section nav_buttons %}
            </section>
        {% endblock content_header %}
        <section class="with-dpx">
            <div class="column-full">
              {% block inner_content %}{% endblock inner_content %}
            </div>
        </section>
    {% endblock %}

  <section class="page-bottom-section">
    <div class="column-full">
      {% show section footer %}
    </div>
  </section>
</div>

{% endblock body %}
