{% extends 'ThemeParent::layout.html.twig' %}
{% block body %}

    <div class="world with-searchbox">
        <section>
            <div class="column-full">
                {{ alerts() }}
                {{ page_top() }}
            </div>
        </section>

        <section class="search-section">
            <div class="column-full">
                {{ page_search_box() }}
            </div>
        </section>

        {# Uncomment these lines to show navigation tabs #}
        {#
        <section>
            <div class="column-full">
                {{ page_tabs() }}
            </div>
        </section>
        #}

        <section>
            {{ flashes() }}
            <div class="column-half-plus">
                {% block page_content %}
                    <section>
                        <div class="column-full">
                            {% block inner_content %}
                            {% endblock inner_content %}
                        </div>
                    </section>
                {% endblock page_content %}
            </div>

            <aside class="sidebar">
                {{ sidebar() }}
            </aside>
        </div>

    </div>

{% endblock body %}
