{% if pager|length %}
  {% for item in pager %}
    <article class="news kb-article kb-article-news">
      <header>
        <div class="calendar-decoration">
          <span class="month">{{ item.date_published | date('M') }}</span>
          <hr>
          <span class="day">{{ item.date_published | date('j') }}</span>
        </div>
        <h1><a href="{{ path('portal_news_view', { slug: item.slug }) }}">{{ item.title }}</a></h1>
        <div class="article-meta">
          {% if item.person %}
            By <span style="background: url({{ avatar_url(item.person) }}) no-repeat; background-size: cover" class="agent-avatar agent-avatar-mini"></span> {{ item.person.name }}
          {% endif %}
          <i class="fa fa-folder-o"> {{ item.category.getRealTitle() }}</i>
          <span class="comments"><i class="fa fa-comments"></i> <a href="#">0 comments</a></span>
        </div>
      </header>

      <hr>

      <div class="article-content padded">
        {{ render_news(item, 'exceprt') }}
      </div><!-- end padded -->
    </article>
  {% endfor %}
{% endif %}
