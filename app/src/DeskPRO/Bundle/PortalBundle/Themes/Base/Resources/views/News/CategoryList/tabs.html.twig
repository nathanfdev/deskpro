<nav class="tabs secondary-tabs news-categories-tabs">
  <ul>
    <li class="{% if not category %}active{% endif %}">
      <a href="{{ path('portal_news') }}">{{ phrase('portal.news.section-title') }}</a>
    </li>

    {% if category_children|length > 0 %}
      {% for child in category_children %}
        <li class="{% if child is same as(category) %}active{% endif %}">
          <a href="{{ portal_path(child) }}">{{ child.title }}</a>
        </li>
      {% endfor %}
    {% endif %}
  </ul>
</nav>
