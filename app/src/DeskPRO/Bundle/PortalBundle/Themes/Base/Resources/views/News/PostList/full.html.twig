{% if pager|length %}
  {% for item in pager %}
    <article class="news kb-article kb-article-news">
      <header>
        <div class="calendar-decoration-new">
          <i class="fa fa-calendar-o"></i>
          <div class="month">{{ item.date_published | date('M') }}</div>
          <div class="day">{{ item.date_published | date('j') }}</div>
        </div>
        <h1><a href="{{ portal_path(item) }}">{{ item.title }}</a></h1>
        <div class="article-meta">
          {% if item.person %}
            By <span style="background: url({{ avatar_url(item.person) }}) no-repeat; background-size: cover" class="agent-avatar agent-avatar-mini"></span> {{ item.person.name }}
          {% endif %}
          <a href="{{ portal_path(item.category) }}"><i class="fa fa-folder-o"> {{ item.category.getRealTitle() }}</i></a>
          {% if item.num_comments > 0 %}
          <span class="comments"><i class="fa fa-comments"></i> <a href="{{ portal_path(item) }}#comments">{{ phrase('portal.general.comments-count', {count: item.num_comments}) }}</a></span>
          {% endif %}
        </div>
      </header>
      <hr>
      <div class="article-content padded">
        {{ render_news(item) }}
      </div>
    </article>
  {% endfor %}
  {% if show_pager %}
    {% show news_pager %}
  {% endif %}
{% endif %}

