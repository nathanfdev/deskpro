<div class="breadcrumbs">
    <ul>
        <li>
            <a href="{{ path('portal_index') }}">{{ global_settings.get('core.deskpro_name') }}</a> <i class="fa fa-angle-right"></i>
        </li>

        <li>
          <a href="{{ path('portal_tickets') }}">{{ phrase('portal.tickets.section-title') }}</a>
          {% if ticket is defined %}<i class="fa fa-angle-right"></i>{% endif %}
        </li>

      {% if ticket is defined %}
        <li>
          <a href="{{ path('portal_tickets_view', { id: ticket.id }) }}">
            {{ ticket.subject }}
          </a>
        </li>
      {% endif %}
    </ul>
    <hr>
</div>