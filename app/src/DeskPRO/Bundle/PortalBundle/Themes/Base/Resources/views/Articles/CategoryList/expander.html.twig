{% if category_children|length > 0 %}
    {% for category in category_children %}
        <article class="article-categories-expandable">
            <header>
                <a href="{{ path('portal_kb_browse', { slug: category.slug }) }}">
                    <h1>{{ category.title }}</h1>
                    <div class="article-controls single-line">
                        <span class="article-tag pointy">{{ phrase('portal.articles.x-articles', {count: category.articles|length}) }}</span>
                        <span class="expandable-control"><i class="fa fa-angle-up"></i></span>
                    </div>
                </a>
            </header>

            {% show kb_list_simple %}

            <div class="list-meta">
                <a href="{{ path('portal_kb_browse', { slug: category.slug }) }}">{{ phrase('portal.articles.view-x-articles', {count: category.articles|length}) }}</a>
            </div>
        </article>
    {% endfor %}
{% endif %}
