{% import 'Theme::icons.html.twig' as icons %}
{% if pager|length > 0 %}
<ul class="download-list">
    {% for dl in pager %}
        <li>
            {{ icons.dl_detailed(dl) }}
            <a href="{{ path('portal_downloads_view', { slug:dl.slug } ) }}">{{ dl.title }}</a>
        </li>
    {% endfor %}
    {% if show_category_link %}
        <div class="list-meta">
            <a href="{{ category ? path('portal_downloads_browse', { slug: category.slug }) : path('portal_downloads') }}">
                {{ phrase('portal.downloads.view-x-files', {count: pager|length}) }}{{ icons.view_more() }}
            </a>
        </div>
    {% endif %}
</ul>
{% else %}
    <strong>{{ phrase('portal.downloads.none') }}</strong>
{% endif %}
