  <li class="welcome">
    <span class="agent-avatar agent-avatar-mini" style="background: url({{ avatar_url(user, 36) }}) no-repeat; background-size: cover;"></span>
    {{ phrase('portal.account.welcome-back') }} {{ app.user.first_name }}

    &middot;
    <a href="{{ path('portal_user_profile') }}">{{ phrase('portal.account.section-title-your-account') }}</a>

    {% if ticket_count > 0 %}
      &middot;
      <a href="{{ path('portal_tickets') }}">{{ phrase('portal.general.nav-tickets') }} ({{ ticket_count }})</a>
    {% endif %}

    {% if user.organization and user.organization_manager and ticket_count_org > 0 %}
      &middot;
      <a href="{{ path('portal_tickets', { type: 'organization' }) }}">{{ phrase('portal.general.nav-tickets-org') }} ({{ ticket_count_org }})</a>
    {% endif %}

  </li>
  <li>
    <a href="{{ path('portal_logout') }}" class="button-small button-marked">{{ phrase('portal.account.logout-btn') }}</a>
  </li>
