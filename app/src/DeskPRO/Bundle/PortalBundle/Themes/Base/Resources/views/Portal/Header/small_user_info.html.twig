{% if is_guest() %}
  {% if display_registration_link %}
    <li>
      <a href="{{ path('portal_user_registration') }}" class="button-small button-marked">{{ phrase('portal.account.login-register-header') }}</a>
    </li>
  {% endif %}

  {% if show_auth %}
    {% if display_registration_link %}
      <li class="register-or-signup">
        <span><hr> Or <hr></span>
      </li>
    {% endif %}
    <li>
      <div class="dropdown-group">
        <a href="{{ path('portal_login') }}" class="button-small button-marked clickaway-dropdown" data-clickaway-target="top-login-dropdown">{{ phrase('portal.account.login-btn') }} <i
                  class="fa fa-caret-down"></i></a>

        <div class="active-button-dropdown language-dropdown" id="top-login-dropdown" style="min-width:300px;">
          <div class="small-form">
            {% if show_login_form %}
              <form action="{{ path('portal_login_submit') }}" method="post" id="login-sidebar">
                <input type="hidden" name="_failure_path" value="{{ path('portal_login', {retry:'auth'}) }}"/>
                <label>
                  <span>{{ phrase('portal.account.login-email') }}</span>
                  <input type="text" tabindex="2" placeholder="email@example.com" name="username">
                </label>

                <label>
                  <span>{{ phrase('portal.account.login-password') }}</span>
                  <input type="password" tabindex="2" placeholder="Your password" name="password">
                </label>

                {% if show_remember_me %}
                  <div class="permanent-login">
                    <label>{{ phrase('portal.account.login-remember') }} <input tabindex="2" type="checkbox" name="remember_me"></label>
                  </div>
                {% endif %}

                <button type="submit" tabindex="2">{{ phrase('portal.account.login-btn') }}</button>

                {% if show_forgot_password %}
                  <div class="secondary-action">
                    <a href="{{ path('portal_reset_password') }}">{{ phrase('portal.account.login-password-reminder') }}</a>
                  </div>
                {% endif %}
              </form>
            {% endif %}

            {# twitter, facebook, google (the old "icon" usersources) #}
            {% if login_icon_usersources|length > 0 %}
              {% for usersource in login_icon_usersources %}
                <a href="{{ path('portal_login_authenticate', {'usersource_id': usersource.id}) }}"
                   class="button auth-{{ usersource.adapter.codeName|lower }}"><i
                          class="fa fa-{{ usersource.adapter.codeName|lower }}"></i> Login
                  with {{ usersource.adapter.codeName|title }}</a>
              {% endfor %}
            {% endif %}

            {# the newer "text button" usersources #}
            {% if login_text_button_usersources|length > 0 %}
              {% for usersource in login_text_button_usersources %}
                <a href="{{ path('portal_login_authenticate', {'usersource_id': usersource.id}) }}"
                   class="button">{{ usersource.options.login_custom_text }}</a>
              {% endfor %}
            {% endif %}
          </div>
        </div>
      </div>
    </li>
  {% endif %}
{% else %}
  <li class="welcome">
    {{ phrase('portal.account.welcome-back') }} {{ app.user.first_name }}

    &middot;
    <a href="{{ path('portal_user_profile') }}">{{ phrase('portal.account.section-title-your-account') }}</a>

    {% if is_agent() %}
      &middot;
      <a href="{{ path('agent') }}">{{ phrase('agent.general.agent_interface') }}</a>



      {# TODO: temporary link for dev purposes #}
      <a href="/old-agent">[OLD]</a>
      {# TODO: temporary link for dev purposes #}





    {% endif %}

    {% if is_admin() %}
      &middot;
      <a href="{{ path('admin') }}">{{ phrase('agent.general.admin_interface') }}</a>
    {% endif %}

    {% if ticket_count > 0 %}
      &middot;
      <a href="{{ path('portal_tickets') }}">{{ phrase('portal.general.nav-tickets') }} ({{ ticket_count }})</a>
    {% endif %}

  </li>
  <li>
    <a href="{{ path('portal_logout') }}" class="button-small button-marked">{{ phrase('portal.account.logout-btn') }}</a>
  </li>
{% endif %}
