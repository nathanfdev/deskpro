{% extends 'Theme::layout.html.twig' %}

{% block inner_content %}
    <div class="breadcrumbs">
        {% show breadcrumbs %}
    </div>
    <div class="column-full">
        <div class="column-full">
            <div>
                <header class="section-header">
                    <h1>{{ phrase('portal.account.section-title-your-profile') }}</h1>
                </header>
            </div>
        </div>
        <div class="column-full">
            <div>
                <nav class="tabs secondary-tabs">
                    <ul>
                        <li class="tab-inactive">
                            <a href="{{ path('portal_user_profile') }}">
                                <div>
                                    <span class="title">
                                        {{ phrase('portal.account.section-title-profile') }}
                                    </span>
                                </div>
                            </a>
                        </li>
                        <li class="tab-active">
                            <a href="{{ path('portal_user_profile_emails') }}">
                                <div>
                                    <span class="title">
                                        {{ phrase('portal.account.section-title-emails') }}
                                    </span>
                                </div>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>

        <div class="column-full">
            <div>
                <h1>{{ phrase('portal.account.email-managment') }}</h1>
                {% if validating_emails %}
                    <div class="alerts">
                            {% for email,resend_link in validating_emails %}
                                <div class="alert">
                                    <strong>{{ email }}</strong>
                                    {{ phrase('portal.account.emails_are_awaiting_validation') }}
                                    <a class="button button-plain button-small" href="{{ resend_link }}">{{ phrase('portal.account.resend_email') }}</a>
                                </div>
                            {% endfor %}
                    </div>
                {% endif %}

                {% if person.isEmailValidated() %}
                    {{ form_start(emails_form) }}
                    {{ form_errors(emails_form) }}
                    {% for email_form in emails_form.emails %}
                        <div style="display: block; padding-top: 5px; padding-bottom: 5px;">
                            {{ form_errors(email_form.email) }}
                            {{ form_widget(email_form.email) }}
                            {% if email_form.vars.data.isPrimary %}
                                <strong>{{ phrase('portal.account.email-primary-indicator') }}</strong>
                            {% elseif email_form.vars.data.id %}

                                <a class="button button-secondary button-small" href="{{ path('portal_user_profile_emails', { new_primary: email_form.vars.data.id }) }}">{{ phrase('portal.account.email-btn-make-primary') }}</a>
                                <a class="button button-small cancel" href="{{ path('portal_user_profile_emails', { remove_email: email_form.vars.data.id }) }}">{{ phrase('portal.account.email-btn-remove') }}</a>
                            {% endif %}
                        </div>
                    {% endfor %}
                    <button type="submit">{{ phrase('portal.account.email-btn-update') }}</button>
                    {{ form_rest(emails_form) }}
                    {{ form_end(emails_form) }}
                {% else %}
                    {{ phrase('portal.account.email-primary-needs-validation', { email: person.primary_email.email, verify_url: verify_url }) }}
                {% endif %}
            </div>
        </div>

    </div>
{% endblock inner_content %}
