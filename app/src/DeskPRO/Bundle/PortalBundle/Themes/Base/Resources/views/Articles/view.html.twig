{% extends 'Theme::layout.html.twig' %}
{% block inner_content %}

  <div class="breadcrumbs">
    {% show breadcrumbs %}
  </div>

  <article class="news kb-article">
    <header>

      <div class="header-button-container">
        <div class="header-buttons">
          {% show kb_subscription_link %}
          {#<a href="#">{{ phrase('portal.general.btn-email') }} <i class="fa fa-envelope"></i></a>#}
          {#<a href="#">{{ phrase('portal.general.btn-print') }} <i class="fa fa-print"></i></a>#}
          {#<a href="#">{{ phrase('portal.general.btn-download-pdf') }} <i class="fa fa-file-pdf-o"></i></a>#}
        </div>
      </div>

      <h1>{{ article.real_title }}</h1>

      <div class="article-meta"><!-- TODO translations? -->
        <span style="background: url({{ avatar_url(article.person) }}) no-repeat; background-size: cover" class="agent-avatar agent-avatar-mini"></span>
        {{ article.person.name }}
        <hr>
        {{ article.date_published | date('Y-m-d') }}
        <hr>
        <span class="comments"><i class="fa fa-comments-o"></i> <a href="#comments">{{ phrase('portal.general.comments-count', {count: article.num_comments}) }}</a></span>
        <hr>
        In <a href="{{ portal_path(article.primary_category) }}">{{ article.primary_category }}</a>
      </div>
    </header>

    {% show kb_subscription_info %}

    <div class="article-content padded dpx-kb-article-content">
      {{ article.realContent|raw }}
    </div>

    {% if article.labels|length %}
      <div class="tag-list">
        <ul>
          <li class="tag-list-header"><i class="fa fa-tags"></i> {{ phrase('portal.general.tags') }}</li>
          {% for l in  article.labels %}
            <li class="tag-list-item"><a href="{{ path('portal_search_labels', { label: l }) }}">{{ l }}</a></li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}
  </article>

  {% show kb_ratings %}
  {% show related_content %}

  {% if article.num_comments or new_comment_form %}
    <div class="comment-box" id="comments">
      <div class="titled-header">
        <h1>{{ phrase('portal.general.comments-title', {count: article.num_comments}) }}</h1>
      </div>
      {% show kb_article_comments %}
      {% show comment_form %}
    </div>
  {% endif %}
{% endblock inner_content %}

{% block doc_end %}
      {{ insert_glossary_js(article) }}
{% endblock %}
