{% if pager|length > 0 %}
<div class="sidebar-list">
  <h1>Top Articles</h1>
  <ul>
    {% for article in pager %}
      <li>
        <a href="{{ portal_path(article) }}"><i class="fa fa-file-text-o"></i> {{ article.realTitle }}</a>
      <span class="meta">
        {% if article.person %}
        Posted by {{ article.person.display_name_user }}
        {% endif %}
        {# todo: these need better styles, leaving out for now #}
        {#<span class="text-tag rating-tag">12 <i class="fa fa-caret-down"></i></span>#}
        {#<span class="text-tag comment-tag">12<i class="fa fa-comment"></i></span>#}
      </span>
      </li>
    {% endfor %}
  </ul>
  <hr>
</div>
{% endif %}
