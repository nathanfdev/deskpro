{% if brand_setting('user.news_subscriptions') %}
    <div class="header-buttons">
        <a href="{{ path('portal_news_category_toggle_subscription', { slug: category.slug }) }}">
            {% if is_subscribed %}
                {{ phrase('portal.general.category-subscribed') }} |
                {{ phrase('portal.general.unsubscribe-to-category') }}
            {% else %}
                {{ phrase('portal.general.subscribe-to-category') }}
            {% endif %}
        </a>
    </div>
{% endif %}
