{% macro view_more() %}
    <i class="fa fa-caret-right"></i>
    {#<img src="{{ asset('/pub/src/DeskPRO/Bundle/PortalBundle/Resources/img/icon-view-more.png') }}">#}
{% endmacro %}
{% macro dl(dl) %}
    {% if dl.blob and dl.blob.extension %}
        {% if dl.blob.extension in ['zip', 'pdf', 'excel', 'audio', 'video', 'powerpoint', 'image', 'code', 'word', 'archive'] %}
            {% set class = 'fa fa-file-' ~ dl.blob.extension ~ '-o' %}
        {% elseif dl.blob.extension in ['gif', 'jpeg', 'jpg', 'png'] %}
            {% set class = 'fa fa-file-image-o' %}
        {% else %}
            {% set class = 'fa fa-download' %}
        {% endif %}
    {% else %}
        {% set class = 'fa fa-download' %}
    {% endif %}
    <i class="{{ class }}"></i>
{% endmacro %}
{% macro dl_detailed(dl) %}
    {% if dl.blob and dl.blob.extension %}
        <i class="fa fa-{{ file_css_class(dl) }}"></i>
    {% else %}
        {# file type is unknown #}
        <span class="text-tag file-tag">&nbsp;</span>
    {% endif %}
{% endmacro %}
