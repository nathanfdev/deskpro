{% extends 'Theme::layout.html.twig' %}

{% block inner_content %}
    <div class="breadcrumbs">
        {% show breadcrumbs %}
    </div>
    <article class="news kb-article">
        <header>
            <h1>{{ file.title }}</h1>

            <div class="article-meta">
                <span class="agent-avatar agent-avatar-mini"><img src="{{ avatar_url(file.person, 20) }}"></span>
                {{ phrase('portal.articles.by-line', { name: file.person.name, date: file.date_published | date('Y-m-d') }) }}
                <span class="comments"><i class="fa fa-comments"></i> <a
                            href="#">{{ phrase('portal.general.comments-count', {count: file.num_comments}) }}</a></span>
            </div>
        </header>

        <div class="article-extras">
            <a href="{{ path('portal_downloads_download', { slug: file.slug, authcode: file.blob.authcode }) }}">
                {% if file.blob and file.blob.is_image %}
                    <img style="max-width: 100%;"
                         src="{{ path('serve_blob', { blob_auth_id: file.blob.authcode, filename: file.blob.filenameSafe }) }}"
                         alt="{{ file.title }}"/><br>
                {% endif %}

                [{{ file.blob.content_type }}]
                {{ phrase('portal.downloads.btn-download', { size: file.readableFileSize }) }}
            </a>
        </div>

        <div class="header-button-container">
            <div class="header-buttons">
                {% show download_subscription_link %}
                <a href="#">{{ phrase('portal.general.btn-email') }} <i class="fa fa-envelope"></i></a>
                <a href="#">{{ phrase('portal.general.btn-print') }} <i class="fa fa-print"></i></a>
                <a href="#">{{ phrase('portal.general.btn-download-pdf') }} <i class="fa fa-file-pdf-o"></i></a>
            </div>
        </div>

        {% show download_subscription_info %}

        <div class="article-content padded">
            {{ file.contentDesc|raw }}
        </div>

        {% if file.labels|length %}
            <div class="tag-list">
                <ul>
                    <li class="tag-list-header"><i class="fa fa-tags"></i> Tags</li>
                    {% for l in file.labels %}
                        <li class="tag-list-item"><a href="#">{{ l }}</a></li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
    </article>

    {% show download_ratings %}
    {% show related_content %}

    {% if file.num_comments or new_comment_form %}
    <div class="comment-box">
        <div class="titled-header">
            <h1>{{ phrase('portal.general.comments-title', {count: file.num_comments}) }}</h1>
        </div>
        {% show download_comments %}
        {% show comment_form %}
    </div>
    {% endif %}

{% endblock inner_content %}
