{% if pager|length > 0 %}
    <div class="column-half">
        <article class="article-categories">
            <ul>
                {% for article in pager %}
                    <li>
                        <a href="{{ path('portal_kb_view', { slug:article.slug }) }}">{{ article.realTitle }}</a>
                    </li>
                {% endfor %}
            </ul>

            {% if show_category_link %}
                <div class="list-meta">
                    <a href="{{ path('portal_kb_browse', { slug: category.slug }) }}">
                        {{ phrase('portal.articles.view-x-articles', {count: pager|length}) }}
                        <i class="fa fa-caret-right"></i>
                    </a>
                </div>
            {% endif %}
        </article>
    </div>
{% else %}
    <strong>No articles yet</strong>
{% endif %}
