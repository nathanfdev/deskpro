<div class="content-list-wrap simple as-articles {% if pager|length %}with-items{% else %}with-no-items{% endif %}">
    {% if pager|length %}
        <ul class="content-list">
            {% for item in pager %}
                <li>
                    <span class="thumbs"><i class="fa fa-thumbs-up"></i> {{ item.popularity }}</span>
                    <a href="{{ path('portal_feedback_view', { slug: item.slug }) }}">{{ item.title }}</a>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <strong>No feedback yet</strong>
    {% endif %}

    {% if show_category_link %}
        <div class="list-meta">
            <a href="{{ path('portal_feedback') }}">
                {{ phrase('portal.feedback.view-x-feedback', {count: pager|length}) }}
                <i class="fa fa-caret-right"></i>
            </a>
        </div>
    {% endif %}
</div>