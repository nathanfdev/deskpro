{% if category_children|length > 0 %}
<ul>
    {% for category in category_children %}
        <li>
            <img src="{{ asset('pub/src/DeskPRO/Bundle/PortalBundle/Resources/img/icon-view-more.png') }}">
            <a href="{{ path('portal_kb_browse', { slug: category.slug }) }}">
                {{ category.title }} - [{{ category.articles|length }}]
            </a>
        </li>
    {% endfor %}
</ul>
{% endif %}
