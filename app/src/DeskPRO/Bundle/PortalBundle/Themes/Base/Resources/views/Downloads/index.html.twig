{% extends 'Theme::layout.html.twig' %}

{% block inner_content %}
    <div class="breadcrumbs">
        {% show breadcrumbs %}
    </div>
    <div class="downloads main-downloads">
    <header class="section-header">
        <h1>{{ phrase('portal.downloads.section-title') }}</h1>

        <p>
            {{ phrase('portal.downloads.section-desc') }}
        </p>

        <a href="{{ path('portal_downloads', { _format: 'rss' }) }}">{{ phrase('portal.general.rss_subscribe') }} <i class="fa fa-rss"></i></a>
    </header>

    {% show section download_cats_simple %}
    </div>
{% endblock inner_content %}
