{% extends 'Theme::layout.html.twig' %}

{% block inner_content %}
    <div class="breadcrumbs">
        {% show breadcrumbs %}
    </div>
    <article class="feedback main-feedback">
        <div class="feedback-item">
            <div class="feedback-item-controls">
                <a href="{{ portal_path(item, 'vote_up') }}" class="i-agree post-link {% if user_up_voted(item) %} agreed{% endif %}">
                    <i class="fa fa-thumbs-up"></i>
                    <div>{{ phrase('portal.feedback.btn-vote') }}</div>
                    <span class="counter">{{ item.total_rating }}</span>
                </a>
                {# fav/stars feature not supported yet #}
                {#<a href="#" class="star">#}
                    {#<i class="fa fa-star-o"></i>#}
                    {#<div>2</div>#}
                {#</a>#}
            </div>


            <div class="feedback-item-content">
                <span class="feedback-status">
                    {% if item.status_category %}
                        <a href="{{ portal_path(item.status_category) }}">
                            {{ item.status_category }}
                        </a>
                    {% else %}
                        {{ item.status }}
                        {# no link here because it's a worse case fallback #}
                        {# every feedback should have a status_category! #}
                    {% endif %}
                </span>

                <span class="feedback-item-type"><a href="{{ portal_path(item.category) }}">{{ item.category }}</a></span>

                <div class="header-buttons">
                    {% show feedback_subscription_link %}
                    {#<a href="#">{{ phrase('portal.general.btn-email') }} <i class="fa fa-envelope"></i></a>#}
                    {#<a href="#">{{ phrase('portal.general.btn-print') }} <i class="fa fa-print"></i></a>#}
                    {#<a href="#">{{ phrase('portal.general.btn-download-pdf') }} <i class="fa fa-file-pdf-o"></i></a>#}
                </div>

                <h1>
                    <a href="{{ portal_path(item) }}">{{ item.title }}</a>
                </h1>

                <div class="comment">
                    <p>{{ item.content_html|raw }}</p>
                </div>

                <div class="feedback-item-meta">
                    <ul>
                        <li><i class="fa fa-user"></i> {{ item.person.display_name }}</li>
                        <li><a href="#comments"><i
                                        class="fa fa-comment"></i> {{ phrase('portal.general.comments-count', { count: item.num_comments }) }}</a></li>
                        {% if item.getCustomDataSelection() %}
                            <li><a href="#"><i class="fa fa-inbox"></i> {{ item.getCustomDataSelection().title }}</a>
                            </li>
                        {% endif %}
                        {% if item.labels|length %}
                            <li>
                                <i class="fa fa-tags"></i>
                                {% for l in item.labels %}
                                    <a
                                    href="{{ path('portal_search_labels', { label: l }) }}">{{ l }}</a>{% if not loop.last %}, {% endif %}
                                {% endfor %}
                            </li>
                        {% endif %}
                    </ul>
                </div>

                <div class="attached">
                    {% if item.attachments|length > 0 %}
                        <h3>{{ phrase('portal.feedback.attachments') }}</h3>
                        {% for attachment in item.attachments %}
                            <a href="{{ attachment.blob.downloadUrl }}" class="attachement">
                                {% if attachment.blob.is_image %}
                                    <img src="{{ attachment.blob.thumbnailUrl }}" alt="{{ attachment.blob.filename }}">
                                {% endif %}
                                {{ attachment.blob.filename }}
                                <span class="attachement-size">{{ attachment.blob.filesize }} bytes </span>
                            </a><br>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
        </div>
    </article>

    {% show feedback_ratings %}
    {% show related_content %}

    {% if item.num_comments or new_comment_form %}
        <div class="comment-box" id="comments">
            <div class="titled-header">
                <h1>{{ phrase('portal.general.comments-title', {count: item.num_comments}) }}</h1>
            </div>
            {% show feedback_comments %}
            {% show comment_form %}
        </div>
    {% endif %}

{% endblock inner_content %}
