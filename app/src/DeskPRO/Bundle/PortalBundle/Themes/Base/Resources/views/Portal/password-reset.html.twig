{% extends 'Theme::layout.html.twig' %}

{% block page_content %}

    {% if auth_manager.isForgotPasswordVisible %}
        <header class="section-header">
            <h1>Reset Your Password</h1>
        </header>

        {{ form_start(form) }}
        {{ form_rest(form) }}
        <button type="submit">Save Password</button>
        {{ form_end(form) }}
    {% endif %}

{% endblock page_content %}
