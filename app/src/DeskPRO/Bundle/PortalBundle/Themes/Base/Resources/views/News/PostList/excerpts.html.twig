{% import 'Theme::icons.html.twig' as icons %}
{% if pager|length %}
  <ul>
    {% for item in pager %}

      <li>

        <div class="news-header main-list">
          <div class="deskpro-calendar-decoration-flat">
            <div class="dcdf-month">{{ item.date_published | date('M') }}</div>
            <div class="dcdf-day">{{ item.date_published | date('j') }}</div>
          </div>

          <div class="news-header-info">
            <h1><a href="{{ portal_path(item) }}">{{ item.title }}</a></h1>
          </div>

          <div class="article-meta">
            {% if item.person %}{{ phrase('portal.general.by') }} <a href="#"><span style="background: url({{ avatar_url(item.person) }}) no-repeat; background-size: cover" class="agent-avatar agent-avatar-mini"></span> {{ item.person.name }}</a> {% endif %}
            <hr><!-- TODO add comment count and avatar on person -->
            <span class="comments"><i class="fa fa-comments-o"></i> <a href="#comments">10 Comments</a></span>
            <hr>
            {{ phrase('portal.general.in') }} <a href="{{ portal_path(item.category) }}">{{ item.category.title }}</a>
          </div>

          <div class="article-excerpt">
            <p>{{ item.getExcerptHtml|raw }}</p>
          </div>

        </div>

      </li>
    {% endfor %}
  </ul>
  {% if show_category_link %}
    <div class="list-meta">
      <a href="{{ category ? portal_path(category) : path('portal_news') }}">
        {{ phrase('portal.news.view-x-news', {count: pager|length}) }}{{ icons.view_more() }}
      </a>
    </div>
  {% endif %}
  {% if show_pager %}
    {% show news_pager %}
  {% endif %}
{% endif %}
