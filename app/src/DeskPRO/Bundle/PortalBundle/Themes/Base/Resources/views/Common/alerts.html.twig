{% if display_alerts %}
    <div class="alerts">
    {% if impersonator %}
        <div class="alert" style="border: 1px dotted black">
            {{ impersonator.display_name }}, you are impersonating the user: <strong> {{ user.display_name }} (ID #{{ user.id }})</strong>.
            <a style="float: right" href="{{ path('portal_logout', { _dp_impersonate_exit: 1 }) }}">exit impersonation mode</a>.
        </div>
    {% endif %}

    {% for saved in saved_forms %}
        <div class="alert" style="border: 1px dotted black">
            Your <strong>{{ saved.message }}</strong> has not be submitted yet. <a href="{{ saved.link }}">Continue</a>
        </div>
    {% endfor %}
    </div>
{% endif %}