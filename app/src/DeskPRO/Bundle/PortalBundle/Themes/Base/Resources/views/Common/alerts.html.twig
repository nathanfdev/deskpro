{% if display_alerts %}
    <div class="alerts">
    {% if impersonator %}
        <div class="admin-bar">
            <div class="wrapper">
            <ul>
                <li>
                    <a href="{{ path('portal_logout', { _dp_impersonate_exit: 1 }) }}">
                        <span>{{ phrase('portal.account.exit_impersonation') }}</span>
                    </a>
                </li>
                <li>
                    <a href="{{ path('portal_logout', { _dp_impersonate_exit: 1 }) }}">
                        <i>{{ impersonator.display_name }}</i>
                        {{ phrase('portal.account.impersonating') }}
                        <i>{{ user.display_name }}
                            ({{ phrase('portal.general.id') }}
                            #{{ user.id }})
                        </i>
                    </a>
                </li>
            </ul>
            </div>
        </div>
    {% endif %}

    {% for validation in validation_alerts %}
        <a href="{{ validation.resend_url ?: '' }}" class="alert">
            <i class="fa fa-times"></i> <strong>{{ validation.message }}</strong>
        </a>
    {% endfor %}

    {% for saved in saved_forms %}
        <a href="{{ saved.link }}" class="alert">
            <i class="fa fa-times"></i> {{ phrase('portal.account.login-saved-form', { type: saved.message }) }}
        </a>
    {% endfor %}
    </div>
{% endif %}
