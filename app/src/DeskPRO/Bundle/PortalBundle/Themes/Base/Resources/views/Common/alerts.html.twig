{% if display_alerts %}
    <div class="alerts">
    {% if impersonator %}
        <a class="alert" href="{{ path('portal_logout', { _dp_impersonate_exit: 1 }) }}">
            {{ impersonator.display_name }} {{ phrase('portal.account.impersonating') }} <strong>{{ user.display_name }} ({{ phrase('portal.general.id') }} #{{ user.id }})</strong> <a href="{{ path('portal_logout', { _dp_impersonate_exit: 1 }) }}">[{{ phrase('portal.account.exit_impersonation') }}]</a>
        </a>
    {% endif %}

    {% for saved in saved_forms %}
        <a href="{{ saved.link }}" class="alert">
            <i class="fa fa-times"></i> {{ phrase('portal.account.login-saved-form', { type: saved.message }) }}
        </a>
    {% endfor %}
    </div>
{% endif %}