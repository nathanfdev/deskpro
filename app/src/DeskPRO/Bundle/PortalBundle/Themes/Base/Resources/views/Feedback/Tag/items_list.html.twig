{% if pager|length > 0 %}
    <ul>
        {% for item in pager %}
        <li>
            <span class="thumbs"><i class="fa fa-thumbs-up"></i> {{ item.popularity }}</span>
            <a href="{{ path('portal_feedback_view', { slug: item.slug }) }}">{{ item.title }}</a>
        </li>
        {% endfor %}
    </ul>

    <div class="list-meta">
        <a href="{{ path('portal_feedback') }}">View <span>{{ pager|length }}</span> feedback items<img src="{{ asset('web/portal/base/img/icon-view-more.png') }}"></a>
    </div>
{% endif %}
