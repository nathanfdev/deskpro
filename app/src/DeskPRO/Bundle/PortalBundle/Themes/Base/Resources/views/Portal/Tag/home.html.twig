<section class="welcome-news">
  {# Uncomment this section to show a title/welcome message

  <div class="welcome-header">
    <h1>An excellent support site</h1>
    <h2>And an excellent subtitle under it</h2>
  </div>

  <div class="news-panel">
    <h1>Welcome to DeskPRO</h1>
    <p>You can get in touch with us using our Contact Us page, email us directly on <a href="mailto:support@deskpro.com">support@deskpro.com</a> or call us on 1-888-DESKPRO or (+44) 020-3582-1980. </p>
    <p>If you're an existing DeskPRO customer and you have a feature request, please look through our Feedback section and vote for it, or submit it if it's not already there.</p>
    <p>If you are a job candidate or recruiter, please contact us at jobs@deskpro.com.</p>
    <p>See our News section for details of recent updates.</p>
    <p>Follow us on social media to stay updated on new features, DeskPRO tips and interesting helpdesk/customer service articles.</p>
  </div>

  #}

  {% show section nav_buttons_big %}
</section>

{% if can_use_news() %}
<section>
  <article class="news front-page-news">
    <div class="large-title clearfix"><h1>News</h1></div>
    {% show section news_list_excerpts with { count: 2 } %}
  </article>
</section>
{% endif %}

{% if can_use_articles() %}
    <section>
      <article class="news front-page-kb">
        <div class="large-title clearfix"><h1>Knowledgebase</h1></div>
        {% show section kb with { articles_options: { count: 3 }} %}
      </article>
    </section>
{% endif %}

{% group min 2 %}
  <section class="with-{{ group.count }}-columns">
    {% item if has_any_news() %}
      <div class="column">
        <article class="panel-tiny front-page-downloads">
          <div class="large-title clearfix"><h1>Recent News</h1></div>
          {% show section news_list_simple with { count: 5 } %}
        </article>
      </div>
    {% enditem %}

    {% item if has_any_feedback() %}
      <div class="column">
        <article class="panel-tiny front-page-downloads">
          <div class="large-title clearfix"><h1>Recent Feedback</h1></div>
          {% show section feedback_items_list with { count: 5 } %}
        </article>
      </div>
    {% enditem %}

    {% item if has_any_downloads() %}
      <div class="column">
        <article class="panel-tiny front-page-downloads">
          <div class="large-title clearfix"><h1>Recent Downloads</h1></div>
          {% show section downloads_files_list with { count: 5 } %}
        </article>
      </div>
    {% enditem %}
  </section>
{% endgroup %}