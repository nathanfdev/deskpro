{% if is_granted('USE_NEWS') %}
<section>
    <div class="column-full">
        <article class="news front-page-news">
            <div class="large-title clearfix"><h1>News</h1></div>
            {{ this_news_posts_pretty({ count: 2 }) }}
        </article>
    </div>
</section>
{% endif %}

{% if is_granted('USE_ARTICLES') %}
    <section>
        {{ this_knowledgebase({ articles_options: { count: 3 }}) }}
    </section>
{% endif %}

<section>
    {% if is_granted('USE_NEWS') %}
    <div class="column-third">
        <article class="panel-tiny front-page-downloads">
            <div class="large-title clearfix"><h1>Recent News</h1></div>
            {{ this_news_posts_list({ count: 5 }) }}
        </article>
    </div>
    {% endif %}

    {% if is_granted('USE_FEEDBACK') %}
    <div class="column-third">
        <article class="panel-tiny front-page-downloads">
            <div class="large-title clearfix"><h1>Recent Feedback</h1></div>
            {{ this_feedback_items_list({ count: 5 }) }}
        </article>
    </div>
    {% endif %}

    {% if is_granted('USE_DOWNLOADS') %}
    <div class="column-third omega">
        <article class="panel-tiny front-page-downloads">
            <div class="large-title clearfix"><h1>Recent Downloads</h1></div>
            {{ this_downloads_files_list({ count: 5 }) }}
        </article>
    </div>
    {% endif %}
</section>
