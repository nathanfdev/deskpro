<div class="item reply">
  <span class="badge" style="background: url({{ avatar_url(msg.person, 50) }}) no-repeat; background-size: cover"></span>

  <h1>
    {% if msg.person is same as(app.user) %}
      {{ phrase('portal.tickets.timeline_you') }} <span>{{ phrase('portal.tickets.timeline_wrote') }}</span>
    {% else %}
      {{ msg.person.display_name_user }} <span>{{ phrase('portal.tickets.timeline_wrote') }}</span>
    {% endif %}
  </h1>

  <div class="comment user-reply">
    {{ render_message(msg) }}
    {% if msg.attachments|length > 0 %}
      <h3>{{ phrase('portal.tickets.attachments') }}</h3>
      {% for attachment in msg.attachments %}
        <a href="{{ attachment.blob.downloadUrl }}" class="attachement">
          {% if attachment.blob.is_image %}
            <img src="{{ attachment.blob.thumbnailUrl }}" alt="{{ attachment.blob.filename }}">
          {% endif %}
          {{ attachment.blob.filename }}
          <span class="attachement-size">{{ attachment.blob.filesize }} {{ phrase('portal.tickets.file_size_bytes') }}</span>
        </a><br>
      {% endfor %}
    {% endif %}
  </div>
</div>