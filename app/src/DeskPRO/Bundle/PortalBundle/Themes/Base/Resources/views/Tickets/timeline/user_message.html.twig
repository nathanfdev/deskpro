{% import 'Theme:Tickets:macros.html.twig' as macros %}
<div class="ticket-message user-message">
  <div class="ticket-owner">
    <div class="ticket-action-date">{{ msg.date_created|date('full') }}</div>
    {{ macros.person_inline(msg.person) }}
    <span>wrote:</span>
  </div>

  <div class="ticket-message-content">
    {{ render_message(msg) }}
  </div>
  {% if msg.attachments|length > 0 %}
    <div class="ticket-message-files">
      <h1>Attached with this message:</h1>
      <ul>
        {% for attachment in msg.attachments %}
          <li>
            <a href="{{ attachment.blob.downloadUrl }}">
              {% if attachment.blob.is_image %}
                <img src="{{ attachment.blob.thumbnailUrl }}" alt="{{ attachment.blob.filename }}">
              {% endif %}
              <i class="fa fa-file-text-o"></i> {{ attachment.blob.filename }} <span class="attachement-size">{{ attachment.blob.filesize }} {{ phrase('portal.tickets.file_size_bytes') }}</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}
</div>

