{% extends 'Theme::layout.html.twig' %}

{% block page_content %}
    <div class="breadcrumbs">
        {% show breadcrumbs %}
    </div>

    {% if auth_manager.isAuthVisible %}
        <header class="section-header">
            <h1>{{ phrase('portal.account.section-title-login') }}</h1>
        </header>

        {% if reset_success %}
            <strong>{{ phrase('portal.account.reset-password-success') }}</strong>
        {% endif %}

        {% if set_password_success %}
            <strong>{{ phrase('portal.account.set-password-success') }}</strong>
        {% endif %}

        {% if login_error %}
            <div class="error"
                 style="border: 2px solid black; background-color: firebrick;  color:black; font-weight:bold; display: block; padding:5px; margin: 8px;">
                {{ phrase('portal.account.login-invalid') }}
            </div>
        {% endif %}

        {% if lockout_error %}
            <div class="error"
                 style="border: 2px solid black; background-color: firebrick;  color:black; font-weight:bold; display: block; padding:5px; margin: 8px;">
                {{ phrase('portal.account.login-lockout') }}
            </div>
        {% endif %}

        {% if login_captcha_failed %}
            <div class="error"
                 style="border: 2px solid black; background-color: firebrick;  color:black; font-weight:bold; display: block; padding:5px; margin: 8px;">
                {{ phrase('portal.account.login-captcha-failed') }}
            </div>
        {% endif %}

        {% if saved_form %}
            <div class="error"
                 style="border: 2px solid black; background-color: firebrick;  color:black; font-weight:bold; display: block; padding:5px; margin: 8px;">
                <p>{{ phrase('portal.account.login-saved-form', { type: saved_form_message }) }}</p>
            </div>
        {% endif %}

        {% if auth_manager.isLoginFormVisible %}
            <form id="login" class="form-ticket" action="{{ path('portal_login_submit') }}" method="post" novalidate>
                <input type="hidden" name="_failure_path" value="{{ path('portal_login', {retry:'auth'}) }}"/>

                <div class="column-half">
                    <div class="bucket">
                        <label class="title{% if login_error %} error{% endif %}">{{ phrase('portal.account.login-email') }}</label>
                        <input type="text" tabindex="1" placeholder="Email" name="username" value="{{ last_username }}">
                    </div>
                </div>

                <div class="column-half omega">
                    <div class="bucket">

                        {% if auth_manager.isForgotPasswordVisible %}
                            <div class="form-meta form-meta-grey"><a href="{{ path('portal_reset_password') }}">{{ phrase('portal.account.login-password-reminder') }}</a></div>
                        {% endif %}
                        <label class="title{% if login_error %} error{% endif %}">{{ phrase('portal.account.login-password') }}</label>
                        <input type="password" tabindex="1" placeholder="Your password" name="password">
                    </div>
                </div>

                {% if captcha_form is not null %}
                    {{ form_widget(captcha_form) }}
                {% endif %}

                {% if auth_manager.isRememberMeEnabled %}
                    <div class="column-full">
                        <div class="bucket">
                            <button class="button" tabindex="1">{{ phrase('portal.account.login-btn') }}</button>
                            <div class="remember-me"><label for="remember_me">
                                    <input tabindex="1" type="checkbox" name="remember_me">
                                    {{ phrase('portal.account.login-remember') }}
                                </label>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </form>
        {% endif %}

        {% if auth_manager.hasLoginIconUsersources or auth_manager.hasLoginTextButtonUsersources %}
        <div class="column-full">
            <div class="bucket">
                <div class="titled-header-left">
                    <h2>{{ phrase('portal.account.login-external') }}</h2>
                </div>

                {# twitter, facebook, google (the old "icon" usersources) #}
                {% if auth_manager.hasLoginIconUsersources %}
                    {% for usersource in auth_manager.getLoginIconUsersources %}
                        <a href="{{ path('portal_login_authenticate', {'usersource_id': usersource.id}) }}"
                           class="button auth-{{ usersource.adapter.codeName|lower }}"><i
                                    class="fa fa-{{ usersource.adapter.codeName|lower }}"></i> Login
                            with {{ usersource.adapter.codeName|title }}</a>
                    {% endfor %}
                {% endif %}

                {# the newer "text button" usersources #}
                {% if auth_manager.hasLoginTextButtonUsersources %}
                    {% for usersource in auth_manager.getLoginTextButtonUsersources %}
                        <a href="{{ path('portal_login_authenticate', {'usersource_id': usersource.id}) }}"
                           class="button">{{ usersource.options.login_custom_text }}</a>
                    {% endfor %}
                {% endif %}
            </div>
        </div>
        {% endif %}

        {% if auth_manager.isRegistrationFormVisible %}
            <div class="column-full">
                <div class="bucket">
                    <div class="titled-header-left">
                        <h2>{{ phrase('portal.account.login-register-header') }}</h2>
                    </div>

                   <a class="button button-secondary" href="{{ path('portal_user_registration') }}">{{ phrase('portal.account.login-register-btn') }}</a>
                </div>
            </div>
        {% endif %}
    {% endif %}
{% endblock page_content %}
