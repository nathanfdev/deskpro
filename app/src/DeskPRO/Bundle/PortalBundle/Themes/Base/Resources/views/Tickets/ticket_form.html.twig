<style>
    .form-error {
        color: red;
        border: 1px solid red;
    }

    .deskpro-form-widget {
        margin-bottom: 15px;
    }

    .deskpro-date-form-widget select {
        width: 30%;
    }
</style>
<div class="dp_ticket_form dpx-form">
    {{ form_errors(form) }}
    {{ form_start(form, { attr: { class: 'form-ticket' } }) }}
    <div class="dynamic-fields-container">
        {% for widget in form.children if widget.vars.name not in ['_token', '_dp_csrf_token'] %}
            <div class="deskpro-form-widget field_{{ widget.vars.name }} {% if widget.vars.valid is defined and not widget.vars.valid %} form-error{% endif %}"
                 data-field="{{ widget.vars.name }}">
                {{ form_row(widget) }}
                {#<div class="bucket">#}
                {#{{ form_label(widget) }}#}
                {#{{ form_widget(widget) }}#}
                {#{% if widget.vars.valid is defined %}#}
                {#{{ form_errors(widget) }}#}
                {#{% endif %}#}
                {#</div>#}
            </div>
        {% endfor %}
    </div>
    {{ form_rest(form) }}
    {{ form_end(form) }}
</div>
