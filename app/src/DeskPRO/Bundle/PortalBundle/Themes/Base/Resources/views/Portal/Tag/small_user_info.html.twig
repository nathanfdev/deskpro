{% if is_guest() %}
  {% if display_registration_link %}
    <li>
      <a href="{{ path('portal_user_registration') }}" class="button-small button-signup">Create a new account</a>
    </li>
  {% endif %}

  <li>
    <a href="{{ path('portal_login') }}" class="button-small button-login">Log In <i class="fa fa-caret-down"></i></a>
  </li>
{% else %}
  <li class="welcome">
    Welcome back {{ app.name }}
    &middot; <a href="{{ path('portal_user_profile') }}">Your Account</a>
    {% if ticket_count %}
      &middot; <a href="{{ path('portal_tickets') }}">Tickets ({{ ticket_count }})</a>
    {% endif %}
  </li>
  <li>
    <a href="{{ path('portal_logout') }}" class="button-small button-login">Log Out</a>
  </li>
{% endif %}
