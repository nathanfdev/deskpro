{% if pager|length > 0 %}
    <ul class="download-list">
        {% for dl in pager %}
            <li>
                <div class="controls">
                    <ul>
                        {%- if dl.num_comments > 0 -%}
                            <li>
                                <a href="{{ portal_path(dl) }}#comments">
                                    <i class="fa fa-comments"></i>
                                    {{ phrase('portal.general.comments-count', {count: dl.num_comments}) }}
                                </a>
                            </li>
                        {%- endif -%}
                        <li class="the-file">
                            <a href="{{ portal_path(dl, 'serve') }}">
                                {{ phrase('portal.downloads.download') }}
                                <i class="fa fa-download"></i>
                            </a>
                        </li><li class="the-cudos as-vote-widget"><a href="{{ portal_path(dl, 'vote_up') }}" class="post-link as-vote-btn"><i class="fa fa-thumbs-up as-vote-animate"></i> <span class="as-vote-count" data-votes="{{ dl.total_rating }}">{{ dl.total_rating }}</span></a></li>
                    </ul>
                </div>

                <h1>
                    {{ content_icon(dl) }}
                    <a href="{{ portal_path(dl) }}">
                        {{ dl.realTitle }}
                    </a>
                </h1>
                <span class="date">{{ phrase('portal.downloads.uploaded-on') }}: {{ dl.date_created | date('Y-m-d') }}</span>

                <p>
                    {{ dl.content_desc|raw }}
                </p>
            </li>
        {% endfor %}
    </ul>
    {% if show_category_link %}
        <div class="list-meta">
            <a href="{{ category ? portal_path(category) : path('portal_downloads') }}">
                {{ phrase('portal.downloads.view-x-files', {count: pager|length}) }}
                <i class="fa fa-caret-right"></i>
            </a>
        </div>
    {% endif %}
    {% if show_pager %}
        {% show download_pager %}
    {% endif %}
{% else %}
    <strong>{{ phrase('portal.downloads.none') }}</strong>
{% endif %}
