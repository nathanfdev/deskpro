{% if pager|length > 0 %}
    <ul class="download-list">
        {% for dl in pager %}
            <li>
                <div class="controls">
                    <ul>
                        <li class="the-file"><a href="{{ path('portal_downloads_view', { slug: dl.slug }) }}">{{ phrase('portal.downloads.download') }}
                        <i class="fa fa-file-pdf-o"></i></a></li>
                        {% if dl.num_comments > 0 %}
                            <li>
                                <a href="{{ path('portal_news_view', { slug: dl.slug }) }}#comments">
                                    <i class="fa fa-comments"></i>
                                    {{ phrase('portal.general.comments-count', {count: dl.num_comments}) }}
                                </a>
                            </li>
                        {% endif %}
                        <li class="the-cudos has-cudos"><a href="{{ path('portal_downloads_vote_up', { slug: dl.slug }) }}"><i class="fa fa-thumbs-up"></i> {{ dl.total_rating }}</a></li>
                    </ul>
                </div>

                <h1><a href="{{ path('portal_downloads_view', { slug: dl.slug }) }}"><i class="fa fa-file-pdf-o"></i> {{ dl.realTitle }}</a></h1>
                <span class="date">{{ phrase('portal.downloads.uploaded-on') }}: {{ dl.date_created | date('Y-m-d') }}</span>

                <p>
                    {{ dl.content_html|raw }}
                </p>
            </li>
        {% endfor %}
    </ul>
    {% if show_category_link %}
        <div class="list-meta">
            <a href="{{ category ? path('portal_downloads_browse', { slug: category.slug }) : path('portal_downloads') }}">
                {{ phrase('portal.downloads.view-x-files', {count: pager|length}) }}
                <i class="fa fa-caret-right"></i>
            </a>
        </div>
    {% endif %}
{% else %}
    <strong>{{ phrase('portal.downloads.none') }}</strong>
{% endif %}
