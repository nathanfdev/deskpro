{% if brand_setting('user.downloads_subscriptions') %}
    <a href="{{ path('portal_downloads_category_toggle_subscription', { slug: category.slug }) }}">
        {% if is_subscribed %}
            {{ phrase('portal.general.category-subscribed') }} |
            {{ phrase('portal.general.unsubscribe-to-category') }}
        {% else %}
            {{ phrase('portal.general.subscribe-to-category') }}
        {% endif %}
    </a>
{% endif %}
