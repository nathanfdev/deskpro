{% for category in category_children %}
    <div class="column-half{% if loop.index0 % 2 == 1 %} omega{% endif %}">
        <article class="article-categories">
            <header>
                <h1>
                    <img src="{{ asset('pub/src/DeskPRO/Bundle/PortalBundle/Resources/img/icon-view-more.png') }}"> <a href="{{ path('portal_downloads_browse', { slug: category.slug }) }}">{{ category.title }}</a> (X)</h1>
                <hr>
            </header>

            {{ this_downloads_files_simple({category: category.id}) }}
        </article>
    </div>
{% endfor %}
