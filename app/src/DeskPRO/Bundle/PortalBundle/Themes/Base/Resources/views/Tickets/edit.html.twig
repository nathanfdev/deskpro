{% extends 'Theme::layout.html.twig' %}

{% block inner_content %}
    <div class="breadcrumbs">
        {% show breadcrumbs %}
    </div>

    {% if rerendering %}
        <strong>{{ phrase('portal.tickets.switched-department-rerender') }}</strong>
    {% endif %}

    {% show ticket_form %}

    <a href="{{ path('portal_tickets_view', { id: ticket.id }) }}">{{ phrase('portal.tickets.cancel-ticket-edit') }}</a>
{% endblock inner_content %}
