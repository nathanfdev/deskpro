{% if category_children|length > 0 %}
    {% for category in category_children %}
        <div class="column-half{% if loop.index0 % 2 == 1 %} omega{% endif %}">
            <article class="article-categories">
                <header>
                    <h1>
                        <a href="{{ path('portal_kb_browse', { slug: category.slug }) }}">{{ category.title }}</a>
                        ({{ category.articles|length }})
                    </h1>
                    <hr>
                </header>

                {{ this_knowledgebase_articles_forcat({ category: category })|raw }}
            </article>
        </div>
    {% endfor %}
{% endif %}
