{% if category_children|length > 0 %}
    {% for category in category_children %}
        <div class="column-half{% if loop.index0 % 2 == 1 %} omega{% endif %}">
            <article class="article-categories">
                <header>
                    <h1>
                        <img src="{{ asset('pub/src/DeskPRO/Bundle/PortalBundle/Resources/img/icon-view-more.png') }}"> {{ category.title }}
                        ({{ category.articles|length }})</h1>
                    <hr>
                </header>

                {{ knowledgebase_articles_forcat({ category: category }) }}
            </article>
        </div>
    {% endfor %}
{% endif %}
