{% extends 'Theme::layout.html.twig' %}

{% block page_content %}

    {% if auth_manager.isForgotPasswordVisible %}
        <header class="section-header">
            <h1>Forgot your password?</h1>
        </header>

       Fill out this form to have a password reset link sent to you.

        {% if render_error %}
            <strong>Error: please enter a valid email address or username</strong>
        {% endif %}

        {{ form_start(form) }}
        {{ form_rest(form) }}
        <button type="submit">Reset Password</button>
        {{ form_end(form) }}
    {% endif %}

{% endblock page_content %}
