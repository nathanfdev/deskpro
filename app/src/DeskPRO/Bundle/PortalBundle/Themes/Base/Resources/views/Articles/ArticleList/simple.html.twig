{% import 'Theme::icons.html.twig' as icons %}
<div class="content-list-wrap simple as-articles {% if pager|length %}with-items{% else %}with-no-items{% endif %}">
  {% if pager|length %}
    <ul class="content-list">
      {% for article in pager %}
        <li>
          <a href="{{ path('portal_kb_view', { slug: article.slug }) }}">{{ article.realTitle }}</a>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <strong>{{ phrase('portal.articles.none') }}</strong>
  {% endif %}

  {% if show_category_link %}
    <div class="list-meta">
      <a href="{{ category ? path('portal_kb_browse', { slug: category.slug }) : path('portal_kb') }}">
        {{ phrase('portal.articles.view-x-articles', {count: pager|length}) }}{{ icons.view_more() }}
      </a>
    </div>
  {% endif %}
</div>