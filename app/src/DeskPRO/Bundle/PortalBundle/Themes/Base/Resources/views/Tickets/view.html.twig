{% extends 'Theme::layout.html.twig' %}

{% block inner_content %}
  <div class="breadcrumbs">
    {% show breadcrumbs %}
  </div>
  <article class="ticket-page" id="ticket_view_page">
    <div class="container">
      <div class="column-full">

        <div class="ticket-view">
          <!-- Sidebar with the agents in this ticket, ref etc -->
          <div class="ticket-view-sidebar-wrapper">

            <div class="ticket-view-sidebar">
              {% if can_edit %}
                <a href="{{ portal_path(ticket, 'resolve') }}" class="ticket-sidebar-close-ticket">Close this ticket</a>
              {% endif %}
            </div>

            <div class="ticket-view-sidebar">

              <div class="ticket-sidebar-container ticket-sidebar-info">
                <h1>Ticket info:</h1>
                <ul class="major">
                    <li>
                      <span class="sidebar-small-title">Assigned agent:</span>
                      <ul>
                        <li>
                          <a href="#" class="sidebar-person">
                            <span class="agent-avatar agent-avatar-mid" style="background-image: url({{ avatar_url(ticket.agent, 36) }});"><span class="remove-agent"></span></span>
                          <span class="avatar-meta">
                            {% if ticket.agent %}
                            <span class="primary">{{ ticket.agent.display_name }}</span>
                            <span class="secondary">{{ ticket.agent.primary_email.email }}</span>
                            {% else %}
                              <span class="primary">Unassigned</span>
                            {% endif %}
                          </span>
                          </a>
                        </li>
                      </ul>
                    </li>


                  <li>
                    <span class="sidebar-small-title">Ticket opened by:</span>
                    <ul>
                      <li>
                        <a href="#" class="sidebar-person">
                          <span class="agent-avatar agent-avatar-mid" style="background-image: url({{ avatar_url(ticket.person, 36) }});"></span>
                          <span class="avatar-meta">
                            <span class="primary single">{{ ticket.person.primary_email_address }}</span>
                          </span>
                        </a>
                      </li>
                    </ul>
                  </li>

