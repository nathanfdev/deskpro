                          {#<span class="avatar-meta">#}
                            {#<span class="primary single">Add a CC'ed user</span>#}
                          {#</span>#}
                        {#</a>#}

                        {#<div class="add-cc-user-popover" style="display: none;">#}
                          {#<form>#}

                            {#<div class="column-full">#}
                              {#<div>#}
                                {#<div class="bucket">#}
                                  {#<label class="title">Your Name: *</label>#}
                                  {#<input placeholder="Name (required)" type="text">#}
                                {#</div>#}

                                {#<div class="bucket">#}
                                  {#<label class="title">Your Email: *</label>#}
                                  {#<input placeholder="Email:" type="text">#}
                                {#</div>#}

                                {#<div class="bucket">#}
                                  {#<input type="submit" value="Lorel Ipsum">#}
