{% extends 'Theme::layout.html.twig' %}
{% import 'Theme:Tickets:macros.html.twig' as macros %}

{% block inner_content %}
  <div class="breadcrumbs">
    {% show breadcrumbs %}
  </div>
  <article class="ticket-page" id="ticket_view_page">
    <div class="container">
      <div class="column-full">

        {% if ticket.isAwaitingUser() %}
          {# AWAITING USER #}
        <div class="ticket-view-note-for-user agent-has-replied">
          An agent is waiting for you to reply to a message. <a href="#ticket-reply-form">Click here to scroll down to the form.</a>
        </div>
        {% elseif ticket.isAwaitingAgent() %}
          {# AWAITING AGENT #}
        <div class="ticket-view-note-for-user">

          {% if ticket.date_last_user_reply and ticket.messages|length > 1 %}
            <span class="note-for-user-blue">Your last message was sent {{ date_ago(ticket.date_last_user_reply) }}.</span>
          {% else %}
            <span class="note-for-user-blue">You created this ticket {{ date_ago(ticket.date_created) }}.</span>
          {% endif %}

           We have received your message &amp; will send an email notification as soon as an agent has added a comment.
        </div>
        {% else %}
          {# RESOLVED #}
          <div class="ticket-view-note-for-user">

            {% if ticket.date_resolved %}
            <span class="note-for-user-blue">This ticket was closed {{ date_ago(ticket.date_resolved) }}.</span>
              {% endif %}

              You can <a href="{{ path('portal_kb') }}">return to the knowledge base</a> or <a href="{{ path('portal_new_ticket') }}">open a new ticket</a>.
          </div>
        {% endif %}

        <div class="ticket-view">
          <!-- Sidebar with the agents in this ticket, ref etc -->
          <div class="ticket-view-sidebar-wrapper">

            <div class="ticket-view-sidebar">
              {% if can_edit %}
                <a href="{{ portal_path(ticket, 'resolve') }}" class="ticket-sidebar-close-ticket post-link">Close this ticket</a>
              {% endif %}
            </div>

            <div class="ticket-view-sidebar">
              <div class="ticket-sidebar-container ticket-sidebar-info">
                <h1>Ticket info:</h1>
                <ul class="major">
                  <li>
                    <span class="sidebar-small-title">Assigned agent:</span>
                    <ul>
                      <li>
                        <a href="#" class="sidebar-person">
                          {{ macros.person_badge(ticket.agent) }}
                        </a>
                      </li>
                    </ul>
                  </li>

                  <li>
                    <span class="sidebar-small-title">Ticket opened by:</span>
                    <ul>
                      <li>
                        <a href="#" class="sidebar-person">
                          {{ macros.person_badge(ticket.person) }}
                        </a>
                      </li>
                    </ul>
                  </li>

                  <li>
                    <span class="sidebar-small-title">Also on this ticket:</span>
                    <ul>
                      {% for participant in ticket.participants %}
                        <li>
                          <a href="{{ path('portal_tickets_cc_remove', { ticket_ref: ticket_public_id(ticket), cc_id: participant.id }) }}" class="sidebar-person post-link">
                            {{ macros.person_badge(participant.person) }}
                          </a>
                        </li>
                      {% endfor %}
                      <li>
                        <a href="#" class="sidebar-person add-person clickaway-dropdown" data-clickaway-target="add-cc-user-popover">
                          <span class="agent-avatar agent-avatar-mid"><i class="fa fa-plus"></i></span>
                          <span class="avatar-meta">
                            <span class="primary single">Add a CC'ed user</span>
                          </span>
                        </a>

                        <div class="add-cc-user-popover" id="add-cc-user-popover" style="display: none;">
                          <form action="{{ portal_path(ticket, 'add-cc') }}" method="POST">

                            <div class="column-full">
                              <div>
                                <div class="bucket">
                                  <label class="title">Your Name: *</label>
                                  <input placeholder="Name (required)" name="name" type="text" required>
                                </div>

                                <div class="bucket">
                                  <label class="title">Your Email: *</label>
                                  <input name="email" placeholder="Email:" type="text" required>
                                </div>

                                <div class="bucket">
                                  <input type="submit" value="Add To Ticket">
                                </div>
                              </div>
                            </div>
                          </form>
                        </div>
                      </li>
                    </ul>
                  </li>

                  <li>
                    <span class="sidebar-small-title">{{ phrase('portal.tickets.ticket-ref') }}</span>
                    <ul>
                      <li>{{ ticket_public_id(ticket) }}</li>
                    </ul>
                  </li>
                </ul>
              </div>

              {% if ticket.attachments|length > 0 %}
              <div class="ticket-sidebar-container ticket-sidebar-media">
                <h1>Media on this ticket:</h1>
                <ul>
                  {% for attachment in ticket.attachments %}
                  <li>
                      {{ macros.attachment_inline(attachment) }}
                  </li>
                  {% endfor %}
                </ul>
              </div>
              {% endif %}

              <div class="ticket-sidebar-container ticket-sidebar-meta">
                {% if can_edit %}
                  <a href="{{ portal_path(ticket, 'edit') }}" class="sidebar-edit">Edit <i class="fa fa-edit"></i></a>
                {% endif %}
                <h1>Additional ticket information:</h1>
                <ul>
                  {# see the TicketViewService in AppBundle's data services #}
                  {% for property in ticket_view.properties %}
                    {% if property.isVisible %}
                      <li>
                        <h3>{{ property.label }}</h3>
                        <p>{{ property.value }}</p>
                      </li>
                    {% endif %}
                  {% endfor %}
                </ul>
              </div>
            </div>
          </div>

          <!-- Ticket title -->
          <div class="header">
            <h1>{{ ticket.subject }}</h1>
          </div>
          <!-- All the messages -->
          <div class="ticket-messages">
            {% show ticket_timeline %}
            {% show ticket_reply %}
          </div>
        </div>

      </div><!-- end .column-half-plus -->

    </div>
  </article>
{% endblock inner_content %}
