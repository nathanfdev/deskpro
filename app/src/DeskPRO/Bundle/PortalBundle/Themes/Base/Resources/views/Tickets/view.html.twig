                          {#<span class="avatar-meta">#}
                            {#<span class="primary">Kurt Vargas</span>#}
                            {#<span class="secondary">kurt.vargas75@example.com</span>#}
                          {#</span>#}
                        {#</a>#}
                      {#</li>#}

                      {#<li>#}
                        {#<a href="#" class="sidebar-person">#}
