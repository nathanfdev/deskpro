{% for line in timeline %}
  {% if line.type == 'ticket_created' %}
    <div class="ticket-message">
      <div class="ticket-owner">
        <span class="agent-avatar agent-avatar-mid" style="background-image: url({{ avatar_url(line.person, 36) }});"></span>
        <a href="#" class="ticket-owner-name">{{ line.person.display_name }}</a>
        <span class="ticket-owner-email">({{ line.person.primary_email_address }})</span>
        <span>opened this ticket</span>
        <span class="ticket-actual-date">({{ line.datetime|date('m/d/Y') }})</span>
      </div>
    </div>
    {#<div class="item">#}
      {#<span class="badge"><i class="fa fa-star"></i></span>#}
      {#<h1><strong>{{ phrase('portal.tickets.timeline_opened') }}</strong> {{ phrase('portal.general.by') }} {{ line.person.display_name_user }}</h1>#}
      {#<span class="event-happened-at">{{ line.datetime|date('full') }}</span>#}
    {#</div>#}
  {% elseif line.type == 'ticket_reopened' %}
    <div class="ticket-message">
      <div class="ticket-owner">
        <div class="ticket-action-date">{{ line.datetime|date('full') }}</div>
        <span class="agent-avatar agent-avatar-mid" style="background-image: url({{ avatar_url(line.person, 36) }});"></span>
        <a href="#" class="ticket-owner-name">{{ line.person.display_name }}</a>
        <span class="ticket-owner-email">({{ line.person.primary_email_address }})</span>
        <span>reopened this ticket.</span>
      </div>
    </div>
    {#<div class="item">#}
      {#<span class="badge"><i class="fa fa-star"></i></span>#}
      {#<h1><strong>{{ phrase('portal.tickets.timeline_re_opened') }}</strong> {{ phrase('portal.general.by') }} {{ line.person.display_name }}</h1>#}
      {#<span class="event-happened-at">{{ line.datetime|date('full') }}</span>#}
    {#</div>#}
  {% elseif line.type == 'ticket_closed' %}
    <div class="ticket-message">
      <div class="ticket-owner">
        <div class="ticket-action-date">{{ line.datetime|date('full') }}</div>
        <span class="agent-avatar agent-avatar-mid" style="background-image: url({{ avatar_url(ticket.person, 36) }});"></span>
        <a href="#" class="ticket-owner-name">{{ line.person.display_name }}</a>
        <span class="ticket-owner-email">({{ line.person.primary_email_address }})</span>
        <span>marked this ticket:</span>
        <span class="mark-resolved">Resolved</span>
      </div>
    </div>
    {#<div class="item">#}
      {#<span class="badge"><i class="fa fa-star"></i></span>#}
      {#<h1><strong>{{ phrase('portal.tickets.timeline_closed') }}</strong> {{ phrase('portal.general.by') }} </h1>#}
      {#<span class="event-happened-at">{{ line.datetime|date('full') }}</span>#}
    {#</div>#}
  {% elseif line.type == 'agent_message' %}
    {% set msg = line.message %}
    {% include 'Theme:Tickets:timeline/agent_message.html.twig' %}
  {% elseif line.type == 'user_message' %}
    {% set msg = line.message %}
    {% include 'Theme:Tickets:timeline/user_message.html.twig' %}
  {% endif %}
{% endfor %}