{% extends 'Theme::layout.html.twig' %}

{% block inner_content %}
    <div class="breadcrumbs">
        {% show breadcrumbs %}
    </div>
    <div class="search-results">
        <div class="search-results-sidebar">
            <div class="search-result-filters">
                <form method="GET" novalidate>
                    <div class="box-header">Search Filter</div>
                    <label class="box">
                        <input type="text" name="q" value="{{ query }}" style="width: 100%; border: 1px solid #fff0ec;" />
                    </label>
                    {% if can_use_articles() %}
                    <hr />
                    <label class="box">
                        <span class="kb-checkbox-wrapper">
                          <input type="checkbox" name="types[]" value="article" {% if 'article' in limit_types %} checked="checked"{% endif %}>
                          <span class="kb-checkbox-title">{{ phrase('portal.articles.section-title') }}</span>
                        </span>
                    </label>
                    {% endif %}
                    {% if can_use_news() %}
                    <hr />
                    <label class="box">
                        <span class="kb-checkbox-wrapper">
                          <input type="checkbox" name="types[]" value="news" {% if 'news' in limit_types %} checked="checked"{% endif %}>
                          <span class="kb-checkbox-title">{{ phrase('portal.news.section-title') }}</span>
                        </span>
                    </label>
                    {% endif %}
                    {% if can_use_downloads() %}
                    <hr />
                    <label class="box">
                        <span class="kb-checkbox-wrapper">
                          <input type="checkbox" name="types[]" value="download" {% if 'download' in limit_types %} checked="checked"{% endif %}>
                          <span class="kb-checkbox-title">{{ phrase('portal.downloads.section-title') }}</span>
                        </span>
                    </label>
                    {% endif %}
                    {% if can_use_feedback() %}
                    <hr />
                    <label class="box">
                        <span class="kb-checkbox-wrapper">
                          <input type="checkbox" name="types[]" value="feedback" {% if 'feedback' in limit_types %} checked="checked"{% endif %}>
                          <span class="kb-checkbox-title">{{ phrase('portal.feedback.section-title') }}</span>
                        </span>
                    </label>
                    {% endif %}
                    <hr />
                    <div style="width: 100%; text-align: center; margin-top:5px;">
                        <button type="submit" style="width: 80%; margin-top: 12px;">Search</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="search-results-content">
                <div class="search-result-count">
                    {% if pageinfo.total_results %}
                        {{ phrase('portal.general.x-search-results', { num: num_results, query: query }) }}
                    {% else %}
                        {{ phrase('portal.general.no-search-results') }}
                    {% endif %}
                </div>
            {% if not is_search %}
                {{ phrase('portal.general.no-search-query') }}
            {% else %}
                <div class="search-results">
                    <div class="search-results-content">
                        {% if results|length > 0 %}
                            <ul class="search-result-items">
                                {% for result_item in results %}
                                    {% set result = result_item['object'] %}
                                    {% set type = result_item['type'] %}
                                    <li class="search-result-item">
                                        <h1><a href="{{ portal_path(result) }}">{{ result.title }}</a></h1>
                                        <div class="search-result-meta">
                                            {% set cats = get_secure_content_cats(result) %}
                                            {% if cats|length > 0 %}
                                            <i class="fa fa-tags"></i>
                                            {% for cat in cats %}
                                                <a href="{{ portal_path(cat) }}">
                                                    {% if cat.title is defined %}
                                                        {{ cat.title }}
                                                    {% elseif cat.name is defined %}
                                                        {{ cat.name }}
                                                    {% else %}
                                                        {{ portal_path(cat) }}
                                                    {% endif %}
                                                </a>
                                                {% if not loop.last %}
                                                    <i class="fa fa-angle-right"></i>
                                                {% endif %}
                                            {% endfor %}
                                            {% endif %}
                                            {% if result.date_published is not null %}
                                                <hr>
                                                <span>{{ date(result.date_published) }}</span>
                                            {% endif %}
                                            {% if result.num_comments > 0 %}
                                                <hr>
                                                <a href="{{ portal_path(result) }}#comments">
                                                    {{ phrase('portal.general.comments-count', { count: result.num_comments }) }}
                                                </a>
                                            {% endif %}
                                        </div>
                                        <p>{{ result.search_summary }}</p>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                        {% if pager.haveToPaginate %}
                            {{ pagerfanta(pager) }}
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock inner_content %}
