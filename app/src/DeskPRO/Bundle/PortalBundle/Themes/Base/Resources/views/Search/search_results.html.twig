{% extends 'Theme::layout.html.twig' %}
{% import 'Theme:Search:search_macros.html.twig' as search_macros %}

{% block inner_content %}
    <div class="breadcrumbs">
        {% show breadcrumbs %}
    </div>

    {% set article_info = results['article'] is defined ? results['article']['pageinfo'] : null %}
    {% set article_results = results['article'] in results ? results['article']['results'] : null %}
    {% set news_info = results['news'] in results ? results['news']['pageinfo'] : null %}
    {% set news_results = results['news'] in results ? results['news']['results'] : null %}
    {% set feedback_info = results['feedback'] in results ? results['feedback']['pageinfo'] : null %}
    {% set feedback_results = results['feedback'] in results ? results['feedback']['results'] : null %}
    {% set download_info = results['download'] in results ? results['download']['pageinfo'] : null %}
    {% set download_results = results['download'] in results ? results['download']['results'] : null %}

    <div class="search-result-controls">
          <h1>{{ phrase('portal.general.x-search-results-no-query', { num: combined['total_results'] }) }}</h1>
          <ul>
              {% if can_use_articles() and article_info %}
            <li><a href="#"><i class="fa fa-list-alt"></i><span class="title">{{ phrase('portal.articles.search-title') }} <span class="count">({{ article_info['total_results'] }})</span></span></a></li>
              {% endif %}

              {% if can_use_news() and news_info %}
            <li><a href="#"><i class="fa fa-calendar-o"></i><span class="title">{{ phrase('portal.news.search-title') }} <span class="count">({{ news_info['total_results'] }})</span></span></a></li>
              {% endif %}

              {% if can_use_feedback() and feedback_info %}
            <li><a href="#"><i class="fa fa-thumbs-o-up"></i><span class="title">{{ phrase('portal.feedback.search-title') }} <span class="count">({{ feedback_info['total_results'] }})</span></span></a></li>
              {% endif %}

              {% if can_use_downloads() and download_info %}
            <li><a href="#"><i class="fa fa-copy"></i><span class="title">{{ phrase('portal.downloads.search-title') }} <span class="count">({{ download_info['total_results'] }})</span></span></a></li>
              {% endif %}
          </ul>
        </div>

        {% if not is_search %}
            {{ phrase('portal.general.no-search-query') }}
        {% elseif combined['total_results'] < 1 %}
            {{ phrase('portal.general.no-search-results') }}
        {% else %}

        {% if can_use_articles() and article_results %}
            <div class="search-result-category-wrapper">
              <div class="deskpro-search-results">
                <div class="search-result-category"><hr><i class="fa fa-list-alt"></i><span class="title">{{ phrase('portal.articles.search-title') }}</span></div>
                <ul>
                    {% for result_set in article_results %}
                        {{ search_macros.search_result(result_set) }}
                    {% endfor %}
                  <li class="dpx-show-more">
                    <div class="button-wrapper">
                      <a href="#" class="show-more-content">Show more <i class="fa fa-angle-double-down"></i></a>
                    </div>
                  </li>
                </ul>
              </div>
            </div>
        {% endif %}

        {% if can_use_news() and news_results %}
            <div class="search-result-category-wrapper">
              <div class="deskpro-search-results">
                <div class="search-result-category"><hr><i class="fa fa-calendar-o"></i><span class="title">{{ phrase('portal.news.search-title') }}</span></div>
                <ul>
                    {% for result_set in news_results %}
                        {{ search_macros.search_result(result_set) }}
                    {% endfor %}
                  <li class="dpx-show-more">
                    <div class="button-wrapper">
                      <a href="#" class="show-more-content">Show more <i class="fa fa-angle-double-down"></i></a>
                    </div>
                  </li>
                </ul>
              </div>
            </div>
        {% endif %}

        {% if can_use_feedback() and feedback_results %}
            <div class="search-result-category-wrapper">
              <div class="deskpro-search-results">
                <div class="search-result-category"><hr><i class="fa fa-thumbs-o-up"></i><span class="title">{{ phrase('portal.feedback.search-title') }}</span></div>
                <ul>
                    {% for result_set in feedback_results %}
                        {{ search_macros.search_result(result_set) }}
                    {% endfor %}
                  <li class="dpx-show-more">
                    <div class="button-wrapper">
                      <a href="#" class="show-more-content">Show more <i class="fa fa-angle-double-down"></i></a>
                    </div>
                  </li>
                </ul>
              </div>
            </div>
        {% endif %}

        {% if can_use_downloads() and download_results %}
            <div class="search-result-category-wrapper">
              <div class="deskpro-search-results">
                <div class="search-result-category"><hr><i class="fa fa-copy"></i><span class="title">{{ phrase('portal.downloads.search-title') }}</span></div>
                <ul>
                    {% for result_set in download_results %}
                        {{ search_macros.search_result(result_set) }}
                    {% endfor %}
                  <li class="dpx-show-more">
                    <div class="button-wrapper">
                      <a href="#" class="show-more-content">Show more <i class="fa fa-angle-double-down"></i></a>
                    </div>
                  </li>
                </ul>
              </div>
            </div>
        {% endif %}
    {% endif %}
{% endblock inner_content %}
