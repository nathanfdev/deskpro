{% include 'Theme:Internal:modernizr-include.html.twig' %}
<script type="text/javascript">
    (function(){
        document.body.className = document.body.className + ' with-js';

        // Features that determine if 'DPUI' can be enabled for this user
        window.WITH_DPUI =
          Modernizr &&
          !Modernizr.ie8compat &&
          Modernizr.json &&
          Modernizr.blobconstructor
        ;

        if (window.WITH_DPUI) {
            document.body.className = document.body.className + ' with-dpui';
        } else {
            document.body.className = document.body.className + ' without-dpui';
        }

        window.DP_LOAD_FN = [];

        window.DESKPRO_BASE_URL = '{{ base_url() }}';
        window.DESKPRO_ROOT_URL = '{{ root_url() }}';
        window.DESKPRO_WEB_URL = '{{ root_url() }}web';
        window.DESKPRO_MULTI_LANG = {{ is_multi_lang() ? 'true' : 'false' }};
        window.DESKPRO_LANG = '{{ lang_code() }}';
        window.DESKPRO_ENABLED_LANGS = [{% for language in enabled_languages() %}{{ '{' }}code: '{{ language.urlCode }}', title:'{{ language.title|capitalize }}',flag:'{{ language.flag_image }}'{{ '}' }}{% if not loop.last %},{% endif %}{% endfor %}];
        window.DP_ASSET_URL = '{{ asset('') }}';
        window.DP_BASE_URL = '{{ path('portal_home')|trim('/') }}/';
        window.__DP_APP_SRC__ = '{{ asset('DeskPRO_WidgetBundle.js', 'app_assets') }}';
        window.__DP_URL__ = '{{ root_url() }}';
        window.__DP_OPTIONS__ = {
            "widget": {
                "type": "column",
                "position": "right",
                "agentPollingTimeout": 10
            },
            "company":{
                "name": "Acme Corp. Chat and a long name lorel ipsum dolor",
                "logo": ""
            },
            "button":{
                "size": "medium",
                "name": "Help",
                "colors": {
                    "background": "",
                    "text":" ",
                    "border": ""
                }
            },
            "chat": {
                "enabled": true,
                "requestUserInfo": true,
                "proactive": true,
                "popup": {
                    "enabled": true,
                    "title": "DeskPRO Customer Support",
                    "message": "Given a string consisting of printable ASCII chars, produce an output consisting of its unique chars in the original order.",
                    "replyType": "buttons"
                },
                "beginMode": "form",
                "waitingTimeout": 30
            }
        };
        window.DESKPRO_USERSOURCES = {{ auth_usersources_js_object() }};
        window.DESKPRO_CAN_USE_TICKETS = {{ can_use_tickets() ? 'true' : 'false' }};
        window.DESKPRO_CAN_USE_FEEDBACK = {{ can_use_feedback() ? 'true' : 'false' }};
        window.DESKPRO_CAN_USE_CHAT = {{ can_use_chat() ? 'true' : 'false' }};
        window.PORTAL_MODE = '{{ portal_mode() }}';

        window.DESKPRO_PHRASES = {};
        window.DP_SET_PHRASES = function(p) {
            window.DESKPRO_PHRASES = p;
            if (window.PortalApp && window.PortalApp.phrases) {
                window.PortalApp.phrases.setPhrases(p);
            }
        }
    })();
</script>
<script type="text/javascript" src="{{ url('portal_api_lang_widget_phrases', {_format: 'js'}) }}"></script>
<script type="text/javascript" src="{{ asset('DeskPRO_PortalBundle.js', 'app_assets') }}" async="async"></script>

{% if portal_mode() != 'focus-window' %}
    <script type="text/javascript" src="{{ asset('widget_loader.js', 'app_assets') }}" async="async"></script>
{% endif %}
