{% import 'Theme::icons.html.twig' as icons %}
<div class="content-list-wrap simple as-news {% if pager|length %}with-items{% else %}with-no-items{% endif %}">
  {% if pager|length %}
    <ul>
      {% for news in pager %}
        <li>
          <div class="date-tag">
            <span class="month">{{ news.date_published | date('M') }}</span>
            <span class="day">{{ news.date_published | date('j') }}</span>
          </div>
          <a href="{{ path('portal_news_view', { slug: news.slug }) }}">{{ news.title }}</a>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <strong>{{ phrase('portal.news.none') }}</strong>
  {% endif %}

  {% if show_category_link %}
    <div class="list-meta">
      <a href="{{ category ? path('portal_news_browse', { slug: category.slug }) : path('portal_news') }}">
        {{ phrase('portal.news.view-x-news', {count: pager|length}) }}{{ icons.view_more() }}
      </a>
    </div>
  {% endif %}
</div>
