{% extends 'Theme::layout.html.twig' %}

{% block inner_content %}
    <div class="breadcrumbs">
        {% show breadcrumbs %}
    </div>

    <div class="column-full">
      <div>
      <nav class="tabs secondary-tabs">
        <ul>
          <li class="tab-active">
            <a href="#">
              <div>
                <span class="title">Open Tickets <div class="text-tag rating-tag">3 awaiting response</div></span>
              </div>
            </a>
          </li>

          <li class="tab-inactive">
            <a href="#">
              <div>
                <span class="title">Resolved</span>
              </div>
            </a>
          </li>

          <li class="tab-solo">
            <form class="form-filter">
              <div class="bucket">
                <span>Filter: </span>
                <input placeholder="Type filters here" type="text">
              </div>
            </form>
          </li>
        </ul>
        </nav>
      </div>
    </div>

    <div class="column-full">
        {% if type == 'own' and person.organization and person.organization_manager %}
            <a class="button" href="{{ path('portal_tickets', { type: 'organization' }) }}">
                {{ phrase('portal.tickets.list_switch_to_organization') }}
            </a>
        {% endif %}
        {% if type == 'organization' %}
            <a class="button" href="{{ path('portal_tickets') }}">
                {{ phrase('portal.tickets.list_switch_to_my_tickets') }}
            </a>
        {% endif %}

        {% macro sort_link(label, sort_value, sort, sort_param, sort_dir, sort_dir_param) %}
            {% set queryParams = app.request.query.all|merge({(sort_param):sort_value}) %}
            {% set isActive = sort_value == sort %}
            {% if isActive %}
                {% set linkDir = sort_dir == 'desc' ? 'asc' : 'desc' %}
            {% else %}
                {% set linkDir = 'desc' %}
            {% endif %}
            {% set queryParams = app.request.query.all|merge({(sort_param):sort_value, (sort_dir_param):linkDir}) %}
            {% set url = path(app.request.attributes.get('_route'), queryParams) %}
            {% set sort_icon = sort_dir == 'desc' ? '&darr;' : '&uarr;' %}
            <a href="{{ url }}">{{ label }}{% if isActive %}{{ sort_icon|raw }}{% endif %}</a>
        {% endmacro %}

        {% macro tickets_table(tickets_pager, title, pg_param, sort_param, sort, sort_dir_param, sort_dir) %}
        <div class="column-full">
         <div><!-- Table Header -->
             <header class="titled-header">
                 <h1>{{ title }}</h1>
             </header>

             <div class="table-meta">
              <div class="table-controls">
                <a href="#" class="column-control"></a>
                <a href="#" class="expand-control"><i class="fa fa-caret-right"></i></a>
              </div>
            </div>

             <!-- Table -->
             <table class="user-ticket-list">
                 <thead>
                 <tr>
                     <td class="table-header">
                         {{ _self.sort_link(
                             phrase('portal.tickets.list_department'),
                             'department',
                             sort,
                             sort_param,
                             sort_dir,
                             sort_dir_param
                         ) }}
                         /
                         {{ _self.sort_link(
                         phrase('portal.tickets.list_subject'),
                             'subject',
                              sort,
                              sort_param,
                              sort_dir,
                              sort_dir_param
                         ) }}
                     </td>
                     <td class="table-header">
                         {{ _self.sort_link(
                             phrase('portal.tickets.list_date_created'),
                             'created',
                             sort,
                             sort_param,
                             sort_dir,
                             sort_dir_param
                         ) }}
                     </td>
                     <td class="table-header right">
                         {{ _self.sort_link(
                             phrase('portal.tickets.list_last_action'),
                             'activity',
                             sort,
                             sort_param,
                             sort_dir,
                             sort_dir_param
                         ) }}
                     </td>
                 </tr>
                 </thead>
                 <tbody>
                 {% for ticket in tickets_pager %}
                     <tr class="item-row">
                         <td>
                             <a href="{{ portal_path(ticket) }}">
                                 <span class="status-tag">{{ ticket_status(ticket) }}</span>
                                 <span class="focus">[{{ ticket.department }}]</span>
                                 {{ ticket.subject }}
                             </a>
                         </td>
                         <td>
                             <a href="{{ portal_path(ticket) }}">
                                 <span class="date">{{ ticket.date_created|date }}</span>
                             </a>
                         </td>
                         <td class="info-block">
                             {% set last_message = ticket.messages|last %}
                             {% if last_message %}
                             <a href="{{ portal_path(ticket) }}">
                                 <img src="{{ avatar_url(last_message.person) }}" class="avatar">
                                 <span class="person">{{ last_message.person.display_name_user }}</span>
                                 <span class="date">{{ ticket.last_activity_date|date }}</span>
                             </a>
                             {% endif %}
                         </td>
                     </tr>
                 {% endfor %}
                 </tbody>
             </table>

             {% if tickets_pager.haveToPaginate() %}
                {{ pagerfanta(tickets_pager, null, { pageParameter: '['~pg_param~']' }) }}
             {% endif %}
         </div>
        </div>
        {% endmacro %}

        {{ _self.tickets_table(awaiting_user_tickets,phrase('portal.tickets.list_status_user'),awaiting_user_tickets_pg_param,awaiting_user_sort_param,awaiting_user_sort,awaiting_user_sort_dir_param,awaiting_user_sort_dir) }}

        {{ _self.tickets_table(awaiting_agent_tickets,phrase('portal.tickets.list_status_agent'),awaiting_agent_tickets_pg_param,awaiting_agent_sort_param,awaiting_agent_sort,awaiting_agent_sort_dir_param,awaiting_agent_sort_dir) }}

        {{ _self.tickets_table(resolved_tickets,phrase('portal.tickets.list_status_resolved'),resolved_tickets_pg_param,resolved_sort_param,resolved_sort,resolved_sort_dir_param,resolved_sort_dir) }}
{% endblock inner_content %}
