{% if category_children|length > 0 %}
    <ul>
        {% for category in category_children %}
            <li>
                <h1>
                    <a href="{{ path('portal_kb_browse', { slug: category.slug }) }}">
                        {{ category.title }}
                        <span>{{ category.articles|length }}</span>
                    </a>
                </h1>
                <span class="meta">
                    {% show knowledgebase_comma_list with { category: category } %}
                </span>
            </li>
        {% endfor %}
    </ul>
{% endif %}
