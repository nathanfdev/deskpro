{% extends 'Theme::layout.html.twig' %}

{% block page_content %}
    <div class="breadcrumbs">
        {% show breadcrumbs %}
    </div>
    {% if auth_manager.isForgotPasswordVisible %}
        <header class="section-header">
            <h1>{{ phrase('portal.account.section-title-set-password') }}</h1>
        </header>

        {% if from_saved %}
            <div class="error"
                     style="border: 2px solid black; background-color: firebrick;  color:black; font-weight:bold; display: block; padding:5px; margin: 8px;">
                {{ phrase('portal.account.set-password-for-user') }}
            </div>
        {% endif %}

        {{ form_start(form) }}
        {{ form_rest(form) }}
        <button type="submit">{{ phrase('portal.account.set-password-btn') }}</button>
        {{ form_end(form) }}
    {% endif %}
{% endblock page_content %}
