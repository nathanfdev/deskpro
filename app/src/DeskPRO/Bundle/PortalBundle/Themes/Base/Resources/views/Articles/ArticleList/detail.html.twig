{% if pager|length > 0 %}
  <ul class="categories-article-list">
    {% for article in pager %}
      <li>
        <a href="{{ path('portal_kb_view', { slug: article.slug }) }}">
          <h1>{{ article.realTitle }}</h1>

          <div class="article-meta">
            <span class="updated"><i class="fa fa-calendar-o"></i> {{ article.date_created|date('day') }}</span>
            {% if article.num_comments > 0 %}
              <span class="comments"><i class="fa fa-comments"></i> <a
                        href="{{ path('portal_kb_view', { slug: article.slug }) }}#comments">
                  {{ phrase('portal.general.comments-count', {count: article.num_comments}) }}
                </a></span>
            {% endif %}
          </div>
        </a>
      </li>
    {% endfor %}
  </ul>
{% else %}
  <strong>{{ phrase('portal.articles.none') }}</strong>
{% endif %}
