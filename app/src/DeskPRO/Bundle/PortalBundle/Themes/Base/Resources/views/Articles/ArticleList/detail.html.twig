{% if pager|length > 0 %}
  <ul class="categories-article-list">
    {% for article in pager %}
      <li>
        <a href="{{ path('portal_kb_view', { slug: article.slug }) }}">
          <h1>{{ article.realTitle }}</h1>

          <div class="article-meta">
            <span class="updated"><i class="fa fa-calendar-o"></i> {{ article.date_created|date('day') }}</span>
            <span class="comments"><i class="fa fa-comments"></i> 0 comments</span>
          </div>
        </a>
      </li>
    {% endfor %}
  </ul>
{% else %}
  <strong>No articles yet</strong>
{% endif %}
