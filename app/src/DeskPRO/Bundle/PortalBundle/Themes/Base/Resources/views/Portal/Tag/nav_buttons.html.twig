<ul class="big-button-collection left thin">
  {% if can_use_articles() %}
    <li>
      <a href="{{ path('portal_kb') }}">
        <i class="fa fa-columns"></i>
        <span class="title">Knowledgebase</span>
        <span class="subtitle">Read help articles</span>
      </a>
    </li>
  {% endif %}

  {% if can_use_news() %}
    <li>
      <a href="{{ path('portal_news') }}">
        <i class="fa fa-file-text-o"></i>
        <span class="title">News</span>
        <span class="subtitle">News &amp; updates</span>
      </a>
    </li>
  {% endif %}

  {% if can_use_feedback() %}
    <li>
      <a href="{{ path('portal_feedback') }}">
        <i class="fa fa-list-alt"></i>
        <span class="title">Feedback</span>
        <span class="subtitle">Custom suggestions</span>
      </a>
    </li>
  {% endif %}

  {% if can_use_tickets() %}
    <li>
      <a href="{{ path('portal_new_ticket') }}">
        <i class="fa fa-comments"></i>
        <span class="title">Contact Us</span>
        <span class="subtitle">We are here to help</span>
      </a>
    </li>
  {% endif %}
</ul>