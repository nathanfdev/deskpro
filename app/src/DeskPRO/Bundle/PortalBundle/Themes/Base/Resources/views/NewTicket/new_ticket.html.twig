{% extends 'Theme::layout.html.twig' %}
{% block inner_content %}
    {{ newticket_breadcrumbs() }}
    <div class="wrapper" id="new_ticket_page">
        {{ newticket_header() }}

        {% if rerendering %}
            <strong>You have switched departments and the form fields have changed. Please review the form and submit again.</strong>
        {% endif %}

        {% embed 'Theme:Form:ticket.html.twig' %}{% endembed %}
        {% embed 'Theme:Form:ticket_js_tpl.html.twig' %}{% endembed %}
    </div>
{% endblock inner_content %}
{% block doc_end %}
    <!-- DESKPRO_TICKET_DISPLAY -->
    <script type="text/javascript">
        {{ ticket_display_js|raw }}
    </script>
{% endblock doc_end %}