<?xml version="1.0" encoding="UTF-8" ?>
<rss version="2.0">
    <channel>
        {% if category %}
            <title>{{ brand_setting('core.deskpro_name') }} - {{ category.full_title  }}</title>
            <description>{{ brand_setting('core.deskpro_name') }} - {{ category.full_title }}</description>
            <link>{{ url('portal_feedback', { slug: category.slug }) }}</link>
        {% else %}
            <title>{{ brand_setting('core.deskpro_name') }} - {{ phrase('portal.feedback.section-title') }}</title>
            <description>{{ brand_setting('core.deskpro_name') }} - {{ phrase('portal.feedback.section-title') }}</description>
            <link>{{ url('portal_feedback') }}</link>
        {% endif %}
        <lastBuildDate>{{ 'now'|date('r') }}</lastBuildDate>
        <pubDate>{{ 'now'|date('r') }}</pubDate>
        <ttl>1800</ttl>
        {% for item in pager %}
            <item>
                <title>{{ item.title }}</title>
                <description>{{ item.content }}</description>
                <link>{{ url('portal_feedback_view', { slug: item.slug }) }}</link>
                <guid>{{ url('portal_feedback_view', { slug: item.id }) }}</guid>
                <pubDate>{{ item.date_published|date('r') }}</pubDate>
            </item>
        {% endfor %}
    </channel>
</rss>
