{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block pagebar %}
	<nav>
		<ul>
			<li class="add"><a href="{{ path('admin_emailtrans_newaccount') }}">{{ phrase('admin.gateway.add_account') }}</a></li>
		</ul>
	</nav>
	<ul>
		<li><a href="{{ path('admin_emailtrans_list') }}">{{ phrase('admin.gateway.outgoing_email') }}</a></li>
	</ul>
{% endblock %}
{% block page %}

{{ design.helpbox() }}
	<p>
		This page lists the accounts that DeskPRO can send mail from. There are two types of mail DeskPRO sends:
	</p>
	<ul style="margin: 15px 15px 15px 35px; list-style-type: disc;">
		<li>
			Informational messages such as welcome emails, warnings or password reset instructions. These are emails the the
			user is not expected to reply to so mail is sent from a "no reply" email address defined below.<br />
		</li>
		<li>
			Ticket notification messages such as alerts sent to a user or agent when someone has replied to a ticket.
			These emails are designed to handle a user replying to them. Using ticket triggers,
			you can define rules to set which email address to send from. For example, if a user sends
			an email to your sales gateway then you might want to make sure all future replies are also sent from
			your sales email address.
		</li>
	</ul>
	<p>
		Before DeskPRO is able to actually send email from an address, you need to define an outgoing email account
		for the address. Your account is already set up to send mail from any @{{ constant('DPC_SITE_DOMAIN') }}
		but you may wish to add more accounts for email addresses on your own domain.
	</p>
{{ design.helpbox_end() }}

<div class="top-option">
	<h3>{{ phrase('admin.gateway.default_from_address') }}</h3>
	<form action="{{ path('admin_emailtrans_set_default_from') }}" method="post">
		"No Reply" email address:
		<input type="text" name="default_from" value="{{ app.getSetting('core.default_from_email') }}" /> <button class="clean-white">{{ phrase('agent.general.update') }}</button>
		<div style="padding-top:5px;">
			This is the email address that automated emails are sent from, such as welcome emails and warnings.
		</div>
	</form>
</div>

<br />

<div class="check-grid item-list">
	<table width="100%">
		<thead>
			<tr>
				<th style="text-align:left">&nbsp; {{ phrase('admin.gateway.use_criteria') }}</th>
				<th style="text-align:left">{{ phrase('admin.general.account') }}</th>
				<th style="text-align:left">{{ phrase('admin.gateway.backup_account') }}</th>
				<th style="text-align:left" width="10">&nbsp;</th>
			</tr>
		</thead>
		<tbody>
			<tr class="highlight">
				<td>
					*@{{ constant('DPC_SITE_DOMAIN') }}
				</td>
				<td>
					DeskPRO outgoing mail server
				</td>
				<td>&nbsp;</td>
				<td>&nbsp;</td>
			</tr>
			{% for transport in transports %}{% if transport.match_type != 'all' %}
				<tr>
					<td>
						{% if transport.match_type == 'exact' %}{{ phrase('admin.gateway.from_pattern', {'pattern':transport.match_pattern}) }}
						{% elseif transport.match_type == 'domain' %}{{ phrase('admin.gateway.from_domain', {'pattern':transport.match_pattern}) }}
						{% elseif transport.match_type == 'regex' %}{{ phrase('admin.gateway.from_pattern', {'pattern':transport.match_pattern}) }}
						{% elseif transport.match_type == 'all' %}{{ phrase('agent.general.default') }}{% endif %}
					</td>
					<td>{{ transport.title }}</td>
					<td>
						{% if transport.backup_transport_type %}
							{% if transport.backup_transport_type == 'smtp' %}{{ transport.backup_transport_options.host }}:{{ transport.backup_transport_options.username }}
							{% elseif transport.backup_transport_type == 'gmail' %}{{ phrase('admin.gateway.from_google', {'pattern':transport.backup_transport_options.username}) }}
							{% elseif transport.backup_transport_type == 'mail' %}{{ phrase('admin.general.php_mail') }}
							{% else %}{{ transport.backup_transport_type }}
							{% endif %}
						{% else %}
							{{ phrase('agent.general.none') }}
						{% endif %}
					</td>
					<td style="padding: 3px 3px 0 0">
						{% if transport.match_type == 'all' %}
							<a href="{{ path('admin_emailtrans_setup') }}"><span class="btn-edit-gear"></span></a>
						{% else %}
							<a href="{{ path('admin_emailtrans_editaccount', { 'id': transport.id }) }}"><span class="btn-edit-gear"></span></a>
						{% endif %}
					</td>
				</tr>
			{% endif %}{% endfor %}
		</tbody>
	</table>
</div>

{% endblock %}
