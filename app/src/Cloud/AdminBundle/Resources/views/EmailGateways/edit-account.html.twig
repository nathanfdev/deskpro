<div id="edit_email_overlay" style="width: 700px; height: 600px; display: none;">
	<div class="overlay-title">
		<span class="close-overlay"></span>
		<h4>Custom Email Account</h4>
	</div>
	<div class="overlay-content">
		<div class="check-grid item-list" id="email_forward_list">
			<table width="100%">
				<thead>
					<tr>
						<th style="text-align:left">Custom Email Addresses</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>
							<p style="font-size: 11px; padding-bottom: 8px;">
								This is the email address that will appear in the "From" field of emails sent by your helpdesk.
								Make sure you have configured your server to forward messages into your DeskPRO account.
							</p>
							<p>
								Enter your custom email address: <input type="text" value="{{ gateway.getAliasEmailAddress() }}" />
							</p>
						</td>
					</tr>
				</tbody>
			</table>
		</div>

		<br/>

		<div class="check-grid item-list" id="email_forward_list">
			<table width="100%">
				<thead>
					<tr>
						<th style="text-align:left">Custom SMTP account for outgoing email</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>
							{% include 'AdminBundle:EmailTransports:edit-account-form.html.twig' with {form: trans_form} %}
						</td>
					</tr>
				</tbody>
			</table>
		</div>

		<br/>

		<div class="check-grid item-list" id="email_forward_list">
			<table width="100%">
				<thead>
					<tr>
						<th style="text-align:left">Additional Email Addresses</th>
					</tr>
				</thead>
				<tbody>
					{% for addr in gateway.addresses %}
						{% if loop.index > 2  %}
						<tr>
							<td>
								<div style="float: right">
									<button class="clean-white remove-trigger">Remove</button>
								</div>
								<input type="text" name="helpdesk_emails[]" value="{{ addr.match_pattern }}" placeholder="Email address or a full domain name (Example: my-alias@mydomain.com)" />
							</td>
						</tr>
						{% endif %}
					{% endfor %}

					<tr>
						<td>
							<button class="clean-white add-trigger">Add New Address</button>
						</td>
					</tr>
				</tbody>
			</table>
		</div>

		<br/><br/>
	</div>
	<div class="overlay-footer">
		<div id="setout_save_wrap">
			<button class="clean-white" id="fwd_emails_savebtn">Save Changes</button>
		</div>
		<div id="fwd_emails_loading" style="display: none;">
			<img src="{{ asset('images/spinners/loading-small-flat.gif') }}" />
		</div>
	</div>
</div>