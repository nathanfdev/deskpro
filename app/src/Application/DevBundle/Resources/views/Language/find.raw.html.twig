<a href="{{ path('dev_lang_index') }}">Back</a>

{% if langfiles|length %}
    {% for file,conf in langfiles %}
        <h3>{{file}}</h3>
<pre>
{{conf}}
</pre>
    {% endfor %}
{% endif %}

<form method="post">
    <table cellspacing="0" cellpadding="2" border="1" width="100%">
    <tr><th>Replace?</th><th>File</th><th>String</th><th>Auto Id</th></tr>

        {% for file,strings in untranslated %}
            {% for string in strings %}
                <tr>
                    <td><input type="checkbox" name="replace[]" value="{{file}}?{{string.text}}" /></td>
                    <td>{{filenames[file]}}</td>
                    <td>{{string.text}}</td>
                    <td>{{string.id}}</td>
                </tr>
                <tr>
                    <td colspan="4">
                        {% for line in string.context %}
                        OLD: {{line.in|raw}}<br />
                        NEW: {{line.out|raw}}
                        {% if not loop.last %}
                        <hr />
                        {% endif %}
                        {% endfor %}
                    </td>
                </tr>
            {% endfor %}
        {% endfor %}
    </table>
    Dry run: <input type="checkbox" name="dryrun" value="1" /><br />
    <input type="submit" value="Replace Strings!" />
</form>