<a href="{{ path('dev_lang_index') }}">Back</a>
<br />
{% for folder,export in global %}
Export global.php file for {{folder}}:<br />
<pre>
{{export}}
</pre>
{% endfor %}

{% for bundle, ids in foreign %}
<h1>Foreign phrase identities in {{bundle}}</h1>
<table border="1" cellspacing="0" cellpadding="2">
    <tr><th>Id</th><th>Occurances</th></tr>
    {% for id, files in ids %}
        <tr><td>{{id}}</td><td>{{files|length}}</td></tr>
        <tr><td colspan="2">
            {% for file in files %}
            {{file.filename}}:{{file.line}}<br />
            {% endfor %}
        </td></tr>
    {% endfor %}
</table>
{% endfor %}
<form method="post">
    <input type="submit" name="globals" value="Separate globals">
</form>