{# Articles #}
{% if typename == 'articles' %}
{% for article in results %}
	<li>
		<a class="title" href="{{ path('user_articles_article', {'slug': article.url_slug}) }}">{{ article.title|emphasize_words(query) }}</a>
		<div class="breadcrumb-line">
			<ul>
				<li><a href="{{ path('user_articles') }}">{{ phrase('user.global.articles') }}</a></li>
				{% for c in article.categories %}
					{% if loop.index == 1 %}
						{% for pc in c.tree_parents %}
							<li><a href="{{ path('user_articles', {'slug': pc.url_slug}) }}">{{ pc.full_title }}</a></li>
						{% endfor %}
						<li><a href="{{ path('user_articles', {'slug': c.url_slug}) }}">{{ c.full_title }}</a></li>
					{% endif %}
				{% endfor %}
			</ul>
		</div>
	</li>
{% endfor %}

{# News #}
{% elseif typename == 'news' %}
{% for news in results %}
	<li class="news-item  {% if show_more and loop.last %}has-more{% endif %}">
		<a class="title" href="{{ path('user_downloads_file', {'slug': news.url_slug}) }}">{{ news.title }}</a>
		<div class="breadcrumb-line">
			<ul>
				<li><a href="{{ path('user_downloads') }}">{{ phrase('user.global.downloads') }}</a></li>
				{% for cat in news.category.tree_parents %}
					<li><a href="{{ path('user_downloads', {'slug': cat.url_slug}) }}">{{cat.title}}</a></li>
				{% endfor %}
			</ul>
		</div>
	</li>
{% endfor %}

{# Feedback #}
{% elseif typename == 'feedback' %}
{% for feedback in results %}
	<li class="feedback-item {% if show_more and loop.last %}has-more{% endif %}">
		<a class="title" href="{{ path('user_feedback_view', {'slug': feedback.url_slug}) }}">{{ feedback.title }}</a>
		<div class="breadcrumb-line">
			<ul>
				<li><a href="{{ path('user_feedback') }}">{{ phrase('user.global.feedback') }}</a></li>
				{% for cat in feedback.category.tree_parents %}
					<li><a href="{{ path('user_feedback', {'slug': cat.url_slug}) }}">{{cat.title}}</a></li>
				{% endfor %}
			</ul>
		</div>
	</li>
{% endfor %}

{# Downloads #}
{% elseif typename == 'downloads' %}
{% for download in results %}
	<li class="file popular {% if show_more and loop.last %}has-more{% endif %}">
		<a class="title" href="{{ path('user_news_view', {'slug': download.url_slug}) }}">{{ download.title }}</a>
		<div class="breadcrumb-line">
			<ul>
				<li><a href="{{ path('user_news') }}">{{ phrase('user.global.news') }}</a></li>
				{% for cat in download.category.tree_parents %}
					<li><a href="{{ path('user_news', {'slug': cat.url_slug}) }}">{{cat.title}}</a></li>
				{% endfor %}
			</ul>
		</div>
	</li>
{% endfor %}
{% endif %}
