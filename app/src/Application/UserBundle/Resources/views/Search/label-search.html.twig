{% import 'UserBundle:Common:macros.html.twig' as layout %}
{% extends 'UserBundle::layout.html.twig' %}
{% block breadcrumb %}
	<li><a href="{{ path('user_search_labels') }}">{{ phrase('user.search.labels_section_name') }}</a></li>
{% endblock %}
{% block content %}

{{ layout.page_box('dp-search-page dp-labels-page') }}
	{{ layout.page_content() }}
	<strong>{{ phrase('user.search.find_tagged_with') }}:</strong><br />
	<input type="text" name="label" id="search_label" value="{{ label }}" /> <button class="btn small" onclick="var url = $(this).data('url').replace(/_LABEL_/, $('#search_label').val().trim()); window.location = url;" data-url="{{ path('user_search_labels', {'label': '_LABEL_'}) }}">{{ phrase('user.find') }}</button>

	<div class="dp-tag-cloud">
		<ul>
			{% for c_label,css_class in cloud %}
				<li class="dp-{{css_class}}"><a href="{{ path('user_search_labels', {'label': c_label}) }}">{{ c_label }}</a></li>
			{% endfor %}
		</ul>
	</div>

	{{ layout.page_content_end() }}
{{ layout.page_box_end() }}

{% if results.articles.results|length %}
	{{ layout.page_box() }}
		{{ layout.page_title() }}
			<h1><a class="button" href="{{ path('user_search_labels', {'label': label, 'type': 'articles'}) }}">{{ phrase('user.articles') }}</a></h1>
		{{ layout.page_title_end() }}

		{{ layout.page_content() }}
			<div class="with-handler"
				data-element-handler="DeskPRO.User.ElementHandler.MoreLoader"
				data-load-url="{{ path('user_search_labels', {'label': label, 'type': 'articles', 'page': '00000'})|replace({'00000': '{page}'}) }}"
			>
				<div class="dp-search-list">
					<ul>
						{% include 'UserBundle:Search:label-search-items.html.twig' with {'typename': 'articles', 'results': results.articles.results, 'show_more': results.articles.show_more} %}
					</ul>
				</div>
				{% if results.articles.show_more %}
				<div class="content-more">
					<div class="is-not-loading">
						<a class="button" href="{{ path('user_search_labels', {'label': label, 'type': 'articles', 'page': page+1}) }}">{{ phrase('user.more') }}</a>
					</div>
					<div class="is-loading">
						<center><img src="{{ asset('images/loading-big-circle.gif') }}" alt="" /></center>
					</div>
				</div>
				{% endif %}
			</div>
		{{ layout.page_content_end() }}
	{{ layout.page_box_end() }}
{% endif%}

{% if results.articles.results|length %}
	{{ layout.page_box() }}
		{{ layout.page_title() }}
			<h1><a class="button" href="{{ path('user_search_labels', {'label': label, 'type': 'downloads'}) }}">{{ phrase('user.downloads') }}</a></h1>
		{{ layout.page_title_end() }}

		{{ layout.page_content() }}
			<div class="with-handler"
				data-element-handler="DeskPRO.User.ElementHandler.MoreLoader"
				data-load-url="{{ path('user_search_labels', {'label': label, 'type': 'downloads', 'page': '00000'})|replace({'00000': '{page}'}) }}"
			>
				<div class="dp-search-list">
					<ul>
						{% include 'UserBundle:Search:label-search-items.html.twig' with {'typename': 'downloads', 'results': results.downloads.results, 'show_more': results.downloads.show_more} %}
					</ul>
				</div>
				{% if results.downloads.show_more %}
				<div class="content-more">
					<div class="is-not-loading">
						<a class="button" href="{{ path('user_search_labels', {'label': label, 'type': 'downloads', 'page': page+1}) }}">{{ phrase('user.more') }}</a>
					</div>
					<div class="is-loading">
						<center><img src="{{ asset('images/loading-big-circle.gif') }}" alt="" /></center>
					</div>
				</div>
				{% endif %}
			</div>
		{{ layout.page_content_end() }}
	{{ layout.page_box_end() }}
{% endif%}

{% if results.articles.results|length %}
	{{ layout.page_box() }}
		{{ layout.page_title() }}
			<h1><a class="button" href="{{ path('user_search_labels', {'label': label, 'type': 'feedback'}) }}">{{ phrase('user.feedback') }}</a></h1>
		{{ layout.page_title_end() }}

		{{ layout.page_content() }}
			<div class="with-handler"
				data-element-handler="DeskPRO.User.ElementHandler.MoreLoader"
				data-load-url="{{ path('user_search_labels', {'label': label, 'type': 'feedback', 'page': '00000'})|replace({'00000': '{page}'}) }}"
			>
				<div class="dp-search-list">
					<ul>
						{% include 'UserBundle:Search:label-search-items.html.twig' with {'typename': 'feedback', 'results': results.feedback.results, 'show_more': results.feedback.show_more} %}
					</ul>
				</div>
				{% if results.feedback.show_more %}
				<div class="content-more">
					<div class="is-not-loading">
						<a class="button" href="{{ path('user_search_labels', {'label': label, 'type': 'feedback', 'page': page+1}) }}">{{ phrase('user.more') }}</a>
					</div>
					<div class="is-loading">
						<center><img src="{{ asset('images/loading-big-circle.gif') }}" alt="" /></center>
					</div>
				</div>
				{% endif %}
			</div>
		{{ layout.page_content_end() }}
	{{ layout.page_box_end() }}
{% endif%}

{% endblock %}
