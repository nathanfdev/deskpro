{% extends 'UserBundle::layout.html.twig' %}
{% block head %}
	<meta property="og:url" content="{{ path('user_feedback_view', {'slug': feedback.url_slug}) }}" />
	<meta property="og:title" content="{{feedback.title}}" />
	<meta property="og:type" content="article" />
	<link rel="canonical" href="{{ url('user_feedback_view', {'slug': feedback.url_slug}) }}" />
{% endblock %}
{% block breadcrumb %}
	<li><a href="{{ path('user_feedback') }}">{{ phrase('user.global.feedback') }}</a></li>
	{% for cat in category_path %}
		<li><a href="{{ path('user_feedback', {'slug': cat.url_slug}) }}">{{cat.title}}</a></li>
	{% endfor %}
	<li><a href="{{ path('user_feedback_view', {'slug': feedback.url_slug}) }}">{{feedback.title}}</a></li>
{% endblock %}
{% block page_title %}
	{{ feedback.title }}
	-
	Feedback
	{% for cat in category_path %}
		/ {{ cat.title }}
	{% endfor %}
{% endblock %}
{% block content %}
<div class="dp-feedback-page">
	<div class="dp-content-block">
		<div class="dp-box">
			<div class="dp-box-header">
				{% if app.user.hasPerm('feedback.rate') %}
					{% include 'UserBundle:Feedback:voting-widget.html.twig' with {'has_voted_this': num_votes_this} %}
				{% endif %}
				<h1>{{ feedback.title }}</h1>
			</div>
			<div class="dp-box-content-meta">
				<div class="by-line">
					<img src="{{ feedback.person.getPictureUrl(40) }}" />
					{{ phrase('user.global.created_by_name_on_date', {'name': feedback.person.display_name, 'date': feedback.date_created|date('M d Y')}) }}
					<br class="dp-clear" style="clear:left" />
				</div>
			</div>
			<div class="dp-box-content-wrapper">
				<div class="dp-box-content">
					<div class="dp-post">{{ feedback.content_html|raw }}</div>

					{% include 'UserBundle:Common:labels-box.html.twig' with {'labels': feedback.labels} %}

					{% if app.getSetting('core.facebook_like') %}
						{% include 'UserBundle:Common:facebook-like.html.twig' with {'page_permalink': article.permalink} %}
					{% endif %}

					{% if app.user.hasPerm('feedback.comment') %}
						{% include 'UserBundle:Common:comments-box.html.twig' with {
							'comments': comments,
							'form_action': path('user_feedback_newcomment', {'feedback_id': feedback.id}),
							'check_perm': 'feedback.comment'
						} %}
					{% endif %}
				</div>
			</div>
		</div>
	</div>
</div>

{% endblock %}
