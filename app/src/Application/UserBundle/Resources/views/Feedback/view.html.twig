{% import 'UserBundle:Common:macros-social.html.twig' as social %}
{% set this_section = 'feedback' %}
{% extends 'UserBundle::layout.html.twig' %}
{% block head %}
	<meta property="og:url" content="{{ path('user_feedback_view', {'slug': feedback.url_slug}) }}" />
	<meta property="og:title" content="{{feedback.title}}" />
	<meta property="og:type" content="article" />
	<link rel="canonical" href="{{ url('user_feedback_view', {'slug': feedback.url_slug}) }}" />
{% endblock %}
{% block breadcrumb %}
	<li><span class="dp-divider">&rarr;</span> <a href="{{ path('user_feedback') }}">{{ phrase('user.general.feedback') }}</a></li>
	{% for cat in category_path %}
		<li><span class="dp-divider">&rarr;</span> <a href="{{ path('user_feedback', {'slug': cat.url_slug}) }}">{{cat.title}}</a></li>
	{% endfor %}
	<li><span class="dp-divider">&rarr;</span> <a href="{{ path('user_feedback_view', {'slug': feedback.url_slug}) }}">{{feedback.title}}</a></li>
{% endblock %}
{% block page_title %}
	{{ feedback.title }}
	-
	Feedback
	{% for cat in category_path %}
		/ {{ cat.title }}
	{% endfor %}
{% endblock %}
{% block content %}

<section class="dp-article-post dp-content-post dp-content-page">
	<header>
		<table class="dp-layout" width="100%"><tr>
			<td width="50" style="padding-right: 16px;">{% include 'UserBundle:Feedback:voting-widget.html.twig' %}</td>
			<td class="dp-row-contain">
				<h3 style="margin-bottom: 0">{{ feedback.title }}</h3>
				<ul class="dp-post-info">
					<li class="dp-author"><i class="dp-icon-user"></i> {{ feedback.person.display_name }}</li>
					<li class="dp-category"><i class="dp-icon-folder-close"></i> <a href="{{ path('user_feedback', {'slug': feedback.category.url_slug}) }}">{{ feedback.category.title }}</a></li>
					<li class="dp-date"><i class="dp-icon-calendar"></i> {{ feedback.date_created|date('full') }}</li>
					<li class="dp-comments"><i class="dp-icon-comment"></i> {{ phrase('user.general.count_comments', {'count': comment_counts[feedback.id]|default(0)}) }}</li>
				</ul>
			</td>
		</tr></table>
	</header>
	<article>
		{{ feedback.content_html|raw }}
	</article>
	<footer>
		{% include 'UserBundle:Common:labels-box.html.twig' with {'labels': feedback.labels} %}

		{% if app.getSetting('core.show_share_widget') %}
			{{ social.social_block(path('user_feedback_view', {'slug': feedback.url_slug}), feedback.title) }}
		{% endif %}
	</footer>
</section>

{% if app.user.hasPerm('feedback.comment') %}
	{% include 'UserBundle:Common:comments-box.html.twig' with {
		'type': 'feedback',
		'comments': comments,
		'form_action': path('user_feedback_newcomment', {'feedback_id': feedback.id}),
		'check_perm': 'feedback.comment',
		'no_comment_form': (feedback.status == 'closed')
	} %}
{% endif %}

{% endblock %}
