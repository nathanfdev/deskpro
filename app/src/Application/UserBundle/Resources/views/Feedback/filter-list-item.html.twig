<li class="dp-feedback-row {% if has_voted_ids[feedback.id] %}dp-voted-row{% endif %}"">
	<section class="dp-feedback-post dp-content-post">
		<header>
			<div class="dp-feedback-widget-wrap">
				{% include 'UserBundle:Feedback:voting-widget.html.twig' %}
			</div>
			<div class="dp-feedback-info-wrap">
				<div class="dp-fadeaway-titl-wrap"><h3 style="margin-bottom: 0" class="dp-fadeaway-container"><a class="dp-fadeaway-title" href="{{ path('user_feedback_view', {'slug': feedback.url_slug}) }}">{{feedback.title}}</a><div class="dp-fadeaway"></div></h3></div>
				<ul class="dp-post-info">
					<li class="dp-author"><i class="dp-icon-user"></i> {{ feedback.person.display_name }}</li>
					<li class="dp-category"><i class="dp-icon-folder-close"></i> <a href="{{ path('user_feedback', {'status': status, 'slug': feedback.category.url_slug}) }}">{{ feedback.category.title }}</a></li>
					<li class="dp-date"><i class="dp-icon-calendar"></i> {{ feedback.date_created|date('full') }}</li>
					<li class="dp-comments"><i class="dp-icon-comment"></i> {{ phrase('user.general.count_comments', {'count': comment_counts[feedback.id]|default(0)}) }}</li>
				</ul>
			</div>
		</header>
	</section>
</li>