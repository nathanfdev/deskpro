{##
 # The portal sidebar block that draws the feedback category list.
 ##}

<section class="dp-sidebar-block">
	<header>
		<h3>
			{% if title %}{{ title }}{% else %}{{ phrase('user.general.feedback') }}{% endif %}
		</h3>
	</header>
	<article class="dp-written">
		<p class="dp-summary">
			{% set phrase1 %}{{ phrase('user.feedback.browse_our_x_suggestions_open', {count: (counts[0]['new'] + counts[0]['active'])|default(0)} )}}{% endset %}
			{% set phrase2 %}{{ phrase('user.feedback.browse_our_x_suggestions_closed', {count: counts[0]['closed']|default(0)} )}}{% endset %}
			{{ phrase('user.feedback.browse_our_feedback', { phrase1: phrase1, phrase2: phrase2 }) }}
		</p>
		<ul class="dp-cat-list">
			{% for cat in categories %}
				<li>
					<div class="dp-fadeaway-container">
						<i class="dp-icon-folder-close"></i>
						<a class="dp-fadetitle" href="{{ path('user_feedback', {slug: cat.url_slug}) }}">{{ cat.title }}</a>
						<div class="dp-fadeaway"></div>
						<a href="{{ path('user_feedback', {slug: cat.url_slug}) }}" class="dp-badge dp-small">{{ (counts[cat.id]['new'] + counts[cat.id]['active'])|default(0) }}</a>
					</div>
				</li>
			{% endfor %}
		</ul>
	</article>
</section>