{% extends 'UserBundle::layout-partial-aware.html.twig' %}
{% block head %}
<script src="{{ asset('javascripts/DeskPRO/User/ElementHandler/NewFeedback.js') }}"></script>
{% endblock %}
{% block breadcrumb %}
	<li><a href="{{ path('user_feedback') }}">{{ phrase('user.feedback.section_name') }}</a></li>
	<li><a href="{{ path('user_feedback_newfeedback') }}">{{ phrase('user.feedback.newfeedback_section_name') }}</a></li>
{% endblock %}
{% block content %}

<div
	class="dp-content-block dp-newfeedback-page with-handler"
	data-element-handler="DeskPRO.User.ElementHandler.NewFeedback"
	data-suggestions-url="{{ path('user_search_similarto', {'content_type': 'feedback'}) }}"
>
	<div class="dp-box">
		<div class="dp-box-header">
			<h1>{{ phrase('user.feedback.newfeedback_section_name') }}</h1>
		</div>

		<div class="dp-box-content-wrapper">
			<div class="dp-box-content dp-form">
				{% if errors|length %}
					<div class="alert-message error">
						{{ phrase('user.form_errors_correct') }}
						<!--
						{{ debug_var(error_fields) }}
						{{ debug_var(errors) }}
						-->
					</div>
				{% endif %}

				<form action="{{ path('user_feedback_newfeedback') }}" method="post" class="with-form-validator">
				<input type="hidden" name="process" value="1" />

					{###############
					 # Email
					 ###############}

					{% include 'UserBundle:Common:form-email-login-row.html.twig' with { 'email_form_name': 'feedback[person_email]', 'mode': 'identity' } %}

					{###############
					 # Name
					 ###############}
					<div class="dp-form-row {% if error_fields['person_name'] %}dp-error{% endif %}"">
						<div class="dp-form-label">
							<label>{{ phrase('user.label_your_name') }} *</label>
						</div>
						<div class="dp-form-input">
							{{ form_widget(form.person_name, {
								'attr': {
									'data-field-validators': 'DeskPRO.Form.LengthValidator',
									'data-min-len': 2
								}
							}) }}
							<div class="dp-error-explain">
								{{ phrase('user.feedback.please_enter_your_name') }}
							</div>
						</div>
					</div>

					{###############
					 # Category
					 ###############}

					<div class="dp-form-row {% if error_fields['category_id'] %}dp-error{% endif %}">
						<div class="dp-form-label">
							<label>{{ phrase('user.label_category') }} *</label>
						</div>
						<div class="dp-form-input with-sub-options" data-field-validators="DeskPRO.Form.TwoLevelSelectValidator">
							<div class="dp-select-wrapper" style="width: 70%;">
								<select name="feedback[category_id]" class="parent-option category_id">
									<option value=""></option>
									{% for id,info in feedback_categories %}
										<option value="{{id}}">{{info.title}}</option>
									{% endfor %}
								</select>
								{% for parent_id, parent_info in feedback_categories %}
									{% if parent_info.children|length %}
									<div class="dp-sub-options sub-options-category_id sub-options-{{parent_id}}" style="display: none">
										<select class="sub_category_id">
											<option value=""></option>
											{% for id,info in parent_info.children %}
												<option value="{{id}}">{{info.title}}</option>
											{% endfor %}
										</select>
									</div>
									{% endif %}
								{% endfor %}
							</div>
							<div class="dp-error-explain">
								{{ phrase('user.label_category_error') }}
							</div>
						</div>
					</div>

					{###############
					 # Title
					 ###############}

					<div class="dp-form-row {% if error_fields['title'] %}dp-error{% endif %}">
						<div class="dp-form-label">
							<label>{{ phrase('user.feedback.label_summary') }} *</label> <em class="note">{{ phrase('user.feedback.label_summary_explain') }}</em>
						</div>
						<div class="dp-form-input">
							{{ form_widget(form.title, {
								'attr': {
									'data-field-validators': 'DeskPRO.Form.LengthValidator',
									'data-min-len': 5
								}
							}) }}
							<div class="dp-error-explain">
								{{ phrase('user.feedback.summary_error') }}
							</div>
						</div>
					</div>

					<div class="dp-related-search" id="dp_newfeedback_related_container" style="display: none">
						<h4>{{ phrase('user.feedback.similar_title') }}</h4>
						<div class="subline">{{ phrase('user.feedback.similar_note') }}</div>
						<div class="dp-list results">
						</div>
						<div class="more-link" style="display: none;">
							<a>{{ phrase('user.feedback.similar_count', {{'count_place': '<span class="count">0</span>'}}) }}</a>
						</div>
					</div>

					{###############
					 # Description
					 ###############}

					<div class="dp-form-row {% if error_fields['content'] %}dp-error{% endif %}">
						<div class="dp-form-label">
							<label>{{ phrase('user.feedback.label_desc') }} *</label> <em class="note">{{ phrase('user.feedback.label_desc_explain') }}</em>
						</div>
						<div class="dp-form-input">
							{{ form_widget(form.content, {
								'attr': {
									'data-field-validators': 'DeskPRO.Form.LengthValidator',
									'data-min-len': 5
								}
							}) }}
							<div class="dp-error-explain">
								{{ phrase('user.feedback.desc_error') }}
							</div>
						</div>
					</div>

					<input class="btn primary" type="submit" value="Submit Feedback" />
				</form>
			</div>
		</div>
	</div>

	<script type="text/x-deskpro-plain" class="related-content-overlay-tpl">
		<div class="dp-overlay-outer dp-post-overlay">
		<div class="dp-overlay">
			<div class="dp-overlay-inner">
				<span class="dp-close-btn">{{ phrase('user.close') }}</span>
				<div class="dp-content">
					<span class="dp-open-full"><a>{{ phrase('user.overlay_open_full') }}</a></span>
					<div class="dp-content-holder">
						<div class="dp-loading-msg">{{ phrase('user.loading') }}</div>
					</div>
					<div class="dp-controls">
						<div class="dp-default dp-control-section">
							<button class="btn small dp-section-toggle primary dp-set-answered" data-toggle-section=".dp-confirm-answered">{{ phrase('user.feedback.similar_same_as') }}</button>
							<button class="btn small dp-not-answered">{{ phrase('user.feedback.similar_not_same_as') }}</button>
						</div>
						<div class="dp-confirm-answered dp-control-section" style="display:none">
							<p>{{ phrase('user.feedback.similar_same_confirm') }}</p>
							<button class="btn small primary dp-answererd" data-type="close">{{ phrase('user.feedback.simialr_same_confirm_yes') }}</button>
							<button class="btn small dp-answererd" data-type="ticket">{{ phrase('user.feedback.simialr_same_confirm_no') }}</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</script>

</div>

{% endblock %}
