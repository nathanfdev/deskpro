{##
 # Used when browsing feedback that lists feedback results and controls like status and category switchers, and includes
 # the new feedback form.
 #
 # This template serves for all feedback browse views including the main feedback landing page.
 ##}

{% set this_section = 'feedback' %}
{% extends 'UserBundle::layout.html.twig' %}
{% block head %}
	<script src="{{ asset('javascripts/DeskPRO/User/ElementHandler/FeedbackInlineNew.js') }}"></script>
{% endblock %}
{% macro cat_row(cat, status, selected_cat) %}
	<li {% if cat.id == selected_cat.id %}class="on"{% endif %}>
		<a href="{{ path('user_feedback', {'status': status, 'slug': cat.url_slug}) }}">{{ cat.title }}</a>
		{% if cat.children|length %}
			<ul>
				{% for subcat in cat.children %}
					{{ _self.cat_row(subcat, status) }}
				{% endfor %}
			</ul>
		{% endif %}
	</li>
{% endmacro %}
{% block breadcrumb %}
	<li><span class="dp-divider">&rarr;</span> <a href="{{ path('user_feedback') }}">{{ phrase('user.general.feedback') }}</a></li>
	{% if not (status == 'any-status' and search_options.order_by == 'popular' and not category) %}
		<li>
			<span class="dp-divider">&rarr;</span>
			<a href="{{ path('user_feedback', {order_by:search_options.order_by}) }}">
				{% if search_options.order_by == 'popular' %}{{ phrase('user.feedback.status_popular') }}
				{% elseif search_options.order_by == 'newest' %}{{ phrase('user.feedback.newest') }}
				{% elseif search_options.order_by == 'most-voted' %}{{ phrase('user.feedback.most_votes') }}
				{% elseif search_options.order_by == 'i-voted' %}{{ phrase('user.feedback.i_voted') }}
				{% endif %}
			</a>
		</li>
		{% if category %}
			{% for cat in category.getTreeParents() %}
				<li><span class="dp-divider">&rarr;</span> <a href="{{ path('user_feedback', {'status': status, 'slug': cat.url_slug}) }}">{{ cat.title }}</a></li>
			{% endfor %}
			<li><span class="dp-divider">&rarr;</span> <a href="{{ path('user_feedback', {'status': status, 'slug': category.url_slug}) }}">{{ category.title }}</a></li>
		{% endif %}
		{% if parent_status and parent_status != 'any-status' %}
			<li>
				<span class="dp-divider">&rarr;</span>
				<a href="{{ path('user_feedback', {'status': parent_status, 'slug': category.url_slug}) }}">
					{% if parent_status == 'gathering-feedback' %}{{ phrase('user.feedback.status_new') }}
					{% elseif parent_status == 'active' %}{{ phrase('user.feedback.status_active') }}
					{% elseif parent_status == 'closed' %}{{ phrase('user.feedback.status_closed') }}
					{% endif %}
				</a>
			</li>
			{% if parent_status != status %}
				<li>
					<span class="dp-divider">&rarr;</span>
					<a href="{{ path('user_feedback', {'status': status, 'slug': category.url_slug}) }}">
						{% if parent_status == 'active' %}
							{{ active_status_cats[sub_status_id].title }}
						{% else %}
							{{ closed_status_cats[sub_status_id].title }}
						{% endif %}
					</a>
				</li>
			{% endif %}
		{% endif %}
	{% endif %}
{% endblock %}
{% block page_title %}
	{{ phrase('user.general.feedback') }}
	{% if not (status == 'any-status' and search_options.order_by == 'popular' and not category) %}
		-
		{% if search_options.order_by == 'popular' %}{{ phrase('user.feedback.status_popular') }}
		{% elseif search_options.order_by == 'newest' %}{{ phrase('user.feedback.newest') }}
		{% elseif search_options.order_by == 'most-voted' %}{{ phrase('user.feedback.most_votes') }}
		{% elseif search_options.order_by == 'i-voted' %}{{ phrase('user.feedback.i_voted') }}
	{% endif %}
	{% if category %}
		{% for cat in category.getTreeParents() %}
			- {{ cat.title }}
		{% endfor %}
		- {{ category.title }}
	{% endif %}
	{% if parent_status and parent_status != 'any-status' %}
		-
		{% if parent_status == 'gathering-feedback' %}{{ phrase('user.feedback.status_new') }}
		{% elseif parent_status == 'active' %}{{ phrase('user.feedback.status_active') }}
		{% elseif parent_status == 'closed' %}{{ phrase('user.feedback.status_closed') }}
		{% endif %}
		{% if parent_status != status %}
			-
			{% if parent_status == 'active' %}
				{{ active_status_cats[sub_status_id].title }}
			{% else %}
				{{ closed_status_cats[sub_status_id].title }}
			{% endif %}
		{% endif %}
	{% endif %}
{% endif %}
{% endblock %}
{% block content %}

<section class="dp-portal-section dp-new-feedback-section">
	<header>
		<h1>{{ phrase('user.general.feedback') }}</h1>
	</header>
	<article>
		<p>
			{{ phrase('user.feedback.explain') }}
		</p>
	</article>
</section>

{% include 'UserBundle:Feedback:filter-new-feedback.html.twig' %}

{% if not just_form %}
	<section class="dp-portal-section dp-feedback-section">
		<header>
			<h1>{{ phrase('user.feedback.there_are_x_suggestions', {'count': num_results}) }}</h1>
		</header>
		<div class="dp-content-block dp-articles-block">
			<div class="dp-content-wrapper">
				<div style="float:left; width: 100%;">
					{% include 'UserBundle:Feedback:filter-nav.html.twig' %}
				</div>
				<br style="clear:left;height: 1px;" />

				<ul class="dp-content-list">
					{% for feedback in feedback %}
						{% include 'UserBundle:Feedback:filter-list-item.html.twig' %}
					{% endfor %}
				</ul>

				{% if pageinfo.last != 1 %}
					{% set page_url = path('user_feedback', {'status': status, 'slug': category.url_slug|default('all-categories'), 'order_by': search_options.order_by }) ~ '?p=' %}
					<div class="dp-pagination">
						<ul>
							{% if pageinfo.prev %}<li><a href="{{ page_url ~ pageinfo.prev }}">&larr; {{ phrase('user.general.page_prev') }}</a></li>{% endif %}
							{% for p in pageinfo.pages %}
								<li class="{% if pageinfo.cursor == p %}dp-active{% endif %}"><a href="{{ page_url ~ p }}">{{ p }}</a>
							{% endfor %}
							{% if pageinfo.next %}<li><a href="{{ page_url ~ pageinfo.next }}">{{ phrase('user.general.next') }} &rarr;</a></li>{% endif %}
						</ul>
					</div>
				{% endif %}
			</div>
		</div>
	</section>
{% endif %}
{% endblock %}
