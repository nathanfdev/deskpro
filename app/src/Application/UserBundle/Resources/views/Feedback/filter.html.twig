{% set this_section = 'feedback' %}
{% extends 'UserBundle::layout.html.twig' %}
{% block head %}
<script src="{{ asset('javascripts/DeskPRO/User/ElementHandler/FeedbackNav.js') }}"></script>
{% endblock %}
{% macro cat_row(cat, status, selected_cat) %}
	<li {% if cat.id == selected_cat.id %}class="on"{% endif %}>
		<a href="{{ path('user_feedback', {'status': status, 'slug': cat.url_slug}) }}">{{ cat.title }}</a>
		{% if cat.children|length %}
			<ul>
				{% for subcat in cat.children %}
					{{ _self.cat_row(subcat, status) }}
				{% endfor %}
			</ul>
		{% endif %}
	</li>
{% endmacro %}
{% block breadcrumb %}
	<li><a href="{{ path('user_feedback') }}">{{ phrase('user.general.feedback') }}</a><span class="dp-divider">&rarr;</span></li>
	{% if not (status == 'all' and search_options.order_by == 'popular' and not category) %}
		<li>
			<a href="{{ path('user_feedback', {order_by:search_options.order_by}) }}">
				{% if search_options.order_by == 'popular' %}{{ phrase('user.feedback.popular') }}
				{% elseif search_options.order_by == 'popular' %}{{ phrase('user.feedback.newest') }}
				{% elseif search_options.order_by == 'most-voted' %}{{ phrase('user.feedback.most_voted') }}
				{% endif %}
			</a>
			<span class="dp-divider">&rarr;</span>
		</li>
		{% if parent_status != status %}
			<li>
				<a href="{{ path('user_feedback', {'status': status, 'slug': category.url_slug}) }}">
					{% if parent_status == 'active' %}
						{{ active_status_cats[sub_status_id].title }}
					{% else %}
						{{ closed_status_cats[sub_status_id].title }}
					{% endif %}
				</a>
				<span class="dp-divider">&rarr;</span>
			</li>
		{% endif %}
		{% if category %}
			{% for cat in category.getTreeParents() %}
				<li><a href="{{ path('user_feedback', {'status': status, 'slug': cat.url_slug}) }}">{{ cat.title }}</a><span class="dp-divider">&rarr;</span></li>
			{% endfor %}
			<li><a href="{{ path('user_feedback', {'status': status, 'slug': category.url_slug}) }}">{{ category.title }}</a><span class="dp-divider">&rarr;</span></li>
		{% endif %}
		<li>
			<a href="{{ path('user_feedback', {'status': parent_status, 'slug': category.url_slug}) }}">{{ phrase('user.feedback.status_' ~ parent_status) }}</a>
			<span class="dp-divider">&rarr;</span>
		</li>
	{% endif %}
{% endblock %}
{% block page_title %}
	{{ phrase('user.general.feedback') }}
	/ {{ phrase('user.feedback.status_' ~ parent_status) }}
	{% if parent_status != status %}
		/
		{% if parent_status == 'active' %}
			{{ active_status_cats[sub_status_id].title }}
		{% else %}
			{{ closed_status_cats[sub_status_id].title }}
		{% endif %}
	{% endif %}
	{% if category %}
		{% for cat in category.getTreeParents() %}
			/ {{ cat.title }}
		{% endfor %}
		/ {{ category.title }}
	{% endif %}
{% endblock %}
{% block content %}

<section class="dp-portal-section dp-new-feedback-section">
	<header>
		<h1>{{ phrase('user.general.feedback') }}</h1>
	</header>
	<article>
		<p>
			{{ phrase('user.feedback.explain') }}
		</p>
	</article>
</section>

{% include 'UserBundle:Feedback:filter-new-feedback.html.twig' %}

<section class="dp-portal-section">
	{% if category %}
	<header>
		{% if category %}
		<h1>{{ phrase('user.articles.there_are_x_articles', {'count': articles|length}) }}</h1>
		{% endif %}
	</header>
	{% endif %}
	<div class="dp-content-block dp-articles-block">
		<div class="dp-content-wrapper">
			<div style="float:left; width: 100%;">
				{% include 'UserBundle:Feedback:filter-nav.html.twig' %}
			</div>

			<ul class="dp-content-list">
				{% for feedback in feedback %}
					{% include 'UserBundle:Feedback:filter-list-item.html.twig' %}
				{% endfor %}
			</ul>

			{% if pageinfo.last != 1 %}
				{% set page_url = path('user_feedback', {'status': status, 'slug': category.url_slug|default('all-categories'), 'order_by': search_options.order_by }) ~ '?p=' %}
				<div class="dp-pagination">
					<ul>
						{% if pageinfo.prev %}<li><a href="{{ page_url ~ pageinfo.prev }}">&larr; {{ phrase('user.general.page_prev') }}</a></li>{% endif %}
						{% for p in pageinfo.pages %}
							<li class="{% if pageinfo.cursor == p %}dp-active{% endif %}"><a href="{{ page_url ~ p }}">{{ p }}</a>
						{% endfor %}
						{% if pageinfo.next %}<li><a href="{{ page_url ~ pageinfo.next }}">{{ phrase('user.general.page_next') }} &rarr;</a></li>{% endif %}
					</ul>
				</div>
			{% endif %}
		</div>
	</div>
</section>

{% endblock %}
