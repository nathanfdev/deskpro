<div style="background-color: #eee; padding: 3px;">
	<ul class="dp-hide-print">
		<li><a href="{{ path('user_feedback_newfeedback') }}">{{ phrase('user.general.submit_feedback') }}</a></li>
	</ul>
	<ul>
		<li style="margin-bottom: 15px;">
			{% if not status or status == 'new' %}
				<a href="{{ path('user_feedback') }}">
			{% else %}
				<a href="{{ path('user_feedback_status', {'status': status}) }}">
			{% endif %}
				{{ phrase('user.feedback.all_feedback') }}
			</a>
		</li>
	{% for cat in categories %}
		<li>
			{% if not status or status == 'new' %}
				<a href="{{ path('user_feedback_cat', {'slug': cat.url_slug}) }}">
			{% else %}
				<a href="{{ path('user_feedback_cat_status', {'slug': cat.url_slug, 'status': status}) }}">
			{% endif %}
			{{ cat.title }}</a>
		</li>
	{% endfor %}
	</ul>
</div>
