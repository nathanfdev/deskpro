{% extends 'UserBundle::layout.html.twig' %}
{% import "UserBundle:Common:property-fields.html.twig" as property_fields %}
{% block content %}

{% block finish_pre %}{% endblock %}

<div style="width: 220px; float:right; margin-left: 10px; background-color: #eee;">
	{{ phrase('user.register_here_are_extra_benefits') }}:
	<ul>
		<li>{{ phrase('user.register__never_validate_again') }}n</li>
		<li>{{ phrase('user.register_view_tickets_easily') }}</li>
		<li>{{ phrase('user.register_manage_profile') }}</li>
	</ul>
</div>
<h2 style="font-size: 15px;">{{ phrase('user.register_can_set_a_password') }}</h2>
<p>
	{{ phrase('user.register_reuse_account') }}:
</p>
<form action="{{ path('user_register_finish') }}" method="post">
	<input type="hidden" name="process" value="1" />
	{{ phrase('user.register_set_a_password') }}: <input type="password" name="password" value="" /><br />
	{{ phrase('global.repeat') }}: <input type="password" name="password2" value="" /><br />
	<input type="submit" value="{{ phrase('user.register_btn_register_account') }}" />
</form>

<br style="clear:both;" />

{% endblock %}