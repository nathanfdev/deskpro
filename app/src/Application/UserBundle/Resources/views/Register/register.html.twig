{% extends app.request.isXmlHttpRequest() ? 'UserBundle::auth-ajax-layout.html.twig' : 'UserBundle::auth-layout.html.twig' %}

{% import 'UserBundle:Common:macros-form.html.twig' as formmacro %}
{% set authManager = app.authenticationManager %}
{% if return is not defined or not return %}{% set return = app.returnUrl %}{% endif %}
{% if not is_helpdesk_path(return) %}{% set return = '' %}{% endif %}

{% block auth_register %}

	<form action="{{ path('user_register') }}" method="post">

		{{ form_token('user_register') }}
		<div class="dp-its-a-trap">
			{# Spam trap: If these fields contain values when submitted, the system knows a bot submitted the form #}
			<input type="text" name="first_name" value=""/>
			<input type="text" name="last_name" value=""/>
			<input type="text" name="email" value=""/>
		</div>
		<input type="hidden" name="process" value="1"/>

		<div class="dp-control-group {% if error_fields['name'] %}dp-error{% endif %}">
			<div class="dp-control-label">
				<label>{{ phrase('user.general.your_name') }} *</label>
			</div>
			<div class="dp-controls dp-fill">
				{{ form_widget(form.name) }}
				<div class="dp-help-inline dp-error-explain">
					{{ phrase('user.general.please_enter_your_name') }}
				</div>
			</div>
		</div>

		<div class="dp-control-group {% if error_fields['email'] %}dp-error{% endif %}">
			<div class="dp-control-label">
				<label>{{ phrase('user.general.your_email_address') }} *</label>
			</div>
			<div class="dp-controls dp-fill">
				{{ form_widget(form.email) }}
				{% if errors['email.invalid'] %}
					<div class="dp-help-inline dp-error-explain">{{ phrase('user.general.please_enter_your_email') }}</div>{% endif %}
				{% if errors['email.in_use'] %}
					<div class="dp-help-inline dp-error-explain">{{ phrase('user.profile.register_email_exists') }}</div>{% endif %}
			</div>
		</div>

		<div class="dp-control-group {% if error_fields['password'] %}dp-error{% endif %}">
			<div class="dp-control-label">
				<label>{{ phrase('user.profile.password') }} *</label>
			</div>
			<div class="dp-help-inline" style="font-size:11px;">
				{% if app.getSetting('user.password_policy.require_num_uppercase') %}{{ phrase('user.profile.register_password_min_uc', {count: app.getSetting('user.password_policy.require_num_uppercase')}) }}, {% endif %}
				{% if app.getSetting('user.password_policy.require_num_lowercase') %}{{ phrase('user.profile.register_password_min_lc', {count: app.getSetting('user.password_policy.require_num_lowercase')}) }}, {% endif %}
				{% if app.getSetting('user.password_policy.require_num_number') %}{{ phrase('user.profile.register_password_min_num', {count: app.getSetting('user.password_policy.require_num_number')}) }}, {% endif %}
				{% if app.getSetting('user.password_policy.require_num_symbol') %}{{ phrase('user.profile.register_password_min_sym', {count: app.getSetting('user.password_policy.require_num_symbol')}) }}, {% endif %}
				{% if app.getSetting('user.password_policy.min_length') %}{{ phrase('user.profile.register_password_min_length', {count: app.getSetting('user.password_policy.min_length')}) }}{% endif %}
			</div>
			<div class="dp-controls dp-fill">
				{{ form_widget(form.password) }}
			</div>
			{% if errors['password.invalid'] %}
				<div class="dp-help-inline dp-error-explain">{{ phrase('user.profile.register_password_invalid') }}</div>
			{% endif %}
			{% if errors['password.mismatch'] %}
				<div class="dp-help-inline dp-error-explain">{{ phrase('user.profile.register_password_mismatch') }}</div>
			{% endif %}
		</div>

		<div class="dp-control-group">
			<div class="dp-control-label">
				<label>{{ phrase('user.profile.label_repeat_password') }} *</label>
			</div>
			<div class="dp-controls dp-fill">
				{{ form_widget(form.password2) }}
			</div>
		</div>

		{% if form.language_id %}
			<div class="dp-control-group">
				<div class="dp-control-label">
					<label>{{ phrase('user.profile.language') }}</label>
				</div>
				<div class="dp-controls dp-fill">
					{{ form_widget(form.language_id) }}
				</div>
			</div>
		{% endif %}

		{% if not custom_fields %}{% set custom_fields = app.getPersonFieldManager().getDisplayArray() %}{% endif %}
		{% for f in custom_fields %}
			{% if f.field_def.getTypeName() == 'hidden' %}
				<div style="display: none;">{{ render_custom_field_form(f) }}</div>
			{% else %}
				<div class="dp-control-group {% if error_fields['field_' ~ f.field_def.id] %}dp-error{% endif %}">
					<div class="dp-control-label">
						<label>{{ f.field_def.title }}</label>
					</div>
					<div class="dp-controls dp-fill">
						{{ render_custom_field_form(f) }}
					</div>
					{% if error_fields['field_' ~ f.field_def.id] %}
						<div class="dp-help-inline dp-error-explain">{{ formmacro.custom_field_errors(errors, f.field_def, 'field_' ~ f.field_def.id) }}</div>{% endif %}
				</div>
			{% endif %}
		{% endfor %}

		{% if captcha %}
			<div class="dp-control-group {% if error_fields['captcha'] %}dp-error dp-error-static{% endif %}">
				<div class="dp-control-label">
					<label>{{ phrase('user.general.label_captcha') }} *</label>
				</div>
				<div class="dp-controls dp-fill">
					{{ captcha.getHtml()|raw }}
					{% if error_fields['captcha'] %}
						<div class="dp-help-inline dp-error-explain">
							{{ phrase('user.tickets.form_error_captcha_invalid') }}
						</div>
					{% endif %}
				</div>
			</div>
		{% endif %}

		<input class="dp-btn dp-btn-primary" type="submit" value="{{ phrase('user.tickets.submit') }}"/>
	</form>

{% endblock %}
