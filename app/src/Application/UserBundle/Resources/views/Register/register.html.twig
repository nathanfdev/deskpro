{% extends 'UserBundle::layout.html.twig' %}
{% block breadcrumb %}
	{% if this_page == 'register' %}
		<li><span class="dp-divider">&rarr;</span> <a href="{{ path('user_register') }}">{{ phrase('user.general.register') }}</a></li>
	{% else %}
		<li><span class="dp-divider">&rarr;</span> <a href="{{ path('user_register') }}">{{ phrase('user.general.log_in') }}</a></li>
	{% endif %}
{% endblock %}
{% block head %}
<script type="text/javascript">
	$(document).ready(function() {
		$('#user_type_exist').on('click', function() {
			$('#user_type_new_form').hide();
			$('#user_type_exist_form').show();
		});
		$('#user_type_new').on('click', function() {
			$('#user_type_exist_form').hide();
			$('#user_type_new_form').show();
		});
	});
</script>
{% endblock %}
{% block content %}

<div class="dp-register-page">

	{% if from_ticket.id %}
		<div class="dp-alert dp-alert-success">
			<strong>"{{ from_ticket.subject }}" can be viewed online</strong><br />
			<p>
				To view and manage your ticket online, register for an account or log in. This step is optional, you will still get replies from our agents to your email address.
			<p>
		</div>
	{% endif %}

	<section class="dp-well">
		<header>
			{% if app.usersourceManager.getWithCapability('tpl_login_pull_btn') %}
				<div class="dp-connect-with">
					{{ phrase_dev('Or connect with') }}
					{% for usersource in app.usersourceManager.getWithCapability('tpl_login_pull_btn') %}
						{{ render_usersource(usersource, 'login_pull_btn') }}
					{% endfor %}
				</div>
			{% endif %}
			<label>
				<h3><input type="radio" name="user_type" id="user_type_exist" {% if this_page == 'login' %}checked="checked"{% endif %} /> {{ phrase_dev("I am already a registered user") }}</h3>
			</label>
		</header>
		<article id="user_type_exist_form" class="dp-well dp-well-light" {% if this_page != 'login' %}style="display:none"{% endif %}>
			{% if failed_login_name %}
				<div class="dp-alert dp-alert-error">
					{{ phrase('user.general.login_error') }}
				</div>
			{% endif %}
			<form action="{{ path('user_login_authenticate_local') }}" class="dp-layout" method="post">
				{% if return %}
					<input type="hidden" name="return" value="{{return}}" />
				{% endif %}
				<table cellspacing="0" cellpadding="0" width="100%">
					<tr>
						<td>
							<div style="padding-bottom: 5px;">
								{{ phrase('user.general.email_address') }}
							</div>
							<div>
								<input tabindex="500" type="text" value="" name="email" size="20" value="{{ failed_login_name }}" />
							</div>
						</td>
						<td>
							<div style="padding-bottom: 5px;">
								{{ phrase('user.general.password') }}
								<a style="margin-left: 9px;" href="{{ path('user_login_resetpass') }}">{{ phrase('user.general.lost_qm') }}</a>
							</div>
							<div>
								<input tabindex="501" type="password" value="" name="password" size="20" />
							</div>
						</td>
						<td style="text-align: center; vertical-align: middle;" valign="middle">
							<input class="dp-btn dp-btn-primary" type="submit" value="{{ phrase('user.general.log_in') }}" />
						</td>
					</tr>
				</table>
			</form>
		</article>
	</section>
	<section class="dp-well">
		<header>
			<label>
				<h3><input type="radio" name="user_type" id="user_type_new" {% if this_page == 'register' %}checked="checked"{% endif %} /> {{ phrase_dev("I am a new user") }}</h3>
			</label>
		</header>
		<article id="user_type_new_form" class="dp-well dp-well-light" {% if this_page != 'register' %}style="display:none"{% endif %}>
			<form action="{{ path('user_register') }}" method="post">
				<input type="hidden" name="process" value="1" />

				<div class="dp-control-group {% if error_fields['name'] %}dp-error{% endif %}">
					<div class="dp-control-label">
						<label>{{ phrase('user.general.your_name') }} *</label>
					</div>
					<div class="dp-controls dp-fill">
						{{ form_widget(form.name, {attr:{tabindex: 1}}) }}
						<div class="dp-help-inline dp-error-explain">
							{{ phrase('user.general.register_enter_name') }}
						</div>
					</div>
				</div>

				<div class="dp-control-group {% if error_fields['email'] %}dp-error{% endif %}">
					<div class="dp-control-label">
						<label>{{ phrase('user.general.your_email_address') }} *</label>
					</div>
					<div class="dp-controls dp-fill">
						{{ form_widget(form.email) }}
						{% if errors['email.invalid'] %}<div class="dp-help-inline dp-error-explain">{{ phrase('user.general.register_enter_valid_email') }}</div>{% endif %}
						{% if errors['email.in_use'] %}<div class="dp-help-inline dp-error-explain">{{ phrase('user.general.register_email_exists') }}</div>{% endif %}
					</div>
				</div>

				<div class="dp-control-group {% if error_fields['password'] %}dp-error{% endif %}">
					<div class="dp-control-label">
						<label>{{ phrase('user.general.password') }} *</label>
					</div>
					<div class="dp-controls dp-fill">
						{{ form_widget(form.password) }}
					</div>
					{% if errors['password.short'] %}<div class="dp-help-inline dp-error-explain">{{ phrase('user.general.register_password_min_length') }}</div>{% endif %}
					{% if errors['password.mismatch'] %}<div class="dp-help-inline dp-error-explain">{{ phrase('user.general.register_password_mismatch') }}</div>{% endif %}
				</div>

				<div class="dp-control-group">
					<div class="dp-control-label">
						<label>{{ phrase('user.profile.label_repeat_password') }} *</label>
					</div>
					<div class="dp-controls dp-fill">
						{{ form_widget(form.password2) }}
					</div>
				</div>

				<div class="dp-control-group">
					<div class="dp-control-label">
						<label>{{ phrase('user.general.label_captcha') }} *</label>
					</div>
					<div class="dp-controls dp-fill">
						{% include 'UserBundle:Common:recaptcha.html.twig' %}
					</div>
				</div>

				<input class="dp-btn dp-btn-primary" type="submit" value="{{ phrase('user.tickets.submit') }}" />
			</form>
		</article>
	</section>
</div>

{% endblock %}
