{% extends 'UserBundle::layout.html.twig' %}
{% block breadcrumb %}
	<li><a href="{{ path('user_register') }}">{{ phrase('user.register') }}</a></li>
{% endblock %}
{% block content %}
<div
	class="dp-content-block dp-register-page with-handler"
>
	<div class="dp-box">
		<div class="dp-box-header">
			<h1>{{ phrase('global.register') }}</h1>
		</div>
		<div class="dp-box-content-wrapper">
			<div class="dp-box-content dp-form">
				<form action="" method="post">
				<input type="hidden" name="process" value="1" />

					<div class="dp-form-row {% if error_fields['name'] %}dp-error{% endif %}">
						<div class="dp-form-label">
							<label>{{ phrase('user.label_your_name') }} *</label>
						</div>
						<div class="dp-form-input">
							{{ form_widget(form.name) }}
							<div class="dp-error-explain">
								{{ phrase('user.register_please_enter_name') }}
							</div>
						</div>
					</div>

					<div class="dp-form-row {% if error_fields['email'] %}dp-error{% endif %}">
						<div class="dp-form-label">
							<label>{{ phrase('user.label_your_email') }} *</label>
						</div>
						<div class="dp-form-input">
							{{ form_widget(form.email) }}
							{% if errors['email.invalid'] %}<div class="dp-error-explain">{{ phrase('user.register_please_enter_valid_email') }}</div>{% endif %}
							{% if errors['email.in_use'] %}<div class="dp-error-explain">{{ phrase('user.register_email_address_exists_already') }}</div>{% endif %}
						</div>
					</div>

					<div class="dp-form-row {% if error_fields['password'] %}dp-error{% endif %}">
						<div class="dp-form-label">
							<label>{{ phrase('global.password') }} *</label>
						</div>
						<div class="dp-form-input">
							{{ form_widget(form.password) }}
						</div>
						{% if errors['password.short'] %}<div class="dp-error-explain">{{ phrase('user.register_password_must_be_at_least') }}</div>{% endif %}
						{% if errors['password.mismatch'] %}<div class="dp-error-explain">{{ phrase('user.register_password_mismatch') }}</div>{% endif %}
					</div>

					<div class="dp-form-row">
						<div class="dp-form-label">
							<label>{{ phrase('user.profile.label_repeat_password') }} *</label>
						</div>
						<div class="dp-form-input">
							{{ form_widget(form.password2) }}
						</div>
					</div>

					<div class="dp-form-row">
						<div class="dp-form-label">
							<label>{{ phrase('user.label_captcha') }} *</label>
						</div>
						<div class="dp-form-input">
							{% include 'UserBundle:Common:recaptcha.html.twig' %}
						</div>
					</div>

					<div class="dp-footer">
						<input class="btn primary" type="submit" value="{{ phrase('global.register') }}" />
					</div>
				</form>
			</div>
		</div>
	</div>
</div>
{% endblock %}
