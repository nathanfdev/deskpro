{% for news in news_entries %}
	<li class="{% if show_more and loop.last %}has-more{% endif %}">
		<div style="float:right">
			<div class="cal-date" title="{{ feedback.date_created|date('M d Y @ H:i:s') }}" style="margin-bottom: 4px;">
				<div class="month">{{ feedback.date_created|date('M')|upper }}</div>
				<div class="day">{{ feedback.date_created|date('d') }}</div>
			</div>
			<div class="info-line">
				<ul>
					<li class="comments" title="{{ phrase('user.comments') }}" style="width: 46px; text-align: center; display: block; padding: 0;"><span>{{ rand(1, 50) }}</span></li>
				</ul>
			</div>
		</div>
		<h4><a href="{{ path('user_news_view', {'slug': news.url_slug}) }}">{{ news.title }}</a></h4>
		<div class="message">
			{{ news.excerpt_html|raw }}
		</div>
		<div class="more-link"><a href="">{{ phrase('user.news.view_entire_article') }} {% if news.count_words_after_excerpt > 0 %}{{ phrase('user.news.count_words_remaining', {'count':news.count_words_after_excerpt}) }}{% endif %} &rarr;</a></div>
	</li>
{% endfor %}