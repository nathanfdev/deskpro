{% extends 'UserBundle:News:layout.html.twig' %}
{% block breadcrumb %}
	<li><a href="{{ path('user_news') }}">{{ phrase('global.news') }}</a></li>
	{% for cat in category_path %}
		<li><a href="{{ path('user_news', {'slug': cat.url_slug}) }}">{{cat.title}}</a></li>
	{% endfor %}
{% endblock %}
{% block page_title %}
	News
	{% for cat in category_path %}
		/ {{cat.title}}
	{% endfor %}
{% endblock %}
{% block news_list %}
<div class="with-handler"
		data-element-handler="DeskPRO.User.ElementHandler.MoreLoader"
		data-load-url="{{ path('user_news_list', {'page': '00000', 'per_page': per_page})|replace({'00000': '{page}'}) }}"
	>
	<ul class="dp-news-list">
		{% include 'UserBundle:News:browse-news-list.html.twig' %}
	</ul>
	{% if is_partial_request() %}
		{% if num_results > news_entries|length %}
			<div class="dp-footer">
				<a href="{{ path('user_news') }}" class="btn">{{ phrase('user.news.view_all_x_news', {'count': num_results}) }}</a>
			</div>
		{% endif %}
	{% else %}
		{% if pageinfo.last != 1 %}
			<div class="dp-footer">
				<div class="pagination">
					<ul>
						{% if pageinfo.prev %}
							<li>
								<a href="{{ path('user_news', {'status': status, 'slug': category.url_slug, 'page': pageinfo.prev }) }}">{{ phrase('user.page_prev') }}</a>
							</li>
						{% endif %}
						{% for p in pageinfo.pages %}
							<li {% if pageinfo.curpage == p %}class="active"{% endif %}>
								<a href="{{ path('user_news', {'status': status, 'slug': category.url_slug, 'page': p }) }}">{{ p }}</a>
							</li>
						{% endfor %}
						{% if pageinfo.next %}
							<li>
								<a href="{{ path('user_news', {'status': status, 'slug': category.url_slug, 'page': pageinfo.next }) }}">{{ phrase('user.page_next') }}</a>
							</li>
						{% endif %}
					</ul>
					<br class="dp-clear" style="clear:right"/>
				</div>
			</div>
		{% endif %}
	{% endif %}
</div>
{% endblock %}
