{% extends is_partial_request() ? 'UserBundle::layout-partial.html.twig' : 'UserBundle::layout.html.twig' %}
{% block head %}
{% if do_portal %}
	<script src="{{ asset('javascripts/DeskPRO/User/ElementHandler/Kb.js') }}"></script>
{% endif %}
{% endblock %}
{% block content %}
<div class="dp-content-block dp-news-page">
	<div class="dp-box">
		<div class="dp-box-header">
			{% if category %}
				<h1><a href="{{ path('user_news', {'slug': category.url_slug}) }}">{{ phrase('global.news') }}: {{category.title}}</a></h1>
			{% else %}
				<h1><a href="{{ path('user_news') }}">{{ phrase('global.news') }}</a></h1>
			{% endif %}
		</div>

		<div class="dp-box-content-wrapper">
			<div class="dp-box-content">
				{% block news_list %}{% endblock %}
			</div>
		</div>
	</div>
</div>
{% endblock %}
