{% extends 'UserBundle:News:layout.html.twig' %}
{% block breadcrumb %}
	<li><a href="{{ path('user_news') }}">{{ phrase('user.general.news') }}</a></li>
	{% for cat in category_path %}
		<li><a href="{{ path('user_news', {'slug': cat.url_slug}) }}">{{cat.title}}</a></li>
	{% endfor %}
{% endblock %}
{% block news_posts %}
<div class="with-handler"
		data-element-handler="DeskPRO.User.ElementHandler.MoreLoader"
		data-load-url="{{ path('user_news', {'page': '00000', 'per_page': per_page})|replace({'00000': '{page}'}) }}"
	>
	<div class="content-filters">
		{{ phrase('user.general.category') }}:
		<select name="category_id" class="category_id" onchange="window.location = $(this).val();">
			<option value="{{ path('user_news') }}">All ({{ category_counts[0] }})</option>
			{% for cat in news_cats %}
				<option value="{{ path('user_news', {'slug': news_cat_objs[cat.id].url_slug}) }}" {% if category.id == cat.id %}selected="selected"{% endif %}>{{ '--'|repeat(cat.depth) }}{{ cat.title }} ({{ category_counts[cat.id] }})</option>
			{% endfor %}
		</select>
	</div>
	<div class="content-list">
		<ul>
			{% include 'UserBundle:News:browse-news-posts.html.twig' %}
		</ul>
	</div>
	{% if show_more %}
	<div class="content-more">
		<div class="is-not-loading">
			<button>{{ phrase('user.general.more') }}</button>
		</div>
		<div class="is-loading">
			<center><img src="{{ asset('images/loading-big-circle.gif') }}" alt="" /></center>
		</div>
	</div>
	{% endif %}
</div>
{% endblock %}
