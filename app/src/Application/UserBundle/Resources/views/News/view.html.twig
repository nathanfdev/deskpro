{% extends 'UserBundle::layout.html.twig' %}
{% block head %}
	<meta property="og:url" content="{{ path('user_news_view', {'slug': post.url_slug}) }}" />
	<meta property="og:title" content="{{post.title}}" />
	<meta property="og:type" content="blog" />
	<link rel="canonical" href="{{ url('user_news_view', {'slug': post.url_slug}) }}" />
{% endblock %}
{% block breadcrumb %}
	<li><a href="{{ path('user_news') }}">{{ phrase('user.news.section_name') }}</a></li>
	{% for cat in category_path %}
		<li><a href="{{ path('user_news', {'slug': cat.url_slug}) }}">{{cat.title}}</a></li>
	{% endfor %}
	<li><a href="{{ path('user_news_view', {'slug': post.url_slug}) }}">{{ post.title }}</a></li>
{% endblock %}
{% block page_title %}
	{{ post.title }}
	-
	News
	{% for cat in category_path %}
		/ {{cat.title}}
	{% endfor %}
{% endblock %}
{% block content %}
<div class="dp-news-page">
	<div class="dp-content-block">
		<div class="dp-box">
			<div class="dp-box-header">
				<h1>{{ post.title }}</h1>
			</div>

			<div class="dp-box-content-meta">
				<div class="by-line">
					<img src="{{ post.person.getPictureUrl(40) }}" />
					{{ phrase('user.created_by_x_on_y', {'name': post.person.display_name, 'date': post.date_created|date('M d Y')}) }}
					<br class="dp-clear" style="clear:left" />
				</div>
			</div>

			<div class="dp-box-content-wrapper">
				<div class="dp-box-content">
					<div class="dp-post">{{ post.content_html|raw }}</div>

					{% include 'UserBundle:Common:labels-box.html.twig' with {'labels': post.labels} %}

					{% if app.user.hasPerm('news.rate') %}
						{% include 'UserBundle:Common:rating-bar.html.twig' with {'content_object': post} %}
					{% endif %}

					{% if app.getSetting('core.facebook_like') %}
						{% include 'UserBundle:Common:facebook-like.html.twig' with {'page_permalink': news.permalink} %}
					{% endif %}

					{% if app.user.hasPerm('news.comment') %}
						{% include 'UserBundle:Common:comments-box.html.twig' with {
							'comments': comments,
							'form_action': path('user_news_newcomment', {'post_id': post.id}),
							'check_perm': 'news.comment'
						} %}
					{% endif %}
				</div>
			</div>
		</div>
	</div>
</div>
{% endblock %}
