{% for news in news_entries %}
	<li>
		<div class="dp-cal-date" title="{{ phrase('user.posted_date', {'date':news.date_created|date('M d Y @ H:i:s')}) }}">
			<div class="month">{{ news.date_created|date('M')|upper }}</div>
			<div class="day">{{ news.date_created|date('d') }}</div>
		</div>
		<div class="dp-inner">
			<div class="dp-faded-container">
				<h4 style="margin-bottom: 0"><a href="{{ path('user_news_view', {'slug': news.url_slug}) }}">{{ news.title }}</a></h4>
				<div class="dp-bound-faded"></div>
			</div>
			<div class="dp-meta">
                {{ phrase('user.news.author_name', {'name':news.person.display_name}) }}
				{% if news.category %}
					| {{ phrase('global.category') }} <a href="{{ path('user_news_list', {'slug': news.category.url_slug })}}">{{ news.category.title }}</a>
				{% endif %}
				{% if comment_counts[news.id] %}{{ phrase('user.news._comments') }}: {{ comment_counts[news.id] }}{% endif %}
			</div>
		</div>
	</li>
{% endfor %}
