{% import 'UserBundle:Common:macros-social.html.twig' as social %}
{% for news in news_entries %}
	<li>
		<section class="dp-news-post dp-content-post">
			<div class="dp-cal-date" title="{{ phrase('user.general.posted_date', {'date':news.date_created|date('M d Y @ H:i:s')}) }}">
				<div class="dp-month">{{ news.date_created|date('M')|upper }}</div>
				<div class="dp-day">{{ news.date_created|date('d') }}</div>
			</div>
			<header>
				<h3 style="margin-bottom: 0"><a href="{{ path('user_news_view', {'slug': news.url_slug}) }}">{{ news.title }}</a></h3>
				<ul class="dp-post-info">
					<li class="dp-author"><i class="dp-icon-user"></i> {{ news.person.display_name }}</li>
					<li class="dp-category"><i class="dp-icon-folder-close"></i> <a href="{{ path('user_news_list', {'slug': news.category.url_slug })}}">{{ news.category.title }}</a></li>
				</ul>
			</header>
			<article>
				{{ news.content|raw }}
			</article>
			<footer>
				{{ social.social_block(path('user_news_view', {'slug': news.url_slug}), news.title) }}
			</footer>
		</section>
	</li>
{% endfor %}
