{% if not app.user.is_guest %}
<div class="dp-form">
	<table cellspacing="0" cellpadding="0" width="100%"><tr><td valign="top" width="50%" style="padding-right: 10px;">
		<div class="dp-form-row {% if error_fields['person.name'] %}dp-error{% endif %} dp-form-row-person_name">
			<div class="dp-form-label">
				<label>{{ phrase('global.name') }}</label>
				<em class="desc">{{ phrase('global.required') }}</em>
			</div>
			<div class="dp-form-input">
				<input
						type="text"
						name="new_comment[name]"
						class="display-name-field"
						value="{{ app.user.display_name }}"
						data-field-validators="DeskPRO.Form.LengthValidator"
						data-min-len="2"
						/>
				<div class="dp-error-explain">
					{{ phrase('user.register_please_enter_name') }}
				</div>
			</div>
		</div>
	</td><td valign="top" width="50%" style="padding-left: 10px;">
		<div class="dp-form-label">
			<label>{{ phrase('user.comments_logged_in_as') }}</label>
		</div>
		<div class="dp-form-input">
			<span class="logged-in-as {{ app.session.get('auth_usersource_type') }}">
				{% if app.session.get('usersource_display_link') %}
					<a href="{{ app.session.get('usersource_display_link') }}">
						{{ app.session.get('usersource_display_name')|default(app.user.display_name) }}
					</a>
				{% else %}
					{{ app.session.get('usersource_display_name')|default(app.user.display_name) }}
				{% endif %}
			</span>
		</div>
	</td></tr></table>
</div>
{% else %}
<div class="dp-form">
	<div class="form-row">
		<table cellspacing="0" cellpadding="0" width="100%"><tr><td valign="top" width="50%" style="padding-right: 10px;">
			<div class="dp-form-row {% if error_fields['person.name'] %}dp-error{% endif %} dp-form-row-person_name">
				<div class="dp-form-label">
					<label>{{ phrase('global.name') }}</label>
					<em class="desc">{{ phrase('global.required') }}</em>
				</div>
				<div class="dp-form-input">
					<input
							type="text"
							name="new_comment[name]"
							class="display-name-field"
							value=""
							data-field-validators="DeskPRO.Form.LengthValidator"
							data-min-len="2"
							/>
					<div class="dp-error-explain">
						{{ phrase('user.register_please_enter_name') }}
					</div>
				</div>
			</div>
		</td><td valign="top" width="50%" style="padding-left: 10px;">
			<div class="dp-form-row dp-form-row-person_email" id="comment_login_wrap">
				<div class="dp-form-label">
					<label>{{ phrase('user.label_email_address') }}</label>
					<em class="desc">{{ phrase('user.required_not_displayed') }}</em>
				</div>
				<div class="dp-form-input">
					<input
							type="text"
							name="new_comment[email]"
							class="display-name-field"
							value=""
							data-field-validators="DeskPRO.Form.LengthValidator"
							data-min-len="2"
							/>
					{% if app.usersourceManager.getWithCapability('tpl_widget_overlay_btn') %}
					<div class="connect-with">
						{{ phrase('global.or_connect_with') }}
						{% for usersource in app.usersourceManager.getWithCapability('tpl_widget_overlay_btn') %}
						{{ render_usersource(usersource, 'widget_overlay_btn') }}
						{% endfor %}
					</div>
					{% endif %}
					<div class="dp-error-explain">
						{{ phrase('user.comments_please_enter_email') }}
					</div>
				</div>
			</div>
		</td></tr></table>
	</div>
</div>
{% endif %}