{% macro select_options_hierarchy(cat, selected, depth) %}
	{% if not depth %}{% set depth = 0 %}{% endif %}
	{% set indent = '&nbsp;'|repeat(depth) %}
	{% if cat.children|length %}
		<optgroup label="{{ indent|raw }}{{ cat.title }}">
			{% for child in cat.children %}
				{{ _self.select_options_hierarchy(child, selected, depth+1) }}
			{% endfor %}
		</optgroup>
	{% else %}
		<option value="{{ cat.id }}" {% if selected == cat.id %}selected="selected"{% endif %}>{{ indent|raw }}{{ cat.title }}</option>
	{% endif %}
{% endmacro %}