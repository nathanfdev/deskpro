<div id="dp_userbar">
	{% if app.user.is_guest %}
		{{ phrase('user.general.welcome_back_guest') }} &middot;
		<a href="{{ path('user_login') }}" id="dp_login_link">{{ phrase('user.general.log_in') }}</a> &middot; <a href="{{ path('user_register') }}">{{ phrase('user.general.welcome_back_x') }}</a>
	{% else %}
		{{ phrase('user.general.welcome_back_x', {'name': app.user.display_name}) }} &middot;
		{% if app.user.HelpdeskUser.ticket_count %}
			<a href="{{ path('user_tickets') }}">{{ phrase('user.general.view_my_x_tickets', {'count': app.user.HelpdeskUser.ticket_count}) }}</a> &middot;
		{% endif %}
		<a href="{{ path('user_profile') }}">{{ phrase('user.general.edit_my_profile') }}</a> &middot;
		<a href="{{ path('user_logout', {'auth': static_security_token('user_logout', 0) }) }}">{{ phrase('user.general.log_out') }}</a>
	{% endif %}
</div>
