<div class="dp-user-vote dp-hide-print">
	{% if app.getSetting('user.show_ratings') and content_object.num_ratings >= app.getSetting('user.show_ratings') %}
		<div style="float:left; margin-top: 2px;">
			{{ phrase('user.general.rating_x_of_y_found_helpful', {'percent': content_object.rating_percent, 'vote_count': content_object.num_ratings}) }}
		</div>
	{% endif %}
	<form action="{{ path('user_saverating', { 'object_type': content_object.content_type, 'object_id': content_object.id}) }}" method="post">
		<input type="hidden" name="log_search_id" value="{{ rating_log_search_id }}" />
		{% if rating.rating %}
			{% if rating.rating >= 1 %}
				{{ phrase('user.general.marked_as_helpful') }}
			{% else %}
				{{ phrase('user.general.marked_as_unhelpful') }}
			{% endif %}
		{% else %}
			<button class="good" value="1" name="rating"><span>{{ phrase('user.general.set_as_helpful') }}</span></button>
			<button class="bad" value="-1" name="rating"><span>{{ phrase('user.general.set_as_unhelpful') }}</span></button>
		{% endif %}
	</form>
</div>
