<li class="{% if comment.person.is_agent == 2 %}agent{% endif %} {% if comment.status != 'visible' %}dp-validating{% endif %}">
	<div class="avatar" style="background-image: url('{{ path('serve_default_picture', {'s': 30}) }}');"></div>
	<div class="post">
		<div class="byline">
			<span class="time">{{ comment.date_created|date('M j, Y') }}</span>
			<cite>{{ comment.getUserName() }}</cite>
		</div>
		<div class="message">
			{{ comment.content_html|raw }}
			{% if comment.status != 'visible' %}
				<p class="dp-validating-note">{{ phrase('user.general.your_comment_agent_validation') }}</p>
			{% endif %}
		</div>
	</div>
</li>
