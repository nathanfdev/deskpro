{% macro twitter_share(page_url, page_title) %}
	<a href="https://twitter.com/share" class="twitter-share-button" {% if page_url %}data-url="{{ page_url }}"{% endif %} {% if page_title %}data-text="{{ page_title }}"{% endif %} data-width="50">Tweet</a>
{% endmacro %}

{% macro facebook_like(page_url) %}
	<div class="fb-like" data-href="http://exampdadasdle.com/" data-send="false" data-layout="button_count" data-width="50" data-show-faces="false"></div>
{% endmacro %}

{% macro gplus_plusone(page_url) %}
	<div class="g-plusone" data-size="medium" data-href="{{ page_url }}"></div>
{% endmacro %}

{% macro linkedin_share(page_url) %}
	<script type="IN/Share" data-url="{{ page_url }}" data-counter="right"></script>
{% endmacro %}

{% macro social_block(page_url, page_title) %}
	<div class="dp-social-block">
		<table style="margin: 0 auto 0 auto;"><tr>
			<th width="100" style="vertical-align: top;">Share this:</th>
			<td width="50" style="vertical-align: top;">{{ _self.twitter_share(page_url, page_title) }}</td>
			<td width="50" style="vertical-align: top;">{{ _self.facebook_like(page_url) }}</td>
			<td width="50" style="vertical-align: top;">{{ _self.gplus_plusone(page_url) }}</td>
			<td width="50" style="vertical-align: top;">{{ _self.linkedin_share(page_url) }}</td>
		</tr></table>
	</div>
{% endmacro %}