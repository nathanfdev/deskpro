{% macro twitter_share(page_url, page_title) %}
	<a href="https://twitter.com/share" class="twitter-share-button" {% if page_url %}data-url="{{ page_url }}"{% endif %} {% if page_title %}data-text="{{ page_title }}"{% endif %} data-width="110">Tweet</a>
{% endmacro %}

{% macro facebook_like(page_url) %}
	<div class="fb-like" data-href="http://exampdadasdle.com/" data-send="false" data-layout="button_count" data-width="96" data-show-faces="false"></div>
{% endmacro %}

{% macro gplus_plusone(page_url) %}
	<div class="g-plusone" data-size="medium" data-href="{{ page_url }}"></div>
{% endmacro %}

{% macro linkedin_share(page_url) %}
	<script type="IN/Share" data-url="{{ page_url }}" data-counter="right"></script>
{% endmacro %}

{% macro social_block(page_url, page_title) %}
	<div class="dp-social-block">
		<table><tr>
			<td class="dp-title">{{ phrase('user.general.share_this') }}:</th>
			<td">
				{% if app.getSetting('core.show_share_twitter') %}
					<span class='st_twitter_hcount' displayText='Tweet'></span>
					&nbsp;
				{% endif %}
				{% if app.getSetting('core.show_share_facebook') %}
					<span class='st_facebook_hcount' displayText='Facebook'></span>
					&nbsp;
				{% endif %}
				{% if app.getSetting('core.show_share_linkedin') %}
					<span class='st_linkedin_hcount' displayText='LinkedIn'></span>
					&nbsp;
				{% endif %}
				{% if app.getSetting('core.show_share_gplus') %}
					<span class='st_plusone_hcount' displayText='Google +1'></span>
				{% endif %}
			</td>
		</tr></table>
	</div>
{% endmacro %}