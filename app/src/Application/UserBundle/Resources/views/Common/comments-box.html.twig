<section class="dp-comments-box dp-well">
	<header>
		<h4>{{ phrase('user.general.count_comments', {'count': comments|length}) }}</h4>
	</header>
	<article class="dp-well dp-well-light">
		{% if comments_widget %}
			{{comments_widget|raw}}
		{% else %}
			<ul>
				{% for comment in comments %}
					<li {% if comment.person.is_agent == 2 %}class="agent"{% endif %}>
						<header>
							<div class="avatar" style="width: 40px; height: 40px; background-image: url('{{ path('serve_default_picture', {'s': 40}) }}');"></div>
							<div class="byline" style="margin-left: 48px;">
								<h4>{{ comment.getUserName() }}</h4>
								<ul class="dp-post-info">
									<li class="dp-date"><i class="dp-icon-calendar"></i> {{ comment.date_created|date('full') }}</li>
								</ul>
							</div>
						</header>
						<article>
							{{ comment.content_html|raw }}
						</article>
					</li>
				{% endfor %}
				{% if not no_comment_form %}
					{% if not app.user.id and app.getSetting('core.interact_require_login') %}
						<li class="new-comment no-nav">
							{% set phrase_link1 %}
							<a href="{{ path('user_register') }}">{{ phrase('user.general.register') }}</a>
							{% endset %}
							{% set phrase_link2 %}
							<a href="{{ path('user_login') }}">{{ phrase('user.general.comments_login') }}</a>
							{% endset %}
							{{ phrase('user.general.comments_add_a_comment', {'link1':phrase_link1,'link2':phrase_link2}) }}
						</li>
					{% elseif app.user.hasPerm(check_perm) %}
					<li class="new-comment {% if not app.user.is_guest %}no-nav{% endif %}" id="comments_login_info">
						<form action="{{ form_action }}" method="post" class="with-form-validator">
							<div class="login-area">
								<div class="inner-wrap">
									<div>
										<textarea name="new_comment[content]" cols="120" rows="5" placeholder="{{ phrase('user.general.comments_add_a_comment') }}"></textarea>
									</div>
									<div id="comments_form_login_area" data-element-handler="DeskPRO.User.ElementHandler.CommentFormLogin" class="with-handler">{% include 'UserBundle:Common:comments-login-form.html.twig' %}</div>
									<div style="padding-top: 0">
										<button class="dp-btn dp-primary" style="margin-top: 10px;">{{ phrase('user.general.post_comment_btn') }}</button>
									</div>
								</div>
							</div>
						</form>
					</li>
					{% endif %}
				{% endif %}
			</ul>
		{% endif %}
	</article>
</section>