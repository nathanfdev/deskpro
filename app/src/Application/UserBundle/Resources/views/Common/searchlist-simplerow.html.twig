<li class="{{ type }} {{ type }}-{{ item.id }}">
	{% if q %}
		<a
			href="{{ path('user_search', {q: q, c: count, t: security_token(q ~ count), gourl: item.getLink() }) }}"
			onmouseover="window.status='item.getLink()';"
			onmouseout="window.status='item.getLink()';"
			class="view-item"
			data-content-type="{{ type }}"
			data-content-id="{{ item.id }}"
		>
	{% else %}
		<a href="{{ item.getLink() }}" class="view-item" data-content-type="{{ type }}" data-content-id="{{ item.id }}">
	{% endif %}
		<span>{{ item.title }}</span>
	</a>
	<div class="summary">
		{% if type == 'article' %}
			{{ item.getSearchSummary(100) }}
		{% elseif type == 'news' %}
			{{ item.date_created|date('Y-m-d') }} &middot; {{ phrase('user.general.count_comments', {'count': item.num_comments}) }}
		{% elseif type == 'download' %}
			{{ item.getFileName() }} &middot; {{ item.getReadableFileSize() }}
		{% elseif type == 'feedback' %}
            {{ phrase('user.general.count_votes', {'count': item.total_rating}) }} &middot; {{ phrase('user.general.count_comments', {'count': item.num_comments}) }}
		{% endif %}
	</div>
</li>
