{% if not field_name %}{% set field_name = "attach[]" %}{% endif %}
{% if not good_field_name %}{% set good_field_name = "attach" %}{% endif %}
{% if not blob_field_name %}{% set blob_field_name = "attach_ids[]" %}{% endif %}
<div
	class="with-handler {{ add_classname }} form-upload-section"
	data-element-handler="DeskPRO.User.ElementHandler.FormUploadHandler"
	data-upload-to="{{ path('user_accept_upload') }}"
	data-security-token="{{ security_token('attach_temp') }}"
	data-drop-document="1"
>
	<div class="dp-fallback">
		{% for i in 0..5 %}
			<input type="file" name="{{ field_name }}" />
		{% endfor %}
	</div>
	<div class="dp-good-upload" style="display: none">
		<script class="dptpl-attach-upload" type="text/x-jquery-tmpl">
			<li class="uploading">{{ phrase('user.uploading') }}: ${name} <span class="cancel">{{ phrase('user.cancel') }}</span></li>
		</script>
		<script class="dptpl-attach-download" type="text/x-jquery-tmpl">
			{{ '{{if error}} '}}
				<li class="error">
					${error}
				</li>
			{{ '{{else}} '}}
				<li class="uploaded">
					<input type="hidden" name="{{ blob_field_name }}" value="${blob_auth_id}" />
					<a href="${download_url}" target="_blank">${filename}</a>
					<span class="size">${filesize_readable}</span>
					<span class="remove">{{ phrase('user.remove') }}</span>
				</li>
			{{ '{{/if}} '}}
		</script>
		<div class="file-input">
			{% if showAsLink %}
				<div class="hidden-file-upload">
					<span class="link">{{ phrase('user.upload_a_file') }}</span>
					<input type="file" name="{{ good_field_name }}" multiple="multiple" />
				</div>
			{% else %}
				<input type="file" name="{{ good_field_name }}" multiple="multiple" /> <button class="btn small">{{ phrase('user.upload') }}</button>
			{% endif %}
		</div>

		<ul class="files file-list"></ul>
	</div>
</div>
