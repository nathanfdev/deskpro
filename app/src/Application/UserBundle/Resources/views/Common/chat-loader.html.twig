<!-- DeskPRO Chat Loader -->
<script type="text/javascript">
var DpChatWidget_Options = DpChatWidget_Options || {};
DpChatWidget_Options.staticUrl = '{{ asset_url('') }}';
DpChatWidget_Options.deskproUrl = '{{ url('user') }}';
DpChatWidget_Options.protocol = ('https:' == document.location.protocol ? 'https' : 'http');
DpChatWidget_Options.currentPageUrl = window.location;
DpChatWidget_Options.referrerPageUrl = document.referrer;
{% if constant('DP_DEBUG') %}var DpChatWidget_EnableDebug = true;{% endif %}
{% if app.getSetting('user.chat_intercept_leaving_domains') %}
DpChatWidget_Options.interceptLeavingDomains = [
	{% for domain in app.getSetting('user.chat_intercept_leaving_domains')|explode(',') %}
		{{ domain|json_encode|raw }}{% if not loop.last %},{% endif %}
	{% endfor %}
];
{% endif %}

(function() {
	var scr = document.createElement('script');
	scr.src = '{{ asset('javascripts/DeskPRO/User/ChatWidget/ChatWidget.js') }}';
	scr.setAttribute('async', 'true');
	document.documentElement.firstChild.appendChild(scr);
})();
</script>
<!-- /DeskPRO Chat Loader -->
