{% extends 'UserBundle::layout.html.twig' %}
{% block breadcrumb %}
	<li><a href="{{ path('user_tickets') }}">{{ phrase('user.tickets.your_tickets') }}</a></li>
	<li><a href="{{ path('user_tickets_view', {'ticket_ref': ticket.public_id}) }}">{{ ticket.subject }}</a></li>
{% endblock %}
{% block page_title %}
	{{ ticket.subject }} - {{ phrase('user.tickets.your_tickets') }}
{% endblock %}
{% block content %}
<div class="dp-content-block dp-ticket-page with-handler" data-element-handler="DeskPRO.User.ElementHandler.TicketView">
	<div class="dp-box">
		<div class="dp-box-header">
			{% if ticket.status == 'awaiting_agent' or ticket.status == 'awaiting_user' %}
				<div class="dp-status-switcher" title="{{ phrase('user.tickets.click_to_close') }}">
					<div class="dp-status active dp-status-open">{{ phrase('user.open') }}</div>
					<a class="dp-status switcher dp-status-closed" href="{{ path('user_tickets_close', {'ticket_ref': ticket.public_id}) }}">{{ phrase('user.feedback.status_closed') }}</a>
				</div>
			{% elseif ticket.status == 'resolved' %}
				<div class="dp-status dp-status-resolved">{{ phrase('user.resolved') }}</div>
			{% elseif ticket.status == 'closed' %}
				<div class="dp-status dp-status-closed">{{ phrase('user.feedback.status_closed') }}</div>
			{% endif %}
			<h1>{{ ticket.subject }}</h1>
            <a target="_blank" href="{{ path('user_tickets_view', {'ticket_ref': ticket.id, 'pdf': 1}) }}"><img src="{{ asset('images/filetypes/page_white_acrobat.png') }}" /> {{ phrase('user.download_pdf') }}</a>
		</div>
		<div class="dp-box-content-wrapper">
			<div class="dp-box-content">
				{# Ticket Info #}
				<div class="dp-ticket-info">
					<ul>
						<li>
							<div class="label">{{ phrase('user.ticket_ref') }}</div>
							<div class="value">{{ ticket.public_id }}</div>
						</li>
						<li>
							<div class="label">{{ phrase('user.department') }}</div>
							<div class="value">{{ phrase_object(ticket.department, 'full') }}</div>
						</li>

						{% if ticket.category %}
							<li>
								<div class="label">{{ phrase('user.category') }}</div>
								<div class="value">{{ phrase_object(ticket.category, 'full') }}</div>
							</li>
						{% endif %}

						{% if ticket.product %}
							<li>
								<div class="label">{{ phrase('user.product') }}</div>
								<div class="value">{{ phrase_object(ticket.product, 'full') }}</div>
							</li>
						{% endif %}

						{% if ticket.priority %}
							<li>
								<div class="label">{{ phrase('user.priority') }}</div>
								<div class="value">{{ phrase_object(ticket.priority) }}</div>
							</li>
						{% endif %}

						{% if ticket.person.id != app.user.id %}
							<li>
								<div class="label">{{ phrase('user.ticket_starter') }}</div>
								<div class="value">{{ ticket.person.display_name }} &lt;{{ ticket.person.email_address }}&gt;</div>
							</li>
						{% endif %}

						{% if user_participants|length %}
							<li>
								<div class="label">{{ phrase('user.tickets.label_cced') }}</div>
								<div class="value">
									<ul>
										{% for part in user_participants %}
											<li>
												{{ part.person.display_name }} &lt;{{ part.person.email_address }}&gt;
											</li>
										{% endfor %}
									</ul>
								</div>
							</li>
						{% endif %}

						{% for f in custom_fields %}
							{% if ticket.hasCustomField(f.field_def.id) %}
								<li>
									<div class="label">{{f.title}}</div>
									<div class="value">
										{{ render_custom_field(f) }}
									</div>
								</li>
							{% endif %}
						{% endfor %}
					</ul>
					<br class="dp-clear" style="clear:left" />
				</div>
				{# /Ticket Info #}

				{# Messages #}
				<div class="dp-messages">
					<ul>
						{% for message in ticket.displayable_messages %}
							<li class="{% if message.person.is_agent %}agent-reply{% endif %}">
								<div class="author">
									{% if message.person %}
										<img src="{{ message.person.getPictureUrl(60) }}" /><br />
									{% endif %}
									<strong>{{ message.person.display_name }}</strong>
								</div>
								<div class="post">
									<div class="dp-date">
										<span class="timeago" title="{{ message.date_created|date('c') }}">{{ message.date_created|date('M j Y h:ia') }}</span>
									</div>
									{{ message.message_html|raw }}

									{% if message_to_attach[message.id] %}
										<ul class="attachment-list">
											{% for attach_id in message_to_attach[message.id] %}
												{% set ticket_attach = attachments[attach_id] %}
												<li class="{% if ticket_attach.blob.isImage() %}is-image{% else %}dp-icon-file dp-icon-{{ticket_attach.blob.extension|default('none')}}{% endif %}" rel="message-{{message.id}}">
													{% if ticket_attach.blob.isImage() %}
														<a href="{{ ticket_attach.blob.download_url }}" target="_blank"><img src="{{ path('serve_blob', {'blob_auth_id': ticket_attach.blob.auth_id, 'filename': ticket_attach.blob.filename, 's': 50, 'size-fit': '1'}) }}" alt="" class="preview" /></a>
													{% endif %}
													<a href="{{ ticket_attach.blob.download_url }}" target="_blank">{{ticket_attach.blob.filename}}</a>
													<span class="size">({{ ticket_attach.blob.readable_filesize }})</span>
												</li>
											{% endfor %}
										</ul>
									{%endif%}
								</div>
								{% if message.id == last_agent_message_id and message.person.id != app.user.id %}
									<div class="feedback-link">
										<span class="desc">
											{% if user_ratings[message.id] == 1 %}
												{{ phrase('user.tickets.you_rated_helpful') }}
											{% elseif user_ratings[message.id] == -1 %}
												{{ phrase('user.tickets.you_rated_unhelpful') }}
											{% else %}
												{{ phrase('user.tickets.was_reply_helpful') }}
											{% endif %}
										</span>
										<span class="desc-helpful">{{ phrase('user.tickets.rate_helpful') }}</span>
										<span class="desc-not-helpful">{{ phrase('user.tickets.rate_unhelpful') }}</span>

										<a class="helpful" href="{{ path('user_tickets_feedback', {'ticket_ref': ticket.ref, 'message_id': message.id, 'rating': 1 }) }}">{{ phrase('user.tickets.rate_helpful') }}</a>
										<a class="not-helpful" href="{{ path('user_tickets_feedback', {'ticket_ref': ticket.ref, 'message_id': message.id, 'rating': -1 }) }}">{{ phrase('user.tickets.rate_unhelpful') }}</a>
									</div>
								{% endif %}
								<br class="dp-clear" style="clear:left" />
							</li>
						{% endfor %}

						{% if ticket.status == 'awaiting_agent' %}
							<li class="close-ticket">
								{{ phrase('user.tickets.have_we_answered', {'link_url': path('user_tickets_close', {'ticket_ref': ticket.public_id})}) }}
							</li>
						{% endif %}

						{# New Reply #}
						<li class="new-reply">
							<div class="dp-form">
								<form action="{{ path('user_tickets_addreply', {'ticket_ref': ticket.public_id}) }}" method="POST" class="with-form-validator" enctype="multipart/form-data">
									<div class="dp-form">
										{% if errors|length %}
											<div class="alert-message error">
												{{ phrase('user.form_errors_correct') }}
												<!--
												{{ debug_var(error_fields) }}
												{{ debug_var(errors) }}
												-->
											</div>
										{% endif %}
										<div class="dp-form-row {% if error_fields['message'] %}dp-error{% endif %}">
											<div class="dp-form-label">
												<label>{{ phrase('user.add_reply') }}</label>
											</div>
											<div class="dp-form-input">
												<textarea
													name="newreply[message]"
													cols="120"
													rows="5"
													placeholder="{{ phrase('user.tickets.type_your_reply_here') }}"
													data-field-validators="DeskPRO.Form.LengthValidator"
													data-min-len="0"
												>{{ newreply.message }}</textarea>

												<div class="dp-error-explain">
													{{ phrase('user.tickets.message_error') }}
												</div>
											</div>
										</div>
									</div>

									<div class="dp-form-row">
										<div class="dp-form-label">
											<label>{{ phrase('user.attachments') }}</label>
										</div>
										<div class="dp-form-input">
											{% include 'UserBundle:Common:form-upload-input.html.twig' %}
										</div>
									</div>

									<button class="btn primary" style="margin-top: 10px;">{{ phrase('user.ticekts.add_reply_btn') }}</button>
								</form>
							</div>
						</li>
						{# /New Reply #}
					</ul>
					{# /Messages #}
				</div>
			</div>
		</div>
	</div>
</div>
{% endblock %}
