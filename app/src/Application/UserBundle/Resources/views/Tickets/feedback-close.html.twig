{##
 # Confirmation message shown after a user has submitted feedback on a message popup.
 # The window is meant to self-close with Javascript but depending on the browser the user may
 # have to manually close the window so there needs to be some kind of message.
 ##}

{% extends 'UserBundle::layout-simple-popup.html.twig' %}
{% block head %}
<script type="text/javascript">
window.close();
$(document).ready(function() {
	window.close();
});
</script>
{% endblock %}
{% block content %}
	<h4>{{ phrase('user.tickets.closed_thanks') }}</h4>

	<button class="dp-butotn small" onclick="window.close();" style="margin-top: 10px;">{{ phrase('user.general.close_window') }}</button>
{% endblock %}
