{% extends 'UserBundle::layout.html.twig' %}
{% block head %}
<style type="text/css">
ul.attachment-list {
	margin-top: 10px;
	padding-top: 5px;
	border-top: 1px solid #C5CDD4;
	padding-left: 8px;

	background: #FFFFFF; /* old browsers */
	background: -moz-linear-gradient(top, #FFFFFF 0%, #F7F8F9 100%); /* firefox */
	background: -webkit-gradient(linear, left top, left bottom, color-stop(0%,#FFFFFF), color-stop(100%,#F7F8F9)); /* webkit */
	filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#FFFFFF', endColorstr='#F7F8F9',GradientType=0 ); /* ie */
}

ul.attachment-list > li {
	line-height: 18px;
	padding-top: 2px;
	padding-bottom: 2px;
}
ul.attachment-list > li span.size {
	font-size: 7pt;
	color: #5E5E5E;
}

ul.attachment-list > li img.preview {
	text-align: right;
	vertical-align: middle;
	margin-right: 6px;
}
</style>
{% endblock %}
{% block content %}

<div style="background-color: #FFF9DE; border: 2px solid #C4BEA3; margin-bottom: 15px; padding: 8px;">
	<strong><a href="{{ path('user_register_finish') }}">{{ phrase('user.tickets.register_free', {'email':limited_person.primary_email_address}) }}</a></strong>

</div>

<h1 style="border-bottom: 2px solid #ddd; margin-bottom: 10px; padding-bottom: 3px;">{{ ticket.subject }}</h1>

<table cellspacing="5" cellpadding="0" border="0" width="100%"><tr>
	<td>
		<small>{{ phrase('user.general.department') }}</small><br />
		{{ticket.department.title}}
	</td>
	{% if ticket.category %}
	<td>
		<small>{{ phrase('user.general.category') }}</small><br />
		{{ticket.category.title}}
	</td>
	{% endif %}
	{% if ticket.product %}
	<td>
		<small>{{ phrase('user.general.product') }}</small><br />
		{{ticket.product.title}}
	</td>
	{% endif %}
	{% if ticket.priority %}
	<td>
		<small>{{ phrase('user.general.priority') }}</small><br />
		{{ticket.priority.title}}
	</td>
	{% endif %}
	<td>
		<small>{{ phrase('user.general.status') }}</small><br />
		{{ phrase('user.tickets.status_' ~ ticket.status) }}
	</td>
	<td>
		<small>{{ phrase('user.tickets.agent') }}</small><br />
		{{ ticket.agent.display_name|default(phrase('user.general.unassigned')) }}
	</td>
</tr></table>

<table cellspacing="5" cellpadding="0" border="0" width="100%"><tr><td>
	<strong>{{ phrase('user.general.ticket_participants') }}</strong><Br />
	<ul>
		<li><strong>{{ phrase('user.general.you') }}</strong> ({{app.user.primary_email_address}})</li>
	</ul>
</td></tr></table>

{% for message in ticket.displayable_messages %}
	<div style="border: 2px solid #ddd; margin-bottom: 15px;">
		<div style="background-color: #ddd;">
			<img src="{{ message.person.getPictureUrl(50) }}" alt="" style="float:left; margin-right: 6px; "/>
			{{ message.person.display_name }}
			<br style="clear:left" />
		</div>
		<div style="padding: 10px">
			{{ message.message_html|raw }}

			{% if ticket_message_attachments[message.id] %}
				<ul class="attachment-list">
					{% for attach_id in ticket_message_attachments[message.id] %}
						{% set ticket_attach = ticket_attachments[attach_id] %}
						<li class="{% if ticket_attach.blob.isImage() %}is-image{% else %}icon icon-attachment icon-filetype-{{ticket_attach.blob.extension|default('none')}}{% endif %}" rel="message-{{message.id}}">
							{% if ticket_attach.blob.isImage() %}
								<img src="{{ path('serve_blob', {'blob_auth_id': ticket_attach.blob.auth_id, 'filename': ticket_attach.blob.filename, 's': 50, 'size-fit': '1'}) }}" alt="" class="preview" />
							{% endif %}
							<a href="{{ ticket_attach.blob.download_url }}" target="_blank">{{ticket_attach.blob.filename}}</a>
							<span class="size">({{ ticket_attach.blob.readable_filesize }})</span>
						</li>
					{% endfor %}
				</ul>
			{%endif%}
		</div>
	</div>
{% endfor %}

<form action="{{ path('user_tickets_addreply', {'ticket_ref': ticket.ref}) }}" method="post" {{ form_enctype(newreply_form) }}>
<div style="border: 2px solid #ddd; margin-bottom: 15px;">
	<div style="background-color: #ddd;">
		<h4>{{ phrase('user.general.new_reply') }}</h4>
	</div>
	<div style="">
		{{ form_widget(newreply_form.message, {'attr': {'style': 'width: 90%; height: 100px;'}}) }}
		<br />
		{{ phrase('user.tickets.attach_a_file') }}: {{ form_widget(newreply_form.new_upload) }}
		<center><input type="submit" value="{{ phrase('user.general.add_reply') }}" /></center>
	</div>
</div>
{{ form_rest(newreply_form) }}
</form>
{% endblock %}
