{##
 # The confirmation and feedback page displayed when a user wants to resolve their ticket.
 ##}

{% extends 'UserBundle::layout.html.twig' %}
{% block breadcrumb %}
	<li><span class="dp-divider">&rarr;</span> <a href="{{ path('user_tickets') }}">{{ phrase('user.tickets.your_tickets') }}</a></li>
	<li><span class="dp-divider">&rarr;</span> <a href="{{ path('user_tickets_view', {'ticket_ref': ticket.public_id}) }}">{{ ticket.subject }}</a></li>
{% endblock %}
{% block page_title %}
	{{ ticket.subject }} - {{ phrase('user.tickets.your_tickets') }}
{% endblock %}
{% block content %}

<section class="dp-ticket dp-content-page dp-content-post">
	<header>
		<h3>{{ phrase('user.tickets.resolve_ticket', {subject: ticket.subject}) }}</h3>
	</header>
	<article class="dp-ticket-info">
		<form action="{{ path('user_tickets_resolve', {'ticket_ref': ticket.ref}) }}" method="post">
			<input type="hidden" name="process" value="1" />
			<div class="dp-box-section">
				<p>
					{{ phrase('user.tickets.resolve_ticket_explain') }}
				</p>

				<center><button class="dp-btn dp-btn-primary">{{ phrase('user.tickets.resolve_my_ticket_btn') }}</button></center>
			</div>

			{% if not exist_feedback and not no_feedback %}
			<div class="dp-box-section">
				<div class="dp-form">
					<div class="dp-form-row">
						<div class="dp-form-label">
							<label>{{ phrase('user.tickets.leave_feedback_title') }}</label>
						</div>
						<div class="dp-form-input">
							<label><input type="radio" name="rating" value="1" {% if exist_feedback.rating == 1 %}checked="checked"{% endif %} /> {{ phrase('user.tickets.rate_helpful') }}</label>
							&nbsp;&nbsp;&nbsp;
							<label><input type="radio" name="rating" value="0" {% if exist_feedback.rating == -1 %}checked="checked"{% endif %} /> {{ phrase('user.tickets.rate_unhelpful') }}</label>
						</div>
					</div>

					<div class="dp-form-row">
						<div class="dp-form-label">
							<label>{{ phrase('user.tickets.leave_feedback_text_title') }}</label>
						</div>
						<div class="dp-form-input">
							<textarea name="message" style="width: 95%; height: 60px;">{{ exist_feedback.message }}</textarea>
						</div>
					</div>

					<center><input class="dp-btn dp-btn-primary" type="submit" name="with_feedback" value="{{ phrase('user.tickets.resolve_my_ticket_send_feedback_btn') }}" /></center>
				</div>
			</div>
			{% endif %}
		</form>
	</article>
</section>

{% endblock %}
