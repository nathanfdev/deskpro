{% extends 'UserBundle::layout.html.twig' %}
{% block breadcrumb %}
	<li><a href="{{ path('user_tickets') }}">{{ phrase('user.global.tickets') }}</a></li>
	<li><a href="{{ path('user_tickets_view', {'ticket_ref': ticket.public_id}) }}">{{ ticket.subject }}</a></li>
{% endblock %}
{% block content %}
<div class="dp-content-block dp-ticket-page with-handler" data-element-handler="DeskPRO.User.ElementHandler.TicketView">
	<div class="dp-box">
		<div class="dp-box-header">
			<h4>{{ phrase('user.tickets.close_ticket_title') }}: {{ ticket.subject }}</h4>
		</div>

		<div class="dp-box-content-wrapper">
			<div class="dp-box-content">
				<form action="{{ path('user_tickets_close', {'ticket_ref': ticket.ref}) }}" method="post">
				<input type="hidden" name="process" value="1" />
				<div class="dp-box-section">
					<p>
						{{ phrase('user.tickets.close_ticket_explain') }}
					</p>

					<center><button class="btn primary">{{ phrase('user.tickets.close_my_ticket_btn') }}</button></center>
				</div>

				{% if not exist_feedback and not no_feedback %}
					<div class="dp-box-section">
						<div class="dp-form">
							<div class="dp-form-row">
								<div class="dp-form-label">
									<label>{{ phrase('user.ticket.leave_feedback_title') }}</label>
								</div>
								<div class="dp-form-input">
									<label><input type="radio" name="rating" value="1" {% if exist_feedback.rating == 1 %}checked="checked"{% endif %} /> {{ phrase('user.tickets.rate_helpful') }}</label>
									&nbsp;&nbsp;&nbsp;
									<label><input type="radio" name="rating" value="0" {% if exist_feedback.rating == -1 %}checked="checked"{% endif %} /> {{ phrase('user.tickets.rate_unhelpful') }}</label>
								</div>
							</div>

							<div class="dp-form-row">
								<div class="dp-form-label">
									<label>{{ phrase('user.ticket.leave_feedback_text_title') }}</label>
								</div>
								<div class="dp-form-input">
									<textarea name="message" style="width: 95%; height: 60px;">{{ exist_feedback.message }}</textarea>
								</div>
							</div>

							<center><input class="btn primary" type="submit" name="with_feedback" value="{{ phrase('user.tickets.close_my_ticket_send_feedback_btn') }}" /></center>
						</div>
					</div>
				{% endif %}
				</form>
			</div>
		</div>
	</div>
</div>
{% endblock %}
