{% extends 'UserBundle::layout-simple-popup.html.twig' %}
{% block content %}
<div class="dp-content-block dp-ticket-page with-handler" data-element-handler="DeskPRO.User.ElementHandler.TicketView">
	<div class="dp-box">
		<div class="dp-box-header">
			<h4>{{ phrase('user.tickets.feedback_thanks') }}</h4>
		</div>

		<div class="dp-box-content-wrapper">
			<div class="dp-box-content">
				{% if feedback.rating == 1 %}
					<form action="{{ path('user_tickets_feedback_closeticket', {'ticket_ref': ticket.ref, 'message_id': message.id, 'close_win': 1}) }}">
						<p>
							{{ phrase('user.tickets.feedback_thanks_pos') }}
							<button class="btn primary small" style="display: inline">{{ phrase('user.tickets.feedback_close_btn') }}</button>
						</p>
					</form>

					<button class="btn small" onclick="window.close();" style="margin-top: 10px;">{{ phrase('user.close_window') }}</button>
				{% else %}
					<p>
						{{ phrase('user.tickets.feedback_thanks_neg') }}
					</p>

					<button class="btn small" onclick="window.close();" style="margin-top: 10px;">{{ phrase('user.close_window') }}</button>
				{% endif %}
			</div>
		</div>
	</div>
</div>
{% endblock %}
