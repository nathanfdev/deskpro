{##
 # The ticket listing showing all a users tickets
 ##}

{% extends 'UserBundle::layout.html.twig' %}
{% block breadcrumb %}
	<li><span class="dp-divider">&rarr;</span> <a href="{{ path('user_tickets') }}">{{ phrase('user.general.tickets') }}</a></li>
{% endblock %}
{% block page_title %}{{ phrase('user.tickets.your_tickets') }}{% endblock %}
{% block content %}

{% macro ticket_row(ticket, last_messages) %}
	<li>
		<div class="dp-title">
			<div class="dp-fadeaway-container">
				<h4 class="dp-fadetitle">
					<a href="{{ path('user_tickets_view', {'ticket_ref': ticket.public_id }) }}">{{ ticket.subject }}</a>
					{% if 0 %}
					<a target="_blank" href="{{ path('user_tickets_view', {'ticket_ref': ticket.id, 'pdf': 1}) }}">
						<img src="{{ asset('images/filetypes/page_white_acrobat.png') }}" alt="{{ phrase('user.general.download_pdf') }}" />
					</a>
					{% endif %}
				</h4>
				<div class="dp-fadeaway-inner-container">
					<div class="dp-fadeaway"></div>
					<div class="dp-opaque-fadeaway">
						<span class="dp-time">{{ ticket.date_created|date('full') }}</span>
					</div>
				</div>
			</div>
		</div>
		<ul class="dp-post-info">
			<li class="dp-category"><i class="dp-icon-folder-close"></i> {{ ticket.department.full_title }}</li>
			<li class="dp-author"><i class="dp-icon-user"></i>
				{% if last_messages[ticket.id].person.id == app.user.id %}
					{{ phrase('user.tickets.list_last_activity_by_you') }}
				{% else %}
					{{ phrase('user.tickets.list_last_activity_by_x', {'name': last_messages[ticket.id].person.display_name}) }}
				{% endif %}
				(<span class="timeago" title="{{ last_messages[ticket.id].date_created|date('c') }}">{{ last_messages[ticket.id].date_created|date('fulltime') }}</span>)
			</li>
		</ul>
	</li>
{% endmacro %}

{% if active_tickets|length %}
	<section class="dp-ticketlist-section dp-portal-section">
		<header>
			<h1>{{ phrase('user.general.open_tickets') }}</h1>
		</header>
		<div class="dp-content-block">
			<div class="dp-content-wrapper">
				<ul class="dp-ticket-list">
					{% for ticket in active_tickets %}
						{{ _self.ticket_row(ticket, last_messages) }}
					{% endfor %}
				</ul>
			</div>
		</div>
	</section>

	<br />
{% endif %}

{% if resolved_tickets|length %}
	<section class="dp-ticketlist-section dp-portal-section">
		<header>
			<h1>{{ phrase('user.tickets.list_resolved') }}</h1>
		</header>
		<div class="dp-content-block">
			<div class="dp-content-wrapper">
				<ul class="dp-ticket-list">
					{% for ticket in resolved_tickets %}
						{{ _self.ticket_row(ticket, last_messages) }}
					{% endfor %}
				</ul>
			</div>
		</div>
	</section>

	<br />
{% endif %}

{% if closed_tickets|length %}
	<section class="dp-ticketlist-section dp-portal-section">
		<header>
			<h1>{{ phrase('user.tickets.list_closed') }}</h1>
		</header>
		<div class="dp-content-block">
			<div class="dp-content-wrapper">
				<ul class="dp-ticket-list">
					{% for ticket in closed_tickets %}
						{{ _self.ticket_row(ticket, last_messages) }}
					{% endfor %}
				</ul>
			</div>
		</div>
	</section>
{% endif %}
{% endblock %}
