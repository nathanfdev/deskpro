{% extends 'UserBundle::layout.html.twig' %}
{% block breadcrumb %}
	<li><a href="{{ path('user_tickets') }}">{{ phrase('user.tickets') }}</a></li>
{% endblock %}
{% block page_title %}{{ phrase('user.tickets.your_tickets') }}{% endblock %}
{% block content %}

{% if active_tickets %}
<div class="with-handler" data-element-handler="DeskPRO.User.ElementHandler.TicketList">
<div class="dp-content-block dp-ticketlist-page dp-open-tickets">
	<div class="dp-box">
		<div class="dp-box-header">
			<h1>{{ phrase('user.open_tickets') }}</h1>
		</div>
		<div class="dp-box-content-wrapper">
			<div class="dp-box-content">
				<ul class="dp-ticketlist">
					{% for ticket in active_tickets %}
						<li>
							<h4><a href="{{ path('user_tickets_view', {'ticket_ref': ticket.public_id }) }}">{{ ticket.subject }}</a></h4>
							<ul class="dp-meta">
								<li>{{ ticket.date_created|date('M j Y') }}</li>
								{% if ticket.department %}
									<li>{{ phrase('user.department') }}: {{ticket.department.title}}</li>
								{% endif %}
								{% if last_messages[ticket.id] %}
									<li>
										{% if last_messages[ticket.id].person.id == app.user.id %}
											{{ phrase('user.tickets.list_last_activity_by_you') }}
										{% else %}
											{{ phrase('user.tickets.list_last_activity_by_x', {'name': last_messages[ticket.id].person.display_name}) }}
										{% endif %}
										(<span class="timeago" title="{{ last_messages[ticket.id].date_created|date('c') }}">{{ last_messages[ticket.id].date_created|date('M j Y h:ia') }}</span>)
									</li>
								{% endif %}
								<li>
									<a class="close-ticket-trigger" href="{{ path('user_tickets_close', {'ticket_ref': ticket.public_id, 'back': 'list'}) }}"></a>
								</li>
							</ul>
						</li>
					{% endfor %}
				</ul>
			</div>
		</div>
	</div>
</div>
{% endif %}

{% if resolved_tickets %}
<div class="dp-content-block dp-ticketlist-page dp-open-tickets">
	<div class="dp-box">
		<div class="dp-box-header">
			<h1>{{ phrase('user.tickets.list_closed') }}</h1>
		</div>
		<div class="dp-box-content-wrapper">
			<div class="dp-box-content">
				<ul class="dp-ticketlist">
					{% for ticket in resolved_tickets %}
						<li>
							<h4><a href="{{ path('user_tickets_view', {'ticket_ref': ticket.public_id }) }}">{{ ticket.subject }}</a></h4>
							<ul class="dp-meta">
								<li>{{ ticket.date_created|date('M j Y') }}</li>
								<li>{{ phrase('user.department') }}: {{ticket.department.title}}</li>
								{% if last_messages[ticket.id] %}
									<li>
										{% if last_messages[ticket.id].person.id == app.user.id %}
											{{ phrase('user.tickets.list_last_activity_by_you') }}
										{% else %}
											{{ phrase('user.tickets.list_last_activity_by_x', {'name': last_messages[ticket.id].person.display_name}) }}
										{% endif %}
										(<span class="timeago" title="{{ last_messages[ticket.id].date_created|date('c') }}">{{ last_messages[ticket.id].date_created|date('M j Y h:ia') }}</span>)
									</li>
								{% endif %}
							</ul>
						</li>
					{% endfor %}
				</ul>
			</div>
		</div>
	</div>
</div>
{% endif %}

</div>
{% endblock %}
