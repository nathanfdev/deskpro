{% if app.user.hasPerm('articles.use') or app.user.hasPerm('feedback.use') or app.user.hasPerm('downloads.use') or app.user.hasPerm('news.use') %}
<div class="dp-sidebar-block dp-nav-block">
	<div class="dp-box-header">
		<h3>{{ phrase('user.general.title_resources') }}</h3>
	</div>
	<ul class="dp-content-list">
		{% if app.user.hasPerm('articles.use') %}<li><a href="{{ path('user_articles') }}">{{ phrase('user.general.content_help_articles') }}</a></li>{% endif %}
		{% if app.user.hasPerm('feedback.use') %}<li><a href="{{ path('user_feedback') }}">{{ phrase('user.general.feedback') }}</a></li>{% endif %}
		{% if app.user.hasPerm('downloads.use') %}<li><a href="{{ path('user_downloads') }}">{{ phrase('user.general.downloads') }}</a></li>{% endif %}
		{% if app.user.hasPerm('news.use') %}<li><a href="{{ path('user_news') }}">{{ phrase('user.general.news') }}</a></li>{% endif %}
	</ul>
</div>
{% endif %}
