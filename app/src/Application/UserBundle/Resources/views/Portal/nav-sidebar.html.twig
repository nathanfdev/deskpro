{% if app.user.hasPerm('articles.use') or app.user.hasPerm('feedback.use') or app.user.hasPerm('downloads.use') or app.user.hasPerm('news.use') %}
<div class="dp-sidebar-block dp-nav-block">
	<div class="dp-box-header">
		<h3>Resources</h3>
	</div>
	<ul class="dp-content-list">
		{% if app.user.hasPerm('articles.use') %}<li><a href="{{ path('user_articles') }}">Help Articles</a></li>{% endif %}
		{% if app.user.hasPerm('feedback.use') %}<li><a href="{{ path('user_feedback') }}">Feedback</a></li>{% endif %}
		{% if app.user.hasPerm('downloads.use') %}<li><a href="{{ path('user_downloads') }}">Downloads</a></li>{% endif %}
		{% if app.user.hasPerm('news.use') %}<li><a href="{{ path('user_news') }}">News</a></li>{% endif %}
	</ul>
</div>
{% endif %}
