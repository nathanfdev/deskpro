{% if feedback|length %}
	<div class="dp-sidebar-block dp-feedback-block">
		<div class="dp-box-header">
			<h3><a href="{{ path('user_feedback', {'status': 'new'}) }}">{{ phrase('user.portal.title_newest_feedback') }}</a></h3>
		</div>
		<ul class="dp-content-list">
			{% for feedback in feedback %}
				<li>
					{% include 'UserBundle:Feedback:voting-widget.html.twig' %}
					<div class="title dp-faded-container">
						<a href="{{ path('user_feedback_view', {'slug': feedback.url_slug}) }}">{{feedback.title}}</a>
						<div class="dp-bound-faded"></div>
					</div>
				</li>
			{% endfor %}
		</ul>
		<div class="dp-more" style="clear:left">
			<a href="{{ path('user_feedback', {'status': 'new'}) }}">{{ phrase('user.portal.view_more_feedback') }}</a>
		</div>
	</div>
{% endif %}
