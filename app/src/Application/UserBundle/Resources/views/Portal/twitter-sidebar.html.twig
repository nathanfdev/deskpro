{##
 # The twitter sidebar block
 ##}

<div class="dp-sidebar-block dp-twitter-block">
	<div class="dp-box-header">
		<h3>
			<a href="http://twitter.com/{{ twitter_name }}">{{ phrase('user.portal.twitter_user_link', {'name':twitter_name}) }}</a>
		</h3>
	</div>
	<div class="dp-twitter-list">
		<ul>
			{% for item in feed_items %}
				<li>
					{{ item.description|raw }}
				</li>
			{% endfor %}
		</ul>
		<div class="dp-more">
			<a href="http://twitter.com/{{ twitter_name }}">{{ phrase('user.portal.twitter_view_more', {'name':twitter_name}) }}</a>
		</div>
	</div>
</div>
