{##
 # The staff listing sidebar block
 ##}

{% if staff|length %}
	<section class="dp-sidebar-block">
		<header>
			<h3>
				{% if title %}
					{{ title }}
				{% else %}
					{% if online %}
                        {{ phrase('user.portal.online_staff') }}
					{% else %}
                        {{ phrase('user.portal.our_staff') }}
					{% endif %}
				{% endif %}
			</h3>
		</header>
		<article class="dp-written">
			<p class="dp-summary">
				{{ phrase('user.portal.we_are_here_to_help') }}
			</p>
			<ul class="dp-clearfix dp-person-list {% if staff|length > 5 %}dp-compact{% endif %}">
				{% for agent in staff %}
				<li title="{{ agent.display_name }}">
					<span style="background-image: url('{{ agent.getPictureUrl(24) }}')">{{ agent.display_name }}</span>
				</li>
				{% endfor %}
			</ul>
		</article>
	</section>
{% endif %}
