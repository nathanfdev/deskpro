{% if staff|length %}
	<div class="dp-sidebar-block dp-online-block">
		<div class="dp-box-header">
			<h3>
				{% if title %}
					{{ title }}
				{% else %}
					{% if online %}
						Online Staff
					{% else %}
						Our Staff
					{% endif %}
				{% endif %}
			</h3>
		</div>
		<div class="dp-summary">
			Our friendly support staff are here to help.
		</div>
		{% if staff|length > 5 %}
			<ul class="dp-compact">
				{% for agent in staff %}
					<li title="{{ agent.display_name }}">
						<span style="background-image: url('{{ agent.getPictureUrl(24) }}')"></span>
					</li>
				{% endfor %}
			</ul>
			<br class="dp-clear" style="clear:left" />
		{% else %}
			<ul>
				{% for agent in staff %}
					<li>
						<div class="item">
							<span style="background-image: url('{{ agent.getPictureUrl(24) }}')">{{ agent.display_name }}</span>
						</div>
					</li>
				{% endfor %}
			</ul>
		{% endif %}
	</div>
{% endif %}
