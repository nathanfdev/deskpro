{% if app.user.hasPerm('tickets.use') or app.user.hasPerm('feedback.submit') or app.user.hasPerm('chat.use') %}
<div class="dp-sidebar-block dp-contact-block">
	<div class="dp-box-header">
		<h3>Contact Us</h3>
	</div>

	<ul class="dp-primary">
		{% if app.user.hasPerm('tickets.use') %}<li><a href="{{ path('user_tickets_new') }}" class="dp-email-us">Email us</a></li>{% endif %}
		{% if app.user.hasPerm('feedback.submit') %}<li><a href="{{ path('user_feedback_newfeedback') }}" class="dp-submit-feedback">Submit a suggestion</a></li>{% endif %}
		{% if app.user.hasPerm('chat.use') %}<li><a href="#" class="dp-chat-live dp-chat-trigger">Chat live</a></li>{% endif %}
	</ul>
</div>
{% endif %}
