{% if cloud|length %}
	<div class="dp-sidebar-block dp-labels-block">
		<div class="dp-box-header">
			<h3><a href="{{ path('user_search_labels') }}">{{ phrase('user.tags') }}</a></h3>
		</div>
		<div class="dp-tag-cloud">
			<ul>
				{% for c_label,css_class in cloud %}
					<li class="dp-{{css_class}}"><a href="{{ path('user_search_labels', {'label': c_label}) }}">{{ c_label }}</a></li>
				{% endfor %}
			</ul>
		</div>
	</div>
{% endif %}
