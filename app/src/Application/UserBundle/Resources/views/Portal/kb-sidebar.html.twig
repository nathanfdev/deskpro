<div class="sidebar-item dp-kb-page">
	<div class="heading">
		<h2>{{ title|default('News') }}</h2>
	</div>

	<div class="content-list">
		{% for article in articles %}
			<div class="item icon-news">
				<a href="{{ path('user_articles_article', {'slug': article.url_slug}) }}">{{ article.title }}</a>
			</div>
		{% endfor %}
	</div>

	<div class="more-link">
		<a href="{{ path('user_articles') }}">more...</a>
	</div>
</div>
