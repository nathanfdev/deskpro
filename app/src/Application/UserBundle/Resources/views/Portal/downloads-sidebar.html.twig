{% if downloads|length %}
	<div class="dp-sidebar-block dp-downloads-block">
		<div class="dp-box-header">
			<h3><a href="{{ path('user_downloads') }}">{{ phrase('user.global.downloads') }}</a></h3>
		</div>
		<ul class="dp-content-list">
			{% for download in downloads %}
				<li>
					<div class="dp-faded-container">
						<span class="dp-icon-file dp-icon-{{ download.blob.extension }}">
							<a href="{{ path('serve_blob', {'blob_auth_id': download.blob.auth_id, 'filename': download.blob.filename}) }}">{{ download.filename }}</a>
						</span>
						| {{ download.readable_filesize }}
						<div class="dp-bound-faded"></div>
					</div>
				</li>
			{% endfor %}
		</ul>
		<div class="dp-more" style="clear:left">
			<a href="{{ path('user_downloads') }}">{{ phrase('user.portal.view_more_downloads') }}</a>
		</div>
	</div>
{% endif %}
