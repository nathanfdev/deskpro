{##
 # The feedback tab of the website widget overlay
 ##}

<div id="newfeedback" class="tab" style="display: none;">
	<form action="{{ path('user_widget_newfeedback') }}" method="POST" id="dp_newfeedback_form" class="with-form-validator">
		{{ form_token('newfeedback_widget') }}

		{% if app.usersourceManager.getWithCapability('tpl_widget_overlay_btn') %}
		<div class="socials">
			<div>
				<span>{{ phrase('user.widget.or_connect_with') }}</span>
				<ul>
					{% for usersource in app.usersourceManager.getWithCapability('tpl_widget_overlay_btn') %}
					<li>{{ render_usersource(usersource, 'widget_overlay_btn') }}</li>
					{% endfor %}
				</ul>
			</div>
		</div>
		{% endif %}

		<div class="fields-row">
			<div class="txt dp-form-row-person_name">
				{{ form_widget(feedbackform.person_name, {
					'attr': {
						'data-field-validators': 'DeskPRO.Form.LengthValidator',
						'data-min-len': 2,
						'placeholder': phrase('user.widget.your_name'),
						'class': 'name-field'
					}
				}) }}
				<span class="tooltip-error">
					<span>{{ phrase('user.widget.register_enter_name') }}</span>
				</span>
			</div>
			<div class="txt alignright dp-form-row-person_email">
				<input type="text" class="email-field" id="dp_newticket_email" name="feedback[person_email]" value="" placeholder="{{ phrase('user.widget.your_email_address') }}" data-field-validators="DeskPRO.Form.EmailValidator" data-min-len="4" />
				<span class="tooltip-error">
					<span>{{ phrase('user.widget.register_please_enter_email') }}</span>
				</span>
			</div>
		</div>

		<div class="dp-new-feedback" >
			<div class="dp-input-prepend">
				<table cellspacing="0" cellpadding="0" width="100%"><tr>
					<td width="50" class="dp-msg">
						<span style="white-space: nowrap;">{{ phrase('user.widget.i_have_a') }}</span>
					</td>
					<td width="10" class="dp-cat dp-cat2">
						<div class="dp-form-row-category_id with-sub-options feedbackCat_id_wrapper" data-field-validators="DeskPRO.Form.TwoLevelSelectValidator">
							<div style="position: relative;" class="dp-inplace-drop">
								<em><span class="dp-opt-label">&nbsp;</span> <i></i></em>
								<select name="feedback[category_id]" class="parent-option category_id no-uniform">
									{% for cat in feedback_categories %}
										<option value="{{cat.id}}">{{cat.title}}</option>
									{% endfor %}
								</select>
							</div>
						</div>
						<span class="tooltip-error">
							<span>{{ phrase('user.widget.please_choose_a_category') }}</span>
						</span>
					</td>
					<td class="dp-title">
						{{ form_widget(feedbackform.title, {
							'attr': {
								'data-field-validators': 'DeskPRO.Form.LengthValidator',
								'data-min-len': 5,
								'class': 'search-collect',
								'placeholder': phrase('user.widget.enter_short_summary')
							}
						}) }}
					</td>
				</tr></table>
			</div>
			<div class="dp-form-row-title">
				<span class="tooltip-error">
					<span>{{ phrase('user.widget.summary_error') }}</span>
				</span>
			</div>
		</div>

		<div class="fields-row message dp-form-row-content">
			<table cellspacing="0" cellpadding="0" width="100%"><tr><td><div style="position: relative">
				<div class="textarea">
					{{ form_widget(feedbackform.content, {
						'attr': {
							'class': 'dp-message',
							'data-field-validators': 'DeskPRO.Form.LengthValidator',
							'data-min-len': 10,
							'placeholder': phrase('user.widget.message'),
							'class': addclass
						}
					}) }}
				</div>
				<span class="tooltip-error">
					<span>{{ phrase('user.widget.desc_error') }}</span>
				</span>
			</div></td></tr></table>
		</div>
		<div class="btn-holder clearfix">
			<button type="submit" class="btn-activity dp-show-not-loading">{{ phrase('user.widget.send') }}</button>
			<i class="spinner-flat dp-show-is-loading"></i>
		</div>
	</form>

	<div class="thank-you" id="dp_newfeedback_done" style="display: none">
		<h2>{{ phrase('user.widget.thank_you') }}</h2>
		<p>{{ phrase('user.widget.register_thank_you_for_feedback') }}</p>
	</div>
</div>