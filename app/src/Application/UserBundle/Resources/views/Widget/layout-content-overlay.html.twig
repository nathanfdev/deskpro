{##
 # The layout used when displaying a content page launched from the website widget.
 ##}
{% set content %}{% block content %}{% endblock %}{% endset %}
{% if app.getRequest().query.get('_partial') == 'overlaySuggest' %}
	{{ content|raw }}
{% else %}
	<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
	<html xmlns="http://www.w3.org/1999/xhtml" lang="en" class="dp-simple-popup">
	<head>
		<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
		{% include 'UserBundle::layout-resources.html.twig' %}
		{% block head %}{% endblock %}

		<script type="text/javascript">
			$(document).ready(function() {
				$('a').each(function() {
					$(this).attr('target', '_blank');
				});
			});
		</script>
	</head>
	<body id="dp_content_overlay">
		<div id="dp">

			<article id="dp_article_content">
				{{ content|raw }}
			</article>

			{% block foot %}
			<div class="dp-controls">
				<a href="{{ content_link }}" target="_blank" class="dp-btn dp-open-in-window" style="float: right"><i class="dp-icon-share"></i> {{ phrase('user.general.widget_open_in_new_window') }}</a>
				{#<div class="dp-default dp-control-section">
					<button class="dp-btn dp-section-toggle dp-set-answered" data-toggle-section=".dp-confirm-answered"><i class="dp-icon-ok"></i> {{ phrase('user.general.widget_bad_result') }}</button>
					<button class="dp-btn dp-not-answered"><i class="dp-icon-remove"></i> {{ phrase('user.general.widget_good_result') }}</button>
				</div>#}
			</div>
			{% endblock %}
		</div>
	</body>
	</html>
{% endif %}