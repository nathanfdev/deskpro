{##
 # The chat tab of the website widget overlay
 ##}

<div id="newchat" class="tab" style="display: none; min-height: 300px;">
	<form method="POST" id="dp_newchat_form" class="with-form-validator">
		{% if app.usersourceManager.getWithCapability('tpl_widget_overlay_btn') %}
		<div class="socials">
			<div>
				<span>{{ phrase('user.widget.or_connect_with') }}</span>
				<ul>
					{% for usersource in app.usersourceManager.getWithCapability('tpl_widget_overlay_btn') %}
					<li>{{ render_usersource(usersource, 'widget_overlay_btn') }}</li>
					{% endfor %}
				</ul>
			</div>
		</div>
		{% endif %}

		<div class="fields-row">
			<div class="txt dp-form-row-person_name">
				<input type="text" class="name-field" id="dp_newchat_name" name="name" value="" placeholder="{{ phrase('user.widget.your_name') }}" data-field-validators="DeskPRO.Form.LengthValidator" data-min-len="4" />
				<span class="tooltip-error">
					<span>{{ phrase('user.widget.register_enter_name') }}</span>
				</span>
			</div>
			<div class="txt alignright dp-form-row-person_email">
				<input type="text" class="email-field" id="dp_newchat_email" name="email" value="" placeholder="{{ phrase('user.widget.your_email_address') }}" data-field-validators="DeskPRO.Form.LengthValidator" data-min-len="4" />
				<span class="tooltip-error">
					<span>{{ phrase('user.widget.register_please_enter_email') }}</span>
				</span>
			</div>
		</div>
		<div class="fields-row dp-form-row-ticket_department_id">
			<select name="newticket[ticket][department_id]">
				<option value=""></option>
				{% for id,info in ticket_options.departments_hierarchy %}
				{% if info.children %}
				<optgroup label="{{ info.title }}">
					{% for subid,subinfo in info.children %}
					<option value="{{subinfo.id}}">{{subinfo.user_title}}</option>
					{% endfor %}
				</optgroup>
				{% else %}
				<option value="{{info.id}}">{{info.user_title}}</option>
				{% endif %}
				{% endfor %}
			</select>
			<span class="tooltip-error">
				<span>{{ phrase('user.widget.please_choose_a_department') }}</span>
			</span>
		</div>

		<div class="btn-holder clearfix">
			<button type="submit" class="btn-activity">{{ phrase('user.widget.send') }}</button>
		</div>
	</form>

	<div class="thank-you" id="dp_newchat_done" style="display: none">
		<h2>{{ phrase('user.widget.please_wait') }}</h2>
		<p>{{ phrase('user.widget.wait_while_connecting_with_agent') }}</p>
	</div>
</div>