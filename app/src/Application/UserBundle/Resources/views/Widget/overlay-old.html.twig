<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html>
<head>
	<script type="text/javascript">
		var BASE_URL = '{{ path('user') }}';
		var ASSETS_BASE_URL = '{{ asset('') }}';
		var DESKPRO_PERSON_ID = {{ app.user.id|default(0) }};

		{% if constant('DP_DEBUG') %}
		DP_DEBUG = true;
		{% else %}
		DP_DEBUG = false;
		{% endif %}
	</script>

	{% if app.isDebug() %}
	{{ dp_asset_html('user_vendors') }}
	{{ dp_asset_html('user_common') }}
	<link id="dp_stylesheet" rel="stylesheet" type="text/css" href="{{ app.request.getBasePath() }}/file.php/res-user/main.css?{{ app.style.css_updated|date('u')|crc32 }}&amp;reload=1" media="screen,print" />
	{% else %}
	{{ dp_asset_html('user') }}
	<link id="dp_stylesheet" rel="stylesheet" type="text/css" href="{{ app.style.css_blob.getDownloadUrl() }}?{{ app.style.css_blob.id }}" media="screen,print" />
	{% endif %}

	<link rel="stylesheet" type="text/css" href="{{ asset('stylesheets/user/main-print.css') }}" media="print" />
	<!--[if IE ]><link href="{{ asset('stylesheets/user/main-ie.css') }}" rel="stylesheet" type="text/css"><![endif]-->

	<script src="{{ asset('javascripts/DeskPRO/TouchCaller.js') }}" type="text/javascript"></script>
	<script src="{{ asset('javascripts/DeskPRO/WordHighlighter.js') }}" type="text/javascript"></script>
	<script src="{{ asset('javascripts/DeskPRO/User/WebsiteWidget/OverlayWin.js') }}" type="text/javascript"></script>

	<script type="text/javascript">
		var OverlayWin = new DeskPRO.User.WebsiteWidget.OverlayWin();
		$(document).ready(function() {
			OverlayWin.initPage();
		});
	</script>
</head>
<body id="dp_overlay">

<div id="left_pane">
	<div class="related-title">
		{{ phrase('user.register_similar_results') }}
		<span id="cancel_related">x</span>
	</div>
	<div class="search-area">
		<input id="search_box" type="text" placeholder="{{ phrase('user.register_search_for_something') }}Search for something..." />
		<span id="search_box_clear" style="display: none">x</span>
		<button id="search_box_go">{{ phrase('user.search') }}</button>
	</div>
	<div class="list-area">
		<ul id="new_content_list">
			{% for content in newest_content %}
			{% include 'UserBundle:Common:searchlist-simplerow.html.twig' with { type: content.type, item: content.item } %}
			{% endfor %}
		</ul>
		<ul id="search_content_list" style="display: none"></ul>
	</div>
</div>
<div id="right_pane">
<div class="head-area with-handler">
	<ul id="dp_overlay_navtabs">
		<li data-tab-for="#newticket" class="on">{{ phrase('user.register_contact_our_agents') }}</li>
		<li data-tab-for="#newfeedback">{{ phrase('user.submit_feedback') }}</li>
		<li data-tab-for="#newchat">{{ phrase('user.register_chat_with_us') }}</li>
	</ul>
</div>
<div class="body-area" id="right_pane_body">

{################################################
		 # New Ticket
		 ################################################}

		<div id="newticket">
	<form action="{{ path('user_widget_newticket') }}" method="POST" id="dp_newticket_form" class="with-form-validator" enctype="multipart/form-data">
		{{ form_token('newticket_widget') }}
		{% if app.user.id %}
		<div class="form-row">
			<div class="dp-form-row">
				<div class="dp-form-label"><label>{{ phrase('user.you') }}</label></div>
				<div class="dp-form-input">
					{{ app.user.display_name }} ({{ app.user.email_address }})
				</div>
			</div>
		</div>
		{% else %}
		<div class="form-row">
			<table cellspacing="0" cellpadding="0" width="100%"><tr><td valign="top" width="50%" style="padding-right: 10px;">
				<div class="dp-form-row {% if error_fields['person.name'] %}dp-error{% endif %} dp-form-row-person_name">
					<div class="dp-form-label">
						<label>{{ phrase('user.your_name') }} *</label>
					</div>
					<div class="dp-form-input">
						{{ form_widget(ticketform.person.name, {
										'attr': {
											'data-field-validators': 'DeskPRO.Form.LengthValidator',
											'data-min-len': 2,
											'placeholder': phrase('user.your_name'),
											'class': 'name-field'
										}
									}) }}
						<div class="dp-error-explain">
							{{ phrase('user.register_enter_name') }}
						</div>
					</div>
				</div>
			</td><td valign="top" width="50%" style="padding-left: 10px;">
				<div class="dp-form-row dp-form-row-person_email">
					<div class="dp-form-label">
						<label>{{ phrase('user.your_email_address') }} *</label>
					</div>
					<div class="dp-form-input">
						<input type="text" class="email-field" id="dp_newticket_email" name="newticket[person][email]" value="" placeholder="{{ phrase('user.your_email_address') }}" data-field-validators="DeskPRO.Form.LengthValidator" data-min-len="4" />
						{% if app.usersourceManager.getWithCapability('tpl_widget_overlay_btn') %}
						<div class="connect-with">
							{{ phrase('user.or_connect_with') }}
							{% for usersource in app.usersourceManager.getWithCapability('tpl_widget_overlay_btn') %}
							{{ render_usersource(usersource, 'widget_overlay_btn') }}
							{% endfor %}
						</div>
						{% endif %}
						<div class="dp-error-explain">
							{{ phrase('user.register_enter_name') }}
						</div>
					</div>
				</div>
			</td></tr></table>
		</div>
		{% endif %}

		<div class="form-row">
			<table cellspacing="0" cellpadding="0" width="100%"><tr><td>
				{% include 'UserBundle:NewTicket:field-subject.html.twig' with {form: ticketform, addclass: 'search-collect'} %}
			</td></tr></table>
		</div>

		<div class="form-row">
			<table cellspacing="0" cellpadding="0" width="100%"><tr><td>
				{% include 'UserBundle:NewTicket:field-department.html.twig' with {form: ticketform} %}
			</td></tr></table>
		</div>

		<div class="form-row">
			<table cellspacing="0" cellpadding="0" width="100%"><tr><td><div style="position: relative">
				<div class="dp-drop-file-zone"><h1>{{ phrase('user.register_drop_here_to_attach') }}</h1></div>
				{% include 'UserBundle:NewTicket:field-message.html.twig' with {form: ticketform, addclass: 'search-collect'} %}
				{% include 'UserBundle:Common:form-upload-input.html.twig'  with { showAsLink: true } %}
			</div></td></tr></table>
		</div>

		<div class="form-row">
			<table cellspacing="0" cellpadding="0" width="100%"><tr><td>
				<button class="dp-button">{{ phrase('user.register_send_message') }}</button>
			</td></tr></table>
		</div>
	</form>
	<div class="thank-you" id="dp_newticket_done" style="display: none">
		<h2>{{ phrase('user.thank_you') }}</h2>
		<p>{{ phrase('user.register_thank_you_for_ticket') }}</p>
	</div>
</div>


{################################################
		 # New Feedback
		 ################################################}

		<div id="newfeedback" style="display: none">
	<form action="{{ path('user_widget_newfeedback') }}" method="POST" id="dp_newfeedback_form" class="with-form-validator">
		{{ form_token('newfeedback_widget') }}
		{% if app.user.id %}
		<div class="form-row">
			<div class="dp-form-row">
				<div class="dp-form-label"><label>{{ phrase('user.you') }}</label></div>
				<div class="dp-form-input">
					{{ app.user.display_name }} ({{ app.user.email_address }})
				</div>
			</div>
		</div>
		{% else %}
		<div class="form-row">
			<table cellspacing="0" cellpadding="0" width="100%"><tr><td width="50%" style="padding-right: 10px;">
				<div class="dp-form-row {% if error_fields['person.name'] %}dp-error{% endif %} dp-form-row-person_name">
					<div class="dp-form-label">
						<label>{{ phrase('user.your_name') }} *</label>
					</div>
					<div class="dp-form-input">
						{{ form_widget(feedbackform.person_name, {
									'attr': {
										'data-field-validators': 'DeskPRO.Form.LengthValidator',
										'data-min-len': 2,
										'placeholder': phrase('user.your_name'),
										'class': 'name-field'
									}
								}) }}
						<div class="dp-error-explain">
							{{ phrase('user.register_enter_name') }}
						</div>
					</div>
				</div>
			</td><td width="50%" style="padding-left: 10px;">
				<div class="dp-form-row dp-form-row-person_email">
					<div class="dp-form-label">
						<label>{{ phrase('user.your_email_address') }} *</label>
					</div>
					<div class="dp-form-input">
						<input type="text" class="email-field" id="dp_newfeedback_email" name="feedback[person_email]" value="" placeholder="{{ phrase('user.your_email_address') }}" data-field-validators="DeskPRO.Form.LengthValidator" data-min-len="4" />
						{% if app.usersourceManager.getWithCapability('tpl_widget_overlay_btn') %}
						<div class="connect-with">
							{{ phrase('user.or_connect_with') }}
							{% for usersource in app.usersourceManager.getWithCapability('tpl_widget_overlay_btn') %}
							{{ render_usersource(usersource, 'widget_overlay_btn') }}
							{% endfor %}
						</div>
						{% endif %}
						<div class="dp-error-explain">
							{{ phrase('user.register_enter_name') }}
						</div>
					</div>
				</div>
			</td></tr></table>
		</div>
		{% endif %}

		<div class="dp-form-row {% if error_fields['category_id'] %}dp-error{% endif %}">
			<div class="dp-form-label">
				<label>{{ phrase('user.category') }} *</label>
			</div>
			<div class="dp-form-input with-sub-options feedbackCat_id_wrapper" data-field-validators="DeskPRO.Form.TwoLevelSelectValidator">
				<div class="dp-select-wrapper" style="width: 70%;">
					<select name="feedback[category_id]" class="parent-option category_id">
						<option value=""></option>
						{% for cat in feedback_categories %}
						<option value="{{cat.id}}">{{cat.title}}</option>
						{% endfor %}
					</select>
					{% for parent_cat in feedback_categories %}
					{% if parent_cat.children|length %}
					<div class="dp-sub-options sub-options-category_id sub-options-{{parent_cat.id}}" style="display: none">
						<select class="sub_category_id">
							<option value=""></option>
							{% for cat in parent_cat.children %}
							<option value="{{cat.id}}">{{cat.title}}</option>
							{% endfor %}
						</select>
					</div>
					{% endif %}
					{% endfor %}
				</div>
				<div class="dp-error-explain">
					{{ phrase('user.please_choose_a_category') }}
				</div>
			</div>
		</div>

		<div class="dp-form-row {% if error_fields['title'] %}dp-error{% endif %}">
			<div class="dp-form-label">
				<label>{{ phrase('user.summary') }} *</label> <em class="note">{{ phrase('user.feedback.label_summary_explain') }}</em>
			</div>
			<div class="dp-form-input">
				{{ form_widget(feedbackform.title, {
							'attr': {
								'data-field-validators': 'DeskPRO.Form.LengthValidator',
								'data-min-len': 5,
								'class': 'search-collect'
							}
						}) }}
				<div class="dp-error-explain">
					{{ phrase('user.feedback.summary_error') }}
				</div>
			</div>
		</div>

		<div class="dp-form-row {% if error_fields['content'] %}dp-error{% endif %}">
			<div class="dp-form-label">
				<label>{{ phrase('user.description') }} *</label> <em class="note">{{ phrase('user.feedback.label_explain_feedback') }}</em>
			</div>
			<div class="dp-form-input">
				{{ form_widget(feedbackform.content, {
							'attr': {
								'data-field-validators': 'DeskPRO.Form.LengthValidator',
								'data-min-len': 5,
								'class': 'search-collect'
							}
						}) }}
				<div class="dp-error-explain">
					{{ phrase('user.feedback.desc_error') }}
				</div>
			</div>
		</div>

		<input class="btn primary" type="submit" value="Submit Feedback" />
	</form>
	<div class="thank-you" id="dp_newfeedback_done" style="display: none">
		<h2>{{ phrase('user.thank_you') }}</h2>
		<p>{{ phrase('user.register_thank_you_for_feedback') }}</p>
	</div>
</div>

{################################################
		 # New Chat
		 ################################################}

		<div id="newchat" style="display: none">
	<form method="POST" id="dp_newchat_form" class="with-form-validator">
		{% if app.user.id %}
		<div class="form-row">
			<div class="dp-form-row">
				<div class="dp-form-label"><label>{{ phrase('user.you') }}</label></div>
				<div class="dp-form-input">
					{{ app.user.display_name }} ({{ app.user.email_address }})
				</div>
			</div>
		</div>
		{% else %}
		<div class="form-row">
			<table cellspacing="0" cellpadding="0" width="100%"><tr><td width="50%" style="padding-right: 10px;">
				<div class="dp-form-row {% if error_fields['person.name'] %}dp-error{% endif %} dp-form-row-person_name">
					<div class="dp-form-label">
						<label>{{ phrase('user.your_name') }} *</label>
					</div>
					<div class="dp-form-input">
						<input type="text" class="name-field" id="dp_newchat_name" name="name" value="" placeholder="{{ phrase('user.your_name') }}" data-field-validators="DeskPRO.Form.LengthValidator" data-min-len="4" />
						<div class="dp-error-explain">
							{{ phrase('user.register_enter_name') }}
						</div>
					</div>
				</div>
			</td><td width="50%" style="padding-left: 10px;">
				<div class="dp-form-row dp-form-row-person_email">
					<div class="dp-form-label">
						<label>{{ phrase('user.your_email_address') }} *</label>
					</div>
					{% if app.usersourceManager.getWithCapability('tpl_widget_overlay_btn') %}
					<div class="connect-with">
						{{ phrase('user.or_connect_with') }}
						{% for usersource in app.usersourceManager.getWithCapability('tpl_widget_overlay_btn') %}
						{{ render_usersource(usersource, 'widget_overlay_btn') }}
						{% endfor %}
					</div>
					{% endif %}
					<div class="dp-form-input">
						<input type="text" class="email-field" id="dp_newchat_email" name="email" value="" placeholder="{{ phrase('user.your_email_address') }}" data-field-validators="DeskPRO.Form.LengthValidator" data-min-len="4" />
						<div class="dp-error-explain">
							{{ phrase('user.register_enter_name') }}
						</div>
					</div>
				</div>
			</td></tr></table>
		</div>
		{% endif %}

		<div class="dp-form-row {% if error_fields['department_id'] %}dp-error{% endif %}">
			<div class="dp-form-label">
				<label>{{ phrase('user.department') }} *</label>
			</div>
			<div class="department_id_wrapper with-sub-options dp-form-input" data-field-validators="DeskPRO.Form.TwoLevelSelectValidator">
				<div class="dp-select-wrapper">
					<select name="department_id" class="department_id parent-option">
						<option value=""></option>
						{% for id,info in departments %}
						<option value="{{id}}">{{info.title}}</option>
						{% endfor %}
					</select>
					{% for parent_id, parent_info in ticket_options.departments_hierarchy %}
					{% if parent_info.children|length %}
					<div class="dp-sub-options sub-options-department_id sub-options-{{parent_id}}" style="display: none">
						<select class="sub_department_id">
							<option value=""></option>
							{% for id,info in parent_info.children %}
							<option value="{{id}}">{{info.title}}</option>
							{% endfor %}
						</select>
					</div>
					{% endif %}
					{% endfor %}
				</div>
				<div class="dp-error-explain">
					{{ phrase('user.please_enter_department') }}
				</div>
			</div>
		</div>

		<input type="submit" value="Chat Now" />
	</form>

	<div class="thank-you" id="dp_newchat_done" style="display: none">
		<h2>{{ phrase('user.register_wait') }}</h2>
		<p>{{ phrase('user.register_wait_while') }}</p>
	</div>
</div>
</div>
</div>

</body>
</html>
