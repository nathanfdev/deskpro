<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html>
<head>
	<script type="text/javascript">
		var BASE_URL = '{{ path('user') }}';
		var ASSETS_BASE_URL = '{{ asset('') }}';
		var DESKPRO_PERSON_ID = {{ app.user.id|default(0) }};

		{% if constant('DP_DEBUG') %}
			DP_DEBUG = true;
		{% else %}
			DP_DEBUG = false;
		{% endif %}
	</script>

	{% if app.isDebug() %}
		{{ dp_asset_html('user_vendors') }}
		{{ dp_asset_html('user_common') }}
		<link id="dp_stylesheet" rel="stylesheet" type="text/css" href="{{ app.request.getBasePath() }}/file.php/res-user/main.css?{{ app.style.css_updated|date('u')|crc32 }}&amp;reload=1" media="screen,print" />
	{% else %}
		{{ dp_asset_html('user') }}
		<link id="dp_stylesheet" rel="stylesheet" type="text/css" href="{{ app.style.css_blob.getDownloadUrl() }}?{{ app.style.css_blob.id }}" media="screen,print" />
	{% endif %}

	<link rel="stylesheet" type="text/css" href="{{ asset('stylesheets/user/main-print.css') }}" media="print" />
	<!--[if IE ]><link href="{{ asset('stylesheets/user/main-ie.css') }}" rel="stylesheet" type="text/css"><![endif]-->

	<script src="{{ asset('javascripts/DeskPRO/TouchCaller.js') }}" type="text/javascript"></script>
	<script src="{{ asset('javascripts/DeskPRO/WordHighlighter.js') }}" type="text/javascript"></script>
	<script src="{{ asset('javascripts/DeskPRO/User/ChatWidget/ChatWin.js') }}" type="text/javascript"></script>

	<script type="text/javascript">
		var ChatWin = new DeskPRO.User.WebsiteWidget.ChatWin({
			sessionCode: '{{ session_code }}',
			conversationId: {{ convo.id|default(0) }},
			assignedAgentId: {{ convo.agent.id|default(0) }},
			assignedAgentName: '{{ convo.agent.display_name|default(0) }}',
			assignedAgentAvatar: '{{ convo.agent.getPictureUrl(40)|default(0) }}',
			assignedAgentAvatarIcon: '{{ convo.agent.getPictureUrl(16)|default(0) }}',
			initialMessages: {{ convo_messages|json_encode|raw }},
			uploadTo: '{{ path('user_accept_upload') }}',
			uploadSecurityToken: '{{ security_token('attach_temp') }}'
		});
		$(document).ready(function() {
			ChatWin.initPage();
		});
	</script>
</head>
<body id="dp_chat">
<div id="dp_chat_wrap">

<div id="dp_chat_end_confirm" style="display: none">
	{{ phrase('user.chat.confirm_end_chat') }}
	<button id="dp_chat_end_no">{{ phrase('global.cancel') }}</button>
	<button id="dp_chat_end_yes">{{ phrase('global.end_chat') }}</button>
</div>

<i id="dp_chatwin_min"></i>
<i id="dp_chatwin_close"></i>

<div id="dp_chat_start">
	{% if app.user.id %}
		{% if not app.user.name %}
			<input type="text" name="name" placeholder="{{ phrase('user.chat.your_name') }}" /><br />
		{% else %}
			{{ app.user.name }}
		{% endif %}
		{% if not app.user.email_address %}
			<input type="text" name="email" placeholder="{{ phrase('user.chat.your_email') }}" />
		{% else %}
			{{ app.user.email_address }}
		{% endif %}
	{% else %}
		<input type="text" name="name" placeholder="{{ phrase('user.chat.your_name') }}" /><br />
		<input type="text" name="email" placeholder="{{ phrase('user.chat.your_email') }}" />
		{% if app.usersourceManager.getWithCapability('tpl_widget_overlay_btn') %}
			<div class="connect-with">
				{{ phrase('global.or_connect_with') }}
				{% for usersource in app.usersourceManager.getWithCapability('tpl_widget_overlay_btn') %}
					{{ render_usersource(usersource, 'widget_overlay_btn') }}
				{% endfor %}
			</div>
		{% endif %}
	{% endif %}
	<br />
	<select name="department_id">
		<option value="0">{{ phrase('user.chat.choose_department') }}</option>
		{% for dep in departments %}
			{% if dep.children|length %}
				<optgroup label="{{ dep.title }}">
					{% for subdep in dep.children %}
						<option value="{{ subdep.id }}">{{ subdep.title }}</option>
					{% endfor %}
				</optgroup>
			{% else %}
				<option value="{{ dep.id }}">{{ dep.title }}</option>
			{% endif %}
		{% endfor %}
	</select><br />
	<button id="dp_chat_start_go">{{ phrase('user.chat.start_chat') }}</button>
</div>

<div id="dp_chat_finding_agent" style="display: none">
	<p>{{ phrase('user.chat.please_wait_for_agent_for_chat') }}</p>
</div>

<div id="dp_chat_active" style="display: none">
	<div id="dp_chat_filedrag">{{ phrase('user.chat.drop_file_here') }}</div>
	<div id="dp_chat_header_pane">
		<div id="dpchat_with_agent" style="display: none"></div>
		<div id="dpchat_without_agent">
			{{ phrase('user.chat.please_wait_for_agent') }}
		</div>
	</div>
	<div id="dp_chat_messages_pane">
		<div id="uploading_list" class="uploading-list">
			<ul class="files"></ul>
		</div>
	</div>
	<div id="dp_chat_input_pane">
		<textarea id="dp_chat_message_input"></textarea>
		<button id="dp_chat_message_send" class="btn primary">{{ phrase('global.send') }}</button>
		<div id="dp_chat_message_upload">
			<a id="dp_chat_upload_link">{{ phrase('user.chat.send_a_file') }}</a>
			<input type="file" name="attach" id="dp_chat_message_upload_file" />
		</div>
	</div>
</div>

<div id="dp_chat_done" style="display: none">
	{# Field is hidden if the user entered an email addy, its sent automatically when chat ended #}
	<div class="form-row email-field">
		{% set phrase_part %}
		<input type="text" name="email" value="" placeholder="{{ phrase('user.chat.your_email') }}" />
		{% endset %}
		{{ phrase('user.widget.send_a_transcript_of_this_chat_to') }} 
	</div>

	<div class="form-row">
		{{ phrase('user.chat.rate_response_time') }}
		<select name="rating_response_time">
			<option value="0"></option>
			<option value="1">1</option>
			<option value="2">2</option>
			<option value="3">3</option>
			<option value="4">4</option>
			<option value="5">5</option>
		</select>
	</div>

	<div class="form-row">
		{{ phrase('user.chat.rate_satisfaction') }}
		<select name="rating_overall">
			<option value="0"></option>
			<option value="1">1</option>
			<option value="2">2</option>
			<option value="3">3</option>
			<option value="4">4</option>
			<option value="5">5</option>
		</select>
	</div>

	<div class="form-row">
		{{ phrase('user.chat.comments') }}
		<textarea name="comments"></textarea>
	</div>

	<button id="dp_chat_end_real">{{ phrase('user.chat.send_and_close') }}</button>
</div>

</div>

<script type="text/x-deskpro-plain" id="dp_chat_tpl_agent_header">
	<div class="avatar"><img src="%avatar_url%" /></div>
	<div class="info">
		<em>{{ phrase('user.chat.you_are_chatting_with') }}</em>
		<h1>%name%</h1>
	</div>
</script>
<script type="text/x-deskpro-plain" id="dp_chat_tpl_user_message">
	<div class="row message user">
		<div class="author">{{ phrase('global.you') }}</div>
		<div class="message">%message%</div>
	</div>
</script>
<script type="text/x-deskpro-plain" id="dp_chat_tpl_agent_message">
	<div class="row message agent">
		<div class="avatar"><img src="%avatar_url_icon%" /></div>
		<div class="author">%name%</div>
		<div class="message">%message%</div>
	</div>
</script>
<script type="text/x-deskpro-plain" id="dp_chat_tpl_sys_message">
	<div class="row message sys">
		<div class="author">*</div>
		<div class="message">%message%</div>
	</div>
</script>
<script type="text/x-deskpro-plain" id="dp_chat_tpl_sys_message_prompt">
	<div class="row message sys-prompt">
		<div class="message">%message%</div>
	</div>
</script>

<script class="dptpl-attach-upload" type="text/x-jquery-tmpl">
	<li class="uploading">{{ phrase('global.uploading') }}: ${name} <span class="cancel">{{ phrase('global.cancel') }}</span></li>
</script>
<script class="dptpl-attach-download" type="text/x-jquery-tmpl">
	{{ '{{if error}} '}}
		<li class="error">
			${error}
		</li>
	{{ '{{else}} '}}
		<li class="uploaded">
			<input type="hidden" name="{{ blob_field_name }}" value="${blob_auth_id}" />
			<a href="${download_url}" target="_blank">${filename}</a>
			<span class="size">${filesize_readable}</span>
			<span class="remove">{{ phrase('global.remove') }}</span>
		</li>
	{{ '{{/if}} '}}
</script>

</body>
</html>
