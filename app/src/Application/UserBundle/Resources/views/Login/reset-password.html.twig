{% extends 'UserBundle::layout.html.twig' %}
{% block content %}
<div class="dp-content-block dp-passreset-page">
	<div class="dp-box">
		<div class="dp-box-header">
			<h1>{{ phrase('user.reset_password') }}</h1>
		</div>
		<div class="dp-box-content-wrapper">
			<div class="dp-box-content dp-form">
				<form action="{{ path('user_login_resetpass_send') }}" class="form login" method="post">
					<div class="dp-form-row">
						<div class="dp-form-label">
							<label>{{ phrase('user.email_address') }}</label>
						</div>
						<div class="dp-form-input">
							<input type="text" value="" name="email" id="email" size="40" />
						</div>
					</div>

					<input class="btn primary" type="submit" value="{{ phrase('user.continue') }}" />
				</form>
			</div>
		</div>
	</div>
</div>

{% endblock %}
