{##
 # The confirm page after the reset password link has been sent to a user.
 ##}

{% extends 'UserBundle::layout.html.twig' %}
{% block content %}
<section class="dp-portal-section dp-new-feedback-section">
	<header>
		<h1>{{ phrase('user.profile.reset_password') }}</h1>
	</header>
	<article>
		{% if did_send %}
			<p>
				{{ phrase('user.profile.reset_password_done') }}
			</p>
		{% else %}
			<p>
				{{ phrase('user.profile.reset_password_noaccount') }}
			</p>
		{% endif %}
	</article>
</section>
{% endblock %}