{#
 # The form displayed when the user is resetting their password after clicking the reset link in their email.
 #}

{% extends 'UserBundle::layout.html.twig' %}
{% block content %}
<section class="dp-portal-section dp-new-feedback-section">
	<header>
		<h1>{{ phrase('user.profile.reset_password') }}</h1>
	</header>
	<article>

        {% for k, v in errors %}
            <div class="dp-alert dp-alert-error">
                {{ phrase('user.profile.register_password_' ~ k, {count: attribute(policy, k)}) }}
            </div>
        {% endfor %}

        <form action="{{ path('user_login_resetpass_newpass', {'code': code}) }}" class="form login" method="post">
			{{ form_token() }}
			<input type="hidden" name="process" value="1" />
			<div class="dp-control-group">
				<div class="dp-control-label">
					<label>{{ phrase('user.profile.label_new_password') }}</label>
					<div style="font-size: 11px;">
						{% set prefix = (app.user.is_agent ? 'agent' : 'user') ~ '.password_policy.' %}
						{% if app.getSetting(prefix ~ 'forbid_reuse') %}{{ phrase('user.profile.register_password_unused') }}, {% endif %}
						{% if app.getSetting(prefix ~ 'require_num_uppercase') %}{{ phrase('user.profile.register_password_require_num_uppercase', {count: app.getSetting(prefix ~ 'require_num_uppercase')}) }}, {% endif %}
						{% if app.getSetting(prefix ~ 'require_num_lowercase') %}{{ phrase('user.profile.register_password_require_num_lowercase', {count: app.getSetting(prefix ~ 'require_num_lowercase')}) }}, {% endif %}
						{% if app.getSetting(prefix ~ 'require_num_number') %}{{ phrase('user.profile.register_password_require_num_number', {count: app.getSetting(prefix ~ 'require_num_number')}) }}, {% endif %}
						{% if app.getSetting(prefix ~ 'require_num_symbol') %}{{ phrase('user.profile.register_password_require_num_symbol', {count: app.getSetting(prefix ~ 'require_num_symbol')}) }}, {% endif %}
						{% if app.getSetting(prefix ~ 'min_length') %}{{ phrase('user.profile.register_password_min_length', {count: app.getSetting(prefix ~ 'min_length')}) }}{% endif %}
					</div>
				</div>
				<div class="dp-controls">
					<input type="password" autocomplete="off" value="" name="password" id="password" size="40" />
				</div>
			</div>
			<div class="dp-control-group">
				<div class="dp-control-label">
					<label>{{ phrase('user.profile.label_repeat_password') }}</label>
				</div>
				<div class="dp-controls">
					<input type="password" autocomplete="off" value="" name="password2" id="password2" size="40" />
				</div>
			</div>

			<input class="btn primary" type="submit" value="{{ phrase('user.profile.reset_password') }}" />
		</form>
	</article>
</section>
{% endblock %}
