{% extends 'UserBundle::layout.html.twig' %}
{% block breadcrumb %}
	<li><a href="{{ path('user_login') }}">{{ phrase('user.general.log_in') }}</a></li>
{% endblock %}
{% block content %}
<div class="dp-login-page">
	<div class="dp-content-block">
		<div class="dp-box">
			<div class="dp-box-header">
				<h1>{{ phrase('user.general.log_in') }}</h1>
			</div>

			<div class="dp-box-content-wrapper">
				<div class="dp-box-content">
					{% if invalid_login %}
						<div class="alert-message error">
							{{ phrase('user.general.login_error') }}
						</div>
					{% endif %}
					<form action="{{ path('user_login_authenticate_local') }}" class="form login" method="post">
						{% if return %}
							<input type="hidden" name="return" value="{{return}}" />
						{% endif %}
						<div class="dp-form">
							<div class="dp-form-row">
								<div class="dp-form-label">{{ phrase('user.general.email') }}</div>
								<div class="dp-form-input">
									<input type="text" value="" name="email" id="email" size="40" tabindex="1" />
								</div>
							</div>
							<div class="dp-form-row">
								<div class="dp-form-label">{{ phrase('user.general.password') }} <em class="note"><a href="{{ path('user_login_resetpass') }}">{{ phrase('user.general.lost_qm') }}</a></em></div>
								<div class="dp-form-input">
									<input type="password" value="" name="password" id="password" size="40" tabindex="2" />
								</div>
							</div>
						</div>
						<div class="footer">
							<input class="btn primary" type="submit" value="{{ phrase('user.general.log_in') }}" />
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>
{% endblock %}
