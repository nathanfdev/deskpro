/***********************************************************************************************************************
* Content
* These styles are general styling applied to pages in DeskPRO
***********************************************************************************************************************/

#dp .dp-br-clear {
	clear: both;
	height: 1px;
	overflow: hidden;
}

#dp .dp-summary {
	font-size: 90%;
	color: #888;
}

#dp .not-loading { display: block; }
#dp .is-loading { display: none; }

#dp .loading .not-loading { display: none; }
#dp .loading .is-loading { display: block; }

#dp .dp-backdrop {
	position: absolute;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
}

#dp .dp-highlight-word {
	border-bottom: 1px dotted #706960;
	cursor: help;
}

/******************************
* Fadeaway containers
******************************/

/*
	To get a fading effect on text, you need:
	1) To know the height of the text line
	2) The text line must be wrapper in a positioned container
	3) Along with the text, there must be a dp-fadeaway element that actually draws the fade

	The container is overflow:hidden and the text should be whitespace:nowrap. This'll
	cause the text to overrun the container. The fadeaway element is a absolutely
	positioned element over the right side of the text which overlaps and gives us the effect
	by having left-most opacity at 0, and right-most opacity at 100.

	This uses transparent PNG's so if you don't have a white bg, you need to generate a new image.
*/

#dp .dp-fadeaway-container {
	position: relative;
	overflow: hidden;
	white-space: nowrap;
}

#dp .dp-fadeaway-container .dp-fadetitle {
	white-space: nowrap;
}

#dp .dp-fadeaway-container .dp-fadeaway-inner-container {
	position: absolute;
	top: 0;
	right: 0;
	bottom: 0;
}

#dp .dp-fadeaway-container .dp-fadeaway-inner-container .dp-opaque-fadeaway {
	margin-left: 53px;
	background-color: #fff;
}

#dp .dp-fadeaway-container .dp-fadeaway-inner-container .dp-fadeaway {
	right: auto;
	left: 0;
}

#dp .dp-fadeaway-container .dp-fadeaway {
	width: 53px;
	position: absolute;
	top: 0;
	right: 0;
	bottom: 0;
	background: transparent url(../../web/images/fadeaway-white.png) repeat-y 100% 0;
}

/******************************
* Drop zone targets
******************************/

.dp-drop-file-zone {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	display: none;

	background-color: rgba(175, 192, 213, 0.7);
	z-index: 1000000;
	display: none;
}

.dp-drop-file-zone h1 {
	margin: 10px auto 0 auto;
	width: 300px;
	text-align: center;
	padding: 25px;
	background-color: #AFC0D5;
	font-size: 18px;
	border: 1px solid #66717F;
}

body.file-drag-over .dp-drop-file-zone {
	display: block;
}

/******************************
* A person list is a list with a person avatar, and a name.
* Options: .dp-compact turns the list into just an avatar shown side-by-side
******************************/

#dp ul.dp-person-list {
	margin: 0;
	padding: 0;
}

#dp ul.dp-person-list li {
	list-style: none;
	margin: 0;
	padding: 0;
}

#dp ul.dp-person-list li span {
	display: block;
	line-height: 30px;
	background-repeat: no-repeat;
	background-position: 0 50%;
	padding-left: 30px;
}

#dp ul.dp-person-list.dp-compact li {
	float: left;
	margin-right: 6px;
}

#dp ul.dp-person-list.dp-compact li span {
	padding-left: 0;
	width: 24px;
	height: 24px;
	text-indent: -1000px;
	overflow: hidden;
