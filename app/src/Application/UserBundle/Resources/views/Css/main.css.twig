/***********************************************************************************************************************
* #dp_html
* Applied to the DeskPRO HTML page
***********************************************************************************************************************/

/*
	The DeskPRO page structure is like this:

	html#dp_html
		body
			div#dp_custom_header
			div#dp
				div#dp_main
					section#dp_header_bar
						div#dp_header_title
						div#dp_header_search
					div#dp_page_wrapper
						div#dp_content_wrapper
							section#dp_content
						div#dp_sidebar_wrapper
							section#dp_sidebar
					div#dp_footer_bar
 */

html#dp_html, html#dp_html body {
	background: {{ stylevar.bg_color }};
	margin: 0;
	padding: 0;
}

#dp {
	font-family: {{ font_body|raw }};
	font-size: 13px;
	line-height: 18px;
	color: {{ stylevar.text_color }};
}

#dp li, #dp td, #dp span, #dp label {
	font-family: {{ font_body|raw }};
}

#dp h1, #dp h2, #dp h3, #dp h4, #dp h5, #dp h6 {
	font-family: {{ font_headings|raw }};
	text-shadow: 1px 1px 1px rgba(255,255,255, 0.8);
}

#dp_custom_header {

}

#dp_main {
	max-width: {{ page_width }}px;
	margin: 15px auto 15px auto;
}

#dp_main_inner {
	padding: 0 18px 0 18px;
}

#dp .dp-clear {
	clear: both;
	height: 1px;
	overflow: hidden;
	visibility: hidden;
}

.dp-chat-disabled .dp-chat-trigger { display: none; }

#dp .dp-flashes {
	padding: 10px;
}

/***********************************************************************************************************************
* Header Bar
* This includes the top blue bar, the helpdesk title, and the search box
***********************************************************************************************************************/

#dp_header {
	margin: 9px 0 9px 9px;
	position: relative;
}

#dp_header img.logo {
	display: none;
}

#dp_header.dp-with-logo img.logo {
	display: block;
}

#dp_header.disabled.dp-with-logo img.logo {
	display: none;
}

#dp_header.dp-with-logo h1,
#dp_header.dp-with-logo h2 {
	display: none;
}

#dp_header h1 {
	font-size: 14pt;
	line-height: 100%;
	float: left;
}

#dp_header h1 a {
	color: {{ stylevar.header_name_color }};
}

#dp_header h2 {
	border-left: 1px solid {{ stylevar.header_tagline_color }};
	color: {{ stylevar.header_tagline_color }};
	font-size: 10pt;
	padding: 0;
	margin:  0;
	line-height: 100%;
	float: left;
	margin-left: 10px;
	padding-left: 10px;
	margin-top: -0px;
	line-height: 20px;
}


{% set dp_header_bar_height = 55 %}
#dp_header_bar {
