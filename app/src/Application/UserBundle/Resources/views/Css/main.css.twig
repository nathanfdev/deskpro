	max-width: {{ page_width }}px;
	height: {{ dp_header_bar_height }}px;
	background-color: {{ stylevar.header_bar_bg_color }};
	color: {{ stylevar.header_text_color }};
	border-bottom: 2px solid #1A4A7A;
	{{ _self.border_radius({ tl: 6, tr: 6}) }}
