}

section#dp_header_search input#dp_search::-webkit-input-placeholder { color: #555; }
section#dp_header_search input#dp_search:-moz-placeholder { color: #555; }

section#dp_header_search .dp-btn {
	padding: 7px 12px;
	font-size: 11pt;
}

#dp #dp_search_assist {
