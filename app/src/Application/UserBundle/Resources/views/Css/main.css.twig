	display: none;
}

#deskpro #dp_header.dp-with-logo img.logo {
	display: block;
}

#deskpro #dp_header.disabled.dp-with-logo img.logo {
	display: none;
}

#deskpro .dp-clear {
	clear: both;
	width: 0;
	height: 0;
	overflow: hidden;
}


#deskpro #dp_header {
	padding: 10px 0 10px 0;
}

