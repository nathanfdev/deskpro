#dp .dp-accordion{margin-bottom:18px;}
#dp .dp-accordion-group{margin-bottom:2px;border:1px solid #e5e5e5;-webkit-border-radius:4px;-moz-border-radius:4px;border-radius:4px;}
#dp .dp-accordion-heading{border-bottom:0;}
#dp .dp-accordion-heading .dp-accordion-toggle{display:block;padding:8px 15px;}
#dp .dp-accordion-inner{padding:9px 15px;border-top:1px solid #e5e5e5;}
#dp .dp-carousel{position:relative;margin-bottom:18px;line-height:1;}
#dp .dp-carousel-inner{overflow:hidden;width:100%;position:relative;}
#dp .dp-carousel .item{display:none;position:relative;-webkit-transition:0.6s ease-in-out left;-moz-transition:0.6s ease-in-out left;-ms-transition:0.6s ease-in-out left;-o-transition:0.6s ease-in-out left;transition:0.6s ease-in-out left;}
#dp .dp-carousel .item>img{display:block;line-height:1;}
#dp .dp-carousel .dp-active,#dp .dp-carousel .dp-next,#dp .dp-carousel .dp-prev{display:block;}
#dp .dp-carousel .dp-active{left:0;}
#dp .dp-carousel .dp-next,#dp .dp-carousel .dp-prev{position:absolute;top:0;width:100%;}
#dp .dp-carousel .dp-next{left:100%;}
#dp .dp-carousel .dp-prev{left:-100%;}
#dp .dp-carousel .dp-next.dp-left,#dp .dp-carousel .dp-prev.dp-right{left:0;}
#dp .dp-carousel .dp-active.dp-left{left:-100%;}
#dp .dp-carousel .dp-active.dp-right{left:100%;}
#dp .dp-carousel-control{position:absolute;top:40%;left:15px;width:40px;height:40px;margin-top:-20px;font-size:60px;font-weight:100;line-height:30px;color:#ffffff;text-align:center;background:#222222;border:3px solid #ffffff;-webkit-border-radius:23px;-moz-border-radius:23px;border-radius:23px;opacity:0.5;filter:alpha(opacity=50);}
#dp .dp-carousel-control.dp-right{left:auto;right:15px;}
#dp .dp-carousel-control:hover{color:#ffffff;text-decoration:none;opacity:0.9;filter:alpha(opacity=90);}
#dp .dp-carousel-caption{position:absolute;left:0;right:0;bottom:0;padding:10px 15px 5px;background:#333333;background:rgba(0, 0, 0, 0.75);}
#dp .dp-carousel-caption h4,#dp .dp-carousel-caption p{color:#ffffff;}
#dp .dp-hero-unit{padding:60px;margin-bottom:30px;background-color:#eeeeee;-webkit-border-radius:6px;-moz-border-radius:6px;border-radius:6px;}
#dp .dp-hero-unit h1{margin-bottom:0;font-size:60px;line-height:1;color:inherit;letter-spacing:-1px;}
#dp .dp-hero-unit p{font-size:18px;font-weight:200;line-height:27px;color:inherit;}
#dp .dp-pull-right{float:right;}
#dp .dp-pull-left{float:left;}
#dp .dp-hide{display:none;}
#dp .dp-show{display:block;}
#dp .dp-invisible{visibility:hidden;}

/***********************************************************************************************************************
* DeskPRO customizations or additions made to Twitter Bootstrap
***********************************************************************************************************************/

#dp .dp-badge:hover {
	cursor: default;
}

#dp .dp-badge.dp-small {
	font-size: 10px;
	padding: 0px 4px;
}

#dp .dp-nav li .dp-info-prefix {
	color: #838383;
}

#dp .dp-dropdown-element { position:absolute;top:100%;left:0;z-index:1000;float:left;display:none;min-width:160px;padding:4px 0;margin:0;list-style:none;background-color:#ffffff;border-color:#ccc;border-color:rgba(0, 0, 0, 0.2);border-style:solid;border-width:1px;-webkit-border-radius:0 0 5px 5px;-moz-border-radius:0 0 5px 5px;border-radius:0 0 5px 5px;-webkit-box-shadow:0 5px 10px rgba(0, 0, 0, 0.2);-moz-box-shadow:0 5px 10px rgba(0, 0, 0, 0.2);box-shadow:0 5px 10px rgba(0, 0, 0, 0.2);-webkit-background-clip:padding-box;-moz-background-clip:padding;background-clip:padding-box;*border-right-width:2px;*border-bottom-width:2px; }
#dp .dp-dropdown-element {
	{{ _self.border_radius(6) }}
}
#dp .dp-dropdown-element.dp-pull-right {
	{{ _self.border_radius({tr: 0}) }}
}
#dp .dp-dropdown-element.dp-pull-right{right:0;left:auto;}
#dp .dp-dropdown.dp-open .dp-dropdown-element { display: block; }

/***********************************************************************************************************************
* #dp_html
* Applied to the DeskPRO HTML page
***********************************************************************************************************************/

/*
	The DeskPRO page structure is like this:

	html#dp_html
		body
			div#dp_custom_header
			div#dp
				div#dp_main
					section#dp_header_bar
						div#dp_header_title
						div#dp_header_search
					div#dp_page_wrapper
						div#dp_content_wrapper
							section#dp_content
						div#dp_sidebar_wrapper
							section#dp_sidebar
					div#dp_footer_bar
 */

html#dp_html, html#dp_html body {
	background: #fff;
	margin: 0;
	padding: 0;
}

#dp {
	font-family: {{ font_body|raw }};
	font-size: 13px;
	line-height: 18px;
	color: #333333;
}

#dp li, #dp td, #dp span, #dp label {
	font-family: {{ font_body|raw }};
}

#dp h1, #dp h2, #dp h3, #dp h4, #dp h5, #dp h6 {
	font-family: {{ font_headings|raw }};
	text-shadow: 1px 1px 1px rgba(255,255,255, 0.8);
}

#dp_custom_header {

}

#dp_main {
	width: {{ page_width }}px;
	margin: 15px auto 15px auto;
}

#dp .dp-clear {
	clear: both;
	height: 1px;
	overflow: hidden;
	visibility: hidden;
}

/***********************************************************************************************************************
* Header Bar
* This includes the top blue bar, the helpdesk title, and the search box
***********************************************************************************************************************/

{% set dp_header_bar_height = 55 %}
#dp_header_bar {
position: relative;
	width: {{ page_width }}px;
	height: {{ dp_header_bar_height }}px;
	background-color: #2a69a9;
	color: #fff;
	border-bottom: 2px solid #1A4A7A;
	{{ _self.border_radius({ tl: 6, tr: 6}) }}
	overflow: hidden;
}

#dp_header_bar h1 {
	line-height: {{ dp_header_bar_height + 5 }}px;
	padding: 0;
	margin: 0;
	padding-left: 15px;
	text-shadow: 0px 1px 1px rgba(0,0,0, 0.5);
}

section#dp_header_search {
	position: absolute;
	right: 15px;
	top: 12px;
}

section#dp_header_search input#deskpro_search {
	width: 440px;
	padding: 7px;
	margin-right: 10px;
	font-size: 11pt;
	background: #fff url(../../web/images/user/mag-left.png) no-repeat 10px 50%;
	padding-left: 30px;
}

section#dp_header_search input#deskpro_search::-webkit-input-placeholder { color: #555; }
section#dp_header_search input#deskpro_search:-moz-placeholder { color: #555; }

section#dp_header_search .dp-btn {
	padding: 7px 12px;
	font-size: 11pt;
}


/***********************************************************************************************************************
* Layout
* These rules just define the layout of the two columns (page column and the sidebar)
***********************************************************************************************************************/

{% set dp_sidebar_width = 250 %}

#dp_page_wrapper {
	background-color: #ededed;
	padding: 18px;
	border: 1px solid #B2B1B1;
	border-top: none;
}

#dp_sidebar_wrapper {
	float: right;
	width: {{ dp_sidebar_width }}px;
}

#dp_content_wrapper {
	margin-right: {{ dp_sidebar_width+18 }}px;
}

#dp_content {
	background-color: #fff;
	border: 1px double #d2d0d0;
	{{ _self.border_radius({ tl: 5, tr: 5, bl: 5, br: 5 }) }}
}

#dp_breadcrumb_wrap {

}

#dp_breadcrumb_wrap .dp-breadcrumb {
	border-top: none;
	border-left: none;
	border-right: none;
	{{ _self.border_radius({ tl: 6, tr: 6, bl: 0, br: 0 }) }}
}

#dp_breadcrumb_wrap .dp-breadcrumb li i {
	{{ _self.opacity(0.7) }}
}

#dp_breadcrumb_wrap .dp-breadcrumb li:last-child .dp-divider {
	display: none;
}

/***********************************************************************************************************************
* Main Nav Tabs
* These are the big tabs at the top of the page for Home, Knowledgebase, Feedback and Contact Us
***********************************************************************************************************************/

{% set dp_content_tab_height = 45 %}

nav#dp_content_tabs {
	height: {{ dp_content_tab_height }}px;
	overflow: hidden;
	position: relative;
	top: 1px;
	z-index: 2;
}
nav#dp_content_tabs ul {
	margin: 0;
	margin-left: 10px;
	padding: 0;
}

nav#dp_content_tabs ul li {
	position: relative;
	top: 0px;
	display: block;
	float: left;
	margin-right: 10px;
	box-sizing: border-box;
	height: {{ dp_content_tab_height-2 }}px;

	border: 1px solid #c9d0d8;
	background-color: #fff;
	{{ _self.border_radius({ tr: 6, tl: 6}) }}
	-moz-background-clip: padding; -webkit-background-clip: padding-box; background-clip: padding-box;
	{{ _self.box_shadow('1px 0px 2px rgba(0,0,0, 0.2)') }}

	font-family: "Helvetica Neue",Helvetica,Arial,sans-serif;
	line-height: 100%;
	cursor: pointer;
}

nav#dp_content_tabs ul li:hover,
nav#dp_content_tabs ul li.on {
	{{ _self.box_shadow('1px 0px 2px rgba(0,0,0, 0.3), inset 0px 0px 1px rgba(0,0,0, 0.3)') }}
	border: 1px solid #c9d0d8;
	cursor: pointer;
}

nav#dp_content_tabs ul li.on {
	height: {{ dp_content_tab_height+1 }}px;
	top: 1px;
}

nav#dp_content_tabs ul li:hover h3 {
	text-decoration: underline;
}

nav#dp_content_tabs a, nav#dp_content_tabs a:hover {
	color: inherit;
	text-decoration: none;
	display: block;
}

nav#dp_content_tabs h3 {
	margin: 0;
	padding: 6px 8px 3px 3px;
	line-height: 100%;
	font-size: 15px;
	font-weight: bold;
	color: #0088CC;
	text-decoration: none;
	display: inline-block;
}
nav#dp_content_tabs h3  {
	line-height: 100%;
	border-bottom: 2px solid transparent;
}

nav#dp_content_tabs i {
	{{ _self.opacity(0.7) }}
	margin-left: 8px;
}

nav#dp_content_tabs label {
	line-height: 100%;
	margin: 0;
	font-size: 11px;
	color: #6E6E6E;
	padding: 0 8px 0 8px;
}

/***********************************************************************************************************************
* Sidebar
* This contains the style for sidebar and sidebar blocks
***********************************************************************************************************************/

#dp_sidebar_wrapper {
	/* Padding top to align contents of sidebar with that of the page,
	because the tabs at the top of the content column take up space */
	padding-top: {{ dp_content_tab_height }}px;
}

#dp_sidebar_wrapper section.dp-sidebar-block {
	margin-bottom: 15px;
	background-color: #fff;
	border: 1px solid #D2D0D0;
	{{ _self.border_radius(6) }}
}

#dp_sidebar_wrapper section.dp-sidebar-block > header {
	border-bottom: 1px solid #D2D0D0;
}

#dp_sidebar_wrapper section.dp-sidebar-block > header h3 {
	padding: 2px 5px 0 6px;
	margin: 0;
	font-size: 15px;
	line-height: 25px;
}

#dp_sidebar_wrapper section.dp-sidebar-block > article.dp-written {
	padding: 10px;
}

/***********************************************************************************************************************
* Content
* These styles are general styling applied to pages in DeskPRO
***********************************************************************************************************************/

#dp .dp-br-clear {
	clear: both;
	height: 1px;
	overflow: hidden;
}

#dp .dp-summary {
	font-size: 90%;
	color: #888;
}

#dp .not-loading { display: block; }
#dp .is-loading { display: none; }

#dp .loading .not-loading { display: none; }
#dp .loading .is-loading { display: block; }

/******************************
* A person list is a list with a person avatar, and a name.
* Options: .dp-compact turns the list into just an avatar shown side-by-side
******************************/

#dp ul.dp-person-list {
	margin: 0;
	padding: 0;
}

#dp ul.dp-person-list li {
	list-style: none;
	margin: 0;
	padding: 0;
}

#dp ul.dp-person-list li span {
	display: block;
	line-height: 30px;
	background-repeat: no-repeat;
	background-position: 0 50%;
	padding-left: 30px;
}

#dp ul.dp-person-list.dp-compact li {
	float: left;
	margin-right: 6px;
}

#dp ul.dp-person-list.dp-compact li span {
	padding-left: 0;
	width: 24px;
	height: 24px;
	text-indent: -1000px;
	overflow: hidden;
}

/******************************
* Intro Box
* The welcome box at the top of pages, like the top of the portal
******************************/

#dp .dp-intro-box {
	margin: 30px;
	margin-bottom: 30px;
	background-color: #F5F5F5;
	border: 1px solid #DADADA;
	padding: 10px;
	{{ _self.border_radius(6) }};
}

/******************************
* Content Listing: General styling applied to lists of content, like a listing of news posts
******************************/

#dp ul.dp-content-list {
	margin: 0;
	padding: 0;
}

#dp ul.dp-content-list > li {
	list-style: none;
	padding: 0 0 35px 0;
	margin: 15px 0 35px 0;
	border-bottom: 1px solid #DDDCDC;
}

#dp ul.dp-content-list > li:last-child {
	border-bottom: none;
}

#dp .dp-content-post > header h3 {
	font-size: 15pt;
	font-weight: normal;
	margin: 0;
	padding: 0;
	line-height: 100%;
	padding-bottom: 2px;
}

#dp .dp-content-post > article {
	padding: 15px;
}

#dp .dp-content-post > article p {
	line-height: 160%;
}

#dp .dp-content-post > footer {
	padding-left: 15px;
}

#dp ul.dp-post-info {
	margin: 0;
	padding: 0;
}

#dp ul.dp-post-info li {
	display: inline-block;
	margin-right: 18px;
	font-size: 9pt;
	color: #898888;
}

#dp ul.dp-post-info li i {
	{{ _self.opacity(0.5) }}
}

#dp ul.dp-post-info li a {
	color: #898888;
	text-decoration: underline;
}

/******************************
* Social Block: Style for the block that contains twitter, facebook and gplus buttons
******************************/

#dp .dp-social-block > table {
	margin: 0;
	padding: 0;
}

#dp .dp-social-block > table th {
	font-weight: bold;
	vertical-align: middle;
	padding-right: 10px;
}

#dp .dp-social-block > table td {
	padding: 0 10px 0 10px;
	vertical-align: middle;
}

/******************************
* Category List: A listing intended to be category titles and an option count
******************************/

#dp ul.dp-cat-list {
	margin: 0 0 0 8px;
	padding: 0;
}

#dp ul.dp-cat-list.dp-dropdown-element {
	max-width: 228px;
	padding: 8px;
}

#dp ul.dp-cat-list li {
	padding: 0;
	margin: 3px 0 3px 0;
	list-style: none;
	font-size: 10pt;
}

#dp ul.dp-cat-list li.sep {
	border-top: 1px solid #D2D0D0;
	margin: 8px -8px 0 -8px;
	padding: 0 0 8px 0;
	height: 1px;
	overflow: hidden;
}

#dp ul.dp-cat-list li.dp-sub { padding-left: 15px; }
#dp ul.dp-cat-list li.dp-sub.dp-depth-2 { padding-left: 30px; }
#dp ul.dp-cat-list li.dp-sub.dp-depth-3 { padding-left: 45px; }
#dp ul.dp-cat-list li.dp-sub.dp-depth-4 { padding-left: 60px; }
#dp ul.dp-cat-list li.dp-sub.dp-depth-5 { padding-left: 75px; }
#dp ul.dp-cat-list li.dp-sub.dp-depth-6 { padding-left: 90px; }

#dp ul.dp-cat-list li i {
	{{ _self.opacity(0.3) }}
}

#dp ul.dp-cat-list li:hover i {
	{{ _self.opacity(1) }}
}

#dp .dp-login-box-inner {
	margin: 20px 0 0 0;
}

#dp .dp-login-box-inner .dp-btn-row { text-align: right; }
#dp .dp-reset-section .dp-btn-row { text-align: center; margin-top: 8px; }
#dp .dp-login-box-inner .dp-reset-desc { text-align: center; }

#dp .dp-login-box-inner form {
	margin: 0;
	padding: 0;
}

#dp .dp-login-box-inner dl {
	margin: 0;
	padding: 0;
}


/******************************
* A table used for design/layout
******************************/

#dp table.dp-layout,
#dp table.dp-layout > thead > tr > td,
#dp table.dp-layout > thead > tr > th,
#dp table.dp-layout > tbody > tr > td,
#dp table.dp-layout > tbody > tr > th {
	margin: 0;
	padding: 0;
	border: 0;
}

/***********************************************************************************************************************
* Portal Section
* This is a master wrapper around page section
***********************************************************************************************************************/

.dp-portal-section {
	margin: 15px;
}

#dp section.dp-portal-section {
	margin-bottom: 15px;
}

#dp section.dp-portal-section > header h1 {
	font-size: 20pt;
	font-weight: normal;
	font-family: "HelveticaNeue-Light","Helvetica Neue Light","Helvetica Neue",sans-serif;
	color: #C3C2C2;
	margin-bottom: 25px;
}

#dp section.dp-portal-section > .dp-content-block {
	margin-left: 15px;
}

/***********************************************************************************************************************
* News
* These styles apply to news listings and news posts
***********************************************************************************************************************/

#dp .dp-cal-date {
    width: 46px;
    float: left;
	margin-right: 12px;
}

#dp .dp-cal-date .dp-month {
    background-color: {{ stylevar.cal_date_month_bg }};
    font-size: 9px;
    font-weight: bold;
    color: {{ stylevar.cal_date_month_text }};
    text-align: center;

    -moz-border-radius-topleft: 4px;
    -moz-border-radius-topright: 4px;
    -moz-border-radius-bottomright: 0px;
    -moz-border-radius-bottomleft: 0px;
    -webkit-border-radius: 4px 4px 0px 0px;
    border-radius: 4px 4px 0px 0px;
}

#dp .dp-cal-date .dp-day {
    background-color: {{ stylevar.cal_date_bg }};
    border: 2px solid {{ stylevar.cal_date_border }};
    border-top: none;
    text-align: center;
    color: {{ stylevar.cal_date_text }};
    font-family: 'Myriad Pro','Myriad',helvetica,arial,sans-serif;
    font-size: 13px;
    padding-top: 2px;

    -moz-border-radius-topleft: 0px;
    -moz-border-radius-topright: 0px;
    -moz-border-radius-bottomright: 4px;
    -moz-border-radius-bottomleft: 4px;
    -webkit-border-radius: 0px 0px 4px 4px;
    border-radius: 0px 0px 4px 4px;
}

/***********************************************************************************************************************
* Articles
* These styles apply to article lists and articles
***********************************************************************************************************************/

#dp .dp-articles-block ul.dp-content-list > li {
	margin: 0 0 10px 0;
	padding: 10px 0 10px 0;
}

/***********************************************************************************************************************
* Feedback
***********************************************************************************************************************/

#dp .dp-new-feedback-section > article {
	margin: 0;
}

#dp .dp-new-feedback {
	margin: 30px;
	margin-bottom: 30px;
	background-color: #F5F5F5;
	border: 1px solid #DADADA;
	padding: 10px;
	{{ _self.border_radius(6) }};
}

#dp .dp-new-feedback > header h2 {
	font-size: 11pt;
	font-weight: bold;
	color: #8D8D8D;
}

#dp .dp-new-feedback .dp-search-bar .dp-add-on {
	padding: 5px 8px 5px 8px;
	font-size: 14pt;
	height: 22px;
	vertical-align: top;
}

#dp .dp-new-feedback .dp-search-bar .dp-input-prepend,
#dp .dp-new-feedback .dp-search-bar .dp-suggest-title {
	margin-bottom: 0;
}

#dp .dp-new-feedback .dp-search-bar input.dp-suggest-title {
	width: 80%;
	padding: 5px 8px 5px 8px;
	font-size: 14pt;
	height: 22px;
}

#dp .dp-new-feedback .dp-search-bar  .dp-btn {
	padding: 5px 10px 5px 10px;
	font-size: 14pt;
	margin-top: 2px;=
}

/***********************************************************************************************************************
* Browse Lists
* These are category lists that have a heading for the parent, and then links for one level of children,
* and a link for "view all"
***********************************************************************************************************************/

#dp ul.dp-browse-list {
	list-style-type: none;
	clear: left;

	padding-bottom: 40px;
	margin-left: 15px;
}

#dp ul.dp-browse-list:first-of-type {
	border-top: none;
	margin-top: 0;
}

#dp ul.dp-browse-list a {
	cursor: pointer;
}

#dp ul.dp-browse-list .dp-view-more {
	float: left;
	background-color: #F0F0F0;
	{{ _self.border_radius(8) }}
}

#dp ul.dp-browse-list .dp-view-more a {
	display: block;
	padding: 5px 10px 5px 10px;
}

#dp ul.dp-browse-list .dp-view-more a:hover {
	text-decoration: none;
}

#dp ul.dp-browse-list .dp-view-more .dp-badge {
	position: relative;
	top: -1px;
}

#dp ul.dp-browse-list > li {
	float: left;
	width: 45%;

	background: transparent url(../../web/images/user/page.png) no-repeat 0 0px;
	padding-left: 24px;
	margin-bottom: 35px;
}

#dp ul.dp-browse-list > li > h3 {
	font-size: 11pt;
	margin: 0;
	padding: 1px 0 3px 0;
	line-height: 100%;
}

#dp ul.dp-browse-list > li > h3 a {
	color: #000;
}

#dp ul.dp-browse-list > li > ul {
	margin: 0;
	padding: 0;
	list-style-type: none;
}

#dp ul.dp-browse-list > li > ul > li {
	line-height: 100%;
	padding: 0 3px;
	margin-left: 15px;
	list-style: square;
	line-height: 150%;
}

/******************
* dp-browse-list-full
*******************/

#dp ul.dp-browse-list-full {
	list-style-type: none;
	font-size: 11px;

	padding-top: 5px;
	margin-left: 10px;
	margin-right: 10px;
	margin-bottom: 0;
}

#dp ul.dp-browse-list-full.sep {
	margin-top: 10px;
	clear: left;
}

#dp ul.dp-browse-list-full a {
	cursor: pointer;
}

#dp ul.dp-browse-list-full > li {
	margin-bottom: 8px;
}

#dp ul.dp-browse-list-full > li:last-of-type {
	border-bottom: none;
}

#dp ul.dp-browse-list-full > li > h3 {
	font-size: 10pt;
	font-weight: normal;
	margin: 0;
	padding: 0 0 0 0;
	line-height: 100%;
}

#dp ul.dp-browse-list-full > li .dp-meta {
	color: {{ stylevar.meta_text_color }};
}