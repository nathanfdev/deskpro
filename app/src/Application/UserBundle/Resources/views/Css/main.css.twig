	line-height: 18px;
}

#dp_chat_messages_pane .row .message {
	font-size: 12px;
	clear: both;
}

#dp_chat_messages_pane .row.agent {
	background-color: #DDE2E9;
}

#dp_chat_message_upload {
	position: absolute;
	bottom: 0;
	left: 0;
	right: 0;
}

#dp_chat_upload_link {
	position: absolute;
	bottom: 0;
	left: 0;
	color: blue;
	padding: 0 0 5px 5px;
}

#dp_chat_message_upload_file {
	position: absolute;
	bottom: 0;
	left: 0;
	filter: alpha(opacity=0);
	-khtml-opacity: 0;
	-moz-opacity: 0;
	opacity: 0;
}

#dp_chat_filedrag {
	position: absolute;
	bottom: 0;
	left: 0;
	right: 0;
	top: 0;
	font-size: 13px;
	z-index: 100;
	background-color: #FFF2D5;
	text-align: center;
	padding-top: 20px;
	display: none;

	filter: alpha(opacity=90);
	-khtml-opacity: 0.9;
	-moz-opacity: 0.9;
	opacity: 0.9;
}

.file-drag-over #dp_chat_filedrag {
	display: block;
}

#dp_chatwin_close {
	position: absolute;
	top: 0;
	right: 0;
	width: 16px;
	height: 16px;
	overflow: none;
	background: url(../../web/images/user/cross.png);
	display: block;
	cursor: pointer;
	z-index: 50;
}

#dp_chatwin_min {
	position: absolute;
	top: 0;
	right: 18px;
	width: 16px;
	height: 16px;
	overflow: none;
	background: url(../../web/images/user/bullet_toggle_minus.png);
	display: block;
	cursor: pointer;
	z-index: 50;
}

#dp_chat_end_confirm {
	position: absolute;
	top: 15px;
	right: 15px;
	left: 15px;
	padding: 15px;
	text-align: center;
	z-index: 150;
	background-color: #DEE3E7;
	border: 2px solid #C5CBCF;
}

#dp_chat_done {
	position: absolute;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	overflow: auto;
	padding: 10px;
}


