#dp .feedback-link {
	position: absolute;
	bottom: 0px;
	right: 10px;
	color: #AAA;
	font-size: 10px;
	line-height: 16px;
}

#dp .dp-date  {
	font-size: 10px;
	color: #999;
}

#dp .feedback-link span {
	padding-right: 10px;
}

#dp .feedback-link .desc-helpful,
#dp .feedback-link .desc-not-helpful {
	display:none;
}

#dp .feedback-link.rating-helpful .desc-helpful { display: inline; }
#dp .feedback-link.rating-helpful .desc,
#dp .feedback-link.rating-helpful .desc-not-helpful { display: none; }

#dp .feedback-link.rating-not-helpful .desc-not-helpful { display: inline; }
#dp .feedback-link.rating-not-helpful .desc,
#dp .feedback-link.rating-not-helpful .desc-helpful { display: none; }

#dp .feedback-link a {
	display: block;
	float: right;
	width: 16px;
	height: 16px;
	background-repeat: no-repeat;
	background-position: 50% 50%;
	overflow: hidden;
	text-indent: -100px;
	cursor: pointer;
}

#dp .feedback-link a:hover,
#dp .feedback-link a.on {
	opacity: 0.6;
}


#dp .feedback-link a.helpful {
	background-image: url(../../web/images/user/thumb_up.png);
}

#dp .feedback-link a.not-helpful {
	background-image: url(../../web/images/user/thumb_down.png);
}

#dp li:hover .feedback-link,
#dp li:hover .feedback-link a {
	color: #555;
}


