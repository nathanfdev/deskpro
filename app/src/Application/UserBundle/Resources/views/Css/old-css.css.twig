	background-color:#fbfcff;
	padding:9px;
	color:#7a7f87;
	font:14px/17px 'Helvetica Neue',Helvetica,Arial, sans-serif;
}
.widget-deskpro form{
	margin:0;
	padding:0;
	border:0;
	outline:0;
	font-size:100%;
	vertical-align: baseline;
	background:none;
}
.widget-deskpro a{
	color:#000;
	text-decoration:underline;
}
.widget-deskpro p{margin:0 0 12px;}
.widget-deskpro a:hover{text-decoration:none;}
.widget-deskpro a:focus{outline:none;}
.widget-deskpro input,textarea,select{
