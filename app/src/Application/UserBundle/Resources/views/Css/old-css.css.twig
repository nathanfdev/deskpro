}
.widget-deskpro .widget-logo{
	background:url(../../web/images/user/widget/bg-logo.png) no-repeat;
	height:39px;
	width:136px;
	overflow:hidden;
	position:absolute;
	text-indent:100%;
	white-space: nowrap;
	bottom:24px;
	right:23px;
}
.widget-deskpro .widget-logo a{
	height:100%;
	display:block;
}
.widget-deskpro .aside{
	float:left;
	width:328px;
}
.widget-deskpro .aside .head{
	padding:20px 0 0 24px;
	height:53px;
	background:#dce3ff url(../../web/images/user/widget/bg-aside-head.gif) repeat-x;
}
.widget-deskpro .btn{
	border:1px solid #c2c3c8;
	float:left;
	text-decoration:none;
	background:url(../../web/images/user/widget/bg-btn.gif) repeat-x;
	height:34px;
	cursor:pointer;
	color:#707680;
	position:relative;
	border-radius: 4px;
	-moz-border-radius: 4px;
	-webkit-border-radius: 4px;
	font:bold 12px/15px 'Helvetica Neue',Helvetica,Arial, sans-serif;
}
.widget-deskpro .btn i.icon{
	display:inline-block;
	margin:0 7px 0 0;
	vertical-align:middle;
}
.widget-deskpro .btn i.icon-call{
	width:17px;
	height:12px;
	background:url(../../web/images/user/widget/icon-call.png) no-repeat;
}
.widget-deskpro .btn:hover i.icon-call,
.widget-deskpro .btn.active i.icon-call{background:url(../../web/images/user/widget/icon-call-active.png) no-repeat;}
.widget-deskpro .btn i.icon-mail{
	width:15px;
	height:12px;
	background:url(../../web/images/user/widget/icon-mail.png) no-repeat;
}
.widget-deskpro .btn:hover i.icon-mail,
.widget-deskpro .btn.active i.icon-mail{background:url(../../web/images/user/widget/icon-mail-hover.png) no-repeat;}
.widget-deskpro .btn i.icon-chat{
	width:16px;
	height:14px;
	background:url(../../web/images/user/widget/icon-chat.png) no-repeat;
}
.widget-deskpro .btn:hover i.icon-chat,
.widget-deskpro .btn.active i.icon-chat{background:url(../../web/images/user/widget/icon-chat-hover.png) no-repeat;}
.widget-deskpro a.btn{
	height:26px;
	padding:8px 10px 0;
}
.widget-deskpro .btn:hover,
.widget-deskpro .btn.active{
	border-color:#549429;
	text-decoration:none;
	color:#fff;
	background:url(../../web/images/user/widget/btn-hover.gif) repeat-x;
}
.widget-deskpro .txt{
	float:left;
	padding:0 15px;
	border:1px solid #d1d4d9;
	height:33px;
	position:relative;
	border-radius: 4px;
	-moz-border-radius: 4px;
	-webkit-border-radius: 4px;
	width:225px;
	background:url(../../web/images/user/widget/bg-txt-field.gif) repeat-x;
}
.widget-deskpro .txt-wide{width:533px;}
.widget-deskpro .txt.correct{
	border-color:#72b843;
	box-shadow: 0 0 20px 1px #e0efd6;
	-webkit-box-shadow: 0 0 20px 1px #e0efd6;
	-moz-box-shadow: 0 0 20px 1px #e0efd6;
}
.widget-deskpro .txt.error{
	border-color:#db4e4e;
	box-shadow: 0 0 20px 1px #f9e0e0;
	-webkit-box-shadow: 0 0 20px 1px #f9e0e0;
	-moz-box-shadow: 0 0 20px 1px #f9e0e0;
}
.widget-deskpro .error .tooltip-error {
	display: block;
}
.widget-deskpro .tooltip-error{
	display: none;
	position:absolute;
	right:5px;
	padding-right:21px;
	top:28px;
	font-size:9px;
	line-height:12px;
	color:#fff;
	background:url(../../web/images/user/widget/bg-tooltip.png) no-repeat 100% -28px;
}
.widget-deskpro .tooltip-error>span{
	float:right;
	padding:8px 0 0 18px;
	height:20px;
	background:url(../../web/images/user/widget/bg-tooltip.png) no-repeat;
}
.widget-deskpro .dp-form-row-ticket_message .tooltip-error,
.widget-deskpro .dp-form-row-content .tooltip-error {
	bottom: -23px;
	top: auto;
}
.widget-deskpro .dp-form-row-ticket_department_id, .widget-deskpro .dp-form-row-category_id {
	position: relative;
}
.widget-deskpro .dp-form-row-ticket_department_id .tooltip-error, .widget-deskpro .dp-form-row-category_id .tooltip-error {
	right: auto;
	left: 10px;
}
.widget-deskpro .txt input{
	float:left;
	border:0;
	background:none;
	width:100%;
}
.widget-deskpro input[type="text"],
.widget-deskpro input[type="password"]{
	color:#7a7f87;
	height:17px;
	width:95%;
