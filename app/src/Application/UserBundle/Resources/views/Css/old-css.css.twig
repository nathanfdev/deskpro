#dp_chat {
	background-color: #fff;
}
#dp_chat {
	font-family: "Lucida Grande", "Lucida Sans Unicode", "Tahoma", Arial, sans-serif;
	font-size: 11px;
}

#dp_chat_wrap, #dp_chat_active, #dp_chat_start, #dp_chat_finding_agent {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	border: 1px solid #CCCCCC;
	border-bottom: none;
}

#dp_chat_finding_agent_more {
	padding: 30px;
	text-align: center;
}

#dp_chat_header_pane {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	height: 40px;
	background-color: #ECF0F4;
	border-bottom: 1px solid #ccc;
}

#dp_chat_messages_pane {
	position: absolute;
	top: 41px;
	left: 0;
	right: 0;
	bottom: 76px;
	overflow: auto;
}

#dp_chat_input_pane {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 75px;
	border-top: 1px solid #ccc;
	background-color: #F1F1F1;
}

#dp_chat_input_pane textarea#dp_chat_message_input {
	position: absolute;
	left: 5px;
	top: 5px;
	height: 40px;
	width: 75%;
}
#dp_chat_input_pane button#dp_chat_message_send {
	position: absolute;
	right: 5px;
	top: 5px;
	height: 40px;
	width: 18%;
}

#dp_chat_start {
	padding: 20px;
}

#dp_chat_start input, #dp_chat_start select, #dp_chat_start button {
	width: 99%;
	margin-bottom: 10px;
}

#dp_chat_finding_agent p {
	padding: 30px;
	padding-bottom: 40px;
	background: url(../../web/images/spinners/loading-big-circle.gif) no-repeat 50% 100%;
	text-align: center;
}

#dpchat_with_agent .avatar {
	float: left;
	margin-right: 10px;
}

#dpchat_with_agent .info {
	float: left;
}

#dpchat_with_agent .info h1 {
	margin: 0;
	padding: 0;
	font-size: 14px;
}

#dp_chat_messages_pane .row {
	margin: 8px;
	padding: 6px;
	background-color: #F5F7FA;
	border-radius: 4px;
	border: 1px solid #CED4DB;
}

#dp_chat_messages_pane .row.sys {
	background-color: #F7F7F7;
	border: 1px solid #E8EAEA;
}

#dp_chat_messages_pane .row.sys .author {
	display: none;
}

#dp_chat_messages_pane .row .avatar {
	float: left;
	margin-right: 5px;
}

#dp_chat_messages_pane .row .author {
	font-weight: bold;
	line-height: 18px;
}

#dp_chat_messages_pane .row .message {
	font-size: 12px;
	clear: both;
}

#dp_chat_messages_pane .row.agent {
	background-color: #DDE2E9;
}

#dp_chat_message_upload {
	position: absolute;
	bottom: 0;
	left: 0;
	right: 0;
}

#dp_chat_upload_link {
	position: absolute;
	bottom: 0;
	left: 0;
	color: blue;
	padding: 0 0 5px 5px;
}

#dp_chat_message_upload_file {
	position: absolute;
	bottom: 0;
	left: 0;
	filter: alpha(opacity=0);
	-khtml-opacity: 0;
	-moz-opacity: 0;
	opacity: 0;
}

#dp_chat_filedrag {
	position: absolute;
	bottom: 0;
	left: 0;
	right: 0;
	top: 0;
	font-size: 13px;
	z-index: 100;
	background-color: #FFF2D5;
	text-align: center;
	padding-top: 20px;
	display: none;

	filter: alpha(opacity=90);
	-khtml-opacity: 0.9;
	-moz-opacity: 0.9;
	opacity: 0.9;
}

.file-drag-over #dp_chat_filedrag {
	display: block;
}

#dp_chatwin_close {
	position: absolute;
	top: 0;
	right: 0;
	width: 16px;
	height: 16px;
	overflow: none;
	background: url(../../web/images/user/cross.png);
	display: block;
	cursor: pointer;
	z-index: 50;
}

#dp_chatwin_min {
	position: absolute;
	top: 0;
	right: 18px;
	width: 16px;
	height: 16px;
	overflow: none;
	background: url(../../web/images/user/bullet_toggle_minus.png);
	display: block;
	cursor: pointer;
	z-index: 50;
}

#dp_chat_end_confirm {
	position: absolute;
	top: 15px;
	right: 15px;
	left: 15px;
	padding: 15px;
	text-align: center;
	z-index: 150;
	background-color: #DEE3E7;
	border: 2px solid #C5CBCF;
}

#dp_chat_done {
	position: absolute;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	overflow: auto;
	padding: 10px;
}


#dp_overlay .hidden-file-upload, .widget-deskpro .hidden-file-upload {
	position: relative;
	width: 150px;
}

#dp_overlay .hidden-file-upload span, .widget-deskpro .hidden-file-upload span {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	font-size: 11px;
}

#dp_overlay .hidden-file-upload span.link, .widget-deskpro .hidden-file-upload span.link {
	color: blue;
	text-decoration: underline;
}

#dp_overlay .hidden-file-upload input, .widget-deskpro .hidden-file-upload input {
	filter: alpha(opacity=0);
	-khtml-opacity: 0;
	-moz-opacity: 0;
	opacity: 0;
}

/**********************************************************
* Website Widget
**********************************************************/

.widget-deskpro{
	margin: 0 auto;
	border-radius: 4px;
	-moz-border-radius: 4px;
	-webkit-border-radius: 4px;
	width:942px;
