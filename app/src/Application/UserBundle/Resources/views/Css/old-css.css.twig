	padding:0;
	margin:0;
}
.widget-deskpro form,
.widget-deskpro fieldset{border-style:none;}
.widget-deskpro ol{padding:0 0 14px 24px;}
.widget-deskproul li,
.widget-deskpro ol li{list-style-position:outside;}
.widget-deskpro ul li{list-style-type:disc;}
.widget-deskpro ul{padding:0 0 14px 18px;}
.widget-deskpro .widget-close{
	position:absolute;
	text-indent:-9999px;
	overflow:hidden;
	background:url(../../web/images/user/widget/btn-close.png) no-repeat;
	height:28px;
	width:28px;
	right:-13px;
	top:-15px;
}
.clearfix:after {
	clear: both;
	content:'';
	display: block;
}
.widget-deskpro .widget-container{
	position:relative;
	background:#fff url(../../web/images/user/widget/bg-widget-container.gif) repeat-y;
	border:1px solid #c5c5c5;
