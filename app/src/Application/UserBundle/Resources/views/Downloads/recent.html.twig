{% extends 'UserBundle:Downloads:layout.html.twig' %}
{% block breadcrumb %}
	<li><a href="{{ path('user_downloads') }}">{{ phrase('user.downloads') }}</a></li>
	<li><a href="{{ path('user_downloads_recent') }}">{{ phrase('user.downloads.recent_section_name') }}</a></li>
{% endblock %}
{% block downloads_recent %}
	<div class="with-handler"
		data-element-handler="DeskPRO.User.ElementHandler.MoreLoader"
		data-load-url="{{ path('user_downloads_recent', {'page': '00000'})|replace({'00000': '{page}'}) }}"
	>
		<div class="content-list">
			<ul>
				{% include 'UserBundle:Downloads:recent-items.html.twig' %}
			</ul>
		</div>
		{% if show_more %}
		<div class="content-more">
			<div class="is-not-loading">
				<a class="button" href="{{ path('user_downloads_recent', {'page': page+1}) }}">{{ phrase('user.more_btn')}}</a>
			</div>
			<div class="is-loading">
				<center><img src="{{ asset('images/loading-big-circle.gif') }}" alt="" /></center>
			</div>
		</div>
		{% endif %}
	</div>
{% endblock %}
