{% extends 'UserBundle::layout.html.twig' %}
{% block breadcrumb %}
	<li><span class="dp-divider">&rarr;</span> <a href="{{ path('user_downloads') }}">{{ phrase('user.general.downloads') }}</a></li>
	{% for cat in category_path %}
		<li><<span class="dp-divider">&rarr;</span> a href="{{ path('user_downloads', {'slug': cat.url_slug}) }}">{{cat.title}}</a></li>
	{% endfor %}
{% endblock %}
{% block page_title %}
	{{ phrase('user.general.downloads') }} /
	{% for cat in category_path %}
		{{cat.title}} /
	{% endfor %}
	{{category.title}}
{% endblock %}
{% block content %}
	<div class="dp-box-nav">
		<ul>
			<li class="dp-title">{{ phrase('user.downloads.category') }}:</li>
			<li class="all {% if not category %}on{% endif %}">
				<a href="{{ path('user_downloads') }}"><span>{{ phrase('user.feedback.status_all') }} <em>({{ category_counts['0_total']|default(0) }})</em></span></a>
			</li>
			{% include 'UserBundle:Downloads:browse-cat-list.html.twig' with {'categories': categories } %}
		</ul>
	</div>
	<div class="dp-box-content dp-with-nav">
		<ul class="dp-downloads-list">
			{% for download in downloads %}
				<li>
					<div class="dp-faded-container">
						<h3><span class="dp-icon-file dp-icon-{{ download.blob.extension }}"><a href="{{ path('user_downloads_file', {'slug': download.url_slug}) }}">{{ download.title }}</a></span></h3>
						<div class="dp-bound-faded"></div>
					</div>
					<div class="meta">
						<a href="{{ path('serve_blob', {'blob_auth_id': download.blob.auth_id, 'filename': download.blob.filename}) }}">{{ download.filename }}</a> | {{ download.readable_filesize }}
						{% if comment_counts[download.id] %}| Comments: {{ comment_counts[download.id] }}{% endif %}
					</div>
				</li>
			{% endfor %}
		</ul>

		{% if is_partial_request() %}
			{% if num_results > downloads|length %}
				<div class="dp-footer">
					<a class="btn" href="{{ path('user_downloads') }}">{{ phrase('user.downloads.view_all_x', {'count': num_results})}}</a>
				</div>
			{% endif %}
		{% else %}
			{% if pageinfo.last != 1 %}
				<div class="dp-footer">
					<div class="pagination">
						<ul>
							{% if pageinfo.prev %}
								<li>
									<a href="{{ path('user_downloads', {'slug': cat.url_slug, 'page': pageinfo.prev }) }}">{{ phrase('user.general.page_prev') }}</a>
								</li>
							{% endif %}
							{% for p in pageinfo.pages %}
								<li {% if pageinfo.curpage == p %}class="active"{% endif %}>
									<a href="{{ path('user_downloads', {'slug': cat.url_slug, 'page': p }) }}">{{ p }}</a>
								</li>
							{% endfor %}
							{% if pageinfo.next %}
								<li>
									<a href="{{ path('user_downloads', {'slug': cat.url_slug, 'page': pageinfo.next }) }}">{{ phrase('user.general.page_next') }}</a>
								</li>
							{% endif %}
						</ul>
						<br class="dp-clear" style="clear:right"/>
					</div>
				</div>
			{% endif %}
		{% endif %}
		<br class="dp-clear" style="clear:left "/>
	</div>
{% endblock %}
