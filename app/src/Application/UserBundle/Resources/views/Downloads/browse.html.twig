{##
 # The main downloads page that lists categories and results. This page is used both for the
 # downloads homepage, and viewing specific categories.
 ##}

{% set this_section = 'downloads' %}
{% extends 'UserBundle::layout.html.twig' %}
{% block breadcrumb %}
<li xmlns="http://www.w3.org/1999/html"><span class="dp-divider">&rarr;</span> <a href="{{ path('user_downloads') }}">{{ phrase('user.downloads.title') }}</a></li>
	{% if category %}
		{% for cat in category_path %}
			<li><span class="dp-divider">&rarr;</span> <a href="{{ path('user_downloads', {'slug': cat.url_slug}) }}">{{cat.title}}</a></li>
		{% endfor %}
		<li><span class="dp-divider">&rarr;</span> <a href="{{ path('user_downloads', {'slug': category.url_slug}) }}">{{category.title}}</a></li>
	{% endif %}
{% endblock %}
{% block page_title %}
	{{ phrase('user.downloads.title') }}
	{% if category %}
		/
		{% for cat in category_path %}
			{{cat.title}} /
		{% endfor %}
		{{category.title}}
	{% endif %}
{% endblock %}
{% block content %}

{% if category_children|length %}
	<div style="overflow: hidden;">
		<section class="dp-portal-section">
			<header>
				{% if category %}
					<h1>{{ phrase('user.downloads.title-categories', {'count': category_children|length}) }}</h1>
				{% else %}
					<h1>{{ phrase('user.downloads.categories') }}</h1>
				{% endif %}
			</header>
			<div class="dp-content-block dp-news-block">
				<div class="dp-content-wrapper">
					<ul class="dp-cat-list">
						{% include 'UserBundle:Downloads:browse-cat-list.html.twig' with {'categories': category_children} %}
					</ul>
				</div>
			</div>
		</section>
		<br style="clear: both; height: 1px; overflow: hidden" />
	</div>
{% endif %}

{% if downloads|length %}
	<section class="dp-portal-section">
		<header>
			<h1>{{ phrase('user.downloads.title-downloads', {'count': downloads|length}) }}</h1>
		</header>
		<div class="dp-content-block dp-articles-block">
			<div class="dp-content-wrapper">
				<ul class="dp-content-list">
					{% for download in downloads %}
					<li>
						<section class="dp-article-post dp-content-post dp-download-post">
							<header>
								<h3 style="margin-bottom: 0">
									<a href="{{ path('serve_blob', {'blob_auth_id': download.blob.auth_id, 'filename': download.blob.filename}) }}">
										{{ download.title }}
										<em>{{ download.blob.getReadableFilesize() }}</em>
									</a>
								</h3>
								<ul class="dp-post-info">
									<li class="dp-date"><i class="dp-icon-calendar"></i> {{ download.date_created|date('full') }}</li>
									<li class="dp-comments"><i class="dp-icon-comment"></i> <a href="{{ path('user_downloads_file', {'slug': download.url_slug}) }}#comments">{{ phrase('user.general.count_comments', {'count': comment_counts[download.id]|default(0)}) }}</li></a
								</ul>
							</header>
							{% if download.content %}
								<div class="short-desc">
									{{ download.content_desc }}
									<a href="{{ path('user_downloads_file', {'slug': download.url_slug}) }}">{{ phrase('user.general.read_more') }}</a>
								</div>
							{% endif %}
						</section>
					</li>
					{% endfor %}
				</ul>
			</div>
		</div>
	</section>
{% endif %}

<br style="clear: both; height: 1px; overflow: hidden" />

{% endblock %}