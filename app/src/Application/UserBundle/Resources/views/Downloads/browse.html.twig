{% set this_section = 'downloads' %}
{% extends 'UserBundle::layout.html.twig' %}
{% block breadcrumb %}
	<li><span class="dp-divider">&rarr;</span> <a href="{{ path('user_downloads') }}">{{ phrase('user.general.downloads') }}</a></li>
	{% if category %}
		{% for cat in category_path %}
			<li><span class="dp-divider">&rarr;</span> <a href="{{ path('user_downloads', {'slug': cat.url_slug}) }}">{{cat.title}}</a></li>
		{% endfor %}
		<li><span class="dp-divider">&rarr;</span> <a href="{{ path('user_downloads', {'slug': category.url_slug}) }}">{{category.title}}</a></li>
	{% endif %}
{% endblock %}
{% block page_title %}
	{{ phrase('user.general.downloads') }}
	{% if category %}
		/
		{% for cat in category_path %}
			{{cat.title}} /
		{% endfor %}
		{{category.title}}
	{% endif %}
{% endblock %}
{% block content %}

{% if category_children|length %}
	<section class="dp-portal-section">
		<header>
			{% if category %}
				<h1>{{ phrase('user.downloads.there_are_x_subcats', {'count': category_children|length}) }}</h1>
			{% else %}
				<h1>{{ phrase('user.downloads.categories') }}</h1>
			{% endif %}
		</header>
		<div class="dp-content-block dp-news-block">
			<div class="dp-content-wrapper">
				<ul class="dp-cat-list">
					{% include 'UserBundle:Downloads:browse-cat-list.html.twig' with {'categories': category_children} %}
				</ul>
			</div>
		</div>
	</section>
	<br style="clear: both; height: 1px; overflow: hidden" />
{% endif %}

{% if downloads|length %}
	<section class="dp-portal-section">
		<header>
			<h1>{{ phrase('user.downloads.there_are_x_files', {'count': downloads|length}) }}</h1>
		</header>
		<div class="dp-content-block dp-articles-block">
			<div class="dp-content-wrapper">
				<ul class="dp-content-list">
					{% for download in downloads %}
					<li>
						<section class="dp-article-post dp-content-post">
							<header>
								<h3 style="margin-bottom: 0" class="dp-fadeaway-container"><a class="dp-fadeaway-title" href="{{ path('user_downloads_file', {'slug': download.url_slug}) }}">{{ download.title }}</a><div class="dp-fadeaway"></div></h3>
								<ul class="dp-post-info">
									<li class="dp-file"><i class="dp-icon-file"></i> <a href="{{ path('serve_blob', {'blob_auth_id': download.blob.auth_id, 'filename': download.blob.filename}) }}">{{ download.filename }}</a> {{ download.readable_filesize }}</li>
									<li class="dp-date"><i class="dp-icon-calendar"></i> {{ download.date_created|date('full') }}</li>
									<li class="dp-comments"><i class="dp-icon-comment"></i> {{ phrase('user.general.count_comments', {'count': comment_counts[download.id]|default(0)}) }}</li>
								</ul>
							</header>
						</section>
					</li>
					{% endfor %}
				</ul>
			</div>
		</div>
	</section>
{% endif %}

<br style="clear: both; height: 1px; overflow: hidden" />

{% endblock %}