{% extends 'UserBundle:Downloads:layout.html.twig' %}
{% block breadcrumb %}
	<li><a href="{{ path('user_downloads') }}">{{ phrase('user.downloads') }}</a></li>
	<li><a href="{{ path('user_downloads_popular') }}">{{ phrase('user.downloads.popular_section_name') }}</a></li>
{% endblock %}
{% block downloads_popular %}
	<div class="with-handler"
		data-element-handler="DeskPRO.User.ElementHandler.MoreLoader"
		data-load-url="{{ path('user_downloads_popular', {'page': '00000'})|replace({'00000': '{page}'}) }}"
	>
		<div class="content-list">
			<ul>
				{% include 'UserBundle:Downloads:popular-items.html.twig' %}
			</ul>
		</div>
		{% if show_more %}
		<div class="content-more">
			<div class="is-not-loading">
				<button>{{ phrase('user.more_btn') }}</button>
			</div>
			<div class="is-loading">
				<center><img src="{{ asset('images/loading-big-circle.gif') }}" alt="" /></center>
			</div>
		</div>
		{% endif %}
	</div>
{% endblock %}
