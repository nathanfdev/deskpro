{% extends 'UserBundle::layout.html.twig' %}
{% block head %}
	<meta property="og:url" content="{{ path('user_downloads_file', {'slug': download.url_slug}) }}" />
	<meta property="og:title" content="{{article.title}}" />
	<meta property="og:type" content="article" />
	<link rel="canonical" href="{{ url('user_downloads_file', {'slug': download.url_slug}) }}" />
{% endblock %}
{% block breadcrumb %}
<li><a href="{{ path('user_downloads') }}">{{ phrase('global.downloads') }}</a></li>
	{% for cat in category_path %}
		<li><a href="{{ path('user_downloads', {'slug': cat.url_slug}) }}">{{cat.title}}</a></li>
	{% endfor %}
	<li><a href="{{ path('user_downloads_file', {'slug': download.url_slug}) }}">{{ download.title }}</a></li>
{% endblock %}
{% block page_title %}
	{{ download.title }} - {{ download.filename }}
	-
	Downloads
	{% for cat in category_path %}
		/ {{cat.title}}
	{% endfor %}
{% endblock %}
{% block content %}
<div class="dp-download-page">
	<div class="dp-content-block">
		<div class="dp-box">
			<div class="dp-box-header">
				<h1>{{ download.title }}</h1>
			</div>
			<div class="dp-box-content-meta">
				<div class="by-line">
					<img src="{{ download.person.getPictureUrl(40) }}" />
					{{ phrase('global.created_by_name_on_date', {'name': download.person.display_name, 'date': article.date_created|date('M d Y')}) }}
					<br class="dp-clear" style="clear:left" />
				</div>
			</div>
			<div class="dp-box-content-wrapper">
				<div class="dp-box-content">
					<div class="dp-post">
						{{ download.content_html|raw }}
					</div>
					<div class="dp-download-btn-wrap">
						<a class="btn" href="{{ path('serve_blob', {'blob_auth_id': download.blob.auth_id, 'filename': download.blob.filename}) }}">
							{{ phrase('user.downloads.label_download') }}: {{ download.filename }} <small>({{ download.readable_filesize }})</small>
						</a>
					</div>

					{% include 'UserBundle:Common:labels-box.html.twig' with {'labels': download.labels} %}

					{% if app.user.hasPerm('downloads.rate') %}
						{% include 'UserBundle:Common:rating-bar.html.twig' with {'content_object': download} %}
					{% endif %}

					{% if app.getSetting('core.facebook_like') %}
						{% include 'UserBundle:Common:facebook-like.html.twig' with {'page_permalink': article.permalink} %}
					{% endif %}

					{% if app.user.hasPerm('downloads.comment') %}
						{% include 'UserBundle:Common:comments-box.html.twig' with {
							'comments': comments,
							'form_action': path('user_downloads_newcomment', {'download_id': download.id}),
							'check_perm': 'downloads.comment'
						} %}
					{% endif %}
				</div>
			</div>
		</div>
	</div>
</div>
{% endblock %}
