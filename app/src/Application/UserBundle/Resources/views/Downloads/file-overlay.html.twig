{% extends 'UserBundle:Widget:layout-content-overlay.html.twig' %}
{% block content %}
	<div class="dp-content-header">
		<h3 class="title">{{ download.title }}</h3>
	</div>
	<div class="dp-content-body">
		<div class="dp-post">
			<p><a class="btn" href="{{ path('serve_blob', {'blob_auth_id': download.blob.auth_id, 'filename': download.blob.filename}) }}">
				{{ phrase('user.downloads.label_download') }}: {{ download.filename }} <small>({{ download.readable_filesize }})</small>
			</a></p>
			{{ download.content_html|raw }}
		</div>
		{% if comments|length %}
			<div class="dp-box-comments dp-mini">
				<div class="dp-comments-placeholder dp-toggle-sel" data-toggle-sel=".dp-box-comments-content">
					<span>{{ phrase('user.comments_count', {{'count': comments|length}}) }}</span>
				</div>
				<div class="dp-box-comments-content" style="display: none">
					<ul>
						{% for comment in comments %}
							<li>
								<cite>{{ comment.user_name|default(phrase('user.name_anon')) }}:</cite>
								<div class="post">
									{{ comment.content_html|raw }}
								</div>
							</li>
						{% endfor %}
					</ul>
				</div>
			</div>
		{% endif %}
	</div>
{% endblock %}
