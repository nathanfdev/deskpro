{##
 # The department row of the new ticket form
 ##}

{% import 'UserBundle:Common:macros-form.html.twig' as formmacro %}
<div class="dp-control-group {% if error_fields['ticket.department_id'] %}dp-error{% endif %}">
	<div class="dp-control-label">
		<label><strong>{{ phrase('user.general.department') }} *</strong></label>
	</div>
	<div class="dp-controls dp-fill ticket_department">
		<select name="newticket[ticket][department_id]">
			<option value=""></option>
			{% for cat in app.getDataRepository('Department').getPersonDepartments(app.user, 'tickets') %}
				{{ formmacro.select_options_hierarchy(cat, newticket.ticket.department_id) }}
			{% endfor %}
		</select>
		<div class="dp-help-inline dp-error-explain">
			{{ phrase('user.general.please_choose_a_department') }}
		</div>
	</div>
</div>
