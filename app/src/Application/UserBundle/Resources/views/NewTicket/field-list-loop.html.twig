{##
 # This template helps draw the fields that are to be displayed on the newticket page based on the layout
 # defined from the admin interfacer.
 #
 # You generally don't want to edit this template directly because it contains logic for wrapper elements.
 #
 # If you want to modify the appearance of fields, edit one of the field-*.html.twig
 # templates instead.
 ##}

{% for item in page_data %}

{% if (mode == 'default' and item.field_type == 'ticket_department') or (mode =='non_default' and item.id not in page_data_field_ids) %}
<div data-field-id="ticket_department" class="ticket-display-field ticket_department" {% if mode == 'non_default' %}style="display: none"{% endif %}>
	{% include 'UserBundle:NewTicket:field-department.html.twig' %}
</div>
{% endif %}

{% if (mode == 'default' and item.field_type == 'ticket_subject') or (mode =='non_default' and item.id not in page_data_field_ids) %}
<div data-field-id="ticket_subject" class="ticket-display-field ticket_subject" {% if mode == 'non_default' %}style="display: none"{% endif %}>
	{% include 'UserBundle:NewTicket:field-subject.html.twig' %}
</div>
{% endif %}

{% if type != 'modify' %}
	{% if (mode == 'default' and item.field_type == 'message') or (mode =='non_default' and item.id not in page_data_field_ids) %}
	<div data-field-id="message" class="ticket-display-field message" {% if mode == 'non_default' %}style="display: none"{% endif %}>
		{% include 'UserBundle:NewTicket:field-message.html.twig' %}
	</div>
	{% endif %}

	{% if (mode == 'default' and item.field_type == 'attachments') or (mode =='non_default' and item.id not in page_data_field_ids) %}
	<div data-field-id="attachments" class="ticket-display-field attachments" {% if mode == 'non_default' %}style="display: none"{% endif %}>
		{% include 'UserBundle:NewTicket:field-attachments.html.twig' %}
	</div>
	{% endif %}
{% endif %}

{% if ticket_options.ticket_categories_hierarchy %}
{% if (mode == 'default' and item.field_type == 'ticket_category') or (mode =='non_default' and item.id not in page_data_field_ids) %}
<div data-field-id="ticket_category" class="ticket_category ticket-display-field" {% if mode == 'non_default' %}style="display: none"{% endif %}>
	{% include 'UserBundle:NewTicket:field-ticket-category.html.twig' %}
</div>
{% endif %}
{% endif %}

{% if ticket_options.products_hierarchy %}
{% if (mode == 'default' and item.field_type == 'ticket_product') or (mode =='non_default' and item.id not in page_data_field_ids) %}
<div data-field-id="ticket_product" class="ticket_product ticket-display-field" {% if mode == 'non_default' %}style="display: none"{% endif %}>
	{% include 'UserBundle:NewTicket:field-product.html.twig' %}
</div>
{% endif %}
{% endif %}

{% if form.ticket.priority_id %}
{% if (mode == 'default' and item.field_type == 'ticket_priority') or (mode =='non_default' and item.id not in page_data_field_ids) %}
<div data-field-id="ticket_priority" class="ticket_priority ticket-display-field" {% if mode == 'non_default' %}style="display: none"{% endif %}>
	{% include 'UserBundle:NewTicket:field-ticket-priority.html.twig' %}
</div>
{% endif %}
{% endif %}

{###############
 # Custom Fields
 ###############}

{% for f in custom_fields %}
{% if (mode == 'default' and item.field_type == 'ticket_field' and item.field_id == f.id) or (mode =='non_default' and item.id not in page_data_field_ids) %}
<div data-field-id="ticket_field[{{f.id}}]" class="dp-control-group custom-field ticket_field_{{f.id}} ticket-display-field" {% if mode == 'non_default' %}style="display: none"{% endif %}>
	{% include 'UserBundle:NewTicket:field-custom-field.html.twig' %}
</div>
{% endif %}
{% endfor %}

{% if captcha_html %}
{% if (mode == 'default' and item.field_type == 'captcha') or (mode =='non_default' and item.id not in page_data_field_ids) %}
<div data-field-id="captcha" class="ticket-display-field captcha">
	{% include 'UserBundle:NewTicket:field-captcha.html.twig' %}
</div>
{% endif %}
{% endif %}

{% endfor %}
