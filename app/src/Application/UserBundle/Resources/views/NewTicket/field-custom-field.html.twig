<div class="dp-control-group custom-ticket-field-{{f.id}}">
	<div class="dp-control-label">
		<label><strong>{{f.title}}</strong> {% if f.field_def.description %}<i class="dp-help-pop dp-icon-question-sign" data-title="{{ f.title }}" data-content="{{ f.field_def.description }}"></i>{% endif %}</label>
	</div>
	<div class="dp-controls dp-fill">{{ render_custom_field_form(f) }}</div>
</div>
