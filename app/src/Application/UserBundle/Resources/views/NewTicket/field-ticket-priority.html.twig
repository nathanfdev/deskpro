<div class="dp-form-row {% if error_fields['ticket.priority_id'] %}dp-error{% endif %}">
	<div class="dp-form-label">
		<label>{{ phrase('global.priority') }}</label>
	</div>
	<div class="dp-form-input">
		{{ form_widget(form.ticket.priority_id, {'class': 'priority_id'}) }}
		<div class="dp-error-explain">
			{{ phrase('user.tickets.please_choose_priority') }}
		</div>
	</div>
</div>
