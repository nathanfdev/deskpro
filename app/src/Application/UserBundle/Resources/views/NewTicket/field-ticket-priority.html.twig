{##
 # The priority select box of the new ticket form
 ##}

<div class="dp-control-group {% if error_fields['ticket.priority_id'] %}dp-error{% endif %}">
	<div class="dp-control-label">
		<label><strong>{{ phrase('user.general.priority') }}</strong></label>
	</div>
	<div class="dp-controls dp-fill ticket_priority">
		<select name="newticket[ticket][priority_id]">
			{% for id,pri in ticket_options.ticket_priorities %}
				<option value="{{ id }}">{{ pri }}</option>
			{% endfor %}
		</select>
		<div class="dp-help-inline dp-error-explain">
			{{ phrase('user.tickets.please_choose_priority') }}
		</div>
	</div>
</div>
