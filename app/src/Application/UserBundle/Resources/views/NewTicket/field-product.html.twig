{##
 # The product select box of the new ticket form
 ##}

{% import 'UserBundle:Common:macros-form.html.twig' as formmacro %}
<div class="dp-control-group ticket_product {% if error_fields['ticket.product_id'] %}dp-error{% endif %}">
	<div class="dp-control-label">
		<label><strong>{{ phrase('user.general.product') }}</strong></label>
	</div>
	<div class="dp-controls dp-fill ticket_product">
		<select name="newticket[ticket][product_id]">
			{% for cat in app.getDataRepository('Product').getRootNodes() %}
				{{ formmacro.select_options_hierarchy(cat, newticket.ticket.product_id) }}
			{% endfor %}
		</select>
		<div class="dp-help-inline dp-error-explain">
			{{ phrase('user.tickets.please_choose_product') }}
		</div>
	</div>
</div>
