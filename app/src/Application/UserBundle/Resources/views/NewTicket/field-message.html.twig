<div class="dp-form-row {% if error_fields['ticket.message'] %}dp-error{% endif %} dp-form-row-ticket_message">
	<div class="dp-form-label">
		<label>{{ phrase('user.tickets.lbl_what_is_your_question') }}</label>
	</div>
	<div class="dp-form-input">
		{{ form_widget(form.ticket.message, {
			'attr': {
				'class': 'dp-message',
				'data-field-validators': 'DeskPRO.Form.LengthValidator',
				'data-min-len': 10,
				'placeholder': 'Message',
				'class': addclass
			}
		}) }}
		<div class="dp-error-explain">
			{{ phrase('user.tickets.please_enter_at_least') }}
		</div>
	</div>
</div>
