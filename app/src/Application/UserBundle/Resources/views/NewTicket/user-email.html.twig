<div id="dp_newticket_login_row" class="dp-newticket-login dp-newticket-login-email {% if login_error %}open{% endif %}">
	{% if app.user.is_guest %}
		{% if login_error %}
		<div class="alert-message error dp-newticket-login-err">
			{% set phrase_link %}
				<a href="{{ path('user_login_resetpass') }}">{{ phrase('user.tickets.click_here') }}</a>
			{% endset %}
			{{ phrase('user.tickets.invalid_email', {'phrase_link':phrase_link}) }}
		</div>
		{% endif %}

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('user.tickets.label_your_email_star') }}</label> <em class="desc">
				{% set phrase_link %}
					<a href="{{ path('user_login') }}" class="dp-newticket-login-open">{{ phrase('user.tickets.link_login') }}</a>
				{% endset %}
				{{ phrase('user.tickets.login_if_registered', {'link':phrase_link}) }}
				<a href="{{ path('user_login_resetpass') }}">{{ phrase('user.tickets.lost_password_link') }}</a></em>
			</div>
			<div class="dp-form-input">
				<input type="text" id="dp_newticket_email" name="newticket[person][email]" value="" />
			</div>
		</div>

		<div class="dp-form-row dp-newticket-login-pass">
			<div class="dp-form-label">
				<label>{{ phrase('user.tickets.lbl_password') }}</label>
			</div>
			<div class="dp-form-input">
				<input type="password" id="dp_newticket_login_pass" />
				<div class="dp-loading">
					{{ phrase('user.tickets.logging_in') }}
				</div>
				<div class="dp-btn-row">
					{% set phrase_link1 %}
					<button class="btn primary dp-login-in-trigger">{{ phrase('user.tickets.login') }}</button>
					{% endset %}
					{% set phrase_link2 %}
					<a class="dp-newticket-login-open">{{ phrase('user.tickets.close') }}</a>
					{% endset %}
					{{ phrase('user.tickets.login_or_close', {'link1':phrase_link1, 'link2':phrase_link2}) }}
				</div>
			</div>
		</div>
	{% else %}
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('user.tickets.lbl_your_email') }}</label></em>
			</div>
			<div class="dp-form-input">
				{{ app.user.primary_email_address }}
			</div>
		</div>
	{% endif %}
</div>
