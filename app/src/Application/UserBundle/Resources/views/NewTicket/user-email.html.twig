<div id="dp_newticket_login_row" class="dp-newticket-login dp-newticket-login-email {% if login_error %}open{% endif %}">
	{% if app.user.is_guest %}
		{% if login_error %}
		<div class="alert-message error dp-newticket-login-err">
			{% set phrase_link %}
				<a href="{{ path('user_login_resetpass') }}">{{ phrase('user.tickets.click_here') }}</a>
			{% endset %}
			{{ phrase('user.tickets.invalid_email', {'phrase_link':phrase_link}) }}
		</div>
		{% endif %}

		<div class="dp-control-group">
			<div class="dp-control-label">
				<label><strong>{{ phrase('user.tickets.label_your_email_star') }}</strong></label> <em class="desc">
				{% set phrase_link %}
					<a href="{{ path('user_login') }}" class="dp-newticket-login-open">{{ phrase('user.general.log_in') }}</a>
				{% endset %}
				{{ phrase('user.general.login_if_registered', {'link':phrase_link}) }}
				<a href="{{ path('user_login_resetpass') }}">{{ phrase('user.tickets.lost_password_link') }}</a></em>
			</div>
			<div class="dp-controls dp-fill">
				<input type="text" id="dp_newticket_email" name="newticket[person][email]" value="" />
			</div>
		</div>

		<div class="dp-control-group dp-newticket-login-pass">
			<div class="dp-control-label">
				<label><strong>{{ phrase('user.general.password') }}</strong></label>
			</div>
			<div class="dp-controls dp-fill">
				<input type="password" id="dp_newticket_login_pass" />
				<div class="dp-loading">
					{{ phrase('user.tickets.logging_in') }}
				</div>
				<div class="dp-btn-row">
					{% set phrase_link1 %}
					<button class="btn primary dp-login-in-trigger">{{ phrase('user.general.log_in') }}</button>
					{% endset %}
					{% set phrase_link2 %}
					<a class="dp-newticket-login-open">{{ phrase('user.general.close_lc') }}</a>
					{% endset %}
					{{ phrase('user.tickets.login_or_close', {'link1':phrase_link1, 'link2':phrase_link2}) }}
				</div>
			</div>
		</div>
	{% else %}
		<div class="dp-control-group">
			<div class="dp-control-label">
				<label><strong>{{ phrase('user.general.your_email_address') }}</strong></label></em>
			</div>
			<div class="dp-controls dp-fill">
				{{ app.user.primary_email_address }}
			</div>
		</div>
	{% endif %}
</div>
