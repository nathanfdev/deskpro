{##
 # The category select box of the new ticket form
 ##}

{% import 'UserBundle:Common:macros-form.html.twig' as formmacro %}
<div class="dp-control-group {% if error_fields['ticket.category_id'] %}dp-error{% endif %}">
	<div class="dp-control-label">
		<label><strong>{{ phrase('user.general.category') }}</strong></label>
	</div>
	<div class="dp-controls dp-fill ticket_category">
		<select name="newticket[ticket][category_id]">
			{% for cat in app.getDataRepository('TicketCategory').getRootNodes() %}
				{{ formmacro.select_options_hierarchy(cat, newticket.ticket.category_id) }}
			{% endfor %}
		</select>
		<div class="dp-help-inline dp-error-explain">
			{{ phrase('user.general.please_choose_a_category') }}{{ phrase('user.tickets.please_choose_product') }}
		</div>
	</div>
</div>