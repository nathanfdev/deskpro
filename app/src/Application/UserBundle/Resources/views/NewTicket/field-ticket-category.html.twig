<div class="dp-form-row  {% if error_fields['ticket.category_id'] %}dp-error{% endif %}">
	<div class="dp-form-label">
		<label>{{ phrase('user.global.category') }}</label>
	</div>
	<div class="dp-form-input with-sub-options">
		<select name="newticket[ticket][category_id]" class="parent-option category_id">
			<option value=""></option>
			{% for id,info in ticket_options.ticket_categories_hierarchy %}
				<option value="{{id}}">{{info.title}}</option>
			{% endfor %}
		</select>
		{% for parent_id, parent_info in ticket_options.ticket_categories_hierarchy %}
			{% if parent_info.children|length %}
			<div class="dp-sub-options sub-options-category_id sub-options-{{parent_id}}" style="display: none">
				<select class="sub_category_id">
					<option value=""></option>
					{% for id,info in parent_info.children %}
						<option value="{{id}}">{{info.title}}</option>
					{% endfor %}
				</select>
			</div>
			{% endif %}
		{% endfor %}
		<div class="dp-error-explain">
			{{ phrase('user.global.please_choose_a_category') }}
		</div>
	</div>
</div>
