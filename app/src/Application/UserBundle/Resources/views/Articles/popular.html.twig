{% extends 'UserBundle::layout.html.twig' %}
{% block breadcrumb %}
	<li><a href="{{ path('user_articles') }}">{{ phrase('user.general.knowledgebase') }}</a></li>
	<li><a href="{{ path('user_articles_popular') }}">{{ phrase('user.articles.popular_section_name') }}</a></li>
{% endblock %}
{% block kb_popular %}
	<div class="with-handler"
		data-element-handler="DeskPRO.User.ElementHandler.MoreLoader"
		data-load-url="{{ path('user_articles_popular', {'page': '00000'})|replace({'00000': '{page}'}) }}"
	>
		<div class="content-list">
			<ul>
				{% include 'UserBundle:Articles:popular-items.html.twig' %}
			</ul>
		</div>
		{% if show_more %}
		<div class="content-more">
			<div class="is-not-loading">
				<button>{{ phrase('user.general.more') }}</button>
			</div>
			<div class="is-loading">
				<center><img src="{{ asset('images/loading-big-circle.gif') }}" alt="" /></center>
			</div>
		</div>
		{% endif %}
	</div>
{% endblock %}
