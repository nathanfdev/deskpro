{% extends 'UserBundle:Articles:layout.html.twig' %}
{% block breadcrumb %}
	<li><a href="{{ path('user_articles') }}">{{ phrase('user.global.knowledgebase') }}</a></li>
	<li><a href="{{ path('user_articles_filter') }}">{{ phrase('user.global.find') }}</a></li>
{% endblock %}
{% block kb_find %}
	<div>
		<div class="content-filters">
			<form action="{{ path('user_articles_filter') }}" method="get" id="kb_find_form">
			<input type="hidden" name="order_by" value="{{ search_options.order_by }}" />
			<table cellspacing="0" cellpadding="0" width="100%">
				<tr>
					<td>{{ phrase('user.global.category') }}:</td>
					<td>{{ phrase('user.global.product') }}:</td>
					<td rowspan="2"><button>{{ phrase('user.global.find') }}</button></td>
				</tr>
				<tr>
					<td>
						<select name="category_id">
							<option value="0">{{ phrase('user.global.all') }}</option>
							{% for cat in kb_cats %}
								<option value="{{cat.id}}" {% if search_options.category_id == cat.id %}selected="selected"{% endif %}>{{ '--'|repeat(cat.depth) }}{{ cat.title }}</option>
							{% endfor %}
						</select>
					</td>
					<td>
						<select name="product_id">
							<option value="0">{{ phrase('user.global.all') }}</option>
							{% for prod in products %}
								<option value="{{prod.id}}" {% if search_options.product_id == prod.id %}selected="selected"{% endif %}>{{ '--'|repeat(prod.depth) }}{{ prod.title }}</option>
							{% endfor %}
						</select>
					</td>
				</tr>
			</table>
			</form>
		</div>
		<div class="content-list">
			<ul>
				{% for article in articles %}
				<li class="article">
					<div class="info-line" style="float:right">
						<ul>
							<li class="comments" title="{{ phrase('user.global.comments') }}"><span>{{ 0 }}</span></li>
							<li class="views" title="{{ phrase('user.articles.views') }}"><span>{{ article.view_count }}</span></li>
						</ul>
					</div>
					<h4><a href="{{ path('user_articles_article', {'slug': article.url_slug}) }}">{{ article.title }}</a></h4>
				</li>
				{% endfor %}
				<li class="pagenav">
					<div class="count">{{ phrase('user.articles.number_of_articles', {'count':num_results}) }}</div>
					<form action="{{ path('user_articles_filter') }}" method="get" id="kb_find_form_btm">
					<input type="hidden" name="category_id" value="{{ search_options.category_id }}" />
					<input type="hidden" name="product_id" value="{{ search_options.product_id }}" />
					<div class="controls">
						<div class="sort-controls">
							{{ phrase('user.articles.sorted_by') }}
							<select name="order_by" onchange="$('#kb_find_form_btm select.page').val(1); $('#kb_find_form_btm').submit();">
								<option value="id.desc" {% if search_options.order_by == 'id.desc' %}selected="selected"{% endif %}>{{ phrase('user.global.date') }}</option>
								<option value="view_count.desc" {% if search_options.order_by == 'view_count.desc' %}selected="selected"{% endif %}>{{ phrase('user.global.popularity') }}</option>
							</select>
						</div>
						{% if pageinfo.last != 1 %}
						<div class="page-controls">
							{% if pageinfo.prev %}
								<a href="{{ path('user_articles_filter', search_options|merge({'page': pageinfo.prev})) }}" class="page-link page-left">{{ phrase('user.articles.previous') }}</a>
							{% endif %}
							{{ phrase('user.global.page') }}<select class="page" name="page" onchange="$('#kb_find_form_btm').submit();">
								{% for i in 1..pageinfo.last %}
									<option value="{{i}}" {% if i == pageinfo.curpage %}selected="selected"{% endif %}>{{i}}</option>
								{% endfor %}
							</select>
							{{ phrase('user.global.of') }} {{ pageinfo.last }} <button class="dp-button x-small">{{ phrase('user.articles.go') }}</button>
							{% if pageinfo.next %}
								<a href="{{ path('user_articles_filter', search_options|merge({'page': pageinfo.next})) }}" class="page-link page-right">{{ phrase('user.global.next') }}</a>
							{% endif %}
						</div>
						{% endif %}
					</div>
					</form>
					<br class="clear" />
				</li>
			</ul>
		</div>
	</div>
{% endblock %}
