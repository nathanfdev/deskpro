{% set this_section = 'articles' %}
{% extends 'UserBundle::layout.html.twig' %}
{% block breadcrumb %}
	<li><a href="{{ path('user_articles') }}">{{ phrase('user.general.knowledgebase') }}</a>{% if category %}<span class="dp-divider">&rarr;</span>{% endif %}</li>
	{% if category %}
		{% for cat in category_path %}
			<li><a href="{{ path('user_articles', {'slug': cat.url_slug}) }}">{{cat.title}}</a><span class="dp-divider">&rarr;</span></li>
		{% endfor %}
		<li><a href="{{ path('user_articles', {'slug': category.url_slug}) }}">{{category.title}}</a></li>
	{% endif %}
{% endblock %}
{% block page_title %}
	{{ phrase('user.general.knowledgebase') }}
	{% if category %}
		/
		{% for cat in category_path %}
			{{cat.title}} /
		{% endfor %}
		{{category.title}}
	{% endif %}
{% endblock %}
{% block content %}

{% if category_children|length or not articles|length %}
	<section class="dp-portal-section">
		<header>
			{% if category %}
				<h1>{{ phrase('user.articles.there_are_x_subcats', {'count': category_children|length}) }}</h1>
			{% else %}
				<h1>{{ phrase('user.general.knowledgebase') }}</h1>
			{% endif %}
		</header>
		<div class="dp-content-block dp-news-block">
			<div class="dp-content-wrapper">
				<ul class="dp-content-list">
					{% include 'UserBundle:Articles:browse-cat-list.html.twig' with {'categories': category_children, 'category_articles': category_children_articles} %}
				</ul>
			</div>
		</div>
	</section>
{% endif %}

{% if articles %}
	<section class="dp-portal-section">
		{% if category %}
			<header>
				{% if category %}
					<h1>{{ phrase('user.articles.there_are_x_articles', {'count': articles|length}) }}</h1>
				{% endif %}
			</header>
		{% endif %}
		<div class="dp-content-block dp-news-block">
			<div class="dp-content-wrapper">
				<ul class="dp-content-list">
					{% for article in articles %}
					<li>
						<h4><a href="{{ path('user_articles_article', {'slug': article.url_slug}) }}">{{ article.title }}</a></h4>
						<div class="dp-meta">
							{{ phrase('user.articles.meta_author', {'author': article.person.display_name}) }}
							&middot;
							{{ phrase('user.general.count_comments', {'count': comment_counts[article.id]|default(0)}) }}
						</div>
					</li>
					{% endfor %}
				</ul>
			</div>
		</div>
	</section>
{% endif %}

{% endblock %}
