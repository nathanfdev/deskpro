{% extends 'UserBundle:Articles:layout.html.twig' %}
{% block breadcrumb %}
	<li><a href="{{ path('user_articles') }}">{{ phrase('user.knowledgebase') }}</a></li>
	{% for cat in category_path %}
		<li><a href="{{ path('user_articles', {'slug': cat.url_slug}) }}">{{cat.title}}</a></li>
	{% endfor %}
	<li><a href="{{ path('user_articles', {'slug': category.url_slug}) }}">{{category.title}}</a></li>
{% endblock %}
{% block page_title %}
	Knowledgebase /
	{% for cat in category_path %}
		{{cat.title}} /
	{% endfor %}
	{{category.title}}
{% endblock %}
{% block kb_browse %}

{% if category_children|length or not articles|length %}
	<div class="dp-content-block dp-kb-page">
		<div class="dp-box">
			<div class="dp-box-header">
				{% if category %}
					<h1>{{ phrase('user.articles.there_are_x_subcats', {'count': category_children|length}) }}</h1>
				{% else %}
					<h1>{{ phrase('user.knowledgebase') }}</h1>
				{% endif %}
			</div>

			<div class="dp-box-content-wrapper">
				<div class="dp-box-content">
					{% include 'UserBundle:Articles:browse-cat-list.html.twig' with {'categories': category_children, 'category_articles': category_children_articles} %}
				</div>
				<br class="dp-clear" style="clear: left;" />
			</div>
		</div>
	</div>
{% endif %}

{% if articles %}
<div class="dp-content-block dp-kb-page">
	<div class="dp-box">
		<div class="dp-box-header">
			{% if category %}
				<h1>{{ phrase('user.articles.there_are_x_articles', {'count': articles|length}) }}</h1>
			{% endif %}
		</div>

		<div class="dp-box-content-wrapper">
			<div class="dp-box-content">
				<ul class="dp-browse-list-full sep">
					{% for article in articles %}
					<li>
						<h4><a href="{{ path('user_articles_article', {'slug': article.url_slug}) }}">{{ article.title }}</a></h4>
						<div class="dp-meta">
							{{ phrase('user.articles.meta_author', {'author': article.person.display_name}) }}
							&middot;
							{{ phrase('user.count_comments', {'count': comment_counts[article.id]|default(0)}) }}
						</div>
					</li>
					{% endfor %}
				</ul>
			</div>
		</div>
	</div>
</div>
{% endif %}

{% endblock %}
