{% extends 'UserBundle::layout.html.twig' %}
{% block head %}
	<meta property="og:url" content="{{ path('user_articles_article', {'slug': article.id}) }}" />
	<meta property="og:title" content="{{article.title}}" />
	<meta property="og:type" content="article" />
{% endblock %}
{% block breadcrumb %}
	<li><a href="{{ path('user_articles') }}">{{ phrase('user.articles.section_name') }}</a></li>
	{% for categories in all_categories %}
		{% if loop.index0 == 0 %}
			{% for c in categories %}
				<li><a href="{{ path('user_articles', {'slug': c.url_slug}) }}">{{c.title}}</a></li>
			{% endfor %}
		{% endif %}
	{% endfor %}
	<li><a href="{{ path('user_articles_article', {'slug': article.url_slug}) }}">{{article.title}}</a></li>
{% endblock %}
{% block page_title %}
	{{ article.title }}
	-
	Knowledgebase
	{% for categories in all_categories %}
		{% if loop.index0 == 0 %}
			{% for c in categories %}
				/ {{c.title}}
			{% endfor %}
		{% endif %}
	{% endfor %}
{% endblock %}
{% block content %}
<div class="dp-article-page">
	<div class="dp-content-block">
		<div class="dp-box">
			<div class="dp-box-header">
				<h1>{{ article.title }}</h1>
			</div>
			<div class="dp-box-content-meta">
				<div class="by-line">
					<img src="{{ article.person.getPictureUrl(40) }}" />
					Created by {{ article.person.display_name }} on {{ article.date_created|date('M d Y') }}
					<br class="dp-clear" style="clear:left" />
				</div>
			</div>
			<div class="dp-box-content-wrapper">
				<div class="dp-box-content">
					<div class="dp-post">{{ article.content_html|raw }}</div>

					{% include 'UserBundle:Common:labels-box.html.twig' with {'labels': article.labels} %}

					{% include 'UserBundle:Common:rating-bar.html.twig' with {'content_object': article} %}

					{% if app.getSetting('core.facebook_like') %}
						{% include 'UserBundle:Common:facebook-like.html.twig' with {'page_permalink': article.permalink} %}
					{% endif %}

					{% include 'UserBundle:Common:comments-box.html.twig' with {
						'comments': comments,
						'form_action': path('user_articles_newcomment', {'article_id': article.id}),
						'check_perm': 'articles.comment'
					} %}
				</div>
			</div>
		</div>
	</div>
</div>
{% endblock %}
