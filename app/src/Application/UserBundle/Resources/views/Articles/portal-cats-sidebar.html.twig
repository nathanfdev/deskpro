<section class="dp-sidebar-block">
	<header>
		<h3>
			{% if title %}{{ title }}{% else %}Knowledgebase{% endif %}
		</h3>
	</header>
	<article class="dp-written">
		<p class="dp-summary">
			Browse through our {{ counts['0_total']|default(0) }} help articles
		</p>
		<ul class="dp-cat-list">
			{% for cat in categories %}
				<li>
					<div class="dp-fadeaway-container">
						<i class="dp-icon-folder-close"></i>
						<a class="dp-fadetitle" href="{{ path('user_articles', {slug: cat.url_slug}) }}">{{ cat.title }}</a>
						<div class="dp-fadeaway"></div>
						<span class="dp-badge dp-small">{{ counts[cat.id ~ '_total']|default(0) }}</span>
					</div>
				</li>
			{% endfor %}
		</ul>
	</article>
</section>