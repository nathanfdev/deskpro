{% extends 'UserBundle:Widget:layout-content-overlay.html.twig' %}
{% block content %}
	<div class="dp-content-header">
		<h3 class="title"><a href="{{ article.getLink() }}" class="full-page">{{ article.title }}</a></h3>
	</div>
	<div class="dp-content-body">
		<div class="dp-post">{{ article.content_html|raw }}</div>
		{% if comments|length %}
			<div class="dp-box-comments dp-mini">
				<div class="dp-comments-placeholder dp-toggle-sel" data-toggle-sel=".dp-box-comments-content">
					<span>{{ phrase('global.1_commentcount_comments', {'count': comments|length}) }}</span>
				</div>
				<div class="dp-box-comments-content" style="display: none">
					<ul>
						{% for comment in comments %}
							<li>
								<cite>{{ comment.user_name|default(phrase('global.anonymous')) }}:</cite>
								<div class="post">
									{{ comment.content_html|raw }}
								</div>
							</li>
						{% endfor %}
					</ul>
				</div>
			</div>
		{% endif %}
	</div>
{% endblock %}
