{% for article in articles %}
	<li class="article popular {% if show_more and loop.last %}has-more{% endif %}">
		<div class="info-line" style="float:right">
			<ul>
				<li class="comments" title="{{ phrase('user.comments') }}"><span>{{ 0 }}</span></li>
				<li class="views" title="{{ phrase('user.articles.views') }}"><span>{{ article.view_count }}</span></li>
			</ul>
		</div>
		<h4><a href="{{ path('user_articles_article', {'slug': article.url_slug}) }}">{{ article.title }}</a></h4>
	</li>
{% else %}
	{% if page == 1 %}
		<li>{{ phrase('user.articles.no_popular') }}</li>
	{% else %}
		<li>{{ phrase('user.there_are_no_more_results') }}
	{% endif %}
{% endfor %}
