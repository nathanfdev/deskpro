<ul class="dp-browse-list">
	{% for cat in categories %}
		{% if loop.index0 != 0 and loop.index0 % 2 == 0 %}</ul><ul class="dp-browse-list">{% endif %}
		<li>
			<h3 class="dp-fadeaway-container"><a class="dp-fadeaway-title" href="{{ path('user_articles', {'slug': cat.url_slug}) }}">{{ cat.title }}</a><div class="dp-fadeaway"></div></h3>
			<ul>
				{% for article in category_articles[cat.id] %}
					<li>
						<div class="dp-faded-container">
							<a href="{{ path('user_articles_article', {'slug': article.url_slug}) }}">{{ article.title }}</a>
							<div class="dp-bound-faded"></div>
						</div>
					</li>
				{% endfor %}
			</ul>
			<br class="dp-br-clear" />
            {% set this_cat_counts = category_counts[cat.id ~ '_total'] %}
            {% if this_cat_counts %}
				<div class="dp-view-more">
					<a href="{{ path('user_articles', {'slug': cat.url_slug}) }}">
						{{ phrase('user.articles.view_all_x_articles', {'count': '<span class="dp-badge dp-badge-info dp-small">' ~ this_cat_counts ~ '</span>'}) }} &rarr;
					</a>
				</div>
            {% endif %}
		</li>
	{% endfor %}
</ul>
