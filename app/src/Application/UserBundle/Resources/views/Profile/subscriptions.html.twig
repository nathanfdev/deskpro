{% extends 'UserBundle::layout.html.twig' %}
{% block head %}
	<script src="{{ asset('javascripts/DeskPRO/User/ElementHandler/SubscriptionManager.js') }}"></script>
{% endblock %}
{% block breadcrumb %}
	<li><a href="{{ path('user_profile') }}">{{ phrase('user.profile') }}</a></li>
	<li><a href="{{ path('user_profile_subs') }}">{{ phrase('user.profile.subscriptions') }}</a></li>
{% endblock %}
{% block content %}
<div class="content-item with-handler" data-element-handler="DeskPRO.User.ElementHandler.SubscriptionManager">
	<div class="heading">
		<h2>{{ phrase('user.profile.subscriptions') }}</h2>
	</div>
	{% if subscriptions.article %}
	<div class="content-list subscription-list">
		<h3>{{ phrase('user.profile.article_subscriptions') }}</h3>
		<ul>
			{% for sub in subscriptions.article %}
				{% set article = sub.article %}
				<li class="article">
					<a href="{{ path('user_profile_subdel', {'type': 'article', 'id': article.id, 'return_sub': 1}) }}" class="sub-delete">x</a>
					<h4><a href="{{ path('user_articles_article', {'slug': article.url_slug}) }}">{{ article.title }}</a></h4>
				</li>
			{% endfor %}
		</ul>
	</div>
	{% endif %}
	{% if subscriptions.news %}
	<div class="content-list subscription-list">
		<h3>{{ phrase('user.profile.news_subscriptions') }}</h3>
		<ul>
			{% for sub in subscriptions.news %}
				{% set news = sub.news %}
				<li class="feedback-item">
					<a href="{{ path('user_profile_subdel', {'type': 'news', 'id': news.id, 'return_sub': 1}) }}" class="sub-delete">x</a>
					<h4 style="margin-bottom: 0"><a href="{{ path('user_news_view', {'slug': news.url_slug}) }}">{{ news.title }}</a></h4>
				</li>
			{% endfor %}
		</ul>
	</div>
	{% endif %}
	{% if subscriptions.feedback %}
	<div class="content-list subscription-list">
		<h3>{{ phrase('user.profile.feedback_subscriptions') }}</h3>
		<ul>
			{% for sub in subscriptions.feedback %}
				{% set feedback = sub.feedback %}
				<li class="feedback-item">
					<a href="{{ path('user_profile_subdel', {'type': 'feedback', 'id': feedback.id, 'return_sub': 1}) }}" class="sub-delete">x</a>
					<div class="feedback-votes" title="{{ phrase('user.profile.votes_in_favor_of_this_feedback') }}">
						<div class="votes"><span>{{ rand(1,80) }}</span></div>
					</div>
					<h4><a href="{{ path('user_feedback_view', {'slug': feedback.url_slug}) }}">{{feedback.title}}</a></h4>
				</li>
			{% endfor %}
		</ul>
	</div>
	{% endif %}
	{% if subscriptions.download %}
	<div class="content-list subscription-list">
		<h3>{{ phrase('user.profile.download_subscriptions') }}</h3>
		<ul>
			{% for sub in subscriptions.download %}
				{% set download = sub.download %}
				<li class="feedback-item">
					<a href="{{ path('user_profile_subdel', {'type': 'download', 'id': download.id, 'return_sub': 1}) }}" class="sub-delete">x</a>
					<h4><a href="{{ path('user_downloads_file', {'slug': download.url_slug}) }}"><span class="icon-file icon-{{ download.blob.extension }}">{{ download.title }}</span></a></h4>
				</li>
			{% endfor %}
		</ul>
	</div>
	{% endif %}
</div>
{% endblock %}