{% extends 'UserBundle::layout.html.twig' %}
{% block breadcrumb %}
	<li><a href="{{ path('user_profile') }}">Profile</a></li>
{% endblock %}
{% block page_title %}Your Profile{% endblock %}
{% block content %}
<div class="dp-content-block dp-profile-page">
	<div class="dp-box">
		<div class="dp-box-header">
			<h1>Profile</h1>
		</div>
		<div class="dp-box-content-wrapper">
			<div class="dp-box-content dp-form">
				<div class="dp-form-row">
					<div class="dp-form-label">
						<label>First Name</label>
					</div>
					<div class="dp-form-input">
						{{ form_widget(form.first_name) }}
					</div>
				</div>
				<div class="dp-form-row">
					<div class="dp-form-label">
						<label>Last Name</label>
					</div>
					<div class="dp-form-input">
						{{ form_widget(form.last_name) }}
					</div>
				</div>
				<div class="dp-form-row">
					<div class="dp-form-label">
						<label>Timezone</label>
					</div>
					<div class="dp-form-input">
						{{ form_widget(form.timezone) }}
					</div>
				</div>

				<button class="btn primary">Save</button>
			</div>
		</div>
	</div>
</div>

<div class="dp-content-block dp-profile-page">
	<div class="dp-box">
		<div class="dp-box-header">
			<h1>Email Addresses</h1>
		</div>
		<div class="dp-box-content-wrapper">
			<div class="dp-box-content">
				{% if app.session.hasFlash('resent_validation_email') %}
					<div class="alert-message info">
						Validation email was resent to {{ app.session.flash('resent_validation_email') }}
					</div>
				{% endif %}
				{% if app.session.hasFlash('removed_email') %}
					<div class="alert-message info">
						Email {{ app.session.flash('removed_email') }} was removed
					</div>
				{% endif %}
				{% if app.session.hasFlash('new_email') %}
					<div class="alert-message info">
						Email {{ app.session.flash('removed_email') }} was added
					</div>
				{% endif %}
				{% if app.session.hasFlash('new_email_validating') %}
					<div class="alert-message info">
						Email {{ app.session.flash('removed_email') }} was added. To start using this email address, you must validate it
						by clicking on the link we just sent you.
					</div>
				{% endif %}

				<ul class="dp-emails-list">
					{% for email in app.user.emails %}
					<li>
						<div class="dp-controls">
							{% if email.id == app.user.primary_email.id %}
								Primary address
							{% else %}
								<a href="{{ path('user_profile_emails_setdefault', {'email_id': email.id}) }}">Set as primary address</a>
								&bull;
								<a class="remove" title="Remove email address" href="{{ path('user_profile_emails_remove', {'email_id': email.id}) }}">Delete</a>
							{% endif %}
						</div>
						{{ email.email }}
					</li>
					{% endfor %}
					{% for email in validating_emails %}
						<li class="validating">
							<div class="dp-controls">
								<a href="{{ path('user_profile_emails_validate_sendlink', {'email_id': email.id}) }}">Resend Validation Email</a>
								&bull;
								<a class="remove" title="Remove email address" href="{{ path('user_profile_emails_validate_remove', {'email_id': email.id}) }}">Delete</a>
							</div>
							{{ email.email }} <em>(awaiting validation)</em>
						</li>
					{% endfor %}
					<li class="dp-new-email">
						<form action="{{ path('user_profile_emails_new') }}" method="post">
							<label>Add an email address to your account:</label><br />
							<input type="text" name="new_email" value="" size="30" /> <button class="btn small"></button>
						</form>
					</li>
				</ul>
			</div>
		</div>
	</div>
</div>

<div class="dp-content-block dp-profile-page">
	<div class="dp-box">
		<div class="dp-box-header">
			<h1>Change Password</h1>
		</div>
		<div class="dp-box-content-wrapper">
			<form action="{{ path('user_profile_changepassword') }}" method="post">
				<div class="dp-box-content dp-form">
					<div class="dp-form-row">
						<div class="dp-form-label">
							<label>Current Password</label>
						</div>
						<div class="dp-form-input">
							<input type="password" name="current_password" value="" />
						</div>
					</div>
					<div class="dp-form-row">
						<div class="dp-form-label">
							<label>New Password</label>
						</div>
						<div class="dp-form-input">
							<input type="password" name="password" value="" />
						</div>
					</div>
					<div class="dp-form-row">
						<div class="dp-form-label">
							<label>Repeat Password</label>
						</div>
						<div class="dp-form-input">
							<input type="password" name="password2" value="" />
						</div>
					</div>

					<button class="btn primary">Change Password</button>
				</div>
			</form>
		</div>
	</div>
</div>
{% endblock %}
