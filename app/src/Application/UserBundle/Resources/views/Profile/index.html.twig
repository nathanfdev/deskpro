{% extends 'UserBundle::layout.html.twig' %}
{% block breadcrumb %}
	<li><a href="{{ path('user_profile') }}">{{ phrase('user.profile.profile') }}</a></li>
{% endblock %}
{% block page_title %}Your Profile{% endblock %}
{% block content %}
<div class="dp-content-block dp-profile-page">
	<div class="dp-box">
		<div class="dp-box-header">
			<h1>{{ phrase('user.profile.profile') }}</h1>
		</div>
		<div class="dp-box-content-wrapper">
			<div class="dp-box-content dp-form">
				<div class="dp-form-row">
					<div class="dp-form-label">
						<label>{{ phrase('user.profile.first_name') }}</label>
					</div>
					<div class="dp-form-input">
						{{ form_widget(form.first_name) }}
					</div>
				</div>
				<div class="dp-form-row">
					<div class="dp-form-label">
						<label>{{ phrase('user.profile.last_name') }}</label>
					</div>
					<div class="dp-form-input">
						{{ form_widget(form.last_name) }}
					</div>
				</div>
				<div class="dp-form-row">
					<div class="dp-form-label">
						<label>{{ phrase('user.profile.timezone') }}</label>
					</div>
					<div class="dp-form-input">
						{{ form_widget(form.timezone) }}
					</div>
				</div>

				<button class="btn primary">{{ phrase('user.profile.btn_save') }}</button>
			</div>
		</div>
	</div>
</div>

<div class="dp-content-block dp-profile-page">
	<div class="dp-box">
		<div class="dp-box-header">
			<h1>{{ phrase('user.profile.email_addresses') }}</h1>
		</div>
		<div class="dp-box-content-wrapper">
			<div class="dp-box-content">
				{% if app.session.hasFlash('resent_validation_email') %}
					<div class="alert-message info">
						{{ phrase('user.profile.validation_resent_to', {'email':app.session.flash('resent_validation_email')}) }}
					</div>
				{% endif %}
				{% if app.session.hasFlash('removed_email') %}
					<div class="alert-message info">
						{{ phrase('user.profile.email_was_removed', {'email':app.session.flash('removed_email')}) }}
					</div>
				{% endif %}
				{% if app.session.hasFlash('new_email') %}
					<div class="alert-message info">
						{{ phrase('user.profile.email_was_added', {'email':app.session.flash('removed_email')}) }}
					</div>
				{% endif %}
				{% if app.session.hasFlash('new_email_validating') %}
					<div class="alert-message info">
						{{ phrase('user.profile.email_was_added_validate_it', {'email':app.session.flash('removed_email')}) }}
					</div>
				{% endif %}

				<ul class="dp-emails-list">
					{% for email in app.user.emails %}
					<li>
						<div class="dp-controls">
							{% if email.id == app.user.primary_email.id %}
								{{ phrase('user.profile.primary_address') }}
							{% else %}
								<a href="{{ path('user_profile_emails_setdefault', {'email_id': email.id}) }}">{{ phrase('user.profile.set_as_primary_address') }}</a>
								&bull;
								<a class="remove" title="Remove email address" href="{{ path('user_profile_emails_remove', {'email_id': email.id}) }}">{{ phrase('user.profile.delete') }}</a>
							{% endif %}
						</div>
						{{ email.email }}
					</li>
					{% endfor %}
					{% for email in validating_emails %}
						<li class="validating">
							<div class="dp-controls">
								<a href="{{ path('user_profile_emails_validate_sendlink', {'email_id': email.id}) }}">{{ phrase('user.profile.resend_validation_email') }}</a>
								&bull;
								<a class="remove" title="Remove email address" href="{{ path('user_profile_emails_validate_remove', {'email_id': email.id}) }}">{{ phrase('user.profile.delete') }}</a>
							</div>
							{{ email.email }} <em>{{ phrase('user.profile.awaiting_validation') }}</em>
						</li>
					{% endfor %}
					<li class="dp-new-email">
						<form action="{{ path('user_profile_emails_new') }}" method="post">
							<label>{{ phrase('user.profile.add_an_email_address_to_account') }}:</label><br />
							<input type="text" name="new_email" value="" size="30" /> <button class="btn small"></button>
						</form>
					</li>
				</ul>
			</div>
		</div>
	</div>
</div>

<div class="dp-content-block dp-profile-page">
	<div class="dp-box">
		<div class="dp-box-header">
			<h1>{{ phrase('user.profile.change_password') }}</h1>
		</div>
		<div class="dp-box-content-wrapper">
			<form action="{{ path('user_profile_changepassword') }}" method="post">
				<div class="dp-box-content dp-form">
					<div class="dp-form-row">
						<div class="dp-form-label">
							<label>{{ phrase('user.profile.current_password') }}</label>
						</div>
						<div class="dp-form-input">
							<input type="password" name="current_password" value="" />
						</div>
					</div>
					<div class="dp-form-row">
						<div class="dp-form-label">
							<label>{{ phrase('user.profile.new_password') }}</label>
						</div>
						<div class="dp-form-input">
							<input type="password" name="password" value="" />
						</div>
					</div>
					<div class="dp-form-row">
						<div class="dp-form-label">
							<label>{{ phrase('user.profile.repeat_password') }}</label>
						</div>
						<div class="dp-form-input">
							<input type="password" name="password2" value="" />
						</div>
					</div>

					<button class="btn primary">{{ phrase('user.profile.change_password') }}</button>
				</div>
			</form>
		</div>
	</div>
</div>
{% endblock %}
