{% extends 'UserBundle::layout.html.twig' %}
{% block content %}

<section class="dp-portal-section">
	<div class="dp-content-block dp-profile-block">
		<p>
			{{ phrase('user.general.you_have_validated') }}
			{% if ticket_ids|length %}{{ phrase('user.general.agents_working') }}{% endif %}
		</p>
		{% if not app.user.id %}
			<p>
				<a class="dp-btn dp-btn-primary" href="{{ path('user_login') }}">{{ phrase('user.general.log_in') }}</a>
			</p>
		{% endif %}
	</div>
</section>
{% endblock %}
