{% extends 'UserBundle::layout.html.twig' %}
{% block content %}
	<div class="dp-content-block dp-profile-page">
		<div class="dp-box">
			<div class="dp-box-header">
				<h3>{{ phrase('user.chat.transcript_title') }}</h3>
			</div>
			<div class="dp-box-content-wrapper">
				{{ phrase('user.chat.transcript_explain') }}<br /><br />

				<form action="{{ path('user_chat_chatended', {'session_code': session.session_code}) }}" method="post">
				<input type="hidden" name="process" value="1" />
				<input type="hidden" name="conversation_id" value="{{ convo.id }}" />
				<table cellspacing="0" cellpadding="8" border="0">
					<tr>
						<td>{{ phrase('user.general.your_name') }}: </td>
						<td><input type="text" name="name" value="" /></td>
					</tr>
					<tr>
						<td>{{ phrase('user.general.your_email_address') }}: </td>
						<td><input type="text" name="email" value="" /></td>
					</tr>
					<tr>
						<td colspan="2" align="right">
							<input type="submit" value="{{ phrase('user.chat.transcript_btn') }}" />
						</td>
					</tr>
				</table>
				</form>
			</div>
		</div>
	</div>
{% endblock %}
