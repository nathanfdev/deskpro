{% set page_noindex = true %}
{% extends 'UserBundle::layout.html.twig' %}
{% block content %}

<div class="dp-error-page">
	<div class="dp-content-block">
		<div class="dp-box">
			<div class="dp-box-header">
				{% if error_title %}
					<h1>{{ error_title }}</h1>
				{% else %}
					<h1>{{ phrase('user.not_found') }}</h1>
				{% endif %}
			</div>

			<div class="dp-box-content-wrapper">
				<div class="dp-box-content">
					{% if error_message %}
						{{ error_message }}
					{% else %}
						{{ phrase('user.error_not_found') }}
					{% endif %}
				</div>
			</div>
		</div>
	</div>
</div>

{% endblock %}
