{% set page_noindex = true %}
{% extends 'UserBundle::layout.html.twig' %}
{% block content %}

<div class="dp-error-page">
	<div class="dp-content-block">
		<div class="dp-box">
			<div class="dp-box-header">
				{% if error_title %}
					<h1>{{ error_title }}</h1>
				{% else %}
					<h1>{{ phrase('user.general.error_not_allowed_title') }}</h1>
				{% endif %}
			</div>

			<div class="dp-box-content-wrapper">
				<div class="dp-box-content">
					{% if error_message %}
						{{ error_message }}
					{% else %}
						{{ phrase('user.general.error_not_allowed') }}
					{% endif %}

					{% if app.user.is_guest %}
						<p>
							{{ phrase('user.general.error_not_allowed_help', {'login_url': path('user_login')}) }}
						</p>
					{% endif %}
				</div>
			</div>
		</div>
	</div>
</div>

{% endblock %}
