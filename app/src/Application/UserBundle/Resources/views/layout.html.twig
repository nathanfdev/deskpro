{% set breadcrumb %}{% block breadcrumb %}{% endblock %}{% endset %}
{% if not breadcrumb|trim|length %}{% set breadcrumb = false %}{% endif %}
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
<head>
	{% if page_noindex %}<meta name="robots" content="noindex,nofollow" />{% endif %}
	{% if app.getSetting('core.favicon_blob_id') %}
		<link rel="shortcut icon" id="favicon" href="{{ path('favicon', {}, true) }}" />
	{% else %}
		<link rel="shortcut icon" id="favicon" href="{{ asset('images/favicon.ico') }}" />
	{% endif %}
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
	<title>{% block page_title %}{{ app.getSetting('core.deskpro_name') }}{% endblock %}</title>

	{% include 'UserBundle:Common:resources.html.twig' %}

	<meta property="og:site_name" content="{{ app.getSetting('core.site_name')|default(app.getSetting('core.core.helpdesk_name')) }}" />
	{% if app.getSetting('core.facebook_admins') %}<meta property="fb:admins" content="{{ app.getSetting('core.facebook_admins') }}" />{% endif %}

	{{ portal_css(['sidebar', 'pagetop']) }}
	{{ portal_js(['sidebar', 'pagetop']) }}

	{% block head %}{% endblock %}

	{% if admin_portal_controls %}
		<script type="text/javascript">var IS_ADMIN_CONTROLS = true;</script>
		{{ dp_asset_html('agent_vendors') }}
		{{ dp_asset_html('agent_common') }}
		{{ dp_asset_html('user_portaladmin') }}
		{{ dp_asset_html('user_portaladmin_css') }}
	{% endif %}

	{% include 'UserBundle::custom-headinclude.html.twig' %}
</head>
<body>
<script type="text/javascript">document.body.className += " with-js";</script>

{% if admin_portal_controls %}
	<div id="dp_custom_head_wrap" class="dp-portal-block" style="display: none">
		<div id="dp_custom_head" class="dp-portal-block-content"></div>
	</div>
	<div id="dp_custom_head_placeholder" class="dp-portal-placeholder dp-portal-placeholder-head {% if custom_templates['UserBundle::custom-headinclude.html.twig'] %}dp-portal-placeholder-highlight{% endif %}" data-portal-block="head_include" data-portal-for="#dp_custom_head" data-mode="head">
		<em>{{ phrase('admin.designer.edit_page_head') }}</em>
	</div>
	<div id="dp_custom_header_wrap" class="dp-portal-block" {% if not custom_templates['UserBundle::custom-header.html.twig'] %}style="display: none"{% endif %}>
		<div id="dp_custom_header" class="dp-portal-block-content">
			{% include 'UserBundle::custom-header.html.twig' %}
		</div>
	</div>
	<div id="dp_custom_header_placeholder" class="dp-portal-placeholder dp-portal-placeholder-header" data-portal-block="header" data-portal-for="#dp_custom_header" {% if custom_templates['UserBundle::custom-header.html.twig'] %}style="display: none"{% endif %}>
		<em>{{ phrase('admin.designer.edit_header_section') }}</em>
	</div>
{% else %}
	{% include 'UserBundle::custom-header.html.twig' %}
{% endif %}

<div id="deskpro" class="deskpro {% block body_class %}{% endblock %}{% if breadcrumb %}dp-with-breadcrumb{% endif %}">

{% if admin_portal_controls %}
<div id="dp_header" {% if app.logoblob %}class="dp-with-logo"{% endif %}>
	<a href="{{ path('user') }}"><img class="logo" {% if app.logoblob %}src="{{ app.logoblob.getDownloadUrl() }}"{% endif %} /></a>

	<h1><a href="{{ path('user') }}">{{ app.getSetting('core.deskpro_name') }}</a></h1>
	<h2 {% if not app.getSetting('core.deskpro_tagline') %}style="display: none"{% endif %}>{{ app.getSetting('core.deskpro_tagline') }}</h2>
	{% if admin_portal_controls %}
	<div id="dp_header_portal_off">
		{{ phrase('admin.designer.reenable_simple_header') }}
	</div>
	{% endif %}
</div>
{% else %}
	<div id="dp_header" {% if app.logoblob %}class="dp-with-logo"{% endif %}>
		{% if app.logoblob %}
		<a href="{{ path('user') }}"><img class="logo" src="{{ app.logoblob.getDownloadUrl() }}" /></a>
		{% else %}
			<h1><a href="{{ path('user') }}">{{ app.getSetting('core.deskpro_name') }}</a></h1>
			{% if app.getSetting('core.deskpro_tagline') %}
				<h2>{{ app.getSetting('core.deskpro_tagline') }}</h2>
			{% endif %}
		{% endif %}
	</div>
{% endif %}

<div id="dp_search_assist" style="display: none;">
	<div class="results"></div>
	<div class="foot">
		<h4>{{ phrase('user.general.is_search_relevant') }}</h4>
		<ul>
			<li class="ticket"><a href="{{ path('user_tickets_new') }}">{{ phrase('user.general.create_ticket') }}</a></li>
			<li class="feedback"><a href="{{ path('user_feedback_newfeedback') }}">{{ phrase('user.general.create_feedback') }}</a></li>
			<li class="chat dp-chat-trigger no-omni-trigger"><a href="#">{{ phrase('user.general.btn_create_chat') }}</a></li>
		</ul>
		<br class="dp-clear" style="clear:left" />
	</div>
</div>

{% if app.user.is_guest %}
<div id="dp_login_box_title"><a href="{{ path('user_login') }}">{{ phrase('user.general.log_in') }}</a></div>
<div id="dp_login_box" class="with-handler" data-element-handler="DeskPRO.User.ElementHandler.LoginBox">
	<form action="{{ path('user_login_authenticate_local') }}" class="form login" method="post">
		<div class="dp-login-box-inner">
			<dl>
				<dt>{{ phrase('user.general.email_address') }}</dt>
				<dd><input type="text" value="" name="email" id="dp_login_email" size="40" tabindex="1" /></dd>
			</dl>
			<div class="dp-login-section">
				<dl>
					<dt>{{ phrase('user.general.password') }} <em class="forgot"><a href="{{ path('user_login_resetpass') }}">{{ phrase('user.general.log_in') }}</a></em></dt>
					<dd><input type="password" value="" name="password" id="dp_login_password" size="40" tabindex="2" /></dd>
				</dl>
				<div style="float:right">
					{% for usersource in app.usersourceManager.getWithCapability('tpl_login_pull_btn') %}
						{{ render_usersource(usersource, 'login_pull_btn') }}
					{% endfor %}
				</div>
				<input class="btn" type="submit" value="{{ phrase('user.general.log_in') }}" />
			</div>
			<div class="dp-reset-section" style="display: none">
				<div class="dp-reset-desc">
					{{ phrase('user.general.lost_password_explain') }}
					<br />
					<div class="dp-btn-row">
						<div class="not-loading">
							<button class="btn small dp-do-send">{{ phrase('user.general.lost_password_send_btn') }}</button>
							<br /><a class="back">{{ phrase('user.general.cancel') }}</a>
						</div>
						<div class="is-loading">
							{{ phrase('user.general.please_wait') }}
						</div>
					</div>
				</div>
				<div class="dp-reset-sent" style="display: none">
					{{ phrase('user.general.lost_password_sent') }}
					<center><br /><br /><a class="back">{{ phrase('user.general.lost_password_back_btn') }}</a></center>
				</div>
			</div>
		</div>
	</form>
</div>
{% endif %}

{% set sidebar %}{% block sidebar %}{{ portal_section('sidebar') }}{% endblock %}{% endset %}
<div id="dp_page" {% if not sidebar|trim|length %}class="no-sidebar"{% endif %}>
	<div id="dp_header_bar">
		{% include 'UserBundle:Common:layout-userbar.html.twig' %}
		<div id="dp_search_bar" class="with-handler" data-element-handler="DeskPRO.User.ElementHandler.OmniSearch">
			<form action="{{ path('user_search') }}" method="GET">
				<table cellpadding="0" cellspacing="0" border="0" width="100%"><tr><td width="100%" style="padding-right: 16px;">
					<input type="text" name="q" id="deskpro_search" {% if app.search_query %}value="{{ app.search_query }}"{% endif %} placeholder="{{ phrase('user.general.comments_enter_details') }}" autocomplete="off" />
				</td><td width="50">
					<button class="btn primary">{{ phrase('user.general.search') }}</button>
				</td></tr></table>
			</form>
		</div>
	</div>

	{% if sidebar|trim|length %}
	<div id="dp_sidebar">
		{{ sidebar }}
	</div>
	{% endif %}

	{% if breadcrumb %}
		<div id="dp_breadcrumb">
			<ul>
				<li><a href="{{ path('user') }}">{{ phrase('user.general.helpdesk') }}</a></li>
				{{ breadcrumb }}
			</ul>
		</div>
	{% endif %}

	<div id="dp_content">
		{% if app.session.hasFlash('new_ticket') %}
			<div class="dp-content-block">
				<div class="dp-box">
					<div class="dp-box-content-wrapper">
						<div class="dp-box-content">
							<div class="alert-message block-message success">
								<p>{{ phrase('user.tickets.created_successfully') }}</p>
								{% if app.session.hasFlash('new_ticket_validating_email') %}
									<p>
										{{ phrase('user.tickets.new_validating_notice', {'email': app.session.flash('new_ticket_validating_email')}) }}
									 </p>
								{% elseif app.session.hasFlash('new_ticket_email') %}
									{{ phrase('user.tickets.new_ticket_notice', {'email': app.session.flash('new_ticket_email')}) }}
								{% endif %}
							</div>
						</div>
					</div>
				</div>
			</div>
		{% endif %}

		{% block content %}{% endblock %}
	</div>

	<div id="dp_footer">
		<a href="http://www.deskpro.com/">{{ phrase('user.general.powered_by') }}</a>
	</div>
</div>

</div>

{% if admin_portal_controls %}
	<div id="dp_custom_footer_wrap" class="dp-portal-block" {% if not custom_templates['UserBundle::custom-footer.html.twig'] %}style="display: none"{% endif %}>
		<div id="dp_custom_footer" class="dp-portal-block-content">
			{% include 'UserBundle::custom-footer.html.twig' %}
		</div>
	</div>
	<div id="dp_custom_footer_placeholder" class="dp-portal-placeholder dp-portal-placeholder-footer" data-portal-block="footer" data-portal-for="#dp_custom_footer" {% if custom_templates['UserBundle::custom-footer.html.twig'] %}style="display: none"{% endif %}>
		<em>{{ phrase('admin.designer.edit_footer_section') }}</em>
	</div>
{% else %}
	{% include 'UserBundle::custom-footer.html.twig' %}
{% endif %}

{% if admin_portal_controls %}
	<script type="text/javascript" src="{{ asset('vendor/less/less.min.js') }}"></script>
{% endif %}

{% if not app.getSetting('user.disable_chat_element') and not admin_portal_controls %}
	{% include 'UserBundle:Common:chat-loader.html.twig' %}

	<!-- DeskPRO Widget -->
	<div id="dp_newticket_form" style="display: none"></div>
	<script type="text/javascript">
	var DpOverlayWidget_Options = DpOverlayWidget_Options || {};
	DpOverlayWidget_Options.staticUrl = '{{ asset_url('') }}';
	DpOverlayWidget_Options.deskproUrl = '{{ url('user') }}';
	DpOverlayWidget_Options.protocol = ('https:' == document.location.protocol ? 'https' : 'http');
	(function() {
		var scr = document.createElement('script');
		scr.src = '{{ asset('javascripts/DeskPRO/User/WebsiteWidget/Overlay.js') }}';
		scr.setAttribute('async', 'true');
		document.documentElement.firstChild.appendChild(scr);
	})();
	</script>
	<!-- /DeskPRO Widget -->
{% endif %}

</body>
</html>
