<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html id="dp_html" xmlns="http://www.w3.org/1999/xhtml" lang="en">
<head>
	{% if page_noindex %}<meta name="robots" content="noindex,nofollow" />{% endif %}
	{% if app.getSetting('core.favicon_blob_id') %}
		<link rel="shortcut icon" id="favicon" href="{{ path('favicon', {}, true) }}" />
	{% else %}
		<link rel="shortcut icon" id="favicon" href="{{ app.getRequest().getBasePath() }}/favicon.ico" />
	{% endif %}
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
	<title>{% block page_title %}{{ app.getSetting('core.deskpro_name') }}{% endblock %}</title>

	<meta property="og:site_name" content="{{ app.getSetting('core.site_name')|default(app.getSetting('core.core.helpdesk_name')) }}" />
	{% if app.getSetting('core.facebook_admins') %}<meta property="fb:admins" content="{{ app.getSetting('core.facebook_admins') }}" />{% endif %}

	{% include 'UserBundle::layout-resources.html.twig' %}

	{% if admin_portal_controls %}
	<script type="text/javascript">var IS_ADMIN_CONTROLS = true;</script>
	{{ dp_asset_html('agent_vendors') }}
	{{ dp_asset_html('agent_common') }}
	{{ dp_asset_html('user_portaladmin') }}
	{{ dp_asset_html('user_portaladmin_css') }}
	{% endif %}

	{% block head %}{% endblock %}
	{% include 'UserBundle::custom-headinclude.html.twig' %}
</head>
<body>
<div id="fb-root"></div>
<script type="text/javascript">document.body.className += " dp-with-js";</script>
{% if app.getSetting('core.show_share_widget') %}
	{% if app.getSetting('core.show_share_twitter') %}
		<script>!function(d,s,id){var js,fjs=d.getElementsByTagName(s)[0];if(!d.getElementById(id)){js=d.createElement(s);js.id=id;js.src="//platform.twitter.com/widgets.js";fjs.parentNode.insertBefore(js,fjs);}}(document,"script","twitter-wjs");</script>
	{% endif %}
	{% if app.getSetting('core.show_share_facebook') %}
		<script type="text/javascript">(function(d, s, id) { var js, fjs = d.getElementsByTagName(s)[0]; if (d.getElementById(id)) return;	js = d.createElement(s); js.id = id; js.src = "//connect.facebook.net/en_US/all.js#xfbml=1&appId=113084412087018"; fjs.parentNode.insertBefore(js, fjs); }(document, 'script', 'facebook-jssdk'));</script>
	{% endif %}
	{% if app.getSetting('core.show_share_gplus') %}
		<script type="text/javascript">(function() { var po = document.createElement('script'); po.type = 'text/javascript'; po.async = true; po.src = 'https://apis.google.com/js/plusone.js'; var s = document.getElementsByTagName('script')[0]; s.parentNode.insertBefore(po, s);})();</script>
	{% endif %}
	{% if app.getSetting('core.show_share_linkedin') %}
		<script src="//platform.linkedin.com/in.js" type="text/javascript"></script>
	{% endif %}
{% endif %}

{# Processing #}
{% set breadcrumb %}{% block breadcrumb %}{% endblock %}{% endset %}
{% if not breadcrumb|trim %}{% set breadcrumb = false %}{% endif %}
{% set sidebar %}{% block sidebar %}{{ portal_section('sidebar') }}{% endblock %}{% endset %}
{% if not sidebar|trim %}{% set sidebar = false %}{% endif %}

{% if admin_portal_controls %}
	<div id="dp_custom_head_wrap" class="dp-portal-block" style="display: none">
		<div id="dp_custom_head" class="dp-portal-block-content"></div>
	</div>
	<div id="dp_custom_head_placeholder" class="dp-portal-placeholder dp-portal-placeholder-head {% if custom_templates['UserBundle::custom-headinclude.html.twig'] %}dp-portal-placeholder-highlight{% endif %}" data-portal-block="head_include" data-portal-for="#dp_custom_head" data-mode="head">
		<em>{{ phrase('admin.designer.edit_page_head') }}</em>
	</div>
	<div id="dp_custom_header_wrap" class="dp-portal-block" {% if not custom_templates['UserBundle::custom-header.html.twig'] %}style="display: none"{% endif %}>
		<div id="dp_custom_header" class="dp-portal-block-content">
			{% include 'UserBundle::custom-header.html.twig' %}
		</div>
	</div>
	<div id="dp_custom_header_placeholder" class="dp-portal-placeholder dp-portal-placeholder-header" data-portal-block="header" data-portal-for="#dp_custom_header" {% if custom_templates['UserBundle::custom-header.html.twig'] %}style="display: none"{% endif %}>
		<em>{{ phrase('admin.designer.edit_header_section') }}</em>
	</div>
{% else %}
	{% include 'UserBundle::custom-header.html.twig' %}
{% endif %}

<div id="dp">
	<div id="dp_main">
	<div id="dp_main_inner">

		{% if admin_portal_controls %}
			<div id="dp_header" class="{% if app.logoblob %}dp-with-logo{% endif %} {% if not app.getSetting('user.portal_simpleheader') %}disabled{% endif %}">
				<a href="{{ path('user') }}"><img class="logo" {% if app.logoblob %}src="{{ app.logoblob.getDownloadUrl() }}"{% endif %} /></a>

				<h1><a href="{{ path('user') }}">{{ app.getSetting('user.portal_header') }}</a></h1>
				<h2 {% if not app.getSetting('user.portal_tagline') %}style="display: none"{% endif %}>{{ app.getSetting('user.portal_tagline') }}</h2>
				{% if admin_portal_controls %}
					<div id="dp_header_portal_off" style="float:left">
						{{ phrase('admin.designer.reenable_simple_header') }}
					</div>
				{% endif %}
				<br style="clear:both;height: 1px;overflow: hidden;" />
			</div>
		{% else %}
			{% if app.getSetting('user.portal_simpleheader') %}
				{% if app.logoblob %}
					<div id="dp_header">
						<a href="{{ path('user') }}"><img class="logo" src="{{ app.logoblob.getDownloadUrl() }}" /></a>
					</div>
				{% else %}
					<h1><a href="{{ path('user') }}">{{ app.getSetting('user.portal_header') }}</a></h1>
					<h2 {% if not app.getSetting('user.portal_tagline') %}style="display: none"{% endif %}>{{ app.getSetting('user.portal_tagline') }}</h2>
					<br style="clear:both; height: 1px;overflow: hidden;" />
				{% endif %}
			{% endif %}
		{% endif %}

		<div id="dp_header_bar">
			<section id="dp_header_title">
				<h1>{{ app.getSetting('user.portal_title') }}</h1>
			</section>
			<section id="dp_header_search" class="with-handler" data-element-handler="DeskPRO.User.ElementHandler.OmniSearch">
				<form action="{{ path('user_search') }}" class="dp-form-search" id="dp_omnisearch">
					<input type="input" name="q" id="dp_search" placeholder="{{ phrase('user.general.search_for_something') }}" value="{{ query }}" />
					<button class="dp-btn" type="submit">{{ phrase('user.general.search') }}</button>
				</form>
			</section>
		</div>
		{% set any_tabs = false %}
		{% if app.getSetting('user.portal_tab_news') %}{% set any_tabs = true %}{% endif %}
		{% if app.user.hasPerm('articles.use') and app.getSetting('user.portal_tab_articles') %}{% set any_tabs = true %}{% endif %}
		{% if app.user.hasPerm('feedback.use') and app.getSetting('user.portal_tab_feedback') %}{% set any_tabs = true %}{% endif %}
		{% if app.getSetting('user.portal_tab_tickets') %}{% set any_tabs = true %}{% endif %}

		<div id="dp_page_wrapper" {% if not any_tabs and not admin_portal_controls %}class="dp-no-tabs"{% endif %}>
			<div id="dp_sidebar_wrapper">
				<section id="dp_sidebar">
					{{ sidebar }}
				</section>
			</div>
			<div id="dp_content_wrapper">
				{% if any_tabs or admin_portal_controls %}
					<nav id="dp_content_tabs">
						<ul>
							{% if admin_portal_controls or app.getSetting('user.portal_tab_news') %}
								<li class="dp-tab-news {% if this_section == 'news' %}on{% endif %} {% if not app.getSetting('user.portal_tab_news') %}disabled{% endif %}" data-tab="news">
									<a href="{{ path('user') }}">
										<i class="dp-icon-home"></i> <h3>{{ phrase('user.general.tab_home') }}</h3>
										<label>{{ phrase('user.general.tab_home_note') }}</label>
									</a>
								</li>
							{% endif %}
							{% if app.user.hasPerm('articles.use') and (admin_portal_controls or app.getSetting('user.portal_tab_articles')) %}
								<li class="dp-tab-articles {% if this_section == 'articles' %}on{% endif %} {% if not app.getSetting('user.portal_tab_articles') %}disabled{% endif %}" data-tab="articles">
									<a href="{{ path('user_articles') }}">
										<i class="dp-icon-folder-open"></i> <h3>{{ phrase('user.general.knowledgebase') }}</h3>
										<label>{{ phrase('user.general.tab_kb_note') }}</label>
									</a>
								</li>
							{% endif %}
							{% if app.user.hasPerm('feedback.use') and (admin_portal_controls or app.getSetting('user.portal_tab_feedback')) %}
								<li class="dp-tab-feedback {% if this_section == 'feedback' %}on{% endif %} {% if not app.getSetting('user.portal_tab_feedback') %}disabled{% endif %}" data-tab="feedback">
									<a href="{{ path('user_feedback') }}">
										<i class="dp-icon-file"></i> <h3>{{ phrase('user.general.feedback') }}</h3>
										<label>{{ phrase('user.general.tab_feedback_note') }}</label>
									</a>
								</li>
							{% endif %}
							{% if admin_portal_controls or app.getSetting('user.portal_tab_tickets') %}
								<li class="dp-tab-contact {% if this_section == 'tickets' %}on{% endif %} {% if not app.getSetting('user.portal_tab_tickets') %}disabled{% endif %}" data-tab="tickets">
									<a href="{{ path('user_tickets_new') }}">
										<i class="dp-icon-inbox"></i> <h3>{{ phrase('user.general.contact_us') }}</h3>
										<label>{{ phrase('user.general.tab_contact_note') }}</label>
									</a>
								</li>
							{% endif %}
						</ul>
					</nav>
				{% endif %}
                <section id="dp_content">
					{% if breadcrumb %}
						<nav id="dp_breadcrumb_wrap">
							<div class="dp-breadcrumb-fade"></div>
							<ul class="dp-breadcrumb">
								<li>
									<a href="{{ path('user') }}"><i class="dp-icon-home"></i></a>
								</li>
								{{ breadcrumb }}
							</ul>
						</nav>
					{% endif %}

					{% include 'UserBundle::layout-flashes.html.twig' %}

					{% block content %}{% endblock %}
				</section>
			</div>
			<footer id="dp_footer">
				<div class="dp-copy">
					<a href="http://www.deskpro.com/">{{ phrase('user.general.helpdesk_by', {'deskpro': phrase('user.general.deskpro')}) }}</a>
				</div>
			</footer>
		</div>
	</div>
	</div>

	<div id="dp_search_assist" style="display: none;">
		<div class="results"></div>
		<div class="foot">
			<div class="dp-more-link">
				<button class="dp-btn dp-btn-success">{{ phrase('user.general.view_more_search_results')}} &rarr;</button>
			</div>
			<h4>{{ phrase('user.general.is_search_relevant') }}</h4>
			<ul>
				<li class="ticket"><a href="{{ path('user_tickets_new') }}">{{ phrase('user.general.contact_us') }}</a></li>
				<li class="feedback"><a href="{{ path('user_feedback_new') }}">{{ phrase('user.general.create_feedback') }}</a></li>
				<li class="chat dp-chat-trigger no-omni-trigger"><a href="#">{{ phrase('user.general.btn_create_chat') }}</a></li>
			</ul>
		</div>
	</div>
</div>

{% if admin_portal_controls %}
	<div id="dp_custom_footer_wrap" class="dp-portal-block" {% if not custom_templates['UserBundle::custom-footer.html.twig'] %}style="display: none"{% endif %}>
		<div id="dp_custom_footer" class="dp-portal-block-content">
			{% include 'UserBundle::custom-footer.html.twig' %}
		</div>
	</div>
	<div id="dp_custom_footer_placeholder" class="dp-portal-placeholder dp-portal-placeholder-footer" data-portal-block="footer" data-portal-for="#dp_custom_footer" {% if custom_templates['UserBundle::custom-footer.html.twig'] %}style="display: none"{% endif %}>
		<em>{{ phrase('admin.designer.edit_footer_section') }}</em>
	</div>
{% else %}
	{% include 'UserBundle::custom-footer.html.twig' %}
{% endif %}

{% if admin_portal_controls %}
	<script type="text/javascript" src="{{ asset('vendor/less/less.min.js') }}"></script>
{% endif %}

{% if not app.getSetting('user.disable_chat_element') and not admin_portal_controls and app.user.hasPerm('chat.use') %}
	{% include 'UserBundle:Common:chat-loader.html.twig' %}
	<!-- DeskPRO Widget -->
	<div id="dp_newticket_form" style="display: none"></div>
	<script type="text/javascript">
		var DpOverlayWidget_Options = DpOverlayWidget_Options || {};
		DpOverlayWidget_Options.staticUrl = '{{ asset_url('') }}';
		DpOverlayWidget_Options.deskproUrl = '{{ url('user') }}';
		DpOverlayWidget_Options.protocol = ('https:' == document.location.protocol ? 'https' : 'http');
		(function() {
			var scr = document.createElement('script');
			scr.src = '{{ asset('javascripts/DeskPRO/User/WebsiteWidget/Overlay.js') }}';
			scr.setAttribute('async', 'true');
			document.documentElement.firstChild.appendChild(scr);
		})();
	</script>
	<!-- /DeskPRO Widget -->
{% endif %}

</body>
</html>
