<!DOCTYPE html>
<html>
<head>
	<title>DeskPRO API</title>
	<link href='{{ asset('swagger-ui/css/highlight.default.css') }}' media='screen' rel='stylesheet' type='text/css'/>
	<link href='{{ asset('swagger-ui/css/screen.css') }}' media='screen' rel='stylesheet' type='text/css'/>
	<script type="text/javascript" src="{{ asset('swagger-ui/lib/shred.bundle.js') }}"></script>
	<script src='{{ asset('swagger-ui/lib/jquery-1.8.0.min.js') }}' type='text/javascript'></script>
	<script src='{{ asset('swagger-ui/lib/jquery.slideto.min.js') }}' type='text/javascript'></script>
	<script src='{{ asset('swagger-ui/lib/jquery.wiggle.min.js') }}' type='text/javascript'></script>
	<script src='{{ asset('swagger-ui/lib/jquery.ba-bbq.min.js') }}' type='text/javascript'></script>
	<script src='{{ asset('swagger-ui/lib/handlebars-1.0.0.js') }}' type='text/javascript'></script>
	<script src='{{ asset('swagger-ui/lib/underscore-min.js') }}' type='text/javascript'></script>
	<script src='{{ asset('swagger-ui/lib/backbone-min.js') }}' type='text/javascript'></script>
	<script src='{{ asset('swagger-ui/lib/swagger.js') }}' type='text/javascript'></script>
	<script src='{{ asset('swagger-ui/swagger-ui.js') }}' type='text/javascript'></script>
	<script src='{{ asset('swagger-ui/lib/highlight.7.3.pack.js') }}' type='text/javascript'></script>
	<style type="text/css">
		#header {
			background: #1b79b0;
		}
		#header a#logo {
			background: transparent;
			padding: 20px;
		}

		.swagger-ui-wrap ul#resources li.resource, .swagger-ui-wrap ul#resources li.resource:last-child {
			border: 2px solid #ccc;
			border-radius: 2px;
			margin-bottom: 15px;
		}

		.swagger-ui-wrap ul#resources li.resource div.heading {
			background: #e6e7e9;
			padding: 5px;
		}

		.swagger-ui-wrap ul#resources li.resource div.heading ul.options {
			margin: 0;
			padding: 0;
			font-size: 11px;
		}

		.swagger-ui-wrap ul#resources li.resource div.heading h2 {
			margin: 0;
			padding: 0;
			font-size: 12px;
			font-weight: normal;
			color: #666;
		}

		.swagger-ui-wrap ul#resources li.resource ul.endpoints {
			padding: 25px;
		}

		.swagger-ui-wrap ul#resources li.resource ul.endpoints li.endpoint ul.operations li.operation div.heading ul.options {
			font-size: 14px;
		}

		.swagger-ui-wrap ul#resources li.resource div.heading h2 a {
			font-size: 14px;
			font-weight: bold;
			color: #444;
		}

		.swagger-ui-wrap {
			max-width: 1250px;
			font-family: Helvetica, Arial, sans-serif;
		}
	</style>
	<script type="text/javascript">
	$(function () {
		$('#input_baseUrl').val((window.location.href+"").replace(/api\.html.*?$/, ''));
		window.swaggerUi = new SwaggerUi({
			url: (window.location.href+"").replace(/api\.html.*?$/, 'docs'),
			dom_id: "swagger-ui-container",
			supportedSubmitMethods: ['get', 'post', 'put', 'delete'],
			onComplete: function(swaggerApi, swaggerUi){
				log("Loaded SwaggerUI")
				$('pre code').each(function(i, e) {hljs.highlightBlock(e)});
			},
			onFailure: function(data) {
				log("Unable to Load SwaggerUI");
			},
			docExpansion: "none"
		});

		$('#input_apiKey').change(function() {
			var key = $('#input_apiKey')[0].value;
			log("key: " + key);
			if (key && key.trim() != "") {
				log("added key " + key);
				window.authorizations.add("key", new ApiKeyAuthorization("X-DeskPRO-API-Key", key, "header"));
			}
		});
		window.swaggerUi.load();
	});
	</script>
</head>

<body>
<div id='header'>
	<div class="swagger-ui-wrap">
		<a id="logo" href="#">DeskPRO API</a>
		<input type="hidden" value="" id="input_baseUrl" />
		<div style="float:right; margin-top: -2px;"><input placeholder="api_key" id="input_apiKey" name="apiKey" type="text" style="width:280px; font-family: Monaco, Consolas, monospace; border: 1px solid #0f4063; border-radius: 2px; background: #fff; padding: 5px; font-size: 12px;"/></div>
	</div>
</div>

<div id="message-bar" class="swagger-ui-wrap"></div>
<div id="swagger-ui-container" class="swagger-ui-wrap"></div>

</body>
</html>
