                        },
                        {
                            "paramType": "query",
                            "name": "attach_id",
                            "type": "integer",
                            "required": false,
                            "description": "The ID of an already uploaded file to include with the download. Required if no attach value is provided."
                        }
                    ]
                }
            ]
        }
