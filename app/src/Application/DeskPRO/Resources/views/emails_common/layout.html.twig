{% extends 'DeskPRO:emails_common:email-internal.html.twig' %}
{% set tpl_header %}{% block header %}{% include 'DeskPRO:emails_common:layout-header.html.twig '%}{% endblock %}{% endset %}
{% set tpl_footer %}{% block footer %}{% include 'DeskPRO:emails_common:layout-footer.html.twig '%}{% endblock %}{% endset %}
{% set tpl_footer_bar %}{% block footer_bar %}{% include 'DeskPRO:emails_common:layout-footer-bar.html.twig '%}{% endblock %}{% endset %}
{% block email_body %}
<!--DP_TOP_MARK-->
<html>
<body>
<!--DP_TOP_MARK--><span style="color:#ffffff;text-size:8px;">_______________________.</span>
<table width="600" border="0" align="center" cellpadding="0" cellspacing="0" style="font-family:Arial, Helvetica, sans-serif; color:#FFFFFF; font-size:12px;">
	{% if tpl_header|trim %}
		<tr>
			<td valign="top" style="color:#999999;">{{ tpl_header|trim }}</td>
		</tr>
	{% endif %}
	<tr>
		<td valign="top" style="color:#999999;">{% block content %}{% endblock %}</td>
	</tr>
	{% if tpl_footer|trim %}
		<tr>
			<td valign="top" style="color:#999999;">{{ tpl_footer|trim }}</td>
		</tr>
	{% endif %}
	{% if tpl_footer_bar|trim %}
		<tr>
			<td colspan="2" align="center" bgcolor="#0D1C3E" style="padding:12px; font-size:12px; color:#fff;">{{ tpl_footer_bar|raw }}</td>
		</tr>
	{% endif %}
</table>
</body>
{% endblock %}