{% extends 'DeskPRO:emails_common:email-internal.html.twig' %}
{% import 'DeskPRO:emails_common:layout-macros.html.twig' as layout %}
{% block email_body %}
<html>
<body>
<a name="DP_TOP_MARK"></a>
<table class="DP_TOP_MARK" id="DP_TOP_MARK" alt="DP_TOP_MARK" name="DP_TOP_MARK" width="100%" border="0" cellpadding="0" cellspacing="0" style="{{ layout.standard_font() }}"><tr><td>

<!--DP_TOP_MARK-->
<table border="0" width="100%" border="0" cellpadding="0" cellspacing="0" style="{{ layout.standard_font() }}">
	{% if is_noreply %}
		<tr>
			<td valign="top" style="{{ layout.standard_font() }} color:#949494; background-color: #FFFFFF; padding: 0 0 14px 0; font-size: 10px" bgcolor="#FFFFFF">
				{{ phrase('user.emails.do-not-reply') }}
			</td>
		</tr>
	{% endif %}
	<tr>
		<td valign="top" style="{{ layout.standard_font() }} color:#242424; background-color: #FFFFFF; padding: 0;" bgcolor="#FFFFFF">{% block content %}{% endblock %}</td>
	</tr>
	{% set footer_content %}{% block footer_content %}{% endblock %}{% endset %}
	{% include 'DeskPRO:emails_common:layout-footer.html.twig' %}
</table>
{% block email_end %}{% endblock %}

</td></tr></table>
</body>
{% endblock %}