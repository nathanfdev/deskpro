<!--DP_TOP_MARK-->
<html>
<body>
<!--DP_TOP_MARK--><span style="color:#ffffff;text-size:8px;">_______________________.</span>
<table width="600" border="0" align="center" cellpadding="0" cellspacing="0" style="font-family:Arial, Helvetica, sans-serif; color:#FFFFFF; font-size:12px;">
	<tr>
		<td valign="top" style="color:#999999;">{% block content %}{% endblock %}</td>
	</tr>
	<tr>
		<td colspan="2" align="center" bgcolor="#0D1C3E" style="padding:12px; font-size:12px; color:#fff;">
			<a href="{{ app.getSetting('core.deskpro_url') }}" style="color:#fff;">{{ app.getSetting('core.deskpro_name') }}</a>
			{% if app.getSetting('core.site_name') %}
				| <a href="{{ app.getSetting('core.site_url') }}" style="color:#fff;">{{ app.getSetting('core.site_name') }}</a>
			{% endif %}
		</td>
	</tr>
</table>
</body>
