{% extends 'DeskPRO:emails_common:email-internal.html.twig' %}
{% import 'DeskPRO:emails_common:layout-macros.html.twig' as layout %}
{% block email_body %}
<html>
<head>
	<style type="text/css">
		p {
			margin: 0;
		}

		a {
			color: #0065A3;
			text-decoration: underline;
		}

		td.dp-layout-top {
			font-size: 12px;
		}

		td {
			padding: 0;
		}

		span.dp-replycode {
			color:#E8E8E8;
			font-size:1px;
		}

		div.dp-wrap, td, p, span, div {
			font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
			line-height: 125%;
			color: #242424;
		}

		div.dp-layout-section-header {
			padding-bottom: 2px;
		}

		div.dp-layout-section-header-title {
			font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
			font-size: 14px;
			font-weight: bold;
		}

		div.dp-spacer {
			font-size:1px;
			padding: 6px;
			height: 6px;
			overflow:hidden;
		}

		div.dp-hr {
			font-size: 12px;
			line-height: 100%;
			padding: 0;
			margin-top: 15px;
			border-top: 2px solid #C5C5C5;
		}

		td.dp-layout-bottom, td.dp-layout-bottom span, td.dp-layout-bottom div, td.dp-layout-bottom a, td.dp-layout-bottom td, td.dp-layout-bottom p {
			color: #ABABAB;
		}

		table.dp-props-table {
			border-left: 1px solid #BABABA;
			border-right: 1px solid #BABABA;
			border-bottom: 1px solid #BABABA;
		}

		table.dp-props-table td {
			font-size: 12px;
			padding: 6px;
			border-top: 1px solid #BABABA;
		}

		div.dp-author-row {
			color: #ABABAB;
			font-size: 12px;
			padding-bottom: 2px;
		}

		div.dp-quoted-message {
			font-size: 12px;
			border-left: 1px solid #00174B;
			color: #00174B;
			font-size:12px;
			line-height:125%;
			padding-left: 8px;
			margin-left: 2px;
		}
	</style>
</head>
<body>
<div class="dp-wrap">
<a name="DP_TOP_MARK {{with_cutmark}}"></a>
<table class="DP_TOP_MARK {{with_cutmark}}" id="DP_TOP_MARK" alt="DP_TOP_MARK {{with_cutmark}}" name="DP_TOP_MARK {{with_cutmark}}" width="100%" border="0" cellpadding="0" cellspacing="0" style="{{ layout.standard_font() }}"><tr><td>

<!--DP_TOP_MARK-->{% if with_cutmark %}<!-- {{with_cutmark}} -->{% endif %}
<table border="0" width="100%" border="0" cellpadding="0" cellspacing="0">
	{% ifblock email_header %}
		<tr>
			<td valign="top">
				<div class="dp-layout-top">
					{% block email_header %}{% block header_content %}{% endblock %}{% endblock %}
				</div>
			</td>
		</tr>
	{% endifblock %}
	<tr>
		<td valign="top" class="dp-layout-content">{% block content %}{% endblock %}</td>
	</tr>
	<tr>
		<td valign="top" class="dp-layout-bottom">
			<div class="dp-layout-bottom">
				{{ layout.hr() }}
				{% ifblock footer_content %}
					{% block footer_content %}{% endblock %}
					<br /><br />
				{% endifblock %}
				{% if app.getSetting('core.site_name') and app.getSetting('core.site_url') %}
					<a href="{{ app.getSetting('core.site_url') }}" style="{{ layout.info_link_style() }}; font-size: 12px;">{{ app.getSetting('core.site_name') }}</a> &middot;
				{% elseif app.getSetting('core.site_url') %}
					<a href="{{ app.getSetting('core.site_url') }}" style="{{ layout.info_link_style() }} font-size: 12px;">{{ app.getSetting('core.site_url') }}</a> &middot;
				{% endif %}

				<a href="{{ app.getSetting('core.deskpro_url') }}" style="{{ layout.info_link_style() }} font-size: 12px;">{{ app.getSetting('core.deskpro_url') }}</a>
			</div>
		</td>
	</tr>
</table>
{% block email_end %}{% endblock %}

{% if tac %}
	{{ layout.replycode(tac.access_code) }}
{% elseif ticket %}
	{{ layout.replycode(ticket.access_code) }}
{% endif %}

</td></tr></table>

</div>
</body>
</html>
{% endblock %}