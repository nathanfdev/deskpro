{##
# Wrapper around sections in emails
##}
{% macro section(content) %}
	<div class="dp-layout-section">
		{{content}}
	</div>
	<br /><br />
{% endmacro %}

{##
# Wrapper around sections in emails
##}
{% macro sectionHeader(content) %}
	<div class="dp-layout-section-header"><div class="dp-layout-section-header-title">{{ content }}</div></div>
{% endmacro %}

{##
# The spacer inserts small whitespace between two elements
##}
{% macro spacer() %}<div class="dp-spacer">&nbsp;</div>{% endmacro %}

{##
# Styling applied to ticket log actiontext
##}
{% macro actiontext_style(type) %}{% spaceless %}
	{% if type == 'row' %}padding: 5px 0 5px 0;
	{% elseif type == 'type' %}font-weight: bold;
	{% elseif type == 'old-val' %}
	{% elseif type == 'new-val' %}
	{% endif %}
{% endspaceless %}{% endmacro %}

{##
# A horizontal rule that is used to separate the footer
##}
{% macro hr() %}
	<div class="dp-hr">&nbsp;</div>
{% endmacro %}

{##
# Invisible code tracking that is appended to the bottom of emails
##}
{% macro replycode(code) %}
	<span class="dp-replycode">(#{{ code }})</span>
{% endmacro %}

{##
# Standard greeting text for a user
##}
{% macro greeting(person) %}
	{{ phrase('user.emails.greeting', {'name': person.display_name_user}) }}<br /><br />
{% endmacro %}
