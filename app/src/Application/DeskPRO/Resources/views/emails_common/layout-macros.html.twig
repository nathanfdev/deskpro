{% macro section(title, content, options) %}
	<table width="100%" border="0" cellspacing="0" cellpadding="0" style="margin-top:15px;">
		{% if title %}
			<tr>
				<td style="font-size:18px; color:#242424; padding-top:6px; padding-bottom:6px;">
					{{ title }}
				</td>
			</tr>
		{% endif %}
		{% if content %}
			<tr>
				<td style="font-size:12px; line-height:145%; padding-bottom:15px;">
					{{ content }}
				</td>
			</tr>
		{% endif %}
	</table>
{% endmacro %}

{% macro link_style() %}color: #0065A3;text-decoration: underline;{% endmacro %}
{% macro info_link_style() %}color: #949494;text-decoration: underline;{% endmacro %}

{% macro info_section(content, options) %}
	<p style="margin: 0; padding: 0;">{{ content }}</p>
{% endmacro %}

{% macro sep() %}
	<p style="height: 2px; padding: 0; margin: 15px 0 15px 0; background-color: #C5C5C5;">&nbsp;</p>
{% endmacro %}

{% macro messages_section(title, content, options) %}
<table width="100%" border="0" cellspacing="0" cellpadding="0" style="margin-top:15px;margin-bottom:15px;">
	{% if title %}
	<tr>
		<td style="font-size:18px; color:#242424; padding-top:6px; padding-bottom:6px;">
			{{ title }}
		</td>
	</tr>
	{% endif %}
	{% if content %}
	<tr>
		<td style="font-size:12px; line-height:125%;">
			{{ content }}
		</td>
	</tr>
	{% endif %}
</table>
{% endmacro %}

{% macro message(author, time, message, options) %}
	<table width="620" border="0" cellspacing="0" cellpadding="3">
		<tr><td style="font-size:12px; line-height:125%; color: #6D6D6D;">{{ phrase('user.emails.on_x_at_y_z_wrote', { date: time|date('full'), time: time|date('time'), author: author|e }) }}</td></tr>
		<tr><td style="font-size:12px; line-height:145%; padding-left: 6px;">
			<table cellspacing="0" cellpadding="0" width="100%"><tr><td style="border-left: 1px solid #00174B; color: #00174B; font-size:12px; line-height:135%; padding-left: 8px;">
				{{ message|raw }}
			</td></tr></table>
		</td></tr>
		<tr><td><br /></td></tr>
	</table>
{% endmacro %}

{% macro render_top_message(message, options) %}
	<table width="620" border="0" cellspacing="0" cellpadding="3">
		<tr><td style="font-size:12px; line-height:145%;">
			{{ message.message_html|raw }}
		</td></tr>
	</table>
{% endmacro %}

{% macro render_ticket_messages(messages, title, options) %}
	{% if not options.skip_top or (options.skip_top and messages|length > 1) %}
		{% set section_content %}
			{% for message in messages %}
				{% if options.skip_top and loop.first %}
				{% else %}
					{% if message.person.is_agent %}
						{{ _self.message(message.person.display_name, message.date_created, message.message_html) }}
					{% else %}
						{{ _self.message(message.person.display_contact, message.date_created, message.message_html) }}
					{% endif %}
				{% endif %}
			{% endfor %}
		{% endset %}
		{{ _self.messages_section(title, section_content) }}
	{% endif %}
{% endmacro %}

{% macro replycode(code) %}
	<span style="color:#ffffff;text-size:8px;">(#{{ code }})</span>
{% endmacro %}

{% macro greeting(person) %}
	{{ phrase('user.emails.greeting', {'name': person.display_name}) }}<br /><br />
{% endmacro %}