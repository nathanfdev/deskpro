{% endif %}

--50c634de_3222e7cd_af2f
Content-Type: text/plain; charset="utf-8"
Content-Transfer-Encoding: 7bit
Content-Disposition: inline

{{ message|strip_html }}

{% if as_reply %}
  {% if as_agent %}
    === {{ phrase('agent.emails.reply_above_line') }} ===


  {% endif %}
  (#{{ access_code }})
{% endif %}


