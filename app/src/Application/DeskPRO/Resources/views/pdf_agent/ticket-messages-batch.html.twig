{% for message in ticket_messages %}
<table class="ticket_list_table" width="100%" border="0" cellspacing="0">
    <tr><td colspan="2"><hr /></td></tr>
    <tr>
        <td>Message #{{ loop.index  }}</td>
        <td align="right">By {{message.person.name}} at {{message.date_created|date('fulltime')}}</td>
    </tr>
    <tr><td colspan="2"><hr /></td></tr>
    <tr>
        <td colspan="2">
            {{ message.message_html|safe_link_urls_html }}
        </td>
    </tr>
    {% if ticket_message_attachments[message.id] %}
        <tr>
            <td colspan="2">
                <ul class="attachment-list">
                {% for attach_id in ticket_message_attachments[message.id] %}
                {% set ticket_attach = ticket_attachments[attach_id] %}
                <li>
                    {% if ticket_attach.blob.isImage() %}
                        <img src="{{ path('serve_blob', {'blob_auth_id': ticket_attach.blob.auth_id, 'filename': ticket_attach.blob.filename_safe, 's': 50, 'size-fit': '1'}) }}" class="preview" />
                    {% endif %}
                    {{ticket_attach.blob.filename}}
                    <span class="size">({{ ticket_attach.blob.readable_filesize }})</span>
                </li>
                {% endfor %}
            </ul>
            </td>
        </tr>
    {%endif%}
</table>
{% endfor %}