{% set agent_notification_footer = 'notify' %}
<dp:subject>Tweet assigned to you by {{ performer.getDisplayName() }}</dp:subject>
{% if account_status.agent %}

{{ performer.getDisplayContact() }} has assigned a tweet to you.
<br /><br />
<a href="{{ url_full('agent') }}#app.twitter,tw-own:{{ account_status.account.id }}::">View your tweets</a>

{% elseif account_status.agent_team %}

{{ performer.getDisplayContact() }} has assigned a tweet to your team.
<br /><br />
<a href="{{ url_full('agent') }}#app.twitter,tw-team:{{ account_status.account.id }}::">View your team's tweets</a>

{% endif %}