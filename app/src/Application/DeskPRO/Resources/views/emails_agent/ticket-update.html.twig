{% set agent_reply_above_line = true %}
<dp:subject>
	{% if type_flag == 'assigned' %}
		{% set action = 'ASSIGNED' %}
	{% elseif type_flag == 'assigned_team' %}
		{% set action = 'ASSIGNED TEAM' %}
	{% elseif type_flag == 'added_part' %}
		{% set action = 'FOLLOWED' %}
	{% else %}
		{% set action = 'UPDATED' %}
	{% endif %}
	[#{{ ticket.id }} {{action}}] Re: {{ ticket.subject }}
</dp:subject>
<dp:body>
	<dp:section>
		{% if action_performer and action_performer.getId() %}
			{{ action_performer.getDisplayContact() }}
		{% else %}
			System
		{% endif %} updated the ticket "{{ ticket.subject }}"

		{% if type_flag == 'assigned' %}
			and assigned it to you.
		{% elseif type_flag == 'assigned_team' %}
			and assigned it to your team "{{ ticket.agent_team.name }}".
		{% elseif type_flag == 'added_part' %}
			and added you as a new follower.
		{% endif %}
	</dp:section>

	<dp:section>
		<dp:section-header>Ticket</dp:section-header>
		{% for log in ticket_logs %}
			{% include 'DeskPRO:emails_agent:ticket-log-actiontext.html.twig' %}
		{% endfor %}

		<br /><br />

		{% include 'DeskPRO:emails_agent:ticket-props-table.html.twig' %}
	</dp:section>

	<dp:section>
		<dp:section-header>{{ phrase('agent.general.message_history') }}</dp:section-header>
		{% for message in messages|slice(1) %}
			{% include 'DeskPRO:emails_common:ticket-message-row.html.twig' with {
				message: message,
				show_author_email: true,
				is_to_agent: true
			} %}
			<dp:spacer />
		{% endfor %}
	</dp:section>
</dp:body>