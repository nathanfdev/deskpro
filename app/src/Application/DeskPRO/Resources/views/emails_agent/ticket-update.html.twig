{% set agent_reply_above_line = true %}
<dp:subject>
	{% if type_flag == 'assigned' %}
		{% set action = 'ASSIGNED' %}
	{% elseif type_flag == 'assigned_team' %}
		{% set action = 'ASSIGNED TEAM' %}
	{% elseif type_flag == 'added_part' %}
		{% set action = 'FOLLOWED' %}
	{% else %}
		{% set action = 'UPDATED' %}
	{% endif %}
	[#{{ ticket.id }} {{action}}] Re: {{ ticket.subject }}{% if sla and sla_status == 'warning' %} (SLA WARNING){% elseif sla and sla_status == 'fail' %} (SLA FAILED){% endif %}
</dp:subject>
{% if action_performer and action_performer.getId() %}
	{{ action_performer.getDisplayContact() }}
{% elseif sla %}
	SLA {{ sla.title }}{% if sla_status == 'warning' %} (Warning){% elseif sla_status == 'fail' %} (Failed){% endif %}
{% else %}
	System
{% endif %} updated the ticket "{{ ticket.subject }}"

{% if type_flag == 'assigned' %}
	and assigned it to you.
{% elseif type_flag == 'assigned_team' %}
	and assigned it to your team "{{ ticket.agent_team.name }}".
{% elseif type_flag == 'added_part' %}
	and added you as a new follower.
{% endif %}

<br /><br />

<h1>Ticket</h1>

{{ phrase('agent.emails.ticket_was_created', {name: ticket.person.getDisplayContact()}) }}

<br /><br />

<dp:ticket-properties-table />

<br /><br />

<h1>{{ phrase('agent.general.message_history') }}</h1>
<dp:agent-ticket-history />