{% extends 'DeskPRO:emails_common:layout.html.twig' %}
{% import 'DeskPRO:emails_common:layout-macros.html.twig' as layout %}
{% block email_subject %}
{% if type_flag == 'assigned' %}Ticket assigned: {{ ticket.subject }}
{% elseif type_flag == 'assigned_team' %}Ticket assigned to your team: {{ ticket.subject }}
{% elseif type_flag == 'added_part' %}Added as a follower on: {{ ticket.subject }}
{% else %}Ticket updated: {{ ticket.subject }}{% endif %}
{% endblock %}
{% block content %}
{% set content %}
{% if action_performer %}{{ action_performer.getDisplayName() }}{% else %}System{% endif %} updated the ticket "{{ ticket.subject }}"


{% if type_flag == 'assigned' %}and assigned it to you.
{% elseif type_flag == 'assigned_team' %}and assigned it to your team "{{ ticket.agent_team.name }}".
{% elseif type_flag == 'added_part' %}and added you as a new follower.
{% endif %}
<br /><br />

View this ticket online:<br />
<a href="{{ url_full('agent') }}#app.tickets,t:{{ ticket.id }}" style="{{ layout.link_style() }}">{{ url_full('agent') }}#app.tickets,t:{{ ticket.id }}</a>
{% endset %}
{{ layout.section('', content) }}

<br /><br />

{% if type_flag == 'updated' %}
	{% set content %}
		{% for log in ticket_logs %}
			{% include 'DeskPRO:emails_agent:ticket-log-actiontext.html.twig' %}
		{% endfor %}
	{% endset %}
	{{ layout.section('Ticket Changes', content) }}
{% else %}
	{% set content %}
	<table cellspacing="0" cellpadding="3" width="100%">
		<tr>
			<td width="130">{{ phrase('agent.general.department') }}</td>
			<td>{{ticket.department.full_title|default(phrase('agent.general.none'))}}</td>
		</tr>
		<tr>
			<td width="130">{{ phrase('agent.general.agent') }}</td>
			<td>{{ticket.agent.display_name|default(phrase('agent.general.unassigned'))}}</td>
		</tr>
		{% if ticket.agent_team %}
			<tr>
				<td width="130">{{ phrase('agent.general.team') }}</td>
				<td>{{ticket.agent_team.name|default(phrase('agent.general.none'))}}</td>
			</tr>
		{% endif %}
		{% if ticket.category %}
			<tr>
				<td width="130">{{ phrase('agent.general.category') }}</td>
				<td>{{ticket.category.full_title|default(phrase('agent.general.none'))}}</td>
			</tr>
		{% endif %}
		{% if ticket.product %}
			<tr>
				<td width="130">{{ phrase('agent.general.product') }}</td>
				<td>{{ticket.product.title|default(phrase('agent.general.none'))}}</td>
			</tr>
		{% endif %}
		{% if ticket.priority %}
			<tr>
				<td width="130">{{ phrase('agent.general.priority') }}</td>
				<td>{{ticket.priority.title|default(phrase('agent.general.none'))}}</td>
			</tr>
		{% endif %}
		{% if ticket.workflow %}
			<tr>
				<td width="130">{{ phrase('agent.general.workflow') }}</td>
				<td>{{ticket.workflow.title|default(phrase('agent.general.none'))}}</td>
			</tr>
		{% endif %}
		<tr>
			<td width="130">{{ phrase('agent.general.status') }}</td>
			<td>
				{{ phrase( 'agent.tickets.status_' ~ ticket.status) }}
			</td>
		</tr>
	</table>
	{% endset %}
	{{ layout.section('Ticket', content) }}
{% endif %}
<br/><br/>

{{ layout.render_ticket_messages(messages, phrase('agent.general.messages')) }}

<br/><br/>
{{ layout.replycode(tac.access_code) }}
{% endblock %}