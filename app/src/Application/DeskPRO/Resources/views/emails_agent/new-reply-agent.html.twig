{% set with_cutline = 1 %}
{% extends 'DeskPRO:emails_common:layout.html.twig' %}
{% import 'DeskPRO:emails_common:layout-macros.html.twig' as layout %}
{% block email_subject %}
	{% if new_message.is_agent_note %}{{ phrase('agent.emails.new_note_ticket_subject', { ticket_subject: ticket.subject, ticket_id: ticket.id }) }}
	{% else %}{{ phrase('agent.emails.new_agent_reply_ticket_subject', { ticket_subject: ticket.subject, ticket_id: ticket.id }) }}{% endif %}
{% endblock %}
{% block content %}

{% set content %}
	{{ phrase('agent.emails.reply_above_line') }}
	<br /><br />
	{{ layout.render_top_message(messages|first) }}
{% endset %}
{{ layout.section('', content) }}

<br/>

{% set content %}
	{{ phrase('agent.emails.person_replied', {name: new_message.person.getDisplayName(), 'subject':ticket.subject}) }}

	<br /><br />

	{% include 'DeskPRO:emails_agent:ticket-props-table.html.twig' %}
{% endset %}
{{ layout.section(phrase('agent.emails.section_ticket'), content) }}

<br/><br/>

{% set content %}
	{% for log in ticket_logs %}
		{% include 'DeskPRO:emails_agent:ticket-log-actiontext.html.twig' %}
	{% endfor %}
{% endset %}
{{ layout.section('Ticket Changes', content) }}

<br/><br/>

{{ layout.render_ticket_messages(messages, phrase('agent.general.message_history'), { ticketdisplay: ticketdisplay, show_author_email: true, skip_top: true, agent: true }) }}

<br/><br/>

{{ layout.replycode(tac.access_code) }}
{% endblock %}