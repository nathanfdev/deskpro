{% set with_cutline = 1 %}
{% extends 'DeskPRO:emails_common:layout.html.twig' %}
{% import 'DeskPRO:emails_common:layout-macros.html.twig' as layout %}
{% block email_subject %}
	{% if is_new_agent_reply %}
		{% if new_message.is_agent_note %}{{ phrase('agent.general.new_note_ticket_subject', { ticket_subject: ticket.subject }) }}
		{% else %}{{ phrase('agent.general.new_reply_ticket_subject', { ticket_subject: ticket.subject }) }}{% endif %}
	{% else %}{{ phrase('agent.general.new_reply_ticket_subject', { ticket_subject: ticket.subject }) }}
	{% endif %}
{% endblock %}
{% block content %}

{% set content %}
	{{ phrase('agent.emails.reply_above_line') }}
	<br /><br />

	{%- if is_new_agent_reply -%}{{ phrase('agent.emails.agent_replied', {'subject':ticket.subject}) }}
	{%- elseif is_new_user_reply -%}{{ phrase('agent.emails.user_replied', {'subject':ticket.subject}) }}
	{%- endif -%}
{% endset %}
{{ layout.section('', content) }}

<br />

{{ layout.render_ticket_messages(messages, '', { ticketdisplay: ticketdisplay, show_author_email: true, only_top: true }) }}

<br/>

{% set content %}
	{% include 'DeskPRO:emails_agent:ticket-props-table.html.twig' %}
{% endset %}
{{ layout.section(phrase('agent.emails.section_title_ticket_properties'), content) }}

<br/><br/>

{{ layout.render_ticket_messages(messages, phrase('agent.general.message_history'), { ticketdisplay: ticketdisplay, show_author_email: true, skip_top: true }) }}

<br/><br/>

{{ layout.replycode(tac.access_code) }}
{% endblock %}