{% extends 'DeskPRO:emails_common:layout.html.twig' %}
{% import 'DeskPRO:emails_common:layout-macros.html.twig' as layout %}
{% block email_subject %}
	Your new agent account
{% endblock %}
{% block content %}
	{% set phrase_part %}
		<a href="{{ app.getSetting('core.deskpro_url') }}">{{ app.getSetting('core.deskpro_url') }}</a>
	{% endset %}
	{{ phrase('agent.emails.ticket_created_link', {'link':phrase_part,'name':app.user.getDisplayName(),'email':app.user.primary_email_address}) }}
	<br /><br />

	<strong>{{ phrase('agent.emails.login_url') }}:</strong> <a href="{{ app.getSetting('core.deskpro_url') }}agent/">{{ app.getSetting('core.deskpro_url') }}agent/</a><br />
	<strong>{{ phrase('agent.general.your_email_address') }}:</strong> {{ agent.primary_email_address }}<br />
	<strong>{{ phrase('agent.emails.your_initial_password') }}:</strong> {{ agent.getPlaintextPassword() }}
{% endblock %}
