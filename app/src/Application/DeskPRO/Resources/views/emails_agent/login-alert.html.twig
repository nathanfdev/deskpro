{% extends 'DeskPRO:emails_common:layout.html.twig' %}
{% import 'DeskPRO:emails_common:layout-macros.html.twig' as layout %}
{% block email_subject %}
	{% if success %}
		{{ phrase('agent.emails.alert_successful_login') }}
	{% else %}
		{{ phrase('agent.emails.alert_failed_login') }}
	{% endif %}
{% endblock %}
{% block content %}
	{% set content %}
		{% if success %}
			{{ phrase('agent.emails.notice_account_used_to_login') }}<br />
		{% else %}
			{{ phrase('agent.emails.someone_tried_to_log_in_using_your_account') }}<br />
		{% endif %}

		{{ phrase('agent.emails.user_ip') }}: {{ session.visitor.ip_address }}<br />
		{{ phrase('agent.user_agent') }}: {{ session.visitor.user_agent }}<br />
		{{ phrase('agent.emails.referring_page') }}: {{ session.visitor.ref_page|default('n/a') }}<br />
		{{ phrase('agent.landing_page') }}: {{ session.visitor.landing_page|default('n/a') }}<br />
		{{ phrase('agent.emails.first_seen') }}: {{ session.visitor.date_created|date('fulltime') }}<br />
	{% endset %}
	{% if success %}
		{{ layout.section(phrase('agent.emails.alert_successful_login'), content) }}
	{% else %}
		{{ layout.section(phrase('agent.emails.alert_failed_login'), content) }}
	{% endif %}
{% endblock %}