{% extends 'DeskPRO:emails_common:layout.html.twig' %}
{% import 'DeskPRO:emails_common:layout-macros.html.twig' as layout %}}
{% block email_subject %}
	{% if success %}
		Successful login alert
	{% else %}
		Failed login attempt alert
	{% endif %}
{% endblock %}
{% block content %}
{% set content %}
	{% if success %}
		Your account was used to successfully log in.<br />
	{% else %}
		Someone tried to log in using your account.<br />
	{% endif %}

	User IP: {{ session.visitor.ip_address }}<br />
	User Agent: {{ session.visitor.user_agent }}<br />
	Referring Page: {{ session.visitor.ref_page|default('n/a') }}<br />
	Landing Page: {{ session.visitor.landing_page|default('n/a') }}<br />
	First Seen: {{ session.visitor.date_created|date('fulltime') }}<br />
{% endset %}
{% if success %}
	{{ layout.section('Successful Login Alert', content) }}
{% else %}
	{{ layout.section('Failed Login Attempt', content) }}
{% endif %}

{% endblock %}