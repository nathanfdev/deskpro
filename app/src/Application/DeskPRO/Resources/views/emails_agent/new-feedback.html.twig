<dp:is-noreply />
<dp:subject>
	New feedback: {{ feedback.title }} {% if feedback.getStatusCode() == 'hidden.validating' %}(requires validation){% endif %}
</dp:subject>
<dp:body>
	<dp:section>
		{{ feedback.person.getDisplayContact() }} has submitted new feedback "{{ feedback.title }}"
		{% if feedback.getStatusCode() == 'hidden.validating' %}that requires validation{% endif %}

		<br /><br />

		View online: <a href="{{ url_full('agent') }}#app.feedback,i:{{ feedback.id }}">{{ url_full('agent') }}#app.feedback,fb_content,i:{{ feedback.id }}</a>
	</dp:section>

	<dp:section>
		{{ feedback.getContent()|raw }}
	</dp:section>
</dp:body>