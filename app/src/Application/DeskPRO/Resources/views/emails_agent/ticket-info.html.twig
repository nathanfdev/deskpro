{% if access_code %}<!--ACCESS CODE: (#{{access_code}})-->{% endif %}
<table cellspacing="0" cellpadding="0" width="100%">
	<tr>
		<td width="50%">
			{{ phrase('deskpro.emails_agent.by_name', {'name':ticket.person.display_name}) }}
			<br>({{ticket.person.primary_email.email}})
		</td>
		<td width="50%">
			<table cellspacing="0" cellpadding="3" width="100%">
				<tr>
					<td width="130">{{ phrase('deskpro.emails_agent.agent') }}</td>
					<td>{{ticket.agent.display_name|default('None')}}</td>
				</tr>
				<tr>
					<td width="130">{{ phrase('deskpro.emails_agent.team') }}</td>
					<td>{{ticket.agent_team.name|default('None')}}</td>
				</tr>
				<tr>
					<td width="130">{{ phrase('deskpro.emails_agent.category') }}</td>
					<td>{{ticket.category.full_title|default('None')}}</td>
				</tr>
				<tr>
					<td width="130">{{ phrase('deskpro.emails_agent.product') }}</td>
					<td>{{ticket.product.title|default('None')}}</td>
				</tr>
				<tr>
					<td width="130">{{ phrase('deskpro.emails_agent.priority') }}</td>
					<td>{{ticket.priority.title|default('None')}}</td>
				</tr>
				<tr>
					<td width="130">{{ phrase('deskpro.emails_agent.workflow') }}</td>
					<td>{{ticket.workflow.title|default('None')}}</td>
				</tr>
				<tr>
					<td width="130">{{ phrase('deskpro.emails_agent.status') }}</td>
					<td>
						{% if not ticket.status or ticket.status == 'awaiting_agent' %}
							{{ phrase('deskpro.emails_agent.open') }}
						{% elseif ticket.status == 'awaiting_user' %}
                            {{ phrase('deskpro.emails_agent.pending') }}
						{% elseif ticket.status == 'resolved' %}
                            {{ phrase('deskpro.emails_agent.resolved') }}
						{% endif %}
					</td>
				</tr>
			</table>
		</td>
	</tr>
</table>
