{% set with_cutline = 1 %}
{% extends 'DeskPRO:emails_common:layout.html.twig' %}
{% import 'DeskPRO:emails_common:layout-macros.html.twig' as layout %}
{% block email_subject %}
	{% if ticket.agent.id == agent.id %}
		{{ phrase('agent.emails.subject_new_ticket_assigned', { ticket_subject: ticket.subject, ticket_id: ticket.id }) }}
	{% elseif ticket.agent_team and agent.isTeamMember(ticket.agent_team.id) %}
		{{ phrase('agent.emails.subject_new_ticket_assignedteam', { ticket_subject: ticket.subject, ticket_id: ticket.id }) }}
	{% else %}
		{{ phrase('agent.emails.subject_new_ticket', { ticket_subject: ticket.subject, ticket_id: ticket.id }) }}
	{% endif %}
{% endblock %}
{% block content %}

{% set content %}
	{{ phrase('agent.emails.reply_above_line') }}
	<br /><br />

{{ layout.render_top_message(messages|first) }}
{% endset %}
{{ layout.section('', content) }}

<br />

{% set content %}
	{{ phrase('agent.emails.ticket_was_created', {name: ticket.person.getDisplayContact()}) }}

	<br /><br />

	{% include 'DeskPRO:emails_agent:ticket-props-table.html.twig' %}
{% endset %}
{{ layout.section(phrase('agent.emails.section_ticket'), content) }}

{% endblock %}
{% block email_end %}
	<br/><br/>
	{{ layout.replycode(tac.access_code) }}
{% endblock %}