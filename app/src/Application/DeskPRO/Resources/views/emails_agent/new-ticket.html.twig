{% extends 'DeskPRO:emails_common:layout.html.twig' %}
{% import 'DeskPRO:emails_common:layout-macros.html.twig' as layout %}
{% block email_subject %}{{ phrase('agent.emails.subject_new_ticket', { ticket_subject: ticket.subject }) }}{% endblock %}
{% block content %}
{% set content %}{{ phrase('agent.emails.a_new_ticket_has_been_created') }}{% endset %}
{{ layout.section('', content) }}

{% set content %}
<table cellspacing="0" cellpadding="3" width="100%">
	<tr>
		<td width="130">{{ phrase('agent.agent') }}</td>
		<td>{{ticket.agent.display_name|default(phrase('agent.none'))}}</td>
	</tr>
	<tr>
		<td width="130">{{ phrase('agent.team') }}</td>
		<td>{{ticket.agent_team.name|default(phrase('agent.none'))}}</td>
	</tr>
	<tr>
		<td width="130">{{ phrase('agent.category') }}</td>
		<td>{{ticket.category.full_title|default(phrase('agent.none'))}}</td>
	</tr>
	<tr>
		<td width="130">{{ phrase('agent.product') }}</td>
		<td>{{ticket.product.title|default(phrase('agent.none'))}}</td>
	</tr>
	<tr>
		<td width="130">{{ phrase('agent.priority') }}</td>
		<td>{{ticket.priority.title|default(phrase('agent.none'))}}</td>
	</tr>
	<tr>
		<td width="130">{{ phrase('agent.workflow') }}</td>
		<td>{{ticket.workflow.title|default(phrase('agent.none'))}}</td>
	</tr>
	<tr>
		<td width="130">{{ phrase('agent.status') }}</td>
		<td>
			{% if not ticket.status or ticket.status == 'awaiting_agent' %}
            {{ phrase('agent.open') }}
            {% elseif ticket.status == 'awaiting_user' %}
            {{ phrase('agent.pending') }}
            {% elseif ticket.status == 'resolved' %}
            {{ phrase('agent.tickets.status_resolved') }}
            {% endif %}
		</td>
	</tr>
</table>
{% endset %}
{{ layout.section(phrase('agent.emails.section_title_ticket_properties'), content) }}

{{ layout.render_ticket_messages(messages, phrase('agent.messages')) }}

<br/><br/>
{{ layout.replycode(tac.access_code) }}
{% endblock %}