{% set agent_reply_above_line = true %}
<dp:subject>
	{{ phrase('agent.emails.new_user_reply_ticket_subject', { ticket_subject: ticket.subject, ticket_id: ticket.id }) }}
</dp:subject>
<dp:body>
	<dp:section>
		{% include 'DeskPRO:emails_common:ticket-message.html.twig' with {message: messages|first} %}
	</dp:section>

	<dp:section>
		<dp:section-header>Ticket</dp:section-header>
		{{ phrase('agent.emails.person_replied', {name: new_message.person.getDisplayContact(), 'subject':ticket.subject}) }}

		<br /><br />

		{% include 'DeskPRO:emails_agent:ticket-props-table.html.twig' %}
	</dp:section>

	<dp:section>
		<dp:section-header>Ticket Changes</dp:section-header>
		{% for log in ticket_logs %}
			{% include 'DeskPRO:emails_agent:ticket-log-actiontext.html.twig' %}
		{% endfor %}
	</dp:section>

	<dp:section>
		<dp:section-header>{{ phrase('agent.general.message_history') }}</dp:section-header>
		{% for message in messages|slice(1) %}
			{% include 'DeskPRO:emails_common:ticket-message-row.html.twig' with {
				message: message,
				show_author_email: true
			} %}
			<dp:spacer />
		{% endfor %}
	</dp:section>
</dp:body>