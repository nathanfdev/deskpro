{% extends 'DeskPRO:emails_common:layout.html.twig' %}
{% import 'DeskPRO:emails_common:layout-macros.html.twig' as layout %}
{% block email_subject %}
	{% if is_new_agent_reply %}{{ phrase('agent.general.new_reply_ticket_subject', { ticket_subject: ticket.subject }) }}
	{% else %}{{ phrase('agent.general.new_reply_ticket_subject', { ticket_subject: ticket.subject }) }}
	{% endif %}
{% endblock %}
{% block content %}
{{ phrase('agent.emails.reply_above_line') }}
<br /><br />

{% if is_new_agent_reply %}{{ phrase('agent.emails.agent_replied', {'subject':ticket.subject}) }}
{% elseif is_new_user_reply %}{{ phrase('agent.emails.user_replied', {'subject':ticket.subject}) }}
{% endif %}
<br /><br />

{{ layout.section('', content) }}

{% set content %}
<table cellspacing="0" cellpadding="3" width="100%">
	<tr>
		<td width="130">View Online</td>
		<td>
			<a href="{{ url_full('agent') }}#app.tickets,t:{{ ticket.id }}" style="{{ layout.link_style() }}">
				{{ url_full('agent') }}#app.tickets,t:{{ ticket.id }}
			</a>
		</td>
	</tr>
	<tr>
		<td width="130">{{ phrase('agent.general.id') }}</td>
		<td>{{ ticket.id }}</td>
	</tr>
	<tr>
		<td width="130">{{ phrase('agent.general.agent') }}</td>
		<td>{{ticket.agent.display_name|default(phrase('agent.general.none'))}}</td>
	</tr>
	<tr>
		<td width="130">{{ phrase('agent.general.team') }}</td>
		<td>{{ticket.agent_team.name|default(phrase('agent.general.none'))}}</td>
	</tr>
	<tr>
		<td width="130">{{ phrase('agent.general.category') }}</td>
		<td>{{ticket.category.full_title|default(phrase('agent.general.none'))}}</td>
	</tr>
	<tr>
		<td width="130">{{ phrase('agent.general.product') }}</td>
		<td>{{ticket.product.title|default(phrase('agent.general.none'))}}</td>
	</tr>
	<tr>
		<td width="130">{{ phrase('agent.general.priority') }}</td>
		<td>{{ticket.priority.title|default(phrase('agent.general.none'))}}</td>
	</tr>
	<tr>
		<td width="130">{{ phrase('agent.general.workflow') }}</td>
		<td>{{ticket.workflow.title|default(phrase('agent.general.none'))}}</td>
	</tr>
	<tr>
		<td width="130">{{ phrase('agent.general.status') }}</td>
		<td>
            {% if not ticket.status or ticket.status == 'awaiting_agent' %}
            {{ phrase('agent.general.open') }}
            {% elseif ticket.status == 'awaiting_user' %}
            {{ phrase('agent.general.pending') }}
            {% elseif ticket.status == 'resolved' %}
            {{ phrase('agent.tickets.status_resolved') }}
            {% endif %}
		</td>
	</tr>
</table>
{% endset %}
{{ layout.section(phrase('agent.emails.section_title_ticket_properties'), content) }}

{{ layout.render_ticket_messages(messages, phrase('agent.general.messages'), { ticketdisplay: ticketdisplay }) }}

<br/><br/>
{{ layout.replycode(tac.access_code) }}
{% endblock %}