{% extends 'DeskPRO:emails_common:layout.html.twig' %}
{% import 'DeskPRO:emails_common:layout-macros.html.twig' as layout %}
{% block email_subject %}
	{% if is_new_agent_reply %}{{ phrase('agent.global.new_reply_ticket_subject', { ticket_subject: ticket.subject }) }}
	{% else %}{{ phrase('agent.global.new_reply_ticket_subject', { ticket_subject: ticket.subject }) }}
	{% endif %}
{% endblock %}
{% block content %}

{% if is_new_agent_reply %}{{ phrase('agent.emails_agent.an_agent_has_replied', {'subject':ticket.subject}) }}
{% elseif is_new_user_reply %}{{ phrase('agent.emails_agent.a_user_has_replied', {'subject':ticket.subject}) }}
{% endif %}

{{ layout.section('', content) }}

{% set content %}
<table cellspacing="0" cellpadding="3" width="100%">
	<tr>
		<td width="130">{{ phrase('agent.global.agent') }}</td>
		<td>{{ticket.agent.display_name|default(phrase('agent.global.none'))}}</td>
	</tr>
	<tr>
		<td width="130">{{ phrase('agent.global.team') }}</td>
		<td>{{ticket.agent_team.name|default(phrase('agent.global.none'))}}</td>
	</tr>
	<tr>
		<td width="130">{{ phrase('agent.global.category') }}</td>
		<td>{{ticket.category.full_title|default(phrase('agent.global.none'))}}</td>
	</tr>
	<tr>
		<td width="130">{{ phrase('agent.global.product') }}</td>
		<td>{{ticket.product.title|default(phrase('agent.global.none'))}}</td>
	</tr>
	<tr>
		<td width="130">{{ phrase('agent.global.priority') }}</td>
		<td>{{ticket.priority.title|default(phrase('agent.global.none'))}}</td>
	</tr>
	<tr>
		<td width="130">{{ phrase('agent.global.workflow') }}</td>
		<td>{{ticket.workflow.title|default(phrase('agent.global.none'))}}</td>
	</tr>
	<tr>
		<td width="130">{{ phrase('agent.global.status') }}</td>
		<td>
            {% if not ticket.status or ticket.status == 'awaiting_agent' %}
            {{ phrase('agent.global.open') }}
            {% elseif ticket.status == 'awaiting_user' %}
            {{ phrase('agent.global.pending') }}
            {% elseif ticket.status == 'resolved' %}
            {{ phrase('agent.global.resolved') }}
            {% endif %}
		</td>
	</tr>
</table>
{% endset %}
{{ layout.section('Ticket Properties', content) }}

{{ layout.render_ticket_messages(messages, 'Messages') }}

<br/><br/>
{{ layout.replycode(tac.access_code) }}
{% endblock %}