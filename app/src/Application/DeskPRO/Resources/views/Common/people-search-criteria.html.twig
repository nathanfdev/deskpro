{% if id or classname %}
	{# if given an id or classname then we want a wrapper #}
	<div {% if id %}id="{{ id }}"{% endif %} class="{{ classname }}" style="display:none">
	<div class="row">
		<div class="term">
			<div class="remove">-</div>
			<div class="controls">
				<div class="type"></div>
				<div class="op"></div>
				<div class="options"></div>
			</div>
		</div>
	</div>
	<div class="type" title="{{ phrase('deskpro.common.choose_criteria') }}" data-rule-type="">
	</div>
{% endif %}

{% if 'person_organization' not in no_show_fields and term_options.organizations %}
<div class="type" title="{{ phrase('agent.global.organization') }}" {% if with_rule_group %}data-rule-group="Person"{% endif %} data-term-type="GenericMenuTerm" data-term-triggers="org,organization,company" data-rule-type="person_organization">
	<div class="op">
		<select name="op">
			<option value="is">{{ phrase('agent.global.is') }}</option>
			<option value="not">{{ phrase('agent.global.is_not') }}</option>
		</select>
	</div>
	<div class="options">
		<select name="organization">
			{% for id,title in term_options.organizations %}
			<option value="{{id}}">{{title}}</option>
			{% endfor %}
		</select>
	</div>
</div>
{% endif %}

