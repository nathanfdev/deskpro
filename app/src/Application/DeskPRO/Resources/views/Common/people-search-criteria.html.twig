{% if 'person_field' not in no_show_fields and term_options.custom_people_fields %}
	{% set op_lang = {'is': phrase('agent.global.is'), 'not': phrase('agent.global.is_not'), 'contains': phrase('agent.global.contains'), 'notcontains': phrase('agent.global.does_not_contain'), 'gt': 'is greater than', 'lt': 'is less than'} %}
	{% for field in term_options.custom_people_fields %}
	{% if field.field_def.getFilterCapabilities(search_context) %}
	<div class="type" title="{{ phrase('deskpro.common.field_name', {'field':field.field_def.title}) }}" data-rule-group="Person Fields" data-rule-type="person_field[{{field.field_def.id}}]">
		<div class="op">
			<select name="op">
				{% if search_context == 'filter' %}
					{% for op in field.field_def.getFilterCapabilities(search_context) %}
						<option value="{{op}}">{{op_lang[op]}}</option>
					{% endfor %}
				{% else %}
					{% for op in field.field_def.getSearchCapabilities(search_context) %}
						<option value="{{op}}">{{op_lang[op]}}</option>
					{% endfor %}
				{% endif %}
			</select>
		</div>
		<div class="options">
			{{ form_widget(field.formView) }}
		</div>
	</div>
	{% endif %}
	{% endfor %}
{% endif %}

{% if id or classname %}
	</div>
{% endif %}
