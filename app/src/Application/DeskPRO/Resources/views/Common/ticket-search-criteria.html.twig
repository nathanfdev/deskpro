{% if id or classname %}
	{# if given an id or classname then we want a wrapper #}
	<div {% if id %}id="{{ id }}"{% endif %} class="{{ classname }}" style="display:none">
	<div class="row">
		<div class="term">
			<div class="remove">-</div>
			<div class="controls">
				<div class="type"></div>
				<div class="op"></div>
				<div class="options"></div>
			</div>
		</div>
	</div>
	<div class="type" title="{{ phrase('deskpro.common.choose_criteria') }}" data-rule-type="">
	</div>
{% endif %}

	{% if 'action_performer' not in no_show_fields and 0 %}
		<div class="type" title="{{ phrase('deskpro.common.performer') }}" data-rule-type="action_performer">
			<div class="op">
				<select name="op" class="op">
					<option value="is">{{ phrase('deskpro.common.is') }}</option>
					<option value="not">{{ phrase('deskpro.common.is_not') }}</option>
				</select>
			</div>
			<div class="options">
				<select name="action_performer">
					<option value="agent">{{ phrase('deskpro.common.agent') }}</option>
					<option value="person">{{ phrase('deskpro.common.user') }}</option>
				</select>
			</div>
		</div>
	{% endif %}

	{% if 'is_new_user' not in no_show_fields and 'new_ticket' in event_group %}
	<div class="type" title="{{ phrase('deskpro.common.is_a_new_user') }}" data-rule-type="is_new_user">
		<div class="op">
			<input type="hidden" name="op" value="is" />
		</div>
		<div class="options">
			<input type="hidden" name="is_new_user" value="1" />
		</div>
	</div>
	<div class="type" title="{{ phrase('deskpro.common.is_not_a_new_user') }}" data-rule-type="is_not_new_user">
		<div class="op">
			<input type="hidden" name="op" value="is" />
		</div>
		<div class="options">
			<input type="hidden" name="is_not_new_user" value="1" />
		</div>
	</div>
	{% endif %}

	{% if 'creation_system' not in no_show_fields and 'new_ticket' not in event_group %}
	<div class="type" title="{{ phrase('deskpro.common.originated_interface') }}" data-rule-type="creation_system" data-term-type="GenericMenuTerm" data-term-triggers="interface,orig-interface,original-interface">
		<div class="op">
			<select name="op" class="op">
				<option value="is">{{ phrase('deskpro.common.is') }}</option>
				<option value="not">{{ phrase('deskpro.common.is_not') }}</option>
			</select>
		</div>
		<div class="options">
			<select name="creation_system">
				<option value="web">{{ phrase('deskpro.common.web_interface') }}</option>
				<option value="web.person">{{ phrase('deskpro.common._by_user') }}</option>
				<option value="widget.person">{{ phrase('deskpro.common.website_widget') }}</option>
				<option value="web.agent">{{ phrase('deskpro.common._by_agent_on_behalf_of_user') }}</option>
				<option value="gateway.person">{{ phrase('global.email') }}</option>
			</select>
		</div>
	</div>
	{% endif %}

	{% if 'gateway_address' not in no_show_fields and term_options.gateway_addresses %}
		<div class="type" title="{{ phrase('deskpro.common.ticket_gateway_address') }}" data-rule-type="gateway_address" data-term-type="GenericMenuTerm" data-term-triggers="gateway,address,gateway_address">
			<div class="op">
				<select name="op" class="op">
					<option value="is">{{ phrase('deskpro.common.is') }}</option>
					<option value="not">{{ phrase('deskpro.common.is_not') }}</option>
				</select>
			</div>
			<div class="options">
				<select name="gateway_address">
					{% for id,addr in term_options.gateway_addresses %}
						<option value="{{ id }}">{{ addr }}</option>
					{% endfor %}
				</select>
			</div>
		</div>
	{% endif %}

	{% if 'gateway_account' not in no_show_fields and term_options.gateway_accounts %}
		<div class="type" title="{{ phrase('deskpro.common.ticket_gateway_account') }}" data-rule-type="gateway_account" data-term-type="GenericMenuTerm" data-term-triggers="gateway,account,gateway_account">
			<div class="op">
				<select name="op" class="op">
					<option value="is">{{ phrase('deskpro.common.is') }}</option>
					<option value="not">{{ phrase('deskpro.common.is_not') }}</option>
				</select>
			</div>
			<div class="options">
				<select name="gateway_address">
					{% for id,name in term_options.gateway_accounts %}
					<option value="{{ id }}">{{ name }}</option>
					{% endfor %}
				</select>
			</div>
		</div>
	{% endif %}

	{% if 'subject' not in no_show_fields %}
	<div class="type" title="{{ phrase('deskpro.common.subject') }}" data-rule-type="subject">
		<div class="op">
			<select name="op" class="op">
				<option value="contains">{{ phrase('deskpro.common.contains') }}</option>
				<option value="not_contains">{{ phrase('deskpro.common.does_not_contain') }}</option>
				<option value="is">{{ phrase('deskpro.common.is') }}</option>
				<option value="not">{{ phrase('deskpro.common.is_not') }}</option>
			</select>
		</div>
		<div class="options">
			<input type="text" name="subject" value="" />
		</div>
	</div>
	{% endif %}

	{% if 'department' not in no_show_fields and term_options.departments_hierarchy %}
		<div class="type" title="{{ phrase('global.department') }}" data-rule-type="department" data-term-type="GenericMenuTerm" data-term-triggers="dep,department">
			<div class="op">
				<select name="op" class="op">
					<option value="is">{{ phrase('deskpro.common.is') }}</option>
					<option value="not">{{ phrase('deskpro.common.is_not') }}</option>
					{% if with_change_terms %}
						<option value="changed">{{ phrase('deskpro.common.changed') }}</option>
						<option value="changed_to">{{ phrase('deskpro.common.changed_to') }}</option>
						<option value="changed_from">{{ phrase('deskpro.common.changed_from') }}</option>
						<option value="not_changed_to">{{ phrase('deskpro.common.not_changed_to') }}</option>
						<option value="not_changed_from">{{ phrase('deskpro.common.not_changed_from') }}</option>
					{% endif %}
				</select>
			</div>
			<div class="options">
				<select name="department">
					{% for dep in term_options.departments_hierarchy %}
						<option value="{{dep.id}}">{{dep.title}}</option>
						{% if dep.children %}
							{% for subdep in dep.children %}
								<option data-full-title="{{ dep.title }} &gt; {{ subdep.title }}" value="{{subdep.id}}">-- {{subdep.title}}</option>
							{% endfor %}
						{% endif %}
					{% endfor %}
				</select>
			</div>
		</div>
	{% endif %}

	{% if 'agent' not in no_show_fields and (not event_trigger or event_trigger != 'new_ticket') %}
	<div class="type" title="{{ phrase('deskpro.common.assigned_agent') }}" data-rule-type="agent" data-term-type="GenericMenuTerm" data-term-triggers="agent">
		<div class="op">
			<select name="op" class="op">
				<option value="is">{{ phrase('deskpro.common.is') }}</option>
				<option value="not">{{ phrase('deskpro.common.is_not') }}</option>
				{% if with_change_terms %}
					<option value="changed">{{ phrase('deskpro.common.changed') }}</option>
					<option value="changed_to">{{ phrase('deskpro.common.changed_to') }}</option>
					<option value="changed_from">{{ phrase('deskpro.common.changed_from') }}</option>
					<option value="not_changed_to">{{ phrase('deskpro.common.not_changed_to') }}</option>
					<option value="not_changed_from">{{ phrase('deskpro.common.not_changed_from') }}</option>
				{% endif %}
			</select>
		</div>
		<div class="options">
			<select name="agent">
				<option value="0">{{ phrase('deskpro.common.unassigned') }}</option>
				<option value="-1">{{ phrase('deskpro.common.current_agent') }}</option>
				{% for id,label in term_options.agents %}
					<option value="{{id}}">{{label}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	{% endif %}

	{% if options.agent_teams and 'agent_team' not in no_show_fields and (not event_trigger or event_trigger != 'new_ticket') %}
		<div class="type" title="{{ phrase('deskpro.common.agent_team') }}" data-rule-type="agent_team" data-term-type="GenericMenuTerm" data-term-triggers="team,agent-team">
			<div class="op">
				<select name="op" class="op">
					<option value="is">{{ phrase('deskpro.common.is') }}</option>
					<option value="not">{{ phrase('deskpro.common.is_not') }}</option>
					{% if with_change_terms %}
						<option value="changed">{{ phrase('deskpro.common.changed') }}</option>
						<option value="changed_to">{{ phrase('deskpro.common.changed_to') }}</option>
						<option value="changed_from">{{ phrase('deskpro.common.changed_from') }}</option>
						<option value="not_changed_to">{{ phrase('deskpro.common.not_changed_to') }}</option>
						<option value="not_changed_from">{{ phrase('deskpro.common.not_changed_from') }}</option>
					{% endif %}
				</select>
			</div>
			<div class="options">
				<select name="agent_team">
					<option value="0">{{ phrase('deskpro.common.no_team') }}</option>
					<option value="-1">{{ phrase('deskpro.common.any_of_current_agents_teams') }}</option>
					{% for id,title in term_options.agent_teams %}
						<option value="{{id}}">{{title}}</option>
					{% endfor %}
				</select>
			</div>
		</div>
	{% endif %}

	{% if 'participant' not in no_show_fields and (not event_trigger or event_trigger != 'new_ticket') %}
	<div class="type" title="{{ phrase('deskpro.common.followers') }}" data-rule-type="participant" data-term-type="GenericMenuTerm" data-term-triggers="followers">
		<div class="op">
			<select name="op" class="op">
				<option value="is">{{ phrase('deskpro.common.include') }}</option>
				<option value="not">{{ phrase('deskpro.common.does_not_include') }}</option>
				{% if with_change_terms %}
					<option value="changed">{{ phrase('deskpro.common.changed') }}</option>
					<option value="changed_to">{{ phrase('deskpro.common.changed_to_include') }}</option>
					<option value="changed_from">{{ phrase('deskpro.common.changed_to_remove') }}</option>
				{% endif %}
			</select>
		</div>
		<div class="options">
			<select name="agent">
				<option value="-1">{{ phrase('deskpro.common.current_agent') }}</option>
				{% for id,label in term_options.agents %}
					<option value="{{id}}">{{label}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	{% endif %}

	{% if 'label' not in no_show_fields and not event_trigger or event_trigger != 'new_ticket' %}
	<div class="type" title="{{ phrase('deskpro.common.labels') }}" data-rule-type="label" data-rule-handler="DeskPRO.Agent.RuleBuilder.LabelsTerm" data-label-type="tickets" data-term-type="GenericInputTerm" data-term-triggers="label,labelled,labels">
		<div class="op">
			<select name="op" class="op">
				<option value="is">{{ phrase('deskpro.common.is') }}</option>
				<option value="not">{{ phrase('deskpro.common.is_not') }}</option>
				{% if with_change_terms %}
					<option value="changed">{{ phrase('deskpro.common.changed') }}</option>
					<option value="changed_to">{{ phrase('deskpro.common.changed_to_include') }}</option>
					<option value="changed_from">{{ phrase('deskpro.common.changed_to_remove') }}</option>
				{% endif %}
			</select>
		</div>
		<div class="options">
			{% include 'DeskPRO:Common:rulebuilder-labels-options.html.twig' %}
		</div>
	</div>
	{% endif  %}

	{% if 'status' not in no_show_fields %}
	<div class="type" title="{{ phrase('deskpro.common.status') }}" data-rule-type="status" data-term-type="GenericMenuTerm" data-term-triggers="status">
		<div class="op">
			<select name="op" class="op">
				<option value="is">{{ phrase('deskpro.common.is') }}</option>
				<option value="not">{{ phrase('deskpro.common.is_not') }}</option>
				{% if with_change_terms %}
					<option value="changed">{{ phrase('deskpro.common.changed') }}</option>
					<option value="changed_to">{{ phrase('deskpro.common.changed_to') }}</option>
					<option value="changed_from">{{ phrase('deskpro.common.changed_from') }}</option>
					<option value="not_changed_to">{{ phrase('deskpro.common.not_changed_to') }}</option>
					<option value="not_changed_from">{{ phrase('deskpro.common.not_changed_from') }}</option>
				{% endif %}
			</select>
		</div>
		<div class="options">
			<select name="status">
				<option value="awaiting_agent">{{ phrase('deskpro.common.awaiting_agent') }}</option>
				<option value="awaiting_user">{{ phrase('deskpro.common.awaiting_user') }}</option>
				<option value="resolved">{{ phrase('deskpro.common.resolved') }}</option>
				<option value="closed">{{ phrase('deskpro.common.closed') }}</option>
				<option value="hidden">{{ phrase('deskpro.common.hidden_awaiting_validating_spam') }}</option>
			</select>
		</div>
	</div>
	{% endif %}

	{% if 'organization' not in no_show_fields and term_options.organizations %}
	<div class="type" title="{{ phrase('deskpro.common.organization') }}" data-term-type="GenericMenuTerm" data-term-triggers="org,organization,company" data-rule-type="organization">
		<div class="op">
			<select name="op">
				<option value="is">{{ phrase('deskpro.common.is') }}</option>
				<option value="not">{{ phrase('deskpro.common.is_not') }}</option>
			</select>
		</div>
		<div class="options">
			<select name="organization">
				{% for id,title in term_options.organizations %}
				<option value="{{id}}">{{title}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	{% endif %}

	{% if 'product' not in no_show_fields and term_options.products %}
		<div class="type" title="{{ phrase('deskpro.common.product') }}" data-rule-type="product" data-term-type="GenericMenuTerm" data-term-triggers="prod,product">
			<div class="op">
				<select name="op" class="op">
					<option value="is">{{ phrase('deskpro.common.is') }}</option>
					<option value="not">{{ phrase('deskpro.common.is_not') }}</option>
					{% if with_change_terms %}
						<option value="changed">{{ phrase('deskpro.common.changed') }}</option>
						<option value="changed_to">{{ phrase('deskpro.common.changed_to') }}</option>
						<option value="changed_from">{{ phrase('deskpro.common.changed_from') }}</option>
						<option value="not_changed_to">{{ phrase('deskpro.common.not_changed_to') }}</option>
						<option value="not_changed_from">{{ phrase('deskpro.common.not_changed_from') }}</option>
					{% endif %}
				</select>
			</div>
			<div class="options">
				<select name="product">
					{% for id,label in term_options.products %}
						<option value="{{id}}">{{label}}</option>
					{% endfor %}
				</select>
			</div>
		</div>
	{% endif %}

	{% if 'category' not in no_show_fields and term_options.categories %}
		<div class="type" title="{{ phrase('deskpro.common.category') }}" data-rule-type="category" data-term-type="GenericMenuTerm" data-term-triggers="cat,category">
			<div class="op">
				<select name="op" class="op">
					<option value="is">{{ phrase('deskpro.common.is') }}</option>
					<option value="not">{{ phrase('deskpro.common.is_not') }}</option>
					{% if with_change_terms %}
						<option value="changed">{{ phrase('deskpro.common.changed') }}</option>
						<option value="changed_to">{{ phrase('deskpro.common.changed_to') }}</option>
						<option value="changed_from">{{ phrase('deskpro.common.changed_from') }}</option>
						<option value="not_changed_to">{{ phrase('deskpro.common.not_changed_to') }}</option>
						<option value="not_changed_from">{{ phrase('deskpro.common.not_changed_from') }}</option>
					{% endif %}
				</select>
			</div>
			<div class="options">
				<select name="category">
					{% for id,label in term_options.categories %}
						<option value="{{id}}">{{label}}</option>
					{% endfor %}
				</select>
			</div>
		</div>
	{% endif %}

	{% if 'urgency' not in no_show_fields %}
	<div class="type" title="{{ phrase('deskpro.common.urgency') }}" data-rule-type="urgency" data-term-type="GenericInputTerm" data-term-triggers="urgency">
		<div class="op">
			<select name="op" class="op">
				<option value="is">{{ phrase('deskpro.common.is') }}</option>
				<option value="not">{{ phrase('deskpro.common.is_not') }}</option>
				<option value="lte">&lt;=</option>
				<option value="gte">&gt;=</option>
				{% if with_change_terms %}
					<optgroup label="{{ phrase('deskpro.common.changed') }}">
						<option value="changed">{{ phrase('deskpro.common.changed') }}</option>
						<option value="changed_to">{{ phrase('deskpro.common.changed_to') }}</option>
						<option value="changed_from">{{ phrase('deskpro.common.changed_from') }}</option>
						<option value="not_changed_to">{{ phrase('deskpro.common.not_changed_to') }}</option>
						<option value="not_changed_from">{{ phrase('deskpro.common.not_changed_from') }}</option>
					</optgroup>
					<optgroup label="Changed (ranged)">
						<option value="changed_to_gte">Changed to &gt;=</option>
						<option value="changed_to_lte">Changed to &lt;=</option>
						<option value="changed_from_gte">Changed from &gt;=</option>
						<option value="changed_from_lte">Changed from &lt;=</option>
						<option value="not_changed_to_gte">Not changed to &gt;=</option>
						<option value="not_changed_from_lte">Not changed from &lt;=</option>
					</optgroup>
				{% endif %}
			</select>
		</div>
		<div class="options">
			<input type="text" size="4" value="" name="num" />
		</div>
	</div>
	{% endif %}

	{% if 'priority' not in no_show_fields and term_options.priorities %}
		<div class="type" title="{{ phrase('deskpro.common.priority') }}" data-rule-type="priority" data-term-type="GenericMenuTerm" data-term-triggers="pri,priority">
			<div class="op">
				<select name="op" class="op">
					<option value="is">{{ phrase('deskpro.common.is') }}</option>
					<option value="not">{{ phrase('deskpro.common.is_not') }}</option>
					<option value="lte">{{ phrase('deskpro.common.is_less_than') }}</option>
					<option value="gte">{{ phrase('deskpro.common.is_greater_than') }}</option>
					{% if with_change_terms %}
						<option value="changed">{{ phrase('deskpro.common.changed') }}</option>
						<option value="changed_to">{{ phrase('deskpro.common.changed_to') }}</option>
						<option value="changed_from">{{ phrase('deskpro.common.changed_from') }}</option>
						<option value="not_changed_to">{{ phrase('deskpro.common.not_changed_to') }}</option>
						<option value="not_changed_from">{{ phrase('deskpro.common.not_changed_from') }}</option>
					{% endif %}
				</select>
			</div>
			<div class="options">
				<select name="priority">
					{% for id,label in term_options.priorities %}
						<option value="{{id}}">{{label}}</option>
					{% endfor %}
				</select>
			</div>
		</div>
	{% endif %}

	{% if 'workflow' not in no_show_fields and term_options.ticket_workflows %}
		<div class="type" title="{{ phrase('deskpro.common.workflow') }}" data-rule-type="workflow" data-term-type="GenericMenuTerm" data-term-triggers="work,workflow">
			<div class="op">
				<select name="op" class="op">
					<option value="is">{{ phrase('deskpro.common.is') }}</option>
					<option value="not">{{ phrase('deskpro.common.is_not') }}</option>
					{% if with_change_terms %}
						<option value="changed">{{ phrase('deskpro.common.changed') }}</option>
						<option value="changed_to">{{ phrase('deskpro.common.changed_to') }}</option>
						<option value="changed_from">{{ phrase('deskpro.common.changed_from') }}</option>
						<option value="not_changed_to">{{ phrase('deskpro.common.not_changed_to') }}</option>
						<option value="not_changed_from">{{ phrase('deskpro.common.not_changed_from') }}</option>
					{% endif %}
				</select>
			</div>
			<div class="options">
				<select name="workflow">
					{% for id,label in term_options.ticket_workflows %}
						<option value="{{id}}">{{label}}</option>
					{% endfor %}
				</select>
			</div>
		</div>
	{% endif %}

	{% if 'language' not in no_show_fields and term_options.languages %}
	<div class="type" title="{{ phrase('deskpro.common.language') }}" data-term-type="GenericMenuTerm" data-rule-type="language" data-term-triggers="lang,language">
		<div class="op">
			<select name="op">
				<option value="is">{{ phrase('deskpro.common.is') }}</option>
				<option value="not">{{ phrase('deskpro.common.is_not') }}</option>
			</select>
		</div>
		<div class="options">
			<select name="language">
				{% for id,title in term_options.languages %}
				<option value="{{id}}">{{title}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	{% endif %}

	{% if 'date_created' not in no_show_fields and (not event_trigger or event_trigger != 'new_ticket') %}
	<div class="type" title="{{ phrase('deskpro.common.date_created') }}" data-rule-type="date_created" data-rule-handler="DeskPRO.Agent.RuleBuilder.DateTerm" data-term-type="GenericDateTerm" data-term-triggers="date-created">
		<div class="op">
			<select name="op" class="op">
				<option value="lte">{{ phrase('deskpro.common.before') }}</option>
				<option value="gte">{{ phrase('deskpro.common.after') }}</option>
				<option value="between">{{ phrase('deskpro.common.between') }}</option>
			</select>
		</div>
		<div class="options">
			{% include 'DeskPRO:Common:rulebuilder-date-options.html.twig' %}
		</div>
	</div>
	{% endif %}

    {% if 'time_created' not in no_show_fields and (not event_trigger or event_trigger != 'new_ticket') %}
    <div class="type" title="{{ phrase('deskpro.common.time_created') }}" data-rule-type="time_created">
        <div class="op">
            <select name="op" class="op">
                <option value="before">{{ phrase('deskpro.common.before') }}</option>
                <option value="after">{{ phrase('deskpro.common.after') }}</option>
            </select>
        </div>
        <div class="options">
            <label>{{ phrase('deskpro.common.hour') }}</label>
            <select name="hour1">
                {% for hour in range(0,23) %}
                <option>{{ '%02s'|format(hour) }}</option>
                {% endfor %}
            </select>
            <label>{{ phrase('deskpro.common.minute') }}</label>
            <select name="minute1">
                {% for minute in range(0,59) %}
                <option>{{ '%02s'|format(minute) }}</option>
                {% endfor %}
            </select>
        </div>
    </div>
    {% endif %}

    {% if 'time_user_reply' not in no_show_fields and (not event_trigger or event_trigger != 'new_ticket') %}
    <div class="type" title="{{ phrase('deskpro.common.time_of_last_user_reply') }}" data-rule-type="time_user_replied">
        <div class="op">
            <select name="op" class="op">
                <option value="before">{{ phrase('deskpro.common.before') }}</option>
                <option value="after">{{ phrase('deskpro.common.after') }}</option>
            </select>
        </div>
        <div class="options">
            <label>{{ phrase('deskpro.common.hour') }}</label>
            <select name="hour1">
                {% for hour in range(0,23) %}
                <option>{{ '%02s'|format(hour) }}</option>
                {% endfor %}
            </select>
            <label>{{ phrase('deskpro.common.minute') }}</label>
            <select name="minute1">
                {% for minute in range(0,59) %}
                <option>{{ '%02s'|format(minute) }}</option>
                {% endfor %}
            </select>
        </div>
    </div>
    {% endif %}

    {% if 'day_created' not in no_show_fields and (not event_trigger or event_trigger != 'new_ticket') %}
    <div class="type" title="{{ phrase('deskpro.common.day_created') }}" data-rule-type="day_created">
        <div class="op">
            <select name="op" class="op">
                <option value="is">{{ phrase('deskpro.common.is') }}</option>
                <option value="not">{{ phrase('deskpro.common.is_not') }}</option>
            </select>
        </div>
        <div class="options">
            {% set days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'] %}
            {% for day in days %}
                <label>{{ day }}</label>
                <input type="checkbox" value="{{ day }}" name="days[]"/>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {% if 'day_last_user_reply' not in no_show_fields and (not event_trigger or event_trigger != 'new_ticket') %}
    <div class="type" title="{{ phrase('deskpro.common.day_last_user_reply') }}" data-rule-type="day_last_user_reply">
        <div class="op">
            <select name="op" class="op">
                <option value="is">{{ phrase('deskpro.common.is') }}</option>
                <option value="not">{{ phrase('deskpro.common.is_not') }}</option>
            </select>
        </div>
        <div class="options">
            {% set days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'] %}
            {% for day in days %}
                <label>{{ day }}</label>
                <input type="checkbox" value="{{ day }}" name="days[]"/>
            {% endfor %}
        </div>
    </div>
    {% endif %}

	{% if 'date_resolved' not in no_show_fields and (not event_trigger or event_trigger == 'time_resolved') %}
	<div class="type" title="{{ phrase('deskpro.common.date_resolved') }}" data-rule-type="date_resolved" data-rule-handler="DeskPRO.Agent.RuleBuilder.DateTerm" data-term-triggers="date-resolved">
		<div class="op">
			<select name="op" class="op">
				<option value="lte">{{ phrase('deskpro.common.before') }}</option>
				<option value="gte">{{ phrase('deskpro.common.after') }}</option>
				<option value="between">{{ phrase('deskpro.common.between') }}</option>
			</select>
		</div>
		<div class="options">
			{% include 'DeskPRO:Common:rulebuilder-date-options.html.twig' %}
		</div>
	</div>
	{% endif %}

	{% if 'date_closed' not in no_show_fields and not event_trigger %}
	<div class="type" title="{{ phrase('deskpro.common.date_closed') }}" data-rule-type="date_closed" data-rule-handler="DeskPRO.Agent.RuleBuilder.DateTerm">
		<div class="op">
			<select name="op" class="op">
				<option value="lte">{{ phrase('deskpro.common.before') }}</option>
				<option value="gte">{{ phrase('deskpro.common.after') }}</option>
				<option value="between">{{ phrase('deskpro.common.between') }}</option>
			</select>
		</div>
		<div class="options">
			{% include 'DeskPRO:Common:rulebuilder-date-options.html.twig' %}
		</div>
	</div>
	{% endif %}

	{% if 'date_last_agent_reply' not in no_show_fields and (not event_trigger or event_trigger != 'new_ticket') %}
	<div class="type" title="{{ phrase('deskpro.common.date_of_last_agent_reply') }}" data-rule-type="date_last_agent_reply" data-rule-handler="DeskPRO.Agent.RuleBuilder.DateTerm">
		<div class="op">
			<select name="op" class="op">
				<option value="lte">{{ phrase('deskpro.common.before') }}</option>
				<option value="gte">{{ phrase('deskpro.common.after') }}</option>
				<option value="between">{{ phrase('deskpro.common.between') }}</option>
			</select>
		</div>
		<div class="options">
			{% include 'DeskPRO:Common:rulebuilder-date-options.html.twig' %}
		</div>
	</div>
	{% endif %}

	{% if 'date_last_user_reply' not in no_show_fields %}
	<div class="type" title="{{ phrase('deskpro.common.date_of_last_user_reply') }}" data-rule-type="date_last_user_reply" data-rule-handler="DeskPRO.Agent.RuleBuilder.DateTerm">
		<div class="op">
			<select name="op" class="op">
				<option value="lte">{{ phrase('deskpro.common.before') }}</option>
				<option value="gte">{{ phrase('deskpro.common.after') }}</option>
				<option value="between">{{ phrase('deskpro.common.between') }}</option>
			</select>
		</div>
		<div class="options">
			{% include 'DeskPRO:Common:rulebuilder-date-options.html.twig' %}
		</div>
	</div>
	{% endif %}

	{% if 'robot_email' not in no_show_fields and event_trigger == 'new_ticket' or event_trigger == 'new_reply'  %}
	<div class="type" title="{{ phrase('deskpro.common.email_is_sent_from_a_robot') }}" data-rule-type="robot_email">
		<div class="op">
			<input type="hidden" name="op" value="is" />
		</div>
		<div class="options">
			<input type="hidden" name="is_robot_email" value="1" />
		</div>
	</div>
	{% endif %}

	{% if 'ticket_field' not in no_show_fields and term_options.custom_ticket_fields %}
		{% set op_lang = {'is': phrase('deskpro.common.is'), 'not': phrase('deskpro.common.is_not'), 'contains': phrase('deskpro.common.contains'), 'notcontains': phrase('deskpro.common.does_not_contain'), 'gt': phrase('deskpro.common.is_greater_than'), 'lt': phrase('deskpro.common.is_less_than') } %}
		{% for field in term_options.custom_ticket_fields %}
			{% if field.field_def.getFilterCapabilities(search_context) %}
			<div class="type" title="{{field.field_def.title}}" data-rule-group="Ticket Fields" data-rule-type="ticket_field[{{field.field_def.id}}]">
				<div class="op">
					<select name="op" class="op">
						{% if search_context == 'filter' %}
							{% for op in field.field_def.getFilterCapabilities(search_context) %}
								<option value="{{op}}">{{op_lang[op]}}</option>
							{% endfor %}
						{% else %}
							{% for op in field.field_def.getSearchCapabilities(search_context) %}
								<option value="{{op}}">{{op_lang[op]}}</option>
							{% endfor %}
						{% endif %}
					</select>
				</div>
				<div class="options">
					{{ form_widget(field.formView) }}
				</div>
			</div>
			{% endif %}
		{% endfor %}
	{% endif %}

	{% if 'person' not in no_show_fields %}
		{% include 'DeskPRO:Common:people-search-criteria.html.twig' with {'with_rule_group': true, 'term_options': people_term_options, 'id': false, 'classname': false} %}
	{% endif %}

{% if id or classname %}
</div>
{% endif %}
