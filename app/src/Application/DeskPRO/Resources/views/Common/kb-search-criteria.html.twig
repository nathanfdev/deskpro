{% if id or classname %}
	{# if given an id or classname then we want a wrapper #}
	<div {% if id %}id="{{ id }}"{% endif %} class="{{ classname }}" style="display:none">
	<div class="row">
		<div class="term">
			<div class="remove">-</div>
			<div class="controls">
				<div class="type"></div>
				<div class="op"></div>
				<div class="options"></div>
			</div>
		</div>
	</div>
	<div class="type" title="{{ phrase('agent.choose_criteria') }}" data-rule-type="">
	</div>
{% endif %}
<div class="type" title="{{ phrase('agent.category') }}" data-rule-type="category">
	<div class="op">
		<select name="op" class="op">
			<option value="is">{{ phrase('agent.is') }}</option>
			<option value="not">{{ phrase('agent.is_not') }}</option>
		</select>
	</div>
	<div class="options">
		<select name="category">
			{% for cat in term_options.categories %}
				<option value="{{cat.id}}">{% if cat.depth %}{{ '--'|repeat(cat.depth) }} {%endif %}{{cat.title}}</option>
			{% endfor %}
		</select>
	</div>
</div>
<div class="type" title="{{ phrase('agent.status') }}" data-rule-type="status">
	<div class="op">
		<select name="op" class="op">
			<option value="is">{{ phrase('agent.is') }}</option>
			<option value="not">{{ phrase('agent.is_not') }}</option>
		</select>
	</div>
	<div class="options">
		<select name="status">
			<option value="published">{{ phrase('agent.publish.status_published') }}</option>
			<option value="archived">{{ phrase('agent.publish.status_archived') }}</option>
			<option value="hidden">{{ phrase('agent.hidden') }}</option>
			<option value="hidden.unpublished">{{ phrase('agent.hidden_unpublished') }}</option>
			<option value="hidden.validating">{{ phrase('agent.hidden_validating') }}</option>
			<option value="hidden.deleted">{{ phrase('agent.hidden_deleted') }}</option>
		</select>
	</div>
</div>
<div class="type" title="{{ phrase('agent.date_created') }}" data-rule-type="date_created" data-rule-handler="DeskPRO.Agent.RuleBuilder.DateTerm">
	<div class="op">
		<select name="op" class="op">
			<option value="lte">{{ phrase('agent.before') }}</option>
			<option value="gte">{{ phrase('agent.after') }}</option>
			<option value="between">{{ phrase('agent.between') }}</option>
		</select>
	</div>
	<div class="options">
		{% include 'DeskPRO:Common:rulebuilder-date-options.html.twig' %}
	</div>
</div>
<div class="type" title="{{ phrase('agent.labels') }}" data-rule-type="label">
	<div class="op">
		<select name="op" class="op">
			<option value="is">{{ phrase('agent.include') }}</option>
			<option value="not">{{ phrase('agent.does_not_include') }}</option>
		</select>
	</div>
	<div class="options">
		<input type="text" name="label" value="" />
	</div>
</div>
{% if id or classname %}
</div>
{% endif %}