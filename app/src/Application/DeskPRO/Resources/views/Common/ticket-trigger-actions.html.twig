<div {% if id %}id="{{ id }}"{% endif %} class="{{ classname|default('actions-tpl') }}" style="display:none">
	<div class="row">
		<div class="term">
			<div class="remove">-</div>
			<div class="controls">
				<div class="type"></div>
				<div class="options"></div>
			</div>
		</div>
	</div>

	<div class="type" title="Set &quot;From&quot; address on email notifications" data-rule-type="set_from_address">
		<div class="options">
			<input type="text" name="email_address" />
		</div>
	</div>
	<div class="type" title="Stop processing other triggers" data-rule-type="stop_actions">
		<div class="options">
			<input type="hidden" name="stop_actions" value="1" />
		</div>
	</div>
	<div class="type" title="Set Agent" data-rule-type="agent">
		<div class="options">
			<select name="agent">
				{% for id,title in term_options.agents %}
					<option value="{{id}}">{{title}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	{% if term_options.agent_teams %}
	<div class="type" title="Set Agent Team" data-rule-type="agent_team">
		<div class="options">
			<select name="agent_team">
				{% for id,title in term_options.agent_teams %}
					<option value="{{id}}">{{title}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	{% endif %}
	<div class="type" title="Set Status" data-rule-type="status">
		<div class="options">
			<select name="status">
				<option value="awaiting_agent">{{ phrase('deskpro.common.awaiting_agent') }}</option>
				<option value="awaiting_user">{{ phrase('deskpro.common.awaiting_user') }}</option>
				<option value="resolved">{{ phrase('deskpro.common.resolved') }}</option>
			</select>
		</div>
	</div>
	<div class="type" title="Delete Ticket" data-rule-type="delete">
		<div class="options">
			<input type="hidden" name="delete_ticket" value="1" />
		</div>
	</div>
	<div class="type" title="Set Department" data-rule-type="department">
		<div class="options">
			<select name="department">
				{% for id,title in term_options.departments %}
					<option value="{{id}}">{{title}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	{% if term_options.categories %}
		<div class="type" title="Set Category" data-rule-type="category">
			<div class="options">
				<select name="category">
					{% for id,label in term_options.categories %}
						<option value="{{id}}">{{label}}</option>
					{% endfor %}
				</select>
			</div>
		</div>
	{% endif %}
	{% if term_options.products %}
	<div class="type" title="Set Product" data-rule-type="product">
		<div class="options">
			<select name="product">
				{% for id,title in term_options.products %}
					<option value="{{id}}">{{title}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	{% endif %}
	{% if term_options.priorities %}
	<div class="type" title="Set Priority" data-rule-type="priority">
		<div class="options">
			<select name="priority">
				{% for id,title in term_options.priorities %}
					<option value="{{id}}">{{title}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	{% endif %}
	{% if term_options.ticket_workflows%}
	<div class="type" title="Set Workflow" data-rule-type="workflow">
		<div class="options">
			<select name="workflow">
				{% for id,title in term_options.ticket_workflows %}
					<option value="{{id}}">{{title}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	{% endif %}
	<div class="type" title="Add Labels" data-rule-type="add_labels" data-rule-handler="DeskPRO.Agent.RuleBuilder.LabelsTerm">
		<div class="options">
			{% include 'DeskPRO:Common:rulebuilder-labels-options.html.twig' %}
		</div>
	</div>
	<div class="type" title="Remove Labels" data-rule-type="remove_labels" data-rule-handler="DeskPRO.Agent.RuleBuilder.LabelsTerm">
		<div class="options">
			{% include 'DeskPRO:Common:rulebuilder-labels-options.html.twig' %}
		</div>
	</div>
	<div class="type" title="Set Flag" data-rule-type="flag">
		<div class="options">
			<select name="flag">
				<option value="blue">{{ phrase('deskpro.common.blue') }}</option>
				<option value="green">{{ phrase('deskpro.common.green') }}</option>
				<option value="orange">{{ phrase('deskpro.common.orange') }}</option>
				<option value="pink">{{ phrase('deskpro.common.pink') }}</option>
				<option value="purple">{{ phrase('deskpro.common.purple') }}</option>
				<option value="red">{{ phrase('deskpro.common.red') }}</option>
				<option value="yellow">{{ phrase('deskpro.common.yellow') }}</option>
			</select>
		</div>
	</div>
	<div class="type" title="Increase/Decrease Urgency" data-rule-type="urgency">
		<div class="options">
			<input type="text" name="num" /><small>{{ phrase('deskpro.common.enter_a_negative_number_to_have_urgency_decreased') }}</small>
		</div>
	</div>
	<div class="type" title="Set Urgency" data-rule-type="urgency_set">
		<div class="options">
			<input type="text" name="num" style="width: 50px" />
			{% if event_trigger != 'new_ticket' %}
			<select name="allow_lower">
				<option value="0">{{ phrase('deskpro.common.only_set_when_urgency_is_lower') }}</option>
				<option value="1">{{ phrase('deskpro.common.always_set_this_urgency') }}</option>
			</select>
			{% endif %}
		</div>
	</div>
	<div class="type" title="Add Ticket Reply" data-rule-type="reply">
		<div class="options" style="display:block">
			<textarea name="reply_text" cols="80" rows="4"></textarea>
		</div>
	</div>
	<div class="type" title="Disable all notifications" data-rule-type="disable_notifications">
		<div class="options" style="display:block">
			<input type="hidden" name="disable_notifications" value="1" />
		</div>
	</div>
	<div class="type" title="Disable user notifications" data-rule-type="disable_user_notifications">
		<div class="options" style="display:block">
			<input type="hidden" name="disable_user_notifications" value="1" />
		</div>
	</div>
	<div class="type" title="Disable agent notifications" data-rule-type="disable_agent_notifications">
		<div class="options" style="display:block">
			<input type="hidden" name="disable_agent_notifications" value="1" />
		</div>
	</div>
	<div class="type" title="Always notify agents" data-rule-type="add_agent_notify">
		<div class="options" style="display:block">
			<select name="codes[]" multiple="multiple" style="display: block">
				<optgroup label="Agents">
					<option value="assigned_agent">{{ phrase('deskpro.common.assigned_agent') }}</option>
					{% for k,v in term_options.agents %}
						<option value="agent.{{k}}">{{v}}</option>
					{% endfor %}
				</optgroup>
				<optgroup label="Teams">
					<option value="assigned_agent_team">{{ phrase('deskpro.common.assigned_team') }}</option>
					{% for k,v in term_options.agent_teams %}
						<option value="agent_team.{{k}}">{{v}}</option>
					{% endfor %}
				</optgroup>
			</select>
		</div>
	</div>

	{% if event_trigger == 'new_ticket' %}
		<div class="type" title="Agent Notification: new-ticket" data-rule-group="Email Templates" data-rule-type="agent_notify_newticket" data-rule-handler="DeskPRO.Admin.RuleBuilder.TemplateEdit">
			<div class="options" style="display: block">
				<span class="status-value menu-trigger" data-tpldir="emails_agent" data-tplprefix="ticket-new"></span>
			</div>
		</div>

		<div class="type" title="User Notification: new-ticket-autoreply" data-rule-group="Email Templates" data-rule-type="user_notify_newticket_autoreply" data-rule-handler="DeskPRO.Admin.RuleBuilder.TemplateEdit">
			<div class="options" style="display: block">
				<span class="status-value menu-trigger" data-tpldir="emails_user" data-tplprefix="new-ticket-autoreply"></span>
			</div>
		</div>

		<div class="type" title="User Notification: new-ticket-validate" data-rule-group="Email Templates" data-rule-type="user_notify_newticket_validate" data-rule-handler="DeskPRO.Admin.RuleBuilder.TemplateEdit">
			<div class="options" style="display: block">
				<span class="status-value menu-trigger" data-tpldir="emails_user" data-tplprefix="new-ticket-validate"></span>
			</div>
		</div>
	{% endif %}

	{% if event_trigger == 'new_reply' %}
		<div class="type" title="Agent Notification: new-reply" data-rule-group="Email Templates" data-rule-type="agent_notify_newreply">
			<div class="options" style="display: block">
				<select name="template">
					<option value="DeskPRO:emails_agent:new-reply.html.twig">DeskPRO:emails_agent:new-reply.html.twig</option>
				</select>
			</div>
		</div>

		<div class="type" title="User Notification: new-reply-autoreply" data-rule-group="Email Templates" data-rule-type="user_notify_newreply_autoreply">
			<div class="options" style="display: block">
				<select name="template">
					<option value="DeskPRO:emails_user:new-reply-autoreply.html.twig">DeskPRO:emails_user:new-reply-autoreply.html.twig</option>
				</select>
			</div>
		</div>

		<div class="type" title="User Notification: new-reply" data-rule-group="Email Templates" data-rule-type="user_notify_newreply">
			<div class="options" style="display: block">
				<select name="template">
					<option value="DeskPRO:emails_user:new-reply.html.twig">DeskPRO:emails_user:new-reply.html.twig</option>
				</select>
			</div>
		</div>
	{% endif %}

	{% if term_options.custom_ticket_fields %}
		{% for field in term_options.custom_ticket_fields %}
			{% if field.field_def.isFormField() %}
			<div class="type" title="Set {{field.field_def.title}}" data-rule-group="Ticket Fields" data-rule-type="ticket_field[{{field.field_def.id}}]">
				<div class="options">
					{{ form_widget(field.formView) }}
				</div>
			</div>
			{% endif %}
		{% endfor %}
	{% endif %}
	{% if term_options.custom_people_fields %}
		{% for field in term_options.custom_people_fields %}
			{% if field.field_def.isFormField() %}
			<div class="type" title="Set User Field: {{field.field_def.title}}" data-rule-group="User Fields"  data-rule-type="people_field[{{field.field_def.id}}]">
				<div class="options">
					{{ form_widget(field.formView) }}
				</div>
			</div>
			{% endif %}
		{% endfor %}
	{% endif %}
</div>
