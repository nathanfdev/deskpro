<div {% if id %}id="{{ id }}"{% endif %} class="{{ classname|default('actions-tpl') }}" style="display:none">
	<div class="row">
		<div class="term">
			<div class="remove">-</div>
			<div class="controls">
				<div class="type"></div>
				<div class="options"></div>
			</div>
		</div>
	</div>

	<div class="type" title="{{ phrase('agent.general.set_notifs_from_address') }}" data-rule-type="set_from_address">
		<div class="options">
			<input type="text" name="email_address" />
		</div>
	</div>
	<div class="type" title="{{ phrase('agent.general.set_notifs_from_name') }}" data-rule-type="set_from_name">
		<div class="options">
			<input type="text" name="name" />
		</div>
	</div>
	<div class="type" title="{{ phrase('agent.general.stop_processing_other_triggers') }}" data-rule-type="stop_actions">
		<div class="options">
			<input type="hidden" name="stop_actions" value="1" />
		</div>
	</div>

	{% if event_group in ['new_ticket.web_person', 'new_ticket.gateway_person', 'new_ticket.widget'] %}
		<div class="type" title="{{ phrase('agent.general.email_user_auto_new_ticket') }}" data-rule-type="set_email_template_user_new_ticket" data-rule-handler="DeskPRO.Admin.RuleBuilder.TemplateEdit">
			<div class="options newline" style="display: block">
				<input class="no-auto" type="hidden" name="tpl_type" value="user_new_ticket" />
				<input type="hidden" name="tpl" class="tpl-name" value="" />
				<span class="status-value menu-trigger" data-tpldir="emails_user" data-tplprefix="new-ticket"></span>
			</div>
		</div>
		<div class="type" title="{{ phrase('agent.general.email_user_validation_alert') }}" data-rule-type="set_email_template_user_new_ticket_validate" data-rule-handler="DeskPRO.Admin.RuleBuilder.TemplateEdit">
			<div class="options newline" style="display: block">
				<input class="no-auto" type="hidden" name="tpl_type" value="user_new_ticket_validate" />
				<input type="hidden" name="tpl" class="tpl-name" value="" />
				<span class="status-value menu-trigger" data-tpldir="emails_user" data-tplprefix="new-ticket-validate"></span>
			</div>
		</div>
		<div class="type" title="{{ phrase('agent.general.email_agent_new_ticket') }}" data-rule-type="set_email_template_agent_new_ticket" data-rule-handler="DeskPRO.Admin.RuleBuilder.TemplateEdit">
			<div class="options newline" style="display: block">
				<input class="no-auto" type="hidden" name="tpl_type" value="agent_new_ticket" />
				<input type="hidden" name="tpl" class="tpl-name" value="" />
				<span class="status-value menu-trigger" data-tpldir="emails_agent" data-tplprefix="new-ticket"></span>
			</div>
		</div>
	{% endif %}
	{% if event_group in ['new_ticket.agent'] %}
		<div class="type" title="{{ phrase('agent.general.email_user_new_ticket') }}" data-rule-type="set_email_template_user_new_ticket_agent" data-rule-handler="DeskPRO.Admin.RuleBuilder.TemplateEdit">
			<div class="options newline" style="display: block">
				<input class="no-auto" type="hidden" name="tpl_type" value="user_new_ticket_agent" />
				<input type="hidden" name="tpl" class="tpl-name" value="" />
				<span class="status-value menu-trigger" data-tpldir="emails_user" data-tplprefix="new-ticket-agent"></span>
			</div>
		</div>
		<div class="type" title="{{ phrase('agent.general.email_agent_new_ticket') }}" data-rule-type="set_email_template_agent_new_ticket" data-rule-handler="DeskPRO.Admin.RuleBuilder.TemplateEdit">
			<div class="options newline" style="display: block">
				<input class="no-auto" type="hidden" name="tpl_type" value="agent_new_ticket" />
				<input type="hidden" name="tpl" class="tpl-name" value="" />
				<span class="status-value menu-trigger" data-tpldir="emails_agent" data-tplprefix="new-ticket"></span>
			</div>
		</div>
	{% endif %}
	{% if event_group in ['new_reply.web_person', 'new_reply.gateway_person'] %}
		<div class="type" title="{{ phrase('agent.general.email_user_auto_new_reply') }}" data-rule-type="set_email_template_user_new_reply" data-rule-handler="DeskPRO.Admin.RuleBuilder.TemplateEdit">
			<div class="options newline" style="display: block">
				<input class="no-auto" type="hidden" name="tpl_type" value="user_new_reply_user" />
				<input type="hidden" name="tpl" class="tpl-name" value="" />
				<span class="status-value menu-trigger" data-tpldir="emails_user" data-tplprefix="new-reply-user"></span>
			</div>
		</div>
		<div class="type" title="{{ phrase('agent.general.email_agent_new_reply') }}" data-rule-type="set_email_template_agent_new_reply" data-rule-handler="DeskPRO.Admin.RuleBuilder.TemplateEdit">
			<div class="options newline" style="display: block">
				<input class="no-auto" type="hidden" name="tpl_type" value="agent_new_reply_user" />
				<input type="hidden" name="tpl" class="tpl-name" value="" />
				<span class="status-value menu-trigger" data-tpldir="emails_agent" data-tplprefix="new-reply-user"></span>
			</div>
		</div>
	{% endif %}
	{% if event_group in ['new_reply.agent'] %}
		<div class="type" title="{{ phrase('agent.general.email_user_new_agent_reply') }}" data-rule-type="set_email_template_user_new_reply_agent" data-rule-handler="DeskPRO.Admin.RuleBuilder.TemplateEdit">
			<div class="options newline" style="display: block">
				<input class="no-auto" type="hidden" name="tpl_type" value="user_new_reply_agent" />
				<input type="hidden" name="tpl" class="tpl-name" value="" />
				<span class="status-value menu-trigger" data-tpldir="emails_user" data-tplprefix="new-reply-agent"></span>
			</div>
		</div>
		<div class="type" title="{{ phrase('agent.general.email_agent_new_agent_reply') }}" data-rule-type="set_email_template_agent_new_reply" data-rule-handler="DeskPRO.Admin.RuleBuilder.TemplateEdit">
			<div class="options newline" style="display: block">
				<input class="no-auto" type="hidden" name="tpl_type" value="agent_new_reply_agent" />
				<input type="hidden" name="tpl" class="tpl-name" value="" />
				<span class="status-value menu-trigger" data-tpldir="email_agent" data-tplprefix="new-reply-agent"></span>
			</div>
		</div>
	{% endif %}

	{% if 'new_ticket' in event_group %}
	<div class="type" title="{{ phrase('agent.general.force_email_validation') }}" data-rule-type="force_email_validation">
		<div class="options">
			<input type="hidden" name="force_email_validation" value="1" />
		</div>
	</div>
	{% endif %}

	<div class="type" title="{{ phrase('agent.general.set_agent') }}" data-rule-type="agent">
		<div class="options">
			<select name="agent">
				{% for id,title in term_options.agents %}
					<option value="{{id}}">{{title}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	{% if term_options.agent_teams %}
	<div class="type" title="{{ phrase('agent.general.set_agent_team') }}" data-rule-type="agent_team">
		<div class="options">
			<select name="agent_team">
				{% for id,title in term_options.agent_teams %}
					<option value="{{id}}">{{title}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	{% endif %}
	<div class="type" title="{{ phrase('agent.general.set_status') }}" data-rule-type="status">
		<div class="options">
			<select name="status">
				<option value="awaiting_agent">{{ phrase('agent.tickets.status_awaiting_agent') }}</option>
				<option value="awaiting_user">{{ phrase('agent.tickets.status_awaiting_user') }}</option>
				<option value="resolved">{{ phrase('agent.tickets.status_resolved') }}</option>
			</select>
		</div>
	</div>
	<div class="type" title="{{ phrase('agent.general.delete_ticket') }}" data-rule-type="delete">
		<div class="options">
			<input type="hidden" name="delete_ticket" value="1" />
		</div>
	</div>
	<div class="type" title="{{ phrase('agent.general.set_department') }}" data-rule-type="department">
		<div class="options">
			<select name="department">
				{% for id,title in term_options.departments %}
					<option value="{{id}}">{{title}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	{% if term_options.ticket_categories %}
		<div class="type" title="{{ phrase('agent.general.set_category') }}" data-rule-type="category">
			<div class="options">
				<select name="category">
					{% for id,label in term_options.ticket_categories %}
						<option value="{{id}}">{{label}}</option>
					{% endfor %}
				</select>
			</div>
		</div>
	{% endif %}
	{% if term_options.products %}
	<div class="type" title="{{ phrase('agent.general.set_product') }}" data-rule-type="product">
		<div class="options">
			<select name="product">
				{% for id,title in term_options.products %}
					<option value="{{id}}">{{title}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	{% endif %}
	{% if term_options.priorities %}
	<div class="type" title="{{ phrase('agent.general.set_priority') }}" data-rule-type="priority">
		<div class="options">
			<select name="priority">
				{% for id,title in term_options.priorities %}
					<option value="{{id}}">{{title}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	{% endif %}
	{% if term_options.ticket_workflows%}
	<div class="type" title="{{ phrase('agent.general.set_workflow') }}" data-rule-type="workflow">
		<div class="options">
			<select name="workflow">
				{% for id,title in term_options.ticket_workflows %}
					<option value="{{id}}">{{title}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	{% endif %}
	<div class="type" title="{{ phrase('agent.general.add_labels') }}" data-rule-type="add_labels" data-rule-handler="DeskPRO.Agent.RuleBuilder.LabelsTerm">
		<div class="options">
			{% include 'DeskPRO:Common:rulebuilder-labels-options.html.twig' %}
		</div>
	</div>
	<div class="type" title="{{ phrase('agent.general.remove_labels') }}" data-rule-type="remove_labels" data-rule-handler="DeskPRO.Agent.RuleBuilder.LabelsTerm">
		<div class="options">
			{% include 'DeskPRO:Common:rulebuilder-labels-options.html.twig' %}
		</div>
	</div>
	<div class="type" title="{{ phrase('agent.general.set_flag') }}" data-rule-type="flag">
		<div class="options">
			<select name="flag">
				<option value="blue">{{ phrase('agent.general.flag_blue') }}</option>
				<option value="green">{{ phrase('agent.general.flag_green') }}</option>
				<option value="orange">{{ phrase('agent.general.flag_orange') }}</option>
				<option value="pink">{{ phrase('agent.general.flag_pink') }}</option>
				<option value="purple">{{ phrase('agent.general.flag_purple') }}</option>
				<option value="red">{{ phrase('agent.general.flag_red') }}</option>
				<option value="yellow">{{ phrase('agent.general.flag_yellow') }}</option>
			</select>
		</div>
	</div>
	<div class="type" title="{{ phrase('agent.general.increase_decrease_urgency') }}" data-rule-type="urgency">
		<div class="options">
			<input type="text" name="num" /><small>{{ phrase('agent.general.urgency_enter_negative_number') }}</small>
		</div>
	</div>
	<div class="type" title="{{ phrase('agent.general.set_urgency') }}" data-rule-type="urgency_set">
		<div class="options">
			<input type="text" name="num" style="width: 50px" />
			{% if event_trigger != 'new_ticket' %}
			<select name="allow_lower">
				<option value="0">{{ phrase('agent.general.notice_only_when_urgency_lower') }}</option>
				<option value="1">{{ phrase('agent.general.always_set_this_urgency') }}</option>
			</select>
			{% endif %}
		</div>
	</div>
	<div class="type" title="{{ phrase('agent.general.add_ticket_reply') }}" data-rule-type="reply">
		<div class="options" style="display:block">
			<textarea name="reply_text" cols="80" rows="4"></textarea>
		</div>
	</div>
	<div class="type" title="{{ phrase('agent.general.disable_all_notifications') }}" data-rule-type="disable_notifications">
		<div class="options" style="display:block">
			<input type="hidden" name="disable_notifications" value="1" />
		</div>
	</div>
	<div class="type" title="{{ phrase('agent.general.disable_user_notifications') }}" data-rule-type="disable_user_notifications">
		<div class="options" style="display:block">
			<input type="hidden" name="disable_user_notifications" value="1" />
		</div>
	</div>
	<div class="type" title="{{ phrase('agent.general.disable_agent_notifications') }}" data-rule-type="disable_agent_notifications">
		<div class="options" style="display:block">
			<input type="hidden" name="disable_agent_notifications" value="1" />
		</div>
	</div>
	<div class="type" title="{{ phrase('agent.general.always_notify_agents') }}" data-rule-type="add_agent_notify">
		<div class="options" style="display:block">
			<select name="codes[]" multiple="multiple" style="display: block">
				<optgroup label="Agents">
					<option value="assigned_agent">{{ phrase('agent.general.assigned_agent') }}</option>
					{% for k,v in term_options.agents %}
						<option value="agent.{{k}}">{{v}}</option>
					{% endfor %}
				</optgroup>
				<optgroup label="Teams">
					<option value="assigned_agent_team">{{ phrase('agent.general.assigned_team') }}</option>
					{% for k,v in term_options.agent_teams %}
						<option value="agent_team.{{k}}">{{v}}</option>
					{% endfor %}
				</optgroup>
			</select>
		</div>
	</div>

	{% if term_options.custom_ticket_fields %}
		{% for field in term_options.custom_ticket_fields %}
			{% if field.field_def.isFormField() %}
			<div class="type" title="{{ phrase('agent.general.set_field_name', {'field':field.field_def.title}) }}" data-rule-group="Ticket Fields" data-rule-type="ticket_field[{{field.field_def.id}}]">
				<div class="options">
					{{ form_widget(field.formView) }}
				</div>
			</div>
			{% endif %}
		{% endfor %}
	{% endif %}
	{% if term_options.custom_people_fields %}
		{% for field in term_options.custom_people_fields %}
			{% if field.field_def.isFormField() %}
			<div class="type" title="{{ phrase('agent.general.set_user_field_name', {'field':field.field_def.title}) }}" data-rule-group="User Fields"  data-rule-type="people_field[{{field.field_def.id}}]">
				<div class="options">
					{{ form_widget(field.formView) }}
				</div>
			</div>
			{% endif %}
		{% endfor %}
	{% endif %}
</div>
