{% if id or classname %}
	{# if given an id or classname then we want a wrapper #}
	<div {% if id %}id="{{ id }}"{% endif %} class="{{ classname }}" style="display:none">
	<div class="row">
		<div class="term">
			<div class="remove">-</div>
			<div class="controls">
				<div class="type"></div>
				<div class="op"></div>
				<div class="options"></div>
			</div>
		</div>
	</div>
	<div class="type" title="{{ phrase('deskpro.common.choose_criteria') }}" data-rule-type="">
	</div>
{% endif %}
<div class="type" title="{{ phrase('agent.global.category') }}" data-rule-type="category">
	<div class="op">
		<select name="op" class="op">
			<option value="is">{{ phrase('agent.global.is') }}</option>
			<option value="not">{{ phrase('agent.global.is_not') }}</option>
		</select>
	</div>
	<div class="options">
		<select name="category">
			{% for cat in term_options.categories %}
				<option value="{{cat.id}}">{% if cat.depth %}{{ '--'|repeat(cat.depth) }} {%endif %}{{cat.title}}</option>
			{% endfor %}
		</select>
	</div>
</div>
<div class="type" title="{{ phrase('deskpro.common.is_published') }}" data-rule-type="is_published">
	<div class="op">
		<input type="hidden" name="op" value="is" />
	</div>
	<div class="options">
		<input type="hidden" name="is_published" value="1" />
	</div>
</div>
<div class="type" title="{{ phrase('deskpro.common.is_not_published') }}" data-rule-type="is_not_published">
	<div class="op">
		<input type="hidden" name="op" value="is" />
	</div>
	<div class="options">
		<input type="hidden" name="is_not_published" value="1" />
	</div>
</div>
<div class="type" title="{{ phrase('deskpro.common.date_created') }}" data-rule-type="date_created" data-rule-handler="DeskPRO.Agent.RuleBuilder.DateTerm">
	<div class="op">
		<select name="op" class="op">
			<option value="lte">{{ phrase('deskpro.common.before') }}</option>
			<option value="gte">{{ phrase('deskpro.common.after') }}</option>
			<option value="between">{{ phrase('deskpro.common.between') }}</option>
		</select>
	</div>
	<div class="options">
		{% include 'DeskPRO:Common:rulebuilder-date-options.html.twig' %}
	</div>
</div>
<div class="type" title="{{ phrase('agent.global.labels') }}" data-rule-type="label">
	<div class="op">
		<select name="op" class="op">
			<option value="is">{{ phrase('agent.global.include') }}</option>
			<option value="not">{{ phrase('agent.global.does_not_include') }}</option>
		</select>
	</div>
	<div class="options">
		<input type="text" name="label" value="" />
	</div>
</div>
{% if id or classname %}
</div>
{% endif %}