<span class="status-value menu-trigger"></span>
<input type="hidden" class="date1-input" name="date1" value="" />
<input type="hidden" class="date2-input" name="date2" value="" />
<input type="hidden" class="date1-relative-input" name="date1_relative" value="" />
<input type="hidden" class="date1-relative-type" name="date1_relative_type" value="" />
<input type="hidden" class="date2-relative-input" name="date2_relative" value="" />
<input type="hidden" class="date2-relative-type" name="date2_relative_type" value="" />
<div class="date-wrap two" style="display: none">
	<div class="date1">
		<div class="date">
			<span class="switcher">{{ phrase('deskpro.common.relative_time') }}</span>
			<input type="text" class="date1-display" />
			<div class="widget"></div>
		</div>
		<div class="relative relative1" style="display: none;">
			<span class="switcher">{{ phrase('deskpro.common.calendar') }}</span>
			<input type="text" class="relative1-input" /><br />
			<select class="relative1-type">
				<option value="minutes">minutes</option>
				<option value="hours">hours</option>
				<option value="days">days</option>
				<option value="weeks">weeks</option>
				<option value="months">months</option>
				<option value="years">years</option>
			</select> {{ phrase('deskpro.common.ago') }}
		</div>
	</div>
	<div class="date2">
		<div class="date">
			<span class="switcher">{{ phrase('deskpro.common.relative_time') }}</span>
			<input type="text" class="date2-display" />
			<div class="widget"></div>
		</div>
		<div class="relative relative2" style="display: none;">
			<span class="switcher">{{ phrase('deskpro.common.calendar') }}</span>
			<input type="text" class="relative2-input" /><br />
			<select class="relative2-type">
				<option value="minutes">minutes</option>
				<option value="hours">hours</option>
				<option value="days">days</option>
				<option value="weeks">weeks</option>
				<option value="months">months</option>
				<option value="years">years</option>
			</select> {{ phrase('deskpro.common.ago') }}
		</div>
	</div>
</div>