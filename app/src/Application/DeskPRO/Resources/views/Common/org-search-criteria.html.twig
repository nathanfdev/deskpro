{% if id or classname %}
	{# if given an id or classname then we want a wrapper #}
	<div {% if id %}id="{{ id }}"{% endif %} class="{{ classname }}" style="display:none">
	<div class="row">
		<div class="term">
			<div class="remove">-</div>
			<div class="controls">
				<div class="type"></div>
				<div class="op"></div>
				<div class="options"></div>
			</div>
		</div>
	</div>
	<div class="type" title="{{ phrase('agent.choose_criteria') }}" data-rule-type="">
	</div>
{% endif %}

{% if 'org_date_created' not in no_show_fields %}
<div class="type" title="{{ phrase('agent.date_created') }}" {% if with_rule_group %}data-rule-group="Organization"{% endif %} data-rule-type="org_date_created" data-rule-handler="DeskPRO.Agent.RuleBuilder.DateTerm" data-term-triggers="created">
	<div class="op">
		<select name="op" class="op">
			<option value="lte">{{ phrase('agent.before') }}</option>
			<option value="gte">{{ phrase('agent.after') }}</option>
			<option value="between">{{ phrase('agent.between') }}</option>
		</select>
	</div>
	<div class="options">
		{% include 'DeskPRO:Common:rulebuilder-date-options.html.twig' %}
	</div>
</div>
{% endif %}

{% if 'org_email_domain' not in no_show_fields %}
<div class="type" title="{{ phrase('agent.email_domains') }}" {% if with_rule_group %}data-rule-group="Organization"{% endif %} data-rule-type="org_email_domain" data-term-type="GenericInputTerm" data-term-triggers="emaildomain">
	<div class="op">
		<select name="op">
			<option value="is">{{ phrase('agent.is') }}</option>
			<option value="not">{{ phrase('agent.is_not') }}</option>
		</select>
	</div>
	<div class="options">
		<input type="text" name="email_domain" value="" />
	</div>
</div>
{% endif %}

