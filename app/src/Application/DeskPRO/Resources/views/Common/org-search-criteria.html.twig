<div class="type" title="{{ phrase('agent.labels') }}" {% if with_rule_group %}data-rule-group="Organization"{% endif %} data-rule-type="org_label" data-term-type="GenericInputTerm" data-term-triggers="label,labelled,labels">
	<div class="op">
