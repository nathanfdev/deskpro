{% if 'org_field' not in no_show_fields %}
{% if term_options.custom_org_fields %}
	{% set op_lang = {'is': phrase('agent.is'), 'not': phrase('agent.is_not'), 'contains': phrase('agent.contains'), 'notcontains': phrase('agent.does_not_contain'), 'gt': 'is greater than', 'lt': 'is less than'} %}
	{% for field in term_options.custom_org_fields %}
	{% if field.field_def.getFilterCapabilities(search_context) %}
	<div class="type" title="{{field.field_def.title}}" data-rule-group="Organization Fields" data-rule-type="org_field[{{field.field_def.id}}]">
		<div class="op">
			<select name="op">
				{% if search_context == 'filter' %}
					{% for op in field.field_def.getFilterCapabilities(search_context) %}
						<option value="{{op}}">{{op_lang[op]}}</option>
					{% endfor %}
				{% else %}
					{% for op in field.field_def.getSearchCapabilities(search_context) %}
						<option value="{{op}}">{{op_lang[op]}}</option>
					{% endfor %}
				{% endif %}
			</select>
		</div>
		<div class="options">
			{{ form_widget(field.formView) }}
		</div>
	</div>
	{% endif %}
	{% endfor %}
{% endif %}
{% endif %}

{% if id or classname %}
	</div>
{% endif %}
