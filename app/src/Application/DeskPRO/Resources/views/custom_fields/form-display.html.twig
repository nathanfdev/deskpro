{% set field_input %}
	{% block field_input %}
		{{ form_widget(formView, {'attr':{'id': elId, 'class': field_def.getOption('custom_css_classname', '') }}) }}
	{% endblock %}
{% endset %}
{% block content %}
	<div class="{{field_type}}_{{field_def.id}} {{field_handler_name}} {% if field_handler_name == 'Date' %}datepicker{% endif %} form {{ field_def.getOption('custom_css_classname', '') }} customfield" id="{{elId}}_form_wrap">
        {{- field_input }}{{ field_def.getOption('html', '')|raw -}}
    </div>
{% endblock %}
