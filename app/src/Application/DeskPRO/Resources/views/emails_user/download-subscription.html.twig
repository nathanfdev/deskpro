<dp:subject>
	{% if new_downloads and updated_downloads %}
		{{ phrase('user.email_subjects.download_sub_new_and_updated') }}
	{% elseif new_downloads %}
		{{ phrase('user.email_subjects.download_sub_new') }}
	{% else %}
		{{ phrase('user.email_subjects.download_sub_updated') }}
	{% endif %}
</dp:subject>

{% if new_downloads %}
	<h1>{{ phrase('user.emails.download-new-downloads', {count: new_downloads|length}) }}</h1>
	<ul>
		{% for download in new_downloads %}
			<li><a href="{{ url_full('portal_download_view', {slug: download.getSlug()}) }}">{{ download.title }}</a></li>
		{% endfor %}
	</ul>
{% endif %}

{% if updated_downloads %}
	<h1>{{ phrase('user.emails.download-updated-downloads', {count: updated_downloads|length}) }}</h1>
	<ul>
		{% for download in updated_downloads %}
			<li><a href="{{ url_full('portal_download_view', {slug: download.getSlug()}) }}">{{ download.title }}</a></li>
		{% endfor %}
	</ul>
{% endif %}

<div class="dp-hr">&nbsp;</div>
{{ phrase('user.emails.downloads-explain', {unsubscribe_url: url_full('portal_download_unsubscribe_all'), deskpro_url: url_full('portal_index') }) }}
