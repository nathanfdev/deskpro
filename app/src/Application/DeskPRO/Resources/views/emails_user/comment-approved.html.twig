{##
 # Sent to a user after an agent approves their comment
 ##}
{% set is_noreply = true %}
{% extends 'DeskPRO:emails_common:layout.html.twig' %}
{% block email_subject %}
	{{ phrase('user.email_subjects.comment-approved') }}
{% endblock %}
{% block content %}
	{% set content = comment.getObject() %}{% set phrase_link %}<a href="{{ helpdesk_url(content.getLink(false)) }}">{{ content.title }}</a>{% endset %}
	{{ phrase('user.emails.comment_thank-you', {'link': phrase_link}) }}
	{{ phrase('user.emails.comment_approved') }}
{% endblock %}