{% extends 'DeskPRO:emails_user:layout.html.twig' %}
{% import 'DeskPRO:emails_user:layout-macros.html.twig' as layout %}
{% block content %}
	<!--ACCESS CODE: (#{{access_code_full}})-->
	{% if is_first %}
		{{ layout.section_start() }}
            {{ phrase('user.emails.added_to_ticket', {'name':ticket.person.display_name}) }}
		{{ layout.section_end() }}
	{% endif %}

	{{ layout.section_start(ticket.subject) }}
		{% for message in messages %}
			{{ message.message_html|raw }}
		{% endfor %}
	{{ layout.section_end() }}
{% endblock %}