{% extends 'DeskPRO:emails_common:layout.html.twig' %}
{% block email_subject %}
	{{ phrase('user.email_subjects.ticket_participant_added') }}
{% endblock %}
{% block content %}
	<!--ACCESS CODE: (#{{access_code_full}})-->
	{% if is_first %}
		<p>
            {{ phrase('user.emails.added_to_ticket', {'name':ticket.person.display_name}) }}
		</p>
	{% endif %}

	{% for message in messages %}
		{{ message.message_html|raw }}
	{% endfor %}
{% endblock %}