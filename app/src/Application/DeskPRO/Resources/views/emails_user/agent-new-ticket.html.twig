{% extends 'DeskPRO:emails_user:layout.html.twig' %}
{% import 'DeskPRO:emails_user:layout-macros.html.twig' as layout %}
{% block email_teaser_link %}
	{{ phrase('deskpro.emails_user.view_your_ticket_online_at') }}:<br />
	<a href="{{ url_full('user_tickets_view', {'ticket_ref': ticket.access_code}) }}">
		{{ url_display('user_tickets_view', {'ticket_ref': ticket.access_code}) }}
	</a>
{% endblock %}
{% block content %}
	{{ layout.section_start() }}
		An agent has created a new ticket for you. You can view this ticket online at any time
		by visiting
		<a href="{{ url_full('user_tickets_view', {'ticket_ref': ticket.access_code}) }}">
			{{ url_display('user_tickets_view', {'ticket_ref': ticket.access_code}) }}
		</a>
	{{ layout.section_end() }}

	{{ layout.section_start() }}
		{% for message in messages %}
			{{ message.message_html|raw }}
		{% endfor %}
	{{ layout.section_end() }}

	<br/><br/>
	(#{{ticket.access_code}})
{% endblock %}