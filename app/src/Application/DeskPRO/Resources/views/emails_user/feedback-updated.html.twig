{% extends 'DeskPRO:emails_user:layout.html.twig' %}
{% import 'DeskPRO:emails_user:layout-macros.html.twig' as layout %}
{% block email_teaser_link %}
	{{ phrase('user.emails_user.view_your_feedback_online_at') }}:<br />
	<a href="{{ url('user_feedback_view', {'slug': feedback.url_slug}) }}">
		{{ url('user_feedback_view', {'slug': feedback.url_slug}) }}
	</a>
{% endblock %}
{% block content %}
	{{ layout.section_start() }}
		{% if show == 'validated' %}
			Your submitted feedback "{{ feedback.title }}" has been validated and will now appear on our website.
		{% elseif show == 'closed' %}
        	Your submitted feedback "{{ feedback.title }}" was closed: {{ feedback.status_category.title }}
        {% elseif show == 'closed' %}
        	Your submitted feedback "{{ feedback.title }}" has been updated. It is now
        	filed under the new status "{{ feedback.status_category.title }}"
        {% endif %}
	{{ layout.section_end() }}

	{{ layout.section_start() }}
		Your feedback currently has <strong>{{ feedback.votes }}</strong> votes. View your feedback online at:<br />
		<a href="{{ url('user_feedback_view', {'slug': feedback.url_slug}) }}">
			{{ url('user_feedback_view', {'slug': feedback.url_slug}) }}
		</a>
	{{ layout.section_end() }}
{% endblock %}