{##
 # Sent to a user when their feedback status has been updated
 ##}

{% extends 'DeskPRO:emails_common:layout.html.twig' %}
{% block email_subject %}
	{{ phrase('user.email_subjects.feedback_updated') }}
{% endblock %}
{% block content %}
	<p>
		{% if show == 'validated' %}
	        {{ phrase('user.emails.feedback_published', {'title':feedback.title}) }}
		{% elseif show == 'closed' %}
            {{ phrase('user.emails.feedback_closed', {'title':feedback.title, 'status':feedback.status_category.title}) }}
        {% elseif show == 'closed' %}
            {{ phrase('user.emails.feedback_updated', {'title': feedback.title, 'status':feedback.statuscategory.title}) }}
        {% endif %}
	</p>
	<p>
        {{ phrase('user.emails.feedback_votes', {'count': feedback.votes}) }}
		<a href="{{ url('user_feedback_view', {'slug': feedback.url_slug}) }}">
			{{ url('user_feedback_view', {'slug': feedback.url_slug}) }}
		</a>
	</p>
{% endblock %}