{##
 # Sent to a user after an agent reset their password
 ##}

{% extends 'DeskPRO:emails_common:layout.html.twig' %}
{% block email_subject %}
	{{ phrase('user.email_subjects.password_agent-reset') }}
{% endblock %}
{% block content %}
	{{ phrase('user.emails.password_agent-reset') }}:
	<br /><br />
	<strong>{{ phrase('agent.general.url') }}: </strong> <a href="{{ url('user') }}">{{ url_display('user') }}</a><br />
	<strong>{{ phrase('agent.general.email_address') }}:</strong> {{ person.primary_email_address }}<br />
	<strong>{{ phrase('agent.general.password') }}:</strong> {{ person.plaintext_password }}
{% endblock %}
