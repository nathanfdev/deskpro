{% extends 'DeskPRO:emails_user:layout.html.twig' %}
{% import 'DeskPRO:emails_user:layout-macros.html.twig' as layout %}
{% block content %}
	{{ layout.section_start() }}
		{{ phrase('deskpro.emails_user.an_agent_has_reset_your_account_password_you') }}:
		<br /><br />
		<strong>{{ phrase('agent.global.url') }}: </strong> <a href="{{ url('user') }}">{{ url_display('user') }}</a><br />
		<strong>{{ phrase('agent.global.email_address') }}:</strong> {{ person.primary_email_address }}<br />
		<strong>{{ phrase('agent.global.password') }}:</strong> {{ person.plaintext_password }}
	{{ layout.section_end() }}
{% endblock %}
