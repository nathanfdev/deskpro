{% extends 'DeskPRO:emails_common:layout.html.twig' %}
{% import 'DeskPRO:emails_common:layout-macros.html.twig' as layout %}
{% block email_subject %}
	{{ phrase('user.email_subjects.password_reset') }}
{% endblock %}
{% block content %}
	{% set content %}
		{{ phrase('user.emails.password_reset') }}
		{% if person.is_agent %}
			<a href="{{ url_full('agent_login', {'reset_code': code}) }}">{{ url_full('agent_login', {'code': code}) }}</a>
		{% else %}
			<a href="{{ url_full('user_login_resetpass_newpass', {'code': code}) }}">{{ url_full('user_login_resetpass_newpass', {'code': code}) }}</a>
		{% endif %}
	{% endset %}
	{{ layout.section('', content) }}
{% endblock %}
