{% extends 'DeskPRO:emails_common:layout.html.twig' %}
{% import 'DeskPRO:emails_common:layout-macros.html.twig' as layout %}
{% block email_subject %}Reset Password{% endblock %}
{% block content %}
{% set content %}
{{ phrase('user.emails.requested_password_reset_click_following_link') }}
{% if person.is_agent %}
	<a href="{{ url_full('agent_login', {'reset_code': code}) }}">{{ url_display('agent_login', {'code': code}) }}</a>
{% else %}
	<a href="{{ url_full('user_login_resetpass_newpass', {'code': code}) }}">{{ url_display('user_login_resetpass_newpass', {'code': code}) }}</a>
{% endif %}
{% endset %}
{{ layout.section('', content) }}
{% endblock %}
