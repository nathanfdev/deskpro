<dp:subject>
	{% if new_articles and updated_articles %}
		{{ phrase('user.email_subjects.news_sub_new_and_updated') }}
	{% elseif new_articles %}
		{{ phrase('user.email_subjects.news_sub_new') }}
	{% else %}
		{{ phrase('user.email_subjects.news_sub_updated') }}
	{% endif %}
</dp:subject>

{% if new_articles %}
	<h1>{{ phrase('user.emails.news-new-articles', {count: new_articles|length}) }}</h1>
	<ul>
		{% for article in new_articles %}
			<li><a href="{{ url_full('portal_news_view', {slug: article.getSlug()}) }}">{{ article.title }}</a></li>
		{% endfor %}
	</ul>
{% endif %}

{% if updated_articles %}
	<h1>{{ phrase('user.emails.news-updated-articles', {count: updated_articles|length}) }}</h1>
	<ul>
		{% for article in updated_articles %}
			<li><a href="{{ url_full('portal_news_view', {slug: article.getSlug()}) }}">{{ article.title }}</a></li>
		{% endfor %}
	</ul>
{% endif %}

<div class="dp-hr">&nbsp;</div>
{{ phrase('user.emails.news-explain', {unsubscribe_url: url_full('portal_news_unsubscribe_all'), deskpro_url: url_full('portal_index') }) }}
