{% extends 'DeskPRO:emails_user:layout.html.twig' %}
{% import 'DeskPRO:emails_user:layout-macros.html.twig' as layout %}
{% block content %}
	{{ layout.section_start() }}
		{{ phrase('deskpro.emails_user.thank_you_for_chatting_with_us_here_is') }}
	{{ layout.section_end() }}

	{{ layout.section_start() }}
		{% for message in convo_messages|reverse %}
			<div class="message {% if message.is_sys %}sys{% elseif message.author.is_agent %}agent{% else %}user{% endif%}">
				<span class="author">{% if message.is_sys %}*{% else %}&lt;{{message.author_name}}&gt;{% endif %}</span>
				<span class="message">{{message.content}}</span>
			</div>
		{% endfor %}
	{{ layout.section_end() }}
{% endblock %}