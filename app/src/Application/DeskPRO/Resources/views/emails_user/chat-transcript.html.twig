{##
 # Sent to a user after they completed a chat and want an email transcript
 ##}

{% extends 'DeskPRO:emails_common:layout.html.twig' %}
{% block email_subject %}
	{{ phrase('user.email_subjects.chat_transcript') }}
{% endblock %}
{% block content %}
	<p>{{ phrase('user.emails.chat_transcript') }}</p>

	{% for message in convo_messages|reverse %}
		{% if message.is_sys %}
			<p>
				[{{ message.date_created|date('g:ia') }}] *
				{% if message.metadata.phrase_id %}
					{% if message.is_html %}
						{{ phrase('user.chat.'~ message.metadata.phrase_id, message.metadata) }}
					{% else %}
						{{ phrase('user.chat.'~ message.metadata.phrase_id, message.metadata)|e }}
					{% endif %}
				{% elseif message.is_html %}
					{{message.content|raw}}
				{% else %}
					{{message.content}}
				{% endif %}
			</p>
		{% elseif message.author.is_agent and message.author.id != convo.person.id %}
			<p style="background-color: #EDEDED">
				[{{ message.date_created|date('g:ia') }}] {{ message.author.display_name }}:
				{% if message.is_html %}
					{{message.content|raw}}
				{% else %}
					{{message.content}}
				{% endif %}
			</p>
		{% else %}
			<p style="background-color: #EDEDED">
				[{{ message.date_created|date('g:ia') }}] {{ phrase('user.chat.author_you') }}:
				{% if message.is_html %}
					{{message.content|raw}}
				{% else %}
					{{message.content}}
				{% endif %}
			</p>
		{% endif %}
	{% endfor %}
{% endblock %}