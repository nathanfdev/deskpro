{##
 # Sent to a user after they completed a chat and want an email transcript
 ##}

{% extends 'DeskPRO:emails_common:layout.html.twig' %}
{% block email_subject %}
	{{ phrase('user.email_subjects.chat_transcript') }}
{% endblock %}
{% block content %}
	<p>{{ phrase('user.emails.your_chat_transcript') }}</p>

	{% for message in convo_messages|reverse %}
		<div class="message {% if message.is_sys %}sys{% elseif message.author.is_agent %}agent{% else %}user{% endif%}">
			<span class="author">{% if message.is_sys %}*{% else %}&lt;{{message.author_name}}&gt;{% endif %}</span>
			<span class="message">{{message.content}}</span>
		</div>
	{% endfor %}
{% endblock %}