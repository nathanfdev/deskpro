<dp:subject>{{ phrase('user.email_subjects.re', {'subject':ticket.subject}) }}</dp:subject>
<dp:body>
	{{ layout.greeting(person) }}
	{{ phrase('user.emails.ticket_received') }}
	<br /><br />

	<dp:section>
		{% include 'DeskPRO:emails_common:ticket-message-row.html.twig' with {message: messages|first} %}
	</dp:section>
</dp:body>
<dp:bottom>
	{{ phrase('user.emails.ticket_access_ticket_online') }}
	<a href="{{ url_full('user_tickets_view', {'ticket_ref': ticket.access_code}) }}" style="{{ layout.info_link_style() }}">
		{{ url_full('user_tickets_view', {'ticket_ref': ticket.access_code}) }}
	</a>
</dp:bottom>