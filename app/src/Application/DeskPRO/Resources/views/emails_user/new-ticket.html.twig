{% extends 'DeskPRO:emails_common:layout.html.twig' %}
{% import 'DeskPRO:emails_common:layout-macros.html.twig' as layout %}
{% block email_subject %}
    {{ phrase('user.emails_user.re_subject', {'subject':ticket.subject}) }}
{% endblock %}
{% block content %}
	{% set content %}
		{{ layout.greeting(person) }}
		{{ phrase('user.emails_user.your_ticket_has_been_recieved_and_our_agents') }}
	{% endset %}
	{{ layout.section('', content) }}

	{{ layout.render_ticket_messages(messages) }}


	{% set content %}
        {{ phrase('user.global.view_and_manage_ticket_online') }}
		<a href="{{ url_full('user_tickets_view', {'ticket_ref': ticket.access_code}) }}" style="{{ layout.link_style() }}">
			{{ url_display('user_tickets_view', {'ticket_ref': ticket.access_code}) }}
		</a>
	{% endset %}
	{{ layout.info_section(content, {center: 1}) }}
{% endblock %}
{% block email_end %}
	<br/><br/>
	{{ layout.replycode(ticket.access_code) }}
{% endblock %}