<dp:subject>
	{% if validating == 'existing' or validating == 'new' %}
		{{ phrase('user.email_subjects.feedback_new-confirm') }}
	{% else %}
		{{ phrase('user.email_subjects.feedback_new') }}
	{% endif %}
</dp:subject>
{{ phrase('user.emails.feedback_thank-you', {'title':feedback.title}) }}

<br /><br />

{% if feedback.status == 'hidden' and not feedback.is_reviewed %}
	{{ phrase('user.emails.feedback_agent-validation') }}

	<br /><br />
{% endif %}

{% if validating %}
	{{ phrase('user.emails.feedback_validate-email') }}
	{{ verify_url }}
{% endif %}
