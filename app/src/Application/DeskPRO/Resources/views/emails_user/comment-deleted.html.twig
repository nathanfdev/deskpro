{##
 # Sent to a user after an agent deletes their comment awaiting validation.
 ##}

{% extends 'DeskPRO:emails_common:layout.html.twig' %}
{% block email_subject %}
	{{ phrase('user.email_subjects.comment-deleted') }}
{% endblock %}
{% block content %}
	{% set content = comment.getObject() %}{% set phrase_link %}<a href="{{ object_path(content) }}">{{ content.title }}</a>{% endset %}
	{{ phrase('user.emails.comment_thank-you', {'link': phrase_link}) }}
	{{ phrase('user.emails.comment_deleted') }}
{% endblock %}