{% extends 'DeskPRO:emails_common:layout.html.twig' %}
{% import 'DeskPRO:emails_common:layout-macros.html.twig' as layout %}
{% block email_subject %}
	{% if action == 'new_user_reply' %}{{ phrase('core_tickets_user_email.subject_new_reply', {ticket_subject: ticket.subject}) }}
	{% elseif action == 'new_agent_reply' %}{{ phrase('core_tickets_user_email.subject_new_reply', {ticket_subject: ticket.subject}) }}
	{% endif %}
{% endblock %}
{% block content %}
{% set content %}
{{ phrase('deskpro.emails_user.name_has_replied_to_your_ticket', {'name':new_message.person.display_name}) }}
<br /><br />
{{ phrase('deskpro.emails_user.you_can_view_ticket_by_visiting') }}
<a href="{{ url_full('user_tickets_view', {'ticket_ref': ticket.access_code}) }}">
	{{ url_display('user_tickets_view', {'ticket_ref': ticket.access_code}) }}
</a>
{% endset %}
{{ layout.section('', content) }}

{{ layout.render_ticket_messages(messages) }}

<br/><br/>
{{ layout.replycode(ticket.access_code) }}
{% endblock %}