{##
 # Sent to a user after they've posted new feedback
 ##}
{% set is_noreply = true %}
{% extends 'DeskPRO:emails_common:layout.html.twig' %}
{% block email_subject %}
	{{ phrase('user.email_subjects.feedback_new-disapproved') }}
{% endblock %}
{% block content %}
	<p>{{ phrase('user.emails.feedback_thank-you', {'title':feedback.title}) }}</p>
	<p>
		{% if reason %}
			{{ phrase('user.emails.feedback_disapproved') }}
		{% else %}
			{{ phrase('user.emails.feedback_disapproved-reason') }}
			<br /><br />
			{{ reason }}
		{% endif %}
	</p>
{% endblock %}
