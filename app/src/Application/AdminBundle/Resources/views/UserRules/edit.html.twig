{% extends 'AdminBundle::layout.html.twig' %}
{% block pagebar %}
	<ul>
		<li><a href="{{ path('admin_usergroups_new') }}">{{ phrase('admin.userrules.user_rules') }}</a></li>
		{% if rule.id %}
			<li>{{ phrase('admin.userrules.new_rule') }}</li>
		{% else %}
			<li>{{ phrase('admin.userrules.edit_rule') }}</li>
		{% endif %}
	</ul>
{% endblock %}
{% block page %}

<form action="{{ path('admin_userrules_edit', {'rule_id': rule.id|default(0)}) }}" method="post">
<input type="hidden" name="process" value="1" />
{{ form_token('edit_userrule') }}

<div class="dp-form">
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('admin.userrules.email_address_pattern') }}</label>
		</div>
		<div class="dp-form-input">
			<textarea name="rule[patterns_string]" placeholder="{{ phrase('admin.userrules.enter_a_pattern_one_per_line_example_examplecom') }}" rows="6" style="height: 115px">{{ rule.patterns_string }}</textarea>
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('admin.userrules.when_matching_add_user_to_usergroup') }}</label>
		</div>
		<div class="dp-form-input">
			<select name="rule[add_usergroup]">
				{% for id,name in usergroups %}
					<option value="{{ id }}" {% if rule.add_usergroup.id == id %}checked="checked"{% endif %}>{{ name }}</option>
				{% endfor %}
			</select>
		</div>
	</div>
</div>

<button class="btn primary save-trigger">{{ phrase('admin.global.save') }}</button>
</form>

{% if rule.id %}
	<div class="delete-link-wrap">
		<a href="{{ path('admin_userrules_delete', {'rule_id': rule.id, _dp_security_token: security_token('delete_userrule') }) }}">{{ phrase('admin.global.delete') }}</a>
	</div>
{% endif %}
{% endblock %}
