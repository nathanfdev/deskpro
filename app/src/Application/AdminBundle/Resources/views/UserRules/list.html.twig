{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% import 'AdminBundle:Common:admin-macros.html.twig' as admin %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/ElementHandler/TicketPriorityList.js') }}"></script>
{% endblock %}
{% block pagebar %}
	<nav>
		<ul>
			<li class="add"><a href="{{ path('admin_userrules_new') }}">Add New Rule</a></li>
		</ul>
	</nav>
	<ul>
		<li>User Rules</li>
	</ul>
{% endblock %}
{% block page %}
<div class="check-grid item-list">
	<table width="100%">
		<thead>
			<tr>
				<th style="text-align:left">&nbsp; Match</th>
				<th style="text-align:center" width="180">Actions</th>
				<th style="text-align:left" width="50">&nbsp;</th>
			</tr>
		</thead>
		<tbody>
			{% for rule in rules %}
				<tr>
					<td>
						{% for p in rule.email_patterns %}{{ p }}{% if not loop.last %},{% endif %}{% endfor %}
					</td>
					<td>
						{% if rule.add_usergroup %}Add to usergroup {{ rule.add_usergroup.title }}<br />{% endif %}
						{% if rule.add_organization %}Add to organization {{ rule.add_organization.title }}{% endif %}
					</td>
					<td style="padding: 3px 3px 0 0; text-align: right;">
						<a href="{{ path('admin_userrules_edit', {rule_id:rule.id}) }}"><span class="btn-edit-gear"></span></a>
					</td>
				</tr>
			{% else %}
				<tr>
			 		<td colspan="3">
						<p style="text-align: center">
							You haven't created any user rules yet.
						</p>
					</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
</div><br /><br />

{% if org_domains|length %}
	<p>
		These organizations have domain name associations. Users that register with an email address that match any of these domains will
		be added to the appropriate organization. You can add or modify these domain associations by editing the organization from the agent interface.
	</p>
	<div class="check-grid item-list">
	<table width="100%">
		<thead>
			<tr>
				<th style="text-align:left">&nbsp; Organization</th>
				<th style="text-align:left">Domains</th>
			</tr>
		</thead>
		<tbody>
			{% for info in org_domains %}
				<tr>
					<td>{{ info[0].name }}</td>
					<td>
						{% for d in info %}{{ d.domain }}{% if not loop.last %}, {% endif %}{% endfor %}
					</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
</div>
{% endif %}
{% endblock %}
