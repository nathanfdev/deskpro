{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block pagebar %}
     <nav>
          <ul>
               <li class="add"><a href="{{ path('admin_ticket_msgtpl_new') }}">New Message Template</a></li>
          </ul>
     </nav>
     <ul>
          <li>Ticket Message Templates</li>
     </ul>
{% endblock %}

{% block page %}

<div class="page-content agent-listing" style="padding:0;">
	<div class="content-table">
		<table width="100%">
			<thead>
				<tr>
					<th class="single-title">Message Template</th>
				</tr>
			</thead>
			<tbody>
				{% for id,title in message_templates %}
					<tr>
						<td class="title">
							<a href="{{ path('admin_ticket_msgtpl_edit', {id: id}) }}">{{ title }}</a>
						</td>
					</tr>
				{% else %}
					<tr>
						<td>
							You have not defined any ticket message templates.
							<a href="{{ path('admin_ticket_msgtpl_new') }}">Create a new one now</a>.
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
</div>
{% endblock %}
