{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block pagebar %}
     <nav>
          <ul>
               <li class="add"><a href="{{ path('admin_ticket_msgtpl_new') }}">New Message Template</a></li>
          </ul>
     </nav>
     <ul>
          <li>Ticket Message Templates</li>
     </ul>
{% endblock %}

{% block page %}

<div class="page-content agent-listing" style="padding:0;">
	<div class="content-table">
		<table width="100%">
			<thead>
				<tr>
					<th class="single-title" width="100%">Title</th>
					<th class="single-title" width="10">&nbsp;</th>
				</tr>
			</thead>
			<tbody>
				{% for msgtpl in message_templates %}
					<tr>
						<td class="title" valign="middle" style="vertical-align: middle;">
							<strong><a href="{{ path('admin_ticket_msgtpl_edit', {id: msgtpl.id}) }}">{{ msgtpl.title }}</a></strong>
							{% if msgtpl.department.full_title %}
								<div style="font-size: 11px; padding-top: 2px;">
									Department: {{ msgtpl.department.full_title }}
								</div>
							{% endif %}
						</td>
						<td valign="middle" style="vertical-align: middle;">
							<a href="{{ path('admin_ticket_msgtpl_edit', {id: msgtpl.id}) }}"><span class="btn-edit-gear"></span></a>
						</td>
					</tr>
				{% else %}
					<tr>
						<td>
							You have not defined any ticket message templates.
							<a href="{{ path('admin_ticket_msgtpl_new') }}">Create a new one now</a>.
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
</div>
{% endblock %}
