{% extends 'AdminBundle::layout.html.twig' %}
{% block pagetitle %}
	<h1>{{ phrase('admin.ticketcategories.delete_ticket_category') }}</h1>
	<nav>
		<a class="clean-white" href="{{ path('admin_ticketcats') }}">&larr; {{ phrase('admin.ticketcategories.back_to_ticket_categories') }}</a>
	</nav>
{% endblock %}
{% block page %}

{% if category.children|length %}
	<p>{{ phrase('admin.ticketcategories.are_you_sure_delete_top_level', {'title':category.title}) }}:</p>

	<ul class="bullet-list">
		{% for c in category.children %}
			<li>{{ c.title }}</li>
		{% endfor %}
	</ul>

	<p>{{ phrase('admin.ticketcategories.any_tickets_that_belong_to_any_of_these') }}</p>
{% else %}
	<p>{{ phrase('admin.ticketcategories.are_you_sure_delete', {'title':category.title}) }}</p>

	<p>{{ phrase('admin.ticketcategories.any_tickets_that_belong_this_category_will_have') }}</p>
{% endif %}

<a class="btn" href="{{ path('admin_ticketcats_dodel', {'category_id': category.id, 'security_token': security_token('delete_ticket_category')}) }}">{{ phrase('admin.global.yes_i_am_sure_i_want_to_delete') }}</a>

{% endblock %}
