{% extends 'AdminBundle::layout.html.twig' %}
{% block pagetitle %}
	<h1>{{ phrase('admin.ticketcategories.delete_ticket_category') }}</h1>
	<nav>
		<a class="clean-white" href="{{ path('admin_ticketcats') }}">&larr; Back to ticket categories</a>
	</nav>
{% endblock %}
{% block page %}

{% if category.children|length %}
	<p>Are you sure you want to delete the category "<strong>{{ category.title }}</strong>"? Since this is a top-level category, <strong>all of these child-products will be deleted too</strong>:</p>

	<ul class="bullet-list">
		{% for c in category.children %}
			<li>{{ c.title }}</li>
		{% endfor %}
	</ul>

	<p>{{ phrase('admin.ticketcategories.any_tickets_that_belong_to_any_of_these') }}</p>
{% else %}
	<p>Are you sure you want to delete the category "<strong>{{ category.title }}</strong>"?</p>

	<p>{{ phrase('admin.ticketcategories.any_tickets_that_belong_this_category_will_have') }}</p>
{% endif %}

<a class="btn" href="{{ path('admin_ticketcats_dodel', {'category_id': category.id, 'security_token': security_token('delete_ticket_category')}) }}">{{ phrase('admin.ticketcategories.yes_i_am_sure_i_want_to_delete') }}</a>

{% endblock %}
