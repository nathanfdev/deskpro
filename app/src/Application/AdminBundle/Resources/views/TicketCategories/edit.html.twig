{% extends 'AdminBundle::layout.html.twig' %}
{% block pagetitle %}
	<h1>{% if category.id %}Edit Category{% else %}New Category{% endif %}</h1>
	<nav>
		<a class="clean-white" href="{{ path('admin_ticketcats') }}">&larr; Back to categories</a>
	</nav>
{% endblock %}
{% block page %}

<form action="{{ path('admin_ticketcats_edit', {'category_id': category.id|default(0)}) }}" method="post">
<input type="hidden" name="process" value="1" />

<div class="dp-form">
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('global.title') }}</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.title) }}
		</div>
	</div>

	{% if form.parent %}
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('admin.ticketcategories.parent_category') }}</label>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.parent) }}
			</div>
		</div>
	{% endif %}
</div>

{{ form_rest(form) }}

<button class="btn primary save-trigger">{{ phrase('global.save') }}</button>
</form>

<div class="delete-link-wrap">
	<a href="{{ path('admin_ticketcats_del', {'category_id': category.id}) }}">{{ phrase('admin.ticketcategories.delete') }}</a>
</div>
{% endblock %}
