{% extends 'AdminBundle::layout.html.twig' %}
{% set page_handler = 'DeskPRO.Admin.ElementHandler.TicketTriggersPage' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/ElementHandler/TicketTriggersPage.js') }}"></script>
<script type="text/javascript">
	var UPDATE_ORDER_URL = '{{ path('admin_tickettriggers_updateorder') }}';
</script>
{% endblock %}
{% block pagebar %}
	<nav>
		<ul>
			<li class="add"><a href="{{ path('admin_tickettriggers_new_choosetype') }}">Add Trigger</a></li>
		</ul>
	</nav>
	<ul>
		<li>Triggers</li>
	</ul>
{% endblock %}
{% block page %}

{% macro trigger_row(trigger) %}
	<li class="item-row trigger-row is-trigger" data-trigger-id="{{ trigger.id }}">
		<div class="dp-block-controls">
			<ul>
				<li class="dp-edit"><a href="{{ path('admin_tickettriggers_edit', {'trigger_id': trigger.id}) }}" class="popout-trigger"><span></span></a></li>
				<li class="dp-move"><span></span></li>
			</ul>
		</div>
		{% if trigger.title %}<lable><h3>{{ trigger.title }}</h3></lable>{% endif %}
		<div class="trigger-desc">
			<div class="terms">
				<em class="op ctrl">if</em>
				{% for desc in trigger.getTermDescriptions() %}
					<span class="term">{{ desc }}</span>
					{% if not loop.last %}<em class="op">and</em>{% endif %}
				{% endfor %}
			</div>
			<div class="actions">
				<em class="op ctrl">then</em>
				{% for desc in trigger.getActionDescriptions() %}
					<span class="term">{{ desc|raw }}</span>
					{% if not loop.last %}<em class="op">and</em>{% endif %}
				{% endfor %}
			</div>
		</div>
	</li>
{% endmacro %}

{% if not triggers %}
<p>
	You haven't created any triggers yet. <a href="{{ path('admin_tickettriggers_new_choosetype') }}">Click here to create one now</a>.
</p>
{% endif %}

{% if triggers.new_ticket %}
<h2>New Ticket Triggers</h2>
<ul class="item-list trigger-set">
	{% for trigger in triggers.new_ticket %}
		{{ _self.trigger_row(trigger) }}
	{% endfor %}
</ul>
<br />
{% endif %}

{% if triggers.new_reply %}
<h2>New Repy Triggers</h2>
<ul class="item-list trigger-set">
	{% for trigger in triggers.new_reply %}
		{{ _self.trigger_row(trigger) }}
	{% endfor %}
</ul>
<br />
{% endif %}

{% if triggers.new_reply %}
<h2>Ticket Update Triggers</h2>
<ul class="item-list trigger-set">
	{% for trigger in triggers.property_change %}
		{{ _self.trigger_row(trigger) }}
	{% endfor %}
</ul>
<br />
{% endif %}

{% if triggers.time_open %}
<h2>Escalations based on the time a ticket has been open</h2>
<ul class="item-list">
	{% for trigger in triggers.time_open %}
		{{ _self.trigger_row(trigger) }}
	{% endfor %}
</ul>
<br />
{% endif %}

{% if triggers.time_user_waiting %}
<h2>Escalations based on the time a user has been waiting for a reply</h2>
<ul class="item-list">
	{% for trigger in triggers.time_user_waiting %}
		{{ _self.trigger_row(trigger) }}
	{% endfor %}
</ul>
<br />
{% endif %}

{% if triggers.time_total_user_waiting %}
<h2>Escalations based on the total time a user has been waiting in a ticket</h2>
<ul class="item-list">
	{% for trigger in triggers.time_total_user_waiting %}
		{{ _self.trigger_row(trigger) }}
	{% endfor %}
</ul>
<br />
{% endif %}

{% if triggers.time_agent_waiting %}
<h2>Escalations based on the total time an agent has been waiting for a user reply</h2>
<ul class="item-list">
	{% for trigger in triggers.time_agent_waiting %}
		{{ _self.trigger_row(trigger) }}
	{% endfor %}
</ul>
<br />
{% endif %}

{% if triggers.time_agent_waiting %}
<h2>Escalations based on the time a ticket was resolved</h2>
<ul class="item-list">
	{% for trigger in triggers.time_agent_waiting %}
		{{ _self.trigger_row(trigger) }}
	{% endfor %}
</ul>
{% endif %}

{% endblock %}
