{% extends 'AdminBundle::layout.html.twig' %}
{% set page_handler = 'DeskPRO.Admin.ElementHandler.TicketTriggersPage' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/ElementHandler/TicketTriggersPage.js') }}"></script>
<script type="text/javascript">
	var UPDATE_ORDER_URL = '{{ path('admin_tickettriggers_updateorder') }}';
</script>
{% endblock %}
{% block pagebar %}
<nav>
	<ul>
		<li class="add"><a href="{{ path('admin_tickettriggers_new_choosetype') }}">{{ phrase('admin.tickettriggers.add_trigger') }}</a></li>
	</ul>
</nav>
<ul>
	<li>{{ phrase('admin.global.triggers') }}</li>
</ul>
{% endblock %}
{% block page %}

{% macro trigger_row(index, trigger, time_explain_prefix) %}
<li class="item-row trigger-row is-trigger {% if trigger.is_enabled %}{% else %}off{% endif %}" id="trigger_{{ trigger.id }}" data-trigger-id="{{ trigger.id }}">
	<div class="dp-block-controls">
		<ul>
			<li class="dp-edit"><a href="{{ path('admin_tickettriggers_edit', {'trigger_id': trigger.id}) }}" class="popout-trigger"><span></span></a></li>
			<li class="dp-move"><span></span></li>
			<li class="dp-on-off trigger-toggle"><span class="off" {% if trigger.is_enabled %}style="display: none"{% endif %}>{{ phrase('admin.global.off') }}</span><span class="on" {% if not trigger.is_enabled %}style="display: none"{% endif %}>{{ phrase('admin.global.on') }}</span></li>
		</ul>
	</div>
	<div class="run-order"><label>{{ index }}</label></div>
	<div class="contents">
		{% if trigger.sys_name %}
		<lable><h2>{{ phrase('agent.triggers_' ~ trigger.sys_name|replace({'.': '_'})) }}</h2></lable>
		{% elseif trigger.title %}
		<lable><h2>{{ trigger.title }}</h2></lable>
		{% endif %}
		<div class="trigger-desc">
			<table cellspacing="0" cellpadding="0"><tr><td valign="top" width="350">
				<div class="terms">
					<em class="op ctrl">{{ phrase('admin.tickettriggers.if') }}</em>
					{% if trigger.event_trigger_option %}
					{{ time_explain_prefix }} {% if trigger.getOptionScale() == 'seconds' %}{{ relative_time(trigger.getOptionSeconds()) }}{% else %}{{ trigger.event_trigger_option }}{% endif %} <br /><em class="op">{{ phrase('agent.global.and') }}</em>
					{% endif %}
					{% for desc in trigger.getTermDescriptions() %}
					<span class="term">{{ desc }}</span>
					{% if not loop.last %}<br /><em class="op">{{ phrase('agent.global.and') }}</em>{% endif %}
					{% endfor %}
				</div>
			</td><td valign="top" width="50%" style="padding-left: 15px;">
				<div class="actions">
					<em class="op ctrl">{{ phrase('admin.tickettriggers.then') }}</em>
					{% for desc in trigger.getActionDescriptions() %}
					<span class="term">{{ desc|raw }}</span>
					{% if not loop.last %}<br /><em class="op">{{ phrase('agent.global.and') }}</em>{% endif %}
					{% endfor %}
				</div>
			</td></tr></table>
		</div>
	</div>
	<br class="clear" />
</li>
{% endmacro %}

{% if not triggers %}
<p>
	{{ phrase('admin.tickettriggers.you_havent_created_any_triggers_yet') }} <a href="{{ path('admin_tickettriggers_new_choosetype') }}">{{ phrase('admin.tickettriggers.click_here_to_create_one_now') }}</a>.
</p>
{% endif %}

{% set types = {
	'new_ticket.web_person': "New Ticket via Web Interface",
	'new_ticket.gateway_person': "New Ticket via Email",
	'new_ticket.widget': "New Ticket via Website Widget",
	'new_ticket.agent': "New Ticket created by an Agent",
	'new_reply.web_person': "New Reply via Web Interface",
	'new_reply.gateway_person': "New Reply via Email",
	'new_reply.agent': 'New Rely by an Agent',
	'property_change.user': "Ticket Updated by a User",
	'property_change.agent': "Ticket Updated by an Agent",
	'time_open': 'Time a ticket has been open',
	'time_user_waiting': 'Time a user has been waiting for a reply',
	'time_total_user_waiting': 'Total time a user has been waiting in a ticket',
	'time_agent_waiting': 'Time an agent has been waiting for a user reply',
	'time_resolved': 'Time a ticket has been resolved for',
	'other': 'Other',
} %}

{% for type,title in types %}
{% if triggers[type] %}
<div class="content-table template-dir trigger-dir">
	<table width="100%" class="simple">
		<thead>
		<tr>
			<th class="single-title" colspan="10">
				<h1 class="noexpand">
					{{ title }}
				</h1>
			</th>
		</tr>
		</thead>
		<tbody>
		<tr>
			<td>
				<ul class="item-list trigger-set">
					{% for trigger in triggers[type] %}
						{{ _self.trigger_row(loop.index, trigger) }}
					{% endfor %}
				</ul>
			</td>
		</tr>
		</tbody>
	</table>
</div>
<br />
{% endif %}
{% endfor %}

{% endblock %}
