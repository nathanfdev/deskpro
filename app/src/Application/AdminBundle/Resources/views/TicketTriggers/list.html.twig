{% extends 'AdminBundle::layout.html.twig' %}
{% set page_handler = 'DeskPRO.Admin.ElementHandler.TicketTriggersPage' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/ElementHandler/TicketTriggersPage.js') }}"></script>
<script type="text/javascript">
	var UPDATE_ORDER_URL = '{{ path('admin_tickettriggers_updateorder') }}';
</script>
{% endblock %}
{% block pagebar %}
	<nav>
		<ul>
			<li class="add"><a href="{{ path('admin_tickettriggers_new_choosetype') }}">{{ phrase('admin.tickettriggers.add_trigger') }}</a></li>
		</ul>
	</nav>
	<ul>
		<li>{{ phrase('admin.tickettriggers.triggers') }}</li>
	</ul>
{% endblock %}
{% block page %}

{% macro trigger_row(trigger, time_explain_prefix) %}
	<li class="item-row trigger-row is-trigger {% if trigger.is_enabled %}{% else %}off{% endif %}" id="trigger_{{ trigger.id }}" data-trigger-id="{{ trigger.id }}">
		<div class="dp-block-controls">
			<ul>
				<li class="dp-edit"><a href="{{ path('admin_tickettriggers_edit', {'trigger_id': trigger.id}) }}" class="popout-trigger"><span></span></a></li>
				<li class="dp-move"><span></span></li>
				<li class="dp-on-off trigger-toggle"><span class="off" {% if trigger.is_enabled %}style="display: none"{% endif %}>{{ phrase('admin.tickettriggers.off') }}</span><span class="on" {% if not trigger.is_enabled %}style="display: none"{% endif %}>{{ phrase('admin.tickettriggers.on') }}</span></li>
			</ul>
		</div>
		{% if trigger.sys_name %}
			<lable><h2>{{ phrase('agent.triggers_' ~ trigger.sys_name|replace({'.': '_'})) }}</h2></lable>
		{% elseif trigger.title %}
			<lable><h2>{{ trigger.title }}</h2></lable>
		{% endif %}
		<div class="trigger-desc">
			<div class="terms">
				<em class="op ctrl">if</em>
				{% if trigger.event_trigger_option %}
					{{ time_explain_prefix }} {{ relative_time(trigger.event_trigger_option, 1) }} <em class="op">and</em>
				{% endif %}
				{% for desc in trigger.getTermDescriptions() %}
					<span class="term">{{ desc }}</span>
					{% if not loop.last %}<em class="op">and</em>{% endif %}
				{% endfor %}
			</div>
			<div class="actions">
				<em class="op ctrl">then</em>
				{% for desc in trigger.getActionDescriptions() %}
					<span class="term">{{ desc|raw }}</span>
					{% if not loop.last %}<em class="op">and</em>{% endif %}
				{% endfor %}
			</div>
		</div>
	</li>
{% endmacro %}

{% if not triggers %}
<p>
	{{ phrase('admin.tickettriggers.you_havent_created_any_triggers_yet') }} <a href="{{ path('admin_tickettriggers_new_choosetype') }}">{{ phrase('admin.tickettriggers.click_here_to_create_one_now') }}</a>.
</p>
{% endif %}

{% if triggers.new_ticket %}
<h2>{{ phrase('admin.tickettriggers.new_ticket_triggers') }}</h2>
<ul class="item-list trigger-set">
	{% for trigger in triggers.new_ticket %}
		{{ _self.trigger_row(trigger) }}
	{% endfor %}
</ul>
<br />
{% endif %}

{% if triggers.new_reply %}
<h2>{{ phrase('admin.tickettriggers.new_reply_triggers') }}</h2>
<ul class="item-list trigger-set">
	{% for trigger in triggers.new_reply %}
		{{ _self.trigger_row(trigger) }}
	{% endfor %}
</ul>
<br />
{% endif %}

{% if triggers.new_reply %}
<h2>{{ phrase('admin.tickettriggers.ticket_update_triggers') }}</h2>
<ul class="item-list trigger-set">
	{% for trigger in triggers.property_change %}
		{{ _self.trigger_row(trigger) }}
	{% endfor %}
</ul>
<br />
{% endif %}

{% if triggers.time_open %}
<h2>{{ phrase('admin.tickettriggers.triggers_based_on_the_time_a_ticket_has') }}</h2>
<ul class="item-list">
	{% for trigger in triggers.time_open %}
		{{ _self.trigger_row(trigger, 'Ticket has been open') }}
	{% endfor %}
</ul>
<br />
{% endif %}

{% if triggers.time_user_waiting %}
<h2>{{ phrase('admin.tickettriggers.triggers_based_on_the_time_a_user_has') }}</h2>
<ul class="item-list">
	{% for trigger in triggers.time_user_waiting %}
		{{ _self.trigger_row(trigger, 'Ticket has been awaiting agent for') }}
	{% endfor %}
</ul>
<br />
{% endif %}

{% if triggers.time_total_user_waiting %}
<h2>{{ phrase('admin.tickettriggers.triggers_based_on_the_total_time_a_user') }}</h2>
<ul class="item-list">
	{% for trigger in triggers.time_total_user_waiting %}
		{{ _self.trigger_row(trigger, 'Total user waiting time is ') }}
	{% endfor %}
</ul>
<br />
{% endif %}

{% if triggers.time_agent_waiting %}
<h2>{{ phrase('admin.tickettriggers.triggers_based_on_the_time_an_agent_has') }}</h2>
<ul class="item-list">
	{% for trigger in triggers.time_agent_waiting %}
		{{ _self.trigger_row(trigger, 'Ticket has been awaiting user for') }}
	{% endfor %}
</ul>
<br />
{% endif %}

{% if triggers.time_agent_waiting %}
<h2>{{ phrase('admin.tickettriggers.triggers_based_on_the_time_a_ticket_was') }}</h2>
<ul class="item-list">
	{% for trigger in triggers.time_agent_waiting %}
		{{ _self.trigger_row(trigger, 'Ticket has been resolved for') }}
	{% endfor %}
</ul>
{% endif %}

{% endblock %}
