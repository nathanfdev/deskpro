{% extends 'AdminBundle::layout.html.twig' %}
{% set page_handler = 'DeskPRO.Admin.ElementHandler.TicketTriggersPage' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/ElementHandler/TicketTriggersPage.js') }}"></script>
<script type="text/javascript">
	var UPDATE_ORDER_URL = '{{ path('admin_tickettriggers_updateorder') }}';
</script>
{% endblock %}
{% block pagebar %}
<nav>
	<ul>
		<li class="add"><a href="{{ path('admin_tickettriggers_new_choosetype') }}">{{ phrase('admin.tickets.add_trigger') }}</a></li>
	</ul>
</nav>
<ul>
	<li>{{ phrase('admin.general.triggers') }}</li>
</ul>
{% endblock %}
{% block page %}

{% macro trigger_row(index, trigger, time_explain_prefix) %}
<li class="item-row trigger-row is-trigger {% if trigger.is_enabled %}{% else %}off{% endif %}" id="trigger_{{ trigger.id }}" data-trigger-id="{{ trigger.id }}">
	<div class="dp-block-controls">
		<ul>
			{% if not trigger.isUneditable() %}
				<li class="dp-edit"><a href="{{ path('admin_tickettriggers_edit', {'trigger_id': trigger.id}) }}" class="popout-trigger"><span></span></a></li>
			{% endif %}
			<li class="dp-move"><span></span></li>
			<li class="dp-on-off trigger-toggle"><span class="off" {% if trigger.is_enabled %}style="display: none"{% endif %}>{{ phrase('admin.general.off') }}</span><span class="on" {% if not trigger.is_enabled %}style="display: none"{% endif %}>{{ phrase('admin.general.on') }}</span></li>
		</ul>
	</div>
	<div class="run-order"><label>{{ index }}</label></div>
	<div class="contents">
        {% if trigger.sys_name and trigger.sys_name == trigger.title %}
            <lable><h2>{{ phrase('agent.general.triggers_' ~ trigger.sys_name|replace({'.': '_'})) }}</h2></lable>
        {% elseif trigger.title %}
            <lable><h2>{{ trigger.title }}</h2></lable>
        {% endif %}
		<div class="trigger-desc" {% if trigger.isUneditable() %}style="display: none"{% endif %}>
			<table cellspacing="0" cellpadding="0"><tr><td valign="top" width="350">
				<div class="terms">
					<em class="op ctrl">{{ phrase('admin.tickets.if') }}</em>
					{% if trigger.event_trigger_option %}
					{{ time_explain_prefix }} {% if trigger.getOptionScale() == 'seconds' %}{{ relative_time(trigger.getOptionSeconds()) }}{% else %}{{ trigger.event_trigger_option }}{% endif %} <br /><em class="op">{{ phrase('agent.general.and') }}</em>
					{% endif %}
					{% for desc in trigger.getTermDescriptions() %}
					<span class="term">{{ desc }}</span>
					{% if not loop.last %}<br /><em class="op">{{ phrase('agent.general.and') }}</em>{% endif %}
					{% endfor %}
				</div>
			</td><td valign="top" width="50%" style="padding-left: 15px;">
				<div class="actions">
					<em class="op ctrl">{{ phrase('admin.tickets.then') }}</em>
					{% for desc in trigger.getActionDescriptions() %}
					<span class="term">{{ desc|raw }}</span>
					{% if not loop.last %}<br /><em class="op">{{ phrase('agent.general.and') }}</em>{% endif %}
					{% endfor %}
				</div>
			</td></tr></table>
		</div>
	</div>
	<br class="clear" />
</li>
{% endmacro %}

{% if not triggers %}
<p>
	{{ phrase('admin.tickets.no_triggers_yet') }} <a href="{{ path('admin_tickettriggers_new_choosetype') }}">{{ phrase('admin.tickets.click_here_to_create') }}</a>.
</p>
{% endif %}

{% set types = {
	'new_ticket': phrase('admin.tickets.new_ticket'),
	'new_ticket.web_person': phrase('admin.tickets.new_ticket_web'),
	'new_ticket.gateway_person': phrase('admin.tickets.new_ticket_gateway'),
	'new_ticket.widget': phrase('admin.tickets.new_ticket_widget'),
	'new_ticket.agent': phrase('admin.tickets.new_ticket_agent'),
	'new_reply': phrase('admin.tickets.new_reply'),
	'new_reply.web_person': phrase('admin.tickets.new_reply_web'),
	'new_reply.gateway_person': phrase('admin.tickets.new_reply_gateway'),
	'new_reply.agent': phrase('admin.tickets.new_reply_agent'),
	'property_change': phrase('admin.tickets.property_change'),
	'property_change.user': phrase('admin.tickets.property_change_user'),
	'property_change.agent': phrase('admin.tickets.property_change_agent'),
	'time_open': phrase('admin.tickets.time_open'),
	'time_user_waiting': phrase('admin.tickets.time_user_waiting'),
	'time_total_user_waiting': phrase('admin.tickets.time_total_user_waiting'),
	'time_agent_waiting': phrase('admin.tickets.time_agent_waiting'),
	'time_resolved': phrase('admin.tickets.time_resolved'),
	'other': phrase('agent.general.other'),
} %}

{% for type,title in types %}
{% if triggers[type] %}
<div class="content-table template-dir trigger-dir">
	<table width="100%" class="simple">
		<thead>
		<tr>
			<th class="single-title" colspan="10">
				<h1 class="noexpand">
					{{ title }}
				</h1>
			</th>
		</tr>
		</thead>
		<tbody>
		<tr>
			<td>
				<ul class="item-list trigger-set">
					{% for trigger in triggers[type] %}
						{{ _self.trigger_row(loop.index, trigger) }}
					{% endfor %}
				</ul>
			</td>
		</tr>
		</tbody>
	</table>
</div>
<br />
{% endif %}
{% endfor %}

{% endblock %}
