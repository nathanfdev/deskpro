{% extends 'AdminBundle::layout.html.twig' %}
{% set page_handler = 'DeskPRO.Admin.ElementHandler.TicketTriggerEditPage' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/ElementHandler/TicketTriggerEditPage.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function TicketTriggerEditPage_initTerms(handler) {
	var basename;

	{% if from_gateway %}
		basename = 'terms['+Orb.uuid()+']';
		handler.criteriaEditor.addNewRow($('.criteria-form .search-terms'), basename, { type: 'gateway_account', op: 'is', options: { gateway_account: {{ from_gateway.id }} } });

		{% if from_gateway.getPrimaryEmailAddress() %}
			basename = 'actions['+Orb.uuid()+']';
			handler.actionsEditor.addNewRow($('.actions-form .search-terms'), basename, { type: 'set_from_address', options: { email_address: '{{ from_gateway.getPrimaryEmailAddress() }}' } });
		{% endif %}
	{% endif %}

	{% for action in trigger.terms %}
		basename = 'terms['+Orb.uuid()+']';
		handler.criteriaEditor.addNewRow($('.criteria-form .search-terms'), basename, { type: '{{action.type}}', op: '{{action.op}}', options: {{action.options|json_encode|raw}} });
	{% endfor %}

	var count = 0;
	{% for action in trigger.actions %}
		basename = 'actions['+Orb.uuid()+']';
		handler.actionsEditor.addNewRow($('.actions-form .search-terms'), basename, { type: '{{action.type}}', options: {{action.options|json_encode|raw}} });
	{% endfor %}
}
</script>
{% endblock %}
{% block pagebar %}
	<ul>
		<li><a href="{{ path('admin_tickettriggers') }}">{{ phrase('admin.general.triggers') }}</a></li>
		<li>{% if trigger.id %}{{ phrase('admin.tickets.edit_triggers') }}{% else %}{{ phrase('admin.tickets.new_trigger') }}{% endif %}</li>
	</ul>
{% endblock %}
{% block page %}

{% if from_gateway %}
	<div class="alert-message block-message success">
		<h3>{{ phrase('admin.tickets.gateway_created_success') }}</h3>
		{{ phrase('admin.tickets.gateway_created_success_trigger') }}
		<br />
		<a href="{{ path('admin_emailgateways') }}" class="clean-white">{{ phrase('admin.tickets.gateway_created_success_trigger_orback') }}</a>
	</div>
{% endif %}

<form action="{{ path('admin_tickettriggers_edit', {'trigger_id': trigger.id|default(0)}) }}" method="post">
<input type="hidden" name="process" value="1" />

<div class="dp-form">
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('admin.tickets.event') }}</label>
		</div>
		<div class="dp-form-input">
			<input type="hidden" name="trigger[event_trigger]" value="{{ trigger.event_trigger }}" />
			{% macro time_select(event_trigger_time, event_trigger_scale) %}
				<input type="text" name="event_trigger_time" value="{{ event_trigger_time }}" size="10" style="width: 80px" class="small" />
				<select name="event_trigger_scale">
					{% for scale,label in {'minutes': phrase('admin.tickets.minutes'), 'hours': phrase('admin.tickets.hours'), 'days': phrase('admin.tickets.days'), 'weeks': phrase('admin.tickets.weeks'), 'months': phrase('admin.tickets.months')} %}
						<option {% if event_trigger_scale == scale %}selected="selected"{% endif %} value="{{ scale }}">{{ label }}</option>
					{% endfor %}
				</select>
			{% endmacro %}
			{% if trigger.getTriggerGroup() == 'new_ticket.web_person' %}{{ phrase('admin.tickets.new_ticket_web') }}
			{% elseif trigger.getTriggerGroup() == 'new_ticket.gateway_person' %}{{ phrase('admin.tickets.new_ticket_gateway') }}
			{% elseif trigger.getTriggerGroup() == 'new_ticket.widget' %}{{ phrase('admin.tickets.new_ticket_widget') }}
			{% elseif trigger.getTriggerGroup() == 'new_reply.web_person' %}{{ phrase('admin.tickets.new_reply_web') }}
			{% elseif trigger.getTriggerGroup() == 'new_reply.gateway_person' %}{{ phrase('admin.tickets.new_reply_gateway') }}
			{% elseif trigger.getTriggerGroup() == 'new_reply.agent' %}{{ phrase('admin.tickets.new_reply_agent') }}
			{% elseif trigger.getTriggerGroup() == 'property_change.user' %}{{ phrase('admin.tickets.property_change_user') }}
			{% elseif trigger.getTriggerGroup() == 'property_change.agent' %}{{ phrase('admin.tickets.property_change_agent') }}
			{% elseif trigger.getTriggerGroup() == 'time_open' %}{{ phrase('admin.tickets.ticket_open_for_duration') }} {{ _self.time_select(event_trigger_time, event_trigger_scale) }}
			{% elseif trigger.getTriggerGroup() == 'time_user_waiting' %}{{ phrase('admin.tickets.user_waiting_on_agent_duration') }} {{ _self.time_select(event_trigger_time, event_trigger_scale) }}
			{% elseif trigger.getTriggerGroup() == 'time_agent_waiting' %}{{ phrase('admin.tickets.agent_waiting_for_user') }} {{ _self.time_select(event_trigger_time, event_trigger_scale) }}
			{% elseif trigger.getTriggerGroup() == 'time_total_user_waiting' %}{{ phrase('admin.tickets.user_waiting_duration') }} {{ _self.time_select(event_trigger_time, event_trigger_scale) }}
			{% else %}{{trigger.event_trigger}}
			{% endif %}
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('agent.general.description') }}</label> <em>{{ phrase('admin.tickets.enter_optional_description') }}</em>
		</div>
		<div class="dp-form-input">
            {% if trigger.sys_name and trigger.sys_name == trigger.title %}
                {{ phrase('agent.general.triggers_' ~ trigger.sys_name|replace({'.': '_'})) }}
                <div style="display: none">{{ form_widget(form.title) }}</div>
            {% elseif trigger.title %}
                {{ form_widget(form.title) }}
			{% endif %}
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('agent.general.criteria') }}</label>
		</div>
		<div class="dp-form-input">
			<div class="criteria-form search-form">
				<div class="search-terms"></div>
				<div class="term"><span class="add-term">{{ phrase('agent.general.widget_add') }}</span> {{ phrase('agent.general.actions') }}</div>
			</div>
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('agent.general.actions') }}</label>
		</div>
		<div class="dp-form-input">
			<div class="actions-form search-form">
				<div class="search-terms"></div>
				<div class="term"><span class="add-term">{{ phrase('agent.general.widget_add') }}</span> {{ phrase('admin.tickets.add_a_new_action') }}</div>
			</div>
		</div>
	</div>
</div>

<button class="clean-white save-trigger">{{ phrase('agent.general.save') }}</button>

<!-- These never change -->
{% for info in trigger.getStaticTerms() %}
	{% set static_key = 'static_' ~ loop.index %}
	<input type="hidden" name="terms[static_{{ static_key }}][type]" value="{{ info.type }}" />
	<input type="hidden" name="terms[static_{{ static_key }}][op]" value="{{ info.op }}" />
	{% for k,v in info.options %}
		<input type="hidden" name="terms[static_{{ static_key }}][{{ k }}]" value="{{ v }}" />
	{% endfor %}
{% endfor %}

{{ form_rest(form) }}
</form>

{% if trigger.id %}
	<div class="delete-link-wrap">
		<a href="{{ path('admin_tickettriggers_delete', {id: trigger.id, auth: security_token('delete_trigger') }) }}" class="confirm-delete-trigger" data-prompt="{{ phrase('admin.tickets.confirm_delete_trigger') }}">{{ phrase('agent.general.delete') }}</a>
	</div>
{% endif %}

{% include 'DeskPRO:Common:ticket-search-criteria.html.twig' with {
	'classname': 'criteria-tpl',
	'term_options': term_options,
	'people_term_options': term_options.people_term_options,
	'with_change_terms': true,
	'event_trigger': trigger.event_trigger,
	'event_group': trigger.getTriggerGroup()
} %}
{% include 'DeskPRO:Common:ticket-trigger-actions.html.twig' with {
	'classname': 'actions-tpl',
	'term_options': term_options,
	'trigger': trigger,
	'event_trigger': trigger.event_trigger,
	'event_group': trigger.getTriggerGroup()
} %}
{% endblock %}
