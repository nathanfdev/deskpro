{% extends 'AdminBundle::layout.html.twig' %}
{% set page_handler = 'DeskPRO.Admin.ElementHandler.TicketTriggerEditPage' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/ElementHandler/TicketTriggerEditPage.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function TicketTriggerEditPage_initTerms(handler) {
	{% for action in trigger.terms %}
		var basename = 'terms['+Orb.uuid()+']';
		handler.criteriaEditor.addNewRow($('.criteria-form .search-terms'), basename, { type: '{{action.type}}', op: '{{action.op}}', options: {{action.options|json_encode|raw}} });
	{% endfor %}

	var count = 0;
	{% for action in trigger.actions %}
		var basename = 'actions['+Orb.uuid()+']';
		handler.actionsEditor.addNewRow($('.actions-form .search-terms'), basename, { type: '{{action.type}}', options: {{action.options|json_encode|raw}} });
	{% endfor %}
}
</script>
{% endblock %}
{% block pagebar %}
	<ul>
		<li><a href="{{ path('admin_tickettriggers') }}">{{ phrase('admin.tickettriggers.triggers') }}</a></li>
		<li>{% if trigger.id %}Edit Trigger{% else %}New Trigger{% endif %}</li>
	</ul>
{% endblock %}
{% block page %}

<form action="{{ path('admin_tickettriggers_edit', {'trigger_id': trigger.id|default(0)}) }}" method="post">
<input type="hidden" name="process" value="1" />

<div class="dp-form">
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('admin.tickettriggers.event') }}</label>
		</div>
		<div class="dp-form-input">
			<input type="hidden" name="trigger[event_trigger]" value="{{ trigger.event_trigger }}" />
			{% macro time_select(event_trigger_time, event_trigger_scale) %}
				<input type="text" name="event_trigger_time" value="{{ event_trigger_time }}" size="10" style="width: 80px" class="small" />
				<select name="event_trigger_scale">
					{% for scale,label in {'minutes': 'Minutes', 'hours': 'Hours', 'days': 'Days', 'weeks': 'Weeks', 'months': 'Months'} %}
						<option {% if event_trigger_scale == scale %}selected="selected"{% endif %} value="{{ scale }}">{{ label }}</option>
					{% endfor %}
				</select>
			{% endmacro %}
			{% if trigger.event_trigger == 'new_ticket' %}New Ticket
			{% elseif trigger.event_trigger == 'new_reply' %}New Reply
			{% elseif trigger.event_trigger == 'property_change' %}Ticket Edited
			{% elseif trigger.event_trigger == 'time_open' %}Ticket is open for {{ _self.time_select(event_trigger_time, event_trigger_scale) }}
			{% elseif trigger.event_trigger == 'time_user_waiting' %}User waiting for a reply for {{ _self.time_select(event_trigger_time, event_trigger_scale) }}
			{% elseif trigger.event_trigger == 'time_agent_waiting' %}Agent waiting for a reply for {{ _self.time_select(event_trigger_time, event_trigger_scale) }}
			{% elseif trigger.event_trigger == 'time_total_user_waiting' %}Total user waiting time exceeds {{ _self.time_select(event_trigger_time, event_trigger_scale) }}
			{% else %}{{trigger.event_trigger}}
			{% endif %}
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('admin.tickettriggers.description') }}</label> <em>{{ phrase('admin.tickettriggers.optionally_enter_a_description_to_help_you_remember') }}</em>
		</div>
		<div class="dp-form-input">
			{% if trigger.sys_name %}
				{{ phrase('agent.triggers_' ~ trigger.sys_name|replace({'.': '_'})) }}
				<div style="display: none">{{ form_widget(form.title) }}</div>
			{% else %}
				{{ form_widget(form.title) }}
			{% endif %}
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('admin.tickettriggers.criteria') }}</label>
		</div>
		<div class="dp-form-input">
			<div class="criteria-form search-form">
				<div class="search-terms"></div>
				<div class="term"><span class="add-term">+</span> {{ phrase('admin.tickettriggers.add_a_new_criteria') }}</div>
			</div>
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('admin.tickettriggers.actions') }}</label>
		</div>
		<div class="dp-form-input">
			<div class="actions-form search-form">
				<div class="search-terms"></div>
				<div class="term"><span class="add-term">+</span> {{ phrase('admin.tickettriggers.add_a_new_action') }}</div>
			</div>
		</div>
	</div>
</div>

<button class="clean-white save-trigger">{{ phrase('admin.tickettriggers.save') }}</button>

{{ form_rest(form) }}
</form>

{% include 'DeskPRO:Common:ticket-search-criteria.html.twig' with {
	'classname': 'criteria-tpl',
	'term_options': term_options,
	'people_term_options': term_options.people_term_options,
	'with_change_terms': true,
	'event_trigger': trigger.event_trigger
} %}
{% include 'DeskPRO:Common:ticket-trigger-actions.html.twig' with {
	'classname': 'actions-tpl',
	'term_options': term_options,
	'trigger': trigger,
	'event_trigger': trigger.event_trigger
} %}
{% endblock %}
