{% extends 'AdminBundle::layout.html.twig' %}
{% set page_handler = 'DeskPRO.Admin.ElementHandler.TicketTriggersNewChoosePage' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/ElementHandler/TicketTriggersNewChoosePage.js') }}"></script>
{% endblock %}
{% block pagebar %}
	<ul>
		<li><a href="{{ path('admin_tickettriggers') }}">{{ phrase('admin.general.triggers') }}</a></li>
		<li>{{ phrase('admin.tickets.choose_type') }}</li>
	</ul>
{% endblock %}
{% block page %}

<p>
	{{ phrase('admin.tickets.choose_trigger_event') }}
</p>

<form action="{{ path('admin_tickettriggers_edit', {'trigger_id': '0'}) }}" class="form" method="post" id="choice_form">

{% if with_urgency %}<input type="hidden" name="with-urgency" value="1" />{% endif %}

<div class="dp-form">
	<div class="dp-form-row-group" data-element-handler="DeskPRO.Admin.ElementHandler.RadioExpander" data-group-class="dp-input-group" data-expand-class="dp-group-options" data-select-first-subradio="trigger_group">
		<div class="dp-form-row">
			<div class="dp-form-input">
				<div class="dp-input-group">
					<label>
						<input type="radio" class="option-trigger" name="trigger_group_group" value="new_ticket" checked="checked" />
						{{ phrase('admin.tickets.trigger_group_new_ticket') }}
					</label>
					<div class="dp-group-options" style="display: none">
						{% set types = {
							'new_ticket.web_person': phrase('admin.tickets.new_ticket_web'),
							'new_ticket.gateway_person': phrase('admin.tickets.new_ticket_gateway'),
							'new_ticket.widget': phrase('admin.tickets.new_ticket_widget'),
							'new_ticket.agent': phrase('admin.tickets.new_ticket_agent'),
						} %}
						<ul>
							<li><label><input type="radio" name="trigger_group" class="trigger_group" value="new_ticket" /> All tickets</label></li>
							{% for type,title in types %}
								<li><label><input type="radio" name="trigger_group" class="trigger_group" value="{{ type }}" /> {{ title }}</label><br /></li>
							{% endfor %}
						</ul>
					</div>
				</div>

				<div class="dp-input-group">
					<label>
						<input type="radio" class="option-trigger" name="trigger_group_group" value="new_reply" />
						{{ phrase('admin.tickets.trigger_group_new_reply') }}
					</label>
					<div class="dp-group-options" style="display: none">
						{% set types = {
							'new_reply.web_person': phrase('admin.tickets.new_reply_web'),
							'new_reply.gateway_person': phrase('admin.tickets.new_reply_gateway'),
							'new_reply.agent': phrase('admin.tickets.new_reply_agent'),
						} %}
						<ul>
							<li><label><input type="radio" name="trigger_group" class="trigger_group" value="new_reply" /> All replies</label></li>
							{% for type,title in types %}
								<li><label><input type="radio" name="trigger_group" class="trigger_group" value="{{ type }}" /> {{ title }}</label></li>
							{% endfor %}
						</ul>
					</div>
				</div>

				<div class="dp-input-group">
					<label>
						<input type="radio" class="option-trigger" name="trigger_group_group" value="property_change" />
						{{ phrase('admin.tickets.trigger_group_property_change') }}
					</label>
					<div class="dp-group-options" style="display: none">
						{% set types = {
							'property_change.user': phrase('admin.tickets.property_change_user'),
							'property_change.agent': phrase('admin.tickets.property_change_agent'),
						} %}
						<ul>
							<li><label><input type="radio" name="trigger_group" class="trigger_group" value="property_change" /> All ticket property change</label></li>
							{% for type,title in types %}
								<li><label><input type="radio" name="trigger_group" class="trigger_group" value="{{ type }}" /> {{ title }}</label></li>
							{% endfor %}
						</ul>
					</div>
				</div>

				<div class="dp-input-group">
					<label>
						<input type="radio" class="option-trigger" name="trigger_group_group" value="escalation" />
						{{ phrase('admin.tickets.trigger_group_escalation') }}
					</label>
					<div class="dp-group-options" style="display: none">
						<ul>
							<li>
								<label><input type="radio" name="trigger_group" class="trigger_group" value="time_open" /> {{ phrase('admin.tickets.ticket_open_for_duration') }}</label>
								<span class="show-off">...</span>
								<span class="show-on">
									<input type="text" name="event_trigger_time" value="" size="10" style="width: 80px" class="small" />
									<select name="event_trigger_scale">
										{% for scale,label in {'minutes': phrase('admin.tickets.minutes'), 'hours': phrase('admin.tickets.hours'), 'days': phrase('admin.tickets.days'), 'weeks': phrase('admin.tickets.weeks'), 'months': phrase('admin.tickets.months')} %}
											<option value="{{ scale }}">{{ label }}</option>
										{% endfor %}
									</select>
								</span>
							</li>

							<li>
								<label><input type="radio" name="trigger_group" class="trigger_group" value="time_user_waiting" /> {{ phrase('admin.tickets.user_waiting_on_agent_duration') }}</label>
								<span class="show-off">...</span>
								<span class="show-on">
									<input type="text" name="event_trigger_time" value="" size="10" style="width: 80px" class="small" />
									<select name="event_trigger_scale">
										{% for scale,label in {'minutes': phrase('admin.tickets.minutes'), 'hours': phrase('admin.tickets.hours'), 'days': phrase('admin.tickets.days'), 'weeks': phrase('admin.tickets.weeks'), 'months': phrase('admin.tickets.months')} %}
											<option value="{{ scale }}">{{ label }}</option>
										{% endfor %}
									</select>
								</span>
							</li>

							<li>
								<label><input type="radio" name="trigger_group" class="trigger_group" value="time_total_user_waiting" /> {{ phrase('admin.tickets.user_waiting_duration') }}</label>
								<span class="show-off">...</span>
								<span class="show-on">
									<input type="text" name="event_trigger_time" value="" size="10" style="width: 80px" class="small" />
									<select name="event_trigger_scale">
										{% for scale,label in {'minutes': phrase('admin.tickets.minutes'), 'hours': phrase('admin.tickets.hours'), 'days': phrase('admin.tickets.days'), 'weeks': phrase('admin.tickets.weeks'), 'months': phrase('admin.tickets.months')} %}
											<option value="{{ scale }}">{{ label }}</option>
										{% endfor %}
									</select>
								</span>
							</li>


							<li>
								<label><input type="radio" name="trigger_group" class="trigger_group" value="time_agent_waiting" /> {{ phrase('admin.tickets.agent_waiting_for_user') }}</label>
								<span class="show-off">...</span>
								<span class="show-on">
									<input type="text" name="event_trigger_time" value="" size="10" style="width: 80px" class="small" />
									<select name="event_trigger_scale">
										{% for scale,label in {'minutes': phrase('admin.tickets.minutes'), 'hours': phrase('admin.tickets.hours'), 'days': phrase('admin.tickets.days'), 'weeks': phrase('admin.tickets.weeks'), 'months': phrase('admin.tickets.months')} %}
											<option value="{{ scale }}">{{ label }}</option>
										{% endfor %}
									</select>
								</span>
							</li>

							<li>
								<label><input type="radio" name="trigger_group" class="trigger_group" value="time_resolved" /> {{ phrase('admin.tickets.ticket_resolved_duration') }}</label>
								<span class="show-off">...</span>
								<span class="show-on">
									<input type="text" name="event_trigger_time" value="" size="10" style="width: 80px" class="small" />
									<select name="event_trigger_scale">
										{% for scale,label in {'minutes': phrase('admin.tickets.minutes'), 'hours': phrase('admin.tickets.hours'), 'days': phrase('admin.tickets.days'), 'weeks': phrase('admin.tickets.weeks'), 'months': phrase('admin.tickets.months')} %}
											<option value="{{ scale }}">{{ label }}</option>
										{% endfor %}
									</select>
								</span>
							</li>
						</ul>
					</div>
				</div>

			</div>
		</div>
	</div>
</div>

<br />
<button class="clean-white save-trigger">{{ phrase('agent.general.continue') }} &rarr;</button>

</form>

<style type="text/css">
	.show-off {
		display: inline-block;
	}
	.show-on {
		display: none;
	}

	.on > .show-off { display: none; }
	.on > .show-on  { display: inline-block; }

	.trigger_group {
		margin-right :4px;
	}

	.dp-group-options li {
		line-height: 25px;
	}
</style>
{% endblock %}
