{% extends 'AdminBundle:TicketTriggers:ticket-trigger-tpl.html.twig' %}
{% block pagebar %}
	<ul>
		<li><a href="{{ path('admin_tickettriggers') }}">{{ phrase('admin.general.triggers') }}</a></li>
		<li>
			{% if trigger.id %}
				Edit Trigger
			{% else %}
				New Trigger
			{% endif %}
		</li>
	</ul>
{% endblock %}
{% block event_row %}
	{% if trigger.event_trigger == 'new.email.user' %}When a user creates a ticket via email
	{% elseif trigger.event_trigger == 'new.email.agent' %}When an agent forwards a user email via email
	{% elseif trigger.event_trigger == 'new.web.agent' %}When an agent creates a new ticket via the agent interface
	{% elseif trigger.event_trigger == 'new.web.portal' %}When a user creates a new ticket via the helpdesk portal
	{% elseif trigger.event_trigger == 'new.web.widget' %}When a user creates a new ticket via the website widget
	{% elseif trigger.event_trigger == 'new.web.embed' %}When a user creates a new ticket via an embedded ticket form
	{% endif %}
{% endblock %}