{% set page_handler = 'DeskPRO.Admin.ElementHandler.SettingsPage' %}
{% extends 'AdminBundle::layout.html.twig' %}
{% block pagebar %}
	<ul>
		<li>{{ phrase('admin.general.apps') }}</li>
	</ul>
{% endblock %}
{% block page %}

<div class="portal-toggle inline chat">
	{% if app.getSetting('user.portal_enabled') %}
		<a class="toggle-btn" href="{{ path('admin_apps_toggle', {app: 'chat', enable: '0'}) }}"><em>{{ phrase('admin.portal.click_to_disable') }}</em></a>
	{% else %}
		<a class="toggle-btn disabled" href="{{ path('admin_apps_toggle', {app: 'chat', enable: '1'}) }}"><em>{{ phrase('admin.portal.click_to_enable') }}</em></a>
	{% endif %}
	<h3>{{ phrase('admin.general.apps_chat') }}</h3>
	<p>
		{{ phrase('admin.general.apps_chat_explain') }}
	</p>
</div>

