{% set page_handler = 'DeskPRO.Admin.ElementHandler.SettingsPage' %}
{% extends 'AdminBundle::layout.html.twig' %}
{% block pagebar %}
	<ul>
		<li>Settings</li>
	</ul>
{% endblock %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/ElementHandler/SettingsPage.js') }}"></script>
{% endblock %}
{% block page %}

<div class="setting_section_head">
	<a href="{{ path('admin_settings_adv') }}">Advanced settings view</a>
</div>

<form action="{{ path('admin_settings') }}" method="POST" id="settings_form">
<input type="hidden" name="process" value="1" />

<div class="setting_field_row">
	<h4>Basics</h4>
	<div class="setting_fields">
		<div class="field_row">
			<table cellspacing="0" cellpadding="0"><tr>
				<td style="padding-right: 10px;">
					<label>Your helpdesk name</label>
					<input type="text" name="settings[core.deskpro_name]" value="{{app.getSetting('core.deskpro_name')}}" size="40" />
				</td>
				<td>
					<label>Your helpdesk URL</label>
					<input type="text" name="settings[core.deskpro_url]" value="{{app.getSetting('core.deskpro_url')}}" size="40" />
				</td>
			</tr></table>
		</div>
		<div class="field_row">
			<table cellspacing="0" cellpadding="0"><tr>
				<td style="padding-right: 10px;">
					<label>Your website name</label>
					<input type="text" name="settings[core.site_name]" value="{{app.getSetting('core.site_name')}}" size="40" />
				</td>
				<td>
					<label>Your website URL</label>
					<input type="text" name="settings[core.site_url]" value="{{app.getSetting('core.site_url')}}" size="40" />
				</td>
			</tr></table>
		</div>
	</div>
</div>
<div class="setting_field_row">
	<h4>Helpdesk</h4>
	<div class="setting_fields">
		<div class="field_row">
			<label><input type="checkbox" name="settings[core.helpdesk_disabled]" {% if app.getSetting('core.helpdesk_disabled') %}checked="checked"{% endif %} />
				The helpdesk is currently disabled</label>
		</div>
		<div class="field_row">
			<label><input type="checkbox" name="settings[core.force_ssl]" {% if app.getSetting('core.force_ssl') %}checked="checked"{% endif %} />
				Force users to use https:// by redirecting non-https requests</label>
		</div>
		<div class="field_row">
			<label><input type="checkbox" name="settings[core.force_domain]" {% if app.getSetting('core.force_domain') %}checked="checked"{% endif %} />
				Force users to use the domain name set in your "Helpdeks URL." For example, this will forward non-www to www.</label>
		</div>
	</div>
</div>
<div class="setting_field_row">
	<h4>Attachments</h4>
	<div class="setting_fields">
		<table cellspacing="0" cellpadding="0" width="100%"><tr><td valign="top" style="padding-right: 15px" width="50%">
			<h6>Users</h6>

			<div class="field_row">
				<input type="hidden" id="user_attach_maxsize" name="settings[core.attach_user_maxsize]" value="{{ app.getSetting('core.attach_user_maxsize') }}" />
				Max upload size: <span id="user_attach_maxsize_label"></span> MB
				<div id="user_attach_maxsize_slider"></div>
				<div id="user_attach_maxsize_notice" data-maxsize="{{ max_uploadsize }}" style="display: none">
					The max file size your server supports is {{ max_uploadsize_readable }}. <a>Learn why you are bound by this limit.</a>
				</div>
			</div>

			<div class="field_row">
				<label style="display: inline;"><input type="radio" id="user_attach_limit_type_b" name="user_attach_limit_type" value="blacklist" {% if app.getSetting('core.attach_user_not_exts') %}checked="checked"{% endif %}> Disallow these file types</label>
				<label style="display: inline;"><input type="radio" id="user_attach_limit_type_w" name="user_attach_limit_type" value="whitelist" {% if not app.getSetting('core.attach_user_not_exts') %}checked="checked"{% endif %}> Only allow these file types</label>
				<input type="hidden" id="user_attach_limit_list_whitelist" name="settings[core.attach_user_must_exts]" value="{{ app.getSetting('core.attach_user_must_exts') }}" />
				<input type="hidden" id="user_attach_limit_list_blacklist" name="settings[core.attach_user_not_exts]" value="{{ app.getSetting('core.attach_user_not_exts') }}" />
				<input type="text" id="user_attach_limit_input" style="width: 300px; height: 22px;" />
			</div>
		</td><td valign="top" style="padding-left: 15px" width="50%">
			<h6>Agents</h6>

			<div class="field_row">
				<input type="hidden" id="agent_attach_maxsize" name="settings[core.attach_agent_maxsize]" value="{{ app.getSetting('core.attach_agent_maxsize') }}" />
				Max upload size: <span id="agent_attach_maxsize_label"></span> MB
				<div id="agent_attach_maxsize_slider"></div>
				<div id="agent_attach_maxsize_notice" data-maxsize="{{ max_uploadsize }}" style="display: none">
					The max file size your server supports is {{ max_uploadsize_readable }}. <a>Learn why you are bound by this limit.</a>
				</div>
			</div>

			<div class="field_row">
				<label style="display:inline"><input type="radio" id="agent_attach_limit_type_b" name="agent_attach_limit_type" value="blacklist" {% if app.getSetting('core.attach_agent_not_exts') %}checked="checked"{% endif %}> Disallow these file types</label>
				<label style="display:inline"><input type="radio" id="agent_attach_limit_type_w" name="agent_attach_limit_type" value="whitelist" {% if not app.getSetting('core.attach_agent_not_exts') %}checked="checked"{% endif %}> Only allow these file types</label>
				<input type="hidden" id="agent_attach_limit_list_whitelist" name="settings[core.attach_agent_must_exts]" value="{{ app.getSetting('core.attach_agent_must_exts') }}" />
				<input type="hidden" id="agent_attach_limit_list_blacklist" name="settings[core.attach_agent_not_exts]" value="{{ app.getSetting('core.attach_agent_not_exts') }}" />
				<input type="text" id="agent_attach_limit_input" style="width: 300px; height: 22px;" />
			</div>
		</table>
	</div>
</div>
<div class="setting_field_row">
	<h4>Advanced</h4>
	<div class="setting_fields">
		<div class="field_row">
			<table cellspacing="0" cellpadding="0"><tr>
				<td style="padding-right: 10px;">
					<label>Cookie Path</label>
					<input type="text" name="settings[core.cookie_path]" value="{{app.getSetting('core.cookie_path')}}" size="40" />
				</td>
				<td>
					<label>Cookie Domain</label>
					<input type="text" name="settings[core.cookie_domain]" value="{{app.getSetting('core.cookie_domain')}}" size="40" />
				</td>
			</tr></table>
		</div>
	</div>
</div>

<div class="setting_field_row" style="text-align: center">
	<button class="clean-white">Save Settings</button>
</div>

</form>

{% endblock %}
