{% set page_handler = 'DeskPRO.Admin.ElementHandler.QuickSetup' %}
{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('vendor/detect_timezone.js') }}"></script>
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/ElementHandler/QuickSetup.js') }}"></script>
{% endblock %}
{% block pagebar %}
	<ul>
		<li>{{ phrase('admin.settings.welcome_to_deskpro') }}</li>
	</ul>
{% endblock %}
{% block page %}

<form class="dp-form" method="post" action="{{ path('admin_welcome') }}" id="quick_setup_form">
	<input type="hidden" name="process" value="1" />
	{{ form_token() }}

	<div class="dp-form-section">
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('admin.settings.default_email_from_address') }}</label> <em class="desc">{{ phrase('admin.settings.enter_the_email_address_deskpro_should_use_by') }}</em>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.default_from_email) }}
				{% if errors.invalid_default_from_email %}<div class="dp-error">{{ phrase('agent.global.please_enter_a_valid_email_address') }}</div>{% endif %}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('admin.settings.deskpro_url') }}</label> <em class="desc">{{ phrase('admin.settings.this_is_the_url_to_deskpro_itself_with') }}</em>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.deskpro_url) }}
				{% if errors.default_from_email %}<div class="dp-error">{{ phrase('admin.settings.please_enter_a_valid_url') }}</div>{% endif %}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('admin.settings.deskpro_name') }}</label> <em class="desc">{{ phrase('admin.settings.the_name_of_your_helpdesk') }}</em>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.deskpro_name) }}
				{% if errors.default_from_email %}<div class="dp-error">{{ phrase('admin.settings.please_enter_a_name_for_the_helpdesk') }}</div>{% endif %}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('admin.settings.your_site_name') }}</label> <em class="desc">{{ phrase('admin.settings.your_main_website_name') }}</em>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.site_name) }}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('admin.settings.your_site_url') }}</label> <em class="desc">{{ phrase('admin.settings.your_main_website_url') }}</em>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.site_url) }}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('admin.settings.default_timezone') }}</label> <em class="desc">{{ phrase('admin.settings.the_default_timezone_used_when_expressing_dates_to') }}</em>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.timezone) }}
				{% if errors.default_from_email %}<div class="dp-error">{{ phrase('admin.settings.please_select_a_timezone') }}</div>{% endif %}
			</div>
		</div>
	</div>

	<div class="dp-form-section">
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ form_widget(form.portal_enabled) }} {{ phrase('admin.settings.enable_portal') }}</label><br />
			</div>
			<div class="dp-form-input">
				<p>
					DeskPRO includes a user front-end where your users can submit tickets and feedback and read knowledgebase articles and news, and download files.
					You can configure all the options later. If you don't want a portal and you are using DeskPRO just to manage email, you can turn this off.
				</p>
			</div>
		</div>
	</div>

	<footer class="controls">
		<button class="clean-white">{{ phrase('agent.global.continue') }}</button>
	</footeR>
</form>

{% endblock %}
