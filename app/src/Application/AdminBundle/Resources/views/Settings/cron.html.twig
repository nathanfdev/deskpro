{% extends 'AdminBundle::layout.html.twig' %}
{% block pagebar %}
	<ul>
		<li>{{ phrase('admin.settings.configure_scheduled_tasks') }}</li>
	</ul>
{% endblock %}
{% block page %}

<div class="dp-form">
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('admin.settings.configuring_scheduled_tasks') }}</label>
		</div>
		<div class="dp-form-input">
			{{ phrase('admin.settings.notice_scheduled_tasks') }}:
			<ul>
				<li><a href="">{{ phrase('admin.settings.linux') }}</a></li>
				<li><a href="">{{ phrase('admin.settings.windows') }}</a></li>
			</ul>
		</div>
	</div>

	<div class="dp-form">
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('admin.settings.command_to_run_every_minute') }}</label>
			</div>
			<div class="dp-form-input">
				{{ phrase('admin.settings.configure_minute_command') }}:
<pre class="codebox">
{{ php_path }} -q {{ path }}/cron.php
</pre>
			</div>
		</div>
	</div>
</div>

{% if show_complete_form %}
	<footer class="controls">
		<a class="clean-white" href="{{ path('admin_settings_cron', {complete: '1'}) }}">{{ phrase('admin.settings.confirm_configured_scheduled_tasks') }}</a>
	</footer>
{% endif %}

{% endblock %}
