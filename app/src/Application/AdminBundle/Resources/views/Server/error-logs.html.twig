{% extends 'AdminBundle::layout.html.twig' %}
{% block pagebar %}
	<nav>
          <ul>
               <li><a href="{{ path('admin_server_error_logs_clear', {x: security_token('clear_error_logs') }) }}">{{ phrase('admin.general.clear_logs') }}</a></li>
          </ul>
     </nav>
	<ul>
		<li>{{ phrase('admin.general.error_logs') }}</li>
	</ul>
{% endblock %}
{% block page %}
<div class="check-grid item-list">
	<table width="100%">
		<thead>
			<tr>
				<th width="50">{{ phrase('agent.general.id') }}</th>
				<th>{{ phrase('agent.general.message') }}</th>
				<th width="180">{{ phrase('agent.general.date') }}</th>
				<th>Details&nbsp;</th>
			</tr>
		</thead>
		<tbody>
			{% for log in logs %}
				<tr>
					<td>{{log.id}}</td>
					<td>{{log.summary}}</td>
					<td>{{log.date}}</td>
					<td><a href="{{ path('admin_server_error_logs_view', {'log_id': log.id}) }}">{{ phrase('admin.general.view') }}</a></td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
</div>

{% endblock %}
