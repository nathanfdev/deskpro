{% extends 'AdminBundle::layout.html.twig' %}
{% block pagebar %}
	<nav>
          <ul>
               <li><a href="{{ path('admin_server_error_logs_clear', {x: security_token('clear_error_logs') }) }}">{{ phrase('admin.global.clear_logs') }}</a></li>
          </ul>
     </nav>
	<ul>
		<li>{{ phrase('admin.global.error_logs') }}</li>
	</ul>
{% endblock %}
{% block page %}
<div class="check-grid item-list">
	<table width="100%">
		<thead>
			<tr>
				<th width="50">{{ phrase('admin.global.id') }}</th>
				<th width="50">{{ phrase('admin.global.pri') }}</th>
				<th>{{ phrase('admin.global.message') }}</th>
				<th width="180">{{ phrase('admin.global.date') }}</th>
				<th>Details&nbsp;</th>
			</tr>
		</thead>
		<tbody>
			{% for log in logs %}
				<tr>
					<td>{{log.id}}</td>
					<td>{{log.priority_name}}</td>
					<td>{{log.message}}</td>
					<td>{{log.date_created|date('Y-m-d H:m:s')}}</td>
					<td><a href="{{ path('admin_server_error_logs_view', {'log_id': log.id}) }}">{{ phrase('admin.server.view') }}</a></td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
</div><br />

{% if pagination.pages|length > 1 %}
<div class="page_nav">
	<ul>
		{% if pagination.curpage != pagination.first %}
			<li><a href="{{ path('admin_server_error_logs', {'p': pagination.first}) }}">{{ phrase('admin.global.first') }}</a></li>
			<li><a href="{{ path('admin_server_error_logs', {'p': pagination.prev}) }}">{{ phrase('admin.global.prev') }}</a></li>
		{% endif %}

		{% for i in pagination.pages %}
			<li {% if i == pagination.curpage %}class="cur_page"{% endif %}><a href="{{ path('admin_server_error_logs', {'p': i}) }}">{{i}}</a></li>
		{% endfor %}

		{% if pagination.curpage != pagination.last %}
			<li><a href="{{ path('admin_server_error_logs', {'p': pagination.next}) }}">{{ phrase('admin.global.next') }}</a></li>
			<li><a href="{{ path('admin_server_error_logs', {'p': pagination.last}) }}">{{ phrase('admin.global.last') }}</a></li>
		{% endif %}
	</ul>
</div>
{% endif %}

{% endblock %}
