{% extends 'AdminBundle::layout.html.twig' %}
{% block pagebar %}
	<ul>
		<li>{{ phrase('admin.server.file_uploads') }}</li>
	</ul>
{% endblock %}
{% block page %}

<div class="check-grid item-list">
	<table width="100%">
		<thead>
			<tr>
				<th colspan="4">{{ phrase('admin.server.file_storage_mechanism') }}</th>
			</tr>
		</thead>
		<tbody>
			{% if use_fs %}
				<tr>
					<td width="200">{{ phrase('admin.server.storage_mechanism') }}</td>
					<td>
						{{ phrase('admin.server.file_storage') }}
						<div style="font-size: 11px">
							You are currently using the most efficient storage mechanism. {% if not moving_id %}While not recommended, you can <a class="switch-trigger">switch back to using database storage</a>.{% endif %}
						</div>
					</td>
				</tr>
				<tr>
					<td>{{ phrase('admin.server.storage_path') }}</td>
					<td>{{ filestorage_path }}</td>
				</tr>
			{% else %}
				<tr>
					<td>{{ phrase('admin.server.storage_mechanism') }}</td>
					<td>
						{{ phrase('admin.server.database_storage') }}
						<div style="font-size: 11px">
							Databases are not designed to store files.{% if not moving_id %} We recommend <a class="switch-trigger">switching to filesystem storage</a> where files are store as files in a directory on your server.{% endif %}
						</div>
					</td>
				</tr>
				<tr>
					<td>{{ phrase('admin.server.storage_table') }}</td>
					<td>{{ phrase('admin.server.blobs_storage') }}</td>
				</tr>
			{% endif %}
			{% if moving_id %}
				<tr>
					<td colspan="4">
						Currently transferring files from {% if use_fs %}the database to the filesystem{% else %}the filesystem to the database{% endif %}.
						{{ count_done }} of {{ count_todo }} ({{ count_perc }}%) files have been processed.
					</td>
				</tr>
			{% endif %}
		</tbody>
	</table>
</div><br />

<div class="check-grid item-list">
	<table width="100%">
		<thead>
			<tr>
				<th >{{ phrase('admin.server.setting') }}</th>
				<th width="200">{{ phrase('admin.server.value') }}</th>
			</tr>
		</thead>
		<tbody>
			<tr>
				<td>
					<h3>{{ phrase('admin.server.file_uploads') }}</h3>
					<p>{{ phrase('admin.server.this_setting_must_be_enabled_for_php_to') }}</p>
				</td>
				<td>{{ php_vars.file_uploads }}
			</tr>

			<tr>
				<td>
					<h3>{{ phrase('admin.server.upload_tmp_dir') }}</h3>
					<p>{{ phrase('admin.server.this_is_where_php_saves_files_to_temporarily') }}</p>
				</td>
				<td>{{ php_vars.upload_tmp_dir }}
			</tr>

			<tr>
				<td>
					<h3>{{ phrase('admin.server.upload_max_filesize') }}</h3>
					<p>{{ phrase('admin.server.this_is_the_maximum_size_for_any_single') }}</p>
				</td>
				<td>{{ php_vars.upload_max_filesize }}
			</tr>

			<tr>
				<td>
					<h3>{{ phrase('admin.server.post_max_size') }}</h3>
					<p>{{ phrase('admin.server.this_is_the_max_size_of_any_post') }}</p>
				</td>
				<td>{{ php_vars.post_max_size }}
			</tr>
		</tbody>
	</table>
</div><br />

<div class="check-grid item-list">
	<table width="100%">
		<thead>
			<tr>
				<th colspan="10">{{ phrase('admin.server.test_a_file_upload') }}</th>
			</tr>
		</thead>
		<tbody>
			{% if has_uploaded %}
				<tr>
					<td>
						{% if failed %}<h3>{{ phrase('admin.server.failed') }}</h3><br />{{ failed }}
						{% else %}
							<h3>{{ phrase('admin.server.success') }}</h3>
							{{ phrase('admin.server.download_attachment') }}: <a href="{{ attach.getDownloadUrl() }}">{{ attach.getDownloadUrl() }}</a><br />
						{% endif %}
					</td>
				</tr>
			{% else %}
				<tr>
					<td>
						<form action="{{ path('admin_server_attach', {test: 1}) }}" method="post" enctype="multipart/form-data">
							<input type="file" name="file" /> <button>{{ phrase('admin.server.test_upload') }}</button>
						</form>
					</td>
				</tr>
			{% endif %}
		</tbody>
	</table>
</div>

{% if not moving_id %}
<div id="switch_confirm" style="display: none; width: 500px; height: 300px">
	<div class="overlay-title">
		<span class="close-overlay"></span>
		<h4>{{ phrase('admin.server.change_storage_mechanism') }}</h4>
	</div>
	<div class="overlay-content">
		{% if use_fs %}
			<p style="margin-bottom: 10px;">You are currently storing files in the filesystem at {{ filestorage_path }}.<br /><br />Are you sure you want to switch back to using the database
			storage mechanism?</p>
		{% else %}
			<p style="margin-bottom: 10px;">You are currently storing files in the database. Do you want to switch to the filesystem storage mechanism? Files will be stored
			on your server at {{ filestorage_path }}</p>
		{% endif %}

		<p style="margin: 10px; background-color: #F5F5F5; padding: 10px;">
			{{ count_todo }} files with a total size of {{ total_size_readable }} will be moved.
			<br /><br />
			The transfer is done gradually via a scheduled task.
			It may take some time before all of your files are completely transferred. All normal attachment functions like uploading and downloading
			will continue to work.
		</p>
	</div>
	<div class="overlay-footer">
		<form action="{{ path('admin_server_attach_switch') }}">
			{{ form_token() }}
			<button class="clean-white">Confirm: Switch to the {% if use_fs %}database{% else %}filesystem{% endif %} storage mechanism</button>
		</form>
	</div>
</div>

<script type="text/javascript">
$(document).ready(function() {
	var overlay = new DeskPRO.UI.Overlay({
		triggerElement: $('.switch-trigger'),
		contentElement: $('#switch_confirm')
	});
});
</script>
{% endif %}

{% endblock %}
