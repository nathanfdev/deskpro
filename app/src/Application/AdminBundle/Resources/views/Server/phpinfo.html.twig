{% extends 'AdminBundle::layout.html.twig' %}
{% block pagebar %}
	<ul>
		<li>{{ phrase('admin.global.php_info') }}</li>
	</ul>
{% endblock %}
{% block page %}

<h1>{{ phrase('admin.server.important_configuration_values') }}</h1>
<div class="check-grid item-list">
	<table width="100%">
		<thead>
			<tr>
				<th style="text-align:left">&nbsp; Setting</th>
				<th style="text-align:left">{{ phrase('agent.global.value') }}</th>
			</tr>
		</thead>
		<tbody>
			<tr>
				<td>{{ phrase('admin.server.php_version') }}</td>
				<td>{{ php_config.version }}</td>
			</tr>
			<tr>
				<td>{{ phrase('admin.server.memory_limit') }}</td>
				<td>{{ php_config.memory_limit }} (<a href="{{ app.request.getBaseUrl() }}?_sys=memtest&amp;_={{ config_hash }}">{{ phrase('admin.server.test_this_value') }}</a>)</td>
			</tr>
			<tr>
				<td>{{ phrase('admin.server.error_log') }}</td>
				<td>{{ php_config.error_log }}</td>
			</tr>
		</tbody>
	</table>
</div>

<hr />

{{ phpinfo|raw }}
{% endblock %}
