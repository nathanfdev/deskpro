{% extends 'AdminBundle::layout.html.twig' %}
{% block pagebar %}
	<ul>
		<li><a href="{{ path('admin_server_error_logs') }}">{{ phrase('admin.general.error_logs') }}</a></li>
		<li>{{ phrase('admin.general.error_log_id', {'id':log.id}) }}</li>
	</ul>
{% endblock %}
{% block page %}

<div class="dp-form">
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('agent.id') }}</label>
		</div>
		<div class="dp-form-input">
			{{ log.id }}
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('agent.date') }}</label>
		</div>
		<div class="dp-form-input">
			{{ log.date_created|date('Y-m-d H:m:s') }}
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('admin.general.log_name') }}</label>
		</div>
		<div class="dp-form-input">
			{{ log.log_name }}
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('admin.general.sn_code') }}</label>
		</div>
		<div class="dp-form-input">
			{{ log.session_name|default(phrase('agent.none')) }}
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('agent.priority') }}</label>
		</div>
		<div class="dp-form-input">
			{{log.priority}} {{log.priority_name}}
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('agent.flag') }}</label>
		</div>
		<div class="dp-form-input">
			{{ log.flag|default(phrase('agent.none')) }}
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('agent.message') }}</label>
		</div>
		<div class="dp-form-input">
			<textarea style="width:99%; height:200px; font-family:Monaco, 'Courier New', courier, monospace;">{{log.message}}</textarea>
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('admin.general.additional_data') }}</label>
		</div>
		<div class="dp-form-input">
			<textarea style="width:99%; height:200px; font-family:Monaco, 'Courier New', courier, monospace;">{{data_structure}}</textarea>
		</div>
	</div>
</div>
{% endblock %}
