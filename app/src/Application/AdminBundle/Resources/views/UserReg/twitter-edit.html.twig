{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block pagebar %}
     <ul>
         <li><a href="{{ path('admin_userreg_options') }}">Registration Settings</a></li>
		 <li>Twitter Setup</li>
     </ul>
{% endblock %}
{% block prepage %}
	<div style="padding: 10px 10px 0 10px;">
		{{ design.helpbox() }}
			<p>
				To enable Twitter integration, you must register with Twitterto get your own key and secret.
				<a href="https://dev.twitter.com/apps/new">Click here here to sign up now</a>.
			</p>
		{{ design.helpbox_end() }}
	</div>
{% endblock %}
{% block page %}

<form action="{{ path('admin_userreg_twitter_edit') }}" method="post" class="dp-form">
	{{ form_token('twitter_setup') }}
	<input type="hidden" name="process" value="1" />

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Consumer Key</label>
		</div>
		<div class="dp-form-input">
			<input type="text" name="twitter[consumer_key]" value="{{ options.consumer_key }}" placeholder="Enter your Twitter consumer key" />
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Consumer Secret</label>
		</div>
		<div class="dp-form-input">
			<input type="text" name="twitter[consumer_secret]" value="{{ options.consumer_secret }}" placeholder="Enter your Twitter consumer secret" />
		</div>
	</div>

	<footer class="controls">
	<div class="is-not-loading">
		<button class="clean-white">Save</button>
	</div>
	<div class="is-loading">
		<div class="loading-icon-flat">&nbsp;</div>
	</div>
</footer>

<br class="clear" />
</form>
{% endblock %}
