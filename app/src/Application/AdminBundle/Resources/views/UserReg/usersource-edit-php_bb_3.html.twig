<div class="dp-form-row">
	<div class="dp-form-label">
		<label>{{ phrase('admin.userreg.database_dsn') }}</label>
	</div>
	<div class="dp-form-input">
		{{ form_widget(form.db_dsn) }}
		<br />
		<small>Enter the DSN connection string for the database. Refer to the manual for the string format
			(<a href="http://www.php.net/manual/en/ref.pdo-mysql.connection.php">{{ phrase('admin.userreg.mysql') }}</a>).
			For example: <var>mysql:host=localhost;dbname=mydb</var>
		</small>
	</div>
</div>

