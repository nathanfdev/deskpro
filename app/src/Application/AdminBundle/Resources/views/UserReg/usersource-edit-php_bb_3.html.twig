<div class="dp-form-row">
	<div class="dp-form-label">
		<label>Database DSN</label>
	</div>
	<div class="dp-form-input">
		{{ form_widget(form.db_dsn) }}
		<br />
		<small>Enter the DSN connection string for the database. Refer to the manual for the string format
			(<a href="http://www.php.net/manual/en/ref.pdo-mysql.connection.php">MySQL</a>).
			For example: <var>mysql:host=localhost;dbname=mydb</var>
		</small>
	</div>
</div>

<div class="dp-form-row">
	<div class="dp-form-label">
		<label>Database User</label>
	</div>
	<div class="dp-form-input">
		{{ form_widget(form.db_username) }}
	</div>
</div>

<div class="dp-form-row">
	<div class="dp-form-label">
		<label>Database Password</label>
	</div>
	<div class="dp-form-input">
		{{ form_widget(form.db_password) }}
	</div>
</div>

<div class="dp-form-row">
	<div class="dp-form-label">
		<label>Table Prefix</label>
	</div>
	<div class="dp-form-input">
		{{ form_widget(form.table_prefix) }}
		<br />
		<small>If your installation is using a table prefix, enter it here.</small>
	</div>
</div>

<div class="dp-form-row">
	<div class="dp-form-label">
		<label>URL to password check service</label>
	</div>
	<div class="dp-form-input">
		{{ form_widget(form.check_service_url) }}
		<br />
		<small>The URL to the password check service you uploaded.</small>
	</div>
</div>

<div class="dp-form-row">
	<div class="dp-form-label">
		<label>Password check service key</label>
	</div>
	<div class="dp-form-input">
		{{ form_widget(form.check_service_key) }}
		<br />
		<small>The secret key inside the password check service file you uploaded</small>
	</div>
</div>