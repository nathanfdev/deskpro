	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('admin.userreg.host') }}</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.host) }}<br />
			<div style="padding-top: 4px">
				<small>{{ phrase('admin.userreg.if_youre_using_a_nonstandard_port_389_or') }}:</small>
				{{ form_widget(form.port, {attr: {style: 'width: 50px'}}) }}
			</div>
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('admin.userreg.use_secure_connection') }}</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.secure) }}
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('admin.userreg.base_dn') }}</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.baseDn) }}
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('admin.userreg.domain_name') }}</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.accountDomainName) }}
			<br />
			<small>{{ phrase('admin.userreg.the_fqdn_name_for_users_in_this_directory') }}</small>
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('admin.userreg.short_domain_name_slash') }}</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.accountDomainNameShort) }}
			<br />
			<small>{{ phrase('admin.userreg.the_short_domain_name_for_users_in_this') }}</small>
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('admin.userreg.service_account') }}</label>
		</div>
		<div class="dp-form-input">
			<div>{{ phrase('admin.userreg.username') }}: {{ form_widget(form.username, {attr:{style:"width: 250px"}}) }}</div>
			<div style="padding-top: 4px;">{{ phrase('admin.userreg.password') }}: {{ form_widget(form.password, {attr:{style:"width: 250px"}}) }}</div>
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('admin.userreg.custom_filter') }}</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.accountFilterFormat) }}
			<br />
			<small>By default, the filter performed when looking up users is <var>(&(objectClass=user)(sAMAccountName=%s))</var>. Use <var>%s</var> as the input placeholder.</small>
		</div>
	</div>