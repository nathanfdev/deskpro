<div class="dp-form-row">
	<div class="dp-form-label">
		<label>{{ phrase('admin.user_registration.database_dsn') }}</label>
	</div>
	<div class="dp-form-input">
		{{ form_widget(form.db_dsn) }}
		<br />
        <small>{{ phrase('admin.user_registration.enter_dsn_mysql') }}</small>
	</div>
</div>

<div class="dp-form-row">
	<div class="dp-form-label">
		<label>{{ phrase('admin.user_registration.database_user') }}</label>
	</div>
	<div class="dp-form-input">
		{{ form_widget(form.db_username) }}
	</div>
</div>

<div class="dp-form-row">
	<div class="dp-form-label">
		<label>{{ phrase('admin.user_registration.database_password') }}</label>
	</div>
	<div class="dp-form-input">
		{{ form_widget(form.db_password) }}
	</div>
</div>

<div class="dp-form-row">
	<div class="dp-form-label">
		<label>{{ phrase('admin.user_registration.table_prefix') }}</label>
	</div>
	<div class="dp-form-input">
		{{ form_widget(form.table_prefix) }}
		<br />
		<small>{{ phrase('admin.user_registration.enter_table_prefix_here') }}</small>
	</div>
</div>

<div class="dp-form-row-group" data-element-handler="DeskPRO.Admin.ElementHandler.RadioExpander" data-group-class="dp-input-group" data-expand-class="dp-group-options">
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Single Sign On</label>
		</div>
		<div class="dp-form-input">
			<div class="dp-input-group">
				<label>
					<input type="radio" class="option-trigger" name="usersource[sso]" value="0" {% if not usersource.getOption('sso') %}checked="checked"{% endif %} />
					Disable
				</label>
			</div>

			<div class="dp-input-group">
				<label>
					<input type="radio" class="option-trigger" name="usersource[sso]" value="1" {% if usersource.getOption('sso') %}checked="checked"{% endif %} />
					Enable
				</label>
				<div class="dp-group-options" style="display: none">
					File Path to Magento: {{ form_widget(form.magento_path, {'attr': {'placeholder': 'Example: /var/www/html/magento'}}) }}
					<br />(Note: this requires that Magento be on the same domain and server as DeskPRO. You must also set your Magento options to expose cookies to DeskPRO.)
				</div>
			</div>
		</div>
		<div>Single sign on allows users to automatically be logged into their DeskPRO account if they are logged into their Magento account. When the user visits DeskPRO for the first time, a DeskPRO account will automatically be created based on their Magento account.</div>
	</div>
</div>