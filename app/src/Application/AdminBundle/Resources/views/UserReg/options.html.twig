{% extends 'AdminBundle::layout.html.twig' %}
{% set page_handler = 'DeskPRO.Admin.ElementHandler.UserModePage' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/ElementHandler/UserModePage.js') }}"></script>
{% endblock %}
{% block pagebar %}
     <ul>
         <li>{{ phrase('admin.registration.registration_settings') }}</li>
     </ul>
{% endblock %}
{% block sidebar_right %}
	<div class="dp-page-box" style="margin-top: 15px;">
		<div class="resource-item-list">
			<header>
				<div class="controls">
					<a class="clean-white small" href="{{ path('admin_userreg_usersource_choose') }}">{{ phrase('admin.registration.add_user_source') }}</a>
				</div>
				<h4>{{ phrase('admin.registration.user_sources') }}</h4>
			</header>
			<article>
				<article class="box-hint">{{ phrase('admin.registration.a_user_source_is_any_database_that_deskpro') }}</article>
				<ul>
					<li>
						<input class="onoff-slider" type="checkbox" value="1" onclick="window.location='{{ path('admin_userreg_deskpro_source_toggle') }}';" {% if app.getSetting('core.deskpro_source_enabled') %}checked="checked"{% endif %} />
						{{ phrase('agent.deskpro') }}
					</li>
					<li>
						<input class="onoff-slider" type="checkbox" value="1" onclick="window.location='{{ path('admin_userreg_facebook_toggle') }}';" {% if app.getSetting('core.facebook_source_enabled') %}checked="checked"{% endif %} />
						{{ phrase('agent.facebook') }} <a href="{{ path('admin_userreg_facebook_edit') }}" class="btn-edit-gear2" style="position: relative; top: 2px;"></a>
					</li>
					<li>
						<input class="onoff-slider" type="checkbox" value="1" onclick="window.location='{{ path('admin_userreg_twitter_toggle') }}';" {% if app.getSetting('core.twitter_source_enabled') %}checked="checked"{% endif %} />
						{{ phrase('agent.twitter') }} <a href="{{ path('admin_userreg_twitter_edit') }}" class="btn-edit-gear2" style="position: relative; top: 2px;"></a>
					</li>
					<li>
						<input class="onoff-slider" type="checkbox" value="1" onclick="window.location='{{ path('admin_userreg_google_toggle') }}';" {% if app.getSetting('core.google_source_enabled') %}checked="checked"{% endif %} />
						{{ phrase('admin.registration.google') }}
					</li>
					{% for usersource in usersources %}{% if usersource.source_type != 'facebook' and usersource.source_type != 'google' %}
						<li>
							<input class="onoff-slider" type="checkbox" value="1" onclick="window.location='{{ path('admin_userreg_usersource_toggle', {id: usersource.id}) }}';" {% if usersource.is_enabled %}checked="checked"{% endif %} />
							{{ usersource.title }}
							<a href="{{ path('admin_userreg_usersource_edit', {id: usersource.id}) }}" class="btn-edit-gear2" style="position: relative; top: 2px;"></a>
						</li>
					{% endif %}{% endfor %}
				</ul>
			</article>
		</div>
	</div>
{% endblock %}
{% block page %}
<form action="{{ path('admin_userreg_options_save') }}" method="POST" id="mode_form">

{% macro options_table(reg_triggers) %}
	<table cellspacing="0" cellpadding="0" width="100%" style="margin-left: 8px; margin-right: 6px;">
		<tr>
			<td width="10"><input type="checkbox" name="email_validation" value="1" {% if app.getSetting('core.email_validation') %}checked="checked"{% endif %} /></td>
			<td>
				<h3>{{ phrase('agent.force_email_validation') }}</h3>
                {{ phrase('admin.registration.notice_forces_users_to_validate_email', {'path':path('admin_tickettriggers')}) }}
                <br />
				{% if reg_triggers['email_validation.web'] %}   <input class="onoff-slider trigger-toggle" type="checkbox" value="{{ reg_triggers['email_validation.web'].id }}" name="email_validation.web" {% if reg_triggers['email_validation.web'].is_enabled %}checked="checked"{% endif %} /> {{ phrase('admin.registration.enable_validation_for_web_submitted_tickets') }}<br />{% endif %}
				{% if reg_triggers['email_validation.email'] %} <input class="onoff-slider trigger-toggle" type="checkbox" value="{{ reg_triggers['email_validation.email'].id }}" name="email_validation.web" {% if reg_triggers['email_validation.email'].is_enabled %}checked="checked"{% endif %} /> {{ phrase('admin.registration.enable_validation_for_email_submitted_tickets') }}<br />{% endif %}
				{% if reg_triggers['email_validation.widget'] %}<input class="onoff-slider trigger-toggle" type="checkbox" value="{{ reg_triggers['email_validation.widget'].id }}" name="email_validation.web" {% if reg_triggers['email_validation.widget'].is_enabled %}checked="checked"{% endif %} /> {{ phrase('admin.registration.enable_validation_for_widget_submitted_tickets') }}<br />{% endif %}
			</td>
		</tr>
		<tr>
			<td width="10"><input type="checkbox" name="existing_account_login" value="1" {% if app.getSetting('core.existing_account_login') %}checked="checked"{% endif %} /></td>
			<td>
				<h3>{{ phrase('admin.registration.force_login_for_existing_users') }}</h3>
				{{ phrase('admin.registration.notice_when_email_exists') }}
			</td>
		</tr>
	</table>
{% endmacro %}

<div class="dp-form">
<div class="dp-form-row-group" data-element-handler="DeskPRO.Admin.ElementHandler.RadioExpander" data-group-class="dp-input-group" data-expand-class="dp-group-options">
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('admin.registration.registration_mode') }}</label>
		</div>
		<div class="dp-form-input" style="width: 95%;">
			<div class="dp-input-group">
				<label>
					<input class="option-trigger" type="radio" name="mode" value="open" {% if not app.getSetting('core.user_mode') or app.getSetting('core.user_mode') == 'open' %}checked="checked"{% endif %}>
					{{ phrase('admin.registration.open_helpdesk') }}
				</label>
				<div class="dp-group-options" style="display: none">
					<p>{{ phrase('admin.registration.with_an_open_helpdesk_anyone_can_use_the') }}</p>
					{{ _self.options_table(reg_triggers) }}
				</div>
			</div>

			<div class="dp-input-group">
				<label>
					<input class="option-trigger" type="radio" name="mode" value="require_reg" {% if app.getSetting('core.user_mode') == 'require_reg' %}checked="checked"{% endif %}>
					{{ phrase('admin.registration.require_registration') }}
				</label>
				<div class="dp-group-options" style="display: none">
					<p>{{ phrase('admin.registration.with_this_mode_the_helpdesk_is_readable_by') }}</p>
					{{ _self.options_table(reg_triggers) }}
				</div>
			</div>

			<div class="dp-input-group">
				<label>
					<input class="option-trigger" type="radio" name="mode" value="require_reg_agent_validation" {% if app.getSetting('core.user_mode') == 'require_reg_agent_validation' %}checked="checked"{% endif %}>
					{{ phrase('admin.registration.require_registration_with_agent_validation') }}
				</label>
				<div class="dp-group-options" style="display: none">
					<p>{{ phrase('admin.registration.this_is_the_same_as_request_registration_except') }}</p>
					{{ _self.options_table(reg_triggers) }}
				</div>
			</div>

			<div class="dp-input-group">
				<label>
					<input class="option-trigger" type="radio" name="mode" value="closed" {% if app.getSetting('core.user_mode') == 'closed' %}checked="checked"{% endif %}>
					{{ phrase('agent.closed') }}
				</label>
				<div class="dp-group-options" style="display: none">
					<p>{{ phrase('admin.registration.notice_closed_helpdesk_closes_registration') }}</p>
				</div>
			</div>


		</div>
	</div>

	<footer class="controls">
		<div class="is-not-loading">
			<button class="clean-white">{{ phrase('admin.registration.save_registration_settings') }}</button>
		</div>
		<div class="is-loading">
			<div class="loading-icon-flat">&nbsp;</div>
		</div>
	</footer>

	<br class="clear" />
</div>
</div>

</form>

{% endblock %}
