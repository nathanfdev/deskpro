{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% extends 'AdminBundle::layout.html.twig' %}
{% block pagebar %}
<ul xmlns="http://www.w3.org/1999/html">
	<li><a href="{{ path('admin_userreg_options') }}">Registration Options</a></li>
	{% if not usersource.id %}
		<li><a href="{{ path('admin_userreg_usersource_choose') }}">New Usersource</a></li>
	{% else %}
		<li>{{ usersource.title }}</li>
	{% endif %}
</ul>
{% endblock %}
{% block page %}

<form action="{{ path('admin_userreg_usersource_edit', {id: usersource.id|default(0)}) }}" method="post" class="dp-form">
	<input type="hidden" name="process" value="1" />
	<input type="hidden" name="usersource[source_type]" value="{{ usersource.source_type }}" />
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Title</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.title) }}
		</div>
	</div>

	{% include 'AdminBundle:UserReg:usersource-edit-' ~ usersource.source_type ~ '.html.twig' %}

	<button class="btn primary save-trigger">Save</button>
</form>

{% if usersource.id %}
<div class="delete-link-wrap">
	<a href="{{ path('admin_userreg_usersource_delete', {id: usersource.id, security_token: security_token('delete_usersource') }) }}" onclick="return confirm('Are you sure you want to delete this usersource? Users will not be able to log in with these credentials anymore.');">delete</a>
</div>
{% endif %}

{% endblock %}