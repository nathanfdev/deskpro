{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% extends 'AdminBundle::layout.html.twig' %}
{% block pagebar %}
<ul xmlns="http://www.w3.org/1999/html" xmlns="http://www.w3.org/1999/html">
	<li><a href="{{ path('admin_userreg_options') }}">{{ phrase('admin.user_registration.registration_options') }}</a></li>
	{% if not usersource.id %}
		<li><a href="{{ path('admin_userreg_usersource_choose') }}">{{ phrase('admin.user_registration.new_usersource') }}</a></li>
	{% else %}
		<li>{{ usersource.title }}</li>
	{% endif %}
</ul>
{% endblock %}
{% block page %}

<form action="{{ path('admin_userreg_usersource_edit', {id: usersource.id|default(0)}) }}" method="post" class="dp-form">
	<input type="hidden" name="process" value="1" />
	<input type="hidden" name="usersource[source_type]" value="{{ usersource.source_type }}" />
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('agent.title') }}</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.title) }}
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('admin.user_registration.lost_password_url') }}</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.lost_password_url) }}
		</div>
		<small>
			{{ phrase('admin.user_registration.when_a_user_has_loggedin_using_this_usersource') }}
		</small>
	</div>

	{% include 'AdminBundle:UserReg:usersource-edit-' ~ usersource.source_type ~ '.html.twig' %}

	<button class="btn primary save-trigger">{{ phrase('agent.save') }}</button>
</form>

{% if usersource.id %}
<div class="delete-link-wrap">
	<a href="{{ path('admin_userreg_usersource_delete', {id: usersource.id, security_token: security_token('delete_usersource') }) }}" onclick="return confirm('{{ phrase('admin.user_registration.are_you_sure_delete_usersource') }}');">{{ phrase('agent.delete') }}</a>
</div>
{% endif %}

{% endblock %}