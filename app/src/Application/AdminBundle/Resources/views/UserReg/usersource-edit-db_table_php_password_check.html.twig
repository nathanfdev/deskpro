	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Database DSN</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.db_dsn) }}
			<br />
			<small>Enter the DSN connection string for the database. Refer to the manual for the string format
				(<a href="http://www.php.net/manual/en/ref.pdo-mysql.connection.php">MySQL</a>,
				<a href="http://www.php.net/manual/en/ref.pdo-sqlsrv.connection.php">MS SQL</a>,
				<a href="http://www.php.net/manual/en/ref.pdo-sqlite.connection.php">SQLite</a>,
				<a href="http://www.php.net/manual/en/pdo.drivers.php">more</a>).
			 	For example, for a MySQL database: <var>mysql:host=localhost;dbname=mydb</var>
			</small>
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Database User</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.db_username) }}
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Database Password</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.db_password) }}
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Table</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.table) }}
			<br />
			<small>The table containing your user information. For example, <var>users</var></small>
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>"ID" field</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.field_id) }}
			<br />
			<small>The field that contains a users unique ID.</small>
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>"Username" field</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.field_username) }}
			<br />
			<small>If your schema has a unique "username" field users can use to log in, enter it here. This field is optional and allows users to enter usernames into the login form instead of email addresses.</small>
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>"Email" field</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.field_email) }}
			<br />
			<small>If your schema has a unique "email" field users can use to log in, enter it here. Note that you must specify the username or email fields, or both.</small>
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>"Password" field</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.field_password) }}
			<br />
			<small>The field in the table that contains the users password.</small>
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>"First Name" field</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.field_first_name) }}
			<br />
			<small>If your schema has a field that stores the users first name, enter it here.</small>
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>"Last Name" field</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.field_last_name) }}
			<br />
			<small>If your schema has a field that stores the users last name, enter it here.</small>
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>"Full Name" field</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.field_name) }}
			<br />
			<small>If your schema has a field that stores the users full name, enter it here.</small>
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>PHP code to verify inputted password</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.password_php, {attr: {style: 'height: 150px'}}) }}
			<br />
			<small>
				Enter the raw PHP code to use when checking the validity of an inputted password against
				a found user record. The following variables are available for use:
				<ul>
					<li>&middot; $userinfo is the full row from your table</li>
					<li>&middot; $userinfo_password is the password field from the row. This is the same as $userinfo['yourpasswordfield']</li>
					<li>&middot; $password_input is the password inputted by the user. This is what you need to check against $userinfo_password.</li>
					<li>&middot; $pass is a boolean value. If the password is correct, set this variable to true. If it's invalid, set it to false.</li>
				</ul>

				Here's some example code to check a salted password:<br />
				<code>$pass = (md5($password_input . $userinfo['salt']) == $userinfo_password);</code>
			</small>
		</div>
	</div>