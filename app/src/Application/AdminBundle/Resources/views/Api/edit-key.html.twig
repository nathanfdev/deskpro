{% extends 'AdminBundle::layout.html.twig' %}
{% block pagebar %}
<ul>
	<li><a href="{{ path('admin_api_keylist') }}">API Keys</a></li>
	{% if apikey.id %}
		<li>Edit API Key</li>
	{% else %}
		<li>Add API Key</li>
	{% endif %}
</ul>
{% endblock %}
{% block page %}

<form action="{{ path('admin_api_editkey', {'id': apikey.id|default(0)}) }}" method="post" class="dp-form">

	{% if errors %}
	<ul id="errors_container">
		{% for error in errors %}
		<li>{{ error }}</li>
		{% endfor %}
	</ul>
	{% endif %}

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Note</label>
		</div>
		<div class="dp-form-input">
			<input type="text" name="note" value="{{apikey.note}}" />
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>API Agent</label>
		</div>
		<div class="dp-form-input">
			<select name="agent_id">
				<option value="0">&nbsp;</option>
				{% for agent in agents %}
					<option value="{{ agent.id }}" {% if agentId == agent.id %}selected="selected"{% endif %}>{{ agent.name }}</option>
				{% endfor %}
			</select>
			<p>Every API request is made as an agent in the system. Select the agent that will be making these requests.</p>
		</div>
	</div>

	<footer class="controls">
		<button class="clean-white">Save API Key</button>
	</footer>

	{{ form_token() }}
	<input type="hidden" name="process" value="1" />

</form>

{% endblock %}