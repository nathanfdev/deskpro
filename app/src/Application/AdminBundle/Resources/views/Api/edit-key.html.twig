{% extends 'AdminBundle::layout.html.twig' %}
{% block section 'integrations' %}
{% block sub_section 'api' %}
{% block content %}

<form action="{{ path('admin_api_editkey', {'id': apikey.id|default(0)}) }}" method="post">

<table class="form">
	{% if apikey.id %}
	<tr>
		<td class="label">
			<label>{{ phrase('admin.api.key_information') }}</label>
		</td>
		<td>
			{{ phrase('agent.global.id') }}: {{apikey.id}}<br />
			{{ phrase('admin.api.key') }}: {{apikey.code}}
			<hr />
			{{ phrase('admin.api.http_basic_auth') }}: <input type="text" class="flat" value="{{apikey.id}}:{{apikey.code}}" style="width: 200px;" /><br />
			{{ phrase('admin.api.example_curl') }}: <input type="text" class="flat" value="curl -u {{apikey.id}}:{{apikey.code}} http://deskpro/api/test" style="width: 200px;" />
		</td>
	</tr>
	{% endif %}
	<tr>
		<td class="label" width="40%">
			<label>{{ phrase('admin.api.note_or_description') }}</label>
		</td>
		<td>
			<input type="text" name="api_key[note]" value="{{apikey.note}}" style="width: 90%" />
		</td>
	</tr>
	<tr>
		<td class="label">
			<label>{{ phrase('admin.api.user_owner') }}</label>
			<div class="info">
				Every API request is made with the authority of an actual
				user. Enter the person who this API key will be making requests for.
			</div>
		</td>
		<td>
			<input type="text" name="person_email" value="{{apikey.person.primary_email_address}}" style="width: 300px;"/>
		</td>
	</tr>
</table>

<div style="text-align:center">
	<button class="dp-button" type="submit">{{ phrase('agent.global.save') }}</button>
</div>

</form>

{% endblock %}