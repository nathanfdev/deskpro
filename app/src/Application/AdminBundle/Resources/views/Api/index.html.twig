{% extends 'AdminBundle::layout.html.twig' %}
{% block section 'integrations' %}
{% block sub_section 'api' %}
{% block content %}

<div style="text-align: right">
	<a class="dp-button green" href="{{ path('admin_api_newkey') }}">{{ phrase('admin.api.create_api_key') }}</a>
	<br /><br />
</div>

<ul class="item-list">
	{% for apikey in all_apikeys %}
		<li>
			<div style="float:right">
				<ul class="controls">
					<li class="edit"><a href="{{ path('admin_api_editkey', {'id': apikey.id}) }}">{{ phrase('admin.api.viewedit') }}</a></li>
					<li class="delete"><a href="{{ path('admin_api_delkey', {'id': apikey.id}) }}" onclick="return confirm('{{ phrase('admin.api.are_you_sure') }}');">{{ phrase('agent.general.delete') }}</a></li>
				</ul>
			</div>
			<strong>{{apikey.person.display_name}}</strong>
			{% if apikey.note %}<p>{{apikey.note}}</p>{% endif %}

			<p>{{ phrase('admin.api.http_basic_auth') }}: <input type="text" class="flat" value="{{apikey.id}}:{{apikey.code}}" style="width: 200px;" /></p>
		</li>
	{% else %}
		{{ phrase('admin.api.no_api_keys_yet') }}
	{% endfor %}
</ul>

{% endblock %}