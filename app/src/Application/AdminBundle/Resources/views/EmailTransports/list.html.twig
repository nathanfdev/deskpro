{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block pagebar %}
	<nav>
		<ul>
			<li class="add"><a href="{{ path('admin_emailtrans_newaccount') }}">{{ phrase('admin.emailtransports.add_account') }}</a></li>
		</ul>
	</nav>
	<ul>
		<li><a href="{{ path('admin_emailtrans_list') }}">{{ phrase('admin.emailtransports.outgoing_email') }}</a></li>
	</ul>
{% endblock %}
{% block page %}

{{ design.helpbox() }}
	<p>
		You need to define a mail server for every address DeskPRO might send email "From." Sometimes a single mail server
		might let you send email from any "From" address, but sometimes (such as with Google Apps), the server will
		only let you send email from a single address.
	</p>
{{ design.helpbox_end() }}

<div class="top-option">
	<h3>{{ phrase('admin.emailtransports.default_from_address') }}</h3>
	<form action="{{ path('admin_emailtrans_set_default_from') }}" method="post">
		{{ form_token('admin_update_from') }}
		<input type="text" name="default_from" value="{{ app.getSetting('core.default_from_email') }}" /> <button class="clean-white">{{ phrase('admin.emailtransports.update') }}</button>
	</form>
</div>

<h1 style="font-size: 13px">{{ phrase('admin.emailtransports.outgoing_email_accounts') }}</h1>
<div class="check-grid item-list">
	<table width="100%">
		<thead>
			<tr>
				<th style="text-align:left">&nbsp; Use Criteria</th>
				<th style="text-align:left">{{ phrase('admin.emailtransports.account') }}</th>
				<th style="text-align:left">{{ phrase('admin.emailtransports.backup_account') }}</th>
				<th style="text-align:left" width="10">&nbsp;</th>
			</tr>
		</thead>
		<tbody>
			{% for transport in transports %}
				<tr {% if transport.match_type == 'all' %}class="highlight"{% endif %}>
					<td>
						{% if transport.match_type == 'exact' %}From {{ transport.match_pattern }}
						{% elseif transport.match_type == 'domain' %}From *@{{ transport.match_pattern }}
						{% elseif transport.match_type == 'regex' %}From {{ transport.match_pattern }}
						{% elseif transport.match_type == 'all' %}Default{% endif %}
					</td>
					<td>{{ transport.title }}</td>
					<td>
						{% if transport.backup_transport_type %}
							{% if transport.backup_transport_type == 'smtp' %}{{ transport.backup_transport_options.host }}:{{ transport.backup_transport_options.username }}
							{% elseif transport.backup_transport_type == 'gmail' %}Google Apps: {{ transport.backup_transport_options.username }}
							{% elseif transport.backup_transport_type == 'mail' %}PHP mail()
							{% else %}{{ transport.backup_transport_type }}
							{% endif %}
						{% else %}
							None
						{% endif %}
					</td>
					<td style="padding: 3px 3px 0 0">
						{% if transport.match_type == 'all' %}
							<a href="{{ path('admin_emailtrans_setup') }}"><span class="btn-edit-gear"></span></a>
						{% else %}
							<a href="{{ path('admin_emailtrans_editaccount', { 'id': transport.id }) }}"><span class="btn-edit-gear"></span></a>
						{% endif %}
					</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
</div>

{% endblock %}
