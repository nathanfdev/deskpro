{% set page_handler = 'DeskPRO.Admin.ElementHandler.EditEmailTransportPage' %}
{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/ElementHandler/EditEmailTransportPage.js') }}"></script>
{% endblock %}
{% block pagebar %}
	<ul>
		<li><a href="{{ path('admin_emailtrans_list') }}">Outgoing Email</a></li>
		{% if is_setup %}
			<li>{{ phrase('admin.emailtransports.setup_default_mail_server') }}</li>
		{% else %}
			{% if transport.id %}
				<li>{{ phrase('admin.emailtransports.edit_server') }}</li>
			{% else %}
				<li>{{ phrase('admin.emailtransports.new_server') }}</li>
			{% endif %}
		{% endif %}
	</ul>
{% endblock %}
{% block page %}

{% if is_setup %}
	{{ design.helpbox() }}
		<p>
			This account is used by default when the system needs to email user. For example, registration confirmations and reset password links.
			You might also have email gateways and rules set up to send notifications from different email addresses.
		</p>

		<p>
			If you have not set up other SMTP accounts to handle other email addresses, DeskPRO will attemp to use this account with a different "From" address. Depending on
			the service you are using, this might not work. For example, Gmail only allows the "From" address to be that of the account.
		</p>
	{{ design.helpbox_end() }}
{% endif %}

<form id="transport_form" action="{{ path('admin_emailtrans_editaccount', {'id': transport.id|default(0)}) }}" method="post">
{{ form_token('edit_transport') }}

<input type="hidden" name="process" value="1" />

<div class="dp-form">

	{% block email_transports_form_top %}{% endblock %}

	{% if transport.match_type == 'all' %}
		<input type="hidden" name="transport[match_type]" value="all" />
	{% endif %}
	{% if transport.match_type != 'all' %}
		<div class="dp-form-row-group" data-element-handler="DeskPRO.Admin.ElementHandler.RadioExpander" data-group-class="dp-input-group" data-expand-class="dp-group-options">
			<div class="dp-form-row">
				<div class="dp-form-label">
					<label>{{ phrase('admin.emailtransports.when_should_this_account_be_used') }}</label>
				</div>
				<div class="dp-form-input">
					<div class="dp-input-group">
						<label>
							<input type="radio" class="option-trigger email-address-type" name="transport[match_type]" value="exact" {% if not edittrans.match_type or edittrans.match_type == 'exact' %}checked="checked"{% endif %} />
							{{ phrase('admin.emailtransports.exact_address') }}
						</label>
						<div class="dp-group-options" style="display: none">
							{{ phrase('admin.emailtransports.email_address') }}: {{ form_widget(form.match_email, { 'attr': { 'class': 'small email-address-pattern', 'style': 'width:400px' }}) }}
						</div>
					</div>

					<div class="dp-input-group">
						<label>
							<input type="radio" class="option-trigger email-address-type" name="transport[match_type]" value="domain" {% if edittrans.match_type == 'domain' %}checked="checked"{% endif %} />
							{{ phrase('admin.emailtransports.every_address_at_a_domain') }}
						</label>
						<div class="dp-group-options" style="display: none">
							Domain: *@{{ form_widget(form.match_domain, { 'attr': { 'class': 'small email-domain-pattern', 'style': 'width:400px' }}) }}
						</div>
					</div>

					<div class="dp-input-group">
						<label>
							<input type="radio" class="option-trigger" name="transport[match_type]" value="regex" {% if edittrans.match_type == 'regex' %}checked="checked"{% endif %} />
							{{ phrase('admin.emailtransports.addresses_that_match_a_regular_expression') }}
						</label>
						<div class="dp-group-options" style="display: none">
							{{ phrase('admin.emailtransports.pattern') }}: {{ form_widget(form.match_regex, { 'attr': { 'class': 'small', 'style': 'width:400px' }}) }}
						</div>
					</div>
				</div>
			</div>
		</div>
	{% endif %}

	<div class="dp-form-row-group" data-element-handler="DeskPRO.Admin.ElementHandler.RadioExpander" data-group-class="dp-input-group" data-expand-class="dp-group-options">
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('admin.emailtransports.mail_server') }}</label>
			</div>
			<div class="dp-form-input">
				<div class="dp-input-group">
					<label>
						<input type="radio" class="option-trigger" name="transport[transport_type]" value="mail" {% if transport.transport_type == 'mail' %}checked="checked"{% endif %} />
						{{ phrase('admin.emailtransports.php_mail') }}
					</label>

					<div class="dp-group-options" style="display: none">
						<div class="test-row">
							<span class="test-button test-account-settings primary"><span class="lightning-small-icon"></span> {{ phrase('admin.emailtransports.test_settings') }}</span>
						</div>
					</div>
				</div>

				<div class="dp-input-group">
					<label>
						<input type="radio" class="option-trigger" name="transport[transport_type]" value="smtp" {% if not transport.transport_type or transport.transport_type == 'smtp' %}checked="checked"{% endif %} />
						{{ phrase('admin.emailtransports.smtp_account') }}
					</label>
					<div class="dp-group-options" style="display: none">
						<table cellspacing="0" cellpadding="0" width="100%">
							<tr>
								<td class="title" width="120">{{ phrase('admin.emailtransports.host') }}:</td>
								<td>
									{{ form_widget(form.smtp_options.host, {'attr': {'class': 'small'}}) }}<br />
								</td>
							</tr>
							<tr>
								<td class="title">{{ phrase('admin.emailtransports.secure') }}:</td>
								<td>{{ form_widget(form.smtp_options.secure, {'attr': {'class': 'small'}}) }}</td>
							</tr>
							<tr>
								<td class="title">{{ phrase('admin.emailtransports.port') }}:</td>
								<td>{{ form_widget(form.smtp_options.port, {'attr': {'class': 'small', 'style': 'width: 100px'}}) }}</td>
							</tr>
							<tr>
								<td class="title">{{ phrase('admin.emailtransports.requires_auth') }}:</td>
								<td>
									<input
										type="checkbox"
										{% if edittrans.smtp_options.username or edittrans.smtp_options.password %}checked="checked"{% endif %}
										data-element-handler="DeskPRO.ElementHandler.CheckboxToggle"
										data-targets="#smtp_auth_username, #smtp_auth_password"
									/> {{ phrase('admin.emailtransports.yes') }}
								</td>
							</tr>
							<tr id="smtp_auth_username">
								<td class="title">{{ phrase('admin.emailtransports.username') }}:</td>
								<td>{{ form_widget(form.smtp_options.username, {'attr': {'class': 'small'}}) }}</td>
							</tr>
							<tr id="smtp_auth_password">
								<td class="title">{{ phrase('admin.emailtransports.password') }}:</td>
								<td>{{ form_widget(form.smtp_options.password, {'attr': {'class': 'small'}}) }}</td>
							</tr>
						</table>

						<div class="test-row">
							<span class="test-button test-account-settings primary"><span class="lightning-small-icon"></span> {{ phrase('admin.emailtransports.test_settings') }}</span>
						</div>
					</div>
				</div>

				<div class="dp-input-group">
					<label>
						<input type="radio" class="option-trigger" name="transport[transport_type]" value="gmail" {% if transport.transport_type == 'gmail' %}checked="checked"{% endif %} />
						{{ phrase('admin.emailtransports.google_apps') }}
					</label>
					<div class="dp-group-options" style="display: none">
						<table cellspacing="0" cellpadding="0" width="100%">
							<tr>
								<td class="title" width="120">{{ phrase('admin.emailtransports.full_email_address') }}:</td>
								<td>{{ form_widget(form.gmail_options.username, {'attr': {'class': 'small'}}) }}</td>
							</tr>
							<tr>
								<td class="title">{{ phrase('admin.emailtransports.password') }}:</td>
								<td>{{ form_widget(form.gmail_options.password, {'attr': {'class': 'small'}}) }}</td>
							</tr>
						</table>
						<div class="test-row">
							<span class="test-button test-account-settings primary"><span class="lightning-small-icon"></span> {{ phrase('admin.emailtransports.test_settings') }}</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="dp-form-row-group" data-element-handler="DeskPRO.Admin.ElementHandler.RadioExpander" data-group-class="dp-input-group" data-expand-class="dp-group-options">
		<div class="dp-form-row">
			<div class="dp-form-label">
				<input type="radio" id="backup_form_none_radio" class="option-trigger transport-type-backup" name="transport[backup_transport_type]" value="NONE" {% if not transport.backup_transport_type %}checked="checked"{% endif %} style="display:none" />
				<label>
					<input type="checkbox" id="backup_toggle" class="onoff-slider" {% if transport.backup_transport_type %}checked="checked"{% endif %} />
					{{ phrase('admin.emailtransports.backup_mail_server') }}
				</label>
			</div>
			<div class="dp-form-input" id="backup_form" {% if not transport.backup_transport_type %}style="display: none"{% endif %}>
				<div class="dp-input-group">
					<label>
						<input type="radio" id="backup_form_php" class="option-trigger transport-type-backup" name="transport[backup_transport_type]" value="mail" {% if transport.backup_transport_type == 'mail' %}checked="checked"{% endif %} />
						{{ phrase('admin.emailtransports.php_mail') }}
					</label>
					<div class="dp-group-options" style="display: none">
						<div class="test-row">
							<span class="test-button test-account-settings backup"><span class="lightning-small-icon"></span> {{ phrase('admin.emailtransports.test_settings') }}</span>
						</div>
					</div>
				</div>

				<div class="dp-input-group">
					<label>
						<input type="radio" class="option-trigger transport-type-backup" name="transport[backup_transport_type]" value="smtp" {% if transport.backup_transport_type == 'smtp' %}checked="checked"{% endif %} />
						{{ phrase('admin.emailtransports.smtp_account') }}
					</label>
					<div class="dp-group-options" style="display: none">
						<table cellspacing="0" cellpadding="0" width="100%">
							<tr>
								<td  class="title" width="120">{{ phrase('admin.emailtransports.host') }}:</td>
								<td>
									{{ form_widget(form.backup_smtp_options.host, {'attr': {'class': 'small'}}) }}<br />
								</td>
							</tr>
							<tr>
								<td class="title">{{ phrase('admin.emailtransports.secure') }}:</td>
								<td>{{ form_widget(form.backup_smtp_options.secure, {'attr': {'class': 'small'}}) }}</td>
							</tr>
							<tr>
								<td class="title">{{ phrase('admin.emailtransports.port') }}:</td>
								<td>{{ form_widget(form.backup_smtp_options.port, {'attr': {'class': 'small', 'style': 'width: 100px'}}) }}</td>
							</tr>
							<tr>
								<td class="title">{{ phrase('admin.emailtransports.requires_auth') }}:</td>
								<td>
									<input
										type="checkbox"
										{% if edittrans.backup_smtp_options.username or edittrans.backup_smtp_options.password %}checked="checked"{% endif %}
										data-element-handler="DeskPRO.ElementHandler.CheckboxToggle"
										data-targets="#backup_smtp_auth_username, #backup_smtp_auth_password"
									/> {{ phrase('admin.emailtransports.yes') }}
								</td>
							</tr>
							<tr id="backup_smtp_auth_username">
								<td class="title">{{ phrase('admin.emailtransports.username') }}:</td>
								<td>{{ form_widget(form.backup_smtp_options.username, {'attr': {'class': 'small'}}) }}</td>
							</tr>
							<tr id="backup_smtp_auth_password">
								<td class="title">{{ phrase('admin.emailtransports.password') }}:</td>
								<td>{{ form_widget(form.backup_smtp_options.password, {'attr': {'class': 'small'}}) }}</td>
							</tr>
						</table>

						<div class="test-row">
							<span class="test-button test-account-settings backup"><span class="lightning-small-icon"></span> {{ phrase('admin.emailtransports.test_settings') }}</span>
						</div>
					</div>
				</div>

				<div class="dp-input-group">
					<label>
						<input type="radio" class="option-trigger transport-type-backup" name="transport[backup_transport_type]" value="gmail" {% if transport.backup_transport_type == 'gmail' %}checked="checked"{% endif %} />
						{{ phrase('admin.emailtransports.google_apps') }}
					</label>
					<div class="dp-group-options" style="display: none">
						<table cellspacing="0" cellpadding="0" width="100%">
							<tr>
								<td class="title" width="120">{{ phrase('admin.emailtransports.full_email_address') }}:</td>
								<td>{{ form_widget(form.backup_gmail_options.username, {'attr': {'class': 'small'}}) }}</td>
							</tr>
							<tr>
								<td class="title">{{ phrase('admin.emailtransports.password') }}:</td>
								<td>{{ form_widget(form.backup_gmail_options.password, {'attr': {'class': 'small'}}) }}</td>
							</tr>
						</table>
						<div class="test-row">
							<span class="test-button test-account-settings backup"><span class="lightning-small-icon"></span> {{ phrase('admin.emailtransports.test_settings') }}</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<button class="clean-white">{{ phrase('admin.emailtransports.save') }}</button>
</form>

<div id="test_settings_overlay" style="width: 400px; height: 230px; overflow:auto; display: none;">
	<div class="overlay-title">
		<span class="close-overlay close-trigger"></span>
		<h4>{{ phrase('admin.emailtransports.test_outgoing_email') }}</h4>
	</div>
	<div class="overlay-content">
		<div style="margin-bottom: 3px;">{{ phrase('admin.emailtransports.send_a_test_email_to') }}: <input type="text" class="small" name="send_to" value="{{ app.user.primaryEmailAddress() }}" /></div>
		{{ phrase('admin.emailtransports.from_email_address') }}: <input type="text" class="small" name="send_from" id="test_send_from" value="" />
		<div class="result">
			<div class="is-loading loading-icon-big"><br /><br /></div>
			<div class="is-not-loading">
				<div class="success">
					{{ phrase('admin.emailtransports.no_errors_were_reported_but_you_should_confirm') }}
				</div>
				<div class="error">
					{{ phrase('admin.emailtransports.there_was_an_error_while_trying_to_send') }}: <span class="error-msg"></span>
				</div>
			</div>
		</div>
	</div>
	<div class="overlay-footer">
		<button
			class="clean-white test-trigger"
			data-url="{{ path('admin_emailtrans_testaccount') }}"
		>{{ phrase('admin.emailtransports.test_now') }}</button>
	</div>
</div>

{% if transport.id and transport.match_type != 'all' %}
	<div class="delete-link-wrap">
		<a href="{{ path('admin_emailtrans_del', {id: transport.id, security_token: security_token('delete_transport') }) }}" onclick="return confirm('Are you sure you want to delete this SMTP account? If email is still being sent by the system From any of the affected addresses, users may fail to recieve them without this account.');">delete</a>
	</div>
{% endif %}

{% endblock %}
