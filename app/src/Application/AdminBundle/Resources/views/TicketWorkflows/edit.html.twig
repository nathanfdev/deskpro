{% extends 'AdminBundle::layout.html.twig' %}
{% block pagetitle %}
	<h1>{% if workflow.id %}{{ phrase('admin.ticketworkflows.edit_workflow') }}{% else %}{{ phrase('admin.ticketworkflows.new_workflow') }}{% endif %}</h1>
	<nav>
		<a class="clean-white" href="{{ path('admin_ticketworks') }}">&larr; {{ phrase('admin.ticketworkflows.back_to_ticket_workflows') }}</a>
	</nav>
{% endblock %}
{% block page %}

<form action="{{ path('admin_ticketworks_edit', {'workflow_id': workflow.id|default(0)}) }}" method="post">
<input type="hidden" name="process" value="1" />

<div class="dp-form">
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('agent.global.title') }}</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.title) }}
		</div>
	</div>
</div>

{{ form_rest(form) }}

<button class="btn primary save-trigger">{{ phrase('agent.global.save') }}</button>
</form>

<div class="delete-link-wrap">
	<a href="{{ path('admin_ticketworks_del', {'workflow_id': workflow.id}) }}">{{ phrase('agent.global.delete') }}</a>
</div>
{% endblock %}
