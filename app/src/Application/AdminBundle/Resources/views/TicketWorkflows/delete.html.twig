{% extends 'AdminBundle::layout.html.twig' %}
{% block pagetitle %}
	<h1>{{ phrase('admin.ticketworkflows.delete_workflow') }}</h1>
	<nav>
		<a class="clean-white" href="{{ path('admin_ticketworks') }}">&larr; Back to workflows</a>
	</nav>
{% endblock %}
{% block page %}

<p>Are you sure you want to delete the workflow "<strong>{{ workflow.title }}</strong>"?</p>

<p>{{ phrase('admin.ticketworkflows.any_tickets_that_use_this_workflow_will_have') }}</p>

<a class="btn" href="{{ path('admin_ticketworks_dodel', {'workflow_id': workflow.id, 'security_token': security_token('delete_workflow')}) }}">{{ phrase('admin.global.yes_i_am_sure_i_want_to_delete') }}</a>

{% endblock %}
