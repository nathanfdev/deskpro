{% set page_handler = 'DeskPRO.Admin.ElementHandler.EditEmailGatewayPage' %}
{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/ElementHandler/EditEmailGatewayPage.js') }}"></script>
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/ElementHandler/EditEmailTransportPage.js') }}"></script>
{% endblock %}
{% block pagebar %}
	<ul>
		<li><a href="{{ path('admin_emailgateways') }}">{{ phrase('admin.global.email_gateways') }}</a></li>
		{% if gateway.id %}
			<li>{{ phrase('admin.emailgateways.edit_gateway') }}</li>
		{% else %}
			<li>{{ phrase('admin.emailgateways.new_gateway') }}</li>
		{% endif %}
	</ul>
{% endblock %}
{% block page %}

<form id="gateway_form" action="{{ path('admin_emailgateways_edit', {'id': gateway.id|default('0')}) }}" method="post">
{{ form_token('edit_gateway') }}

<input type="hidden" name="process" value="1" />

<div class="dp-form">
	<input type="hidden" name="gateway[connection_type]" value="pop3" />
	<input type="hidden" name="gateway[gateway_type]" value="tickets" />
	<input type="hidden" id="define_transport" name="gateway[define_transport]" value="{% if not editgateway.define_transport %}0{% else %}1{% endif %}" />

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('admin.global.email_address') }}</label> <em class="desc">{{ phrase('admin.emailgateways.the_address_that_this_gateway_account_is_for') }}</em>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.address, {attr: {id: "gateway_address"}}) }}<br />
			<div id="add_addr_link" style="padding-top: 4px; width: 70%; text-align: right; {% if gateway.addresses|length > 1 %}display: none;{% endif %}">
				{{ phrase('admin.emailgateways.will_this_account_recieve_mail_for_more_than') }} <button class="clean-white small">{{ phrase('admin.emailgateways.click_here_to_add_more') }}</button>
			</div>

			<div class="choices-builder" id="gateway_addresses" style="margin-top:5px; {% if gateway.addresses|length < 2 %}display: none;{% endif %}">
				<header>
					<input type="text" class="new-choice" value="" style="width: 280px !important" /> <button class="clean-white add-trigger">{{ phrase('admin.global.add') }}</button>
				</header>
				<div style="display: none" id="choice_extra_fields"></div>
				<ul class="list">
					{% for adr in gateway.addresses %}
						{% if loop.index != 1 %}
						<li data-address-id="{{ adr.id }}">
							<div class="controls"><ul><li class="remove"><a>{{ phrase('admin.global.remove') }}</a></li></ul></div>
							<div class="label">{{ adr.title }}</div>
						</li>
						{% endif %}
					{% endfor %}
				</ul>
				<script type="text/x-deskpro-plain" class="row-tpl">
					<li class="item new" data-choice-id="new">
						<div class="controls"><ul><li class="remove"><a>{{ phrase('admin.global.remove') }}</a></li></ul></div>
						<div class="label"></div>
						<input type="hidden" name="new_address[%id%][match_pattern]" class="row-value" value="" />
					</li>
				</script>
			</div>
		</div>
	</div>

	<div class="dp-form-row-group" data-element-handler="DeskPRO.Admin.ElementHandler.RadioExpander" data-group-class="dp-input-group" data-expand-class="dp-group-options">
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('admin.emailgateways.account_information') }}</label>
			</div>
			<div class="dp-form-input">
				<div class="dp-input-group">
					<label>
						<input type="radio" class="option-trigger" name="gateway[connection_type]" value="pop3" {% if not gateway.connection_type or gateway.connection_type == 'pop3' %}checked="checked"{% endif %} id="pop3_btn" />
						{{ phrase('admin.emailgateways.pop3_account') }}
					</label>
					<div class="dp-group-options" style="display: none">
						<table cellspacing="0" cellpadding="0" width="100%">
							<tr>
								<td width="100">{{ phrase('admin.global.host') }}:</td>
								<td>
									{{ form_widget(form.pop3_options.host, {'attr': {'class': 'small'}}) }}<br />
								</td>
							</tr>
							<tr>
								<td>{{ phrase('admin.global.secure') }}:</td>
								<td>{{ form_widget(form.pop3_options.secure, {'attr': {'class': 'small'}}) }}</td>
							</tr>
							<tr>
								<td>{{ phrase('admin.global.port') }}:</td>
								<td>{{ form_widget(form.pop3_options.port, {'attr': {'class': 'small', 'style': 'width: 100px'}}) }}</td>
							</tr>
							<tr>
								<td>{{ phrase('admin.global.username') }}:</td>
								<td>{{ form_widget(form.pop3_options.username, {'attr': {'class': 'small'}}) }}</td>
							</tr>
							<tr>
								<td>{{ phrase('admin.global.password') }}:</td>
								<td>{{ form_widget(form.pop3_options.password, {'attr': {'class': 'small'}}) }}</td>
							</tr>
						</table>
						<div class="test-row">
							<span class="test-button test-gateway-account-settings primary"><span class="lightning-small-icon"></span> {{ phrase('admin.global.test_settings') }}</span>
						</div>
					</div>
				</div>

				<div class="dp-input-group">
					<label>
						<input type="radio" class="option-trigger" name="gateway[connection_type]" value="gmail" {% if gateway.connection_type == 'gmail' %}checked="checked"{% endif %} id="gapps_btn" />
						{{ phrase('admin.global.google_apps') }}
					</label>
					<div class="dp-group-options" style="display: none">
						<table cellspacing="0" cellpadding="0" width="100%">
							<tr>
								<td width="120">{{ phrase('admin.global.full_email_address') }}:</td>
								<td>{{ form_widget(form.gmail_options.username, {'attr': {'class': 'small'}}) }}</td>
							</tr>
							<tr>
								<td>{{ phrase('admin.global.password') }}:</td>
								<td>{{ form_widget(form.gmail_options.password, {'attr': {'class': 'small'}}) }}</td>
							</tr>
						</table>
						<div class="test-row">
							<span class="test-button test-gateway-account-settings primary"><span class="lightning-small-icon"></span> {{ phrase('admin.global.test_settings') }}</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div id="smtp_options_default" {% if editgateway.define_transport %}style="display: none"{% endif %}>
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('admin.emailgateways.outgoing_mail_account') }}</label>
			</div>
			<div class="dp-form-input">
				<span class="show-non-gapps" {% if gateway.connection_type == 'gmail' %}style="display: none"{% endif %}>
                    {% set phrase_link %}
                        <a href="{{ path('admin_emailtrans_setup') }}">{{ phrase('admin.emailgateways.default_outgoing_account') }}</a>.
                    {% endset %}
                    {{ phrase('admin.emailgateways.using_the', {'link':phrase_link}) }}
                </span>
				<span class="show-gapps" {% if gateway.connection_type !='gmail' %}style="display: none"{% endif %}>{{ phrase('admin.emailgateways.use_the_google_apps_account_defined_above_for') }}</span>
				<button class="clean-white small toggle-custom-smtp">{{ phrase('admin.emailgateways.use_a_different_outgoing_account') }}</button>
			</div>
		</div>
	</div>

	<div id="smtp_options" {% if not editgateway.define_transport %}style="display: none;"{% endif %} data-element-handler="DeskPRO.Admin.ElementHandler.EditEmailTransportPage">
		<div class="dp-form-row-group" data-element-handler="DeskPRO.Admin.ElementHandler.RadioExpander" data-group-class="dp-input-group" data-expand-class="dp-group-options">
			<div class="dp-form-row">
				<div class="dp-form-label">
					<label>{{ phrase('admin.emailgateways.outgoing_mail_account') }}</label> <button class="clean-white small toggle-custom-smtp">{{ phrase('admin.emailgateways.go_back_to_using_the_default_outgoing_account') }}</button>
				</div>
				<div class="dp-form-input">
					<div class="dp-input-group">
						<label>
							<input type="radio" class="option-trigger" name="transport[transport_type]" value="mail" {% if transport.transport_type == 'mail' %}checked="checked"{% endif %} />
							{{ phrase('admin.global.php_mail') }}
						</label>

						<div class="dp-group-options" style="display: none">
							<div class="test-row">
								<span class="test-button test-account-settings primary"><span class="lightning-small-icon"></span> {{ phrase('admin.global.test_settings') }}</span>
							</div>
						</div>
					</div>

					<div class="dp-input-group">
						<label>
							<input type="radio" class="option-trigger" name="transport[transport_type]" value="smtp" {% if not transport.transport_type or transport.transport_type == 'smtp' %}checked="checked"{% endif %} />
							{{ phrase('admin.global.smtp_account') }}
						</label>
						<div class="dp-group-options" style="display: none">
							<table cellspacing="0" cellpadding="0" width="100%">
								<tr>
									<td class="title" width="120">{{ phrase('admin.global.host') }}:</td>
									<td>
										{{ form_widget(trans_form.smtp_options.host, {'attr': {'class': 'small'}}) }}<br />
									</td>
								</tr>
								<tr>
									<td class="title">{{ phrase('admin.global.secure') }}:</td>
									<td>{{ form_widget(trans_form.smtp_options.secure, {'attr': {'class': 'small'}}) }}</td>
								</tr>
								<tr>
									<td class="title">{{ phrase('admin.global.port') }}:</td>
									<td>{{ form_widget(trans_form.smtp_options.port, {'attr': {'class': 'small', 'style': 'width: 100px'}}) }}</td>
								</tr>
								<tr>
									<td class="title">{{ phrase('admin.global.requires_auth') }}:</td>
									<td>
										<input
											type="checkbox"
											{% if edittrans.smtp_options.username or edittrans.smtp_options.password %}checked="checked"{% endif %}
											data-element-handler="DeskPRO.ElementHandler.CheckboxToggle"
											data-targets="#smtp_auth_username, #smtp_auth_password"
										/> {{ phrase('admin.global.yes') }}
									</td>
								</tr>
								<tr id="smtp_auth_username">
									<td class="title">{{ phrase('admin.global.username') }}:</td>
									<td>{{ form_widget(trans_form.smtp_options.username, {'attr': {'class': 'small'}}) }}</td>
								</tr>
								<tr id="smtp_auth_password">
									<td class="title">{{ phrase('admin.global.password') }}:</td>
									<td>{{ form_widget(trans_form.smtp_options.password, {'attr': {'class': 'small'}}) }}</td>
								</tr>
							</table>

							<div class="test-row">
								<span class="test-button test-account-settings primary"><span class="lightning-small-icon"></span> {{ phrase('admin.global.test_settings') }}</span>
							</div>
						</div>
					</div>

					<div class="dp-input-group">
						<label>
							<input type="radio" class="option-trigger" name="transport[transport_type]" value="gmail" {% if transport.transport_type == 'gmail' %}checked="checked"{% endif %} />
							{{ phrase('admin.global.google_apps') }}
						</label>
						<div class="dp-group-options" style="display: none">
							<table cellspacing="0" cellpadding="0" width="100%">
								<tr>
									<td class="title" width="120">{{ phrase('admin.global.full_email_address') }}:</td>
									<td>{{ form_widget(trans_form.gmail_options.username, {'attr': {'class': 'small'}}) }}</td>
								</tr>
								<tr>
									<td class="title">{{ phrase('admin.global.password') }}:</td>
									<td>{{ form_widget(trans_form.gmail_options.password, {'attr': {'class': 'small'}}) }}</td>
								</tr>
							</table>
							<div class="test-row">
								<span class="test-button test-account-settings primary"><span class="lightning-small-icon"></span> {{ phrase('admin.global.test_settings') }}</span>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="dp-form-row-group" data-element-handler="DeskPRO.Admin.ElementHandler.RadioExpander" data-group-class="dp-input-group" data-expand-class="dp-group-options">
				<div class="dp-form-row">
					<div class="dp-form-label">
						<input type="radio" id="backup_form_none_radio" class="option-trigger transport-type-backup" name="transport[backup_transport_type]" value="NONE" {% if not transport.backup_transport_type %}checked="checked"{% endif %} style="display:none" />
						<label>
							<input type="checkbox" id="backup_toggle" class="onoff-slider" {% if transport.backup_transport_type %}checked="checked"{% endif %} />
							{{ phrase('admin.emailgateways.backup_outgoing_mail_account') }}
						</label>
					</div>
					<div class="dp-form-input" id="backup_form" {% if not transport.backup_transport_type %}style="display: none"{% endif %}>
						<div class="dp-input-group">
							<label>
								<input type="radio" id="backup_form_php" class="option-trigger transport-type-backup" name="transport[backup_transport_type]" value="mail" {% if transport.backup_transport_type == 'mail' %}checked="checked"{% endif %} />
								{{ phrase('admin.global.php_mail') }}
							</label>
							<div class="dp-group-options" style="display: none">
								<div class="test-row">
									<span class="test-button test-account-settings backup"><span class="lightning-small-icon"></span> {{ phrase('admin.global.test_settings') }}</span>
								</div>
							</div>
						</div>

						<div class="dp-input-group">
							<label>
								<input type="radio" class="option-trigger transport-type-backup" name="transport[backup_transport_type]" value="smtp" {% if transport.backup_transport_type == 'smtp' %}checked="checked"{% endif %} />
								{{ phrase('admin.global.smtp_account') }}
							</label>
							<div class="dp-group-options" style="display: none">
								<table cellspacing="0" cellpadding="0" width="100%">
									<tr>
										<td  class="title" width="120">{{ phrase('admin.global.host') }}:</td>
										<td>
											{{ form_widget(trans_form.backup_smtp_options.host, {'attr': {'class': 'small'}}) }}<br />
										</td>
									</tr>
									<tr>
										<td class="title">{{ phrase('admin.global.secure') }}:</td>
										<td>{{ form_widget(trans_form.backup_smtp_options.secure, {'attr': {'class': 'small'}}) }}</td>
									</tr>
									<tr>
										<td class="title">{{ phrase('admin.global.port') }}:</td>
										<td>{{ form_widget(trans_form.backup_smtp_options.port, {'attr': {'class': 'small', 'style': 'width: 100px'}}) }}</td>
									</tr>
									<tr>
										<td class="title">{{ phrase('admin.global.requires_auth') }}:</td>
										<td>
											<input
												type="checkbox"
												{% if edittrans.backup_smtp_options.username or edittrans.backup_smtp_options.password %}checked="checked"{% endif %}
												data-element-handler="DeskPRO.ElementHandler.CheckboxToggle"
												data-targets="#backup_smtp_auth_username, #backup_smtp_auth_password"
											/> {{ phrase('admin.global.yes') }}
										</td>
									</tr>
									<tr id="backup_smtp_auth_username">
										<td class="title">{{ phrase('admin.global.username') }}:</td>
										<td>{{ form_widget(trans_form.backup_smtp_options.username, {'attr': {'class': 'small'}}) }}</td>
									</tr>
									<tr id="backup_smtp_auth_password">
										<td class="title">{{ phrase('admin.global.password') }}:</td>
										<td>{{ form_widget(trans_form.backup_smtp_options.password, {'attr': {'class': 'small'}}) }}</td>
									</tr>
								</table>

								<div class="test-row">
									<span class="test-button test-account-settings backup"><span class="lightning-small-icon"></span> {{ phrase('admin.global.test_settings') }}</span>
								</div>
							</div>
						</div>

						<div class="dp-input-group">
							<label>
								<input type="radio" class="option-trigger transport-type-backup" name="transport[backup_transport_type]" value="gmail" {% if transport.backup_transport_type == 'gmail' %}checked="checked"{% endif %} />
								{{ phrase('admin.global.google_apps') }}
							</label>
							<div class="dp-group-options" style="display: none">
								<table cellspacing="0" cellpadding="0" width="100%">
									<tr>
										<td class="title" width="120">{{ phrase('admin.global.full_email_address') }}:</td>
										<td>{{ form_widget(trans_form.backup_gmail_options.username, {'attr': {'class': 'small'}}) }}</td>
									</tr>
									<tr>
										<td class="title">{{ phrase('admin.global.password') }}:</td>
										<td>{{ form_widget(trans_form.backup_gmail_options.password, {'attr': {'class': 'small'}}) }}</td>
									</tr>
								</table>
								<div class="test-row">
									<span class="test-button test-account-settings backup"><span class="lightning-small-icon"></span> {{ phrase('admin.global.test_settings') }}</span>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('admin.emailgateways.enabled') }}</label>
		</div>
		<div class="dp-form-input">
			<label>
				{{ form_widget(form.is_enabled) }}
				{{ phrase('admin.emailgateways.yes_process_email_from_this_account') }}
			</label>
		</div>
	</div>
</div>

<button class="clean-white">{{ phrase('admin.global.save') }}</button>
</form>

<div id="test_gateway_settings_overlay" style="width: 400px; height: 200px; overflow:auto; display: none;">
	<div class="overlay-title">
		<span class="close-overlay close-trigger"></span>
		<h4>{{ phrase('admin.emailgateways.test_incoming_email_account') }}</h4>
	</div>
	<div class="overlay-content">
		{{ phrase('admin.emailgateways.this_will_test_the_connection_to_your_email') }}
		<div class="result">
			<div class="is-loading loading-icon-big"><br /><br /></div>
			<div class="is-not-loading">
				<div class="success">
					{{ phrase('admin.emailgateways.no_errors_were_reported') }}
				</div>
				<div class="error">
					{{ phrase('admin.emailgateways.there_was_an_error_while_trying_to_connect') }}: <span class="error-msg"></span>
				</div>
			</div>
		</div>
	</div>
	<div class="overlay-footer">
		<button
			class="clean-white test-trigger"
			data-url="{{ path('admin_emailgateways_testaccount') }}"
		>{{ phrase('admin.global.test_now') }}</button>
	</div>
</div>

<div id="test_settings_overlay" style="width: 400px; height: 200px; overflow:auto; display: none;">
	<div class="overlay-title">
		<span class="close-overlay close-trigger"></span>
		<h4>{{ phrase('admin.global.test_outgoing_email') }}</h4>
	</div>
	<div class="overlay-content">
		<div style="margin-bottom: 3px;">{{ phrase('admin.global.send_a_test_email_to') }}: <input type="text" class="small" name="send_to" value="{{ app.user.primaryEmailAddress() }}" /></div>
		{{ phrase('admin.global.from_email_address') }}: <input type="text" class="small" name="send_from" id="test_send_from" value="" />
		<div class="result">
			<div class="is-loading loading-icon-big"><br /><br /></div>
			<div class="is-not-loading">
				<div class="success">
					{{ phrase('admin.global.no_errors_were_reported_but_you_should_confirm') }}
				</div>
				<div class="error">
					{{ phrase('admin.global.there_was_an_error_while_trying_to_send') }}: <span class="error-msg"></span>
				</div>
			</div>
		</div>
	</div>
	<div class="overlay-footer">
		<button
			class="clean-white test-trigger"
			data-url="{{ path('admin_emailtrans_testaccount') }}"
		>{{ phrase('admin.global.test_now') }}</button>
	</div>
</div>

{% if gateway.id %}
	<div class="delete-link-wrap">
		<a href="{{ path('admin_emailgateways_del', {id: gateway.id, security_token: security_token('delete_gateway') }) }}" onclick="return confirm('Are you sure you want to delete this gateway? Email sent to this inbox will no longer be processed.');">{{ phrase('admin.global.delete') }}</a>
	</div>
{% endif %}
{% endblock %}
