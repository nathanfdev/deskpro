{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block html_head %}
<style type="text/css">
	ul.small-detail-list {
		margin: 0 0 0 20px;
		padding: 0;
	}

	ul.small-detail-list li {
		font-size: 11px;
		list-style: square;
		pading: 0 0 0 5px;
		margin: 0;
	}

	#email_forward_list input[type="text"] {
		width: 50%;
	}
</style>

<script type="text/javascript">
$(document).ready(function() {
	var container = $('#email_forward_list');

	container.on('click', '.remove-trigger', function(ev) {
		ev.preventDefault();
		$(this).closest('tr').remove();
	});

	container.find('button.add-trigger').on('click', function(ev) {
		ev.preventDefault();
		var html = '<tr><td><div style="float: right"><button class="clean-white remove-trigger">Remove</button></div><input type="text" name="helpdesk_emails[]" placeholder="Email address or a full domain name" value="" /></td></tr>';
		container.find('tbody').find('tr').last().before(html);
	});

	$('#email_forward_list_chk').on('change', function() {
		if (this.checked) {
			$('#email_forward_list').slideDown();
		} else {
			$('#email_forward_list').slideUp();
		}
	});
});
</script>
{% endblock %}
{% block pagebar %}
	<nav>
		<ul>
			<li class="add"><a href="{{ path('admin_emailgateways_new') }}">{{ phrase('admin.gateway.add_email_gateway') }}</a></li>
		</ul>
	</nav>
	<ul>
		<li><a href="{{ path('admin_emailgateways') }}">{{ phrase('admin.general.email_gateways') }}</a></li>
	</ul>
{% endblock %}
{% block sidebar_right %}
<div class="dp-page-box">
	<div class="resource-item-list">
		<header>
			<div class="controls">
				<a class="clean-white small" href="{{ path('admin_emailtrans_newaccount') }}">{{ phrase('agent.feedback.status_new') }}</a>
			</div>
			<h4>{{ phrase('admin.general.outgoing_email_accounts') }}</h4>
		</header>
		<article>
			{% if all_transports|length > 1 %}{# > 1 because 1 is always the 'all' transport #}
				<ul class="item-list">
					{% for transport in all_transports %}{% if transport.match_type != 'all' %}
						<li>
							<div class="dp-block-controls">
								<ul>
									<li class="dp-edit"><a href="{{ path('admin_emailtrans_editaccount', { 'id': transport.id }) }}"><span></span></a></li>
								</ul>
							</div>

							{{ phrase('admin.gateway.from') }}:
							<a href="{{ path('admin_emailtrans_editaccount', { 'id': transport.id }) }}">
							{% if transport.match_type == 'exact' %}{{ transport.match_pattern }}
							{% elseif transport.match_type == 'domain' %}*@{{ transport.match_pattern }}
							{% elseif transport.match_type == 'regex' %}{{ transport.match_pattern }}
							{% endif %}
							</a>
							<br />
							{{ phrase('admin.gateway.send_through') }}:<br />
							&nbsp;&nbsp;&nbsp;<span title="{{ transport.title }}">{{ transport.title|truncate(45) }}</span>
						</li>
					{% endif %}{% endfor %}
				</ul>
				<p>
                    {% set phrase_link %}
                        <a href="{{ path('admin_emailtrans_setup') }}">{{ phrase('admin.gateway.default_outgoing_account') }}</a>
                    {% endset %}
                    {{ phrase('admin.gateway.when_no_rules_match', {'link':phrase_link}, true) }}
				</p>
			{% else %}
				<p>
                    {% set phrase_link %}
                    <a href="{{ path('admin_emailtrans_setup') }}">{{ phrase('admin.gateway.default_outgoing_account') }}</a>
                    {% endset %}
                    {{ phrase('admin.gateway.all_email_is_being_sent_via', {'link':phrase_link}, true) }}
				</p>
				<p>
                    {% set phrase_link %}
                    <a href="{{ path('admin_emailtrans_newaccount') }}">{{ phrase('admin.gateway.add_new_account') }}</a>
                    {% endset %}
                    {{ phrase('admin.gateway.explain_different_servers', {'link':phrase_link}, true) }}
				</p>
			{% endif %}
		</article>
	</div>
</div>
{% endblock %}
{% block page %}

{{ design.helpbox() }}
	<p>{{ phrase('admin.gateway.explain_email_gateway') }}</p>
{{ design.helpbox_end() }}

<div style="padding-bottom: 5px; font-size: 11px;">
	{{ phrase('admin.general.view_by') }}:
	<label><input type="radio" name="view_by" value="address" checked="checked" onclick="$('#by_account').hide(); $('#by_address').show();"> {{ phrase('admin.general.email_addresses') }}</label>
	&nbsp;&nbsp;
	<label><input type="radio" name="view_by" value="account" onclick="$('#by_account').show(); $('#by_address').hide();"> {{ phrase('admin.general.account') }}</label>
</div>

<div class="check-grid item-list" id="by_account" style="display:none;">
	<table width="100%">
		<thead>
			<tr>
				<th style="text-align:left">&nbsp; {{ phrase('admin.general.account') }}</th>
				<th style="text-align:left" width="10">&nbsp;</th>
			</tr>
		</thead>
		<tbody>
			{% for gateway in all_gateways %}
				<tr>
					<td>
						<input
							type="checkbox"
							class="onoff-slider gateway-toggle-{{ gateway.id }}"
							{% if gateway.is_enabled %}checked="checked"{% endif %}
							data-element-handler="DeskPRO.ElementHandler.CheckboxCallUrl"
							data-url="{{ path('admin_emailgateways_quicktoggle', {'id': gateway.id}) }}"
							data-state-property="is_enabled"
						/>
						{{ gateway.title }}
						<ul class="small-detail-list">
							{% for address in gateway.addresses %}
								<li>{{ address.match_pattern }}</li>
							{% endfor %}
						</ul>
					</td>
					<td style="padding: 3px 3px 0 0">
						<a href="{{ path('admin_emailgateways_edit', { 'id': gateway.id }) }}"><span class="btn-edit-gear"></span></a>
					</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
</div>

<div class="check-grid item-list" id="by_address">
	<table width="100%">
		<thead>
			<tr>
				<th style="text-align:left">&nbsp; {{ phrase('agent.general.email_address') }}</th>
				<th style="text-align:left" width="10">&nbsp;</th>
			</tr>
		</thead>
		<tbody>
			{% for pattern,gateway in all_gateways_byemail %}
				<tr>
					<td>
						<input
							type="checkbox"
							class="onoff-slider gateway-toggle-{{ gateway.id }}"
							{% if gateway.is_enabled %}checked="checked"{% endif %}
							data-element-handler="DeskPRO.ElementHandler.CheckboxCallUrl"
							data-url="{{ path('admin_emailgateways_quicktoggle', {'id': gateway.id}) }}"
							data-state-property="is_enabled"
						/>
						{{ pattern }}
						<ul class="small-detail-list">
							<li>{{ phrase('admin.general.account') }}: {{ gateway.title }}</li>
						</ul>
					</td>
					<td style="padding: 3px 3px 0 0">
						<a href="{{ path('admin_emailgateways_edit', { 'id': gateway.id }) }}"><span class="btn-edit-gear"></span></a>
					</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
</div>

<br />
<input
	type="checkbox"
	id="email_forward_list_chk"
	class="onoff-slider"
	{% if app.getSetting('core.helpdesk_emails') %}checked="checked"{% endif %}
/> Enable email forwarding support<br />
<div id="email_forward_list" {% if not app.getSetting('core.helpdesk_emails') %}style="display: none;"{% endif %}>
	If you are forwarding other email addresses into the accounts defined above, you need to list those
	addresses here so DeskPRO does not mistake them as real users. Add each address you are forwarding FROM here.

	<form action="{{ path('admin_emailgateways_savehdaddr') }}" method="POST">
		<div class="check-grid item-list">
			<table width="100%">
				<thead>
					<tr>
						<th style="text-align:left">Forwarded Email Addresses</th>
					</tr>
				</thead>
				<tbody>
					{% for addr in helpdesk_emails %}
						<tr>
							<td>
								<div style="float: right">
									<button class="clean-white remove-trigger">Remove</button>
								</div>
								<input type="text" name="helpdesk_emails[]" value="{{ addr }}" placeholder="Email address or a full domain name" />
							</td>
						</tr>
					{% endfor %}

					<tr>
						<td>
							<button class="clean-white add-trigger">Add New Address</button>
						</td>
					</tr>
				</tbody>
			</table>
		</div>

		<button class="clean-white" style="margin: 4px 4px;">Save Addresses</button>
	</form>
</div>

{% endblock %}
