{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block html_head %}
<style type="text/css">
	ul.small-detail-list {
		margin: 0 0 0 20px;
		padding: 0;
	}

	ul.small-detail-list li {
		font-size: 11px;
		list-style: square;
		pading: 0 0 0 5px;
		margin: 0;
	}

	#email_forward_list input[type="text"] {
		width: 50%;
	}

	.select2-container .select2-choice span {
		text-align: left;
	}
</style>

<script type="text/javascript">
$(document).ready(function() {
	var container = $('#email_forward_list');

	container.on('click', 'button.remove-trigger', function(ev) {
		ev.preventDefault();
		$(this).parent().parent().parent().hide().find('input').remove();
	});

	container.find('button.add-trigger').on('click', function(ev) {
		ev.preventDefault();
		var html = '<tr><td><div style="float: right"><button class="clean-white remove-trigger">Remove</button></div><input type="text" name="helpdesk_emails[]" placeholder="Email address or a full domain name" value="" /></td></tr>';
		container.find('tbody').find('tr').last().before(html);
	});

	$('#fwd_emails_savebtn').on('click', function(ev) {
		ev.preventDefault();
		$('#email_forward_form').submit();
		$(this).hide();
		$('#fwd_emails_loading').show();
	});

	DP.select($('select.change-linked-dep'));

	$('select.change-linked-dep').on('change', function() {
		var gateway_id = $(this).data('gateway-id');
		var dep_id = $(this).val();
		var el = $(this);
		var me = this;

		if (dep_id != '0') {
			$('select.change-linked-dep').each(function() {
				if (this != me && $(this).val() == dep_id) {
					$(this).select2('val', '0');
					DeskPRO_Window.util.showSavePuff($(this).prev());
				}
			});
		}

		$.ajax({
			url: '{{ path('admin_emailgateways_setlinkeddep') }}',
			data: {
				gateway_id: gateway_id,
				department_id: dep_id
			},
			type: 'POST',
			success: function() {
				DeskPRO_Window.util.showSavePuff(el.prev());
			}
		});
	});

	var overlay = new DeskPRO.UI.Overlay({
		triggerElement: $('#fwd_emails_overlay_trigger'),
		contentElement: $('#fwd_emails_overlay')
	});
});
</script>
{% endblock %}
{% block pagebar %}
	<nav>
		<ul>
			<li style="margin-right: 8px;"><a href="{{ path('admin_emailgateway_errors') }}">View Rejections and Errors</a></li>
			<li class="add"><a href="{{ path('admin_emailgateways_new') }}">{{ phrase('admin.gateway.add_email_gateway') }}</a></li>
		</ul>
	</nav>
	<ul>
		<li><a href="{{ path('admin_emailgateways') }}">{{ phrase('admin.general.email_gateways') }}</a></li>
	</ul>
{% endblock %}
{% block page %}

{{ design.helpbox() }}
	<p>{{ phrase('admin.gateway.explain_email_gateway') }}</p>
{{ design.helpbox_end() }}

<div class="check-grid item-list" id="by_address">
	<table width="100%">
		<thead>
			<tr>
				<th style="text-align:left; padding-left:0;" colspan="2">{{ phrase('agent.general.email_address') }}</th>
				<th style="text-align:left">Department</th>
			</tr>
		</thead>
		<tbody>
			{% for pattern,gateway in all_gateways_byemail %}
				<tr>
					<td style="vertical-align: top;" width="10">
						<input
							type="checkbox"
							class="onoff-slider gateway-toggle-{{ gateway.id }}"
							{% if gateway.is_enabled %}checked="checked"{% endif %}
							data-element-handler="DeskPRO.ElementHandler.CheckboxCallUrl"
							data-url="{{ path('admin_emailgateways_quicktoggle', {'id': gateway.id}) }}"
							data-state-property="is_enabled"
						/>
					</td>
					<td>
						<strong>{{ pattern }}</strong>
						<ul class="small-detail-list">
							<li>
								Incoming Account:
								<a class="editable-link" href="{{ path('admin_emailgateways_edit', { 'id': gateway.id }) }}"><span>
									{{ gateway.title }}
								</span></a>
							</li>
							<li>
								Outgoing account:
								<a class="editable-link" href="{{ path('admin_emailgateways_edit', { 'id': gateway.id }) }}"><span>
									{% if gateway.linked_transport and gateway.linked_transport.transport_type != 'mail' %}
										{{ gateway.linked_transport.title }}
									{% else %}
										Default (send through DeskPRO)
									{% endif %}
								</span></a>
							</li>
						</ul>
					</td>
					<td>
						<select class="change-linked-dep" data-gateway-id="{{ gateway.id }}">
							<option value="0" {% if not gateway.department %}selected="selected"{% endif %}>None</option>
							{% for dep in app.getDataRepository('Department').getRootNodes() if dep.is_tickets_enabled %}
								{% if dep.children|length %}
									<optgroup label="{{ dep.title }}">
										{% for subdep in dep.children %}
											<option data-full-title="{{ dep.title }} &gt; {{ subdep.title }}" value="{{subdep.id}}" {% if gateway.department.id == dep.id %}selected="selected"{% endif %}>{{subdep.title}}</option>
										{% endfor %}
									</optgroup>
								{% else %}
									<option value="{{dep.id}}" {% if gateway.department.id == dep.id %}selected="selected"{% endif %}>{{dep.title}}</option>
								{% endif %}
							{% endfor %}
						</select>
					</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
</div>

<br />

<strong>
	<span class="small-light-icon tipped" data-tipped-options="maxWidth: 250" title="If you want to <em>forward</em> email into any of your defined email account, you need to list the original &quot;From&quot; addresses here.<br /><br />Failing to add the addresses here will result in the helpdesk thinking the unknown email address is a user account. This means any ticket sent to the forward address will have that addresses added as a CC user."></span>
	<span id="fwd_emails_overlay_trigger" class="editable-link"><span>
		Forarded Email Addresses
	</span></span>
</strong>
{% if helpdesk_emails %}
<ul class="small-detail-list">
	{% for addr in helpdesk_emails %}
		<li>{{ addr }}</li>
	{% endfor %}
</ul>
{% endif %}

<div id="fwd_emails_overlay" style="width: 700px; height: 600px; display: none;">
	<div class="overlay-title">
		<span class="close-overlay"></span>
		<h4>Forwarded Email Addresses</h4>
	</div>
	<div class="overlay-content">
		<p style="margin-bottom: 8px">
			If you want to <em>forward</em> email into any of your defined email account, you need to list the original &quot;From&quot; addresses here.
		</p>
		<p style="margin-bottom: 8px">
			For example, if you wanted to configure your email server with an alias <em>example-alias@{{ app.getSetting('core.deskpro_url')|url_domain }}</em>
			to your email account <em>example@{{ app.getSetting('core.deskpro_url')|url_domain }}</em>, then you need to add <em>example-alias@{{ app.getSetting('core.deskpro_url')|url_domain }}</em>
			to this list so the system knows how to properly map the address.
		</p>

		<form action="{{ path('admin_emailgateways_savehdaddr') }}" method="POST" id="email_forward_form">
			<input type="hidden" name="process" value="1" />
			<div class="check-grid item-list" id="email_forward_list">
				<table width="100%">
					<thead>
						<tr>
							<th style="text-align:left">Forwarded Email Addresses</th>
						</tr>
					</thead>
					<tbody>
						{% for addr in helpdesk_emails %}
							<tr>
								<td>
									<div style="float: right">
										<button class="clean-white remove-trigger">Remove</button>
									</div>
									<input type="text" name="helpdesk_emails[]" value="{{ addr }}" placeholder="Email address or a full domain name" />
								</td>
							</tr>
						{% endfor %}

						<tr>
							<td>
								<button class="clean-white add-trigger">Add New Address</button>
							</td>
						</tr>
					</tbody>
				</table>
			</div>
		</form>
	</div>
	<div class="overlay-footer">
		<div id="setout_save_wrap">
			<button class="clean-white" id="fwd_emails_savebtn">Save Changes</button>
		</div>
		<div id="fwd_emails_loading" style="display: none;">
			<img src="{{ asset('images/spinners/loading-small-flat.gif') }}" />
		</div>
	</div>
</div>

{% endblock %}
