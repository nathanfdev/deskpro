{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block pagebar %}
	<nav>
		<ul>
			<li class="add"><a href="{{ path('admin_emailgateways_new') }}">{{ phrase('admin.emailgateways.add_email_gateway') }}</a></li>
		</ul>
	</nav>
	<ul>
		<li><a href="{{ path('admin_emailgateways') }}">{{ phrase('admin.emailgateways.email_gateways') }}</a></li>
	</ul>
{% endblock %}
{% block sidebar_right %}
<div class="dp-page-box">
	<div class="resource-item-list">
		<header>
			<div class="controls">
				<a class="clean-white small" href="{{ path('admin_emailtrans_newaccount') }}">{{ phrase('admin.emailgateways.new') }}</a>
			</div>
			<h4>{{ phrase('admin.emailgateways.outgoing_email_accounts') }}</h4>
		</header>
		<article>
			{% if all_transports|length > 1 %}{# > 1 because 1 is always the 'all' transport #}
				<ul class="item-list">
					{% for transport in all_transports %}{% if transport.match_type != 'all' %}
						<li>
							<div class="dp-block-controls">
								<ul>
									<li class="dp-edit"><a href="{{ path('admin_emailtrans_editaccount', { 'id': transport.id }) }}"><span></span></a></li>
								</ul>
							</div>

							From:
							<a href="{{ path('admin_emailtrans_editaccount', { 'id': transport.id }) }}">
							{% if transport.match_type == 'exact' %}{{ transport.match_pattern }}
							{% elseif transport.match_type == 'domain' %}*@{{ transport.match_pattern }}
							{% elseif transport.match_type == 'regex' %}{{ transport.match_pattern }}
							{% endif %}
							</a>
							<br />
							{{ phrase('admin.emailgateways.send_through') }}:<br />
							&nbsp;&nbsp;&nbsp;<span title="{{ transport.title }}">{{ transport.title|truncate(45) }}</span>
						</li>
					{% endif %}{% endfor %}
				</ul>
				<p>
					When none of the above rules match, email will be sent through the <a href="{{ path('admin_emailtrans_setup') }}">default outgoing account</a>.
				</p>
			{% else %}
				<p>
					All email is currently being sent through the <a href="{{ path('admin_emailtrans_setup') }}">default outgoing account</a>.
				</p>
				<p>
					You may <a href="{{ path('admin_emailtrans_newaccount') }}">add a new account</a> to send emails using different servers. For example,
					if your SMTP server requires authentication for each specific "From" address, you will need to create multiple outgoing accounts
					for each "From" address you plan to support.
				</p>
			{% endif %}
		</article>
	</div>
</div>
{% endblock %}
{% block page %}

{{ design.helpbox() }}
	<p>
		An email gateway reads email from an email account you control and converts those emails into tickets in DeskPRO for your
		agents to read and respond to. This allows you to communicate seamlessly with users via normal email.
	</p>
{{ design.helpbox_end() }}

<div class="check-grid item-list">
	<table width="100%">
		<thead>
			<tr>
				<th style="text-align:left">&nbsp; Account</th>
				<th style="text-align:left" width="10">&nbsp;</th>
			</tr>
		</thead>
		<tbody>
			{% for gateway in all_gateways %}
				<tr>
					<td>
						<input
							type="checkbox"
							class="onoff-slider"
							{% if gateway.is_enabled %}checked="checked"{% endif %}
							data-element-handler="DeskPRO.ElementHandler.CheckboxCallUrl"
							data-url="{{ path('admin_emailgateways_quicktoggle', {'id': gateway.id}) }}"
							data-state-property="is_enabled"
						/>
						{{ gateway.title }}
					</td>
					<td style="padding: 3px 3px 0 0">
						<a href="{{ path('admin_emailgateways_edit', { 'id': gateway.id }) }}"><span class="btn-edit-gear"></span></a>
					</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
</div>

{% endblock %}
