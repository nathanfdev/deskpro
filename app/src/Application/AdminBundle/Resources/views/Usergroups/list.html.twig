{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block pagebar %}
     <nav>
          <ul>
               <li class="add"><a href="{{ path('admin_usergroups_new') }}">{{ phrase('admin.user_groups.add_usergroup') }}</a></li>
          </ul>
     </nav>
     <ul>
          <li>{{ phrase('agent.general.usergroups') }}</li>
     </ul>
{% endblock %}

{% block page %}

<div class="check-grid item-list">
	<table width="100%">
		<thead>
			<tr>
				<th style="text-align:left">&nbsp; {{ phrase('agent.general.usergroup') }}</th>
				<th style="text-align:center" width="180">{{ phrase('agent.general.number_of_members') }}</th>
				<th style="text-align:left" width="50">&nbsp;</th>
			</tr>
		</thead>
		<tbody>
			<tr>
				<td>{{ phrase('agent.general.usergroup_everyone') }}</td>
				<td style="text-align:center">
					<a href="{{ path('admin_usergroups_browse', {'id': '1'})}}">{{ member_counts[0]|default('0') }}</a>
				</td>
				<td style="padding: 3px 3px 0 0; text-align: right;">
					<a href="{{ path('admin_usergroups_edit', {'id': 1}) }}"><span class="btn-edit-gear"></span></a>
				</td>
			</tr>
		{% for usergroup in usergroups %}
			<tr>
				<td>
					{{ usergroup.title }}
					{% if usergroup.note %}
						<div style="font-size: 9px; margin-left: 15px;">{{ usergroup.note }}</div>
					{% endif %}
				</td>
				<td style="text-align:center"><a href="{{ path('admin_usergroups_browse', {'id': usergroup.id})}}">{{ member_counts[usergroup.id]|default('0') }}</a></td>
				<td style="padding: 3px 3px 0 0; text-align: right;">
					<a href="{{ path('admin_usergroups_edit', {'id': usergroup.id}) }}"><span class="btn-edit-gear"></span></a>
				</td>
			</tr>
		{% endfor %}
		</tbody>
	</table>
</div>

{% endblock %}
