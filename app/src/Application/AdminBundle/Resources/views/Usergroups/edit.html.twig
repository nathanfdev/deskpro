{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block pagebar %}
     <ul>
         <li><a href="{{ path('admin_usergroups') }}">{{ phrase('agent.global.usergroups') }}</a></li>
		 {% if usergroup.id %}
		 	<li>{{ phrase('admin.usergroups.edit_usergroup') }}</li>
		 {% else %}
		 	<li>{{ phrase('admin.usergroups.new_usergroup') }}</li>
		 {% endif %}
     </ul>
{% endblock %}
{% block page %}

<form action="{{ path('admin_usergroups_edit', {'id': usergroup.id|default(0)}) }}" method="post">
{{ form_token('edit_usergroup') }}

<input type="hidden" name="process" value="1" />

<div class="dp-form">
	<div class="dp-form-section">
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('agent.global.title') }}</label>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.title) }}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('admin.usergroups.note_description') }}</label>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.note, {'attr': {'style': 'height: 50px'}}) }}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('agent.global.number_of_members') }}</label>
			</div>
			<div class="dp-form-input">
				{{ member_count|default('0') }} (<a href="{{ path('admin_usergroups_browse', {'id': usergroup.id})}}">{{ phrase('admin.usergroups.browse') }}</a>)
			</div>
		</div>
	</div>

	<div class="dp-form-section">
		<div class="dp-form-label">
			<label>{{ phrase('agent.global.permissions') }}</label>
		</div>
		<div class="dp-form-input">
			{% include 'AdminBundle:Usergroups:edit-permtable.html.twig' %}
		</div>
	</div>
</div>

<footer class="controls">
	<div class="is-not-loading">
		<button class="clean-white">{{ phrase('admin.usergroups.save_usergroup') }}</button>
	</div>
	<div class="is-loading">
		<div class="loading-icon-flat">&nbsp;</div>
	</div>
</footer>

<br class="clear" />
</form>

{% if usergroup.id and usergroup.id != 1 %}
<div class="delete-link-wrap">
	<a href="{{ path('admin_usergroups_delete', {'id': usergroup.id, 'auth': security_token('delete_usergroup') }) }}" onclick="return confirm('Are you sure you want to delete this usergroup?');">{{ phrase('agent.global.delete') }}</a>
</div>
{% endif %}

{% endblock %}
