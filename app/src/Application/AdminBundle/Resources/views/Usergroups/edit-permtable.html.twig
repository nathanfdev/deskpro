<nav class="check-grid-tabs">
	<ul data-element-handler="DeskPRO.ElementHandler.SimpleTabs" data-trigger-elements="> li">
		<li class="on" data-tab-for="#permgroup_tickets"><span>{{ phrase('agent.global.tickets') }}</span></li>
		<li data-tab-for="#permgroup_chat"><span>{{ phrase('agent.global.chat') }}</span></li>
		<li data-tab-for="#permgroup_feedback"><span>{{ phrase('agent.global.feedback') }}</span></li>
		<li data-tab-for="#permgroup_articles"><span>{{ phrase('agent.global.articles') }}</span></li>
		<li data-tab-for="#permgroup_downloads"><span>{{ phrase('agent.global.downloads') }}</span></li>
		<li data-tab-for="#permgroup_news"><span>{{ phrase('agent.global.news') }}</span></li>
	</ul>
</nav>

<div id="permgroup_tickets" style="display: none" class="dp-form-box">
	<!-- PERMISSION:tickets.use --><input class="onoff-slider" type="checkbox" {% if permissions['tickets.use'] or not usergroup.id %}checked="checked"{% endif %} name="permissions[tickets.use]" value="1" /> {{ phrase('admin.usergroups.can_use_tickets') }}
	<div class="check-grid" style="max-height: 200px; overflow: auto;">
		<table width="100%">
			<thead>
				<tr>
					<th style="text-align: left;">{{ phrase('admin.global.departments') }}</th>
					<th width="60">&nbsp;</th>
				</tr>
			</thead>
			<tbody>
				{% for dep in departments %}
					<tr>
						{% if dep.children|length %}
							<td class="title title-group">{{ dep.title }}</td>
							<td class="prop">&nbsp;</td>
						{% else %}
							<td class="title">{{ dep.title }}</td>
							<td class="prop"><input class="onoff-slider" type="checkbox" {% if ug_deps[dep.id].tickets or not usergroup.id %}checked="checked"{% endif %} name="department_permissions[{{ dep.id }}][tickets]" value="1" /></td>
						{% endif %}
					</tr>
					{% if dep.children %}
						{% for subdep in dep.children %}
							<tr>
								<td class="title">&nbsp;&nbsp;&nbsp;&nbsp; {{ subdep.title }}</td>
								<td class="prop"><input class="onoff-slider" type="checkbox" {% if ug_deps[subdep.id].tickets or not usergroup.id %}checked="checked"{% endif %} name="department_permissions[{{ subdep.id }}][tickets]" value="1" /></td>
							</tr>
						{% endfor %}
					{% endif %}
				{% endfor %}
			</tbody>
		</table>
	</div>
</div>

