{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block pagetitle %}
	<h1>{{ phrase('admin.test.test_page') }}</h1>
{% endblock %}
{% block page %}

<div class="layout-content with-scrollbar" id="testscroll" style="width: 500px; height: 500px; position: relative;">
<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
<div class="scroll-viewport"><div class="scroll-content">
	<div style="background-color: #555"><br /><br /><br /><br /></div>
	<div style="background-color: #ccc"><br /><br /><br /><br /></div>
	<div style="background-color: #fff"><br /><br /><br /><br /></div>
	<div style="background-color: #ccc"><br /><br /><br /><br /></div>
	<div style="background-color: #fff"><br /><br /><br /><br /></div>
	<div style="background-color: #ccc"><br /><br /><br /><br /></div>
	<div style="background-color: #fff"><br /><br /><br /><br /></div>
	<div style="background-color: #ccc"><br /><br /><br /><br /></div>
	<div style="background-color: #fff"><br /><br /><br /><br /></div>
	<div style="background-color: #ccc"><br /><br /><br /><br /></div>
	<div style="background-color: #fff"><br /><br /><br /><br /></div>
	<div style="background-color: #ccc"><br /><br /><br /><br /></div>
	<div style="background-color: #fff"><br /><br /><br /><br /></div>
	<div style="background-color: #ccc"><br /><br /><br /><br /></div>
	<div style="background-color: #fff"><br /><br /><br /><br /></div>
	<div style="background-color: #555"><br /><br /><br /><br /></div>
</div></div></div>


{#
	- overlay-title and overlay-footer are optional
	- you must always specify a width/height on the wrapper, if you need it to be dynamic
	then you'll need to hack that in using the events on Overlay
	- the inner content must always be called overlay-content
#}
<div id="overlay_wrapper" style="width: 400px; height: 400px; display: none;">
	<div class="overlay-title">
		<span class="close-overlay"></span>
		<h4>{{ phrase('admin.test.overlay_title') }}</h4>
	</div>
	<div class="overlay-content">
		<p>{{ phrase('admin.test.overlay_content') }}</p>
	</div>
	<div class="overlay-footer">
		<button class="clean-white">{{ phrase('admin.test.overlay_footer') }}</button>
	</div>
</div>


<script type="text/javascript">
	$(document).ready(function() {
		var overlay = new DeskPRO.UI.Overlay({
			triggerElement: $('#open_overlay_btn'),
			contentElement: $('#overlay_wrapper')
		});

		$('#testscroll').tinyscrollbar();

		window.gototop = function() {
			$('#testscroll').trigger('goscrolltop');
		}
	});
</script>
{% endblock %}
