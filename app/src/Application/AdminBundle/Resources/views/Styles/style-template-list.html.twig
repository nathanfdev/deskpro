{% extends 'AdminBundle::layout.html.twig' %}
{% block content %}

<div class="block" id="block-tables">
	<div class="content">
		<h2 class="title">Templates</h2>
		<div class="inner">
			{% for bundle, template_list in template_files %}
				<table class="table">
					<tr>
						<th class="first" colspan="3">{{bundle}}</th>
					</tr>
					{% for template in template_list %}
						<tr>
							<td width="10"><!--TODO: Icon--></td>
							<td>{{template}}</td>
							<td width="50" style="text-align: right;"><a href="{{ path('admin_styles_edittemplate', {'style_id': style.id, 'template_name': template}) }}">Edit</a>
						</tr>
					{% endfor %}
				</table>
			{% endfor %}
		</div>
	</div>
</div>

{% endblock %}
{% block sidebar %}
	{% include 'AdminBundle:Styles:_style_sidebar.html.twig' %}
{% endblock %}