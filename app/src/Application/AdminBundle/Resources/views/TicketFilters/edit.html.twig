{% extends 'AdminBundle::layout.html.twig' %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
$(document).ready(function() {
	var criteriaEditor = new DeskPRO.Form.RuleBuilder($('.criteria-tpl'));

	$('.criteria-form .add-term').on('click', function() {
		var basename = 'terms['+Orb.uuid()+']';
		criteriaEditor.addNewRow($('.criteria-form .search-terms'), basename);
	});

	{% if filter.terms %}
	var terms = {{filter.terms|json_encode|raw}};
	Array.each(terms, function(info, x) {
		var basename = 'terms[' + Orb.uuid() + ']';
		criteriaEditor.addNewRow($('.criteria-form .search-terms'), basename, {
			type: info.type,
			op: info.op,
			options: info.options
		});
	});
	{% endif %}
});
</script>
{% endblock %}
{% block pagebar %}
	<ul>
		<li><a href="{{ path('admin_tickets_filters') }}">{{ phrase('admin.tickets.ticket_filters') }}</a></li>
		<li>{% if filter.id %}Edit Filter{% else %}New Filter{% endif %}</li>
	</ul>
{% endblock %}
{% block page %}

<form action="{{ path('admin_tickets_filters_edit', {'filter_id': filter.id|default(0)}) }}" method="post" class="dp-form">
<input type="hidden" name="process" value="1" />

<div class="dp-form-row">
	<div class="dp-form-label">
		<label>{{ phrase('agent.global.type') }}</label>
	</div>
	<div class="dp-form-input">
		{% if filter.is_global %}
			Global filter
		{% elseif filter.agent_team %}
			Team filter for {{ filter.agent_team.name }}
		{% else %}
			Custom filter for {{ filter.person.display_name }}
		{% endif %}
	</div>
</div>
<div class="dp-form-row">
	<div class="dp-form-label">
		<label>{{ phrase('agent.global.title') }}</label>
	</div>
	<div class="dp-form-input">
		<input type="text" name="filter[title]" value="{{filter.title}}" />

		{% if not filter.id %}
		<input type="hidden" name="filter[person_id]" value="{{filter.person.id|default(0)}}" />
		<input type="hidden" name="filter[agent_team_id]" value="{{filter.agent_team.id|default(0)}}" />
		<input type="hidden" name="filter[is_global]" value="{{ filter.is_global + 0 }}" />
		{% endif %}
	</div>
</div>
<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('agent.global.criteria') }}</label>
		</div>

	<div class="dp-form-input">
		<div class="criteria-form search-form">
			<div class="search-terms"></div>
			<div class="term"><span class="add-term">+</span> {{ phrase('agent.global.add_a_new_criteria') }}</div>
		</div>
	</div>
</div>

{% if filter.id %}
	{% if filter.is_global or filter.agent_team %}
		{% if filter_users %}
			<div style="float: left; width: 45%; margin-right: 20px">
				<div class="dp-form-row">
					<div class="dp-form-label">
						<label>
							{{ phrase('admin.tickets.in_use_by') }}:
						</label>
					</div>

					<div class="dp-form-input">
						<div class="icon-list-box" style="width: 98%">
							<ul>
								{% for agent in filter_users %}
									<li>
										<img src="{{ agent.getPictureUrl(20) }}" class="list-icon" />
										{{ agent.display_name }}
									</li>
								{% endfor %}
							</ul>
						</div>
					</div>
				</div>
			</div>
		{% endif %}
		{% if filter_users_ignore %}
			<div style="float: left; width: 45%; margin-right: 8px">
				<div class="dp-form-row">
					<div class="dp-form-label">
						<label>
							{{ phrase('admin.tickets.disabled_by') }}:
						</label>
					</div>

					<div class="dp-form-input">
						<div class="icon-list-box" style="width: 98%">
							<ul>
								{% for agent in filter_users_ignore %}
									<li>
										<img src="{{ agent.getPictureUrl(20) }}" class="list-icon" />
										{{ agent.display_name }}
									</li>
								{% endfor %}
							</ul>
						</div>
					</div>
				</div>
			</div>
		{% endif %}
		<br class="clear" />
	{% else %}
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>
					{{ phrase('admin.tickets.only_name_has_filter_access', {'name':filter.person.name}) }}
				</label>
			</div>
			<div class="dp-form-input">
				{% if not filter_users %}
                    {{ phrase('admin.tickets.name_has_filter_disabled', {'name':filter.person.name}) }}
				{% else %}
					{{ phrase('admin.tickets.name_has_filter_enabled', {'name':filter.person.name}) }}
				{% endif %}
			</div>
		</div>
	{% endif %}
{% endif %}

<button class="clean-white save-trigger">{{ phrase('agent.global.save') }}</button>

</form>

{% include 'DeskPRO:Common:ticket-search-criteria.html.twig' with { 'classname': 'criteria-tpl', 'term_options': term_options, 'search_context': 'filter' } %}

{% endblock %}
