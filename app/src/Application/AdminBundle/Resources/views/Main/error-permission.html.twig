<!DOCTYPE HTML>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="robots" content="NOINDEX" />
	<meta http-equiv="X-UA-Compatible" content="IE=100" />

	<script type="text/javascript">
		{% if constant('DP_DEBUG') %}
			DP_DEBUG = true;
		{% else %}
			DP_DEBUG = false;
		{% endif %}
	</script>

	{{ dp_asset_html('agent_vendors_css') }}
	{{ dp_asset_html('agent_interface_css') }}
	{{ dp_asset_html('admin_interface_css') }}

	{{ dp_asset_html('agent_vendors') }}
	{{ dp_asset_html('agent_common') }}
	{{ dp_asset_html('agent_deskpro_ui') }}
    {{ dp_asset_html('admin_admin_ui') }}
    {{ dp_asset_html('admin_admin_handlers') }}

	{% block html_head %}{% endblock %}
	{% block page_js_exec %}{% endblock %}

	<script type="text/javascript" src="{{ asset('vendor/less/less.min.js') }}"></script>
</head>
<body>
<div id="dp_page_wrap">
<div id="dp_admin_pagebar">
	<ul>
		<li>{{ phrase('admin.menu.no_permission') }}</li>
	</ul>
</div>
<div id="dp_admin_page">
	<div id="dp_admin_page_inner">
		<div class="dp-page-box">
			<div class="page-content">
				{% if message %}
					{{ message }}
				{% else %}
					{{ phrase('admin.menu.you_do_not_have_permission_to_view_use') }}
				{% endif %}
			</div>
		</div>
	</div>
</div>
</div>
</body>
</html>
