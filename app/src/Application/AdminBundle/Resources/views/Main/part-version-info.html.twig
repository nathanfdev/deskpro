{% if version_info %}
	<div style="padding-top: 5px; padding-bottom: 5px;">
		The latest build is
		<span class="{% if version_info.build == constant('DP_BUILD_TIME') %}{% else %}label important{% endif %}">#{{ version_info.build_num }}</span>
		(built on {{ version_info.build|date('Y-m-d') }}).
	</div>

	<article class="box-hint" style="text-align: center">
		{% if version_info.build == constant('DP_BUILD_TIME') %}
			{{ phrase('admin.general.you_are_up_to_date') }}
		{% else %}
			{{ phrase('admin.general.you_are_outdated_by_x_buils', {count: version_info.count_behind}) }}
			<a style="margin-top: 5px" class="btn primary" href="{{ path('admin_upgrade') }}">{{ phrase('admin.general.click_here_for_upgrade_instructions') }}</a>
		{% endif %}
	</article>
{% endif %}