{% extends 'AdminBundle::layout.html.twig' %}
{% block pagetitle %}
	<h1>{% if priority.id %}Edit Priority{% else %}New Priority{% endif %}</h1>
	<nav>
		<a class="clean-white" href="{{ path('admin_ticketpris') }}">&larr; {{ phrase('admin.tickets.back_to_ticket_properties') }}</a>
	</nav>
{% endblock %}
{% block page %}

<form action="{{ path('admin_ticketpris_edit', {'priority_id': priority.id|default(0)}) }}" method="post">
<input type="hidden" name="process" value="1" />

<div class="dp-form">
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('agent.general.title') }}</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.title) }}
		</div>
	</div>
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('agent.general.priority') }}</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.priority, {'attr': {'size': 4} }) }}
		</div>
	</div>
</div>

{{ form_rest(form) }}

<button class="btn primary save-trigger">{{ phrase('agent.general.save') }}</button>
</form>

<div class="delete-link-wrap">
	<a href="{{ path('admin_ticketpris_del', {'priority_id': priority.id}) }}">{{ phrase('agent.general.delete') }}</a>
</div>
{% endblock %}
