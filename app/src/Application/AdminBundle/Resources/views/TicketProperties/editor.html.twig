{% set this_page = 'ticket_editor' %}
{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/ElementHandler/TicketEditor.js') }}"></script>
<script type="text/javascript">
var TICKET_DISPLAY_DATA = {{ page_data|json_encode|raw }};
</script>
{% endblock %}
{% block page_nav_inner %}
<div class="page-nav-block">
	<div class="inner-shadow"></div>
	<section class="top">
		{% if is_default and not (not department and section == 'create') %}<div class="disable-overlay"></div>{% endif %}
		<header>
			<h4>{{ phrase('admin.ticketproperties.ticket_elements') }}</h4>
		</header>
		<article id="ticket_elements">
			<ul>
				<li class="draggable irremovable" data-item-id="ticket_department" data-edit-title="{{ phrase('admin.ticketproperties.edit_departments') }}" data-edit-url="{{ path('admin_departments') }}"><label>{{ phrase('global.department') }}</label></li>
				{% if section == 'create' %}
					<li class="draggable irremovable" data-item-id="message"><label>{{ phrase('admin.ticketproperties.ticket_message') }}</label></li>
					<li class="draggable irremovable" data-item-id="ticket_subject"><label>{{ phrase('admin.ticketproperties.ticket_subject') }}</label></li>
					<li class="draggable" data-item-id="attachments"><label>{{ phrase('global.attachments') }}</label></li>
				{% endif %}
				<li class="draggable" data-item-id="ticket_category" data-edit-title="{{ phrase('global.edit_categories') }}" data-edit-url="{{ path('admin_ticketcats') }}"><label>{{ phrase('global.category') }}</label></li>
				<li class="draggable" data-item-id="ticket_product" data-edit-title="{{ phrase('admin.ticketproperties.edit_products') }}" data-edit-url="{{ path('admin_products') }}"><label>{{ phrase('global.product') }}</label></li>
				<li class="draggable" data-item-id="ticket_priority" data-edit-title="{{ phrase('admin.ticketproperties.edit_priorities') }}" data-edit-url="{{ path('admin_ticketpris') }}"><label>{{ phrase('global.priority') }}</label></li>
				{% for field in custom_ticket_fields %}
				<li class="draggable" data-item-id="ticket_field[{{field.field_def.id}}]" data-edit-title="{{ phrase('global.edit_field') }}" data-edit-url="{{ path('admin_customdeftickets_edit', {field_id: field.field_def.id}) }}">
				<label>{{field.title}}</label>
					</li>
				{% endfor %}
				{% if section == 'create' %}
					<li class="draggable" data-item-id="captcha"><label>{{ phrase('admin.ticketproperties.captcha') }}</label></li>
				{% endif %}
			</ul>
		</article>
	</section>
</div>
<div class="page-nav-block">
	<div class="inner-shadow"></div>
	<section class="top">
		<header>
			<h4>{{ phrase('admin.ticketproperties.embed_into_your_website') }}</h4>
		</header>
		<article class="with-single-button">
			<button class="clean-white small" id="embed_form_overlay_trigger" data-load-url="{{ path('admin_tickets_editor_form_embed', {department_id: department.id|default(0)}) }}">{{ phrase('admin.ticketproperties.integration_options') }}</button>
		</article>
	</section>
</div>
{% endblock %}
{% block pagebar %}
	<ul>
		<li>Ticket Layout Editor: {% if department %}{{ department.full_title }}{% else %}Default{% endif %}</li>
	</ul>
{% endblock %}
{% block content %}

<div style="padding: 10px 10px 0 10px">
{{ design.helpbox() }}
	<p>
        {{ phrase('admin.ticketproperties.notice_you_can_edit_the_form') }}
	</p>
{{ design.helpbox_end() }}
</div>

<div class="pagetop-option">
	<input type="checkbox" class="onoff-slider" id="per_department_check" data-update-url="{{ path('admin_tickets_editor_toggleper') }}" {% if app.getSetting('core_tickets.per_department_form') %}checked="checked"{% endif %}/> {{ phrase('admin.ticketproperties.enable_custom_layouts_for_each_department') }}
	{% if app.getSetting('core_tickets.per_department_form') %}
		<div class="sub">
            {% set phrase_link1 %}
            <a class="switcher" href="{{ path('admin_tickets_editor_dep', {'department_id': '0', 'section': section}) }}">{{ phrase('admin.ticketproperties.default_layout') }}</a>
            {% endset %}
            <span id="department_switcher" class="switcher"><span>{{ phrase('global.department') }}</span></span>
            {% set phrase_link2 %}
            {% endset %}
            {{ phrase('admin.ticketproperties.edit_default_layout_or_select_another', {'link1':phrase_link1,'link2':phrase_link2}) }}
		</div>
	{% endif %}
</div>

<div class="content-tabs">
	<nav>
		<span class="saving-text" id="saving_text" style="display: none">{{ phrase('global.saving') }}</span>
		<ul>
			<li {% if section == 'create' %}class="on"{% endif %}>
				<a href="{{ path('admin_tickets_editor_dep', {'department_id': department.id|default('0')}) }}">{{ phrase('admin.ticketproperties.new_ticket_form') }}</a>
			</li>
			<li {% if section == 'view' %}class="on"{% endif %}>
				<a href="{{ path('admin_tickets_editor_dep', {'department_id': department.id|default('0'), 'section': 'view'}) }}">{{ phrase('admin.ticketproperties.view_ticket_page') }}</a>
			</li>
			<li class="{% if section == 'modify' %}on{% endif %}">
				<a href="{{ path('admin_tickets_editor_dep', {'department_id': department.id|default('0'), 'section': 'modify'}) }}">{{ phrase('admin.ticketproperties.modify_ticket_form') }}</a>
			</li>
		</ul>
		<br />
	</nav>

	{% if not (not department and section == 'create') %}
	<div class="editor-toggle-alt-view">
		<input
			type="checkbox"
			class="onoff-slider"
			id="alternative_view_toggle"
			data-enable="{{ path('admin_tickets_editor_dep_init', {department_id: department.id|default(0), section: section}) }}"
			data-disable="{{ path('admin_tickets_editor_dep_revert', {department_id: department.id|default(0), section: section}) }}"
			{% if not is_default %}checked="checked"{% endif %}
		/>
        {% if section == 'view' %}
        {% set phrase_part = phrase('admin.ticketproperties.view_ticket_page') %}
        {% elseif section == 'create' %}
        {% set phrase_part = phrase('admin.ticketproperties.new_ticket_form') %}
        {% else %}
        {% set phrase_part = phrase('admin.ticketproperties.modify_ticket_form') %}
        {% endif %}
        {{ phrase('admin.ticketproperties.enable_alternative_for_x', {'subphrase':phrase_part}) }}
	</div>
	{% endif %}

	<section>
		<form
			action="{{ path('admin_tickets_editor_dep_save', {'department_id': department.id|default(0), 'section': section }) }}"
			method="post"
			class="dp-page-box"
			id="admin_ticket_editor"
			data-element-handler="DeskPRO.Admin.ElementHandler.TicketEditor"
			data-section="{{section}}"
		>
		{% if is_default and not (not department and section == 'create') %}<div class="disable-overlay"></div>{% endif %}

		<ul id="admin_ticket_editor_items" class="dp-form">
			<li class="no-items-notice">
				{{ phrase('admin.ticketproperties.drag_and_drop_fields_from_the_left_onto') }}
			</li>
		</ul>
		</form>
	</section>
</div>

{############################
 # Main row template
 ############################}
<script type="text/x-deskpro-plain" id="editor_row_tpl">
	<li class="form-item dp-form-row">
		<div class="dp-block-controls">
			<ul>
				<li class="dp-edit-fields"><span></span></li>
				<li class="dp-edit edit-field-trigger"><span></span></li>
				<li class="dp-remove remove-field-trigger"><span></span></li>
				<li class="dp-move"><span></span></li>
			</ul>
		</div>
		<div class="dp-form-label">
			<label class="field-title"></label>
		</div>
		<article class="dp-form-input"></article>

		<div class="field-options-overlay" style="width: 550px; height: 260px; display: none;">
			<div class="overlay-title">
				<span class="close-trigger close-overlay"></span>
				<h4>{{ phrase('admin.ticketproperties.field_options') }}</h4>
			</div>
			<div class="overlay-content">
				<div class="dp-form">
					<div class="choices-container"></div>
					<div class="dp-form-row">
						<div class="dp-form-label">
							<label>
                                {% set phrase_part %}
								<select name="term_match_type">
                                    <option value="all">{{ phrase('admin.ticketproperties.all') }}</option>
                                    <option value="any">{{ phrase('admin.ticketproperties.any') }}</option>
                                </select>
                                {% endset %}
                                {{ phrase('admin.ticketproperties.only_show_field_when_choice', {'choice':phrase_part}) }}
                            </label>
						</div>
						<div class="dp-form-input">
							<div class="criteria-form search-form">
								<div class="search-terms"></div>
								<div class="term"><span class="add-term">+</span> {{ phrase('global.add_a_new_criteria') }}</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</li>
</script>

{############################
 # For choice-type fields, allow selection of which options to display
 ############################}
<script type="text/x-deskpro-plain" id="field_options_choices_tpl">
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>
				<input type="checkbox" class="custom_options" name="custom_options" value="1" /> {{ phrase('admin.ticketproperties.customize_choices_to_display') }}
			</label>
		</div>
		<div class="dp-form-input custom-options" style="display:none"></div>
	</div>
</script>

{############################
 # Subject
 ############################}
<script type="text/x-deskpro-plain" id="rendered_field_ticket_subject">
	<div class="subject">
		<input type="text" />
	</div>
</script>

{############################
 # {{ phrase('global.department') }}
 ############################}
<script type="text/x-deskpro-plain" id="rendered_field_ticket_department">
	<div class="subject">
		<select><option></option><option>------------------</option></select>
	</div>
</script>

{############################
 # Message field
 ############################}
<script type="text/x-deskpro-plain" id="rendered_field_message">
	<div class="message">
		<textarea class="message-input" style="height: 80px"></textarea>
	</div>
</script>

{############################
 # Attachments field
 ############################}
<script type="text/x-deskpro-plain" id="rendered_field_attachments">
	<div class="attachments">
		<input type="file" /> <button class="clean-white small">{{ phrase('global.upload') }}</button>
	</div>
</script>

{############################
 # Category field value
 ############################}
<script type="text/x-deskpro-plain" id="rendered_field_ticket_category">
	<div class="ticket-category">
		<select class="ticket-category-input field-value">
			<option>{{ phrase('admin.ticketproperties.choose_a_category') }}</option>
			{% for id,label in term_options.ticket_categories_full %}
				<option value="{{id}}">{{label}}</option>
			{% endfor %}
		</select>
	</div>
</script>

{############################
 # Product field value
 ############################}
<script type="text/x-deskpro-plain" id="rendered_field_ticket_product">
	<div class="ticket-product">
		<select class="ticket-product-input field-value">
			<option>{{ phrase('admin.ticketproperties.choose_a_product') }}</option>
			{% for id,label in term_options.products %}
				<option value="{{id}}">{{label}}</option>
			{% endfor %}
		</select>
	</div>
</script>

{############################
 # Priority field value
 ############################}
<script type="text/x-deskpro-plain" id="rendered_field_ticket_priority">
	<div class="ticket-priority">
		<select class="ticket-priority-input field-value">
			<option>{{ phrase('admin.ticketproperties.choose_a_priority') }}</option>
			{% for id,label in term_options.priorities %}
				<option value="{{id}}">{{label}}</option>
			{% endfor %}
		</select>
	</div>
</script>

{############################
 # Custom fields
 ############################}

{% for field in custom_ticket_fields %}
	<script type="text/x-deskpro-plain" id="rendered_field_ticket_field_{{field.id}}">
		<div class="ticket-field field-value">
			{{ render_custom_field_form(field) }}
		</div>
	</script>
{% endfor %}

{############################
 # Captcah field rnedered
 ############################}
<script type="text/x-deskpro-plain" id="rendered_field_captcha">
	<div class="captcha">
		<img src="{{ asset('images/admin/captcha-example.png') }}"
	</div>
</script>


{############################
 # Criteria options
 ############################}
<div id="criteria_tpl" class="search-builder-tpl" style="display:none">
	<div class="row">
		<div class="term">
			<div class="type"></div>
			<div class="op"></div>
			<div class="options"></div>
			<div class="remove">-</div>
		</div>
	</div>
	{% if term_options.products %}
		<div class="type" title="{{ phrase('global.product') }}" data-rule-type="product">
			<div class="op">
				<select name="op">
					<option value="is">{{ phrase('global.is') }}</option>
					<option value="not">{{ phrase('global.is_not') }}</option>
				</select>
			</div>
			<div class="options">
				<select name="product">
					{% for id,label in term_options.products %}
						<option value="{{id}}">{{label}}</option>
					{% endfor %}
				</select>
			</div>
		</div>
	{% endif %}
	{% if term_options.ticket_categories_full %}
		<div class="type" title="{{ phrase('global.category') }}" data-rule-type="category">
			<div class="op">
				<select name="op">
					<option value="is">{{ phrase('global.is') }}</option>
					<option value="not">{{ phrase('global.is_not') }}</option>
				</select>
			</div>
			<div class="options">
				<select name="category">
					{% for id,label in term_options.ticket_categories_full %}
						<option value="{{id}}">{{label}}</option>
					{% endfor %}
				</select>
			</div>
		</div>
	{% endif %}
	{% if term_options.priorities %}
		<div class="type" title="{{ phrase('global.priority') }}" data-rule-type="priority">
			<div class="op">
				<select name="op">
					<option value="is">{{ phrase('global.is') }}</option>
					<option value="not">{{ phrase('global.is_not') }}</option>
					<option value="lt">{{ phrase('global.is_less_than') }}</option>
					<option value="gt">{{ phrase('global.is_greater_than') }}</option>
				</select>
			</div>
			<div class="options">
				<select name="priority">
					{% for id,label in term_options.priorities %}
						<option value="{{id}}">{{label}}</option>
					{% endfor %}
				</select>
			</div>
		</div>
	{% endif %}
	{% if term_options.ticket_workflows %}
		<div class="type" title="{{ phrase('global.workflow') }}" data-rule-type="workflow">
			<div class="op">
				<select name="op">
					<option value="is">{{ phrase('global.is') }}</option>
					<option value="not">{{ phrase('global.is_not') }}</option>
				</select>
			</div>
			<div class="options">
				<select name="workflow">
					{% for id,label in term_options.ticket_workflows %}
						<option value="{{id}}">{{label}}</option>
					{% endfor %}
				</select>
			</div>
		</div>
	{% endif %}
</div>

<div class="optionbox" id="department_ob">
	<section data-section-name="department">
		<header>
			<h3>{{ phrase('admin.ticketproperties.switch_to_department') }}</h3>
			<input type="text" class="filter-box" placeholder="{{ phrase('global.filter') }}" />
		</header>
		<ul>
			{% if department.id %}
				<li class="top first emphasis">
					<input
						type="radio"
						name="dep_radio"
						value="0"
						{% if not department %}checked="checked"{% endif %}
						data-refresh-url="{{ path('admin_tickets_editor_dep', {'department_id': '0', 'section': section}) }}"
					/>
					<label>{{ phrase('admin.ticketproperties.default_layout') }}</label>
				</li>
			{% endif %}
			{% for dep in department_hierarchy %}
				<li
					class="top {% if dep.children %}group-title{% endif %} item-{{ dep.id }}"
					data-item-id="{{ dep.id }}"
					data-full-title="{{ dep.title }}"
				>
					{% if not dep.children %}
					<input
						type="radio"
						name="dep_radio"
						value="{{ dep.id }}"
						{% if department.id == dep.id %}checked="checked"{% endif %}
						data-refresh-url="{{ path('admin_tickets_editor_dep', {'department_id': dep.id, 'section': section}) }}"
					/>
					{% endif %}
					<label>{{ dep.title }}</label>
				</li>
				{% if dep.children %}
					{% for subdep in dep.children %}
						<li
							class="child item-{{ subdep.id }} child-of-{{ dep.id }}"
							data-item-id="{{ dep.id }}"
							data-parent-id="{{ dep.id }}"
							data-full-title="{{ dep.title }} &gt; {{ subdep.title }}"
						>
							<span class="elbow-end"></span>
							<input
								type="radio"
								name="dep_radio"
								value="{{ subdep.id }}"
								{% if department.id == dep.id %}checked="checked"{% endif %}
								data-refresh-url="{{ path('admin_tickets_editor_dep', {'department_id': subdep.id, 'section': section}) }}"
							/>
							<label>{{subdep.title}}</label>
						</li>
					{% endfor %}
				{% endif %}
			{% endfor %}
		</ul>
	</section>
</div>

<div id="embed_form_overlay" style="width: 785px; height: 555px; display: none;">
	<div class="overlay-title">
		<span class="close-overlay"></span>
		<h4>{{ phrase('admin.ticketproperties.embed_into_your_website') }}</h4>
	</div>
	<div class="overlay-content">
		<div class="loading-icon-big" style="padding-top: 20px;"></div>
	</div>
</div>

{% endblock %}
