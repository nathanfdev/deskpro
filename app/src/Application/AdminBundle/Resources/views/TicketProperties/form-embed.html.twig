<div>
	<div class="overlay-section">
		<h3>{{ phrase('admin.tickets.direct_link') }}</h3>
		{{ phrase('admin.tickets.link_directly_to_the_new_ticket_form') }}:
		<br />
		<input type="text" value="{{ app.request.getUriForPath('') }}/new-ticket{% if department %}/{{ department.id }}{% endif %}" style="width: 80%;" />
	</div>

	<div class="overlay-section">
		<h3>{{ phrase('admin.tickets.popup_window') }}</h3>
		{{ phrase('admin.tickets.add_a_link_to_your_website_that_opens') }}
		<br />
{% set code %}
<a
	href="{{ app.request.getUriForPath('') }}/tickets/new-simple/{{ department.id|default('0') }}"
	onclick="window.open(this.href, null, 'height=600, width=710, toolbar=0, location=0, status=1, scrollbars=1, resizable=1'); return false"
	class="dp-newticket-link"
>{{ phrase('admin.tickets.contact_us') }}</a>
{% endset %}
		<textarea style="height: 80px; width: 80%;">{{ code|e }}</textarea>
	</div>


	<div class="overlay-section">
		<h3>{{ phrase('agent.website_widget') }}</h3>
		{{ phrase('admin.tickets.embed_the_new_ticket_form_directly_into_any') }}:
		<br />
{% set code %}
<!-- DeskPRO New Ticket -->
<div id="dp_newticket_form" style="display: none"></div>
<script type="text/javascript">
var DpNewTicket_Options = DpNewTicket_Options || {};
DpNewTicket_Options.autoResize = true;
DpNewTicket_Options.initialHeight = 700;
DpNewTicket_Options.intoElement = 'dp_newticket_form';
(function() {
	var scr = document.createElement('script');
	scr.src = ('https:' == document.location.protocol ? 'https' : 'http') + '://{{ app.request.getUriForPath('')|replace({'http://': '', 'https://': ''}) }}/tickets/new-js/{{ department.id|default('0') }}.js';
	scr.setAttribute('async', 'true');
	document.documentElement.firstChild.appendChild(scr);
})();
</script>
<!-- /DeskPRO New Ticket -->
{% endset %}
		<textarea style="height: 200px; width: 80%;" wrap="off">{{ code|e }}</textarea>
	</div>
</div>
