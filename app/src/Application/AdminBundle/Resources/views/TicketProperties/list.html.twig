{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block pagebar %}
	<nav>
		<ul>
			<li class="add"><a href="{{ path('admin_customdeftickets_new_choosetype') }}">{{ phrase('admin.ticketproperties.add_new_field') }}</a></li>
		</ul>
	</nav>
	<ul>
		<li>{{ phrase('admin.global.ticket_fields') }}</li>
	</ul>
{% endblock %}
{% block content %}
<div
	class="dp-page-box"
	data-element-handler="DeskPRO.Admin.ElementHandler.TicketPropertiesList"
	data-set-setting-url="{{ path('admin_settings_set', {'setting_name': '_SETTING_NAME_', 'security_token': security_token('set_setting')}) }}"
	data-set-field-url="{{ path('admin_customdeftickets_setenabled', {'field_id': '00000'})|replace({'00000': '_FIELD_ID_'}) }}"
>

<ul class="field-dual-list">
	<li>
		<header>
			<h3><a href="{{ path('admin_departments') }}">{{ phrase('admin.global.departments') }}</a></h3>
			{#<div class="check-control">
				<input type="checkbox" {% if app.getSetting('core.enable_departments') %}checked="checked"{% endif %} class="onoff-slider" data-setting-name="core.enable_departments" />
			</div>#}
			<br class="clear" />
		</header>
		<p>
            {{ phrase('admin.ticketproperties.explain_departments') }}
            {{ phrase('admin.ticketproperties.you_have_count_departments', {'count':counts.department}) }}
		</p>
	</li>

	<li>
		<header>
			<h3><a href="{{ path('admin_products') }}">{{ phrase('agent.global.products') }}</a></h3>
			<div class="check-control">
				<input type="checkbox" {% if app.getSetting('core.use_product') %}checked="checked"{% endif %} class="onoff-slider" data-enable-url="{{ path('admin_products_toggle', {enable: '1'}) }}" data-disable-url="{{ path('admin_products_toggle', {enable: '0'}) }}" />
			</div>
			<br class="clear" />
		</header>
		<p>
            {{ phrase('admin.ticketproperties.explain_products') }}
            {{ phrase('admin.ticketproperties.you_have_count_products', {'count':counts.product}) }}
		</p>
	</li>

	<li>
		<header>
			<h3><a href="{{ path('admin_ticketcats') }}">{{ phrase('admin.global.ticket_categories') }}</a></h3>
			<div class="check-control">
				<input type="checkbox" {% if app.getSetting('core.use_ticket_category') %}checked="checked"{% endif %} class="onoff-slider" data-enable-url="{{ path('admin_ticketcats_toggle', {enable: '1'}) }}" data-disable-url="{{ path('admin_ticketcats_toggle', {enable: '0'}) }}" />
			</div>
			<br class="clear" />
		</header>
		<p>
            {{ phrase('admin.ticketproperties.explain_categories') }}
            {{ phrase('admin.ticketproperties.you_have_count_categories', {'count':counts.ticket_category}) }}
		</p>
	</li>

	<li>
		<header>
			<h3><a href="{{ path('admin_ticketpris') }}">{{ phrase('admin.global.ticket_priorities') }}</a></h3>
			<div class="check-control">
				<input type="checkbox" {% if app.getSetting('core.use_ticket_priority') %}checked="checked"{% endif %} class="onoff-slider" data-enable-url="{{ path('admin_ticketpris_toggle', {enable: '1'}) }}" data-disable-url="{{ path('admin_ticketpris_toggle', {enable: '0'}) }}" />
			</div>
			<br class="clear" />
		</header>
		<p>
            {{ phrase('admin.ticketproperties.explain_priorities') }}
            {{ phrase('admin.ticketproperties.you_have_count_priorities', {'count':counts.ticket_priority}) }}
		</p>
	</li>

	<li>
		<header>
			<h3><a href="{{ path('admin_ticketworks') }}">{{ phrase('admin.global.ticket_workflows') }}</a></h3>
			<div class="check-control">
				<input type="checkbox" {% if app.getSetting('core.use_ticket_workflow') %}checked="checked"{% endif %} class="onoff-slider" data-enable-url="{{ path('admin_ticketworks_toggle', {enable: '1'}) }}" data-disable-url="{{ path('admin_ticketworks_toggle', {enable: '0'}) }}" />
			</div>
			<br class="clear" />
		</header>
		<p>
            {{ phrase('admin.ticketproperties.explain_workflows') }}
            {{ phrase('admin.ticketproperties.you_have_count_workflows', {'count':counts.ticket_workflow}) }}
		</p>
	</li>

	{% for field in fields %}
		<li class="short" {% if loop.index == 2 %}style="clear:left"{% endif %}>
			<header>
				<h3><a class="popout-trigger" href="{{ path('admin_customdeftickets_edit', {'field_id': field.id}) }}">{{ field.title }}</a></h3>
				<div class="check-control">
					<input type="checkbox" {% if field.is_enabled %}checked="checked"{% endif %} class="onoff-slider" data-field-id="{{ field.id }}" />
				</div>
				<br class="clear" />
			</header>
			<p>{{ phrase(field.handler_class_phrase) }}</p>
		</li>
	{% endfor %}

</ul>
<br class="clear" />

</div>
{% endblock %}
