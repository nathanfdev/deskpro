{% set this_page = 'portal_templates' %}
{% set page_handler = 'DeskPRO.Admin.ElementHandler.TemplateEditList' %}
{% extends 'AdminBundle:Portal:layout.html.twig' %}
{% block pagebar %}
<ul>
	<li>Templates</li>
</ul>
{% endblock %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/ElementHandler/TemplateEditList.js') }}"></script>
{% endblock %}
{% block page %}
{% macro render_dir(bundle_name, dirname, dirinfo) %}
	<div class="content-table template-dir">
		<table width="100%">
			<thead class="{% if dirinfo.count_outdated %}dir-outdated{% endif %} {% if dirinfo.count_changed %}dir-changed{% endif %}">
				<tr>
					<th class="single-title" colspan="10">
						<span class="count-outdated"><i>{{ dirinfo.count_outdated }}</i> outdated</span>
						<span class="count-changed"><i>{{ dirinfo.count_changed }}</i> custom</span>
						<span class="count">{{ dirinfo.templates|length }} templates</span>
						<h1 class="toggle-section">{% if dirname != '!top' %}{{ dirname }}{% else %}Layout{% endif %}</h1>
					</th>
				</tr>
			</thead>
			<tbody style="display: none">
				{% for name,info in dirinfo.templates %}
					{{ _self.render_tpl(name, info) }}
				{% endfor %}
			</tbody>
		</table>
	</div>
	<br />
{% endmacro %}

{% macro render_tpl(name, info) %}
	<tr id="row_{{ name|lower|replace({':': '_', '.': '_'}) }}" class="template-row {% if info.is_custom %}tpl-changed{% endif %} {% if info.is_outdated %}tpl-outdated{% endif %}" data-template-name="{{ name }}">
		<td>
			<em class="edit edit-tpl-trigger"></em>
			<span class="changed-tag">custom</span>
			<span class="outdated-tag">outdated</span>
			<h3>{{ info.shortname }}</h3>
		</td>
	</tr>
{% endmacro %}

{% for bundle_name,dirs in list %}
	{% for dirname,dirinfo in dirs %}
		{{ _self.render_dir(bundle_name, dirname, dirinfo) }}
	{% endfor %}
{% endfor %}

<div id="edittpl_overlay" class="deskpro-overlay-outer" style="display: none;">
	<div class="deskpro-overlay">
		<div class="overlay-title">
			<span class="close-overlay"></span>
			<h4 class="template-title"></h4>
		</div>
		<div class="overlay-content">
			<textarea class="template-code" spellcheck="false"></textarea>
		</div>
		<div class="overlay-footer">
			<div class="is-not-loading">
				<button class="clean-white save-trigger">Save Changes</button>
				&nbsp;&nbsp; <button class="clean-white revert-trigger">Revert To Default</button>
			</div>
			<div class="is-loading">
				<div class="loading-icon-flat"></div>
			</div>
		</div>
	</div>
</div>

{% endblock %}