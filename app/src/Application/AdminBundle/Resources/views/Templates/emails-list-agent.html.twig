{% import 'AdminBundle:Templates:macros.html.twig' as tplmacro %}
{% extends 'AdminBundle:Templates:emails-list-common.html.twig' %}
{% block pagetabs %}
<ul>
	<li><a href="{{ path('admin_templates_email', {list_type: 'layout'}) }}">Email Layout</a></li>
	<li><a href="{{ path('admin_templates_email', {list_type: 'user'}) }}">User Emails</a></li>
	<li class="on"><a href="{{ path('admin_templates_email', {list_type: 'agent'}) }}">Agent Emails</a></li>
</ul>
{% endblock %}
{% block content %}

	<div class="page-content">
		<div class="content-table">
			<table width="100%">
				<thead>
					<tr>
						<th class="single-title">Tickets</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>
							<strong><a class="editable-link" href="{{ path('admin_templates_editemail', {name: 'DeskPRO:emails_agent:new-ticket.html.twig'}) }}"><span>
								New Ticket Notification
							</span></a></strong>
							<div class="tpl-desc">
								This email is sent to agents to notify them of new tickets.
							</div>
						</td>
					</tr>
					<tr>
						<td>
							<strong><a class="editable-link" href="{{ path('admin_templates_editemail', {name: 'DeskPRO:emails_agent:ticket-update.html.twig'}) }}"><span>
								Ticket Updated Notification
							</span></a></strong>
							<div class="tpl-desc">
								This email is sent to agents to notify them of changes to tickets.
							</div>
						</td>
					</tr>
					<tr>
						<td>
							<strong><a class="editable-link" href="{{ path('admin_templates_editemail', {name: 'DeskPRO:emails_agent:new-reply-user.html.twig'}) }}"><span>
								New User Reply
							</span></a></strong>
							<div class="tpl-desc">
								This email is sent to agents to notify them of new replies by users.
							</div>
						</td>
					</tr>
					<tr>
						<td>
							<strong><a class="editable-link" href="{{ path('admin_templates_editemail', {name: 'DeskPRO:emails_agent:new-agent-user.html.twig'}) }}"><span>
								New Agent Reply
							</span></a></strong>
							<div class="tpl-desc">
								This email is sent to agents to notify them of new replies by another agent.
							</div>
						</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>

	<div class="page-content">
		<div class="content-table">
			<table width="100%">
				<thead>
					<tr>
						<th class="single-title">General</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>
							<strong><a class="editable-link" href="{{ path('admin_templates_editemail', {name: 'DeskPRO:emails_agent:new-agent-chat-message.html.twig'}) }}"><span>
								New Chat Message
							</span></a></strong>
							<div class="tpl-desc">
								This email is sent to agents to notify them of chat messages sent to them while they were offline.
							</div>
						</td>
					</tr>
					<tr>
						<td>
							<strong><a class="editable-link" href="{{ path('admin_templates_editemail', {name: 'DeskPRO:emails_agent:new-comment.html.twig'}) }}"><span>
								New User Comment
							</span></a></strong>
							<div class="tpl-desc">
								This email is sent to agents to notify them of new user comments on articles, news or downloads.
							</div>
						</td>
					</tr>
					<tr>
						<td>
							<strong><a class="editable-link" href="{{ path('admin_templates_editemail', {name: 'DeskPRO:emails_agent:new-feedback.html.twig'}) }}"><span>
								New Feedback
							</span></a></strong>
							<div class="tpl-desc">
								This email is sent to agents to notify them of new user feedback submissions.
							</div>
						</td>
					</tr>
					<tr>
						<td>
							<strong><a class="editable-link" href="{{ path('admin_templates_editemail', {name: 'DeskPRO:emails_agent:new-registration.html.twig'}) }}"><span>
								New Registration
							</span></a></strong>
							<div class="tpl-desc">
								This email is sent to agents to notify them of new user registrations.
							</div>
						</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>

	<div class="page-content">
		<div class="content-table">
			<table width="100%">
				<thead>
					<tr>
						<th class="single-title">Alerts &amp; Errors</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>
							<strong><a class="editable-link" href="{{ path('admin_templates_editemail', {name: 'DeskPRO:emails_agent:login-alert.html.twig'}) }}"><span>
								Login Alerts
							</span></a></strong>
							<div class="tpl-desc">
								This email is sent to agents to notify them of logins or attempted logins using their account.
							</div>
						</td>
					</tr>
					<tr>
						<td>
							<strong><a class="editable-link" href="{{ path('admin_templates_editemail', {name: 'DeskPRO:emails_agent:agent-welcome.html.twig'}) }}"><span>
								Agent Welcome Email
							</span></a></strong>
							<div class="tpl-desc">
								This email is sent to newly created agents.
							</div>
						</td>
					</tr>
					<tr>
						<td>
							<strong><a class="editable-link" href="{{ path('admin_templates_editemail', {name: 'DeskPRO:emails_agent:agent-changeemail-mergeuser.html.twig'}) }}"><span>
								Account Merged
							</span></a></strong>
							<div class="tpl-desc">
								This email is sent to an agent whose account was merged with another user.
							</div>
						</td>
					</tr>
					<tr>
						<td>
							<strong><a class="editable-link" href="{{ path('admin_templates_editemail', {name: 'DeskPRO:emails_agent:admin-noreset-password.html.twig'}) }}"><span>
								Admin Reset Password
							</span></a></strong>
							<div class="tpl-desc">
								This email is sent to agents when an admin resets their password.
							</div>
						</td>
					</tr>
					<tr>
						<td>
							<strong><a class="editable-link" href="{{ path('admin_templates_editemail', {name: 'DeskPRO:emails_agent:error-invalid-forward.html.twig'}) }}"><span>
								Invalid Forward
							</span></a></strong>
							<div class="tpl-desc">
								The auto-reply sent to an agent who has forwarded an email to the helpdesk that the helpdesk cannot parse.
							</div>
						</td>
					</tr>
					<tr>
						<td>
							<strong><a class="editable-link" href="{{ path('admin_templates_editemail', {name: 'DeskPRO:emails_agent:error-marker-missing.html.twig'}) }}"><span>
								Missing Marker
							</span></a></strong>
							<div class="tpl-desc">
								The auto-reply sent to an agent who has replied by email to a ticket but the reply is missing the standard marker line.
							</div>
						</td>
					</tr>
					<tr>
						<td>
							<strong><a class="editable-link" href="{{ path('admin_templates_editemail', {name: 'DeskPRO:emails_agent:error-unknown-from.html.twig'}) }}"><span>
								Unknown From
							</span></a></strong>
							<div class="tpl-desc">
								The auto-reply sent to the an agent who has sent a reply by email from an unknown "From" address.
							</div>
						</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}