{% import 'AdminBundle:Templates:macros.html.twig' as tplmacro %}
{% extends 'AdminBundle::layout.html.twig' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('vendor/codemirror/lib/codemirror.js') }}"></script>
<link rel="stylesheet" href="{{ asset('vendor/codemirror/lib/codemirror.css') }}" type="text/css" />

	<script type="text/javascript" src="{{ asset('vendor/codemirror/mode/css/css.js') }}"></script>
	<script type="text/javascript" src="{{ asset('vendor/codemirror/mode/javascript/javascript.js') }}"></script>
	<script type="text/javascript" src="{{ asset('vendor/codemirror/mode/xml/xml.js') }}"></script>
	<script type="text/javascript" src="{{ asset('vendor/codemirror/mode/htmlembedded/htmlembedded.js') }}"></script>
	<script type="text/javascript" src="{{ asset('vendor/codemirror/mode/htmlmixed/htmlmixed.js') }}"></script>

<script type="text/javascript">
$(document).ready(function() {

	var phraseCache = {};

	var codeHints_lastTip = null;
	var codeHints_lastPos = null;

	function codeHints() {
		var cm = this;
		var cursor = cm.getCursor();
		var token = cm.getTokenAt(cursor);

		if (codeHints_lastPos && codeHints_lastPos == (token.start + ' ' + token.end)) {
			return;
		}

		codeHints_lastPos = (token.start + ' ' + token.end);

		if (codeHints_lastTip) codeHints_lastTip.remove();
		codeHints_lastTip = null;

		var pos = cm.cursorCoords(false, 'page');

		if (token.string) {
			switch (token.string) {
				case '<dp:ticket-history':
					codeHints_lastTip = $('<div class="code-tip">Inserts the contents of all previous messages in this ticket. See template <a href="">ticket-message-row</a></div>');
					codeHints_lastTip.appendTo('body');
					codeHints_lastTip.css({ left: pos.x, top: pos.y + 15});
					break;

				case '<dp:agent-ticket-history':
					codeHints_lastTip = $('<div class="code-tip">Inserts the contents of all previous messages in this ticket suitable for an agent (for example, notes are included). See template <a href="">ticket-message-row</a></div>');
					codeHints_lastTip.appendTo('body');
					codeHints_lastTip.css({ left: pos.x, top: pos.y + 15});
					break;

				case '<dp:ticket-logs':
					codeHints_lastTip = $('<div class="code-tip">Inserts a list of changes done to the ticket.</div>');
					codeHints_lastTip.appendTo('body');
					codeHints_lastTip.css({ left: pos.x, top: pos.y + 15});
					break;

				case '<dp:ticket-rating-links':
					codeHints_lastTip = $('<div class="code-tip">Inserts links that let the user rate their support as good, bad or okay. See template <a href="">ticket-rating-links</a></div>');
					codeHints_lastTip.appendTo('body');
					codeHints_lastTip.css({ left: pos.x, top: pos.y + 15});
					break;

				case '<dp:ticket-properties-table':
					codeHints_lastTip = $('<div class="code-tip">Enters the full ticket details in a table.</div>');
					codeHints_lastTip.appendTo('body');
					codeHints_lastTip.css({ left: pos.x, top: pos.y + 15});
					break;

				case '<dp:agent-reply':
					codeHints_lastTip = $('<div class="code-tip">Inserts the agents reply, if there was one.</div>');
					codeHints_lastTip.appendTo('body');
					codeHints_lastTip.css({ left: pos.x, top: pos.y + 15});
					break;

				case '<dp:user-reply':
					codeHints_lastTip = $('<div class="code-tip">Inserts the users reply, if there was one.</div>');
					codeHints_lastTip.appendTo('body');
					codeHints_lastTip.css({ left: pos.x, top: pos.y + 15});
					break;

				default:
					var m = token.string.match(/\{\{\s*phrase\('(.*?)\'.*?\)\s*\}\}/);
					if (m) {
						var phraseId = m[1];

						if (phraseCache[phraseId]) {
							codeHints_lastTip = $('<div class="code-tip"></div>');
							codeHints_lastTip.text(phraseCache[phraseId]);
							codeHints_lastTip.appendTo('body');
							codeHints_lastTip.css({ left: pos.x, top: pos.y + 15});
						} else {
							var el = $('<div class="code-tip"><i class="flat-spinner"></i></div>');
							codeHints_lastTip = el;
							codeHints_lastTip.appendTo('body');
							codeHints_lastTip.css({ left: pos.x, top: pos.y + 15});

							$.ajax({
								url: BASE_URL + "admin/languages/get-phrase-text.json",
								data: {
									language_id: 1,
									phrase_id: phraseId
								},
								success: function(data) {
									phraseCache[phraseId] = data.phrase_text;
									el.text(data.phrase_text)
								}
							});
						}
					}
			}
		}
	}

	$('.template-editor-row').each(function() {
		var row       = $(this);
		var toggle    = row.find('.toggle-section');
		var tbody     = row.find('tbody');
		var tfoot     = row.find('tfoot');
		var textarea  = tbody.find('textarea.template');
		var subject   = tbody.find('textarea.subject');
		var subjectEl = subject.get(0);
		var template  = textarea.data('template-name');
		var templateEl = textarea.get(0);
		var hasLoaded = false;

		var codeCm = null;
		var subjCm = null;

		function setCode(code) {
			code = code.trim();

			if (subjectEl) {
				var m, subjectCode = '';
				m = code.match(/^([\w\W]*)<dp:subject>([\w\W]*)<\/dp:subject>([\w\W]*)$/);
				if (m) {
					subjectCode = m[2];
					code = m[1] + m[3];
					code = code.trim();
				}
			}

			textarea.val(code);

			if (codeCm) {
				codeCm.setValue(code);
			} else {
				codeCm = CodeMirror.fromTextArea(templateEl, {
					mode: textarea.data('mode') || 'htmlmixed',
					lineNumbers: true,
					indentWithTabs: true,
					onCursorActivity: function() {
						codeHints.apply(codeCm);
					}
				});
			}

			if (subjectEl) {
				subject.val(subjectCode);

				if (subjCm) {
					subjCm.setValue(subjectCode);
				} else {
					subjCm = CodeMirror.fromTextArea(subjectEl, {
						mode: 'htmlmixed',
						lineNumbers: false,
						indentWithTabs: true,
						onCursorActivity: function() {
							codeHints.apply(subjCm);
						}
					});
				}
			}
		}

		toggle.on('click', function(ev) {
			ev.preventDefault();

			if (toggle.hasClass('expanded')) {
				toggle.removeClass('expanded');
				tbody.hide();
				tfoot.hide();
				return;
			}

			if (hasLoaded) {
				toggle.addClass('expanded');
				tbody.show();
				tfoot.show();
				return;
			}

			toggle.find('i').show();
			$.ajax({
				url: BASE_URL + 'admin/templates/get-template-code',
				data: {
					name: template
				},
				complete: function() {
					toggle.find('i').hide();
				},
				success: function(code) {
					hasLoaded = true;
					toggle.addClass('expanded');
					tbody.show();
					tfoot.show();

					setCode(code);
				}
			});
		});

		row.find('button.save-trigger').on('click', function(ev) {
			ev.preventDefault();
			tfoot.addClass('mark-loading');

			var code = codeCm.getValue();
			if (subjectEl) {
				code = '<dp:subject>' + subjCm.getValue() + '</dp:subject>' + "\n" + code;
			}

			var postData = [
				{name: 'name', value: template},
				{name: 'code', value: code}
			];

			$.ajax({
				url: BASE_URL + 'admin/templates/save-template.json',
				type: 'POST',
				data: postData,
				complete: function() {
					tfoot.removeClass('mark-loading');
				},
				success: function(data) {
					if (data.error) {
						alert(data.error_message + "\n\nLine: " + data.error_line);
						return;
					}
				}
			});
		});

		row.find('button.revert-trigger').on('click', function(ev) {
			ev.preventDefault();
			tfoot.addClass('mark-loading');

			var postData = [
				{name: 'name', value: template}
			];

			$.ajax({
				url: BASE_URL + 'admin/templates/revert-template.json',
				type: 'POST',
				data: postData,
				complete: function() {
					tfoot.removeClass('mark-loading');
				},
				success: function(data) {
					var code = data.code || '';
					setCode(code);
				}
			});
		});
	});
});
</script>
{% endblock %}