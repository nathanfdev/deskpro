{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% extends 'AdminBundle::layout.html.twig' %}
{% block pagetitle %}
	<h1>{{ phrase('admin.languages.new_language') }}</h1>
{% endblock %}
{% block page %}

<form action="{{ path('admin_langs_newlang_save') }}" method="post">
<input type="hidden" name="process" value="1" />

<div class="dp-form">
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('admin.languages.language_pack') }}</label>
		</div>
		<div class="dp-form-input">
			{{ phrase('admin.languages.create_a_new_language_using_one_of_these') }}:<br />
			<select name="language_package">
				{% for package,title in packs %}
					<option value="{{ package }}">{{ title }}</option>
				{% endfor %}
			</select>
		</div>
	</div>
</div>

<button class="clean-white">{{ phrase('admin.languages.create_new_language') }}</button>

</form>

{% endblock %}
