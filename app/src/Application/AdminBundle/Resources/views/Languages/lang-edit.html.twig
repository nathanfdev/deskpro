{% extends 'AdminBundle:Languages:lang-layout.html.twig' %}
{% block pagebar %}
     <ul>
		<li><a href="{{ path('admin_langs') }}">{{ phrase('admin.languages.languages') }}</a></li>
		{% if language.id %}
			<li>{{ phrase('admin.languages.edit_language') }}</li>
		{% else %}
			<li>{{ phrase('admin.languages.new_language') }}</li>
		{% endif %}
     </ul>
{% endblock %}
{% block page %}

<form action="{{ path('admin_langs_editlang', {'language_id': language.id|default(0)}) }}" method="post">
<input type="hidden" name="process" value="1" />

<div class="dp-form">
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('global.title') }}</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.title) }}
		</div>
	</div>
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('admin.languages.locale') }}</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.locale) }}
		</div>
	</div>
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('admin.languages.language_pack') }}</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.language_package) }}
		</div>
	</div>
</div>

<button class="clean-white">{{ phrase('global.save') }}</button>

</form>

{% if language.id != 1 %}
	<div style="width: 70%; text-align: right">
		<a class="delete-link" href="{{ path('admin_langs_dellang', {'language_id': language.id, 'security_token': security_token('delete_lang') }) }}" onclick="return confirm('Are you sure you want to delete this language? Custom phrases will be removed, and things (e.g., tickets) classified using this language will have their language unset.');">{{ phrase('admin.languages.delete_language') }}</a>
	</div>
{% endif %}

{% endblock %}
