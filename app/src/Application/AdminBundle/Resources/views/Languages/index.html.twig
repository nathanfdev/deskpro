{% set admin_page_class = 'with_top_border' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% extends 'AdminBundle::layout.html.twig' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/ElementHandler/LangEditSettings.js') }}"></script>
{% endblock %}
{% block pagebar %}
     <nav>
          <ul>
               <li class="add"><a href="{{ path('admin_langs_install') }}">{{ phrase('admin.languages.add_language') }}</a></li>
          </ul>
     </nav>
     <ul>
          <li>{{ phrase('admin.general.languages') }}</li>
     </ul>
{% endblock %}
{% block sidebar_right %}
<div
	class="dp-page-box"
	data-element-handler="DeskPRO.Admin.ElementHandler.LangEditSettings"
	data-set-default-lang-url="{{ path('admin_settings_set', {'setting_name':'core.default_language_id', 'security_token': security_token('set_setting')}) }}"
>
	<div class="resource-item-list">
		<header>
			<div class="controls">
				<button class="clean-white small save-trigger" style="display: none" id="save_lang_settings">{{ phrase('admin.general.save_changes') }}</button>
			</div>
			<h4>{{ phrase('admin.languages.default_language') }}</h4>
		</header>
		<article>
			{{ phrase('admin.languages.notice_default_language') }}:<br />
			<select id="default_lang_setting">
				{% for lang in languages %}
					<option value="{{lang.id}}" {% if app.getSetting('core.default_language_id') == lang.id %}selected="selected"{% endif %}>{{lang.title}}</option>
				{% endfor %}
			</select>
		</article>
	</div>
</div>
{% endblock %}
{% block pagebar_after %}
	<div class="portal-toggle">
		<a class="toggle-btn" href="{{ path('admin_langs', {set_enable_languages: 0}) }}"><em>{{ phrase('admin.portal.click_to_disable') }}</em></a>
		<p>
			Multi-lingual features are enabled. This allows you to install multiple language packs and modify text phrases used throughout the system.
		</p>
		<div
			data-element-handler="DeskPRO.Admin.ElementHandler.LangEditSettings"
			data-set-default-lang-url="{{ path('admin_settings_set', {'setting_name':'core.default_language_id', 'security_token': security_token('set_setting')}) }}"
		>
			<p>
				You have {% if languages|length == 1%}1 language{% else %}{{ languages|length }} languages{% endif %} installed. <a href="{{ path('admin_langs_install') }}">Install more</a>.
			</p>
		</div>
	</div>
{% endblock %}
{% block page %}
<h1>{{ phrase('admin.general.languages') }}</h1>
<ul class="item-list">
	{% for lang in languages %}
		<li>
			<div class="dp-block-controls">
				<ul>
					<li class="dp-edit">
						<a href="{{ path('admin_langs_editlang', {'language_id': lang.id}) }}" class="popout-trigger"><span></span></a>
					</li>
				</ul>
			</div>
			<label>{{ lang.title }}</label>
		</li>
	{% endfor %}
</ul>
{% endblock %}
