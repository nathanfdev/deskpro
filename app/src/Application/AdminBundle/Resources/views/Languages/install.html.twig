{% extends 'AdminBundle:Languages:lang-layout.html.twig' %}
{% block pagebar %}
<ul>
	<li><a href="{{ path('admin_langs') }}">{{ phrase('admin.general.languages') }}</a></li>
	<li>{{ phrase('admin.languages.new_language') }}</li>
</ul>
{% endblock %}
{% block page %}
	<div class="dp-form">
		<div class="dp-form-section">
			<div class="dp-form-row">
				<div class="dp-form-label">
					<label>Upload Language Pack</label>
				</div>
				<div class="dp-form-input">
					<input type="file" name="upfile" /><br />
					Upload a language pack file (it should end in .xml) from your hard-drive.
					<br />
					<button class="clean-white">Install Language</button>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
