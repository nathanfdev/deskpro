{% extends 'AdminBundle::layout.html.twig' %}
{% block pagebar %}
<nav>
	<ul>
		<li><a href="{{ path('admin_emailgateway_errors_clear', {security_token: security_token('clear_gateway_errors') }) }}">{{ phrase('admin.general.clear_logs') }}</a></li>
	</ul>
</nav>
<ul>
	<li>{{ phrase('admin.general.gateway_error_logs') }}</li>
</ul>
{% endblock %}
{% block page %}
<div class="check-grid item-list">
	<table width="100%">
		<thead>
		<tr>
			<th style="text-align: left" width="50">{{ phrase('agent.general.id') }}</th>
			<th style="text-align: left;">{{ phrase('admin.general.email_info') }}</th>
			<th style="text-align: right">{{ phrase('admin.general.error_type') }}</th>
			<th width="10">&nbsp;</th>
		</tr>
		</thead>
		<tbody>
		{% for source in sources %}
			<tr>
				<td style="text-align: left">{{ source.id }}</td>
				<td>
					<ul class="standard-list small">
						<li>{{ phrase('admin.general.email_from') }}: {{ source.header_from }}</li>
						<li>{{ phrase('admin.general.email_to') }}: {{ source.header_to }}</li>
						<li>{{ phrase('admin.general.email_subject') }}: {{ source.header_subject }}</li>
					</ul>
				</td>
				<td style="text-align: right">{{ source.error_code }}</td>
				<td><a href="{{ path('admin_emailgateway_errors_view', {id: source.id }) }}">{{ phrase('admin.general.view') }}</a></td>
			</tr>
		{% endfor %}
		</tbody>
	</table>
</div><br />

{% if pagination.pages|length > 1 %}
<div class="page_nav">
	<ul>
		{% if pagination.curpage != pagination.first %}
		<li><a href="{{ path('admin_emailgateway_errors', {'p': pagination.first}) }}">{{ phrase('admin.general.first') }}</a></li>
		<li><a href="{{ path('admin_emailgateway_errors', {'p': pagination.prev}) }}">{{ phrase('agent.general.prev') }}</a></li>
		{% endif %}

		{% for i in pagination.pages %}
		<li {% if i == pagination.curpage %}class="cur_page"{% endif %}><a href="{{ path('admin_emailgateway_errors', {'p': i}) }}">{{i}}</a></li>
		{% endfor %}

		{% if pagination.curpage != pagination.last %}
		<li><a href="{{ path('admin_emailgateway_errors', {'p': pagination.next}) }}">{{ phrase('admin.general.next') }}</a></li>
		<li><a href="{{ path('admin_emailgateway_errors', {'p': pagination.last}) }}">{{ phrase('admin.general.last') }}</a></li>
		{% endif %}
	</ul>
</div>
{% endif %}

{% endblock %}
