{% extends 'AdminBundle::layout.html.twig' %}
{% block pagebar %}
<nav>
	<ul>
		<li><a href="{{ path('admin_emailgateway_errors_clear', {security_token: security_token('clear_gateway_errors') }) }}">{{ phrase('admin.general.clear_logs') }}</a></li>
	</ul>
</nav>
<ul>
	<li><a href="{{ path('admin_emailgateways') }}">Email Accounts</a></li>
	<li>{{ phrase('admin.general.gateway_error_logs') }}</li>
</ul>
{% endblock %}
{% block page %}
<div class="check-grid item-list">
	<table width="100%">
		<thead>
		<tr>
			<th style="text-align: center;" width="10">{{ phrase('agent.general.id') }}</th>
			<th style="text-align: left;">{{ phrase('admin.general.email_info') }}</th>
			<th style="text-align: right">{{ phrase('admin.general.error_type') }}</th>
		</tr>
		</thead>
		<tbody>
		{% for source in sources %}
			<tr>
				<td class="title on" style="text-align: center; padding-left: 0;"><a href="{{ path('admin_emailgateway_errors_view', {id: source.id }) }}">{{ source.id }}</a></td>
				<td>
					<table cellspacing="0" cellpadding="0" width="100%">
						<tr>
							<td nowrap="nowrap" width="50" style="text-align: right; padding-right: 8px;">Date:</td>
							<td>{{ source.date_created|date('fulltime') }}</td>
						</tr>
						<tr>
							<td nowrap="nowrap" width="50" style="text-align: right; padding-right: 8px;">{{ phrase('admin.general.email_from') }}:</td>
							<td>{{ source.header_from }}</td>
						</tr>
						<tr>
							<td nowrap="nowrap" style="text-align: right; padding-right: 8px;">{{ phrase('admin.general.email_to') }}:</td>
							<td>{{ source.header_to }}</td>
						</tr>
						<tr>
							<td nowrap="nowrap" style="text-align: right; padding-right: 8px;">{{ phrase('admin.general.email_subject') }}:</td>
							<td>
								<div class="table-fade-container" style="width: 650px;">
									<div class="table-fade-text">
										{{ source.header_subject }}
									</div>
									<div class="table-fade-away"></div>
								</div>
							</td>
						</tr>
					</table>
				</td>
				<td style="text-align: right; white-space: nowrap;" nowrap="nowrap">{{ source.error_code_title }}</td>
			</tr>
		{% endfor %}
		</tbody>
	</table>
</div><br />

{% if pageinfo.pages|length > 1 %}
<div class="page_nav">
	<ul>
		{% if pageinfo.curpage != pageinfo.first %}
		<li><a href="{{ path('admin_emailgateway_errors', {'p': pageinfo.first}) }}">{{ phrase('admin.general.first') }}</a></li>
		<li><a href="{{ path('admin_emailgateway_errors', {'p': pageinfo.prev}) }}">{{ phrase('agent.general.prev') }}</a></li>
		{% endif %}

		{% for i in pageinfo.pages %}
		<li {% if i == pageinfo.curpage %}class="cur_page"{% endif %}><a href="{{ path('admin_emailgateway_errors', {'p': i}) }}">{{i}}</a></li>
		{% endfor %}

		{% if pageinfo.curpage != pageinfo.last %}
		<li><a href="{{ path('admin_emailgateway_errors', {'p': pageinfo.next}) }}">{{ phrase('admin.general.next') }}</a></li>
		<li><a href="{{ path('admin_emailgateway_errors', {'p': pageinfo.last}) }}">{{ phrase('admin.general.last') }}</a></li>
		{% endif %}
	</ul>
</div>
{% endif %}

{% endblock %}
