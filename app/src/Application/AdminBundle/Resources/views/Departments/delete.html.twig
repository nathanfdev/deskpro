{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block pagebar %}
	<ul>
		<li><a href="{{ path('admin_departments') }}">{{ phrase('admin.departments.departments') }}</a></li>
		<li>{{ phrase('admin.departments.delete_department') }}</li>
	</ul>
{% endblock %}
{% block page %}

{% if department.children|length %}
	<p>Are you sure you want to delete the department "<strong>{{ department.title }}</strong>"? Since this is a top-level department, <strong>all of these sub-departments will be deleted too</strong>:</p>

	<ul class="bullet-list">
		{% for c in department.children %}
			<li>{{ c.title }}</li>
		{% endfor %}
	</ul>
{% else %}
	<p>Are you sure you want to delete the department "<strong>{{ department.title }}</strong>"?</p>
{% endif %}

<form action="{{ path('admin_departments_dodel', {'department_id': department.id, 'security_token': security_token('delete_department')}) }}" method="post">

{% if ticket_count > 0 %}
	<p>
		There are <strong>{% if ticket_count > 1000 %}over 1000{% else %}{{ ticket_count }}{% endif %}</strong> tickets
		{% if chat_count > 0 %}and <strong>{% if chat_count > 1000 %}over 1000{% else %}{{ chat_count }}{% endif %}</strong> chats{% endif %}
		using this department.</p>

	<p>
		Please choose a sub-department to move them into:
		<select name="move_to_department">
			{% for d in departments %}
				{% if d.id != department.id %}
					{% if d.children|length %}
						<optgroup label="{{ d.title }}" class="dep-{{ d.id }}">
						{% for sd in d.children %}
							{% if sd.id != department.id %}
								<option value="{{ sd.id }}">{{ sd.title }}</option>
							{% endif %}
						{% endfor %}
						</optgroup>
					{% else %}
						<option value="{{ d.id }}">{{ d.title }}</option>
					{% endif %}
				{% endif %}
			{% endfor %}
		</select>
	</p>
{% endif %}

{% if department.children|length %}
	<button class="btn">{{ phrase('admin.departments.yes_delete_this_department_and_all_subdepartments') }}</button>
{% else %}
	<button class="btn">{{ phrase('admin.departments.yes_delete_this_department') }}</button>
{% endif %}

</form>

{% endblock %}
