{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block pagebar %}
	<ul>
		<li><a href="{{ path('admin_departments') }}">{{ phrase('admin.global.departments') }}</a></li>
		<li>{{ phrase('admin.departments.delete_department') }}</li>
	</ul>
{% endblock %}
{% block page %}

{% if department.children|length %}
    <p>{{ phrase('admin.agents.are_you_sure_delete_dept_top_level', {'title':department.title}) }}</p>

	<ul class="bullet-list">
		{% for c in department.children %}
			<li>{{ c.title }}</li>
		{% endfor %}
	</ul>
{% else %}
	<p>{{ phrase('admin.agents.are_you_sure_delete_dept', {'title':department.title}) }}</p>
{% endif %}

<form action="{{ path('admin_departments_dodel', {'department_id': department.id, 'security_token': security_token('delete_department')}) }}" method="post">

{% if ticket_count > 0 %}
	<p>
        {% set phrase_params = {'tickets':phrase('admin.departments.count_tickets', {'count':ticket_count}), 'chats':phrase(''admin.departments.count_chats'', {'count':chat_count})} %}
        {{ phrase('admin.departments.there_are_tickets_and_chats', phrase_params) }}
	<p>
		{{ phrase('admin.departments.please_choose_a_subdepartment_to_move_them_into') }}:
		<select name="move_to_department">
			{% for d in departments %}
				{% if d.id != department.id %}
					{% if d.children|length %}
						<optgroup label="{{ d.title }}" class="dep-{{ d.id }}">
						{% for sd in d.children %}
							{% if sd.id != department.id %}
								<option value="{{ sd.id }}">{{ sd.title }}</option>
							{% endif %}
						{% endfor %}
						</optgroup>
					{% else %}
						<option value="{{ d.id }}">{{ d.title }}</option>
					{% endif %}
				{% endif %}
			{% endfor %}
		</select>
	</p>
{% endif %}

{% if department.children|length %}
	<button class="btn">{{ phrase('admin.departments.yes_delete_this_department_and_all_subdepartments') }}</button>
{% else %}
	<button class="btn">{{ phrase('admin.departments.yes_delete_this_department') }}</button>
{% endif %}

</form>

{% endblock %}
