{% extends 'AdminBundle::layout.html.twig' %}
{% block content %}

<div class="table-list-wrap">
	<h2>Error Log #{{log.id}}</h2>
	<table class="table-list" cellspacing="0" cellpadding="0" width="100%">
		<tbody>
			<tr>
				<td width="200"><strong>{{ phrase('admin.logs.id') }}</strong></td>
				<td>{{log.id}}</td>
			</tr>

			<tr>
				<td><strong>{{ phrase('admin.logs.date') }}</strong></td>
				<td>{{log.date_created|date('Y-m-d H:m:s')}}</td>
			</tr>

			<tr>
				<td><strong>{{ phrase('admin.logs.log_name') }}</strong></td>
				<td>{{log.log_name}}</td>
			</tr>

			<tr>
				<td><strong>{{ phrase('admin.logs.flag') }}</strong></td>
				<td>{{log.flag|default('None')}}</td>
			</tr>

			<tr>
				<td><strong>{{ phrase('admin.logs.priority') }}</strong></td>
				<td>{{log.priority}} {{log.priority_name}}</td>
			</tr>

			<tr>
				<td><strong>{{ phrase('admin.logs.sn') }}</strong></td>
				<td>{{log.session_name|default('None')}}</td>
			</tr>

			<tr>
				<td><strong>{{ phrase('admin.logs.message') }}</strong></td>
				<td>
					<textarea style="width:99%; height:200px; font-family:Monaco, 'Courier New', courier, monospace;">{{log.message}}</textarea>
				</td>
			</tr>

			<tr>
				<td><strong>{{ phrase('admin.logs.additional_data') }}</strong></td>
				<td>
					<textarea style="width:99%; height:200px; font-family:Monaco, 'Courier New', courier, monospace;">{{data_structure}}</textarea>
				</td>
			</tr>
		</tbody>
	</table>
</div>

{% endblock %}