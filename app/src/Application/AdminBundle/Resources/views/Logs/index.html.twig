{% extends 'AdminBundle::layout.html.twig' %}
{% block content %}

<div class="table-list-wrap">
	<h2>{{ phrase('admin.logs.logs') }}</h2>
	<table class="table-list" cellspacing="0" cellpadding="0" width="100%">
		<tbody>
			<tr>
				<td width="200">
					<strong><a href="{{ path('admin_logs_errors') }}">{{ phrase('admin.logs.error_logs') }}</a></strong>
				</td>
				<td>
					Error logs contain recorded information about errors and exceptions on your helpdesk.
					Errors should generally not happen, so any logged information here is worth investigating.
				</td>
			</tr>

			<tr>
				<td>
					<strong>{{ phrase('admin.logs.look_up_sn') }}</strong>
				</td>
				<td>
					{{ phrase('admin.logs.if_you_have_a_sn_code_for_a') }}
					<hr />
					{{ phrase('admin.logs.sn_code') }}: <input type="text" id="sn_code" /> <button class="dp-button x-small" onclick="window.location=BASE_URL+'admin/logs/sn/' + $('#sn_code').val()">{{ phrase('admin.logs.view') }}</button>
				</td>
			</tr>
		</tbody>
	</table>
</div>

{% endblock %}