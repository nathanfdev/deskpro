{% extends 'AdminBundle::layout_popout.html.twig' %}

{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/GeneralEdit.js') }}"></script>
{% endblock %}

{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
	window.DeskPRO_Page = new DeskPRO.Admin.PageHandler.GeneralEdit('twitter_accounts', {{ account.id|default(0) }});

	{% if row_html %}
		window.DeskPRO_Page.updateParentListRow({{ row_html|json_encode|raw }});
	{% endif %}
}
</script>
{% endblock %}

{% block page_id "twitter_accounts" %}

{% block header %}
	<h1>Modify Twitter Account "@{{ account.user.screen_name }}"</h1>
{% endblock %}

{% block content %}
<form action="{{ path('admin_twitter_accounts_edit', {'account_id': account.id|default(0)}) }}" method="post">
	<input type="hidden" name="process" value="1" />
	<div class="form-panel">
		<div class="row">
			<label>{{ phrase('admin.twitteraccount.oauth_token') }}</label>
			{{ form_widget(form.oauth_token) }}
		</div>
		<div class="row">
			<label>{{ phrase('admin.twitteraccount.oauth_token_secret') }}</label>
			{{ form_widget(form.oauth_token_secret) }}
		</div>
	</div>

	{{ form_rest(form) }}
</form>
{% endblock %}

{% block footer %}
	<button class="dp-button small save-trigger">{{ phrase('admin.twitteraccount.save') }}</button>
{% endblock %}
