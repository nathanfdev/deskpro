<li class="account account-{{ account.id }}" data-account-id="{{ account.id }}" style="position:relative">
	<div style="float:right">
		<ul class="controls">
			<li class="edit"><a class="popout-trigger" href="{{ path('admin_twitter_accounts_edit', {'account_id': account.id}) }}" data-width="400" data-height="250">{{ phrase('agent.edit') }}</a></li>
		</ul>
	</div>
	<div style="float:left">
		<img src="{{ account.user.profile_image_url }}" width="24" height="24" border="0" />
	</div>
	<div style="float:left; margin-left: 10px">
		<strong>@{{ account.user.screen_name }}</strong>
		<div style="font-size: 90%">{{ account.user.name }}</div>
	</div>
	<div style="float:left; margin-left: 250px;position:absolute">
		<strong>{{ phrase('admin.twitteraccount.oauth') }}:</strong>
		{% if verified[account.id] %}
			<span style="color:green">{{ phrase('agent.verified') }}</span>
		{% else %}
			<span style="color:red">{{ phrase('admin.twitteraccount.error') }}</span>
		{% endif %}
		<div style="font-size: 50%">
			<strong>{{ phrase('admin.twitteraccount.token') }}:</strong> {{ account.oauth_token }}
			<br />
			<strong>{{ phrase('admin.twitteraccount.secret') }}:</strong> {{ account.oauth_token_secret }}
		</div>
	</div>
	<div style="clear:both"></div>
</li>