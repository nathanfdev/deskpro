{% extends 'AdminBundle::layout.html.twig' %}
{% block page %}

<div style="text-align: right">
	<a class="dp-button green" href="{{ path('admin_twitter_accounts_new') }}" target="_twitter">{{ phrase('admin.twitteraccount.create_new_account') }}</a>
	<br /><br />
</div>

<ul class="item-list">
	{% for account in accounts %}
		{% include 'AdminBundle:TwitterAccount:list-row.html.twig' %}
	{% else %}
		<li>
			{{ phrase('admin.twitteraccount.you_have_no_accounts_defined') }}
		</li>
	{% endfor %}
</ul>

{% endblock %}

{% block sidebar %}
{% endblock %}
