{% set layout_tpl = 'AdminBundle:Portal:layout.html.twig' %}
{% set this_page = 'kb_fields' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% extends 'AdminBundle:CustomDefAbstract:edit.html.twig' %}
{% block pagebar %}
     <ul>
		<li><a href="{{ path('admin_customdefarticles') }}">{{ phrase('admin.customdefarticles.article_fields') }}</a></li>
		{% if field.id %}
			<li>{{ phrase('admin.customdefarticles.edit_field') }}</li>
		{% else %}
			<li>{{ phrase('admin.customdefarticles.new_field') }}</li>
		{% endif %}
     </ul>
{% endblock %}
