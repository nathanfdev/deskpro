{% extends 'AdminBundle::layout.html.twig' %}
{% block pagebar %}
	<ul>
		<li>{{ phrase('admin.license.save_license_code') }}</li>
	</ul>
{% endblock %}
{% block sidebar_right %}
{% if not currently_has_license %}
<div class="dp-page-box" style="padding-top: 15px;">
	<div class="resource-item-list icon-group">
		<header>
			<h4>{{ phrase('admin.license.ask_doesnt_have_license') }}</h4>
		</header>
		<article>
			{{ phrase('admin.license.do_if_not_have_license') }}
			<a href="{{ path('admin_license_reqdemo') }}">{{ phrase('admin.license.click_generate_demo_license') }}</a>.
		</article>
	</div>
</div>
{% endif %}
{% endblock %}
{% block page %}

{% if from_demo %}
	<div class="alert-message block-message success">
		{{ phrase('admin.license.notice_license_has_been_emailed') }}
	</div>
{% endif %}

<form action="{{ path('admin_license_input_save') }}" method="post">

{% if invalid %}
<div class="alert-message block-message error">
	<strong>{{ phrase('admin.license.error_encountered') }}:</strong>
	<ul>
		{% if invalid %}<li>{{ phrase('admin.license.notice_invalid_license', {'invalid':invalid}) }}</li>{% endif %}
	</ul>
</div>
{% endif %}

<div class="dp-form">
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('admin.license.your_license_code') }}</label>
		</div>
		<div class="dp-form-input">
			<textarea name="license_code" style="height: 150px">{{ app.getSetting('core.license') }}</textarea>
		</div>
	</div>
</div>

	<button class="clean-white">{{ phrase('admin.license.save_license') }}</button>
</form>

<div style="margin: 40px 38px 30px 30px; background-color: #EDEDED; padding: 10px;">
	<a href="{{ path('admin_license_keyfile', {email_address: email_address|default(app.user.primary_email_address) }) }}" class="install-key-file">{{ phrase('admin.license.installkey') }}</a>
	<p>
		If your server is not connected to the internet or there is a problem setting your license automatically,
		then our agents may ask you to email this keyfile to <a href="mailto:support@deskpro.com">{{ phrase('agent.general.supportdeskprocom') }}</a>
		so your license code can be manually generated.
	</p>
	<br style="clear: left; height: 10px;" />
</div>

{% endblock %}
