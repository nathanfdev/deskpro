{% extends 'AdminBundle::layout.html.twig' %}
{% block pagebar %}
	<nav>
		<ul>
			<li><a href="{{ path('admin_license_input') }}">{{ phrase('admin.license.change_license_code') }}</a></li>
		</ul>
	</nav>
	<ul>
		<li>{{ phrase('admin.license.your_license') }}</li>
	</ul>
{% endblock %}
{% block page %}

<div class="dp-form">
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('admin.license.license_id') }}</label>
		</div>
		<div class="dp-form-input">
			{{ lic.getLicenseId() }}
		</div>
	</div>
	{% if lic.isDemo() %}
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('admin.license.demo') }}</label>
			</div>
			<div class="dp-form-input">
				{{ phrase('admin.license.this_is_a_fullyfunctional_demo_license_with_no') }}
			</div>
		</div>
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('admin.license.demo_expiry') }}</label>
			</div>
			<div class="dp-form-input">
                {% set phrase_link %}
                    <a href="mailto:support@deskpro.com">{{ phrase('admin.license.supportdeskprocom') }}</a>
                {% endset %}
                {{ phrase('admin.license.license_will_expire_on', {'date':lic.getExpireDate()|date('M j, Y'),'link':phrase_link}) }}
			</div>
		</div>
	{% else %}
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('admin.global.agents') }}</label>
			</div>
			<div class="dp-form-input">
				{% if not lic.getMaxAgents() %}
					{{ phrase('admin.license.unlimited') }}
				{% else %}
					{{ lic.getMaxAgents() }}
				{% endif %}
			</div>
		</div>
	{% endif %}
</div>

{% endblock %}
