{% extends 'AdminBundle::layout.html.twig' %}
{% block pagebar %}
	<ul>
		<li>{{ phrase('admin.license.request_demo_license') }}</li>
	</ul>
{% endblock %}
{% block sidebar_right %}
<div class="dp-page-box" style="padding-top: 15px;">
	<div class="resource-item-list icon-group">
		<header>
			<h4>{{ phrase('admin.license.already_have_a_license_code') }}</h4>
		</header>
		<article>
			If you already have a license code, <a href="{{ path('admin_license_input') }}">click here to enter it</a>.
		</article>
	</div>
</div>
{% endblock %}
{% block page %}

<form action="{{ path('admin_license_reqdemo') }}" method="post">
<input type="hidden" name="process" value="1" />

{% if errors|length %}
<div class="alert-message block-message error">
	<strong>{{ phrase('admin.license.we_encountered_a_problem') }}:</strong>
	<ul>
		{% if errors.email %}<li>{{ phrase('admin.license.please_enter_a_valid_email_address') }}</li>{% endif %}
		{% if errors.timeout %}<li>{{ phrase('admin.license.your_server_timedout_while_trying_to_contact_our') }}</li>{% endif %}
		{% if errors.server_error %}<li>{{ phrase('admin.license.our_licensing_server_is_having_technical_difficulties_you') }}</li>{% endif %}
		{% if errors.request_error %}<li>Our licensing server responded with the error code "{{ errors.request_error }}". You should contact support@deskpro.com if the problem persists.</li>{% endif %}
		{% if errors.unknown_request_error %}<li>{{ phrase('admin.license.there_was_an_unknown_problem_while_trying_to') }}</li>{% endif %}
	</ul>

	{% if errors.timeout or errors.unknown_request_error %}
		<p>
			{{ phrase('admin.license.a_connection_problem_may_be_temporary_but_it') }}
		</p>
		<p style="font-size: 120%; color: #000; margin-top: 10px; padding-top: 5px; border-top: #FBC7C6;">
			<a href="{{ path('admin_license_keyfile', {email_address: email_address|default(app.user.primary_email_address) }) }}" class="install-key-file">install.key</a>
			<br />
			If you continue to experience problems, email <a href="mailto:support@deskpro.com" style="color: #000;">support@deskpro.com</a> with the key file linked to the left
			and we will generate a license code for you.
		</p>
		<br class="clear" />
	{% endif %}
</div>
{% endif %}

<div class="dp-form">
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('admin.license.your_email_address') }}</label>
		</div>
		<div class="dp-form-input">
			<input type="text" name="email_address" value="{{ app.user.primary_email_address }}" /><br />
			<small>{{ phrase('admin.license.your_personal_demo_license_code_will_be_sent') }}</small>
		</div>
	</div>
</div>

	<button class="clean-white">Get your demo license &rarr;</button>
</form>

{% endblock %}
