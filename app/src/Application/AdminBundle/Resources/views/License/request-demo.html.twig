{% extends 'AdminBundle::layout.html.twig' %}
{% block pagebar %}
	<ul>
		<li>{{ phrase('admin.license.request_demo_license') }}</li>
	</ul>
{% endblock %}
{% block sidebar_right %}
<div class="dp-page-box" style="padding-top: 15px;">
	<div class="resource-item-list icon-group">
		<header>
			<h4>{{ phrase('admin.license.ask_have_license_code') }}</h4>
		</header>
		<article>
            {{ phrase('admin.license.do_if_have_license', {'path':path('admin_license_input')}) }}
		</article>
	</div>
</div>
{% endblock %}
{% block page %}

<form action="{{ path('admin_license_reqdemo') }}" method="post">
<input type="hidden" name="process" value="1" />

{% if errors|length %}
<div class="alert-message block-message error">
	<strong>{{ phrase('admin.license.error_encountered') }}:</strong>
	<ul>
		{% if errors.email %}<li>{{ phrase('agent.please_enter_valid_email') }}</li>{% endif %}
		{% if errors.timeout %}<li>{{ phrase('admin.license.error_you_timed_out') }}</li>{% endif %}
		{% if errors.server_error %}<li>{{ phrase('admin.license.error_licensing_server_problems') }}</li>{% endif %}
		{% if errors.request_error %}<li>{{ phrase('admin.license.license_server_detected_error', {'error':errors.request_error}) }}</li>{% endif %}
		{% if errors.unknown_request_error %}<li>{{ phrase('admin.license.error_licence_server_connection') }}</li>{% endif %}
	</ul>

	{% if errors.timeout or errors.unknown_request_error %}
		<p>
			{{ phrase('admin.license.explain_connection_problems') }}
		</p>
		<p style="font-size: 120%; color: #000; margin-top: 10px; padding-top: 5px; border-top: #FBC7C6;">
			<a href="{{ path('admin_license_keyfile', {email_address: email_address|default(app.user.primary_email_address) }) }}" class="install-key-file">{{ phrase('admin.license.installkey') }}</a>
			<br />
            {% set phrase_link %}
                <a href="mailto:support@deskpro.com" style="color: #000;">{{ phrase('agent.supportdeskprocom') }}</a>
            {% endset %}
            {{ phrase('admin.license.do_if_license_has_problems', {'link':phrase_link}) }}
		</p>
		<br class="clear" />
	{% endif %}
</div>
{% endif %}

<div class="dp-form">
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('agent.your_email_address') }}</label>
		</div>
		<div class="dp-form-input">
			<input type="text" name="email_address" value="{{ app.user.primary_email_address }}" /><br />
			<small>{{ phrase('admin.license.notice_license_destination') }}</small>
		</div>
	</div>
</div>

	<button class="clean-white">{{ phrase('admin.license.get_demo_license') }}</button>
</form>

{% endblock %}
