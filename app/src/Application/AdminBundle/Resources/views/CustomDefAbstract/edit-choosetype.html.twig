{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% extends layout_tpl ? layout_tpl : 'AdminBundle::layout.html.twig' %}
{% block page %}

<form action="{{ path(route_basename~'edit', {'field_id': 0}) }}" class="form">
{{ design.block_sections() }}

	{{ design.block_sections_item() }}
		<header><h3><label><input type="radio" name="fielddef[handler_class]" value="Application\DeskPRO\CustomFields\Handler\{{ phrase('admin.customdef.text') }}" checked="checked" /> {{ phrase('admin.customdef.text') }}</label></h3></header>
		<p>{{ phrase('admin.customdef.this_is_a_simple_oneline_text_box') }}</p>
	{{ design.block_sections_item_end() }}

	{{ design.block_sections_item() }}
		<header><h3><label><input type="radio" name="fielddef[handler_class]" value="Application\DeskPRO\CustomFields\Handler\Textarea" /> {{ phrase('admin.customdef.textarea') }}</label></h3></header>
		<p>{{ phrase('admin.customdef.this_is_a_multiline_text_box_that_can') }}</p>
	{{ design.block_sections_item_end() }}

	{{ design.block_sections_item() }}
		<header><h3><label><input type="radio" name="fielddef[handler_class]" value="Application\DeskPRO\CustomFields\Handler\Choice" /> {{ phrase('admin.customdef.choice') }}</label></h3></header>
		<p>{{ phrase('admin.customdef.this_is_a_set_of_predefined_options_presented') }}</p>
	{{ design.block_sections_item_end() }}

	{#
	{{ design.block_sections_item() }}
		<header><h3><label><input type="radio" name="fielddef[handler_class]" value="Application\DeskPRO\CustomFields\Handler\Date" /> {{ phrase('agent.global.date') }}</label></h3></header>
		<p>{{ phrase('admin.customdef.this_field_lets_you_select_a_date') }}</p>
	{{ design.block_sections_item_end() }}
	#}

	{{ design.block_sections_item() }}
		<header><h3><label><input type="radio" name="fielddef[handler_class]" value="Application\DeskPRO\CustomFields\Handler\Display" /> {{ phrase('admin.customdef.display') }}</label></h3></header>
		<p>{{ phrase('admin.customdef.this_is_a_widget_field_that_lets_you') }}</p>
	{{ design.block_sections_item_end() }}

	<li class="footer">
		<button class="clean-white">{{ phrase('agent.global.continue') }}</button>
	</li>

{{ design.block_sections_end() }}

</form>
{% endblock %}
