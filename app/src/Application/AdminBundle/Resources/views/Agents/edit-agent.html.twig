{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block pagebar %}
	{% if agent.id %}
	<nav>
		<ul>
			<li class="tools" id="tools_menu_trigger"><a></a><em></em></li>
		</ul>
	</nav>
	<ul id="tools_menu" style="display: none">
		{% if not agent.is_vacation_mode %}<li id="vacation_overlay_trigger">Vacation Mode</li>{% endif %}
		<li id="delete_overlay_trigger">Delete Agent</li>
	</ul>
	{% endif %}

	<ul>
		<li><a href="{{ path('admin_agents') }}">Agents</a></li>
		{% if agent.id %}
			<li>Edit Agent</li>
		{% else %}
			<li>New Agent</li>
		{% endif %}
	</ul>
{% endblock %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/ElementHandler/AgentEditPage.js') }}"></script>
{% endblock %}
{% block page %}
{% if agent.is_vacation_mode %}
	<div class="alert-message block-message info">
		<h1>{{ agent.display_name }} is currently in vacation mode</h1>
		<form action="{{ path('admin_agents_setvacation', {person_id: agent.id, set_to: '0'}) }}" method="post">
			{{ form_token() }}
			<p>
				While in vacation mode, agents cannot log in or use the system at all.
				If {{ agent.display_name }} is back, <button class="clean-white small">turn off vacation mode</button>
			</p>
		</form>
	</div>
{% endif %}

<form
	action="{{ path('admin_agents_edit_save', {'person_id': agent.id|default('0')}) }}"
	method="POST"
	data-element-handler="DeskPRO.Admin.ElementHandler.AgentEditPage"
	data-validate-url="{{ path('admin_agents_edit_formvalidate', {person_id: agent.id|default('0')}) }}"
>

<div class="dp-form">
	<div class="dp-form-section">
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>Name</label>
			</div>
			<div class="dp-form-input">
				<input style="width:200px;" type="text" name="agent[first_name]" value="{{ agent.first_name }}" />
				<input style="width:200px;" type="text" name="agent[last_name]" value="{{ agent.last_name }}" />
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>Email</label>
			</div>
			<div class="dp-form-input">
				<input style="width:422px;" type="text" name="agent[email]" value="{{ agent.primary_email_address }}" />
			</div>
		</div>

		{% if not agent.id %}
			<div class="dp-form-row">
				<div class="dp-form-label">
					<label>Initial Password</label>
				</div>
				<div class="dp-form-input">
					<input style="width:422px;" type="text" name="agent[password]" value="{{ random_password }}" />
				</div>
			</div>
		{% endif %}

		{% if all_teams %}
			<div class="dp-form-row">
				<div class="dp-form-label">
					<label>Teams</label>
				</div>
				<div class="dp-form-input">
					<div class="checkbox-rows"  style="width:417px;">
						<ul style="max-height: 200px;">
							{% for team in all_teams %}
							<li>
								<label>
									<input type="checkbox" name="agent[teams][]" value="{{ team.id }}" {% if team.id in agent_teams %}checked="checked"{% endif %} />
									{{ team.name }}
								</label>
							</li>
							{% endfor %}
						</ul>
					</div>
				</div>
			</div>
		{% endif %}
	</div>

	<div class="dp-form-section">
		<table cellspacing="0" cellpadding="0" width="100%"><tr>
			<td width="35%" style="padding-right: 10px">
				<div class="dp-form-row">
					<div class="dp-form-label">
						<label>Zone Access</label>
					</div>
					<div class="dp-form-input">
						<input type="hidden" name="agent[can_agent]" value="1" />

						<label style="line-height: 24px">
							<input type="checkbox" name="agent[can_admin]" value="1" {% if agent.can_admin %}checked="checked"{% endif %} />
							<span class="with-icon zone-admin">Can access admin</span>
						</label><br />

						<label style="line-height: 24px">
							<input type="checkbox" name="agent[can_reports]" value="1" {% if agent.can_reports %}checked="checked"{% endif %} />
							<span class="with-icon zone-reports">Can access reports</span>
						</label><br />

						<label style="line-height: 24px">
							<input type="checkbox" name="agent[can_billing]" value="1" {% if agent.can_billing %}checked="checked"{% endif %} />
							<span class="with-icon zone-billing">Can access billing</span>
						</label><br />
					</div>
				</div>
			</td>
			<td width="65%" style="padding-left: 10px">
				<div class="dp-form-row">
					<div class="dp-form-label">
						<label>Department Access Permissions</label>
					</div>
					<div class="dp-form-input">
						<div class="check-grid" style="max-height: 200px; overflow: auto;">
							<table width="100%">
								<thead>
									<tr>
										<th style="text-align: left;">Department</th>
										<th width="60">Tickets</th>
										<th width="60">Chat</th>
									</tr>
								</thead>
								<tbody>
									{% for dep in departments %}
										<tr>
											{% if dep.children|length %}
												<td class="title title-group">{{ dep.title }}</td>
												<td class="prop">&nbsp;</td>
												<td class="prop">&nbsp;</td>
											{% else %}
												<td class="title">{{ dep.title }}</td>
												<td class="prop"><input class="onoff-slider" type="checkbox" {% if agent_deps[dep.id].tickets or not agent.id %}checked="checked"{% endif %} name="agent[departments][{{ dep.id }}][tickets]" value="1" /></td>
												<td class="prop"><input class="onoff-slider" type="checkbox" {% if agent_deps[dep.id].chat or not agent.id %}checked="checked"{% endif %} name="agent[departments][{{ dep.id }}][chat]" value="1" /></td>
											{% endif %}
										</tr>
										{% if dep.children %}
											{% for subdep in dep.children %}
												<tr>
													<td class="title">&nbsp;&nbsp;&nbsp;&nbsp; {{ subdep.title }}</td>
													<td class="prop"><input class="onoff-slider" type="checkbox" {% if agent_deps[dep.id].tickets or not agent.id %}checked="checked"{% endif %} name="agent[departments][{{ subdep.id }}][tickets]" value="1" /></td>
													<td class="prop"><input class="onoff-slider" type="checkbox" {% if agent_deps[dep.id].chat or not agent.id %}checked="checked"{% endif %} name="agent[departments][{{ subdep.id }}][chat]" value="1" /></td>
												</tr>
											{% endfor %}
										{% endif %}
									{% endfor %}
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</td>
		</tr></table>
	</div>

	{##############################
	 # Permisssions
	 ##############################}
	<div class="dp-form-section">
		<table cellspacing="0" cellpadding="0" width="100%"><tr>
			<td width="35%" style="padding-right: 10px">
				{% if all_usergroups %}
					<div class="dp-form-row">
						<div class="dp-form-label">
							<label>Permission Groups</label>
						</div>
						<div class="dp-form-input">
							<div class="checkbox-rows" id="usergroup_checks">
								<ul style="max-height: 200px;">
									{% for usergroup in all_usergroups %}
									<li>
										<label>
											<input type="checkbox" name="agent[usergroups][]" value="{{ usergroup.id }}" {% if (not agent.id and usergroup.id == 2) or (usergroup.id in agent_usergroups) %}checked="checked"{% endif %} />
											{{ usergroup.title }}
										</label>
									</li>
									{% endfor %}
								</ul>
							</div>
						</div>
					</div>
				{% endif %}
			</td>
			<td width="65%" style="padding-left: 10px">
				<div class="dp-form-row">
					<div class="dp-form-label">
						<label>Permissions</label>
					</div>
					<div class="dp-form-input" id="permgroup_table">
						{% include 'AdminBundle:Agents:edit-agent-permtable.html.twig' %}
					</div>
				</div>
			</td>
		</table>
	</div>
</div>

<footer class="controls">
	<div class="is-not-loading">
		<button class="clean-white">Save Agent</button>
	</div>
	<div class="is-loading">
		<div class="loading-icon-flat">&nbsp;</div>
	</div>
</footer>

<br class="clear" />
</form>

{% include 'AdminBundle:Agents:edit-agent-overlays.html.twig' %}
{% endblock %}
