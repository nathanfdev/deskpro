{% macro perm_col(title, usergroup_values, permgroup, name, depends_on, class) %}
	{% set perm_fname_flat = permgroup ~ '_' ~ name %}
	<tr
		class="permrow perm-{{ permgroup }}_{{ name }} {{class}}"
		data-permgroup="{{ permgroup }}"
		data-permname="{{ name }}"
		{% if depends_on %}data-depends-on="{{ depends_on }}"{% endif %}
	>
		<td width="37" class="prop effective highlight no-border" id="effective_lbl_{{ perm_fname_flat }}">
			<span class="on">{{ phrase('admin.global.on') }}</span>
			<span class="off">{{ phrase('admin.global.off') }}</span>
		</td>
		<td class="title">{{ title|raw }}</td>
		<td class="prop">
			<input
				class="onoff-slider override-perm"
				type="checkbox"
				name="permissions[{{ permgroup }}][override][{{ name }}]"
				id="perm_val_override_{{ perm_fname_flat }}"
				value="1"
				{% if usergroup_values['override'][permgroup ~ '.' ~ name] %}checked="checked"{% endif %}
			/>
			{# Other permission values #}
			{% for id, ug in usergroup_values %}
				{% if id and id != 'override' %}
					<input
						type="hidden"
						class="ug-perm-val"
						data-ug-id="{{ id }}"
						name="permissions[{{ permgroup }}][{{ id }}][{{ name }}]"
						id="perm_val_{{ id }}_{{ perm_fname_flat }}"
						data-name="{{permgroup ~ '.' ~ name}}"
						value="{% if ug[permgroup ~ '.' ~ name] %}1{% else %}0{% endif %}"
					/>
				{% endif %}
			{% endfor %}
		</td>
	</tr>
{% endmacro %}

<nav class="check-grid-tabs">
	<ul data-element-handler="DeskPRO.ElementHandler.SimpleTabs" data-trigger-elements="> li">
		<li class="on" data-tab-for="#permgroup_tickets"><span>{{ phrase('admin.global.tickets') }}</span></li>
		<li data-tab-for="#permgroup_people"><span>{{ phrase('admin.agents.people_and_organizations') }}</span></li>
		<li data-tab-for="#permgroup_chat"><span>{{ phrase('admin.global.chat') }}</span></li>
		<li data-tab-for="#permgroup_publish"><span>{{ phrase('admin.global.publish') }}</span></li>
	</ul>
</nav>

