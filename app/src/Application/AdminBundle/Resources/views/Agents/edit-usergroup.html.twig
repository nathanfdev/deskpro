{% set page_handler = 'DeskPRO.Admin.ElementHandler.AgentGroupEditPage' %}
{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block pagebar %}
	{% if usergroup.id %}
	<nav>
		<ul>
			<li class="tools" id="tools_menu_trigger"><a></a><em></em></li>
		</ul>
	</nav>
	<ul id="tools_menu" style="display: none">
		<li id="delete_overlay_trigger">{{ phrase('admin.agents.delete_permission_group') }}</li>
	</ul>
	{% endif %}

	<ul>
		<li><a href="{{ path('admin_agents') }}">{{ phrase('admin.agents.agents') }}</a></li>
		{% if usergroup.id %}
			<li>{{ phrase('admin.agents.edit_permission_group') }}</li>
		{% else %}
			<li>{{ phrase('admin.agents.new_permission_group') }}</li>
		{% endif %}
	</ul>
{% endblock %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/ElementHandler/AgentGroupEditPage.js') }}"></script>
{% endblock %}
{% block page %}

<form action="{{ path('admin_agents_groups_edit', {'usergroup_id': usergroup.id|default(0)}) }}" method="post">
<input type="hidden" name="process" value="1" />

<div class="dp-form">
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('admin.agents.title') }}</label>
		</div>
		<div class="dp-form-input">
			<input type="text" name="usergroup[title]" value="{{usergroup.title}}" />
		</div>
	</div>
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>{{ phrase('admin.agents.members') }}</label>
		</div>
		<div class="dp-form-input">
			<div class="checkbox-rows">
				<ul>
					{% for agent in agents %}
					<li>
						<label>
							<input type="checkbox" name="usergroup[members][]" value="{{ agent.id }}" {% if agent.id in members %}checked="checked"{% endif %} />
							{{ agent.display_name }}
						</label>
					</li>
					{% endfor %}
				</ul>
			</div>
		</div>
	</div>

	{##############################
	 # Permisssions
	 ##############################}
	<div class="dp-form-row">
		<div class="dp-form-label" id="permgroups">
			<label>{{ phrase('admin.agents.permissions') }}</label>

			{% macro perm_col(usergroup_values, permgroup, name) %}
				<td class="prop"><input
					class="onoff-slider permcheck"
					type="checkbox"
					name="permissions[{{ permgroup }}][{{ name }}]"
					value="1"
					data-perm-name="{{ permgroup}}.{{ name }}"
					{% if usergroup_values[permgroup ~ '.' ~ name] %}checked="checked"{% endif %}
				/></td>
			{% endmacro %}

			<nav class="check-grid-tabs">
				<button class="clean-white small" style="float:right; position: relative; top: -4px;" id="load_agent_perms_btn">{{ phrase('admin.agents.load_permissions_from_agent') }}</button>
				<ul data-element-handler="DeskPRO.ElementHandler.SimpleTabs" data-trigger-elements="> li">
					<li class="on" data-tab-for="#permgroup_tickets"><span>{{ phrase('admin.agents.tickets') }}</span></li>
					<li data-tab-for="#permgroup_people"><span>{{ phrase('admin.agents.people_and_organizations') }}</span></li>
					<li data-tab-for="#permgroup_chat"><span>{{ phrase('admin.agents.chat') }}</span></li>
					<li data-tab-for="#permgroup_publish"><span>{{ phrase('admin.agents.publish') }}</span></li>
				</ul>
			</nav>

			{# TICKET PERMISSIONS #}
			<div id="permgroup_tickets" style="display: none">
				<div class="check-grid">
					<table width="100%">
						<thead>
							<tr>
								<th>{{ phrase('admin.agents.permission') }}</th>
								<th width="60">{{ phrase('admin.agents.onoff') }}</th>
							</tr>
						</thead>
						<tbody>
							<tr class="permrow">
								<td class="title">{{ phrase('admin.agents.use_ticket_system') }}</td>
								{{ _self.perm_col(usergroup_values, 'tickets', 'use') }}
							</tr>
							<tr>
								<td class="title">{{ phrase('admin.agents.create_tickets') }}</td>
								{{ _self.perm_col(usergroup_values, 'tickets', 'create') }}
							</tr>
						</tbody>
						<tbody>
							<tr class="permrow">
								<td class="title">{{ phrase('admin.agents.view_own_and_teams_tickets') }}</td>
								{{ _self.perm_col(usergroup_values, 'tickets', 'view_own') }}
							</tr>
							<tr class="permrow">
								<td class="title">{{ phrase('admin.agents.modify_own_and_teams_tickets') }}</td>
								{{ _self.perm_col(usergroup_values, 'tickets', 'modify_own') }}
							</tr>
							<tr class="permrow">
								<td class="title">{{ phrase('admin.agents.delete_own_and_teams_tickets') }}</td>
								{{ _self.perm_col(usergroup_values, 'tickets', 'delete_own') }}
							</tr>
							<tr class="permrow">
								<td class="title">{{ phrase('admin.agents.resolve_own_and_teams_tickets') }}</td>
								{{ _self.perm_col(usergroup_values, 'tickets', 'resolve_own') }}
							</tr>
						</tbody>
						<tbody>
							<tr class="permrow">
								<td class="title">{{ phrase('admin.agents.view_unassigned_tickets') }}</td>
								{{ _self.perm_col(usergroup_values, 'tickets', 'view_unassigned') }}
							</tr>
							<tr class="permrow">
								<td class="title">{{ phrase('admin.agents.modify_unassigned_tickets') }}</td>
								{{ _self.perm_col(usergroup_values, 'tickets', 'modify_unassigned') }}
							</tr>
							<tr class="permrow">
								<td class="title">{{ phrase('admin.agents.delete_unassigned_tickets') }}</td>
								{{ _self.perm_col(usergroup_values, 'tickets', 'delete_unassigned') }}
							</tr>
							<tr class="permrow">
								<td class="title">{{ phrase('admin.agents.resolve_unassigned_tickets') }}</td>
								{{ _self.perm_col(usergroup_values, 'tickets', 'resolve_unassigned') }}
							</tr>
						</tbody>
						<tbody>
							<tr class="permrow">
								<td class="title">{{ phrase('admin.agents.view_others_tickets') }}</td>
								{{ _self.perm_col(usergroup_values, 'tickets', 'view_others') }}
							</tr>
							<tr class="permrow">
								<td class="title">{{ phrase('admin.agents.modify_others_tickets') }}</td>
								{{ _self.perm_col(usergroup_values, 'tickets', 'modify_others') }}
							</tr>
							<tr class="permrow">
								<td class="title">{{ phrase('admin.agents.delete_others_tickets') }}</td>
								{{ _self.perm_col(usergroup_values, 'tickets', 'delete_others') }}
							</tr>
							<tr class="permrow">
								<td class="title">{{ phrase('admin.agents.resolve_others_tickets') }}</td>
								{{ _self.perm_col(usergroup_values, 'tickets', 'resolve_others') }}
							</tr>
						</tbody>
					</table>
				</div>
			</div>
			{# /TICKET PERMISSIONS #}

			{# PEOPLE PERMISSIONS #}
			<div id="permgroup_people" style="display: none">
				<div class="check-grid">
					<table width="100%">
						<thead>
							<tr>
								<th>{{ phrase('admin.agents.permission') }}</th>
								<th width="60">{{ phrase('admin.agents.onoff') }}</th>
							</tr>
						</thead>
						<tbody>
							<tr class="permrow">
								<td class="title">{{ phrase('admin.agents.create_people') }}</td>
								{{ _self.perm_col(usergroup_values, 'people', 'create') }}
							</tr>
							<tr class="permrow">
								<td class="title">
									{{ phrase('admin.agents.edit_people') }}
								</td>
								{{ _self.perm_col(usergroup_values, 'people', 'edit') }}
							</tr>
							<tr class="permrow">
								<td class="title">{{ phrase('admin.agents.delete_people') }}</td>
								{{ _self.perm_col(usergroup_values, 'people', 'delete') }}
							</tr>
							<tr class="permrow">
								<td class="title">
									{{ phrase('admin.agents.validate_users_and_user_email_addresses') }}
								</td>
								{{ _self.perm_col(usergroup_values, 'people', 'validate') }}
							</tr>
							<tr>
								<td class="title">
									{{ phrase('admin.agents.edit_email_addresses') }}
									<span class="small-light-icon tipped" data-tipped-options="maxWidth: 250" title="{{ phrase('admin.agents.be_careful_who_you_allow_to_manage_email') }}"></span>
								</td>
								{{ _self.perm_col(usergroup_values, 'people', 'manage_emails') }}
							</tr>
							<tr>
								<td class="title">
									{{ phrase('admin.agents.reset_passwords') }}
									<span class="small-light-icon tipped" data-tipped-options="maxWidth: 250" title="{{ phrase('admin.agents.be_careful_who_you_allow_to_reset_user') }}"></span>
								</td>
								{{ _self.perm_col(usergroup_values, 'people', 'reset_password') }}
							</tr>
						</tbody>
						<tbody>
							<tr class="permrow">
								<td class="title">{{ phrase('admin.agents.create_organizations') }}</td>
								{{ _self.perm_col(usergroup_values, 'org', 'create') }}
							</tr>
							<tr class="permrow">
								<td class="title">{{ phrase('admin.agents.edit_organizations') }}</td>
								{{ _self.perm_col(usergroup_values, 'org', 'edit') }}
							</tr>
							<tr class="permrow">
								<td class="title">{{ phrase('admin.agents.delete_organizations') }}</td>
								{{ _self.perm_col(usergroup_values, 'org', 'delete') }}
							</tr>
						</tbody>
					</table>
				</div>
			</div>
			{# /PEOPLE PERMISSIONS #}

			{# CHAT PERMISSIONS #}
			<div id="permgroup_chat" style="display: none">
				<div class="check-grid">
					<table width="100%">
						<thead>
							<tr>
								<th>{{ phrase('admin.agents.permission') }}</th>
								<th width="60">{{ phrase('admin.agents.onoff') }}</th>
							</tr>
						</thead>
						<tbody>
							<tr class="permrow">
								<td class="title">{{ phrase('admin.agents.use_chat_system') }}</td>
								{{ _self.perm_col(usergroup_values, 'chat', 'use') }}
							</tr>
							<tr>
								<td class="title">{{ phrase('admin.agents.can_see_new_unassigned_chats') }}</td>
								{{ _self.perm_col(usergroup_values, 'chat', 'view_unassigned') }}
							</tr>
							<tr>
								<td class="title">{{ phrase('admin.agents.can_see_chats_assigned_to_others') }}</td>
								{{ _self.perm_col(usergroup_values, 'chat', 'view_others') }}
							</tr>
							<tr>
								<td class="title">{{ phrase('admin.agents.can_delete_chat_transcripts') }}</td>
								{{ _self.perm_col(usergroup_values, 'chat', 'delete') }}
							</tr>
						</tbody>
					</table>
				</div>
			</div>
			{# /CHAT PERMISSIONS #}

			{# PUBLISH PERMISSIONS #}
			<div id="permgroup_publish" style="display: none">
				<div class="check-grid">
					<table width="100%">
						<thead>
							<tr>
								<th>{{ phrase('admin.agents.permission') }}</th>
								<th width="60">{{ phrase('admin.agents.onoff') }}</th>
							</tr>
						</thead>
						<tbody>
							<tr class="permrow">
								<td class="title">{{ phrase('admin.agents.create_content') }}</td>
								{{ _self.perm_col(usergroup_values, 'publish', 'create') }}
							</tr>
							<tr class="permrow">
								<td class="title">{{ phrase('admin.agents.delete_content') }}</td>
								{{ _self.perm_col(usergroup_values, 'publish', 'delete') }}
							</tr>
							<tr class="permrow">
								<td class="title">{{ phrase('admin.agents.edit_others_content') }}</td>
								{{ _self.perm_col(usergroup_values, 'publish', 'edit') }}
							</tr>
							<tr class="permrow">
								<td class="title">
									{{ phrase('admin.agents.validate_content_and_comments_including_own') }}
									<span class="small-light-icon tipped" data-tipped-options="maxWidth: 250" title="{{ phrase('admin.agents.if_an_agent_does_not_have_this_permission') }}"></span>
								</td>
								{{ _self.perm_col(usergroup_values, 'publish', 'validate') }}
							</tr>
						</tbody>
					</table>
				</div>
			</div>
			{# /CHAT PERMISSIONS #}
		</div>
	</div>
</div>

<button class="btn primary save-trigger">{{ phrase('admin.agents.save') }}</button>
</form>

{% if usergroup.id %}
<div id="delete_overlay" style="width: 400px; height: 150px; display: none;">
	<div class="overlay-title">
		<span class="close-overlay"></span>
		<h4>{{ phrase('admin.agents.delete_agent') }}</h4>
	</div>
	<div class="overlay-content">
		<p>{{ phrase('admin.agents.deleting_this_permission_group_will_remove_all_the') }}</p>
	</div>
	<div class="overlay-footer">
		<form action="{{ path('admin_agents_groups_del', {'usergroup_id': usergroup.id, 'security_token': security_token('delete_group')}) }}" method="get">
			<button class="clean-white">
				{% set phrase_part %}<span class="agent-name">{{ usergroup.title }}</span>{% endset %}
                {{ phrase('admin.agents.delete_name', {'name':phrase_part}) }}
			</button>
		</form>
	</div>
</div>
{% endif %}
{% endblock %}
