{% set page_handler = 'DeskPRO.Admin.ElementHandler.AgentListPage' %}
{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/ElementHandler/AgentListPage.js') }}"></script>
{% endblock %}
{% block pagebar %}
	<nav>
		<ul>
			<li class="add"><a href="{{ path('admin_agents_new') }}">{{ phrase('admin.agents.add_agent') }}</a></li>
		</ul>
	</nav>
	<ul>
		<li>{{ phrase('agent.agents') }}</li>
	</ul>
{% endblock %}
{% block prepage %}
	<div style="padding: 10px 10px 0 10px;">
		{{ design.helpbox() }}
			<p>{{ phrase('admin.agents.agents_are_anybody_with_access_to_the_agent') }}</p>
			<p>{{ phrase('admin.agents.agent_teams_are_for_helpdesks_that_want_to') }}</p>
		{{ design.helpbox_end() }}
	</div>
{% endblock %}
{% block sidebar_right %}
	<div class="dp-page-box">
		<div class="resource-item-list">
			<header>
				<div class="controls">
					<a class="clean-white small" href="{{ path('admin_agents_groups_new') }}">{{ phrase('agent.new') }}</a>
				</div>
				<h4>{{ phrase('admin.agents.permission_groups') }}</h4>
			</header>
			<article>
				<article class="box-hint">{{ phrase('admin.agents.a_permission_group_is_a_set_of_system') }}</article>
				<ul>
					{% for usergroup in all_usergroups %}
						<li class="usergroup usergroup-{{usergroup.id}}" data-usergroup-id="{{usergroup.id}}">
							<a class="title" href="{{ path('admin_agents_groups_edit', {'usergroup_id': usergroup.id}) }}">{{usergroup.title}}</a>
							<div class="icon-list">
								<ul>
									{% for id in usergroup_member_ids[usergroup.id] %}
										{% set agent = all_agents[id] %}
										<li><img src="{{ agent.getPictureUrl(30) }}" class="tipped" title="{{ agent.display_name }}" /></li>
									{% endfor %}
								</ul>
								<br class="clear" />
							</div>
						</li>
					{% else %}
						{{ phrase('admin.agents.you_have_not_created_any_permission_groups') }} <a href="{{ path('admin_agents_groups_new') }}">{{ phrase('admin.agents.click_here') }}</a> {{ phrase('admin.agents.to_create_one_now') }}
					{% endfor %}
				</ul>
			</article>
		</div>
	</div>

	<div class="dp-page-box">
		<div class="resource-item-list icon-group">
			<header>
				<div class="controls">
					<a class="clean-white small" href="{{ path('admin_agents_teams_new') }}">{{ phrase('agent.new') }}</a>
				</div>
				<h4>{{ phrase('agent.teams') }}</h4>
			</header>
			<article>
				<article class="box-hint">{{ phrase('admin.agents.teams_are_an_a_way_to_organize_agents') }}</article>
				<ul>
					{% for team in all_teams %}
						<li class="agent-team team-{{team.id}}" data-team-id="{{team.id}}">
							<a class="title" href="{{ path('admin_agents_teams_edit', {'team_id': team.id}) }}">{{team.name}}</a>
							<div class="icon-list">
								<ul>
									{% for id in team_member_ids[team.id] %}
										{% set agent = all_agents[id] %}
										<li><img src="{{ agent.getPictureUrl(30) }}" class="tipped" title="{{ agent.display_name }}" /></li>
									{% endfor %}
								</ul>
								<br class="clear" />
							</div>
						</li>
					{% else %}
						<li>
							{{ phrase('admin.agents.you_have_not_created_any_teams') }} <a href="{{ path('admin_agents_teams_new') }}">{{ phrase('admin.agents.click_here') }}</a> {{ phrase('admin.agents.to_create_one_now') }}
						</li>
					{% endfor %}
				</ul>
			</article>
		</div>
	</div>
{% endblock %}

{% block content %}
<div class="dp-page-box">

<div class="page-content agent-listing" style="padding-top: 0;">

	<div class="content-table">
		<table width="100%">
			<thead>
				<tr>
					<th class="single-title">{{ phrase('agent.agent') }}</th>
					<th class="r-col" width="16"><img title="{{ phrase('admin.agents.can_access_the_admin_interface') }}" src="{{ asset('images/admin/icons/zone-admin.png') }}" /></th>
					<th class="r-col" width="16"><img title="{{ phrase('admin.agents.can_access_the_reporting_interface') }}" src="{{ asset('images/admin/icons/zone-reports.png') }}" /></th>
					<th class="r-col" width="16"><img title="{{ phrase('admin.agents.can_access_the_billing_interface') }}" src="{{ asset('images/admin/icons/zone-billing.png') }}" /></th>
				</tr>
			</thead>
			<tbody>
				{% for person in all_agents %}
					{% if person.is_vacation_mode %}
					<tr class="vacation-mode" data-agent-id="{{ person.id }}">
						<td class="title" colspan="4">
							<div class="vacation-mode-desc">
								{{ phrase('admin.agents.vacation_mode') }}
							</div>
							<img src="{{ person.getPictureUrl(28) }}" align="left" style="margin-right: 6px;" />
							<h4><a href="{{ path('admin_agents_edit', {'person_id': person.id} )}}">{{person.display_name}}</a></h4>
							<address>{{person.primary_email_address}}</address>
						</td>
					</tr>
					{% else %}
						<tr data-agent-id="{{ person.id }}">
							<td class="title">
								<span class="tools-menu-icon agent"></span>
								<img src="{{ person.getPictureUrl(28) }}" align="left" style="margin-right: 6px;" />
								<h4><a href="{{ path('admin_agents_edit', {'person_id': person.id} )}}">{{person.display_name}}</a></h4>
								<address>{{person.primary_email_address}}</address>
							</td>
							<td class="prop r-col">{% if person.can_admin %}<img src="{{ asset('images/agent/icons/check.png') }}" />{% else %}&nbsp;{% endif %}</td>
							<td class="prop r-col">{% if person.can_reports %}<img src="{{ asset('images/agent/icons/check.png') }}" />{% else %}&nbsp;{% endif %}</td>
							<td class="prop r-col">{% if person.can_billing %}<img src="{{ asset('images/agent/icons/check.png') }}" />{% else %}&nbsp;{% endif %}</td>
						</tr>
					{% endif %}
				{% endfor %}
			</tbody>
		</table>
	</div>
<div>

{% if count_deleted %}
	<div class="deleted-text">
        <a href="{{ path('admin_agents_deleted') }}">{{ phrase('admin.agents.there_are_deleted_agents', {'count':count_deleted}) }}</a>.
	</div>
{% endif %}

<ul id="agent_tools_menu" style="display: none">
	{#<li class="vacation">Vacation Mode</li>#}
	<li class="delete">{{ phrase('admin.agents.delete_agent') }}</li>
</ul>
{% include 'AdminBundle:Agents:edit-agent-overlays.html.twig' %}

</div>
{% endblock %}
