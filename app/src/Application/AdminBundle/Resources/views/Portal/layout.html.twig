{% extends 'AdminBundle::layout.html.twig' %}
{% block page_nav %}
<div data-element-handler="DeskPRO.Admin.ElementHandler.PortalNav" id="portal_nav">
	<section class="top">
		<header>
			<h4>{{ phrase('admin.global.portal') }}</h4>
		</header>
		<article>
			<ul>
				<li class="{% if this_page == 'portal_editor' %}on{% endif %}"><a href="{{ path('admin_portal') }}">{{ phrase('admin.portal.portal_editor') }}</a></li>
				<li class="{% if this_page == 'website_widgets' %}on{% endif %}"><a>{{ phrase('admin.portal.website_widgets') }}</a></li>
				<li class="{% if this_page == 'labels' %}on{% endif %}"><a>{{ phrase('admin.global.labels') }}</a></li>
				<li class="{% if this_page == 'portal_settings' %}on{% endif %}"><a href="{{ path('admin_portal_settings') }}">{{ phrase('admin.portal.global_settings') }}</a></li>
				<li class="{% if this_page == 'portal_templates' %}on{% endif %}"><a href="{{ path('admin_templates_user') }}">{{ phrase('admin.global.templates') }}</a></li>
			</ul>
		</article>

		{% block page_nav_portal %}{% endblock %}
	</section>

	<section>
		<header>
			<div class="onoff">
				<input type="checkbox" name="kb" value="1" checked="checked" class="onoff-slider section-toggle" />
			</div>
			<h4>{{ phrase('admin.global.knowledgebase') }}</h4>
		</header>
		<article>
			<ul>
				{#<li class="{% if this_page == 'kb_settings' %}on{% endif %}"><a>Settings</a></li>#}
				<li class="{% if this_page == 'kb_fields' %}on{% endif %}"><a href="{{ path('admin_customdefarticles') }}">{{ phrase('admin.portal.custom_fields') }}</a></li>
				<li><a href="{{ app.request.getBaseUrl() }}/agent/#app.publish" target="_blank">{{ phrase('admin.portal.manage_articles') }}</a></li>
			</ul>
		</article>
	</section>

	<section>
		<header>
			<div class="onoff">
				<input type="checkbox" name="feedback" value="1" checked="checked" class="onoff-slider section-toggle" />
			</div>
			<h4>{{ phrase('admin.global.feedback') }}</h4>
		</header>
		<article>
			<ul>
				{#<li class="{% if this_page == 'feedback_settings' %}on{% endif %}"><a href="{{ path('admin_feedback_settings' ) }}">Settings</a></li>#}
				<li class="{% if this_page == 'feedback_statuses' %}on{% endif %}"><a href="{{ path('admin_feedback_statuses') }}">{{ phrase('admin.global.statuses') }}</a></li>
				<li class="{% if this_page == 'feedback_cats' %}on{% endif %}"><a href="{{ path('admin_feedback_cats') }}">{{ phrase('admin.global.categories') }}</a></li>
				<li class="{% if this_page == 'feedback_fields' %}on{% endif %}"><a href="{{ path('admin_customdeffeedback') }}">{{ phrase('admin.portal.custom_fields') }}</a></li>
				<li><a href="{{ app.request.getBaseUrl() }}/agent/#app.feedback" target="_blank">{{ phrase('admin.portal.manage_feedback') }}</a></li>
			</ul>
		</article>
	</section>

	<section>
		<header>
			<div class="onoff">
				<input type="checkbox" name="downloads" value="1" checked="checked" class="onoff-slider section-toggle" />
			</div>
			<h4>{{ phrase('admin.global.downloads') }}</h4>
		</header>
		<article>
			<ul>
				{#<li><a>Settings</a></li>#}
				<li><a>{{ phrase('admin.portal.custom_fields') }}</a></li>
				<li><a href="{{ app.request.getBaseUrl() }}/agent/#app.publish" target="_blank">{{ phrase('admin.portal.manage_downloads') }}</a></li>
			</ul>
		</article>
	</section>

	<section>
			<header>
				<div class="onoff">
					<input type="checkbox" name="news" value="1" checked="checked" class="onoff-slider section-toggle" />
				</div>
				<h4>{{ phrase('admin.global.news') }}</h4>
			</header>
			<article>
				<ul>
					{#<li><a>Settings</a></li>#}
					<li><a>{{ phrase('admin.portal.custom_fields') }}</a></li>
					<li><a href="{{ app.request.getBaseUrl() }}/agent/#app.publish" target="_blank">{{ phrase('admin.portal.manage_news') }}</a></li>
				</ul>
			</article>
		</section>

	{#
		<section>
			<header>
				<div class="onoff">
					<input type="checkbox" name="troubles" value="1" checked="checked" class="onoff-slider section-toggle" />
				</div>
				<h4>Troubleshooters</h4>
			</header>
			<article>
				<ul>
					<li><a>Settings</a></li>
					<li><a>{{ phrase('admin.portal.custom_fields') }}</a></li>
				</ul>
			</article>
		</section>
	#}
</div>
{% endblock %}
