{% extends 'AdminBundle::layout.html.twig' %}
{% block page_nav %}
<div data-element-handler="DeskPRO.Admin.ElementHandler.PortalNav" id="portal_nav">
	<section class="top">
		<header>
			<h4>Portal</h4>
		</header>
		<article>
			<ul>
				<li class="{% if this_page == 'portal_editor' %}on{% endif %}"><a href="{{ path('admin_portal') }}">Portal Editor</a></li>
				<li class="{% if this_page == 'website_widgets' %}on{% endif %}"><a>Website Widgets</a></li>
				<li class="{% if this_page == 'labels' %}on{% endif %}"><a>Labels</a></li>
				<li class="{% if this_page == 'portal_settings' %}on{% endif %}"><a href="{{ path('admin_portal_settings') }}">Global Settings</a></li>
				<li class="{% if this_page == 'portal_templates' %}on{% endif %}"><a href="{{ path('admin_templates_user') }}">Templates</a></li>
			</ul>
		</article>

		{% block page_nav_portal %}{% endblock %}
	</section>

	<section>
		<header>
			<div class="onoff">
				<input type="checkbox" name="kb" value="1" checked="checked" class="onoff-slider section-toggle" />
			</div>
			<h4>Knowledgebase</h4>
		</header>
		<article>
			<ul>
				{#<li class="{% if this_page == 'kb_settings' %}on{% endif %}"><a>Settings</a></li>#}
				<li class="{% if this_page == 'kb_fields' %}on{% endif %}"><a href="{{ path('admin_customdefarticles') }}">Custom Fields</a></li>
				<li><a href="{{ app.request.getBaseUrl() }}/agent/#app.publish" target="_blank">Manage Articles</a></li>
			</ul>
		</article>
	</section>

	<section>
		<header>
			<div class="onoff">
				<input type="checkbox" name="feedback" value="1" checked="checked" class="onoff-slider section-toggle" />
			</div>
			<h4>Feedback</h4>
		</header>
		<article>
			<ul>
				{#<li class="{% if this_page == 'feedback_settings' %}on{% endif %}"><a href="{{ path('admin_feedback_settings' ) }}">Settings</a></li>#}
				<li class="{% if this_page == 'feedback_statuses' %}on{% endif %}"><a href="{{ path('admin_feedback_statuses') }}">Statuses</a></li>
				<li class="{% if this_page == 'feedback_cats' %}on{% endif %}"><a href="{{ path('admin_feedback_cats') }}">Categories</a></li>
				<li class="{% if this_page == 'feedback_fields' %}on{% endif %}"><a href="{{ path('admin_customdeffeedback') }}">Custom Fields</a></li>
				<li><a href="{{ app.request.getBaseUrl() }}/agent/#app.feedback" target="_blank">Manage Feedback</a></li>
			</ul>
		</article>
	</section>

	<section>
		<header>
			<div class="onoff">
				<input type="checkbox" name="downloads" value="1" checked="checked" class="onoff-slider section-toggle" />
			</div>
			<h4>Downloads</h4>
		</header>
		<article>
			<ul>
				{#<li><a>Settings</a></li>#}
				<li><a>Custom Fields</a></li>
				<li><a href="{{ app.request.getBaseUrl() }}/agent/#app.publish" target="_blank">Manage Downloads</a></li>
			</ul>
		</article>
	</section>

	<section>
			<header>
				<div class="onoff">
					<input type="checkbox" name="news" value="1" checked="checked" class="onoff-slider section-toggle" />
				</div>
				<h4>News</h4>
			</header>
			<article>
				<ul>
					{#<li><a>Settings</a></li>#}
					<li><a>Custom Fields</a></li>
					<li><a href="{{ app.request.getBaseUrl() }}/agent/#app.publish" target="_blank">Manage News</a></li>
				</ul>
			</article>
		</section>

	{#
		<section>
			<header>
				<div class="onoff">
					<input type="checkbox" name="troubles" value="1" checked="checked" class="onoff-slider section-toggle" />
				</div>
				<h4>Troubleshooters</h4>
			</header>
			<article>
				<ul>
					<li><a>Settings</a></li>
					<li><a>Custom Fields</a></li>
				</ul>
			</article>
		</section>
	#}
</div>
{% endblock %}
