{% extends 'AdminBundle::layout.html.twig' %}
{% block page_nav %}
<div data-element-handler="DeskPRO.Admin.ElementHandler.PortalNav" id="portal_nav">
	<section class="top">
		<header>
			<h4>{{ phrase('admin.general.portal') }}</h4>
		</header>
		<article>
			<ul>
				<li class="{% if this_page == 'portal_editor' %}{{ phrase('admin.general.on') }}{% endif %}"><a href="{{ path('admin_portal') }}">{{ phrase('admin.portal.portal_editor') }}</a></li>
				<li class="{% if this_page == 'website_widgets' %}{{ phrase('admin.general.on') }}{% endif %}"><a>{{ phrase('admin.portal.website_widgets') }}</a></li>
				<li class="{% if this_page == 'labels' %}{{ phrase('admin.general.on') }}{% endif %}"><a>{{ phrase('agent.general.labels') }}</a></li>
				<li class="{% if this_page == 'portal_settings' %}{{ phrase('admin.general.on') }}{% endif %}"><a href="{{ path('admin_portal_settings') }}">{{ phrase('admin.portal.global_settings') }}</a></li>
				<li class="{% if this_page == 'portal_templates' %}{{ phrase('admin.general.on') }}{% endif %}"><a href="{{ path('admin_templates_user') }}">{{ phrase('admin.general.templates') }}</a></li>
			</ul>
		</article>

		{% block page_nav_portal %}{% endblock %}
	</section>
</div>
{% endblock %}
