<section class="dp-portal-simpleheader-editor">
	<div class="overlay-title">
		<span class="close-overlay close-trigger"></span>
		<h4>Edit Logo</h4>
	</div>
	<div class="overlay-content">
		<div class="image">

			<h3>Upload a new logo</h3>
			<input type="file" name="file-upload" />
			<div class="files"></div>

			<script class="template-upload" type="text/text/x-tmpl">
				<p>Upliading ...</p>
			</script>
			<script class="template-download" type="text/x-tmpl">
				{{ '{% var file=o.files[0]; %}' }}
				<div>
					<input type="hidden" class="new_blob_auth_id" value="{{ '{%=file.blob_auth_id%}' }}" />
					<input type="hidden" class="new_logo_url" value="{{ '{%=file.download_url%}' }}" />
					<img src="{{ '{%=file.download_url%}' }}" class="pic-new" />
				</div>
			</script>

			<div class="save-btn-wrap">
				<button class="clean-white save-logo-trigger">Save logo</button>
			</div>
		</div>
		<div class="text">
			<h3>... or just enter a title and a tagline</h3>
			<div class="input-title"><input type="text" class="title" name="title" value="{{ app.getSetting('core.deskpro_name') }}" placeholder="Title" /></div>
			<div class="input-tagline"><input type="text" class="tagline" name="tagline" value="{{ app.getSetting('core.deskpro_tagline') }}" placeholder="Tagline" /></div>

			<div class="save-btn-wrap">
				<button class="clean-white save-text-trigger">Save title and tagline</button>
			</div>
		</div>
	</div>
</section>
