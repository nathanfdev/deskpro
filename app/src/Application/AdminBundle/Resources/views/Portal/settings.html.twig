{% set this_page = 'portal_settings' %}
{% extends 'AdminBundle:Portal:layout.html.twig' %}
{% block pagetitle %}
	<h1>{{ phrase('admin.portal.portal_settings') }}</h1>
{% endblock %}
{% block page %}
<div class="setting_field_row">
	<h4>{{ phrase('admin.portal.commenting') }}</h4>
	<div class="setting_fields">
		<div class="field_row">
			<label><input type="checkbox" name="settings[core.helpdesk_enabled]" {% if app.getSetting('core.helpdesk_enabled') %}checked="checked"{% endif %} />
				{{ phrase('admin.portal.allow_users_to_submit_comments') }}</label>
			<label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<input type="checkbox" name="settings[core.helpdesk_enabled]" {% if app.getSetting('core.helpdesk_enabled') %}checked="checked"{% endif %} />
				{{ phrase('admin.portal.require_users_to_log_in_or_register_before') }}</label>
			<label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<input type="checkbox" name="settings[core.helpdesk_enabled]" {% if app.getSetting('core.helpdesk_enabled') %}checked="checked"{% endif %} />
				{{ phrase('admin.portal.require_users_to_validate_their_email_addresses_before') }}</label>
			<label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<input type="checkbox" name="settings[core.helpdesk_enabled]" {% if app.getSetting('core.helpdesk_enabled') %}checked="checked"{% endif %} />
				{{ phrase('admin.portal.require_all_comments_to_be_manually_validated_by') }}</label>
			<label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<input type="checkbox" name="settings[core.helpdesk_enabled]" {% if app.getSetting('core.helpdesk_enabled') %}checked="checked"{% endif %} />
				{{ phrase('admin.portal.show_a_captcha_on_comment_forms') }}</label>
		</div>
		<div class="field_row">
			<label><input type="checkbox" name="settings[core.helpdesk_enabled]" {% if app.getSetting('core.helpdesk_enabled') %}checked="checked"{% endif %} />
				{{ phrase('admin.portal.allow_users_to_rate_content') }}</label>
			<label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<input type="checkbox" name="settings[core.helpdesk_enabled]" {% if app.getSetting('core.helpdesk_enabled') %}checked="checked"{% endif %} />
			{{ phrase('admin.portal.show_ratings_publicly') }}</label>
		</div>
	</div>
</div>

<div class="setting_field_row">
	<h4>{{ phrase('admin.portal.integrations') }}</h4>
	<div class="setting_fields">
		<div class="field_row">
			<label><input type="checkbox" name="settings[core.helpdesk_enabled]" {% if app.getSetting('core.helpdesk_enabled') %}checked="checked"{% endif %} /> {{ phrase('admin.portal.show_facebook_like_button') }}</label>
			<label><input type="checkbox" name="settings[core.helpdesk_enabled]" {% if app.getSetting('core.helpdesk_enabled') %}checked="checked"{% endif %} /> {{ phrase('admin.portal.show_google_1_button') }}</label>
			<label><input type="checkbox" name="settings[core.helpdesk_enabled]" {% if app.getSetting('core.helpdesk_enabled') %}checked="checked"{% endif %} /> {{ phrase('admin.portal.show_addthis_widget') }}</label>
		</div>
	</div>
</div>

<footer class="setting_field_row" style="text-align: center">
	<button class="clean-white">{{ phrase('admin.general.save_settings') }}</button>
</footer>

{% endblock %}
