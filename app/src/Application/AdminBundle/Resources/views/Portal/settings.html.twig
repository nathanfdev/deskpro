{% set this_page = 'portal_settings' %}
{% extends 'AdminBundle::layout.html.twig' %}
{% block pagetitle %}
	<h1>{{ phrase('admin.portal.portal_settings') }}</h1>
{% endblock %}
{% block page %}
<div class="setting_field_row">
	<h4>{{ phrase('admin.portal.commenting') }}</h4>
	<div class="setting_fields">
		<div class="field_row">
			<label><input type="checkbox" name="settings[core.helpdesk_enabled]" {% if app.getSetting('core.helpdesk_enabled') %}checked="checked"{% endif %} />
				{{ phrase('admin.portal.allow_users_to_submit_comments') }}</label>
			<label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<input type="checkbox" name="settings[core.helpdesk_enabled]" {% if app.getSetting('core.helpdesk_enabled') %}checked="checked"{% endif %} />
				{{ phrase('admin.portal.comment_disable_anonymous') }}</label>
			<label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<input type="checkbox" name="settings[core.helpdesk_enabled]" {% if app.getSetting('core.helpdesk_enabled') %}checked="checked"{% endif %} />
				{{ phrase('admin.portal.comment_require_email_validation') }}</label>
			<label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<input type="checkbox" name="settings[core.helpdesk_enabled]" {% if app.getSetting('core.helpdesk_enabled') %}checked="checked"{% endif %} />
				{{ phrase('admin.portal.comment_require_validation') }}</label>
			<label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<input type="checkbox" name="settings[core.helpdesk_enabled]" {% if app.getSetting('core.helpdesk_enabled') %}checked="checked"{% endif %} />
				{{ phrase('admin.portal.comment_use_captcha') }}</label>
		</div>
		<div class="field_row">
			<label><input type="checkbox" name="settings[core.helpdesk_enabled]" {% if app.getSetting('core.helpdesk_enabled') %}checked="checked"{% endif %} />
				{{ phrase('admin.portal.allow_users_to_rate_content') }}</label>
			<label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<input type="checkbox" name="settings[core.helpdesk_enabled]" {% if app.getSetting('core.helpdesk_enabled') %}checked="checked"{% endif %} />
			{{ phrase('admin.portal.show_ratings') }}</label>
		</div>
	</div>
</div>

<div class="setting_field_row">
	<h4>{{ phrase('admin.portal.integrations') }}</h4>
	<div class="setting_fields">
		<div class="field_row">
			<label><input type="checkbox" name="settings[core.helpdesk_enabled]" {% if app.getSetting('core.helpdesk_enabled') %}checked="checked"{% endif %} /> {{ phrase('admin.portal.show_facebook_like') }}</label>
			<label><input type="checkbox" name="settings[core.helpdesk_enabled]" {% if app.getSetting('core.helpdesk_enabled') %}checked="checked"{% endif %} /> {{ phrase('admin.portal.show_google_plus_one') }}</label>
			<label><input type="checkbox" name="settings[core.helpdesk_enabled]" {% if app.getSetting('core.helpdesk_enabled') %}checked="checked"{% endif %} /> {{ phrase('admin.portal.show_addthis') }}</label>
		</div>
	</div>
</div>

<footer class="setting_field_row" style="text-align: center">
	<button class="clean-white">{{ phrase('admin.general.save_settings') }}</button>
</footer>

{% endblock %}
