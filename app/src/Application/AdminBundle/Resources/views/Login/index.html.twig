<!DOCTYPE HTML>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="robots" content="NOINDEX" />
	<meta http-equiv="X-UA-Compatible" content="IE=100" />
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
	<title>{{ phrase('agent.general.log_in') }}</title>
	<link rel="shortcut icon" id="favicon" href="{{ asset('images/admin/favicon-admin.png') }}" />
	<script type="text/javascript">
	if (typeof pageMeta !== 'undefined') pageMeta.goToLogin = true;
	</script>
	<script type="text/javascript" charset="utf-8" src="{{ asset('vendor/jquery/jquery.min.js') }}"></script>

	<style type="text/css">
	body {
		background: #fff !important;
	}

	{% include 'DeskPRO:Common:admin-login.css.twig' %}

	{% if app.usersourceManager.getWithCapability('form_login') %}
	#dp_login dt { width: 120px; }
	{% endif %}
	</style>
</head>
<body>

<form action="{{ path('admin_login_authenticate_local') }}" method="post">
	<input type="hidden" name="agent_login" value="1" />
	{% if return %}<input type="hidden" name="return" value="{{return}}" />{% endif %}

	<div id="dp_login">
		<div class="msg-outer">
			<div class="msg">
				<h1>{{ phrase('agent.general.log_in') }}</h1>
				{% if failed_login_name %}<p class="error">{{ phrase('agent.login.login_failed') }}</p>{% endif %}
				{% if has_logged_out %}<p class="okay">{{ phrase('agent.login.has_logged_out') }}</p>{% endif %}
				<dl>
					<dt>
						{{ phrase('agent.general.email') }}
						{% if app.usersourceManager.getWithCapability('form_login') %}/ Username{% endif %}
					</dt>
					{% if agent_session %}
						<dd>
							<cite style="background-image: url('{{ agent_session.person.getPictureUrl(30) }}')">{{ agent_session.person.getPrimaryEmailAddress() }}</cite>
							<input type="hidden" name="email" id="email" value="{{ agent_session.person.primary_email_address }}" />
						</dd>
					{% else %}
						<dd><input type="{% if app.usersourceManager.getWithCapability('form_login') %}text{% else %}email{% endif %}" class="text" value="{{ failed_login_name }}" name="email" id="email" size="40" tabindex="1" /></dd>
					{% endif %}

					<dt>{{ phrase('agent.general.password') }}</dt>
					<dd class="password">
						{% if app.isCloud %}
							<a class="agent" href="{{ app.request.getBaseUrl() }}/agent/login?lost">{{ phrase('agent.general.lost_qm') }}</a>
						{% else %}
							<a href="#" id="lost_link">{{ phrase('agent.general.lost_qm') }}</a>
						{% endif %}
						<input type="password" class="text" value="" name="password" id="password" size="40"  tabindex="2" />
						<div style="text-align: left; display: none;" id="lost_explain">
							To reset admin passwords, use the command-line utility:
							<div class="code">/path/to/php /path/to/deskpro/cmd.php dp:agents --reset-password</div>
						</div>
					</dd>

					<dt></dt>
					<dd class="btn"><button tabindex="3">{{ phrase('agent.general.log_in') }}</button></dd>
				</dl>

				<br class="clear" />
			</div>
		</div>
		<a href="http://www.deskpro.com/" id="dp_logo">{{ phrase('agent.general.deskpro') }}</a>
	</div>
</form>

<script type="text/javascript">
var el = document.getElementById('email');
if (el) {
	el.focus();
}

$('#lost_link').on('click', function(ev) {
	ev.preventDefault();
	$('#lost_explain').slideToggle();
});
</script>
</body>
</html>
