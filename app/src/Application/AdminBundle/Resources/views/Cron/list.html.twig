{% extends 'AdminBundle::layout.html.twig' %}
{% block pagebar %}
	<nav>
		<ul>
			<li><a href="{{ path('admin_server_cron_logs') }}">{{ phrase('admin.cron.view_logs') }}</a></li>
		</ul>
	</nav>
	<ul>
		<li>{{ phrase('admin.global.scheduled_tasks') }}</li>
	</ul>
{% endblock %}
{% block page %}
<div class="check-grid item-list">
	<table width="100%">
		<thead>
			<tr>
				<th style="text-align:left">&nbsp; {{ phrase('admin.cron.task') }}</th>
				<th style="text-align:center" width="80">{{ phrase('admin.cron.interval') }}</th>
				<th style="text-align:center" width="185">{{ phrase('admin.cron.last_run') }}</th>
				<th style="text-align:center" width="185">{{ phrase('admin.cron.next_run') }}</th>
			</tr>
		</thead>
		<tbody>
			{% for job in jobs %}
				<tr>
					<td>{{ job.title }}</td>
					<td style="text-align:center">{{ job.interval_readable }}</td>
					<td style="text-align:center">
						{% if job.last_run_date %}{{ job.last_run_date|date('Y-m-d H:i:s') }}{% else %}{{ phrase('agent.never') }}{% endif %}
					</td>
					<td style="text-align:center">
						{{ job.next_run_date|date('Y-m-d H:i:s') }}
					</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
</div>
{% endblock %}
