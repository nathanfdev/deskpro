<form action="{{ path('agent_publish_search') }}">
	<ul class="property-list">
		<li class="search-input">
			<label>{{ phrase('agent.main.search') }}</label>
			<div class="values">
				<input type="text" name="query" />
				<br />
				{{ phrase('agent.main.search_in_types') }}
				<select name="types">
					<option value="">{{ phrase('agent.main.all') }}</option>
					<option value="article">{{ phrase('agent.main.articles') }}</option>
					<option value="download">{{ phrase('agent.main.downloads') }}</option>
					<option value="feedback">{{ phrase('agent.main.feedback') }}</option>
					<option value="news">{{ phrase('agent.main.news') }}</option>
				</select>
			</div>
		</li>
	</ul>
	<br class="clear" />
</form>
