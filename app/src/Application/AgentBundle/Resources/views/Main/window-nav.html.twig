<!-- BEGIN NAVIGATION -->
<div id="dp_nav">
	<div id="dp_nav_sections" class="deskproPane">
		<ul>
			{% if app.user.hasPerm('agent_tickets.use') %}
				<li class="dpNavActive" id="tickets_section" data-section-handler="DeskPRO.Agent.WindowElement.Section.Tickets">
					<div class="count-badge navCounterRed" style="display: none"><span></span></div>
					<a><span class="ticketNavIcon">{{ phrase('agent.general.tickets') }}</span></a>
				</li>
			{% endif %}

			{% if app.getSetting('core.apps_chat') and app.user.hasPerm('agent_chat.use') %}
				<li  id="chat_section" data-section-handler="DeskPRO.Agent.WindowElement.Section.UserChat">
					<div class="count-badge navCounterRed" style="display: none"><span></span></div>
					<a><span class="chatNavIcon">{{ phrase('agent.general.chat') }}</span></a>
				</li>
			{% endif %}

			<li id="people_section" data-section-handler="DeskPRO.Agent.WindowElement.Section.People">
				<div class="count-badge navCounterRed" style="display: none"><span></span></div>
				<a><span class="peopleNavIcon">{{ phrase('agent.general.people') }}</span></a>
			</li>

			{% if app.getSetting('core.apps_feedback')  %}
				<li id="feedback_section" data-section-handler="DeskPRO.Agent.WindowElement.Section.Feedback">
					<div class="count-badge navCounterRed" style="display: none"><span></span></div>
					<a><span class="feedbackNavIcon">{{ phrase('agent.general.feedback') }}</span></a>
				</li>
			{% endif %}

			{% if app.getSetting('core.apps_kb') or app.getSetting('core.apps_news') or app.getSetting('core.apps_downloads') %}
				<li id="publish_section" data-section-handler="DeskPRO.Agent.WindowElement.Section.Publish">
					<div class="count-badge navCounterRed" style="display: none"><span></span></div>
					<a><span class="publishNavIcon">{{ phrase('agent.general.publish') }}</span></a>
				</li>
			{% endif %}

			{% if app.getSetting('core.apps_tasks')  %}
				<li id="tasks_section" data-section-handler="DeskPRO.Agent.WindowElement.Section.Tasks">
					<div class="count-badge navCounterRed" style="display: none"><span></span></div>
					<a><span class="tasksNavIcon">{{ phrase('agent.general.tasks') }}</span></a>
				</li>
			{% endif %}
		</ul>
		<div id="agent_chat_section" data-section-handler="DeskPRO.Agent.WindowElement.Section.AgentChat" class="no-click-switch">
			<span id="chat_online_count">0</span>
		</div>
	</div>

	{% if app.getSetting('core.disable_dpcom_newticket') %}
		<a id="submit_beta_feedback" href="http://helpdesk.deskpro.com/" target="_blank"></a>
	{% endif %}
</div>
<!-- END NAVIGATION -->
