<div class="dp-omnibox" ng-class="{'is-active': isActive}" dp-omnibox>
	<div class="input-area">
		<i class="fa fa-search"></i>
		<div class="input-wrap">
			<input type="text" ng-model="searchQuery" ng-change="touchSearch()" />
		</div>
	</div>
	<div class="dp-omnibox-results" style="display: none;">
		<div ng-show="isMainLoading" style="text-align: center;">
			<i class="spinner-circle-32"></i>
		</div>
		<div ng-show="!isMainLoading">
			<section ng-repeat="group in resultGroups" class="result-group">
				<header>{{ ng_var('group.title') }}</header>
				<article>
					<div class="list-listing">
						<div ng-repeat="result in group.results">
							<script type="text/plain" dp-tpl tpl-id="dp_search_list_row">
								{% include 'AgentBundle:Main:window-header-searchbox-result.html.twig' %}
							</script>
						</div>
					</div>
				</article>
			</section>
		</div>
	</div>
</div>