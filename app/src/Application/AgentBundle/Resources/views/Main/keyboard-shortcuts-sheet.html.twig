<div id="dp_keyboard_shortcuts" style="display: none">
	<header>
		<span class="close"></span>
		<em>Keyboard Shortcuts</em>
	</header>
	<article>
		<table cellspacing="0" cellpadding="0" width="100%"><tr>
			<td width="40%">
				<h3>Creation</h3>
				<div class="row">
					<kbd>t</kbd> {{ phrase('agent.main.open_new_ticket_form') }}
				</div>
				<div class="row">
					<kbd>p</kbd> {{ phrase('agent.main.open_new_person_form') }}
				</div>
				<div class="row">
					<kbd>o</kbd> {{ phrase('agent.main.open_new_organization_form') }}
				</div>
				<div class="row">
					<kbd>k</kbd> {{ phrase('agent.main.open_new_task_form') }}
				</div>
				<div class="row">
					<kbd>a</kbd> {{ phrase('agent.main.open_new_article_form') }}
				</div>
				<div class="row">
					<kbd>i</kbd> {{ phrase('agent.main.open_new_feedback_form') }}
				</div>
				<div class="row">
					<kbd>n</kbd> {{ phrase('agent.main.open_new_news_form') }}
				</div>
				<div class="row">
					<kbd>d</kbd> {{ phrase('agent.main.open_new_download_form') }}
				</div>
			</td>
			<td width="60%">
				<h3>{{ phrase('agent.main.window_navigation') }}</h3>
				<div class="row">
					<kbd>{{ phrase('agent.main.ctrlleft') }}</kbd> {{ phrase('agent.main.go_to_previous_tab') }}
				</div>
				<div class="row">
					<kbd>{{ phrase('agent.main.ctrlright') }}</kbd> {{ phrase('agent.main.go_to_next_tab') }}
				</div>
				<div class="row">
					<kbd>{{ phrase('agent.main.ctrlshiftc') }}</kbd> {{ phrase('agent.main.close_current_tab') }}
				</div>
				<div class="row">
					<kbd>{{ phrase('agent.main.up_or_down') }}</kbd> When in a filter listing, moves selected row cursor
				</div>
				<div class="row">
					<kbd>enter</kbd> When in a filter listing, opens the selected row
				</div>
				<div class="row">
					<kbd>space</kbd> When in a filter listing, checks the checkbox on the select row
				</div>

				<h3>{{ phrase('agent.main.tickets') }}</h3>
				<div class="row">
					<kbd>shit+r</kbd> {{ phrase('agent.main.focus_reply_box') }}
				</div>
			</td>
		</tr></table>
	</article>
</div>
