<div id="dp_keyboard_shortcuts" style="display: none">
	<header>
		<span class="close"></span>
		<em>{{ phrase('agent.interface.keyboard_shortcuts') }}</em>
	</header>
	<article>
		<table cellspacing="0" cellpadding="0" width="100%"><tr>
			<td width="40%">
				<h3>{{ phrase('agent.interface.creation') }}</h3>
				<div class="row">
					<kbd>{{ phrase('agent.interface.kbd_new_ticket') }}</kbd> {{ phrase('agent.interface.open_new_ticket_form') }}
				</div>
				<div class="row">
					<kbd>{{ phrase('agent.interface.kbd_new_person') }}</kbd> {{ phrase('agent.interface.open_new_person_form') }}
				</div>
				<div class="row">
					<kbd>{{ phrase('agent.interface.kbd_new_organisation') }}</kbd> {{ phrase('agent.interface.open_new_organization_form') }}
				</div>
				<div class="row">
					<kbd>{{ phrase('agent.interface.kbd_new_task') }}</kbd> {{ phrase('agent.interface.open_new_task_form') }}
				</div>
				<div class="row">
					<kbd>{{ phrase('agent.interface.kbd_new_article') }}</kbd> {{ phrase('agent.interface.open_new_article_form') }}
				</div>
				<div class="row">
					<kbd>{{ phrase('agent.interface.kbd_new_feedback') }}</kbd> {{ phrase('agent.interface.open_new_feedback_form') }}
				</div>
				<div class="row">
					<kbd>{{ phrase('agent.interface.kbd_new_news') }}</kbd> {{ phrase('agent.interface.open_new_news_form') }}
				</div>
				<div class="row">
					<kbd>{{ phrase('agent.interface.kbd_new_download') }}</kbd> {{ phrase('agent.interface.open_new_download_form') }}
				</div>
			</td>
			<td width="60%">
				<h3>{{ phrase('agent.window_navigation') }}</h3>
				<div class="row">
					<kbd>{{ phrase('agent.interface.kbd_ctrl_left') }}</kbd> {{ phrase('agent.interface.go_to_previous_tab') }}
				</div>
				<div class="row">
					<kbd>{{ phrase('agent.interface.kbd_ctrl_right') }}</kbd> {{ phrase('agent.interface.go_to_next_tab') }}
				</div>
				<div class="row">
					<kbd>{{ phrase('agent.interface.kbd_ctrl_shift_c') }}</kbd> {{ phrase('agent.interface.close_current_tab') }}
				</div>
				<div class="row">
					<kbd>{{ phrase('agent.interface.kbd_up_or_down') }}</kbd> {{ phrase('agent.filter_moves_cursor') }}
				</div>
				<div class="row">
					<kbd>{{ phrase('agent.interface.kbd_enter') }}</kbd> {{ phrase('agent.filter_opens_selected') }}
				</div>
				<div class="row">
					<kbd>{{ phrase('agent.interface.kbd_space') }}</kbd> {{ phrase('agent.filter_checks_selected') }}
				</div>

				<h3>{{ phrase('agent.tickets') }}</h3>
				<div class="row">
					<kbd>{{ phrase('agent.interface.kbd_shift_r') }}</kbd> {{ phrase('agent.focus_reply_box') }}
				</div>
			</td>
		</tr></table>
	</article>
</div>
