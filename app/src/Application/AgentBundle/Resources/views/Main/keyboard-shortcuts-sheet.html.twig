<div id="dp_keyboard_shortcuts" style="display: none">
	<header>
		<span class="close"></span>
		<em>Keyboard Shortcuts</em>
	</header>
	<article>
		<table cellspacing="0" cellpadding="0" width="100%"><tr>
			<td width="40%">
				<h3>Creation</h3>
				<div class="row">
					<kbd>t</kbd> Open new ticket form
				</div>
				<div class="row">
					<kbd>p</kbd> Open new person form
				</div>
				<div class="row">
					<kbd>o</kbd> Open new organization form
				</div>
				<div class="row">
					<kbd>k</kbd> Open new task form
				</div>
				<div class="row">
					<kbd>a</kbd> Open new article form
				</div>
				<div class="row">
					<kbd>i</kbd> Open new feedback form
				</div>
				<div class="row">
					<kbd>n</kbd> Open new news form
				</div>
				<div class="row">
					<kbd>d</kbd> Open new download form
				</div>
			</td>
			<td width="60%">
				<h3>Window Navigation</h3>
				<div class="row">
					<kbd>ctrl+left</kbd> Go to previous tab
				</div>
				<div class="row">
					<kbd>ctrl+right</kbd> Go to next tab
				</div>
				<div class="row">
					<kbd>ctrl+shift+c</kbd> Close current tab
				</div>
				<div class="row">
					<kbd>up or down</kbd> When in a filter listing, moves selected row cursor
				</div>
				<div class="row">
					<kbd>enter</kbd> When in a filter listing, opens the selected row
				</div>
				<div class="row">
					<kbd>space</kbd> When in a filter listing, checks the checkbox on the select row
				</div>

				<h3>Tickets</h3>
				<div class="row">
					<kbd>shit+r</kbd> Focus reply box
				</div>
			</td>
		</tr></table>
	</article>
</div>
