<div id="dp_keyboard_shortcuts" style="display: none">
	<header>
		<span class="close"></span>
		<em>{{ phrase('agent.pages.keyboard_shortcuts') }}</em>
	</header>
	<article>
		<table cellspacing="0" cellpadding="0" width="100%"><tr>
			<td width="40%">
				<h3>{{ phrase('agent.pages.creation') }}</h3>
				<div class="row">
					<kbd>{{ phrase('agent.pages.kbd_new_ticket') }}</kbd> {{ phrase('agent.pages.open_new_ticket_form') }}
				</div>
				<div class="row">
					<kbd>{{ phrase('agent.pages.kbd_new_person') }}</kbd> {{ phrase('agent.pages.open_new_person_form') }}
				</div>
				<div class="row">
					<kbd>{{ phrase('agent.pages.kbd_new_organisation') }}</kbd> {{ phrase('agent.pages.open_new_organization_form') }}
				</div>
				<div class="row">
					<kbd>{{ phrase('agent.pages.kbd_new_task') }}</kbd> {{ phrase('agent.pages.open_new_task_form') }}
				</div>
				<div class="row">
					<kbd>{{ phrase('agent.pages.kbd_new_article') }}</kbd> {{ phrase('agent.pages.open_new_article_form') }}
				</div>
				<div class="row">
					<kbd>{{ phrase('agent.pages.kbd_new_feedback') }}</kbd> {{ phrase('agent.pages.open_new_feedback_form') }}
				</div>
				<div class="row">
					<kbd>{{ phrase('agent.pages.kbd_new_news') }}</kbd> {{ phrase('agent.pages.open_new_news_form') }}
				</div>
				<div class="row">
					<kbd>{{ phrase('agent.pages.kbd_new_download') }}</kbd> {{ phrase('agent.pages.open_new_download_form') }}
				</div>
			</td>
			<td width="60%">
				<h3>{{ phrase('agent.window_navigation') }}</h3>
				<div class="row">
					<kbd>{{ phrase('agent.pages.ctrlleft') }}</kbd> {{ phrase('agent.pages.go_to_previous_tab') }}
				</div>
				<div class="row">
					<kbd>{{ phrase('agent.pages.ctrlright') }}</kbd> {{ phrase('agent.pages.go_to_next_tab') }}
				</div>
				<div class="row">
					<kbd>{{ phrase('agent.pages.ctrlshiftc') }}</kbd> {{ phrase('agent.pages.close_current_tab') }}
				</div>
				<div class="row">
					<kbd>{{ phrase('agent.pages.up_or_down') }}</kbd> {{ phrase('agent.when_in_a_filter_listing_moves_selected_row') }}
				</div>
				<div class="row">
					<kbd>{{ phrase('agent.pages.enter') }}</kbd> {{ phrase('agent.when_in_a_filter_listing_opens_the_selected') }}
				</div>
				<div class="row">
					<kbd>{{ phrase('agent.pages.space') }}</kbd> {{ phrase('agent.when_in_a_filter_listing_checks_the_checkbox') }}
				</div>

				<h3>{{ phrase('agent.tickets') }}</h3>
				<div class="row">
					<kbd>{{ phrase('agent.pages.shiftr') }}</kbd> {{ phrase('agent.focus_reply_box') }}
				</div>
			</td>
		</tr></table>
	</article>
</div>
