<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="robots" content="noindex,nofollow" />
	<meta http-equiv="X-UA-Compatible" content="IE=Edge" />

	<script type="text/javascript">
		{% if constant('DP_DEBUG') %}
			DP_DEBUG = true;
		{% else %}
			DP_DEBUG = false;
		{% endif %}
	</script>

	{% if app.getSetting('core.favicon_blob_id') %}
		<link rel="shortcut icon" id="favicon" href="{{ path('favicon', {}, true) }}" />
	{% else %}
		<link rel="shortcut icon" id="favicon" href="{{ app.getRequest().getBasePath() }}/favicon.ico" />
	{% endif %}

	<title>{{ phrase('agent.interface.deskpro_agent_interface') }}</title>
	<style type="text/css">
	body {
		overflow: hidden;
		background: #fff !important;
	}
	#agent_chats_wrapper, #agent_chat_panel {
		display: none;
	}

	#dp_loading {
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		left: 0;
		z-index: 1000000000;

		background-color: #DFE5EB;
		background: rgb(158,166,175); /* Old browsers */
		background: -moz-linear-gradient(top, rgba(158,166,175,1) 0%, rgba(213,218,224,1) 15%, rgba(223,229,235,1) 100%); /* FF3.6+ */
		background: -webkit-gradient(linear, left top, left bottom, color-stop(0%,rgba(158,166,175,1)), color-stop(15%,rgba(213,218,224,1)), color-stop(100%,rgba(223,229,235,1))); /* Chrome,Safari4+ */
		background: -webkit-linear-gradient(top, rgba(158,166,175,1) 0%,rgba(213,218,224,1) 15%,rgba(223,229,235,1) 100%); /* Chrome10+,Safari5.1+ */
		background: -o-linear-gradient(top, rgba(158,166,175,1) 0%,rgba(213,218,224,1) 15%,rgba(223,229,235,1) 100%); /* Opera11.10+ */
		background: -ms-linear-gradient(top, rgba(158,166,175,1) 0%,rgba(213,218,224,1) 15%,rgba(223,229,235,1) 100%); /* IE10+ */
		filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#9ea6af', endColorstr='#dfe5eb',GradientType=0 ); /* IE6-9 */
		background: linear-gradient(top, rgba(158,166,175,1) 0%,rgba(213,218,224,1) 15%,rgba(223,229,235,1) 100%); /* W3C */
		text-align: center;
	}

	#dp_loading .msg-outer {
		-webkit-border-radius: 4px;
		-moz-border-radius: 4px;
		border-radius: 4px;

		width: 250px;

		margin: 250px auto 0 auto;

		-webkit-box-shadow: 1px 1px 6px 1px rgba(50, 50, 50, 0.6);
		-moz-box-shadow: 1px 1px 6px 1px rgba(50, 50, 50, 0.6);
		box-shadow: 1px 1px 6px 1px rgba(50, 50, 50, 0.6);

		border: 1px solid #C3CEE1;
	}

	#dp_loading .msg {
		-webkit-border-radius: 3px;
		-moz-border-radius: 3px;
		border-radius: 3px;
		background-color: #fff;

		border: 1px solid #6B7A9F;

		-webkit-box-shadow: inset 0px 0px 4px 1px rgba(50, 50, 50, 0.3);
		-moz-box-shadow: inset 0px 0px 4px 1px rgba(50, 50, 50, 0.3);
		box-shadow: inset 0px 0px 4px 1px rgba(50, 50, 50, 0.3);

		padding:  20px;
	}

	#dp_loading h1 {
		font-family: 'Myriad Pro', 'Myriad', helvetica, arial, sans-serif;
		font-size: 15px;
		text-align: left;
		color: #000;

		display: inline-block;
		text-align: center;

		background: url({{ asset('images/spinners/page-loading.gif') }}) no-repeat 0 0;
		line-height: 35px;

		margin: 0;
		padding: 0;
		padding-left: 48px;

		height: 35px;
	}

	{# Agent links that are us dont appear clickable #}
	.agent-link[data-agent-id="{{ app.user.id }}"]:hover, .agent-link[data-agent-id="0"]:hover {
		text-decoration: none;
		cursor: text;
	}
	</style>
</head>
<body class="{% if is_demo %}is-demo{% endif %}">
<div id="dp_loading"><div class="msg-outer"><div class="msg"><h1>{{ phrase('agent.general.loading_interface') }}</h1></div></div></div>
<div id="dp_window">

{% include 'AgentBundle:Main:window-header.html.twig' %}
{% include 'AgentBundle:Main:window-nav.html.twig' %}
{% include 'AgentBundle:Main:window-col-layout.html.twig' %}
{% include 'AgentBundle:Main:window-chat.html.twig' %}

{####################
 # RESOURCE LOADING
 ####################}

{% include 'AgentBundle:Main:global-templates.html.twig' %}

</div>{# /dp_window #}

<audio preload="preload">
	<source src="{{ asset('/sounds/new-chat.mp3') }}" />
	<source src="{{ asset('/sounds/new-chat.ogg') }}" />
</audio>
<div id="volume_controls_back"></div>
<div id="volume_controls">
	<div class="slider"></div>
	<span class="mute-toggle" id="sound_icon_in" class="tipped" title="{{ phrase('agent.interface.toggle_mute') }}"></span>
</div>

{% include 'AgentBundle:Main:resources.html.twig' %}
{% include 'AgentBundle:Settings:settings-window.html.twig' %}
{% include 'AgentBundle:MediaManager:media-window.html.twig' %}

{% if js_debug.devbar %}
	<div id="dp_devbar">
		<a class="reload-active-tab">{{ phrase('agent.general.reload_active_tab') }}</a>
	</div>
	<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Agent/devbar.js') }}"></script>
{% endif %}

{% include 'AgentBundle:Main:page-init.html.twig' %}

<div id="reload_overlay" style="display: none;">
	<table cellspacing="0" cellpadding="0" width="100%" height="100%"><tr><td width="100%" height="100%" valign="middle" align="center" style="vertical-align: middle; text-align: center">
		<article>
			<h3>{{ phrase('agent.general.please_wait') }}</h3>
		</article>
	</table>
</div>

<div id="dp_submit_feedback" data-element-handler="DeskPRO.Agent.ElementHandler.DeskproSubmitFeedback" style="display: none;">
	<em class="close-trigger"></em>
	<form action="{{ path('agent_submit_deskpro_feedback') }}" method="post">
		<article>
			<p>
				We want to hear about your experience with DeskPRO v4.
			</p>
			<div class="text-wrapper">
				<textarea name="message"></textarea>
			</div>
		</article>
		<footer>
			<div class="is-not-loading">
				<button type="submit" class="clean-white">Send Feedback</button>
			</div>
			<div class="is-loading" style="padding-top: 9px;">
				<img src="{{ asset('images/spinners/loading-small-flat.gif') }}" />
			</div>
		</footer>
	</form>
</div>

</body>
</html>
