<!-- BEGIN HEADER BAR -->
<div id="dp_header">
	{# User Logo #}
	<div id="dp_header_user">
		<div class="button-wrap" id="userSetting_trigger">
			<h1>
				<cite style="background-image: url({{ app.user.getPictureUrl(24) }});"></cite>
				<span class="drop"></span>
			</h1>
		</div>
	</div>
	<!-- Header - User Control Dropdown -->
	<div id="userSetting" style="display:none;">
		<div class="userProfileDropdown" >
			<div class="userProfileDropdownHeader">
				<a><em style="background-image: url({{ app.user.getPictureUrl(24) }});"></em></a>
				<span class="drop"></span>
			</div>
			<ul>
				<li class="currentUsername"><p>{{ app.user.display_name }}</p></li>
				<li class="setting with-sub" id="user_settings_link"><a>{{ phrase('agent.general.settings') }}</a></li>
				<li class="sub" id="user_settings_link_profile"><a>Profile</a></li>
				{% if app.user.getPermissionsManager().get('GeneralChecker').canSetSignature() %}<li class="sub" id="user_settings_link_signature"><a>{{ phrase('agent.settings.signature') }}</a></li>{% endif %}
				<li class="sub" id="user_settings_link_ticketnotify"><a>Ticket Notifications</a></li>
				<li class="sub" id="user_settings_link_othernotify"><a>Other Notifications</a></li>
				<li class="sub" id="user_settings_link_macros"><a>Macros</a></li>
				<li class="sub" id="user_settings_link_filters"><a>Filters</a></li>
				<li class="sub last" id="user_settings_link_snippets" data-snippet-viewer-url="{{ path('agent_ticket_snippetviewer', {'ticket_id': 0}) }}"><a>Snippets</a></li>
				<li class="help"><a href="http://support.deskpro.com/">{{ phrase('agent.general.help') }}</a></li>
				<li class="logout"><a href="{{ path('user_logout', {'auth': static_security_token('user_logout', 0)}) }}?to=agent">{{ phrase('agent.general.log_out') }}</a></li>
			</ul>
		</div>
	</div>

	<!-- BEGIN NOTIFICATION SECTION -->
	<div id="DP-NotificationSection">
		<div id="chatStatusWrap">
			<div class="well">
				<em>
					<span id="chatOnlineCount">1</span>
				</em>
			</div>
		</div>
		<div id="agent_status_menu" style="display:none;">
			<div class="notifDropdown">
				<div class="notifHead">
					<em>
						<span id="chatOnlineCount2">1</span>
					</em>
				</div>
				<div id="agent_status_menu_body">
					<ul>
						<li id="agent_status_menu_onlinerow">
							<div class="avatar" style="background-image: url({{ app.user.getPictureUrl(30) }});"></div>
							You are currently available for chat.
							<button class="clean-white toggle-status-trigger">Sign out of chat</button>
						</li>
						<li id="agent_status_menu_offlinerow" style="display: none;">
							<div class="avatar" style="background-image: url({{ app.user.getPictureUrl(30) }});"></div>
							You are currently away from chat.
							<button class="clean-white toggle-status-trigger">Sign in to chat</button>
						</li>
					</ul>

					<div class="online-list" id="agent_status_menu_onlinelist">
						<h6>Other agents online for chat</h6>
						<ul class="list">
							{% for agent in agents if agent.id != app.user.id %}
								<li
									class="agent-{{ agent.id }} {% if agent.id in userchat_online_agent_ids %}online-now{% endif %}"
									style="{% if agent.id == app.user.id %}display: none;{% endif %}"
								>
									<div class="avatar" style="background-image: url({{ agent.getPictureUrl(30) }});"></div>
									{{ agent.display_name }}
								</li>
							{% endfor %}
						</ul>
					</div>
				</div>
			</div>
		</div>
		<div id="notificationWrap" class="left">
			<div class="notifications" id="dp_notif_bed">
				<div class="notifMail notif-item notif-tickets"><span class="counter">0</span></div>
				{#<div class="notifChat notif-item notif-chat"><span class="counter">0</span></div>#}
				<div class="notifFeedback notif-item notif-feedback"><span class="counter">0</span></div>
				<div class="notifTask notif-item notif-tasks"><span class="counter">0</span></div>
			</div>
		</div>
	</div>
	<div id="notificationDropdown" style="display:none;">
		<div class="notifDropdown">
			<div class="notifHead">
				<div class="notifMail notif-item notif-tickets"><span class="counter">0</span></div>
				{#<div class="notifChat notif-item notif-chat"><span class="counter">0</span></div>#}
				<div class="notifFeedback notif-item notif-feedback"><span class="counter">0</span></div>
				<div class="notifTask notif-item notif-tasks"><span class="counter">0</span></div>
			</div>
			<div id="dp_notify_list_wrap">
				<ul id="dp_notify_list">
					<li id="dp_notify_list_none">
						<article><em>{{ phrase('agent.interface.notifs_appear_here') }}</em></article>
						<a>{{ phrase('agent.general.change_notif_settings') }}</a>
					</li>
					<li class="dismissAll" id="dp_notify_list_dismiss" style="display: none">
						<a>{{ phrase('agent.interface.dismiss_notifications') }}</a>
					</li>
				</ul>
			</div>
		</div>
	</div>
	<!-- END NOTIFICATION SECTION -->
	<!-- BEGIN SEARCH SECTION -->
	<div id="dp_omnibox_wrap">
		<div id="dp_omnibox">
			<div class="searchBoxWrap" id="dp_omniinput_wrap">
				<div class="type-icon">
					<span class="icon"></span>
				</div>
				<input type="text" id="dp_omniinput" size="4" placeholder="{{ phrase('agent.general.search') }}" data-element-handler="DeskPRO.Agent.ElementHandler.OmniQuickSearch" />
			</div>
		</div>
		<div id="dp_omnibox_adv">
			<a><span class="plusIcon">
				<i></i>
			</span></a>
		</div>
	<!-- END SEARCH SECTION -->
	</div>
	<!-- BEGIN CREATE SECTION -->
	<div id="DP-CreateSection">
		<div class="DP-createTicket">
			<div id="createContentTrigger" class="newContent">
				<a><span class="plusIcon">{{ phrase('agent.general.create') }}</span></a>
			</div>
		</div>
		<!-- Header - Create Ticket Dropdown on click -->
		<div id="createTicketToggle" style="display:none;">
			<div class="createHeader">
				<a>{{ phrase('agent.general.create') }}</a>
			</div>
			<div class="createDropdown">
				<ul class="createBtnPopups">
					{% if app.user.hasPerm('agent_tickets.create') %}
						<li id="create_ticket_btn"><a><span class="createTicket">{{ phrase('agent.general.new_ticket') }} <kbd>t</kbd></span></a></li>
					{% endif %}
					{% if app.user.hasPerm('agent_people.create') %}
						<li id="create_person_btn"><a><span class="createPerson">{{ phrase('agent.general.new_person') }} <kbd>p</kbd></span></a></li>
					{% endif %}
					{% if app.user.hasPerm('agent_org.create') %}
						<li id="create_organization_btn"><a><span class="createOrg">{{ phrase('agent.general.new_organization') }} <kbd>o</kbd></span></a></li>
					{% endif %}
					<li id="create_task_btn"><a><span class="createTask">{{ phrase('agent.general.new_task') }} <kbd>k</kbd></span></a></li>
					{% if app.user.hasPerm('agent_publish.create') %}
						<li id="create_article_btn"><a><span class="createArticle">{{ phrase('agent.general.new_article') }} <kbd>a</kbd></span></a></li>
						<li id="create_news_btn"><a><span class="createNews">{{ phrase('agent.interface.new_news') }} <kbd>n</kbd></span></a></li>
						<li id="create_download_btn"><a><span class="createDownload">{{ phrase('agent.general.new_download') }} <kbd>d</kbd></span></a></li>
						<li id="create_feedback_btn"><a><span class="createFeedback">{{ phrase('agent.general.new_feedback') }} <kbd>i</kbd></span></a></li>
					{% endif %}
					{% if app.getConfig('enable_twitter') and app.user.getTwitterAccountIds()|length %}
						<li id="create_tweet_btn"><a><span class="createTweet">Tweet <kbd>w</kbd></span></a></li>
					{% endif %}
				</ul>
			</div>
		</div>
	<!-- END CREATE SECTION -->
	</div>

	{# DeskPRO Logo #}
	<div id="dp_logo_wrap">
		<div class="button-wrap">
			<h1>
				{{ phrase('agent.general.deskpro') }}
				<span class="drop"></span>
			</h1>
		</div>
	</div>
	<div id="dp_logo_expand_wrap">
		<div class="dropdown-header">
			<h1>
				{{ phrase('agent.general.deskpro') }}
				<span class="drop"></span>
			</h1>
		</div>
		<div class="dropdown-content">
			<a href="http://www.deskpro.com/" target="_blank">{{ phrase('agent.interface.powered_by') }} <span>{{ phrase('agent.interface.deskpro_website_host') }}</span></a>
		</div>
	</div>

	<!-- BEGIN INTERFACE SECTION -->
	{% if app.user.can_admin or app.user.can_billing or app.user.can_reports or app.getSetting('user.portal_enabled') %}
	<div id="DP-InterfaceSwitcher">
		<div class="DP-adminSwitch">
			<div class="adminSwitcher">
				<a class="agent">{{ phrase('agent.general.agent_interface') }}<span class="dropdownIcon"></span></a>
			</div>
		</div>
		<!-- Header - Switch Button Interfaces- Dropdown -->
		<div id="interfacesToggle" style="display:none;">
		<div class="dropdownSwitcherWrap" >
			<div class="switcherHeader">
				<a class="agent"><span>{{ phrase('agent.general.agent_interface') }}</span></a>
			</div>
			<ul>
				{% if app.user.can_admin %}<li><a class="admin" href="{{ app.request.getBaseUrl() }}/admin/login?dpsid-agent={{ app.getSession().getId() }}"><span>{{ phrase('agent.general.admin_interface') }}</span></a></li>{% endif %}
				{% if app.user.can_billing %}<li><a class="billing" href="{{ app.request.getBaseUrl() }}/billing" style="margin-right: -3px;"><span class="check">{% if app.isCloud() %}{{ phrase('agent.general.billing_interface') }}{% else %}{{ phrase('agent.general.license_interface') }}{% endif %}</span></a></li>{% endif %}
				{% if app.user.can_reports %}<li><a class="reports" href="{{ app.request.getBaseUrl() }}/reports"><span>{{ phrase('agent.general.reports_interface') }}</span></a></li>{% endif %}
				{% if app.getSetting('user.portal_enabled') %}<li><a class="user" href="{{ app.request.getBaseUrl() }}/"><span>{{ phrase('agent.general.user_interface') }}</span></a></li>{% endif %}
			</ul>
		</div>
		</div>
	</div>
	{% endif %}
	<!-- END INTERFACE SECTION -->

	<!-- BEGIN STATUS SECTION -->
	<div id="DP-StatusSection">
		<div class="DP-adminStatus">
			<ul>
				<li class="networkStatIndicator" id="network_status_indicator">
					<a class="tipped" data-tipped="network_status_tip_wrap" data-tipped-options="inline:true, hook: 'bottommiddle'"></a>
					<div id="network_status_tip_wrap" style="display: none;"><div id='network_status_tip'>{{ phrase('agent.interface.network_status') }}<br /><div class='network-status-green'>{{ phrase('agent.interface.network_status_okay') }}</div><div class='network-status-red'>{{ phrase('agent.interface.network_status_bad') }}</div></div></div>
				</li>
				<li class="keyboardIcon">
					<a id="keyboard_shortcuts_trigger" class="tipped" title="{{ phrase('agent.interface.keyboard_shortcuts') }}" data-tipped-options="hook: 'bottommiddle'"></a>
				</li>
				<li class="soundIcon">
					<a class="tipped" id="sound_icon" title="{{ phrase('agent.interface.sound_explain') }}" data-tipped-options="hook: 'bottommiddle'"></a>
				</li>
			</ul>
		</div>
	</div>
	<!-- END STATUS SECTION -->
<!-- END HEADER BAR -->
</div>

<div id="dp_omniresults" style="display: none">
	<script type="text/x-deskpro-plain" id="dp_omniresults_section">
		<section class="section {TYPE} section-{TYPE}">
			<header>
				{TITLE}
				<span class="expand-btn"></span>
			</header>
			<article>
				<ul class="result-list"></ul>
			</article>
		</section>
	</script>
	<script type="text/x-deskpro-plain" id="dp_omniresults_result_row">
		<li class="result-item {TYPE}-{ID}"><span class="prop-id">{ID}</span> <label>{TITLE}</label></li>
	</script>
	<script type="text/x-deskpro-plain" id="dp_omniresults_result_row_twitter">
		<li class="result-item {TYPE} twitter-user-find" data-name="{TITLE}"><label>Find Twitter user {TITLE}...</label></li>
	</script>
</div>

<div id="dp_recent_list" style="display: none">
	<section class="section {TYPE} section-{TYPE}">
		<header>
			RECENTLY VIEWED
		</header>
		<article>
			<ul class="result-list"></ul>
		</article>
	</section>
	<script type="text/x-deskpro-plain" id="dp_recent_list_row">
		<li class="result-item {TYPE}-{ID}"><span class="prop-id">{ID}</span> <label>{TITLE}</label></li>
	</script>
</div>

<div id="dp_searchsheet" data-element-handler="DeskPRO.Agent.ElementHandler.OmniSearchSheet">
	<div class="header-section">
		<span id="omnisearch_reset">{{ phrase('agent.interface.reset_form') }}</span>
		<span class="close close-search-sheet"></span>
		<em>{{ phrase('agent.general.search') }}:</em>
		<ul>
			<li data-tab-for="#dp_searchsheet_tickets">{{ phrase('agent.general.tickets') }}</li>
			<li data-tab-for="#dp_searchsheet_people">{{ phrase('agent.general.people') }}</li>
			<li data-tab-for="#dp_searchsheet_orgs">{{ phrase('agent.general.organizations') }}</li>
			<li data-tab-for="#dp_searchsheet_content">{{ phrase('agent.general.publish_and_feedback') }}</li>
		</ul>
	</div>

	{# Ticket Search Form #}
	<div class="sheet-section" id="dp_searchsheet_tickets" data-type="tickets">
		{% include 'AgentBundle:Main:search-sheet-tickets.html.twig' %}
	</div>
	{# /Ticket Search Form #}

	{# People Search Form #}
	<div class="sheet-section" id="dp_searchsheet_people" data-type="people">
		{% include 'AgentBundle:Main:search-sheet-people.html.twig' %}
	</div>
	{# /People Search Form #}

	{# Orgs Search Form #}
	<div class="sheet-section" id="dp_searchsheet_orgs" data-type="orgs">
		{% include 'AgentBundle:Main:search-sheet-orgs.html.twig' %}
	</div>
	{# /Orgs Search Form #}

	{# Content Search Form #}
	<div class="sheet-section" id="dp_searchsheet_content" data-type="content">
		{% include 'AgentBundle:Main:search-sheet-content.html.twig' %}
	</div>
	{# /Content Search Form #}

	<div class="footer-section">
		<button id="omnisearch_submit">{{ phrase('agent.general.search') }}</button>
	</div>
</div>

{% include 'AgentBundle:Main:keyboard-shortcuts-sheet.html.twig' %}