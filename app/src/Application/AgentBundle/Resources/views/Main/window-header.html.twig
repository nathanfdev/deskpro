<div id="dp_header">

	{##########################################################################}
	{# User Profile #}
	{##########################################################################}

	<div class="user-profile pull-left">
		<img class="gravatar pull-left" src="{{ app.user.getPictureUrl(30) }}">
		<div class="username">{{ phrase('agent.chrome.hello-user', {name: app.user.name}) }}</div>
		<ul class="nav-profile">
			<li id="user_settings_link"><i class="icon-cog"></i> <a>{{ phrase('agent.chrome.link_settings') }}</a></li>
			<li><i class="icon-question-sign"></i> <a>{{ phrase('agent.chrome.link_help') }}</a></li>
			<li onclick="window.location='{{ path('user_logout', {'auth': static_security_token('user_logout', 0)}) }}?to=agent'; return false;"><i class="icon-signout"></i> <a>{{ phrase('agent.chrome.link_logout') }}</a></li>
		</ul>
	</div>

	{##########################################################################}
	{# Chat #}
	{##########################################################################}

	<div class="btn-group-chat pull-left">
		<a class="btn" id="dp_header_userchat_btn">
			<div class="chat-big-icon pull-left"></div>
				<span class="status">
					<span class="dp-phrase dp-phrase-on agent_chrome_chat_logged_in">{{ phrase('agent.chrome.chat_logged_in') }}</span>
					<span class="dp-phrase agent_chrome_chat_logged_out">{{ phrase('agent.chrome.chat_logged_out') }}</span>
				</span>
			<ul class="info">
				<li><i class="icon-user"></i> {{ phrase('agent.chrome.chat_online-agents', {}, true) }}</li>
				<li><i class="icon-group"></i> {{ phrase('agent.chrome.chat_online-users', {}, true) }}</li>
			</ul>
			<div class="arrow">
				<span class="caret"></span>
			</div>
		</a>

		{####################}
		{# Chat #}
		{####################}
		<div class="dp-header-group-chat-dropdown" id="dp_header_userchat_dropdown">
			<table class="layout-table" width="100%"><tbody><tr>
				<td class="column1" id="agent_status_menu_onlinelist">
					<div id="agent_status_menu_me_list">
					<div class="dp-not-loading">
						<div class="avatar" style="background-image: url({{ app.user.getPictureUrl(30) }});"></div>
						<a class="signin trigger-toggle-status">
							<span class="dp-phrase dp-phrase-on agent_chrome_chat_sign-in">{{ phrase('agent.chrome.chat_sign-in') }}</span>
							<span class="dp-phrase agent_chrome_chat_sign-out">{{ phrase('agent.chrome.chat_sign-out') }}</span>
							&rarr;
						</a>
					</div>
					<div class="dp-is-loading pull-center">
						<i class="spinner-flat"></i>
					</div>
				</div>
				<ul class="agents list">
					<li class="header">
						<a href="#" class="agents-list-groupdep">{{ phrase('agent.chrome.chat_list_by-department') }}</a>
						{{ phrase('agent.chrome.chat_list_agents-online', {}, true) }}
					</li>
				</ul>
				<ul class="agents list department-grouped" style="display: none;">
					{% for id,title in app.getDataRepository('Department').getFullNames('chat') %}
						<li class="dep dep-{{ id }}">
							<h4>{{ title }}</h4>
							<ul class="sub-list"></ul>
						</li>
					{% endfor %}
				</ul>
					<ul class="agents list normal">
						{% for agent in agents %}
							<li
								data-department-ids="{{ agent_chat_depmap[agent.id]|join(',') }}"
								class="agent agent-{{ agent.id }} {% if agent.id in userchat_online_agent_ids %}online-now{% endif %}"
							>
								<div class="avatar" style="background-image: url({{ agent.getPictureUrl(16) }});"></div>
								{{ agent.display_name }}
							</li>
						{% endfor %}
					</ul>
				</td>
				<td class="column2" id="agent_status_online_users">
					{% include 'AgentBundle:UserTrack:header-table.html.twig' %}
				</td>
			</tr></tbody></table>
		</div>
	</div>

	<div class="btn-group-actions pull-left">
		<div class="btn-wrap create-group pull-left">
			<a class="btn"><i class="icon-plus"></i> {{ phrase('agent.chrome.btn_create') }}</a>
				<ul class="btn-menu">
					<li id="create_ticket_btn"><a><div class="wrap"><i class="icon-envelope"></i></div>{{ phrase('agent.chrome.create_new-ticket') }} <kbd>t</kbd></a></li>
					<li id="create_person_btn"><a><div class="wrap"><i class="icon-user"></i></div>{{ phrase('agent.chrome.create_new-person') }} <kbd>p</kbd></a></li>
					<li id="create_organization_btn"><a><div class="wrap"><i class="icon-group"></i></div>{{ phrase('agent.chrome.create_new-organization') }} <kbd>o</kbd></a></li>
					<li id="create_task_btn"><a><div class="wrap"><i class="icon-edit"></i></div>{{ phrase('agent.chrome.create_new-task') }} <kbd>k</kbd></span></a></li>
					<li id="create_article_btn"><a><div class="wrap"><i class="icon-file-alt"></i></div>{{ phrase('agent.chrome.create_new-article') }} <kbd>a</kbd></a></li>
					<li id="create_news_btn"><a><div class="wrap"><i class="icon-book"></i></div>{{ phrase('agent.chrome.create_new-news') }} <kbd>n</kbd></span></a></li>
					<li id="create_download_btn"><a><div class="wrap"><i class="icon-download"></i></div>{{ phrase('agent.chrome.create_new-download') }} <kbd>d</kbd></a></li>
					<li id="create_feedback_btn" class="last"><a><div class="wrap"><i class="icon-lightbulb"></i></div>{{ phrase('agent.chrome.create_new-feedback') }} <kbd>i</kbd></a></li>
				</ul>
		</div>
		<div class="btn-wrap pull-left"><a class="btn"><i class="icon-rotate-left"></i> {{ phrase('agent.chrome.btn_recent') }}</a></div>
	</div>

