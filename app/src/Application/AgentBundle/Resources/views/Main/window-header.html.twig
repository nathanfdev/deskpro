<!-- BEGIN HEADER BAR -->
<div id="dp_header">
	<div id="dp_logo_wrap">
		<div class="button-wrap">
			<h1>
				DeskPRO
				<span class="drop"></span>
			</h1>
		</div>
	</div>
	<div id="dp_logo_expand_wrap">
		<div class="dropdown-header">
			<h1>
				DeskPRO
				<span class="drop"></span>
			</h1>
		</div>
		<div class="dropdown-content">
			<a href="http://www.deskpro.com/" target="_blank">Powered by <span>www.deskpro.com</span></a>
		</div>
	</div>
	<!-- BEGIN NOTIFICATION SECTION -->
	<div id="DP-NotificationSection">
		<div id="notificationWrap" class="left">
			<div class="notifications" id="dp_notif_bed" style="display: none;">
				<div class="notifMail notif-item notif-tickets" style="display: none;"><span class="counter">0</span></div>
				<div class="notifChat notif-item notif-chat" style="display: none;"><span class="counter">0</span></div>
			</div>
		</div>
	</div>
	<div id="notificationDropdown" style="display:none;">
		<div class="notifDropdown">
			<div class="notifHead">
				<div class="notifMail notif-item notif-tickets" style="display: none;"><span class="counter">0</span></div>
				<div class="notifChat notif-item notif-chat" style="display: none;"><span class="counter">0</span></div>
			</div>
			<ul id="dp_notify_list">
				<li class="dismissAll" id="dp_notify_list_dismiss">
					<a>{{ phrase('agent.window.dismiss_notifications') }}</a>
				</li>
			</ul>
		</div>
	</div>
	<!-- END NOTIFICATION SECTION -->
	<!-- BEGIN SEARCH SECTION -->
	<div id="dp_omnibox_wrap">
		<div id="dp_omnibox">
			<div class="searchBoxWrap" id="dp_omniinput_wrap">
				<div class="type-icon">
					<span class="icon"></span>
				</div>
				<input type="input" id="dp_omniinput" size="4" placeholder="Search" data-element-handler="DeskPRO.Agent.ElementHandler.OmniQuickSearch" />
			</div>
		</div>
		<div id="dp_omnibox_adv">
			<a><span class="plusIcon">Advanced</span></a>
		</div>
	<!-- END SEARCH SECTION -->
	</div>
	<!-- BEGIN CREATE SECTION -->
	<div id="DP-CreateSection">
		<div class="DP-createTicket">
			<div id="createContentTrigger" class="newContent">
				<a><span class="plusIcon">{{ phrase('agent.create') }}</span></a>
			</div>
		</div>
		<!-- Header - Create Ticket Dropdown on click -->
		<div id="createTicketToggle" style="display:none;">
			<div class="createHeader">
				<a>{{ phrase('agent.create') }}</a>
			</div>
			<div class="createDropdown">
				<ul class="createBtnPopups">
					{% if app.user.hasPerm('agent_tickets.create') %}
						<li id="create_ticket_btn"><a><span class="createTicket">{{ phrase('agent.window.new_ticket') }} <kbd>t</kbd></span></a></li>
					{% endif %}
					{% if app.user.hasPerm('agent_people.create') %}
						<li id="create_person_btn"><a><span class="createPerson">{{ phrase('agent.window.new_person') }} <kbd>p</kbd></span></a></li>
					{% endif %}
					{% if app.user.hasPerm('agent_org.create') %}
						<li id="create_organization_btn"><a><span class="createOrg">{{ phrase('agent.window.new_organization') }} <kbd>o</kbd></span></a></li>
					{% endif %}
					<li id="create_task_btn"><a><span class="createTask">{{ phrase('agent.window.new_task') }} <kbd>k</kbd></span></a></li>
					{% if app.user.hasPerm('agent_publish.create') %}
						<li id="create_article_btn"><a><span class="createArticle">{{ phrase('agent.window.new_article') }} <kbd>a</kbd></span></a></li>
						<li id="create_news_btn"><a><span class="createNews">{{ phrase('agent.window.new_news') }} <kbd>n</kbd></span></a></li>
						<li id="create_download_btn"><a><span class="createDownload">{{ phrase('agent.window.new_download') }} <kbd>d</kbd></span></a></li>
						<li id="create_feedback_btn"><a><span class="createFeedback">{{ phrase('agent.window.new_feedback') }} <kbd>i</kbd></span></a></li>
					{% endif %}
				</ul>
			</div>
		</div>
	<!-- END CREATE SECTION -->
	</div>
	<!-- BEGIN USER SECTION -->
	<div id="DP-UserSection">
		<div id="DP-userControl">
			<div class="currentUserAvatar">
				<div class="userWrapper">
					<a id="userSetting_trigger">
						<em style="background-image: url({{ app.user.getPictureUrl(20) }});"></em>
						<span class="drop"></span>
					</a>
				</div>
			</div>
		</div>
		<!-- Header - User Control Dropdown -->
		<div id="userSetting" style="display:none;">
			<div class="userProfileDropdown" >
				<div class="userProfileDropdownHeader">
					<a><em style="background-image: url({{ app.user.getPictureUrl(20) }});"></em></a>
					<span class="drop"></span>
				</div>
				<ul>
					<li class="currentUsername"><p>{{ app.user.display_name }}</p></li>
					<li class="setting" id="user_settings_link"><a>{{ phrase('agent.window.settings') }}</a></li>
					<li class="help"><a href="http://support.deskpro.com/">{{ phrase('agent.window.help') }}</a></li>
					<li class="logout"><a href="{{ path('user_logout', {'auth': static_security_token('user_logout', 0)}) }}?to=agent">{{ phrase('agent.window.logout') }}</a></li>
				</ul>
			</div>
		</div>
	<!-- END USER SECTION -->
	</div>

	<!-- BEGIN INTERFACE SECTION -->
	{% if app.user.can_admin or app.user.can_billing or app.user.can_reports or app.getSetting('user.portal_enabled') %}
	<div id="DP-InterfaceSwitcher">
		<div class="DP-adminSwitch">
			<div class="adminSwitcher">
				<a class="agent">Agent Interface<span class="dropdownIcon"></span></a>
			</div>
		</div>
		<!-- Header - Switch Button Interfaces- Dropdown -->
		<div id="interfacesToggle" style="display:none;">
		<div class="dropdownSwitcherWrap" >
			<div class="switcherHeader">
				<a class="agent"><span>{{ phrase('agent.window.agent_interface') }}</span></a>
			</div>
			<ul>
				{% if app.user.can_admin %}<li><a class="admin" href="{{ app.request.getBaseUrl() }}/admin/login?dpsid-agent={{ app.getSession().getId() }}"><span>{{ phrase('agent.window.admin_interface') }}</span></a></li>{% endif %}
				{% if app.user.can_billing %}<li><a class="billing" href="{{ app.request.getBaseUrl() }}/billing"><span>{{ phrase('agent.window.billing_interface') }}</span></a></li>{% endif %}
				{% if app.user.can_reports %}<li><a class="reports" href="{{ app.request.getBaseUrl() }}/reports"><span>{{ phrase('agent.window.reports_interface') }}</span></a></li>{% endif %}
				{% if app.getSetting('user.portal_enabled') %}<li><a class="user" href="{{ app.request.getBaseUrl() }}/"><span>{{ phrase('agent.window.user_interface') }}</span></a></li>{% endif %}
			</ul>
		</div>
		</div>
	</div>
	{% endif %}
	<!-- END INTERFACE SECTION -->

	<!-- BEGIN STATUS SECTION -->
	<div id="DP-StatusSection">
		<div class="DP-adminStatus">
			<ul>
				<li class="agentStatus" id="agent_status_trigger">
					<a class="tipped on" id="agent_status" data-tipped="{{ phrase('agent.window.toggle_away_status') }}" data-tipped-options="hook: 'bottommiddle'"><em class="label-away">{{ phrase('agent.window.away_short') }}</em><em class="label-dnd">{{ phrase('agent.window.do_not_disturb_short') }}</em></a>
					<div id="agent_status_menu" style="display:none;">
						<div class="createDropdown">
							<ul class="createBtnPopups">
								<li class="status_go_available"><a><span class="statusAvailable">{{ phrase('agent.window.available') }}</span></a></li>
								<li class="status_go_away"><a><span class="statusAway">{{ phrase('agent.window.away') }}</span></a></li>
								<li class="status_go_dnd"><a><span class="statusDnd">{{ phrase('agent.window.do_not_disturb') }}</span></a></li>
							</ul>
						</div>
					</div>
				</li>
				<li class="networkStatIndicator" id="network_status_indicator">
					<a class="tipped" data-tipped="network_status_tip" data-tipped-options="inline:true, hook: 'bottommiddle'"></a>
					<div id='network_status_tip' style="display: none;">{{ phrase('agent.window.network_status') }}<br /><div class='network-status-green'>{{ phrase('agent.window.network_status_okay') }}</div><div class='network-status-red'>{{ phrase('agent.window.network_status_bad') }}</div></div>
				</li>
				<li class="keyboardIcon">
					<a id="keyboard_shortcuts_trigger" class="tipped" title="Keyboard shortcuts" data-tipped-options="hook: 'bottommiddle'"></a>
				</li>
				<li class="soundIcon">
					<a class="tipped" id="sound_icon" title="{{ phrase('agent.window.sound_explain') }}" data-tipped-options="hook: 'bottommiddle'"></a>
				</li>
			</ul>
		</div>
	</div>
	<!-- END STATUS SECTION -->
<!-- END HEADER BAR -->
</div>

<div id="dp_omniresults" style="display: none">
	<script type="text/x-deskpro-plain" id="dp_omniresults_section">
		<section class="section {TYPE} section-{TYPE}">
			<header>
				{TITLE}
				<span class="expand-btn"></span>
			</header>
			<article>
				<ul class="result-list"></ul>
			</article>
		</section>
	</script>
	<script type="text/x-deskpro-plain" id="dp_omniresults_result_row">
		<li class="result-item {TYPE}-{ID}"><span class="prop-id">{ID}</span> {TITLE}</li>
	</script>
</div>

{% include 'AgentBundle:Main:keyboard-shortcuts-sheet.html.twig' %}

<div id="dp_searchsheet" data-element-handler="DeskPRO.Agent.ElementHandler.OmniSearchSheet">
	<header>
		<span id="omnisearch_reset">Reset Form</span>
		<span class="close close-search-sheet"></span>
		<em>Search:</em>
		<ul>
			<li data-tab-for="#dp_searchsheet_tickets">Tickets</li>
			<li data-tab-for="#dp_searchsheet_people">People</li>
			<li data-tab-for="#dp_searchsheet_orgs">Organizations</li>
			<li data-tab-for="#dp_searchsheet_content">Publish and Feedback</li>
		</ul>
	</header>

	{# Ticket Search Form #}
	<article id="dp_searchsheet_tickets" data-type="tickets">
		{% include 'AgentBundle:Main:search-sheet-tickets.html.twig' %}
	</article>
	{# /Ticket Search Form #}

	{# People Search Form #}
	<article id="dp_searchsheet_people" data-type="people">
		{% include 'AgentBundle:Main:search-sheet-people.html.twig' %}
	</article>
	{# /People Search Form #}

	{# Orgs Search Form #}
	<article id="dp_searchsheet_orgs" data-type="orgs">
		{% include 'AgentBundle:Main:search-sheet-orgs.html.twig' %}
	</article>
	{# /Orgs Search Form #}

	{# Content Search Form #}
	<article id="dp_searchsheet_content" data-type="content">
		{% include 'AgentBundle:Main:search-sheet-content.html.twig' %}
	</article>
	{# /Content Search Form #}

	<footer>
		<button id="omnisearch_submit">Search</button>
	</footer>
</div>
