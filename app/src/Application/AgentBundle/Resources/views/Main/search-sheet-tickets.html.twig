<form action="{{ path('agent_ticketsearch_runcustomfilter') }}">
	<ul class="property-list">
		<li class="ob">
			<label>{{ phrase('agent.general.department') }}</label>
			<div class="values">
				{% include 'AgentBundle:Common:select-department.html.twig' with {
					'name': 'set_term[department][]',
					'blank_title': phrase('agent.general.department'),
					'departments': app.departments.getPersonDepartments(app.user, 'tickets'),
					'add_attr': 'multiple="multiple"'
				} %}
			</div>
		</li>
		<li class="ob">
			<label>{{ phrase('agent.general.status') }}</label>
			<div class="values">
				<select name="set_term[status][]" multiple="multiple">
					<option data-start="1" class="start" value="awaiting_agent">{{ phrase('agent.tickets.status_awaiting_agent') }}</option>
					<option data-start="1" class="start" value="awaiting_user">{{ phrase('agent.tickets.status_awaiting_user') }}</option>
					<option value="resolved">{{ phrase('agent.tickets.status_resolved') }}</option>
					<option value="closed">{{ phrase('agent.tickets.status_closed') }}</option>
					<option value="hidden.validated">{{ phrase('agent.general.awaiting_validation') }}</option>
					<option value="hidden.spam">{{ phrase('agent.general.spam') }}</option>
					<option value="hidden.deleted">{{ phrase('agent.general.deleted') }}</option>
				</select>
			</div>
		</li>
		<li class="ob">
			<label>{{ phrase('agent.general.agent') }}</label>
			<div class="values">
				{% include 'AgentBundle:Common:select-agent.html.twig' with {
					'name': 'set_term[agent][]',
					'blank_title': phrase('agent.general.agent'),
					'agents': app.agents.getAgents(),
					'add_attr': 'multiple="multiple"'
				} %}
			</div>
		</li>
		{% if app.getSetting('core.use_agent_team') %}
			<li class="ob">
				<label>{{ phrase('agent.general.agent_team') }}</label>
				<div class="values">
					{% include 'AgentBundle:Common:select-agent-team.html.twig' with {
						'name': 'set_term[agent_team][]',
						'blank_title': phrase('agent.general.agent_team'),
						'agent_teams': app.agent_teams.getTeams(),
						'add_attr': 'multiple="multiple"'
					} %}
				</div>
			</li>
		{% endif %}
		<li class="ob">
			<label>{{ phrase('agent.general.followers') }}</label>
			<div class="values">
				{% include 'AgentBundle:Common:select-agent.html.twig' with {
					'name': 'set_term[participant][]',
					'blank_title': phrase('agent.general.agent'),
					'agents': app.agents.getAgents(),
					'add_attr': 'multiple="multiple"'
				} %}
			</div>
		</li>
		{% if app.getSetting('core.use_ticket_category') %}
		<li class="ob">
			<label>{{ phrase('agent.general.category') }}</label>
			<div class="values">
				{% include 'AgentBundle:Common:select-category.html.twig' with {
					'name': 'set_term[category][]',
					'blank_title': phrase('agent.general.category'),
					'categories': ticket_options.ticket_categories_hierarchy,
					'add_attr': 'multiple="multiple"'
				} %}
			</div>
		</li>
		{% endif %}
		{% if app.getSetting('core.use_product') %}
		<li class="ob">
			<label>{{ phrase('agent.general.product') }}</label>
			<div class="values">
				{% include 'AgentBundle:Common:select-product.html.twig' with {
					'name': 'set_term[product][]',
					'blank_title': phrase('agent.general.product'),
					'products': ticket_options.products_hierarchy,
					'add_attr': 'multiple="multiple"'
				} %}
			</div>
		</li>
		{% endif %}
		{% if app.getSetting('core.use_ticket_priority') %}
		<li class="ob">
			<label>{{ phrase('agent.general.priority') }}</label>
			<div class="values">
				{% include 'AgentBundle:Common:select-priority.html.twig' with {
					'name': 'set_term[priority][]',
					'blank_title': phrase('agent.general.priority'),
					'priorities': app.getDataService('TicketPriority').getNames(),
					'add_attr': 'multiple="multiple"'
				} %}
			</div>
		</li>
		{% endif %}
		{% if app.getSetting('core.use_ticket_workflow') %}
		<li class="ob">
			<label>{{ phrase('agent.general.workflow') }}</label>
			<div class="values">
				{% include 'AgentBundle:Common:select-workflow.html.twig' with {
					'name': 'set_term[workflow][]',
					'blank_title': phrase('agent.general.workflow'),
					'workflows': app.getDataService('TicketWorkflow').getNames(),
					'add_attr': 'multiple="multiple"'
				} %}
			</div>
		</li>
		{% endif %}

		{% if app.getDataService('Sla').hasSlas() %}
		<li class="ob">
			<label>SLA</label>
			<div class="values">
				<select name="set_term[sla][]" multiple="multiple">
					{% for sla in app.getDataService('Sla').getAllSlas %}
						<option value="{{ sla.id }}">{{ sla.title }}</option>
					{% endfor %}
				</select>
			</div>
		</li>
		{% endif %}

		{% if app.getDataService('Organization').getOrganizationNames()|length %}
		<li class="ob">
			<label>{{ phrase('agent.general.organization') }}</label>
			<div class="values">
				<select name="set_term[organization][]" multiple="multiple">
					{% for id,title in app.getDataService('Organization').getOrganizationNames() %}
						<option value="{{ id }}">{{ title }}</option>
					{% endfor %}
				</select>
			</div>
		</li>
		{% endif %}

		{% if app.languages.isMultiLang() %}
			<li class="ob">
				<label>{{ phrase('agent.general.language') }}</label>
				<div class="values">
					<select name="language">
						{% for id,title in app.languages.getTitles() %}
						<option value="{{id}}">{{title}}</option>
						{% endfor %}
					</select>
				</div>
			</li>
		{% endif %}

		{% if ticket_options.custom_ticket_fields %}
			{% for field in ticket_options.custom_ticket_fields %}
				{% if field.field_def.getFilterCapabilities('filter') %}
				<li {% if 'Choice' in field.field_def.handler_class %}class="ob"{% else %}class="field-input"{% endif %}>
					<label>{{field.field_def.title}}</label>
					<div class="values">
						{{ render_custom_field_form(field, {field_group: 'set_term'}) }}
					</div>
				</li>
				{% endif %}
			{% endfor %}
		{% endif %}
	</ul>
	<br class="clear" />

	<div class="search-form" id="tickersearch_criteria_list" data-templates="#tickersearch_criteria_tpl">
		<div class="search-terms"></div>
		<div class="term"><span class="add-term">+</span> {{ phrase('agent.general.add_criteria_term') }}</div>
	</div>

	<ul class="property-list">
		<li class="search-input">
			<div class="values">
				<input type="text" name="query" placeholder="{{ phrase('agent.interface.search_for_text_or_a_phrase') }}" />
			</div>
		</li>
	</ul>
	<br class="clear" />
</form>

{% include 'DeskPRO:Common:ticket-search-criteria.html.twig' with {
	classname: 'search-builder-tpl',
	id: 'tickersearch_criteria_tpl',
	term_options: term_options,
	no_show_fields: ['department', 'status', 'agent', 'agent_team', 'participant', 'category', 'product', 'priority', 'workflow', 'organizaton', 'language', 'ticket_field'],
	search_context: 'filter'
} %}
