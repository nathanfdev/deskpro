<form action="{{ path('agent_ticketsearch_runcustomfilter') }}">
	<ul class="property-list">
		<li class="ob">
			<label>{{ phrase('agent.main.department') }}</label>
			<div class="values">
				{% include 'AgentBundle:Common:select-department.html.twig' with {
					'name': 'set_term[department][]',
					'blank_title': phrase('agent.department'),
					'departments': ticket_options.departments_hierarchy,
					'add_attr': 'multiple="multiple"'
				} %}
			</div>
		</li>
		<li class="ob">
			<label>{{ phrase('agent.main.status') }}</label>
			<div class="values">
				<select name="set_term[status][]" multiple="multiple">
					<option data-start="1" class="start" value="awaiting_agent">{{ phrase('agent.main.awaiting_agent') }}</option>
					<option data-start="1" class="start" value="awaiting_user">{{ phrase('agent.main.awaiting_user') }}</option>
					<option value="resolved">{{ phrase('agent.main.resolved') }}</option>
					<option value="closed">{{ phrase('agent.main.closed') }}</option>
					<option value="hidden.validated">{{ phrase('agent.main.awaiting_validation') }}</option>
					<option value="hidden.spam">{{ phrase('agent.main.spam') }}</option>
					<option value="hidden.deleted">{{ phrase('agent.main.deleted') }}</option>
				</select>
			</div>
		</li>
		<li class="ob">
			<label>{{ phrase('agent.main.agent') }}</label>
			<div class="values">
				{% include 'AgentBundle:Common:select-agent.html.twig' with {
					'name': 'set_term[agent][]',
					'blank_title': phrase('agent.agent'),
					'departments': ticket_options.agents,
					'add_attr': 'multiple="multiple"'
				} %}
			</div>
		</li>
		{% if app.getSetting('core.use_agent_team') %}
			<li class="ob">
				<label>{{ phrase('agent.main.agent') }} {{ phrase('agent.main.team') }}</label>
				<div class="values">
					{% include 'AgentBundle:Common:select-agent-team.html.twig' with {
						'name': 'set_term[agent_team][]',
						'blank_title': phrase('agent.agent_team'),
						'departments': ticket_options.agent_teams,
						'add_attr': 'multiple="multiple"'
					} %}
				</div>
			</li>
		{% endif %}
		<li class="ob">
			<label>{{ phrase('agent.main.followers') }}</label>
			<div class="values">
				{% include 'AgentBundle:Common:select-agent.html.twig' with {
					'name': 'set_term[participant][]',
					'blank_title': phrase('agent.agent'),
					'departments': ticket_options.agents,
					'add_attr': 'multiple="multiple"'
				} %}
			</div>
		</li>
		{% if app.getSetting('core.use_ticket_category') %}
		<li class="ob">
			<label>{{ phrase('agent.main.category') }}</label>
			<div class="values">
				{% include 'AgentBundle:Common:select-category.html.twig' with {
					'name': 'set_term[category][]',
					'blank_title': phrase('agent.category'),
					'categories': ticket_options.ticket_categories_hierarchy,
					'add_attr': 'multiple="multiple"'
				} %}
			</div>
		</li>
		{% endif %}
		{% if app.getSetting('core.use_product') %}
		<li class="ob">
			<label>{{ phrase('agent.main.product') }}</label>
			<div class="values">
				{% include 'AgentBundle:Common:select-product.html.twig' with {
					'name': 'set_term[product][]',
					'blank_title': phrase('agent.product'),
					'products': ticket_options.products_hierarchy,
					'add_attr': 'multiple="multiple"'
				} %}
			</div>
		</li>
		{% endif %}
		{% if app.getSetting('core.use_ticket_priority') %}
		<li class="ob">
			<label>{{ phrase('agent.main.priority') }}</label>
			<div class="values">
				{% include 'AgentBundle:Common:select-priority.html.twig' with {
					'name': 'set_term[priority][]',
					'blank_title': phrase('agent.priority'),
					'priorities': ticket_options.ticket_priorities,
					'add_attr': 'multiple="multiple"'
				} %}
			</div>
		</li>
		{% endif %}
		{% if app.getSetting('core.use_ticket_workflow') %}
		<li class="ob">
			<label>{{ phrase('agent.main.workflow') }}</label>
			<div class="values">
				{% include 'AgentBundle:Common:select-workflow.html.twig' with {
					'name': 'set_term[workflow][]',
					'blank_title': phrase('agent.workflow'),
					'workflows': ticket_options.ticket_workflows,
					'add_attr': 'multiple="multiple"'
				} %}
			</div>
		</li>
		{% endif %}

		{% if ticket_options.people_organizations %}
		<li class="ob">
			<label>{{ phrase('agent.main.organization') }}</label>
			<div class="values">
				<select name="set_term[organization][]" multiple="multiple">
					{% for id,title in ticket_options.people_organizations %}
						<option value="{{ id }}">{{ title }}</option>
					{% endfor %}
				</select>
			</div>
		</li>
		{% endif %}

		{% if ticket_options.languages %}
			<li class="ob">
				<label>{{ phrase('agent.main.language') }}</label>
				<div class="values">
					<select name="language">
						{% for id,title in term_options.languages %}
						<option value="{{id}}">{{title}}</option>
						{% endfor %}
					</select>
				</div>
			</li>
		{% endif %}

		{% if ticket_options.custom_ticket_fields %}
			{% for field in ticket_options.custom_ticket_fields %}
				{% if field.field_def.getFilterCapabilities('filter') %}
				<li {% if 'Choice' in field.field_def.handler_class %}class="ob"{% else %}class="field-input"{% endif %}>
					<label>{{field.field_def.title}}</label>
					<div class="values">
						{{ render_custom_field_form(field) }}
					</div>
				</li>
				{% endif %}
			{% endfor %}
		{% endif %}
	</ul>
	<br class="clear" />

	<div class="search-form" id="tickersearch_criteria_list" data-templates="#tickersearch_criteria_tpl">
		<div class="search-terms"></div>
		<div class="term"><span class="add-term">+</span> {{ phrase('agent.add_criteria_term') }}</div>
	</div>

	<ul class="property-list">
		<li class="search-input">
			<div class="values">
				<input type="text" name="query" placeholder="{{ phrase('agent.main.search_for_text_or_a_phrase') }}" />
			</div>
		</li>
	</ul>
	<br class="clear" />
</form>

{% include 'DeskPRO:Common:ticket-search-criteria.html.twig' with {
	classname: 'search-builder-tpl',
	id: 'tickersearch_criteria_tpl',
	term_options: term_options,
	no_show_fields: ['department', 'status', 'agent', 'agent_team', 'participant', 'category', 'product', 'priority', 'workflow', 'organizaton', 'language', 'ticket_field'],
	search_context: 'filter'
} %}
