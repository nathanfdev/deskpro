{# Everything Menus #}
<div id="everything_search_terms_global">
	<div class="type" title="{{ phrase('agent.labels') }}" data-rule-type="label" data-rule-handler="DeskPRO.Agent.RuleBuilder.LabelsTerm" data-label-type="everything" data-term-type="GenericInputTerm" data-term-triggers="label,labelled,labels">
		<div class="op">
			<select name="op" class="op">
				<option value="is">{{ phrase('agent.is') }}</option>
				<option value="not">{{ phrase('agent.is_not') }}</option>
				{% if with_change_terms %}
					<option value="changed">{{ phrase('agent.changed') }}</option>
					<option value="changed_to">{{ phrase('agent.changed_to_include') }}</option>
					<option value="changed_from">{{ phrase('agent.changed_to_remove') }}</option>
				{% endif %}
			</select>
		</div>
		<div class="options">
			{% include 'DeskPRO:Common:rulebuilder-labels-options.html.twig' %}
		</div>
	</div>
</div>

