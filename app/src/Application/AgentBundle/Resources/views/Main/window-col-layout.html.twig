<div id="dp_center">
	<div class="collapsed-area" id="dp_right_collapsed">
		<ul id="dp_collapsed_tabs"></ul>
	</div>
	<div id="dp_source">
		<div id="dp_source_loading"></div>
		<div id="dp_source_footer">
			<footer class="results-nav no-click-switch" id="agent_chat_section" data-section-handler="DeskPRO.Agent.WindowElement.Section.AgentChat">
				<div class="cursor">
					<ul id="agent_chat_online_icons">
						{% for agent in agents %}
							<li
								class="{% if agent.id == app.user.id %}agent-me{% else %}agent-{{ agent.id }}{% endif %}"
								style="{% if agent.id != app.user.id and agent.id not in online_agent_ids %}display: none;{% endif %}"
							>
								<i class="agent-inline-icon" style="background-image: url({{ agent.getPictureUrl(16) }});"></i>
							</li>
						{% endfor %}
					</ul>
				</div>
			</footer>
		</div>
	</div>
	<div id="dp_list">
		<div id="dp_list_loading"></div>
	</div>
	<div id="dp_list_resizer" ng-show="paneVis.list && paneVis.tabs"><div></div></div>
	<div id="dp_content">
		<div id="tabNavigationPane" style="width: 5500px; vertical-align: bottom;">

            <div class="btn-group-actions" style="background: none; display: inline-block; position: static; height: 28px; vertical-align: bottom; padding: 0;">
                <div class="btn-wrap create-group pull-left">
                    <a class="btn" style="line-height: 24px; height: 24px;"><i class="icon-plus"></i><span class="btn-text">{{ phrase('agent.chrome.btn_add') }}</span></a>
                </div>
            </div>

            <div class="bootstrap" ng-show="tabs.length && !paneVis.list" style="display: inline-block; vertical-align: bottom; margin-bottom: 3px;">
                <div class="btn-group" dropdown>

                    <button type="button" class="btn btn-show-list" ng-click="showList()"></button>
                    <button type="button" class="btn btn-primary btn-sm dropdown-toggle" style="height: 25px; padding: 3px 5px;">
                        <span class="caret"></span>
                        <span class="sr-only">Split button!</span>
                    </button>

                    <ul class="dropdown-menu" role="menu" style="z-index: 2; max-height: 300px; max-width: 200px; overflow-y: scroll;">
                        <li ng-repeat="item in listItems" ng-class="item.open && 'active'">
                            <a href="#" data-route="{{ ng_var('item.route') }}" style="overflow: hidden;">
                                {{ ng_var('item.title') }}
                                <div class="pull-right" ng-show="!item.open">+</div>
                                <div class="pull-right" ng-show="item.open">-</div>
                            </a>
                        </li>
                    </ul>

                </div>
            </div>

			<div class="deskproTabList" style="position: static; display: inline-block; vertical-align: bottom;">
				<div class="deskproTabListInner" style="position: static;">
					<ul class="dp-tab-list">

                        <li ng-repeat="tab in tabs" id="{{ ng_var('tab.tabBtnId') }}"
                            ng-click="tabClick($event, tab)"
                            data-tab-id="{{ ng_var('tab.id') }}"
                            class="{{ ng_var('tab.class') }}"
                            ng-class="tab.isActive && 'activeTabList'"
                            {{ ng_var('tab.page.TYPENAME') }}
                            {{ ng_var('tab.page.LOADING_TYPENAME') }}
                            >
                            <div class="item-hover-over-indicator"></div>
                                <a>
                                    <i class="icon-globe dp-icon-placeholder"></i>{{ ng_var('tab.title') }}
                                </a>
                                <span class="bound-fade"></span>
                                <span class="close"></span>
                            </li>
                        </li>

					</ul>
				</div>
			</div>
			<div id="tabNavSelectorRight">
				<a class="tabSlideRight"></a>
			</div>
		</div>
		<div id="dp_content_wrap">
			<div id="dp_content_info">
				<table cellspacing="0" cellpadding="0" width="100%" height="100%"><tr><td valign="middle">
					<h1>{{ phrase('agent.interface.major_items_appear_here') }}</h1>
				</td></tr></table>
			</div>
		</div>
	</div>
</div>