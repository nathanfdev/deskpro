<div id="dp_center">
	<div class="collapsed-area" id="dp_left_collapsed">
		<ul>
			<li class="source_pane toggle_source_pane"><span><i class="icon-dashboard"></i> Navigation</span></li>
			<li class="list_pane toggle_list_pane"><span><i class="icon-filter"></i> Listing</span></li>
		</ul>
	</div>
	<div class="collapsed-area" id="dp_right_collapsed">
		<ul>
			<li class="tabs_pane toggle_tabs_pane"><span><i class="icon-globe"></i> Tabs</span></li>
		</ul>
	</div>
	<div id="dp_source">
		<div id="dp_source_loading"></div>
	</div>
	<div id="dp_list">
		<div id="dp_list_loading"></div>
	</div>
	<div id="dp_list_resizer"><div></div></div>
	<div id="dp_content">
		<div id="tabNavigationPane">
			<div style="position: absolute; top: 10px; right: 10px;z-index:1000000;">
				<span class="toggle_tabs_pane" style="background-color: #fff; border-radius: 10px; line-height: 100%; padding: 1px; cursor: pointer;"><i class="icon-double-angle-right"></i></span>
			</div>
			<div id="tabNavSelectorLeft">
				<a class="tabSlideLeft"></a>
			</div>
			<div class="deskproTabList">
				<div class="deskproTabListInner">
					<ul class="dp-tab-list">

					</ul>
				</div>
			</div>
			<div id="tabNavSelectorRight">
				<a class="tabSlideRight"></a>
			</div>
			{# <div id="tabDropdownPicker"></div> #}
		</div>
		<div id="dp_content_wrap">
			<div id="dp_content_info">
				<table cellspacing="0" cellpadding="0" width="100%" height="100%"><tr><td valign="middle">
					<h1>{{ phrase('agent.interface.major_items_appear_here') }}</h1>
				</td></tr></table>
			</div>
		</div>
	</div>
</div>