<li class="keyboard with-menu">
	<a href="" class="tipped" data-tipped="keyboard_shortcuts_tip" data-tipped-options="inline: true, hook: 'bottommiddle'">{{ phrase('agent.main.keyboard') }}</a>
	<div id="keyboard_shortcuts_tip" style="display: none">
		<table cellspacing="0" cellpadding="0" width="100%">
			<tr>
				<td>
					<h5>{{ phrase('agent.window_navigation') }}</h5>
					<div class="row">
						<kbd>{{ phrase('agent.main.ctrlleft') }}</kbd> {{ phrase('agent.window.key_left_tab') }}
					</div>
					<div class="row">
						<kbd>{{ phrase('agent.main.ctrlright') }}</kbd> {{ phrase('agent.window.key_right_tab') }}
					</div>
					<div class="row">
						<kbd>{{ phrase('agent.main.ctrlshiftc') }}</kbd> {{ phrase('agent.window.key_close_tab') }}
					</div>
				</td>
				<td>
					<h5>{{ phrase('agent.create_content') }}</h5>
					<div class="row">
						<kbd>{{ phrase('agent.main.kbd_new_ticket') }}</kbd> {{ phrase('agent.new_ticket') }}
					</div>
					<div class="row">
						<kbd>{{ phrase('agent.main.kbd_new_person') }}</kbd> {{ phrase('agent.new_person') }}
					</div>
					<div class="row">
						<kbd>{{ phrase('agent.main.kbd_new_article') }}</kbd> {{ phrase('agent.new_article') }}
					</div>
					<div class="row">
						<kbd>{{ phrase('agent.main.kbd_new_download') }}</kbd> {{ phrase('agent.new_download') }}
					</div>
					<div class="row">
						<kbd>{{ phrase('agent.main.kbd_new_feedback') }}</kbd> {{ phrase('agent.new_feedback') }}
					</div>
				</td>
			</tr>
		</table>
		<table cellspacing="0" cellpadding="0" width="100%">
			<tr>
				<td>
					<h5>{{ phrase('agent.tickets') }}</h5>
					<div class="row">
						<kbd>{{ phrase('agent.main.shiftr') }}</kbd> {{ phrase('agent.focus_reply_box') }}
					</div>
					<div class="row">
						<kbd>{{ phrase('agent.main.shiftc') }}</kbd> {{ phrase('agent.window.set_ticket_resolved') }}
					</div>
					<div class="row">
						<kbd>{{ phrase('agent.main.shifta') }}</kbd> {{ phrase('agent.window.assign_to_self') }}
					</div>
				</td>
				<td>
					<h5>{{ phrase('agent.people') }}</h5>
					<div class="row">
						<kbd>{{ phrase('agent.main.shiftr') }}</kbd> {{ phrase('agent.window.focus_notes_box') }}
					</div>
					<div class="row">
						<kbd>{{ phrase('agent.main.shiftt') }}</kbd> {{ phrase('agent.window.create_ticket_person') }}
					</div>
				</td>
			</tr>
		</table>
	</div>
</li>
