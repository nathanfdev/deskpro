<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.SettingsPage.Filters';
</script>

<div style="text-align: right">
	<a class="clean-white" data-route="poppage:{{ path('agent_settings_ticketfilters_new') }}" data-zindex="32050">{{ phrase('agent.settings.create_filter') }}</a>
</div>

<br />

<div class="check-grid item-list">
	<table width="100%">
		<thead>
			<tr>
				<th>{{ phrase('agent.global.filters') }}</th>
				<th width="50"></th>
			</tr>
		</thead>
		<tbody>
			{% for filter in filters %}
				<tr>
					<td>{{ filter.title }}</td>
					<td class="prop" style="text-align: center;">
						<ul class="controls">
							<li class="delete delete-filter" data-delete-url="{{ path('agent_settings_ticketfilters_del', { 'filter_id': filter.id }) }}" data-filter-id="{{ filter.id }}"></li>
							<li class="edit" data-route="poppage:{{ path('agent_settings_ticketfilters_edit', { 'filter_id': filter.id }) }}" data-zindex="32050"></li>
						</ul>
					</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="2">{{ phrase('agent.settings.no_filters') }}</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
</div>
