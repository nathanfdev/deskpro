{% for snippet in snippets %}
	<li class="snippet snippet-{{ snippet.id }}" data-snippet-id="{{ snippet.id }}">
		<div class="show">
			<div class="controls">
				<div><span class="edit-trigger"></span></div>
				<div><span class="expand-trigger"></span></div>
			</div>
			<div class="snippet-content" data-snippet-id="{{ snippet.id }}">
				<label>
					{% for title_info in snippet.title %}
						<span class="lang-{{ title_info.language_id }} title">{{ title_info.value }}</span>
					{% endfor %}
				</label>
				{% if snippet.shortcut_code %}<span class="snippet-code">%{{ snippet.shortcut_code }}%</span>{% endif %}
				<div class="content show">
					<div class="main-content">
						{% for snippet_info in snippet.snippet %}
							<span class="lang-{{ snippet_info.language_id }} snippet">{{ snippet_info.value }}</span>
							<textarea style="display: none;" class="lang-{{ snippet_info.language_id }} snippet-value" data-language-id="{{ snippet_info.language_id }}">{{ snippet_info.value }}</textarea>
						{% endfor %}
					</div>
					<div class="fadeaway"></div>
				</div>
			</div>
		</div>
	</li>
{% endfor %}