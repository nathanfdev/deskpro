{% import 'AgentBundle:Common:agent-macros.html.twig' as agentui %}
<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.AgentChatTranscript';
pageMeta.title         = '{{ phrase('agent.chat.chat_transcript') }}';
pageMeta.conversation_id = {{convo.id}};
</script>
{{ agentui.scroll_containers('agentchat-page') }}
	<header class="page-header">
		<h1>
			{% for p in convo.participants %}
				{% if loop.last %} and {% endif %}{{ p.display_name }}{% if not loop.last %},{% endif %}
			{% endfor %}
		</h1>
		<time class="timeago" datetime="{{ convo.date_created|date('c') }}">{{ convo.date_created|date('day_short') }}</time>
	</header>

	<div class="profile-box-container">
		<header>
			<h4>{{ phrase('agent.chat.chat_transcript') }}</h4>
		</header>
		<section class="chat-transcript">
			<div class="messages chat-transcript {% if convo.status == 'ended' %}chat-ended{% endif %}" id="{{baseId}}_messages_box">
				{% for message in convo_messages|reverse %}
					<div class="row {% if message.metadata.new_user_track %}user-track{% endif %} {% if message.is_sys %}sys{% elseif message.author.is_agent and message.author.id != convo.person.id %}agent{% else %}user{% endif%} message-{{ message.id }}">
						{% if message.is_sys %}
							<div class="message-content">
								<div class="message">
									{% if message.is_html %}
										{{message.content|raw}}
									{% else %}
										{{message.content}}
									{% endif %}
								</div>
								<time>{{ message.date_created|date('g:ia') }}</time>
							</div>
						{% elseif message.author.is_agent and message.author.id != convo.person.id %}
							<div class="message-content">
								<div class="chatSend">
									<div class="chatMsgSend">
										{% if message.is_html %}
											{{message.content|raw}}
										{% else %}
											{{message.content}}
										{% endif %}
										<span class="bubbleLeft"></span>
									</div>
								</div>
								<time>{{ message.date_created|date('g:ia') }}</time>
							</div>
						{% else %}
							<div class="message-content">
								<div class="chatRecieve">
									<div class="chatMsgRecieve">
										{% if message.is_html %}
											{{message.content|raw}}
										{% else %}
											{{message.content|safe_link_urls}}
										{% endif %}
										<span class="bubbleRight"></span>
									</div>
								</div>
								<time>{{ message.date_created|date('g:ia') }}</time>
							</div>
						{% endif %}
					</div>
				{% endfor %}
				<div class="row user-typing" style="display: none" id="{{baseId}}_user_typing">
					<div class="message-content">
						<div class="chatRecieve">
							<div class="chatMsgRecieve">
								<label>{{ phrase('agent.chat.user_typing') }}: </label>
								<div class="prop-msg"></div>
								<span class="bubbleRight"></span>
							</div>
						</div>
					</div>
				</div>
			</div>
			<br class="clear" />
		</section>
	</div>
{{ agentui.scroll_containers_end() }}
