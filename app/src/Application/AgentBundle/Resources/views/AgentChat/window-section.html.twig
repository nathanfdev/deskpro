{% extends 'AgentBundle::source-pane-layout.html.twig' %}
{% block pane_main_tab %}
	<li class="tab active"><i class="icon-dp-chat"></i> {{ phrase('agent.chat.chat_history') }}</li>
{% endblock %}
{% block pane_other_tabs %}{% endblock %}
{% block pane_content %}
<div class="pane-content pane-content-main">
	<section class="pane-section">
		<header>
			<h1>{{ phrase('agent.chat.chat_history') }}</h1>
		</header>
		<ul class="nav-list">
			{% if agent_chatted|length %}
				<li>
					<div class="is-nav-item item agent-0" data-route="listpane:{{ path('agent_agentchat_history', {'agent_id': '0'}) }}">
						<h3>{{ phrase('agent.chat.agent_chats') }}</h3>
						<em class="counter list-counter">{{ chatted_counts[0]|default(0) }}</em>
					</div>
					<ul class="nav-list-small indented">
						{% for agent in agent_chatted %}
							<li>
								<div class="item is-nav-item agent-{{ agent.id }}" data-route="listpane:{{ path('agent_agentchat_history', {'agent_id': agent.id}) }}">
									<h3>{{ agent.display_name }}</h3>
									<div class="float-side">
										<em class="counter list-counter">{{ chatted_counts[agent.id]|default(0) }}</em>
									</div>
								</div>
							</li>
						{% endfor %}
					</ul>
				</li>
			{% endif %}
			{% if agent_team_chatted|length %}
				<li>
					<div class="is-nav-item item agent-team-0" data-route="listpane:{{ path('agent_agentchat_history_team', {'agent_team_id': '0'}) }}">
						<h3>{{ phrase('agent.chat.team_chats') }}</h3>
						<em class="counter list-counter">{{ chatted_team_counts[0]|default(0) }}</em>
					</div>
					<ul class="sub-group show">
						{% for agent_team in agent_team_chatted %}
							<li>
								<div class="item is-nav-item agent-team-{{ agent_team.id }}" data-route="listpane:{{ path('agent_agentchat_history_team', {'agent_team_id': agent_team.id}) }}">
									<h3>{{ agent.display_name }}</h3>
									<div class="float-side">
										<em class="counter list-counter">{{ chatted_team_counts[agent_team.id]|default(0) }}</em>
									</div>
								</div>
							</li>
						{% endfor %}
					</ul>
				</li>
			{% endif %}
		</ul>
	</section>
</div>
{% endblock %}
