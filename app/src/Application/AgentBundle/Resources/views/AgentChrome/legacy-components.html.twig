<script type="text/deskpro-legacy" id="dplegacy.tabbar">
    <div id="tabNavigationPane" style="vertical-align: bottom;">
        <div id="tabNavSelectorLeft">
            <a class="tabSlideLeft"></a>
        </div>

        <div class="mainDeskproTabList deskproTabList" style="vertical-align: bottom;">
            <div class="deskproTabListInner" context-menu="context(null)" context-menu-disabled="!tabHistory.length && !tabs.length" data-target="tabContextMenu">
                <ul class="dp-tab-list">
                    <li ng-repeat="tab in tabs track by tab.id" id="{{ ng_var('tab.tabBtnId') }}"
                        ng-mousedown="tabClick($event, tab)"
                        data-tab-id="{{ ng_var('tab.id') }}"
                        ng-class="{'activeTabList': tab.isActive && paneVis.tabs, 'is-alerting': tab.isAlerting}"
                        class="{{ ng_var('tab.classId') }}"
                        context-menu="context(tab)"
                        data-target="tabContextMenu"
                    >
                        <div class="item-hover-over-indicator"></div>
                        <a>
                            <i class="" ng-class="{
                                'fa fa-envelope':  tab.tabType == 'ticket',
                                'fa fa-user':      tab.tabType == 'person',
                                'fa fa-users':     tab.tabType == 'organization',
                                'fa fa-file-text': tab.tabType == 'article',
                                'fa fa-download':  tab.tabType == 'download',
                                'fa fa-list-alt':  tab.tabType == 'news',
                                'fa fa-th-list':   tab.tabType == 'feedback',
                                'fa fa-comment':   tab.tabType == 'userchat'
                            }"></i>{{ ng_var('tab.title') }}
                        </a>
                        <span class="bound-fade"></span>
                        <span class="close"></span>
                    </li>
                </ul>
            </div>
        </div>

        <div id="tabNavSelectorRight">
            <a class="tabSlideRight"></a>
        </div>

        <div class="dropdown" id="tabContextMenu" style="position: fixed;z-index: 3;">
            <ul class="dropdown-menu" role="menu">
                <li ng-show="contextTab">
                    <a class="pointer" role="menuitem" tabindex="1" ng-click="closeCurrent()">
                        {{ phrase('agent.general.tabs_close_current') }}
                    </a>
                </li>
                <li ng-show="tabs.length">
                    <a class="pointer" role="menuitem" tabindex="2" ng-click="closeAll()">
                        {{ phrase('agent.general.tabs_close_all') }}
                    </a>
                </li>
                <li ng-show="contextTab">
                    <a class="pointer" role="menuitem" tabindex="3" ng-click="closeOthers()">
                        {{ phrase('agent.general.tabs_close_others') }}
                    </a>
                </li>
                <li ng-show="tabHistory.length && tabs.length" role="presentation" class="divider"></li>
                <li ng-repeat="tab in tabHistory">
                    <a class="pointer" role="menuitem" tabindex="4" ng-click="reopenTab(tab)">
                        {{ phrase('agent.general.tabs_reopen') }} {{ ng_var('tab.title') }}
                    </a>
                </li>
            </ul>
        </div>
    </div>
</script>
