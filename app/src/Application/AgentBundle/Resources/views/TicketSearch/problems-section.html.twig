{% if app.getSetting('core.problems.enabled') and app.user.hasPerm('agent_problems.view') %}

    <section class="pane-section sla-section" id="problems-section">

        <header>
            <h1>
                <span class="problems-filter-type">
                    {{ phrase('agent.problems.title') }}
                </span>
            </h1>
        </header>

        <article>
            <script type="text/html">
                {% set _url = path('agent_ticketsearch_runproblem', {'problem_id': '0000'}) %}
                <li class="is-nav-item">
                    <div class="item" data-route="listpane:{{ _url }}">
                        <h3></h3>

                        <div class="float-side">
                            <em style="cursor:pointer" data-route="listpane:{{ _url }}"
                                class="counter list-counter">0</em>
                        </div>
                    </div>
                </li>
            </script>
            <ul id="tickets_outline_problems" class="nav-list">

                {% if 0 == open_problems|length and 0 == closed_problems|length %}
                    <li class="no-data">
                        {{ phrase('agent.problems.no_problems_boss') }}
                    </li>
                {% endif %}

                {% for p in open_problems %}
                    <li class="is-nav-item" data-problem-id="{{ p.id }}">

                        {% set _url = path('agent_ticketsearch_runproblem', {'problem_id': p.id}) %}

                        <div class="item" data-route="listpane:{{ _url }}">
                            <h3>{{ p.title }}</h3>

                            <div class="float-side">
                                <em style="cursor:pointer" data-route="listpane:{{ _url }}"
                                    class="counter list-counter">
                                    {{ problem_counts[p.id]|default(0) }}
                                </em>
                            </div>
                        </div>
                    </li>
                {% endfor %}

                {% if closed_problems|length %}
                    <li class="closed-problems-list">
                        <div class="item-form">
                            <div class="select-value-wrap">
                                <div class="select-value">
                                    <label id="nav_closed_problem_label"></label>
                                    <i class="icon-caret-down"></i>
                                </div>
                                <select id="closed_problems_select"
                                        class="dpe_select invisible-trigger problems_select"
                                        data-label-bound="#nav_closed_problem_label"
                                        data-dropdown-css-class="invisible-trigger small filter-list"
                                        data-select-width="165"
                                        data-path="listpane:{{ path('agent_ticketsearch_runproblem', {'problem_id': 0}) }}"
                                        >
                                    <option value="">{{ phrase('agent.problems.closed_problems') }}</option>
                                    {% for p in closed_problems %}
                                        <option value="{{ p.id }}" data-problem-id="{{ p.id }}">{{ p.title }}
                                            ({{ problem_counts[p.id]|default(0) }})
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                    </li>
                {% endif %}


            </ul>
        </article>
    </section>
{% endif %}