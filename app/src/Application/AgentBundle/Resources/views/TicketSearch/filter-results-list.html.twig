{% import 'AgentBundle:Common:macro-flagname.html.twig' as flagnamer %}
<script>
{% if filter %}
	{% if filter.sys_name %}
		pageMeta.url_fragment = '{{ url_fragment('agent_ticketsearch_runnamedfilter', {'filter_name': filter.sys_name}) }}';
	{% else %}
		pageMeta.url_fragment = '{{ url_fragment('agent_ticketsearch_runfilter', {'filter_id': filter.id}) }}';
	{% endif %}

	pageMeta.filter_id = {{filter_id}};
	pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.TicketFilter';
	pageMeta.refreshUrl = '{{ path('agent_ticketsearch_runfilter', {'filter_id': filter_id}) }}?set_group_term={{ set_group_term }}&set_group_option={{ set_group_option }}&view_name={{ view_name }}';
	pageMeta.viewTypeUrl = '{{ path('agent_ticketsearch_runfilter', {'filter_id': filter_id}) }}?set_group_term={{ set_group_term }}&set_group_option={{ set_group_option }}&view_type=$view_type&view_name={{ view_name }}';
{% else %}
	pageMeta.cache_id = {{cache_id}};
	pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.TicketCustomFilter';
	pageMeta.refreshUrl = '{{ path('agent_ticketsearch_runcustomfilter', {'cache_id': cache_id}) }}?set_group_term={{ set_group_term }}&set_group_option={{ set_group_option }}&view_name={{ view_name }}';
	pageMeta.viewTypeUrl = '{{ path('agent_ticketsearch_runcustomfilter', {'cache_id': cache_id}) }}?set_group_term={{ set_group_term }}&set_group_option={{ set_group_option }}&view_type=$view_type&view_name={{ view_name }}';
{% endif %}

pageMeta.saveListPrefsUrl = '{{ path('agent_ajax_save_prefs') }}';
pageMeta.getMacroUrl = '{{ path('agent_ticketsearch_ajax_get_macro') }}?macro_id=$macro_id';
pageMeta.deleteTicketUrl = '{{ path('agent_ticketsearch_ajax_delete_tickets') }}';
pageMeta.viewTicketUrl = '{{ path('agent_ticket_view', {'ticket_id': '0000'})|replace({'0000': '$ticket_id'}) }}';
pageMeta.loadFirst = {% if load_first %}true{% else %}false{% endif %};
pageMeta.fetchResultsUrl = '{{ path('agent_ticketsearch_getpage', {'view_type': 'list', 'view_name': view_name}) }}';
pageMeta.viewType = 'list';
pageMeta.view_name = '{{ view_name }}';

{% if not tickets %}
	pageMeta.noResults = true;
{% endif %}

pageMeta.perPage = {{ per_page }};
pageMeta.ticketResultIds = {{ ticket_ids|json_encode|raw }};

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
<section class="dp-overlay">
	<header>
		<div class="controls">
			<a class="order-by-menu-trigger clean-white arrow menu-fitted">{{ phrase('agent.ordered_by') }} <span class="label">{{ order_by_summary }}</span><em></em></a>
			<a class="group-by-menu-trigger clean-white arrow menu-fitted">{{ phrase('agent.grouped_by') }} <span class="label">{{ grouping_summary|default(phrase('agent.none')) }}</span><em></em></a>
			<a class="display-options-trigger clean-white">{{ phrase('agent.display_options') }}</a>
		</div>

		<ul style="display: none" class="order-by-menu">
			<li data-order-by="urgency">{{ phrase('agent.urgency') }}</li>
			<li data-order-by="date_created">{{ phrase('agent.date_opened') }}</li>
			<li data-order-by="priority">{{ phrase('agent.priority') }}</li>
		</ul>
		<ul style="display: none" class="group-by-menu">
			<li data-group-by="">{{ phrase('agent.none') }}</li>
			<li data-group-by="department">{{ phrase('agent.department') }}</li>
			{% if app.getSetting('core.use_ticket_category') %}<li data-group-by="category">{{ phrase('agent.category') }}</li>{% endif %}
			{% if app.getSetting('core.use_ticket_category') %}<li data-group-by="priority">{{ phrase('agent.priority') }}</li>{% endif %}
			{% if app.getSetting('core.use_ticket_workflow') %}<li data-group-by="workflow">{{ phrase('agent.workflow') }}</li>{% endif %}
			{% if app.getSetting('core.use_product') %}<li data-group-by="product">{{ phrase('agent.product') }}</li>{% endif %}
			<li data-group-by="organization">{{ phrase('agent.organization') }}</li>
			<li data-group-by="language">{{ phrase('agent.language') }}</li>
			<li data-group-by="urgency">{{ phrase('agent.urgency') }}</li>
			<li data-group-by="agent">{{ phrase('agent.agent') }}</li>
			{% if app.getSetting('core.use_agent_team') %}<li data-group-by="agent_team">{{ phrase('agent.agent_team') }}</li>{% endif %}
			<li data-group-by="time_waiting">{{ phrase('agent.time_waiting') }}</li>
			<li data-group-by="total_user_waiting">{{ phrase('agent.total_time_waiting') }}</li>
			<li data-group-by="date_created">{{ phrase('agent.date_opened') }}</li>
		</ul>

		<span class="close close-trigger"></span>
		<h1>{{ phrase('agent.tickets') }}</h1>
	</header>
	<article>
		{% include 'AgentBundle:TicketSearch:filter-display-options-overlay.html.twig' with {show_all: 1 } %}

		{% include 'AgentBundle:TicketSearch:filter-grouping-bar.html.twig' %}

		<div class="table-result-list">
			<table cellspacing="0" width="100%">
				{% include 'AgentBundle:TicketSearch:part-results-list.html.twig' %}
			</table>
		</div>
	</article>
	<div class="full-loading" style="display: none">
		<em>{{ phrase('agent.loading') }}</em>
	</div>
	<footer class="is-ticket-list bottom-action-bar">
			<div class="check-count selection-bar">
				{{ phrase('agent.x_selected', {'num_placeholder': '<span class="selected-count">0</span>'}) }}

				<button class="clean-white perform-actions-trigger">
					<span>{{ phrase('agent.perform_actions') }}</span>
				</button>
			</div>
			<div class="pagecontrols results-nav">
				<div class="cursor">
                    <a target="_blank"
                       href="{{ path('agent_ticketsearch_runfilter', {'filter_id': filter_id}) }}?view_type=csv&set_group_term={{ set_group_term }}&set_group_option={{ set_group_option }}&view_name={{ view_name }}">
                        <button class="clean-white">
                            <span>{{ phrase('agent.tickets.export_to_csv') }}</span>
                        </button>
                    </a>
                    {% set phrase_part1 %}
                    <span class="results-showing-count" id="{{baseId}}_showing_count"></span>
                    {% endset %}
                    {% set phrase_part2 %}
                    <span class="results-total-count" id="{{baseId}}_total_count">{{ ticket_ids|length }}</span>
                    {% endset %}
                    {{ phrase('agent.showing_results_x_of_y', {'count':ticket_ids|length,'display_count':phrase_part1,'size':phrase_part2}) }}
				</div>
				{% if ticket_ids|length > per_page %}
					<ul class="pagenav no-prev">
						<li class="prev"></li>
						<li class="next"></li>
					</ul>
				{% endif %}
			</div>

        	{% include 'AgentBundle:TicketSearch:filter-massactions-overlay.html.twig' %}
        </div>
	</footer>
</section>