<li class="ticket {% if is_new_ticket %}new-ticket{% elseif is_new_agent_reply or is_new_user_reply %}new-reply{% else %}update{% endif %}" data-type="tickets" data-route="ticket:{{ path('agent_ticket_view', {'ticket_id': ticket.id}) }}" data-route-notabreload="1">
	<em class="dismiss"></em>
	<time class="timeago"></time>
	<a><i class="row-icon"></i> {{ ticket.subject }}</a>
	<div class="info">
		{% if is_new_ticket %}
            {{ phrase('agent.chat.new_ticket_by', {'name':performer.name,'email':performer.primary_email_address}) }}
		{% elseif is_new_agent_reply %}
            {{ phrase('agent.chat.new_agent_reply_by', {'name':performer.name}) }}
		{% elseif is_new_user_reply %}
            {{ phrase('agent.chat.new_user_reply_by', {'name':performer.name}) }}
		{% else %}
			{% for log in log_items %}
				{% include 'AgentBundle:TicketSearch:notify-row-log.html.twig' %}
			{% endfor %}
		{% endif %}
	</div>
</li>
