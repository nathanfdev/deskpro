<div class="list-pane-instance">
	<div class="list-pane-header">
		<h1><i class="icon-dp-ticket"></i> {{ ng_bind('ticketCount') }} Tickets</h1>
	</div>
	<div class="list-pane-content list-pane-view with-header with-subheader with-footer" ng-class="{'with-alert-subheader': hasUnloadedUpdates}">
		<header class="view-header" ng-non-bindable>
			{% include 'AgentBundle:TicketSearch:filter-display-options-overlay.html.twig' %}
			{% include 'AgentBundle:TicketSearch:filter-control-bar.html.twig' %}
		</header>
		<header class="view-subheader">
			<header class="list-selection-bar">
				<input class="selection-control" type="checkbox" ng-model="checkedTicketsToggle" ng-change="checkAllTickets(checkedTicketsToggle)" />
				{{ phrase('agent.general.x_selected', {'num_placeholder': '{{ checkedTicketsCount }}'}, true) }}

				<div class="realtime-indicator" ng-class="{'realtime-on': realtime}">
					<span class="status" ng-click="toggleRealtimeUpdates();">
						<div ng-show="realtime">
							<em>Real-time updates are enabled</em>
							<i class="icon-retweet"></i>
						</div>
						<div ng-show="!realtime">
							<em>Real-time updates are disabled</em>
							<i class="icon-retweet"></i>
						</div>
					</span>
				</div>

				<div ng-non-bindable>
					{% include 'AgentBundle:TicketSearch:filter-massactions-overlay.html.twig' %}
				</div>
			</header>
		</header>
		<header class="view-alert-subheader" ng-show="hasUnloadedUpdates">
			There have been updates since you loaded this list.
			<button class="clean-white" ng-click="refreshCursor();">
				<span ng-hide="refreshCursorLoading">Refresh List</span>
				<span ng-show="refreshCursorLoading"><i class="spinner-flat"></i></span>
			</button>
		</header>
		<article class="view-body">
			<div ng-non-bindable>
				{% include 'AgentBundle:TicketSearch:filter-grouping-bar.html.twig' %}
			</div>

			<div style="padding: 20px; text-align: center;" ng-show="refreshCursorLoading">
				<i class="spinner-circle-32"></i>
			</div>

			<section class="list-listing" ng-hide="refreshCursorLoading">
				<div
					bindonce
					ng-repeat="ticket in tickets track by ticket.id"
				>
					<script type="text/plain" dp-tpl tpl-id="ticket_list_row" attach-parent watch="['display_fields']" watch-deep="['ticket']">
						{% include 'AgentBundle:TicketSearch:ticket-list-row.html.twig' %}
					</script>
				</div>
			</section>

		</article>
		<footer class="view-footer results-nav">
			<div class="cursor">
				Showing {{ ng_bind('pageCursorStart') }} to {{ ng_bind('pageCursorEnd') }} of {{ ng_bind('ticketCount') }}
			</div>
			<ul class="pagenav" ng-class="{'no-prev': !hasPrevPage, 'no-next': !hasNextPage}">
				<li class="prev" ng-click="loadPrevCursorPage();"></li>
				<li class="next" ng-click="loadNextCursorPage();"></li>
			</ul>
		</footer>
	</div>
</div>