<div class="list-pane-instance">
	<div class="list-pane-header">
		<h1><i class="icon-dp-ticket"></i> Tickets</h1>
	</div>
	<div class="list-pane-content list-pane-view with-header with-subheader with-footer">
		<header class="view-header">
			{% include 'AgentBundle:TicketSearch:filter-control-bar.html.twig' %}
		</header>
		<header class="view-subheader">
			{% include 'AgentBundle:TicketSearch:filter-massactions-bar.html.twig' %}
		</header>
		<article class="view-body">


			<section class="list-listing">

				<article
					ng-repeat="ticket in tickets"
					class="row-item ticket-{{ ng_var('ticket.id') }}"
					data-ticket-id="{{ ng_var('ticket.id') }}"
					data-route="ticket:{{ path('agent_ticket_view', {'ticket_id': '0000'})|replace({'0000': '{{ticket.id}}'}) }}"
					data-route-title="@selector(a.subject)"
					data-route-openclass="open"
				>
					<div class="item-hover-over-indicator"></div>
					<div class="loading-arrow">{{ phrase('agent.general.loading') }}</div>
					<input type="checkbox" class="item-select" ng-model="checked[ticket.id]" />
					<div class="top-row">
						<div class="top-row-left">
							<h3>
								<span class="obj-id">#{{ ng_var('ticket.id') }}</span>
								<a class="subject click-through">
									{{ ng_var('ticket.subject') }}
								</a>
							</h3>
						</div>
						<div class="top-row-right">
							<div class="bound-fade"></div>
							<div class="on-hold" ng-show="ticket.is_hold">{{ phrase('agent.tickets.on_hold') }}</div>
							<div class="status-pill status urgency-{{ ng_var('ticket.urgency') }} {{ ng_var("ticket.status_code") }}">
								<label>{{ ng_var('ticket.status_code') }}</label>
								<i ng-show="ticket.status == 'awaiting_agent'" class="ticket-urgency" data-urgency="{{ ticket.urgency }}">{{ ticket.urgency }}</i>
							</div>
							<span ng-show="ticket.agent" class="tipped agent-inline-icon" title="{{ ng_var('ticket.agent.display_name') }}"></span>
							<br class="clear" />
						</div>
					</div>
					<div class="userinfo">
						<a class="name click-through" data-route="person:{{ path('agent_people_view', {'person_id': '0000'})|replace({'0000': '{{ticket.person.id}}'}) }}" data-route-title="@selector(.person-tip)">
							<span class="with-icon" data-person-id="{{ ng_var('ticket.person.id') }}">{{ ng_var('ticket.person.display_name') }}</span></a>
							<span class="org" ng-if="ticket.person.organization">
								(<span ng-if="ticket.person.organization_position">{{ ng_var('ticket.person.organization_position') }}, </span>{{ ng_var('ticket.person.organization.name') }})
							</span>
							<span ng-if="ticket.person.primary_email" class="email"><b class="person-{{ ng_var('ticket.person.id') }}-pemail">{{ ng_var('ticket.person.primary_email.email') }}</b></span>
						<div class="bound-fade"></div>
					</div>
				</article>

			</section>

		</article>
		<footer class="view-footer results-nav">
			<ul class="pagenav no-prev">
				<li class="prev"></li>
				<li class="next"></li>
			</ul>
		</footer>
	</div>
	{% include 'AgentBundle:TicketSearch:filter-display-options-overlay.html.twig' %}
</div>