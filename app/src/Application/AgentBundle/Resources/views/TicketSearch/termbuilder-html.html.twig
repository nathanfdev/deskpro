<div class="type" title="{{ phrase('agent.ticketsearch.search_all_tickets') }}" data-rule-type="archive_search">
	<div class="op">
		<input type="hidden" name="op" value="is" />
	</div>
	<div class="options">
		<input type="hidden" name="archive_search" value="1" />
		<span>{{ phrase('agent.ticketsearch.search_all_tickets_including_tickets_that_are_resolved') }}</span>
	</div>
</div>
<div class="type" title="{{ phrase('agent.subject') }}" data-rule-type="subject">
	<div class="op">
		<select name="op">
			<option value="is">{{ phrase('agent.is') }}</option>
			<option value="not">{{ phrase('agent.is_not') }}</option>
			<option value="contains">{{ phrase('agent.contains') }}</option>
			<option value="not_contains">{{ phrase('agent.does_not_contain') }}</option>
		</select>
	</div>
	<div class="options">
		<input type="text" name="subject" value="" />
	</div>
</div>
<div class="type" title="{{ phrase('agent.labels') }}" data-rule-type="label">
	<div class="op">
		<select name="op">
			<option value="is">{{ phrase('agent.includes_label') }}</option>
			<option value="not">{{ phrase('agent.does_not_include_label') }}</option>
		</select>
	</div>
	<div class="options">
		<input type="text" name="label" value="" />
	</div>
</div>
<div class="type" title="{{ phrase('agent.assigned_agent') }}" data-rule-type="agent">
	<div class="op">
		<select name="op">
			<option value="is">{{ phrase('agent.is') }}</option>
			<option value="not">{{ phrase('agent.is_not') }}</option>
		</select>
	</div>
	<div class="options">
		<select name="agent">
			<option value="0">{{ phrase('agent.unassigned') }}</option>
			<option value="-1">{{ phrase('agent.me') }}</option>
			{% for id,label in term_options.agents %}
				<option value="{{id}}">{{label}}</option>
			{% endfor %}
		</select>
	</div>
</div>
<div class="type" title="{{ phrase('agent.ticketsearch.participants') }}" data-rule-type="participant">
	<div class="op">
		<select name="op">
			<option value="is">{{ phrase('agent.include') }}</option>
			<option value="not">{{ phrase('agent.does_not_include') }}</option>
		</select>
	</div>
	<div class="options">
		<select name="agent">
			<option value="-1">{{ phrase('agent.me') }}</option>
			{% for id,label in term_options.agents %}
				<option value="{{id}}">{{label}}</option>
			{% endfor %}
		</select>
	</div>
</div>
{% if term_options.agent_teams %}
	<div class="type" title="{{ phrase('agent.agent_team') }}" data-rule-type="agent_team">
		<div class="options">
			<div class="op">
				<select name="op">
					<option value="is">{{ phrase('agent.is') }}</option>
					<option value="not">{{ phrase('agent.is_not') }}</option>
				</select>
			</div>
			<select name="agent_team">
				<option value="0">{{ phrase('agent.no_team') }}</option>
				<option value="-1">{{ phrase('agent.ticketsearch.any_of_my_teams') }}</option>
				{% for id,title in term_options.agent_teams %}
					<option value="{{id}}">{{title}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
{% endif %}
<div class="type" title="{{ phrase('agent.status') }}" data-rule-type="status">
	<div class="op">
		<select name="op">
			<option value="is">{{ phrase('agent.is') }}</option>
			<option value="not">{{ phrase('agent.is_not') }}</option>
		</select>
	</div>
	<div class="options">
		<select name="status" multiple="multiple" size="6">
			<option value="awaiting_agent">{{ phrase('agent.awaiting_agent') }}</option>
			<option value="awaiting_user">{{ phrase('agent.awaiting_user') }}</option>
			<option value="resolved">{{ phrase('agent.resolved') }}</option>
			<option value="closed">{{ phrase('agent.closed') }}</option>
			<option value="hidden">{{ phrase('agent.hidden_awaiting_validating_spam') }}</option>
		</select>
	</div>
</div>
{% if term_options.products %}
	<div class="type" title="{{ phrase('agent.product') }}" data-rule-type="product">
		<div class="op">
			<select name="op">
				<option value="is">{{ phrase('agent.is') }}</option>
				<option value="not">{{ phrase('agent.is_not') }}</option>
			</select>
		</div>
		<div class="options">
			<select name="product">
				{% for id,label in term_options.products %}
					<option value="{{id}}">{{label}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
{% endif %}
{% if term_options.departments %}
	<div class="type" title="{{ phrase('agent.department') }}" data-rule-type="department">
		<div class="op">
			<select name="op">
				<option value="is">{{ phrase('agent.is') }}</option>
				<option value="not">{{ phrase('agent.is_not') }}</option>
			</select>
		</div>
		<div class="options">
			<select name="department">
				{% for id,label in term_options.departments %}
					<option value="{{id}}">{{label}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
{% endif %}
{% if term_options.categories %}
	<div class="type" title="{{ phrase('agent.category') }}" data-rule-type="category">
		<div class="op">
			<select name="op">
				<option value="is">{{ phrase('agent.is') }}</option>
				<option value="not">{{ phrase('agent.is_not') }}</option>
			</select>
		</div>
		<div class="options">
			<select name="category">
				{% for id,label in term_options.categories %}
					<option value="{{id}}">{{label}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
{% endif %}
{% if term_options.priorities %}
	<div class="type" title="{{ phrase('agent.priority') }}" data-rule-type="priority">
		<div class="op">
			<select name="op">
				<option value="is">{{ phrase('agent.is') }}</option>
				<option value="not">{{ phrase('agent.is_not') }}</option>
				<option value="lt">{{ phrase('agent.is_less_than') }}</option>
				<option value="gt">{{ phrase('agent.is_greater_than') }}</option>
			</select>
		</div>
		<div class="options">
			<select name="priority">
				{% for id,label in term_options.priorities %}
					<option value="{{id}}">{{label}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
{% endif %}
<div class="type" title="{{ phrase('agent.originated_interface') }}" data-rule-type="creation_system">
	<div class="op">
		<select name="op">
			<option value="is">{{ phrase('agent.is') }}</option>
			<option value="not">{{ phrase('agent.is_not') }}</option>
		</select>
	</div>
	<div class="options">
		<select name="creation_system">
			<option value="web">{{ phrase('agent.web_interface') }}</option>
			<option value="web.person">{{ phrase('agent._by_user') }}</option>
			<option value="web.agent">{{ phrase('agent._by_agent_on_behalf_of_user') }}</option>
			<option value="gateway">{{ phrase('agent.email') }}</option>
		</select>
	</div>
</div>
{% if term_options.gateway_names %}
<div class="type" title="{{ phrase('agent.ticketsearch.receiving_gateway_account') }}" data-rule-type="receiving_gateway">
	<div class="op">
		<select name="op">
			<option value="is">{{ phrase('agent.is') }}</option>
			<option value="not">{{ phrase('agent.is_not') }}</option>
		</select>
	</div>
	<div class="options">
		<select name="receiving_gateway">
			{% for id,label in term_options.gateway_names %}
				<option value="{{id}}">{{label}}</option>
			{% endfor %}
		</select>
	</div>
</div>
{% endif %}
{% if term_options.ticket_workflows %}
	<div class="type" title="{{ phrase('agent.workflow') }}" data-rule-type="workflow">
		<div class="op">
			<select name="op">
				<option value="is">{{ phrase('agent.is') }}</option>
				<option value="not">{{ phrase('agent.is_not') }}</option>
			</select>
		</div>
		<div class="options">
			<select name="workflow">
				{% for id,label in term_options.ticket_workflows %}
					<option value="{{id}}">{{label}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
{% endif %}
{% if term_options.custom_ticket_fields %}
	{% set op_lang = {'is': phrase('agent.is'), 'not': phrase('agent.is_not'), 'contains': 'has', 'notcontains': 'does not have', 'gt': phrase('agent.is_greater_than'), 'lt': phrase('agent.is_less_than')} %}
	{% for field in term_options.custom_ticket_fields %}
		<div class="type" title="{{ phrase('agent.ticketsearch.ticket_field_name', {'field':field.field_def.title}) }}" data-rule-type="ticket_field[{{field.field_def.id}}]">
			<div class="op">
				<select name="op">
					{% for op in field.field_def.search_capabilities %}
						<option value="{{op}}">{{op_lang[op]}}</option>
					{% endfor %}
				</select>
			</div>
			<div class="options">
				{{ form_widget(field.formView) }}
			</div>
		</div>
	{% endfor %}
{% endif %}