<div class="type" title="{{ phrase('agent.tickets.search_all_tickets') }}" data-rule-type="archive_search">
	<div class="op">
		<input type="hidden" name="op" value="is" />
	</div>
	<div class="options">
		<input type="hidden" name="archive_search" value="1" />
		<span>{{ phrase('agent.tickets.explain_search_all_tickets') }}</span>
	</div>
</div>
<div class="type" title="{{ phrase('agent.general.subject') }}" data-rule-type="subject">
	<div class="op">
		<select name="op">
			<option value="is">{{ phrase('agent.general.is') }}</option>
			<option value="not">{{ phrase('agent.general.is_not') }}</option>
			<option value="contains">{{ phrase('agent.general.contains') }}</option>
			<option value="not_contains">{{ phrase('agent.general.does_not_contain') }}</option>
		</select>
	</div>
	<div class="options">
		<input type="text" name="subject" value="" />
	</div>
</div>
<div class="type" title="{{ phrase('agent.general.labels') }}" data-rule-type="label">
	<div class="op">
		<select name="op">
			<option value="is">{{ phrase('agent.general.includes_label') }}</option>
			<option value="not">{{ phrase('agent.general.does_not_include_label') }}</option>
		</select>
	</div>
	<div class="options">
		<input type="text" name="label" value="" />
	</div>
</div>
<div class="type" title="{{ phrase('agent.general.assigned_agent') }}" data-rule-type="agent">
	<div class="op">
		<select name="op">
			<option value="is">{{ phrase('agent.general.is') }}</option>
			<option value="not">{{ phrase('agent.general.is_not') }}</option>
		</select>
	</div>
	<div class="options">
		<select name="agent">
			<option value="0">{{ phrase('agent.general.unassigned') }}</option>
			<option value="-1">{{ phrase('agent.general.me') }}</option>
			{% for id,label in term_options.agents %}
				<option value="{{id}}">{{label}}</option>
			{% endfor %}
		</select>
	</div>
</div>
<div class="type" title="{{ phrase('agent.tickets.participants') }}" data-rule-type="participant">
	<div class="op">
		<select name="op">
			<option value="is">{{ phrase('agent.general.include') }}</option>
			<option value="not">{{ phrase('agent.general.does_not_include') }}</option>
		</select>
	</div>
	<div class="options">
		<select name="agent">
			<option value="-1">{{ phrase('agent.general.me') }}</option>
			{% for id,label in term_options.agents %}
				<option value="{{id}}">{{label}}</option>
			{% endfor %}
		</select>
	</div>
</div>
{% if term_options.agent_teams %}
	<div class="type" title="{{ phrase('agent.general.agent_team') }}" data-rule-type="agent_team">
		<div class="options">
			<div class="op">
				<select name="op">
					<option value="is">{{ phrase('agent.general.is') }}</option>
					<option value="not">{{ phrase('agent.general.is_not') }}</option>
				</select>
			</div>
			<select name="agent_team">
				<option value="0">{{ phrase('agent.general.no_team') }}</option>
				<option value="-1">{{ phrase('agent.tickets.any_of_my_teams') }}</option>
				{% for id,title in term_options.agent_teams %}
					<option value="{{id}}">{{title}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
{% endif %}
<div class="type" title="{{ phrase('agent.general.status') }}" data-rule-type="status">
	<div class="op">
		<select name="op">
			<option value="is">{{ phrase('agent.general.is') }}</option>
			<option value="not">{{ phrase('agent.general.is_not') }}</option>
		</select>
	</div>
	<div class="options">
		<select name="status" multiple="multiple" size="6">
			<option value="awaiting_agent">{{ phrase('agent.tickets.status_awaiting_agent') }}</option>
			<option value="awaiting_user">{{ phrase('agent.tickets.status_awaiting_user') }}</option>
			<option value="resolved">{{ phrase('agent.tickets.status_resolved') }}</option>
			<option value="closed">{{ phrase('agent.general.closed') }}</option>
			<option value="hidden">{{ phrase('agent.general.hidden_awaiting_validating_spam') }}</option>
		</select>
	</div>
</div>
{% if term_options.products %}
	<div class="type" title="{{ phrase('agent.general.product') }}" data-rule-type="product">
		<div class="op">
			<select name="op">
				<option value="is">{{ phrase('agent.general.is') }}</option>
				<option value="not">{{ phrase('agent.general.is_not') }}</option>
			</select>
		</div>
		<div class="options">
			<select name="product">
				{% for id,label in term_options.products %}
					<option value="{{id}}">{{label}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
{% endif %}
{% if term_options.departments %}
	<div class="type" title="{{ phrase('agent.general.department') }}" data-rule-type="department">
		<div class="op">
			<select name="op">
				<option value="is">{{ phrase('agent.general.is') }}</option>
				<option value="not">{{ phrase('agent.general.is_not') }}</option>
			</select>
		</div>
		<div class="options">
			<select name="department">
				{% for id,label in term_options.departments %}
					<option value="{{id}}">{{label}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
{% endif %}
{% if term_options.categories %}
	<div class="type" title="{{ phrase('agent.general.category') }}" data-rule-type="category">
		<div class="op">
			<select name="op">
				<option value="is">{{ phrase('agent.general.is') }}</option>
				<option value="not">{{ phrase('agent.general.is_not') }}</option>
			</select>
		</div>
		<div class="options">
			<select name="category">
				{% for id,label in term_options.categories %}
					<option value="{{id}}">{{label}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
{% endif %}
{% if term_options.priorities %}
	<div class="type" title="{{ phrase('agent.general.priority') }}" data-rule-type="priority">
		<div class="op">
			<select name="op">
				<option value="is">{{ phrase('agent.general.is') }}</option>
				<option value="not">{{ phrase('agent.general.is_not') }}</option>
				<option value="lt">{{ phrase('agent.general.is_less_than') }}</option>
				<option value="gt">{{ phrase('agent.general.is_greater_than') }}</option>
			</select>
		</div>
		<div class="options">
			<select name="priority">
				{% for id,label in term_options.priorities %}
					<option value="{{id}}">{{label}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
{% endif %}
<div class="type" title="{{ phrase('agent.general.originated_interface') }}" data-rule-type="creation_system">
	<div class="op">
		<select name="op">
			<option value="is">{{ phrase('agent.general.is') }}</option>
			<option value="not">{{ phrase('agent.general.is_not') }}</option>
		</select>
	</div>
	<div class="options">
		<select name="creation_system">
			<option value="web">{{ phrase('agent.general.web_interface') }}</option>
			<option value="web.person">-- {{ phrase('agent.general.by_user') }}</option>
			<option value="web.agent">-- {{ phrase('agent.general.by_agent_for_user') }}</option>
			<option value="gateway">{{ phrase('agent.general.email') }}</option>
		</select>
	</div>
</div>
{% if term_options.gateway_names %}
<div class="type" title="{{ phrase('agent.tickets.receiving_gateway_account') }}" data-rule-type="receiving_gateway">
	<div class="op">
		<select name="op">
			<option value="is">{{ phrase('agent.general.is') }}</option>
			<option value="not">{{ phrase('agent.general.is_not') }}</option>
		</select>
	</div>
	<div class="options">
		<select name="receiving_gateway">
			{% for id,label in term_options.gateway_names %}
				<option value="{{id}}">{{label}}</option>
			{% endfor %}
		</select>
	</div>
</div>
{% endif %}
{% if term_options.ticket_workflows %}
	<div class="type" title="{{ phrase('agent.general.workflow') }}" data-rule-type="workflow">
		<div class="op">
			<select name="op">
				<option value="is">{{ phrase('agent.general.is') }}</option>
				<option value="not">{{ phrase('agent.general.is_not') }}</option>
			</select>
		</div>
		<div class="options">
			<select name="workflow">
				{% for id,label in term_options.ticket_workflows %}
					<option value="{{id}}">{{label}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
{% endif %}
{% if term_options.custom_ticket_fields %}
	{% set op_lang = {'is': phrase('agent.general.is'), 'not': phrase('agent.general.is_not'), 'contains': 'has', 'notcontains': 'does not have', 'gt': phrase('agent.general.is_greater_than'), 'lt': phrase('agent.general.is_less_than')} %}
	{% for field in term_options.custom_ticket_fields %}
		<div class="type" title="{{ phrase('agent.tickets.ticket_field_name', {'field':field.field_def.title}) }}" data-rule-type="ticket_field[{{field.field_def.id}}]">
			<div class="op">
				<select name="op">
					{% for op in field.field_def.search_capabilities %}
						<option value="{{op}}">{{op_lang[op]}}</option>
					{% endfor %}
				</select>
			</div>
			<div class="options">
				{{ form_widget(field.formView) }}
			</div>
		</div>
	{% endfor %}
{% endif %}