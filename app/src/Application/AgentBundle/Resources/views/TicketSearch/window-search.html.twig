<section class="source-pane-search">

	{##################################################################################################################}
	{# Status #}
	{##################################################################################################################}

	<div class="input-row">
		<div class="input-row-title">
			<strong>Status</strong>
		</div>
		<div class="input-row-body">
			{% set elid = el_uid() %}
			<select class="dp-select-widget-simple" name="status" multiple="multiple" data-target-menu="#{{ elid }}_menu">
				<option selected="selected" value="awaiting_agent">Awaiting Agent</option>
				<option selected="selected" value="awaiting_user">Awaiting User</option>
				<option value="resolved">Resolved</option>
				<option value="closed">Archived</option>
				<option value="hidden.awaiting_validation">Awaiting Validation</option>
				<option value="hidden.spam">Spam</option>
				<option value="hidden.deleted">Deleted</option>
			</select>
			<div class="source-pane-select-menu" id="{{ elid }}_menu">
				<i class="icon-caret-up"></i>
				<ul class="checkbox-list">
					<li><label><input class="widget-val" type="checkbox" value="awaiting_agent" /> Awaiting Agent</label></li>
					<li><label><input class="widget-val" type="checkbox" value="awaiting_user" /> Awaiting User</label></li>
					<li><label><input class="widget-val" type="checkbox" value="resolved" /> Resolved</label></li>
					<li><label><input class="widget-val" type="checkbox" value="closed" /> Closed</label></li>
				</ul>

				<div class="alt-options">
					<strong>Hidden Tickets:</strong>
					<ul class="checkbox-list">
						<li><label><input class="widget-val" type="checkbox" value="hidden.awaiting_validation" /> Awaiting Validation</label></li>
						<li><label><input class="widget-val" type="checkbox" value="hidden.spam" /> Spam</label></li>
						<li><label><input class="widget-val" type="checkbox" value="hidden.deleted" /> Deleted</label></li>
					</ul>
				</div>
			</div>
		</div>
	</div>

	{##################################################################################################################}
	{# Agent #}
	{##################################################################################################################}

	<div class="input-row">
		<div class="input-row-title">
			<strong>Agent</strong>
		</div>
		<div class="input-row-body">
			{% set elid = el_uid() %}
			<select class="dp-select-widget-simple" name="status" multiple="multiple" data-target-menu="auto">
				<optgroup label="Agents">
					<option selected="selected" value="agent.{{ app.user.id }}">Me</option>
					{% for agent in app.getDataRepository('Agent').getAgents() if agent.id != app.user.id %}
						<option value="{{ agent.id }}">{{ agent.display_name }}</option>
					{% endfor %}
				</optgroup>
				<optgroup label="Agent Teams">
					{% for team in app.getDataRepository('AgentTeam').getTeams() %}
						<option value="team.{{ team.id }}">{{ team.name }}</option>
					{% endfor %}
				</optgroup>
			</select>
		</div>
	</div>

	{##################################################################################################################}
	{# Ticket Field #}
	{##################################################################################################################}

	<div class="input-row">
		<div class="input-row-title">
			<strong>Ticket Field</strong>
		</div>
		<div class="input-row-body">
			<button class="btn-value trigger-open-panel" data-panel-id="panel-ticket-fields">Choose</button>
		</div>
	</div>

	<div class="source-pane-search-panel panel-ticket-fields">
		{% include 'AgentBundle:TicketSearch:window-search-fields.html.twig' %}
	</div>

	{##################################################################################################################}
	{# Subject #}
	{##################################################################################################################}

	<div class="input-row">
		<div class="input-row-title">
			<strong>Subject</strong>
		</div>
		<div class="adv-btn trigger-open-panel" data-panel-id="panel-ticket-subject"><i class="icon-cog"></i></div>
		<div class="input-row-body with-adv">
			<div class="text-value">
				<div class="value"></div>
			</div>
		</div>
	</div>

	{% set elid = el_uid() %}
	<div class="source-pane-search-panel panel-ticket-subject">
		<div class="pane-rows-wrap" id="{{ elid }}_pane_rows">
			<div class="pane-row row-orig" id="{{ elid }}_orig_row">
				<div class="sep-row">
					<div class="line"></div>
					<strong>and</strong>
				</div>
				<div class="remove-row-btn trigger-remove-row"><i class="icon-minus-sign"></i></div>
				<table class="layout-table v-middle" width="100%">
					<tr>
						<td width="80">Subject</td>
						<td>
							<input class="full-width" type="text" name="search_subject_string[]" placeholder="Enter search words" />
						</td>
					</tr>
					<tr>
						<td>&nbsp;</td>
						<td>
							<select class="dp-select-widget-simple" name="search_subject_op[]" data-target-menu="auto" data-menu-addclass="no-caret">
								<option selected="selected" value="is">contains</option>
								<option value="not">does not contain</option>
							</select>
							<select class="dp-select-widget-simple" name="search_subject_type[]" data-target-menu="auto" data-menu-addclass="no-caret">
								<option value="and">all words</option>
								<option value="or">any word</option>
								<option value="phrase">phrase</option>
							</select>
						</td>
					</tr>
				</table>
			</div>
		</div>
		<div class="add-row">
			<div class="add-row-btn trigger-clone-row" data-target="#{{ elid }}_orig_row" data-target-list="#{{ elid }}_pane_rows"><i class="icon-plus-sign"></i></div>
		</div>
	</div>

	{##################################################################################################################}
	{# Message #}
	{##################################################################################################################}

	<div class="input-row">
		<div class="input-row-title">
			<strong>Message</strong>
		</div>
		<div class="adv-btn trigger-open-panel" data-panel-id="panel-ticket-message"><i class="icon-cog"></i></div>
		<div class="input-row-body with-adv">
			<div class="text-value">
				<div class="value"></div>
			</div>
		</div>
	</div>

	{% set elid = el_uid() %}
	<div class="source-pane-search-panel panel-ticket-message">
		<div class="pane-rows-wrap" id="{{ elid }}_pane_rows">
			<div class="pane-row row-orig" id="{{ elid }}_orig_row">
				<div class="sep-row">
					<div class="line"></div>
					<strong>and</strong>
				</div>
				<div class="remove-row-btn trigger-remove-row"><i class="icon-minus-sign"></i></div>
				<table class="layout-table v-middle" width="100%">
					<tr>
						<td width="80">Message</td>
						<td>
							<input class="full-width" type="text" name="search_message_string[]" placeholder="Enter search words" />
						</td>
					</tr>
					<tr>
						<td>&nbsp;</td>
						<td>
							<select class="dp-select-widget-simple" name="search_message_op[]" data-target-menu="auto" data-menu-addclass="no-caret">
								<option selected="selected" value="is">contains</option>
								<option value="not">does not contain</option>
							</select>
							<select class="dp-select-widget-simple" name="search_message_type[]" data-target-menu="auto" data-menu-addclass="no-caret">
								<option value="and">all words</option>
								<option value="or">any word</option>
								<option value="phrase">phrase</option>
							</select>
						</td>
					</tr>
					<tr>
						<td>By</td>
						<td>
							<select class="dp-select-widget-simple" name="search_message_who[]" data-target-menu="auto" data-menu-addclass="no-caret">
								<option selected="selected" value="0" data-title="An agent or user"></option>
								<option value="agent">An agent</option>
								<option value="user">A user</option>
							</select>
							<input type="text" class="dp-date-input" name="search_message_date[]" placeholder="on dd/mm/yy" />
						</td>
					</tr>
				</table>
			</div>
		</div>
		<div class="add-row">
			<div class="add-row-btn trigger-clone-row" data-target="#{{ elid }}_orig_row" data-target-list="#{{ elid }}_pane_rows"><i class="icon-plus-sign"></i></div>
		</div>
	</div>

	{##################################################################################################################}
	{# User #}
	{##################################################################################################################}

	<div class="input-row">
		<div class="input-row-title">
			<strong>User</strong>
		</div>
		<div class="input-row-body">
			<button class="btn-value trigger-open-panel" data-panel-id="panel-user-fields">Choose</button>
		</div>
	</div>

	<div class="source-pane-search-panel panel-user-fields">
		{% include 'AgentBundle:TicketSearch:window-search-user.html.twig' %}
	</div>

	{##################################################################################################################}
	{# Organization #}
	{##################################################################################################################}

	<div class="input-row">
		<div class="input-row-title">
			<strong>Organization</strong>
		</div>
		<div class="input-row-body">
			<button class="btn-value trigger-open-panel" data-panel-id="panel-org-fields">Choose</button>
		</div>
	</div>

	<div class="source-pane-search-panel panel-org-fields">
		{% include 'AgentBundle:TicketSearch:window-search-org.html.twig' %}
	</div>

	{##################################################################################################################}
	{# Dates and Times #}
	{##################################################################################################################}

	<div class="input-row">
		<div class="input-row-title">
			<strong>Dates &amp; Times</strong>
		</div>
		<div class="input-row-body">
			<button class="btn-value trigger-open-panel" data-panel-id="panel-date-fields">Choose</button>
		</div>
	</div>

	<div class="source-pane-search-panel panel-date-fields">
		{% include 'AgentBundle:TicketSearch:window-search-dates.html.twig' %}
	</div>

	<footer>
		<button class="dp-btn"> Search</button>
	</footer>
</section>