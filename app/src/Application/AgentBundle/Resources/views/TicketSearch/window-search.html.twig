<section class="source-pane-search">

	{##################################################################################################################}
	{# Status #}
	{##################################################################################################################}

	<div class="input-row">
		<div class="input-row-title">
			<strong>Status</strong>
		</div>
		<div class="input-row-body add-to-search">
			{% set elid = el_uid() %}
			<select class="dp-select-widget-simple" name="search_status[]" multiple="multiple" data-target-menu="#{{ elid }}_menu">
				<option selected="selected" value="awaiting_agent">Awaiting Agent</option>
				<option selected="selected" value="awaiting_user">Awaiting User</option>
				<option value="resolved">Resolved</option>
				<option value="closed">Archived</option>
				<option value="hidden.awaiting_validation">Awaiting Validation</option>
				<option value="hidden.spam">Spam</option>
				<option value="hidden.deleted">Deleted</option>
			</select>
			<div class="source-pane-select-menu" id="{{ elid }}_menu">
				<i class="icon-caret-up"></i>
				<ul class="checkbox-list">
					<li><label><input class="widget-val" type="checkbox" value="awaiting_agent" /> Awaiting Agent</label></li>
					<li><label><input class="widget-val" type="checkbox" value="awaiting_user" /> Awaiting User</label></li>
					<li><label><input class="widget-val" type="checkbox" value="resolved" /> Resolved</label></li>
					<li><label><input class="widget-val" type="checkbox" value="closed" /> Closed</label></li>
				</ul>

				<div class="alt-options">
					<strong>Hidden Tickets:</strong>
					<ul class="checkbox-list">
						<li><label><input class="widget-val" type="checkbox" value="hidden.awaiting_validation" /> Awaiting Validation</label></li>
						<li><label><input class="widget-val" type="checkbox" value="hidden.spam" /> Spam</label></li>
						<li><label><input class="widget-val" type="checkbox" value="hidden.deleted" /> Deleted</label></li>
					</ul>
				</div>
			</div>
		</div>
	</div>

	{##################################################################################################################}
	{# Agent #}
	{##################################################################################################################}

	<div class="input-row">
		<div class="input-row-title">
			<strong>Agent</strong>
		</div>
		<div class="input-row-body add-to-search">
			{% set elid = el_uid() %}
			<select class="dp-select-widget-simple" name="search_assigned[]" multiple="multiple" data-target-menu="auto">
				<optgroup label="Agents">
					<option value="0">Unassigned</option>
					<option selected="selected" value="{{ app.user.id }}">Me</option>
					{% for agent in app.agents.getAgents() if agent.id != app.user.id %}
						<option value="{{ agent.id }}">{{ agent.display_name }}</option>
					{% endfor %}
				</optgroup>
				{% if app.agent_teams.getTeams()|length %}
					<optgroup label="Agent Teams">
						<option value="team.0">No team</option>
						{% for team in app.agent_teams.getTeams() %}
							<option value="team.{{ team.id }}">{{ team.name }}</option>
						{% endfor %}
					</optgroup>
				{% endif %}
			</select>
		</div>
	</div>

	{##################################################################################################################}
	{# Ticket Field #}
	{##################################################################################################################}

	{% set elid = el_uid() %}
	<div class="input-row">
		<div class="input-row-title">
			<strong>Ticket Field</strong>
		</div>
		<div class="adv-btn trigger-open-panel" data-panel-id="panel-ticket-fields" data-target-summary="#{{ elid }}_termlist"><i class="icon-cog"></i></div>
		<div class="text-value with-adv trigger-open-panel" data-panel-id="panel-ticket-fields" id="{{ elid }}_termlist">

		</div>
	</div>

	<div class="source-pane-search-panel panel-ticket-fields">
		{% include 'AgentBundle:TicketSearch:window-search-fields.html.twig' %}
	</div>

	{##################################################################################################################}
	{# Subject #}
	{##################################################################################################################}

	{% set elid = el_uid() %}
	<div class="input-row">
		<div class="input-row-title">
			<strong>Subject</strong>
		</div>
		<div class="adv-btn trigger-open-panel" data-panel-id="panel-ticket-subject" data-target-summary="#{{ elid }}_text_val"><i class="icon-cog"></i></div>
		<div class="input-row-body with-adv">
			<input type="text" name="search_subject_simple" value="" id="{{ elid }}_text_val" />
		</div>
	</div>

	<div class="source-pane-search-panel panel-ticket-subject">
		<div class="pane-rows-wrap" id="{{ elid }}_pane_rows">
			<div class="pane-row row-orig add-to-search" id="{{ elid }}_orig_row">
				<div class="sep-row">
					<div class="line"></div>
					<strong>and</strong>
				</div>
				<div class="remove-row-btn trigger-remove-row"><i class="icon-minus-sign"></i></div>
				<table class="layout-table v-middle" width="100%">
					<tr>
						<td width="80">Subject</td>
						<td>
							<input class="full-width search-string" type="text" name="search_subject_string[]" placeholder="Enter search words" style="margin-bottom: 6px;" />
						</td>
					</tr>
					<tr>
						<td>&nbsp;</td>
						<td>
							<select class="dp-select-widget-simple" name="search_subject_op[]" data-target-menu="auto" data-menu-addclass="no-caret" data-zindex="10000001" data-select-close="1">
								<option selected="selected" value="is">contains</option>
								<option value="not">does not contain</option>
							</select>
							<select class="dp-select-widget-simple" name="search_subject_type[]" data-target-menu="auto" data-menu-addclass="no-caret" data-zindex="10000001" data-select-close="1">
								<option value="and">all words</option>
								<option value="or">any word</option>
								<option value="phrase">phrase</option>
							</select>
						</td>
					</tr>
				</table>
			</div>
		</div>
		<div class="add-row">
			<div class="add-row-btn trigger-clone-row" data-target="#{{ elid }}_orig_row" data-target-list="#{{ elid }}_pane_rows"><i class="icon-plus-sign"></i></div>
		</div>
	</div>

	{##################################################################################################################}
	{# Message #}
	{##################################################################################################################}

	{% set elid = el_uid() %}
	<div class="input-row">
		<div class="input-row-title">
			<strong>Message</strong>
		</div>
		<div class="adv-btn trigger-open-panel" data-panel-id="panel-ticket-message" data-target-summary="#{{ elid }}_text_val"><i class="icon-cog"></i></div>
		<div class="input-row-body with-adv">
			<input type="text" name="search_message_simple" value="" id="{{ elid }}_text_val" />
		</div>
	</div>

	<div class="source-pane-search-panel panel-ticket-message">
		<div class="pane-rows-wrap" id="{{ elid }}_pane_rows">
			<div class="pane-row row-orig add-to-search" id="{{ elid }}_orig_row">
				<div class="sep-row">
					<div class="line"></div>
					<strong>and</strong>
				</div>
				<div class="remove-row-btn trigger-remove-row"><i class="icon-minus-sign"></i></div>
				<table class="layout-table v-middle" width="100%">
					<tr>
						<td width="80">Message</td>
						<td>
							<input class="full-width search-string" type="text" name="search_message_string[]" placeholder="Enter search words" style="margin-bottom: 6px;" />
						</td>
					</tr>
					<tr>
						<td>&nbsp;</td>
						<td>
							<select class="dp-select-widget-simple" name="search_message_op[]" data-target-menu="auto" data-menu-addclass="no-caret" data-zindex="10000001" data-select-close="1">
								<option selected="selected" value="is">contains</option>
								<option value="not">does not contain</option>
							</select>
							<select class="dp-select-widget-simple" name="search_message_type[]" data-target-menu="auto" data-menu-addclass="no-caret" data-zindex="10000001" data-select-close="1">
								<option value="and">all words</option>
								<option value="or">any word</option>
								<option value="phrase">phrase</option>
							</select>
						</td>
					</tr>
					<tr>
						<td>&nbsp;</td>
						<td>
							<table class="layout-table v-middle" width="100%">
								<tr>
									<td width="100" style="padding-right: 4px;">
										<select class="dp-select-widget-simple" name="search_message_who[]" data-target-menu="auto" data-menu-addclass="no-caret" data-zindex="10000001" data-select-close="1">
											<option selected="selected" value="0">By anyone</option>
											<option value="agent">By an agent</option>
											<option value="user">By a user</option>
										</select>
									</td>
									<td>
										<div class="date-term-wrap" data-base-name="search_message_when">
											<select name="search_message_when_op[]" class="op dp-select-widget-simple" data-target-menu="auto" data-menu-addclass="no-caret" data-zindex="10000001" data-select-close="1">
												<option selected="selected" value="0">Written any time</option>
												<option value="lte">Written before</option>
												<option value="gte">Written after</option>
												<option value="between">Written between</option>
											</select>
											{% include 'DeskPRO:Common:rulebuilder-date-options.html.twig' %}
										</div>
									</td>
								</tr>
							</table>
						</td>
					</tr>
				</table>
			</div>
		</div>
		<div class="add-row">
			<div class="add-row-btn trigger-clone-row" data-target="#{{ elid }}_orig_row" data-target-list="#{{ elid }}_pane_rows"><i class="icon-plus-sign"></i></div>
		</div>
	</div>

	{##################################################################################################################}
	{# User #}
	{##################################################################################################################}

	{% set elid = el_uid() %}
	<div class="input-row">
		<div class="input-row-title">
			<strong>User</strong>
		</div>
		<div class="adv-btn trigger-open-panel" data-panel-id="panel-user-fields" data-target-summary="#{{ elid }}_termlist"><i class="icon-cog"></i></div>
		<div class="text-value with-adv trigger-open-panel" data-panel-id="panel-user-fields" id="{{ elid }}_termlist">

		</div>
	</div>

	<div class="source-pane-search-panel panel-user-fields">
		{% include 'AgentBundle:TicketSearch:window-search-user.html.twig' %}
	</div>

	{##################################################################################################################}
	{# Organization #}
	{##################################################################################################################}

	{% set elid = el_uid() %}
	<div class="input-row">
		<div class="input-row-title">
			<strong>Organization</strong>
		</div>
		<div class="adv-btn trigger-open-panel" data-panel-id="panel-org-fields" data-target-summary="#{{ elid }}_termlist"><i class="icon-cog"></i></div>
		<div class="text-value with-adv trigger-open-panel" data-panel-id="panel-org-fields" id="{{ elid }}_termlist">

		</div>
	</div>

	<div class="source-pane-search-panel panel-org-fields">
		{% include 'AgentBundle:TicketSearch:window-search-org.html.twig' %}
	</div>

	{##################################################################################################################}
	{# Dates and Times #}
	{##################################################################################################################}

	{% set elid = el_uid() %}
	<div class="input-row">
		<div class="input-row-title">
			<strong>Dates &amp; Times</strong>
		</div>
		<div class="adv-btn trigger-open-panel" data-panel-id="panel-date-fields" data-target-summary="#{{ elid }}_termlist"><i class="icon-cog"></i></div>
		<div class="text-value with-adv trigger-open-panel" data-panel-id="panel-date-fields" id="{{ elid }}_termlist">

		</div>
	</div>

	<div class="source-pane-search-panel panel-date-fields">
		{% include 'AgentBundle:TicketSearch:window-search-dates.html.twig' %}
	</div>

	<footer>
		<button class="dp-btn trigger-submit-search" data-search-url="{{ path('agent_ticketsearch_runcustomfilter') }}">Search</button>
	</footer>
</section>