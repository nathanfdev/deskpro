<script type="text/ng-template" id="ticketlist_prop_department">
	<span class="prop-title">{{ phrase('agent.general.department') }}:</span>
	<span class="prop-val">{{ ng_var('ticket.department.title_full') }}</span>
</script>

<script type="text/ng-template" id="ticketlist_prop_ref">
	<span class="prop-title">{{ phrase('agent.general.ref') }}:</span>
	<span class="prop-val">{{ ng_var('ticket.ref') }}</span>
</script>

<script type="text/ng-template" id="ticketlist_prop_language">
	<span class="prop-title">{{ phrase('agent.general.language') }}:</span>
	<span class="prop-val">{{ ng_var('ticket.language.title') }}</span>
</script>

<script type="text/ng-template" id="ticketlist_prop_category">
	<span class="prop-title">{{ phrase('agent.general.category') }}:</span>
	<span class="prop-val">{{ ng_var('ticket.category.title') }}</span>
</script>

<script type="text/ng-template" id="ticketlist_prop_priority">
	<span class="prop-title">{{ phrase('agent.general.priority') }}:</span>
	<span class="prop-val">{{ ng_var('ticket.priority.title') }}</span>
</script>

<script type="text/ng-template" id="ticketlist_prop_workflow">
	<span class="prop-title">{{ phrase('agent.general.workflow') }}:</span>
	<span class="prop-val">{{ ng_var('ticket.workflow.title') }}</span>
</script>

<script type="text/ng-template" id="ticketlist_prop_product">
	<span class="prop-title">{{ phrase('agent.general.product') }}:</span>
	<span class="prop-val">{{ ng_var('ticket.product.title') }}</span>
</script>

<script type="text/ng-template" id="ticketlist_prop_agent">
	<span class="prop-title">{{ phrase('agent.general.agent') }}:</span>
	<span class="prop-val" ng-if="ticket.agent && ticket.agent.id == DESKPRO_PERSON_ID">{{ ng_var('ticket.agent.display_name') }}</span>
	<span class="prop-val" ng-if="ticket.agent && ticket.agent.id != DESKPRO_PERSON_ID"><a class="agent_link">{{ ng_var('ticket.agent.display_name') }}</a></span>
	<span class="prop-val" ng-if="!ticket.agent">{{ phrase('agent.general.unassigned') }}</span>
</script>

<script type="text/ng-template" id="ticketlist_prop_agent_team">
	<span class="prop-title">{{ phrase('agent.general.agent_team') }}:</span>
	<span class="prop-val" ng-if="ticket.agent_team">{{ ng_var('ticket.agent_team.name') }}</span>
	<span class="prop-val" ng-if="!ticket.agent_team">{{ phrase('agent.general.no_team') }}</span>
</script>

<script type="text/ng-template" id="ticketlist_prop_labels">
	<span class="prop-title">{{ phrase('agent.general.labels') }}:</span>
	<span class="prop-val">
			<span bindonce ng-repeat="label in ticket.labels" class="listing-tag">{{ ng_var('label') }}</span>
		</span>
</script>

<script type="text/ng-template" id="ticketlist_prop_organization">
	<span class="prop-title">{{ phrase('agent.general.organization') }}:</span>
	<span class="prop-val">
			<a class="with-route" data-route="page:{{ path('agent_org_view', {'organization_id': '0000'})|replace({'0000': '{{ticket.organization.id}}'}) }}" data-route-title="@text">{{ ng_var('ticket.organization.name') }}</a>
		</span>
</script>

<script type="text/ng-template" id="ticketlist_prop_date_created">
	<span class="prop-title">{{ phrase('agent.general.date_created') }}:</span>
	<span class="prop-val">
			<dp-timeago timestamp="{{ ng_var('ticket.date_created_ts') }}" />
		</span>
</script>

<script type="text/ng-template" id="ticketlist_prop_date_user_waiting">
	<span class="prop-title">{{ phrase('agent.general.user_waiting') }}:</span>
	<span class="prop-val">
			<dp-timeago timestamp="{{ ng_var('ticket.date_user_waiting_ts') }}" no-suffix />
		</span>
</script>

<script type="text/ng-template" id="ticketlist_prop_date_resolved">
	<span class="prop-title">{{ phrase('agent.general.date_resolved') }}:</span>
	<span class="prop-val">
			<dp-timeago timestamp="{{ ng_var('ticket.date_resolved_ts') }}" />
		</span>
</script>

<script type="text/ng-template" id="ticketlist_prop_date_last_user_reply">
	<span class="prop-title">{{ phrase('agent.general.date_of_last_user_reply') }}:</span>
	<span class="prop-val">
			<dp-timeago timestamp="{{ ng_var('ticket.date_last_user_reply_ts') }}" />
		</span>
</script>

<script type="text/ng-template" id="ticketlist_prop_date_last_agent_reply">
	<span class="prop-title">{{ phrase('agent.general.date_of_last_agent_reply') }}:</span>
	<span class="prop-val">
			<dp-timeago timestamp="{{ ng_var('ticket.date_last_agent_reply_ts') }}" />
		</span>
</script>

<script type="text/ng-template" id="ticketlist_prop_date_last_reply">
	<span class="prop-title">{{ phrase('agent.general.date_of_last_reply') }}:</span>
	<span class="prop-val" ng-if="ticket.date_last_agent_reply && (!ticket.date_last_user_reply || ticket.date_last_agent_reply_ts > ticket.date_last_user_reply_ts)">
			<dp-timeago timestamp="{{ ng_var('ticket.date_last_agent_reply_ts') }}" />
		</span>
	<span class="prop-val" ng-if="ticket.date_last_user_reply && (!ticket.date_last_agent_reply || ticket.date_last_user_reply_ts > ticket.date_last_agent_reply_ts)">
			<dp-timeago timestamp="{{ ng_var('ticket.date_last_user_reply_ts') }}" />
		</span>
</script>

<script type="text/ng-template" id="ticketlist_prop_total_user_waiting">
	<span class="prop-title">{{ phrase('agent.general.total_time_waiting') }}:</span>
	<span class="prop-val">
			{{ ng_static_var('ticket.total_user_waiting|formatSeconds:ticket.date_user_waiting_ts') }}
		</span>
</script>

{% for field in app.getCustomFieldManager('tickets').getFields() %}
	<script type="text/ng-template" id="ticketlist_prop_ticket_fields[{{ field.id }}]">
		<span class="prop-title">{{ field.title }}:</span>
		<span class="prop-val">{{ ng_var('ticket.field' ~ field.id) }}</span>
	</script>
{% endfor %}
{% for field in app.getCustomFieldManager('people').getFields() %}
	<script type="text/ng-template" id="ticketlist_prop_person_fields[{{ field.id }}]">
		<span class="prop-title">{{ field.title }}:</span>
		<span class="prop-val">{{ ng_var('ticket.person.field' ~ field.id) }}</span>
	</script>
{% endfor %}