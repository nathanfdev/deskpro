<section class="list-top-area ticket">
	{% if not hide_terms_summary %}
	<div class="summary">
		<span class="edit" title="{{ phrase('agent.edit_search_terms') }}">{{ phrase('agent.ucfirst_edit') }}</span>
		{% for line in terms_summary %}
			{{line}}{% if not loop.last %},{% endif %}
		{% else %}
			No criteria, all tickets match
		{% endfor %}
	</div>
	{% endif %}
	<div class="form-panel" {% if not show_search_form %}style="display: none"{% endif %}>
		<form action="{{ path('agent_ticketsearch_runcustomfilter') }}" method="post" class="ticket-search-form">
			<div class="row" style="margin-top: 0;">
				<div class="search-form" id="criteria_list">
					<div class="search-terms"></div>
					<div class="term"><span class="add-term">+</span> {{ phrase('agent.add_a_new_term') }}</div>
				</div>
				<div class="term">
					{{ phrase('agent.order_by') }}
					<select name="order_by">
						<option value="ticket.date_created:desc">{{ phrase('agent.ticketsearch.date_opened_newerolder') }}</option>
						<option value="ticket.date_created:asc">{{ phrase('agent.ticketsearch.date_opened_oldernewer') }}</option>
						<option value="ticket.priority:desc">{{ phrase('agent.ticketsearch.priority_highestlowest') }}</option>
						<option value="ticket.priority:asc">{{ phrase('agent.ticketsearch.priority_lowesthighest') }}</option>
					</select>
				</div>
				{% include 'DeskPRO:Common:ticket-search-criteria.html.twig' with { 'classname': 'search-builder-tpl', 'term_options': ticket_options } %}
			</div>
			<div style="text-align: center;"><button class="dp-button x-small">{{ phrase('agent.search') }}</button></div>
		</form>
	</div>
	
	{% if search_form %}
	<script type="text/x-deskpro-plain" class="search-form-data">{{ search_form|json_encode|raw }}</script>
	{% endif %}

</section>