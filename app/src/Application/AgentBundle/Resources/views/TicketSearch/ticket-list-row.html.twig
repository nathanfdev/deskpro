<article
	class="row-item "
	data-route="ticket:{{ path('agent_ticket_view', {'ticket_id': '0000'})|replace({'0000': '<%= ticket.id %>'}) }}"
	ng-class="{'open': openTickets[ticket.id], 'list-animation': isLoaded && !pauseListAnim}"
	data-route-title="@selector(a.subject)"
	data-route-openclass="open"
>
	<div class="item-hover-over-indicator"></div>
	<div class="loading-arrow">{{ phrase('agent.general.loading') }}</div>
	<input type="checkbox" class="item-select" ng-model="checkedTickets[ticket.id]" />
	<div class="top-row">
		<div class="top-row-left">
			<h3>
				<span class="obj-id">#<%= ticket.id %></span>
				<a class="subject click-through">
					<%- ticket.subject %>
				</a>
			</h3>
			<dp-sticky-tip trigger=".subject" offset-top="18" ng-if="ticket.previews[0]">
				<div class="previewtext-row">
					<cite><%- ticket.previews[0].person.display_name %>:</cite>
					<%- ticket.previews[0].message.preview_text %>
				</div>
			</dp-sticky-tip>
		</div>
		<div class="top-row-right">
			<div class="bound-fade"></div>
			<% if (ticket.is_hold) { %><div class="on-hold">{{ phrase('agent.tickets.on_hold') }}</div><% } %>
			<div class="status-pill status urgency-<%= ticket.urgency %> <%= ticket.status %> <%= ticket.status %>_<%= ticket.hidden_status %>">
				<% if (ticket.status == 'awaiting_agent') { %>
					<label>{{ phrase('agent.tickets.status_awaiting_agent') }}</label>
				<% } %>
				<% if (ticket.status == 'awaiting_user') { %>
					<label>{{ phrase('agent.tickets.status_awaiting_user') }}</label>
				<% } %>
				<% if (ticket.status == 'resolved') { %>
					<label>{{ phrase('agent.tickets.status_resolved') }}</label>
				<% } %>
				<% if (ticket.status == 'closed') { %>
					<label>{{ phrase('agent.tickets.status_closed') }}</label>
				<% } %>
				<% if (ticket.status == 'hidden' && !ticket.hidden_status) { %>
					<label>{{ phrase('agent.tickets.status_hidden') }}</label>
				<% } %>
				<% if (ticket.status == 'hidden' && ticket.hidden_status == 'deleted') { %>
					<label>{{ phrase('agent.tickets.status_hidden_deleted') }}</label>
				<% } %>
				<% if (ticket.status == 'hidden' && ticket.hidden_status == 'spam') { %>
					<label>{{ phrase('agent.tickets.status_hidden_spam') }}</label>
				<% } %>
				<% if (ticket.status == 'hidden' && ticket.hidden_status == 'temp') { %>
					<label>{{ phrase('agent.tickets.status_hidden_temp') }}</label>
				<% } %>
				<% if (ticket.status == 'hidden' && ticket.hidden_status == 'validating') { %>
					<label>{{ phrase('agent.tickets.status_hidden_validating') }}</label>
				<% } %>

				<% if (ticket.status == 'awaiting_agent') { %>
					<i class="ticket-urgency"><%= ticket.urgency %></i>
				<% } %>
			</div>

			<% if (ticket.agent) { %>
				<span class="tipped agent-inline-icon" title="<%- ticket.agent.display_name %>" style="background-image: url('<%- ticket.agent.picture_url_16 %>');"></span>
			<% } %>
			<br class="clear" />
		</div>
	</div>
	<div class="userinfo">
		<a class="name click-through" data-route="person:{{ path('agent_people_view', {'person_id': '0000'})|replace({'0000': '<%= ticket.person.id %>'}) }}" data-route-title="@selector(.person-tip)">
			<span class="with-icon" style="background-image: url('<%- ticket.person.picture_url_16 %>');"><%- ticket.person.display_name %></span></a>
			<% if (ticket.person.organization) { %>
				<span class="org">
					(<% if (ticket.person.organization_position) { %><%= ticket.person.organization_position %>, <% } %><%- ticket.person.organization.name %>)
				</span>
			<% } %>
			<% if (ticket.person.primary_email) { %>
				<span class="email"><%- ticket.person.primary_email.email %></span>
			<% } %>
		<div class="bound-fade"></div>
	</div>
	<div class="extra-fields">
		<ul>
			<% for (var i = 0; i < display_fields.length; i++) { var field = display_fields[i]; if (!this.isFieldDisplayable(ticket)(field)) continue; %>
				<li>
					<% if (field == 'department') { %>
						<span class="prop-title">{{ phrase('agent.general.department') }}:</span>
						<span class="prop-val"><%- ticket.department.title_full %></span>
					<% } %>

					<% if (field == 'ref') { %>
						<span class="prop-title">{{ phrase('agent.general.ref') }}:</span>
						<span class="prop-val"><%- ticket.ref %></span>
					<% } %>

					<% if (field== 'language') { %>
						<span class="prop-title">{{ phrase('agent.general.language') }}:</span>
						<span class="prop-val"><%= ticket.language.title %></span>
					<% } %>

					<% if (field== 'category') { %>
						<span class="prop-title">{{ phrase('agent.general.category') }}:</span>
						<span class="prop-val"><%= ticket.category.title %></span>
					<% } %>

					<% if (field== 'priority') { %>
						<span class="prop-title">{{ phrase('agent.general.priority') }}:</span>
						<span class="prop-val"><%= ticket.priority.title %></span>
					<% } %>

					<% if (field== 'workflow') { %>
						<span class="prop-title">{{ phrase('agent.general.workflow') }}:</span>
						<span class="prop-val"><%= ticket.workflow.title %></span>
					<% } %>

					<% if (field== 'product') { %>
						<span class="prop-title">{{ phrase('agent.general.product') }}:</span>
						<span class="prop-val"><%= ticket.product.title %></span>
					<% } %>

					<% if (field== 'agent') { %>
						<span class="prop-title">{{ phrase('agent.general.agent') }}:</span>
						<% if (ticket.agent && ticket.agent.id == DESKPRO_PERSON_ID) { %><span class="prop-val"><%- ticket.agent.display_name %></span><% } %>
						<% if (ticket.agent && ticket.agent.id != DESKPRO_PERSON_ID) { %><span class="prop-val"><a class="agent_link"><%- ticket.agent.display_name %></a></span><% } %>
						<% if (!ticket.agent) { %><span class="prop-val">{{ phrase('agent.general.unassigned') }}</span><% } %>
					<% } %>

					<% if (field== 'agent_team') { %>
						<span class="prop-title">{{ phrase('agent.general.agent_team') }}:</span>
						<% if (ticket.agent_team) { %><span class="prop-val"><%- ticket.agent_team.name %></span><% } %>
						<% if (!ticket.agent_team) { %><span class="prop-val">{{ phrase('agent.general.no_team') }}</span><% } %>
					<% } %>

					<% if (field== 'labels') { %>
						<span class="prop-title">{{ phrase('agent.general.labels') }}:</span>
						<span class="prop-val">
							<span bindonce ng-repeat="label in ticket.labels" class="listing-tag">{{ ng_var('label') }}</span>
						</span>
					<% } %>

					<% if (field== 'organization') { %>
						<span class="prop-title">{{ phrase('agent.general.organization') }}:</span>
						<span class="prop-val">
							<a class="with-route" data-route="page:{{ path('agent_org_view', {'organization_id': '0000'})|replace({'0000': '<%= ticket.organization.id %>'}) }}" data-route-title="@text"><%- ticket.organization.name %></a>
						</span>
					<% } %>

					<% if (field== 'date_created') { %>
						<span class="prop-title">{{ phrase('agent.general.date_created') }}:</span>
						<span class="prop-val">
							<dp-timeago timestamp="<%= ticket.date_created_ts %>" />
						</span>
					<% } %>

					<% if (field== 'date_user_waiting') { %>
						<span class="prop-title">{{ phrase('agent.general.user_waiting') }}:</span>
						<span class="prop-val">
							<dp-timeago timestamp="<%= ticket.date_user_waiting_ts %>" no-suffix />
						</span>
					<% } %>

					<% if (field== 'date_resolved') { %>
						<span class="prop-title">{{ phrase('agent.general.date_resolved') }}:</span>
						<span class="prop-val">
							<dp-timeago timestamp="<%= ticket.date_resolved_ts %>" />
						</span>
					<% } %>

					<% if (field== 'date_last_user_reply') { %>
						<span class="prop-title">{{ phrase('agent.general.date_of_last_user_reply') }}:</span>
						<span class="prop-val">
							<dp-timeago timestamp="<%= ticket.date_last_user_reply_ts %>" />
						</span>
					<% } %>

					<% if (field== 'date_last_agent_reply') { %>
						<span class="prop-title">{{ phrase('agent.general.date_of_last_agent_reply') }}:</span>
						<span class="prop-val">
								<dp-timeago timestamp="<%= ticket.date_last_agent_reply_ts %>" />
							</span>
					<% } %>

					<% if (field== 'date_last_reply') { %>
						<span class="prop-title">{{ phrase('agent.general.date_of_last_reply') }}:</span>
						<% if (ticket.date_last_agent_reply && (!ticket.date_last_user_reply || ticket.date_last_agent_reply_ts > ticket.date_last_user_reply_ts)) { %>
							<span class="prop-val">
								<dp-timeago timestamp="<%= ticket.date_last_agent_reply_ts %>" />
							</span>
						<% } %>
						<% if (ticket.date_last_user_reply && (!ticket.date_last_agent_reply || ticket.date_last_user_reply_ts > ticket.date_last_agent_reply_ts)) { %>
							<dp-timeago timestamp="<%= ticket.date_last_user_reply_ts %>" />
						<% } %>
					<% } %>

					<% if (field== 'total_user_waiting') { %>
						<span class="prop-title">{{ phrase('agent.general.total_time_waiting') }}:</span>
						<span class="prop-val">
							<span bo-bind="<%= ticket.total_user_waiting %>|formatSeconds:ticket.date_user_waiting_ts"></span>
						</span>
					<% } %>

					{% for field in app.getCustomFieldManager('tickets').getFields() %}
						<% if (field== 'ticket_fields[{{ field.id }}]') { %>
							<span class="prop-title">{{ field.title }}:</span>
							<span class="prop-val"><%- ticket.field{{ field.id }} %></span>
						<% } %>
					{% endfor %}
					{% for field in app.getCustomFieldManager('people').getFields() %}
						<% if (field== 'person_fields[{{ field.id }}]') { %>
							<span class="prop-title">{{ field.title }}:</span>
							<span class="prop-val"><%- ticket.person.field{{ field.id }} %></span>
						<% } %>
					{% endfor %}
				</li>
			<% } %>
		</ul>
		<br class="clear"/>
	</div>
</article>