<div class="search-form">
	<form action="{{ path('agent_ticketsearch_runcustomfilter') }}" method="post" id="tickets_search_form">
		<div class="search-terms"></div>
		<div class="term"><span class="add-term">+</span> {{ phrase('agent.global.add_a_new_criteria') }}</div>
		<div class="term">
			{{ phrase('agent.global.order_by') }}
			<select name="filter[order_by]">
				<option value="ticket.date_created:desc">{{ phrase('agent.ticketsearch.date_opened_newerolder') }}</option>
				<option value="ticket.date_created:asc">{{ phrase('agent.ticketsearch.date_opened_oldernewer') }}</option>
				<option value="ticket.priority:desc">{{ phrase('agent.ticketsearch.priority_highestlowest') }}</option>
				<option value="ticket.priority:asc">{{ phrase('agent.ticketsearch.priority_lowesthighest') }}</option>
			</select>
		</div>
		<div class="term">
			{{ phrase('agent.ticketsearch.group_by') }}
			<select name="filter[group_by]">
				<option value="">{{ phrase('agent.ticketsearch.no_grouping') }}</option>
				{% for id,name in {'priority_id':'Priority', 'status': 'Status', 'department_id': 'Department', 'category_id': 'Category', 'product_id': 'Product', 'agent_id': 'Agent', 'agent_team_id': 'Agent Team'} %}
					<option value="{{id}}" {%if filter.group_by == id %}selected="selected"{%endif%}>{{name}}</option>
				{% endfor %}
			</select>
		</div>
		<center><input type="submit" value="search" /></center>
	</form>
</div>

{% include 'DeskPRO:Common:ticket-search-criteria.html.twig' with { 'classname': 'search-builder-tpl"', 'term_options': ticket_options } %}