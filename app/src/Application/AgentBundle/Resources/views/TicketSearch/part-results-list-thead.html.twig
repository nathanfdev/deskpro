<thead>
	<tr>
		{% if not disable_actions %}
			<th width="20" class="check-all check" width="5" valign="middle" style="vertical-align: middle; text-align: left;"><input type="checkbox" class="check-all-box selection-control" style="margin: 0; margin-left: 3px; padding: 0;"/></th>
		{% endif %}
		{% set perc = (100 / display_fields|length) %}
		{% for field in display_fields %}
			{% if field == 'subject' %}<th>Subject</th>
			{% elseif field == 'user' %}<th>User</th>
			{% elseif field == 'deleted_reason' %}<th data-field="deleted_reason">{{ phrase('agent.ticketsearch.deleted_reason') }}</th>
			{% elseif field == 'person_email' %}<th data-field="person">{{ phrase('agent.ticketsearch.user_email') }}</th>
			{% elseif field == 'person_organization' %}<th data-field="person_organization">Organization</th>
			{% elseif field == 'department' %}<th data-field="department">Department</th>
			{% elseif field == 'category' %}<th data-field="category">Category</th>
			{% elseif field == 'product' %}<th data-field="product">Product</th>
			{% elseif field == 'organization' %}<th data-field="organization">Organization</th>
			{% elseif field == 'agent' %}<th data-field="agent">Agent</th>
			{% elseif field == 'agent_team' %}<th data-field="agent_team">Team</th>
			{% elseif field == 'labels' %}<th data-field="agent_team">Lables</th>
			{% elseif field == 'date_user_waiting' %}<th data-field="agent_team">User Waiting</th>
			{% elseif field == 'date_created' %}<th data-field="date_created">Date Opened</th>
			{% else %}
				{% for f in ticket_field_defs %}
					{% if field == 'ticket_fields['~f.id~']' %}
					<th data-field="ticket_fields[{{f.id}}]">{{f.title}}</th>
					{% endif %}
				{% endfor %}
				{% for f in person_field_defs %}
					{% if field == 'person_fields['~f.id~']' %}
					<th data-field="person_fields[{{f.id}}]">{{f.title}}</th>
					{% endif %}
				{% endfor %}
			{% endif %}
		{% endfor %}
	</tr>
</thead>
