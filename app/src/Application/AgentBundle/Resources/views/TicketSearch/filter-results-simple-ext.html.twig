{% import 'AgentBundle:Common:agent-macros.html.twig' as agentui %}
<script>
{% if filter %}
	{% if filter.sys_name %}
		pageMeta.url_fragment = '{{ url_fragment('agent_ticketsearch_runnamedfilter', {'filter_name': filter.sys_name}) }}';
	{% else %}
		pageMeta.url_fragment = '{{ url_fragment('agent_ticketsearch_runfilter', {'filter_id': filter.id}) }}';
	{% endif %}

	pageMeta.filter_id = {{filter_id}};
	pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.TicketFilter';
	pageMeta.refreshUrl = '{{ path('agent_ticketsearch_runfilter', {'filter_id': filter_id}) }}?set_group_term={{ set_group_term }}&set_group_option={{ set_group_option }}&view_name={{ view_name }}';
	pageMeta.viewTypeUrl = '{{ path('agent_ticketsearch_runfilter', {'filter_id': filter_id}) }}?set_group_term={{ set_group_term }}&set_group_option={{ set_group_option }}&view_type=$view_type&view_name={{ view_name }}';
{% elseif sla_id %}
	pageMeta.url_fragment = '{{ url_fragment('agent_ticketsearch_runsla', {'sla_id': sla_id}) }}';

	pageMeta.sla_id = {{sla_id}};
	pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.TicketSla';
	pageMeta.refreshUrl = '{{ path('agent_ticketsearch_runsla', {'sla_id': sla_id}) }}?set_group_term={{ set_group_term }}&set_group_option={{ set_group_option }}&view_name={{ view_name }}';
	pageMeta.viewTypeUrl = '{{ path('agent_ticketsearch_runsla', {'sla_id': sla_id}) }}?set_group_term={{ set_group_term }}&set_group_option={{ set_group_option }}&view_type=$view_type&view_name={{ view_name }}';
{% else %}
	pageMeta.cache_id = {{cache_id}};
	pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.TicketCustomFilter';
	pageMeta.refreshUrl = '{{ path('agent_ticketsearch_runcustomfilter', {'cache_id': cache_id}) }}?set_group_term={{ set_group_term }}&set_group_option={{ set_group_option }}';
	pageMeta.viewTypeUrl = '{{ path('agent_ticketsearch_runcustomfilter', {'cache_id': cache_id}) }}?set_group_term={{ set_group_term }}&set_group_option={{ set_group_option }}&view_type=$view_type&view_name={{ view_name }}';
{% endif %}
{% if not tickets %}
	pageMeta.noResults = true;
{% endif %}
pageMeta.loadSingleUrl = '{{ path('agent_ticketsearch_singleticketrow', {'filter_id': filter_id|default('0')}) }}?ticket_id=$ticket_id&view_type=$view_type&view_name={{ view_name }}';
pageMeta.fetchResultsUrl = '{{ path('agent_ticketsearch_getpage') }}';

{% if filter.sys_name == 'agent' %}pageMeta.groupingIgnore=["agent","agent_team"];{% endif %}
{% if filter.sys_name == 'agent_team' %}pageMeta.groupingIgnore=["agent","agent_team"];{% endif %}
{% if filter.sys_name == 'unassigned' %}pageMeta.groupingIgnore=["agent"];{% endif %}

pageMeta.perPage = {{ per_page }};
pageMeta.ticketResultIds = {{ ticket_ids|json_encode|raw }};

pageMeta.view_name = '{{ view_name }}';

{% if set_group_term  %}
	pageMeta.topGroupingTerm = '{{ set_group_term }}';
	pageMeta.topGroupingOption = '{{ set_group_option }}';
{% endif %}

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
{{ agentui.scroll_containers('page-listing page-ticket-listing') }}

	{% if ticket_ids|length %}
		<div id="{{baseId}}_is_results">
			{% include 'AgentBundle:TicketSearch:filter-display-options-overlay.html.twig' %}

			{% include 'AgentBundle:TicketSearch:filter-control-bar.html.twig' %}
			{% include 'AgentBundle:TicketSearch:filter-grouping-bar.html.twig' %}
			{% include 'AgentBundle:TicketSearch:filter-massactions-bar.html.twig' %}

			{% if not filter or not filter.sys_name %}
				{% include 'AgentBundle:TicketSearch:filter-terms-bar.html.twig' %}
			{% endif %}

			<section class="list-listing" id="{{baseId}}_results_wrap">
				{% include 'AgentBundle:TicketSearch:part-results-simple-ext.html.twig' %}
			</section>

			<footer class="results-nav">
				<div class="cursor">
                    {% set phrase_part1 %}
                    <span class="results-showing-count" id="{{baseId}}_showing_count"></span>
                    {% endset %}
                    {% set phrase_part2 %}
                    <span class="results-total-count" id="{{baseId}}_total_count">{{ ticket_ids|length }}</span>
                    {% endset %}
                    {{ phrase('agent.general.showing_results_x_of_y', {'display_count':phrase_part1,'size':phrase_part2}, true) }}
				</div>
				{% if ticket_ids|length > per_page %}
					<ul class="pagenav no-prev">
						<li class="prev"></li>
						<li class="next"></li>
					</ul>
				{% endif %}
				<div class="loading">

				</div>
			</footer>
		</div>
	{% endif %}

	<section class="list-listing no-results" id="{{baseId}}_no_results" {% if ticket_ids|length %}style="display:none"{% endif %}>
		<article class="row-item no-results">
			<p style="padding: 15px;">{{ phrase('agent.general.there_are_no_results') }}</p>
		</article>
	</section>

{{ agentui.scroll_containers_end() }}
