<header class="list-control-bar">
	<ul class="btn-controls">
		<li class="display-options display-options-trigger"><a></a></li>
		<li class="right"><span class="sep"></span></li>
		<li class="detail-view detail-view-trigger"><a class="setupIcon"></a></li>
		<li class="right"><span class="sep"></span></li>
	</ul>
	<ul>
		<li>{{ phrase('global.ordered_by') }} </li>
		<li class="order-by-menu-trigger menu-fitted" data-menu-button=".button"><a class="button"><span class="label">{{ order_by_summary }}</span><em></em></a></li>
		<li>{{ phrase('agent.and_grouped_by') }} </li>
		<li class="group-by-menu-trigger menu-fitted" data-menu-button=".button"><a class="button"><span class="label">{{ grouping_summary|default('None') }}</span><em></em></a></li>
		<li><span class="sep"></span></li>
	</ul>

	<ul style="display: none" class="order-by-menu">
		<li data-order-by="urgency">{{ phrase('global.urgency') }}</li>
		<li data-order-by="date_created">{{ phrase('global.date_opened') }}</li>
		{% if app.getSetting('core.use_ticket_priority') %}<li data-order-by="priority">{{ phrase('global.priority') }}</li>{% endif %}
	</ul>
	<ul style="display: none" class="group-by-menu">
		<li data-group-by="">{{ phrase('global.none') }}</li>
		<li class="sep">-</li>
		<li data-group-by="department">{{ phrase('global.department') }}</li>
		{% if app.getSetting('core.use_ticket_category') %}<li data-group-by="category">{{ phrase('global.category') }}</li>{% endif %}
		{% if app.getSetting('core.use_ticket_priority') %}<li data-group-by="priority">{{ phrase('global.priority') }}</li>{% endif %}
		{% if app.getSetting('core.use_product') %}<li data-group-by="product">{{ phrase('global.product') }}</li>{% endif %}
		{% if app.getSetting('core.use_ticket_workflow') %}<li data-group-by="workflow">{{ phrase('global.workflow') }}</li>{% endif %}
		<li data-group-by="organization">{{ phrase('global.organization') }}</li>
		<li data-group-by="language">{{ phrase('global.language') }}</li>
		<li data-group-by="urgency">{{ phrase('global.urgency') }}</li>
		<li data-group-by="agent">{{ phrase('global.agent') }}</li>
		{% if app.getSetting('core.use_agent_team') %}<li data-group-by="agent_team">{{ phrase('global.agent_team') }}</li>{% endif %}
		<li data-group-by="user_waiting">{{ phrase('agent.time_waiting') }}</li>
		<li data-group-by="total_user_waiting">{{ phrase('agent.total_time_waiting') }}</li>
		<li data-group-by="date_created">{{ phrase('global.date_opened') }}</li>
	</ul>
</header>
