<ul class="source-list" id="tickets_outline_flags_list" style="margin-top: 4px;">
	{% for color in flags %}
		<li class="flag flag-{{color}} nav-flag-{{color}}" data-flag="{{color}}" data-route="listpane:{{ path('agent_ticketsearch_runcustomfilter') }}?terms[0][type]=flagged&amp;terms[0][op]=is&amp;terms[0][flag]={{color}}&amp;view_name=flagged">
			<span class="title">
				<span class="flag flag-{{color}}">{{ flagnamer.flag_name(color, person) }}</span>
				<span id="ticket_flag_{{color}}_count" class="list-counter">{{ flag_counts[color]|default(0) }}</span>
			</span>
		</li>
	{% endfor %}
</ul>

<aside class="source-info-explain">
	{{ phrase('agent.tickets.flags_let_you_create_personal_collections_of_tickets') }}
</aside>