<% if (ticket.preview_changes) {
	ticket_display = ticket.preview_changes;
} else {
	ticket_display = ticket;
} %>
<% var fields = getDisplayableFields(); %>
<td width="20"><input type="checkbox" class="item-select" ng-model="checkedTickets[<%= ticket.id %>]" /></td>

<% for (var i = 0; i < fields.length; i++) { var field = fields[i]; %>
	<td class="col-<%- field %>">
		<div class="cell-value">
		<% if (field == 'subject') { %>
			<span class="prop-val">
                <span class="obj-id">#<%= ticket_display.id %></span>
                <span class="obj-link"
                      ng-mouseenter="$emit('tickets.quick_actions.show', $event, ticket, 900)"
                      ng-mouseleave="$emit('tickets.quick_actions.hide')">
                    <%- ticket_display.subject %>
                </span>
            </span>
		<% } %>
		<% if (field == 'user') { %>
			<span class="prop-val" title="<%- ticket_display.person.primary_email.email %>">
				<a class="name link click-through" data-route="person:{{ path('agent_people_view', {'person_id': '0000'})|replace({'0000': '<%= ticket_display.person.id %>'})|raw }}" data-route-title="@selector(.person-tip)">
					<%- ticket_display.person.display_name %>
				</a>
			</span>
		<% } %>
		<% if (field == 'department') { %>
			<span class="prop-val"><%- ticket_display.department.title_full %></span>
		<% } %>
		<% if (field == 'status') { %>
			<div class="status-pill status urgency-<%- ticket_display.urgency %> <%- ticket_display.status %> <%- ticket_display.status %>_<%- ticket_display.hidden_status %>" style="top: auto;">
				<% if (ticket_display.status == 'awaiting_agent') { %><label>{{ phrase('agent.tickets.status_awaiting_agent') }}</label><i class="ticket-urgency"><%- ticket_display.urgency %></i><% } %>
				<% if (ticket_display.status == 'awaiting_user') { %><label>{{ phrase('agent.tickets.status_awaiting_user') }}</label><% } %>
				<% if (ticket_display.status == 'resolved') { %><label>{{ phrase('agent.tickets.status_resolved') }}</label><% } %>
				<% if (ticket_display.status == 'archived') { %><label>{{ phrase('agent.tickets.status_archived') }}</label><% } %>
				<% if (ticket_display.status == 'hidden') { %><label>{{ phrase('agent.tickets.status_hidden') }}</label><% } %>
			</div>
		<% } %>
		<% if (field == 'ref') { %>
			<span class="prop-val"><%- ticket_display.ref %></span>
		<% } %>
		<% if (field == 'language') { %>
			<span class="prop-val"><%= ticket_display.language.title %></span>
		<% } %>
		<% if (field == 'category') { %>
			<span class="prop-val"><%= ticket_display.category.title %></span>
		<% } %>
		<% if (field == 'priority') { %>
			<span class="prop-val"><%= ticket_display.priority.title %></span>
		<% } %>
		<% if (field == 'workflow') { %>
			<span class="prop-val"><%= ticket_display.workflow.title %></span>
		<% } %>
		<% if (field == 'product') { %>
			<span class="prop-val"><%= ticket_display.product.title %></span>
		<% } %>
		<% if (field == 'agent') { %>
			<% if (ticket_display.agent && ticket_display.agent.id == DESKPRO_PERSON_ID) { %><span class="prop-val"><img ng-src="<%- ticket.agent.picture_url_16 %>" title="<%- ticket.agent.display_name %>" /> <%- ticket.agent.display_name %></span><% } %>
			<% if (ticket_display.agent && ticket_display.agent.id != DESKPRO_PERSON_ID) { %><span class="prop-val"><a class="agent_link" ng-click="openAgentChat(<%= ticket_display.agent.id %>, $event)"><img ng-src="<%- ticket.agent.picture_url_16 %>" title="<%- ticket.agent.display_name %>" /> <%- ticket.agent.display_name %></a></span><% } %>
			<% if (!ticket_display.agent) { %>&nbsp;<% } %>
		<% } %>
		<% if (field == 'agent_team') { %>
			<% if (ticket_display.agent_team) { %><span class="prop-val"><%- ticket_display.agent_team.name %></span><% } %>
			<% if (!ticket_display.agent_team) { %><span class="prop-val">{{ phrase('agent.general.no_team') }}</span><% } %>
		<% } %>
		<% if (field == 'labels') { %>
			<% if (ticket_display.labels) { %>
				<% for (var labelIdx = 0; labelIdx < ticket_display.labels.length; labelIdx++) { %>
					<span class="listing-tag" dp-label="<%- ticket_display.labels[labelIdx] %>"><%- ticket_display.labels[labelIdx] %></span>
				<% } %>
			<% } %>
		<% } %>
		<% if (field == 'organization') { %>
			<a class="with-route" data-route="page:{{ path('agent_org_view', {'organization_id': '0000'})|replace({'0000': '<%= ticket_display.organization.id %>'}) }}" data-route-title="@text"><%- ticket_display.organization.name %></a>
		<% } %>
		<% if (field == 'date_created') { %>
			<span dp-timeago auto-update timestamp="<%= ticket_display.date_created_ts %>" />
		<% } %>
		<% if (field == 'date_user_waiting') { %>
			<span dp-timeago auto-update timestamp="<%= ticket_display.date_user_waiting_ts %>" no-suffix />
		<% } %>
		<% if (field == 'date_resolved') { %>
			<span dp-timeago auto-update timestamp="<%= ticket_display.date_resolved_ts %>" />
		<% } %>
		<% if (field == 'date_last_user_reply') { %>
			<span dp-timeago auto-update timestamp="<%= ticket_display.date_last_user_reply_ts %>" />
		<% } %>
		<% if (field == 'date_last_agent_reply') { %>
			<span dp-timeago auto-update timestamp="<%= ticket_display.date_last_agent_reply_ts %>" />
		<% } %>
		<% if (field == 'date_last_reply') { %>
			<% if (ticket_display.date_last_agent_reply && (!ticket_display.date_last_user_reply || ticket_display.date_last_agent_reply_ts > ticket_display.date_last_user_reply_ts)) { %>
				<span class="prop-val">
					<span dp-timeago auto-update timestamp="<%= ticket_display.date_last_agent_reply_ts %>" />
				</span>
			<% } %>
			<% if (ticket_display.date_last_user_reply && (!ticket_display.date_last_agent_reply || ticket_display.date_last_user_reply_ts > ticket_display.date_last_agent_reply_ts)) { %>
				<span dp-timeago auto-update timestamp="<%= ticket_display.date_last_user_reply_ts %>" />
			<% } %>
		<% } %>
		<% if (field == 'total_user_waiting') { %>
			<span class="prop-val">
				<span ng-bind="<%= parseInt(
					(ticket_display.total_user_waiting || 0)
					+ (
						(ticket_display.date_user_waiting_ts || ticket_display.date_created_ts)
						- ((new Date()).getTime()/1000)
					)
				) %>|formatSeconds"></span>
			</span>
		<% } %>
		<% if (field == 'slas') { %>
			<span class="prop-val">
				<% for (var slaIdx = 0; slaIdx < ticket_display.ticket_slas.length; slaIdx++) { var ticket_sla = ticket_display.ticket_slas[slaIdx]; %>
				<span class="prop-val sla-status-<%= ticket_sla.sla_status %>">
					<%- ticket_sla.sla.title %>
					<% if (ticket_sla.next_trigger_date_ts) { %>
						(<span dp-timeago auto-update timestamp="<%= ticket_sla.next_trigger_date_ts %>" no-suffix />)
					<% } %>
				</span>
				<% } %>
			</span>
		<% } %>

		{% for field in app.getCustomFieldManager('tickets').getFields() %}
			<% if (field == 'ticket_fields[{{ field.id }}]') { %>
				<span class="prop-val"><%- ticket_display.field{{ field.id }} %></span>
			<% } %>
		{% endfor %}
		{% for field in app.getCustomFieldManager('people').getFields() %}
			<% if (field == 'person_fields[{{ field.id }}]') { %>
				<span class="prop-val"><%- ticket_display.person.field{{ field.id }} %></span>
			<% } %>
		{% endfor %}
		</div>
	</td>
<% } %>
