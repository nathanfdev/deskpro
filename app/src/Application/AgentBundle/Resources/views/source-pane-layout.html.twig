{% import 'AgentBundle:Common:agent-macros.html.twig' as layout %}
{% set _nothing %}{% block dp_declare %}{% endblock %}{% endset %}
{% block top %}{% endblock %}
<div class="source-pane-instance {{ add_classname }}">
	<div class="source-pane-header">
		{% block pane_header %}
			<ul class="pane-tabs">
				{% block pane_main_tab %}{% endblock %}
				{% block pane_other_tabs %}<li class="tab" data-tab-id="pane-content-search"><i class="icon-search"></i> Search</li>{% endblock %}
			</ul>
		{% endblock %}
	</div>
	<div class="source-pane-content">
		{{ layout.scroll_containers() }}
			{% block pane_content %}{% endblock %}
		{{ layout.scroll_containers_end() }}
	</div>
</div>