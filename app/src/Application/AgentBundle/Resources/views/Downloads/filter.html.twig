<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.DownloadList';
pageMeta.refreshUrl = '{{ path('agent_downloads_list', {'cache_id': result_id}) }}';

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
{# scroll containers #}
<div class="layout-content with-scrollbar page-listing page-downloads-filter">
<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
<div class="scroll-viewport"><div class="scroll-content">
{# /scroll containers #}

	{% include 'AgentBundle:Downloads:filter-display-options.html.twig' %}
	{% include 'AgentBundle:Downloads:filter-control-bar.html.twig' %}

	<section class="downloads-simple-list list-listing no-check">
		{% include 'AgentBundle:Downloads:filter-page.html.twig' %}
	</section>

	{% if not results|length %}
		<section class="list-listing no-results">
			<p>{{ phrase('global.there_are_no_results') }}</p>
		</section>
	{% endif %}

	{% if results|length %}
		<footer class="results-nav">
			<div class="cursor">
                {% set phrase_part %}
                <span class="results-total-count" id="{{baseId}}_total_count">{{ results|length }}</span>
                {% endset %}
                {{ phrase('agent.downloads.showing_count_downloads', {'count':results|length,'display_count':phrase_part}) }}
			</div>
		</footer>
	{% endif %}
</div>

{# scroll containers #}
</div></div></div></div>
{# /scroll containers #}
