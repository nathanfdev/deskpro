{% import 'AgentBundle:Common:agent-macros.html.twig' as agentui %}
<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.NewDownload';

pageMeta.title = '{{ phrase('agent.global.new_download') }}';
pageMeta.uploadAttachUrl              = '{{ path('agent_accept_upload') }}';

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>

{{ agentui.scroll_containers('page-new-download page-new-content') }}

<a class="tab-anchor" href="#">&nbsp;</a>

<form id="{{baseId}}_newdownload" class="keybound-submit">

<div class="first section cat-section" id="{{baseId}}_cat_section">
	<div class="step">
		<span class="num">1</span>
		<span class="check">{{ phrase('agent.global.done') }}</span>
	</div>
	<div class="content">
		<div class="col">
			<h4>{{ phrase('agent.global.category') }}</h4>
			{% include 'AgentBundle:Common:select-standard.html.twig' with {
				'name': 'newdownload[category_id]',
				'id': baseId ~ '_cat',
				'add_classname': 'category_id',
				'add_attr': '',
				'with_blank': 1,
				'blank_title': '',
				'categories': download_categories,
				'selected': state.newdownload.category_id
			} %}
		</div>
		<div class="col">
			<h4 class="light">{{ phrase('agent.global.status') }}</h4>
			<select name="newdownload[status]">
				<option value="published">{{ phrase('agent.global.published') }}</option>
				<option value="hidden.unpublished">{{ phrase('agent.global.unpublished') }}</option>
				<option value="hidden.draft">{{ phrase('agent.global.draft') }}</option>
				{% if constant('DP_DEBUG') %}
					<option value="hidden.validating" selected="selected">{{ phrase('agent.global.dev_validating') }}</option>
				{% endif %}
			</select>
		</div>
		<br class="clear" />
	</div>
</div>

<div class="section title-section" id="{{baseId}}_title_section">
	<div class="step">
		<span class="num">2</span>
		<span class="check">{{ phrase('agent.global.done') }}</span>
	</div>
	<div class="content">
		<h4>{{ phrase('agent.global.title') }}</h4>
		<input type="title" name="newdownload[title]" id="{{baseId}}_title" value="{{ state.newdownload.title }}" />
	</div>
</div>

<div class="section file-section" id="{{baseId}}_file_section">
	<div class="step">
		<span class="num">3</span>
		<span class="check">{{ phrase('agent.global.done') }}</span>
	</div>
	<div class="content">
		<h4>{{ phrase('agent.global.everyone') }}</h4>
		<input type="file" name="file-upload" multiple="multiple" /> <button class="clean-gray xxx-small">{{ phrase('agent.global.upload') }}</button>
		{% include 'AgentBundle:Common:attach-row-tmpl.html.twig' with {formname: 'newdownload[attach]', noremove: true} %}
        <ul class="files file-list"></ul>
	</div>
</div>

<div class="section article-section" id="{{baseId}}_content_section">
	<div class="step">
		<span class="num">4</span>
		<span class="check">{{ phrase('agent.global.done') }}</span>
	</div>
	<div class="content">
		<h4>{{ phrase('agent.global.description') }}</h4>
		<textarea type="text" name="newdownload[content]" id="{{baseId}}_content">{{ state.newdownload.content }}</textarea>
	</div>
</div>


<div class="section other-section" id="{{baseId}}_other_section">
	<div class="step">
		<span class="num">5</span>
		<span class="check">{{ phrase('agent.global.done') }}</span>
	</div>
	<div class="content">
		{# Tab Container #}
		<div class="tab-container">
			<nav id="{{baseId}}_other_props_tabs_wrap">
				<ul id="{{baseId}}_other_props_tabs">
					<li data-tab-for="> .tab-properties">{{ phrase('agent.global.properties') }}</li>
				</ul>
			</nav>
			<div class="content-wrapper" id="{{baseId}}_other_props_tabs_content" style="display: none">
				{# Tab Properties #}
				<div class="tab-properties" style="display: none">
					<dl>
						<dt class="prop">{{ phrase('agent.global.url_slug') }}</dt>
						<dd class="prop">
							<input type="input" name="newdownload[slug]" id="{{baseId}}_slug" value="{{ state.newdownload.slug }}" />
						</dd>

						<dt class="prop">{{ phrase('agent.global.labels') }}</dt>
						<dd class="prop">
							<div class="tags-wrap article-tags">
								<input type="text" value="{% for label in state.newdownload.labels %}{{label.label}},{% endfor %}" />
							</div>
						</dd>
					</dl>
				</div>
				{# /Tab Properties #}
			</div>
		</div>
		{# /Tab Container #}
	</div>
</div>

<footer class="pop-footer">
	<div class="is-not-loading">
		<button class="submit-trigger clean-white">{{ phrase('agent.downloads.create_download') }} <kbd>{{ phrase('agent.global.altc') }}</kbd></button>
	</div>
	<div class="is-loading" style="padding-top: 9px;">
		<img src="{{ asset('images/spinners/loading-small.gif') }}" />
	</div>
</footer>

</form>

{{ agentui.scroll_containers_end() }}
