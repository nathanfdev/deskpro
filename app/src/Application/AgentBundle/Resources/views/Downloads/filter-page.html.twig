<section class="search-reuslts page-set" data-page="{{ page }}">
	{% for download in results %}
		<article
			class="row-item download download-{{download.id}} downloads-{{download.id}} related-is-linkable"
			data-content-type="downloads"
			data-content-id="{{ download.id }}"
			data-route="download:{{ path('agent_downloads_view', {'download_id': download.id}) }}"
			data-route-title="@selector(a.row-title)"
			data-route-openclass="open"
		>
			{#<input class="item-select" type="checkbox" value="{{download.id}}" />#}
			<div class="top-row">
				<div class="top-row-left">
					<h3>
						<a class="row-title click-through">{{ download.title }}</a>
					</h3>
				</div>
				<div class="top-row-right visible-ticket-controls">
					<div class="bound-faded"></div>
					<span class="tipped kb-insert-link dl-insert-link" title="{{ phrase('agent.insert_link') }}" data-download-id="{{ download.id }}">{{ phrase('agent.insert_link') }}</span>
					<span class="tipped kb-insert-link dl-insert-attach"  title="{{ phrase('agent.insert_content') }}" data-download-id="{{ download.id }}">{{ phrase('agent.add_attachment') }}</span>
				</div>
				<div class="top-row-right visible-related-content-controls">
					<div class="bound-faded"></div>
					<span class="tipped related-link" title="{{ phrase('global.add_as_related') }}"></span>
					<span class="tipped related-unlink" title="{{ phrase('global.remove_as_related') }}"></span>
				</div>
			</div>
			<hr class="clear-top" />
			{% if display_fields|length %}
				<div class="extra-fields">
					<ul>
						{% for field in display_fields %}
							{% if field == 'category' %}
								<li>
									<span class="prop-title">{{ phrase('global.category') }}</span>
									<span class="prop-val">{{ download.category.full_title }}</span>
								</li>
							{% elseif field == 'author' %}
								<li>
									<span class="prop-title">{{ phrase('global.author') }}</span>
									<span class="prop-val">{{ download.person.display_name }}</span>
								</li>
							{% elseif field == 'date_created' %}
								<li>
									<span class="prop-title">{{ phrase('global.date_created') }}</span>
									<span class="prop-val">{{ download.date_created|date('day')}}</span>
								</li>
							{% elseif field == 'num_downloads' %}
								<li>
									<span class="prop-title">{{ phrase('agent.num_downloads') }}</span>
									<span class="prop-val">{{ download.num_downloads|default(0) }}</span>
								</li>
							{% endif %}
						{% endfor %}
					</ul>
					<br class="clear" />
				</div>
			{% else %}
				<br class="clear" />
			{% endif %}
		</article>
	{% endfor %}
</section>
