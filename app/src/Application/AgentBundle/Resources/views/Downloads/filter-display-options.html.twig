{% extends 'AgentBundle:Common:display-options-layout.html.twig' %}
{% block other_options %}
	<div style="display: none">
		{{ phrase('agent.order_by') }}: <select name="order_by" class="sel-order-by">
		<option class="date_created" value="downloads.date_created:desc">{{ phrase('agent.date_created_newestoldest') }}</option>
		<option value="downloads.date_created:asc">{{ phrase('agent.date_created_oldestnewest') }}</option>
		<option class="num_downloads" value="downloads.num_downloads:desc">{{ phrase('agent.publish.number_of_downloads_highestlowest') }}</option>
		<option value="downloads.num_downloads:asc">{{ phrase('agent.publish.number_of_downloads_lowesthighest') }}</option>
		</select>
	</div>
{% endblock %}
{% block display_elements_list %}
	<li data-field="author"><input type="checkbox" name="author" {% if 'author' in display_fields %}checked="checked"{% endif %} /> {{ phrase('agent.author') }}</li>
	<li data-field="category"><input type="checkbox" name="category" {% if 'category' in display_fields %}checked="checked"{% endif %} /> {{ phrase('agent.category') }}</li>
	<li data-field="date_created"><input type="checkbox" name="date_created" {% if 'date_created' in display_fields %}checked="checked"{% endif %} /> {{ phrase('agent.date_created') }}</li>
	<li data-field="num_downloads"><input type="checkbox" name="num_downloads" {% if 'num_downloads' in display_fields %}checked="checked"{% endif %} /> {{ phrase('agent.num_downloads') }}</li>
{% endblock %}
