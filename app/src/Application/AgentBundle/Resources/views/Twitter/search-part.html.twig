{% for result in results %}
    <table width="100%" cellpadding="0" cellspacing="0" >
        <tr class="user-info">
            <td colspan="2">
                <div class="top-row-left">
                    <div class="user" data-route="page:{{ path('agent_twitter_user', {'user_id': status.user.id}) }}">
                        <h4 class="screen_name">@{{ result.from_user }}</h4> /
                        <span class="name">{{ result.from_user_name }}</span>
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="avatar" width="48px">
                <div class="photo" data-route="page:{{ path('agent_twitter_user', {'user_id': status.user.id}) }}">
                    <img src="{{ result.profile_image_url }}" width="48" height="48" border="0" />
                </div>
                <div class="user-meta">
                    {% if result.from_user_id_str is not sameas(account.user.id) %}
                        {% if result.from_user_id_str in account.friend_ids %}
                            <button class="clean-white small unfollow"><a>{{ phrase('agent.twitter.unfollow') }}</a></button>
                        {% else %}
                            <button class="clean-white small follow"><a>{{ phrase('agent.twitter.follow') }}</a></button>
                        {% endif %}
                    {% endif %}
                </div>
            </td>
            <td>
                <div class="status-text">
                        <p class="raw"><span>{{ result.text|raw }}</span></p>
                </div>
            </td>
        </tr>
    </table>

{% endfor %}
