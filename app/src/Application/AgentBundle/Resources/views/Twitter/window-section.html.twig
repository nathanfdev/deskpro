
<section class="source-section">
	<ul class="source-list">
		<li class="auto-load-route" data-route="listpane:{{ path('agent_twitter_starred_tweets_list') }}">
			<h3 class="title">
				<span class="list-counter" id="twitter_starred_statuses_count">{{ statuses.starred|default(0) }}</span>
				{{ phrase('agent.twitter.starred_tweets') }}
			</h3>
		</li>
		<li data-route="listpane:{{ path('agent_twitter_my_tweets_list') }}">
			<h3 class="title">
				<span class="list-counter" id="twitter_my_statuses_count">{{ statuses.account|default(0) }}</span>
				{{ phrase('agent.twitter.my_tweets') }}
			</h3>
		</li>
		{% if app.getSetting('core.use_agent_team') %}
		<li data-route="listpane:{{ path('agent_twitter_team_tweets_list') }}">
			<h3 class="title">
				<span class="list-counter" id="twitter_team_statuses_count">{{ statuses.team|default(0) }}</span>
				{{ phrase('agent.twitter.team_tweets') }}
			</h3>
		</li>
		{% endif %}
	</ul>
</section>

{% for account in accounts %}
	<section class="source-section">
		<header>
			<h1>@{{ account.user.screen_name }}</h1>
		</header>
	</section>
	<ul class="source-list with-tree no-editor" style="margin-bottom: 10px">
		<li class="has-children dp-cat-li sub-expanded">
			<div class="item-wrap dp-cat-item">
				<span class="sub-toggle">{{ phrase('agent.general.expand') }}</span>

				<span class="title" data-route="listpane:{{ path('agent_twitter_inbox_list', {'account_id': account.id}) }}">
					<span class="list-counter" id="twitter_{{ account.id }}_inbox_count" data-count="{{ account.countInbox() }}">{{ account.countInbox() }}</span>
					<span>{{ phrase('agent.general.inbox') }}</span>
				</span>
			</div>
			<ul class="sub-group">
				<li class="dp-cat-li">
					<div class="item-wrap dp-cat-item">
						<span class="title" data-route="listpane:{{ path('agent_twitter_messages_list', {'account_id': account.id}) }}">
							<span class="list-counter" id="twitter_{{ account.id }}_direct_count" data-count="{{ account.countMessages() }}">{{ account.countMessages() }}</span>
							<span>{{ phrase('agent.twitter.direct') }}</span>
						</span>
					</div>
				</li>
				<li class="dp-cat-li">
					<div class="item-wrap dp-cat-item">
						<span class="title" data-route="listpane:{{ path('agent_twitter_replies_list', {'account_id': account.id}) }}">
							<span class="list-counter" id="twitter_{{ account.id }}_replies_count" data-count="{{ account.countReplies() }}">{{ account.countReplies() }}</span>
							<span>{{ phrase('agent.twitter.replies') }}</span>
						</span>
					</div>
				</li>
				<li class="dp-cat-li">
					<div class="item-wrap dp-cat-item">
						<span class="title" data-route="listpane:{{ path('agent_twitter_mentions_list', {'account_id': account.id}) }}">
							<span class="list-counter" id="twitter_{{ account.id }}_mentions_count" data-count="{{ account.countMentions() }}">{{ account.countMentions() }}</span>
							<span>{{ phrase('agent.general.mentions') }}</span>
						</span>
					</div>
				</li>
				<li class="dp-cat-li">
					<div class="item-wrap dp-cat-item">
						<span class="title" data-route="listpane:{{ path('agent_twitter_retweets_list', {'account_id': account.id}) }}">
							<span class="list-counter" id="twitter_{{ account.id }}_retweets_count" data-count="{{ account.countRetweets() }}">{{ account.countRetweets() }}</span>
							<span>{{ phrase('agent.twitter.retweets') }}</span>
						</span>
					</div>
				</li>
			</ul>
		</li>

		<li class="has-children dp-cat-li">
			<div class="item-wrap dp-cat-item">
				<span class="title" data-route="listpane:{{ path('agent_twitter_followers_list_new', {'account_id': account.id}) }}">
					<span class="list-counter" id="twitter_{{ account.id }}_new_followers_count" data-count="{{ account.countNewFollowers() }}">{{ account.countNewFollowers() }}</span>
					<span>{{ phrase('agent.twitter.new_followers') }}</span>
				</span>
			</div>
		</li>

		<li class="has-children dp-cat-li">
			<div class="item-wrap dp-cat-item">
				<span class="sub-toggle">{{ phrase('agent.general.expand') }}</span>

				<span class="title" data-route="listpane:{{ path('agent_twitter_list_searches', {'account_id': account.id}) }}">
					<span class="list-counter" id="twitter_{{ account.id }}_searches_count" data-count="{{ account.searches.count|default(0) }}">{{ account.searches.count|default(0) }}</span>
					<span>{{ phrase('agent.twitter.searches') }}</span>
				</span>
			</div>
			<ul class="sub-group">
				{% for search in account.searches %}
					<li class="dp-cat-li">
						<div class="item-wrap dp-cat-item">
							<span class="title" data-route="listpane:{{ path('agent_twitter_run_search', {'account_id': account.id, 'search_id': search.id}) }}">
								<span>{{ search.term }}</span>
							</span>
						</div>
					</li>
				{% endfor %}
			</ul>
		</li>

		<li class="dp-cat-li">
			<div class="item-wrap dp-cat-item">
				<span class="title" data-route="listpane:{{ path('agent_twitter_timeline_list', {'account_id': account.id}) }}">
					<span class="list-counter" id="twitter_{{ account.id }}_timeline_count" data-count="{{ account.countTimeline() }}">{{ account.countTimeline() }}</span>
					<span>Timeline</span>
				</span>
			</div>
		</li>

		<li class="dp-cat-li">
			<div class="item-wrap dp-cat-item">
				<span class="title" data-route="listpane:{{ path('agent_twitter_outgoing_list', {'account_id': account.id}) }}">
					<span class="list-counter" id="twitter_{{ account.id }}_sent_count" data-count="{{ account.countOutgoing() }}">{{ account.countOutgoing() }}</span>
					<span>{{ phrase('agent.twitter.sent') }}</span>
				</span>
			</div>
		</li>

		<li class="dp-cat-li">
			<div class="item-wrap dp-cat-item">
				<span class="title" data-route="listpane:{{ path('agent_twitter_followers_list', {'account_id': account.id}) }}">
					<span class="list-counter" id="twitter_{{ account.id }}_followers_count" data-count="{{ account.countFollowers() }}">{{ account.countFollowers() }}</span>
					<span>{{ phrase('agent.general.followers') }}</span>
				</span>
			</div>
		</li>
	</ul>

{% endfor %}
