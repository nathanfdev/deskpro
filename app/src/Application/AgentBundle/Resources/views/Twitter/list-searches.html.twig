<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.TwitterAccountSearchList';

pageMeta.accountId = '{{ account.id|escape }}';

pageMeta.newSearchUrl = '{{ path('agent_twitter_new_search', { 'account_id': account.id }) }}';
{% include 'AgentBundle:Twitter:list-urls.js.twig' %}
</script>


{# scroll containers #}
<div class="layout-content with-scrollbar page-listing">
<div class="scrollbar disable"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
<div class="scroll-viewport"><div class="scroll-content">
{# /scroll containers #}

<div class="layout-content twitter">

    {% include 'AgentBundle:Twitter:search-control-bar.html.twig' %}

    <div class="content">
        <section class="search-results list-listing">
		{% for search in account.searches %}
			<article
				class="row-item twitter-search"
				data-route="listpane:{{ path('agent_twitter_run_search', {'account_id': account.id, 'search_id': search.id}) }}"
				style="padding: 8px"
			>
				<a style="float: right" class="delete-icon" data-confirm="Are you sure you want to delete this search?" href="{{ path('agent_twitter_search_delete', {'account_id': account.id, 'search_id': search.id, 'security_token': security_token('delete_search')}) }}">Delete</a>
				<a class="click-through">{{ search.term }}</a>
			</article>
		{% endfor %}
        </section>

		<section class="list-listing no-results" id="{{baseId}}_no_results" {% if account.searches|length %}style="display:none"{% endif %}>
			<article class="row-item no-results">
				<p style="padding: 15px;">{{ phrase('agent.general.there_are_no_results') }}</p>
			</article>
		</section>
    </div>
</div>

{# scroll containers #}
</div></div></div>
{# /scroll containers #}
