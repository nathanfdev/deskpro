<section id="publish_outline_glossary">
	<ul class="source-list">
		<li class="all on">
			<span class="add-new tipped glossary-new-trigger" title="{{ phrase('agent.publish.add_new_glossary') }}"></span>
			<span class="title">
				{{ phrase('agent.publish.words', {'count':glossary_count}) }}
			</span>
		</li>
	</ul>

	<section class="source-labels-list">
		<dl>
			{% for letter,words in glossary_words %}
				<dt data-letter="{{ letter }}" {% if not words|length %}style="display: none"{% endif %}>{{ letter }}</dt>
				<dd data-letter="{{ letter }}" {% if not words|length %}style="display: none"{% endif %}>
					<ul>
						{% for id,word in words %}
							<li>
								<span class="glossary-word-trigger word-{{id}}" data-word-id="{{id}}">
								{{word}}
								</span>
							</li>
						{% endfor %}
					</ul>
				</dd>
			{% endfor %}
		</dl>
	</section>

	<div class="glossary-add-dlg dp-overlay" style="display:none;">
		<div class="overlay-title"><h4>{{ phrase('agent.publish.add_new_glossary') }}</h4></div>
		<div class="overlay-content">
			<input type="text" class="word" value="" style="width: 150px; margin-bottom: 5px;" placeholder="{{ phrase('agent.publish.word_title') }}" /><br />
			<textarea class="content" rows="2" cols="50" style="width: 98%; height: 175px;" placeholder="{{ phrase('agent.publish.word_def') }}"></textarea>
		</div>
		<div class="overlay-footer">
			<button class="clean-white save-trigger">{{ phrase('agent.add') }}</button>
		</div>
	</div>

	<div class="glossary-edit-dlg dp-overlay" style="display:none;">
		<div class="overlay-title"><h4>{{ phrase('agent.publish.edit_new_glossary') }}</h4></div>
		<div class="overlay-content">
			<div class="form">
				<strong class="word"></strong><br />
				<input type="hidden" class="word_id" value="" />
				<textarea class="content" rows="2" cols="50" style="width: 98%; height: 165px"></textarea>
			</div>
		</div>
		<div class="overlay-footer">
			<button class="clean-white delete-trigger">{{ phrase('agent.delete') }}</button>
			<button class="clean-white save-trigger">{{ phrase('agent.save') }}</button>
		</div>
	</div>
</section>
