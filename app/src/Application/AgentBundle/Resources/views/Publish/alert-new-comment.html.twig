<<li class="publish inside"
	data-type="publish"
	data-route="listpane:{{ path('agent_publish_validatingcomments') }}"
>
	<div class="dismiss"><i class="icon-ban-circle"></i></div>
	<time></time>
	<big>New comment on {{ comment.getObject().title }}</big>
	<small>
		Comment by {{ comment.getUserDisplayContact() }}
		{% if comment.status == 'validating' %}requires validation{% endif %}
	</small>
</li>