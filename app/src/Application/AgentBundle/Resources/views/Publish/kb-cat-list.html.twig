{% for cat in cats %}
	<li
		class="{% if loop.first %}auto-load-route{% endif %} kb-cat-{{ cat.id }} {% if cat.children|length %}has-children{% endif %}"
		data-category-id="{{ cat.id }}"
		data-usergroup-ids="{{ kb_cats_usergroups[cat.id]|default([])|join(',') }}"
	>
		<span class="edit-cat">{{ phrase('agent.edit') }}</span>
		<span class="delete-cat" {% if counts[cat.id] %}style="display: none"{% endif %}>{{ phrase('agent.delete') }}</span>
		<span class="sub-toggle">{{ phrase('agent.expand') }}</span>
		<span class="title is-nav-item fitted" data-route="listpane:{{ path('agent_kb_list', {'category_id':cat.id}) }}">
			<span class="list-counter"
				id="kb_cat_count_{{ cat.id }}"
				data-count="{{ counts[cat.id]|default(0) }}"
			>{{ counts[cat.id]|default(0) }}</span>
			<span class="title-edit">{{ cat.title }}</span>
			<em class="spacer">&nbsp;</em>
		</span>
		<ul class="sub-group">
			{% if cat.children|length %}
				{% include 'AgentBundle:Publish:kb-cat-list.html.twig' with {'cats': cat.children, 'counts': counts, 'depth': depth+1 } %}
			{% endif %}
		</ul>
	</li>
{% endfor %}
