<div id="publish_outline_kb_tab">
	<section id="publish_outline_kb">
		<ul class="source-list with-tree" id="publish_outline_articlescat_list">
			<li class="all">
				{% if app.user.hasPerm('agent_publish.create') %}
					<span class="edit-mode tipped" id="publish_outline_articlescat_editmode" title="{{ phrase('agent.global.edit_categories') }}"></span>
					<span class="add-new-cat tipped" id="publish_outline_articlescat_addcat" title="{{ phrase('agent.create_new_category') }}"></span>
					<span class="add-new-article tipped" id="publish_outline_articles_add" title="{{ phrase('agent.create_article') }}" data-newloader-name="newArticleLoader"></span>
				{% endif %}
				<span class="all-route title" data-route="listpane:{{ path('agent_kb_list') }}">
					{{ phrase('agent.publish.count_articles', {'count': kb_cats_counts['0_total']|default(0)}) }}
				</span>
			</li>
			{% include 'AgentBundle:Publish:kb-cat-list.html.twig' with {'cats': kb_cats, 'counts': kb_cats_counts, 'depth': 0 } %}
		</ul>
	</section>

	<br class="clear" />
</div>
