<div id="publish_outline_kb_tab">
	<section id="publish_outline_kb">
		<div class="tree-restructure-loading-message"><h3>Saving Structure</h3></div>
		<ul class="source-list with-tree" id="publish_outline_articlescat_list">
			<li class="all">
				{% if app.user.hasPerm('agent_publish.create') %}
					<span class="edit-mode tipped" id="publish_outline_articlescat_editmode" title="{{ phrase('agent.general.edit_categories') }}"></span>
					<span class="add-new-cat tipped" id="publish_outline_articlescat_addcat" title="{{ phrase('agent.general.create_new_category') }}"></span>
					<span class="add-new-article tipped" id="publish_outline_articles_add" title="{{ phrase('agent.general.create_article') }}" data-newloader-name="newArticleLoader"></span>
				{% endif %}
				<span class="all-route title" data-route="listpane:{{ path('agent_kb_list') }}">
					{{ phrase('agent.publish.count_articles', {'count': kb_cats_counts['0_total']|default(0)}) }}
				</span>
				<div class="cat-editor-instruction">
					Drag and drop to move folders, click the gears to edit titles and permissions, and click the recycle bin to delete empty categories.
				</div>
			</li>
			{% include 'AgentBundle:Publish:kb-cat-list.html.twig' with {'cats': kb_cats, 'counts': kb_cats_counts, 'depth': 0 } %}
		</ul>

		{% if kb_translate_queue[0] %}
			<ul class="source-list with-tree" style="margin-top: 15px;">
				<li class="has-children">
					<span class="sub-toggle" style="left:3px;" onclick="$(this).parent().find('.sub-group').toggle(); $(this).parent().toggleClass('sub-expanded');"></span>
					<span data-route="listpane:{{ path('agent_kb_list', {pending_translate: 1}) }}" class="is-nav-item title" style="padding-left: 16px;">
						<span class="list-counter">{{ kb_translate_queue[0] }}</span>
						{{ phrase('agent.publish.untranslated_articles') }}
					</span>
					<ul class="sub-group">
						{% for lang_id, count in kb_translate_queue if lang_id > 0 and count > 0 %}
							<li data-route="listpane:{{ path('agent_kb_list', {pending_translate: 1, language_id: lang_id}) }}">
								<span class="title is-nav-item fitted" style="padding-left: 20px;">
									<span class="list-counter">{{ count }}</span>
									{{ app.languages.get(lang_id).title }}
								</span>
							</li>
						{% endfor %}
					</ul>
				</li>
			</ul>
		{% endif %}
	</section>

	<br class="clear" />
</div>
