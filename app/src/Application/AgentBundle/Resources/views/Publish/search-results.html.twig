<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.Basic';
</script>
{# scroll containers #}
<div class="layout-content with-scrollbar page-listing">
<div class="scrollbar disable"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
<div class="scroll-viewport"><div class="scroll-content">
{# /scroll containers #}

<section class="feedback-simple-list list-listing">
	<section class="search-reuslts page-set" data-page="{{ page }}">
	{% for res in results %}
		{% if res.type == 'article' %}
			{% set article = res.object %}
			<article
				class="row-item article article-{{article.id}} articles-{{article.id}} related-is-linkable"
				data-content-type="articles"
				data-content-id="{{ article.id }}"
				data-route="page:{{ path('agent_kb_article', {'article_id': article.id}) }}"
				data-route-title="@selector(a.row-title)"
				data-route-openclass="open"
			>
				<div class="top-row">
					<div class="top-row-left">
						<h3>
							<a class="row-title click-through">{{ article.title }}</a>
						</h3>
					</div>
					<div class="top-row-right visible-ticket-controls">
						<div class="bound-faded"></div>
						<span class="tipped kb-insert-link" title="{{ phrase('agent.general.insert_link') }}" data-article-id="{{ article.id }}"></span>
						<span class="tipped kb-insert-content" title="{{ phrase('agent.general.insert_content') }}" data-article-id="{{ article.id }}"></span>
					</div>
					<div class="top-row-right visible-related-content-controls">
						<div class="bound-faded"></div>
						<span class="tipped related-link" title="{{ phrase('agent.general.add_as_related') }}"></span>
						<span class="tipped related-unlink" title="{{ phrase('agent.general.remove_as_related') }}"></span>
					</div>
				</div>
				<hr class="clear-top" />
				<div class="extra-fields">
					<ul>
						<li>
							<span class="prop-title">{{ phrase('agent.general.category') }}</span>
							<span class="prop-val">{{ article.category_names }}</span>
						</li>
						<li>
							<span class="prop-title">{{ phrase('agent.general.author') }}</span>
							<span class="prop-val">{{ article.by_line }}</span>
						</li>
						<li>
							<span class="prop-title">{{ phrase('agent.general.date_created') }}</span>
							<span class="prop-val">{{ article.date_created|date('day')}}</span>
						</li>
						<li>
							<span class="prop-title">{{ phrase('agent.general.num_views') }}</span>
							<span class="prop-val">{{ article.view_count|default(0) }}</span>
						</li>
					</ul>
					<br class="clear" />
				</div>
			</article>
		{% elseif res.type == 'download' %}
			{% set downlod = res.object %}
			<article class="download download-{{download.id}}">
				<div class="title">
					<a class="with-route" data-route="page:{{ path('agent_downloads_view', {'download_id': download.id}) }}">{{ download.title }}</a>
				</div>
				<div class="info">
					<ul>
						<li>{{ download.category.full_title }}</li>
						{% if download.person %}<li>{{ download.person.display_name }}</li>{% endif %}
						<li>{{ download.filename }}</li>
					</ul>
				</div>
			</article>
		{% elseif res.type == 'feedback' %}
			{% set feedback = res.object %}
			<article
				class="row-item feedback feedback-{{feedback.id}} feedback-{{feedback.id}} related-is-linkable"
				data-content-type="feedback"
				data-content-id="{{ feedback.id }}"
				data-route="page:{{ path('agent_feedback_view', {'feedback_id': feedback.id}) }}"
				data-route-title="@selector(a.feedback-title)"
				data-route-openclass="open"
			>
				<div class="top-row">
					<div class="top-row-left">
						<span class="votes">
							{{ feedback.num_ratings|default(0) }}
						</span>
						<h3>
							<a class="feedback-title click-through">{{ feedback.title }}</a>
						</h3>
					</div>
					<div class="top-row-right visible-related-content-controls">
						<div class="bound-faded"></div>
						<span class="tipped related-link" title="{{ phrase('agent.general.add_as_related') }}"></span>
						<span class="tipped related-unlink" title="{{ phrase('agent.general.remove_as_related') }}"></span>
					</div>
				</div>
				<hr class="clear-top" />
				<div class="extra-fields">
					<ul>
						<li>
							<span class="prop-title">{{ phrase('agent.general.category') }}</span>
							<span class="prop-val">{{ feedback.category.full_title }}</span>
						</li>
						<li>
							<span class="prop-title">{{ phrase('agent.general.author') }}</span>
							<span class="prop-val">{{ feedback.person.display_name }} {% if feedback.person.primary_email_address %}({{ feedback.person.primary_email_address }}){% endif %}</span>
						</li>
						<li>
							<span class="prop-title">{{ phrase('agent.general.date_created') }}</span>
							<span class="prop-val">{{ feedback.date_created|date('day')}}</span>
						</li>
					</ul>
					<br class="clear" />
				</div>
			</article>
		{% elseif res.type == 'news' %}
			{% set news = res.object %}
			<article
				class="row-item news news-{{news.id}} related-is-linkable"
				data-content-type="news"
				data-content-id="{{ news.id }}"
				data-route="page:{{ path('agent_news_view', {'news_id': news.id}) }}"
				data-route-title="@selector(a.row-title)"
				data-route-openclass="open"
			>
				<div class="top-row">
					<div class="top-row-left">
						<h3>
							<a class="row-title click-through">{{ news.title }}</a>
						</h3>
					</div>
					<div class="top-row-right visible-related-content-controls">
						<div class="bound-faded"></div>
						<span class="tipped related-link" title="{{ phrase('agent.general.add_as_related') }}"></span>
						<span class="tipped related-unlink" title="{{ phrase('agent.general.remove_as_related') }}"></span>
					</div>
				</div>
				<hr class="clear-top" />
				<div class="extra-fields">
					<ul>
						<li>
							<span class="prop-title">{{ phrase('agent.general.category') }}</span>
							<span class="prop-val">{{ news.category.full_title }}</span>
						</li>

						<li>
							<span class="prop-title">{{ phrase('agent.general.author') }}</span>
							<span class="prop-val">{{ news.person.display_name }}</span>
						</li>

						<li>
							<span class="prop-title">{{ phrase('agent.general.date_created') }}</span>
							<span class="prop-val">{{ news.date_created|date('day')}}</span>
						</li>
					</ul>
					<br class="clear" />
				</div>
			</article>
		{% endif %}
	{% endfor %}
	</section>
</section>

{# scroll containers #}
</div></div></div>
{# /scroll containers #}
