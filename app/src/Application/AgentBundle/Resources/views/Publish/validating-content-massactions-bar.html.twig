<header class="list-selection-bar">
	<input type="checkbox" class="selection-control" />
    {% set phrase_part %}
        <span class="selected-count">0</span>
    {% endset %}
    {{ phrase('global.display_count_selected', {'display_count':phrase_part}) }}
	<a class="perform-action perform-actions-trigger disabled menu-fitted">
		<span>{{ phrase('agent.perform_actions') }}</span>
	</a>
	<ul class="actions-menu" style="display: none">
		<li data-action="approve">{{ phrase('agent.approve') }}</li>
		<li data-action="disapprove">{{ phrase('agent.delete') }}</li>
	</ul>
</header>
