{% if app.user.hasPerm('agent_publish.validate') %}
<section class="source-section">
	<header><h1>{{ phrase('agent.general.pending') }}</h1></header>
	<article>
		<section class="source-section sys-filters-section">
			<ul class="source-list">
				<li class="is-nav-item" data-route="listpane:{{ path('agent_publish_validatingcomments') }}">
					<h3 class="title">
						<span class="list-counter" id="publish_validating_comments_count">{{ counts.validating_comments|default(0) }}</span>
						{{ phrase('agent.publish.comments_to_validate') }}
					</h3>
				</li>
				<li class="is-nav-item auto-load-route" data-route="listpane:{{ path('agent_public_validatingcontent') }}">
					<h3 class="title">
						<span class="list-counter" id="publish_validating_count">{{ counts.validating_content|default(0) }}</span>
						{{ phrase('agent.publish.content_to_validate') }}
					</h3>
				</li>
				<li class="is-nav-item" data-route="listpane:{{ path('agent_kb_pending') }}">
					<h3 class="title">
						<span class="list-counter" id="kb_pending_count">{{ counts.pending|default(0) }}</span>
						{{ phrase('agent.publish.pending_articles') }}
					</h3>
				</li>
				<li class="is-nav-item" data-route="listpane:{{ path('agent_public_drafts', {'type': 'mine'}) }}">
					<h3 class="title">
						<span class="list-counter" id="publish_drafts_count">{{ counts.drafts|default(0) }}</span>
						{{ phrase('agent.publish.draft_content') }}
					</h3>
				</li>

				<li class="is-nav-item" data-route="listpane:{{ path('agent_public_drafts', {'type': 'all'}) }}">
					<h3 class="title">
						<span class="list-counter" id="publish_drafts_count">{{ counts.all_drafts|default(0) }}</span>
						{{ phrase('agent.publish.all_draft_content') }}
					</h3>
				</li>
			</ul>
		</section>
	</article>
</section>
{% endif %}

<section class="group-section open">
	<header><h1>{{ phrase('agent.general.knowledgebase') }}</h1></header>
	<article>
		{% include 'AgentBundle:Publish:kb-tab.html.twig' %}
	</article>
</section>

<section class="group-section">
	<header><h1>{{ phrase('agent.general.news') }}</h1></header>
	<article style="display: none">
		{% include 'AgentBundle:Publish:news-tab.html.twig' %}
	</article>
</section>

<section class="group-section">
	<header><h1>{{ phrase('agent.general.downloads') }}</h1></header>
	<article style="display: none">
		{% include 'AgentBundle:Publish:downloads-tab.html.twig' %}
	</article>
</section>

<section class="group-section">
	<header><h1>{{ phrase('agent.publish.glossary') }}</h1></header>
	<article style="display: none">
		{% include 'AgentBundle:Publish:kb-glossary.html.twig' %}
		<br class="clear" />
	</article>
</section>

{# Category editor #}
<div id="publish_cat_editor_backdrop" class="backdrop cat-editor-backdrop" style="position: absolute; top:0;left:0;right:0;bottom:0; display: none;"></div>
<div id="publish_cat_editor_tab" class="cat-editor-tab" style="display: none">
	<input type="text" class="title" />
</div>
<div id="publish_cat_editor" class="cat-editor" style="display: none">
	<span class="close-trigger">x</span>
	<h5>{{ phrase('agent.general.usergroups') }}</h5>
	<div class="list">
		{% for ug in usergroups %}
			<label>
				<input type="checkbox" class="usergroup usergroup-{{ ug.id }} {% if ug.sys_name == 'everyone' %}everyone{% endif %}" value="{{ ug.id }}" />
				{% if ug.sys_name %}
					{{ phrase('agent.general.usergroup_' ~ ug.sys_name) }}
				{% else %}
					{{ ug.title }}
				{% endif %}
			</label>
		{% endfor %}
	</div>
</div>
<div id="publish_cat_editor_shadowbreak" class="cat-editor-shadow-breaker" style="display: none" />

<script type="text/x-deskpro-plain" id="publish_outline_cat_list_newitem">
	<li	>
		<span class="edit-cat">edit</span>
		<span class="delete-cat">{{ phrase('agent.general.delete') }}</span>
		<span class="sub-toggle">{{ phrase('agent.general.expand') }}</span>
		<span class="title is-nav-item fitted">
			<span class="list-counter" data-count="0">0</span>
			<span class="title-edit">{{ phrase('agent.general.add_category') }}</span>
			<em class="spacer">&nbsp;</em>
		</span>
		<ul class="sub-group"></ul>
	</li>
</script>
