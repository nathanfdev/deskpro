<li
	class="task task-row-{{ task.id }}"
	data-class-id="task-row-{{ task.id }}"
	data-type="tasks"
	{% if task.assigned_agent %}
		data-route="listpane:{{ path('agent_task_list',{'search_type': 'own', 'search_categoty': 'total'}) }}"
	{% elseif task.assigned_agent_team %}
		data-route="listpane:{{ path('agent_task_list',{'search_type': 'team', 'search_categoty': 'total'}) }}"
	{% endif %}
	data-route-notabreload="1"
	data-icon="{{ asset('images/agent/app-nav/app-tasks.png') }}"
>
	<em class="dismiss"></em>
	<time class="timeago"></time>
	<a><i class="row-icon"></i> {{ task.title }}</a>
	<div class="info">
		{% if task.assigned_agent %}
			Assigned to this task by {{ performer.display_name }}
		{% elseif task.assigned_agent_team %}
			Your team was assigned to this task by {{ performer.display_name }}
		{% endif %}
	</div>
</li>
