{% import 'AgentBundle:Common:agent-macros.html.twig' as agentui %}
<script>
    pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.TaskList';
    pageMeta.search_type = '{{ search_type }}';
    pageMeta.search_category = '{{ search_category }}';

    {% set baseId = el_uid() %}
    pageMeta.baseId = '{{ baseId }}';
</script>
{{ agentui.scroll_containers('page-task-list') }}

{% include 'AgentBundle:Task:task-list-bar.html.twig' %}

<div id="{{baseId}}_task_list">
    {% for group in tasks_grouped %}
    	{% if group.tasks|length %}
			<div class="task-group">
				<header>
					<span class="expand-collapse"></span>
					<h4>{{ group.title }}</h4>
				</header>
				<section>
					{% for task in group.tasks %}
						{% include 'AgentBundle:Task:task-list-row.html.twig' with {'task': task } %}
					{% endfor %}
				</section>
			</div>
		{% endif %}
    {% endfor %}
</div>

{% if completed_tasks|length %}
<div id="{{baseId}}_task_list">
	<div class="task-group collapsed">
		<header>
			<span class="expand-collapse"></span>
			<h4>{{ completed_tasks|length }} {{ phrase('agent.task.completed_tasks') }}</h4>
		</header>
		<section>
			{% for task in completed_tasks %}
				{% include 'AgentBundle:Task:task-list-row.html.twig' with {'task': task } %}
			{% endfor %}
		</section>
	</div>
</div>
{% endif %}

<ul id="{{baseId}}_menu_vis" style="display: none">
	<li data-vis="0">{{ phrase('agent.global.private') }}</li>
	<li data-vis="1">{{ phrase('agent.global.public') }}</li>
</ul>

<div class="optionbox reply-agent-team-ob" id="{{baseId}}_assign_ob" style="display: none">
	<div class="col">
		<section data-section-name="agents">
			<header>
				<h3>{{ phrase('agent.global.agents') }}</h3>
				<input type="text" class="filter-box" placeholder="{{ phrase('agent.global.filter') }}" />
			</header>
			<ul>
				<li class="me last-me">
					<input type="radio" name="{{baseId}}_asignedto" value="{{ app.user.id }}" />
					<label><span class="agent-pic agent-label-{{ app.user.id }}" style="background-image: url({{ app.user.getPictureUrl(16) }})">{{ phrase('agent.global.me') }}</span></label>
				</li>

				{% for agent in agents %}
					{% if agent.id != app.user.id %}
						<li>
							<input type="radio" name="{{baseId}}_asignedto" value="{{ agent.id }}" />
							<label><span class="agent-pic agent-label-{{ agent.id }}" style="background-image: url({{ agent.getPictureUrl(16) }})">{{ agent.display_name }}</span></label>
							<div class="bound-fade"></div>
						</li>
					{% endif %}
				{% endfor %}
			</ul>
		</section>
	</div>
	{% if app.getSetting('core.use_agent_team') %}
	<div class="col">
		<section data-section-name="teams">
			<header>
				<h3>{{ phrase('agent.global.teams') }}</h3>
				<input type="text" class="filter-box" placeholder="{{ phrase('agent.global.filter') }}" />
			</header>
			<ul>
				{% for team in app.user.getAgent().getTeams() %}
					<li class="me {% if loop.last %}last-me{% endif %}">
						<input type="radio" name="{{baseId}}_asignedto" value="{{ team.id }}" />
						<label class="agent-team-label-{{ team.id }}">{{ team.name }}</label>
						<div class="bound-fade"></div>
					</li>
				{% endfor %}

				{% for team in agent_teams %}
					{% if team.id not in app.user.getAgent().getTeamIds() %}
						<li>
							<input type="radio" name="{{baseId}}_asignedto" value="{{ team.id }}" />
							<label class="agent-team-label-{{ team.id }}">{{ team.name }}</label>
							<div class="bound-fade"></div>
						</li>
					{% endif %}
				{% endfor %}
			</ul>
		</section>
	</div>
	{% endif %}
	<br class="clear" />
</div>

{{ agentui.scroll_containers_end() }}
