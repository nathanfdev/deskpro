<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.NewsList';
pageMeta.refreshUrl = '{{ path('agent_news_list', {'cache_id': result_id}) }}';

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
{# scroll containers #}
<div class="layout-content with-scrollbar page-listing page-validating-comments">
<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
<div class="scroll-viewport"><div class="scroll-content">
{# /scroll containers #}

	{% include 'AgentBundle:News:filter-display-options.html.twig' %}
	{% include 'AgentBundle:News:filter-control-bar.html.twig' %}

	<section class="news-simple-list list-listing no-check">
		{% include 'AgentBundle:News:filter-page.html.twig' %}
	</section>

	{% if not results|length %}
		<section class="list-listing no-results">
			<p>{{ phrase('agent.general.there_are_no_results') }}</p>
		</section>
	{% endif %}

	{% if results|length %}
		<footer class="results-nav">
			<div class="cursor">
				{{ phrase('agent.general.showing') }} <span class="results-total-count" id="{{baseId}}_total_count">{{ results|length }}</span> {{ phrase('agent.publish.news_posts') }}
			</div>
		</footer>
	{% endif %}
{# scroll containers #}
</div></div></div></div>
{# /scroll containers #}
