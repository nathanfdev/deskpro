{% import 'AgentBundle:Common:optionbox-macros.html.twig' as optionbox %}
<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.NewsView';
pageMeta.title = {{news.title|json_encode|raw}};
pageMeta.news_id = {{news.id}};
pageMeta.url_fragment  = '{{ url_fragment('agent_news_view', {'news_id': news.id}) }}';
pageMeta.permalink = '{{news.permalink}}';
pageMeta.labelsSaveUrl = '{{ path('agent_news_ajax_labels_save', {'news_id': news.id}) }}';

{% if news.hidden_status == 'validating' %}
pageMeta.isValidating = true;
{% endif %}

pageMeta.canEdit   = {% if news.person.id != app.user.id and not app.user.hasPerm('agent_publish.edit') %}false{% else %}true{% endif %};
pageMeta.canDelete = {% if not app.user.hasPerm('agent_publish.delete') %}false{% else %}true{% endif %};

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
{# scroll containers #}
<div class="layout-content with-scrollbar page-listing page-news-view {% if news.person.id != app.user.id and not app.user.hasPerm('agent_publish.edit') %}perm-no-edit{% endif %} {% if not app.user.hasPerm('agent_publish.delete') %}perm-no-delete{% endif %}">
<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
<div class="scroll-viewport"><div class="scroll-content">
{# /scroll containers #}

<div class="delete-notice" {% if news.status_code != "hidden.deleted" %}style="display: none;"{% endif %}>
	{{ phrase('agent.record_deleted') }} <button class="clean-gray xxx-small undelete">{{ phrase('agent.undelete') }}</button>
</div>

{% if news.status_code == "hidden.validating" %}
	{% include 'AgentBundle:Publish:view-approve-header.html.twig' %}
{% endif %}

<header class="page-header">
	<h4 class="id-number">#{{ news.id }}</h4>
	<h1 class="editable hover-edit" data-editable-for=".inline-editable .title">{{ news.title }}</h1>
	<br class="clear" />
	<div class="meta-line">
		<div class="status the-status article-status"><span>{{ phrase('agent.publish.status_' ~ news.status_code|replace({'.':'_'})) }}</span></div>
		<div class="category" id="{{baseId}}_cat_trigger"><span>{{ phrase('agent.category') }}: <span id="{{baseId}}_cat_label">{{ news.category.full_title }}</span></span></div>
	</div>
	<br class="clear" />
</header>

<div class="profile-box-container-outer">
	<div class="profile-box-container">
		<header>
			<h4>{{ phrase('agent.properties') }}</h4>
		</header>
		<section class="description-area">
			<dl class="info-list">
				<dt class="type-labels">{{ phrase('agent.labels') }}:</dt>
				<dd class="kb-tags tags-wrap noedit-tags">
					<input type="text" id="{{baseId}}_labels_input" value="{% for label in news.labels %}{{label.label}},{% endfor %}" />
				</dd>

				<dt>{{ phrase('agent.rating') }}</dt>
				<dd>
                    {% set phrase_part %}
                    <span class="link-look who-voted-trigger">{{ phrase('agent.count_votecount_votes', {'count': news.num_ratings}) }}</span>
                    {% endset %}
                    {{ phrase('agent.percent_helpful_subphrase', {'percent':news.rating_percent,'subphrase':phrase_part}) }}<br />
                    <small>{{ phrase('agent.found_article_helpful_or_not', {'up_votes':news.up_votes,'down_votes':news.down_votes}) }}</small>
				</dd>

				<dt></dt>
				<dd>
					{{ phrase('agent.created_timeago_by_x_on_y', {
						'timeago': '<time class="timeago" datetime="' ~ news.date_created|date('c') ~'"></time>',
						'name': news.person.display_name,
						'date': '<time>' ~ news.date_created|date('fulltime') ~ '</time>'
					}) }}
				</dd>
			</dl>

			<div class="controls" id="{{baseId}}_action_buttons">
				<button class="clean-white delete nodelete-hide" {% if news.status_code == "hidden.deleted" %}style="display:none"{% endif %}>{{ phrase('agent.ucfirst_delete') }}</button>
				<button class="clean-white permalink">{{ phrase('agent.copy_permalink') }}</button>
				<button class="clean-white view-user-interface">{{ phrase('agent.view_in_user_interface') }}</button>
				<br class="clear" />
			</div>
		</section>
	</div>
</div>

<div class="profile-box-container reply-box-wrap">
	<header>
		<nav  id="{{baseId}}_bodytabs">
			<ul>
				<li class="on" data-tab-for="#{{baseId}}_tab_contents .news-content"><span>{{ phrase('agent.page') }}</span></li>
				<li data-tab-for="#{{baseId}}_tab_contents .comments-tab"><span>{{ phrase('agent.comments') }} (<span id="{{baseId}}_count_comments">{{news_comments|length|default(0)}}</span>)</span></li>
				<li data-tab-for="#{{baseId}}_tab_contents .revisions-tab"><span>{{ phrase('agent.label_revisions') }} (<span id="{{baseId}}_count_revs">{{news.revisions|length|default(0)}}</span>)</span></li>
				<li data-tab-for="#{{baseId}}_tab_contents .related-content-tab"><span>{{ phrase('agent.related_content') }} (<span id="{{baseId}}_count_related">0</span>)</span></li>
				<li data-tab-for="#{{baseId}}_tab_contents .search-tab"><span>{{ phrase('agent.search') }}</span></li>
			</ul>
		</nav>
	</header>
	<section>

		{# Tab Contents #}
		<div id="{{baseId}}_tab_contents">
			{# Tab: Content #}
			<div class="deskpro-tab-item news-content on">
				{# Content #}
				<nav class="sub-box-nav noedit-hide">
					<ul class="option-buttons right" id="{{baseId}}_content_edit_btns">
						<li class="kb-editor-edit edit" id="{{baseId}}_edit_btn"><span>{{ phrase('agent.ucfirst_edit') }}</span></li>
						<li class="editor-save-trigger save" id="{{baseId}}_save_btn"><span>{{ phrase('agent.save') }}</span></li>
						<li class="editor-cancel-trigger cancel" id="{{baseId}}_cancel_btn"><span>{{ phrase('agent.cancel') }}</span></li>
					</ul>
				</nav>
				<div id="{{baseId}}_content_ed" class="news-content content-tab-item">
				{% include 'AgentBundle:News:view-content-tab.html.twig' %}
				</div>
				{# /Content #}
			</div>

			{# Tab: Comments #}
			<div class="deskpro-tab-item content-tab-item comments-tab">
				<div class="news-comments">
					<div class="full-tab-content">
						<div class="messages-wrap" id="{{baseId}}_comments_wrap">
							{% for comment in news_comments %}
								{% include 'AgentBundle:News:view-comment.html.twig' %}
							{% endfor %}
						</div>
					</div>

					<div class="messages-wrap new-note">
						<article
							class="content-message agent-message"
							data-comment-id="{{comment.id}}"
							data-content-type="{{ comment.object_content_type }}"
						>
							<div class="avatar">
								<img src="{{ app.user.getPictureUrl(40) }}" alt="" width="40" height="40" />
							</div>
							<div class="content">
								<header>
									<h4>{{ phrase('agent.new_comment') }}</h4>
								</header>
								<div class="body-text">
									<textarea style="width:99%; height: 80px;"></textarea>
								</div>
								<div class="footer-text">
									<div class="loading-off">
										<button class="clean-white">{{ phrase('agent.add_comment') }}</button>
									</div>
									<div class="loading-on" style="display:none">
										{{ phrase('agent.saving') }}
									</div>
								</div>
							</div>
						</article>
					</div>
				</div>
			</div>
			{# /Tab: Comments #}

			{# Tab: Revisions #}
			<div id="{{baseId}}_revs" class="deskpro-tab-item content-tab-item revisions-tab">
				{% include 'AgentBundle:News:view-revisions-tab.html.twig' %}
			</div>
			{# /Tab: Revisions #}

			{# Tab: Related #}
			<div id="{{baseId}}_related_content" class="deskpro-tab-item content-tab-item related-content-tab">
				{% include 'AgentBundle:Common:content-related-list.html.twig' %}
			</div>
			{# /Tab: Related #}

			{# Tab: Search #}
			<div id="{{baseId}}_searchtab" class="deskpro-tab-item search-tab">
				<section class="description-area sticky-search-words">
					<dl class="info-list">
						<dt class="type-labels">{{ phrase('agent.publish.sticky_words_title') }}</dt>
						<dd class="noedit-tags">
							<input type="text" value="{% for label in sticky_search_words %}{{label}},{% endfor %}" id="{{baseId}}_stickysearch_input" />
							<div class="explain">
								{{ phrase('agent.publish.search_sticky_words_explain') }}
							</div>
						</dd>
					</dl>
				</section>

				<br />

				{% include 'AgentBundle:Publish:rated-searches.html.twig' %}
			</div>
			{# /Tab: Search #}
		</div>
		{# /Main Tabs #}
</section>
</div>

<div class="inline-editable" style="display:none">
	<div class="title">
		<input type="text" name="title" value="{{ news.title }}"/>
		<input type="hidden" name="action" value="title" />
	</div>
</div>

<ul class="status-menu" data-option-name="status" style="display:none">
	<li data-option-value="published">{{ phrase('agent.publish.status_published') }}</li>
	<li data-option-value="hidden.unpublished">{{ phrase('agent.publish.status_hidden_unpublished') }}</li>
	<li data-option-value="archived">{{ phrase('agent.publish.status_archived') }}</li>
	{% if news.person.id == app.user.id %}
		<li data-option-value="hidden.draft">{{ phrase('agent.publish.status_hidden_draft') }}</li>
	{% endif %}
</ul>

{{ optionbox.category_ob(news_categories, phrase('agent.publish.news_categories'), phrase('agent.apply'), {'id': baseId ~ '_cat_ob'}) }}

{# scroll containers #}
</div></div></div></div>
{# /scroll containers #}
