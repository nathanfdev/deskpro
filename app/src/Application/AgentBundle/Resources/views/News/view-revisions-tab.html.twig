<div class="check-grid item-list revision-compare-table">
	<table width="100%">
		<thead>
			<tr>
				<th>&nbsp;</th>
				<th style="text-align: left">Revision</th>
				<th width="10">Compare&nbsp;</th>
			</tr>
		</thead>
		<tbody>
			{% for rev in news.revisions %}
				<tr class="rev-{{rev.id}}">
					<td width="30">{{ loop.index }}</td>
					<td>
						{{ phrase('agent.by_x', {'name': rev.person.display_name}) }},
						{{ rev.date_created|date('Y-m-d') }}
					</td>
					<td width="10" align="center">
						<input type="checkbox" class="rev-compare-check" value="{{rev.id}}" />
					</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
</div>

<div style="text-align: right;padding-top: 8px;">
	<button class="clean-white compare-trigger">{{ phrase('agent.publish.compare_selected') }}</button>
</div>
