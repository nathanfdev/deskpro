{% extends 'AgentBundle:Login:layout.html.twig' %}
{% block head %}
	<script type="text/javascript">
		$(document).ready(function() {
			$('#lost_link').on('click', function(ev) {
				ev.preventDefault();

				$('#normal_view').show();
				$('#lost_message_view').hide();
				$('#loading_view').hide();

				$('#login_title').hide();
				$('#login_fields').hide();
				$('#lost_password_title').show();
				$('#lost_fields').show();
			});

			$('#login_link').on('click', function(ev) {
				ev.preventDefault();

				$('#normal_view').show();
				$('#lost_message_view').hide();
				$('#loading_view').hide();

				$('#lost_password_title').hide();
				$('#lost_fields').hide();
				$('#login_title').show();
				$('#login_fields').show();
			});

			$('#do_send_lost').on('click', function(ev) {
				ev.preventDefault();
				$('#normal_view').hide();
				$('#lost_message_view').hide();
				$('#loading_view').show();

				var postData = {
					email: $('#email').val().trim()
				};

				if (!postData.email.length || postData.email.indexOf('@') === -1) {
					$('#normal_view').show();
					$('#lost_message_view').hide();
					$('#loading_view').hide();
					$('#lost_password_title').hide();
					$('#lost_fields').hide();
					$('#login_title').show();
					$('#login_fields').show();
					return;
				}

				$.ajax({
					url: '{{ path(route_prefix~'_send_lost') }}',
					data: postData,
					complete: function() {
						$('#loading_view').hide();
						$('#lost_message_view').show();
					}
				});
			});

			{% if app.getRequest().query.has('lost') %}
				$('#lost_link').trigger('click');
			{% endif %}
		});
	</script>
{% endblock %}
{% block content %}
<div class="title">
	Login
</div>
<div class="content">
	<form action="{{ path(route_prefix~'_login_authenticate_local') }}" method="post">
		<div id="normal_view">
			<input type="hidden" name="agent_login" value="1" />
			{% if return %}<input type="hidden" name="return" value="{{return}}" />{% endif %}

			<h1 id="login_title">{{ phrase('agent.general.log_in') }}</h1>
			<h1 id="lost_password_title" style="display: none;">{{ phrase('agent.general.lost_password') }}</h1>
			{% if timeout %}<p class="error" style="display: block">Your session has timed out, you must log in again.</p>{% endif %}
			{% if failed_login_name %}<p class="error">{{ phrase('agent.login.login_failed') }}</p>{% endif %}
			{% if has_done_reset %}<p class="okay">{{ phrase('agent.login.password_was_reset') }}</p>{% endif %}
			{% if has_logged_out %}<p class="okay">{{ phrase('agent.login.has_logged_out') }}</p>{% endif %}

			<fieldset>
				<p>
					<i class="icon-envelope-alt"></i>
					<input type="text" class="text" value="{{ failed_login_name }}" name="email" id="email" size="40" placeholder="Email" tabindex="1" />
				</p>
				<p>
					<i class="icon-lock"></i>
					<input type="password" class="text" value="" name="password" id="password" size="40"  tabindex="2" placeholder="Password" />
				</p>
			</fieldset>
			<p>
				<label class="checkbox">
					<input type="checkbox" name="remember_me" value="1" tabindex="3" /> Remember me
				</label>
			</p>
			<p><input class="full-width" type="submit" value="Log In" /></p>
			<p class="text-right"><a href="#">Forgot your password?</a></p>
		</div>
	</form>
</div>

<script type="text/javascript">
	document.getElementById('email').focus();
</script>
{% endblock %}