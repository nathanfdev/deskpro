{% if app.request.get('agent.wrong_scheme') %}
{# when we have wrong scheme, ping https and redirect if its available #}
<script>
	var pingResponseHandler = function(data) {
		if ('object' === typeof data && 'pong' === data.response) {
			window.location.href = '{{ url_full('agent_login', {'return': path('admin') }) }}';
		}
	};
	$(function(){
		var scriptSrc = '{{ url_full('user', {_sys: 'ping', type: 'jsonp', callback: 'pingResponseHandler'}) }}';
		$('head').append('<script type="text/javascript" src="' + scriptSrc + '"/>');
	});
</script>
{% endif %}

