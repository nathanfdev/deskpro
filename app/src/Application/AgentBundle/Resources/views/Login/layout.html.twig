<!DOCTYPE HTML>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="robots" content="NOINDEX" />
<meta http-equiv="X-UA-Compatible" content="IE=Edge,chrome=1" />
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
<title>{{ phrase('agent.general.log_in') }}</title>
<script type="text/javascript">
	if (typeof pageMeta !== 'undefined') pageMeta.goToLogin = true;
</script>
<script type="text/javascript" charset="utf-8" src="{{ asset('vendor/jquery/jquery.min.js') }}"></script>

<style type="text/css">
body {
	background: #DEE4EA !important;
}

{% include 'DeskPRO:Common:admin-login.css.twig' %}

#loading_view i {
	display: block;
	margin: 10px;
	padding: 10px;
	padding-top: 38px;
	background: url({{ asset('images/spinners/loading-big-circle.gif') }}) no-repeat 50% 0;
	font-style: normal;
	text-align: center;
	font-family: "Helvetica Neue",Helvetica,Arial,sans-serif;
}

#lost_message_view {
	font-family: "Helvetica Neue",Helvetica,Arial,sans-serif;
}

{% if is_popup %}
#dp_login .msg-outer {
	position: static;
	margin: 15px;
	width: auto;
}
{% endif %}

{% if app.usersourceManager.getWithCapability('form_login') %}
#dp_login dt { width: 120px; }
{% endif %}
</style>
{% block head %}{% endblock %}
</head>
<body>

<div id="dp_login">
	<div class="msg-outer">
		<div class="msg">
			{% block content %}{% endblock %}
			<br class="clear" />
		</div>
	</div>
	{% if not is_popup %}
		<a href="http://www.deskpro.com/" id="dp_logo">{{ phrase('agent.general.deskpro') }}</a>
	{% endif %}
</div>
</body>
</html>
