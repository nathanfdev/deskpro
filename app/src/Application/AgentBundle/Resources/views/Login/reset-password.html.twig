{% extends 'AgentBundle:Login:layout.html.twig' %}
{% block head %}
<script type="text/javascript">
	$(document).ready(function() {
		$('#form').on('submit', function(ev) {
			if ($('#new_password').val().length < 4) {
				alert('{{ phrase('agent.login.alert_too_short') }}');
				ev.preventDefault();
				return;
			}
			if ($('#new_password').val() != $('#new_password2').val()) {
				alert('{{ phrase('agent.login.alert_fields_must_match') }}');
				ev.preventDefault();
			}
		});
	});
</script>
{% endblock %}
{% block content %}
<form action="{{ path('agent_login', {reset_code: reset_code}) }}" id="form" method="post">

<h1 id="login_title">{{ phrase('agent.login.enter_new_password') }}</h1>

<dl>
	<dt>{{ phrase('agent.general.new_password') }}</dt>
	<dd><input type="password" autocomplete="off" class="text" value="" name="new_password" id="new_password" size="40" tabindex="1" /></dd>
</dl>

<div id="login_fields">
	<dl>
		<dt>{{ phrase('agent.general.repeat') }}</dt>
		<dd><input type="password" autocomplete="off" class="text" value="" name="new_password2" id="new_password2" size="40" tabindex="1" /></dd>
	</dl>

	<dl>
		<dt></dt>
		<dd class="btn"><button id="submit_btn">{{ phrase('agent.general.reset_password') }}</button></dd>
	</dl>
</div>
</form>
{% endblock %}