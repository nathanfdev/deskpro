<section class="search-reuslts page-set" data-page="{{page}}">
	{% for comment in comments %}
		<article class="comment comment-{{comment.id}}">
			<div class="userinfo">
				<address style="right: 20px;">
					{{ comment.user_email }}
				</address>
				{% if comment.person %}
					<a class="with-route name" data-route="person:{{ path('agent_people_view', {'person_id': comment.person.id|default('0')}) }}">
						{{ comment.person.display_name }}
					</a>
				{% else %}
					{{ comment.user_name }}
				{% endif %}
			</div>
			<div class="preview">
				{{ comment.content }}
			</div>
			<div style="padding-left: 5px;">
				<a class="with-route" data-route="page:{{ path('agent_feedback_view', {'feedback_id': comment.feedback.id}) }}">
					{{ comment.feedback.title }}
				</a>
			</div>
			<div style="float:right; padding-right: 4px;">
				<button class="dp-button x-small delete-trigger" data-comment-id="{{comment.id}}">{{ phrase('agent.ucfirst_delete') }}</button>
				<button class="dp-button x-small approve-trigger" data-comment-id="{{comment.id}}">{{ phrase('agent.approve') }}</button>
			</div>
			<time class="timeago" datetime="{{ comment.date_created|date('c') }}">{{ comment.date_created|date('day_short') }}</time>
		</article>
	{% endfor %}
</section>
