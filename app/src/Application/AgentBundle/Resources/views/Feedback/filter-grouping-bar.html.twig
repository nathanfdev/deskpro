{% if grouped_info and grouped_info[-1].total %}
	<header class="list-grouping-bar">
		<ul>
			<li class="{% if subgroup == sub.id %}on{% endif %}">
				<a data-route="listpane:{{ subgroup_url|replace({'SUBGROUP_ID': ''}) }}">
					{{ phrase('agent.all') }}
					<span class="count">{{ grouped_info[-1].total }}</span>
				</a>
			</li>
			{% for cat in grouped_info %}
				{% if cat.id != '-1' %}
					{% for sub in cat.sub %}
						<li class="{% if subgroup == sub.id %}on{% endif %}">
							<a data-route="listpane:{{ subgroup_url|replace({'SUBGROUP_ID': sub.id}) }}">
								{{ sub.title }}
								<span class="count">{{ sub.total }}</span>
							</a>
						</li>
					{% endfor %}
				{% endif %}
			{% endfor %}
		</ul>
		<br class="clear" />
	</header>
{% endif %}
