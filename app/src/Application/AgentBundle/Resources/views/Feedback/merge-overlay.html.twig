<div class="ticket-merge feedback-merge overlay">
	<div class="overlay-title">
		<h4>{{ phrase('agent.merge_x_into', {{'name': feedback.title|e}}) }}</h4>
		<div class="info">
			{{ phrase('agent.feedback.merge_explain') }}
		</div>
	</div>

	<div class="overlay-content">
		{% if not open_feedback %}
			<div class="group">
				<ul>
					<li>
						{{ phrase('agent.feedback.merge_none_open') }}
					</li>
				</ul>
			</div>
		{% endif %}

		{% if open_feedback %}
		<div class="group open-tickets">
			<ul>
				{% for feedback in open_feedback %}
					<li>
						<a data-route="page:{{ path('agent_feedback_view', {'feedback_id': feedback.id}) }}" class="with-route">{{ feedback.title }}</a>
						<button class="clean-gray xx-small merge-trigger" data-feedback-id="{{ feedback.id }}">{{ phrase('agent.merge') }}</button>
					</li>
				{% endfor %}
			</ul>
		</div>
		{% endif %}
	</div>
</div>
