<li class="ticket" data-type="tickets" data-route="page:{{ path('agent_feedback_view', {'feedback_id': feedback.id}) }}" data-route-notabreload="1">
	<em class="dismiss"></em>
	<time class="timeago"></time>
	<a>{{ feedback.title }}</a>
	<div class="info">
		New feedback by {{ feedback.person.getDisplayContact() }}
		{% if feedback.getStatusCode() == 'hidden.user_validating' %}requires validation{% endif %}
	</div>
</li>
