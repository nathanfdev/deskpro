<section class="search-reuslts page-set" data-page="{{page}}">
	{% for feedback in feedback %}
		<article
			class="feedback feedback-{{feedback.id}}"
			data-route="page:{{ path('agent_feedback_view', {'feedback_id': feedback.id, 'from_listing_result_id': cache_id}) }}"
			data-route-title="@selector(a.feedback-title)"
			data-route-openclass="open"
		>
			<div class="userinfo">
				<address style="right: 20px;">
					{{ feedback.person.primary_email_address }}
				</address>
				<a class="with-route name" data-route="person:{{ path('agent_people_view', {'person_id': feedback.person.id|default('0')}) }}">
					{{ feedback.person.display_name }}
				</a>
			</div>
			<div class="preview">
				<a class="feedback-title">{{ feedback.summary_line }}</a>
			</div>
			<time class="timeago" datetime="{{ feedback.date_created|date('c', 'UTC') }}">{{ feedback.date_created|date('day_short') }}</time>
		</article>
	{% endfor %}
</section>
