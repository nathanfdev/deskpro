{% import 'AgentBundle:Common:optionbox-macros.html.twig' as optionbox %}
<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.FeedbackView';
pageMeta.title = {{feedback.title|json_encode|raw}};
pageMeta.feedback_id = {{feedback.id}};
pageMeta.url_fragment  = '{{ url_fragment('agent_feedback_view', {'feedback_id': feedback.id}) }}';

pageMeta.permalink = '{{ feedback.permalink }}';
pageMeta.labelsSaveUrl = '{{ path('agent_feedback_ajax_labels_save', {'feedback_id': feedback.id}) }}';

pageMeta.canEdit   = {% if feedback.person.id != app.user.id and not app.user.hasPerm('agent_publish.edit') %}false{% else %}true{% endif %};
pageMeta.canDelete = {% if not app.user.hasPerm('agent_publish.delete') %}false{% else %}true{% endif %};

{% if feedback.hidden_status == 'validating' %}
pageMeta.isValidating = true;
{% endif %}

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
<div class="layout-content full-page page-feedback-view with-scrollbar {% if feedback.person.id != app.user.id and not app.user.hasPerm('agent_publish.edit') %}perm-no-edit{% endif %} {% if not app.user.hasPerm('agent_publish.delete') %}perm-no-delete{% endif %}">
<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
<div class="scroll-viewport"><div class="scroll-content"related-content>

<div class="delete-notice" {% if feedback.status_code != "hidden.deleted" %}style="display: none;"{% endif %}>
	{{ phrase('agent.record_deleted') }} <button class="clean-gray xxx-small undelete">{{ phrase('agent.undelete') }}</button>
</div>

<div class="spam-notice" {% if feedback.status_code != "hidden.spam" %}style="display: none;"{% endif %}>
	{{ phrase('agent.record_marked_spam') }} <button class="clean-gray xxx-small unspam">{{ phrase('agent.unspam') }}</button>
</div>

{% if feedback.status_code == "hidden.validating" %}
	{% include 'AgentBundle:Publish:view-approve-header.html.twig' %}
{% endif %}

<header class="page-header">
	<h4 class="id-number">#{{ feedback.id }}</h4>
	<h1 class="editable hover-edit" data-editable-for=".inline-editable .title">{{ feedback.title }}</h1>
	<br class="clear" />
	<div class="meta-line">
		<div class="status the-status feedback-status" id="{{baseId}}_status_trigger"><span id="{{baseId}}_status_label">
			{% if feedback.status == 'new' %}
				{{ phrase('agent.feedback.status_active') }}
			{% elseif feedback.status == 'active' %}
				{{ phrase('agent.feedback.status_active') }}: {{ feedback.status_category.title }}
			{% elseif feedback.status == 'closed' %}
				{{ phrase('agent.closed') }}: {{ feedback.status_category.title }}
			{% else %}
				{{ phrase('agent.hidden') }}
			{% endif %}
		</span></div>
		<div class="category" id="{{baseId}}_cat_trigger"><span>{{ phrase('agent.category') }}: <span id="{{baseId}}_cat_label">{{ feedback.category.full_title }}</span></span></div>
	</div>
	<br class="clear" />
</header>

<div class="profile-box-container">
	<header>
		<h4>{{ phrase('agent.properties') }}</h4>
	</header>
	<section class="description-area">
		<dl class="info-list">
			<dt class="type-labels">{{ phrase('agent.labels') }}:</dt>
			<dd class="feedback-tags tags-wrap noedit-tags">
				<input type="text" id="{{baseId}}_labels_input" value="{% for label in feedback.labels %}{{label.label}},{% endfor %}" />
			</dd>

			<dt>{{ phrase('agent.votes') }}:</dt>
			<dd>
				<span class="link-look who-voted-trigger">
                    {% set phrase_part %}}
                    <span id="{{baseId}}_num_votes">{{ feedback.num_ratings }}</span>
                    {% endset %}
                    {{ phrase('agent.feedback.count_votes', {'display_count':phrase_part,'count':feedback.num_ratings}) }}
                </span>
				<button class="clean-gray xxx-small tipped {% if my_vote %}radio-on{% endif %}" title="{{ phrase('agent.feedback.vote_for_this_feedback') }}" id="{{baseId}}_my_vote">+1</button>
			</dd>

			<dt>{{ phrase('agent.author') }}:</dt>
			<dd>
                {% set phrase_part %}
                    {% for author in feedback.authors %}
                        <cite class="person-popover preload" data-person-id="{{ author.id }}">{{ author.display_name }}</cite>
                        {% if not loop.last %}, {% endif %}
                    {% endfor %}
                {% endset %}
                {{ phrase('agent.feedback.by_people_on_date', {'people':phrase_part,'date':feedback.date_created|date('day')}) }}
			</dd>
		</dl>

		{% if custom_fields|length %}
			<dl class="info-list" id="{{baseId}}_custom_fields_rendered">
				{% include 'AgentBundle:Feedback:view-customfields-rendered-rows.html.twig' %}
			</dl>
			<dl class="info-list" id="{{baseId}}_custom_fields_editable" style="display: none">
				{% include 'AgentBundle:Feedback:view-customfields-edit-rows.html.twig' %}
			</dl>
		{% endif %}

		<div class="controls" id="{{baseId}}_properties_controls">
			<div class="showing-editing-fields" style="display: none">
				<button class="clean-white save-fields-trigger"><span>{{ phrase('agent.save') }}</span></button>
			</div>
			<div class="showing-rendered-fields" id="{{baseId}}_action_buttons">
				{% if custom_fields|length %}
					<button class="clean-white edit-fields-trigger noedit-hide"><span>{{ phrase('agent.edit_properties') }}</span></button>
				{% endif %}
				<button class="clean-white delete delete-type nodelete-hide" {% if feedback.status_code == "hidden.deleted" %}style="display:none"{% endif %}>{{ phrase('agent.ucfirst_delete') }}</button>
				<button class="clean-white spam delete-type noedit-hide" {% if feedback.status_code == "hidden.spam" %}style="display:none"{% endif %}>{{ phrase('agent.mark_spam') }}</button>
				<button class="clean-white merge noedit-hide">{{ phrase('agent.merge') }}</button>
				<button class="clean-white permalink">{{ phrase('agent.copy_permalink') }}</button>
				<button class="clean-white view-user-interface">{{ phrase('agent.view_in_user_interface') }}</button>
			</div>
		</div>
	</section>
</div>

<div class="profile-box-container reply-box-wrap">
	<header>
		<nav id="{{baseId}}_bodytabs">
			<ul>
				<li class="tab-trigger" data-tab-for="#{{baseId}}_content_tab">{{ phrase('agent.description') }}</li>
				<li class="tab-trigger" data-tab-for="#{{baseId}}_comments_tab">{{ phrase('agent.comments') }} (<span id="{{baseId}}_count_comments">{{feedback_comments|length|default(0)}}</span>)</li>
				<li class="tab-trigger" data-tab-for="#{{baseId}}_revs">{{ phrase('agent.label_revisions') }} (<span id="{{baseId}}_count_revs">{{feedback.revisions|length|default(0)}}</span>)</li>
				<li class="tab-trigger" data-tab-for="#{{baseId}}_related_content">{{ phrase('agent.related_content') }} (<span id="{{baseId}}_count_related">0</span>)</li>
				<li class="tab-trigger" data-tab-for="#{{baseId}}_searchtab">{{ phrase('agent.search') }}</li>
			</ul>
		</nav>
	</header>
	<section>

		{# Tab Contents #}
		<div id="{{baseId}}_tab_contents">
			{# Tab: Content #}
			<div id="{{baseId}}_content_tab" class="deskpro-tab-item content-tab on" style="display: block">
				<nav class="sub-box-nav noedit-hide">
					<ul class="option-buttons right" id="{{baseId}}_content_edit_btns">
						<li class="kb-editor-edit edit" id="{{baseId}}_edit_btn"><span>{{ phrase('agent.ucfirst_edit') }}</span></li>
						<li class="editor-save-trigger save" id="{{baseId}}_save_btn"><span>{{ phrase('agent.save') }}</span></li>
						<li class="editor-cancel-trigger cancel" id="{{baseId}}_cancel_btn"><span>{{ phrase('agent.cancel') }}</span></li>
					</ul>
				</nav>
				<div id="{{baseId}}_content_ed" class="content-tab-item">
				{% include 'AgentBundle:Feedback:view-content-tab.html.twig' %}
				</div>
			</div>
			{# /Tab: Content #}

			{# Tab: Comments #}
			<div id="{{baseId}}_comments_tab" class="deskpro-tab-item content-tab-item comments-tab">
				<div class="feedback-comments">
					<div class="full-tab-content">
						<div class="messages-wrap" id="{{baseId}}_comments_wrap">
							{% for comment in feedback_comments %}
								{% include 'AgentBundle:Feedback:view-comment.html.twig' %}
							{% endfor %}
						</div>
					</div>

					<div class="messages-wrap new-note">
						<article
							class="content-message agent-message"
							data-comment-id="{{comment.id}}"
							data-content-type="{{ comment.object_content_type }}"
						>
							<div class="avatar">
								<img src="{{ app.user.getPictureUrl(40) }}" alt="" width="40" height="40" />
							</div>
							<div class="content">
								<header>
									<h4>{{ phrase('agent.new_comment') }}</h4>
								</header>
								<div class="body-text">
									<textarea style="width:99%; height: 80px;"></textarea>
								</div>
								<div class="footer-text">
									<div class="loading-off">
										<button class="clean-white">{{ phrase('agent.add_comment') }}</button>
									</div>
									<div class="loading-on" style="display:none">
										{{ phrase('agent.saving') }}
									</div>
								</div>
							</div>
						</article>
					</div>
				</div>
			</div>
			{# /Tab: Comments #}

			{# Tab: Revisions #}
			<div id="{{baseId}}_revs" class="deskpro-tab-item content-tab-item revisions-tab">
				{% include 'AgentBundle:Feedback:view-revisions-tab.html.twig' %}
			</div>
			{# /Tab: Revisions #}

			{# Tab: Related #}
			<div id="{{baseId}}_related_content" class="deskpro-tab-item content-tab-item related-content-tab">
				{% include 'AgentBundle:Common:content-related-list.html.twig' %}
			</div>
			{# /Tab: Related #}

			{# Tab: Search #}
			<div id="{{baseId}}_searchtab" class="deskpro-tab-item search-tab">
				<section class="description-area sticky-search-words">
					<dl class="info-list">
						<dt class="type-labels">{{ phrase('agent.publish.sticky_words_title') }}</dt>
						<dd class="noedit-tags">
							<input type="text" value="{% for label in sticky_search_words %}{{label}},{% endfor %}" id="{{baseId}}_stickysearch_input" />
							<div class="explain">
								{{ phrase('agent.publish.search_sticky_words_explain') }}
							</div>
						</dd>
					</dl>
				</section>

				<br />

				{% include 'AgentBundle:Publish:rated-searches.html.twig' %}
			</div>
			{# /Tab: Search #}
		</div>
		{# /Tab Contents #}
	</section>
</div>

<div class="inline-editable" style="display:none">
	<div class="title">
		<input type="text" name="title" value="{{ feedback.title }}"/>
		<input type="hidden" name="action" value="title" />
	</div>
</div>

<ul class="menu status status-menu {{add_classname}}" data-option-name="status" style="display:none">
	<li
		class="status-new"
		data-status-type="new"
		data-option-value="new"
	>{{ phrase('agent.feedback.status_new') }}</li>
	<li
		class="section-title status-active"
		data-status-type="active"
		data-option-value="active"
	>{{ phrase('agent.feedback.status_active') }}</li>
	{% for cat in active_status_cats %}
		<li
			class="status-{{cat.id}}"
			data-status-type="active"
			data-option-value="active.{{cat.id}}"
		>{{cat.title}}</li>
	{% endfor %}
	<li
		class="section-title status-closed"
		data-status-type="closed"
		data-option-value="closed"
	>{{ phrase('agent.closed') }}</li>
	{% for cat in closed_status_cats %}
		<li
			class="status-{{cat.id}}"
			data-status-type="closed"
			data-option-value="closed.{{cat.id}}"
		>{{cat.title}}</li>
	{% endfor %}
</ul>

{{ optionbox.start('Status', {'id': baseId ~ '_status_ob'}) }}
	{{ optionbox.section_start('', 'status') }}
		<li class="top parent-option item-new" data-item-id="new" data-full-title="{{ phrase('agent.feedback.status_new') }}">
			<input type="radio" name="status" value="new" />
			<label>{{ phrase('agent.feedback.status_new') }}</label>
		</li>
		<li class="top parent-option item-active" data-item-id="active" data-full-title="{{ phrase('agent.feedback.status_active') }}">
			<input type="radio" name="status" value="active" />
			<label>{{ phrase('agent.feedback.status_active') }}</label>
		</li>
		{% for cat in active_status_cats %}
			<li class="child item-active-{{cat.id}}" data-item-id="active.{{cat.id}}" data-full-title="{{ phrase('agent.feedback.status_active') }}: {{ cat.title }}">
				<span class="elbow-end"></span>
				<input type="radio" name="category_id" value="active.{{cat.id}}" />
				<label>{{ cat.title }}</label>
			</li>
		{% endfor %}
		<li class="top parent-option item-closed" data-item-id="closed" data-full-title="{{ phrase('agent.feedback.closed') }}">
			<input type="radio" name="status" value="closed" />
			<label>{{ phrase('agent.closed') }}</label>
		</li>
		{% for cat in closed_status_cats %}
			<li class="child item-closed-{{cat.id}}" data-item-id="closed.{{cat.id}}" data-full-title="{{ phrase('agent.feedback.closed_category', {'cat':cat.title }) }}">
				<span class="elbow-end"></span>
				<input type="radio" name="category_id" value="closed.{{cat.id}}" />
				<label>{{ cat.title }}</label>
			</li>
		{% endfor %}
	{{ optionbox.section_end() }}
{{ optionbox.end(phrase('agent.set_status')) }}

{{ optionbox.category_ob(feedback_categories, 'Feedback Category', phrase('agent.apply'), {'id': baseId ~ '_cat_ob'}) }}

{# scroll containers #}
</div></div></div></div>
{# /scroll containers #}
