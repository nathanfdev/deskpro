<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.FeedbackCommentsValidating';
pageMeta.pageUrl = '{{ path('agent_feedback_validating_comments') }}?partial=1&page=$page';
pageMeta.refreshUrl = '{{ path('agent_feedback_validating_comments') }}';
pageMeta.isValidating = true;
{% if not feedback %}
	pageMeta.noResults = true;
{% endif %}
</script>
<header class="section-header">
	<h1>
		{{ phrase('agent.publish.comments_awaiting_validation') }}
	</h1>
</header>
<div class="layout-content">
<div class="content">
	<section class="feedback-simple-list deskpro-results-list">
		{% include 'AgentBundle:Feedback:validating-comments-list-part.html.twig' %}
	</section>

	{% if not comments|length %}
		<section class="list-listing no-results">
			<p>{{ phrase('global.there_are_no_results') }}</p>
		</section>
	{% endif %}

	<div class="loading-more">
		{{ phrase('global.loading') }}
	</div>
	<div class="no-more-results">
		{{ phrase('global.there_are_no_more_results') }}
	</div>
</div>
</div>
