<section class="search-reuslts page-set" data-page="{{ page }}">
	{% for pending_article in pending_articles %}
		<article class="row-item pending-article pending-article-{{pending_article.id}}">
			<input
				class="item-select"
				type="checkbox"
				value="{{ pending_article.id }}"
				{% if pending_article.ticket %}
					data-ticket-route="page:{{ object_path_agent(pending_article.ticket) }}"
				{% endif %}
			/>
			{% if pending_article.ticket %}
				<div class="top-row">
					<div class="top-row-left">
						<h3>
							{{ phrase('global.ticket') }} <a class="with-route" data-route="page:{{ object_path_agent(pending_article.ticket) }}">{{ pending_article.ticket.subject }}</a>
						</h3>
					</div>
					<div class="top-row-right buttons">
						<div class="bound-faded"></div>
						<button class="clean-white small pending-create">{{ phrase('global.create') }}</button>
						<button class="clean-white small pending-delete">{{ phrase('global.ucfirst_delete') }}</button>
					</div>
				</div>
			{% else %}
				<div class="top-row">
					<div class="top-row-left">
						<h3>
							{{ pending_article.comment }}
						</h3>
					</div>
					<div class="top-row-right buttons">
						<div class="bound-faded"></div>
						<button class="clean-white small pending-create">{{ phrase('global.create') }}</button>
						<button class="clean-white small pending-delete">{{ phrase('global.ucfirst_delete') }}</button>
					</div>
				</div>
			{% endif %}
			<br class="clear" />
		</article>
	{% endfor %}
</section>
