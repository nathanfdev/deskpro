{% extends 'AgentBundle:Common:display-options-layout.html.twig' %}
{% block other_options %}
	<div style="display: none">
		<select name="order_by" class="sel-order-by">
			<option class="date" value="article.date_created:desc">Date Created (Newest-Oldest)</option>
			<option value="article.date_created:asc">Date Created (Oldest-Newest)</option>
			<option class="views" value="article.view_count:desc">View Count (Highest-Lowest)</option>
			<option value="article.view_count:asc">View Count (Lowest-Highest)</option>
		</select>
	</div>
{% endblock %}
{% block display_elements_list %}
	<li data-field="author"><input type="checkbox" name="author" /> {{ phrase('agent.author') }}</li>
	<li data-field="category"><input type="checkbox" name="category" /> {{ phrase('agent.category') }}</li>
	<li data-field="date_created"><input type="checkbox" name="date_created" /> {{ phrase('agent.date_created') }}</li>
	<li data-field="view_count"><input type="checkbox" name="view_count" /> {{ phrase('agent.num_views') }}</li>
{% endblock %}
