<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.KbList';
pageMeta.resultId = {{ result_id }};
pageMeta.refreshUrl = '{{ path('agent_kb_list', {'cache_id': result_id}) }}';
pageMeta.url_fragment = '{{ url_fragment('agent_kb_list', {'category_id': category.id}) }}';
{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
{# scroll containers #}
<div class="layout-content with-scrollbar page-listing page-kb-filter">
<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
<div class="scroll-viewport"><div class="scroll-content">
{# /scroll containers #}

	{% include 'AgentBundle:Kb:filter-display-options.html.twig' %}
	{% include 'AgentBundle:Kb:filter-control-bar.html.twig' %}
	{% include 'AgentBundle:Kb:filter-massactions-bar.html.twig' %}

	<section class="kb-simple-list list-listing">
		{% include 'AgentBundle:Kb:filter-page.html.twig' %}
	</section>

	{% if not results|length %}
		<section class="list-listing no-results">
			<p>{{ phrase('agent.general.there_are_no_results') }}</p>
		</section>
	{% endif %}

	{% if results|length %}
		<footer class="results-nav">
			<div class="cursor">
                {% set phrase_part %}
                <span class="results-total-count" id="{{baseId}}_total_count">{{ results|length }}</span>
                {% endset %}
                {{ phrase('agent.publish.showing_count_articles', {'display_count':phrase_part,'count':results|length}) }}
            </div>
		</footer>
	{% endif %}
{# scroll containers #}
</div></div></div></div>
{# /scroll containers #}
