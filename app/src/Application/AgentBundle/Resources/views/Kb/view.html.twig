{% import 'AgentBundle:Common:optionbox-macros.html.twig' as optionbox %}
<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.KbViewArticle';
pageMeta.title = {{article.title|json_encode|raw}};
pageMeta.article_id = {{article.id}};
pageMeta.url_fragment  = '{{ url_fragment('agent_kb_article', {'article_id': article.id}) }}';

pageMeta.permalink = '{{ article.permalink }}';
pageMeta.labelsSaveUrl = '{{ path('agent_kb_ajax_labels_save', {'article_id': article.id}) }}';

{% if article.hidden_status == 'validating' %}
pageMeta.isValidating = true;
{% endif %}

pageMeta.glossaryWords = {{ glossary_words|json_encode|raw }};

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
{# scroll containers #}
<div class="layout-content with-scrollbar page-listing page-kb-view">
<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
<div class="scroll-viewport"><div class="scroll-content">
{# /scroll containers #}

<div class="delete-notice" {% if article.status_code != "hidden.deleted" %}style="display: none;"{% endif %}>
	{{ phrase('agent.record_deleted') }} <button class="clean-gray xxx-small undelete">{{ phrase('agent.undelete') }}</button>
</div>

{% if article.status_code == "hidden.validating" %}
	{% include 'AgentBundle:Publish:view-approve-header.html.twig' %}
{% endif %}

<header class="page-header">
	<h4 class="id-number">#{{ article.id }}</h4>
	<h1 class="editable hover-edit" data-editable-for=".inline-editable .title">{{ article.title }}</h1>
	<br class="clear" />
	<div class="meta-line">
		<div class="status the-status article-status"><span>
			{% if feedback.status == 'new' %}
				New
			{% elseif feedback.status == 'active' %}
				Active: {{ feedback.status_category.title }}
			{% elseif feedback.status == 'closed' %}
				Closed: {{ feedback.status_category.title }}
			{% else %}
				Hidden
			{% endif %}
		</span></div>
	</div>
	<br class="clear" />
</header>

<div class="profile-box-container">
	<header>
		<h4>{{ phrase('agent.label_properties') }}</h4>
	</header>
	<section class="description-area">
		<dl class="info-list">
			<dt class="type-labels">{{ phrase('agent.label_labels') }}:</dt>
			<dd class="kb-tags tags-wrap">
				<input type="text" value="{% for label in article.labels %}{{label.label}},{% endfor %}" />
			</dd>
			<dt class="">{{ phrase('agent.categories') }}</dt>
			<dd>
				<ul id="{{baseId}}_categories" class="add-remove-list">
					{% for cat in article.categories %}
						<li>
							<span class="remove">remove</span>
							{{ cat.full_title }}
							<input type="hidden" name="category_ids[]" value="{{ cat.id }}" />
						</li>
					{% endfor %}
					<li class="add">
						<span class="add"></span>
						{{ phrase('agent.add_category') }}
					</li>
				</ul>
			</dd>

			{% if app.getSetting('core.use_product') %}
				<dt class="">{{ phrase('agent.products') }}</dt>
				<dd>
					<ul id="{{baseId}}_products" class="add-remove-list">
						{% for prod in article.products %}
							<li>
								<span class="remove">remove</span>
								{{ prod.full_title }}
								<input type="hidden" name="product_ids[]" value="{{ prod.id }}" />
							</li>
						{% endfor %}
						<li class="add">
							<span class="add"></span>
							{{ phrase('agent.add_product') }}
						</li>
					</ul>
				</dd>
			{% endif %}

			<dt>{{ phrase('agent.label_rating') }}</dt>
			<dd>
				{{ article.rating_percent }}% helpful (<span class="link-look who-voted-trigger">{{ article.num_ratings }} votes</span>)<br />
				<small>{{ article.up_votes }} found the article helpful, {{ article.down_votes }} found the article unhelpful</small>
			</dd>

			{% if article.date_created == article.date_published %}
				<dt>{{ phrase('agent.created_and_published') }}:</dt>
				<dd>
					<time class="timeago" datetime="{{article.date_created|date('c')}}"></time> by {{ article.person.display_name }} at <time>{{article.date_created|date('H:ia M j Y')}}</time>
				</dd>
			{% else %}
				<dt>{{ phrase('agent.date_created') }}:</dt>
				<dd>
					<time class="timeago" datetime="{{article.date_created|date('c')}}"></time> by {{ article.person.display_name }} at <time>{{article.date_created|date('H:ia M j Y')}}</time>
				</dd>

				{# Makes sure its not a future date, which means auto-publish sometime in the future #}
				{% if article.date_published and article.date_published|date('U') < 'now'|date('U') %}
					<dt>{{ phrase('agent.date_published') }}:</dt>
					<dd>
						<time class="timeago" datetime="{{article.date_published|date('c')}}"></time> at <time>{{article.date_published|date('H:ia M j Y')}}</time>
					</dd>
				{% endif %}
			{% endif %}

			<dd id="{{baseId}}_auto_unpub" {% if not (article.status == 'published') %}style="display: none"{% endif %}>
				<span class="auto-unpublish" {% if not article.date_end %}style="display: none"{% endif %}>
					Automatically <span class="end-action opt" data-val="{{article.end_action|default('unpublish')}}">{{article.end_action|default('Unpublish')}}</span>
					on <span class="end-date opt" {% if article.date_end %}data-val="{{ article.date_end|date('U') }}"{% endif %}>
						{% if article.date_end %}{{ article.date_end|date('M j Y') }}{% else %}(click to set date){% endif %}</span>
					<input type="text" class="end-date-input" value="{{ article.date_end|date('U') }}" style="visibility: none; width: 1px; height: 1px; overflow: hidden; border: 0; margin: 0; padding: 0;" />
					(<span class="remove-auto-unpublish options-text">remove</span>)
				</span>
				<span class="options-text auto-unpublish-set" {% if article.date_end %}style="display: none"{% endif %}>
					Set an automatic unpublish date
				</span>
				<br />

				<ul class="end-action-menu" style="display: none">
					<li data-action="unpublish">{{ phrase('agent.unpublish') }}</li>
					<li data-action="delete">{{ phrase('agent.delete') }}</li>
					<li data-action="archive">{{ phrase('agent.action_archive') }}</li>
				</ul>
			</dd>

			<dd id="{{baseId}}_auto_pub" {% if not (article.hidden_status == 'unpublished') %}style="display: none"{% endif %}>
				<span class="auto-publish" {% if not article.date_published %}style="display: none"{% endif %}>
					Automatically publish
					on <span class="pub-date opt" {% if article.date_published %}data-val="{{ article.date_published|date('U') }}"{% endif %}>
						{% if article.date_published %}{{ article.date_published|date('M j Y') }}{% else %}(click to set date){% endif %}</span>
					<input type="text" class="pub-date-input" value="{{ article.date_published|date('U') }}" style="visibility: none; width: 1px; height: 1px; overflow: hidden; border: 0; margin: 0; padding: 0;" />
					(<span class="remove-auto-publish options-text">remove</span>)
				</span>
				<span class="options-text auto-publish-set" {% if article.date_published %}style="display: none"{% endif %}>
					Set an automatic publish date
				</span>
			</dd>
		</dl>

		{% if custom_fields|length %}
			<dl class="info-list" id="{{baseId}}_custom_fields_rendered">
				{% include 'AgentBundle:Kb:view-customfields-rendered-rows.html.twig' %}
			</dl>
			<dl class="info-list" id="{{baseId}}_custom_fields_editable" style="display: none">
				{% include 'AgentBundle:Kb:view-customfields-edit-rows.html.twig' %}
			</dl>
		{% endif %}

		<div class="controls" id="{{baseId}}_properties_controls">
			<div class="showing-editing-fields" style="display: none">
				<button class="clean-white save-fields-trigger"><span>{{ phrase('agent.save') }}</span></button>
			</div>
			<div class="showing-rendered-fields">
				<button class="clean-white edit-fields-trigger"><span>{{ phrase('agent.edit_properties') }}</span></button>
				<button class="clean-white delete" {% if article.status_code == "hidden.deleted" %}style="display:none"{% endif %}>{{ phrase('agent.delete') }}</button>
				<button class="clean-white permalink">{{ phrase('agent.copy_permalink') }}</button>
				<button class="clean-white view-user-interface">{{ phrase('agent.view_in_user_interface') }}</button>
			</div>
		</div>

		<ul id="{{baseId}}_more_menu" style="display: none;">
			<li data-op="delete">{{ phrase('agent.delete') }}</li>
			<li data-op="print">{{ phrase('agent.print') }}</li>
		</ul>
	</section>
</div>

<nav class="page-tabs" id="{{baseId}}_bodytabs">
	<ul>
		<li class="on" data-tab-for="#{{baseId}}_tab_contents .kb-content"><span>{{ phrase('agent.label_article') }}</span></li>
		<li data-tab-for="#{{baseId}}_tab_contents .comments-tab"><span>{{ phrase('agent.label_comments') }} (<span id="{{baseId}}_count_comments">{{article_comments|length|default(0)}}</span>)</span></li>
		<li data-tab-for="#{{baseId}}_tab_contents .revisions"><span>{{ phrase('agent.label_revisions') }}</span></li>
		<li data-tab-for="#{{baseId}}_tab_contents .kb-related-content"><span>{{ phrase('agent.label_related_content') }}</span></li>
		<li data-tab-for="#{{baseId}}_tab_contents .search-tab"><span>{{ phrase('agent.label_search') }}</span></li>
	</ul>
	<button class="clean-white small kb-editor-edit" style="float:right; margin: 6px 10px 0 0;">{{ phrase('agent.edit') }}</button>
</nav>

{# Tab Contents #}
<div id="{{baseId}}_tab_contents">
	{# Tab: Content #}
	<div class="deskpro-tab-item content-tab-item kb-content on" style="display: block">
		<div id="{{baseId}}_content_ed">
		{% include 'AgentBundle:Kb:view-content-tab.html.twig' %}
		</div>
	</div>
	{# /Tab: Content #}

	{# Tab: Comments #}
	<div class="deskpro-tab-item content-tab-item comments-tab">
		<div class="article-comments">
			<div class="full-deskpro-tab-item">
				<div class="messages-wrap" id="{{baseId}}_comments_wrap">
					{% for comment in article_comments %}
						{% include 'AgentBundle:Kb:view-comment.html.twig' %}
					{% endfor %}
				</div>
			</div>

			<div class="message admin-message new-note">
				<div class="message-avatar left">
					<img src="{{ app.user.getPictureUrl(35) }}" alt="" width="35" height="35" />
				</div>
				<div class="message-body">
					<div class="message-meta">
						<span class="arrow-left"></span>
						<h4>{{ app.user.display_name }}</h4>
					</div>
					<div class="message-text">
						<p>
							<textarea style="width:98%; height: 80px;"></textarea>
							<div style="text-align:center; margin-top: 9px;">
								<div class="loading-off">
									<button class="dp-button x-small">{{ phrase('agent.add_comment') }}</button>
								</div>
								<div class="loading-on" style="display:none">
									{{ phrase('agent.loading_saving') }}
								</div>
							</div>
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>
	{# /Tab: Comments #}

	{# Tab: Revisions #}
	<div id="{{baseId}}_revs" class="loaded deskpro-tab-item revisions">
		{% include 'AgentBundle:Kb:view-revisions-tab.html.twig' %}
	</div>
	{# /Tab: Revisions #}

	{# Tab: Related #}
	<div id="{{baseId}}_related_content" class="deskpro-tab-item kb-related-content">
		{% include 'AgentBundle:Common:content-related-list.html.twig' %}
	</div>
	{# /Tab: Related #}

	{# Tab: Search #}
	<div id="{{baseId}}_searchtab" class="deskpro-tab-item search-tab">
		<div class="tags-wrap sticky-search-words">
			<dl class="table-list">
				<dt class="type-labels">{{ phrase('agent.publish.sticky_words_title') }}</dt>
				<dd>
					<input type="text" value="{% for label in sticky_search_words %}{{label}},{% endfor %}" />
					<div class="explain">
						{{ phrase('agent.publish.search_sticky_words_explain') }}
					</div>
				</dd>
			</dl>
		</div>

		<br />

		{% include 'AgentBundle:Publish:rated-searches.html.twig' %}
	</div>
	{# /Tab: Search #}
</div>
{# /Tab Contents #}

<div class="inline-editable" style="display:none">
	<div class="title">
		<input type="text" name="title" value="{{ article.title }}"/>
		<input type="hidden" name="action" value="title" />
	</div>
</div>

<ul class="status-menu" data-option-name="status" style="display:none">
	<li data-option-value="published">{{ phrase('agent.kb.status_published') }}</li>
	<li data-option-value="hidden.unpublished">{{ phrase('agent.kb.hidden_status_unpublished') }}</li>
	<li data-option-value="archived">{{ phrase('agent.kb.status_archived') }}</li>
	{% if article.person.id == app.user.id %}
		<li data-option-value="hidden.draft">{{ phrase('agent.kb.hidden_status_draft') }}</li>
	{% endif %}
</ul>

{% macro category_row(cat, depth) %}
	<li
		class="{% if not depth %}top{% else %}child{% endif %} {% if cat.children %}parent-option{% endif %} item-{{ cat.id }} depth-{{ depth }}"
		{% if cat.parent_id %}data-parent-id="{{ cat.parent_id }}"{% endif %}
		data-item-id="{{ cat.id }}"
		data-full-title="{{ cat.title }}"
	>
		{% if depth %}<span class="elbow-end"></span>{% endif %}
		<input type="radio" name="category_id" value="{{ cat.id }}" />
		<label>{{ cat.title }}</label>
	</li>
	{% if cat.children|length %}
		{% for subcat in cat.children %}
			{{ _self.category_row(subcat, depth+1) }}
		{% endfor %}
	{% endif %}
{% endmacro %}
{{ optionbox.start(phrase('agent.add_category'), {'id': baseId ~ '_cat_ob'}) }}
	{{ optionbox.section_start('', 'category') }}
		{% for cat in article_categories %}
			{{ _self.category_row(cat, 0) }}
		{% endfor %}
	{{ optionbox.section_end() }}
{{ optionbox.end(phrase('agent.add_category')) }}

{# scroll containers #}
</div></div></div></div>
{# /scroll containers #}
