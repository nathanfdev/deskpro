{% import 'AgentBundle:Common:optionbox-macros.html.twig' as optionbox %}
<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.KbViewArticle';
pageMeta.title = {{article.title|json_encode|raw}};
pageMeta.article_id = {{article.id}};
pageMeta.url_fragment  = '{{ url_fragment('agent_kb_article', {'article_id': article.id}) }}';

pageMeta.permalink = '{{ article.permalink }}';
pageMeta.labelsSaveUrl = '{{ path('agent_kb_ajax_labels_save', {'article_id': article.id}) }}';

{% if article.hidden_status == 'validating' %}
pageMeta.isValidating = true;
{% endif %}

pageMeta.glossaryWords = {{ glossary_words|json_encode|raw }};

pageMeta.canEdit   = {% if article.person.id != app.user.id and not app.user.hasPerm('agent_publish.edit') %}false{% else %}true{% endif %};
pageMeta.canDelete = {% if not app.user.hasPerm('agent_publish.delete') %}false{% else %}true{% endif %};

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
{# scroll containers #}
<div class="layout-content with-scrollbar page-listing page-kb-view {% if article.person.id != app.user.id and not app.user.hasPerm('agent_publish.edit') %}perm-no-edit{% endif %} {% if not app.user.hasPerm('agent_publish.delete') %}perm-no-delete{% endif %}">
<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
<div class="scroll-viewport"><div class="scroll-content">
{# /scroll containers #}

<div class="delete-notice" {% if article.status_code != "hidden.deleted" %}style="display: none;"{% endif %}>
	{{ phrase('agent.record_deleted') }} <button class="clean-gray xxx-small undelete">{{ phrase('agent.undelete') }}</button>
</div>

{% if article.status_code == "hidden.validating" %}
	{% include 'AgentBundle:Publish:view-approve-header.html.twig' %}
{% endif %}

<header class="page-header">
	<h4 class="id-number">#{{ article.id }}</h4>
	<h1 class="editable hover-edit" data-editable-for=".inline-editable .title">{{ article.title }}</h1>
	<br class="clear" />
	<div class="meta-line">
		<div class="status the-status article-status"><span>{{ phrase('agent.publish.status_' ~ article.status_code|replace({'.':'_'})) }}</span></div>
	</div>
	<br class="clear" />
</header>

<div class="profile-box-container-outer">
<div class="profile-box-container">
	<header>
		<h4>{{ phrase('agent.properties') }}</h4>
	</header>
	<section class="description-area">
		<dl class="info-list">
			<dt class="type-labels">{{ phrase('agent.labels') }}:</dt>
			<dd class="kb-tags tags-wrap noedit-tags">
				<input type="text" id="{{baseId}}_labels_input" value="{% for label in article.labels %}{{label.label}},{% endfor %}" />
			</dd>
			<dt class="">{{ phrase('agent.categories') }}</dt>
			<dd>
				<ul id="{{baseId}}_categories" class="add-remove-list">
					{% for cat in article.categories %}
						<li>
							<span class="remove noedit-hide">{{ phrase('agent.remove') }}</span>
							{{ cat.full_title }}
							<input type="hidden" name="category_ids[]" value="{{ cat.id }}" />
						</li>
					{% endfor %}
					<li class="add noedit-hide">
						<span class="add"></span>
						{{ phrase('agent.add_category') }}
					</li>
				</ul>
			</dd>

			{% if app.getSetting('core.use_product') %}
				<dt class="">{{ phrase('agent.products') }}</dt>
				<dd>
					<ul id="{{baseId}}_products" class="add-remove-list">
						{% for prod in article.products %}
							<li>
								<span class="remove">{{ phrase('agent.remove') }}</span>
								{{ prod.full_title }}
								<input type="hidden" name="product_ids[]" value="{{ prod.id }}" />
							</li>
						{% endfor %}
						<li class="add noedit-hide">
							<span class="add"></span>
							{{ phrase('agent.add_product') }}
						</li>
					</ul>
				</dd>
			{% endif %}

			<dt>{{ phrase('agent.rating') }}</dt>
			<dd>
                {% set phrase_part %}
                <span class="link-look who-voted-trigger">{{ phrase('agent.count_votecount_votes', {'count':article.num_ratings}) }}</span>
                {% endset %}
                {{ phrase('agent.percent_helpful_subphrase', {'percent':article.rating_percent,'subphrase':phrase_part}) }}<br />
				<small>{{ phrase('agent.found_article_helpful_or_not', {'up_votes':article.up_votes,'down_votes':article.down_votes}) }}</small>
			</dd>

			{% if article.date_created == article.date_published %}
				<dt>{{ phrase('agent.created_and_published') }}:</dt>
				<dd>
                    {% set phrase_part1 %}
                        <time class="timeago" datetime="{{article.date_created|date('c')}}"></time>
                    {% endset %}
                    {% set phrase_part2 %}
                        <time>{{article.date_created|date('fulltime')}}</time>
                    {% endset %}
                    {{ phrase('agent.publish.event_time_ago_by_who_at_when', {'ago':phrase_part1,'name':article.person.display_name,'date':phrase_part2}) }}
				</dd>
			{% else %}
				<dt>{{ phrase('agent.date_created') }}:</dt>
				<dd>
                    {% set phrase_part1 %}
                    <time class="timeago" datetime="{{article.date_created|date('c')}}"></time>
                    {% endset %}
                    {% set phrase_part2 %}
                    <time>{{article.date_created|date('fulltime')}}</time>
                    {% endset %}
                    {{ phrase('agent.publish.event_time_ago_by_who_at_when', {'ago':phrase_part1,'name':article.person.display_name,'date':phrase_part2}) }}
				</dd>

				{# Makes sure its not a future date, which means auto-publish sometime in the future #}
				{% if article.date_published and article.date_published|date('U') < 'now'|date('U') %}
					<dt>{{ phrase('agent.date_published') }}:</dt>
					<dd>
                        {% set phrase_part1 %}
                        <time class="timeago" datetime="{{article.date_created|date('c')}}"></time>
                        {% endset %}
                        {% set phrase_part2 %}
                        <time>{{article.date_created|date('fulltime')}}</time>
                        {% endset %}
                        {{ phrase('agent.publish.event_time_ago_at_when', {'ago':phrase_part1,'date':phrase_part2}) }}
					</dd>
				{% endif %}
			{% endif %}

			<dd id="{{baseId}}_auto_unpub" {% if not (article.status == 'published') %}style="display: none"{% endif %}>
				<span class="auto-unpublish" {% if not article.date_end %}style="display: none"{% endif %}>
					Automatically <span class="end-action opt" data-val="{{article.end_action|default('unpublish')}}">{{article.end_action|default('Unpublish')}}</span>
					on <span class="end-date opt" {% if article.date_end %}data-val="{{ article.date_end|date('U') }}"{% endif %}>
						{% if article.date_end %}{{ article.date_end|date('day') }}{% else %}{{ phrase('agent.publish.click_to_set_date') }}{% endif %}</span>
					<input type="text" class="end-date-input" value="{{ article.date_end|date('U') }}" style="visibility: none; width: 1px; height: 1px; overflow: hidden; border: 0; margin: 0; padding: 0;" />
					(<span class="remove-auto-unpublish options-text">{{ phrase('agent.remove') }}</span>)
				</span>
				<span class="options-text auto-unpublish-set" {% if article.date_end %}style="display: none"{% endif %}>
					{{ phrase('agent.publish.set_auto_unpublish_date') }}
				</span>
				<br />

				<ul class="end-action-menu" style="display: none">
					<li data-action="unpublish">{{ phrase('agent.unpublish') }}</li>
					<li data-action="archive">{{ phrase('agent.archive') }}</li>
				</ul>
			</dd>

			<dd id="{{baseId}}_auto_pub" {% if not (article.hidden_status == 'unpublished') %}style="display: none"{% endif %}>
				<span class="auto-publish" {% if not article.date_published %}style="display: none"{% endif %}>
					Automatically publish
					on <span class="pub-date opt" {% if article.date_published %}data-val="{{ article.date_published|date('U') }}"{% endif %}>
						{% if article.date_published %}{{ article.date_published|date('day') }}{% else %}{{ phrase('agent.publish.click_to_set_date') }}{% endif %}</span>
					<input type="text" class="pub-date-input" value="{{ article.date_published|date('U') }}" style="visibility: none; width: 1px; height: 1px; overflow: hidden; border: 0; margin: 0; padding: 0;" />
					(<span class="remove-auto-publish options-text">{{ phrase('agent.remove') }}</span>)
				</span>
				<span class="options-text auto-publish-set" {% if article.date_published %}style="display: none"{% endif %}>
					{{ phrase('agent.publish.set_auto_publish_date') }}
				</span>
			</dd>
		</dl>

		{% if custom_fields|length %}
			<dl class="info-list" id="{{baseId}}_custom_fields_rendered">
				{% include 'AgentBundle:Kb:view-customfields-rendered-rows.html.twig' %}
			</dl>
			<dl class="info-list" id="{{baseId}}_custom_fields_editable" style="display: none">
				{% include 'AgentBundle:Kb:view-customfields-edit-rows.html.twig' %}
			</dl>
		{% endif %}

		<div class="controls" id="{{baseId}}_action_buttons">
			<div class="showing-editing-fields" style="display: none">
				<button class="clean-white save-fields-trigger"><span>{{ phrase('agent.save') }}</span></button>
			</div>
			<div class="showing-rendered-fields">
				{% if custom_fields|length %}<button class="clean-white edit-fields-trigger noedit-hide"><span>{{ phrase('agent.edit_properties') }}</span></button>{% endif %}
				<button class="clean-white delete nodelete-hide" {% if article.status_code == "hidden.deleted" %}style="display:none"{% endif %}>{{ phrase('agent.ucfirst_delete') }}</button>
				<button class="clean-white permalink">{{ phrase('agent.copy_permalink') }}</button>
				<button class="clean-white view-user-interface">{{ phrase('agent.view_in_user_interface') }}</button>
                <a target="_blank" href="{{ path('agent_kb_article', {'article_id': article.id,'pdf': 1}) }}"><button class="clean-white">{{ phrase('agent.download_pdf') }}</button></a>
			</div>
		</div>
	</section>
</div>
</div>

<div class="profile-box-container reply-box-wrap">
	<header>
		<nav  id="{{baseId}}_bodytabs">
			<ul>
				<li class="on" data-tab-for="#{{baseId}}_tab_contents .kb-content"><span>{{ phrase('agent.article') }}</span></li>
				<li data-tab-for="#{{baseId}}_tab_contents .comments-tab"><span>{{ phrase('agent.comments') }} (<span id="{{baseId}}_count_comments">{{article_comments|length|default(0)}}</span>)</span></li>
				<li data-tab-for="#{{baseId}}_tab_contents .revisions-tab"><span>{{ phrase('agent.label_revisions') }} (<span id="{{baseId}}_count_revs">{{article.revisions|length|default(0)}}</span>)</span></li>
				<li data-tab-for="#{{baseId}}_tab_contents .related-content-tab"><span>{{ phrase('agent.related_content') }} (<span id="{{baseId}}_count_related">0</span>)</span></li>
				<li data-tab-for="#{{baseId}}_tab_contents .search-tab"><span>{{ phrase('agent.search') }}</span></li>
			</ul>
		</nav>
	</header>
	<section>

		{# Tab Contents #}
		<div id="{{baseId}}_tab_contents">
			{# Tab: Content #}
			<div class="deskpro-tab-item kb-content on" style="display: block">
				<nav class="sub-box-nav noedit-hide">
					<ul class="option-buttons right" id="{{baseId}}_content_edit_btns">
						<li class="kb-editor-edit edit" id="{{baseId}}_edit_btn"><span>{{ phrase('agent.ucfirst_edit') }}</span></li>
						<li class="editor-save-trigger save" id="{{baseId}}_save_btn"><span>{{ phrase('agent.save') }}</span></li>
						<li class="editor-cancel-trigger cancel" id="{{baseId}}_cancel_btn"><span>{{ phrase('agent.cancel') }}</span></li>
					</ul>
				</nav>
				<div id="{{baseId}}_content_ed" class="content-tab-item">
				{% include 'AgentBundle:Kb:view-content-tab.html.twig' %}
				</div>
			</div>
			{# /Tab: Content #}

			{# Tab: Comments #}
			<div class="deskpro-tab-item content-tab-item comments-tab">
				<div class="article-comments">
					<div class="full-deskpro-tab-item">
						<div class="messages-wrap" id="{{baseId}}_comments_wrap">
							{% for comment in article_comments %}
								{% include 'AgentBundle:Kb:view-comment.html.twig' %}
							{% endfor %}
						</div>
						<div class="messages-wrap new-note">
							<article
								class="content-message agent-message"
								data-comment-id="{{comment.id}}"
								data-content-type="{{ comment.object_content_type }}"
							>
								<div class="avatar">
									<img src="{{ app.user.getPictureUrl(40) }}" alt="" width="40" height="40" />
								</div>
								<div class="content">
									<header>
										<h4>{{ phrase('agent.new_comment') }}</h4>
									</header>
									<div class="body-text">
										<textarea style="width:99%; height: 80px;"></textarea>
									</div>
									<div class="footer-text">
										<div class="loading-off">
											<button class="clean-white">{{ phrase('agent.add_comment') }}</button>
										</div>
										<div class="loading-on" style="display:none">
											{{ phrase('agent.saving') }}
										</div>
									</div>
								</div>
							</article>
						</div>
					</div>
				</div>
			</div>
			{# /Tab: Comments #}

			{# Tab: Revisions #}
			<div id="{{baseId}}_revs" class="loaded deskpro-tab-item content-tab-item revisions-tab">
				{% include 'AgentBundle:Kb:view-revisions-tab.html.twig' %}
			</div>
			{# /Tab: Revisions #}

			{# Tab: Related #}
			<div id="{{baseId}}_related_content" class="deskpro-tab-item content-tab-item kb-related-content related-content-tab">
				{% include 'AgentBundle:Common:content-related-list.html.twig' %}
			</div>
			{# /Tab: Related #}

			{# Tab: Search #}
			<div id="{{baseId}}_searchtab" class="deskpro-tab-item search-tab">
				<section class="description-area sticky-search-words">
					<dl class="info-list">
						<dt>{{ phrase('agent.publish.sticky_words_title') }}</dt>
						<dd class="ticket-tags tags-wrap noedit-tags">
							<input type="text" id="{{baseId}}_stickysearch_input" value="{% for label in sticky_search_words %}{{label}},{% endfor %}" />
							<br class="clear" />
							<div class="explain">
								{{ phrase('agent.publish.search_sticky_words_explain') }}
							</div>
						</dd>
					</dl>
				</section>

				<br />

				{% include 'AgentBundle:Publish:rated-searches.html.twig' %}
			</div>
			{# /Tab: Search #}
		</div>
		{# /Tab Contents #}
	</section>
</div>

<div class="inline-editable" style="display:none">
	<div class="title">
		<input type="text" name="title" value="{{ article.title }}"/>
		<input type="hidden" name="action" value="title" />
	</div>
</div>

<ul class="status-menu" data-option-name="status" style="display:none">
	<li data-option-value="published">{{ phrase('agent.publish.status_published') }}</li>
	<li data-option-value="hidden.unpublished">{{ phrase('agent.publish.status_hidden_unpublished') }}</li>
	<li data-option-value="archived">{{ phrase('agent.publish.status_archived') }}</li>
	{% if article.person.id == app.user.id %}
		<li data-option-value="hidden.draft">{{ phrase('agent.publish.status_hidden_draft') }}</li>
	{% endif %}
</ul>

{% macro category_row(cat, depth) %}
	<li
		class="{% if not depth %}top{% else %}child{% endif %} {% if cat.children %}parent-option{% endif %} item-{{ cat.id }} depth-{{ depth }}"
		{% if cat.parent_id %}data-parent-id="{{ cat.parent_id }}"{% endif %}
		data-item-id="{{ cat.id }}"
		data-full-title="{{ cat.title }}"
	>
		{% if depth %}<span class="elbow-end"></span>{% endif %}
		<input type="radio" name="category_id" value="{{ cat.id }}" />
		<label>{{ cat.title }}</label>
	</li>
	{% if cat.children|length %}
		{% for subcat in cat.children %}
			{{ _self.category_row(subcat, depth+1) }}
		{% endfor %}
	{% endif %}
{% endmacro %}
{{ optionbox.start(phrase('agent.add_category'), {'id': baseId ~ '_cat_ob'}) }}
	{{ optionbox.section_start('', 'category') }}
		{% for cat in article_categories %}
			{{ _self.category_row(cat, 0) }}
		{% endfor %}
	{{ optionbox.section_end() }}
{{ optionbox.end(phrase('agent.add_category')) }}

{# scroll containers #}
</div></div></div></div>
{# /scroll containers #}
