{% import 'AgentBundle:Common:agent-macros.html.twig' as agentui %}
<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.NewArticle';

pageMeta.title = '{{ phrase('agent.new_article') }}';
pageMeta.uploadAttachUrl              = '{{ path('agent_accept_upload') }}';

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
{% set dropzonehtml %}<div class="drop-file-zone"><h1>{{ phrase('agent.kb.drop_your_file_here_to_add_it_to') }}</h1></div>{% endset %}
{{ agentui.scroll_containers('page-new-article page-new-content', dropzonehtml) }}

<a class="tab-anchor" href="#">&nbsp;</a>

<form id="{{baseId}}_newarticle" class="keybound-submit">
<input type="hidden" name="pending_article_id" id="{{baseId}}_pending_article_id" value="0" />

<div class="pending-info" style="display: none;">
	<h3>Creating pending article (added by <span class="person-name"></span>)</h3>
	<div class="pending-ticket" style="display: none">
		 {{ phrase('agent.kb.for_ticket') }}:
		<a data-route="" class="with-route ticket-link"></a>
	</div>
	<div class="pending-reason" style="display: none"></div>
</div>

<div class="first section cat-section" id="{{baseId}}_cat_section">
	<div class="step">
		<span class="num">1</span>
		<span class="check">{{ phrase('agent.done') }}</span>
	</div>
	<div class="content">
		<div class="col">
			<h4>{{ phrase('agent.category') }}</h4>
			{% include 'AgentBundle:Common:select-standard.html.twig' with {
				'name': 'newarticle[category_id]',
				'id': baseId ~ '_cat',
				'add_classname': 'category_id',
				'add_attr': '',
				'with_blank': 1,
				'blank_title': '',
				'categories': article_categories,
				'selected': state.newarticle.category_id|default(0)
			} %}
		</div>
		<div class="col">
			<h4 class="light">{{ phrase('agent.status') }}</h4>
			<select name="newarticle[status]">
				<option value="published">{{ phrase('agent.published') }}</option>
				<option value="hidden.unpublished">{{ phrase('agent.unpublished') }}</option>
				<option value="hidden.draft">{{ phrase('agent.draft') }}</option>
				{% if constant('DP_DEBUG') %}
					<option value="hidden.validating" selected="selected">{{ phrase('agent.dev_validating') }}</option>
				{% endif %}
			</select>
		</div>
		<br class="clear" />
	</div>
</div>

<div class="section title-section" id="{{baseId}}_title_section">
	<div class="step">
		<span class="num">2</span>
		<span class="check">{{ phrase('agent.done') }}</span>
	</div>
	<div class="content">
		<h4>{{ phrase('agent.title') }}</h4>
		<input type="title" name="newarticle[title]" id="{{baseId}}_title" value="{{ state.newarticle.title }}" />
	</div>
</div>

<div class="section article-section" id="{{baseId}}_news_section">
	<div class="step">
		<span class="num">3</span>
		<span class="check">{{ phrase('agent.done') }}</span>
	</div>
	<div class="content">
		<h4>{{ phrase('agent.article') }}</h4>
		<textarea type="text" name="newarticle[content]" id="{{baseId}}_content">{{ state.newarticle.content }}</textarea>
	</div>
</div>


<div class="section other-section" id="{{baseId}}_other_section">
	<div class="step">
		<span class="num">5</span>
		<span class="check">{{ phrase('agent.done') }}</span>
	</div>
	<div class="content">
		{# Tab Container #}
		<div class="tab-container">
			<nav id="{{baseId}}_other_props_tabs_wrap">
				<ul id="{{baseId}}_other_props_tabs">
					<li data-tab-for="> .tab-properties">{{ phrase('agent.properties') }}</li>
					<li data-tab-for="> .tab-attach">{{ phrase('agent.attachments') }}</li>
				</ul>
			</nav>
			<div class="content-wrapper" id="{{baseId}}_other_props_tabs_content" style="display: none">
				{# Tab Properties #}
				<div class="tab-properties" style="display: none">
					<dl>
						<dt class="prop">{{ phrase('agent.url_slug') }}</dt>
						<dd class="prop">
							<input type="input" name="newarticle[slug]" id="{{baseId}}_slug" value="{{ state.newarticle.slug }}" />
						</dd>

						<dt class="prop">{{ phrase('agent.labels') }}</dt>
						<dd class="prop">
							<div class="tags-wrap article-tags">
								<input type="text" value="{% for label in state.newarticle.labels %}{{label}},{% endfor %}" />
							</div>
						</dd>
					</dl>
				</div>
				{# /Tab Properties #}

				{# Tab Attach #}
				<div class="tab-attach" style="display: none">
					{% include 'AgentBundle:Common:attach-row-tmpl.html.twig' with {formname: 'newarticle[attach][]'} %}
					<h6>{{ phrase('agent.attachments') }}</h6>
					<div class="file-input">
						<input type="file" name="file-upload" multiple="multiple" /> <button class="clean-gray xxx-small">{{ phrase('agent.upload') }}</button>
					</div>
					<ul class="files file-list"></ul>
				</div>
				{# /Tab Attach #}
			</div>
		</div>
		{# /Tab Container #}
	</div>
</div>


<footer class="pop-footer">
	<div class="is-not-loading">
		<button class="submit-trigger clean-white">{{ phrase('agent.kb.create_article') }} <kbd>{{ phrase('agent.altc') }}</kbd></button>
	</div>
	<div class="is-loading" style="padding-top: 9px;">
		<img src="{{ asset('images/spinners/loading-small.gif') }}" />
	</div>
</footer>

</form>

{{ agentui.scroll_containers_end() }}
