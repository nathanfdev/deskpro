<section class="search-reuslts page-set" data-page="{{ page }}">
	{% for article in results %}
		<article
			class="row-item article article-{{article.id}} articles-{{article.id}} related-is-linkable"
			data-content-type="articles"
			data-content-id="{{ article.id }}"
			data-route="article:{{ path('agent_kb_article', {'article_id': article.id}) }}"
			data-route-title="@selector(a.row-title)"
			data-route-openclass="open"
		>
			<input class="item-select" type="checkbox" value="{{article.id}}" />
			<div class="top-row">
				<div class="top-row-left">
					<h3>
						<a class="row-title click-through">{{ article.title }}</a>
					</h3>
				</div>
				<div class="top-row-right visible-ticket-controls">
					<div class="bound-faded"></div>
					<span class="tipped kb-insert-link" title="{{ phrase('agent.insert_link') }}" data-article-id="{{ article.id }}"></span>
					<span class="tipped kb-insert-content" title="{{ phrase('agent.insert_content') }}" data-article-id="{{ article.id }}"></span>
				</div>
				<div class="top-row-right visible-related-content-controls">
					<div class="bound-faded"></div>
					<span class="tipped related-link" title="{{ phrase('agent.add_as_related') }}"></span>
					<span class="tipped related-unlink" title="{{ phrase('agent.remove_as_related') }}"></span>
				</div>
			</div>
			<hr class="clear-top" />
			{% if display_fields|length %}
				<div class="extra-fields">
					<ul>
						{% for field in display_fields %}
							{% if field == 'category' %}
								<li>
									<span class="prop-title">{{ phrase('agent.category') }}</span>
									<span class="prop-val">{{ article.category_names }}</span>
								</li>
							{% elseif field == 'author' %}
								<li>
									<span class="prop-title">{{ phrase('agent.author') }}</span>
									<span class="prop-val">{{ article.by_line }}</span>
								</li>
							{% elseif field == 'date_created' %}
								<li>
									<span class="prop-title">{{ phrase('agent.date_created') }}</span>
									<span class="prop-val">{{ article.date_created|date('day')}}</span>
								</li>
							{% elseif field == 'view_count' %}
								<li>
									<span class="prop-title">{{ phrase('agent.num_views') }}</span>
									<span class="prop-val">{{ article.view_count|default(0) }}</span>
								</li>
							{% endif %}
						{% endfor %}
					</ul>
					<br class="clear" />
				</div>
			{% else %}
				<br class="clear" />
			{% endif %}
		</article>
	{% endfor %}
</section>
