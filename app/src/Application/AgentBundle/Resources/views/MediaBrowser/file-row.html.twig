<div class="blob-row blob-{{blob.id}} {% if blob.isImage() %}is-image{% endif %}" data-blob-id="{{ blob.id }}">
	<div class="title">
		{% if blob.isImage() %}
			<img class="thumbnail" src="{{ blob.thumbnail_url }}" />
		{% endif %}
		<label>
			{{ phrase('agent.title') }}:
			<input type="text" name="title" class="file-title" value="{{ blob.title|default(blob.filename) }}" />
		</label>
	</div>
	<div class="info">
		<div class="tags-wrap blob-tags">
			<input type="text" value="{% for label in blob.labels %}{{label.label}},{% endfor %}" />
		</div>
		<ul>
			<li><a href="{{ blob.download_url }}">{{ phrase('agent.media.download_file') }}</a></li>
			<li>{{ phrase('agent.media.file_name') }}: {{ blob.filename }}</li>
			<li>{{ phrase('agent.media.file_size') }}: {{ blob.readable_filesize }}</li>
			{% if blob.dim_w %}
				<li>Dimentions: {{ blob.dim_w }}x{{ blob.dim_h }}</li>
			{% endif %}
		</ul>
	</div>
	<div class="footer">
		<button class="dp-button x-small remove-trigger" style="float: right">{{ phrase('agent.remove') }}</button>

		<button class="dp-button x-small link-trigger" data-code="[attach:{{ blob.id }} label:{{ blob.display_title }}]">{{ phrase('agent.media.insert_link_to_file') }}</button>
		{% if blob.isImage() %}
			<button class="dp-button x-small image-trigger" data-code="[attach:{{ blob.id }} image]">{{ phrase('agent.media.insert_image') }}</button>
			<button class="dp-button x-small image-edit-trigger">{{ phrase('agent.media.insert_edited_image') }}</button>
		{% endif %}
	</div>
</div>
