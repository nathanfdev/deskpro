<table width="100%" cellpadding="0" cellspacing="0">
	{% for blob_object in recent_blob_objects %}
		<tr>
			<td>
				{{ blob_object.blob.filename }} attached to
				{% if blob_object.object_type == 'ticket' %}
					ticket <a class="with-route" data-route="{{ path('agent_ticket_view', {'ticket_id': blob_object.object.id}) }}">{{ blob_object.object.subject }}</a>
				{% elseif blob_object.object_type == 'kb' %}
					{{ phrase('agent.mediabrowser.article') }} <a class="with-route" data-route="{{ path('agent_kb_view', {'{{ phrase('agent.mediabrowser.article') }}_id': blob_object.object.id}) }}">{{ blob_object.object.title }}</a>
				{% endif %}
			</td>
			<td>
				{{ blob_object.blob.date_created|date('day') }}
			</td>
		</tr>
	{% endfor %}
</table>
