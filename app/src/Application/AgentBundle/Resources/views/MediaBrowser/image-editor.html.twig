<div class="image-editor overlay">
	<div class="overlay-title">
		<h4>{{ phrase('agent.mediabrowser.crop_and_scale') }}</h4>
	</div>
	<div class="overlay-content" style="width: 700px; height: 500px; overflow: auto;">
		{{ phrase('agent.mediabrowser.scale') }}: <span class="scale-slider-value">100%</span>
		<div class="scale-slider"></div>

		<input type="hidden" name="x" />
		<input type="hidden" name="x2" />
		<input type="hidden" name="y" />
		<input type="hidden" name="y2" />
		<input type="hidden" name="w" />
		<input type="hidden" name="h" />

		<input type="hidden" name="scale" value="100" />

		<br />

		<img src="{{ blob.download_url }}" border="0" />
	</div>
	<div class="overlay-actions">
		<button class="save-trigger dp-button small">{{ phrase('agent.global.save') }}</button>
	</div>
</div>