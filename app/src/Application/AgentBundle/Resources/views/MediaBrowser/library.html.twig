{{ phrase('agent.general.types') }}:
<label>{{ phrase('agent.general.all') }} <input type="checkbox" name="types[]" value="all" /></label>
<label>{{ phrase('agent.general.tickets') }} <input type="checkbox" name="types[]" value="tickets" /></label>
<label>{{ phrase('agent.general.articles') }} <input type="checkbox" name="types[]" value="kb" /></label>

{{ phrase('agent.general.labels') }}: <input type="text" name="labels" value="{{ labels }}" />

{% if blob_objects|length %}
<table width="100%" cellpadding="0" cellspacing="0">
	{% for blob_object in blob_objects %}
		<tr>
			<td>
				{{ blob_object.blob.filename }} attached to
				{% if blob_object.object_type == 'ticket' %}
					ticket <a class="with-route" data-route="{{ path('agent_ticket_view', {'ticket_id': blob_object.object.id}) }}">{{ blob_object.object.subject }}</a>
				{% elseif blob_object.object_type == 'kb' %}
					{{ phrase('agent.general.article') }} <a class="with-route" data-route="{{ path('agent_kb_view', {'{{ phrase('agent.general.article') }}_id': blob_object.object.id}) }}">{{ blob_object.object.title }}</a>
				{% endif %}
			</td>
			<td>
				{{ blob_object.blob.date_created|date('day') }}
			</td>
		</tr>
	{% endfor %}
</table>
{% endif %}
