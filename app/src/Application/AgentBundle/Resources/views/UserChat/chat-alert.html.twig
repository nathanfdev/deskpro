<section class="new-user-chat-alert" data-conversation-id="{{ convo.id }}" id="new_user_chat_alert_{{ convo.id }}" data-play-sound="new-chat">
	<header><h3>{{ phrase('agent.chat.new_chat') }}</h3></header>
	<div class="messages">
		<div class="row name">
			<label>{{ phrase('agent.userchat.chat_started_by') }}</label>
			{% if person %}
				<a data-route="person:{{ path('agent_people_view', {person_id: person.id}) }}">{{ person.display_name }} &lt;{{ person.email_address }}&gt;</a>
			{% else %}
				{{ phrase('agent.userchat.chat_by_anonymouse') }}
			{% endif %}
		</div>

		{% if convo.department %}
			<div class="row department">
				<label>{{ phrase('global.department') }}</label>
				{{ convo.department.full_title }}
			</div>
		{% endif %}

		<div class="row waiting">
			<label>{{ phrase('global.user_waiting') }}</label>
			<span class="wait-timer" data-time="{{ waiting_secs }}">{{ phrase('agent.userchat.count_seconds', {'count':waiting_secs}) }}</span>
		</div>

		{% if url %}
			<div class="row url">
				<label>{{ phrase('agent.userchat.user_is_viewing') }}</label>
				<a href="{{ url }}" title="{{ url }}">{{ url|truncate(50) }}</a>
			</div>
		{% endif %}

		{% if tickets|length %}
			<div class="row tickets">
				<label>{{ phrase('global.open_tickets') }}</label>
				<ul>
					{% for ticket in tickets %}
						<li>
							<a data-route="ticket:{{ path('agent_ticket_view', {ticket_id: ticket.id}) }}">{{ ticket.subject }}</a>
						</li>
					{% endfor %}
				</ul>
			</div>
		{% endif %}

		{% if visitor %}
			<div class="row ip">
				<label>{{ phrase('global.ip_address') }}</label>
				{{ visitor.ip_address }}
			</div>
		{% endif %}
	</div>
	<footer>
		<button class="clean-white small dismiss-trigger">{{ phrase('global.dismiss') }}</button>
		<button class="clean-white small accept-trigger">{{ phrase('agent.chat.take_chat') }}</button>
	</footer>
</section>
