<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.UserChat';
{% if convo.person %}
	pageMeta.title = {{ convo.person.display_contact|json_encode|raw }};
{% elseif convo.person_name or convo.person_email %}
	var t = [];
	{% if convo.person_name %}t.push({{ convo.person_name|json_encode|raw }});{% endif %}
	{% if convo.person_email %}
    {% set email_addr = '<' ~ convo.person_email ~ '>' %}
        t.push({{ email_addr|json_encode|raw }});
    {% endif %}
	pageMeta.title = t.join(' ');
{% else %}
	pageMeta.title = '{{ phrase('agent.chat.title_chat_id', {'chat_id': convo.id}) }}';
{% endif %}
pageMeta.url_fragment  = '{{ url_fragment('agent_userchat_view', {'conversation_id': convo.id}) }}';
pageMeta.conversation_id = {{convo.id}};
pageMeta.youName         = {{ app.uassign_ob_triggerser.display_name|json_encode|raw }};
pageMeta.tabIdClass      = 'user_chat_tab_{{convo.id}}';
pageMeta.status = '{{ convo.status }}';
pageMeta.isEnded = {% if convo.status == 'ended' %}true{% else %}false{% endif %};

pageMeta.session_id = {{ convo.session.id|default('null') }};
{% if convo.person.id %}
pageMeta.viewPersonUrl = '{{ path('agent_people_view', {'person_id': convo.person.id}) }}';
pageMeta.person_id = {{ convo.person.id }};
{% elseif convo.session %}
pageMeta.viewPersonUrl = '{{ path('agent_people_viewsession', {'session_id': convo.session.id}) }}';
pageMeta.person_id = 0;
{% endif %}

{% if convo.person %}
	pageMeta.chatTitle = '{{ convo.person.display_name }} ({{ convo.person.primary_email_address }})';
{% else %}
	pageMeta.chatTitle = '{{ phrase('agent.general.anonymous') }}';
{% endif %}

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
<div class="userchat-page">

<header class="page-header">
    <h4 class="id-number">#{{ convo.id }}</h4>
    <h1>
		{% set chat_person_name %}
			{% if convo.person %}
				<a
					class="user-link as-popover preload"
					style="background-image: url('{{ convo.person.getPictureUrl(20) }}');"
					data-route="person:{{ path('agent_people_view', {'person_id': convo.person.id}) }}"
				>{{ convo.person.display_name }}</a> &lt;{{ convo.person.primary_email_address }}&gt;</a>
			{% else %}
                {% if convo.person_name or convo.person_email %}
                {% set convo_display_name %}
                    {{ convo.person_name }} {% if convo.person_email %} &lt;{{ convo.person_email }}&gt;{% endif %}
                {% endset %}
                {% else %}
                {% set convo_display_name = phrase('agent.general.anonymous') %}
                {% endif %}
				{% if convo.session %}<a
					class="as-popover"
					data-route="person:{{ path('agent_people_viewsession', {'session_id': convo.session.id}) }}"
				>{{convo_display_name}}</a>
                {% else %}
                    {{convo_display_name}}
                {% endif %}
			{% endif %}
		{% endset %}
		{{ phrase('agent.chat.chat_with_x', {'name': chat_person_name}) }}
	</h1>
    <div class="clear"></div>
    <div class="meta-line">
        <div class="category set-department" id="{{baseId}}_dep_btn" data-department-id="{{ convo.department.id|default(0) }}"><span>{{ phrase('agent.general.department') }}: <span class="label-department-id">{{ convo.department.full_title|default(phrase('agent.chat.no_department')) }}</span></span></div>
        <div class="clear"></div>
    </div>
</header>

<table cellspacing="0" cellpadding="0" width="100%"><tr><td class="col" valign="top" width="50%">
    <tr>
        <td width="50%" valign="top">
            <div class="profile-box-container people-box first">
                <header>
                    <h4>{{ phrase('agent.general.person') }}</h4>
                </header>
                <section id="{{baseId}}_people_box_person">
                    <article>
                        <dl>
                            <dt></dt>
                            <dd>
                                {% if convo.person %}
                                    <a class="user-link clean-white as-popover preload" data-route="person:{{ path('agent_people_view', {'person_id': convo.person.id}) }}">
                                        <span style="background-image: url('{{ convo.person.getPictureUrl(20) }}');">
                                            {{ convo.person.display_name }}
                                            <span class="email"><b class="pemail-{{convo.person.id}}" data-hide="@parent">{{ convo.person.email_address }}</b></span>
                                        </span>
                                    </a>
                                {% else %}
                                    {% set convo_display_user_box %}
                                        <span>
                                            {% if convo.person_name %}
                                                {{ convo.person_name }}
                                            {% else %}
                                                {{ phrase('agent.general.anonymous') }}
                                            {% endif %}
                                            <span class="email"><b data-hide="@parent">{% if convo.person_email %}{{ convo.person_email }}{% else %}{{ phrase('agent.chat.no_email') }}{% endif %}</b></span>
                                        </span>
                                    {% endset %}
                                    {% if convo.session %}
                                    <a class="user-link clean-white as-popover preload" data-route="person:{{ path('agent_people_viewsession', {'session_id': convo.session.id}) }}">
                                        {{ convo_display_user_box }}
                                    </a>
                                    {% else %}
                                        <a class="user-link clean-white">{{ convo_display_user_box }}</a>
                                    {% endif %}
                                {% endif %}
                                    <div class="clear"></div>
                            </dd>
                        </dl>
                    </article>
                </section>
            </div>
        </td>
        <td width="50%" valign="top">
			<div class="profile-box-container people-box second">
				<header>
					<div class="controls">
						<span class="edit-gear" id="{{baseId}}_assign_ob_trigger"></span>
					</div>
					<h4>{{ phrase('agent.general.assignments') }}</h4>
				</header>
				<section id="{{baseId}}_people_box_agent">
					<article>
						<dl>
							<dt class="agent-row">{{ phrase('agent.general.assigned_agent') }}</dt>
							<dd class="agent-row">
								<a class="agent-link prop-agent-id" id="{{baseId}}_assign_btn" data-agent-id="{{ convo.agent.id|default(0) }}" style="background-image: url('{{ convo.agent.getPictureUrl(20) }}');">{{ convo.agent.display_name|default('Unassigned') }}</a>
							</dd>

							<dt class="followers-row" {% if not agent_parts|length %}style="display:none"{% endif %}>{{ phrase('agent.chat.other_agents') }}</dt>
							<dd class="followers-row" {% if not agent_parts|length %}style="display:none"{% endif %}>
								<ul id="{{baseId}}_followers_list" class="comma-list">
									{% set has_others = false %}
									{% for part in convo.participants %}
										{% if not part.id == convo.id %}
											{% set has_others = true %}
											<li><span class="agent-link" data-agent-id="{{ part.id }}">{{ part.display_name }}</span></li>
										{% endif %}
									{% endfor %}
									{% if not has_others %}
										<li>{{ phrase('agent.chat.no_others') }}</li>
									{% endif %}
								</ul>
							</dd>
						</dl>
					</article>
				</section>
			</div>
        </td>
    </tr>
</table>

<div class="profile-box-container" id="{{ baseId }}_chat_view">
	<header>
		<h4>{{ phrase('agent.general.chat') }}</h4>
	</header>
	<section>
		<article id="{{baseId}}_chat" class="chat-tab">
			<div class="messages chat-transcript {% if convo.status == 'ended' %}chat-ended{% endif %}" id="{{baseId}}_messages_box">
				{% for message in convo_messages|reverse %}

					<div class="row {% if message.metadata.new_user_track %}user-track{% endif %} {% if message.is_sys %}sys{% elseif message.author.is_agent and message.author.id != convo.person.id %}agent{% else %}user{% endif%} message-{{ message.id }}">
						{% if message.is_sys %}
							<div class="message-content">
								<div class="message">
									{% if message.is_html %}
										{{message.content|raw}}
									{% else %}
										{{message.content}}
									{% endif %}
								</div>
								<time>{{ message.date_created|date('g:ia') }}</time>
							</div>
						{% elseif message.author.is_agent and message.author.id != convo.person.id %}
							<div class="message-content">
								<div class="chatSend">
									<div class="chatMsgSend">
										{% if message.is_html %}
											{{message.content|raw}}
										{% else %}
											{{message.content}}
										{% endif %}
										<span class="bubbleLeft"></span>
									</div>
								</div>
								<time>{{ message.date_created|date('g:ia') }}</time>
							</div>
						{% else %}
							<div class="message-content">
								<div class="chatRecieve">
									<div class="chatMsgRecieve">
										{% if message.is_html %}
											{{message.content|raw}}
										{% else %}
											{{message.content|safe_link_urls}}
										{% endif %}
										<span class="bubbleRight"></span>
									</div>
								</div>
								<time>{{ message.date_created|date('g:ia') }}</time>
							</div>
						{% endif %}
					</div>
				{% endfor %}
				<div id="{{baseId}}_uploading_list" class="uploading-list">
					<ul class="files"></ul>
				</div>
				<div class="row user-typing" style="display: none" id="{{baseId}}_user_typing">
					<div class="message-content">
						<div class="chatRecieve">
							<div class="chatMsgRecieve">
								<label>{{ phrase('agent.chat.user_typing') }}: </label>
								<div class="prop-msg"></div>
								<span class="bubbleRight"></span>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="chatreply" id="{{baseId}}_replybox" style="{% if convo.status != 'open' %}display: none{% endif %};">
				<div class="drop-file-zone"><h1>{{ phrase('agent.general.drop_here_to_attach') }}</h1></div>
				{% if convo.person and convo.person.id != session.person.id %}
					<div class="impersonation-warning" id="{{baseId}}_imposter">
						<strong>{{ phrase('agent.chat.warning') }}</strong>
						<p>{{ phrase('agent.chat.warning_email_address_not_unique') }}</p>
						<button class="clean-white small dismiss">{{ phrase('agent.general.dismiss') }}</button>
					</div>
				{% endif %}
				<nav>
					<ul class="option-buttons">
						<li class="tipped attach" title="{{ phrase('agent.general.attachments') }}">
							<input type="file" class="file" name="file-upload" />
							<span></span>
						</li>
						<li class="tipped snippets" id="{{baseId}}_quick_replies" title="{{ phrase('agent.chat.quick_replies') }}"><span></span></li>
						<li class="tipped ticket" id="{{baseId}}_create_ticket_btn" title="{{ phrase('agent.general.create_ticket') }}"><span></span></li>
					</ul>

					<ul class="option-buttons right">
						<li class="closetab tipped" id="{{baseId}}_end_btn" title="{{ phrase('agent.general.end_chat') }}"><span>{{ phrase('agent.general.send') }}</span></li>
						<li class="send" id="{{baseId}}_send_btn"><span>{{ phrase('agent.general.send') }}</span></li>
					</ul>
				</nav>
				<div class="input-wrap">
					<textarea placeholder="" id="{{baseId}}_replybox_txt" name="message"></textarea>
				</div>
			</div>
		</article>
	</section>
</div>

{% include 'AgentBundle:Common:attach-row-tmpl.html.twig' with {formname: 'attach[]'} %}

<div class="optionbox reply-agent-team-ob with-footer" id="{{baseId}}_agent_assign_ob" data-assigned="{{ convo.agent.id|default('0') }}">
	<header>
		<h4>{{ phrase('agent.general.assignments') }}</h4>
		<span class="close close-trigger"></span>
	</header>
	<div class="col">
		<section data-section-name="agents">
			<header>
				<h3>{{ phrase('agent.general.assign_to') }}</h3>
				<input type="text" class="filter-box" placeholder="{{ phrase('agent.general.filter') }}" />
			</header>
			<ul>
				<li class="me last-me {% if convo.agent.id == app.user.id %}on{% endif %}">
					<input type="radio" name="{{baseId}}_agent" value="{{ app.user.id }}" {% if convo.agent.id == app.user.id %}checked="checked"{% endif %} />
					<label><span class="agent-pic agent-label-{{ app.user.id }}" style="background-image: url({{ app.user.getPictureUrl(16) }})">{{ phrase('agent.general.me') }}</span></label>
				</li>

				<li>
					<input type="radio" name="{{baseId}}_agent" value="0" {% if not convo.agent %}checked="checked"{% endif %}  />
					<label><span class="agent-pic agent-label-0">{{ phrase('agent.general.unassigned') }}</span></label>
				</li>

				{% for agent in agents %}
				{% if agent.id != app.user.id %}
				<li {% if convo.agent.id == agent.id %}class="on"{% endif %}>
					<input type="radio" name="{{baseId}}_agent" value="{{ agent.id }}" {% if convo.agent.id == agent.id %}checked="checked"{% endif %} />
					<label><span class="agent-pic agent-label-{{ agent.id }}" style="background-image: url({{ agent.getPictureUrl(16) }})">{{ agent.display_name }}</span></label>
					<div class="bound-fade"></div>
				</li>
				{% endif %}
				{% endfor %}
			</ul>
		</section>
	</div>

	<div class="col">
		<section data-section-name="followers">
			<header>
				<h3>{{ phrase('agent.chat.invite_others') }}</h3>
				<input type="text" class="filter-box" placeholder="{{ phrase('agent.general.filter') }}" />
			</header>
			<ul>
				<li class="me last-me">
					<input type="checkbox" name="{{bsaeId}}_part" value="{{ app.user.id }}" {% if app.user.id in participant_ids and convo.agent.id != app.user.id %}checked="checked"{% endif %} />
					<label><span class="agent-pic agent-part-label-{{ app.user.id }}" style="background-image: url({{ app.user.getPictureUrl(16) }})">{{ phrase('agent.general.me') }}</span></label>
				</li>

				{% for agent in agents %}
				{% if agent.id != app.user.id %}
				<li {% if convo.participants[agent.id] and convo.agent.id != agent.id %}class="on"{% endif %}>
					<input type="checkbox" name="{{bsaeId}}_part" value="{{ agent.id }}" {% if convo.participants[agent.id] and convo.agent.id != agent.id %}checked="checked"{% endif %} />
					<label><span class="agent-pic agent-part-label-{{ agent.id }}" style="background-image: url({{ agent.getPictureUrl(16) }})">{{ agent.display_name }}</span></label>
					<div class="bound-fade"></div>
				</li>
				{% endif %}
				{% endfor %}
			</ul>
		</section>
	</div>
	<br class="clear" />
	<footer>
		<button class="save-trigger">{{ phrase('agent.general.apply') }}</button>
	</footer>
</div>

<div id="{{baseId}}_closetab_prompt" style="display:none;">
	<div class="confirm-overlay mass-actions-overlay">
		<div class="overlay-title">
			<h4>{{ phrase('agent.chat.title_leave_chat_prompt') }}</h4>
		</div>
		<div class="overlay-content">
			{{ phrase('agent.chat.leave_chat_confirm') }}
		</div>
	</div>
	<div class="overlay-footer prop-footer">
		<button class="clean-white unassign-trigger">{{ phrase('agent.chat.leave_unassign') }}</button>
		<button class="clean-white end-trigger">{{ phrase('agent.chat.leave_end') }}</button>
	</div>
</div>

</div>
