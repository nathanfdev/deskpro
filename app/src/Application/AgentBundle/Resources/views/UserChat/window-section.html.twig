{% macro dep_row(dep, dep_counts, depth) %}
	<li class="is-nav-item {% if depth %} sub-item with-elbow{% endif %}" {% if not dep_counts[dep.id ~ '_total'] %}style="display: none"{% endif %}>
		{% if depth %}
			<span class="elbow">|</span>
		{% endif %}
		<span class="title" data-route="listpane:{{ path('agent_userchat_list_new', {'department_id':dep.id}) }}">
			<span class="list-counter" {% if depth %}data-parentid="{{ dep.getParentId() }}"{% endif %}  id="userchat_deplist_{{ dep.id }}_counter" data-count="{{ dep_counts[dep.id ~ '_total']|default(0) }}">{{ dep_counts[dep.id ~ '_total']|default(0) }}</span>
			{{ dep.title }}
		</span>
	</li>
	{% if dep.children|length %}
		{% for subdep in dep.children %}
			{{ _self.dep_row(subdep, dep_counts, depth+1) }}
		{% endfor %}
	{% endif %}
{% endmacro %}

<section class="source-section">
	<header>
		<h1>{{ phrase('agent.chat.title_open') }}</h1>
	</header>
	<article>
		<ul class="source-list">
			{# New Chats #}
			<li id="userchat_deplist_all">
				<h3 class="title is-nav-item" data-route="listpane:{{ path('agent_userchat_list_new', {'department_id': -1}) }}">
					<span class="list-counter" id="userchat_deplist_0_counter" data-count="{{ dep_counts['0_total']|default(0) }}">{{ dep_counts['0_total']|default(0) }}</span>
					{{ phrase('agent.chat.title_new_chats') }}
				</h3>
				{% if not single_dep_mode %}
				<ul class="sub-group {% if dep_counts['0_total'] %}show{% endif %}">
					{% for dep in departments %}
						{{ _self.dep_row(dep, dep_counts, 0) }}
					{% endfor %}
				</ul>
				{% endif %}
			</li>

			<li>
				<h3 class="title is-nav-item" data-route="listpane:{{ path('agent_userchat_list_active', {'agent_id': app.user.id}) }}">
					<span class="list-counter" id="userchat_list_{{ app.user.id }}_counter">{{ counts[app.user.id]|default(0) }}</span>
					{{ phrase('agent.chat.my_open_chats') }}
				</h3>
			</li>

			{# Active Chats #}
			<li id="userchat_list_all">
				<h3 class="title is-nav-item" data-route="listpane:{{ path('agent_userchat_list_active', {'agent_id': -1}) }}">
					<span class="list-counter" id="userchat_list_allagents_counter" data-count="{{ counts.active|default(0) }}">{{ counts.active|default(0) }}</span>
					{{ phrase('agent.chat.title_active_chats') }}
				</h3>
				<ul class="sub-group show">
					{% for agent_id,agent_name in agent_names %}
						{% if agent_id != app.user.id %}
							<li class="" {% if not counts[agent_id] %}style="display: none"{% endif %} id="userchat_list_{{ agent_id }}">
								<span class="title" data-route="listpane:{{ path('agent_userchat_list_active', {'agent_id': agent_id}) }}">
									<span class="list-counter" id="userchat_list_{{ agent_id }}_counter">{{ counts[agent_id]|default(0) }}</span>
									{{ agent_name }}
								</span>
							</li>
						{% endif %}
					{% endfor %}
				</ul>
			</li>
		</ul>
	</article>
</section>

<section id="chat_filter_container" class="source-section sys-filters-section">
	<header>
		<h1>{{ phrase('agent.chat.title_ended') }}</h1>
		<span id="chat_filter_launch_editor" class="settings"></span>
	</header>
	<article id="chats_system_filters_wrap">
		<ul id="chats_outline_sys_filters" class="source-list">
			{% for filter in ended_filters %}
			<li class="filter filter-{{ filter.id }} nav-filter-{{filter.id}} {% if loop.index == 1 %}active{% endif %}"
				data-filter-id="{{filter.id}}"
				data-filter-name="{{filter.sys_name}}"
				data-grouping-ignore="{{ filter.disallowed }}"
			>
				<h3 class="is-nav-item title" data-route="listpane:{{ path('agent_userchat_filterlist', { 'filter_id': filter.id}) }}">
					<span class="list-counter" id="userchat_{{filter.id}}_count" data-count="{{ filter.count }}">{{ filter.count }}</span>
					{{ filter.title }}
				</h3>
				<ul class="sub-group" style="display: none;"></ul>
			</li>
			{% endfor %}
		</ul>
	</article>
</section>

<section class="source-section">
	<header>
		<h1>Labels</h1>
	</header>
	<article>
		<section class="source-switcher-tabs spaced" id="chat_outline_labels_switcher" {% if not labels_index|length %}style="display: none"{% endif %} data-element-handler="DeskPRO.ElementHandler.SimpleTabs">
			<ul>
				<li data-tab-for="#userchat_labels_list" class="list on">{{ phrase('agent.general.labels_list') }}</li>
				<li data-tab-for="#userchat_labels_cloud" class="cloud">{{ phrase('agent.general.labels_cloud') }}</li>
			</ul>
		</section>

		<section class="source-labels-list" id="userchat_labels_list">
			{% if labels_index|length %}
				<dl>
					{% for letter,labels in labels_index %}
						<dt>{{ letter }}</dt>
						<dd>
							<ul>
								{% for label in labels %}
									<li class="nav-label-{{label|slugify}}" data-route="listpane:{{ path('agent_userchat_filterlist', {filter_id: 'label', filter_param: label}) }}"><span>{{label}}</span></li>
								{% endfor %}
							</ul>
						</dd>
					{% endfor %}
				</dl>
			{% else %}
			<aside class="source-info-explain">{{ phrase('agent.general.no_chat_labels') }}</aside>
			{% endif %}
		</section>
		<section class="source-labels-cloud" id="userchat_labels_cloud" style="display: none;">
			{% if labels_cloud|length %}
				<ul>
					{% for label,css_class in labels_cloud %}
						<li class="{{css_class}} nav-label-{{label|slugify}}" data-route="listpane:{{ path('agent_userchat_filterlist', {filter_id: 'label', filter_param: label}) }}"><span>{{label}}</span></li>
					{% endfor %}
				</ul>
			{% else %}
			<aside class="source-info-explain">{{ phrase('agent.general.no_chat_labels') }}</aside>
			{% endif %}
		</section>
	</article>
</section>

<section id="chat_filter_group_editor">
	<section class="filter-group-editor">
		<span class="close"></span>
		<script type="text/x-deskpro-plain" class="editor-row-tpl">
			<div class="filter-row">
				<div class="field-wrap"></div>
			</div>
		</script>
		<script type="text/x-deskpro-plain" class="editor-fields-tpl">
			<select>
				{% for group in ended_groups %}
				<option value="{{ group.id }}">{{ phrase('agent.general.group_by') }} {{ group.title }}</option>
				{% endfor %}
			</select>
		</script>
	</section>
</section>
