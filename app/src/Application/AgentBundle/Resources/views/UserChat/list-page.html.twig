<section class="search-reuslts page-set" data-page="{{ page }}">
	{% for convo in chats%}
		<article
			class="row-item convo-{{ convo.id }} without-selection"
			data-convo-id="{{ convo.id }}"
			data-route="page:{{ path('agent_userchat_view', {'conversation_id': convo.id}) }}" data-route-title="@selector(a.subject)" data-route-openclass="open">
			<div class="top-row">
				<div class="top-row-left">
					<h3>
						<a class="subject click-through">
							{{ convo.subjectLine }}
						</a>
					</h3>
				</div>
			</div>
			<div class="userinfo general">
                {{ phrase('agent.userchat.by_name', {{'name':convo.person}}) }}
					<a class="name click-through"
					 data-route="person:{{ path('agent_people_view', {'person_id': convo.person.id|default('0')}) }}" data-route-title="@selector(.person-tip)">
					<span class="person-name-picture" style="background-image: url({{ convo.person.getPictureUrl(15) }})">{{ convo.person.display_name }}</span></a>
					{% if convo.person.email_address %}<span class="convo.person-email">&lt;{{ convo.person.email_address }}&gt;</span>{% endif %},
				{% elseif convo.person_name or convo.person_email %}
					{{ convo.person_name }} {% if convo.person_email %} &lt;{{ convo.person_email }}&gt;{% endif %},
				{% else %}
					{{ phrase('agent.anonymous') }},
				{% endif %}
				<time class="timeago" datetime="{{ convo.date_created|date('c') }}">{{ convo.date_created|date('day_short') }}</time>
			</div>
		</article>
	{% endfor %}
</section>
