{% import 'AgentBundle:Common:agent-macros.html.twig' as agentui %}
<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.UserChatFilter';
pageMeta.fetchResultsUrl = '{{ path('agent_userchat_filterlist_page', {'filter_id': filter_id}) }}';

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';

pageMeta.perPage = 50;
pageMeta.resultIds = {{ chat_ids|json_encode|raw }};
</script>
{{ agentui.scroll_containers('page-chat-list') }}

{% if chat_ids|length %}
	<section class="list-listing">
		{% include 'AgentBundle:UserChat:list-page.html.twig' %}
	</section>

	<footer class="results-nav">
		<div class="cursor">
            {% set phrase_part1 %}
            <span class="results-showing-count" id="{{baseId}}_showing_count">{{ (page-1) * 50 + 1 }} - {{ (page - 1) * 50 + chat_ids|length }}</span>
            {% endset %}
            {% set phrase_part2 %}
            <span class="results-total-count" id="{{baseId}}_total_count">{{ total }}</span>
            {% endset %}
            {{ phrase('agent.organization.showing_results_of_size', {'count':total,'display_count':phrase_part1,'size':phrase_part2}) }}
		</div>
		{% if max_page != 1 %}
		<ul class="pagenav {% if page == 1%}no-prev{% endif %} {% if page == max_page %}no-next{% endif %}">
			<li class="prev"
			{% if page != 1%}
			data-route="listpane:{{ path('agent_userchat_filterlist_page', {'p': page - 1, 'filter_id': filter_id, 'group_var': group_var, 'group_val': group_val}) }}"
			{% endif %}
			>
			</li>
			<li class="next"
			{% if page != max_page %}
			data-route="listpane:{{ path('agent_userchat_filterlist_page', {'p': page + 1, 'filter_id': filter_id, 'group_var': group_var, 'group_val': group_val}) }}"
			{% endif %}
			>
			</li>
		</ul>
		{% endif %}
		<div class="loading">

		</div>
	</footer>
{% else %}
	<section class="list-listing no-results">
		<article class="row-item no-results">
			<p style="padding: 15px;">{{ phrase('global.there_are_no_results') }}</p>
		</article>
	</section>
{% endif %}

{{ agentui.scroll_containers_end() }}
