<div class="data-display-table-wrap">
	<div class="table-head">
		<em class="reload-table-btn">Refresh list</em>
		<span class="count-online-users">{{ visitors|length }}</span> Online Users
	</div>
	<div style="max-height: 600px; overflow: auto">
		<table cellspacing="0" cellpadding="0" width="100%" class="data-display-table with-head">
			<tbody style="max-height: 600px; overflow: auto">
				<tr>
					<th class="col-head">User</th>
					<th class="col-head">Current Page</th>
					<th class="col-head" width="10">Time</th>
					{#<th class="col-head" width="10">&nbsp;</th>#}
					<th class="col-head" width="10">&nbsp;</th>
				</tr>
				{% for vis in visitors %}
					<tr>
						<td>
							<div style="width: 130px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;">
								<span {% if vis.visit_track.geo_country %}class="with-country" style="background-image: url({{ asset('images/flags/' ~ vis.visit_track.geo_country|lower ~ '.png') }});" title="{{ vis.visit_track.geo_country }}" {% endif %}>
									{% if vis.person %}
										{{ vis.person.getDisplayName() }}
									{% else %}
										Anon {{ vis.visit_track.ip_address }}
									{% endif %}
								</span>
							</div>
						</td>
						<td>
							<div style="width: 250px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;">
								<a href="{{ vis.last_track.page_url }}" target="_blank">
									{{ vis.last_track.page_url|url_trim_scheme(true) }}
								</a>
							</div>
						</td>
						<td nowrap="nowrap" width="10">{{ vis.date_last|date('time') }}</td>
						{#<td style="padding-right: 0px;"><button class="clean-white">Start Chat</button></td>#}
						<td><em class="details-link" title="View details" data-route="page:{{ path('agent_usertrack_view', {visitor_id: vis.id}) }}"></em></td>
					</tr>
				{% else %}
					<tr>
						<td colspan="100" style="text-align: center">
							There are no online users.
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
</div>