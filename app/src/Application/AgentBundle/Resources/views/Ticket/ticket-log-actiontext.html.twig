{% if log.action_type == 'free' %}
	{{ log.details.message }}
{% elseif log.action_type == 'changed_agent' %}
	<span class="type">Assigned agent</span> changed from
	<span class="old-val">{{log.details.old_agent_name|default(phrase('agent.unassigned'))}}</span>
	to <span class="new-val">{{log.details.new_agent_name|default(phrase('agent.unassigned'))}}</span>
{% elseif log.action_type == 'participant_added' %}
	<span class="type">{{ phrase('agent.ticket.participant_added') }}</span>: <span class="new-val">{{log.details.name}}</span>
{% elseif log.action_type == 'participant_removed' %}
	<span class="type">{{ phrase('agent.ticket.participant_removed') }}</span>: <span class="old-val">{{log.details.name}}</span>
{% elseif log.action_type == 'ticket_created' %}
	Ticket <span class="new-val">#{{log.details.ticket_id}}</span> created
{% elseif log.action_type == 'subject' %}
	Subject changed from <span class="old-val">{{ log.details.old_subject }}</span> to <span class="new-val">{{ log.details.new_subject }}</span>
{% elseif log.action_type == 'ticket_split' %}
	Ticket split from <span class="old-val">#{{log.details.from_ticket_id}}</span>
{% elseif log.action_type == 'merged' %}
	Ticket <span class="old-val">#{{log.id_before}}</span> merged into this
{% elseif log.action_type == 'merged_message' %}
	Message <span class="old-val">#{{log.details.message_id}}</span> into this from ticket #{{log.details.old_ticket_id}}
{% elseif log.action_type == 'merged_attach' %}
	Attachment <span class="old-val">#{{log.id_object}}</span> into this from ticket #{{log.id_before}}
{% elseif log.action_type == 'changed_category' %}
	<span class="type">{{ phrase('agent.ticket.category') }}</span> changed from
	<span class="old-val">{{log.details.old_category_title|default('None')}}</span> to <span class="new-val">{{log.details.new_category_title|default('None')}}</span>
{% elseif log.action_type == 'changed_department' %}
	<span class="type">{{ phrase('agent.ticket.department') }}</span> changed from
	<span class="old-val">{{log.details.old_department_title|default('None')}}</span> to <span class="new-val">{{log.details.new_department_title|default('None')}}</span>
{% elseif log.action_type == 'changed_organization' %}
	<span class="type">{{ phrase('agent.ticket.organization') }}</span> changed from
	<span class="old-val">{{log.details.old_org_name|default('None')}}</span> to <span class="new-val">{{log.details.new_org_name|default('None')}}</span>
{% elseif log.action_type == 'changed_person' %}
	<span class="type">{{ phrase('agent.ticket.user_owner') }}</span> changed from
	<span class="old-val">#{{log.details.old_person_id}} {{old_person_name}}</span> to <span class="new-val">#{{log.details.new_person_id}} {{new_person_name}}</span>
{% elseif log.action_type == 'executed_triggers' %}
	<span class="type">{{ phrase('agent.ticket.ticket_triggers') }}</span> applied:
	<span class="new-val">{{ log.details.trigger_ids }}</span>
{% elseif log.action_type == 'message_created' %}
	<span class="type">{{ phrase('agent.ticket.new_message') }}</span> {% if log.details.message_id %}<span class="new-val">#{{log.details.message_id}}</span>{% endif %}
	{% if log.details.ip_address %}
	from web ({{ log.details.ip_address }})
	{% endif %}
	{% if log.details.email %}
	from email ({{ log.details.email }})
	{% endif %}
{% elseif log.action_type == 'message_removed' %}
	<span class="type">{{ phrase('agent.ticket.message_deleted') }}</span> <span class="old-val">#{{log.id_before}}</span>
{% elseif log.action_type == 'changed_priority' %}
	<span class="type">{{ phrase('agent.ticket.priority') }}</span> changed from
	<span class="old-val">{{log.details.old_priority_title|default('None')}}</span> to <span class="new-val">{{log.details.new_priority_title|default('None')}}</span>
{% elseif log.action_type == 'changed_workflow' %}
	<span class="type">{{ phrase('agent.ticket.workflow') }}</span> changed from
	<span class="old-val">{{log.details.old_workflow_title|default('None')}}</span> to <span class="new-val">{{log.details.new_workflow_title|default('None')}}</span>
{% elseif log.action_type == 'changed_urgency' %}
	<span class="type">{{ phrase('agent.ticket.urgency') }}</span> changed from
	<span class="old-val">{{log.details.old_urgency}}</span> to <span class="new-val">{{log.details.new_urgency}}</span>
{% elseif log.action_type == 'changed_product' %}
	<span class="type">{{ phrase('agent.ticket.product') }}</span> changed from
	<span class="old-val">{{log.details.old_product_title|default('None')}}</span> to <span class="new-val">{{log.details.new_product_title|default('None')}}</span>
{% elseif log.action_type == 'attach_added' %}
	<span class="type">{{ phrase('agent.ticket.new_attachment') }}</span> <span class="new-val">#{{log.details.attach_id}} {{ log.details.filename }}</span>
{% elseif log.action_type == 'attach_removed' %}
	<span class="type">{{ phrase('agent.ticket.attachment_deleted') }}</span> <span class="old-val">#{{log.details.old_attach_id}} {{ log.details.filename }}</span>
{% elseif log.action_type == 'changed_status' %}
	<span class="type">{{ phrase('agent.ticket.status') }}</span> changed from
	<span class="old-val">{{ phrase( 'agent.tickets.status_' ~ log.details.old_status) }}</span> to <span class="new-val">{{ phrase( 'agent.tickets.status_' ~ log.details.new_status) }}</span>
{% elseif log.action_type == 'changed_custom_field' %}
	<span class="type">{{ log.details.field_name }}</span> changed from
	<span class="old-val">{{ log.details.value_before|default('(no value)') }}</span> to <span class="new-val">{{ log.details.value_after|default('(no value)') }}</span>
{% elseif log.action_type == 'agent_notify' %}
	<span class="new-val expand">{{ log.details.who_emailed|length }} agents</span> notified of

	{% if log.details.type == 'newticket'%}new ticket
	{% elseif log.details.type == 'newreply' %}new reply
	{% else %}{{ log.details.type }}
	{% endif %}

	<div class="expand-set" style="display: none">
		<ul>
			{% for info in log.details.who_emailed %}
				<li>
					{% if not info.person_name or info.person_name == info.person_email %}
						{{ info.person_email }}
					{% else %}
						{{ info.person_name }} &lt;{{ info.person_email }}&gt;
					{% endif %}
				</li>
			{% endfor %}
		</ul>
	</div>
{% elseif log.action_type == 'user_notify' %}
	<span class="new-val expand" data-set=".set-emailed">{{ log.details.who_emailed|length }} users</span> notified of

	{% if log.details.type == 'newticket' %}new ticket
	{% elseif log.details.type == 'newreply' %}new reply
	{% else %}{{ log.details.type }}
	{% endif %}

	{% if log.details.who_cced|length %}
		(and <span class="new-val expand" data-set=".set-cced">{{ log.details.who_cced|length }} users</span> were CC'ed)
	{% endif %}

	<div class="expand-set set-emailed" style="display: none">
		<ul>
			{% for info in log.details.who_emailed %}
				<li>
					{% if not info.person_name or info.person_name == info.person_email %}
						{{ info.person_email }}
					{% else %}
						{{ info.person_name }} &lt;{{ info.person_email }}&gt;
					{% endif %}
				</li>
			{% endfor %}
		</ul>
	</div>
	<div class="expand-set set-cced" style="display: none">
		<ul>
			{% for info in log.details.who_cced %}
				<li>
					{% if not info.person_name or info.person_name == info.person_email %}
						{{ info.person_email }}
					{% else %}
						{{ info.person_name }} &lt;{{ info.person_email }}&gt;
					{% endif %}
				</li>
			{% endfor %}
		</ul>
	</div>
{% elseif hide_unknow%}
	{{ log.action_type }}
{% endif %}
