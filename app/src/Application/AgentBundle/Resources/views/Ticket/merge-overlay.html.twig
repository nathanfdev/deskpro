<div class="ticket-merge overlay">
	<div class="overlay-title">
		<h4>{{ phrase('agent.merge_x_into', {{'name': ticket.subject}}) }}</h4>
	</div>

	<div class="overlay-content">
		{% if not open_tickets and not tickets_by_user %}
			<div class="group">
				<ul>
					<li>
						{{ phrase('agent.tickets.merge_none') }}
					</li>
				</ul>
			</div>
		{% endif %}

		{% if open_tickets %}
		<div class="table-result-list">
			<table width="100%" cellspacing="0">
				<thead>
					<tr>
						<th colspan="2">{{ phrase('agent.tickets.other_open_tickets') }}</th>
					</tr>
				</thead>
				<tbody>
					{% for ticket in open_tickets %}
						<tr>
							<td style="width: auto"><a data-route="ticket:{{ path('agent_ticket_view', {'ticket_id': ticket.id}) }}" class="with-route">{{ ticket.subject }}</a></td>
							<td width="20" style="text-align: right"><button class="clean-white small merge-trigger" data-ticket-id="{{ ticket.id }}">{{ phrase('agent.merge') }}</button></td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
		{% endif %}

		{% if tickets_by_user %}
		<div class="table-result-list">
			<table width="100%" cellspacing="0">
				<thead>
					<tr>
						<th colspan="2">{{ phrase('agent.tickets.ticket_by_user') }}</th>
					</tr>
				</thead>
				<tbody>
					{% for ticket in tickets_by_user %}
						<tr>
							<td style="width: auto"><a data-route="ticket:{{ path('agent_ticket_view', {'ticket_id': ticket.id}) }}" class="with-route">{{ ticket.subject }}</a></td>
							<td width="20" style="text-align: right"><button class="clean-white small merge-trigger" data-ticket-id="{{ ticket.id }}">{{ phrase('agent.merge') }}</button></td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
		{% endif %}
	</div>
</div>
