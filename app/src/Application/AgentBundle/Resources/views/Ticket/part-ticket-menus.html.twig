<ul class="ticket-message-edit-menu" style="display:none">
	<li data-option-id="view-details">{{ phrase('agent.general.detail') }}</li>
	<li data-option-id="quote">{{ phrase('agent.general.quote') }}</li>
	<li class="set-as-note" data-option-id="setnote.note">Set as agent note</li>
	<li class="set-as-message" data-option-id="setnote.message">Set as normal message</li>
	{% if ticket_perms.modify_merge %}<li data-option-id="split">Split to new ticket</li>{% endif %}
	<li data-option-id="edit">Edit</li>
	{#<li data-option-id="split">{{ phrase('agent.tickets.split_from_here') }}</li>#}
</ul>
<ul class="ticket-macros-menu" style="display:none" {% if baseId %}id="{{baseId}}_macros_menu"{% endif %}>
	<li class="open-settings-trigger">Create Macros</li>
	{% for macro in macros %}
		<li data-macro-id="{{macro.id}}">{{macro.title}}</li>
	{% endfor %}
</ul>

<div class="delete-ticket-overlay overlay" style="display:none">
	<div class="overlay-title">
		<h4>{{ phrase('agent.general.ucfirst_delete') }}</h4>
	</div>

	<div class="overlay-content">
		{{ phrase('agent.general.deleted_reason') }}: <input type="text" value="" class="delete-reason" style="width: 200px;" />

		{% if person_object_counts.tickets > 1 or person_object_counts.chats %}
		<div id="{{ baseId }}_delete_user_list" style="display: none;">
			<br/>
			Deleting the user will also delete their other related content:<br />
			&bull; {{ person_object_counts.tickets }} Tickets<br/>
			{% if person_object_counts.chats %}&bull; {{ person_object_counts.chats }} Chats<br/>{% endif %}
		</div>
		{% endif %}
	</div>

	<div class="overlay-footer">
		<div class="loading-off">
			<button class="save-trigger clean-white">{{ phrase('agent.general.ucfirst_delete') }}</button>
		</div>
		<div class="loading-on" style="display:none">
			<span>{{ phrase('agent.general.saving') }}... <span class="flat-spinner"></span></span>
		</div>
	</div>
</div>
