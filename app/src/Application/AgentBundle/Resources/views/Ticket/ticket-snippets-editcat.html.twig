<div style="width: 360px; height: 250px; display: none;">
	<div class="overlay-title">
		<span class="close-overlay"></span>
		<h4>{{ phrase('agent.ticket.edit_snippet_category') }}</h4>
	</div>
	<div class="overlay-content">
		<input type="hidden" name="category_id" value="{{ category.id }}" />
		<dl class="generic-form-list">
			<dt>{{ phrase('global.title') }}:</dt>
			<dd><input type="text" name="title" value="{{ category.title }}" /></dd>

			<dt>{{ phrase('agent.ticket.permissions') }}:</dt>
			<dd>
				<label><input type="radio" class="perm-type-opt" name="perm_type" value="me" {% if category.getPermType() == 'me' %}checked="checked"{% endif %} /> {{ phrase('agent.ticket.just_me') }}</label><br />
				{% if app.getSetting('core.use_agent_team') %}<label><input type="radio" class="perm-type-opt" name="perm_type" value="team" {% if category.getPermType() == 'team' %}checked="checked"{% endif %} /> {{ phrase('agent.ticket.my_team') }}</label><br />{% endif %}
				<label><input type="radio" class="perm-type-opt" name="perm_type" value="global" {% if category.getPermType() == 'global' %}checked="checked"{% endif %} /> {{ phrase('agent.ticket.everyone') }}</label><br />
			</dd>

			<dt class="perm-teams" style="display: none">{{ phrase('global.teams') }}:</dt>
			<dd class="perm-teams" style="display: none">
				<select name="teams[]" multiple="multiple" size="6">
					{% for team in agent_teams %}
						<option value="{{ team.id }}">{{ team.name }}</option>
					{% endfor %}
				</select>
			</dd>
		</dl>
	</div>
	<div class="overlay-footer">
		<div class="is-not-loading">
			<button class="clean-white small save-trigger">{{ phrase('global.save') }}</button>
		<button class="clean-white small delete-trigger">{{ phrase('agent.delete') }}</button>
		</div>
		<div class="is-loading">
			<img src="{{ asset('images/spinners/loading-small-flat.gif') }}" />
		<?div>
	</div>
</div>
