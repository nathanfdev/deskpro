<div style="width: 360px; height: 280px; display: none;">
	<div class="overlay-title">
		<span class="close-overlay"></span>
		<h4>{{ phrase('agent.tickets.edit_snippet_category') }}</h4>
	</div>

	<div class="overlay-content">
		<div class="overlay-content-block" style="text-align: center">
			<div class="is-not-loading">
				<button class="clean-white small delete-trigger" data-confirm="Are you sure you want to delete this category? All snippets within will be deleted.">{{ phrase('agent.general.delete') }}</button>
			</div>
			<div class="is-loading">
				<img src="{{ asset('images/spinners/loading-small-flat.gif') }}" />
			</div>
		</div>

		<form>
			<dl class="generic-form-list">
				<dt>{{ phrase('agent.general.title') }}:</dt>
				<dd><input type="text" name="title" value="{{ category.title }}" /></dd>

				{% if category.person.id == app.user.id %}
					<dt>{{ phrase('agent.general.permissions') }}:</dt>
					<dd>
						<label><input type="radio" class="perm-type-opt" name="perm_type" value="me" {% if category.getPermType() == 'me' %}checked="checked"{% endif %} /> {{ phrase('agent.general.just_me') }}</label><br />
						<label><input type="radio" class="perm-type-opt" name="perm_type" value="global" {% if category.getPermType() == 'global' %}checked="checked"{% endif %} /> {{ phrase('agent.general.usergroup_everyone') }}</label><br />
					</dd>
				{% endif %}

				<dt class="perm-teams" style="display: none">{{ phrase('agent.general.teams') }}:</dt>
				<dd class="perm-teams" style="display: none">
					<select name="teams[]" multiple="multiple" size="6">
						{% for team in agent_teams %}
							<option value="{{ team.id }}">{{ team.name }}</option>
						{% endfor %}
					</select>
				</dd>
			</dl>
		</form>

		<input type="hidden" name="category_id" value="{{ category.id }}" />

	</div>
	<div class="overlay-footer">
		<div class="is-not-loading">
			<button class="clean-white small save-trigger">{{ phrase('agent.general.save') }}</button>
		</div>
		<div class="is-loading">
			<img src="{{ asset('images/spinners/loading-small-flat.gif') }}" />
		</div>
	</div>
</div>
