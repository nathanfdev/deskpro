{% import 'AgentBundle:Common:agent-macros.html.twig' as layout %}
<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Basic';
pageMeta.title = 'Ticket Deleted';
</script>
{{ layout.scroll_containers('profile') }}
<div class="{% if not perms.edit %}perm-no-edit{% endif %} {% if not perms.delete %}perm-no-delete{% endif %}">

<div class="ticket-hidden-bar deleted">
	<article>
		{% if delete_log.new_ticket_id %}
			Ticket #{{ delete_log.ticket_id }} was merged into #{{ delete_log.new_ticket_id }} on {{ delete_log.date_created|date('fulltime') }} by {% if delete_log.by_person %}{{ delete_log.by_person.getDisplayContact() }}{% else %} an unknown agent.{% endif %}

			<br />

			<a class="clean-white" data-route="ticket:{{ path('agent_ticket_view', {ticket_id: delete_log.new_ticket_id}) }}">View ticket #{{ delete_log.new_ticket_id }}</a>
		{% else %}
			Ticket #{{ delete_log.ticket_id }} was deleted on {{ delete_log.date_created|date('fulltime') }} by
			{% if delete_log.by_person %}{{ delete_log.by_person.getDisplayContact() }}{% else %} an unknown agent.{% endif %}
			{% if delete_log.reason %}
				<br /><br />
				Reason: {{ delete_log.reason }}
			{% endif %}
		{% endif %}
	</article>
</div>

</div>
{{ layout.scroll_containers_end() }}