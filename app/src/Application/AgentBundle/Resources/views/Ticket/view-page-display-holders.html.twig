<div class="page-display-holders" style="display:none">
	{# Standard fields #}
	{% if app.getSetting('core.use_ticket_category') %}
	<div class="ticket_category category_id standard-field item {% if not ticket.category %}no-value{% endif %}" data-item-type="ticket_category">
		<div class="title">
			<span class="menu-trigger category_id label">{{ phrase('agent.global.category') }}:</span>
		</div>
		<div class="content">
			<span class="prop-val menu-trigger category_id">{{ticket.category.full_title|default(phrase('agent.global.none'))}}</span>
		</div>
	</div>
	{% endif %}
	{% if app.getSetting('core.use_product') %}
	<div class="ticket_product product_id standard-field item {% if not ticket.product %}no-value{% endif %}" data-item-type="ticket_product">
		<div class="title">
			<span class="menu-trigger product_id label">{{ phrase('agent.global.product') }}:</span>
		</div>
		<div class="content">
			<span class="prop-val menu-trigger product_id">{{ticket.product.full_title|default(phrase('agent.global.none'))}}</span>
		</div>
	</div>
	{% endif %}
	{% if app.getSetting('core.use_ticket_priority') %}
	<div class="ticket_priority priority_id standard-field item {% if not ticket.priority %}no-value{% endif %}" data-item-type="ticket_priority">
		<div class="title">
			<span class="menu-trigger priority_id label">{{ phrase('agent.global.priority') }}:</span>
		</div>
		<div class="content">
			<span class="prop-val menu-trigger priority_id">{{ticket.priority.title|default(phrase('agent.global.none'))}}</span>
		</div>
	</div>
	{% endif %}
	{% if app.getSetting('core.use_ticket_workflow') %}
	<div class="ticket_workflow workflow_id standard-field item {% if not ticket.workflow %}no-value{% endif %}" data-item-type="ticket_workflow">
		<div class="title">
			<span class="menu-trigger workflow_id label">{{ phrase('agent.global.workflow') }}:</span>
		</div>
		<div class="content">
			<span class="prop-val menu-trigger workflow_id">{{ticket.workflow.title|default(phrase('agent.global.none'))}}</span>
		</div>
	</div>
	{% endif %}

	{# Custom fields#}
	{% for f in custom_fields %}
		<div class="ticket_field_{{f.id}} custom-field item {% if f.field_def.isFormField() and not ticket.hasCustomField(f.id) %}no-value{% endif %}" data-field-type="ticket_field" data-item-id="{{f.id}}" data-custom-field-handler="{{f.field_handler}}">
			<div class="title">
				<span class="custom-field edit-trigger ticket_field_{{f.id}}" data-item-id="{{f.id}}">{{f.title}}:</span>
			</div>
			<div class="content">
				<div class="custom-field content ticket_field_{{f.id}}" data-item-id="{{f.id}}">
					{{ render_custom_field(f) }}
				</div>
			</div>
		</div>
	{% endfor %}
</div>
<div class="page-display-input" style="display: none;">
	{% if app.getSetting('core.use_ticket_category') %}
	<div class="ticket_category category_id standard-field item" data-item-type="ticket_category">
		<div class="title">{{ phrase('agent.global.category') }}:</div>
		<div class="content">
			<select name="ticket[category_id]" data-prop-id="category_id" class="prop-input-category_id">
				<option value="0">{{ phrase('agent.global.none') }}</option>
				{% for cat in ticket_options.ticket_categories_hierarchy %}
					<option {% if ticket.category.id == cat.id %}selected="selected"{% endif %} value="{{ cat.id }}">{{ "--"|repeat(cat.depth) }} {{ cat.title }}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	{% endif %}
	{% if app.getSetting('core.use_product') %}
	<div class="ticket_product product_id standard-field item" data-item-type="ticket_product">
		<div class="title">{{ phrase('agent.global.product') }}:</div>
		<div class="content">
			<select name="ticket[product]_id" data-prop-id="product_id" class="prop-input-product_id">
				<option value="0">{{ phrase('agent.global.none') }}</option>
				{% for prod in ticket_options.products_hierarchy %}
					<option {% if ticket.product.id == prod.id %}selected="selected"{% endif %} value="{{ prod.id }}">{{ "--"|repeat(prod.depth) }} {{ prod.title }}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	{% endif %}
	{% if app.getSetting('core.use_ticket_priority') %}
	<div class="ticket_priority priority_id standard-field item" data-item-type="ticket_priority">
		<div class="title">{{ phrase('agent.global.priority') }}:</div>
		<div class="content">
			<select name="ticket[priority_id]" data-prop-id="priority_id" class="prop-input-priority_id">
				<option value="0">{{ phrase('agent.global.none') }}</option>
				{% for id,pri in ticket_options.priorities %}
					<option {% if ticket.priority.id == id %}selected="selected"{% endif %} value="{{ id }}">{{ pri }}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	{% endif %}
	{% if app.getSetting('core.use_ticket_workflow') %}
	<div class="ticket_workflow workflow_id standard-field item" data-item-type="ticket_workflow">
		<div class="title">{{ phrase('agent.global.workflow') }}:</div>
		<div class="content">
			<select name="ticket[workflow_id]" data-prop-id="workflow_id" class="prop-input-workflow_id">
				<option value="0">{{ phrase('agent.global.none') }}</option>
				{% for id,work in ticket_options.ticket_workflows %}
					<option {% if ticket.workflow.id == id %}selected="selected"{% endif %} value="{{ id }}">{{ work }}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	{% endif %}

	{% for f in custom_fields %}
		{% if f.field_def.isFormField() %}
		<div class="ticket_field_{{f.id}} custom-field item-input" data-field-type="ticket_field" data-item-id="{{f.id}}" data-custom-field-handler="{{f.field_handler}}">
			<div class="title">{{ f.title }}:</div>
			<div class="content">
				<div class="custom-field field-input ticket_field_{{f.id}}" data-item-id="{{f.id}}">
					{{ render_custom_field_form(f) }}
				</div>
			</div>
		</div>
		{% endif %}
	{% endfor %}
</div>
