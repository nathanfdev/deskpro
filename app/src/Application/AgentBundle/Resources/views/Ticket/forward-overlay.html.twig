<div class="overlay forward-overlay" style="width: 780px; height: 600px;">
	<div class="overlay-title">
		<h4>{{ phrase('agent.tickets.forward_message') }}</h4>
	</div>

	<div class="overlay-content" style="overflow: hidden;">
		<form action="{{ path('agent_ticket_fwd_send', {ticket_id: ticket.id, message_id: message.id}) }}" method="post">
			<div class="forward-wrapper">
				<div class="header-line">
					<div class="label">
						Recipients:
					</div>
					<div style="margin-left: 96px;">
						{% for i in 1..25 %}
							<div class="to_line {% if i == 1 %}is_visible{% endif %}" style="{% if i != 1 %}display: none;{% endif %} margin-bottom: 4px;">
								{% set to_id = el_uid() %}
								<div style="display: inline-block">
									<select name="to_type[{{ to_id }}]">
										<option value="to">To</option>
										<option value="cc">CC</option>
										<option value="bcc">BCC</option>
									</select>
								</div>
								<div
									class="email-address-wrap input"
									style="position: relative; top: 3px; display: inline-block;"
									data-element-handler="DeskPRO.Agent.ElementHandler.PersonSearchBox"
									data-search-url="{{ path('agent_peoplesearch_performquick', {'format': 'json', 'limit': 10, 'start_with': 'a', 'with_agents': 1}) }}"
									data-search-param="term"
									data-position-bound="#{{to_id}}"
								>
									<input
										id="{{to_id}}"
										class="email-address-input term"
										type="text"
										name="to[{{ to_id }}]"
										value=""
										placeholder="{{ phrase('agent.general.email_address') }}"
										style="width: 500px;"
									/>

									<script type="text/x-deskpro-tmpl" class="user-row-tpl">
										<li>
											<a>
											<span class="user-name"></span>
											<address>&lt;<span class="user-email"></span>&gt;</address>
											<div class="bound-fade"></div>
										</a></li>
									</script>
									<div class="person-search-box" style="display: none">
										<section>
											<ul class="results-list">

											</ul>
										</section>
									</div>
								</div>
							</div>
						{% endfor %}
						<div style="margin: 8px 0 0 0;">
							<span class="add-to-btn" style="background: #fff; border: 1px solid #aaa; border-radius: 3px; font-size: 11px; cursor: pointer; padding: 1px 3px;">Add another recipient</span>
						</div>
					</div>
				</div>
				<div class="header-line last">
					<div class="label">{{ phrase('agent.general.subject') }}:</div>
					<div class="input"><input type="text" name="subject" placeholder="{{ phrase('agent.general.subject') }}" value="FW: {{ ticket.subject }}" /></div>
				</div>
				<div class="message-area" style="overflow: auto;max-height: 426px;">
					{% if top %}
						<div class="uneditable-message">
							{{ top|raw }}
						</div>
					{% endif %}
					<div class="real-textarea"><textarea placeholder="{{ phrase('agent.tickets.optionally_enter_message') }}" name="custom_message" class="note"></textarea></div>
					<div class="fwd-headers">
						<div class="agent-sig-view" style="display: none; padding-top: 10px; padding-bottom: 20px;">
							{{ app.user.getSignatureHtml()|raw }}
						</div>
						--- {{ phrase('agent.tickets.forwarded_message') }} ---<br/>
						{{ phrase('agent.general.from') }}: {{ ticket.person.getDisplayName() }} &lt;<a href="mailto:{{ ticket.person.getPrimaryEmailAddress() }}">{{ ticket.person.getPrimaryEmailAddress() }}</a>&gt;<br/>
						{% if ticket.email_account %}{{ phrase('agent.general.to') }}: &lt;<a href="mailto:{{ ticket.email_account.address }}">{{ ticket.email_account.address }}</a>&gt;<br/>{% endif %}
						{{ phrase('agent.general.subject') }}: {{ ticket.subject }}<br/>
						{{ phrase('agent.general.date') }}: {{ date_created|date('fulltime') }}
					</div>
					<div class="orig-message">
						<iframe src="{{ path('agent_ticket_message_raw', {ticket_id: ticket.id, message_id: message.id, raw: security_token('view_raw', 10800), _rt: security_token('request_token', 10800)}) }}" frameborder="0" marginheight="0" marginwidth="0" width="100%" style="margin:0;border:0;" class="forward_overlay_iframe"></iframe>
					</div>
				</div>
			</div>
		</form>
	</div>

	<div class="overlay-footer">
		<div class="is-not-loading">
			<button class="save-trigger clean-white">{{ phrase('agent.general.send') }}</button>
		</div>
		<div class="is-loading">
			<div class="loading-icon"></div>
		</div>
	</div>
</div>