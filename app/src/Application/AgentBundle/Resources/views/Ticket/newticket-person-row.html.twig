<div class="col">
	<h4>{{ phrase('agent.global.email_address') }}</h4>
	{% if person.id and person.primary_email and person.primary_email.email %}
		{{ person.primary_email.email }}
	{% else %}
		<input type="text" name="newticket[person][email_address]" class="email" value="" />
	{% endif %}
</div>

<div class="col">
	<h4>{{ phrase('agent.global.name') }}</h4>
	<input type="text" name="newticket[person][name]" class="name" value="{{ person.name }}" />
	{% if person.id %}
		<a data-route="person:{{ path('agent_people_view', {'person_id': person.id}) }}">{{ phrase('agent.global.view_profile') }}</a>
	{% endif %}
</div>
<br class="clear" />
