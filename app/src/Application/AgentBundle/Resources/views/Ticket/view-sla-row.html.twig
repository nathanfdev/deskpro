<tr data-sla-id="{{ticket_sla.sla.id}}">
	<td class="sla-status-icon"><span class="{{ ticket_sla.sla_status }} tipped"
		{% if ticket_sla.sla_status == 'ok' %}title="SLA Status: Ok"
		{% elseif ticket_sla.sla_status == 'warning' %}title="SLA Status: Warning"
		{% elseif ticket_sla.sla_status == 'fail' %}title="SLA Status: Failed"{% endif %}
	></span></td>
	<td>{{ ticket_sla.sla.title }}</td>
	<td>{{ ticket_sla.warn_date ? ticket_sla.warn_date|date('fulltime') : 'N/A' }}</td>
	<td>{{ ticket_sla.fail_date ? ticket_sla.fail_date|date('fulltime') : 'N/A' }}</td>
	{% if ticket_sla.sla.allow_agent_manual %}
		{% if ticket_sla.is_completed %}
			<td class="completed"><a href="{{ path('agent_ticket_sladelete', {ticket_id: ticket.id, sla_id: ticket_sla.sla.id, security_token: security_token('delete_sla'), '_rt': security_token('request_token', 10800)}) }}" class="sla-delete tipped" title="SLA requirements complete. Click to remove SLA.">Delete</a></td>
		{% else %}
			<td class="delete"><a href="{{ path('agent_ticket_sladelete', {ticket_id: ticket.id, sla_id: ticket_sla.sla.id, security_token: security_token('delete_sla'), '_rt': security_token('request_token', 10800)}) }}" class="sla-delete tipped" title="Remove SLA">Delete</a></td>
		{% endif %}
	{% else %}
		{% if ticket_sla.is_completed %}
			<td class="completed"><span class="tipped" title="SLA requirements complete.">Complete</span></td>
		{% else %}
			<td>&nbsp;</td>
		{% endif %}
	{% endif %}
</tr>