{% if custom_fields %}
	<div class="ticket-custom-fields-wrap">
		<div class="ticket-custom-fields show-fields" style="clear:right">
			<div class="wrap">
				{% include 'AgentBundle:Ticket:custom-fields-rendered.html.twig' with {'custom_fields': custom_fields} %}
			</div>
		</div>
	</div>

	<div class="ticket-custom-fields edit show-fields edit-fields-overlay" style="display:none">
		{% for f in custom_fields %}
			<div class="field-wrap custom-field custom-field-{{f.field_def.id}} ticket_field-{{f.field_def.id}} display-element">
				<div class="label-wrap"><label>{{f.title}}</label></div>
				<div class="field-input">
					{{ render_custom_field_form(f) }}
				</div>
			</div>
		{% endfor %}
		<div class="buttons">
			<div class="loading-off">
				<button class="save-trigger dp-button small">{{ phrase('agent.global.save') }}</button>
				<button class="close-trigger dp-button gray small">{{ phrase('agent.global.cancel') }}</button>
			</div>
			<div class="loading-on">
				<span>{{ phrase('agent.global.saving') }}</span>
			</div>
		</div>
	</div>
{% endif %}
