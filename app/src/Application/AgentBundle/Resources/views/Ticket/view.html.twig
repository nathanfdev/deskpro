{% import 'AgentBundle:Common:macro-flagname.html.twig' as flag %}
<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.Ticket';
pageMeta.title         = {{ticket.subject|json_encode|raw}};
pageMeta.ticket_id     = {{ticket.id}};
pageMeta.url_fragment  = '{{ url_fragment('agent_ticket_view', {'ticket_id': ticket.id}) }}';

pageMeta.labelsAutocompleteUrl        = '{{ path('agent_ajax_labels_autocomplete', {'label_type': 'tickets'}) }}';
pageMeta.labelsSaveUrl                = '{{ path('agent_ticket_ajax_labels_save', {'ticket_id': ticket.id}) }}';
pageMeta.getMacroUrl                  = '{{ path('agent_ticket_ajax_get_macro', {'ticket_id': ticket.id }) }}?macro_id=$macro_id';
pageMeta.saveActionsUrl               = '{{ path('agent_ticket_ajax_save_actions', {'ticket_id': ticket.id }) }}';
pageMeta.deleteTicketUrl              = '{{ path('agent_ticketsearch_ajax_delete_tickets') }}';
pageMeta.uploadAttachUrl              = '{{ path('agent_accept_upload') }}';
pageMeta.viewMessageUnformattedUrl    = '{{ path('agent_ticket_message_unformatted', {'ticket_id': ticket.id, 'message_id': '000'})|replace({'000': '{message_id}'}) }}';
pageMeta.getMessageQuoteUrl           = '{{ path('agent_ticket_message_ajax_getquote', {'ticket_id': ticket.id, 'message_id': '000'})|replace({'000': '{message_id}'}) }}';
pageMeta.getMessagesUrl               = '{{ path('agent_ticket_ajax_getmessages', {'ticket_id': ticket.id}) }}';
pageMeta.viewPersonUrl                = '{{ path('agent_people_view', {'person_id': ticket.person.id}) }}';
pageMeta.lastMessageId = {{ last_message_id|default(0) }};
pageMeta.lastLogId = {{ last_log_id|default(0) }};

pageMeta.ticket_perms = {{ ticket_perms|json_encode|raw }};

{% if ticket.person.organization %}
	pageMeta.viewOrgUrl = '{{ path('agent_org_view', {'organization_id': ticket.person.organization.id}) }}';
{% endif %}

pageMeta.urls = {
	'snippetviewer': '{{ path('agent_ticket_snippetviewer', {'ticket_id': ticket.id}) }}'
};

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';

pageMeta.isDeleted = {% if ticket.hidden_status == 'deleted' %}true{% else %}false{% endif %};
pageMeta.isClosed = {% if ticket.status == 'closed' %}true{% else %}false{% endif %};
pageMeta.isSpam = {% if ticket.hidden_status == 'spam' %}true{% else %}false{% endif %};
pageMeta.isLocked = {% if ticket.is_locked == 'deleted' %}true{% else %}false{% endif %};
{% if agent_signature %}
pageMeta.agentSignature = {{ agent_signature|json_encode|raw }};
{% endif %}

</script>
<div class="macro-controls">
	<button class="save" id="macro_apply_btn">{{ phrase('agent.tickets.apply_macro') }}</button>
	<button class="cancel" id="macro_cancel_btn">{{ phrase('agent.general.cancel') }}</button>
</div>

<div class="layout-content with-scrollbar page-ticket {% if ticket.is_locked %}locked{% endif %} {% if ticket.hidden_status == 'deleted' %}deleted{% endif %} {{ ticket.status_code|replace({'.': '_'}) }}">
{% if ticket.is_locked %}
<div class="locked-bar" id="{{baseId}}_locked_bar">
	<button class="clean-white dismiss">{{ phrase('agent.general.dismiss') }}</button>
	{{ phrase('agent.tickets.in_use_by') }} <cite>{{ ticket.locked_by_agent }}</cite>.
</div>
{% endif %}
<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
<div class="scroll-viewport"><div class="scroll-content">

{% if ticket.is_locked %}<div class="locked-overlay" id="{{baseId}}_locked_overlay"></div>{% endif %}

<form class="value-form" style="display:none">
	<input type="hidden" name="agent_id" class="agent_id" value="{{ticket.agent.id|default(0)}}" />
	<input type="hidden" name="agent_team_id" class="agent_team_id" value="{{ticket.agent_team.id|default(0)}}" />
	<input type="hidden" name="department_id" class="department_id" value="{{ticket.department.id|default(0)}}" />
	<input type="hidden" name="category_id" class="category_id" value="{{ticket.category.id|default(0)}}" />
	<input type="hidden" name="product_id" class="product_id" value="{{ticket.product.id|default(0)}}" />
	<input type="hidden" name="priority_id" class="priority_id" value="{{ticket.priority.id|default(0)}}" />
	<input type="hidden" name="workflow_id" class="workflow_id" value="{{ticket.workflow.id|default(0)}}" />
	<input type="hidden" name="is_hold" class="is_hold" value="{{ticket.is_hold|default(0)}}" />
	<input type="hidden" name="status" class="status" value="{{ticket.status}}" />
	<input type="hidden" name="hidden_status" class="hidden_status" value="{{ticket.hidden_status}}" />
</form>

{% if ticket.status == 'hidden' %}
	<div class="ticket-hidden-bar {% if ticket.hidden_status == 'deleted' or ticket.hidden_status == 'spam' %}deleted{% endif %}">
		<article>
		{% if ticket.hidden_status == 'deleted' %}
			{{ phrase('agent.tickets.deleted_by') }} {{ ticket_deleted.by_person.display_name }} (<time class="timeago" title="{{ ticket_deleted.date_created|date('c') }}">{{ ticket_deleted.date_created|date('day') }}</time>).
			{% if ticket_deleted.reason %}
				<br />{{ phrase('agent.general.reason') }}: {{ ticket_deleted.reason }}
			{% endif %}

			{% if ticket_perms.delete %}
				<br />
				<div style="padding: 5px">
					<button class="clean-white undelete-trigger">{{ phrase('agent.general.undelete') }}</button>
				</div>
			{% endif %}
			{% if hard_delete_time %}
				{{ phrase('agent.tickets.perm_delete_note', {'time': hard_delete_time}) }}
			{% endif %}
		{% elseif ticket.hidden_status == 'spam' %}
			{{ phrase('agent.tickets.ticket_is_marked_as_spam') }}<br />

			{% if ticket_perms.delete %}
				<div style="padding: 5px">
					<button class="clean-white unspam-trigger">{{ phrase('agent.general.unspam') }}</button>
				</div>
			{% endif %}

			{% if hard_delete_time %}
				{{ phrase('agent.tickets.perm_delete_note', {'time': hard_delete_time}) }}
			{% endif %}
		{% else %}
			{{ phrase('agent.tickets.hidden_because') }}
			<span>{{ phrase('agent.tickets.hidden_status_' ~ ticket.hidden_status) }}</span><br />
			{{ phrase('agent.tickets.hidden_explain') }}
		{% endif %}
		</article>
	</div>
{% endif %}

<header class="page-header">
	<h4 class="id-number">#{{ ticket.id }}</h4>
	<h1>{{ ticket.subject }}</h1>
	<br class="clear" />
	<div class="meta-line">
		<div class="status set-status awaiting_agent" {% if ticket.status_code != 'awaiting_agent' %}style="display: none"{% endif %}>
			<span class="marker-urgency-data urgency-{{ ticket.urgency }}">
				<label>{{ phrase('agent.tickets.status_awaiting_agent') }}</label>
				<i class="ticket-urgency" id="{{baseId}}_urgency" data-urgency="{{ ticket.urgency }}">{{ ticket.urgency }}</i>
			</span>
		</div>
		<div class="status set-status awaiting_user" {% if ticket.status_code != 'awaiting_user' %}style="display: none"{% endif %}><span><label>{{ phrase('agent.tickets.status_awaiting_user') }}</label></span></div>
		<div class="status set-status closed" {% if ticket.status_code != 'closed' %}style="display: none"{% endif %}><span><label>{{ phrase('agent.tickets.status_closed') }}</label></span></div>
		<div class="status set-status resolved" {% if ticket.status_code != 'resolved' %}style="display: none"{% endif %}><span><label>{{ phrase('agent.tickets.status_resolved') }}</label></span></div>
		<div class="status set-status hidden hidden_spam" {% if ticket.status_code != 'hidden.spam' %}style="display: none"{% endif %}><span><label>{{ phrase('agent.general.spam') }}</label></span></div>
		<div class="status set-status hidden hidden_validating" {% if ticket.status_code != 'hidden.validating' %}style="display: none"{% endif %}><span><label>{{ phrase('agent.general.validating') }}</label></span></div>
		<div class="status set-status hidden hidden_deleted" {% if ticket.status_code != 'hidden.deleted' %}style="display: none"{% endif %}><span><label>{{ phrase('agent.general.deleted') }}</label></span></div>

		<div class="category set-department"><span>{{ phrase('agent.general.department') }}: <span class="label-department-id">{{ ticket.department.full_title }}</span></span></div>

		{% if ticket_perms.modify_set_hold %}
			<div class="set-hold hold noedit-hide" {% if ticket.is_hold %}style="display: none"{% endif %}><span>{{ phrase('agent.tickets.set_hold') }}</span></div>
			<div class="set-hold unhold noedit-hide" {% if not ticket.is_hold %}style="display: none"{% endif %}><span class="tipped" title="{{ phrase('agent.tickets.click_to_release_hold') }}">{{ phrase('agent.tickets.on_hold') }}</span></div>
		{% endif %}
	</div>
	<br class="clear" />
</header>

<table cellspacing="0" cellpadding="0" width="100%"><tr><td class="col" valign="top" width="50%"><tr><td width="50%" valign="top">
	<div class="profile-box-container people-box first">
		<header>
			<h4>{{ phrase('agent.general.people') }}</h4>
		</header>
		<section id="{{baseId}}_people_box_person">
			<article>
				<dl>
					<dt>{{ phrase('agent.general.owner') }}</dt>
					<dd>
						<a class="user-link clean-white as-popover preload" data-route="person:{{ path('agent_people_view', {'person_id': ticket.person_id}) }}">
							<span style="background-image: url('{{ ticket.person.getPictureUrl(20) }}');">
								{{ ticket.person.display_name }}&nbsp;{% if ticket.person.organization %},
									{% if ticket.person.organization_position %}{{ ticket.person.organization_position }}{% endif %}
									{{ ticket.person.organization }}
								{% endif %}
								<span class="email"><b class="pemail-{{ticket.person.id}}" data-hide="@parent">{{ ticket.person_email_address }}</b></span>
							</span>
						</a>
						<div class="clear"></div>
					</dd>
				</dl>
				<dl>

					{% if ticket_perms.modify_cc or user_parts|length %}
						<dt>
							{{ phrase('agent.tickets.cc') }}
							{% if ticket_perms.modify_cc %}<span id="{{baseId}}_new_cc_user" class="btn-small-add"></span>{% endif %}
						</dt>
						<dd
							class="cc-row"
							data-element-handler="DeskPRO.Agent.ElementHandler.TicketCcManage"
							data-add-url="{{ path('agent_ticket_addpart', {'ticket_id': ticket.id}) }}"
							data-delete-url="{{ path('agent_ticket_delpart', {'ticket_id': ticket.id}) }}"
							data-add-trigger="#{{baseId}}_new_cc_user"
							data-replybox-container="#{{baseId}}_replybox_wrap"
						>
							<ul>
								{% for part in user_parts %}
									{% include 'AgentBundle:Ticket:view-user-cc-row.html.twig' with {'person': part.person, 'ticket_perms':ticket_perms } %}
								{% endfor %}
							</ul>
							<script type="text/x-deskpro-plain" class="addrow-tpl">
								<li class="addrow noedit-hide">
									<span class="btn-small-remove remove-row-trigger"></span>
									<input type="text" class="user-part cc-people-search-trigger" />
                                    <div class="person-search-box" style="display: none">
                                        <section>
                                            <ul class="results-list">

                                            </ul>
                                        </section>
                                    </div>
                                    <span class="is-not-loading"><button class="clean-white small cc-saverow-trigger">{{ phrase('agent.general.add') }}</button></span>
                                    <span class="is-loading">{{ phrase('agent.general.saving') }}</span>
                                    <script class="user-row-tpl" type="text/x-deskpro-tmpl">
                                        <li>
                                            <a>
                                                <span class="user-name"></span>
                                                <address>&lt;<span class="user-email"></span>&gt;</address>
                                                <div class="bound-fade"></div>
                                            </a>
                                        </li>
                                    </script>
                                </li>
							</script>
						</dd>
					{% endif %}
				</dl>
			</article>
		</section>
	</div>
</td><td width="50%" valign="top">
	<div class="profile-box-container people-box second">
		<header>
			<div class="controls">
				{% if ticket_perms.modify_assign_agent or ticket_perms.modify_assign_team or ticket_perms.modify_assign_self %}
					<span class="edit-gear noedit-hide" id="{{baseId}}_assign_ob_trigger"></span>
				{% endif %}
			</div>
			<h4>{{ phrase('agent.general.assignments') }}</h4>
		</header>
		<section id="{{baseId}}_people_box_agent">
			<article>
				<dl>
					<dt class="agent-row">{{ phrase('agent.general.agent') }}</dt>
					<dd class="agent-row">
						<span class="agent-link agent-icon prop-agent-id {% if ticket.agent.id == app.user.id %}me{% elseif not ticket.agent.id %}no-agent{% endif %}" data-none-label="{{ phrase('agent.general.no_agent_assigned') }}" data-agent-id="{{ ticket.agent.id }}" style="background-image: url('{{ ticket.agent.getPictureUrl(20) }}');">{{ ticket.agent.display_name|default(phrase('agent.general.team')) }}</span>
					</dd>

					<dt class="team-row" {% if not ticket.agent_team %}style="display: none"{% endif %}>{{ phrase('agent.general.team') }}</dt>
					<dd class="team-row" {% if not ticket.agent_team %}style="display: none"{% endif %}>
						<span class="prop-agent-team-id">{{ ticket.agent_team.name|default(phrase('agent.general.none')) }}</span>
					</dd>

					<dt class="followers-row" {% if not agent_parts|length %}style="display:none"{% endif %}>{{ phrase('agent.general.followers') }}</dt>
					<dd class="followers-row" {% if not agent_parts|length %}style="display:none"{% endif %}>
						<ul id="{{baseId}}_followers_list" class="comma-list">
							{% for part in agent_parts %}
								<li><span class="agent-link" data-agent-id="{{ part.person.id }}">{{ part.person.display_name }}</span></li>
							{% else %}
								<li>{{ phrase('agent.tickets.no_followers') }}</li>
							{% endfor %}
						</ul>
					</dd>
				</dl>
			</article>
		</section>
	</div>
</td></tr></table>

<div class="profile-box-container">
	<header>
		<h4>{{ phrase('agent.general.properties') }}</h4>
	</header>
	<section class="description-area" id="{{baseId}}_fields_display_main_wrap" style="padding:0">
		<table class="prop-table noedit-hide" cellpadding="0" cellspacing="0" width="100%">
			<tr>
				<th>{{ phrase('agent.general.flag') }}</th>
				<td
					class="flagged-wrap"
					id="{{baseId}}_flag_opt"
					data-element-handler="DeskPRO.ElementHandler.ListRadio"
				>
					<ul>
						<li class="flag-none tipped {% if not ticket_flagged %}{{ phrase('agent.tickets.on') }}{% endif %}" data-value="none" title="{{ phrase('agent.tickets.no_flag') }}"><span></span></li>
						{% for color in ['blue', 'green', 'orange', 'pink', 'purple', 'red', 'yellow'] %}
						<li class="flag-{{color}} tipped {% if ticket_flagged == color %}on last-on{% endif %}" data-value="{{ color }}" title="{{ flag.flag_name(color) }}"><span>{{ flag.flag_name(color) }}</span></li>
						{% endfor %}
					</ul>
				</td>
			</tr>
		</table>
		<table class="prop-table noedit-hide" cellpadding="0" cellspacing="0" width="100%">
			{% if ticket.linked_chat %}
			<tr>
				<th>{{ phrase('agent.general.linked_chat') }}:</th>
				<td>
					<a data-route="page:{{ path('agent_userchat_view', { conversation_id: ticket.linked_chat.id }) }}">{{ ticket.linked_chat.getSubjectLine() }}</a>
				</td>
			</tr>
			{% endif %}

			{% if ticket_perms.modify_labels or ticket.labels|length %}
				<tr>
					<th class="type-labels">{{ phrase('agent.general.labels') }}:</th>
					<td class="ticket-tags tags-wrap {% if not ticket_perms.modify_labels %}tags-disable-edit{% endif %}">
						<input type="text" value="{% for label in ticket.labels %}{{label.label}},{% endfor %}" />
					</td>
				</tr>
			{% endif %}

			<tr>
				<th>{{ phrase('agent.general.created') }}:</th>
				<td>
					<time class="timeago" datetime="{{ticket.date_created|date('c')}}"></time>
					{{ phrase('agent.tickets.on') }} {{ ticket.date_created|date('M j Y H:ia') }}
				</td>
			</tr>

			<tr>
				<th>{{ phrase('agent.general.user_waiting') }}:</th>
				<td>
					{% set waiting_total %}
					<time class="timeago" data-timeago-no-ago="1" datetime="{{ ("- " ~ ticket.real_total_user_waiting|default('1') ~ " seconds")|date('c') }}"></time>
					{% endset %}
					{% if ticket.status == 'awaiting_agent' and ticket.date_user_waiting %}
					{% set waiting %}
					<time class="timeago" data-timeago-no-ago="1" datetime="{{ ticket.date_user_waiting|date('c') }}"></time>
					{% endset %}
					{{ phrase('agent.tickets.user_waiting_x_and_total_y', {'waiting': waiting, 'total': waiting_total}) }}
					{% else %}
					{{ phrase('agent.tickets.user_waiting_total_x', {'total': waiting_total}) }}
					{% endif %}
				</td>
			</tr>
		</table>

		<div class="extra-info fields-show">
			<div class="info-list" id="{{baseId}}_fields_display_main"></div>
		</div>
		<div class="fields-edit" style="display: none;"></div>

		<div class="controls" id="{{baseId}}_properties_controls">
			{% if ticket_perms.modify_fields %}<a class="clean-white properties-edit-trigger edit-fields-trigger"><span>{{ phrase('agent.general.edit_properties') }}</span></a>{% endif %}
			{% if ticket_perms.modify_merge %}<a class="clean-white noedit-hide" id="{{baseId}}_merge_trigger"><span>{{ phrase('agent.general.merge') }}</span></a>{% endif %}
			{% if macros|length %}
				<a class="clean-white arrow menu-fitted noedit-hide" id="{{baseId}}_macros_menu_trigger"><span>{{ phrase('agent.general.macros') }}</span><em></em></a>
			{% endif %}
			{% if ticket_perms.delete %}
			{% if not (ticket.hidden_status in ['deleted', 'spam'] )%}
				<a class="clean-white nodelete-hide" id="{{baseId}}_delete_trigger"><span>{{ phrase('agent.general.ucfirst_delete') }}</span></a>
				<a class="clean-white noedit-hide" id="{{baseId}}_spam_trigger"><span>{{ phrase('agent.general.spam') }}</span></a>
			{% endif %}
			{% endif %}
			<a class="clean-white" id="{{baseId}}_print_trigger"><span>{{ phrase('agent.general.print') }}</span></a>
            <a class="clean-white" target="_blank" href="{{ path('agent_ticket_view', {'ticket_id': ticket.id,'pdf': 1}) }}"><span>{{ phrase('agent.general.download_pdf') }}</span></a>
		</div>
	</section>
</div>

<div class="profile-box-container ticket-messages">
	<header>
		<h4>{{ phrase('agent.general.messages') }}</h4>
		<ul class="tickets-msg-controls">
			<li id="{{baseId}}_msgcheck_message"><label><input type="checkbox" class="dp-checkbox show-messages" checked="checked" />{{ phrase('agent.general.messages') }}</label></li>
			<li id="{{baseId}}_msgcheck_attach"><label><input type="checkbox" class="dp-checkbox show-attach" checked="checked" />{{ phrase('agent.general.attachments') }}</label></li>
			<li id="{{baseId}}_msgcheck_notes"><label><input type="checkbox" class="dp-checkbox show-notes" checked="checked" />{{ phrase('agent.general.notes') }}</label></li>
			<li id="{{baseId}}_msgcheck_logs"><label><input type="checkbox" class="dp-checkbox show-logs" />{{ phrase('agent.tickets.ticket_log') }}</label></li>
		</ul>
	</header>
	<section class="messages-wrap" id="{{baseId}}_messages_wrap">
		{{ ticket_messages_block|raw }}
	</section>
</div>

{% if ticket_perms.reply or ticket_perms.modify_note %}
<div id="{{baseId}}_replybox_wrap" class="replybox-wrap">
	{% include 'AgentBundle:Ticket:replybox.html.twig' %}
</div>
{% endif %}

{# Wrapper around fields in the properties box #}
<script type="text/x-deskpro-plain" id="{{baseId}}_fields_display_main_wrap_tpl">
	<table class="prop-table display-item" cellpadding="0" cellspacing="0" width="100%">
		<tr>
			<th class="prop-title display-title"></th>
			<td class="prop-val display-content"></td>
		</tr>
	</table>
</script>
<script type="text/x-deskpro-plain" id="{{baseId}}_fields_display_main_edit_tpl">
	<div class="fields-edit-container">
		<div class="fields-edit-rows"></div>
		<div class="controls">
			<div class="is-not-loading">
				<button class="clean-white save-trigger">{{ phrase('agent.general.save') }}</button>
				<button class="clean-white close-trigger">{{ phrase('agent.general.cancel') }}</button>
			</div>
			<div class="is-loading">
				{{ phrase('agent.general.saving') }}
			</div>
		</div>
	</div>
</script>
<script type="text/x-deskpro-plain" id="{{baseId}}_fields_display_main_edit_row_tpl">
	<table class="prop-table display-item" cellpadding="0" cellspacing="0" width="100%">
		<tr>
			<th class="display-title"></th>
			<td class="display-content"></td>
		</tr>
	</table>
</script>

{# New tab code for bottom tabs (for addition to tabstrip) #}
<script type="text/x-deskpro-plain" class="tpl-fields-maintabs-tab" id="{{baseId}}_fields_display_tabs_tab_tpl">
	<li class="tab-trigger {id} field-tab" data-tab-for=".{id}" data-field-tab-id="{id}">
		<a>{title}</a>
	</li>
</script>
<script type="text/x-deskpro-plain" class="tpl-fields-maintabs-content" id="{{baseId}}_fields_display_tabs_content_tpl">
	<div class="full-container-tabbed-contents tab-content field-tab-content {id}">
	</div>
</script>
<script type="text/x-deskpro-plain" id="{{baseId}}_fields_display_tabs_wrap_tpl">
	<dl class="info-list display-item">
		<dt class="display-title"></dt>
		<dd class="display-content"></dd>
	</dl>
</script>

{% include 'AgentBundle:Ticket:view-page-display-holders.html.twig' %}

{% include 'AgentBundle:Ticket:part-ticket-menus.html.twig' %}

<div class="macro-controls" style="display: none;">
	<button class="clean-white save" id="macro_apply_btn">{{ phrase('agent.general.apply') }}</button>
	<button class="clean-white cancel" id="macro_cancel_btn">{{ phrase('agent.general.cancel') }}</button>
</div>

{% if ticket_perms.modify_assign_agent or ticket_perms.modify_assign_team or ticket_perms.modify_assign_self %}
<div class="optionbox reply-agent-team-ob with-footer" id="{{baseId}}_agent_assign_ob">
	<header>
		<h4>{{ phrase('agent.general.assignments') }}</h4>
		<span class="close close-trigger"></span>
	</header>
	{% if ticket_perms.modify_assign_agent or ticket_perms.modify_assign_self %}
	<div class="col">
		<section data-section-name="agents">
			<header>
				<h3>{{ phrase('agent.general.agents') }}</h3>
				<input type="text" class="filter-box" placeholder="{{ phrase('agent.general.filter') }}" />
			</header>
			<ul>
				{% if ticket_perms.modify_assign_self or ticket.agent.id == app.user.id %}
					<li class="me last-me {% if ticket.agent.id == app.user.id or not ticket.agent %}{{ phrase('agent.tickets.on') }}{% endif %}">
						<input type="radio" name="{{baseId}}_agent" value="{{ app.user.id }}" {% if ticket.agent.id == app.user.id %}checked="checked"{% endif %} />
						<label><span class="agent-pic agent-label-{{ app.user.id }}" style="background-image: url({{ app.user.getPictureUrl(16) }})">{{ phrase('agent.general.me') }}</span></label>
					</li>
				{% endif %}

				{% if ticket_perms.modify_assign_agent or not ticket.agent %}
					<li>
						<input type="radio" name="{{baseId}}_agent" value="0" {% if not ticket.agent %}checked="checked"{% endif %}  />
						<label><span class="agent-pic agent-label-0">{{ phrase('agent.general.unassigned') }}</span></label>
					</li>
				{% endif %}

				{% for agent in agents %}
					{% if agent.id != app.user.id and (ticket_perms.modify_assign_agent or ticket.agent.id == agent.id) %}
						<li {% if ticket.agent.id == agent.id %}class="on"{% endif %}>
							<input type="radio" name="{{baseId}}_agent" value="{{ agent.id }}" {% if ticket.agent.id == agent.id %}checked="checked"{% endif %} />
							<label><span class="agent-pic agent-label-{{ agent.id }}" style="background-image: url({{ agent.getPictureUrl(16) }})">{{ agent.display_name }}</span></label>
							<div class="bound-fade"></div>
						</li>
					{% endif %}
				{% endfor %}
			</ul>
		</section>
	</div>
	{% endif %}
	{% if app.getSetting('core.use_agent_team') and (ticket_perms.modify_assign_team or (ticket_perms.modify_assign_self and app.user.Agent.hasTeams())) %}
	<div class="col">
		<section data-section-name="teams">
			<header>
				<h3>{{ phrase('agent.general.teams') }}</h3>
				<input type="text" class="filter-box" placeholder="{{ phrase('agent.general.filter') }}" />
			</header>
			<ul>
				{% for team in app.user.getAgent().getTeams() %}
					{% if ticket_perms.modify_assign_self or (ticket.agent_team.id == team.id) %}
					<li class="me {% if loop.last %}last-me{% endif %} {% if ticket.agent_team.id == team.id %}{{ phrase('agent.tickets.on') }}{% endif %}">
						<input type="radio" name="{{baseId}}_agent_team" value="{{ team.id }}" {% if ticket.agent_team.id == team.id %}checked="checked"{% endif %} />
						<label class="agent-team-label-{{ team.id }}">{{ team.name }}</label>
						<div class="bound-fade"></div>
					</li>
					{% endif %}
				{% endfor %}

				{% if ticket_perms.modify_assign_team or not ticket.agent_team %}
					<li class="{% if not ticket.agent_team %}{{ phrase('agent.tickets.on') }}{% endif %}">
						<input type="radio" name="{{baseId}}_agent_team" value="0" {% if not ticket.agent_team %}checked="checked"{% endif %} />
						<label><span class="agent-team-label-0">{{ phrase('agent.general.no_team') }}</span></label>
					</li>
				{% endif %}

				{% for team in agent_teams %}
					{% if (ticket_perms.modify_assign_team or ticket.agent_team.id == team.id) and team.id not in app.user.getAgent().getTeamIds() %}
						<li {% if ticket.agent_team.id == team.id %}class="on"{% endif %}>
							<input type="radio" name="{{baseId}}_agent_team" value="{{ team.id }}" {% if ticket.agent_team.id == team.id %}checked="checked"{% endif %} />
							<label class="agent-team-label-{{ team.id }}">{{ team.name }}</label>
							<div class="bound-fade"></div>
						</li>
					{% endif %}
				{% endfor %}
			</ul>
		</section>
	</div>
	{% endif %}
	{% if ticket_perms.modify_assign_agent or ticket_perms.modify_assign_self %}
	<div class="col">
		<section data-section-name="followers">
			<header>
				<h3>{{ phrase('agent.general.followers') }}</h3>
				<input type="text" class="filter-box" placeholder="{{ phrase('agent.general.filter') }}" />
			</header>
			<ul>
				{% if app.user.id in participant_ids or ticket_perms.modify_assign_self %}
					<li class="me last-me {% if app.user.id in participant_ids %}{{ phrase('agent.tickets.on') }}{% endif %}">
						<input type="checkbox" name="{{bsaeId}}_part" value="{{ app.user.id }}" {% if app.user.id in participant_ids %}checked="checked"{% endif %} />
						<label><span class="agent-pic agent-part-label-{{ app.user.id }}" style="background-image: url({{ app.user.getPictureUrl(16) }})">{{ phrase('agent.general.me') }}</span></label>
					</li>
				{% endif %}

				{% for agent in agents %}
					{% if agent.id != app.user.id and ticket_perms.modify_assign_agent %}
						<li {% if agent.id in participant_ids %}class="on"{% endif %}>
							<input type="checkbox" name="{{bsaeId}}_part" value="{{ agent.id }}" {% if agent.id in participant_ids %}checked="checked"{% endif %} />
							<label><span class="agent-pic agent-part-label-{{ agent.id }}" style="background-image: url({{ agent.getPictureUrl(16) }})">{{ agent.display_name }}</span></label>
							<div class="bound-fade"></div>
						</li>
					{% endif %}
				{% endfor %}
			</ul>
		</section>
	</div>
	{% endif %}
	<br class="clear" />
	<footer>
		<button class="save-trigger">{{ phrase('agent.general.apply') }}</button>
	</footer>
</div>
{% endif %}

<div class="confirm-macro-overlay" id="{{baseId}}_confirm_macro_overlay" style="width: 400px; height: 400px; display: none;">
	<div class="overlay-title">
		<h4>{{ phrase('agent.general.confirm') }}</h4>
	</div>
	<div class="overlay-content">
		<div class="actions-list"></div>
	</div>
	<div class="overlay-footer">
		<button class="clean-white" id="{{baseId}}_apply_macro_btn">{{ phrase('agent.general.apply') }}</button>
	</div>
</div>

</div></div> {# /scroll #}
</div>{# /layout #}
