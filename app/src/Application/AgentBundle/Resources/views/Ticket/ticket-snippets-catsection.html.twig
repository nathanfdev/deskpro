<article class="cat-section cat-el cat-{{ category.id }}" data-category-id="{{ category.id }}" style="display:none;">
	<div class="cat-controls">
		<button class="clean-white add-snippet-trigger" style="float:right;">{{ phrase('agent.general.add_new_snippet') }}</button>
		<input type="text" class="filter-input" placeholder="Filter snippets ..." />
	</div>
	<ul>
		{% set has_snippets = true %}
		{% for snippet in snippets %}
			{% include 'AgentBundle:Ticket:ticket-snippets-row.html.twig' %}
		{% else %}
			{% set has_snippets = false %}
		{% endfor %}
		<li class="no-snippets" {% if has_snippets %}style="display: none"{% endif %}>This category has no snippets.</li>
	</ul>
</article>
