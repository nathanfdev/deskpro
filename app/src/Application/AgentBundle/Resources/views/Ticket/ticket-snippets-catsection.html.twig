<article class="cat-{{ category.id }}" style="display:none;">
	<ul>
		{% for snippet in snippets %}
			{% include 'AgentBundle:Ticket:ticket-snippets-row.html.twig' %}
		{% endfor %}
		<li class="new-snippet">
			<div class="display">
				<button class="clean-white add-snippet-trigger">{{ phrase('agent.general.add_new_snippet') }}</button>
			</div>
			<div class="input" style="display: none;">
				<form>
					<input type="hidden" name="category_id" value="{{ category.id }}" />
					<input type="hidden" name="snippet_id" value="0" />
					<input type="text" name="title" value="" placeholder="{{ phrase('agent.general.title') }}" />
					<textarea name="snippet" placeholder="{{ phrase('agent.general.snippet_text_placeholder') }}"></textarea>
					<input type="hidden" name="is_html" value="0" />
					<button class="clean-white save-snippet-trigger">{{ phrase('agent.general.save') }}</button>
				</form>
			</div>
		</li>
	</ul>
</article>
