<div class="bar-wrapper">
<div class="tab-bottom-wrap inner">
	<div class="tab-bottom-open">
		<div class="tab-bottom-tabs">
			<ul>
				<li class="tab-trigger reply-reply on" data-tab-for=".tab-content.reply-reply"><a>{{ phrase('agent.message') }}</a></li>
				<li class="tab-trigger reply-cc" data-tab-for=".tab-content.reply-cc"><a>{{ phrase('agent.tickets.cc') }}</a></li>
				<li class="tab-trigger reply-attach" data-tab-for=".tab-content.reply-attach"><a>{{ phrase('agent.tickets.attachment') }}</a></li>
			</ul>
			<span class="bottom-tabs-button macros">{{ phrase('agent.macros') }}</span>
			<span class="bottom-tabs-button macros-apply" style="display: none;">{{ phrase('agent.apply') }}</span>
			<span class="bottom-tabs-button macros-cancel" style="display: none;">{{ phrase('agent.cancel') }}</span>
		</div>

		<div class="tab-bottom-contents" style="height:154px;">
			{# Reply area #}
			<div class="content-tab-bottom reply-reply tab-content on" data-tab-trigger=".tab-trigger.reply-reply">
				<div class="reply-form-fields">
					{% include 'AgentBundle:Common:attach-row-tmpl.html.twig' with {formname: 'attach[]'} %}
					<textarea name="message"></textarea>
					<input type="hidden" name="options[agent_id]" value="{{app.user.id}}" />
					<input type="hidden" name="options[agent_team_id]" value="{{app.user.getAgentTeamIds[0]}}" />
					<input type="hidden" name="options[status]" value="awaiting_user" />

					<div class="send-reply" style="float:right; margin-right: 8px; margin-top: 4px;">
						<button class="dp-button">{{ phrase('agent.add_reply') }}</button>
						<div class="spinner"></div>
					</div>

					<table cellspacing="0" cellpadding="0" style="margin-top: 5px;">
						<tr>
							<td width="5" valign="middle" style="vertical-align:middle; padding-right: 5px;">
								<input id="foot_assign_check_{{ticket.id}}" class="small" type="checkbox" name="options[do_assign]" value="1" checked="checked" />
							</td>
							<td style="padding-right: 15px; vertical-align:middle;" valign="middle">
								<label for="foot_assign_check_{{ticket.id}}">{{ phrase('agent.tickets.assign_ticket_to') }}</label>
								<span class="prop-val trigger agent_id">{{ phrase('agent.me') }}</span>
								<label for="foot_assign_check_{{ticket.id}}">{{ phrase('agent.and') }}</label>
								<span class="prop-val trigger agent_team_id">{{ phrase('agent.tickets.my_team') }}</span>
							</td>
							<td width="5" valign="middle" style="vertical-align:middle; padding-right:5px;">
								<input id="foot_status_check_{{ticket.id}}" class="small" type="checkbox" name="options[do_status]" checked="checked" />
							</td>
							<td valign="middle" style="vertical-align:middle">
								<label for="foot_status_check_{{ticket.id}}">{{ phrase('agent.tickets.change_status_to') }}</label>
								<span class="prop-val status trigger">{{ phrase('agent.pending') }}</span>
							</td>
						</tr>
						<tr>
							<td width="5" valign="middle" style="vertical-align:middle; padding-right: 5px;">
								<input id="foot_close_tab_{{ticket.id}}" class="small" type="checkbox" name="options[close_tab]" value="1" checked="checked" />
							</td>
							<td style="padding-right: 15px; vertical-align:middle;" valign="middle">
								<label for="foot_close_tab_{{ticket.id}}">{{ phrase('agent.tickets.close_tab_after_reply') }}</label>
							</td>
							<td width="5" valign="middle" style="vertical-align:middle; padding-right:5px;">
								<input id="foot_kb_pending_{{ticket.id}}" class="small" type="checkbox" name="options[kb_pending]" />
							</td>
							<td valign="middle" style="vertical-align:middle">
								<label for="foot_kb_pending_{{ticket.id}}">{{ phrase('agent.tickets.mark_as_pending_kb_article') }}</label>
							</td>
						</tr>
					</table>
				</div>
				<ul class="reply-agent_id-menu" style="display:none">
					<li data-option-id="standard" data-option-name="agent_id" data-option-value="{{app.user.id}}">{{ phrase('agent.me') }}</li>
					<li class="sep">-</li>
					{% for id,title in ticket_options.agents %}
						<li data-option-id="standard" data-option-name="agent_id" data-option-value="{{id}}">{{title}}</li>
					{% endfor %}
				</ul>
				<ul class="reply-agent_team_id-menu" style="display:none">
					<li data-option-id="standard" data-option-name="agent_team_id" data-option-value="{{app.user.getAgentTeamIds[0]}}">{{ phrase('agent.tickets.my_team') }}</li>
					<li class="sep">-</li>
					{% for id,title in ticket_options.agent_teams %}
						<li data-option-id="standard" data-option-name="agent_team_id" data-option-value="{{id}}">{{title}}</li>
					{% endfor %}
				</ul>
				<ul class="reply-status-menu" style="display:none">
					<li data-option-id="standard" data-option-name="status" data-option-value="awaiting_agent">{{ phrase('agent.awaiting_agent') }}</li>
					<li data-option-id="standard" data-option-name="status" data-option-value="awaiting_user">{{ phrase('agent.awaiting_user') }}</li>
					<li data-option-id="standard" data-option-name="status" data-option-value="resolved">{{ phrase('agent.resolved') }}</li>
				</ul>
			</div>
			{# /Reply Area #}

			<div class="content-tab-bottom content-tab-bottom reply-attach tab-content" data-tab-trigger=".tab-trigger.reply-attach">
				<div class="file-input">
					{{ phrase('agent.tickets.drag_and_drop_files_onto_this_area_or') }}:
					<input type="file" name="file-upload" multiple="multiple" />
				</div>
				<ul class="files file-list"></ul>
			</div>
			<div class="content-tab-bottom cc-area reply-cc tab-content" data-tab-trigger=".tab-trigger.reply-cc">
				{% include 'AgentBundle:Ticket:view-reply-cctab.html.twig' with {'participants': participants} %}
			</div>
		</div>
	</div>

	{#
	<div class="tab-bottom">
		<input type="text" class="placeholder" value="{{ phrase('agent.tickets.placeholder_type_a_result') }}" />
		<div class="bar-actions">
			<ul>
				<li class="macro-on macros-apply" style="display:none"><a>{{ phrase('agent.apply') }}</a></li>
				<li class="macro-on macros-cancel" style="display:none"><a>{{ phrase('agent.cancel') }}</a></li>
				<li class="send-reply" style="display:none"><div class="spinner" style="float:left;display:none;"></div><a>{{ phrase('agent.tickets.send_reply') }}</a><a class="loading-msg">{{ phrase('agent.tickets.sending') }}</a></li>
				<li class="macros"><a>{{ phrase('agent.macros') }}</a></li>
				<li class="actions"><a>{{ phrase('agent.actions') }}</a></li>
			</ul>
		</div>
	</div>
	#}
</div>
</div>
