<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.SnippetViewer';
pageMeta.title = 'Ticket Snippets';
pageMeta.ticket_id = {{ ticket.id|default(0) }};

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
<div class="ticket-snippets-overlay snippets-overlay" {% if ticket %}data-ticket-id="{{ ticket.id }}"{% endif %}>
	<nav>
		<header>
			<span class="new-category"></span>
			<h4>{{ phrase('agent.general.categories') }}</h4>
		</header>
		{# Page Containers #}
		<div class="layout-content with-scrollbar" style="top: 21px">
		<div class="scrollbar disable"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
		<div class="scroll-viewport"><div class="scroll-content" data-extra-height="21">
		{# /Page Containers #}
			<ul id="{{ baseId }}_catlist">
				<li class="cat-title-0 category" data-category="0" data-tab-for="article.cat-0" {% if not ticket_snippet_cats|length %}style="display: none;"{% endif %}>
					<a>
						<span class="label">All Snippets</span>
					</a>
				</li>

				{% for category in ticket_snippet_cats %}
					{% include 'AgentBundle:Ticket:ticket-snippets-catrow.html.twig' %}
				{% endfor %}
			</ul>
	 	{# Page Containers #}
        </div></div>
        </div>
        {# /Page Containers #}
	</nav>
	<div class="snippet-sections-wrap">
		{# Page Containers #}
		<div class="layout-content with-scrollbar">
		<div class="scrollbar disable"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
		<div class="scroll-viewport"><div class="scroll-content snippet-sections">
		{# /Page Containers #}
			{% include 'AgentBundle:Ticket:ticket-snippets-allcatsection.html.twig' with {'ticket_snippet_cats': ticket_snippet_cats, 'ticket_snippets': ticket_snippets} %}

			{% for category in ticket_snippet_cats %}
				{% set group = ticket_snippets[category.id] %}
				{% include 'AgentBundle:Ticket:ticket-snippets-catsection.html.twig' with {'category': category, 'snippets': group.snippets} %}
			{% endfor %}

			<div class="no-cats-message" {% if ticket_snippet_cats|length %}style="display: none"{% endif %}>
				{{ phrase('agent.general.snippets_none_explain') }}
			</div>
        {# Page Containers #}
        </div></div>
        </div>
        {# /Page Containers #}
	</div>

	<div id="{{baseId}}_new_snippet" class="snippet-editor-overlay" style="width: 720px; height: 420px; display: none;">
		<div class="overlay-title">
			<span class="close-overlay"></span>
			<h4 class="is-new-snippet">New Snippet</h4>
			<h4 class="is-edit-snippet">Edit Snippet</h4>
		</div>
		<div class="overlay-content">

			<input type="hidden" name="snippet_id" value="0" />
			<input type="text" name="title" value="" placeholder="{{ phrase('agent.general.title') }}" style="width: 100%; box-sizing: border-box; -moz-box-sizing: border-box" />
			<div style="width: 100%">
				<textarea name="snippet" placeholder="{{ phrase('agent.general.snippet_text_placeholder') }}" style="width: 100%; box-sizing: border-box; -moz-box-sizing: border-box; height: 190px"></textarea>
			</div>
			<div style="float:left; font-size: 11px;">
				<span class="small-light-icon tipped" data-tipped-options="maxWidth: 250" title="Type this code into the ticket reply box and the snippet will be inserted automatically. For example, with shortcut code of 'standard-response' you simply type in '%standard-response%' to insert the snippet without opening the snippet manager."></span>
				Shortcut code: <span class="snippet-code-wrap">%<input type="text" name="shortcut_code" class="shortcut-code-input" value="" placeholder="Enter a shortcut" />%</span>
			</div>
			<div style="float:right; text-align: right; font-size:  11px;">
				<select class="variables-select">
					<optgroup label="Ticket">
						<option value="ticket.subject">Subject</option>
						<option value="ticket.department">Department</option>
						<option value="ticket.product">Product</option>
						<option value="ticket.category">Category</option>
						<option value="ticket.workflow">Workflow</option>
						<option value="ticket.priority">Priority</option>
						<option value="ticket.agent">Agent Name</option>
						<option value="ticket.agent_email">Agent Email Address</option>
						<option value="ticket.agent">Agent Team</option>
						<option value="ticket.date_created">Date Created</option>
						<option value="ticket.time_created">Time Created</option>
						{% for field in app.getCustomFieldManager('tickets').getFields() %}
							<option value="ticket.field{{ field.id }}">{{ field.title }}</option>
						{% endfor %}
					</optgroup>
					<optgroup label="User">
						<option value="user.name">Name</option>
						<option value="user.email">Email Address</option>
						<option value="user.organization_position">Position in Organisation</option>
						{% for field in app.getCustomFieldManager('people').getFields() %}
							<option value="user.field{{ field.id }}">{{ field.title }}</option>
						{% endfor %}
					</optgroup>
					<optgroup label="Organisation">
						<option value="org.name">Name</option>
					</optgroup>
				</select> <button class="variables-insert-btn clean-white" style="vertical-align: top; position:relative; top: 3px;">Insert Variable</button>
				<br />
				 <a href="http://support.deskpro.com/kb/articles/133-using-variables-in-snippets" target="_blank">Learn more about variables</a>
			</div>
			<input type="hidden" name="is_html" value="0" />
		</div>
		<div class="overlay-footer">
			<div class="is-not-loading">
				<button class="clean-white small save-snippet-trigger is-new-snippet">{{ phrase('agent.general.add') }}</button>
				<button class="clean-white small save-snippet-trigger is-edit-snippet">{{ phrase('agent.general.save') }}</button>
				<div class="overlay-content-block is-edit-snippet" style="text-align: center; display: inline-block; font-size: 11px;">
					<div class="is-not-loading">
						or
						<span class="faux-link delete-snippet-trigger" data-confirm="Are you sure you want to delete this snippet?">{{ phrase('agent.general.ucfirst_delete') }}</span>
					</div>
					<div class="is-loading">
						<img src="{{ asset('images/spinners/loading-small-flat.gif') }}" />
					</div>
				</div>
			</div>
			<div class="is-loading">
				<img src="{{ asset('images/spinners/loading-small-flat.gif') }}" />
			</div>
		</div>
	</div>

	<div id="{{baseId}}_new_snippet_cat" style="width: 420px; height: 350px; display: none;">
		<div class="overlay-title">
			<span class="close-overlay"></span>
			<h4>{{ phrase('agent.tickets.new_snippet_category') }}</h4>
		</div>
		<div class="overlay-content">
			<form>
				<dl class="generic-form-list">
					<dt>{{ phrase('agent.general.title') }}:</dt>
					<dd><input type="text" name="title" value="New Category" /></dd>

					<dt>{{ phrase('agent.general.permissions') }}:</dt>
					<dd>
						<label><input type="radio" class="perm-type-opt" name="perm_type" value="me" checked="checked" /> {{ phrase('agent.general.just_me') }}</label><br />
						<label><input type="radio" class="perm-type-opt" name="perm_type" value="global" /> {{ phrase('agent.general.usergroup_everyone') }}</label><br />
					</dd>

					<dt class="perm-teams" style="display: none">{{ phrase('agent.general.teams') }}:</dt>
					<dd class="perm-teams" style="display: none">
						<select name="teams[]" multiple="multiple" size="6">
							{% for team in agent_teams %}
								<option value="{{ team.id }}">{{ team.name }}</option>
							{% endfor %}
						</select>
					</dd>
				</dl>
			</form>
		</div>
		<div class="overlay-footer">
			<div class="is-not-loading">
				<button class="clean-white small new-cat-trigger">{{ phrase('agent.general.add') }}</button>
			</div>
			<div class="is-loading">
				<img src="{{ asset('images/spinners/loading-small-flat.gif') }}" />
			</div>
		</div>
	</div>
</div>
