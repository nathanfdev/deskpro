{% import 'AgentBundle:Common:agent-macros.html.twig' as tools %}
{% set replyBaseId = el_uid() %}
<form
	class="ticket-reply-form"
	id="{{replyBaseId}}_reply_form"
	method="post"
	action="{{ path('agent_ticket_ajaxsavereply', {'ticket_id': ticket.id}) }}"

	data-element-handler="DeskPRO.Agent.ElementHandler.TicketReplyBox"
	data-upload-url="{{ path('agent_accept_upload') }}"
	data-snippet-viewer-url="{{ path('agent_ticket_snippetviewer', {'ticket_id': ticket.id}) }}"
	data-base-id="{{replyBaseId}}"
>

<input type="hidden" id="{{replyBaseId}}_is_note" name="options[is_note]" value="0" />

<input type="hidden" id="{{replyBaseId}}_exist_agent_id" value="{{ ticket.agent.id|default(0) }}" />
<input type="hidden" id="{{replyBaseId}}_exist_agent_team_id" value="{{ ticket.agent_team.id|default(0) }}" />

<div class="profile-box-container reply-box-wrap" style="position: relative">
	<div class="drop-file-zone"><h1>{{ phrase('agent.general.drop_here_to_attach') }}</h1></div>
	<div class="ticket-sending-overlay" style="display: none;">
		<strong><span class="hide-note">Sending your message</span><span class="hide-reply" style="display: none">Adding your note</span></strong>

		<div class="close-tab-message">
			<em>This tab will automatically close after your message is posted.</em>
			<button class="keep-open-toggle clean-white" id="{{ replyBaseId }}_keep_open_toggle">Click here to keep this tab open</button>
		</div>
	</div>
	<header>
		<nav>
			<ul>
				{% if ticket_perms.reply %}<li id="{{replyBaseId}}_replybox_replytab_btn" class="on">{{ phrase('agent.general.reply') }}</li>{% endif %}
				{% if ticket_perms.modify_notes %}<li id="{{replyBaseId}}_replybox_notetab_btn" class="note-type {% if not ticket_perms.reply %}on{% endif %}">{{ phrase('agent.general.note') }}</li>{% endif %}
			</ul>
		</nav>
	</header>
	<section class="ticketreply">

		<nav id="{{replyBaseId}}_header_rows">
			<ul class="option-buttons">
				<li class="tipped attach" title="{{ phrase('agent.general.attachments') }}">
					<input type="file" class="file" name="file-upload" />
					<span></span>
				</li>
				<li class="tipped snippets hide-note" id="{{replyBaseId}}_text_snippets_btn" title="{{ phrase('agent.general.snippets') }}"><span></span></li>
			</ul>

			<ul class="option-buttons right">
				<li class="tipped article toggle hide-note" title="{{ phrase('agent.general.mark_as_pending_kb') }}">
					<span><em class="check"></em></span>
					<input type="checkbox" name="options[do_kbpending]"/>
				</li>
				<li class="tipped notifyuser toggle hide-note on" title="Send notification email to users about your reply">
					<span><em class="check"></em></span>
					<input type="checkbox" name="options[notify_user]" checked="checked" />
				</li>
				<li class="send" id="{{replyBaseId}}_send_btn"><span class="hide-note">{{ phrase('agent.general.send') }}</span><span class="hide-reply" style="display: none">{{ phrase('agent.general.add_note') }}</span></li>
			</ul>
		</nav>
		<article>
			<section>
				<ul>
					<li class="to-row hide-note">
						<label>
                            {% if ticket_perms.modify_cc or user_parts|length %}
							    <span class="expander {% if user_parts|length %}expanded{% endif %}" data-target="#{{replyBaseId}}_cc_row">+/-</span>
                            {% endif %}
							{{ phrase('agent.general.to') }}:
						</label>
						<div>
							{{ ticket.person.display_name }}
							{% if ticket.person_email %}
								&lt;{{ ticket.person_email.email }}&gt;
							{% elseif ticket.person.primary_email %}
								&lt;{{ ticket.person.primary_email.email }}&gt;
							{% endif %}
						</div>
					</li>
					{% if ticket_perms.modify_cc or user_parts|length %}
						<li id="{{replyBaseId}}_cc_row" class="cc-row hide-note {% if not user_parts|length %}is-hidden{% endif %}" {% if not user_parts|length %}style="display: none;"{% endif %}>
							<label>{{ phrase('agent.tickets.cc') }}:</label>
							<div>
								<div id="{{replyBaseId}}_newcc" style="display: none;"></div>
								<div id="{{replyBaseId}}_delcc" style="display: none;"></div>

                                <div class="user-rows" id="{{replyBaseId}}_cc_user_rows">
                                    {% for p in user_parts %}
                                        <div class="cc-user-row" data-email="{{ p.person_email.email }}"><span class="btn-small-remove remove-row-trigger"></span><span class="user-email">{{ p.person_email.email }}</span></div>
                                    {% endfor %}
                                </div>
                                <script class="email-row-tpl" type="text/x-deskpro-tmpl">
                                    <div class="cc-user-row">
                                        <span class="btn-small-remove remove-row-trigger"></span>
                                        <span class="user-email"></span>
                                    </div>
                                </script>
                                <div class="addrow noedit-hide">
                                    <input type="text" class="user-part cc-people-search-trigger" />
                                    <div class="person-search-box" style="display: none">
                                        <section>
                                            <ul class="results-list">

                                            </ul>
                                        </section>
                                    </div>
                                    <button class="clean-white small cc-saverow-trigger">{{ phrase('agent.general.add') }}</button>
                                    <script class="user-row-tpl" type="text/x-deskpro-tmpl">
                                        <li>
                                            <a>
                                                <span class="user-name"></span>
                                                <address>&lt;<span class="user-email"></span>&gt;</address>
                                                <div class="bound-fade"></div>
                                            </a>
                                        </li>
                                    </script>
                                </div>
							</div>
						</li>
					{% endif %}
					<li class="hide-note with-select2">
						<label>{{ phrase('agent.general.status') }}:</label>
						<div>
							<select id="{{replyBaseId}}_status_sel" class="dpe_select" name="options[status]" style="min-width: 170px;">
								<option value="">Do not change status</option>
								<option value="awaiting_user" selected="selected">Awaiting User</option>
								<option value="awaiting_agent">Awaiting Agent</option>
								<option value="resolved">Resolved</option>
							</select>
						</div>
					</li>
					<li class="hide-note with-select2">
						<label>{{ phrase('agent.general.assign') }}:</label>
						<div>
							{% set is_selected = false %}
							<select name="options[agent_id]" id="{{replyBaseId}}_agent_sel" class="dpe_select" data-style-type="icons" data-select-icon-size="22" style="min-width: 170px;">
								{% if ticket.agent %}
									<option value="-1">Do not change agent</option>
								{% endif %}

								<option {% if not ticket.agent.id %}{% set is_selected = true %}selected="selected"{% endif %} value="0">Unassigned</option>

								{% if ticket_perms.modify_assign_self or ticket.agent.id == app.user.id %}
									{% set is_selected = true %}
									<option selected="selected" data-icon="{{ app.user.getPictureUrl(20) }}" value="{{ app.user.id }}">{{ app.user.display_name }}</option>
								{% endif %}
								{% for agent in agents %}
									{% if agent.id != app.user.id %}
										<option {% if not is_selected and agent.id == ticket.agent.id %}selected="selected"{% endif %} data-icon="{{ agent.getPictureUrl(20) }}" value="{{ agent.id }}">{{ agent.display_name }}</option>
									{% endif %}
								{% endfor %}
							</select>

							{% set is_selected = false %}
							<select name="options[agent_team_id]" id="{{replyBaseId}}_agent_team_sel" class="dpe_select" data-select-nogrouptitle="1" style="min-width: 170px;">

								{% if ticket.agent_team %}
									<option value="-1">Do not change team</option>
								{% endif %}

								{% if ticket_perms.modify_assign_team or not ticket.agent_team %}
									<option value="0" {% if not ticket.agent_team %}selected="selected"{% endif %}>No Team</option>
								{% endif %}

								{% if app.user.getAgent().getTeams()|length and (ticket_perms.modify_assign_self or (ticket.agent_team.id == team.id)) %}
								<optgroup label="{% if app.user.getAgent().getTeams()|length > 1 %}Your Teams{% else %}Your Team{% endif %}">
									{% for team in app.user.getAgent().getTeams() %}
										<option value="{{ team.id }}" {% if ticket.agent_team.id == team.id %}selected="selected"{% endif %}>{{ team.name }}</option>
									{% endfor %}
								</optgroup>
								{% endif %}

								{% for team in agent_teams %}
									{% if (ticket_perms.modify_assign_team or ticket.agent_team.id == team.id) and team.id not in app.user.getAgent().getTeamIds() %}
										<option value="{{ team.id }}" {% if ticket.agent_team.id == team.id %}selected="selected"{% endif %}>{{ team.name }}</option>
									{% endif %}
								{% endfor %}
							</select>
						</div>
					</li>
					{% if app.getSetting('core_tickets.enable_billing') and app.getSetting('core_tickets.billing_on_reply') %}
						<li id="{{replyBaseId}}_billing_reply" class="hide-note">
							<label>Charge:</label>
							<div>
								<label><input type="checkbox" name="charge_time" value="0" checked="checked" /> Charge time: <span id="{{replyBaseId}}_billing_reply_time"></span></label>
							</div>
						</li>
					{% endif %}
					<li id="{{replyBaseId}}_attach_row" class="attach-row is-hidden" style="display: none">
						<label><span>{{ phrase('agent.general.attachments') }}</span></label>
						<div>
							<ul class="files"></ul>
							<br class="clear"/>
						</div>
					</li>
				</ul>
				<div class="input-wrap">
					<textarea placeholder="" id="{{replyBaseId}}_replybox_txt" name="message">{% if agent_signature %}



{{ agent_signature }}{% endif %}</textarea>
					<textarea id="{{replyBaseId}}_signature_value" class="signature-value" style="display: none;">{{ agent_signature }}</textarea>
				</div>
			</section>
		</article>

	</section>
</div>

{% include 'AgentBundle:Common:attach-row-tmpl.html.twig' with {formname: 'attach[]'} %}

</form>
