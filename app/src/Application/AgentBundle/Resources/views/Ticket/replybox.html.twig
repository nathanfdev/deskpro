{% import 'AgentBundle:Common:agent-macros.html.twig' as tools %}
{% set replyBaseId = el_uid() %}
<form
	class="ticket-reply-form"
	id="{{replyBaseId}}_reply_form"
	method="post"
	action="{{ path('agent_ticket_ajaxsavereply', {'ticket_id': ticket.id}) }}"

	data-element-handler="DeskPRO.Agent.ElementHandler.TicketReplyBox"
	data-upload-url="{{ path('agent_accept_upload') }}"
	data-snippet-viewer-url="{{ path('agent_ticket_snippetviewer', {'ticket_id': ticket.id}) }}"
	data-base-id="{{replyBaseId}}"
>

{% if ticket.agent.id == app.user.id %}
	<input type="hidden" id="{{replyBaseId}}_do_agent_id" name="options[do_assign]" value="0" />
{% else %}
	<input type="hidden" id="{{replyBaseId}}_do_agent_id" name="options[do_assign]" value="1" />
{% endif %}

<input type="hidden" id="{{replyBaseId}}_agent_id" name="options[agent_id]" value="{{ app.user.id }}" />

<input type="hidden" id="{{replyBaseId}}_do_agent_team_id" name="options[do_assign_team]" value="0" />
<input type="hidden" id="{{replyBaseId}}_agent_team_id" name="options[agent_team_id]" value="0" />

{% if ticket.status_code == 'awaiting_agent' %}
	<input type="hidden" id="{{replyBaseId}}_ticket_status" name="options[status]" value="awaiting_user" />
	<input type="hidden" id="{{replyBaseId}}_ticket_do_status" name="options[do_status]" value="1" />
{% else %}
	<input type="hidden" id="{{replyBaseId}}_ticket_status" name="options[status]" value="" />
	<input type="hidden" id="{{replyBaseId}}_ticket_do_status" name="options[do_status]" value="0" />
{% endif %}

<input type="hidden" id="{{replyBaseId}}_is_note" name="options[is_note]" value="0" />

<input type="hidden" id="{{replyBaseId}}_exist_agent_id" value="{{ ticket.agent.id|default(0) }}" />
<input type="hidden" id="{{replyBaseId}}_exist_agent_team_id" value="{{ ticket.agent_team.id|default(0) }}" />

<div class="profile-box-container reply-box-wrap" style="position: relative">
	<div class="drop-file-zone"><h1>{{ phrase('agent.ticket.drop_your_file_here_to_attach_it_to') }}</h1></div>
	<header>
		<nav>
			<ul>
				{% if ticket_perms.reply %}<li id="{{replyBaseId}}_replybox_replytab_btn" class="on">{{ phrase('agent.reply') }}</li>{% endif %}
				{% if ticket_perms.modify_notes %}<li id="{{replyBaseId}}_replybox_notetab_btn" class="note-type {% if not ticket_perms.reply %}on{% endif %}">{{ phrase('agent.note') }}</li>{% endif %}
			</ul>
		</nav>
	</header>
	<section class="ticketreply">

		<nav id="{{replyBaseId}}_header_rows">
			<ul class="option-buttons">
				<li class="tipped attach" title="{{ phrase('agent.attachments') }}">
					<input type="file" class="file" name="file-upload" />
					<span></span>
				</li>
				<li class="tipped snippets hide-note" id="{{replyBaseId}}_text_snippets_btn" title="{{ phrase('agent.snippets') }}"><span></span></li>
			</ul>

			<ul class="option-buttons right">
				<li class="tipped article toggle hide-note" title="{{ phrase('agent.mark_as_pending_kb') }}">
					<span><em class="check"></em></span>
					<input type="checkbox" name="options[do_kbpending]"/>
				</li>
				<li class="tipped closetab toggle hide-note" title="{{ phrase('agent.tickets.close_tab_after_reply') }}">
					<span>{{ phrase('agent.ticket.close_tab') }}<em class="check"></em></span>
					<input type="checkbox" name="options[close_tab]" />
				</li>
				<li class="send" id="{{replyBaseId}}_send_btn"><span class="hide-note">{{ phrase('agent.send') }}</span><span class="hide-reply">{{ phrase('agent.add') }}</span></li>
			</ul>
		</nav>
		<article>
			<section>
				<ul>
					<li class="to-row hide-note">
						<label>
							<span class="expander {% if user_parts|length %}expanded{% endif %}" data-target="#{{replyBaseId}}_cc_row">+/-</span>
							{{ phrase('agent.to') }}:
						</label>
						<div>
							{{ ticket.person.display_name }}
							{% if ticket.person_email %}
								&lt;{{ ticket.person_email.email }}&gt;
							{% elseif ticket.person.primary_email %}
								&lt;{{ ticket.person.primary_email.email }}&gt;
							{% endif %}
						</div>
					</li>
					{% if ticket_perms.modify_cc or user_parts|length %}
						<li id="{{replyBaseId}}_cc_row" class="cc-row hide-note {% if not user_parts|length %}is-hidden{% endif %}" {% if not user_parts|length %}style="display: none;"{% endif %}>
							<label>{{ phrase('agent.ticket.cc') }}:</label>
							<div>
								<input
									type="text"
									placeholder="{{ phrase('agent.ticket.enter_an_email_address') }}"
									name="user_parts"
									value="{% for p in user_parts %}{{ p.person_email.email }}{% if not loop.last %},{% endif %}{% endfor %}"
									id="{{replyBaseId}}_cc_input"
                                    style="display:none"
								/>
                                <div class="user-rows">
                                    {% for p in user_parts %}
                                        <div class="cc-user-row">
                                            <span class="btn-small-remove remove-row-trigger"></span>
                                            <span class="user-email">{{ p.person_email.email }}</span>
                                        </div>
                                    {% endfor %}
                                </div>
                                <script class="email-row-tpl" type="text/x-deskpro-tmpl">
                                    <div class="cc-user-row">
                                        <span class="btn-small-remove remove-row-trigger"></span>
                                        <span class="user-email"></span>
                                    </div>
                                </script>
                                <div class="addrow noedit-hide">
                                    <input type="text" class="user-part cc-people-search-trigger" />
                                    <div class="person-search-box" style="display: none">
                                        <section>
                                            <ul class="results-list">

                                            </ul>
                                        </section>
                                    </div>
                                    <button class="clean-white small cc-saverow-trigger">{{ phrase('agent.ticket.add') }}</button>
                                    <script class="user-row-tpl" type="text/x-deskpro-tmpl">
                                        <li>
                                            <a>
                                                <span class="user-name"></span>
                                                <address>&lt;<span class="user-email"></span>&gt;</address>
                                                <div class="bound-fade"></div>
                                            </a>
                                        </li>
                                    </script>
                                </div>
							</div>
						</li>
					{% endif %}
					<li class="hide-note">
						<label>{{ phrase('agent.status') }}:</label>
						<div id="{{replyBaseId}}_status_detail" class="{% if ticket.status_code == 'awaiting_agent' %}changed{% endif %}">
							<a class="status-trigger prop-change with-menu-click-position">
                                {% set phrase_part %}
                                <span class="new-val-label">{{ phrase('agent.tickets.status_awaiting_user') }}</span>
                                {% endset %}
                                {{ phrase('agent.ticket.change_status', {'old':phrase('agent.tickets.status_' ~ ticket.status), 'new':phrase_part}) }}
							</a>
							<a class="status-trigger prop-no-change with-menu-click-position">
                                {{ phrase('agent.ticket.keep_status_set', {'old':phrase('agent.tickets.status_' ~ ticket.status)}) }}
							</a>
						</div>
					</li>
					<li class="hide-note">
						<label>{{ phrase('agent.assign') }}:</label>
						<div id="{{replyBaseId}}_assign_detail">
							<a id="{{replyBaseId}}_assign_btn" class="with-menu-click-position">
							<span id="{{replyBaseId}}_assign_detail_agent" class="{% if ticket.agent.id != app.user.id %}changed{% endif %}">
								<span class="prop-change">
									{% if ticket.agent %}
                                        {% set phrase_part %}
                                            <span class="new-val-label">{{ phrase('agent.ticket.me') }}</span>
                                        {% endset %}
                                        {{ phrase('agent.ticket.change_agent', {'old':tools.name_or_me(ticket.agent),'new':phrase_part}) }}
										{% if app.getSetting('core.use_agent_team') %} | {% endif %}
									{% else %}
                                        {% set phrase_part %}
                                            <span class="new-val-label">{{ phrase('agent.ticket.me') }}</span>
                                        {% endset %}
										{{ phrase('agent.ticket.remain_assigned_to_agent', {'agent':phrase_part}) }}  {% if app.getSetting('core.use_agent_team') %} | {% endif %}
									{% endif %}
								</span>
								<span class="prop-no-change">
									{% if ticket.agent %}
										{{ phrase('agent.ticket.remain_unassigned_agent', {'agent':tools.name_or_me(ticket.agent)}) }} {% if app.getSetting('core.use_agent_team') %} | {% endif %}
									{% else %}
										{{ phrase('agent.ticket.remain_unassigned') }} {% if app.getSetting('core.use_agent_team') %} | {% endif %}
									{% endif %}
								</span>
							</span>
							{% if app.getSetting('core.use_agent_team') %}
								<span id="{{replyBaseId}}_assign_detail_agent_team">
									<span class="prop-change">
										{% if ticket.agent_team %}
											{% set phrase_part %}
                                                <span class="new-val-label">{{ phrase('agent.ticket.me') }}</span>
                                            {% endset %}
                                            {{ phrase('agent.ticket.change_team', {'old':tools.team_name_or_me(ticket.agent_team),'new':phrase_part}) }}
										{% else %}
											{{ phrase('agent.ticket.remain_assigned_to') }} <span class="new-val-label"></span>
										{% endif %}
									</span>
									<span class="prop-no-change">
										{% if ticket.agent_team %}
                                            {{ phrase('agent.ticket.remain_unassigned_team_with_name', {'name':tools.team_name_or_me(ticket.agent_team)}) }}
										{% else %}
											{{ phrase('agent.ticket.remain_unassigned_team') }}
										{% endif %}
									</span>
								</span>
							{% endif %}
							<span id="{{replyBaseId}}_assign_detail_followers">
								<span class="is-followers" {% if not agent_parts|length %}style="display: none"{% endif %}>
									| {% set phrase_part %}<span class="count">{{ agent_parts|length }}</span>{% endset %}
                                    {{ phrase('agent.ticket.count_followers', {'display_count':phrase_part, 'count':agent_parts|length}) }}
									<div class="inputs" style="display: none">
										{% for p in agent_parts %}
											<input type="hidden" name="agent_parts[]" value="{{ p.person.id }}" />
										{% endfor %}
									</div>
								</span>
							</span>
							</a>
						</div>
					</li>
					<li class="hide-reply" style="display: none">
						<label>{{ phrase('agent.followers') }}:</label>
						<div id="{{replyBaseId}}_assign_followers">
							<a id="{{replyBaseId}}_assign_followers_btn" class="with-menu-click-position">
							<span id="{{replyBaseId}}_assign_followers_detail">
								<span class="no-followers" {% if agent_parts|length %}style="display: none"{% endif %}>
									{{ phrase('agent.ticket.no_followers') }}
								</span>
								<span class="is-followers" {% if not agent_parts|length %}style="display: none"{% endif %}>
									| {% set phrase_part %}<span class="count">{{ agent_parts|length }}</span>{% endset %}
                                    {{ phrase('agent.ticket.count_followers', {'display_count':phrase_part, 'count':agent_parts|length}) }}
									<div class="inputs" style="display: none">
										{% for p in agent_parts %}
											<input type="hidden" name="agent_parts[]" value="{{ p.person.id }}" />
										{% endfor %}
									</div>
								</span>
							</span>
							</a>
						</div>
					</li>
					<li id="{{replyBaseId}}_attach_row" class="attach-row is-hidden" style="display: none">
						<label><span>{{ phrase('agent.attachments') }}</span></label>
						<div>
							<ul class="files"></ul>
							<br class="clear"/>
						</div>
					</li>
				</ul>
				<div class="input-wrap">
					<textarea placeholder="" id="{{replyBaseId}}_replybox_txt" name="message">{% if agent_signature %}



{{ agent_signature }}{% endif %}</textarea>
					<textarea id="{{replyBaseId}}_signature_value" style="display: none;">{{ agent_signature }}</textarea>
				</div>
			</section>
		</article>

	</section>
</div>

{% include 'AgentBundle:Common:attach-row-tmpl.html.twig' with {formname: 'attach'} %}

<ul style="display: none" id="{{replyBaseId}}_status_menu">
	<li data-status="no-change">{{ phrase('agent.tickets.keep_current_status') }}: {{ phrase('agent.tickets.status_' ~ ticket.status) }}</li>
	{% if ticket.status != 'awaiting_agent' %}<li data-status="awaiting_agent">{{ phrase('agent.tickets.status_awaiting_agent') }}</li>{% endif %}
	{% if ticket.status != 'awaiting_user' %}<li data-status="awaiting_user">{{ phrase('agent.tickets.status_awaiting_user') }}</li>{% endif %}
</ul>

<div class="optionbox reply-agent-team-ob" id="{{replyBaseId}}_agent_selector">
	<header>
		<h4>{{ phrase('agent.assignments') }}</h4>
		<span class="close close-trigger"></span>
	</header>
	<div class="col">
		<section data-section-name="agents">
			<header>
				<h3>{{ phrase('agent.agents') }}</h3>
				<input type="text" class="filter-box" placeholder="{{ phrase('agent.filter_placeholder') }}" />
			</header>
			<ul>
				<li class="me last-me {% if ticket.agent.id == app.user.id or not ticket.agent %}on{% endif %}">
					<input type="radio" name="{{replyBaseId}}_agent" value="{{ app.user.id }}" {% if ticket.agent.id == app.user.id or not ticket.agent %}checked="checked"{% endif %} />
					<label><span class="agent-pic agent-label-{{ app.user.id }}" style="background-image: url({{ app.user.getPictureUrl(16) }})">{{ phrase('agent.me') }}</span></label>
				</li>

				<li>
					<input type="radio" name="{{replyBaseId}}_agent" value="0" />
					<label><span class="agent-pic agent-label-0">{{ phrase('agent.unassigned') }}</span></label>
				</li>

				{% for agent in agents %}
					{% if agent.id != app.user.id %}
						<li {% if ticket.agent.id == agent.id %}class="on"{% endif %}>
							<input type="radio" name="{{replyBaseId}}_agent" value="{{ agent.id }}" {% if ticket.agent.id == agent.id %}checked="checked"{% endif %} />
							<label><span class="agent-pic agent-label-{{ agent.id }}" style="background-image: url({{ agent.getPictureUrl(16) }})">{{ agent.display_name }}</span></label>
							<div class="bound-fade"></div>
						</li>
					{% endif %}
				{% endfor %}
			</ul>
		</section>
	</div>
	{% if app.getSetting('core.use_agent_team') %}
	<div class="col">
		<section data-section-name="teams">
			<header>
				<h3>{{ phrase('agent.label_teams') }}</h3>
				<input type="text" class="filter-box" placeholder="{{ phrase('agent.filter_placeholder') }}" />
			</header>
			<ul>
				{% for team in app.user.getAgent().getTeams() %}
					<li class="me {% if loop.last %}last-me{% endif %} {% if ticket.agent_team.id == team.id %}on{% endif %}">
						<input type="radio" name="{{replyBaseId}}_agent_team" value="{{ team.id }}" {% if ticket.agent_team.id == team.id %}checked="checked"{% endif %} />
						<label class="agent-team-label-{{ team.id }}">{{ team.name }}</label>
						<div class="bound-fade"></div>
					</li>
				{% endfor %}

				<li class="{% if not ticket.agent_team %}on{% endif %}">
					<input type="radio" name="{{replyBaseId}}_agent_team" value="0" {% if not ticket.agent_team %}checked="checked"{% endif %} />
					<label><span class="agent-team-label-0">{{ phrase('agent.ticket.no_team') }}</span></label>
				</li>

				{% for team in agent_teams %}
					{% if team.id not in app.user.getAgent().getTeamIds() %}
						<li {% if ticket.agent_team.id == team.id %}class="on"{% endif %}>
							<input type="radio" name="{{replyBaseId}}_agent_team" value="{{ team.id }}" {% if ticket.agent_team.id == team.id %}checked="checked"{% endif %} />
							<label class="agent-team-label-{{ team.id }}">{{ team.name }}</label>
							<div class="bound-fade"></div>
						</li>
					{% endif %}
				{% endfor %}
			</ul>
		</section>
	</div>
	{% endif %}
	<div class="col">
		<section data-section-name="followers">
			<header>
				<h3>{{ phrase('agent.followers') }}</h3>
				<input type="text" class="filter-box" placeholder="{{ phrase('agent.filter_placeholder') }}" />
			</header>
			<ul>
				<li class="me last-me {% if app.user.id in participant_ids %}on{% endif %}">
					<input type="checkbox" name="{{replyBaseId}}_part" value="{{ app.user.id }}" {% if app.user.id in participant_ids %}checked="checked"{% endif %} />
					<label><span class="agent-pic agent-part-label-{{ app.user.id }}" style="background-image: url({{ app.user.getPictureUrl(16) }})">{{ phrase('agent.me') }}</span></label>
				</li>

				{% for agent in agents %}
					{% if agent.id != app.user.id %}
						<li {% if agent.id in participant_ids %}class="on"{% endif %}>
							<input type="checkbox" name="{{replyBaseId}}_part" value="{{ agent.id }}" {% if agent.id in participant_ids %}checked="checked"{% endif %} />
							<label><span class="agent-pic agent-part-label-{{ agent.id }}" style="background-image: url({{ agent.getPictureUrl(16) }})">{{ agent.display_name }}</span></label>
							<div class="bound-fade"></div>
						</li>
					{% endif %}
				{% endfor %}
			</ul>
		</section>
	</div>
	<br class="clear" />
	<footer>
		<button class="save-trigger">{{ phrase('agent.apply') }}</button>
	</footer>
</div>

<div class="optionbox reply-agent-team-ob" id="{{replyBaseId}}_agent_followers_selector">
	<header>
		<h4>{{ phrase('agent.followers') }}</h4>
		<span class="close close-trigger"></span>
	</header>
	<section data-section-name="followers">
		<header>
			<h3>{{ phrase('agent.followers') }}</h3>
			<input type="text" class="filter-box" placeholder="{{ phrase('agent.filter_placeholder') }}" />
		</header>
		<ul>
			<li class="me last-me {% if app.user.id in participant_ids %}on{% endif %}">
				<input type="checkbox" name="{{replyBaseId}}_notepart" value="{{ app.user.id }}" {% if app.user.id in participant_ids %}checked="checked"{% endif %} />
				<label><span class="agent-pic agent-part-label-{{ app.user.id }}" style="background-image: url({{ app.user.getPictureUrl(16) }})">{{ phrase('agent.me') }}</span></label>
			</li>

			{% for agent in agents %}
				{% if agent.id != app.user.id %}
					<li {% if agent.id in participant_ids %}class="on"{% endif %}>
						<input type="checkbox" name="{{replyBaseId}}_notepart" value="{{ agent.id }}" {% if agent.id in participant_ids %}checked="checked"{% endif %} />
						<label><span class="agent-pic agent-part-label-{{ agent.id }}" style="background-image: url({{ agent.getPictureUrl(16) }})">{{ agent.display_name }}</span></label>
						<div class="bound-fade"></div>
					</li>
				{% endif %}
			{% endfor %}
		</ul>
	</section>
	<footer>
		<button class="save-trigger">{{ phrase('agent.apply') }}</button>
	</footer>
</div>

</form>
