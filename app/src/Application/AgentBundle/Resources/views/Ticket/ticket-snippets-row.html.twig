<li class="snippet snippet-{{ snippet.id }}" data-snippet-id="{{ snippet.id }}">
	<div class="show">
		<div class="controls">
			<span class="edit-trigger"></span>
			<div class="insertBtn snippet-trigger" data-snippet-id="{{ snippet.id }}"><a>{{ phrase('agent.general.insert') }}</a></div>
		</div>
		<label>{{ snippet.title }}</label>
		<div class="content show">
			{% if no_formatting %}
				<div class="content raw text">{{ snippet.snippet }}</div>
				<div class="content raw html" display="none">{{ snippet.snippet_html }}</div>
			{% else %}
				<div class="content formatted">
					<div class="real">{{ snippet.snippetFormattedHtmlPreview(ticket, person)|raw }}</div>
					<div class="nobreak">{{ snippet.snippetFormattedHtmlPreview(ticket, person)|strip_linebreaks|raw }}</div>
				</div>
				<textarea class="value formatted text" style="display: none;">{{ snippet.snippetFormatted(ticket, person) }}</textarea>
				<textarea class="value formatted html" style="display: none;">{{ snippet.snippetFormattedHtml(ticket, person) }}</textarea>
			{% endif %}
			<div class="fadeaway">
				<span class="expand"></span>
				<span class="unexpand"></span>
			</div>
		</div>
	</div>
	<div class="edit" style="display: none">
		<form>
			<input type="hidden" name="snippet_id" value="{{ snippet.id }}" />
			<label><input type="text" name="title" value="{{ snippet.title }}" /></label>
			<div class="content">
				<textarea name="snippet">{{ snippet.snippet }}</textarea>
				<textarea name="snippet_html" style="display:none">{{ snippet.snippet_html }}</textarea>
				<input type="hidden" name="is_html" value="0" />
				<div class="edit-controls">
					<button class="clean-white save-snippet-trigger">{{ phrase('agent.general.update') }}</button>
					<button class="clean-white cancel-snippet-trigger">{{ phrase('agent.general.cancel') }}</button>
					<span class="delete-snippet-trigger" data-snippet-id="{{ snippet.id }}" style="cursor: pointer;">{{ phrase('agent.general.delete_snippet') }}</span>
				</div>
			</div>
		</form>
	</div>
</li>
