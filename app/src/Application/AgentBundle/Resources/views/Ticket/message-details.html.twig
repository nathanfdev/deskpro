{% extends 'AgentBundle:Ticket:message-details-layout.html.twig' %}
{% block current_page "detail" %}
{% block body %}
<section class="description-area">
<dl class="info-list">
	<dt>{{ phrase('agent.tickets.message_id') }}</dt>
	<dd>{{ message.id }}</dd>

	<dt>{{ phrase('agent.general.ticket_id') }}</dt>
	<dd>{{ ticket.id }}</dd>

	{#<dt>{{ phrase('agent.general.reference') }}</dt>
	<dd>{{ ticket.ref }}</dd>#}

	<dt>{{ phrase('agent.tickets.creation_system') }}</dt>
	<dd>{{ message.creation_system }}</dd>

	{% if message.email_source %}
		<dt>{{ phrase('agent.tickets.gateway_source_id') }}</dt>
		<dd>{{ message.email_source.id }}</dd>
	{% endif %}

	{% if message.email %}
		<dt>{{ phrase('agent.tickets.sent_from_address') }}</dt>
		<dd>{{ message.email }}</dd>
	{% endif %}

	{% if message.ip_address %}
		<dt>{{ phrase('agent.general.ip_address') }}</dt>
		<dd>{{ message.ip_address }}</dd>
	{% endif %}

	{% if message.visitor %}
		<dt>{{ phrase('agent.general.visitor_id') }}</dt>
		<dd>{{ message.visitor.id }}</dd>

		<dt>{{ phrase('agent.general.browser_agent') }}</dt>
		<dd>{{ message.visitor.last_track.user_agent }}</dd>

		<dt>{{ phrase('agent.general.initial_visit') }}</dt>
		<dd>{{ message.visitor.date_created|date('fulltime') }}</dd>

		<dt>{{ phrase('agent.general.last_activity') }}</dt>
		<dd>{{ message.visitor.date_last|date('fulltime') }}</dd>

		<dt>{{ phrase('agent.general.landing_page') }}</dt>
		<dd>{{ message.visitor.initial_track.page_url }}</dd>
	{% endif %}
</dl>

{% if app.user.can_admin %}
		<br/>
		<br/>
		<br/>
		<br/>

		<dl class="info-list" style="font-size: 11px;">
			<dt>Debug File</dt>
			<dd>
				<a href="{{ path('agent_ticket_download_debug_report', {ticket_id: message.ticket.id, _rt: security_token('request_token', 10800)}) }}">Download Debug File</a><br/>
				A DeskPRO support agent may ask you to provide this file to help diagnose issues.
			</dd>
		</dl>
	{% endif %}
</section>
{% endblock %}
