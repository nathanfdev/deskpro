{% extends 'AgentBundle:Ticket:message-details-layout.html.twig' %}
{% block current_page "unformatted" %}
{% block body %}
<section class="description-area">
<dl class="info-list">
	<dt>{{ phrase('agent.tickets.message_id') }}</dt>
	<dd>{{ message.id }}</dd>

	<dt>{{ phrase('agent.global.ticket_id') }}</dt>
	<dd>{{ ticket.id }}</dd>

	{#<dt>Ref</dt>
	<dd>{{ ticket.ref }}</dd>#}

	<dt>{{ phrase('agent.tickets.creation_system') }}</dt>
	<dd>{{ message.creation_system }}</dd>

	{% if message.email_source %}
		<dt>{{ phrase('agent.tickets.gateway_source_id') }}</dt>
		<dd>{{ message.email_source.id }}</dd>
	{% endif %}

	{% if message.email %}
		<dt>{{ phrase('agent.tickets.sent_from_address') }}</dt>
		<dd>{{ message.email }}</dd>
	{% endif %}

	{% if message.ip_address %}
		<dt>{{ phrase('agent.global.ip_address') }}</dt>
		<dd>{{ message.ip_address }}</dd>
	{% endif %}

	{% if message.visitor %}
		<dt>{{ phrase('agent.visitor_id') }}</dt>
		<dd>{{ message.visitor.id }}</dd>

		<dt>{{ phrase('agent.browser_agent') }}</dt>
		<dd>{{ message.visitor.user_agent }}</dd>

		<dt>{{ phrase('agent.initial_visit') }}</dt>
		<dd>{{ message.visitor.date_created|date('M j, Y H:ia') }}</dd>

		<dt>{{ phrase('agent.global.last_activity') }}</dt>
		<dd>{{ message.visitor.date_last|date('M j, Y H:ia') }}</dd>

		<dt>{{ phrase('agent.global.landing_page') }}</dt>
		<dd>{{ message.visitor.landing_page }}</dd>
	{% endif %}
</dl>
</section>
{% endblock %}
