{% import 'AgentBundle:Common:agent-macros.html.twig' as agentui %}
<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.NewTicket';
pageMeta.title = '{{ phrase('agent.general.new_ticket') }}';
pageMeta.ticket_id = 0;

pageMeta.labelsAutocompleteUrl        = '{{ path('agent_ajax_labels_autocomplete', {'label_type': 'ticket'}) }}';
pageMeta.uploadAttachUrl              = '{{ path('agent_accept_upload') }}';

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
{{ agentui.scroll_containers('page-new-ticket page-new-content') }}

<a class="tab-anchor" href="#">&nbsp;</a>

<form id="{{baseId}}_newticket" class="keybound-submit">

<input type="hidden" name="for_comment_type" id="{{baseId}}_for_comment_type" value="" />
<input type="hidden" name="for_comment_id" id="{{baseId}}_for_comment_id" value="" />
<input type="hidden" name="for_chat_id" id="{{baseId}}_for_chat_id" value="" />

<div class="pending-info comment" style="display: none;">
	<i class="reset"></i>
	<h3>{{ phrase('agent.tickets.creating_ticket_for_title') }} <span id="{{baseId}}_comment_title"></span></h3>
	<div class="pending-item pending-ticket">
		<div class="about">{{ phrase('agent.tickets.commented_on') }}: <a data-route="" class="with-route ticket-link" id="{{baseId}}_comment_object_link"></a></div>
		<div class="post-action">
			<select name="comment_action" id="{{baseId}}_comment_action">
				<option value="delete">{{ phrase('agent.general.ucfirst_delete') }}</option>
				<option value="approve">{{ phrase('agent.general.ucfirst_delete') }}</option>
			</select>
			{{ phrase('agent.tickets.coment_after_ticket_created') }}
		</div>
	</div>
</div>

<div class="pending-info chat" style="display: none;">
	<i class="reset"></i>
	<h3>{{ phrase('agent.tickets.creating_ticket_for_chat') }}: <span id="{{baseId}}_chat_title"></span></h3>
</div>

<div class="pending-info person" style="display: none;">
	<i class="reset"></i>
	{% set phrase_part %}<span id="{{baseId}}_person_title"></span>{% endset %}
	<h3>{{ phrase('agent.tickets.creating_ticket_for_title', {'title':phrase_part}) }}</h3>
</div>

<div class="section user-section first" id="{{baseId}}_user_section">
	<div class="step">
		<span class="num">1</span>
		<span class="check">{{ phrase('agent.general.done') }}</span>
	</div>
	<div class="content">
		<button class="clean-white small switch-user" id="{{baseId}}_switch_user" style="display: none">{{ phrase('agent.general.change_user') }}</button>
		<div id="{{baseId}}_choose_user">
			<div
				id="{{baseId}}_user_searchbox"
				data-element-handler="DeskPRO.Agent.ElementHandler.PersonSearchBox"
				data-search-url="{{ path('agent_peoplesearch_performquick', {'format': 'json', 'limit': 10, 'start_with': 'a'}) }}"
				data-highlight-term="1"
				data-touch-focus="1"
				data-search-param="term"
				data-position-bound="#{{baseId}}_userselect"
			>
				<input type="text" id="{{baseId}}_userselect" class="select-user term" placeholder="{{ phrase('agent.general.choose_person_for_ticket') }}" />
				<input type="hidden" name="newticket[person][id]" value="{{ person.id }}" class="person-id" id="{{baseId}}_person_id" />

				<script type="text/x-deskpro-tmpl" class="user-row-tpl">
					<li>
						<a>
						<span class="user-name"></span>
						<address>&lt;<span class="user-email"></span>&gt;</address>
						<div class="bound-fade"></div>
					</a></li>
				</script>
				<div class="person-search-box" style="display: none">
					<section>
						<ul class="results-list">

						</ul>
						<footer>
							<span class="create-user">{{ phrase('agent.general.create_a_new_person') }}</span>
						</footer>
					</section>
				</div>
			</div>
		</div>
		<div id="{{baseId}}_user_choice">

		</div>
		<div class="error-message person_id person_no_user">{{ phrase('agent.tickets.please_choose_or_create_user') }}</div>
		<div class="error-message person_email_address">{{ phrase('agent.general.please_enter_valid_email') }}</div>
		<br class="clear" />
	</div>
</div>

<div class="section department-section" id="{{baseId}}_dep_section">
	<div class="step">
		<span class="num">2</span>
		<span class="check">{{ phrase('agent.general.done') }}</span>
	</div>
	<div class="content">
		<div class="col">
			<h4>{{ phrase('agent.general.department') }}</h4>
			{% include 'AgentBundle:Common:select-department.html.twig' with {
				'name': "newticket[department_id]",
				'id': baseId ~ '_dep',
				'departments': ticket_options.departments_hierarchy
			} %}
		</div>
		<div class="col">
			<h4>{{ phrase('agent.general.status') }}</h4>
			<select name="newticket[status]" id="{{baseId}}_status">
				<option value="awaiting_agent" selected="selected">{{ phrase('agent.tickets.awaiting_agent') }}</option>
				<option value="awaiting_user">{{ phrase('agent.tickets.awaiting_user') }}</option>
				<option value="resolved">{{ phrase('agent.tickets.status_resolved') }}</option>
			</select>
		</div>
		<div class="col">
			<h4>{{ phrase('agent.general.assignment') }}</h4>
			<input type="hidden" name="newticket[agent_id]" value="0" id="{{baseId}}_agent_id" />
			<input type="hidden" name="newticket[agent_team_id]" value="0" id="{{baseId}}_agent_team_id" />
			<span id="{{baseId}}_assign_btn" class="menu-trigger">
				<span id="{{baseId}}_agent_label">{{ phrase('agent.general.me') }}</span>
				{% if app.getSetting('core.use_agent_team') %}{{ phrase('agent.general.and') }} <span id="{{baseId}}_agent_team_label">{{ phrase('agent.general.category') }}</span>{% endif %}
			</span>
		</div>
		{% if app.getSetting('core.use_ticket_category') %}
			<div class="col fieldprop ticket_category">
				<h4>{{ phrase('agent.general.category') }}</h4>
				{% include 'AgentBundle:Common:select-category.html.twig' with {
					'name': "newticket[category_id]",
					'id': baseId ~ '_cat',
					'categories': ticket_options.ticket_categories_hierarchy,
					'with_blank': true
				} %}
			</div>
		{% endif %}

		{% if app.getSetting('core.use_ticket_priority') %}
			<div class="col fieldprop ticket_priority">
				<h4>{{ phrase('agent.general.priority') }}</h4>
					{% include 'AgentBundle:Common:select-priority.html.twig' with {
						'name': "newticket[priority_id]",
						'id': baseId ~ '_pri',
						'add_classname': 'ticket_priority',
						'priorities': ticket_options.ticket_priorities,
						'with_blank': true
					} %}
			</div>
		{% endif %}

		{% if app.getSetting('core.use_ticket_workflow') %}
			<div class="col fieldprop ticket_workflow">
				<h4>{{ phrase('agent.general.workflow') }}</h4>
					{% include 'AgentBundle:Common:select-workflow.html.twig' with {
						'name': "newticket[workflow_id]",
						'id': baseId ~ '_work',
						'add_classname': 'ticket_workflow',
						'workflows': ticket_options.ticket_workflows,
						'with_blank': true
					} %}
			</div>
		{% endif %}

		{% if app.getSetting('core.use_product') %}
			<div class="col fieldprop ticket_product">
				<h4>{{ phrase('agent.general.product') }}</h4>
					{% include 'AgentBundle:Common:select-product.html.twig' with {
						'name': "newticket[product_id]",
						'id': baseId ~ '_prod',
						'add_classname': 'ticket_product',
						'products': ticket_options.products_hierarchy,
						'with_blank': true
					} %}
			</div>
		{% endif %}

		{% if custom_fields %}
			{% for f in custom_fields %}
				<br class="clear" />
				<div class="col fieldprop ticket-field ticket-field-{{f.field_def.id}} inline-field">
					<h4>{{f.title}}</h4>
					{{ render_custom_field_form(f) }}
				</div>
			{% endfor %}
		{% endif %}

		<br class="clear" />
	</div>
</div>

<div class="section subject-section" id="{{baseId}}_subject_section">
	<div class="step">
		<span class="num">3</span>
		<span class="check">{{ phrase('agent.general.done') }}</span>
	</div>
	<div class="content">
		<h4>{{ phrase('agent.general.subject') }}</h4>
		<input type="text" name="newticket[subject]" class="subject" id="{{baseId}}_subject" value="" />
		<div class="error-message subject">{{ phrase('agent.tickets.please_enter_subject') }}</div>
	</div>
</div>

<div class="section message-section" id="{{baseId}}_message_section">
	<div class="step">
		<span class="num">4</span>
		<span class="check">{{ phrase('agent.general.done') }}</span>
	</div>
	<div class="content">
		<h4>{{ phrase('agent.general.message') }}</h4>
		<textarea name="newticket[message]" class="ticket-message" id="{{baseId}}_message"></textarea>
		<div class="error-message message">{{ phrase('agent.tickets.please_enter_a_message') }}</div>
	</div>
</div>

<div class="section other-section" id="{{baseId}}_other_section">
	<div class="step">
		<span class="num">5</span>
		<span class="check">{{ phrase('agent.general.done') }}</span>
	</div>
	<div class="content">
		{# Tab Container #}
		<div class="tab-container">
			<nav id="{{baseId}}_other_props_tabs_wrap">
				<ul id="{{baseId}}_other_props_tabs">
					<li data-tab-for="> .tab-properties">{{ phrase('agent.general.properties') }}</li>
					<li data-tab-for="> .tab-cc">{{ phrase('agent.tickets.ccs') }}</li>
					<li data-tab-for="> .tab-attach">{{ phrase('agent.general.attachments') }}</li>
				</ul>
			</nav>
			<div class="content-wrapper" id="{{baseId}}_other_props_tabs_content" style="display: none">
				{# Tab Properties #}
				<div class="tab-properties" style="display: none">
					<dl>
						<dt class="prop type-labels">{{ phrase('agent.general.labels') }}:</dt>
						<dd class="prop ticket-tags tags-wrap">
							<input type="text" value="" />
						</dd>
					</dl>

					<br class="clear" />
				</div>
				{# /Tab Properties #}

				{# Tab CC #}
				<div class="tab-cc" style="display: none">
					<div class="cc-input">
						<div
							id="{{baseId}}_user_ccbox"
							data-element-handler="DeskPRO.Agent.ElementHandler.PersonSearchBox"
							data-search-url="{{ path('agent_peoplesearch_performquick', {'format': 'json', 'limit': 10, 'start_with': 'a'}) }}"
							data-highlight-term="1"
							data-touch-focus="1"
							data-search-param="term"
							data-position-bound="#{{baseId}}_userccselect"
						>
							<input type="text" id="{{baseId}}_userccselect" class="cc-user term" placeholder="{{ phrase('agent.tickets.search_for_people_to_add') }}" />

							<script type="text/x-deskpro-tmpl" class="user-row-tpl">
								<li>
									<a>
									<span class="user-name"></span>
									<address>&lt;<span class="user-email"></span>&gt;</address>
									<div class="bound-fade"></div>
								</a></li>
							</script>
							<div class="person-search-box" style="display: none">
								<section>
									<ul class="results-list">

									</ul>
									<footer>
										<span class="create-user">{{ phrase('agent.general.create_a_new_person') }}</span>
									</footer>
								</section>
							</div>
						</div>
					</div>
					<ul id="{{baseId}}_cc_list" class="cc-list"></ul>
				</div>
				{# /Tab CC #}

				{# Tab Attach #}
				<div class="tab-attach" style="display: none">
					{% include 'AgentBundle:Common:attach-row-tmpl.html.twig' with {formname: 'newticket[attach][]'} %}
					<h6>{{ phrase('agent.general.attachments') }}</h6>
					<div class="file-input">
						<input type="file" name="file-upload" multiple="multiple" /> <button class="clean-gray xxx-small">{{ phrase('agent.general.upload') }}</button>
					</div>
					<ul class="files file-list"></ul>
				</div>
				{# /Tab Attach #}
			</div>
		</div>
		{# /Tab Container #}
	</div>
</div>

<div class="optionbox reply-agent-team-ob newticket" id="{{baseId}}_agent_selector">
	<div class="col">
		<section data-section-name="agents">
			<header>
				<h3>{{ phrase('agent.general.agents') }}</h3>
				<input type="text" class="filter-box" placeholder="{{ phrase('agent.general.filter') }}" />
			</header>
			<ul>
				<li class="me last-me {% if ticket.agent.id == app.user.id or not ticket.agent %}on{% endif %}">
					<input type="radio" name="{{baseId}}_agent" value="{{ app.user.id }}" {% if ticket.agent.id == app.user.id or not ticket.agent %}checked="checked"{% endif %} />
					<label><span class="agent-pic agent-label-{{ app.user.id }}" style="background-image: url({{ app.user.getPictureUrl(16) }})">{{ phrase('agent.general.me') }}</span></label>
				</li>

				<li>
					<input type="radio" name="{{baseId}}_agent" value="0" />
					<label><span class="agent-pic agent-label-0">{{ phrase('agent.general.unassigned') }}</span></label>
				</li>

				{% for agent in agents %}
					{% if agent.id != app.user.id %}
						<li {% if ticket.agent.id == agent.id %}class="on"{% endif %}>
							<input type="radio" name="{{baseId}}_agent" value="{{ agent.id }}" {% if ticket.agent.id == agent.id %}checked="checked"{% endif %} />
							<label><span class="agent-pic agent-label-{{ agent.id }}" style="background-image: url({{ agent.getPictureUrl(16) }})">{{ agent.display_name }}</span></label>
							<div class="bound-fade"></div>
						</li>
					{% endif %}
				{% endfor %}
			</ul>
		</section>
	</div>
	{% if app.getSetting('core.use_agent_team') %}
		<div class="col">
			<section data-section-name="teams">
				<header>
					<h3>{{ phrase('agent.general.teams') }}</h3>
					<input type="text" class="filter-box" placeholder="{{ phrase('agent.general.filter') }}" />
				</header>
				<ul>
					{% for team in app.user.getAgent().getTeams() %}
						<li class="me {% if loop.last %}last-me{% endif %} {% if ticket.agent_team.id == team.id %}on{% endif %}">
							<input type="radio" name="{{baseId}}_agent_team" value="{{ team.id }}" {% if ticket.agent_team.id == team.id %}checked="checked"{% endif %} />
							<label class="agent-team-label-{{ team.id }}">{{ team.name }}</label>
							<div class="bound-fade"></div>
						</li>
					{% endfor %}

					<li class="{% if not ticket.agent_team %}on{% endif %}">
						<input type="radio" name="{{baseId}}_agent_team" value="0" {% if not ticket.agent_team %}checked="checked"{% endif %} />
						<label><span class="agent-team-label-0">{{ phrase('agent.general.no_team') }}</span></label>
					</li>

					{% for team in agent_teams %}
						{% if team.id not in app.user.getAgent().getTeamIds() %}
							<li {% if ticket.agent_team.id == team.id %}class="on"{% endif %}>
								<input type="radio" name="{{baseId}}_agent_team" value="{{ team.id }}" {% if ticket.agent_team.id == team.id %}checked="checked"{% endif %} />
								<label class="agent-team-label-{{ team.id }}">{{ team.name }}</label>
								<div class="bound-fade"></div>
							</li>
						{% endif %}
					{% endfor %}
				</ul>
			</section>
		</div>
	{% endif %}
	<br class="clear" />
</div>

<footer class="pop-footer">
	<div class="is-not-loading">
		<button class="submit-trigger clean-white">{{ phrase('agent.general.create_ticket') }} <kbd>{{ phrase('agent.tickets.kbd_alt_c') }}</kbd></button>
	</div>
	<div class="is-loading" style="padding-top: 9px;">
		<img src="{{ asset('images/spinners/loading-small-flat.gif') }}" />
	</div>
</footer>

</form>

{{ agentui.scroll_containers_end() }}
