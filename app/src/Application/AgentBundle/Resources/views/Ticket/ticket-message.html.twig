<article
	class="content-message message message-{{message.id}} {% if message.is_agent_note %}note-message{% elseif message.person.is_agent %}agent-message{% else %}user-message{% endif %} {% if ticket_message_attachments[message.id] %}with-attach{% endif %}"
	data-message-id="{{message.id}}"
>
	<div class="avatar"><img
			src="{{ message.person.getPictureUrl(40) }}"
			alt=""
			width="40"
			height="40"
			{% if not message.person.is_agent %}class="person-overview" data-route="person:{{ path('agent_people_view', {'person_id': message.person.id}) }}"{% endif %}
		/></div>
	<div class="content">
		<header>
			<span class="message-counter with-gear ticket-message-edit-btn" data-message-id="{{ message.id }}">#{{ loop.index }}</span>
			<h4	class="as-popover" data-route="person:{{ path('agent_people_view', {'person_id': message.person.id}) }}">{{message.person.name}}</h4>
			<time class="full-time" datetime="{{message.date_created|date('c')}}">{{message.date_created|date('M j Y, H:ia')}}</time>
			<time class="timeago" datetime="{{message.date_created|date('c')}}"></time>
		</header>
		<div class="body-text">
			{{message.message_html|safe_link_urls_html }}
			{% if ticket_message_attachments[message.id] %}
				<ul class="attachment-list">
					{% for attach_id in ticket_message_attachments[message.id] %}
						{% set ticket_attach = ticket_attachments[attach_id] %}
						<li class="{% if ticket_attach.blob.isImage() %}is-image{% else %}icon icon-attachment icon-filetype-{{ticket_attach.blob.extension|default('none')}}{% endif %}" rel="message-{{message.id}}">
							{% if ticket_attach.blob.isImage() %}
								<a href="{{ ticket_attach.blob.download_url }}" target="_blank"><img src="{{ path('serve_blob', {'blob_auth_id': ticket_attach.blob.auth_id, 'filename': ticket_attach.blob.filename_safe, 's': 50, 'size-fit': '1'}) }}" alt="" class="preview" /></a>
							{% endif %}
							<a href="{{ ticket_attach.blob.download_url }}" target="_blank">{{ticket_attach.blob.filename}}</a>
							<span class="size">({{ ticket_attach.blob.readable_filesize }})</span>
						</li>
					{% endfor %}
				</ul>
			{%endif%}
		</div>
		{% if all_feedback[message.id] %}
			{% set feedback = all_feedback[message.id] %}
			<div class="feedback">
                {{ phrase('agent.ticket.name_found_this_message_x', {{'name':feedback.person.display_name}}) }}
				{% if feedback.rating > 0 %}<em class="helpful">{{ phrase('agent.ticket.helpful') }}</em>{% else %}<em class="unhelpful">{{ phrase('agent.ticket.unhelpful') }}</em>{% endif %}
				{% if feedback.message %}<p>{{ feedback.message }}</p>{% endif %}
			</div>
		{% endif %}
	</div>
	<textarea class="message-quote-{{message.id}}" style="display: none">{{ message.message_quote }}</textarea>
</article>
{% if ticket_message_attachments[message.id] %}
	{% for attach_id in ticket_message_attachments[message.id] %}
		{% set ticket_attach = ticket_attachments[attach_id] %}
		<ul class="attachment-list attachment-lone" style="display: none;">
			<li class="{% if ticket_attach.blob.isImage() %}is-image{% else %}icon icon-attachment icon-filetype-{{ticket_attach.blob.extension|default('none')}}{% endif %}" rel="message-{{message.id}}">
				{% if ticket_attach.blob.isImage() %}
					<a href="{{ ticket_attach.blob.download_url }}" target="_blank"><img src="{{ path('serve_blob', {'blob_auth_id': ticket_attach.blob.auth_id, 'filename': ticket_attach.blob.filename_safe, 's': 50, 'size-fit': '1'}) }}" alt="" class="preview" /></a>
				{% endif %}
				<a href="{{ ticket_attach.blob.download_url }}" target="_blank">{{ticket_attach.blob.filename}}</a>
				<span class="size">({{ ticket_attach.blob.readable_filesize }})</span>
			</li>
		</ul>
	{% endfor %}
{% endif %}
