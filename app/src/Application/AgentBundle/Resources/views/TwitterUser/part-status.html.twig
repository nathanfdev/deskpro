{% if status.isRetweet() %}
	{% set retweet = status %}
	{% set status = status.retweet %}
{% else %}
	{% set retweet = null %}
{% endif %}
<div class="twitter-status status-{{ status.id }}" data-status-id="{{ status.id }}">
	<div class="photo" data-route="page:{{ path('agent_twitter_user', {'user_id': status.user.id}) }}">
		<img src="{{ status.user.profile_image_url }}" width="48" height="48" border="0" />
	</div>

	<h4>
		<span class="user" data-route="page:{{ path('agent_twitter_user', {'user_id': status.user.id}) }}">
			<span class="name">{{ status.user.name }}</span>
			<span class="screen-name">@{{ status.user.screen_name }}</span>
		</span>
		{% if status.isMessage() %}
			<span class="dm-notice">DM</span>
		{% endif %}
		{% if status.long %}
			<span class="long-notice">{% if status.long.is_public %}Long{% else %}Long Private{% endif %}</span>
		{% endif %}
	</h4>

	<div class="status-text">{{ status.long ? status.long.parsed_text|raw : status.parsed_text|raw }}</div>

	{% if status.isMessage() %}
		<time class="timeago" title="{{status.date_created|date('c', 'UTC')}}">{{status.date_created|date('day')}}</time>
	{% else %}
		<a href="https://twitter.com/{{ status.user.screen_name }}/status/{{ status.id }}" target="_blank" class="timeago" title="{{status.date_created|date('c', 'UTC')}}">{{status.date_created|date('day')}}</a>
	{% endif %}

	{% if status.in_reply_to_status or retweet %}
		<div class="extra-container">
			{% if status.in_reply_to_status %}
				{% set reply = status.in_reply_to_status %}
				<div class="in-reply-to">
					{{ phrase('agent.twitter.in_reply_to') }} <span class="user" data-route="page:{{ path('agent_twitter_user', {'user_id': reply.user.id}) }}"><strong>@{{ reply.user.screen_name }}</strong></span>
					"{{ reply.getClippedText(25) }}"
				</div>
			{% endif %}
			{% if retweet %}
				<div class="retweet">
					Retweeted by <span class="user" data-route="page:{{ path('agent_twitter_user', {'user_id': retweet.user.id}) }}"><strong>@{{ retweet.user.screen_name }}</strong></span>
				</div>
			{% endif %}
		</div>
	{% endif %}
</div>
