<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.TwitterUser';

pageMeta.title = '@{{user.screen_name|escape}}';
pageMeta.userId = '{{ user.id|escape }}';
pageMeta.pageIdentity = 'twitter:user:{{ user.id|escape }}';

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>

{# Page Containers #}
<div class="profile layout-content with-scrollbar">
<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
<div class="scroll-viewport"><div class="scroll-content">
{# /Page Containers #}

<header class="page-header">
	<nav class="actions" id="{{baseId}}_action_buttons">
		<ul>
			{% if user.id is not sameas(account.user.id) %}
				{% if user.id in account.friend_ids %}
					<li class="create-ticket"><button class="clean-white large">{{ phrase('agent.global.unfollow') }}</button></li>
				{% else %}
					<li class="create-ticket"><button class="clean-white large">{{ phrase('agent.global.follow') }}</button></li>
				{% endif %}
			{% endif %}
			<li class="create-ticket"><button class="clean-white large">{{ phrase('agent.global.message') }}</button></li>
		</ul>
	</nav>
	<div class="person-picture-box">
		<img src="{{ user.profile_image_url }}"  />
	</div>
	<div class="titlewrap">
		<h1>
			<span class="editable">@{{ user.screen_name}}</span>
		</h1>
		<div class="meta-line">
			<div class="org"><span>
				<span>{{ user.name }}</span><br />

			</span></div>
		</div>
	</div>
	<br class="clear" />
	<p>{{ user.description }}</p>
</header>

<style type="text/css">
	.table-content td { padding: 10px; }
	.table-content .title-col { font-weight: bold; }
	.tabbed article { padding: 10px; }
</style>

<table class="layout-table" cellspacing="0" cellpadding="0" width="100%">
<tr>
	<td valign="top" width="60%">
		<section class="content-col">
			{# Activity Tabs #}
			<div class="profile-box-container tabbed">
				<header>
					<nav>
						<ul>
							<li data-tab-for="#{{baseId}}_statuses_tab" class="on">{{ phrase('agent.global.statuses') }}</li>
							<li data-tab-for="#{{baseId}}_messages_tab">{{ phrase('agent.global.messages') }}</li>
							<li data-tab-for="#{{baseId}}_mentions_tab">{{ phrase('agent.global.mentions') }}</li>
						</ul>
					</nav>
				</header>
				<section>
					<article id="{{baseId}}_statuses_tab" class="on">
						{% for status in user.statuses %}
							{% include 'AgentBundle:TwitterUser:part-status.html.twig' %}
						{% else %}
							No Statuses for User
						{% endfor %}
					</article>
					<article id="{{baseId}}_messages_tab">
						{% for status in user.messages %}
							{% include 'AgentBundle:TwitterUser:part-status.html.twig' %}
						{% else %}
							No Messages for User
						{% endfor %}
					</article>
					<article id="{{baseId}}_mentions_tab">
						{% for status in user.mentions %}
							{% include 'AgentBundle:TwitterUser:part-status.html.twig' %}
						{% else %}
							No Mentions for User
						{% endfor %}
					</article>
				</section>
			</div>
			{# /Activity Tabs #}
		</section>
	</td>
	<td valign="top">
		<section class="property-col">
			{# Box Profile #}
				<div class="profile-box-container summary">
					<header>
						<h4>{{ phrase('agent.global.profile') }}</h4>
					</header>
					<section>
						<table class="table-content contact-list contact-list-wrapper" id="{{baseId}}_contact_display" width="100%">
							<tr class="row-table-cotent">
								<td class="col-table-content title-col">
									<span>{{ phrase('agent.global.language') }}</span>
								</td>
								<td width="70%"  class="col-table-content prop-val">
									{{ user.language }}
								</td>
							</tr>
							<tr class="row-table-cotent dark">
								<td class="col-table-content title-col">
									<span>{{ phrase('agent.twitter.location') }}</span>
								</div>
								<td width="70%"  class="col-table-content prop-val">
									{% if user.location is none %}{{ phrase('agent.twitter.unknown') }}{% else %}{{ user.location }}{% endif %}
								</td>
							</tr>
							<tr class="row-table-cotent">
								<td class="col-table-content title-col">
									<span>{{ phrase('agent.twitter.protected') }}</span>
								</td>
								<td width="70%"  class="col-table-content prop-val">
									{% if user.is_protected %}yes{% else %}no{% endif %}
								</td>
							</tr>
							<tr class="row-table-cotent dark">
								<td class="col-table-content title-col">
									<span>{{ phrase('agent.global.verified') }}</span>
								</td>
								<td width="70%"  class="col-table-content prop-val">
									{% if user.is_verified %}yes{% else %}no{% endif %}
								</td>
							</tr>
							<tr class="row-table-cotent">
								<td class="col-table-content title-col">
									<span>{{ phrase('agent.twitter.geo') }}</span>
								</td>
								<td width="70%" class="col-table-content prop-val">
									{% if user.is_geo_enabled %}yes{% else %}no{% endif %}
								</td>
							</tr>
						</table>
					</section>
				</div>
			{# /Box Profile #}
		</section>
	</td>
</tr>
</table>
{# Page Containers #}
</div>
</div>
</div>
{# /Page Containers #}
