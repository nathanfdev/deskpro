{% set user = follower.user %}
<article
	class="row-item twitter-user user-{{ user.id }} {% if follower.is_archived %}archived{% endif %}"
	data-user-id="{{ user.id }}"
>
	<div class="user-body">
		{% if follower.is_archived %}
			<i class="status-archived"></i>
		{% else %}
			<i class="status-archive"></i>
		{% endif %}
		<div class="photo" data-route="page:{{ path('agent_twitter_user', {'user_id': user.id}) }}">
			<img src="{{ user.profile_image_url }}" width="48" height="48" border="0" />
		</div>
		<div class="info">
			<h4 class="user" data-route="page:{{ path('agent_twitter_user', {'user_id': user.id}) }}">
				<span class="name">{{ user.name }}</span>
				<span class="screen-name">@{{ user.screen_name }}</span>
			</h4>
			<div class="description">{{ user.description }}</div>
		</div>
	</div>
	<div class="message-sent-confirmation" style="display: none">
		Message sent: <span class="message"></span>
	</div>
	<div class="new-reply" style="display: none">
		<form>
			<ul class="reply-type">
				<li class="on" data-type="public">
					<img src="{{ asset('images/agent/icons/twitter_public.png') }}" />
					<div>{{ phrase('agent.general.public') }}</div>
				</li>
				<li  data-type="private">
					<img src="{{ asset('images/agent/icons/twitter_private.png') }}" />
					<div>{{ phrase('agent.general.private') }}</div>
				</li>
			</ul>
			<input type="hidden" class="reply-type-hidden" name="type" value="public" />
			<div class="reply-block">
				{{ phrase('agent.twitter.from_account') }}: @{{ account.user.screen_name }}
				<textarea></textarea>
				<div class="is-not-loading">
					<button class="clean-white small save-reply-trigger">Send Message</button>
					<span class="cancel-reply-trigger">{{ phrase('agent.general.cancel') }}</span>
				</div>
				<div class="is-loading">
					{{ phrase('agent.general.saving') }}
				</div>
			</div>
		</form>
	</div>
	<div class="user-info">
		<ul>
			{% if user.id in account.friend_ids %}
				<li class="noval opt-trigger unfollow">
					<label>Unfollow</label><span class="drop-icon"></span>
				</li>
			{% else %}
				<li class="noval opt-trigger follow">
					<label>Follow</label><span class="drop-icon"></span>
				</li>
			{% endif %}
			<li class="noval opt-trigger message" style="float: right">
				<label>Message</label><span class="drop-icon"></span>
			</li>
		</ul>
	</div>
</article>