<!-- script src="http://code.jquery.com/jquery-1.10.1.min.js"></script -->

<form method="POST" class="actions-overlay export-jira" data-target="{{ path('jira_export', {'ticket_id': ticket.id}) }}" style="width: 650px; height: 570px;">
	<div class="overlay-title">
		<h4>{{ phrase('agent.jira.export_jira') }}</h4>
	</div>
	<div class="overlay-content">
		<div style="display: inline-block; width: 19%; float: left;">
			<label for="jira-issue-title">{{ phrase('agent.jira.labels.title')}} *</label>
		</div>
		<div style="display: inline-block; width: 77%; float: left; padding: 5px;">
			<input style="width: 100%" type="text" name="title" id="jira-issue-title" value="[{{ticket.ref}}] {{ticket.subject}}"/>
		</div>
		<br/>
		<br/>
		<div style="display: inline-block; width: 50%; float: left;">
			<label for="jira-issue-project">{{ phrase('agent.jira.labels.project')}} *</label>
			<select class="dpe_select"  style="width: 60%; float: right;" name="project" id="jira-issue-project">
				{% for project in projects %}
					<option value={{project.key}}>{{ project.name }}</option>
				{% endfor %}
			</select>
		</div>
		<div style="display: inline-block; width: 50%; float: left;">
			<label for="jira-issue-type">{{ phrase('agent.jira.labels.type')}} *</label>
			<select class="dpe_select" style="width: 60%; float: right;" name="issuetype" id="jira-issue-type"  data-style-type="icons" data-select-icon-size="22"></select>
		</div>
		<br/>
		<br/>
		<div style="display: inline-block; width: 50%; float: left;">
			<label for="jira-issue-priority">{{ phrase('agent.jira.labels.priority')}} *</label>
			<select class="dpe_select"  style="width: 60%; float: right;" name="priority" id="jira-issue-priority"></select>
		</div>
		<div style="display: inline-block; width: 50%; float: left;">
			<label for="jira-issue-assignee">{{ phrase('agent.jira.labels.assignee')}} *</label>
			<select class="dpe_select" style="width: 60%; float: right;" name="assignee" id="jira-issue-assignee"  data-style-type="icons" data-select-icon-size="22"></select>
		</div>
		<br/>	
		<br/>
		<div class="row">
			<div class="left" style="width: 20%">
				<label for="description">{{ phrase('agent.jira.labels.description') }} *</label>
			</div>
			<div class="right" style="width: 100%">
				<textarea id="description" name="description">{{description}}</textarea><br/>
				<div class="instruction">{{ phrase('agent.jira.labels.description.warning') }}. {{ phrase('agent.jira.labels.smarttags') }}
					<ol class="smart-tags">
						<li><span class="bold">@dp-agent</span>: The current agent</li>
						<li><span class="bold">@dp-department</span>: The department in which the ticket is raised.</li>
						<li><span class="bold">@dp-ticket</span>: The current ticket</li>
						<li><span class="bold">@dp-customer</span>: The customer</li>
					</ol>
				</div>
			</div>
		</div>
		<div class="row">
			<label for="label">{{ phrase('agent.jira.labels.labels') }}</label>
			<input type="text" style="width: 97%;" value="{{ app.getSetting('core.apps_jira.defaultTags') }}" id="labels" name="labels"/>
			<p class="instruction">{{ phrase('agent.jira.labels.labels.instrcution') }}</p>
		</div>
	</div>
	<div class="overlay-footer">
		<div class="is-not-loading">
			<button type="reset" id="jira-form-cancel" class="close  clean-white">{{ phrase('agent.general.reset') }}</button>
			<button type="submit" id="jira-form-submit" class="export clean-white">{{ phrase('agent.jira.labels.export') }}</button>
		</div>
		<div class="is-loading">
			<i class="flat-spinner"></i>
		</div>
	</div>
</form>
<script>
	$(document).off('change', '#jira-issue-project').on('change', '#jira-issue-project', lookupMeta);
	
	$(document).off('submit', 'form.export-jira').on('submit', 'form.export-jira', function(event){
		//return true;
		$("form.export-jira button").prop("disabled", true);
		
		var form	= $(this).closest('form');
		
		var url		= form.data('target');
		
		var formData = form.serialize();
		
		var jQxhr = $.post(url, formData, "json").done(function(data) {
			DeskPRO_Window.showAlert("Issue " + data.key + " created successfully");
			
			form.find("a.close").click();
		}).fail(function(xhr) {
			var response = jQuery.parseJSON(xhr.responseText);
			
			DeskPRO_Window._showAjaxError(response.message);
		}).always(function(){
			$("form.export-jira button").prop("disabled", false);
		});
		
		return false;
	});
	
	function selectProject(key)
	{
		$("#jira-issue-project").val(key);
		
		lookupMeta();
	}
	
	function lookupMeta()
	{
		var projectDropdown	= $('#jira-issue-project');
		
		var typeDropdown		= $('#jira-issue-type');
		var priorityDropdown	= $('#jira-issue-priority');
		var assigneeDropdown	= $('#jira-issue-assignee');
		
		typeDropdown.prop('disabled', true);
		
		try {
			typeDropdown.select2({
				enabled: false
			});
		} catch(err) {};
		
		priorityDropdown.prop('disabled', true);
		
		try {
			priorityDropdown.select2({
				enabled: false
			});
		} catch(err) {};
		
		assigneeDropdown.prop('disabled', true);
		
		try {
			assigneeDropdown.select2({
				enabled: false
			});
		} catch(err) {};
		
		var projectKey		= projectDropdown.val();
		
		$.getJSON( "{{ path('jira_lookup') }}",{
			"projectkey" : projectKey
		}).done(function(data) {
			if (data) {
				typeDropdown.html("");
				
				$.each(data.issuetypes, function(index, issuetype){
					typeDropdown.append("<option data-icon='" + issuetype.iconUrl + "' value='" + issuetype.id + "'>" + issuetype.name + "</option>");
				});
				
				priorityDropdown.html("");
				
				$.each(data.priorities, function(index, priority){
					priorityDropdown.append("<option data-icon='" + priority.iconUrl + "' value='" + priority.id + "'>" + priority.name + "</option>");
				});
				
				assigneeDropdown.html("");
				
				$.each(data.assignee, function(index, assignee){
					assigneeDropdown.append("<option data-icon='" + (assignee.avatarUrls.xsmall) + "' value='" + assignee.id + "'>" + assignee.displayName + "</option>");
				});
			} else {
				DeskPRO_Window._showAjaxError("{{ phrase('agent.jira.error') }}");
			}
		})
		.fail(function() {
			DeskPRO_Window._showAjaxError("{{ phrase('agent.jira.error') }}");
		})
		.always(function() {
			typeDropdown.prop('disabled', false);
			priorityDropdown.prop('disabled', false);
			assigneeDropdown.prop('disabled', false);
			
			$(".export-jira select.dpe_select").select2({
				formatResult: format,
				formatSelection: format,
				escapeMarkup: function(m) { return m; }
			});
		});
	}
</script>