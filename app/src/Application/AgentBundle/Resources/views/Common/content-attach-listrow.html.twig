<li class="blob-{{ blob.id }}" data-blob-id="{{ blob.id }}">
	{% if blob.isImage() %}
		<img src="{{ path('serve_blob', {'blob_auth_id': blob.auth_id, 'filename': blob.filename, 's': 50, 'size-fit': '1'}) }}" alt="" class="preview" />
	{% endif %}
	<a href="{{ blob.download_url }}" target="_blank">{{ blob.display_title }}</a>
	<span class="size">({{ blob.readable_filesize }})</span>
	{% if insert_controls %}
		<div class="insert-controls">
			<label>
				<input type="blob_append[]" value="{{ blob.id }}" checked="checked" />
				List as an attachment to the article
			</label>
			and/or <a href="" class="insert-link" data-blob-id="{{ blob.id }}">link to the file from within the article</a>
			<div class="insert-controls-overlay">
				<div class="overlay-title" style="padding:  6px;">
					{{ phrase('agent.common.insert_title', {'title':blob.display_title}) }}
				</div>
				<div class="overlay-content" style="padding-bottom: 15px; max-height: 500px overflow: auto;">

					<strong>{{ phrase('agent.common.url') }}</strong><br />
					<input type="hidden" class="insert-url-code" value="![attach:{{ blob.id }} url]" />
					<button class="dp-button">{{ phrase('agent.common.insert') }} {{ phrase('agent.common.url') }}</button><br />
					{{ phrase('agent.common.this_will_insert_a_plaintext_url_to_the') }}

					<hr />

					<strong>{{ phrase('agent.common.link') }}</strong><br />
					<input type="hidden" class="insert-link-code" value="![attach:{{ blob.id }} link:{{ '{{label}}' }}]" />
					{{ phrase('agent.common.label') }}: <input type="text" class="link-label" value="{{ blob.display_title }}" /> <button class="dp-button">{{ phrase('agent.common.insert_link') }}</button><br />
					This will insert a link to the file with the label as the clickable link text.

					{% if blob.isImage() %}
						<hr />

						<strong>{{ phrase('agent.common.full_image') }}</strong>
						<input type="hidden" class="insert-image-code" value="![attach:{{ blob.id }} image]" />
						<button class="dp-button">{{ phrase('agent.common.insert') }} Image</button><br />
						{{ phrase('agent.common.this_will_insert_the_fullsized_image') }}

						<hr />

						<strong>{{ phrase('agent.common.link') }}ed Thumbnail</strong>
						<input type="hidden" class="insert-thumb-code" value="![attach:{{ blob.id }} thumb:{{ '{{width}},{{height}}' }}]" />
						{{ phrase('agent.common.width') }}: <input type="text" class="thumb-width" value="50" />
						{{ phrase('agent.common.height') }}: <input type="text" class="thumb-height" value="50" />
						<button class="dp-button">{{ phrase('agent.common.insert_thumbnail') }}</button><br />
						This will insert a thumbnail image that links to the full-sized image.
					{% endif %}
				</div>
			</div>
		</div>
	{% endif %}
</li>
