<li class="snippet snippet-{{ snippet.id }}" data-snippet-id="{{ snippet.id }}">
	<div class="show">
		<div class="controls">
			<span class="edit-trigger"></span>
			<span class="delete-trigger" data-snippet-id="{{ snippet.id }}" data-confirm="Are you sure you want to delete this snippet?"></span>
		</div>
		<div class="snippet-content tipped" title="Click to insert this snippet" data-snippet-id="{{ snippet.id }}">
			<label>{{ snippet.title }}</label>
			<div class="content show">
				<div class="main-content">
					{% if no_formatting %}
						<div class="content raw">{{ snippet.snippet }}</div>
					{% else %}
						<div class="content formatted">
							<div class="real">{{ snippet.formatPreviewHtml()|raw }}</div>
							<div class="nobreak">{{ snippet.formatPreviewHtml()|strip_linebreaks|raw }}</div>
						</div>
						<textarea class="value formatted" style="display: none;">{{ snippet.format() }}</textarea>
					{% endif %}
				</div>
				<div class="fadeaway">
					<span class="expand"></span>
					<span class="unexpand"></span>
				</div>
			</div>
		</div>
	</div>
	<form class="edit" style="display: none">
			<input type="hidden" name="snippet_id" value="{{ snippet.id }}" />
			<label><input type="text" name="title" value="{{ snippet.title }}" /></label>
			<textarea name="snippet">{{ snippet.snippet }}</textarea>
	</form>
</li>
