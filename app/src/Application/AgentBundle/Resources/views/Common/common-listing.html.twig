{% extends 'AgentBundle::list-pane-layout.html.twig' %}
{% import 'AgentBundle:Common:agent-macros.html.twig' as agentui %}
{% block top %}
	<script>
		{% block pagemeta %}{% endblock %}
	</script>
{% endblock %}
{% block pane_content %}
	{% block content_top %}{% endblock %}

	{% set tmp = block('control_bar') %}
	{% if tmp|trim|length %}
		<header class="list-control-bar">{{ tmp|raw }}</header>
	{% endif %}

	{% set tmp = block('grouping_bar') %}
	{% if tmp|trim|length %}
		<header class="list-grouping-bar">{{ tmp|raw }}</header>
	{% endif %}

	{% set tmp = block('selection_bar') %}
	{% if tmp|trim|length %}
		<header class="list-selection-bar">{{ tmp|raw }}</header>
	{% endif %}

	{% block prelist %}{% endblock %}

	{% set tmp = block('listing') %}
	{% if tmp|trim|length %}
		<section class="list-listing">{{ tmp|raw }}</section>
	{% endif %}

	{% set tmp = block('result_nav') %}
	{% if tmp|trim|length %}
		<footer class="results-nav">{{ tmp|raw }}</footer>
	{% endif %}

	{% block postlist %}{% endblock %}

	{% block bottom %}{% endblock %}
{% endblock %}
