<article class="cat-section cat-{{ category.id }}" data-category-id="{{ category.id }}" style="display:none;">
	<ul>
		<li class="new-snippet">
			<button class="clean-white add-snippet-trigger">{{ phrase('agent.general.add_new_snippet') }}</button>
		</li>
		{% set has_snippets = true %}
		{% for snippet in snippets %}
			{% include 'AgentBundle:Common:text-snippets-row.html.twig' %}
		{% else %}
			{% set has_snippets = false %}
		{% endfor %}
		<li class="no-snippets" {% if has_snippets %}style="display: none"{% endif %}>This category has no snippets.</li>
	</ul>
</article>
