<div class="edit-snippet-category field-overlay" style="display: none">
	<span class="close"></span>
	<input type="hidden" name="category_id" value="{{ category.id }}" />
	<dl>
		<dt>{{ phrase('global.title') }}:</dt>
		<dd><input type="text" name="title" value="{{ category.title }}" /></dd>

		<dt>{{ phrase('global.permissions') }}:</dt>
		<dd>
			<label><input type="radio" class="perm-type-opt" name="perm_type" value="me" {% if perm_type == 'me' %}checked="checked"{% endif %} /> {{ phrase('global.just_me') }}</label><br />
			<label><input type="radio" class="perm-type-opt" name="perm_type" value="team" {% if perm_type == 'team' %}checked="checked"{% endif %} /> {{ phrase('global.teams') }}</label><br />
			<label><input type="radio" class="perm-type-opt" name="perm_type" value="global" {% if perm_type == 'global' %}checked="checked"{% endif %} /> {{ phrase('global.everyone') }}</label><br />
		</dd>

		<dt class="perm-teams" style="display: none">{{ phrase('global.teams') }}:</dt>
		<dd class="perm-teams" style="display: none">
			<select name="teams[]" multiple="multiple" size="6">
				{% for team in agent_teams %}
					<option value="{{ team.id }}">{{ team.name }}</option>
				{% endfor %}
			</select>
		</dd>
	</dl>

	<div class="controls">
		<button class="clean-white small save-trigger">{{ phrase('global.save')}}</button>
		<button class="clean-white small delete-trigger">{{ phrase('global.ucfirst_delete') }}</button>
	</div>
</div>
