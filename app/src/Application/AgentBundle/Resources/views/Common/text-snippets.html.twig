<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.TextSnippetViewer';
</script>
<div class="ticket-snippets-overlay snippets-overlay">
	<nav>
		<header>
			<span class="new-category"></span>
			<h4>{{ phrase('agent.categories') }}</h4>
		</header>
		<ul>
			{% for category in text_snippet_cats %}
				{% include 'AgentBundle:Common:text-snippets-catrow.html.twig' %}
			{% endfor %}
		</ul>
	</nav>
	<div class="snippet-sections-wrap">
		{# Page Containers #}
		<div class="layout-content with-scrollbar">
		<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
		<div class="scroll-viewport"><div class="scroll-content snippet-sections">
		{# /Page Containers #}
			{% for category in text_snippet_cats %}
				{% set group = text_snippets[category.id] %}
				{% include 'AgentBundle:Common:text-snippets-catsection.html.twig' with {'category': category, 'snippets': group.snippets} %}
			{% else %}
				<div class="no-cats-message" {% if ticket_snippet_cats|length %}style="display: none"{% endif %}>
					{{ phrase('agent.snippets_none_explain') }}
				</div>
			{% endfor %}
        {# Page Containers #}
        </div></div>
        </div>
        {# /Page Containers #}
	</div>

	<div class="new-snippet-category field-overlay" style="display: none">
		<span class="close">{{ phrase('agent.close_lc') }}</span>
		<dl>
			<dt>{{ phrase('agent.title') }}:</dt>
			<dd>
				<input type="text" name="title" value="New Category" />
				<input type="hidden" name="typename" value="{{ typename }}" />
			</dd>

			<dt>{{ phrase('agent.permissions') }}:</dt>
			<dd>
				<label><input type="radio" class="perm-type-opt" name="perm_type" value="me" {% if perm_type == 'me' %}checked="checked"{% endif %} /> {{ phrase('agent.just_me') }}</label><br />
				<label><input type="radio" class="perm-type-opt" name="perm_type" value="team" {% if perm_type == 'team' %}checked="checked"{% endif %} /> {{ phrase('agent.teams') }}</label><br />
				<label><input type="radio" class="perm-type-opt" name="perm_type" value="global" {% if perm_type == 'global' %}checked="checked"{% endif %} /> {{ phrase('agent.everyone') }}</label><br />
			</dd>

			<dt class="perm-teams" style="display: none">{{ phrase('agent.teams') }}:</dt>
			<dd class="perm-teams" style="display: none">
				<select name="teams[]" multiple="multiple" size="6">
					{% for team in agent_teams %}
						<option value="{{ team.id }}">{{ team.name }}</option>
					{% endfor %}
				</select>
			</dd>
		</dl>

		<div class="controls">
			<button class="clean-white small new-cat-trigger">{{ phrase('agent.add') }}</button>
		</div>
	</div>
</div>
