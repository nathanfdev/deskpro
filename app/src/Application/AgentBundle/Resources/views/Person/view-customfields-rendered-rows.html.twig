<table class="prop-table" cellpadding="0" cellspacing="0" width="100%">
	{% for f in custom_fields %}
	{% if f.hasValue %}
	<tr>
		<th>{{ f.title }}</th>
		<td>{{ render_custom_field(f) }}</td>
	</tr>
	{% endif %}
	{% endfor %}
	<tr>
		<th>{{ phrase('agent.timezone') }}</th>
		<td>
			{{ person.timezone }} (GMT {{ person.getTimezoneOffset(true) }}, {{ phrase('agent.local_time') }}: {{ person.date_time|date('H:ia M j Y', person) }})
		</td>
	</tr>
</table>