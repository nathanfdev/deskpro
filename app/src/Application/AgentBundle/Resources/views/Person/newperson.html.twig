{% import 'AgentBundle:Common:agent-macros.html.twig' as agentui %}
<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.NewPerson';
pageMeta.title = '{{ phrase('agent.global.new_person') }}';

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
{{ agentui.scroll_containers('page-new-news page-new-content') }}
{{ start_counter('steps') }}

<a class="tab-anchor" href="#">&nbsp;</a>

<form id="{{baseId}}_newperson" class="keybound-submit">
<div class="drop-file-zone"><h1>{{ phrase('agent.person.drop_your_vcard_here') }}</h1></div>
<script class="template-upload" type="text/x-tmpl">
    {{ '{% for (var i=0, file; file=o.files[i]; i++) { %}' }}
    <p>{{ '{%=file.name%}' }} ({{ phrase('agent.global.saving') }})</p>
    {{ '{% } %}' }}
</script>
<script class="template-download" type="text/x-tmpl">
</script>
<div class="first section cat-section" id="{{baseId}}_email_section">
	<div class="step">
		<span class="num">{{ inc_counter('steps') }}</span>
		<span class="check">{{ phrase('agent.global.done') }}</span>
	</div>
	<div class="content">
		<h4>{{ phrase('agent.global.email') }}</h4>
		<input type="text" name="newperson[email]" id="{{baseId}}_email" value="" class="fill" />
	</div>
</div>

<div class="section cat-section" id="{{baseId}}_name_section">
	<div class="step">
		<span class="num">{{ inc_counter('steps') }}</span>
		<span class="check">{{ phrase('agent.global.done') }}</span>
	</div>
	<div class="content">
		<h4>{{ phrase('agent.global.name') }}</h4>
		<input type="text" name="newperson[name]" id="{{baseId}}_name" value="" class="fill" />
	</div>
</div>


<div class="section title-section" id="{{baseId}}_org_section">
	<div class="step">
		<span class="num">{{ inc_counter('steps') }}</span>
		<span class="check">{{ phrase('agent.global.done') }}</span>
	</div>
	<div class="content">
		<h4>{{ phrase('agent.global.organization') }}</h4>
		<div
			class="org-input"
			id="{{baseId}}_org_searchbox"
			data-element-handler="DeskPRO.Agent.ElementHandler.OrgSearchBox"
			data-search-url="{{ path('agent_orgsearch_quicknamesearch', {'format': 'json', 'limit': 10, 'start_with': 'a'}) }}"
			data-highlight-term="1"
			data-touch-focus="1"
			data-search-param="term"
			data-position-bound=".org-name"
			data-super-container=".page-new-content"
		>
			<input type="text" class="org-name fill" name="newperson[new_organization]" placeholder="{{ phrase('agent.global.enter_an_organization_name') }}" value="" />
			<input type="hidden" class="org-id" id="{{baseId}}_org_id" name="newperson[organization_id]" value="" />
			<script type="text/x-deskpro-tmpl" class="user-row-tpl">
				<li>
					<a>
					<span class="org-name"></span>
					<div class="bound-fade"></div>
				</a></li>
			</script>
			<div class="person-search-box org" style="display: none">
				<section>
					<ul class="results-list">

					</ul>
					<footer>
						<span class="create-org">{{ phrase('agent.global.create_a_new_organization') }}</span>
					</footer>
				</section>
			</div>

			<div id="{{baseId}}_org_pos" style="display: none; margin-top: 10px">
				<h4>{{ phrase('agent.global.position') }}</h4>
				<input type="text" name="newperson[organization_position]" value="" size="40" />
			</div>
		</div>
	</div>
</div>

{% if custom_fields|length %}
<div class="section title-section" id="{{baseId}}_fields_section">
	<div class="step">
		<span class="num">{{ inc_counter('steps') }}</span>
		<span class="check">{{ phrase('agent.global.done') }}</span>
	</div>
	<div class="content">
        {% for f in custom_fields %}
        	<h4>{{ f.title }}</h4>
        	{{ render_custom_field_form(f) }}
        	<br />
        {% endfor %}
	</div>
</div>
{% endif %}

<div class="section other-section" id="{{baseId}}_other_section">
	<div class="step">
		<span class="num">{{ inc_counter('steps') }}</span>
		<span class="check">{{ phrase('agent.global.done') }}</span>
	</div>
	<div class="content">
		{# Tab Container #}
		<div class="tab-container">
			<nav id="{{baseId}}_other_props_tabs_wrap">
				<ul id="{{baseId}}_other_props_tabs">
					<li data-tab-for="> .tab-properties">{{ phrase('agent.global.properties') }}</li>
				</ul>
			</nav>
			<div class="content-wrapper" id="{{baseId}}_other_props_tabs_content" style="display: none">
				{# Tab Properties #}
				<div class="tab-properties" style="display: none">
					<dl>
						<dt class="prop">{{ phrase('agent.global.labels') }}</dt>
						<dd class="prop">
							<div class="tags-wrap article-tags">
								<input type="text" value="{% for label in state.newperson.labels %}{{label}},{% endfor %}"/>
							</div>
						</dd>

						{% if usergroup_names|length %}
						<dt class="prop">{{ phrase('agent.global.usergroups') }}</dt>
						<dd class="prop">
							<div id="{{baseId}}_ug_container">
								<select name="newperson[usergroups][]">
									{% for id,name in usergroup_names %}
										<option value="{{ id }}">{{ name }}</option>
									{% endfor %}
								</select>
							</div>
						</dd>
						{% endif %}

						<dt class="prop">{{ phrase('agent.global.timezone') }}</dt>
						<dd class="prop">
							<select id="{{baseId}}_timezone" name="newperson[timezone]" data-placeholder="{{ phrase('agent.global.timezone') }}" style="width: 200px">
								<option></option>
								{% for tz in timezone_options %}
									<option value="{{tz}}">{{ tz }}</option>
								{% endfor %}
							</select>
						</dd>
					</dl>
				</div>
				{# /Tab Properties #}

				<br class="clear" />
			</div>
		</div>
		{# /Tab Container #}
	</div>
</div>

<footer class="pop-footer">
	<div class="is-not-loading">
		<button class="submit-trigger clean-white">{{ phrase('agent.person.create_person') }} <kbd>{{ phrase('agent.global.altc') }}</kbd></button>
	</div>
	<div class="is-loading" style="padding-top: 9px;">
		<img src="{{ asset('images/spinners/loading-small.gif') }}" />
	</div>
</footer>

</form>

{{ agentui.scroll_containers_end() }}
