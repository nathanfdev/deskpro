{# Box Contact #}
<div class="profile-box-container summary">
	<header>
		{% if app.user.hasPerm('agent_people.edit') %}<span class="edit-gear contact-edit"></span>{% endif %}
		<h4>{{ phrase('agent.people.contact_info') }}</h4>
	</header>
	<section>
		<div class="table-content contact-list contact-list-wrapper" id="{{baseId}}_contact_display">
			{% include 'AgentBundle:Person:view-contact-display.html.twig' %}
		</div>
	</section>
</div>
{# /Box Contact #}

<div id="{{baseId}}_contact_outside"></div>

{# Organization Box #}
{% if person.organization or app.user.hasPerm('agent_people.edit') %}
	<div class="profile-box-container summary" id="{{baseId}}_org_box">
		<header id="{{baseId}}_org_display_header">
			{% if app.user.hasPerm('agent_people.edit') %}
				<div class="controls">
					<span class="edit-gear org-edit-trigger"></span>
					<div class="is-loading">{{ phrase('agent.loading_saving') }}</div>
					<button class="cancel" style="display: none">{{ phrase('agent.cancel') }}</button>
					<button class="save" id="{{baseId}}_org_edit_save" style="display: none">{{ phrase('agent.save') }}</button>
					<button class="remove-org" id="{{baseId}}_org_edit_remove_org" style="display: none">{{ phrase('agent.remove') }}</button>
					<button class="is-loading">{{ phrase('agent.loading_saving') }}</button>
					<button class="saved" style="display: none">{{ phrase('agent.saved') }}</button>
				</div>
			{% endif %}
			<h4>{{ phrase('agent.organization') }}</h4>
		</header>
		<section>
			<div class="org-info" id="{{baseId}}_org_display_wrap">
				{% if person.organization %}
					{% include 'AgentBundle:Person:view-org-info.html.twig' %}
				{% endif %}
			</div>
			<div class="org-edit" style="display: none" id="{{baseId}}_org_edit_wrap">
				<div
					class="org-input"
					id="{{baseId}}_org_searchbox"
					data-element-handler="DeskPRO.Agent.ElementHandler.OrgSearchBox"
					data-search-url="{{ path('agent_orgsearch_quicknamesearch', {'format': 'json', 'limit': 10, 'start_with': 'a'}) }}"
					data-highlight-term="1"
					data-touch-focus="1"
					data-search-param="term"
					data-position-bound="@parent(.org-input)"
				>
					<table cellspacing="0" cellpadding="0" width="100%"><tr><td style="white-space: nowrap;" valign="middle">
						<label>{{ phrase('agent.organization') }}:</label>
					</td><td width="100%">
						<input type="text" class="org-name" placeholder="{{ phrase('agent.person.enter_an_organization_name') }}" value="{{ person.organization.name }}" />
					</td></tr></table>

					<input type="hidden" class="org-id" value="{{ person.organization.id|default(0) }}" />
					<script type="text/x-deskpro-tmpl" class="user-row-tpl">
						<li><a>
							<span class="org-name"></span>
							<div class="bound-fade"></div>
						</a></li>
					</script>
					<div class="person-search-box org" style="display: none">
						<section>
							<ul class="results-list">

							</ul>
							{% if app.user.hasPerm('agent_org.create') %}
								<footer>
									<span class="create-org">{{ phrase('agent.create_a_new_org') }}</span>
								</footer>
							{% endif %}
						</section>
					</div>
				</div>
				<div class="pos-input" {% if not person.organization %}style="display: none"{% endif %}>
					<table cellspacing="0" cellpadding="0" width="100%"><tr><td style="white-space: nowrap;" valign="middle">
						<label>{{ phrase('agent.position') }}:</label>
					</td><td width="100%">
						<input type="text" class="org-pos-set" placeholder="{{ phrase('agent.set_a_org_pos') }}" value="{{ person.organization_position }}" />
					</td></tr></table>
				</div>
			</div>
		</section>
	</div>
{% endif %}
{# /Organization Box #}
