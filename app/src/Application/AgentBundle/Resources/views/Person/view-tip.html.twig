<div class="person-tip">
	<div class="picture">
		<img src="{{ person.getPictureUrl(80) }}" width="80" height="80" />
	</div>
	<div class="info">
		<h3>{{ person.display_name }}</h3>
		<div class="email">{{ person.primary_email_address }}</div>
		<dl>
			{% if person.organization %}
				<dt>{{ phrase('agent.organization') }}</dt>
				<dd>{{ person.organization.name }} {% if person.organization_position %}({{ person.organization_position }}){% endif %}</dd>
			{% endif %}
			{% if person.usergroups|length %}
				<dt>{{ phrase('agent.usergroup') }}</dt>
				<dd>
					{% for u in person.usergroups %}
						{{ u.title }}{% if not loop.last %},{% endif %}
					{% endfor %}
				</dd>
			{% endif %}
			<dt>{{ phrase('agent.date_created') }}</dt>
			<dd>{{ person.date_created|date('day') }}</dd>
		</dl>
	</div>
	<br class="clear" />
</div>
