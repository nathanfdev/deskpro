<li class="people inside"
	data-type="people"
	data-route="page:{{ path('agent_people_view', {'person_id': person.id}) }}"
	data-route-notabreload="1"
>
	<div class="dismiss"><i class="icon-ban-circle"></i></div>
	<time></time>
	<big>New registration: {{ person.getDisplayContact() }}</big>
	<small>
		New registration
		{% if not person.is_agent_confirmed %}requires validation{% endif %}
	</small>
</li>
