<li class="ticket"
	data-type="tickets"
	data-route="page:{{ path('agent_people_view', {'person_id': person.id}) }}"
	data-route-notabreload="1"
	data-icon="{{ asset('images/agent/app-nav/app-people.png') }}"
>
	<em class="dismiss"></em>
	<time class="timeago"></time>
	<a>New registration: {{ person.getDisplayContact() }}</a>
	<div class="info">
		New registration
		{% if not person.is_agent_confirmed %}requires validation{% endif %}
	</div>
</li>
