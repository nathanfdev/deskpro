<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.TwitterStatus';

pageMeta.title = '{{ type|capitalize|escape }}: @{{ account.user.screen_name|escape }}';
pageMeta.accountId = '{{ account.id|escape }}';
pageMeta.pageIdentity = 'twitter:{{ type|escape }}:{{ account.id|escape }}';

pageMeta.statusListUrl = '{{ path(twitter_list_route, {'account_id': account.id}) }}?partial=1';
pageMeta.saveNoteUrl = '{{ path('agent_twitter_status_ajaxsave_note') }}';
pageMeta.saveRetweetUrl = '{{ path('agent_twitter_status_ajaxsave_retweet') }}';
pageMeta.saveReplyUrl = '{{ path('agent_twitter_status_ajaxsave_reply') }}';
pageMeta.saveArchiveUrl = '{{ path('agent_twitter_status_ajaxsave_archive') }}';
pageMeta.saveFollowUrl = '{{ path('agent_twitter_user_ajaxsave_follow') }}';
pageMeta.saveUnfollowUrl = '{{ path('agent_twitter_user_ajaxsave_unfollow') }}';
pageMeta.standardStatusLimit = 160;
</script>

{# scroll containers #}
<div class="layout-content with-scrollbar page-listing">
<div class="scrollbar disable"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
<div class="scroll-viewport"><div class="scroll-content">
{# /scroll containers #}

<div class="layout-content twitter">
	{% include 'AgentBundle:TwitterStatus:part-note.html.twig' %}
	{% include 'AgentBundle:TwitterStatus:part-reply.html.twig' %}

	{% include 'AgentBundle:TwitterStatus:list-control-bar.html.twig' with { 'twitter_list_route': twitter_list_route } %}
	{% include 'AgentBundle:TwitterStatus:list-massactions-bar.html.twig' %}

	<div class="content">
			{% include 'AgentBundle:TwitterStatus:part-status.html.twig' %}
	</div>
</div>

{# scroll containers #}
</div></div></div></div>
{# /scroll containers #}
