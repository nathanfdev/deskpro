<section class="comments-list list-listing">
{% for status in statuses %}
{% if status.isRetweet is sameas(true) %}
	{% set retweet = status %}
	{% set status = status.retweet %}
{% else %}
	{% set retweet = null %}
{% endif %}

<style type="text/css">
	.status table { margin: 5px 0; }
	.status .user { display: inline; }
	.status .user * { font-size: 10px; display: inline; }
	.status .user-info .retweet { float: right; }
	.status .user-info .reply { float: right; }
	.status td { padding: 0 5px 5px 0; text-align: left; }
	.status .status-text { }
	.status .screen_name { display: inline; }
	.status .status-text p.raw { background: #eee; display: block; width: 100%; min-height: 37px; }
	.status .status-text p.raw span { margin: 5px; display: block; }
	.status .controls-row { margin-top: 10px; }
	.status .note { backgroud: #fff; margin-left: 20px; border: 1px solid #ddd; padding: 2px 5px; font-size: 10px; }
</style>

<article class="row-item status status-{{ status.id }}{% if retweet %} retweet {% endif %}{%if status.in_reply_to_status %} reply {% endif %}" data-status-id="{{ status.id }}" data-user-id="{{ status.user.id }}">
	<table width="100%" cellpadding="0" cellspacing="0" >
		<tr>
			<td width="20px" valign="middle">
				<input
					class="item-select"
					type="checkbox"
					value="{{ info.content_type }}.{{info.content_id}}"
					data-content-type="{{ info.content_type }}"
					data-comment-id="{{ status.id }}"
					style="vertical-align: middle"
				/>
			</td>
			<td>
				<table width="100%" cellpadding="0" cellspacing="0" >
					<tr class="user-info">
						<td colspan="2">
							<div class="top-row-left">
								{% if status.in_reply_to_status %}
									{% set reply = status.in_reply_to_status %}
									<div class="reply">
										{{ phrase('agent.twitterstatus.in_reply_to') }} <span class="user" data-route="page:{{ path('agent_twitter_user', {'user_id': reply.user.id}) }}"><strong>@{{ reply.user.screen_name }}</strong></span>
										"{{ reply.getClippedParsedText(2)|raw }}..."
									</div>
								{% endif %}
								{% if retweet %}
									<div class="retweet">
										{{ phrase('agent.twitterstatus.retweet_of') }} <span class="user" data-route="page:{{ path('agent_twitter_user', {'user_id': retweet.user.id}) }}"><strong>@{{ retweet.user.screen_name }}</strong></span>
										"{{ retweet.getClippedParsedText(2)|raw }}..."
									</div>
								{% endif %}
								<div class="user" data-route="page:{{ path('agent_twitter_user', {'user_id': status.user.id}) }}">
									<h4 class="screen_name">@{{ status.user.screen_name }}</h4> /
									<span class="name">{{ status.user.name }}</span>
								</div>
							</div>
						</td>
					</tr>
					<tr>
						<td class="avatar" width="48px">
							<div class="photo" data-route="page:{{ path('agent_twitter_user', {'user_id': status.user.id}) }}">
								<img src="{{ status.user.profile_image_url }}" width="48" height="48" border="0" />
							</div>
							<div class="user-meta">
								{% if status.user.id is not sameas(account.user.id) %}
									{% if status.user.id in account.friend_ids %}
										<button class="clean-white small unfollow"><a>{{ phrase('global.unfollow') }}</a></button>
									{% else %}
										<button class="clean-white small follow"><a>{{ phrase('global.follow') }}</a></button>
									{% endif %}
								{% endif %}
							</div>
						</td>
						<td>
							<div class="status-text">
									<p class="raw"><span>{{ status.parsed_text|raw }}</span></p>
							</div>

							<div class="">
								{% if status.notes.count %}

									{% for note in status.notes %}
										<p class="note" data-note-id="{{ note.id }}">
											Note "<span class="text">{{ note.text }}</span>"
											by <span class="user with-route" data-route="person:{{ path('agent_people_view', {'person_id': note.person.id }) }}">{{ note.person.name }}</span>
											<span class="timestamp">
												<span class="timeago" title="{{ note.date_created|date('c') }}">{{ note.date_created|date('r') }}</span>
											</span>
										</p>
									{% endfor %}
								{% endif %}

							</div>

							
						</td>
					</tr>
					<tr>
						<td colspan="2">
							<div class="controls-row">
								<div class="bound-faded"></div>
								<span class="controls">
									<button class="clean-white small status-archive"><a>{% if status.is_archived %}Archived{% else %}Archive{% endif %}</a></button>
									<button class="clean-white small status-reply"><a>{{ phrase('global.reply') }}</a></button>
									{% if status.isMessage is sameas(false) %}
										<button class="clean-white small status-retweet"><a>{{ phrase('agent.twitterstatus.retweet') }}</a></button>
									{% endif %}
									<button class="clean-white small status-assign"><a>{{ phrase('global.assign') }}</a></button>
									<button class="clean-white small status-note"><a>{{ phrase('agent.twitterstatus.add_note') }}</a></button>
								</span>
								<div class="forms">
								</div>
							</div>
						</td>
				</table>
			</td>
		</tr>
	</table>
</article>
{% else %}
    <p class="twitter-no-results">{{ phrase('global.there_are_no_results') }}</p>
{% endfor %}
</section>
