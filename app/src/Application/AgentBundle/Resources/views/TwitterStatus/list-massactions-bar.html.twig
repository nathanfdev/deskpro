<header class="list-selection-bar">
    <input type="checkbox" class="selection-control" /> {% set phrase_part %}<span class="{{ phrase('agent.twitter.selected') }}-count">0</span>{% endset %}{{ phrase('agent.twitter.selected', {'count':phrase_part}, true) }}
    <a class="perform-action perform-actions-trigger disabled">
        <span>{{ phrase('agent.twitter.perform_action') }}</span>
    </a>

    <ul class="actions-menu" style="display: none" data-menu-type="twitter-status-actions-menu">
        <li data-action="archive">
            {{ phrase('agent.general.archive') }}
        </li>
        <li class="sep">-</li>
        <li data-action="reply">
            {{ phrase('agent.general.reply') }}
        </li>
        <li class="sep">-</li>
        <li data-action="assign">
            {{ phrase('agent.general.assign') }}
        </li>
    </ul>
</header>
