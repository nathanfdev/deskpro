<li>
	<div class="photo" data-route="page:{{ path('agent_twitter_user', {'user_id': reply.status.user.id}) }}">
		<img src="{{ reply.status.user.profile_image_url }}" width="24" height="24" border="0" />
	</div>

	<h6>
		<span class="user" data-route="page:{{ path('agent_twitter_user', {'user_id': reply.status.user.id}) }}">
			<span class="name">{{ reply.status.user.name }}</span>
			<span class="screen-name">@{{ reply.status.user.screen_name }}</span>
		</span>
		{% if reply.status.isMessage() %}
			<span class="dm-notice">DM</span>
		{% endif %}
		{% if reply.status.long %}
			<span class="long-notice">{% if reply.status.long.is_public %}Long{% else %}Long Private{% endif %}</span>
		{% endif %}
	</h6>

	<div class="status-text">{{ reply.status.long ? reply.status.long.parsed_text|raw : reply.status.parsed_text|raw }}</div>

	{% if reply.status.isMessage() %}
		<time class="timeago" title="{{reply.status.date_created|date('c', 'UTC')}}">{{reply.status.date_created|date('day')}}</time>
	{% else %}
		<a href="https://twitter.com/{{ reply.status.user.screen_name }}/status/{{ reply.status.id }}" target="_blank" class="timeago" title="{{reply.status.date_created|date('c', 'UTC')}}">{{reply.status.date_created|date('day')}}</a>
	{% endif %}
</li>
