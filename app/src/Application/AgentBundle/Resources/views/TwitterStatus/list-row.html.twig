{% if account_status.status.isRetweet() %}
	{% set retweet = account_status.status %}
	{% set status = account_status.status.retweet %}
{% else %}
	{% set retweet = null %}
	{% set status = account_status.status %}
{% endif %}

<article
	class="row-item twitter-status status-{{ account_status.id }} {% if account_status.is_archived %}archived{% endif %} {% if retweet %}retweet{% endif %} {%if status.in_reply_to_status %}reply{% endif %} {% if status.recipient %}dm{% endif %}"
	data-status-id="{{ account_status.id }}"
	data-user-id="{{ status.user.id }}"
>
	<div class="title">
		<input
			class="item-select"
			type="checkbox"
			value="twitter_account_status.{{account_status.id}}"
			data-content-type="twitter_account_status"
			data-content-id="{{ account_status.id }}"
		/>
		{% if account_status.is_archived %}
			<i class="status-archived"></i>
		{% else %}
			<i class="status-archive"></i>
		{% endif %}
		<h4 class="user" data-route="page:{{ path('agent_twitter_user', {'user_id': status.user.id}) }}">
			<span class="name">{{ status.user.name }}</span>
			<span class="screen-name">@{{ status.user.screen_name }}</span>
		</h4>
	</div>
	<div class="status-body">
		<div class="photo" data-route="page:{{ path('agent_twitter_user', {'user_id': status.user.id}) }}">
			<img src="{{ status.user.profile_image_url }}" width="48" height="48" border="0" />
		</div>
		<!--<div class="user-meta">
			{% if status.user.id is not sameas(account.user.id) %}
				{% if status.user.id in account.friend_ids %}
					<button class="clean-white small unfollow"><a>{{ phrase('agent.general.unfollow') }}</a></button>
				{% else %}
					<button class="clean-white small follow"><a>{{ phrase('agent.general.follow') }}</a></button>
				{% endif %}
			{% endif %}
		</div>-->

		<div class="status-text">{{ status.parsed_text|raw }}</div>

		<time class="timeago" title="{{status.date_created|date('c', 'UTC')}}">{{status.date_created|date('day')}}</time>

		{% if status.in_reply_to_status or retweet %}
			<div class="extra-container">
				{% if status.in_reply_to_status %}
					{% set reply = status.in_reply_to_status %}
					<div class="in-reply-to">
						{{ phrase('agent.twitter.in_reply_to') }} <span class="user" data-route="page:{{ path('agent_twitter_user', {'user_id': reply.user.id}) }}"><strong>@{{ reply.user.screen_name }}</strong></span>
						"{{ reply.getClippedText(25) }}"
					</div>
				{% endif %}
				{% if retweet %}
					<div class="retweet">
						Retweeted by <span class="user" data-route="page:{{ path('agent_twitter_user', {'user_id': retweet.user.id}) }}"><strong>@{{ retweet.user.screen_name }}</strong></span>
					</div>
				{% endif %}
			</div>
		{% endif %}
	</div>
	<div class="reply-list" {% if not account_status.replies|length %}style="display:none"{% endif %}>
		<ul class="twitter-replies">
		{% for reply in account_status.replies %}
			{% include 'AgentBundle:TwitterStatus:reply-li.html.twig' %}
		{% endfor %}
		</ul>
	</div>
	<div class="new-reply" style="display: none">
		<form>
			<ul class="reply-type">
				<li {% if not status.recipient %}class="on"{% endif %} data-type="public">
					<img src="{{ asset('images/agent/icons/twitter_public.png') }}" />
					<div>{{ phrase('agent.general.public') }}</div>
				</li>
				<li {% if status.recipient %}class="on"{% endif %} data-type="private">
					<img src="{{ asset('images/agent/icons/twitter_private.png') }}" />
					<div>{{ phrase('agent.general.private') }}</div>
				</li>
			</ul>
			<input type="hidden" class="reply-type-hidden" name="type" value="{{ status.recipient ? 'private' : 'public' }}" />
			<div class="reply-block">
				{{ phrase('agent.twitter.from_account') }}: @{{ account_status.account.user.screen_name }}
				<textarea></textarea>
				<div class="is-not-loading">
					<button class="clean-white small save-reply-trigger">Reply</button>
					<span class="cancel-reply-trigger">{{ phrase('agent.general.cancel') }}</span>
				</div>
				<div class="is-loading">
					{{ phrase('agent.general.saving') }}
				</div>
			</div>
		</form>
	</div>
	<div class="status-notes notes-wrap" {% if not account_status.notes|length %}style="display: none"{% endif %}>
		<h5>Notes</h5>
		<ul class="note-list">
			{% for note in account_status.notes %}
				{% include 'AgentBundle:TwitterStatus:note-li.html.twig' with {'note': note} %}
			{% endfor %}
		</ul>
	</div>
	<div class="new-note" style="display: none">
		<div class="note-input">
			<textarea></textarea>
			<div class="is-not-loading">
				<button class="clean-white small save-note-trigger">Add Note</button>
				<span class="cancel-note-trigger">{{ phrase('agent.general.cancel') }}</span>
			</div>
			<div class="is-loading">
				{{ phrase('agent.general.saving') }}
			</div>
		</div>
	</div>
	<div class="status-info">
		<ul>
			<li class="noval opt-trigger {% if account_status.is_favorited %}favorited{% else %}add-favorite{% endif %}"></li>
			<li class="noval opt-trigger reply">
				<label>Reply</label><span class="drop-icon"></span>
			</li>
			{% if not status.isMessage() and status.user.id != account_status.account.user.id and (not retweet or retweet.user.id != account_status.account.user.id) %}
				{% if account_status.retweeted %}
					<li class="noval opt-trigger retweeted">
						<label>Retweeted</label><span class="drop-icon"></span>
					</li>
				{% else %}
					<li class="noval opt-trigger retweet">
						<label>Retweet</label><span class="drop-icon"></span>
					</li>
				{% endif %}
			{% endif %}
			<li class="note-btn" style="float:right;">
				<label>Add Note</label><span class="drop-icon"></span>
			</li>
			<li class="noval opt-trigger agent" style="overflow:hidden; height: 18px; position: relative; float: right;">
				<label>
					{% if account_status.agent and account_status.agent.id != app.user.id %}{{ account_status.agent.display_name }}
					{% elseif account_status.agent and account_status.agent.id == app.user.id %}Me
					{% elseif account_status.agent_team %}{{ account_status.agent_team.name }}
					{% else %}None{% endif %}
				</label><span class="drop-icon"></span>
				<select class="agents_sel dpe_select"  style="min-width: 170px; display: none" data-invisible-trigger="1">
					<option {% if not account_status.agent and not account_status.agent_team %}selected="selected"{% endif %} value="">None</option>
					<optgroup label="Agents">
						{% for agent in app.getDataRepository('Agent').getAgents() %}
							<option {% if account_status.agent and agent.id == account_status.agent.id %}selected="selected"{% endif %} data-icon="{{ agent.getPictureUrl(20) }}" value="agent:{{ agent.id }}">{{ agent.display_name }}</option>
						{% endfor %}
					</optgroup>
					{% if app.getDataRepository('AgentTeam').getTeams()|length %}
						<optgroup label="Teams">
							{% for team in app.getDataRepository('AgentTeam').getTeams() %}
								<option value="agent_team:{{ team.id }}" {% if account_status.agent_team and account_status.agent_team.id == team.id %}selected="selected"{% endif %}>{{ team.name }}</option>
							{% endfor %}
						</optgroup>
					{% endif %}
				</select>
			</li>
		</ul>
	</div>
</article>
