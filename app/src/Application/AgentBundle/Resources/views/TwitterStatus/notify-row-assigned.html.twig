<li class="ticket"
	data-type="tickets"
	{% if account_status.agent %}
		data-route="listpane:{{ path('agent_twitter_mine_list', {'account_id': account_status.account.id}) }}"
	{% elseif account_status.agent_team %}
		data-route="listpane:{{ path('agent_twitter_team_list', {'account_id': account_status.account.id}) }}"
	{% endif %}
	data-route-notabreload="1"
	data-icon="images/agent/app-nav/app-twitter.png"
>
	<em class="dismiss"></em>
	<time class="timeago"></time>
	<a><i class="row-icon"></i> Tweet</a>
	<div class="info">
		{% if account_status.agent %}
			Assigned to this tweet by {{ performer.display_name }}
		{% elseif account_status.agent_team %}
			Your team was assigned to this tweet by {{ performer.display_name }}
		{% endif %}
	</div>
</li>
