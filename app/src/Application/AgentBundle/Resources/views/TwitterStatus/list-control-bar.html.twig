{% if twitter_list_route != 'agent_twitter_outgoing_list' %}
<header class="header">
	<div class="list-control-bar">
		<ul class="btn-controls">
			{% if account %}<li><label><input name="account" type="checkbox" style="position: relative; top: 2px" /> Show <img src="{{ account.user.profile_image_url }}" width="16" height="16" alt="" style="position: relative; top: 4px" /> @{{ account.user.screen_name }}'s tweets</label></li>{% endif %}
			<li><label><input name="archived" type="checkbox" style="position: relative; top: 2px" /> {{ phrase('agent.twitter.show_archived_tweets') }}</label></li>
		</ul>
	</div>
</header>
{% endif %}