<thead>
<tr>
    <th width="20">
    </th>
    <th ng-repeat="field in getDisplayableFields()" ng-switch="field">

        {# Id #}
        <span ng-switch-when="id">{{ phrase('agent.general.id') }}</span>

        {# Name with title #}
        <span ng-switch-when="name_with_title">{{ phrase('agent.general.name') }}</span>

        {# Email #}
        <span ng-switch-when="email">{{ phrase('agent.general.email') }}</span>

        {# Tickets count #}
        <span ng-switch-when="num_tickets">{{ phrase('agent.general.number_of_tickets') }}</span>

        {# Organization #}
        <span ng-switch-when="org">{{ phrase('agent.general.organization_name') }}</span>

        {# Organization position #}
        <span ng-switch-when="org_pos">{{ phrase('agent.general.org_position') }}</span>

        {# Labels #}
        <span ng-switch-when="labels">{{ phrase('agent.general.labels') }}</span>

        {#<span ng-switch-default>{{ ng_var('getFieldDisplayName(field)') }}</span>#}

    </th>
</tr>
</thead>
