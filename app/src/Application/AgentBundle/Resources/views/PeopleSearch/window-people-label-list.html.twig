{% if people_tag_index|length %}
	<dl>
		{% for letter,labels in people_tag_index %}
			<dt>{{ letter }}</dt>
			<dd>
				<ul>
					{% for label in labels %}
						<li id="people_label_list_{{label|slugify}}" class="is-nav-item"><span data-route="listpane:{{ path('agent_peoplesearch_customfilter') }}?terms[0][type]=person_label&amp;terms[0][op]=is&amp;terms[0][label]={{label}}">{{label}}</span></li>
					{% endfor %}
				</ul>
			</dd>
		{% endfor %}
	</dl>
	<br class="clear"/>
{% else %}
	<span class="no-labels">{{ phrase('agent.general.no_people_labels') }}</span>
{% endif %}
