<div class="display-terms overlay">
	<div class="overlay-title">
		<h4>{{ phrase('agent.search') }}</h4>
	</div>
	<div class="overlay-content">
		<div style="margin-right: 250px;">
			<div class="search-form">
				<form action="{{ path('agent_peoplesearch_customfilter') }}" method="post" class="people_search_form">
					<input type="hidden" name="copy_display_options" value="{{cache_id}}" />
					<div class="search-form">
						<div class="search-terms"></div>
						<div class="term"><span class="add-term">+</span> {{ phrase('agent.add_search_term') }}</div>
					</div>
				</form>
			</div>

			<div class="search-builder-tpl" style="display:none">
				<div class="row">
					<div class="term">
						<div class="type"></div>
						<div class="op"></div>
						<div class="options"></div>
						<div class="remove">-</div>
					</div>
				</div>
				<div class="type" title="{{ phrase('agent.organization') }}" data-rule-type="organization">
					<div class="op">
						<select name="op">
							<option value="is">{{ phrase('agent.is') }}</option>
							<option value="not">{{ phrase('agent.is_not') }}</option>
						</select>
					</div>
					<div class="options">
						<select name="organization">
							{% for id,title in titles.organizations %}
								<option value="{{id}}">{{title}}</option>
							{% endfor %}
						</select>
					</div>
				</div>
				<div class="type" title="{{ phrase('agent.usergroup') }}" data-rule-type="usergroup">
					<div class="op">
						<select name="op">
							<option value="is">{{ phrase('agent.is') }}</option>
							<option value="not">{{ phrase('agent.is_not') }}</option>
						</select>
					</div>
					<div class="options">
						<select name="usergroup">
							{% for id,title in titles.usergroups %}
								<option value="{{id}}">{{title}}</option>
							{% endfor %}
						</select>
					</div>
				</div>
				<div class="type" title="{{ phrase('agent.search.person_id') }}" data-rule-type="id">
					<div class="op">
						<select name="op">
							<option value="gte">{{ phrase('agent.is_greater_than') }}</option>
							<option value="lte">{{ phrase('agent.is_less_than') }}</option>
						</select>
					</div>
					<div class="options">
						<input type="text" name="id" value="" />
					</div>
				</div>
				<div class="type" title="{{ phrase('agent.language') }}" data-rule-type="language">
					<div class="op">
						<select name="op">
							<option value="is">{{ phrase('agent.is') }}</option>
							<option value="not">{{ phrase('agent.is_not') }}</option>
						</select>
					</div>
					<div class="options">
						<select name="language">
							{% for id,title in titles.languages %}
								<option value="{{id}}">{{title}}</option>
							{% endfor %}
						</select>
					</div>
				</div>

				<div class="type" title="{{ phrase('agent.email_domain') }}" data-rule-type="email_domain">
					<div class="op">
						<select name="op">
							<option value="is">{{ phrase('agent.is') }}</option>
							<option value="not">{{ phrase('agent.is_not') }}</option>
						</select>
					</div>
					<div class="options">
						<input type="text" name="email_domain" value="" />
					</div>
				</div>
				<div class="type" title="{{ phrase('agent.email_domain') }}" data-rule-type="email_domain">
					<div class="op">
						<select name="op">
							<option value="is">{{ phrase('agent.is') }}</option>
							<option value="not">{{ phrase('agent.is_not') }}</option>
						</select>
					</div>
					<div class="options">
						<input type="text" name="email_domain" value="" />
					</div>
				</div>
				<div class="type" title="{{ phrase('agent.labels') }}" data-rule-type="label">
					<div class="op">
						<select name="op">
							<option value="is">{{ phrase('agent.includes_label') }}</option>
							<option value="not">{{ phrase('agent.does_not_include_label') }}</option>
						</select>
					</div>
					<div class="options">
						<input type="text" name="label" value="" />
					</div>
				</div>
				<div class="type" title="{{ phrase('agent.name') }}" data-rule-type="name">
					<div class="op">
						<select name="op">
							<option value="contains">{{ phrase('agent.is') }}</option>
							<option value="notcontains">{{ phrase('agent.is_not') }}</option>
						</select>
					</div>
					<div class="options">
						<input type="text" name="name" value="" />
					</div>
				</div>
				<div class="type" title="{{ phrase('agent.contact_phone') }}" data-rule-type="contact_phone">
					<div class="op">
						<select name="op">
							<option value="contains">{{ phrase('agent.is') }}</option>
							<option value="notcontains">{{ phrase('agent.is_not') }}</option>
						</select>
					</div>
					<div class="options">
						<input type="text" name="phone" value="" />
					</div>
				</div>
				<div class="type" title="{{ phrase('agent.contact_address') }}" data-rule-type="contact_address">
					<div class="op">
						<select name="op">
							<option value="contains">{{ phrase('agent.is') }}</option>
							<option value="notcontains">{{ phrase('agent.is_not') }}</option>
						</select>
					</div>
					<div class="options">
						<input type="text" name="address" value="" />
					</div>
				</div>
				<div class="type" title="{{ phrase('agent.contact_instant_messaging') }}" data-rule-type="contact_im">
					<div class="op">
						<select name="op">
							<option value="contains">{{ phrase('agent.is') }}</option>
							<option value="notcontains">{{ phrase('agent.is_not') }}</option>
						</select>
					</div>
					<div class="options">
						<input type="text" name="im" value="" />
					</div>
				</div>
				{% if people_fields %}
					{% set op_lang = {'is': phrase('agent.is'), 'not':phrase('agent.is_not'), 'contains': 'has', 'notcontains': 'does not have', 'gt': phrase('agent.is_greater_than'), 'lt': phrase('agent.is_less_than')} %}
					{% for field in people_fields %}
						<div class="type" title="Field: {{field.field_def.title}}" data-rule-type="person_field[{{field.field_def.id}}]">
							<div class="op">
								<select name="op">
									{% for op in field.field_def.search_capabilities %}
										<option value="{{op}}">{{op_lang[op]}}</option>
									{% endfor %}
								</select>
							</div>
							<div class="options">
								{{ form_widget(field.formView) }}
							</div>
						</div>
					{% endfor %}
				{% endif %}
			</div>
		</div>
	</div>
	<div class="overlay-actions">
		<div class="loading-off">
			<button class="save-trigger dp-button small">{{ phrase('agent.search') }}</button>
		</div>
		<div class="loading-on" style="display:none">
			<span>{{ phrase('agent.saving') }}</span>
		</div>
	</div>
</div>
