{% extends 'AgentBundle:Common:display-options-layout.html.twig' %}
{% block other_options %}
	<div style="display: none">
		{{ phrase('agent.peoplesearch.order_by') }}: <select name="order_by" class="sel-order-by">
			<option value="person.id:desc" class="date_created">{{ phrase('agent.peoplesearch.date_craeted_newestoldest') }}</option>
			<option value="person.id:asc">{{ phrase('agent.peoplesearch.date_craeted_oldestnewest') }}</option>
			<option value="person.name:asc" class="people_name">{{ phrase('agent.peoplesearch.name') }} (A-Z)</option>
			<option value="person.name:desc">{{ phrase('agent.peoplesearch.name') }} (Z-A)</option>
			<option value="people.date_last_login:desc" class="last_login">{{ phrase('agent.peoplesearch.last_login_time') }}</option>
			<option value="people.organization:asc" class="org">{{ phrase('agent.peoplesearch.organization') }}</option>
			<option value="people.num_tickets:desc" class="num_tickets">{{ phrase('agent.peoplesearch.number_of_tickets') }}</option>
		</select>
	</div>
{% endblock %}
{% block display_elements_list %}
	<li data-field="subject" {% if not show_all %}style="display: none"{% endif %}><label><input type="checkbox" name="name" {% if not show_all or 'name' in display_fields %}checked="checked"{% endif %} /> {{ phrase('agent.peoplesearch.name') }}</label></li>
	<li data-field="email" {% if not show_all %}style="display: none"{% endif %}><label><input type="checkbox" name="email" {% if not show_all or 'email' in display_fields %}checked="checked"{% endif %} /> {{ phrase('agent.peoplesearch.email_address') }}</label></li>
	<li data-field="org" {% if not show_all %}style="display: none"{% endif %}><label><input type="checkbox" name="org" {% if not show_all or 'org' in display_fields %}checked="checked"{% endif %} /> {{ phrase('agent.peoplesearch.organization') }}</label></li>
	<li data-field="org_pos" {% if not show_all %}style="display: none"{% endif %}><label><input type="checkbox" name="org_pos" {% if not show_all or 'org_pos' in display_fields %}checked="checked"{% endif %} /> {{ phrase('agent.peoplesearch.position') }}</label></li>
	<li data-field="language"><input type="checkbox" name="language" {% if 'language' in display_fields %}checked="checked"{% endif %} /> {{ phrase('agent.language') }}</li>
	<li data-field="labels"><input type="checkbox" name="labels" {% if 'labels' in display_fields %}checked="checked"{% endif %} /> {{ phrase('agent.peoplesearch.labels') }}</li>
	<li data-field="num_tickets"><input type="checkbox" name="num_tickets" {% if 'num_tickets' in display_fields %}checked="checked"{% endif %} /> {{ phrase('agent.peoplesearch.number_of_tickets') }}</li>
	{% for f in person_field_defs %}
		<li data-field="person_fields[{{f.id}}]"><input type="checkbox" name="person_fields[{{f.id}}]" {% if "person_fields[#{f.id}]" in display_fields %}checked="checked"{% endif %} /> {{f.title}}</li>
	{% endfor %}
{% endblock %}
