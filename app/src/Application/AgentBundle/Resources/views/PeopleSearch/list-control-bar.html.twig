<header class="list-control-bar">
	<ul class="btn-controls">
		<li class="display-options display-options-trigger"><a></a></li>
		<li class="right"><span class="sep"></span></li>
		<li class="detail-view detail-view-trigger"><a class="setupIcon"></a></li>
		<li class="right"><span class="sep"></span></li>
	</ul>
	<ul>
		<li>{{ phrase('agent.ordered_by') }} </li>
		<li class="order-by-menu-trigger menu-fitted" data-menu-button=".button"><a class="button">
			<span class="label">
				{% if 'name' in cache.criteria.order_by %}
					Name
				{% elseif 'date_last_login' in cache.criteria.order_by %}
					Last Login Time
				{% elseif 'organization' in cache.criteria.order_by %}
					Organization
				{% elseif 'num_tickets' in cache.criteria.order_by %}
					Number of Tickets
				{% else %}
					{{ phrase('agent.date_created') }}
				{% endif %}
			</span>
			<em></em>
		</a></li>
		<li><span class="sep"></span></li>
	</ul>

	<ul class="order-by-menu" style="display: none">
		<li data-order-by="people_name">Name</li>
		<li data-order-by="date_created">{{ phrase('agent.date_created') }}</li>
		<li data-order-by="last_login">Last Login Time</li>
		<li data-order-by="org">Organization</li>
		<li data-order-by="num_tickets">Number of Tickets</li>
	</ul>

	{% include 'AgentBundle:PeopleSearch:list-display-options-overlay.html.twig' %}
</header>
