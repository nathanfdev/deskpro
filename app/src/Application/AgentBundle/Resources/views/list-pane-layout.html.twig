{% import 'AgentBundle:Common:agent-macros.html.twig' as layout %}
{% set _nothing %}{% block dp_declare %}{% endblock %}{% endset %}
{% block top %}{% endblock %}
<div class="list-pane-instance {{ add_classname }}">
	<div class="list-pane-header">
		{% block pane_header %}{% endblock %}
	</div>
	<div class="list-pane-content">
		{% block pane_content_outscroll %}{% endblock %}

		{{ layout.scroll_containers() }}
			{% block pane_content %}{% endblock %}
		{{ layout.scroll_containers_end() }}
	</div>
</div>