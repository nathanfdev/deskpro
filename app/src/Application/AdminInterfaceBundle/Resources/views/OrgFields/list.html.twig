{% extends 'AdminInterfaceBundle:Layout:list.html.twig' %}
{% block listpane_content %}
	<section class="dp-paneblock dp-listpane">
		<header>
			<nav>
				<span dp-ping-flash="display_orders" class="saved-ping"><i class="fa fa-check-square-o-square"></i> {{ phrase('agent.general.saved') }}</span>
				{% include 'AdminInterfaceBundle:Layout:standard-settings-menu.html.twig' %}
			</nav>

			<h3 ng-pluralize count="ListCtrl.custom_fields.length || 0"
				when="{{ ng_plural_phrase('adm.general.count_custom_fields') }}"></h3>
		</header>
		<article>
			<ul class="dp-item-list" ui-sortable="ListCtrl.sortedListOptions" dp-max-height>
				<li ng-repeat="field in ListCtrl.custom_fields"
					class="with-drag-handle"
					dp-state-mark="crm.org_fields.edit.{{ ng_var('field.id') }}"
					data-id="{{ ng_var('field.id') }}">
					<a href="{{ ng_href('crm.org_fields.edit', '{id: field.id}') }}">
						<i class="fa fa-bars drag-handle"></i>
						<div class="pull-right">
							<em class="tag tag-warn" ng-show="!field.is_enabled">Disabled</em>
						</div>
						<h4><span class="title-id" title="ID">#{{ ng_var('field.id') }}</span> <span class="title-text">{{ ng_var('field.title') }}</span></h4>
					</a>
				</li>
			</ul>
			<div class="dp-add-control">
				<a class="btn btn-default" href="{{ ng_href('crm.org_fields.gocreate') }}"
				   ng-class="{'active': isStateActive('.create') }">
					<i class="fa fa-plus"></i>
					{{ phrase('agent.general.add') }}
				</a>
			</div>
		</article>
	</section>

	<section class="dp-paneblock dp-listpane">
		<header>
			<h3 ng-pluralize count="ListCtrl.specific_org_custom_fields.length || 0"
				when="{{ ng_plural_phrase('adm.custom_fields.count_specific_org_fields') }}">
			</h3>
		</header>
		<article>
			<ul class="dp-item-list" ui-sortable="ListCtrl.customFieldListOptions" dp-max-height>
				<li ng-repeat="field in ListCtrl.specific_org_custom_fields"
					class="with-drag-handle"
					dp-state-mark="crm.org_fields.specific.edit.{{ ng_var('field.id') }}"
					data-id="{{ ng_var('field.id') }}">
					<a href="{{ ng_href('crm.org_fields.specific.edit', '{id: field.id}') }}">
						<i class="fa fa-bars drag-handle"></i>
						<div class="pull-right">
							<em class="tag tag-warn" ng-show="!field.is_enabled">Disabled</em>
						</div>
						<h4>
							<span class="title-id" title="ID">#{{ ng_var('field.id') }}</span>
							<span class="title-text">{{ ng_var('field.title') }}</span>
						</h4>
					</a>
				</li>
			</ul>
			<div class="dp-add-control">
				<a class="btn btn-default" href="{{ ng_href('crm.org_fields.specific.gocreate') }}"
					ng-class="{'active': isStateActive('crm.org_fields.specific.create') }">
					<i class="fa fa-plus"></i>
					{{ phrase('agent.general.add') }}
				</a>
			</div>
		</article>
	</section>
{% endblock %}
{% block listpane_help %}
	<header>
		<h1>You can store extra information about organizations with custom organization fields.</h1>
		<p>When you define a custom field, you choose what it's called and what sort of values it can store (text entry, a date, multiple choice etc.).</p>
	</header>
	<article>
		<section>
			<p>You'll need to add your custom organization fields to the user and agent ticket form layouts in <strong>Tickets > Departments</strong>.</p>

		</section>
	<section>
		<h2><span>FAQ</span></h2>
		<dl>

					<dt><em>Q:</em>What's a "per-organization" field?</dt>
			<dd><em>A:</em>
				A per-organization field is a multiple-choice field with different options for each organization. For example, it could be a "Buildings" field that lets users select from their organization's buildings. Define the values for each organization from its profile in the agent interface.
			</dd>

			<dt><em>Q:</em>My helpdesk uses multiple languages and some of these fields are not being translated; how do I fix this?</dt>
			<dd><em>A:</em>
				You need to enter a translated version of any field values/names you have defined. Go to <strong>Setup > Languages</strong>; click on each language you have installed beyond the default, click <strong>Edit Phrases</strong>, and enter a custom translation.
			</dd>

			<dt><em>Q:</em>What does the <strong>Match regular expression</strong> setting on custom text fields do?</dt>
			<dd><em>A:</em>
				A regular expression lets you define a pattern that input must match. For example, if you expect an 8-digit account number starting with 9, you can use a regular expression to make sure input matches that format. See the manual section on <a href="https://www.deskpro.com/manuals/admin-manual/admin-manual.html#custom-field-validation" target="_blank">Custom field validation</a> for more details.
			</dd>
		</dl>
</section>
	<section class="related-content">
			<h2><span>Related Content</span></h2>
			<ul>
				<li>
					<i class="fa fa-book"></i> <a href="https://www.deskpro.com/manuals/admin-manual/admin-manual.html#custom-fields" target="_blank">Custom fields</a>
				</li>

				<li>
					<i class="fa fa-book"></i> <a href="https://www.deskpro.com/manuals/admin-manual/admin-manual.html#field-data-validation" target="_blank">Field data validation</a>
				</li>

			</ul>
	</section>




</article>
{% endblock %}
