{% extends 'AdminInterfaceBundle:Layout:list-editpane.html.twig' %}
{% block editpane_content %}
	<form role="form" name="form_props" ng-submit="ChannelSmsEdit.saveAccount()">
		<section class="dp-paneblock dp-editpane">
			<article class="form-horizontal dp-form">
				<div class="panel panel-fill indent">
					<div class="panel-body">

						<div ng-hide="form.account.is_connected">
							<div class="form-group" style="border-bottom: none;">
								<div class="row">
									<div class="col-lg-3"><h3>Service Provider</h3></div>
									<div class="col-lg-9">
										<select style="margin-bottom: 15px;" ui-select2 ng-model="form.account.type">
											<option value="">Select...</option>
											<option value="twilio">Twilio</option>
										</select>
									</div>
								</div>
							</div>
						</div>


						<div ng-switch="form.account.type">
							<div ng-switch-when="twilio">
								<div class="form-group">
									<div ng-form="twilio_form">

										<div ng-hide="form.account.is_connected">
											<div class="row">
												<div class="col-lg-3"><h3>Account SID</h3></div>
												<div class="col-lg-9">
													<input name="sid" type="text" ng-model="form.account.params.sid"
														required
														class="form-control"
														style="width: 50%;" />
									<span class="help-block"
										style="margin-bottom: 15px;">
										This is the "AccountSID" for your Twilio account. You can find this value here: <a
											href="https://www.twilio.com/user/account/settings">https://www.twilio.com/user/account/settings</a>
										</span>
												</div>
											</div>
											<div class="row">
												<div class="col-lg-3"><h3>Auth Token</h3></div>
												<div class="col-lg-9">
													<input name="auth_token" type="text"
														ng-model="form.account.params.auth_token"
														class="form-control" required style="width: 50%;" />
									<span class="help-block"
										style="margin-bottom: 15px;">
										This is the "AuthToken" for your Twilio account. You can find this value here: <a
											href="https://www.twilio.com/user/account/settings">https://www.twilio.com/user/account/settings</a>
										</span>
												</div>
											</div>

											<div class="row" ng-show="connection_problem">
												<div class="col-lg-9 col-lg-offset-3">
													<div class="alert alert-danger" style="text-align:center;">
														<strong>
															There was a problem connecting with your account. Please
															check your credentials and try again.
														</strong>
													</div>
												</div>
											</div>

											<div class="row">
												<div style="text-align:center;">
													<button style="margin-bottom: 15px;" class="btn btn-primary"
														type="button"
														ng-click="ChannelSmsEdit.connect()" style="width: 25%">
														<i class="fa fa-bolt"></i>
														Connect
													</button>
													<div dp-show-spinning="sms_connect_provider">
														<i class="spinner-flat"></i>
													</div>
												</div>
											</div>
										</div>

									</div>

									<div ng-show="form.account.is_connected" style="margin-bottom: 40px;">
												<div class="col-lg-12">

													<h2 style="display: inline;">
														<img ng-show="form.account.type == 'twilio'"
															src="{{ asset('images/site-icons/twilio_256.png') }}"
															height="30" width="30">
														{{ ng_var('form.account.identifier') }}
													</h2>
														<button class="btn btn-default dropdown-toggle pull-right"><span><i
																	class="fa fa-cog"></i></span> <i
																class="fa fa-caret-down"></i></button>
														<ul class="dropdown-menu pull-right">
															<li><a ng-click="ChannelSmsEdit.connect()"><i
																		class="fa fa-refresh"></i> Sync Account Information</a></li>
															<li><a ng-click="ChannelSmsEdit.clearCredentials()"><i
																		class="fa fa-key"></i> Change Account Credentials</a></li>
														</ul>
										</div>

										<div class="col-lg-3" style="margin-top: 30px;">
											<h3>Twilio Number</h3>
										</div>
										<div class="col-lg-9" style="margin-top: 30px;">
											<select data-placeholder="Select a Number" ng-required
												ng-model="form.account.phone_number"
												ng-options="number.number as number.display_name for number in form.numbers">
												{#<option ng-repeat="number in form.numbers"#}
													{#value="{{ ng_var('number.phone_number') }}">{{ ng_var('number.display_name') }}</option>#}
											</select>
											<button class="btn btn-default btn-xs"
												type="button"
												ng-click="ChannelSmsEdit.connect()" style="width: 25%">
												<i class="fa fa-refresh"></i>
												Sync Account
											</button>
											<div dp-show-spinning="sms_connect_provider">
												<i class="spinner-flat"></i>
											</div>

												<span class="help-block" style="margin-bottom: 15px;">
													This will be the SMS number used for this channel.  If you've updated your Twilio phone numbers, press "Sync Account" so that we can fetch them for you.
												</span>
										</div>
									</div>

								</div>
							</div>

						</div>

						<div class="form-group" ng-show="form.account.is_connected">
							<div class="col-lg-3"><h3>Enabled</h3></div>
							<div class="col-lg-9">
								<label>
									<input type="checkbox" ng-model="form.account.is_enabled"
										/>
									Enable this SMS account
								</label>
								<span class="help-block" style="margin-bottom: 15px;"
									ng-show="!form.account.is_enabled">Enabling this account opens it up as a channel.</span>
									<span class="help-block" style="margin-bottom: 15px;"
										ng-show="form.account.is_enabled">Uncheck this box to disable this account. Disabling this account will remove it as a channel. You can re-enable it later.</span>
							</div>
						</div>

					</div>
				</div>
			</article>
			<footer ng-hide="form_props.$attempted && form_props.$invalid">
				<div class="dp-content">
					<div class="text-danger ng-hide" ng-show="form_props.$attempted && form_props.$invalid">
						<p><strong>{{ phrase('adm.general.please_correct_errors') }}</strong></p>
						<ul>
							<li ng-show="form_props.sid.$error.required">Your Twillio AccountSID is required</li>
							<li ng-show="form_props.auth_token.$error.required">Your Twillio AuthToken is required</li>
						</ul>
					</div>

					<div class="dp-delete-control" ng-if="ChannelSmsEdit.account.id"
						ng-hide="form_props.$attempted && form_props.$invalid">
						<button class="btn btn-danger"
							ng-click="$event.preventDefault(); $parent.ChannelSmsList.startDelete(ChannelSmsEdit.account.id);">
							Delete
						</button>
					</div>

					<div class="dp-btn-controls"
						ng-hide="!form.account.is_connected || (form_props.$attempted && form_props.$invalid)">
						<div dp-hide-spinning="saving_account">
							<button class="btn btn-primary" type="submit"
								dp-submit-form>{{ phrase('agent.general.save') }}</button>
							{#<button class="btn btn-default" type="button"#}
							{#ng-click="ChannelSmsEdit.testRoundTrip()">Test#}
							{#</button>#}
						</div>
						<div dp-show-spinning="saving_account">
							<i class="spinner-flat"></i>
						</div>
					</div>
				</div>
			</footer>
		</section>
		<div dp-register-message="saved_account">{{ ng_var('form.account.identifier') }} was saved successfully</div>
	</form>
{% endblock %}
