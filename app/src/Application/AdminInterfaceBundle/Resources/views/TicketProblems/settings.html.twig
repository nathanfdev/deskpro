{% extends 'AdminInterfaceBundle:Layout:fullpage-pane.html.twig' %}
{% block fullpane_content %}
	<form class="form-horizontal dp-form" role="form" name="form_props" ng-submit="form_props.$valid && TicketSettings.save()">
		<section class="dp-paneblock dp-listpane">
			<header>
				<h3>{{ phrase('adm.problems.title') }}</h3>
			</header>

			{##################################################################################################}

			<article class="form-horizontal dp-form">
				<div class="panel panel-innertable">

					<div class="form-group">
						<div class="col-lg-12">
							<div class="inner-group">
								<label>
									<input type="radio" name="problems_enabled" value="1" ng-model="settings.enabled" />
									{{ phrase('adm.problems.label_enabled') }}
								</label>
							</div>
							<div class="inner-group">
								<label>
									<input type="radio" name="problems_enabled" value="0" ng-model="settings.enabled" />
									{{ phrase('adm.problems.label_disabled') }}
								</label>
							</div>
						</div>
					</div>

                    <div class="form-group" ng-if="settings.enabled">
                        <div class="col-lg-12" style="margin-top: 20px;">

                            <h4>
                                <select ng-model="perm.selected" ng-change="updateAgents()">
                                    {% for perm in ['view', 'create', 'close', 'reopen'] %}
                                        <option value="{{ perm }}">{{ phrase('adm.problems.set_' ~ perm ~ '_perm') }}</option>
                                    {% endfor %}
                                </select>:
                            </h4>

                        </div>
                    </div>

					<div class="form-group" ng-if="settings.enabled">
						<div class="col-lg-12" style="margin-top: 20px;">

                            <h4>
                                {{ phrase('adm.problems.for_groups') }}:
                            </h4>

							<label ng-repeat="group in settings.groups" style="width: 100%;">
								<input type="checkbox" ng-model="group.perms.problems[perm.selected]" ng-change="updateAgents()"
                                       ng-disabled="'agent_all_perms' === group.sys_name || 'agent_all_safe_perms' === group.sys_name"
                                        />
								{{ ng_var('group.title') }}
							</label>

						</div>
					</div>

					<div class="form-group" ng-if="settings.enabled">
						<div class="col-lg-12" style="margin-top: 20px;">

                            <h4>
                                {{ phrase('adm.problems.for_agents') }}:
                            </h4>

							<label ng-repeat="agent in settings.agents" style="width: 100%;">
								<input type="checkbox" ng-model="agent.perms.problems[perm.selected]" ng-checked="agent[perm.selected + '_checked']" ng-disabled="agent[perm.selected + '_disabled']" ng-change="updateAgents()" />
								<span class="agent-icon agent-icon-16x" ng-style="{'background-image': 'url(' + agent.picture_url_16 + ')'}"></span>
								<span class="title-text">{{ ng_var('agent.display_name') }}</span>
							</label>

						</div>
					</div>

				</div>
			</article>

			{##################################################################################################}

            <footer>
                <div class="dp-content">
                    <div class="dp-btn-controls">
                        <div dp-hide-spinning="saving">
                            <button class="btn btn-primary" type="button" ng-click="Settings.save()">
                                {{ phrase('agent.general.save') }}
                            </button>
                        </div>
                        <div dp-show-spinning="saving">
                            <i class="spinner-flat"></i>
                        </div>
                    </div>
                </div>
            </footer>

		</section>
	</form>
	<div dp-register-message="saved_settings">Settings saved successfully.</div>
{% endblock %}
