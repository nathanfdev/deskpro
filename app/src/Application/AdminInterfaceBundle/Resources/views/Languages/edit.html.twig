			<footer>
				<div class="dp-content">
					<div class="text-danger" ng-show="form_props.$attempted && form_props.$invalid">
						<p><strong>{{ phrase('adm.general.please_correct_errors') }}</strong></p>
						<ul>
							<li ng-show="form_props.title.$error.required">{{ phrase('adm.validation.required_lang_title') }}</li>
                            <li ng-show="form_props.locale.$error.required">{{ phrase('adm.validation.required_locale_title') }}</li>
						</ul>
					</div>

					<div class="dp-delete-control" ng-hide="form_props.$attempted && form_props.$invalid">
						<button ng-if="isDefaultLang()" type="button" class="btn btn-danger" tooltip="You cannot uninstall the default language." style="opacity: 0.7;" ng-click="$event.preventDefault(); EditCtrl.startUninstall();">
							Uninstall Language
						</button>
						<button ng-if="!isDefaultLang()" type="button" class="btn btn-danger" ng-click="$event.preventDefault(); EditCtrl.startUninstall();">
							Uninstall Language
						</button>
					</div>

					<div class="dp-btn-controls" ng-hide="form_props.$attempted && form_props.$invalid">
						<div dp-hide-spinning="saving">
							<button class="btn btn-primary" dp-submit-form>
								{{ phrase('agent.general.save') }}
							</button>
						</div>
						<div dp-show-spinning="saving">
							<i class="spinner-flat"></i>
						</div>
					</div>
				</div>
