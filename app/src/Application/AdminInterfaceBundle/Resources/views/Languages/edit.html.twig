	<div dp-register-message="saved_dep">{{ phrase('adm.departments.saved_dep_x_success', {title: 'ng_var(EditCtrl.form.title)'}) }}</div>
	{{ ng_tpl('AdminInterfaceBundle:Languages:uninstall-modal.html.twig') }}
	<div dp-register-message="no_delete_default">
		You cannot uninstall the default language. Choose a different default language first, then try again.
	</div>
