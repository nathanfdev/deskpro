									<span class="help-block">
										The language title as it appears to users.
									</span>
								</div>
							</div>
						</div>
						<div class="form-group">
							<div class="col-lg-3">
								<h3>Edit Phrases</h3>
							</div>
							<div class="col-lg-9">
								<div class="inner-group">
									<a class="btn btn-info" href="{{ ng_href('setup.phrases', "{id: 'phrases-'+EditCtrl.pack.id}") }}"><i class="fa fa-file-text-o"></i> Edit Phrases</a>
								</div>
							</div>
						</div>
