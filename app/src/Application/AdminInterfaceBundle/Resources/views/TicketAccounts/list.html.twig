<div class="pane" xmlns="http://www.w3.org/1999/html">
	<header class="pane-header">
		<h3><i class="fa fa-briefcase"></i> {{ phrase('adm.general.apps_tickets') }} &rarr; {{ phrase('adm.tickets.email_accounts') }}</h3>
		<button class="btn help-page-trigger"><i class="fa fa-question-circle"></i></button>
	</header>
	<article class="pane-content">
		<div class="panel panel-fill">
			<div class="panel-heading">
				<nav class="dp-controls">
					<ul>
						<li>
							<span dp-ping-flash="display_orders" class="saved-ping"><i class="fa fa-check-square-o-square"></i> {{ phrase('agent.general.saved') }}</span>
						</li>
						<li><span class="btn btn-danger" ng-class="{active: delete_mode}" ng-click="delete_mode = !delete_mode;"><i class="fa fa-trash-o"></i> {{ phrase('agent.general.delete') }}</span></li>
						<li><a class="btn btn-success" href="{{ ng_href('tickets.ticket_accounts.gocreate') }}"><i class="fa fa-plus"></i> {{ phrase('agent.general.add') }}</a></li>
					</ul>
				</nav>
				<h3 ng-pluralize count="TicketAccountsList.accounts.length || 0" when="{{ ng_plural_phrase('adm.tickets.x_email_accounts') }}"></h3>
			</div>
			<ul class="dp-item-list" ng-if="TicketAccountsList.accounts.length">
				<li ng-repeat="acc in TicketAccountsList.accounts" dp-state-mark="tickets.ticket_accounts.edit.{{ ng_var('acc.id') }}" data-id="{{ ng_var('acc.id') }}">
					<a href="{{ ng_href('tickets.ticket_accounts.edit', '{id: acc.id}') }}">
						<div class="pull-right">
							<span class="btn btn-danger btn-xs only-icon" ng-show="delete_mode" style="margin-top: -3px;" ng-click="TicketAccountsList.startDelete(acc); $event.preventDefault();"><i class="fa fa-trash-o"></i></span>
						</div>

						<h4><i class="fa fa-inbox"></i> <span class="title-text">{{ ng_var('acc.email_address') }}</span></h4>
					</a>
				</li>
			</ul>
			<p ng-if="!TicketAccountsList.accounts.length" style="padding: 15px;">
				{{ phrase('adm.tickets.no_email_accounts') }}
			</p>

			<div class="text-center" style="padding: 20px;">
				<div class="btn-group">
					<a href="{{ ng_href('tickets.emailsources') }}" class="btn btn-default">Incoming Email Log</a>
					<a href="{{ ng_href('tickets.sendmailqueue') }}" class="btn btn-default">Outgoing Email Log</a>
				</div>
			</div>
		</div>
	</article>
	<a class="pane-nav-btn" href="{{ ng_href('tickets.emailsources') }}">
		<span class="arrow"><i class="fa fa-chevron-down"></i></span>
		<span class="title">Incoming Email Log</span>
	</a>
	<a class="pane-nav-btn" href="{{ ng_href('tickets.sendmailqueue') }}">
		<span class="arrow"><i class="fa fa-chevron-down"></i></span>
		<span class="title">Outgoing Email Log</span>
	</a>
</div>
<div dp-register-message="saved_settings">{{ phrase('adm.general.save_settings_success') }}</div>

{{ ng_tpl('TicketAccounts/delete-modal.html') }}

{% include 'AdminInterfaceBundle:TicketAccounts:help-page.html.twig' %}