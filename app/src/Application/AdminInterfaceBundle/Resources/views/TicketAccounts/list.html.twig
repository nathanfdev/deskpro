<div class="pane">
	<header class="pane-header">
		<h3><i class="icon-briefcase"></i> {{ phrase('adm.general.apps_tickets') }} &rarr; {{ phrase('adm.tickets.email_accounts') }}</h3>
		<button class="btn help-page-trigger"><i class="icon-question-sign"></i></button>
	</header>
	<article class="pane-content no-pad">
		<div class="panel panel-fill">
			<div class="panel-heading">
				<nav class="dp-controls">
					<ul>
						<li>
							<span dp-ping-flash="display_orders" class="saved-ping"><i class="icon-check-sign"></i> {{ phrase('agent.general.saved') }}</span>
						</li>
						<li><span class="btn btn-danger" ng-class="{active: delete_mode}" ng-click="delete_mode = !delete_mode;"><i class="icon-trash"></i> {{ phrase('agent.general.delete') }}</span></li>
						<li><a class="btn btn-success" href="#/tickets/ticket_accounts/go-create"><i class="icon-plus"></i> {{ phrase('agent.general.add') }}</a></li>
					</ul>
				</nav>
				<h3 ng-pluralize count="TicketAccountsList.accounts.length || 0" when="{{ ng_plural_phrase('adm.tickets.x_email_accounts') }}"></h3>
			</div>
			<ul class="dp-item-list" ng-if="TicketAccountsList.accounts.length">
				<li ng-repeat="acc in TicketAccountsList.accounts" dp-state-mark="tickets.ticket_accounts.edit.{{ ng_var('acc.id') }}" data-id="{{ ng_var('acc.id') }}">
					<a href="#/tickets/ticket_accounts/{{ ng_var('acc.id') }}">
						<div class="pull-right">
							<span class="badge" ng-hide="delete_mode" style="margin-top: -2px;" tooltip="The ID can be used in the API" tooltip-placement="left">ID: {{ ng_var('acc.id') }}</span>
							<span class="btn btn-danger btn-xs only-icon" ng-show="delete_mode" style="margin-top: -3px;" ng-click="TicketAccountsList.startDelete(acc); $event.preventDefault();"><i class="icon-trash"></i></span>
						</div>
						<button dp-toggle-switch ng-model="acc.is_enabled"></button>
						<h4><span class="title-text">{{ ng_var('acc.email_address') }}</span></h4>
					</a>
				</li>
			</ul>
			<p ng-if="!TicketAccountsList.accounts.length" style="padding: 15px;">
				{{ phrase('adm.tickets.no_email_accounts') }}
			</p>
	</article>
</div>
<div dp-register-message="saved_settings">{{ phrase('adm.general.save_settings_success') }}</div>

{{ ng_tpl('TicketAccounts/delete-modal.html') }}

{% include 'AdminInterfaceBundle:TicketAccounts:help-page.html.twig' %}