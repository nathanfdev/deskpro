{% extends 'AdminInterfaceBundle:Layout:list.html.twig' %}
{% block listpane_content %}
	<section class="dp-paneblock dp-listpane">
		<header>
			<nav>
				<span class="status-pinger saved-ping" dp-ping-flash="display_orders"><i class="fa fa-check-square-o-square"></i> {{ phrase('agent.general.saved') }}</span>
				{% include 'AdminInterfaceBundle:Layout:standard-settings-menu.html.twig' %}
			</nav>
			<h3 ng-pluralize count="TicketAccountsList.accounts.length || 0" when="{{ ng_plural_phrase('adm.tickets.x_email_accounts') }}"></h3>
		</header>
		<article>
			<p class="dp-empty-list-notice" ng-if="!TicketAccountsList.accounts.length">
				{{ phrase('adm.tickets.no_email_accounts') }}
			</p>
			<ul class="dp-item-list" ng-if="TicketAccountsList.accounts.length" dp-max-height>
				<li ng-repeat="acc in TicketAccountsList.accounts" dp-state-mark="tickets.ticket_accounts.edit.{{ ng_var('acc.id') }}" data-id="{{ ng_var('acc.id') }}">
					<a href="{{ ng_href('tickets.ticket_accounts.edit', '{id: acc.id}') }}">
						<div class="pull-right">
							<em class="tag tag-warn" ng-show="!acc.is_enabled">Disabled</em>
						</div>
						<h4>
							<span class="title-id" title="ID">#{{ ng_var('acc.id') }}</span>
							<span class="title-text">{{ ng_var('acc.address') }}</span>
							<span class="title-copy" clip-copy="acc.address" clip-click="Growl.success('The email addresswas copied to your clipboard');"><i class="fa fa-clipboard"></i></span>
						</h4>
					</a>
				</li>
			</ul>
			<div class="dp-add-control">
				<a class="btn btn-default" href="{{ ng_href('tickets.ticket_accounts.gocreate') }}" ng-class="{'active': isStateActive('.create') }"><i class="fa fa-plus"></i> New Email Account</a>
			</div>
		</article>
	</section>

	<section class="dp-paneblock dp-panelink">
		<a href="{{ ng_href('tickets.ticket_accounts.emailsources') }}">
			<em><i class="fa fa-chevron-down"></i></em>
            <h3>{{ phrase('adm.ticket_accounts.incoming_log') }}</h3>
		</a>
	</section>

	<section class="dp-paneblock dp-panelink">
		<a href="{{ ng_href('tickets.ticket_accounts.sendmailqueue') }}">
			<em><i class="fa fa-chevron-down"></i></em>
			<h3>{{ phrase('adm.ticket_accounts.outgoing_log') }}</h3>
		</a>
	</section>

    <section class="dp-paneblock dp-panelink">
        <a href="{{ ng_href('tickets.ticket_accounts.advancedsettings') }}">
            <em><i class="fa fa-chevron-down"></i></em>
            <h3>{{ phrase('adm.ticket_accounts.advanced_settings') }}</h3>
        </a>
    </section>

	<div dp-register-message="saved_settings">{{ phrase('adm.general.save_settings_success') }}</div>
	{{ ng_tpl('AdminInterface:TicketAccounts:delete-modal.html.twig') }}
{% endblock %}
{% block listpane_help %}
	<header>
		<h1>Set up the email accounts that DeskPRO checks for tickets and replies.</h1>
		<p>DeskPRO can automatically turn incoming emails to <code>support@yourcompany.com</code> or <code>sales@yourcompany.com</code> into tickets.</p>
	</header>
	<article>
		<section>
			<p>When you configure a new email account, DeskPRO will read email messages in the account and import them as tickets and replies.</p>
			<p>You can use the <strong>New Ticket Trigger</strong> to link an email account to a department: for example, if you want all emails to <code>sales@yourcompany.com</code> to be assigned to the sales department.</p>
			<p>This trigger also controls sending auto-response emails. You can customize the auto-response by creating a new reply template: for example, you might want to have different auto-responses for your <code>help@</code> and <code>sales@</code> accounts.</p>
			<p>In <a href="/admin/#/tickets/settings">Tickets > Settings > Email Settings</a>, you can change how DeskPRO processes emails CCed to agents.</p> 
			<p>In <a href="/admin/#/tickets/fwd-settings">Tickets > Forward Settings</a>, you can configure how DeskPRO handles email forwarding into or out of the helpdesk.</p>
			<p>You can configure allowed attachment types and sizes in <strong>Setup > Settings > User/Agent Attachments</strong>.</p>
			<p>If you need to troubleshoot email delivery, check the logs of incoming and outgoing email.</p>
		</section>
		
			<section>
			<h2><span>FAQ</span></h2>
			<dl>
			
				<dt><em>Q:</em>Which email header field does DeskPRO use to determine the sender?</dt>
				<dd><em>A:</em>
					By default, DeskPRO looks at the <code>From:</code> email header first. You can change this under <a href="/admin/#/tickets/settings">Tickets &gt; Settings</a> under <strong>Priority of "From Email Address" headers</strong> if you want to use <code>Reply-To</code> or <code>X-Original-From</code> instead.</dd>
					
				<dt><em>Q:</em>Why can't I use an agent's email address as a ticket account?</dt>
				<dd><em>A:</em>
					An email address that is registered to an agent or user cannot be used as a ticket account. This is necessary to prevent email loops, where DeskPRO could end up endlessly replying to its own messages.
				</dd>
	
			</dl>
		</section>



		<section class="related-content">
			<h2><span>Related Content</span></h2>
			<ul>
				<li><i class="fa fa-book"></i> <a href="https://www.deskpro.com/manuals/admin-manual/admin-manual.html#email-accounts" target="_blank">Set up ticket email accounts</a></li>
				<li><i class="fa fa-book"></i> <a href="https://www.deskpro.com/manuals/admin-manual/admin-manual.html#customizing-the-email-templates" target="_blank">Customizing the email message templates</a> </li>
				<li><i class="fa fa-file-text"></i> <a href="https://support.deskpro.com/kb/articles/157" target="_blank">Why can't users or agents use email addresses that are also ticket accounts?</a></li>
			 <li><i class="fa fa-file-text"></i> <a href="https://support.deskpro.com/kb/articles/80" target="_blank">Using a custom email address</a></li>
					<li><i class="fa fa-file-text"></i> <a href="https://support.deskpro.com/kb/articles/106" target="_blank">Agent ticket forwarding</a></li>
				<li><i class="fa fa-file-text"></i> <a href="https://support.deskpro.com/kb/articles/161" target="_blank">Email action codes</a></li>
				<li><i class="fa fa-file-text"></i> <a href="https://support.deskpro.com/kb/articles/149" target="_blank">Viewing the raw email source for a ticket message</a></li>
				<li><i class="fa fa-file-text"></i> <a href="https://support.deskpro.com/kb/articles/153" target="_blank">Debugging outgoing email with the send mail log</a></li>
				<li><i class="fa fa-file-text"></i> <a href="https://support.deskpro.com/kb/articles/194" target="_blank">Automatically assign agents to tickets they reply to by email</a></li>
