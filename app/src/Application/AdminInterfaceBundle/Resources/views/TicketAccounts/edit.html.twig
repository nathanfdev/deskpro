{% extends 'AdminInterfaceBundle:Layout:list-editpane.html.twig' %}
{% block editpane_content %}
	<form role="form" name="form_props" ng-submit="TicketAccountsEdit.saveAccount()">
		<section class="dp-paneblock dp-editpane">
			<article class="form-horizontal dp-form">
				<div class="panel panel-fill indent">
					<div class="panel-body">
					<div class="form-group">
						<div class="col-lg-3">
							<h3>{{ phrase('agent.general.email_address') }} *</h3>
						</div>
						<div class="col-lg-9">
							<div class="inner-group" dp-error-class="form_props.title">
								<input type="text" class="form-control" name="title" ng-model="form.email_address" style="width: 50%;" required autofocus />
										<span class="help-block">
											{{ phrase('adm.departments.title_explain') }}
										</span>
							</div>
						</div>
					</div>


					{##################################################################################################}
					{# Account Details #}
					{##################################################################################################}

					<div class="form-group">
						<div class="col-lg-3">
							<h3>{{ phrase('adm.tickets.account_details') }} *</h3>
						</div>
						<div class="col-lg-9">
							<div class="inner-group" style="padding-top: 3px;">
								<select
										ui-select2
										ng-model="form.connection_type"
										style="min-width: 240px"
										>
									<option value="pop3">POP3</option>
									<option value="imap">IMAP</option>
									<option value="gmail">GMail or Google Apps</option>
								</select>
							</div>
							<div class="ng-hide" ng-show="form.connection_type == 'pop3'">
								<div class="inner-group">
									<table width="100%" class="inner-form-table">
										<tr>
											<th width="75">Host</th>
											<td><input type="text" class="form-control" name="title" ng-model="form.in_pop3_account.host" style="width: 50%;" placeholder="localhost" ></td>
										</tr>
										<tr>
											<th>Port</th>
											<td><input type="text" class="form-control" name="title" ng-model="form.in_pop3_account.port" style="width: 80px;" placeholder="110" /></td>
										</tr>
										<tr>
											<th>Secure</th>
											<td>
												<label>
													<input type="checkbox" ng-true-value="ssl" ng-model="form.in_pop3_account.secure" /> Enable secure network connection (SSL)
												</label>
											</td>
										</tr>
										<tr>
											<th>Username</th>
											<td><input type="text" class="form-control" name="title" ng-model="form.in_pop3_account.username" style="width: 50%;" /></td>
										</tr>
										<tr>
											<th>Password</th>
											<td><input type="password" class="form-control" name="title" ng-model="form.in_pop3_account.password" style="width: 50%;" /></td>
										</tr>
										<tr>
											<th>&nbsp;</th>
											<td>
												<button class="btn btn-info" ng-click="TicketAccountsEdit.testAccountModal(); $event.preventDefault();"><i class="fa fa-bolt"></i> Test Account Settings</button>
											</td>
										</tr>
									</table>
								</div>
							</div>
							<div class="ng-hide" ng-show="form.connection_type == 'imap'">
								<div class="inner-group">
									<table width="100%" class="inner-form-table">
										<tr>
											<th width="75">Host</th>
											<td><input type="text" class="form-control" name="title" ng-model="form.in_imap_account.host" style="width: 50%;" placeholder="localhost" /></td>
										</tr>
										<tr>
											<th>Port</th>
											<td><input type="text" class="form-control" name="title" ng-model="form.in_imap_account.port" style="width: 80px;" placeholder="110" /></td>
										</tr>
										<tr>
											<th>Secure</th>
											<td>
												<label>
													<input type="checkbox" ng-true-value="ssl" ng-model="form.in_imap_account.secure" /> Enable secure network connection (SSL)
												</label>
											</td>
										</tr>
										<tr>
											<th>Username</th>
											<td><input type="text" class="form-control" name="title" ng-model="form.in_imap_account.username" style="width: 50%;" /></td>
										</tr>
										<tr>
											<th>Password</th>
											<td><input type="password" class="form-control" name="title" ng-model="form.in_imap_account.password" style="width: 50%;" /></td>
										</tr>
										<tr>
											<th>&nbsp;</th>
											<td>
												<button class="btn btn-info" ng-click="TicketAccountsEdit.testAccountModal(); $event.preventDefault();"><i class="fa fa-bolt"></i> Test Account Settings</button>
											</td>
										</tr>
									</table>
								</div>
							</div>
							<div class="ng-hide" ng-show="form.connection_type == 'gmail'">
								<div class="inner-group">
									<table width="100%" class="inner-form-table">
										<tr>
											<th width="100">Email Address</th>
											<td>
												<span ng-show="form.email_address">{{ ng_var('form.email_address') }}</span>
												<span ng-hide="form.email_address">Enter your email address above</span>
											</td>
										</tr>
										<tr>
											<th>Password</th>
											<td><input type="password" class="form-control" name="title" ng-model="form.in_gmail_account.password" style="width: 50%;" /></td>
										</tr>
										<tr>
											<th>&nbsp;</th>
											<td>
												<button class="btn btn-info" ng-click="TicketAccountsEdit.testAccountModal(); $event.preventDefault();"><i class="fa fa-bolt"></i> Test Account Settings</button>
											</td>
										</tr>
									</table>
								</div>
							</div>
						</div>
					</div>

					{##################################################################################################}
					{# Transport Details #}
					{##################################################################################################}

					<div class="form-group" ng-hide="form.connection_type == 'gmail'">
						<div class="col-lg-3">
							<h3>Outgoing Email *</h3>
						</div>
						<div class="col-lg-9">
							<div class="inner-group" style="padding-top: 3px;">
								<select
										ui-select2
										ng-model="form.email_transport.transport_type"
										style="min-width: 240px"
										>
									<option value="mail">Send mail using PHP mail()</option>
									<option value="smtp">SMTP</option>
									<option value="gmail">GMail or Google Apps</option>
								</select>
							</div>
							<div class="ng-hide" ng-show="form.email_transport.transport_type == 'mail'">
								<div class="inner-group">
									<table width="100%" class="inner-form-table">
										<tr>
											<th width="75">PHP Mail</th>
											<td>
												Send mail through the server <code><a href="http://www.php.net/mail">mail()</a></code> function.
											</td>
										</tr>
										<tr>
											<th>&nbsp;</th>
											<td>
												<button class="btn btn-info" ng-click="TicketAccountsEdit.testOutgoingModal(); $event.preventDefault();"><i class="fa fa-bolt"></i> Test Account Settings</button>
											</td>
										</tr>
									</table>
								</div>
							</div>
							<div class="ng-hide" ng-show="form.email_transport.transport_type == 'smtp'">
								<div class="inner-group">
									<table width="100%" class="inner-form-table">
										<tr>
											<th width="75">Host</th>
											<td><input type="text" class="form-control" name="title" ng-model="form.email_transport.out_smtp_account.host" style="width: 50%;" placeholder="localhost" /></td>
										</tr>
										<tr>
											<th>Port</th>
											<td><input type="text" class="form-control" name="title" ng-model="form.email_transport.out_smtp_account.port" style="width: 80px;" placeholder="25" /></td>
										</tr>
										<tr>
											<th>Secure</th>
											<td>
												<label>
													<input type="checkbox" ng-true-value="ssl" ng-model="form.email_transport.out_smtp_account.secure" /> Enable secure network connection (SSL)
												</label>
											</td>
										</tr>
										<tr>
											<th>Username</th>
											<td><input type="text" class="form-control" name="title" ng-model="form.email_transport.out_smtp_account.username" style="width: 50%;" /></td>
										</tr>
										<tr>
											<th>Password</th>
											<td><input type="password" class="form-control" name="title" ng-model="form.email_transport.out_smtp_account.password" style="width: 50%;" /></td>
										</tr>
										<tr>
											<th>&nbsp;</th>
											<td>
												<button class="btn btn-info" ng-click="TicketAccountsEdit.testOutgoingModal(); $event.preventDefault();"><i class="fa fa-bolt"></i> Test Account Settings</button>
											</td>
										</tr>
									</table>
								</div>
							</div>
							<div class="ng-hide" ng-show="form.email_transport.transport_type == 'gmail'">
								<div class="inner-group">
									<table width="100%" class="inner-form-table">
										<tr>
											<th width="100">Email Address</th>
											<td>
												{{ ng_var('form.email_address') }}
											</td>
										</tr>
										<tr>
											<th>Password</th>
											<td><input type="password" class="form-control" name="title" ng-model="form.email_transport.out_gmail_account.password" style="width: 50%;" /></td>
										</tr>
										<tr>
											<th>&nbsp;</th>
											<td>
												<button class="btn btn-info" ng-click="TicketAccountsEdit.testOutgoingModal(); $event.preventDefault();"><i class="fa fa-bolt"></i> Test Account Settings</button>
											</td>
										</tr>
									</table>
								</div>
							</div>
						</div>
					</div>

					{##################################################################################################}
					{# Linked Department #}
					{##################################################################################################}

					<div class="form-group">
						<div class="col-lg-3">
							<h3>Linked Department *</h3>
						</div>
						<div class="col-lg-9">
							<div class="inner-group" style="padding-top: 3px;">
								<select
										ui-select2
										ng-model="form.department"
										style="min-width: 240px"
										>
									<option value="{{ ng_var('dep.id') }}" ng-repeat="dep in TicketAccountsEdit.deps">{{ ng_var('dep._full_title') }}</option>
								</select>
							</div>
						</div>
					</div>

					<div class="form-group">
						<div class="col-lg-3">
							<h3>From Address</h3>
						</div>
						<div class="col-lg-9">
							<div class="inner-group" style="padding-top: 3px;">
								<select ui-select2 style="min-width: 240px;">
									<option value="auto">Automatic: Use the email address linked to the department of the ticket</option>
									<option value="set">Set: Save this email address on the ticket</option>
								</select> <span class="help-icon" tooltip-placement="left" tooltip="When 'automatic' is chosen, then From email address is always the email address of linked to the tickets current department. This means that if you change the department, the From email address may change as well. With 'set', you are setting this email address on the ticket specifically, and it will not change unless changed by triggers or manually updated by an agent."></span>
										<span class="help-block">
											This determines the "From" email address on outgoing email notifications sent to users and agents.
										</span>
							</div>
						</div>
					</div>

					{##################################################################################################}
					{# Actions #}
					{##################################################################################################}

					<div class="form-group">
						<div class="col-lg-3">
							<h3>New Email Actions</h3>
						</div>
						<div class="col-lg-9">
							{# Send newticket auto-response #}
							<div class="inner-group">
								<label style="font-weight: normal">
									<input type="checkbox" ng-model="TicketDepsEdit.trigger.user_send_newuserticket_response.enabled" value="1" />
									Send user an auto-response confirming their new ticket
								</label>
								<div class="ng-hide" ng-show="TicketDepsEdit.trigger.user_send_newuserticket_response.enabled">
									<table class="display-table">
										<tr>
											<td>Template:</td>
											<td>
												<select
														ui-select2
														ng-model="TicketDepsEdit.trigger.user_send_newuserticket_response.template_name"
														style="min-width: 240px"
														class="no-search"
														>
													<option value="">Default template</option>
													<option value="CUSTOM">Custom template</option>
												</select>
												<button class="btn btn-xs ng-hide" ng-show="TicketDepsEdit.trigger.user_send_newuserticket_response.template_name != ''" ng-click="TicketDepsEdit.showEmailEditor('DeskPRO:emails_user:new-ticket.html.twig'); $event.preventDefault();">Edit Template</button>
											</td>
										</tr>

										<tr>
											<td>From Name:</td>
											<td>
												<select
														ui-select2
														ng-model="TicketDepsEdit.trigger.user_send_newuserticket_response.from_name"
														style="min-width: 240px"
														class="no-search"
														>
													<option value="department_title">Department title</option>
													<option value="helpdesk_name">Helpdesk name</option>
													<option value="website_name">Website name</option>
													<option value="CUSTOM">Custom</option>
												</select>
												<div ng-show="TicketDepsEdit.trigger.user_send_newuserticket_response.from_name == 'CUSTOM'">
													<input type="text" class="form-control" ng-model="TicketDepsEdit.trigger.user_send_newuserticket_response.from_name_custom" />
												</div>
											</td>
										</tr>
									</table>
								</div>
							</div>
						</div>
					</div>

					</div>
					</div>
			</article>
			<footer>
				<div class="dp-content">
					<div class="text-danger ng-hide" ng-show="form_props.$attempted && form_props.$invalid">
						<p><strong>{{ phrase('adm.general.please_correct_errors') }}</strong></p>
						<ul>
							<li ng-show="form_props.title.$error.required">{{ phrase('adm.departments.title_error') }}</li>
						</ul>
					</div>

					<div class="dp-delete-control" ng-if="TicketAccountsEdit.account.id">
						<button class="btn btn-danger" ng-click="$event.preventDefault(); $parent.TicketAccountsList.startDelete(TicketAccountsEdit.account.id);">Delete</button>
					</div>


					<div class="dp-btn-controls" ng-hide="form_props.$attempted && form_props.$invalid">
						<div dp-hide-spinning="saving_account">
							<button class="btn btn-primary" dp-submit-form>{{ phrase('agent.general.save') }}</button>
							<button class="btn btn-default" ng-click="TicketAccountsEdit.resetForm()">{{ phrase('agent.general.reset') }}</button>
						</div>
						<div dp-show-spinning="saving_account">
							<i class="spinner-flat"></i>
						</div>
					</div>
				</div>
			</footer>
		</section>
	</form>

	{{ ng_tpl('TicketAccounts/test-account-modal.html') }}
	{{ ng_tpl('TicketAccounts/test-outgoing-modal.html') }}

	<div dp-register-message="saved_account">{{ ng_var('form.email_address') }} was saved successfully</div>
{% endblock %}