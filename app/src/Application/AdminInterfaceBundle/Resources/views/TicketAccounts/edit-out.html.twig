{##################################################################################################}
{# Outgoing Account Details #}
{##################################################################################################}

<div class="form-group" ng-hide="form.incoming_type == 'gmail'">
	<div class="col-lg-3">
		<h3>Outgoing Email *</h3>
	</div>
	<div class="col-lg-9">

		{############}
		{# Selector #}
		{############}

		<div class="inner-group" style="padding-top: 3px;">
			<select
				ui-select2
				ng-model="form.outgoing_type"
				style="min-width: 240px"
			>
				<option value="">Select type</option>
				<option value="mail">Send mail using PHP mail()</option>
				<option value="smtp">SMTP</option>
				<option value="gmail">GMail or Google Apps</option>
			</select>
		</div>

		{############}
		{# PHP Mail #}
		{############}

		<div class="ng-hide" ng-show="form.outgoing_type == 'mail'">
			<div class="inner-group">
				<table width="100%" class="inner-form-table">
					<tr>
						<th width="75">PHP Mail</th>
						<td>
							Send mail through the server <code><a href="http://www.php.net/mail" target="_blank">mail()</a></code> function.
						</td>
					</tr>
					<tr>
						<th>&nbsp;</th>
						<td>
							<button class="btn btn-info" ng-click="TicketAccountsEdit.testOutgoingModal(); $event.preventDefault();"><i class="fa fa-bolt"></i> Test Account Settings</button>
						</td>
					</tr>
				</table>
			</div>
		</div>

		{############}
		{# SMTP     #}
		{############}

		<div class="ng-hide" ng-show="form.outgoing_type == 'smtp'">
			<div class="inner-group">
				<table width="100%" class="inner-form-table">
					<tr>
						<th width="75">Host</th>
						<td><input type="text" class="form-control" name="title" ng-model="form.out_smtp_account.host" style="width: 50%;" placeholder="localhost" /></td>
					</tr>
					<tr>
						<th>Port</th>
						<td><input type="text" class="form-control" name="title" ng-model="form.out_smtp_account.port" style="width: 80px;" placeholder="25" /></td>
					</tr>
					<tr>
						<th>Secure</th>
						<td>
							<label style="display: inline-block">
								<input type="checkbox" ng-model="form.out_smtp_account.secure" /> Enable secure network connection (SSL)
							</label>
							<div style="display: inline-block;" ng-show="form.out_smtp_account.secure">
								<select ui-select2 ng-model="form.out_smtp_account.secure_mode" style="width: 80px;">
									<option value="ssl">SSL</option>
									<option value="tls">TLS</option>
								</select>
							</div>
						</td>
					</tr>
					<tr>
						<th>Username</th>
						<td><input type="text" class="form-control" name="title" ng-model="form.out_smtp_account.user" style="width: 50%;" /></td>
					</tr>
					<tr>
						<th>Password</th>
						<td><input type="password" class="form-control" name="title" ng-model="form.out_smtp_account.password" style="width: 50%;" /></td>
					</tr>
					<tr>
						<th>&nbsp;</th>
						<td>
							<button class="btn btn-info" ng-click="TicketAccountsEdit.testOutgoingModal(); $event.preventDefault();"><i class="fa fa-bolt"></i> Test Account Settings</button>
						</td>
					</tr>
				</table>
			</div>
		</div>

		{############}
		{# Gmail    #}
		{############}

		<div class="ng-hide" ng-show="form.outgoing_type == 'gmail'">
			<div class="inner-group">
				<table width="100%" class="inner-form-table">
					<tr>
						<th width="100">Email Address</th>
						<td>
							<span ng-show="form.address">{{ ng_var('form.address') }}</span>
							<span ng-hide="form.address">Enter your email address above</span>
						</td>
					</tr>
					<tr>
						<th>Password</th>
						<td><input type="password" class="form-control" name="title" ng-model="form.out_gmail_account.password" style="width: 50%;" /></td>
					</tr>
					<tr>
						<th>&nbsp;</th>
						<td>
							<button class="btn btn-info" ng-click="TicketAccountsEdit.testOutgoingModal(); $event.preventDefault();"><i class="fa fa-bolt"></i> Test Account Settings</button>
						</td>
					</tr>
				</table>
			</div>
		</div>
	</div>
</div>