<div>
	<div class="modal-header">
		<button type="button" class="close" ng-click="dismiss()">&times;</button>
		<h4 class="modal-title">Test Outgoing Account</h4>
	</div>
	<div class="modal-body">
		<div ng-show="testing_started">
			<div ng-hide="is_testing">
				<div ng-if="is_success">
					<h3 style="margin-top: 0; margin-bottom: 10px;"><i class="fa fa-check-circle"></i> Your account details are correct</h3>
					<p>
						The account details you entered appear to be correct and the message looks like it was sent. You should
						verify that you received the test message in your inbox.
					</p>
					<p>
						<button class="btn btn-xs" ng-hide="showing_log" ng-click="showLog()"><i class="fa fa-file-text-o"></i> View Log</button>
					</p>
				</div>
				<div ng-if="!is_success">
					<h3 style="margin-top: 0; margin-bottom: 10px;"><i class="fa fa-clock-os-circle"></i> Your account details are incorrect</h3>
					<p>
						The account details you entered appear to be incorrect. Refer to the log below for more information
						or contact <a href="mailto:support@deskpro.com">support@deskpro.com</a> for assistance.
					</p>
				</div>
				<pre class="pre-scrollable" ng-show="showing_log || !is_success">{{ ng_var('log') }}</pre>
			</div>
			<div ng-show="is_testing">
				<br/><br/>
				<div class="text-center">
					Testing... Please wait. This may take a few minutes.
				</div>
				<br/><br/>
			</div>
		</div>
		<div ng-hide="testing_started">
			<table class="inner-form-table" width="100%">
				<tr>
					<th width="80">From:</th>
					<td><input type="text" class="form-control" ng-model="test_email.from" style="width: 70%;" required /></td>
				</tr>
				<tr>
					<th>To:</th>
					<td><input type="text" class="form-control" ng-model="test_email.to" style="width: 70%;" required /></td>
				</tr>
				<tr>
					<th>Subject:</th>
					<td><input type="text" class="form-control" ng-model="test_email.subject" style="width: 70%;" required /></td>
				</tr>
				<tr>
					<th>Message:</th>
					<td><textarea class="form-control" ng-model="test_email.subject" style="width: 70%; height: 80px;"></textarea></td>
				</tr>
			</table>
		</div>
	</div>
	<div class="modal-footer">
		<div ng-show="testing_started">
			<div ng-hide="is_testing">
				<button class="btn btn-info" ng-click="resetTest()"><i class="fa fa-bolt"></i> Test Again</button>
			</div>
			<div ng-show="is_testing">
				<i class="spinner-flat"></i>
			</div>
		</div>
		<div ng-hide="testing_started">
			<button class="btn btn-info" ng-click="testNow()"><i class="fa fa-bolt"></i> Run Test</button>
		</div>
	</div>
</div>