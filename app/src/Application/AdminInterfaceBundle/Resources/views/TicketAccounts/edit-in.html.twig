{##################################################################################################}
{# Incoming Account Details #}
{##################################################################################################}

<div class="form-group" ng-if="form.account_type != 'outgoing'">
	<div class="col-lg-3">
		<h3>{{ phrase('adm.tickets.account_details') }} *</h3>
	</div>
	<div class="col-lg-9">

		{############}
		{# Selector #}
		{############}

		<div class="inner-group" style="padding-top: 3px;">
			<select
					ui-select2
					ng-model="form.incoming_type"
					style="min-width: 240px"
					>
				<option value="">Select Type</option>
				<option value="imap">IMAP</option>
				<option value="pop3">POP3</option>
				<option value="gmail">GMail or Google Apps</option>
				<option value="exchange">MS Exchange</option>
			</select>
		</div>

		{############}
		{# POP3     #}
		{############}

		<div class="ng-hide" ng-show="form.incoming_type == 'pop3'">
			<div class="inner-group">
				<table width="100%" class="inner-form-table">
					<tr>
						<th width="75">Host</th>
						<td><input type="text" class="form-control" name="title" ng-model="form.in_pop3_account.host" style="width: 50%;" placeholder="localhost" ></td>
					</tr>
					<tr>
						<th>Port</th>
						<td><input type="text" class="form-control" name="title" ng-model="form.in_pop3_account.port" style="width: 80px;" placeholder="110" /></td>
					</tr>
					<tr>
						<th>Secure</th>
						<td>
							<label style="display: inline-block">
								<input type="checkbox" ng-model="form.in_pop3_account.secure" /> Enable secure network connection
							</label>
							<div style="display: inline-block;" ng-show="form.in_pop3_account.secure">
								<select ui-select2 ng-model="form.in_pop3_account.secure_mode" style="width: 80px;">
									<option value="ssl">SSL</option>
									<option value="tls">TLS</option>
								</select>
							</div>
						</td>
					</tr>
					<tr>
						<th>Username</th>
						<td><input type="text" class="form-control" name="title" ng-model="form.in_pop3_account.user" style="width: 50%;" /></td>
					</tr>
					<tr>
						<th>Password</th>
						<td><input type="password" class="form-control" name="title" ng-model="form.in_pop3_account.password" style="width: 50%;" /></td>
					</tr>
					<tr>
						<th>&nbsp;</th>
						<td>
							<button class="btn btn-info" ng-click="TicketAccountsEdit.testAccountModal(); $event.preventDefault();"><i class="fa fa-bolt"></i> Test Account Settings</button>
						</td>
					</tr>
				</table>
			</div>
		</div>

		{############}
		{# IMAP     #}
		{############}

		<div class="ng-hide" ng-show="form.incoming_type == 'imap'">
			{% if server_capable('imap') %}
				<div class="inner-group">
					<table width="100%" class="inner-form-table">
						<tr>
							<th width="100">Host</th>
							<td><input type="text" class="form-control" name="title" ng-model="form.in_imap_account.host" style="width: 50%;" placeholder="localhost" ></td>
						</tr>
						<tr>
							<th>Port</th>
							<td><input type="text" class="form-control" name="title" ng-model="form.in_imap_account.port" style="width: 80px;" placeholder="110" /></td>
						</tr>
						<tr>
							<th>Secure</th>
							<td>
								<label style="display: inline-block">
									<input type="checkbox" ng-model="form.in_imap_account.secure" /> Enable secure network connection
								</label>
								<div style="display: inline-block;" ng-show="form.in_imap_account.secure">
									<select ui-select2 ng-model="form.in_imap_account.secure_mode" style="width: 80px;">
										<option value="ssl">SSL</option>
										<option value="tls">TLS</option>
									</select>
								</div>
							</td>
						</tr>
						<tr>
							<th>Username</th>
							<td><input type="text" class="form-control" name="title" ng-model="form.in_imap_account.user" style="width: 50%;" /></td>
						</tr>
						<tr>
							<th>Password</th>
							<td><input type="password" class="form-control" name="title" ng-model="form.in_imap_account.password" style="width: 50%;" /></td>
						</tr>
						<tr>
							<th style="vertical-align: top; padding-top: 10px;">IMAP Folder</th>
							<td style="padding-bottom: 10px;">
								<label style="margin-bottom: 10px;"><input type="radio" ng-model="form.in_imap_account.read_mailbox_type" value="inbox" /> Read messages from the inbox</label>
								<label style="display: inline-block;"><input type="radio" ng-model="form.in_imap_account.read_mailbox_type" value="folder" /> Read messages from a specific folder</label>
								<div ng-hide="form.in_imap_account.read_mailbox_type != 'folder'" style="margin: 4px 0 0 15px;">
									Read from folder: <input style="width: 200px;" type="text" class="form-control" name="title" ng-model="form.in_imap_account.read_mailbox" />
								</div>
							</td>
						</tr>
						<tr>
							<th style="vertical-align: top; padding-top: 10px;">Read Mode</th>
							<td style="padding-bottom: 10px;">
								<div>
									<label><input type="radio" ng-model="form.in_imap_account.mode" value="read" /> Read all unread messages</label>
									<span class="help-block" ng-show="form.in_imap_account.mode == 'read'">
										DeskPRO will read and process all unread messages in the mailbox. After processing, messages are marked as read but stay in the mailbox.
									</span>
								</div>
								<div style="margin: 10px 0;">
									<label style="display: inline-block"><input type="radio" ng-model="form.in_imap_account.mode" value="archive" /> Read all messages and then move</label>
									<div ng-show="form.in_imap_account.mode == 'archive'" style="margin: 4px 0 0 15px;">
										Move to folder: <input type="text" class="form-control" ng-model="form.in_imap_account.archive_mailbox" style="width: 150px;" />
									</div>
									<span class="help-block" ng-show="form.in_imap_account.mode == 'archive'">
										All messages in the mailbox are read and processed. After DeskPRO has processed a message, it will move it into a different folder.
									</span>
								</div>
								<div>
									<label><input type="radio" ng-model="form.in_imap_account.mode" value="delete" /> Read all messages and then delete</label>
									<span class="help-block" ng-show="form.in_imap_account.mode == 'delete'">
										All messages in the mailbox are read and processed. After DeskPRO has processed a message, it will be marked for deletion.
									</span>
								</div>
							</td>
						</tr>
						<tr>
							<th>&nbsp;</th>
							<td>
								<button class="btn btn-info" ng-click="TicketAccountsEdit.testAccountModal(); $event.preventDefault();"><i class="fa fa-bolt"></i> Test Account Settings</button>
							</td>
						</tr>
					</table>
				</div>
			{% else %}
				<div class="inner-group">
					<br/><br/>
					<div class="alert alert-danger">
						<p>
							To set up IMAP accounts, your server must be configured with the PHP <a href="http://php.net/manual/en/book.imap.php">IMAP extension</a>.
						</p>
						<p>
							Please install the IMAP extension then try again.
						</p>
					</div>
				</div>
			{% endif %}
		</div>

		{############}
		{# Gmail    #}
		{############}

		<div class="ng-hide" ng-show="form.incoming_type == 'gmail'">
			<div class="inner-group">
				<table width="100%" class="inner-form-table">
					<tr>
						<th width="100">Email Address</th>
						<td>
							<span ng-show="form.address">{{ ng_var('form.address') }}</span>
							<span ng-hide="form.address">Enter your email address above</span>
						</td>
					</tr>
					<tr>
						<th>Password</th>
						<td><input type="password" class="form-control" name="title" ng-model="form.in_gmail_account.password" style="width: 50%;" /></td>
					</tr>
					<tr>
						<th>&nbsp;</th>
						<td>
							<button class="btn btn-info" ng-click="TicketAccountsEdit.testAccountModal(); $event.preventDefault();"><i class="fa fa-bolt"></i> Test Account Settings</button>
						</td>
					</tr>
				</table>
			</div>
		</div>

		{###############}
		{# MS Exchange #}
		{###############}

		<div class="ng-hide" ng-show="form.incoming_type == 'exchange'">
			{% if server_capable('soap') %}
				<div class="inner-group">
					<table width="100%" class="inner-form-table">
						<tr>
							<th width="100">EWS Host</th>
							<td>
								https://<input type="text" class="form-control" name="host" ng-model="form.in_exchange_account.host" style="display: inline-block; width: 50%;" />
								<br/>
								<span class="help-block">
									DeskPRO communicates with Exchange through <a href="http://msdn.microsoft.com/en-us/library/office/dd877045%28v=exchg.140%29.aspx" target="_blank">Exchange Web Services</a>. Make
									sure EWS is configured and your firewall is not blocking connections.
								</span>
							</td>
						</tr>
						<tr>
							<th>Username</th>
							<td><input type="text" class="form-control" name="username" ng-model="form.in_exchange_account.user" style="width: 50%;" /></td>
						</tr>
						<tr>
							<th>Password</th>
							<td><input type="password" class="form-control" name="password" ng-model="form.in_exchange_account.password" style="width: 50%;" /></td>
						</tr>
						<tr>
							<th style="vertical-align: top; padding-top: 10px;">Folder</th>
							<td style="padding-bottom: 10px;">
								<label style="margin-bottom: 10px;"><input type="radio" ng-model="form.in_exchange_account.read_mailbox_type" value="inbox" /> Read messages from the inbox</label>
								<label style="display: inline-block;"><input type="radio" ng-model="form.in_exchange_account.read_mailbox_type" value="folder" /> Read messages from a specific folder</label>
								<div ng-hide="form.in_exchange_account.read_mailbox_type != 'folder'" style="margin: 4px 0 0 15px;">
									Read from folder: <input style="width: 200px;" type="text" class="form-control" name="title" ng-model="form.in_exchange_account.read_mailbox" />
								</div>
							</td>
						</tr>
						<tr>
							<th style="vertical-align: top; padding-top: 10px;">Read Mode</th>
							<td style="padding-bottom: 10px;">
								<div>
									<label><input type="radio" ng-model="form.in_exchange_account.mode" value="read" /> Read all unread messages</label>
									<span class="help-block" ng-show="form.in_exchange_account.mode == 'read'">
										DeskPRO will read and process all unread messages in the mailbox. After processing, messages are marked as read but stay in the mailbox.
									</span>
								</div>
								<div style="margin: 10px 0;">
									<label style="display: inline-block"><input type="radio" ng-model="form.in_exchange_account.mode" value="archive" /> Read all messages and then move</label>
									<div ng-show="form.in_exchange_account.mode == 'archive'" style="margin: 4px 0 0 15px;">
										Move to folder: <input type="text" class="form-control" ng-model="form.in_exchange_account.archive_mailbox" style="width: 150px;" />
									</div>
									<span class="help-block" ng-show="form.in_exchange_account.mode == 'archive'">
										All messages in the mailbox are read and processed. After DeskPRO has processed a message, it will move it into a different folder.
									</span>
								</div>
								<div>
									<label><input type="radio" ng-model="form.in_exchange_account.mode" value="delete" /> Read all messages and then delete</label>
									<span class="help-block" ng-show="form.in_exchange_account.mode == 'delete'">
										All messages in the mailbox are read and processed. After DeskPRO has processed a message, it will be marked for deletion.
									</span>
								</div>
							</td>
						</tr>
						<tr>
							<th>&nbsp;</th>
							<td>
								<button class="btn btn-info" ng-click="TicketAccountsEdit.testAccountModal(); $event.preventDefault();"><i class="fa fa-bolt"></i> Test Account Settings</button>
							</td>
						</tr>
					</table>
				</div>
			{% else %}
				<div class="inner-group">
					<br/><br/>
					<div class="alert alert-danger">
						<p>
							To set up Exchange accounts, your server must be configured with the PHP <a href="http://php.net/manual/en/book.soap.php">SOAP extension</a>.
						</p>
						<p>
							Please install the SOAP extension then try again.
						</p>
					</div>
				</div>
			{% endif %}
		</div>
	</div>
</div>