{% extends 'AdminInterfaceBundle:Layout:list.html.twig' %}
{% block listpane_content %}
    <section class="dp-paneblock dp-listpane">
        <header>
            <h3>{{ phrase('adm.general.tasks') }}</h3>
        </header>
        <article class="form-horizontal dp-form">
            <div class="panel panel-innertable">
                <div class="form-group">
                    <div class="col-lg-12">
                        <div class="inner-group">
                            <label>
                                <input type="radio" name="task_enabled" value="1" ng-model="settings.enabled" />
                                {{ phrase('adm.tasks.label_enabled') }}
                            </label>
                        </div>
                        <div class="inner-group">
                            <label>
                                <input type="radio" name="task_enabled" value="0" ng-model="settings.enabled" />
                                {{ phrase('adm.tasks.label_disabled') }}
                            </label>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-lg-12">
                        <div class="inner-group">
                            <label style="width: 200px;margin-top: 20px;">
                                <h4>{{ phrase('adm.tasks.task_reminder_time') }}</h4>
                            </label>
                            <select ng-model="settings.task_reminder_time" ui-select2>
                                {% for i in range(0,23) %}
                                    {% if i < 10 %}{% set i = '0' ~ i %}{% endif %}
                                    {% set time1 = i ~ ':00' %}
                                    {% set time2 = i ~ ':30' %}
                                    <option value="{{ time1 }}">{{ time1 }}</option>
                                    <option value="{{ time2 }}">{{ time2 }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </article>

        <footer>
            <div class="dp-content">
                <div class="dp-btn-controls">
                    <div dp-hide-spinning="saving">
                        <button class="btn btn-primary" type="button" ng-click="EditCtrl.save()">
                            {{ phrase('agent.general.save') }}
                        </button>
                    </div>
                    <div dp-show-spinning="saving">
                        <i class="spinner-flat"></i>
                    </div>
                </div>
            </div>
        </footer>

    </section>
{% endblock %}

{% block listpane_help %}
    {% include 'AdminInterfaceBundle:Tasks:help-page.html.twig' %}
{% endblock %}