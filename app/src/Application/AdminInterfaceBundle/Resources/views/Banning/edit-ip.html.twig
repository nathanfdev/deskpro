{% extends 'AdminInterfaceBundle:Layout:list-editpane.html.twig' %}

{% block editpane_content %}

	<form role="form" name="form_props" ng-submit="form_props.$valid && EditCtrl.saveForm()">
		<section class="dp-paneblock dp-editpane">
			<article class="form-horizontal dp-form">
				<div class="panel panel-fill indent">
					<div class="panel-body">
						<div class="form-group">
							<div class="col-lg-3">
								<h3>IP Address Pattern</h3>
							</div>
							<div class="col-lg-9">
								<div class="inner-group" dp-error-class="form_props.banned_ip">
									<input type="text" class="form-control" name="banned_ip"
										   ng-model="EditCtrl.form.banned_ip"
										   style="width: 50%;" required autofocus/>
									<span class="help-block">
										Examples: 192.168.1.1 or 192.168.*
									</span>
								</div>
							</div>
						</div>
					</div>
				</div>
			</article>

			<footer>
				<div class="dp-content">
					<div class="text-danger ng-hide" ng-show="form_props.$attempted && form_props.$invalid">
						<p><strong>{{ phrase('adm.general.please_correct_errors') }}</strong></p>
						<ul>
							<li ng-show="form_props.banned_ip.$error.required">Please set IP Address Pattern</li>
						</ul>
					</div>

					<div class="dp-delete-control" ng-if="EditCtrl.ip_ban.banned_ip" ng-hide="form_props.$attempted && form_props.$invalid">
						<button class="btn btn-danger"
								ng-click="$event.preventDefault(); $parent.ListCtrl.startDelete(EditCtrl.ip_ban.banned_ip);">
							Delete
						</button>
					</div>

					<div class="dp-btn-controls" ng-hide="form_props.$attempted && form_props.$invalid">
						<div dp-hide-spinning="saving">
							<button class="btn btn-primary" dp-submit-form>{{ phrase('agent.general.save') }}</button>
						</div>
						<div dp-show-spinning="saving">
							<i class="spinner-flat"></i>
						</div>
					</div>
				</div>
			</footer>

		</section>
	</form>

{% endblock %}