{% extends 'AdminInterfaceBundle:Labels:layout.html.twig' %}
{% block listpane_content %}
    {% include 'AdminInterfaceBundle:Labels:Common/list-section.html.twig' with {prefix: 'portal.kb_labels'} %}
{% endblock %}
{% block listpane_help %}
	<header>
		<h1>Labeling articles helps users navigate the portal.</h1>
<p>Labels are text tags that agents can use to help organize your helpdesk content.</p>
</header>
<article>
<section>
			<p>Labels are used to match items when agents or users search helpdesk content. They are also displayed in the agent filter pane.</p>

<p>Labels applied to Knowledgebase articles are visible to users from the web portal.</p>

		<p>You can rename or delete wrongly spelled or unhelpful labels using this screen.</p>
	
		<p>You can also give each label a color.</p>
</section>
<section>
<h2><span>FAQ</span></h2>
<dl>
		<dt><em>Q:</em>How do I merge two labels?</dt>
		<dd><em>A:</em>
		Edit one label to have the same name as another, and the labels will be merged.
		</dd>
		

</dl>



</section>
<section class="related-content">
<h2><span>Related Content</span></h2>
<ul>
<li><i class="fa fa-book"></i> <a href="https://www.deskpro.com/manuals/admin-manual/admin-manual.html#labels" target="_blank">Managing labels</a></li>

					<li><i class="fa fa-book"></i> <a href="https://www.deskpro.com/manuals/admin-manual/admin-manual.html#setting-label-colors" target="_blank">Setting label colors</a></li>
</ul>
    </section> 
    
</article>
	
	
{% endblock %}