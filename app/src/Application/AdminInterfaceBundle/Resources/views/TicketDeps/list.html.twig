<div class="pane">
	<header class="pane-header">
		<h3><i class="icon-briefcase"></i> Tickets &rarr; Departments</h3>
	</header>
	<article class="pane-content no-pad">
		<div class="panel panel-fill">
			<div class="panel-heading">
				<nav class="dp-controls">
					<ul>
						<li><span class="btn btn-danger" ng-class="{active: delete_mode}" ng-click="delete_mode = !delete_mode;"><i class="icon-trash"></i> Delete</span></li>
						<li><a class="btn btn-success" href="#/tickets/ticket_deps/create"><i class="icon-plus"></i> Add</a></li>
					</ul>
				</nav>
				<h3>{{ ng_var('TicketDepsList.departments.length') }} Departments</h3>
			</div>
			<ul class="dp-item-list" ui-sortable="TicketDepsList.sortedListOptions">
				<li ng-repeat="dep in TicketDepsList.parent_deps" dp-state-mark="tickets.ticket_deps.edit.{{ ng_var('dep.id') }}" data-id="{{ ng_var('dep.id') }}">
					<a href="#/tickets/ticket_deps/{{ ng_var('dep.id') }}">
						<i class="icon-reorder drag-handle"></i>
						<div class="pull-right">
							<span class="badge" ng-hide="delete_mode" style="margin-top: -1px;">ID: {{ ng_var('dep.id') }}</span>
							<span class="btn btn-danger btn-xs only-icon" ng-show="delete_mode" style="margin-top: -3px;" ng-click="TicketDepsList.startDelete(dep); $event.preventDefault();"><i class="icon-trash"></i></span>
						</div>
						<h4><span class="title-text">{{ ng_var('dep.title') }}</span></h4>
					</a>
					<ul class="dp-item-list sublist" ng-if="TicketDepsList.child_deps[dep.id]" ui-sortable="TicketDepsList.sortedListOptions">
						<li ng-repeat="subdep in TicketDepsList.child_deps[dep.id]" dp-state-mark="tickets.ticket_deps.edit.{{ ng_var('subdep.id') }}" data-id="{{ ng_var('subdep.id') }}">
							<a href="#/tickets/ticket_deps/{{ ng_var('subdep.id') }}">
								<i class="icon-reorder drag-handle"></i>
								<div class="pull-right">
									<span class="badge" ng-hide="delete_mode" style="margin-top: -1px;">ID: {{ ng_var('subdep.id') }}</span>
									<span class="btn btn-danger btn-xs only-icon " ng-show="delete_mode" style="margin-top: -3px;" ng-click="TicketDepsList.startDelete(subdep); $event.preventDefault();"><i class="icon-trash"></i></span>
								</div>
								<h4>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-- <span class="title-text">{{ ng_var('subdep.title') }}</span></h4>
							</a>
						</li>
					</ul>
				</li>
			</ul>
		</div>

		<div class="panel panel-fill">
			<div class="panel-heading">
				<h3>Department Settings</h3>
			</div>
			<div class="panel-body">
				<form class="form-horizontal" role="form">
					<div class="form-group">
						<div class="col-sm-4 text-right">
							<label for="title">Default Department</label>
						</div>
						<div class="col-sm-7">
							<select
								ui-select2
								ng-model="TicketDepsList.dep_settings.default_id"
								style="width: 200px"
							>
								<option value="{{ ng_var('dep.id') }}" ng-repeat="dep in TicketDepsList.default_dep_list">{{ ng_var('dep._full_title') }}</option>
							</select>
						</div>
					</div>

					<div class="form-group">
						<div class="col-sm-4 text-right">
							<label for="title">Phrase</label>
						</div>
						<div class="col-sm-7">
							<p class="help-block">Change the name of the Department field</p>
							<table cellspacing="0" cellpadding="2" width="100%">
								<tbody>
									<tr>
										<td class="text-right">Singular:&nbsp;</td>
										<td width="100%"><input type="text" ng-model="TicketDepsList.dep_settings.name_singular" class="form-control input-sm" style="width: 100%;" /></td>
									</tr>
									<tr>
										<td class="text-right">Plural:&nbsp;</td>
										<td><input type="text" ng-model="TicketDepsList.dep_settings.name_plural" class="form-control input-sm" style="width: 100%" /></td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>
				</form>
			</div>
			<div class="panel-footer text-center">
				<button class="btn btn-primary" ng-click="TicketDepsList.saveSettings()">Save Settings</button>
			</div>
		</div>
	</article>
</div>