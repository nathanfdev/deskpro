<div class="pane">
	<header class="pane-header">
		<h3><i class="fa fa-briefcase"></i> {{ phrase('adm.general.apps_tickets') }} &rarr; {{ phrase('agent.general.departments') }}</h3>
		<button class="btn help-page-trigger"><i class="fa fa-question-circle"></i></button>
	</header>
	<article class="pane-content">
		<div class="panel panel-fill">
			<div class="panel-heading">
				<nav class="dp-controls" style="display: none;">
					<ul>
						<li>
							<span dp-ping-flash="display_orders" class="saved-ping"><i class="fa fa-check-square-o-square"></i> {{ phrase('agent.general.saved') }}</span>
						</li>
						<li><span class="btn btn-danger" ng-class="{active: delete_mode}" ng-click="delete_mode = !delete_mode;"><i class="fa fa-trash-o"></i> {{ phrase('agent.general.delete') }}</span></li>
						<li><a class="btn btn-success" href="{{ ng_href('tickets.ticket_deps.gocreate') }}"><i class="fa fa-plus"></i> {{ phrase('agent.general.add') }}</a></li>
					</ul>
				</nav>
				<h3 ng-pluralize count="TicketDepsList.departments.length || 0" when="{{ ng_plural_phrase('adm.general.x_departments') }}"></h3>
			</div>
			<ul class="dp-item-list" ui-sortable="TicketDepsList.sortedListOptions">
				<li class="with-drag-handle" ng-repeat="dep in TicketDepsList.parent_deps" dp-state-mark="tickets.ticket_deps.edit.{{ ng_var('dep.id') }}" data-id="{{ ng_var('dep.id') }}">
					<a href="{{ ng_href('tickets.ticket_deps.edit', '{id: dep.id}') }}">
						<i class="fa fa-bars drag-handle"></i>
						<div class="pull-right">
							<span class="btn btn-danger btn-xs only-icon" ng-show="delete_mode" style="margin-top: -3px;" ng-click="TicketDepsList.startDelete(dep); $event.preventDefault();"><i class="fa fa-trash-o"></i></span>
						</div>
						<h4><span class="title-text">{{ ng_var('dep.title') }}</span></h4>
					</a>
					<ul class="dp-item-list sublist" ng-if="TicketDepsList.child_deps[dep.id]" ui-sortable="TicketDepsList.sortedListOptions">
						<li class="with-drag-handle" ng-repeat="subdep in TicketDepsList.child_deps[dep.id]" dp-state-mark="tickets.ticket_deps.edit.{{ ng_var('subdep.id') }}" data-id="{{ ng_var('subdep.id') }}">
							<a href="{{ ng_href('tickets.ticket_deps.edit', '{id: subdep.id}') }}">
								<i class="fa fa-bars drag-handle"></i>
								<div class="pull-right">
									<span class="btn btn-danger btn-xs only-icon " ng-show="delete_mode" style="margin-top: -3px;" ng-click="TicketDepsList.startDelete(subdep); $event.preventDefault();"><i class="fa fa-trash-o"></i></span>
								</div>
								<h4>
									<span class="tree-char middle" ng-if="!$last"></span>
									<span class="tree-char last" ng-if="$last"></span>
									<span class="title-text">{{ ng_var('subdep.title') }}</span>
								</h4>
							</a>
						</li>
					</ul>
				</li>
			</ul>
			<div class="add-btn-wrap">
				<a class="btn btn-success" href="{{ ng_href('tickets.ticket_deps.gocreate') }}"><i class="fa fa-plus"></i> {{ phrase('agent.general.add') }}</a>
			</div>

			<div class="panel-body ng-hide" ng-show="TicketDepsList.departments.length == 1">
				<div class="alert alert-info">
					<p>
						{{ phrase('adm.departments.not_user_visible') }}
					</p>
				</div>
			</div>
		</div>
	</article>

	<a class="pane-nav-btn" href="{{ ng_href('tickets.emailsources') }}">
		<span class="arrow"><i class="fa fa-chevron-down"></i></span>
		<span class="title">Incoming Email Log</span>
	</a>
	<a class="pane-nav-btn" href="{{ ng_href('tickets.sendmailqueue') }}">
		<span class="arrow"><i class="fa fa-chevron-down"></i></span>
		<span class="title">Outgoing Email Log</span>
	</a>
</div>
<div dp-register-message="saved_settings">{{ phrase('adm.general.save_settings_success') }}</div>
<div dp-register-message="no_delete_last">{{ phrase('adm.departments.no_delete_last') }}</div>
{% include 'AdminInterfaceBundle:TicketDeps:help-page.html.twig' %}