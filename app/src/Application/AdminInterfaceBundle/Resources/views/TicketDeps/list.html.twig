<div class="pane">
	<header class="pane-header">
		<h3><i class="icon-briefcase"></i> {{ phrase('admin.general.apps_tickets') }} &rarr; {{ phrase('agent.general.departments') }}</h3>
		<button class="btn help-page-trigger"><i class="icon-question-sign"></i></button>
	</header>
	<article class="pane-content no-pad">
		<div class="panel panel-fill">
			<div class="panel-heading">
				<nav class="dp-controls">
					<ul>
						<li>
							<span dp-ping-flash="display_orders" class="saved-ping"><i class="icon-check-sign"></i> {{ phrase('agent.general.saved') }}</span>
						</li>
						<li><span class="btn btn-danger" ng-class="{active: delete_mode}" ng-click="delete_mode = !delete_mode;"><i class="icon-trash"></i> {{ phrase('agent.general.delete') }}</span></li>
						<li><a class="btn btn-success" href="#/tickets/ticket_deps/go-create"><i class="icon-plus"></i> {{ phrase('agent.general.add') }}</a></li>
					</ul>
				</nav>
				<h3 ng-if="TicketDepsList.departments" translate="admin.general.x_departments" translate-values="{ count_length: TicketDepsList.departments }"></h3>
			</div>
			<ul class="dp-item-list" ui-sortable="TicketDepsList.sortedListOptions">
				<li class="with-drag-handle" ng-repeat="dep in TicketDepsList.parent_deps" dp-state-mark="tickets.ticket_deps.edit.{{ ng_var('dep.id') }}" data-id="{{ ng_var('dep.id') }}">
					<a href="#/tickets/ticket_deps/{{ ng_var('dep.id') }}">
						<i class="icon-reorder drag-handle"></i>
						<div class="pull-right">
							<span class="badge" ng-hide="delete_mode" style="margin-top: -2px;" tooltip="The ID can be used in the API" tooltip-placement="left">ID: {{ ng_var('dep.id') }}</span>
							<span class="btn btn-danger btn-xs only-icon" ng-show="delete_mode" style="margin-top: -3px;" ng-click="TicketDepsList.startDelete(dep); $event.preventDefault();"><i class="icon-trash"></i></span>
						</div>
						<h4><span class="title-text">{{ ng_var('dep.title') }}</span></h4>
					</a>
					<ul class="dp-item-list sublist" ng-if="TicketDepsList.child_deps[dep.id]" ui-sortable="TicketDepsList.sortedListOptions">
						<li class="with-drag-handle" ng-repeat="subdep in TicketDepsList.child_deps[dep.id]" dp-state-mark="tickets.ticket_deps.edit.{{ ng_var('subdep.id') }}" data-id="{{ ng_var('subdep.id') }}">
							<a href="#/tickets/ticket_deps/{{ ng_var('subdep.id') }}">
								<i class="icon-reorder drag-handle"></i>
								<div class="pull-right">
									<span class="badge" ng-hide="delete_mode" style="margin-top: -2px;" tooltip="The ID can be used in the API" tooltip-placement="left">ID: {{ ng_var('subdep.id') }}</span>
									<span class="btn btn-danger btn-xs only-icon " ng-show="delete_mode" style="margin-top: -3px;" ng-click="TicketDepsList.startDelete(subdep); $event.preventDefault();"><i class="icon-trash"></i></span>
								</div>
								<h4>
									<span class="tree-char middle" ng-if="!$last"></span>
									<span class="tree-char last" ng-if="$last"></span>
									<span class="title-text">{{ ng_var('subdep.title') }}</span>
								</h4>
							</a>
						</li>
					</ul>
				</li>
			</ul>

			<div class="panel-body ng-hide" ng-show="TicketDepsList.departments.length == 1">
				<div class="alert alert-info">
					<p>
						{{ phrase('admin.departments.not_user_visible') }}
					</p>
				</div>
			</div>
		</div>

		<div class="panel panel-fill">
			<div class="panel-heading">
				<h3>{{ phrase('admin.departments.department_settings') }}</h3>
			</div>
			<div class="panel-body">
				<form class="form-horizontal dp-form" role="form">
					<div class="form-group">
						<div class="col-sm-3">
							<h3>{{ phrase('agent.general.default') }}</h3>
						</div>
						<div class="col-sm-9">
							<select
								ui-select2
								ng-model="TicketDepsList.dep_settings.default_id"
								style="width: 200px"
							>
								<option value="{{ ng_var('dep.id') }}" ng-repeat="dep in TicketDepsList.default_dep_list">{{ ng_var('dep._full_title') }}</option>
							</select>
							<span class="help-block">
								{{ phrase('admin.departments.default_explain') }}
							</span>
						</div>
					</div>

					<div class="form-group">
						<div class="col-sm-3">
							<h3>{{ phrase('agent.general.field_name_title') }}</h3>
						</div>
						<div class="col-sm-9">
							<label>
								<input type="checkbox" ng-model="TicketDepsList.dep_settings.do_rename" />
								<h4>{{ phrase('admin.departments.rename_department_field') }}</h4>
							</label>
							<span class="help-block">
								{{ phrase('admin.departments.rename_department_field_explain') }}
							</span>
							<div ng-show="TicketDepsList.dep_settings.do_rename">
								<div class="inner-group">
									<span>{{ phrase('admin.departments.singular') }}:</span><br/>
									<input type="text" ng-model="TicketDepsList.dep_settings.name_singular" class="form-control input-sm" style="width: 60%;" placeholder="Ex: Region" />
								</div>
								<div class="inner-group">
									<span>{{ phrase('admin.departments.singular') }}</span><br/>
									<input type="text" ng-model="TicketDepsList.dep_settings.name_plural" class="form-control input-sm" style="width: 60%" placeholder="Ex: Regions" />
								</div>
							</div>
						</div>
					</div>
				</form>

				<div class="text-center">
					<div dp-hide-spinning="saving_settings">
						<button class="btn btn-primary" ng-click="TicketDepsList.saveSettings()">Save Settings</button>
					</div>
					<div dp-show-spinning="saving_settings">
						<i class="spinner-flat"></i>
					</div>

				</div>
			</div>
		</div>
	</article>
</div>
<div dp-register-message="saved_settings">{{ phrase('admin.general.save_settings_success') }}</div>
<div dp-register-message="no_delete_last">{{ phrase('admin.departments.no_delete_last') }}</div>
{% include 'AdminInterfaceBundle:TicketDeps:help-page.html.twig' %}