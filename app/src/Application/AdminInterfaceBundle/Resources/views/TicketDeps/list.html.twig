{% extends 'AdminInterfaceBundle:Layout:list.html.twig' %}
{% block listpane_content %}
	<section class="dp-paneblock dp-listpane">
		<header>
			<nav>
				<span class="status-pinger saved-ping" dp-ping-flash="display_orders"><i class="fa fa-check-square-o-square"></i> {{ phrase('agent.general.saved') }}</span>
			</nav>
			<h3 ng-pluralize count="TicketDepsList.departments.length || 0" when="{{ ng_plural_phrase('adm.general.x_departments') }}"></h3>
		</header>
		<article>
			<ul class="dp-item-list" ui-sortable="TicketDepsList.sortedListOptions" dp-list-autoload>
				<li class="with-drag-handle" ng-repeat="dep in TicketDepsList.parent_deps" dp-state-mark="tickets.ticket_deps.edit.{{ ng_var('dep.id') }}" data-id="{{ ng_var('dep.id') }}">
					<a href="{{ ng_href('tickets.ticket_deps.edit', '{id: dep.id}') }}">
						<i class="fa fa-bars drag-handle"></i>
						<div class="pull-right">
							<span class="btn btn-danger btn-xs only-icon" ng-show="delete_mode" style="margin-top: -3px;" ng-click="TicketDepsList.startDelete(dep); $event.preventDefault();"><i class="fa fa-trash-o"></i></span>
						</div>
						<h4><span class="title-text">{{ ng_var('dep.title') }}</span></h4>
					</a>
					<ul class="dp-item-list sublist" ng-if="TicketDepsList.child_deps[dep.id]" ui-sortable="TicketDepsList.sortedListOptions">
						<li class="with-drag-handle" ng-repeat="subdep in TicketDepsList.child_deps[dep.id]" dp-state-mark="tickets.ticket_deps.edit.{{ ng_var('subdep.id') }}" data-id="{{ ng_var('subdep.id') }}">
							<a href="{{ ng_href('tickets.ticket_deps.edit', '{id: subdep.id}') }}">
								<i class="fa fa-bars drag-handle"></i>
								<div class="pull-right">
									<span class="btn btn-danger btn-xs only-icon " ng-show="delete_mode" style="margin-top: -3px;" ng-click="TicketDepsList.startDelete(subdep); $event.preventDefault();"><i class="fa fa-trash-o"></i></span>
								</div>
								<h4>
									<span class="tree-char middle" ng-if="!$last"></span>
									<span class="tree-char last" ng-if="$last"></span>
									<span class="title-text">{{ ng_var('subdep.title') }}</span>
								</h4>
							</a>
						</li>
					</ul>
				</li>
			</ul>
			<div class="dp-add-control">
				<a class="btn btn-default" href="{{ ng_href('tickets.ticket_deps.gocreate') }}" dp-list-autoload autoload-priority="2"><i class="fa fa-plus"></i> New Department</a>
			</div>

			<div class="dp-empty-list-notice" ng-show="TicketDepsList.departments.length == 1">
				<p>
					{{ phrase('adm.departments.not_user_visible') }}
				</p>
			</div>
		</article>
	</section>

	<section class="dp-paneblock dp-panelink">
		<a href="{{ ng_href('tickets.ticket_deps.settings') }}">
			<em><i class="fa fa-chevron-down"></i></em>
			<h3>Department Settings</h3>
		</a>
	</section>

	<div dp-register-message="saved_settings">{{ phrase('adm.general.save_settings_success') }}</div>
	<div dp-register-message="no_delete_last">{{ phrase('adm.departments.no_delete_last') }}</div>
{% endblock %}
{% block listpane_help %}
	<header>
		<h1>Departments are the primary grouping for tickets in your helpdesk</h1>
		<p>
			The Department field has functionality and importance that other fields do not.
		</p>
	</header>
	<article>
		<ul>
			<li>Department is the default grouping field for tickets in the Agent Interface.</li>
			<li>Agent ticket permissions are based upon Departments; you can create agents that can view some tickets but not others.</li>
			<li>User ticket permissions are based upon Departments; you can create Usergroups that can create tickets in certain Departments but not in others.</li>
			<li>Departments control the fields shown when creating a ticket. Different departments can have different custom fields.</li>
			<li>You can set a different name for the Department for Users and Agents e.g. "Terms of Service Violations" for Agents and "Support" for Users.</li>
			<li>You can have a direct 1-1 link between departments (e.g. Sales) and email accounts (e.g. sales@yourdomain.com).</li>
			<li>Each ticket will have a Department - it is the only required field in DeskPRO.</li>
		</ul>
		<p>
			Typical example Department sets include:
		</p>
		<ul>
			<li>A general helpdesk may use Departments such as "Support", "Sales", and "Billing"</li>
			<li>An e-commerce helpdesk may use Departments such as "Sales Question", "Problem with my Order", "Where is my Order" and "Returns"</li>
			<li>An IT helpdesk may use Departments such as "Hardware Problem", "Software Issue", "Password Reset"</li>
		</ul>

		<h2>FAQ</h2>
		<dl>
			<dt>How many departments can I have?</dt>
			<dd>
				You can have an unlimited number of departments. Typically, companies will have less than 10 departments but you can
				structure your Departments as you feel suitable.
			</dd>

			<dt>Can I use Sub Departments (Child Departments)?</dt>
			<dd>
				Yes. A department can be a child or parent of another. E.g. Support -> Support Tier 1 and Support Tier 2. Please note that tickets
				can only be assigned to a child department and not to a department that has sub-departments.
			</dd>

			<dt>I don't need Departments - can I disable the field?</dt>
			<dd>
				Although each ticket will always have a department, if you only have 1 Department defined - the Department field
				will not be shown to users, which has the same effect as disabling the field.
			</dd>

			<dt>Can I have multiple Departments linked to a single email address.</dt>
			<dd>
				Yes. You can create 1-1 links between Departments and Email Accounts when managing Departments. To have multiple
				departments linked to a single email address - you will need to create triggers. See [Multiple departments linked to a single email address]
			</dd>

			<dt>What is the difference between Chat Departments and Ticket Departments?</dt>
			<dd>
				Like the Ticket Department, Chat Departments are the key field for grouping Chats. The two types of departments
				are not linked together - you can have different Departments for tickets and chats.
			</dd>

			<dt>I only want Agents to set the Department for a Ticket - is this possible?</dt>
			<dd>sort of .....</dd>
		</dl>
	</article>
{% endblock %}