<div class="modal-dialog">
<div class="modal-content">
	<div class="modal-header">
		<button type="button" class="close" ng-click="dismiss()">&times;</button>
		<h4 class="modal-title">Delete Department</h4>
	</div>
	<div class="modal-body">
		<p>
			Deleting a department cannot be undone. Along with a department
		</p>
		<p>
			Any tickets that are currently in this department will be moved to:
		</p>
			<select
				ui-select2
				ng-model="selected.move_to_id"
				style="min-width: 240px"
			>
				<option value="{{ ng_var('dep.id') }}" ng-repeat="dep in move_deps_list">{{ ng_var('dep._full_title') }}</option>
			</select>
	</div>
	<div class="modal-footer">
		<button class="btn btn-primary" ng-click="confirm()">Delete Department</button>
		<button class="btn btn-primary" ng-click="dismiss()">Cancel</button>
	</div>
</div>
</div>