<header class="sn-header">
	<h3 ng-if="TicketDepsEdit.dep.id">Edit Department</h3>
	<h3 ng-if="!TicketDepsEdit.dep.id">New Department</h3>
</header>

<section class="pagebar" ng-if="TicketDepsEdit.dep.id">
	<a class="btn btn-danger pull-right" ng-click="TicketDepsEdit.startDelete()"><i class="icon-remove"></i> Delete</a>
	<div >

	</div>
	<br style="clear: right;"/>
</section>

<section class="grids-section">
	<div class="content-border">
		<header class="cb-header">
			<h3>Properties</h3>
		</header>
		<div class="form">
			<ul class="gs-list gs-list-bottom-border">
				<li>
					<div class="row">
						<div class="col-md-4">
							<label for="title">Title</label>
						</div>
						<div class="col-md-8">
							<input type="text" ng-model="TicketDepsEdit.dep.title">
						</div>
					</div>
				</li>
				<li>
					<div class="row">
						<div class="col-md-4">
							<label for="user_title">User Title</label>
						</div>
						<div class="col-md-8">
							<input type="text" ng-model="TicketDepsEdit.dep.user_title">
						</div>
					</div>
				</li>
				<li>
					<div class="row">
						<div class="col-md-4">
							<label for="title">Parent</label>
						</div>
						<div class="col-md-8">
							<select
								ui-select2
								ng-model="TicketDepsEdit.dep.parent_id"
								style="min-width: 240px"
							>
								<option value="{{ ng_var('dep.id') }}" ng-repeat="dep in TicketDepsEdit.dep_parent_list">{{ ng_var('dep.title') }}</option>
							</select>
						</div>
					</div>
				</li>
				<li>
					<div class="col-md-12 text-center">
						<button class="btn btn-primary" ng-click="TicketDepsEdit.saveProperties()">Save Properties</button>
					</div>
				</li>
			</ul>
		</div>
	</div>
</section>

<div ng-if="TicketDepsEdit.dep.id">
	<div class="content-border">
		<header class="cb-header">
			<h3>Agent Group Permissions</h3>
		</header>
		<table class="datagrid">
			<thead>
				<tr>
					<th>Agent Group</th>
					<th>Full Access</th>
					<th>Assignment</th>
				</tr>
			</thead>
			<tbody>
				<tr ng-repeat="usergroup in TicketDepsEdit.agentgroups">
					<td>{{ ng_var('usergroup.title') }}</td>
					<td>
						<button dp-toggle-switch ng-model="usergroup.full"></button>
					</td>
					<td>
						<button dp-toggle-switch ng-model="usergroup.assign"></button>
					</td>
				</tr>
			</tbody>
		</table>

		<div class="col-md-12 text-center">
			<button class="btn btn-primary" ng-click="TicketDepsEdit.savePermissions('agentgroups')">Save Agent Group Permissions</button>
		</div>
	</div>

	<div class="content-border">
		<header class="cb-header">
			<h3>Agent Permissions</h3>
		</header>
		<table class="datagrid">
			<thead>
				<tr>
					<th>Agent</th>
					<th>Full Access</th>
					<th>Assignment</th>
				</tr>
			</thead>
			<tbody>
				<tr ng-repeat="agent in TicketDepsEdit.agents">
					<td>{{ ng_var('agent.display_name') }}</td>
					<td>
						<button dp-toggle-switch ng-model="agent.full"></button>
					</td>
					<td>
						<button dp-toggle-switch ng-model="agent.assign"></button>
					</td>
				</tr>
			</tbody>
		</table>

		<div class="col-md-12 text-center">
			<button class="btn btn-primary" ng-click="TicketDepsEdit.savePermissions('agents')">Save Agent Permission</button>
		</div>
	</div>

	<div class="content-border">
		<header class="cb-header">
			<h3>User Group Permissions</h3>
		</header>
		<table class="datagrid">
			<thead>
				<tr>
					<th>Agent Group</th>
					<th>Access</th>
				</tr>
			</thead>
			<tbody>
				<tr ng-repeat="usergroup in TicketDepsEdit.usergroups">
					<td>{{ ng_var('usergroup.title') }}</td>
					<td>
						<button dp-toggle-switch ng-model="usergroup.use"></button>
					</td>
				</tr>
			</tbody>
		</table>

		<div class="col-md-12 text-center">
			<button class="btn btn-primary" ng-click="TicketDepsEdit.savePermissions('usergroups')">Save User Group Permission</button>
		</div>
	</div>

	<div class="content-border">
		<header class="cb-header">
			<h3>Layout Editor</h3>
		</header>
		<div style="height: 400px;"></div>
	</div>
</div>