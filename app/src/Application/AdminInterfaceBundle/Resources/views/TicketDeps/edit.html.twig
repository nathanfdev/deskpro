<div class="pane">
	<header class="pane-header">
		<h3 ng-if="TicketDepsEdit.dep.id">Tickets &rarr; Departments &rarr; Edit <em>{{ ng_var('TicketDepsEdit.dep.title') }}</em></h3>
		<h3 ng-if="!TicketDepsEdit.dep.id">New Department</h3>
	</header>
	<article class="pane-content no-pad">
		<nav class="dp-main-tabs">
			<ul>
				<li class="active" dp-tab-btn="main.props"><a href="#">Properties</a></li>
				<li dp-tab-btn="main.perms"><a href="#">Permissions</a></li>
				<li dp-tab-btn="main.layout"><a href="#">Layout</a></li>
				<li dp-tab-btn="main.website_embeds"><a href="#">Website Embed</a></li>
			</ul>
		</nav>

		<div dp-tab-body="main.props">
			<div class="panel panel-fill">
				<br/>
				<div class="panel-body">
					<form class="form-horizontal dp-form" role="form">
						<div class="form-group">
							<div class="col-lg-2">
								<h3>Title</h3>
							</div>
							<div class="col-lg-10">
								<div class="inner-group">
									<input type="text" class="form-control" ng-model="TicketDepsEdit.dep.title" style="width: 50%;">
									<span class="help-block">
										This is the title as it will appear throughout the agent and user interfaces.
									</span>
								</div>

								<div class="inner-group">
									<label>
										<input type="checkbox" ng-model="TicketDepsEdit.dep._enable_user_title" value="1" />
										<h4>Show a different title to end-users</h4>
									</label>
									<div ng-show="TicketDepsEdit.dep._enable_user_title">
										<input type="text" class="form-control" ng-model="TicketDepsEdit.dep.user_title" style="width: 50%;" />
									</div>
									<span class="help-block">
										Enter a custom title that will be displayed to your end-users using the portal. Agents will
										see the default title, but your users will see the custom title.
									</span>
								</div>
							</div>
						</div>
						<div class="form-group">
							<div class="col-lg-2">
								<h3>Parent</h3>
							</div>
							<div class="col-lg-10">
								<select
									ui-select2
									ng-model="TicketDepsEdit.dep.parent_id"
									style="min-width: 240px"
									class="no-search"
								>
									<option value="{{ ng_var('dep.id') }}" ng-repeat="dep in TicketDepsEdit.dep_parent_list">{{ ng_var('dep.title') }}</option>
								</select>
								<span class="help-block">
									By setting a parent department, this department becomes a child. This is just an organizational feature that helps
									you create department structures that are easier to use.
								</span>

								<div class="alert alert-info ng-hide" ng-show="show_parent_warning">
									<p>
										<strong><em>{{ ng_var('show_parent_warning.title') }}</em> is not currently a parent</strong>
									</p>
									<ul>
										<li>The parent department you have set is not yet a parent.</li>
										<li>DeskPRO will convert the new parent <em>{{ ng_var('show_parent_warning.title') }}</em> into a parent when you save this form.</li>
										<li>Any tickets that are currently in <em>{{ ng_var('show_parent_warning.title') }}</em> will be moved into <em>{{ ng_var('TicketDepsEdit.dep.title') }}</em>.</li>
									</ul>
								</div>
							</div>
						</div>
					</form>
				</div>
			</div>
			<div class="inner-footer text-center">
				<button class="btn btn-primary" ng-click="TicketDepsEdit.saveAll()">Save</button>
			</div>
		</div>

		<div dp-tab-body="main.perms">
			<div class="panel panel-innertable">
				<div class="panel-heading"><h3>Agent Permissions</h3></div>
				<table class="table table-hover">
					<thead>
						<tr>
							<th>&nbsp;</th>
							<th width="120" class="text-center">Full Access <span class="help-icon" tooltip-placement="left" tooltip="Full Access means the agent can view tickets in the department as well as create or move tickets into the department."></span></th>
							<th width="120" class="text-center">Assignment <span class="help-icon" tooltip-placement="left" tooltip="Assignment means that the agent cannot view tickets in the department, but they can create or move tickets into it."></span></th>
						</tr>
					</thead>
					<tbody>
						<tr ng-repeat="groupObj in TicketDepsEdit.agent_perms.groups">
							<td>{{ ng_var('groupObj.model.title') }}</td>
							<td class="text-center">
								<button locked-model="groupObj.perms.full.locked" dp-toggle-switch ng-model="groupObj.perms.full.state" ng-change="TicketDepsEdit.propogatePermission(groupObj, 'full')"></button>
							</td>
							<td class="text-center">
								<button locked-model="groupObj.perms.assign.locked" dp-toggle-switch ng-model="groupObj.perms.assign.state" ng-change="TicketDepsEdit.propogatePermission(groupObj, 'assign')"></button>
							</td>
						</tr>
						<tr ng-repeat="agentObj in TicketDepsEdit.agent_perms.agents" ng-class="{'first-of-type': $first}">
							<td>{{ ng_var('agentObj.model.display_name') }}</td>
							<td class="text-center">
								<button locked-model="agentObj.perms.full.locked" dp-toggle-switch ng-model="agentObj.perms.full.state" ng-change="TicketDepsEdit.propogatePermission(agentObj, 'full')"></button>
							</td>
							<td class="text-center">
								<button locked-model="agentObj.perms.assign.locked" dp-toggle-switch ng-model="agentObj.perms.assign.state" ng-change="TicketDepsEdit.propogatePermission(agentObj, 'assign')"></button>
							</td>
						</tr>
					</tbody>
				</table>
			</div>

			<div class="panel panel-innertable">
				<div class="panel-heading"><h3>User Group Permissions</h3></div>
				<table class="table table-hover">
					<thead>
						<tr>
							<th>&nbsp;</th>
							<th width="120" class="text-center">Use <span class="help-icon" tooltip-placement="left" tooltip="When enabled, users are able to select this department when submitting tickets or editing tickets. Note that agents can always assign a department the user would not normally have access to."></span></th>
						</tr>
					</thead>
					<tbody>
						<tr ng-repeat="usergroup in TicketDepsEdit.usergroups">
							<td>{{ ng_var('usergroup.title') }}</td>
							<td class="text-center">
								<button dp-toggle-switch ng-model="usergroup.use"></button>
							</td>
						</tr>
					</tbody>
				</table>
			</div>

			<div class="inner-footer text-center">
				<button class="btn btn-primary" ng-click="TicketDepsEdit.saveAll()">Save</button>
			</div>
		</div>

		<div dp-tab-body="main.layout">
			<div class="panel panel-fill">
				<div class="panel-body" style="height: 400px;">

				</div>
			</div>
			<div class="inner-footer text-center">
				<button class="btn btn-primary" ng-click="TicketDepsEdit.saveAll()">Save</button>
			</div>
		</div>

		<div dp-tab-body="main.website_embeds">
			<div class="panel panel-fill">
				<div class="panel-body">
					<p>
						Website Embeds are code snippets you can copy directly into your website to quickly add
						a DeskPRO contact form to any page.
					</p>
					<form role="form" ng-if="TicketDepsEdit.dep.id">
						<div class="form-group">
							<label for="title">Direct Link</label>
							<div class="row">
								<div class="col-lg-8">
									<input type="text" class="form-control" value="{{ ng_var("code_link") }}" />
								</div>
							</div>
						</div>

						<div class="form-group">
							<label for="title">Popup Window</label>
							<div class="row">
								<div class="col-lg-8">
									<textarea style="height:150px;" class="form-control">{{ ng_var("code_win") }}</textarea>
								</div>
							</div>
						</div>

						<div class="form-group">
							<label for="title">Embedded Form</label>
							<div class="row">
								<div class="col-lg-8">
									<textarea style="height:150px;" class="form-control">{{ ng_var("code_embed") }}</textarea>
								</div>
							</div>
						</div>
					</form>
					<div ng-if="!TicketDepsEdit.dep.id">
						<p>
							The Website Embeds code is not available yet because you have not saved this
							new department. Save the department first then come back to this tab.
						</p>
					</div>
				</div>
			</div>
		</div>
	</article>
</div>