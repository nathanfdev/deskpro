<div class="pane">
	<header class="pane-header">
		<h3 ng-if="TicketDepsEdit.dep.id">Edit Department</h3>
		<h3 ng-if="!TicketDepsEdit.dep.id">New Department</h3>
	</header>
	<header class="pane-controls">
		<div class="row">
			<div class="col-md-6">
				&nbsp;
			</div>
			<div class="col-md-6">
				<a class="btn btn-danger pull-right" ng-click="TicketDepsEdit.startDelete()"><i class="icon-remove"></i> Delete</a>
			</div>
		</div>
	</header>
	<article class="pane-content pad-top">

		<div class="panel panel-default">
			<div class="panel-heading">Properties</div>
			<div class="panel-body">
				<form class="form-horizontal" role="form">
					<div class="form-group">
						<div class="col-md-4">
							<label for="title">Title</label>
						</div>
						<div class="col-md-8">
							<input type="text" class="form-control" ng-model="TicketDepsEdit.dep.title">
						</div>
					</div>
					<div class="form-group">
						<div class="col-md-4">
							<label for="user_title">User Title</label>
						</div>
						<div class="col-md-8">
							<input type="text" class="form-control" ng-model="TicketDepsEdit.dep.user_title">
						</div>
					</div>
					<div class="form-group">
						<div class="col-md-4">
							<label for="title">Parent</label>
						</div>
						<div class="col-md-8">
							<select
								ui-select2
								ng-model="TicketDepsEdit.dep.parent_id"
								style="min-width: 240px"
							>
								<option value="{{ ng_var('dep.id') }}" ng-repeat="dep in TicketDepsEdit.dep_parent_list">{{ ng_var('dep.title') }}</option>
							</select>
						</div>
					</div>
				</form>
			</div>
			<div class="panel-footer text-center">
				<button class="btn btn-primary" ng-click="TicketDepsEdit.saveProperties()">Save Properties</button>
			</div>
		</div>

		<div ng-if="TicketDepsEdit.dep.id">
			<div class="panel panel-default">
				<div class="panel-heading">Agent Group Permissions</div>
				<table class="table table-hover">
					<thead>
						<tr>
							<th>Agent Group</th>
							<th>Full Access</th>
							<th>Assignment</th>
						</tr>
					</thead>
					<tbody>
						<tr ng-repeat="usergroup in TicketDepsEdit.agentgroups">
							<td>{{ ng_var('usergroup.title') }}</td>
							<td>
								<button dp-toggle-switch ng-model="usergroup.full"></button>
							</td>
							<td>
								<button dp-toggle-switch ng-model="usergroup.assign"></button>
							</td>
						</tr>
					</tbody>
				</table>
				<div class="panel-footer text-center">
					<button class="btn btn-primary" ng-click="TicketDepsEdit.savePermissions('agentgroups')">Save Agent Group Permission</button>
				</div>
			</div>

			<div class="panel panel-default">
				<div class="panel-heading">Agent Group Permissions</div>
				<table class="table table-hover">
					<thead>
						<tr>
							<th>Agent</th>
							<th>Full Access</th>
							<th>Assignment</th>
						</tr>
					</thead>
					<tbody>
						<tr ng-repeat="agent in TicketDepsEdit.agents">
							<td>{{ ng_var('agent.display_name') }}</td>
							<td>
								<button dp-toggle-switch ng-model="agent.full"></button>
							</td>
							<td>
								<button dp-toggle-switch ng-model="agent.assign"></button>
							</td>
						</tr>
					</tbody>
				</table>
				<div class="panel-footer text-center">
					<button class="btn btn-primary" ng-click="TicketDepsEdit.savePermissions('agents')">Save Agent Permission</button>
				</div>
			</div>

			<div class="panel panel-default">
				<div class="panel-heading">User Group Permissions</div>
				<table class="table table-hover">
					<thead>
						<tr>
							<th>Agent Group</th>
							<th>Access</th>
						</tr>
					</thead>
					<tbody>
						<tr ng-repeat="usergroup in TicketDepsEdit.usergroups">
							<td>{{ ng_var('usergroup.title') }}</td>
							<td>
								<button dp-toggle-switch ng-model="usergroup.use"></button>
							</td>
						</tr>
					</tbody>
				</table>
				<div class="panel-footer text-center">
					<button class="btn btn-primary" ng-click="TicketDepsEdit.savePermissions('usergroups')">Save User Group Permission</button>
				</div>
			</div>

			<div class="panel panel-default">
				<div class="panel-heading">Layout Editor</div>
				<div class="panel-body" style="height: 400px;">

				</div>
			</div>
		</div>
	</article>
</div>