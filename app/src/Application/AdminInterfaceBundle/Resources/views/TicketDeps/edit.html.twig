<div class="pane">
	<header class="pane-header">
		<h3 ng-if="TicketDepsEdit.dep.id">{{ phrase('adm.general.apps_tickets') }} &rarr; {{ phrase('agent.general.departments') }} &rarr; {{ phrase('agent.general.edit') }} <em>{{ ng_var('TicketDepsEdit.dep.title') }}</em></h3>
		<h3 ng-if="!TicketDepsEdit.dep.id">{{ phrase('adm.departments.new_department') }}</h3>
	</header>
	<article class="pane-content">
		<div class="pane-content-header" style="display: none">
			<h3>Edit Department: {{ ng_var('TicketDepsEdit.dep.title') }}</h3>
		</div>
		<form class="form-horizontal dp-form" role="form" name="form_props" ng-submit="TicketDepsEdit.saveAll()">
			<nav class="dp-main-tabs">
				<ul>
					<li class="active" dp-tab-btn="main.props"><a href="#"><i class="fa fa-pencil"></i> {{ phrase('agent.general.properties') }}</a></li>
					<li dp-tab-btn="main.perms"><a href="#"><i class="fa fa-users"></i> {{ phrase('agent.general.permissions') }}</a></li>
					<li dp-tab-btn="main.layout"><a href="#"><i class="fa fa-columns"></i> {{ phrase('adm.general.layout') }}</a></li>
					<li dp-tab-btn="main.website_embeds"><a href="#"><i class="fa fa-code"></i> {{ phrase('adm.general.website_embed') }}</a></li>
				</ul>
			</nav>

			<div dp-tab-body="main.props">
				{% include 'AdminInterfaceBundle:TicketDeps:edit-props.html.twig' %}
			</div>

			<div dp-tab-body="main.perms">
				{% include 'AdminInterfaceBundle:TicketDeps:edit-perms.html.twig' %}
			</div>

			<div dp-tab-body="main.layout">
				{% include 'AdminInterfaceBundle:TicketDeps:edit-layout.html.twig' %}
			</div>

			<div dp-tab-body="main.website_embeds">
				{% include 'AdminInterfaceBundle:TicketDeps:edit-website_embeds.html.twig' %}
			</div>

			<section class="footer">
				<div class="text-danger ng-hide" ng-show="form_props.$attempted && form_props.$invalid">
					<p><strong>{{ phrase('adm.general.please_correct_errors') }}</strong></p>
					<ul>
						<li ng-show="form_props.title.$error.required">{{ phrase('adm.departments.title_error') }}</li>
						<li ng-show="form_props.email_gateway_id.$error">{{ phrase('adm.departments.email_account_required') }}</li>
					</ul>
				</div>

				<div class="btn-controls" ng-hide="form_props.$attempted && form_props.$invalid">
					<div dp-hide-spinning="saving_dep">
						<div class="delete-btn-wrap">
							<button class="btn btn-danger" ng-if="TicketDepsEdit.dep.id">Delete</button>
						</div>
						<button class="btn btn-primary" dp-submit-form>{{ phrase('agent.general.save') }}</button>
						<button class="btn btn-default" ng-click="TicketDepsEdit.resetForm()">{{ phrase('agent.general.reset') }}</button>
					</div>
					<div dp-show-spinning="saving_dep">
						<i class="spinner-flat"></i>
					</div>
				</div>
			</section>
		</form>
	</article>
</div>

<div dp-register-message="saved_dep">{{ phrase('adm.departments.saved_dep_x_success', {title: 'ng_var(TicketDepsEdit.dep.title)'}) }}</div>