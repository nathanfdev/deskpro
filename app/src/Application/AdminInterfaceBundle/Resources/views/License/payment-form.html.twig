<div dp-payment-form-directive ng-model="paymentForm">
	<div>
		<label>
			<input type="radio" ng-model="card_type" value="existing" /> Use your existing credit-card
		</label>
		<div ng-show="mode == 'existing'">
			{{ ng_var('exist_card.type') }}
			{{ ng_var('exist_card.number') }}
			Expires: {{ ng_var('exist_card.expires | amDateFormat:"MMM YYYY"') }}
		</div>
	</div>
	<div>
		<label>
			<input type="radio" ng-model="card_type" value="new" /> Use your existing credit-card
		</label>
		<div ng-show="mode == 'new'">
			Card number: <input type="text" ng-model="new_card.number"/>
			Verification code: <input type="text" ng-model="new_card.cvv"/>
			Expiry Date (YYMM): <input type="text" ng-model="new_card.expiry"/>
		</div>
	</div>
</div>