{% extends 'AdminInterfaceBundle:Layout:list.html.twig' %}
{% block listpane_content %}
	<section class="dp-paneblock dp-listpane">
		<header>
			<nav>
				<span class="status-pinger saved-ping" dp-ping-flash="display_orders">
					<i class="fa fa-check-square-o-square"></i> {{ phrase('agent.general.saved') }}
				</span>
			</nav>
			<h3 ng-pluralize count="ListCtrl.list.length || 0" when="{{ ng_plural_phrase('adm.general.x_api_keys') }}">

			</h3>
		</header>
		<article>
			<ul class="dp-item-list" ui-sortable="ListCtrl.sortedListOptions" dp-list-autoload>
				<li class="with-drag-handle" ng-repeat="api_key in ListCtrl.list"
					dp-state-mark="apps.api_keys.edit.{{ ng_var('api_key.id') }}" data-id="{{ ng_var('api_key.id') }}">
					<a href="{{ ng_href('apps.api_keys.edit', '{id: api_key.id}') }}">
						<h4>
							<img ng-src="{{ ng_var('api_key.user.picture_url') }}" width="33" height="33" border="0"
								 ng-if="api_key.user">
							<i class="fa fa-user" ng-if="!api_key.user"></i>
							<span class="title-text">{{ ng_var('api_key.note') }}</span>
						</h4>
					</a>
				</li>
			</ul>
			<div class="dp-add-control">
				<a class="btn btn-default" ng-class="{'active': isStateActive('.create') }"
				   href="{{ ng_href('apps.api_keys.gocreate') }}" dp-list-autoload autoload-priority="2">
					<i class="fa fa-plus"></i> New Api Key
				</a>
			</div>
		</article>
	</section>
{% endblock %}

{% block listpane_help %}
	{% include 'AdminInterfaceBundle:ApiKeys:help-page.html.twig' %}
{% endblock %}