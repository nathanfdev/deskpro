{% extends 'AdminInterfaceBundle:Layout:list-editpane.html.twig' %}

{% block editpane_content %}

	<form role="form" name="form_props" ng-submit="form_props.$valid && EditCtrl.saveForm()">
		<section class="dp-paneblock dp-editpane">

            <nav class="dp-blocktabs responsive">
                <ul>
                    <li class="active" dp-tab-btn="api.keys"><a href="#"><i class="fa fa-pencil"></i> {{ phrase('adm.api_keys.keys_title') }}</a></li>
                    <li class="pipe" ng-if="EditCtrl.api_key.logs && EditCtrl.api_key.logs.length">|</li>
                    <li dp-tab-btn="api.logs" ng-if="EditCtrl.api_key.logs && EditCtrl.api_key.logs.length">
	                    <a href="#"><i class="fa fa-key"></i> {{ phrase('adm.api_keys.logs_title') }}</a>
                    </li>
                </ul>
            </nav>

			<article class="form-horizontal dp-form">

                <div dp-tab-body="api.keys">
				    <div class="panel panel-fill indent">
					    <div class="panel-body">
							<div class="form-group">
								<div class="col-lg-2">
									<h3>Description</h3>
								</div>
								<div class="col-lg-10">
									<div class="inner-group" dp-error-class="form_props.note">
										<input type="text" class="form-control" name="note" ng-model="EditCtrl.form.note"
											   style="width: 50%;" required autofocus/>
										<span class="help-block">
											Used as note for this API key.
											You could use this field as a reminder of what this API key will be used for.
										</span>
									</div>
								</div>
							</div>
							<div class="form-group" ng-if="EditCtrl.form.id">
								<div class="col-lg-2">
									<h3>API Key Code</h3>
								</div>
								<div class="col-lg-10">
									<div class="pull-right">
										<span class="btn btn-success" ng-click="EditCtrl.regenerateApiKey()">
											Regenerate API Key
										</span>
									</div>
									<div class="inner-group">
										{{ ng_var('EditCtrl.form.keyString') }}
									</div>
								</div>
							</div>
							<div class="form-group">
								<div class="col-lg-2">
									<h3>
										API Key Type
										<button dp-inhelp-btn="admin.api_keys.edit.key_type"></button>
									</h3>
								</div>
								<div class="col-lg-10">
									<div class="inner-group">
										<div class="panel-help" dp-inhelp-body="admin.api_keys.edit.key_type" style="margin-top: 0;">
											<p>
												All API requests are executed in the context of a particular agent. The agent account used
												defines what can be performed using the API. For example, if an agent does not have permission
												to edit tickets then an API key for that agent won't be able to edit tickets using API requests either.
											</p>
											<p>
												<strong>Superuser keys</strong> are special API keys that allow you specify the agent context
												whenever you make an API request rather than pre-defining it here. These are very powerful because
												it means, for example, you could easily perform actions as an admin user with full permissions.
											</p>
										</div>

										<div style="padding-top: 6px;">
											<label style="font-weight: normal; display: block;">
												<input type="radio" ng-model="EditCtrl.form.isSuperUser" ng-value="false">
												Normal API Key
											</label>
											<label style="font-weight: normal; display: block;">
												<input type="radio" ng-model="EditCtrl.form.isSuperUser" ng-value="true">
												Superuser API Key
											</label>
										</div>
									</div>
									<div class="inner-group" dp-error-class="form_props.person">
										<div ng-if="EditCtrl.form.isSuperUser">
											<label>Default Agent:</label>
											<select
												name="person"
												ui-select2
												ng-model="EditCtrl.form.person"
												style="min-width: 240px"
												class="no-search"
												>
												<option value="">No default agent</option>
												<option value="{{ ng_var('agent.id') }}" ng-repeat="agent in EditCtrl.agents">
													{{ ng_var('agent.display_name') }}
												</option>
											</select>
											<span class="help-block">
												The <strong>default agent</strong> to use if no agent is specified with an API request.
												If no default agent is selected here and no agent is specified with an API request, then the request will fail.
											</span>
										</div>

										<div ng-if="!EditCtrl.form.isSuperUser">
											<label>Agent:</label>
											<select
												name="person"
												ui-select2
												ng-model="EditCtrl.form.person"
												style="min-width: 240px"
												class="no-search"
											    required
												>
												<option value="{{ ng_var('agent.id') }}" ng-repeat="agent in EditCtrl.agents">
													{{ ng_var('agent.display_name') }}
												</option>
											</select>
											<span class="help-block">
												<strong>Required.</strong>
												Select the agent that this API key will be bound to. All API requests will be executed
												in the context of this agent.
											</span>
										</div>
									</div>
								</div>
							</div>

							<div class="form-group" ng-if="EditCtrl.form.isSuperUser">
								<div class="col-lg-2">
									<h3>Options</h3>
								</div>
								<div class="col-lg-10">
									<div class="inner-group">
										<label>
											<input type="checkbox" ng-model="EditCtrl.form.isAdminManage" />
											<h4>Enable administration API endpoints</h4>
										</label>
										<span class="help-block">
											When admin API endpoints are enabled, the API can be used to make administrative changes to the helpdesk
											such as changing permissions, editing or deleting agents, setting system settings, editing or deleting email accounts,
											etc.
										</span>
										<div class="alert alert-danger" ng-show="EditCtrl.form.isAdminManage">
											Be very careful with API keys with this option enabled! Anyone with this API key essentially has complete
											admin access to the helpdesk.
										</div>
									</div>
								</div>
							</div>
						</div>
				    </div>
                </div>
                <div dp-tab-body="api.logs">
                    <ul class="dp-item-list">
                        <li dp-li-group-section ng-repeat="item in EditCtrl.api_key.logs">
                            <a href="#" class="toggle" ng-click="$event.preventDefault();">
                                <div class="row" ng-class="!item.response.status && 'text-danger'">
                                    <div class="col-lg-4">{{ ng_var('item.request.method') }}</div>
                                    <div class="col-lg-4">{{ ng_var('item.request.path') }}</div>
                                    <div class="col-lg-4">{{ ng_var('item.time') }}</div>
                                </div>
                            </a>
                            <div class="group-section-wrapper">
                                <div class="col-lg-12">
                                    <h4>{{ phrase('adm.api_keys.request') }}</h4>

                                    <dl class="dl-horizontal">
                                        <dt>{{ phrase('adm.api_keys.path') }}</dt>
                                        <dd>{{ ng_var('item.request.path') }}</dd>
                                        <dt>{{ phrase('adm.api_keys.method') }}</dt>
                                        <dd>{{ ng_var('item.request.method') }}</dd>
                                        <div ng-repeat="(key,val) in item.request.payload">
                                            <dt>{{ ng_var('key') }}</dt>
                                            <dd>{{ ng_var('val') }}</dd>
                                        </div>
                                    </dl>
                                    <h4>{{ phrase('adm.api_keys.response') }}</h4>
                                    <dl class="dl-horizontal">
                                        <dt>{{ phrase('adm.api_keys.status') }}</dt>
                                        <dd>{{ ng_var('item.response.status') }}</dd>
                                        <dt>{{ phrase('adm.api_keys.content') }}</dt>
                                        <dd>{{ ng_var('item.response.content') }}</dd>
                                    </dl>
                                    <br />

                                    <button class="btn btn-default" type="button" ng-click="replayLogEntry(item)">
                                        <i class="fa fa-refresh" ng-class="!item.response && 'fa-spin'"></i> Replay
                                    </button>
                                    <br /><br />
                                </div>
                            </div>
                        </li>
                    </ul>
                </div>
			</article>

			<footer>
				<div class="dp-content">
					<div class="text-danger ng-hide" ng-show="form_props.$attempted && form_props.$invalid">
						<p><strong>{{ phrase('adm.general.please_correct_errors') }}</strong></p>
						<ul>
							<li ng-show="form_props.note.$error.required">Please set title for this API Key</li>
						</ul>
					</div>

					<div class="dp-delete-control" ng-if="EditCtrl.form.id">
						<button class="btn btn-danger"
								ng-click="$event.preventDefault(); EditCtrl.startDelete(EditCtrl.form.id);">
							Delete
						</button>
					</div>

					<div class="dp-btn-controls" ng-hide="form_props.$attempted && form_props.$invalid">
						<div dp-hide-spinning="saving">
							<button class="btn btn-primary" dp-submit-form>{{ phrase('agent.general.save') }}</button>
						</div>
						<div dp-show-spinning="saving">
							<i class="spinner-flat"></i>
						</div>
					</div>
				</div>
			</footer>

		</section>
	</form>

{% endblock %}