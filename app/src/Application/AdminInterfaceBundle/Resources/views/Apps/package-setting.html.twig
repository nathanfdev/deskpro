<div class="col-lg-4">
	<h3>{{ ng_var('setting.label') }}</h3>
</div>
<div class="col-lg-8">
	<div ng-switch-when="text">
		<input type="text" class="form-control" ng-model="setting_values[setting.name]"
			placeholder="{{ ng_var('setting.placeholder') }}" />
	</div>
	<div ng-switch-when="textarea">
		<textarea class="form-control" ng-model="setting_values[setting.name]"
			placeholder="{{ ng_var('setting.placeholder') }}"></textarea>
	</div>
	<div ng-switch-when="password">
		<input type="password" class="form-control" ng-model="setting_values[setting.name]"
			placeholder="{{ ng_var('setting.placeholder') }}" />
	</div>
	<div ng-switch-when="phone_number">
		<input type="tel"
			dp-phone-number
			style="min-width:250px;"
			class="form-control"
			ng-model="setting_values[setting.name]"
			placeholder="{{ ng_var('setting.placeholder') }}" />
	</div>
	<div ng-switch-when="checkbox">
		<label>
			<input type="checkbox" ng-model="setting_values[setting.name]" />
			{{ ng_var('setting.checkbox_label') }}
		</label>
	</div>
	<div ng-switch-when="choice">
		<select
			ng-model="setting_values[setting.name]"
			ui-select2="{dropdownAutoWidth: true}"
			>
			<option ng-repeat="opt in setting.options"
				value="{{ ng_var('opt.value') }}">{{ ng_var('opt.label') }}</option>
		</select>
	</div>
	<span class="help-block" ng-show="setting.description" ng-bind-html="setting.description"></span>
</div>