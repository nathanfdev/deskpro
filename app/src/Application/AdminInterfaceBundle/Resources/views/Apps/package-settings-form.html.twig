<div class="form-group">
	<div class="col-lg-4">
		<h3>Title</h3>
	</div>
	<div class="col-lg-8">
		<input type="text" class="form-control" ng-model="setting_values.dp_app.title" />
		<span class="help-block">
			This title is displayed in the "Installed Apps" and is mainly
			for your own records.
		</span>
	</div>
</div>
<div class="form-group" ng-repeat="setting in pack.settings_def" ng-switch="setting.type" ng-if="setting.type != 'hidden'">
	{% include 'AdminInterfaceBundle:Apps:package-setting.html.twig' %}
</div>
