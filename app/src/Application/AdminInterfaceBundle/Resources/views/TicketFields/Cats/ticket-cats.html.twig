<div class="pane">
	<header class="pane-header">
		<h3>{{ phrase('adm.general.apps_tickets') }} &rarr; Categories</h3>
	</header>
	<article class="pane-content no-pad">
		<form class="form-horizontal dp-form" role="form" name="form_props" ng-submit="TicketCats.save()">
			<div class="panel panel-fill indent">
				<div class="panel-body">
					<div class="form-group">
						<dp-category-builder max-depth="2" ng-model="TicketCats.cats"></dp-category-builder>
					</div>

					<div class="form-group">
						<div class="col-lg-2">
							<h3>Default</h3>
						</div>
						<div class="col-lg-10">
							<select
								ui-select2
								ng-model="TicketCats.default_id"
								style="min-width: 240px"
								class="no-search"
							>
								<option value="{{ ng_var('cat.id') }}" ng-repeat="cat in TicketCats.cat_parent_list">{{ ng_var('cat.title') }}</option>
							</select>
							<span class="help-block">
								Choose the category selected by default on the new ticket form (for both agents and users). This default will
								also be used in the email gateway.
							</span>
						</div>
					</div>

					<div class="form-group">
						<div class="col-lg-2">
							<h3>Validation</h3>
						</div>
						<div class="col-lg-10">
							<div style="padding-top:6px;">
								<label style="font-weight: normal; display: block;">
									<input type="checkbox" ng-model="TicketCats.user_required" /> Require <strong>users</strong> to select a value for this field
								</label>
								<label style="font-weight: normal; display: block;">
									<input type="checkbox" ng-model="TicketCats.agent_required" /> Require <strong>agents</strong> to select a value for this field
								</label>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="inner-footer">
				<div class="text-danger ng-hide" ng-show="form_props.$attempted && form_props.$invalid">
					<p><strong>{{ phrase('adm.general.please_correct_errors') }}</strong></p>
					<ul>
					</ul>
				</div>

				<div class="text-center" ng-hide="form_props.$attempted && form_props.$invalid">
					<div dp-hide-spinning="saving">
						<button class="btn btn-primary" dp-submit-form>{{ phrase('agent.general.save') }}</button>
					</div>
					<div dp-show-spinning="saving">
						<i class="spinner-flat"></i>
					</div>
				</div>
			</div>
		</form>
	</article>
</div>
<div dp-register-message="saved_settings">Categories saved successfully.</div>