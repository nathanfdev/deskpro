{% extends 'AdminInterfaceBundle:Layout:list.html.twig' %}
{% block listpane_content %}
	<section class="dp-paneblock dp-listpane">
		<header>
			<h3>{{ phrase('adm.general.builtin_fields') }}</h3>
		</header>
		<article>
			<ul class="dp-item-list">
				<li dp-state-mark="tickets.fields.categories">
					<a href="{{ ng_href('tickets.fields.categories') }}">
						<div class="pull-right">
							<em class="tag tag-warn" ng-show="!TicketFieldsList.field_enabled.category">Disabled</em>
						</div>
						<h4><span class="title-text">{{ phrase('agent.general.categories') }}</span></h4>
					</a>
				</li>
				<li dp-state-mark="tickets.fields.priorities">
					<a href="{{ ng_href('tickets.fields.priorities') }}">
						<div class="pull-right">
							<em class="tag tag-warn" ng-show="!TicketFieldsList.field_enabled.priority">Disabled</em>
						</div>
						<h4><span class="title-text">{{ phrase('agent.general.priorities') }}</span></h4>
					</a>
				</li>
				<li dp-state-mark="tickets.fields.workflows">
					<a href="{{ ng_href('tickets.fields.workflows') }}">
						<div class="pull-right">
							<em class="tag tag-warn" ng-show="!TicketFieldsList.field_enabled.workflow">Disabled</em>
						</div>
						<h4><span class="title-text">{{ phrase('agent.general.workflows') }}</span></h4>
					</a>
				</li>
				<li dp-state-mark="tickets.fields.products">
					<a href="{{ ng_href('tickets.fields.products') }}">
						<div class="pull-right">
							<em class="tag tag-warn" ng-show="!TicketFieldsList.field_enabled.product">Disabled</em>
						</div>
						<h4><span class="title-text">{{ phrase('agent.general.products') }}</span></h4>
					</a>
				</li>
			</ul>
		</article>
	</section>

	<section class="dp-paneblock dp-listpane">
		<header>
			<nav class="dp-controls">
				<span dp-ping-flash="fields_enabled" class="saved-ping"><i class="fa fa-check-square-o-square"></i> {{ phrase('agent.general.saved') }}</span>
			</nav>

			<h3 ng-pluralize count="TicketFieldsList.custom_fields.length || 0" when="{{ ng_plural_phrase('adm.general.count_custom_fields') }}"></h3>
		</header>
		<article>
			<ul class="dp-item-list">
				<li ng-repeat="field in TicketFieldsList.custom_fields" dp-state-mark="tickets.fields.edit.{{ ng_var('field.id') }}" data-id="{{ ng_var('field.id') }}">
					<a href="{{ ng_href('tickets.fields.edit', '{id: field.id}') }}">
						<div class="pull-right">
							<em class="tag tag-warn" ng-show="!field.is_enabled">Disabled</em>
						</div>
						<h4><span class="title-id" title="ID">#{{ ng_var('field.id') }}</span> <span class="title-text">{{ ng_var('field.title') }}</span></h4>
					</a>
				</li>
			</ul>
			<div class="dp-add-control">
				<a class="btn btn-default" href="{{ ng_href('tickets.fields.gocreate') }}" ng-class="{'active': isStateActive('.create') }"><i class="fa fa-plus"></i> {{ phrase('agent.general.add') }}</a>
			</div>
		</article>
	</section>
{% endblock %}
{% block listpane_help %}
	<header>
		<h1>You can customize the information stored for a ticket with optional built-in fields and custom fields.</h1>
		<p>Use categories, priorities, workflows and products to help organize your helpdesk; you set the values agents/users can choose from. You can also define completely custom fields where you choose the field name and the type of values allowed.</p>
	</header>
	<article>
		<section>
			<p>
				<ul>
					<li><strong>Categories</strong> are a general field, usually used to handle grouping tickets within a department.</li>
					<li><strong>Priorities</strong> describe how important a ticket is. The different priority values you set have an order, from most to least important.</li>
					<li><strong>Workflows</strong> are used to record the ticket's stage in your support process - for example "Triage", "Troubleshooting", "Follow-Up".</li>
					<li><strong>Products</strong> usually denote a real product or service that your enterprise offers and your helpdesk supports. If enabled, products can apply to items other than tickets, such as feedback and articles.</li>
					<li><strong>Custom fields</strong> are the most flexible way to store extra information. You can choose the name of the field and specify how agents and users select values (e.g. text entry, radio buttons etc.) when creating or editing a ticket.</li>
				</ul>
			</p>
			<p>You can specify a default value for all these fields, and set validation options that control what users/agents are allowed or required to enter.</p>
			<p>You control which fields are displayed in the user and agent ticket creation forms by using the <strong>Layout</strong> tab in the Departments section. The forms for different departments can include different fields.</p>
		</section>
		
		<section>
		<h2><span>FAQ</span></h2>
		<dl>
			<dt><em>Q:</em>I set up a field but it is not showing up on the ticket creation forms.</dt>
			<dd><em>A:</em>
				Make sure you have added the field in the Departments section Layout Editor. If users can't see the field, check that the <strong>Agent Only Field</strong> setting is not enabled.
			</dd>
			<dt><em>Q:</em>My helpdesk uses multiple languages and some of these fields are not being translated; how do I fix this?</dt>
			<dd><em>A:</em>
				You need to enter a translated version of any field values/names you have defined. Go to <strong>Setup > Languages</strong>; click on each language you have installed beyond the default, click <strong>Edit Phrases</strong>, and enter a custom translation.
			</dd>
		<dt><em>Q:</em>What does the <strong>Match regular expression</strong> setting on custom text fields do?</dt>
		<dd><em>A:</em>
			A regular expression lets you define a pattern that user/agent input must match. For example, if you expect an 8-digit account number starting with 9, you can use a regular expression to make sure input matches that format. See the manual section on <a href="https://www.deskpro.com/manuals/admin-manual/admin-manual.html#field-data-validation" target="_blank">validating data in fields</a> for more details.
		</dd>
		<dt><em>Q:</em>What's the difference between urgency and priority?</dt>
			<dd><em>A:</em>
				Urgency is a number from 1 to 10. Priorities are an ordered set of named priority levels such as "Routine", "Urgent", "Critical". Priorities can be set by users from the web interface, whereas urgency is for agent reference only. Trigger actions can be used to increase or decrease urgency by a relative amount (e.g. increase urgency by 5, reduce urgency by 2), whereas trigger actions can only set a particular priority.
			</dd>
		</dl>
</section>
		<section class="related-content">
			<h2><span>Related Content</span></h2>
			<ul>
				<li><i class="fa fa-book"></i> <a href="https://www.deskpro.com/manuals/admin-manual/admin-manual.html#categories" target="_blank">Categories</a></li>
				<li><i class="fa fa-book"></i> <a href="https://www.deskpro.com/manuals/admin-manual/admin-manual.html#priorities" target="_blank">Priorities</a></li>
				<li><i class="fa fa-book"></i> <a href="https://www.deskpro.com/manuals/admin-manual/admin-manual.html#workflows" target="_blank">Workflows</a></li>
				<li><i class="fa fa-book"></i> <a href="https://www.deskpro.com/manuals/admin-manual/admin-manual.html#products" target="_blank">Products</a></li>
				<li><i class="fa fa-book"></i> <a href="https://www.deskpro.com/manuals/admin-manual/admin-manual.html#custom-fields" target="_blank">Custom fields</a></li>
				<li><i class="fa fa-book"></i> <a href="https://www.deskpro.com/manuals/admin-manual/admin-manual.html#field-data-validation" target="_blank">Field data validation</a>
				<li><i class="fa fa-book"></i> <a href="https://www.deskpro.com/manuals/admin-manual/admin-manual.html#ticket-form-layouts" target="_blank">Ticket form layouts</a></li>
				<li><i class="fa fa-file-text"></i> <a href="https://support.deskpro.com/kb/articles/181" target="_blank">Ticket assignment workflows in DeskPRO</a></li>
			</ul>
	</section>
	</article>
{% endblock %}