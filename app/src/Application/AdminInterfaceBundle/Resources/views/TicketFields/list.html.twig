{% extends 'AdminInterfaceBundle:Layout:list.html.twig' %}
{% block listpane_content %}
	<section class="dp-paneblock dp-listpane">
		<header>
			<h3>{{ phrase('adm.general.builtin_fields') }}</h3>
		</header>
		<article>
			<ul class="dp-item-list">
				<li dp-state-mark="tickets.fields.categories">
					<a href="{{ ng_href('tickets.fields.categories') }}">
						<div class="pull-right">
							<em class="tag tag-warn" ng-show="!TicketFieldsList.field_enabled.category">Disabled</em>
						</div>
						<h4><span class="title-text">{{ phrase('agent.general.categories') }}</span></h4>
					</a>
				</li>
				<li dp-state-mark="tickets.fields.priorities">
					<a href="{{ ng_href('tickets.fields.priorities') }}">
						<div class="pull-right">
							<em class="tag tag-warn" ng-show="!TicketFieldsList.field_enabled.priority">Disabled</em>
						</div>
						<h4><span class="title-text">{{ phrase('agent.general.priorities') }}</span></h4>
					</a>
				</li>
				<li dp-state-mark="tickets.fields.workflows">
					<a href="{{ ng_href('tickets.fields.workflows') }}">
						<div class="pull-right">
							<em class="tag tag-warn" ng-show="!TicketFieldsList.field_enabled.workflow">Disabled</em>
						</div>
						<h4><span class="title-text">{{ phrase('agent.general.workflows') }}</span></h4>
					</a>
				</li>
				<li dp-state-mark="tickets.fields.products">
					<a href="{{ ng_href('tickets.fields.products') }}">
						<div class="pull-right">
							<em class="tag tag-warn" ng-show="!TicketFieldsList.field_enabled.product">Disabled</em>
						</div>
						<h4><span class="title-text">{{ phrase('agent.general.products') }}</span></h4>
					</a>
				</li>
			</ul>
		</article>
	</section>

	<section class="dp-paneblock dp-listpane">
		<header>
			<nav class="dp-controls">
				<span dp-ping-flash="fields_enabled" class="saved-ping"><i class="fa fa-check-square-o-square"></i> {{ phrase('agent.general.saved') }}</span>
			</nav>

			<h3 ng-pluralize count="TicketFieldsList.custom_fields.length || 0" when="{{ ng_plural_phrase('adm.general.count_custom_fields') }}"></h3>
		</header>
		<article>
			<ul class="dp-item-list">
				<li ng-repeat="field in TicketFieldsList.custom_fields" dp-state-mark="tickets.fields.edit.{{ ng_var('field.id') }}" data-id="{{ ng_var('field.id') }}">
					<a href="{{ ng_href('tickets.fields.edit', '{id: field.id}') }}">
						<div class="pull-right">
							<em class="tag tag-warn" ng-show="!field.is_enabled">Disabled</em>
						</div>
						<h4><span class="title-text">{{ ng_var('field.title') }}</span></h4>
					</a>
				</li>
			</ul>
			<div class="dp-add-control">
				<a class="btn btn-default" href="{{ ng_href('tickets.fields.gocreate') }}" ng-class="{'active': isStateActive('.create') }"><i class="fa fa-plus"></i> {{ phrase('agent.general.add') }}</a>
			</div>
		</article>
	</section>
{% endblock %}
{% block listpane_help %}
	<header>
		<h1>You can customize the information stored for a ticket with optional built-in fields and custom fields.</h1>
		<p>You can use optional categories, priorities, workflows and products to help organize your helpdesk; you set the values agents/users can choose from. You can also define completely custom fields where you choose the field name and the type of values allowed.</p>
	</header>
	<article>
		<section>
			
			<ul>
				<li><strong>Categories</strong> are a general field, usually used to handle grouping tickets within a department.</li>
				<li><strong>Priorities</strong> describe how important a ticket is. The different priority values you set have an order, from most to least important.</li>
				<li><strong>Workflows</strong> are used to record the ticket&#39;s stage in your support process - for example "Triage", "Troubleshooting", "Follow-Up".</li>
				<li><strong>Products</strong> usually denote a real product or service that your enterprise offers and your helpdesk supports. If enabled, products can apply to items other than tickets, such as feedback and articles.</li>
			</ul>
			<p>When you define a <strong>custom field</strong>, you can choose how agents and users select values (e.g. text entry, radio buttons etc.) when creating or editing a ticket.</p>
			<p>You can specify a default value for all these fields, and set validation options that control what users/agents are allowed or required to enter.</p>
			<p>You can control which fields are displayed in the user and agent ticket creation forms by using the <strong>Layout</strong> tab in the Departments section. The forms for different departments can include different fields.</p>
		</section>
		
		<section>
		<h2><span>FAQ</span></h2>
		<dl>
			<dt><em>Q:</em>I set up a field but it is not showing up on the ticket creation forms.</dt>
			<dd><em>A:</em>
				Make sure you have added the field in the Departments section Layout Editor.
			</dd>
			<dt><em>Q:</em>My helpdesk uses multiple languages and some of these fields are not being translated; how do I fix this?</dt>
			<dd><em>A:</em>
				You need to enter a translation for the field names. Go to <strong>Setup > Languages</strong>; click on each language you have installed beyond the default, click <strong>Edit Phrases</strong>, and enter a custom translation.
			</dd>
		<dt><em>Q:</em>What does the <strong>Match regular expression</strong> setting on custom text fields do?</dt>
		<dd><em>A:</em>
			A regular expression lets you define a pattern that user/agent input must match. For example, if you expect an 8-digit account number starting with 9, you can use a regular expression to make sure input matches that format. See the manual section on <a href="#Custom field validation" target="_blank">Custom field validation</a> for more details.
		</dd>
		</dl>
</section>
	<section>
			<h2><span>Related Content</span></h2>
			<ul>
				<li>[MANUAL]<a href="#ticket-customization" target="_blank">Ticket customization</a></li>
				<li>[MANUAL]<a href="#custom-field-validation" target="_blank">Custom field validation</a>
				<li>[MANUAL]<a href="#ticket-form-layouts" target="_blank">Ticket form layouts</a></li>
				<li>[ARTICLE]<a href="https://support.deskpro.com/kb/articles/181" target="_blank">Ticket assignment workflows in DeskPRO</a></li>
			</ul>
	</section>
	</article>
{% endblock %}