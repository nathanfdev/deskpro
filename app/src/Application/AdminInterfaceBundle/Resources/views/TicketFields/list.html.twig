<div class="pane">
	<header class="pane-header">
		<h3><i class="icon-terminal"></i> {{ phrase('adm.general.apps_tickets') }} &rarr; {{ phrase('adm.general.builtin_fields') }}</h3>
		<button class="btn help-page-trigger"><i class="icon-question-sign"></i></button>
	</header>
	<article class="pane-content no-pad">
		<div class="panel panel-fill">
			<div class="panel-heading">
				<nav class="dp-controls">
					<ul>
						<li>
							<span dp-ping-flash="fields_enabled" class="saved-ping"><i class="icon-check-sign"></i> {{ phrase('agent.general.saved') }}</span>
						</li>
					</ul>
				</nav>
				<h3>{{ phrase('adm.general.builtin_fields') }}</h3>
			</div>
			<ul class="dp-item-list">
				<li>
					<a href="#/tickets/ticket_fields/cats">
						<button dp-toggle-switch ng-model="TicketFieldsList.field_enabled.category" ng-change="TicketFieldsList.updateBuiltinFieldEnabledState('category')"></button>
						<h4><span class="title-text">{{ phrase('agent.general.categories') }}</span></h4>
					</a>
				</li>
				<li>
					<a href="#/tickets/ticket_fields/pris">
						<button dp-toggle-switch ng-model="TicketFieldsList.field_enabled.priority" ng-change="TicketFieldsList.updateBuiltinFieldEnabledState('priority')"></button>
						<h4><span class="title-text">{{ phrase('agent.general.priorities') }}</span></h4>
					</a>
				</li>
				<li>
					<a href="#/tickets/ticket_fields/works">
						<button dp-toggle-switch ng-model="TicketFieldsList.field_enabled.workflow" ng-change="TicketFieldsList.updateBuiltinFieldEnabledState('workflow')"></button>
						<h4><span class="title-text">{{ phrase('agent.general.workflows') }}</span></h4>
					</a>
				</li>
				<li>
					<a href="#/tickets/ticket_fields/products">
						<button dp-toggle-switch ng-model="TicketFieldsList.field_enabled.product" ng-change="TicketFieldsList.updateBuiltinFieldEnabledState('product')"></button>
						<h4><span class="title-text">{{ phrase('agent.general.products') }}</span></h4>
					</a>
				</li>
			</ul>
		</div>


		<div class="panel panel-fill">
			<div class="panel-heading">
				<nav class="dp-controls">
					<ul>
						<li>
							<span dp-ping-flash="fields_enabled" class="saved-ping"><i class="icon-check-sign"></i> {{ phrase('agent.general.saved') }}</span>
						</li>
						<li><span class="btn btn-danger" ng-class="{active: delete_mode}" ng-click="delete_mode = !delete_mode;"><i class="icon-trash"></i> {{ phrase('agent.general.delete') }}</span></li>
						<li><a class="btn btn-success" href="#/tickets/ticket_deps/go-create"><i class="icon-plus"></i> {{ phrase('agent.general.add') }}</a></li>
					</ul>
				</nav>

				<h3 ng-pluralize count="TicketFieldsList.custom_fields.length || 0" when="{{ ng_plural_phrase('adm.general.count_custom_fields') }}"></h3>
			</div>
			<ul class="dp-item-list">
				<li ng-repeat="field in TicketFieldsList.custom_fields" dp-state-mark="tickets.ticket_fields.edit.{{ ng_var('field.id') }}" data-id="{{ ng_var('field.id') }}">
					<a href="#/tickets/ticket_fields/{{ ng_var('field.id') }}">
						<button dp-toggle-switch ng-model="field.is_enabled" ng-change="TicketFieldsList.updateCustomFieldEnabledState(field)"></button>
						<div class="pull-right">
							<span class="badge" ng-hide="delete_mode" style="margin-top: -2px;" tooltip="The ID can be used in the API" tooltip-placement="left">ID: {{ ng_var('field.id') }}</span>
							<span class="btn btn-danger btn-xs only-icon" ng-show="delete_mode" style="margin-top: -3px;" ng-click="TicketFieldsList.startDelete(field); $event.preventDefault();"><i class="icon-trash"></i></span>
						</div>
						<h4><span class="title-text">{{ ng_var('field.title') }}</span></h4>
					</a>
				</li>
			</ul>
		</div>
	</article>
</div>
{% include 'AdminInterfaceBundle:TicketFields:help-page.html.twig' %}