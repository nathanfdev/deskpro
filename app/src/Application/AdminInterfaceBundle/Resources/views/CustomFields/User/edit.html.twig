{% extends 'AdminInterfaceBundle:CustomFields:Common/edit.html.twig' %}
{% block extra_types_choose %}
	<div class="form-group" ng-if="EditCtrl.us_apps.length">
		<div class="col-lg-12">
			<h3><label><input type="radio" ng-model="EditCtrl.field_type_chooser" value="data" /> User Auth Data</label></h3>
			<p>
				This is a special field that lets you copy data from a user authentication app into DeskPRO.
			</p>
		</div>
	</div>
{% endblock %}
{% block extra_types_titleswitch %}
	<span ng-switch-when="data">User Auth Data</span>
{% endblock %}
{% block pre_bottomdefault_fields %}
	<div ng-show="EditCtrl.field_type == 'data'">
		<div class="form-group">
			<div class="col-lg-3">
				<h3>Field Name</h3>
			</div>
			<div class="col-lg-9">
				<div class="inner-group">
					<input type="text" class="form-control" name="param_name" spellcheck="false" ng-model="EditCtrl.form.data.field_name" style="width: 50%;" />
					<span class="help-block">
						Enter the name of the field. <a href="https://support.deskpro.com/kb/articles/173" target="_blank">Click here for more information</a> on how to specify the field.
					</span>
				</div>
			</div>
		</div>

		<div class="form-group with-border">
			<div class="col-lg-3">
				<h3>Specific Auth App</h3>
			</div>
			<div class="col-lg-9">
				<div class="inner-group">
					<select ng-model="EditCtrl.form.data.usersource_id" ui-select2>
						<option value="0">Apply to all apps</option>
						<option ng-repeat="app in EditCtrl.us_apps" ng-value="{{ ng_var('app.usersource.id') }}">{{ ng_var('app.title') }}</option>
					</select>
					<span class="help-block">
						Choose which app to apply this field to. When a user logs-in using this app, then DeskPRO
						will attempt to fetch the field you specified above.
					</span>
				</div>
			</div>
		</div>
	</div>
{% endblock %}