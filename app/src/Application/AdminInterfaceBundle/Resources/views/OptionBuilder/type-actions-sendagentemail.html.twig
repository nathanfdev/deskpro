<dp-optionbuilder-row>
	<div class="dp-ob-standard-row">
		<table class="display-table">
			<tr>
				<td class="nowrap"><label>Send Agent Email</label></td>
				<td>
					<table class="display-table">
						<tr>
							<td>Template:</td>
							<td>
								<select ui-select2="{dropdownAutoWidth:true}" ng-model="model.template" style="min-width: 50px;" ng-init="model.template = model.template || ''">
									<option value="">Default Notification</option>
									<option value="CREATE">Create a new template...</option>
								</select>
							</td>
						</tr>

						<tr>
							<td style="vertical-align: top; margin-top: 3px;">Agents:</td>
							<td>
								<ul class="checkbox-list" style="min-width: 200px">
									<li style="border-bottom: 1px solid #ccc;">
										<label>
											<input type="checkbox" ng-model="model.agent_ids.notify_list" />
											Send to agents who have matching subscriptions
										</label>
									</li>
									<li ng-repeat="agent in agents">
										<label>
											<input type="checkbox" ng-model="model.agent_ids[agent.id]" />
											{{ ng_var('agent.display_name') }}
										</label>
									</li>
								</ul>
							</td>
						</tr>
						<tr>
							<td style="vertical-align: top; margin-top: 3px;">From Name:</td>
							<td>
								<select ui-select2="{dropdownAutoWidth:true}" ng-model="model.from_name_type" ng-init="" style="min-width: 50px;">
									<option value="">Default Notification</option>
									<option value="CREATE">Create a new template...</option>
								</select>
							</td>
						</tr>
					</table>
				</td>
			</tr>
		</table>
	</div>
</dp-optionbuilder-row>