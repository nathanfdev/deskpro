<dp-optionbuilder-row>
	<div class="dp-ob-standard-row">
		<table class="display-table">
			<tr>
				<td class="nowrap"><label class="row-label">Send Email</label></td>
				<td ng-show="rowOpts.rowEnabled">
					<table class="display-table spaced">
                        <tr>
                            <td>Email Address to Send to (separate multiple with commas):</td>
                            <td>
                                <input type="text" class="form-control" ng-model="model.emails" ng-list style="min-width: 50px;" />
                            </td>
                        </tr>
						<tr>
							<td>Template:</td>
							<td>
								<select ng-if="!is_creating" ui-select2="{dropdownAutoWidth:true}" ng-model="model.template" style="min-width: 50px;" ng-init="model.template = model.template || 'DeskPRO:emails_user:ticket-new-autoreply.html.twig'" ng-change="handleTemplateChange()">
									<optgroup label="Standard User Emails">
										{% for email,label in {
											'DeskPRO:emails_user:ticket-new-autoreply.html.twig': 'New Ticket Auto-Response',
											'DeskPRO:emails_user:ticket-new-byagent.html.twig': 'New Ticket by Agent',
											'DeskPRO:emails_user:ticket-reply-byagent.html.twig': 'New Agent Reply',
											'DeskPRO:emails_user:ticket-reply-autoreply.html.twig': 'User Reply Auto-Response',
										} %}
											<option value="{{ email }}">{{ label }}</option>
										{% endfor %}
									</optgroup>
									<optgroup label="Other User Emails">
										<option value="DeskPRO:emails_user:ticket-rate.html.twig">Request user feedabck</option>
										<option value="DeskPRO:emails_user:ticket-new-validate-email.html.twig">New ticket requires validation (auto-response)</option>
									</optgroup>
									<optgroup label="Custom Emails">
										<option ng-repeat="tpl in custom_email_tpls" value="{{ ng_var('tpl.name') }}">{{ ng_var('tpl.title') }}</option>
										<option value="CREATE">Create a new template...</option>
									</optgroup>
								</select>
								<span ng-if="is_creating">Creating a new template</span>
								<span ng-if="!is_creating && model.template" style="margin-left: 3px;">
									<a class="inline-edit-link expanded" ng-click="editTemplate()">
										<i class="fa fa-pencil"></i>
										<em>edit template</em>
									</a>
								</span>
							</td>
						</tr>
						<tr>
							<td>From Name:</td>
							<td>
								<select ui-select2="{dropdownAutoWidth:true}" ng-model="model.from_name" ng-init="" style="min-width: 50px;">
									<option value="performer">Name of the person who initiated the action</option>
									<option value="helpdesk_name">Helpdesk Name ({{ app.getSetting('core.deskpro_name') }})</option>
									{% if app.getSetting('core.site_name') %}<option value="site_name">Site Name ({{ app.getSetting('core.site_name') }})</option>{% endif %}
									<option value="custom">Enter a custom name</option>
								</select>
								<div style="padding-top: 3px; width: 250px;">
									<input type="text" class="form-control" ng-model="model.from_name_custom" ng-show="model.from_name == 'custom'" />
								</div>
							</td>
						</tr>
						<tr>
							<td>From Email:</td>
							<td>
								<select ui-select2="{dropdownAutoWidth:true}" ng-model="model.from_account" ng-init="" style="min-width: 50px;">
									<optgroup label="Default">
										<option value="0">The account set on the ticket</option>
									</optgroup>
									<optgroup label="Specific account">
										<option ng-repeat="acc in email_accounts" value="{{ ng_var('acc.id') }}">{{ ng_var('acc.address') }}</option>
									</optgroup>
								</select>
							</td>
						</tr>

                        {% include 'AdminInterfaceBundle:OptionBuilder:email-headers.html.twig' %}

					</table>
				</td>
			</tr>
		</table>
	</div>
</dp-optionbuilder-row>