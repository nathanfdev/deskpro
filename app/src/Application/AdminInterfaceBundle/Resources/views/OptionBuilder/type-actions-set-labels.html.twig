<dp-optionbuilder-row>
	<div class="dp-ob-standard-row">
		<table class="display-table">
			<tr>
				<td class="nowrap" width="50"><label class="row-label">Set Labels</label></td>
				<td ng-show="rowOpts.rowEnabled">
					<table class="display-table spaced" width="100%">
						<tr>
							<td style="vertical-align: top; white-space: nowrap" nowrap width="100">
								<label>
									<input type="checkbox" ng-model="model.with_add" />
									Add labels
								</label>
								<div ng-show="model.with_add">
                                    <input
                                            type="hidden"
                                            ui-select2="model.select2_add"
                                            ng-model="model.add_labels"
                                            style="min-width: 80%"
                                            >
								</div>
							</td>
						</tr>
						<tr>
							<td style="vertical-align: top; white-space: nowrap" nowrap width="100">
								<label>
									<input type="checkbox" ng-model="model.with_remove" />
									Remove labels
								</label>
								<div ng-show="model.with_remove">
                                    <input
                                            type="hidden"
                                            ui-select2="model.select2_remove"
                                            ng-model="model.remove_labels"
                                            style="min-width: 80%"
                                            >
								</div>
							</td>
						</tr>
					</table>
				</td>
			</tr>
		</table>
	</div>
</dp-optionbuilder-row>