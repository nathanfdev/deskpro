<dp-optionbuilder-row>
	<div class="dp-ob-standard-row">
		<table class="display-table" width="100%">
			<tr>
				<td width="80" class="nowrap" style="padding-right: 8px;">
					<select ui-select2="{dropdownAutoWidth:true}" ng-model="model.op" style="min-width: 50px;">
						<option value="is">The user has been emailed</option>
						<option value="not">The user has NOT been emailed</option>
					</select>
				</td>
				<td width="100" class="nowrap">
					<label><input type="checkbox" ng-model="model.with_template" /> a specific email template</label>
				</td>
				<td width="100%" style="padding-left: 5px;">
					<div ng-show="model.with_template">
						<select ui-select2="{dropdownAutoWidth:true}" ng-model="model.template" style="min-width: 50px;" ng-init="model.template = model.template || 'DeskPRO:emails_user:ticket-new-autoreply.html.twig'">
							<optgroup label="Standard User Emails">
								{% for email,label in {
								'DeskPRO:emails_user:ticket-new-autoreply.html.twig': 'New Ticket Auto-Response',
								'DeskPRO:emails_user:ticket-new-byagent.html.twig': 'New Ticket by Agent',
								'DeskPRO:emails_user:ticket-reply-byagent.html.twig': 'New Agent Reply',
								'DeskPRO:emails_user:ticket-reply-autoreply.html.twig': 'User Reply Auto-Response',
								} %}
									<option value="{{ email }}">{{ label }}</option>
								{% endfor %}
							</optgroup>
							<optgroup label="Other User Emails">
								<option value="DeskPRO:emails_user:ticket-rate.html.twig">Request user feedabck</option>
								<option value="DeskPRO:emails_user:ticket-new-validate-email.html.twig">New ticket requires validation (auto-response)</option>
							</optgroup>
							<optgroup label="Custom Emails">
								<option ng-repeat="tpl in custom_email_tpls" value="{{ ng_var('tpl.name') }}">{{ ng_var('tpl.title') }}</option>
							</optgroup>
						</select>
					</div>
				</td>
				<td>&nbsp;</td>
			</tr>
		</table>
	</div>
</dp-optionbuilder-row>
