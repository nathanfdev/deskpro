<div ng-if="all_locked_perms" class="alert alert-danger" style="margin: 10px;">
	<p>
		Permissions are fixed and uneditable for built-in permission groups like this one.
	</p>
	<p>
		If you want to use custom permissions, you must <a href="{{ ng_href('agents.groups.create') }}">create a custom permission group</a> instead.
	</p>
</div>

{% macro perm_row(typename, permname, opts) %}
	{% set row_id = 'perm_' ~ typename ~ '_' ~ permname %}

	<tr
			class="{% if opts.first %}first-of-type{% endif %} {% if opts.toggleName %}nested{% endif %}"
			{% if opts.toggleName %}
				{% set toggleNameId = 'perm_' ~ opts.toggleName|replace({'.':'_'}) %}
				ng-show="{{ toggleNameId }}_toggler"
			{% endif %}
			>
		<td width="100%">
			<span class="title">
				{% if has_phrase('adm.agents.perm_' ~ typename ~ '_' ~ permname) %}
					{{ phrase('adm.agents.perm_' ~ typename ~ '_' ~ permname) }}
				{% else %}
					{{ phrase('adm.agents.perm_' ~ typename ~ '_' ~ permname|replace({'_own': '', '_followed': '', '_unassigned': '', '_others': ''})) }}
				{% endif %}
			</span>

			{% if opts.showToggler %}
				<span class="toggle-wrap" ng-click="{{ row_id }}_toggler = !{{ row_id }}_toggler">
					<span ng-show="!{{ row_id }}_toggler">expand <i class="fa fa-caret-down"></i></span>
					<span ng-show="{{ row_id }}_toggler">collapse <i class="fa fa-caret-up"></i></span>
				</span>
			{% endif %}
		</td>
		<td>
			<input
				dp-slider-switch
				ng-model="EditCtrl.perm_form.{{ typename }}.{{ permname }}"
				{% if opts.toggleName %}
					is-on="EditCtrl.perm_form.{{ opts.toggleName }}"
					is-locked="all_locked_perms || EditCtrl.perm_form.{{ opts.toggleName }}"
					locked-tip="This permission is locked because the parent permission is enabled"
				{% else %}
					is-locked="all_locked_perms"
				{% endif %}
				/>
		</td>
	</tr>
{% endmacro %}

