{% extends 'AdminInterfaceBundle:Layout:list-editpane.html.twig' %}
{% block editpane_content %}
	<form class="form-horizontal dp-form" role="form" name="form_props" ng-submit="">
		<section class="dp-paneblock dp-editpane">
			<article class="form-horizontal dp-form">
				<div class="panel panel-fill indent">
					<div class="panel-body">
						<div class="form-group">
							<div class="col-lg-12">
								<h3><label><input type="radio" ng-model="EditCtrl.usersource_type" value="active_directory" /> Active Directory</label></h3>
							</div>
						</div>
						<div class="form-group">
							<div class="col-lg-12">
								<h3><label><input type="radio" ng-model="EditCtrl.usersource_type" value="ldap" /> LDAP</label></h3>
							</div>
						</div>
						<div class="form-group">
							<div class="col-lg-12">
								<h3><label><input type="radio" ng-model="EditCtrl.usersource_type" value="custom" /> Custom Database</label></h3>
							</div>
						</div>
						<div class="form-group">
							<div class="col-lg-12">
								<h3><label><input type="radio" ng-model="EditCtrl.usersource_type" value="vbulletin" /> vBulletin (v3 or v4)</label></h3>
							</div>
						</div>
						<div class="form-group">
							<div class="col-lg-12">
								<h3><label><input type="radio" ng-model="EditCtrl.usersource_type" value="xenforo" /> XenForo (v1)</label></h3>
							</div>
						</div>
						<div class="form-group">
							<div class="col-lg-12">
								<h3><label><input type="radio" ng-model="EditCtrl.usersource_type" value="phpbb2" /> phpBB (v2)</label></h3>
							</div>
						</div>
						<div class="form-group">
							<div class="col-lg-12">
								<h3><label><input type="radio" ng-model="EditCtrl.usersource_type" value="phpbb3" /> phpBB (v3)</label></h3>
							</div>
						</div>
						<div class="form-group">
							<div class="col-lg-12">
								<h3><label><input type="radio" ng-model="EditCtrl.usersource_type" value="ez_publish" /> eZ Publish</label></h3>
							</div>
						</div>
						<div class="form-group">
							<div class="col-lg-12">
								<h3><label><input type="radio" ng-model="EditCtrl.usersource_type" value="magento" /> Magento</label></h3>
							</div>
						</div>
						<div class="form-group">
							<div class="col-lg-12">
								<div class="alert alert-info">
									More types are available by installing new apps<br/>
									<a href="{{ ng_href('apps.apps') }}" class="btn btn-info">Go to Apps <i class="fa fa-chevron-right"></i></a>
								</div>
							</div>
						</div>
					</div>
				</div>
			</article>
			<footer>
				<div class="dp-content">
					<div class="dp-btn-controls">
						<button class="btn btn-primary" dp-submit-form>Continue <i class="fa fa-arrow-right"></i></button>
					</div>
				</div>
			</footer>
		</section>
	</form>
{% endblock %}