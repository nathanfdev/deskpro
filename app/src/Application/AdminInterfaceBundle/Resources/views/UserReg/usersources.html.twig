{% extends 'AdminInterfaceBundle:Layout:list.html.twig' %}
{% block listpane_content %}
	<section class="dp-paneblock dp-listpane">
		<header>
			<h3>Authentication and SSO</h3>
		</header>
		<article>
			<ul class="dp-item-list">
				<li>
					<a href="{{ ng_href('crm.usersources.deskpro') }}">
						<h4>
							<span class="title-text">DeskPRO</span>
						</h4>
					</a>
				</li>
				<li ng-repeat="app in ListCtrl.apps" dp-state-mark="crm.usersources.app.{{ ng_var('app.id') }}">
					<a href="{{ ng_href('crm.usersources.app', '{id: app.id}') }}">
						<h4>
							<span class="title-text">{{ ng_var('app.title') }}</span>
						</h4>
					</a>
				</li>
			</ul>
			<div class="dp-add-control">
				<a class="btn btn-default" href="{{ ng_href('crm.usersources.newtype') }}"><i class="fa fa-plus"></i> {{ phrase('agent.general.add') }}</a>
			</div>
		</article>
	</section>
{% endblock %}
{% block listpane_help %}
	{% include 'AdminInterfaceBundle:UserReg:usersources-help.html.twig' %}
{% endblock %}