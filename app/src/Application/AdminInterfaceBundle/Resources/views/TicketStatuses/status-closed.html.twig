{% extends 'AdminInterfaceBundle:Layout:list-editpane.html.twig' %}
{% block editpane_content %}
	<section class="dp-paneblock dp-editpane">
		<article>
			<div class="panel panel-fill indent">
				<div class="panel-body">
					<p>
						For very large helpdesks with millions of tickets, archiving can greatly improve performance of the agent interface and filters.
					</p>
					<p>
						When an old ticket is archived it is moved out of your filters and into the 'Archived' section. You can still view archived tickets and agents with permission can restore archived tickets
					</p>
					<p ng-if="settings.enabled || getCount() > 0">
						You currently have <strong>{{ ng_var('getCount()') }}</strong> archived.
					</p>
				</div>
			</div>
		</article>
	</section>

	<form class="form-horizontal dp-form" role="form" name="form_props" ng-submit="TicketStatusEdit.saveLabel()">
		<section class="dp-paneblock dp-editpane">
			<article class="form-horizontal dp-form">
				<div class="panel panel-fill indent">
					<div class="panel-body">
						<div class="form-group">
							<div class="col-lg-3">
								<h3>Enabled</h3>
							</div>
							<div class="col-lg-9">
								<button dp-toggle-switch ng-model="settings.enabled"></button>
							</div>
						</div>

						<div class="form-group">
							<div class="col-lg-3">
								<h3>Auto-Archive</h3>
							</div>
							<div class="col-lg-9">
								<p>
									Automatically move resolved ticket to the archive after
									<dp-time-with-unit ng-model="settings.auto_archive_time"></dp-time-with-unit>
								</p>
							</div>
						</div>
					</div>
				</div>
			</article>
			<footer>
				<div class="dp-content">
					<div class="text-danger ng-hide" ng-show="form_props.$attempted && form_props.$invalid">
						<p><strong>{{phrase('adm.general.please_correct_errors')}}</strong></p>
						<ul>
							<li ng-show="form_props.label.$error.required">{{phrase('adm.general.label_edit_error')}}</li>
						</ul>
					</div>
					<div class="dp-btn-controls" ng-hide="form_props.$attempted && form_props.$invalid">
						<div dp-hide-spinning="saving_label">
							<button class="btn btn-primary" dp-submit-form>{{phrase('agent.general.save')}}</button>
						</div>
						<div dp-show-spinning="saving_label">
							<i class="spinner-flat"></i>
						</div>
					</div>
				</div>
			</footer>
		</section>
	</form>
{% endblock %}