{% extends 'AdminInterfaceBundle:Layout:list.html.twig' %}
{% block listpane_content %}
	<section class="dp-paneblock dp-listpane">
		<header>
			<h3>{{ phrase('admin.tickets.statuses') }}</h3>
		</header>
		<article>
			<ul class="dp-item-list">
				<li>
					<a href="{{ ng_href('tickets.statuses.awaiting_agent') }}">{{ phrase('agent.tickets.status_awaiting_agent') }}</a>
				</li>
				<li>
					<a href="{{ ng_href('tickets.statuses.awaiting_user') }}">{{ phrase('agent.tickets.status_awaiting_user') }}</a>
				</li>
				<li>
					<a href="{{ ng_href('tickets.statuses.resolved') }}">{{ phrase('agent.tickets.status_resolved') }}</a>
				</li>
				<li>
					<a href="{{ ng_href('tickets.statuses.closed') }}">{{ phrase('agent.tickets.status_closed') }}</a>
				</li>
			</ul>
		</article>
	</section>

	<section class="dp-paneblock dp-listpane">
		<header>
			<h3>{{ phrase('admin.tickets.hidden_statuses') }}</h3>
		</header>
		<article>
			<ul class="dp-item-list">
				<li>
					<a href="{{ ng_href('tickets.statuses.hidden_validating') }}">{{ phrase('agent.tickets.status_hidden_validating') }}</a>
				</li>
				<li>
					<a href="{{ ng_href('tickets.statuses.hidden_deleted') }}">{{ phrase('agent.tickets.status_hidden_deleted') }}</a>
				</li>
				<li>
					<a href="{{ ng_href('tickets.statuses.hidden_spam') }}">{{ phrase('agent.tickets.status_hidden_spam') }}</a>
				</li>
			</ul>
		</article>
	</section>
{% endblock %}
{% block listpane_help %}
	{% include 'AdminInterfaceBundle:TicketStatuses:help-page.html.twig' %}
{% endblock %}