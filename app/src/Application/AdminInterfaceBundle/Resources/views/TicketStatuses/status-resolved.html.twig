{% extends 'AdminInterfaceBundle:Layout:list-editpane.html.twig' %}
{% block editpane_content %}
	<section class="dp-paneblock dp-editpane dp-form">
		<article>
			<div class="panel panel-fill indent">
				<div class="panel-body">
					<p>
						A Resolved ticket is a finished ticket that no longer requires action from the agent nor the user.
					</p>
					<p>
						You currently have <strong>{{ ng_var('getCount()') }}</strong> resolved tickets.
					</p>
				</div>
			</div>
		</article>

		{% for num in 4..5 %}

			<article ng-show="ctrl.esc"
					 ng-controller="Admin_TicketEscalations_Ctrl_EditStatuses as ctrl"
					 ng-init="initWith({{ num }})"
					>
				<div class="panel panel-fill indent">
					<div class="panel-body">

						<div class="inner-group">
							<label>
								<input type="checkbox" ng-model="ctrl.esc.is_enabled" ng-change="ctrl.escData.saveEnabledState(ctrl.esc)" />
								<h4>
									After ticket has been resolved for
									<dp-time-with-unit ng-model="ctrl.form.event_trigger_time"></dp-time-with-unit>

									<span ng-if="ctrl.esc.is_default_action">
										set the status to Archived
									</span>
									<dp-option-builder types-def="ctrl.actionsTypeDef" save-target="ctrl.form.actions"
													   options="{tag_first: '', tag_after: 'then', fixOn: []}" option-types="actionOptionTypes"
													   ng-if="false === ctrl.esc.is_default_action"
											>
										<add-btn-label>Action</add-btn-label>
									</dp-option-builder>
								</h4>
							</label>
						</div>

						<span class="help-block">
							{{ phrase('adm.satisfaction.escalation_help') }}
						</span>
					</div>
				</div>
			</article>

		{% endfor %}

		<footer>
			<div class="dp-content">
				<div class="dp-btn-controls">
					<div dp-hide-spinning="saving">
						<button class="btn btn-primary" ng-click="TicketStatusEdit.save()">{{ phrase('agent.general.save') }}</button>
					</div>
					<div dp-show-spinning="saving">
						<i class="spinner-flat"></i>
					</div>
				</div>
			</div>
		</footer>

		<div dp-register-message="saved_settings">Settings saved successfully.</div>

	</section>
{% endblock %}
