{% extends 'AdminInterfaceBundle:Layout:fullpage-pane.html.twig' %}
{% block fullpane_content %}

	<section class="dp-paneblock dp-panelink">
		<a href="{{ ng_href('tickets.ticket_accounts') }}">
			<em><i class="fa fa-chevron-down"></i></em>
			<h3>Email Accounts</h3>
		</a>
	</section>

	<section class="dp-paneblock dp-panelink">
		<a href="{{ ng_href('tickets.ticket_accounts.emailsources') }}">
			<em><i class="fa fa-chevron-down"></i></em>
			<h3>Incoming Email Log</h3>
		</a>
	</section>

	<section class="dp-paneblock dp-panelink">
		<a href="{{ ng_href('tickets.ticket_accounts.sendmailqueue') }}">
			<em><i class="fa fa-chevron-down"></i></em>
			<h3>Outgoing Email Log</h3>
		</a>
	</section>

	<form class="form-horizontal dp-form" role="form" name="form_props" ng-submit="Settings.save()">
		<section class="dp-paneblock dp-listpane">
			<header>
				<h3>Email Settings</h3>
			</header>

			{##################################################################################################}

			<article class="form-horizontal dp-form">
				<div class="panel panel-innertable">
					<div class="form-group">
						<div class="col-lg-12">
							<div class="inner-group">
								<label>
									<input type="checkbox" ng-model="settings.process_agent_fwd" />
									<h4>Smart processing of forwarded emails by agents</h4>
								</label>
								<span class="help-block">
									When enabled, allows your agents to "Forward" an email from their email inbox to the helpdesk.
									The helpdesk will attempt to parse the email to find the original user and original message and create
									a ticket automatically. <a href="https://support.deskpro.com/kb/articles/106-agent-ticket-forwarding" target="_blank">Learn more about this feature.</a>
								</span>
							</div>
							<div class="inner-group">
								<label>
									<input type="checkbox" ng-model="settings.add_agent_ccs" />
									<h4>Allow users to CC agent accounts</h4>
								</label>
								<span class="help-block">
									When enabled, any user or agent can CC an agent email address in to a ticket and that agent will become a follower of the ticket.
									If you do not want users to be able to add specific agents to tickets by CC'ing, you should disable this option.
								</span>
							</div>
							<div class="inner-group">
								<label>
									<h4>Max email size</h4>
								</label>
								<span class="help-block">
									Enter the maximum email size to accept. Any email over this size will be rejected and
									a warning sent to the user. Leave blank for no limit.
								</span>
								<input type="text" class="form-control" ng-model="settings.gateway_max_email_mb" style="width: 80px;" /> megabytes
							</div>
						</div>
					</div>
				</div>
			</article>

			{##################################################################################################}

			<footer>
				<div class="dp-content">
					<div class="dp-btn-controls" ng-hide="form_props.$attempted && form_props.$invalid">
						<div dp-hide-spinning="saving">
							<button class="btn btn-primary" dp-submit-form>{{ phrase('agent.general.save') }}</button>
							<button class="btn btn-default" ng-click="TicketDepsEdit.resetForm()">{{ phrase('agent.general.reset') }}</button>
						</div>
						<div dp-show-spinning="saving">
							<i class="spinner-flat"></i>
						</div>
					</div>
				</div>
			</footer>
		</section>
	</form>
	<div dp-register-message="saved_settings">Settings saved successfully.</div>
{% endblock %}