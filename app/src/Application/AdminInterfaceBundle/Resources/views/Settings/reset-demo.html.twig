{% extends 'AdminInterfaceBundle:Layout:fullpage-pane.html.twig' %}
{% block fullpane_content %}
    <form class="form-horizontal dp-form" role="form" name="form_props" ng-submit="Ctrl.save()">
        <section class="dp-paneblock dp-listpane">
            <header>
                <h3>Reset Demo</h3>
            </header>

            {##################################################################################################}

            <article class="form-horizontal dp-form">
                <div class="panel panel-innertable">
                    <div class="panel-heading">
                        <h3>
                            <span>Published Content Settings</span>
                        </h3>
                    </div>
                    <div class="form-group">
                        <div class="col-lg-12">
                            <div class="inner-group" dp-error-class="form_props.show_ratings">
                                <label>
                                    <input type="checkbox" ng-model="show_ratings_opt" />
                                    <h4>Show ratings publicly</h4>
                                </label>
                                <div ng-show="show_ratings_opt">
                                    Show ratings publicly in the portal after there have been
                                    <input type="number" name="show_ratings" class="form-control" ng-model="settings.show_ratings"
                                           style="width: 80px;" required min="0" /> votes.
                                </div>
                            </div>
                            <div class="inner-group">
                                <label>
                                    <input type="checkbox" ng-model="settings.publish_comments" />
                                    <h4>Enable comments on published content</h4>
                                </label>
						<span class="help-block">
							Enable comments on articles, news and downloads. (This setting does not affect Feedback; discussons on feedback is always enabled).
						</span>
                            </div>
                        </div>
                    </div>
                </div>
            </article>

            {##################################################################################################}

            <footer>
                <div class="dp-content">
                    <div class="dp-btn-controls" ng-hide="form_props.$attempted && form_props.$invalid">
                        <div dp-hide-spinning="saving">
                            <button class="btn btn-primary" dp-submit-form>{{ phrase('agent.general.save') }}</button>
                            <button class="btn btn-default" ng-click="TicketDepsEdit.resetForm()">{{ phrase('agent.general.reset') }}</button>
                        </div>
                        <div dp-show-spinning="saving">
                            <i class="spinner-flat"></i>
                        </div>
                    </div>
                </div>
            </footer>
        </section>
    </form>
    <div dp-register-message="saved_settings">Settings saved successfully.</div>
{% endblock %}
