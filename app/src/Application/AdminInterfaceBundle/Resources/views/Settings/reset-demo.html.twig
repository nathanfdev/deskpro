{% extends 'AdminInterfaceBundle:Layout:fullpage-pane.html.twig' %}
{% block fullpane_content %}
    <form class="form-horizontal dp-form" role="form" name="form_props" ng-submit="Ctrl.save()">
        <section class="dp-paneblock dp-listpane">
            <header>
                <h3>Reset Demo</h3>
            </header>

            {##################################################################################################}

            <article class="form-horizontal dp-form">
                <div class="panel panel-innertable">
                    {#<div class="panel-heading">#}
                        {#<h3>#}
                            {#<span>Header</span>#}
                        {#</h3>#}
                    {#</div>#}
                    <div class="form-group">
                        <div class="col-lg-12">

                            {% set tp = 'adm.settings.reset_demo_titles_' %}
                            {% set dp = 'adm.settings.reset_demo_descriptions_' %}
                            {% for id in [
                                'users',
                                'agents',
                                'tickets',
                                'triggers',
                                'filters',
                                'templates',
                                'esc_sla',
                                'fields',
                                'departments',
                                'perms',
                                'kb',
                                'news',
                                'downloads',
                                'feedback',
                                'labels',
                                'snippets_macros',
                                'settings',
                                'apps'
                            ] %}
                            <div class="inner-group" dp-error-class="form_props.{{ id }}">
                                <label>
                                    <input type="checkbox" name="{{ id }}" ng-model="{{ id }}" />
                                    <h4>{{ phrase(tp ~ id) }}</h4>
                                </label>
                                <span class="help-block">
							        {{ phrase(dp ~ id) }}
						        </span>
                            </div>
                            {% endfor %}

                        </div>
                    </div>
                </div>
            </article>

            {##################################################################################################}

            <footer>
                <div class="dp-content">
                    <div class="dp-btn-controls" ng-hide="form_props.$attempted && form_props.$invalid">
                        <div dp-hide-spinning="saving">
                            <button class="btn btn-primary" dp-submit-form>{{ phrase('agent.general.save') }}</button>
                            <button class="btn btn-default" ng-click="TicketDepsEdit.resetForm()">{{ phrase('agent.general.reset') }}</button>
                        </div>
                        <div dp-show-spinning="saving">
                            <i class="spinner-flat"></i>
                        </div>
                    </div>
                </div>
            </footer>
        </section>
    </form>
    <div dp-register-message="saved_settings">Settings saved successfully.</div>
{% endblock %}
