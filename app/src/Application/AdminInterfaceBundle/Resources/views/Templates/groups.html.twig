{% extends 'AdminInterfaceBundle:Layout:list.html.twig' %}
{% block listpane_content %}
	<section class="dp-paneblock dp-listpane">
		<header>
			<h3>Templates</h3>
		</header>
		<article>
			<ul class="dp-item-list">
				<li ng-repeat="group in ListCtrl.groups" dp-state-mark="groupName!:portal.templates.list.{{ ng_var('group.id|murmurhash') }}">
					<a href="{{ ng_href('portal.templates.list', '{groupName: group.id}') }}">
						<h4>
							<i class="fa fa-folder"></i>
							<span class="title-text">{{ ng_var('group.title') }}</span>
						</h4>
					</a>
				</li>
			</ul>
		</article>
	</section>
{% endblock %}
{% block listpane_help %}
	<header>
		<h1>Customize your portal by editing these templates</h1>
		<p>You can change the design and layout of the portal by editing these templates and the portal phrases.</p>
	</header>
	<article>
	
<p>Templates use <a href="http://twig.sensiolabs.org/doc/templates.html" target="_blank">Twig syntax</a>. </p>
<p>Each template consists of HTML containing special template code:</p>

<ul>
	<li><strong>Phrases</strong> - to insert a phrase as defined in the language pack:<br />
		<code>{{ phrase('user.profile.choose_email') }}</code> inserts "Choose the email address you want to use" (unless custom phrase was stored)
	</li>	
	<li><strong>Variables</strong> - to insert information stored in DeskPRO:<br />
		<code>{{ app.user.name }}</code> inserts name of logged-in user
	</li>
	<li><strong>Tags</strong> - used to choose what to display based on logical operations:<br />
		<code>
    {% if app.user.isMemberOfUsergroup(3) %}
    
        Welcome, VIP!
        
    {% else %}

        Welcome, average Joe!

    {% endif %}
    </code><br />
    displays a different message to users who belong to a certain usergroup.
    </li>
</ul>    
		
		
<p>You can edit template code to customize the portal. Consult the <a href="https://support.deskpro.com/downloads/files/7-admin-manual-pdf" target="_blank">admin manual</a> and the <a href="http://twig.sensiolabs.org/doc/templates.html" target="_blank">Twig documentation</a> for more details.</p>
	
	
	
	
	<section>
		<h2><span>FAQ</span></h2>
		<dl>
			<dt><em>Q:</em>How can I make the portal look more like the rest of my site?</dt>
			<dd><em>A:</em>
				A good place to start is by editing the CSS templates to style the portal.
			</dd>
		</dl>
</section>
		<section>
			<h2><span>Related Content</span></h2>
			<ul>
				<li>[MANUAL]<a href="https://www.deskpro.com/manuals/admin-manual/admin-manual.html#editing-templates">Editing Templates</a></li>
				<li>[ARTICLE]<a href="https://support.deskpro.com/kb/articles/186" target="_blank">Make a cleaner portal News page by removing title & navigation</a></li>
				<li>[ARTICLE]<a href="https://support.deskpro.com/kb/articles/141" target="_blank">Change welcome message based on usergroup</a></li>
				<li>[ARTICLE]<a href="https://support.deskpro.com/kb/articles/144" target="_blank"></a>Customizing the embedded contact form</li>
				<li>[ARTICLE]<a href="https://support.deskpro.com/kb/articles/188" target="_blank">Some of our portal is missing!</a></li>
			</ul>
	</section>
</article>
	
{% endblock %}