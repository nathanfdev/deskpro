<div class="modal-dialog dp-codeeditor-modal">
	<div class="modal-content">
		<div class="modal-header">
			<button type="button" class="close" ng-click="dismiss()">&times;</button>
			<h4 class="modal-title">{{ ng_var('email.display_title') }}</h4>
		</div>
		<div class="modal-body">
			<p>
				{{ ng_var('email.display_description') }}
			</p>
			<div class="editor-row">
				<label>Email Subject:</label>
				<div class="editor-wrap subject">
					<div class="editor" ng-model="email.template_code.subject" ui-ace="{
						mode: 'twig',
						useWrapMode: true,
						showGutter: false,
						theme: 'textmate',
						onLoad: aceLoaded
					}"></div>
				</div>
			</div>
			<div class="editor-row">
				<label>Email Body:</label>
				<div class="editor-wrap body">
					<div class="editor" style="height: 300px;" ng-model="email.template_code.body" ui-ace="{
						mode: 'twig',
						useWrapMode: true,
						theme: 'textmate',
						onLoad: aceLoaded
					}"></div>
				</div>
			</div>
		</div>
		<div class="modal-footer">
			<button class="btn btn-success" ng-click="dismiss()"><i class="fa fa-undo"></i> {{ phrase('agent.general.save') }}</button>
		</div>
	</div>
</div>