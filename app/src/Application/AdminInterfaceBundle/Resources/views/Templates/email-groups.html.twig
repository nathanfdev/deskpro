{% extends 'AdminInterfaceBundle:Layout:list.html.twig' %}
{% block listpane_content %}
	<section class="dp-paneblock dp-listpane">
		<header>
			<h3>Email Templates</h3>
		</header>
		<article>
			<ul class="dp-item-list">
				<li dp-state-mark="groupName!:tickets.email_templates.list.{{ ng_var("'layout:top'|murmurhash") }}">
					<a href="{{ ng_href('tickets.email_templates.list', "{groupName: 'layout:top'}") }}">
						<h4>
							<i class="fa fa-folder"></i>
							<span class="title-text">Layout (Header, footer, CSS)</span>
						</h4>
					</a>
				</li>
			</ul>
		</article>
	</section>

	<section class="dp-paneblock dp-listpane">
		<header>
			<h3>Custom Email Templates</h3>
		</header>
		<article>
			<ul class="dp-item-list">
				<li dp-state-mark="groupName:tickets.email_templates.list.custom">
					<a href="{{ ng_href('tickets.email_templates.list', "{groupName: 'custom'}") }}">
						<h4>
							<i class="fa fa-folder"></i>
							<span class="title-text">Custom Email Templates</span>
						</h4>
					</a>
				</li>
			</ul>
		</article>
	</section>

	<section class="dp-paneblock dp-listpane">
		<header>
			<h3>User Email Templates</h3>
		</header>
		<article>
			<ul class="dp-item-list">
				<li ng-repeat="info in ListCtrl.templateInfo.user.groups" dp-state-mark="groupName!:tickets.email_templates.list.{{ ng_var("'user:' + info.groupId|murmurhash") }}">
					<a href="{{ ng_href('tickets.email_templates.list', "{groupName: 'user:' + info.groupId}") }}">
						<h4>
							<i class="fa fa-folder"></i>
							<span class="title-text">{{ ng_var('info.title') }}</span>
						</h4>
					</a>
				</li>
			</ul>
		</article>
	</section>

	<section class="dp-paneblock dp-listpane">
		<header>
			<h3>Agent Email Templates</h3>
		</header>
		<article>
			<ul class="dp-item-list">
				<li ng-repeat="info in ListCtrl.templateInfo.agent.groups" dp-state-mark="groupName!:tickets.email_templates.list.{{ ng_var("'agent:' + info.groupId|murmurhash") }}">
					<a href="{{ ng_href('tickets.email_templates.list', "{groupName: 'agent:' + info.groupId}") }}">
						<h4>
							<i class="fa fa-folder"></i>
							<span class="title-text">{{ ng_var('info.title') }}</span>
						</h4>
					</a>
				</li>
			</ul>
		</article>
	</section>
{% endblock %}
{% block listpane_help %}
	<header>
		<h1>Customize the content of emails sent out to agents and users by editing these templates.</h1>
			<p>These templates control the content of all emails sent by DeskPRO (except for the text written by agents or users), including both automatic notifications and agent/user replies.
			</p>
	</header>
	<article>
	
		<section>
		
			<p>Templates reference <strong>phrases</strong> (as defined in language packs - see <strong>Setup > Languages</strong>): short re-usable pieces of text which specify something like the user greeting at the beginning of an email. To actually change the text of an email, you should edit the relevant phrase, or define a new phrase and include it in a template. For example, <code>{{ '{{' }} phrase('user.emails.greeting') {{ '}}' }}</code> is used to insert a standard greeting phrase into a user email.</p>
			<p>Templates use <strong>variables</strong> to insert information from DeskPRO into the email. For example, <code>{{ '{{' }} to_name {{ '}}' }}</code> inserts the email recipient's name.</p>
			
		
			<p>Changes to the header, footer and CSS templates will affect all emails.</p>
			
		</section>
	<section>
		<h2><span>FAQ</span></h2>
		<dl>
			<dt><em>Q:</em>I don't understand the template code. Help!</dt>
			<dd><em>A:</em>
				The template syntax is a mixture of HTML, phrases, variables and special template commands. See the <a href="https://www.deskpro.com/manuals/admin-manual/admin-manual.html#introducing-templates" target="_blank">Introducing Templates</a> section in the manual for an explanation.
			</dd>
			
			<dt><em>Q:</em>How can I learn all the details of the template syntax?</dt>
				<dd><em>A:</em>
					The syntax used is Twig by Sensio Labs. See their <a href="http://twig.sensiolabs.org/doc/templates.html" target="_blank">online documentation</a> for more details. 
				</dd>
			<dt><em>Q:</em>I want to send a different new ticket auto-response, depending on the department.</dt>
		<dd><em>A:</em>
			You can create a custom template, based on the default template code, and change the relevant <strong>Department Trigger</strong> to use your new template.
		</dd>
		
			<dt><em>Q:</em>I want to send a custom email message when a trigger runs.</dt>
		<dd><em>A:</em>
			Create a custom template, then specify it in the trigger action that sends the email. 
		</dd>
		
			<dt><em>Q:</em>My name and direct email are included when I use the <strong>Forward Message</strong> feature to forward a message out of the helpdesk. Can I edit a template to remove this?</dt>
			<dd><em>A:</em>
				The <strong>Forward Message</strong> feature is designed to start an email thread "off helpdesk", so the recipient needs to know your name and email address.
			</dd>
		</dl>
</section>
