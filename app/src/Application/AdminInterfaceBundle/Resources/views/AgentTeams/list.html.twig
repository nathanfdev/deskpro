{% extends 'AdminInterfaceBundle:Layout:list.html.twig' %}
{% block listpane_content %}
	<section class="dp-paneblock dp-listpane">
		<header>
			<nav>
				{% include 'AdminInterfaceBundle:Layout:standard-settings-menu.html.twig' %}
			</nav>
			<h3>Agent Teams</h3>
		</header>
		<article>
			<ul class="dp-item-list" dp-list-autoload>
				<li ng-repeat="team in ListCtrl.teams" dp-state-mark="agents.teams.edit.{{ ng_var('team.id') }}">
					<a href="{{ ng_href('agents.teams.edit', '{id: team.id}') }}">
						<h4>
							<span class="title-id" title="ID">#{{ ng_var('team.id') }}</span>
							<span class="title-text">{{ ng_var('team.name') }}</span>
						</h4>
					</a>
				</li>
			</ul>
			<div class="dp-add-control">
				<a class="btn btn-default" href="{{ ng_href('agents.teams.create') }}">
					<i class="fa fa-plus"></i>
					{{ phrase('agent.general.add') }}
				</a>
			</div>
		</article>
	</section>
{% endblock %}
{% block listpane_help %}
	<header>
		<h1>Agent teams allow tickets and tasks to be assigned to groups of agents.</h1>
		<p>
			Assigning a ticket to a team brings it to the attention of all the members of that team.
		</p>
	</header>
	<article>
		<section>
			<p>Teams usually consist of agents who work closely together and all handle the same kind of ticket (e.g. first-line support team, developers, agents who handle VIP accounts). An agent can be a member of more than one team.</p>
			<p>When a ticket is assigned to one of an agent's teams, it will be shown in the <strong>My Teams' Tickets</strong> filter in the agent interface.</p>
			<p>Note that assigning a ticket to an agent's team has the same effect in terms of permissions as if the ticket was directly assigned to the agent.</p>
	
		</section>

		<section>
			<h2><span>FAQ</span></h2>
			<dl>
				<dt><em>Q:</em> How can I make it so that teams can't see each other's tickets?</dt>
				<dd><em>A:</em> If you need to limit who can view tickets, you should use <strong>departments</strong>. Teams are about assignment, whereas departments are used for access control and organizing the helpdesk.</dd>
	
					<dt><em>Q:</em> What is an agent's <b>primary team</b>?</dt>
				<dd><em>A:</em> You can use a trigger (or another automatic action) to assign a ticket to an agent's team. If the agent has more than one team, the primary team is the one that will be used.</dd>
	
	
	
	
				<dt><em>Q:</em> What is a team avatar?</dt>
				<dd><em>A:</em> A team avatar is an icon used to represent the team in the agent interface. It makes it easier to spot which team a ticket is assigned to.</dd>
				
				
				
				
			</dl>
		</section>

		<section class="related-content">
			<h2><span>Related Content</span></h2>
			<ul>

				<li><i class="fa fa-book"></i> <a href="https://www.deskpro.com/manuals/admin-manual/admin-manual.html#set-up-teams" target="_blank">Set up teams</a></li>
				
				<li><i class="fa fa-file-text"></i> <a href="https://support.deskpro.com/kb/articles/185" target="_blank">Ticket assignment workflows</a></li>
				
				<li><i class="fa fa-file-text"></i> <a href="https://support.deskpro.com/kb/articles/203" target="_blank">How do I set up DeskPRO to have two teams of agents who can't see each other's tickets?</a></li>
				
				
				
			</ul>
		</section>
	</article>
{% endblock %}