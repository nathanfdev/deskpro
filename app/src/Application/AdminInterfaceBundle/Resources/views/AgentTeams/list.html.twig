{% extends 'AdminInterfaceBundle:Layout:list.html.twig' %}
{% block listpane_content %}
	<section class="dp-paneblock dp-listpane">
		<header>
			<h3>Agent Teams</h3>
		</header>
		<article>
			<ul class="dp-item-list">
				<li ng-repeat="team in ListCtrl.teams" dp-state-mark="agents.teams.edit.{{ ng_var('team.id') }}">
					<a href="{{ ng_href('agents.teams.edit', '{id: team.id}') }}">
						<h4>
							<span class="title-text">{{ ng_var('team.name') }}</span>
						</h4>
					</a>
				</li>
			</ul>
			<div class="dp-add-control">
				<a class="btn btn-default" href="{{ ng_href('agents.teams.create') }}">
					<i class="fa fa-plus"></i>
					{{ phrase('agent.general.add') }}
				</a>
			</div>
		</article>
	</section>
{% endblock %}
{% block listpane_help %}
	{% include 'AdminInterfaceBundle:UserGroups:help-page.html.twig' %}
{% endblock %}