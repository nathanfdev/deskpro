{% extends 'AdminInterfaceBundle:Layout:fullpage-pane.html.twig' %}

{% block fullpane_content %}

	<section class="dp-paneblock dp-listpane">
		<header>
			<h3>Scheduled Tasks</h3>
		</header>

		{##################################################################################################}

		<article class="padd">
			<table class="table table-bordered">
				<thead>
					<tr>
						<th>
							{{ phrase('admin.logs.task') }}
						</th>
						<th>
							{{ phrase('admin.logs.interval') }}
						</th>
						<th>
							Last Run
						</th>
						<th>
							Last Complete
						</th>
						<th>
							{{ phrase('admin.logs.next_run') }}
						</th>
					</tr>
				</thead>
				<tbody>
					<tr ng-repeat="job in ListCtrl.server_cron.jobs">
						<td class="alt dp-id-col">
							{{ ng_var('job.title') }}
						</td>
						<td>
							{{ ng_var('job.interval_readable') }}
						</td>
						<td>
							<span ng-if="job.last_start_date_ts">
								{{ ng_var('job.last_start_date_ts_ms | date: \'EEEE, MMMM d,y h:mm a\'') }}
							</span>
							<span ng-if="!job.last_start_date_ts">
								{{ phrase('agent.general.never') }}
							</span>
						</td>
						<td>
							<span ng-if="job.last_run_date_ts">
								{{ ng_var('job.last_run_date_ts_ms | date: \'EEEE, MMMM d,y h:mm a\'') }}
							</span>
							<span ng-if="!job.last_run_date_ts">
								{{ phrase('agent.general.never') }}
							</span>
						</td>
						<td>
							{{ ng_var('job.next_run_time') }}
						</td>
					</tr>
				</tbody>
			</table>
		</article>

	</section>

{% endblock %}