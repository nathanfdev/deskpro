<div class="pane">
	<header class="pane-header">
		<h3 ng-if="FeedbackStatusesEdit.feedback_status.id">
			<i class="icon-ticket"></i> {{ phrase('adm.general.apps_portal') }} &rarr; {{ phrase('agent.general.feedback') }} &rarr; {{ phrase('agent.general.statuses') }} &rarr;  <em>{{ ng_var('FeedbackStatusesEdit.feedback_status.title') }}</em>
		</h3>
	</header>
	<article class="pane-content no-pad">
		<form class="form-horizontal dp-form" role="form" name="form_props" ng-submit="FeedbackStatusesEdit.saveFeedbackStatus()">
			<div class="panel panel-fill indent">
				<br/>

				<div class="panel-body">
					<div class="form-group">
						<div class="col-lg-3">
							<h3>{{ phrase('adm.feedback_statuses.title') }} *</h3>
						</div>
						<div class="col-lg-9">
							<div class="inner-group" dp-error-class="form_props.title">
								<input
										type="text"
										class="form-control"
										name="title"
										ng-model="FeedbackStatusesEdit.feedback_status.title"
										dp-server-validation="feedback_status.title.min_length"
										style="width: 50%;" required autofocus>
								<span class="help-block">
									{{ phrase('adm.feedback_statuses.title_explain') }}
								</span>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="inner-footer">
				<div class="text-danger ng-hide" ng-show="form_props.$attempted && form_props.$invalid">
					<p><strong>{{ phrase('adm.general.please_correct_errors') }}</strong></p>
					<ul>
						<li ng-show="form_props.title.$error.required">{{ phrase('adm.feedback_statuses.title_error') }}</li>
						<li ng-show="form_props.title.$error.feedback_status_title_min_length">Title can't be less than 2 symbols</li>
					</ul>
				</div>

				<div class="text-center" ng-hide="form_props.$attempted && form_props.$invalid">
					<div dp-hide-spinning="saving_feedback_status">
						<button class="btn btn-primary" dp-submit-form>{{ phrase('agent.general.save') }}</button>
						<button class="btn btn-default" ng-click="FeedbackStatusesEdit.resetForm()">{{ phrase('agent.general.reset') }}</button>
					</div>
					<div dp-show-spinning="saving_feedback_status">
						<i class="spinner-flat"></i>
					</div>
				</div>
			</div>
		</form>
	</article>

	<div dp-register-message="saved_feedback_status">{{ ng_var('FeedbackStatusesEdit.feedback_status.title') }} was saved successfully</div>
</div>