{% extends 'AdminInterfaceBundle:Layout:list.html.twig' %}
{% block listpane_content %}
	<section class="dp-paneblock dp-listpane">
		<header>
			<h3>Website Embeds</h3>
		</header>
		<article>
			<ul class="dp-item-list">
				<li dp-state-mark="type:portal.embeds.type.tab">
					<a href="{{ ng_href('portal.embeds.type', '{type:"tab"}') }}" dp-list-autoload>
						<h4><span class="title-text">Website Button</span></h4>
					</a>
				</li>
				<li dp-state-mark="type:portal.embeds.type.chat">
					<a href="{{ ng_href('portal.embeds.type', '{type:"chat"}') }}" dp-list-autoload>
						<h4><span class="title-text">Chat Button</span></h4>
					</a>
				</li>
				<li dp-state-mark="type:portal.embeds.type.form">
					<a href="{{ ng_href('portal.embeds.type', '{type:"form"}') }}" dp-list-autoload>
						<h4><span class="title-text">Contact Form</span></h4>
					</a>
				</li>
				<li dp-state-mark="type:portal.embeds.type.helpdesk">
					<a href="{{ ng_href('portal.embeds.type', '{type:"helpdesk"}') }}" dp-list-autoload>
						<h4><span class="title-text">Entire Helpdesk</span></h4>
					</a>
				</li>
			</ul>
		</article>
	</section>

{% endblock %}
{% block listpane_help %}
	<header>
		<h1>Embed DeskPRO in your website</h1>
		<p>Use these code snippets to add portal functions to your site, or embed the whole portal.</p>
	</header>
		<article>
		<section>
			<p>When you change your helpdesk content, the embedded 
			version will automatically update.</p>
			<p>These snippets require your site to allow Javascript. They will work with the vast majority of web hosting, but may not be compatible with some 'easy website builder' services.</p>
	
		</section>


		<section class="related-content">
			<h2><span>Related Content</span></h2>
			<ul>
				<li>
				<i class="fa fa-book"></i> <a href="https://www.deskpro.com/manuals/admin-manual/admin-manual.html#website-integration" target="_blank">Website integration</a>
				</li>	
				<li>
				<i class="fa fa-file-text"></i> <a href="https://support.deskpro.com/kb/articles/257" target="_blank">Adding an embedded contact form to your website</a>
				</li>	
				<li>
				<i class="fa fa-file-text"></i> <a href="https://support.deskpro.com/kb/articles/235" target="_blank">Removing chat from the portal while offering chat on a different site</a>
				</li>
				<i class="fa fa-file-text"></i> <a href="https://support.deskpro.com/kb/articles/146" target="_blank">Set language in the chat widget</a>
				</li>
				<i class="fa fa-file-text"></i> <a href="https://support.deskpro.com/kb/articles/160" target="_blank">Using a custom button with the chat widget</a>
				</li>
			</ul>
		</section>
</article>
{% endblock %}