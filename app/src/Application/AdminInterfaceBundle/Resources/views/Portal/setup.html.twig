{% extends 'AdminInterfaceBundle:Layout:fullpage-pane.html.twig' %}
{% block fullpane_content %}
<div class="content-wrapper">
    <section class="content setup">

        <h1><i class="fa fa-cog"></i> Portal Setup</h1>

        <form>
            {##########################################################################################################}
            {# WEBSITE #}
            {##########################################################################################################}

            <div class="content-section">
                <h2 class="with-divider form-header"><span>Website Settings</span></h2>

                <div class="row">
                    <div class="bucket-third">
                        <div class="inline-input">
                            <label>Website name:</label>
                            <input type="text" placeholder="Website name" ng-model="Ctrl.settings.site_name" />
                        </div>
                    </div>

                    <div class="bucket-two-thirds">
                        <div class="form-text">
                            <p>This is the name of your main website.</p>
                        </div>
                    </div>
                </div>


                <div class="row">
                    <div class="bucket-third">
                        <div class="inline-input">
                            <label>Website URL:</label>
                            <input type="text" placeholder="Website title" ng-model="Ctrl.settings.site_url" />
                        </div>
                    </div>

                    <div class="bucket-two-thirds">
                        <div class="form-text">
                            <p>This is the URL to your main website.</p>
                        </div>
                    </div>
                </div>
            </div><!-- End .content-section -->

            {##########################################################################################################}
            {# HELPDESK #}
            {##########################################################################################################}

            <div class="content-section">
                <h2 class="with-divider form-header"><span>Helpdesk Settings</span></h2>

                <div class="row">
                    <div class="bucket-third">
                        <div class="inline-input">
                            <label>Helpdesk name:</label>
                            <input type="text" placeholder="Helpdesk title" ng-model="Ctrl.settings.deskpro_name" />
                        </div>
                    </div>

                    <div class="bucket-two-thirds">
                        <div class="form-text">
                            <p>This is the name of your helpdesk..</p>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="bucket-third">
                        <div class="inline-input">
                            <label>Helpdesk URL:</label>
                            <input type="text" placeholder="Helpdesk URL" ng-model="Ctrl.settings.deskpro_url" />
                        </div>
                    </div>

                    <div class="bucket-two-thirds">
                        <div class="form-text">
                            <p>This is the URL to your helpdesk.</p>
                        </div>
                    </div>
                </div>

            </div><!-- End .content-section -->

            {##########################################################################################################}
            {# PORTAL MODE #}
            {##########################################################################################################}

            <div class="content-section">
                <h2 class="with-divider"><span>Portal Mode</span></h2>

                <div class="select-portal-mode">
                    <span class="or"><span class="text">or</span></span>

                    <a ng-class="{'selected': Ctrl.settings.portal_mode == 'publish'}" ng-click="Ctrl.setPortalMode('publish')" style="width: 320px;">
                        <span class="title"><span class="icon" ng-show="Ctrl.settings.portal_mode == 'publish'"><i class="fa fa-check"></i></span>Ticket &amp; publish mode</span>
                        <p>Enable content publishing features (articles, news and downloads).</p>
                    </a>

                    <a ng-class="{'selected': Ctrl.settings.portal_mode == 'tickets'}" ng-click="Ctrl.setPortalMode('tickets')" style="width: 320px;">
                        <span class="title"><span class="icon" ng-show="Ctrl.settings.portal_mode == 'tickets'"><i class="fa fa-check"></i></span>Tickets-only mode</span>
                        <p>Only enable tickets.<br/>No other features.</p>
                    </a>
                </div>
            </div><!-- End .content-section -->


            {##########################################################################################################}
            {# APPS #}
            {##########################################################################################################}

            <div class="content-section" ng-show="Ctrl.settings.portal_mode == 'publish'">
                <h2 class="with-divider"><span>Publish Apps</span></h2>

                <div class="apps-list">

                    <div class="col-half">
                        <div ng-class="{'widget-preview': Ctrl.settings.apps_kb, 'widget-preview-disabled': !Ctrl.settings.apps_kb}">
                            <div class="widget-header">
                                <button dp-onoff-switch onoff-class="publish-on-off" ng-model="Ctrl.settings.apps_kb" />
                                <span class="title">Knowledgebase</span>
                                <a class="control">Manage <i class="fa fa-cog"></i></a>
                            </div>
                            <div class="widget-image">
                                <img src="{{ asset('app/Interface/Resources/img/widget-preview-kb.png') }}" alt="Widget Preview: Knowledgebase">
                            </div>

                            <div class="form-text">
                                <p>A news app lorel ipsum dolor sit amet ipsum. This is the text info for an app lorel ipsum dolor. A news app lorel ipsum dolor sit amet ipsum.</p>
                            </div>
                        </div>

                    </div>

                    <div class="col-half omega">
                        <div ng-class="{'widget-preview': Ctrl.settings.apps_downloads, 'widget-preview-disabled': !Ctrl.settings.apps_downloads}">
                            <div class="widget-header">
                                <button dp-onoff-switch onoff-class="publish-on-off" ng-model="Ctrl.settings.apps_downloads" />
                                <span class="title">Downloads</span>
                                <a class="control">Manage  <i class="fa fa-cog"></i></a>
                            </div>
                            <div class="widget-image">
                                <img src="{{ asset('app/Interface/Resources/img/widget-preview-downloads.png') }}" alt="Widget Preview: Knowledgebase">
                            </div>

                            <div class="form-text">
                                <p>A news app lorel ipsum dolor sit amet ipsum. This is the text info for an app lorel ipsum dolor. A news app lorel ipsum dolor sit amet ipsum.</p>
                            </div>
                        </div>
                    </div>



                    <div class="col-half">
                        <div ng-class="{'widget-preview': Ctrl.settings.apps_news, 'widget-preview-disabled': !Ctrl.settings.apps_news}">
                            <div class="widget-header">
                                <button dp-onoff-switch onoff-class="publish-on-off" ng-model="Ctrl.settings.apps_news" />
                                <span class="title">News</span>
                                <a class="control">Manage  <i class="fa fa-cog"></i></a>
                            </div>
                            <div class="widget-image">
                                <img src="{{ asset('app/Interface/Resources/img/widget-preview-news.png') }}" alt="Widget Preview: Knowledgebase">
                            </div>

                            <div class="form-text">
                                <p>A news app lorel ipsum dolor sit amet ipsum. This is the text info for an app lorel ipsum dolor. A news app lorel ipsum dolor sit amet ipsum.</p>
                            </div>
                        </div>

                    </div>

                    <div class="col-half omega">
                        <div ng-class="{'widget-preview': Ctrl.settings.apps_feedback, 'widget-preview-disabled': !Ctrl.settings.apps_feedback}">
                            <div class="widget-header">
                                <button dp-onoff-switch onoff-class="publish-on-off" ng-model="Ctrl.settings.apps_feedback" />
                                <span class="title">Feedback</span>
                                <a class="control">Manage  <i class="fa fa-cog"></i></a>
                            </div>
                            <div class="widget-image">
                                <img src="{{ asset('app/Interface/Resources/img/widget-preview-feedback.png') }}" alt="Widget Preview: Knowledgebase">
                            </div>

                            <div class="form-text">
                                <p>A news app lorel ipsum dolor sit amet ipsum. This is the text info for an app lorel ipsum dolor. A news app lorel ipsum dolor sit amet ipsum.</p>
                            </div>
                        </div>
                    </div>


                </div>

            </div><!-- End .content-section -->

            {##########################################################################################################}
            {# INTERFACES #}
            {##########################################################################################################}

            <div class="content-section">
                <h2 class="with-divider"><span>User Interfaces</span></h2>

                <div class="apps-list">
                    <div class="row">
                        <div class="col-half">
                            <div class="widget-preview">
                                <div class="widget-header">
                                    <button dp-onoff-switch onoff-class="publish-on-off" ng-model="Ctrl.settings.iface_portal" />
                                    </a>
                                    <span class="title">Portal</span>
                                    <a class="control">Manage  <i class="fa fa-cog"></i></a>
                                </div>
                                <div class="widget-image">
                                    <img src="{{ asset('app/Interface/Resources/img/widget-preview-portal.png') }}" alt="Widget Preview: Knowledgebase">
                                </div>
                            </div>

                        </div>

                        <div class="col-half">
                            <div class="form-text">
                                <p>A news app lorel ipsum dolor sit amet ipsum. This is the text info for an app lorel ipsum dolor. A news app lorel ipsum dolor sit amet ipsum.</p>
                            </div>
                        </div>
                    </div>


                    <div class="row">
                        <div class="col-half">
                            <div class="widget-preview">
                                <div class="widget-header">
                                    <button dp-onoff-switch onoff-class="publish-on-off" ng-model="Ctrl.settings.iface_widget" />
                                    <span class="title">Widget</span>
                                    <a class="control">Manage  <i class="fa fa-cog"></i></a>
                                </div>
                                <div class="widget-image">
                                    <img src="{{ asset('app/Interface/Resources/img/widget-preview-widget.png') }}" alt="Widget Preview: Knowledgebase">
                                </div>
                            </div>

                        </div>

                        <div class="col-half">
                            <div class="form-text">
                                <p>A news app lorel ipsum dolor sit amet ipsum. This is the text info for an app lorel ipsum dolor. A news app lorel ipsum dolor sit amet ipsum.</p>
                            </div>
                        </div>
                    </div>

                </div><!-- End .apps-list -->

            </div><!-- End .content-section -->

            {##########################################################################################################}

            <div class="form-footer">
                <hr>
                <div dp-hide-spinning="saving">
                    <button type="submit" ng-click="Ctrl.saveSettings()">Save Settings</button>
                </div>
                <div dp-show-spinning="saving">
                    <i class="spinner-flat"></i>
                </div>
            </div>

        </form>
    </section>
</div><!-- End content wrapper -->
{% endblock %}