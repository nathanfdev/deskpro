{% extends 'AdminInterfaceBundle:Layout:fullpage-pane.html.twig' %}
{% block fullpane_content %}
<div class="content-wrapper">
    <section class="content editor" style="font-family: Lato, helvetica, verdana, sans-serif;">

        <div class="editor-panel">

            <div class="panel-wrapper">
                <div class="current-theme-actions">
                    <a href ng-click="Portal.save()" class="save-changes">Preview Changes</a>
                    <a href ng-click="Portal.discard()" class="discard-changes">Discard Changes</a>
                    <a href ng-click="Portal.commit()" class="save-changes">Save Changes</a>
                </div>

                <a href="#" class="current-theme">
                    <span class="preview-icon"></span>
                    <span class="theme-tag">Theme:</span> <span class="theme-title">An Excellent Theme</span>
                    <span class="dropdown-icon"><i class="fa fa-sort"></i></span>
                </a>

                <!-- Variables settings -->

                <div ng-repeat="(group, variables) in Portal.groups">
                    <div class="panel-title">
                        <a ng-click="Portal.togglePanel(group)">
                            <span ng-bind="Portal.label(group)"></span>
                            <i class="fa fa-caret-right" ng-show="!Portal.isOpen(group)"></i>
                            <i class="fa fa-caret-down" ng-show="Portal.isOpen(group)"></i>
                        </a>
                    </div>
                    <div>
                        <div class="color-scheme font-options" ng-show="Portal.isOpen(group)">
                            <div ng-repeat="variable in variables" ng-init="variable.label = Portal.label(variable.name)">
                                <dp-portal-designer-variable-form
                                    variable="variable"
                                    values="Portal.values">
                                </dp-portal-designer-variable-form>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- End of variables settings -->

                <div class="panel-title">
                    <a ng-click="Portal.togglePanel('logo')">
                        Logo
                        <i class="fa fa-caret-down" ng-show="!Portal.isOpen('logo')"></i>
                        <i class="fa fa-caret-down" ng-show="Portal.isOpen('logo')"></i>
                    </a>
                </div>

                <div class="logo-options" ng-show="Portal.isOpen('logo')">

                    <div class="logo-box logo-size-desktop"><!-- overall box -->

                        <!-- The upload file link -->
                        <a href="#" class="upload-logo"><span class="icon-box"><i class="fa fa-upload"></i></span> <span>Website Logo</span></a>

                        <div class="bucket"><!-- The border around the logo box -->

                            <!-- The white box -->
                            <div class="logo-container">
                                <img src="./img/sample-logo.png">
                            </div>

                        </div>
                    </div>

                    <div class="logo-box logo-size-mobile">
                        <a href="#" class="upload-logo"><span class="icon-box"><i class="fa fa-upload"></i></span> <span>Mobile</span></a>

                        <div class="bucket">
                            <div class="logo-container">
                                <img src="./img/sample-logo.png">
                            </div>
                        </div>
                    </div>

                    <div class="logo-box logo-size-favicon">
                        <a href="#" class="upload-logo"><span class="icon-box"><i class="fa fa-upload"></i></span> <span>Mobile</span></a>

                        <div class="bucket">
                            <div class="logo-container">
                                <img src="./img/sample-logo.png">
                            </div>
                        </div>
                    </div>

                </div>


                <div class="panel-title">
                    <a ng-click="Portal.togglePanel('site_copy')">
                        Site Copy
                        <i class="fa fa-caret-down" ng-show="!Portal.isOpen('site_copy')"></i>
                        <i class="fa fa-caret-down" ng-show="Portal.isOpen('site_copy')"></i>
                    </a>
                </div>

                <div class="site-text" ng-show="Portal.isOpen('site_copy')">
                    <form>
                        <input type="text" placeholder="Sample input text">
                        <textarea placeholder="Add a welcome message"></textarea>
                        <div class="footer">
                            <input type="submit" value="Preview Welcome Message">
                        </div>
                    </form>
                </div>



                <div class="panel-title">
                    <a ng-click="Portal.togglePanel('advanced')">
                        Advanced Edit
                        <i class="fa fa-caret-down" ng-show="!Portal.isOpen('advanced')"></i>
                        <i class="fa fa-caret-down" ng-show="Portal.isOpen('advanced')"></i>
                    </a>
                </div>

                <div class="code-editor" ng-show="Portal.isOpen('advanced')">
                    <nav>
                        <ul>
                            <li><a href="#">Header</a>
                            </li><li>
                                <a href="#">Footer</a>
                            </li><li class="active">
                                <a href="#">CSS</a>
                            </li><li>
                                <a href="#">Javascript</a>
                            </li><li>
                                <a href="#">Assets</a>
                            </li>
                        </ul>
                    </nav>

                    <div class="the-code">
                  <pre>                    <span class="line-number">101</span>&lt;article class="news kb-article kb-article-news"&gt;
                    <br><span class="line-number">102</span>  &lt;header&gt;
                    <br><span class="line-number">103</span>    &lt;div class="calendar-decoration"&gt;&lt;span class="month"&gt;Mar&lt;/span&gt;&lt;hr&gt;&lt;span class="day"&gt;27&lt;/span&gt;&lt;/div&gt;
                    <br><span class="line-number">104</span>    &lt;h1&gt;&lt;a href="#"&gt;New Feature: Interactive API Browser&lt;/a&gt;&lt;/h1&gt;
                    <br><span class="line-number">105</span>    &lt;div class="article-meta"&gt;
                    <br><span class="line-number">106</span>      Posted by
                    <br><span class="line-number">107</span>      &lt;span style="background: url(./img/avatar.png) no-repeat; background-size: cover" class="agent-avatar agent-avatar-mini"&gt;&lt;/span&gt;
                    <br><span class="line-number">108</span>      Ben Henley 2 days ago, in category: &lt;a href="#"&gt;Product &lt;i class="fa fa-caret-down"&gt;&lt;/a&gt;&lt;/i&gt;
                  </pre>
                    </div>
                </div>



                <div class="panel-title">
                    <a ng-click="Portal.togglePanel('advanced')">
                        (sample) Advanced Edit
                        <i class="fa fa-caret-down" ng-show="!Portal.isOpen('advanced')"></i>
                        <i class="fa fa-caret-down" ng-show="Portal.isOpen('advanced')"></i>
                    </a>
                </div>

                <div class="code-editor code-editor-extended" ng-show="Portal.isOpen('advanced')">
                    <a href="#" class="full-screen-link">Full Screen Editor <span class="icon"><i class="fa fa-expand"></i></span></a>
                    <nav>
                        <ul>
                            <li><a href="#">Header</a>
                            </li><li>
                                <a href="#">Footer</a>
                            </li><li class="active">
                                <a href="#">CSS</a>
                            </li><li>
                                <a href="#">Javascript</a>
                            </li><li>
                                <a href="#">Assets</a>
                            </li>
                        </ul>
                    </nav>

                    <div class="the-code">
                  <pre>                    <span class="line-number">101</span>&lt;article class="news kb-article kb-article-news"&gt;
                    <br><span class="line-number">102</span>  &lt;header&gt;
                    <br><span class="line-number">103</span>    &lt;div class="calendar-decoration"&gt;&lt;span class="month"&gt;Mar&lt;/span&gt;&lt;hr&gt;&lt;span class="day"&gt;27&lt;/span&gt;&lt;/div&gt;
                    <br><span class="line-number">104</span>    &lt;h1&gt;&lt;a href="#"&gt;New Feature: Interactive API Browser&lt;/a&gt;&lt;/h1&gt;
                    <br><span class="line-number">105</span>    &lt;div class="article-meta"&gt;
                    <br><span class="line-number">106</span>      Posted by
                    <br><span class="line-number">107</span>      &lt;span style="background: url(./img/avatar.png) no-repeat; background-size: cover" class="agent-avatar agent-avatar-mini"&gt;&lt;/span&gt;
                    <br><span class="line-number">108</span>      Ben Henley 2 days ago, in category: &lt;a href="#"&gt;Product &lt;i class="fa fa-caret-down"&gt;&lt;/a&gt;&lt;/i&gt;
                  </pre>
                    </div>

                    <div class="editor-footer">
                        <a href="#" class="button blank-button">Cancel &amp; Discard Changes</a> <a href="#" class="button">Preview Changes</a>
                    </div>
                </div>



                <div class="panel-title">
                    <a ng-click="Portal.togglePanel('advanced')">
                        (sample) Advanced Edit
                        <i class="fa fa-caret-down" ng-show="!Portal.isOpen('advanced')"></i>
                        <i class="fa fa-caret-down" ng-show="Portal.isOpen('advanced')"></i>
                    </a>
                </div>

                <div class="code-editor code-editor-extended" ng-show="Portal.isOpen('advanced')">
                    <a href="#" class="full-screen-link">Full Screen Editor <span class="icon"><i class="fa fa-expand"></i></span></a>
                    <nav>
                        <ul>
                            <li><a href="#">Header</a>
                            </li><li>
                                <a href="#">Footer</a>
                            </li><li>
                                <a href="#">CSS</a>
                            </li><li>
                                <a href="#">Javascript</a>
                            </li><li class="active">
                                <a href="#">Assets</a>
                            </li>
                        </ul>
                    </nav>

                    <div class="the-assets">
                        <a href="#" class="drag-and-drop-area">
                    <span><i class="fa fa-upload"></i> Drag &amp; Drop here or just click to upload a new file
                  </span></a>

                        <div class="file-list">
                            <ul>
                                <li>
                                    <a href="#" class="file"><span class="file-preview" style="background-image: url(./img/file-preview.png);"></span> file_name.png</a>
                                    <a href="#" class="file-url-copy">Copy file url</a>
                                </li>

                                <li>
                                    <a href="#" class="file"><span class="file-preview" style="background-image: url(./img/file-preview.png);"></span> uploaded_file_28474722.png</a>
                                    <a href="#" class="file-url-copy">Copy file url</a>
                                </li>

                                <li>
                                    <a href="#" class="file"><span class="file-preview" style="background-image: url(./img/file-preview.png);"></span> another_uploaded_file_34346643.png</a>
                                    <a href="#" class="file-url-copy">Copy file url</a>
                                </li>

                                <li>
                                    <a href="#" class="file"><span class="file-preview" style="background-image: url(./img/file-preview.png);"></span> file_name.png</a>
                                    <a href="#" class="file-url-copy">Copy file url</a>
                                </li>

                                <li>
                                    <a href="#" class="file"><span class="file-preview" style="background-image: url(./img/file-preview.png);"></span> uploaded_file_28474722.png</a>
                                    <a href="#" class="file-url-copy">Copy file url</a>
                                </li>

                                <li>
                                    <a href="#" class="file"><span class="file-preview" style="background-image: url(./img/file-preview.png);"></span> another_uploaded_file_34346643.png</a>
                                    <a href="#" class="file-url-copy">Copy file url</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>



                <div class="panel-title">
                    <a ng-click="Portal.togglePanel('expert')">
                        Expert
                        <i class="fa fa-caret-down" ng-show="!Portal.isOpen('expert')"></i>
                        <i class="fa fa-caret-down" ng-show="Portal.isOpen('expert')"></i>
                    </a>
                </div>

                <div class="template-picker" ng-show="Portal.isOpen('expert')">
                    <a href="#" class="select">
                        <span class="title-tag">View template:</span> Home Page
                        <span class="dropdown-icon"><i class="fa fa-sort"></i></span>
                    </a>
                </div>

            </div><!-- End panel wrapper -->

        </div><!-- End editor panel -->

        <section class="preview-panel">
            <iframe ng-if="!Portal.recompiling" ng-src="{{ '{{ Portal.preview_url }}' }}" width="100%" height="100%"></iframe>
            <div ng-if="Portal.recompiling">Recompiling assets...</div>

            <div class="widescreen-info">
                The editor works better on screens over 1280 pixels. Something about full screen and hiding the sidebar
            </div>

            <div class="preview-tools">
                <ul>
                    <li>
                        <a href="#">
                            Preview as <span>a logged in user</span> <i class="fa fa-user"></i> <i class="fa fa-caret-down"></i>
                        </a>

                        <ul>
                            <li><a href="#" class="active"><i class="fa fa-check"></i> Logged in user</a></li>
                            <li><a href="#"><i class="fa fa-users"></i> Logged out visitor</a></li>
                            <li><a href="#"><i class="fa fa-user"></i>Agent</a></li>
                            <li><a href="#"><i class="fa fa-user"></i>Administrator</a></li>
                        </ul>
                    </li>
                    <li>
                        <a href="#">
                            visiting with a <span>tablet</span> <i class="fa fa-tablet"></i> <i class="fa fa-caret-down"></i>
                        </a>
                    </li>
                </ul>
            </div>
        </section>
    </section>
</div>
{% endblock %}
