<a href="#" class="color-preview">
    <spectrum-colorpicker
        ng-model="values[variable.name]"
        format="'hex'"
        on-show-options="{update: false}"
        on-hide-options="{update: false}"
        on-move-options="{update: false}"
    ></spectrum-colorpicker>
    <span class="color-title" ng-bind="variable.label"></span>
</a>
