{% extends 'AdminInterfaceBundle:Layout:fullpage-pane.html.twig' %}
{% block fullpane_content %}
<div class="content-wrapper">
    <section class="content setup widget-editor">
        <h1><i class="fa fa-cog"></i> Site Widget & Chat</h1>
        <form class="widget-editor-form">
            <div class="content-section">
                <h2 class="with-divider form-header"><span>Button Settings</span></h2>
                <ul class="options">
                    <li>
                        <label class="option-label">Button size:</label>
                        <div class="option-group">
                            <select ng-model="chat_options.button.size">
                                <option value="small">S</option>
                                <option value="medium">M</option>
                                <option value="large">L</option>
                            </select>
                        </div>
                    </li>
                    <li>
                        <label class="option-label">Button word:</label>
                        <div class="option-group">
                            <input type="text" ng-model="chat_options.button.name" />
                        </div>
                    </li>
                    <li>
                        <label class="option-label">Colors:</label>
                        <div class="option-group">
                            <ul class="option-group-row">
                                <li>
                                    <spectrum-colorpicker
                                        ng-model="chat_options.button.backgroundColor"
                                        format="'hex'"
                                        class="color-picker"
                                        on-show-options="{update: false}"
                                        on-hide-options="{update: false}"
                                        on-move-options="{update: false}"
                                        ></spectrum-colorpicker>

                                    <label>Background Color</label>
                                </li>
                                <li>
                                    <spectrum-colorpicker
                                        ng-model="chat_options.button.textColor"
                                        format="'hex'"
                                        class="color-picker"
                                        on-show-options="{update: false}"
                                        on-hide-options="{update: false}"
                                        on-move-options="{update: false}"
                                        ></spectrum-colorpicker>

                                    <label>Text Color</label>
                                </li>
                                <li>
                                    <spectrum-colorpicker
                                        ng-model="chat_options.button.borderColor"
                                        format="'hex'"
                                        class="color-picker"
                                        on-show-options="{update: false}"
                                        on-hide-options="{update: false}"
                                        on-move-options="{update: false}"
                                        ></spectrum-colorpicker>

                                    <label>Border Color</label>
                                </li>
                            </ul>
                        </div>
                    </li>
                    <li>
                        <label class="option-label">Position:</label>
                        <div class="option-group">
                            <ul class="inline">
                                <li>
                                    <input type="radio" ng-model="chat_options.widget.position" value="right" />
                                    <label>Right</label>
                                </li>
                                <li>
                                    <input type="radio" ng-model="chat_options.widget.position" value="left" />
                                    <label>Left</label>
                                </li>
                            </ul>
                        </div>
                    </li>
                    <li>
                        <label class="option-label">Widget Size:</label>
                        <div class="option-group">
                            <ul class="inline">
                                <li>
                                    <input type="radio" ng-model="chat_options.widget.type" value="column" />
                                    <label>Column</label>
                                </li>
                                <li>
                                    <input type="radio" ng-model="chat_options.widget.type" value="bubble" />
                                    <label>Corner</label>
                                </li>
                            </ul>
                        </div>
                    </li>
                </ul>
            </div>

            <div class="content-section">
                <h2 class="with-divider form-header"><span>Chat Settings</span></h2>
                <ul class="options">
                    <li>
                        <button dp-toggle-switch ng-model="chat_options.chat.enabled"></button>
                        <h4><span class="title-text">Enable / Disable Chat</span></h4>
                    </li>
                    <li ng-if="chat_options.chat.enabled">
                        <button dp-toggle-switch ng-model="chat_options.chat.requestUserInfo"></button>
                        <h4><span class="title-text">Request Name/Email before Chat Commences</span></h4>

                        <div class="option-group no-label" ng-if="chat_options.chat.requestUserInfo">
                            <ul class="option-group-row">
                                <li>
                                    <label>Begin chat mode:</label>
                                    <select ng-model="chat_options.chat.beginMode">
                                        <option value="conversation">Conversation Style</option>
                                        <option value="form">Form Style</option>
                                    </select>
                                </li>
                            </ul>
                        </div>
                    </li>
                    <li ng-if="chat_options.chat.enabled">
                        <button dp-toggle-switch ng-model="chat_options.chat.proactive"></button>
                        <h4><span class="title-text">Proactive Chat</span></h4>

                        <ul class="options" ng-if="chat_options.chat.proactive">
                            <li>
                                <label class="option-label">Popup:</label>
                                <div class="option-group">
                                    <ul class="option-group-row">
                                        <li>
                                            <input type="radio" ng-model="chat_options.chat_agent_avatar" value="avatars" />
                                            <label>Agent Avatars</label>
                                        </li>
                                        <li>
                                            <input type="radio" ng-model="chat_options.chat_agent_avatar" value="avatar_message" />
                                            <label>Agent Avatar + Message</label>

                                            <ul class="sub-options" ng-if="chat_options.chat_agent_avatar === 'avatar_message'">
                                                <li>
                                                    <label>Agent Title:</label>
                                                    <input type="text" ng-model="chat_options.chat_agent_title"></textarea>
                                                </li>
                                                <li>
                                                    <label>Agent Message:</label>
                                                    <textarea ng-model="chat_options.chat_agent_icon_message"></textarea>
                                                </li>
                                                <li>
                                                    <label>Reply Form Type:</label>
                                                    <select ng-model="Ctrl.settings.button_size">
                                                        <option value="S">Accept Button</option>
                                                        <option value="M">Reply Form</option>
                                                    </select>
                                                </li>
                                            </ul>
                                        </li>
                                    </ul>
                                </div>
                            </li>
                            <li>
                                <label class="option-label">Waiting timeout:</label>
                                <div class="option-group">
                                    <input type="text" ng-model="chat_options.chat.waitingTimeout" />
                                </div>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>

            <div class="content-section">
                <h2 class="with-divider form-header"><span>Ticket Settings</span></h2>
                <ul class="options">
                    <li>
                        <div class="option-group no-label">
                            <ul class="inline float-left">
                                <li>
                                    <input type="radio" ng-model="chat_options.ticket_department" value="default" />
                                    <label>Default Department</label>

                                    <div class="sub-options">
                                        <select ng-model="chat_options.ticket_department">
                                            <option value="S">S</option>
                                            <option value="M">M</option>
                                            <option value="L">L</option>
                                        </select>
                                    </div>
                                </li>
                                <li>
                                    <input type="radio" ng-model="chat_options.ticket_department" value="select" />
                                    <label>User Selects Department</label>
                                </li>
                            </ul>
                        </div>
                    </li>
                </ul>
            </div>

            <div class="form-footer">
                <hr>
                <div dp-hide-spinning="saving">
                    <button type="submit" ng-click="Ctrl.updateChatCode()">Get Code</button>
                </div>
                <div dp-show-spinning="saving">
                    <i class="spinner-flat"></i>
                </div>
            </div>
        </form>

        <iframe id="live-demo" class="widget-editor-live-demo-container"></iframe>

        <div class="editor-row" ng-if="!!code_snippets.chat">
            <div class="editor-wrap">
                <div
                     style="height: 220px;"
                     ng-model="code_snippets.chat"
                     ui-ace="{
                         mode: 'html',
                         useWrapMode: false,
                         showGutter: false,
                         theme: 'textmate',
                         onLoad: embedEditorLoaded
                     }">

                </div>
            </div>
        </div>

    </section>
</div>
{% endblock %}
