{% extends 'AdminInterfaceBundle:Layout:fullpage-pane.html.twig' %}
{% block fullpane_content %}
<div class="content-wrapper">
    <section class="content setup">

        <h1><i class="fa fa-cog"></i> Site Widget & Chat</h1>

        <form>
            <div class="content-section">
                <h2 class="with-divider form-header"><span>Button Settings</span></h2>

                <div class="row">
                    <div class="bucket-third">
                        <div class="inline-input">
                            <label>Button size:</label>
                            <select ng-model="chat_options.button_size">
                                <option value="small">S</option>
                                <option value="medium">M</option>
                                <option value="large">L</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="bucket-third">
                        <div class="inline-input">
                            <label>Button word:</label>
                            <input type="text" ng-model="chat_options.button_word" />
                        </div>
                    </div>

                    <div class="bucket-two-thirds">
                        <div class="form-text">
                            <p><a href="#">Translate</a></p>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="bucket-third">
                        <div class="inline-input">
                            <label>Colors:</label>
                            <ul class="input-group">
                                <li>
                                    <spectrum-colorpicker
                                        ng-model="chat_options.button_background_color"
                                        format="'hex'"
                                        on-show-options="{update: false}"
                                        on-hide-options="{update: false}"
                                        on-move-options="{update: false}"
                                        ></spectrum-colorpicker>

                                    <label>Background Color</label>
                                </li>
                                <li>
                                    <spectrum-colorpicker
                                        ng-model="chat_options.button_text_color"
                                        format="'hex'"
                                        on-show-options="{update: false}"
                                        on-hide-options="{update: false}"
                                        on-move-options="{update: false}"
                                        ></spectrum-colorpicker>

                                    <label>Text Color</label>
                                </li>
                                <li>
                                    <spectrum-colorpicker
                                        ng-model="chat_options.button_border_color"
                                        format="'hex'"
                                        on-show-options="{update: false}"
                                        on-hide-options="{update: false}"
                                        on-move-options="{update: false}"
                                        ></spectrum-colorpicker>

                                    <label>Border Color</label>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="bucket-third">
                        <div class="inline-input">
                            <label>Position:</label>
                            <ul class="input-group">
                                <li>
                                    <input type="radio" ng-model="chat_options.widget_position" value="right" />
                                    <label>Right</label>
                                </li>
                                <li>
                                    <input type="radio" ng-model="chat_options.widget_position" value="left" />
                                    <label>Left</label>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="bucket-third">
                        <div class="inline-input">
                            <label>Widget Size:</label>
                            <ul class="input-group">
                                <li>
                                    <input type="radio" ng-model="chat_options.widget_type" value="column" />
                                    <label>Column</label>
                                </li>
                                <li>
                                    <input type="radio" ng-model="chat_options.widget_type" value="bubble" />
                                    <label>Corner</label>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-section">
                <h2 class="with-divider form-header"><span>Chat Settings</span></h2>

                <article>
                    <div class="panel panel-innertable">
                        <div class="form-group">
                            <button dp-toggle-switch ng-model="chat_options.chat_enabled"></button>
                            <h4><span class="title-text">Enable / Disable Chat</span></h4>
                        </div>
                    </div>
                </article>

                <article>
                    <div class="panel panel-innertable">
                        <div class="form-group">
                            <button dp-toggle-switch ng-model="chat_options.chat_request_user_info"></button>
                            <h4><span class="title-text">Request Name/Email before Chat Commences</span></h4>
                        </div>
                    </div>
                </article>

                <article>
                    <div class="panel panel-innertable">
                        <div class="form-group">
                            <button dp-toggle-switch ng-model="chat_options.chat_proactive"></button>
                            <h4><span class="title-text">Proactive Chat</span></h4>
                        </div>
                    </div>
                </article>

                <ul>
                    <li>
                        <input type="radio" ng-model="chat_options.chat_agent_icon" value="single" /> Single Agent Icon
                    </li>
                    <li>
                        <input type="radio" ng-model="chat_options.chat_agent_icon" value="triple" /> Triple Agent Icon
                    </li>
                    <li>
                        <input type="radio" ng-model="chat_options.chat_agent_icon" value="icon_message" /> Agent Icon + Message
                        <input type="text" ng-model="chat_options.chat_agent_icon_message" />
                    </li>
                </ul>
            </div>

            <div class="content-section">
                <h2 class="with-divider form-header"><span>Ticket Settings</span></h2>

                <ul>
                    <li>
                        <input type="radio" ng-model="Ctrl.settings.button_size" />
                        <label>Default Department</label>

                        <select ng-model="Ctrl.settings.button_size">
                            <option value="S">S</option>
                            <option value="M">M</option>
                            <option value="L">L</option>
                        </select>
                    </li>
                    <li>
                        <input type="radio" ng-model="Ctrl.settings.button_size" />
                        <label>User Selects Department</label>
                    </li>
                </ul>
            </div>

            <div class="form-footer">
                <hr>
                <div dp-hide-spinning="saving">
                    <button type="submit" ng-click="Ctrl.updateChatCode()">Get Code</button>
                </div>
                <div dp-show-spinning="saving">
                    <i class="spinner-flat"></i>
                </div>
            </div>
        </form>

        <div class="editor-row" style="width: 60%" ng-if="!!code_snippets.chat">
            <div class="editor-wrap">
                <div class="editor"
                     style="height: 220px;"
                     ng-model="code_snippets.chat"
                     ui-ace="{
                         mode: 'html',
                         useWrapMode: false,
                         showGutter: false,
                         theme: 'textmate',
                         onLoad: embedEditorLoaded
                     }">

                </div>
            </div>
        </div>

    </section>
</div>
{% endblock %}
