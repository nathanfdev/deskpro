{% extends 'AdminInterfaceBundle:Layout:list.html.twig' %}
{% block listpane_content %}
	<section class="dp-paneblock dp-listpane">
		<header>
			<nav>
				<span class="status-pinger saved-ping" dp-ping-flash="display_orders">
					<i class="fa fa-check-square-o-square"></i> {{ phrase('agent.general.saved') }}
				</span>
			</nav>
			<h3 ng-pluralize count="ListCtrl.list.length || 0" when="{{ ng_plural_phrase('adm.general.x_ticket_escalations') }}"></h3>
		</header>
		<article>
			<ul class="dp-item-list" ng-if="ListCtrl.list.length">
				<li ng-repeat="esc in ListCtrl.list"
					dp-state-mark="tickets.ticket_escalations.edit.{{ ng_var('esc.id') }}" data-id="{{ ng_var('esc.id') }}">
					<a href="{{ ng_href('tickets.ticket_escalations.edit', '{id: esc.id}') }}">
						<div class="pull-right">
							<span class="btn btn-danger btn-xs only-icon" ng-show="delete_mode"
								  style="margin-top: -3px;"
								  ng-click="ListCtrl.startDelete(esc); $event.preventDefault();">
								<i class="fa fa-trash-o"></i>
							</span>
						</div>
						<h4>
							<span class="title-text">{{ ng_var('esc.title') }}</span>
						</h4>
					</a>
				</li>
			</ul>
			<div class="dp-add-control">
				<a class="btn btn-default" href="{{ ng_href('tickets.ticket_escalations.gocreate') }}" ng-class="{'active': isStateActive('.create') }"><i class="fa fa-plus"></i> {{ phrase('adm.ticket_escalations.new_escalation') }}</a>
			</div>
		</article>
	</section>
{% endblock %}
{% block listpane_help %}
	<header>
		<h1>Ticket escalations run actions based on elapsed time.</h1>
		<p>You define under what conditions elapsed time is counted, and how much time must pass before the escalation runs. You choose what <strong>actions</strong> are applied when the escalation runs.</p>
	</header>
	<article>
		<section>
			<p>When you create an escalation, you can choose if it counts:</p>
			<ul>
				<li>time the ticket has been open for: total time the ticket has existed without being resolved</li>
				<li>time the user has been waiting: how long the ticket has been <strong>awaiting agent</strong>; this only counts time from the most recent status change, i.e. changing status to something else then back to <strong>awaiting agent</strong> resets the clock</li>
				<li>total time the user has been waiting: cumulative time the ticket has been <strong>awaiting agent</strong> over its whole life</li>
				<li>time the agent has been waiting: how long ticket has been in <strong>awaiting user</strong> status since its last status change</li>
				<li>how long the ticket has been resolved for</li>
			</ul>
			<p>You can also set extra <strong>criteria</strong> that the ticket must meet for the escalation to run.</p>
		</section>
		
		
		<section>
		<h2><span>FAQ</span></h2>
		<dl>
			<dt><em>Q:</em>How do escalations count time outside helpdesk working hours?</dt>
			<dd><em>A:</em>
				Working hours do not affect escalations. Use SLAs if you need to take working hours into account.
			</dd>
		
			<dt><em>Q:</em>If an escalation with a "stop processing other triggers" action runs, does that stop future escalations from doing anything?</dt>
			<dd><em>A:</em>
			No, "stop processing other triggers" only applies when two triggers/escalations/SLAs run in response to the same event.
			</dd>
		</dl>
		</section>

		<section class="related-content">
			<h2><span>Related Content</span></h2>
			<ul>
				<li><i class="fa fa-book"></i> <a href="https://www.deskpro.com/manuals/admin-manual/admin-manual.html#ticket-escalations" target="_blank">Ticket escalations</a></li>
				<li><i class="fa fa-book"></i> <a href="https://www.deskpro.com/manuals/admin-manual/admin-manual.html#actions-guide" target="_blank">Actions guide</a></li>
				<li><i class="fa fa-book"></i> <a href="https://www.deskpro.com/manuals/admin-manual/admin-manual.html#automating-the-helpdesk" target="_blank">Automating the Helpdesk</a></li>

			</ul>
	</section>
	
	</article>
{% endblock %}