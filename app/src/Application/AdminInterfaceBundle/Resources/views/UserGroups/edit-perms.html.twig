{% macro perm_toggle(typename, permname, opts) %}
	<input
		dp-slider-switch
		ng-model="EditCtrl.perm_form.{{ typename }}.{{ permname }}"
		is-on="EditCtrl.perm_form_reg.{{ typename }}.{{ permname }} || EditCtrl.perm_form_everyone.{{ typename }}.{{ permname }}"
		is-locked="EditCtrl.perm_form_reg.{{ typename }}.{{ permname }} || EditCtrl.perm_form_everyone.{{ typename }}.{{ permname }}"
		locked-tip-e="EditCtrl.perm_form_everyone.{{ typename }}.{{ permname }}? 'This permission is being granted through the Everyone usergroup' : 'This permission is being granted through the Registered usergroup.'"
	/>
{% endmacro %}


<div class="panel panel-innertable">
	<nav class="dp-tabletabs">
		<ul>
			<li class="active" dp-tab-btn="main.perms.tickets"><a href="#"><i class="fa fa-envelope"></i> Tickets</a></li>
			{% if app.getSetting('core.apps_chat') %}
				<li dp-tab-btn="main.perms.chat"><a href="#"><i class="fa fa-comment"></i> Chat</a></li>
			{% endif %}
			<li dp-tab-btn="main.perms.feedback"><a href="#"><i class="fa fa-inbox"></i> Feedback</a></li>
			<li dp-tab-btn="main.perms.articles"><a href="#"><i class="fa fa-file-text"></i> Articles</a></li>
			<li dp-tab-btn="main.perms.downloads"><a href="#"><i class="fa fa-download"></i> Downloads</a></li>
			<li dp-tab-btn="main.perms.news"><a href="#"><i class="fa fa-list-alt"></i> News</a></li>
		</ul>
	</nav>

	{# TICKETS PERMISSIONS #}

	<table class="table table-hover" dp-tab-body="main.perms.tickets">
		<tbody>
			<tr>
				<td width="100%">{{ phrase('admin.user_groups.can_use_tickets') }}</td>
				<td>
					{{ _self.perm_toggle('ticket', 'use') }}
				</td>
			</tr>
			<tr>
				<td width="100%">
					Can re-open resolved tickets

					<div style="padding: 10px 0 0 25px;" ng-show="!EditCtrl.perm_form.ticket.reopen_resolved && !EditCtrl.perm_form_reg.ticket.reopen_resolved">
						How should the helpdesk handle an email reply to a resolved ticket?<br/>
						<div ng-if="EditCtrl.perm_form_reg.ticket.reopen_resolved_createnew">
							<label tooltip="This permission is being granted through the Everyone usergroup">
								<input type="radio" value="new_ticket" ng-model="EditCtrl.perm_form.options.reopen_resolved_createnew" disabled="disabled" />
								<strong>New Ticket</strong> &middot; The message is accepted as a new ticket
							</label>
						</div>
						<div ng-if="!EditCtrl.perm_form_reg.ticket.reopen_resolved_createnew">
							<label>
								<input type="radio" value="reject" ng-model="EditCtrl.perm_form.options.reopen_resolved_createnew" />
								<strong>Reject</strong> &middot; The message is rejected and the user is sent an auto-response
							</label>
							<br/>
							<label>
								<input type="radio" value="new_ticket" ng-model="EditCtrl.perm_form.options.reopen_resolved_createnew" />
								<strong>New Ticket</strong> &middot; The message is accepted as a new ticket
							</label>
						</div>
					</div>
				</td>
				<td>
					{{ _self.perm_toggle('ticket', 'reopen_resolved') }}
				</td>
			</tr>
		</tbody>
	</table>

	{# /TICKETS PERMISSIONS #}

	{# CHAT PERMISSIONS #}

	{% if app.getSetting('core.apps_chat') %}

		<table class="table table-hover" dp-tab-body="main.perms.chat">
			<tbody>
				<tr>
					<td width="100%">{{ phrase('admin.user_groups.can_use_chat') }}</td>
					<td>
						{{ _self.perm_toggle('chat', 'use') }}
					</td>
				</tr>
			</tbody>
		</table>

	{% endif %}

	{# /CHAT PERMISSIONS #}

