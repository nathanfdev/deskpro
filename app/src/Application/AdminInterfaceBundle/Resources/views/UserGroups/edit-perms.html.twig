			</tr>
			<tr>
				<td width="100%">&nbsp;&nbsp;&nbsp;&nbsp; New feedback is visible immediately (no agent validation)</td>
				<td>
					{{ _self.perm_toggle('feedback', 'no_submit_validate') }}
