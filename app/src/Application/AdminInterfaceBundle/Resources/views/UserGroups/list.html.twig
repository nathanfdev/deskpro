{% extends 'AdminInterfaceBundle:Layout:list.html.twig' %}
{% block listpane_content %}
	<section class="dp-paneblock dp-listpane">
		<header>
			<h3>User Groups</h3>
		</header>
		<article>
			<ul class="dp-item-list">
				<li ng-repeat="group in ListCtrl.list"
					dp-state-mark="crm.groups.edit.{{ ng_var('group.id') }}" data-id="{{ ng_var('group.id') }}">
					<a href="{{ ng_href('crm.groups.edit', '{id: group.id}') }}">
						<button dp-toggle-switch ng-model="group.is_enabled"
								ng-change="ListCtrl.toggleUserGroup(group)"></button>
						<h4><span class="title-text">{{ ng_var('group.title') }}</span></h4>
					</a>
				</li>
			</ul>
			<div class="dp-add-control">
				<a class="btn btn-default" href="{{ ng_href('crm.groups.gocreate') }}"
				   ng-class="{'active': isStateActive('.create') }">
					<i class="fa fa-plus"></i>
					{{ phrase('agent.general.add') }}
				</a>
			</div>
		</article>
	</section>
{% endblock %}
{% block listpane_help %}
	{% include 'AdminInterfaceBundle:UserGroups:help-page.html.twig' %}
{% endblock %}