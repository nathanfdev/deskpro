{% extends 'AdminInterfaceBundle:Layout:list-editpane.html.twig' %}
{% block editpane_content %}
    <section class="dp-paneblock dp-editpane">

        <article class="form-horizontal dp-form">
            <div class="panel panel-fill indent">
                <div class="panel-body">

                    <h3>
                        <img ng-src="{{ ng_var('importer.icon') }}" alt="Icon"/>
                        &nbsp;
                        {{ ng_var('importer.title') }}
                    </h3>
                    <br/>


                    {# CSV #}

                    <div class="form-group" ng-if="'csv' === importer.id">
                        <label class="col-lg-3">
                            File
                        </label>

                        <div class="col-lg-9">
                            <a href="javascript:;" class="btn btn-default file-upload-wrapper">
                                <input type="file" ng-file-select="EditCtrl.onFileSelect($files)" accept=".csv"/>
                                Upload CSV
                            </a>
                        </div>
                    </div>

                    <div class="form-group" ng-if="'csv' === importer.id">
                        <label class="col-lg-3">
                            Delimeter
                        </label>

                        <div class="col-lg-9">
                            <select>
                                <option value="">;</option>
                                <option value="">,</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group" ng-if="'csv' === importer.id">
                        <label class="col-lg-3">
                            Enclosure
                        </label>

                        <div class="col-lg-9">
                            <select>
                                <option value="">"</option>
                                <option value="">'</option>
                            </select>
                        </div>
                    </div>


                    {# Zendesk #}

                    <div class="form-group" ng-if="'zendesk' === importer.id">
                        <label class="col-lg-3">
                            Subdomain
                        </label>

                        <div class="col-lg-9">
                            <input type="text" class="form-control"/>

                            <p class="help-block">Subdomain</p>
                        </div>
                    </div>

                    <div class="form-group" ng-if="'zendesk' === importer.id">
                        <label class="col-lg-3">
                            Username
                        </label>

                        <div class="col-lg-9">
                            <input type="text" class="form-control"/>

                            <p class="help-block">Username</p>
                        </div>
                    </div>

                    <div class="form-group" ng-if="'zendesk' === importer.id">
                        <label class="col-lg-3">
                            Password
                        </label>

                        <div class="col-lg-9">
                            <input type="text" class="form-control"/>

                            <p class="help-block">Password</p>
                        </div>
                    </div>

                    <div class="form-group" ng-if="'zendesk' === importer.id">
                        <label class="col-lg-3">
                            API Token
                        </label>

                        <div class="col-lg-9">
                            <input type="text" class="form-control"/>

                            <p class="help-block">Token</p>
                        </div>
                    </div>

                    <div class="form-group" ng-if="'zendesk' === importer.id">
                        <label class="col-lg-3">
                            Initial time
                        </label>

                        <div class="col-lg-9">
                            <input type="text" class="form-control"/>

                            <p class="help-block">Initial time</p>
                        </div>
                    </div>


                    {# OsTicket #}

                    <div class="form-group" ng-if="'osticket' === importer.id">
                        <label class="col-lg-3">
                            Host
                        </label>

                        <div class="col-lg-9">
                            <input type="text" class="form-control"/>

                            <p class="help-block">Host</p>
                        </div>
                    </div>

                    <div class="form-group" ng-if="'osticket' === importer.id">
                        <label class="col-lg-3">
                            Database
                        </label>

                        <div class="col-lg-9">
                            <input type="text" class="form-control"/>

                            <p class="help-block">Database</p>
                        </div>
                    </div>

                    <div class="form-group" ng-if="'osticket' === importer.id">
                        <label class="col-lg-3">
                            Username
                        </label>

                        <div class="col-lg-9">
                            <input type="text" class="form-control"/>

                            <p class="help-block">Username</p>
                        </div>
                    </div>

                    <div class="form-group" ng-if="'osticket' === importer.id">
                        <label class="col-lg-3">
                            Password
                        </label>

                        <div class="col-lg-9">
                            <input type="text" class="form-control"/>

                            <p class="help-block">Password</p>
                        </div>
                    </div>


                </div>
            </div>
        </article>

        <footer ng-hide="has_own_footer">
            <div class="dp-content">
                <div class="dp-btn-controls">
                    <button class="btn btn-primary" ng-click="test()" ng-disabled="!ready">
                        Next
                    </button>
                </div>
            </div>
        </footer>
    </section>

    <div dp-register-message="saved_settings">Settings were saved successfully</div>
{% endblock %}
