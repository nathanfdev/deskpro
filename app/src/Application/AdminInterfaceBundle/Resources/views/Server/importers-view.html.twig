{% extends 'AdminInterfaceBundle:Layout:list-editpane.html.twig' %}
{% block editpane_content %}
    <section class="dp-paneblock dp-editpane">

        <article class="form-horizontal dp-form">
            <div class="panel panel-fill indent">
                <div class="panel-body">

                    <h3>
                        <img ng-src="{{ ng_var('importer.icon') }}" alt="Icon"/>
                        &nbsp;
                        {{ ng_var('importer.title') }}
                        &nbsp;
                        <span ng-if="busy || importer.status && 'testing' !== importer.status && 'done' !== importer.status">
                            <i class="fa fa-spinner fa-spin"></i>
                        </span>
                    </h3>
                    <br/>


                    <div ng-if="!importer.status">
                        {# CSV #}
                        <div ng-if="'csv' === id">
                            <div class="form-group">
                                <label class="col-lg-3">
                                    Files
                                </label>

                                <div class="col-lg-9">

                                    <ul class="list list-unstyled">
                                        <li ng-repeat="blob in importer.config.blobs">
                                            <i class="fa fa-times" style="cursor: pointer;"
                                               ng-click="Ctrl.deleteBlob(blob)"></i>
                                            {{ ng_var('blob.filename') }}
                                        </li>
                                    </ul>

                                    <a href="javascript:;" class="btn btn-default file-upload-wrapper">
                                        <input type="file" ng-file-select="Ctrl.onFileSelect($files)"
                                               accept=".csv"/>
                                        Add CSV file
                                    </a>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-lg-3">
                                    Delimeter
                                </label>

                                <div class="col-lg-9">
                                    <select ng-model="importer.config.delimiter">
                                        <option value="">;</option>
                                        <option value=",">,</option>
                                    </select>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-lg-3">
                                    Enclosure
                                </label>

                                <div class="col-lg-9">
                                    <select ng-model="importer.config.enclosure">
                                        <option value="">"</option>
                                        <option value="'">'</option>
                                    </select>
                                </div>
                            </div>
                        </div>


                        {# Zendesk #}

                        <div ng-if="'zendesk' === id">
                            <div class="form-group">
                                <label class="col-lg-3">
                                    Subdomain
                                </label>

                                <div class="col-lg-9">
                                    <input type="text" class="form-control"/>

                                    <p class="help-block">Subdomain</p>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-lg-3">
                                    Username
                                </label>

                                <div class="col-lg-9">
                                    <input type="text" class="form-control"/>

                                    <p class="help-block">Username</p>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-lg-3">
                                    Password
                                </label>

                                <div class="col-lg-9">
                                    <input type="text" class="form-control"/>

                                    <p class="help-block">Password</p>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-lg-3">
                                    API Token
                                </label>

                                <div class="col-lg-9">
                                    <input type="text" class="form-control"/>

                                    <p class="help-block">Token</p>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-lg-3">
                                    Initial time
                                </label>

                                <div class="col-lg-9">
                                    <input type="text" class="form-control"/>

                                    <p class="help-block">Initial time</p>
                                </div>
                            </div>
                        </div>


                        {# OsTicket #}
                        <div ng-if="'osticket' === id">
                            <div class="form-group">
                                <label class="col-lg-3">
                                    Host
                                </label>

                                <div class="col-lg-9">
                                    <input type="text" class="form-control"/>

                                    <p class="help-block">Host</p>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-lg-3">
                                    Database
                                </label>

                                <div class="col-lg-9">
                                    <input type="text" class="form-control"/>

                                    <p class="help-block">Database</p>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-lg-3">
                                    Username
                                </label>

                                <div class="col-lg-9">
                                    <input type="text" class="form-control"/>

                                    <p class="help-block">Username</p>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-lg-3">
                                    Password
                                </label>

                                <div class="col-lg-9">
                                    <input type="text" class="form-control"/>

                                    <p class="help-block">Password</p>
                                </div>
                            </div>
                        </div>
                    </div>


                    <div ng-if="'testing' === importer.status && !busy">
                        <div ng-if="test_error">
                            {{ ng_var('test_error_message') }}
                        </div>
                        <div ng-if="!test_error">
                            No errors
                        </div>
                    </div>

                    <div ng-if="importer.status && 'testing' !== importer.status">

                        <div>
                            Import process is currently running. Time running: XX
                        </div>
                        <div>
                            progressbar
                        </div>
                        <div>
                            Current step: {{ ng_var('importer.status') }}
                        </div>

                        <br/>

                        <textarea class="form-control" readonly="readonly"
                                  rows="10">{{ ng_var('importer.log') }}</textarea>

                    </div>


                </div>
            </div>
        </article>

        <footer ng-hide="busy">
            <div class="dp-content">
                <div class="dp-btn-controls">

                    <button class="btn btn-primary"
                            ng-click="Ctrl.importTest()"
                            ng-disabled="!ready"
                            ng-if="!importer.status"
                            >
                        Next
                    </button>

                    <button class="btn btn-default"
                            ng-click="Ctrl.importReset()"
                            ng-if="'testing' === importer.status"
                            >
                        Back
                    </button>

                    <button class="btn btn-primary"
                            ng-click="Ctrl.importStart()"
                            ng-if="'testing' === importer.status"
                            >
                        Start Import
                    </button>

                    <button class="btn btn-primary"
                            ng-click="Ctrl.importReset()"
                            ng-if="'done' === importer.status"
                            >
                        New Import
                    </button>

                </div>
            </div>
        </footer>
    </section>

    <div dp-register-message="saved_settings">Settings were saved successfully</div>
{% endblock %}
