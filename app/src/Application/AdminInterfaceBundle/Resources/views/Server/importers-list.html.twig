{% extends 'AdminInterfaceBundle:Layout:list.html.twig' %}
{% block listpane_content %}

    <section class="dp-paneblock dp-listpane" dp-max-height dp-height-add="-35">
        <header>
            <h3>Importers</h3>
        </header>
        <article>
            <ul class="dp-item-list dp-icon-list">
                <li ng-repeat="i in list" dp-state-mark="server.importers.view.{{ ng_var('i.id') }}">
                    <aside>
                        <a href="{{ ng_href('server.importers.view', '{id: i.id}') }}">
                            <img ng-src="/web/images/admin/icons/icon-{{ ng_var('i.id') }}.png" alt="Icon"
                                 style="width: 40px; height: 40px;"/>
                        </a>
                    </aside>
                    <div class="content">
                        <h4>
                            <a href="{{ ng_href('server.importers.view', '{id: i.id}') }}">
                                <span class="title-text">{{ ng_var('i.title') }}</span>
                            </a>
                        </h4>

                        <p class="info">
                            {{ ng_var('i.description') }}
                        </p>
                    </div>
                </li>
            </ul>
        </article>
    </section>

{% endblock %}
{% block listpane_help %}
    <header>
        <h1>Help</h1>
    </header>

    <article>
        <section>
            <p>A long time ago in a galaxy far, far away....</p>
        </section>
    </article>
{% endblock %}