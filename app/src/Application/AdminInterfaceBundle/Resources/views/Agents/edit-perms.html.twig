{% macro perm_col(title, usergroup_values, permgroup, name, depends_on, class) %}
	{% set perm_fname_flat = permgroup ~ '_' ~ name %}
	{% set perm_fname_dot = permgroup ~ '.' ~ name %}
	<tr>
		<td width="100%">{{ title|raw }}</td>
		<td>
			<button dp-toggle-switch ng-model="EditCtrl.form.perms[{{ perm_fname_dot }}]"></button>
		</td>
	</tr>
{% endmacro %}

