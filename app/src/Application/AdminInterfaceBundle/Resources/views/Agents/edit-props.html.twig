
<div class="panel panel-fill indent">
	<div class="panel-body">
		<div class="form-group">
			<div class="col-lg-3">
				<h3>Name</h3>
			</div>
			<div class="col-lg-9">
				<div class="inner-group">
					<input type="text" class="form-control" name="title" ng-model="EditCtrl.form.name" style="width: 50%;" required />
				</div>

				<div class="inner-group">
					<label>
						<input type="checkbox" ng-model="EditCtrl.form.enable_display_name" />
						<h4>Display a different name to end-users</h4>
					</label>
					<div ng-show="EditCtrl.form.enable_display_name">
						<input type="text" class="form-control" ng-model="EditCtrl.form.display_name" style="width: 50%;" />
					</div>
				</div>
			</div>
		</div>
		<div class="form-group">
			<div class="col-lg-3">
				<h3>Email Address</h3>
			</div>
			<div class="col-lg-9">
				<input type="text" class="form-control" name="email" ng-model="EditCtrl.form.email" style="width: 50%;" />
			</div>
		</div>
		<div class="form-group">
			<div class="col-lg-3">
				<h3>Reset Password</h3>
			</div>
			<div class="col-lg-9">
				<input type="text" class="form-control" name="reset_password" ng-model="EditCtrl.form.reset_password" placeholder="Leave blank to keep current password" style="width: 50%;" />
			</div>
		</div>
		<div class="form-group">
			<div class="col-lg-3">
				<h3>Zones</h3>
			</div>
			<div class="col-lg-9">
				<ul class="checkbox-list" style="min-width: 250px">
					<li>
						<label>
							<input type="checkbox" ng-model="EditCtrl.form.zones[admin]" />
							<span>Admin Interface</span>
						</label>
					</li>
					<li>
						<label>
							<input type="checkbox" ng-model="EditCtrl.form.zones[reports]" />
							<span>Reports Interface</span>
						</label>
					</li>
				</ul>
			</div>
		</div>
		<div class="form-group">
			<div class="col-lg-3">
				<h3>Teams</h3>
			</div>
			<div class="col-lg-9">
				<ul class="checkbox-list" style="min-width: 250px">
					<li ng-repeat="team in EditCtrl.teams">
						<label>
							<input type="checkbox" ng-model="EditCtrl.form.teams[team.id]" />
							<span>{{ ng_var('team.name') }}</span>
						</label>
					</li>
				</ul>
			</div>
		</div>
		<div class="form-group">
			<div class="col-lg-3">
				<h3>Permission Groups</h3>
			</div>
			<div class="col-lg-9">
				<ul class="checkbox-list" style="min-width: 250px">
					<li ng-repeat="group in EditCtrl.groups">
						<label>
							<input type="checkbox" ng-model="EditCtrl.form.groups[group.id]" />
							<span>{{ ng_var('group.title') }}</span>
						</label>
					</li>
				</ul>
			</div>
		</div>
	</div>
</div>