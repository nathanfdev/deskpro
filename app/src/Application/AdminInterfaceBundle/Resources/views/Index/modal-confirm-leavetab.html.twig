<div class="modal-dialog">
<div class="modal-content">
	<div class="modal-header">
		<button type="button" class="close" ng-click="dismiss()">&times;</button>
		<h4 class="modal-title">Unsaved Changes</h4>
	</div>
	<div class="modal-body">
		You have unsaved changes on this page. Are you sure you want to change to another page? Your unsaved changes will be lost.
	</div>
	<div class="modal-footer">
		<button class="btn btn-success" ng-click="dismiss()"><i class="icon-undo"></i> Cancel</button>
		<button class="btn btn-danger" ng-click="continue()"><i class="icon-share-alt"></i> Discard unsaved changes and continue</button>
	</div>
</div>
</div>