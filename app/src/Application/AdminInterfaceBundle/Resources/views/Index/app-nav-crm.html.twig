{% extends 'AdminInterfaceBundle:Layout:app.html.twig' %}
{% import 'AdminInterfaceBundle:Index:app-nav-macros.html.twig' as nav %}
{% block nav_content %}
	{{ nav.list() }}
		{{ nav.list_item('Registration', ng_href('crm.reg'), 'crm.reg', 'fa-user') }}
		{{ nav.list_item('Password SEttings', ng_href('crm.password_settings'), 'crm.password_settings', 'fa-asterisk') }}
		{{ nav.list_item('Auth & SSO', ng_href('crm.usersources'), 'crm.usersources', 'fa-key') }}
		{{ nav.list_item('User Groups', ng_href('crm.groups'), 'crm.groups', 'fa-group') }}
		{{ nav.list_item_group('Fields', 'fa-terminal') }}
			{{ nav.list_subitem('Users', ng_href('crm.user_fields'), 'crm.user_fields', 'fa-user') }}
			{{ nav.list_subitem('Organizations', ng_href('crm.org_fields'), 'crm.org_fields', 'fa-group') }}
		{{ nav.list_item_group_end() }}
		{{ nav.list_item('Rules', ng_href('crm.rules'), 'crm.rules', 'fa-tasks') }}
		{{ nav.list_item_group('Labels', 'fa-caret-down') }}
			{{ nav.list_item('Users', ng_href('crm.user_labels'), 'crm.user_labels', 'fa-user') }}
			{{ nav.list_item('Organizations', ng_href('crm.org_labels'), 'crm.org_labels', 'fa-group') }}
		{{ nav.list_item_group_end() }}
		{{ nav.list_item('Banning', ng_href('crm.banning'), 'crm.banning', 'fa-ban') }}
		{{ nav.list_item('CSV Import', ng_href('crm.import'), 'crm.import', 'fa-upload') }}
	{{ nav.list_end() }}
{% endblock %}
