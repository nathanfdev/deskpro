{% extends 'AdminInterfaceBundle:Layout:app.html.twig' %}
{% import 'AdminInterfaceBundle:Index:app-nav-macros.html.twig' as nav %}
{% block nav_content %}
	<div class="sidebar-list">
		<div class="sidebar-brand">
			<ul>
				<li>
					<span class="faded">Brand:</span> <span>Default Brand <i class="fa fa-sort"></i></span>
				</li>
			</ul>
		</div>
	</div>

	{{ nav.list() }}
		{{ nav.list_item('Setup', 'portal.portal_editor', 'portal.portal_editor', 'fa-cog') }}

		{{ nav.list_item_group('User Interfaces', 'fa-th-large') }}
			{{ nav.list_subitem('Portal', 'portal.setup_portal', 'portal.setup_portal', 'fa-home') }}
			{{ nav.list_subitem('Widget', 'portal.setup_widget', 'portal.setup_widget', 'fa-puzzle-piece') }}
			{{ nav.list_subitem('Forms', 'portal.setup_forms', 'portal.setup_forms', 'fa-keyboard-o') }}
		{{ nav.list_item_group_end() }}

		{{ nav.list_item_group('Portal Apps', 'fa-th-large') }}
			{{ nav.list_subitem('Knowledgebase', 'portal.app_kb', 'portal.app_kb', 'fa-book') }}
			{{ nav.list_subitem('News', 'portal.app_news', 'portal.app_news', 'fa-clock-o') }}
			{{ nav.list_subitem('Feedback', 'portal.app_feedback', 'portal.app_feedback', 'fa-thumbs-up') }}
			{{ nav.list_subitem('Downloads', 'portal.app_downloads', 'portal.app_downloads', 'fa-download') }}
		{{ nav.list_item_group_end() }}
	{{ nav.list_end() }}
{% endblock %}
