{% extends 'AdminInterfaceBundle:Layout:app.html.twig' %}
{% import 'AdminInterfaceBundle:Index:app-nav-macros.html.twig' as nav %}
{% block nav_content %}
	<div class="sidebar-list">
		<div class="sidebar-brand">
			<ul>
				<li>
					<a>
						<span class="brand-logo" style="background-image: url({{ asset('app/Interface/Resources/img/file-preview.png') }})"></span>
						<span class="faded">Brand:</span> <span>Default Brand <i class="fa fa-sort"></i></span>
					</a>
				</li>
			</ul>
		</div>
	</div>

	{{ nav.list() }}
		{{ nav.list_item('Setup', ng_href('portal.setup'), 'portal.setup', 'fa-cog', "Ctrl.settings.portal_mode") }}

		{{ nav.list_item_group('User Interfaces', 'fa-th-large') }}
			{{ nav.list_subitem('Portal', ng_href('portal.portal_editor'), 'portal.portal_editor', 'fa-home', 'Ctrl.settings.iface_portal') }}
			{{ nav.list_subitem('Widget', 'portal.setup_widget', 'portal.setup_widget', 'fa-puzzle-piece', 'Ctrl.settings.iface_widget') }}
		{{ nav.list_item_group_end() }}

		{{ nav.list_item_group('Portal Apps', 'fa-th-large', 'Ctrl.settings.portal_mode == "publish"') }}
			{{ nav.list_subitem('Knowledgebase', 'portal.app_kb', 'portal.app_kb', 'fa-book', 'Ctrl.settings.apps_kb') }}
			{{ nav.list_subitem('News', 'portal.app_news', 'portal.app_news', 'fa-clock-o', 'Ctrl.settings.apps_news') }}
			{{ nav.list_subitem('Feedback', 'portal.app_feedback', 'portal.app_feedback', 'fa-thumbs-up', 'Ctrl.settings.apps_feedback') }}
			{{ nav.list_subitem('Downloads', 'portal.app_downloads', 'portal.app_downloads', 'fa-download', 'Ctrl.settings.apps_downloads') }}
		{{ nav.list_item_group_end() }}
	{{ nav.list_end() }}
{% endblock %}
