{% extends 'AdminInterfaceBundle:Layout:fill-page-alt.html.twig' %}
{% block alt_content %}
	<div class="dp-appalt-section">
		<header><h2>Agents</h2></header>
		<section ng-if="Home.online_agents.length">
			<header><h3>Online</h3></header>
			<article>
				<ul class="dp-icon-list with-icons x22">
					<li class="media" ng-repeat="agent in Home.online_agents">
						<i class="icon-img" bg-img="agent.picture_url_22"></i>
						<span class="title">{{ ng_var('agent.display_name') }}</span>
					</li>
				</ul>
			</article>
		</section>

		<section ng-if="Home.offline_agents.length">
			<header><h3>Offline</h3></header>
			<article>
				<ul class="dp-icon-list with-icons x22">
					<li class="media" ng-repeat="agent in Home.offline_agents">
						<i class="icon-img" bg-img="agent.picture_url_22"></i>
						<span class="title">{{ ng_var('agent.display_name') }}</span>
					</li>
				</ul>
			</article>
		</section>
	</div>

	<div class="dp-appalt-section">
		<header><h2>Invite Agent</h2></header>
		<section>
			<article>
				<form>
					<div class="form-group">
						<input type="text" class="form-control" ng-model="new_agent.name" placeholder="Name" />
					</div>
					<div class="form-group">
						<input type="email" class="form-control" ng-model="new_agent.email" placeholder="Email" required />
					</div>
					<button class="btn btn-default">Add Agent</button>
				</form>
			</article>
		</section>
	</div>
{% endblock %}
{% block fillpage_content %}
	<div class="dp-dashboard">
		<div class="row">
			<div class="col-xs-6">
				<div class="dp-item" style="height: 284px;">
					<header>
						<h3>DeskPRO News</h3>
					</header>
					<article>
						...
					</article>
				</div>
			</div>

			<div class="col-xs-6">
				<div class="dp-item" style="height: 284px;">
					<header>
						<h3>Need help?</h3>
					</header>
					<article>
						<div class="dp-mpadded">
							<form>
								<div class="form-group">
									<input type="text" class="form-control" ng-model="submit_ticket.subject" required placeholder="Enter a subject for your message" />
								</div>
								<div class="form-group">
									<textarea class="form-control" style="height: 100px;" ng-model="submit_ticket.message" placeholder="Enter your question here"></textarea>
								</div>
								<div class="form-group">
									<div ng-show="submit_ticket_defaultemail" ng-init="submit_ticket_defaultemail = true">
										We will reply to <strong>{{ app.user.primary_email_address }}</strong>.
										<a href="#" ng-click="submit_ticket_defaultemail = false">Change?</a>
									</div>
									<div class="input-group" ng-hide="submit_ticket_defaultemail">
										<span class="input-group-addon">Reply To:</span>
										<input type="email" class="form-control" ng-model="submit_ticket.email" ng-init="submit_ticket.email = '{{ app.user.primary_email_address }}'" required />
									</div>
								</div>
							</form>
						</div>
						<div class="dp-mpadded">
							<button class="btn btn-default"><i class="fa fa-envelope-o"></i> Send Message</button>
						</div>
					</article>
				</div>
			</div>
		</div>

		<div class="row">
			<div class="col-xs-6">
				<div class="dp-item" style="height: 284px;">
					<header>
						<h3>Quick Stats</h3>
					</header>
					<article>
						<ul class="dp-display-list">
							<li>
								<i class="fa fa-envelope"></i>
								Tickets created today: 6
							</li>
							<li>
								<i class="fa fa-check-square"></i>
								Tickets resolved today: 6
							</li>
							<li>
								<i class="fa fa-clock-o"></i>
								Tickets awaiting agent: 6
							</li>
						</ul>
						<div class="dp-mpadded">
							<a class="btn btn-default" href="{{ path('user') }}/reports">View more reports <i class="fa fa-long-arrow-right"></i></a>
						</div>
					</article>
				</div>
			</div>

			<div class="col-xs-6">
				<div class="dp-item" style="min-height: 284px;">
					<header>
						<h3>Status</h3>
					</header>
					<article>
						<div class="dp-mpadded">
							Everything is running smoothly.
						</div>
					</article>
				</div>
			</div>
		</div>
	</div>
{% endblock %}