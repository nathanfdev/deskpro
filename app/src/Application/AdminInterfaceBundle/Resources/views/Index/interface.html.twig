<!DOCTYPE html>
<html ng-app>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width">
	<title>DeskPRO</title>
	<!--[if IE]><meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" /><![endif]-->

	<link rel="stylesheet" href="{{ asset('app/bower_components/bootstrap/dist/css/bootstrap.min.css') }}"/>
	<link rel="stylesheet" href="{{ asset('app/bower_components/bootstrap-switch/static/stylesheets/bootstrap-switch.css') }}"/>
	<link rel="stylesheet" href="{{ asset('app/bower_components/font-awesome/css/font-awesome.min.css') }}"/>
	<link rel="stylesheet" href="{{ asset('app/Admin/Resources/style/main.css') }}"/>
	<link rel="stylesheet" href="{{ asset('app/Admin/Resources/style/layout.css') }}"/>
</head>
<body>

<header class="header navbar-fixed-top">
	<div class="row">
		<!-- User Profile -->
		<div class="col-md-6">
			<section class="user-profile">
				<img class="up-photo" alt="">

				<div class="up-content">
					<p class="up-name">
						{{ phrase('agent.chrome.hello-user', {name: app.user.display_name}) }}
					</p>
					<ul class="up-nav">
						<li><i class="icon-cog"></i> <a href="#">{{ phrase('agent.general.settings') }}</a></li>
						<li><i class="icon-question-sign"></i> <a href="#">{{ phrase('agent.general.help') }}</a></li>
						<li><i class="icon-signout"></i> <a href="#">{{ phrase('agent.general.log_out') }}</a></li>
					</ul>
				</div>
			</section>
		</div>

		<!-- Logo -->
		<div class="col-md-6">
			<a href="index.html" class="logo">DeskPRO</a>
		</div>
	</div>
</header>

<div id="dp_main_view">
	<!-- Left Navigation Column -->
	<nav class="left-nav">
		<ul>
			<li class="active">
				<a class="ln-icon ln-icon-home" href="#" dp-state-mark="settings">Home</a>
			</li>
			<li>
				<a class="ln-icon ln-icon-chat" href="#">Agent Chat</a>
			</li>
			<li>
				<a class="ln-icon ln-icon-ticket" href="#">Ticket</a>
			</li>
			<li>
				<a class="ln-icon ln-icon-crm" href="#">CRM</a>
			</li>
			<li>
				<a class="ln-icon ln-icon-publish" href="#">Publish</a>
			</li>
			<li>
				<a class="ln-icon ln-icon-twitter" href="#">Twitter</a>
			</li>
			<li>
				<a class="ln-icon ln-icon-rate" href="#">Rate</a>
			</li>
		</ul>
	</nav>
	<div class="dp-section" ui-view>
		<nav class="dp-section-nav sections-nav" ui-view="dp_section_nav" id="dp_section_nav"></nav>
		<div class="dp-section-list" ui-view="dp_section_list" id="dp_section_list"></div>
		<div class="dp-section-page with-list" ui-view="dp_section_page" id="dp_section_page"></div>
	</div>
</div>

<script type="text/javascript">
window.DP_ASSET_URL      = '{{ asset('') }}';
window.DP_BASE_URL       = '/{{ path('user')|trim('/') }}';
window.DP_BASE_API_URL   = window.DP_BASE_URL+'api';
window.DP_BASE_ADMIN_URL = '/{{ path('adm')|trim('/') }}';
window.DP_API_TOKEN      = '{{ api_token.getKeyString() }}';
window.DP_PERSON_ID      = '{{ person.id }}';
</script>
<script
	type="text/javascript"
	data-main="{{ asset('app/admin/loader.js') }}"
	src="{{ asset('app/bower_components/requirejs/require.js') }}"
></script>
</body>
</html>