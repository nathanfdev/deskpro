<!DOCTYPE html>
<html ng-app>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width">
	<title>DeskPRO</title>
	<!--[if IE]><meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" /><![endif]-->

	<!--<link rel="stylesheet" href="{{ asset('app/bower_components/bootstrap/dist/css/bootstrap.min.css') }}"/>-->
	<link rel="stylesheet" href="{{ asset('app/bower_components/bootstrap-switch/static/stylesheets/bootstrap-switch.css') }}"/>
	<link rel="stylesheet" href="{{ asset('app/bower_components/font-awesome/css/font-awesome.min.css') }}"/>
	<link rel="stylesheet" href="{{ asset('app/bower_components/select2/select2.css') }}"/>
	<link rel="stylesheet" href="{{ asset('app/Admin/Resources/style/admin-style.css') }}"/>
</head>
<body>

<header class="dp-app-header">
	<div class="user-profile pull-left">
		<img class="gravatar pull-left" src="{{ app.user.getPictureUrl(32) }}">
		<div class="username">{{ phrase('agent.chrome.hello-user', {name: app.user.name}) }}</div>
		<ul class="nav-profile">
			<li id="user_settings_link"><i class="icon-cog"></i> <a>{{ phrase('agent.chrome.link_preferences') }}</a></li>
			<li id="dp_header_help_trigger"><i class="icon-question-sign"></i> <a>{{ phrase('agent.chrome.link_help') }}</a></li>
			<li onclick="window.location='{{ path('user_logout', {'auth': static_security_token('user_logout', 0)}) }}?to=agent'; return false;"><i class="icon-signout"></i> <a>{{ phrase('agent.chrome.link_logout') }}</a></li>
		</ul>
	</div>

	<div class="group pull-right">
		<a href="http://www.deskpro.com/" target="_blank" class="logo"></a>
	</div>
</header>

<div id="dp_main_view" ng-controller="Admin_Main_Ctrl_MainPage">
	<!-- Left Navigation Column -->
	<nav class="dp-app-nav">
		<ul>
			<li dp-state-mark="home" class="state-on"><a class="app-icon app-icon-home" href="#/">Home</a></li>
			<li dp-state-mark="setup"><a class="app-icon app-icon-cog" href="#/setup">Setup</a></li>
			<li dp-state-mark="agents" class=""><a class="app-icon app-icon-chat" href="#/agents">Agents</a></li>
			<li dp-state-mark="tickets" class=""><a class="app-icon app-icon-ticket" href="#/tickets">Tickets</a></li>
			<li dp-state-mark="crm" class=""><a class="app-icon app-icon-crm" href="#/crm">CRM</a></li>
			<li dp-state-mark="portal" class=""><a class="app-icon app-icon-publish" href="#/portal">Portal</a></li>
			<li dp-state-mark="chat" class=""><a class="app-icon app-icon-chat" href="#/chat">Chat</a></li>
			<li dp-state-mark="twitter" class=""><a class="app-icon app-icon-twitter" href="#/twitter">Twitter</a></li>
			<li dp-state-mark="apps" class=""><a class="app-icon app-icon-rate" href="#/apps">Apps</a></li>
			<li dp-state-mark="server" class=""><a class="app-icon app-icon-cog" href="#/server">Server</a></li>
		</ul>

		<ul class="btm">
			<li><a class="app-icon app-icon-home" href="#/back_to_agent">Back to Agent</a></li>
		</ul>
	</nav>
	<div class="dp-section" ui-view>
		<nav class="dp-section-nav sections-nav" ui-view="dp_section_nav" id="dp_section_nav"></nav>
		<div class="dp-section-body">
			<div class="dp-section-list" id="dp_section_list">
				<div class="dp-view-loading ng-hide" ng-show="loading.dp_section_list"><article><h1>Loading</h1></article></div>
				<div ui-view="dp_section_list" ng-hide="loading.dp_section_list"></div>
			</div>
			<div class="dp-section-page" id="dp_section_page">
				<div class="dp-view-loading ng-hide" ng-show="loading.dp_section_page"><article><h1>Loading</h1></article></div>
				<div ui-view="dp_section_page" ng-hide="loading.dp_section_page"></div>
			</div>
		</div>
	</div>
</div>

<script type="text/javascript">
window.DP_ASSET_URL      = '{{ asset('') }}';
window.DP_BASE_URL       = '/{{ path('user')|trim('/') }}';
window.DP_BASE_API_URL   = '{{ path('user')|rtrim('/') }}/api';
window.DP_BASE_ADMIN_URL = '{{ path('adm')|rtrim('/') }}';
window.DP_API_TOKEN      = '{{ api_token.getKeyString() }}';
window.DP_PERSON_ID      = '{{ person.id }}';
</script>
<script
	type="text/javascript"
	data-main="{{ asset('app/Admin/loader.js') }}"
	src="{{ asset('app/bower_components/requirejs/require.js') }}"
></script>
</body>
</html>