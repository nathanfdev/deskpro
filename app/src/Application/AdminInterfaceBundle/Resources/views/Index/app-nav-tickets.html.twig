{% extends 'AdminInterfaceBundle:Layout:app.html.twig' %}
{% import 'AdminInterfaceBundle:Index:app-nav-macros.html.twig' as nav %}
{% block nav_content %}
	{{ nav.list() }}
		{% if app.getSetting('experimental_admin_features') %}
			{{ nav.list_item_group('Triggers', 'fa-tasks') }}
				{{ nav.list_item('Email', ng_href('tickets.ticket_accounts'), 'tickets.ticket_accounts', 'fa-envelope') }}
				{{ nav.list_item('SMS', ng_href('tickets.channel_sms'), 'tickets.ticket_accounts', 'fa-group') }}
				{{ nav.list_item('Facebook', ng_href('tickets.channel_facebook'), 'tickets.ticket_accounts', 'fa-group') }}
			{{ nav.list_item_group_end() }}
		{% endif %}

		{{ nav.list_item('Departments', ng_href('tickets.ticket_deps'), 'tickets.ticket_deps', 'fa-briefcase') }}

		{%  if not app.getSetting('experimental_admin_features') %}
			{{ nav.list_item('Email Accounts', ng_href('tickets.ticket_accounts'), 'tickets.ticket_accounts', 'fa-envelope') }}
		{% endif %}

		{{ nav.list_item('Statuses', ng_href('tickets.statuses'), 'tickets.statuses', 'fa-ticket') }}
		{{ nav.list_item('Urgency', ng_href('tickets.urgency'), 'tickets.urgency', 'fa-exclamation') }}
		{{ nav.list_item('Fields', ng_href('tickets.fields'), 'tickets.fields', 'fa-terminal') }}

		{{ nav.list_item_group('Triggers', 'fa-tasks') }}
			{{ nav.list_subitem('New Ticket', ng_href('tickets.triggers', {type: "newticket"}), 'type:tickets.triggers.newticket', 'fa-user') }}
			{{ nav.list_subitem('New Reply', ng_href('tickets.triggers', {type: "newreply"}), 'type:tickets.triggers.newreply', 'fa-group') }}
			{{ nav.list_subitem('Ticket Update', ng_href('tickets.triggers', {type: "update"}), 'type:tickets.triggers.update', 'fa-group') }}
		{{ nav.list_item_group_end() }}

		{{ nav.list_item('Macros', ng_href('tickets.macros'), 'tickets.macros', 'fa-keyboard-o') }}
		{{ nav.list_item('Filters', ng_href('tickets.ticket_filters'), 'tickets.ticket_filters', 'fa-filter') }}
		{{ nav.list_item('Satisfaction', ng_href('tickets.satisfaction'), 'tickets.satisfaction', 'fa-smile-o') }}
		{{ nav.list_item('Escalations', ng_href('tickets.ticket_escalations'), 'tickets.ticket_escalations', 'fa-bolt') }}
		{{ nav.list_item('SLAs', ng_href('tickets.slas'), 'tickets.slas', 'fa-clock-o') }}
		{{ nav.list_item('Labels', ng_href('tickets.labels'), 'tickets.labels', 'fa-tags') }}
		{{ nav.list_item('Round Robin', ng_href('tickets.roundrobin'), 'tickets.roundrobin', 'fa-refresh') }}
		{{ nav.list_item('Time Log & Billing', ng_href('tickets.timelog_billing'), 'tickets.timelog_billing', 'fa-usd') }}
		{{ nav.list_item('Email Templates', ng_href('tickets.email_templates'), 'tickets.email_templates', 'fa-file-text') }}
		{{ nav.list_item('Forward Settings', ng_href('tickets.fwd_settings'), 'tickets.fwd_settings', 'fa-mail-forward') }}
		{{ nav.list_item('Settings', ng_href('tickets.settings'), 'tickets.settings', 'fa-cog') }}
	{{ nav.list_end() }}
{% endblock %}
