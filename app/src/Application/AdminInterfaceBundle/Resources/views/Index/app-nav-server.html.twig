{% extends 'AdminInterfaceBundle:Layout:app.html.twig' %}
{% import 'AdminInterfaceBundle:Index:app-nav-macros.html.twig' as nav %}
{% block nav_content %}
	{{ nav.list() }}
		{{ nav.list_item('Server Settings', ng_href('server.server_settings'), 'server.server_settings', 'fa-cog') }}
		{{ nav.list_item('ElasticSearch', ng_href('server.elastic_search'), 'setup.elastic_search', 'fa-search') }}
		{{ nav.list_item('Report File', ng_href('server.report_file'), 'server.report_file', 'fa-download') }}
		{{ nav.list_item('Server Requirements', ng_href('server.server_reqs'), 'server.server_reqs', 'fa-check-square-o') }}
		{{ nav.list_item('File Check', ng_href('server.file_check'), 'server.file_check', 'fa-shield') }}
		{{ nav.list_item('File Uploads', ng_href('server.file_uploads'), 'server.file_uploads', 'fa-upload') }}
		{{ nav.list_item('Scheduled Tasks', ng_href('server.cron'), 'server.cron', 'fa-clock-o') }}
		{{ nav.list_item('PHP Info', ng_href('server.php_info'), 'server.php_info', 'fa-info-circle') }}
		{{ nav.list_item('MySQL Info', ng_href('server.mysql_info'), 'server.mysql_info', 'fa-hdd-o') }}
		{{ nav.list_item('Error Logs', ng_href('server.error_logs'), 'server.error_logs', 'fa-exclamation') }}
	{{ nav.list_end() }}
{% endblock %}
