<div class="pane">
	<header class="pane-header">
		<h3 ng-if="TicketDepsEdit.dep.id">{{ phrase('adm.general.apps_tickets') }} &rarr; {{ phrase('adm.ticket_triggers.triggers') }} &rarr; {{ phrase('agent.general.edit') }} <em>{{ ng_var('TicketTriggersEdit.trigger.title') }}</em></h3>
		<h3 ng-if="!TicketDepsEdit.dep.id">{{ phrase('adm.general.apps_tickets') }} &rarr; {{ phrase('adm.ticket_triggers.triggers') }} &rarr; {{ phrase('adm.ticket_triggers.new_trigger') }}</h3>
	</header>
	<article class="pane-content no-pad">
		<form class="form-horizontal dp-form" role="form" name="form_props" ng-submit="TicketTriggersEdit.saveTrigger()">
			<div class="panel panel-fill indent">
				<br/>
				<div class="panel-body">
					<div class="form-group">
						<div class="col-lg-3">
							<h3>{{ phrase('agent.general.title') }} *</h3>
						</div>
						<div class="col-lg-9">
							<div class="inner-group" dp-error-class="form_props.title">
								<input type="text" class="form-control" name="title" ng-model="form.title" style="width: 50%;" required autofocus />
								<span class="help-block">
									{{ phrase('adm.ticket_triggers.title_explain') }}
								</span>
							</div>
						</div>
					</div>
					<div class="form-group">
						<div class="dp-ob-set">
							<div class="dp-ob-setrow">
								<header>
									<em class="if">If</em> All of the following conditions are met:
								</header>
								<article>
									<dp-option-builder types-def="TicketTriggersEdit.criteraTypeDef" ng-model="trigger_criteria">
										<select>
											<option value="0">Add criteria</option>
											<option value="department">Department</option>
											<option value="product">Product</option>
											<option value="category">Category</option>
											<option value="workflow">Workflow</option>
											<option value="priority">Priority</option>
										</select>
									</dp-option-builder>
								</article>
							</div>
							<div class="dp-ob-setrow">
								<header>
									<em class="and">And</em> Any of the following conditions are met:
								</header>
								<article>
									<dp-option-builder types-def="TicketTriggersEdit.criteraTypeDef" ng-model="trigger_criteria_any">
										<select>
											<option value="0">Add criteria</option>
											<option value="department">Department</option>
											<option value="product">Product</option>
											<option value="category">Category</option>
											<option value="workflow">Workflow</option>
											<option value="priority">Priority</option>
										</select>
									</dp-option-builder>
								</article>
							</div>
							<div class="dp-ob-setrow">
								<header>
									<em class="then">Then</em> The following actions will run:
								</header>
								<article>
									<dp-option-builder types-def="TicketTriggersEdit.criteraTypeDef" ng-model="trigger_actions">
										<select>
											<option value="0">Add action</option>
											<option value="department">Department</option>
											<option value="product">Product</option>
											<option value="category">Category</option>
											<option value="workflow">Workflow</option>
											<option value="priority">Priority</option>
										</select>
									</dp-option-builder>
								</article>
							</div>
						</div>
					</div>
				</div>
			</div>
		</form>
	</article>
</div>