<div class="pane">
	<header class="pane-header">
		<em class="obj-id" ng-if="TicketTriggersEdit.trigger.id" tooltip="This ID can be used in the API" tooltip-placement="left">
			ID: {{ ng_var('TicketTriggersEdit.trigger.id') }}
		</em>
		<h3 ng-if="TicketTriggersEdit.trigger.id">{{ phrase('adm.general.apps_tickets') }} &rarr; {{ phrase('adm.ticket_triggers.triggers') }} &rarr; {{ phrase('agent.general.edit') }} <em>{{ ng_var('TicketTriggersEdit.trigger.title') }}</em></h3>
		<h3 ng-if="!TicketTriggersEdit.trigger.id">{{ phrase('adm.general.apps_tickets') }} &rarr; {{ phrase('adm.ticket_triggers.triggers') }} &rarr; {{ phrase('adm.ticket_triggers.new_trigger') }}</h3>
	</header>
	<article class="pane-content no-pad">
		<form class="form-horizontal dp-form" role="form" name="form_props" ng-submit="TicketTriggersEdit.saveTrigger()">
			<div class="panel panel-fill indent">
				<br/>
				<div class="panel-body">
					<div class="form-group">
						<div class="col-lg-2">
							<h3>{{ phrase('agent.general.title') }} *</h3>
						</div>
						<div class="col-lg-10">
							<div class="inner-group" dp-error-class="form_props.title">
								<input type="text" class="form-control" name="title" ng-model="form.title" style="width: 50%;" required autofocus />
								<span class="help-block">
									{{ phrase('adm.ticket_triggers.title_explain') }}
								</span>
							</div>
						</div>
					</div>
					<div class="form-group">
						<div class="col-lg-2">
							<h3>Event</h3>
						</div>
						<div class="col-lg-10">
							<p ng-if="triggerType == 'newticket'">When a new ticket is created</p>
							<p ng-if="triggerType == 'newreply'">When a new reply is submitted</p>
							<p ng-if="triggerType == 'update'">When a property on a ticket is changed</p>

							<div>
								<div style="float: left; width: 55%">
									<label style="font-weight: normal;">
										<input type="checkbox" ng-model="form.by_user" value="1" />
										By a user
									</label>
									<div ng-show="form.by_user">
										&mdash; <label style="font-weight: normal;">
											<input type="checkbox" dp-tristate-check="form.by_user_opt.web_portal, form.by_user_opt.web_widget, form.by_user_opt.web_form" />
											via the web
										</label>
										<i class="icon-cog" ng-click="show_byuser_web = !show_byuser_web" style="cursor: pointer; color: #888"></i>
										<div style="margin-left: 11px; background: #efefef; border-radius: 2px; padding: 5px; padding-bottom: 0;" ng-show="show_byuser_web">
											<label style="font-weight: normal;"><input type="checkbox" ng-model="form.by_user_opt.web_portal" value="1" /> Portal</label>
											&nbsp;
											<label style="font-weight: normal;"><input type="checkbox" ng-model="form.by_user_opt.web_widget" value="1" /> Widget</label>
											&nbsp;
											<label style="font-weight: normal;"><input type="checkbox" ng-model="form.by_user_opt.web_form" value="1" /> Ticket Form</label>
										</div>
										<br/>
										&mdash; <label style="font-weight: normal;">
											<input type="checkbox" ng-model="form.by_user_opt.email" value="1" />
											via email
										</label><br/>
										&mdash; <label style="font-weight: normal;">
											<input type="checkbox" ng-model="form.by_user_opt.api" value="1" />
											via the API
										</label>
									</div>
								</div>
								<div style="float: left; margin-left: 10px; width: 35%">
									<label style="font-weight: normal;">
										<input type="checkbox" ng-model="form.by_agent" value="1" />
										By an agent
									</label>
									<div ng-show="form.by_agent">
										&mdash; <label style="font-weight: normal;">
											<input type="checkbox" ng-model="form.by_agent_opt.web" value="1" />
											via the agent interface
										</label><br/>
										&mdash; <label style="font-weight: normal;">
											<input type="checkbox" ng-model="form.by_agent_opt.email" value="1" />
											 via email
										</label><br/>
										&mdash; <label style="font-weight: normal;">
											<input type="checkbox" ng-model="form.by_agent_opt.api" value="1" />
											via the API
										</label>
									</div>
								</div>
								<br class="clear;" />
							</div>
						</div>
					</div>
					<div class="form-group">
						<div class="col-lg-2">
							<h3>Criteria</h3>
						</div>
						<div class="col-lg-10">
							<div class="dp-ob-set" dp-option-builder-set="{typedef: TicketTriggersEdit.criteraTypeDef, setsObject: trigger_criteria_set, template: 'ticket_deps_criteria_setrow' }">
								<div class="dp-ob-setrow">
									<header>
										<em class="dp-ob-row-tag if">if</em>
										When following conditions are met:
									</header>
									<article>
										<dp-option-builder types-def="TicketTriggersEdit.criteraTypeDef" ng-model="trigger_criteria_set.first" options="{tag_first: false, tag_after: 'and'}">
											<select>
												<option value="0">Add criteria</option>
												<option value="department">Department</option>
												<option value="product">Product</option>
												<option value="category">Category</option>
												<option value="workflow">Workflow</option>
												<option value="priority">Priority</option>
											</select>
										</dp-option-builder>
									</article>
								</div>
								<div class="dp-ob-addition-setrow">
									<script type="text/ng-template" id="ticket_deps_criteria_setrow">
										<div class="dp-ob-setrow">
											<header>
												<div class="remove-btn-wrap">
													<span class="removerow_btn"><i class="icon-remove"></i></span>
												</div>
												<em class="dp-ob-row-tag if">or</em>
												When following conditions are met:
											</header>
											<article>
												<dp-option-builder types-def="criteria_typedef" ng-model="criteria_set_row" options="{tag_first: false, tag_after: 'and'}">
													<select>
														<option value="0">Add criteria</option>
														<option value="department">Department</option>
														<option value="product">Product</option>
														<option value="category">Category</option>
														<option value="workflow">Workflow</option>
														<option value="priority">Priority</option>
													</select>
												</dp-option-builder>
											</article>
										</div>
									</script>
								</div>
								<div class="dp-ob-add-setrow">
									<div class="btn-wrap">
										<span><i class="add_btn icon-plus-sign"></i></span>
									</div>
									<label>Add another set of criteria</label>
								</div>
							</div>
						</div>
					</div>
					<div class="form-group">
						<div class="col-lg-2">
							<h3>Actions</h3>
						</div>
						<div class="col-lg-10">
							<div class="dp-ob-set">
								<div class="dp-ob-setrow">
									<header>
										The followings actions will run:
									</header>
									<article>
										<dp-option-builder types-def="TicketTriggersEdit.criteraTypeDef" ng-model="trigger_actions" options="{tag_first: 'then', tag_after: 'and'}">
											<select>
												<option value="0">Add action</option>
												<option value="department">Department</option>
												<option value="product">Product</option>
												<option value="category">Category</option>
												<option value="workflow">Workflow</option>
												<option value="priority">Priority</option>
											</select>
										</dp-option-builder>
									</article>
								</div>
							</div>
						</div>
					</div>
				</div>

				<div class="inner-footer">
					<div class="text-danger ng-hide" ng-show="form_props.$attempted && form_props.$invalid">
						<p><strong>{{phrase('adm.general.please_correct_errors')}}</strong></p>
						<ul>

						</ul>
					</div>
					<div class="text-center" ng-hide="form_props.$attempted && form_props.$invalid">
						<div dp-hide-spinning="saving_label">
							<button class="btn btn-primary" dp-submit-form>{{phrase('agent.general.save')}}</button>
						</div>
						<div dp-show-spinning="saving_label">
							<i class="spinner-flat"></i>
						</div>
					</div>
				</div>

			</div>
		</form>
	</article>
</div>