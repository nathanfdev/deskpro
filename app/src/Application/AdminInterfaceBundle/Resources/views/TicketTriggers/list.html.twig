<div class="pane">
	<header class="pane-header">
		<h3><i class="icon-briefcase"></i> {{ phrase('adm.general.apps_tickets') }} &rarr; {{ phrase('adm.ticket_triggers.triggers') }}</h3>
		<button class="btn help-page-trigger"><i class="icon-question-sign"></i></button>
	</header>
	<article class="pane-content no-pad">
		<div class="panel panel-fill">
			<div class="panel-heading">
				<nav class="dp-controls">
					<ul>
						<li>
							<span dp-ping-flash="run_orders" class="saved-ping"><i class="icon-check-sign"></i> {{ phrase('agent.general.saved') }}</span>
						</li>
						<li><span class="btn btn-danger" ng-class="{active: delete_mode}" ng-click="delete_mode = !delete_mode;"><i class="icon-trash"></i> {{ phrase('agent.general.delete') }}</span></li>
						<li><a class="btn btn-success" href="#/tickets/triggers/{{ ng_var('TicketTriggersList.eventType') }}/go-create"><i class="icon-plus"></i> {{ phrase('agent.general.add') }}</a></li>
					</ul>
				</nav>
				<h3 ng-pluralize count="TicketTriggersList.triggers.length" when="{{ ng_plural_phrase('adm.ticket_triggers.count_triggers') }}"></h3>
			</div>
			<ul class="dp-item-list" ui-sortable="TicketTriggersList.sortedListOptions" ng-if="TicketTriggersList.triggers.length">
				<li class="with-drag-handle with-row-toggle" ng-repeat="trigger in TicketTriggersList.triggers" dp-state-mark="tickets.triggers.edit.{{ ng_var('trigger.id') }}" data-id="{{ ng_var('trigger.id') }}">
					<a href="#/tickets/triggers/{{ ng_var('TicketTriggersList.eventType') }}/{{ ng_var('trigger.id') }}">
						<i class="icon-reorder drag-handle"></i>
						<div class="pull-right">
							<em class="tag" ng-if="trigger.by_agent">agent</em>
							<em class="tag" ng-if="trigger.by_user">user</em>
							<span class="badge" ng-hide="delete_mode" style="margin-top: -2px;" tooltip="The ID can be used in the API" tooltip-placement="left">ID: {{ ng_var('trigger.id') }}</span>
							<span class="btn btn-danger btn-xs only-icon" ng-show="delete_mode" style="margin-top: -3px;" ng-click="TicketTriggersList.startTriggerDelete(trigger); $event.preventDefault();"><i class="icon-trash"></i></span>
						</div>
						<button dp-toggle-switch ng-model="trigger.is_enabled" ng-change="TicketTriggersList.toggleTriggerEnabledState(trigger)"></button>
						<h4>
							<span class="title-text">{{ ng_var('trigger.display_title') }}</span>
						</h4>
					</a>
				</li>
			</ul>
			<p ng-if="!TicketTriggersList.triggers.length" style="padding: 15px;">
				{{ phrase('adm.ticket_triggers.no_triggers') }}
			</p>
		</div>
	</article>
</div>
{% include 'AdminInterfaceBundle:TicketTriggers:help-page.html.twig' %}