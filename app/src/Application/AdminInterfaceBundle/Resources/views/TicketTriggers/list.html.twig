{% extends 'AdminInterfaceBundle:Layout:list.html.twig' %}
{% block listpane_content %}
	<section class="dp-paneblock dp-listpane">
		<header>
			<nav>
				<span dp-ping-flash="run_orders" class="saved-ping"><i class="fa fa-check-square-o-square"></i> {{ phrase('agent.general.saved') }}</span>
			</nav>
			<h3 ng-pluralize count="List.triggers.length" when="{{ ng_plural_phrase('adm.ticket_triggers.count_triggers') }}"></h3>
		</header>
		<article>
			<p ng-if="!List.triggers.length" style="padding: 15px;">
				{{ phrase('adm.ticket_triggers.no_triggers') }}
			</p>
			<ul class="dp-item-list" ui-sortable="List.sortedListOptions" ng-if="List.triggers.length" dp-move-list-to-pos>

				{#######################}
				{# Department Triggers #}
				{#######################}

				<li class="with-drag-handle" data-id="departmentGroup" dp-li-group-section ng-if="List.depList.length" data-trigger-id="departments" data-move-to-pos="{{ ng_var('dep_order') }}">
					<a href="{{ ng_href('tickets.triggers', '{type: List.eventType}') }}" class="toggle">
						<i class="fa fa-bars drag-handle"></i>
						<div class="pull-right toggle-wrapper">
							<button dp-toggle-switch ng-model="List.depTriggersEnabled" ng-change="List.updateDepTriggersEnabledState();"></button>
						</div>
						<h4>
							<i class="fa fa-folder as-closed"></i>
							<i class="fa fa-folder-open as-open"></i>
							<span class="title-text"><span ng-pluralize count="List.depList.length" when="{{ ng_plural_phrase('adm.ticket_triggers.count_dep_triggers') }}"></span></span>
							&nbsp;
							<i class="fa fa-caret-down as-closed"></i>
							<i class="fa fa-caret-up as-open"></i>
						</h4>
					</a>
					<div class="group-section-wrapper">
						<div class="group-section-shadow"></div>
						<div class="group-section-content">
							<div class="help-box" ng-if="List.eventType == 'newticket'">
								Use these triggers if you want to perform actions based on the department a user selects when
								submitting a ticket from the web interface.
							</div>
							<div class="help-box" ng-if="List.eventType == 'update'">
								Use these triggers if you want to perform actions based on when the department is changed
								to a new department.
							</div>
							<ul class="dp-item-list" ng-if="List.eventType == 'newticket'">
								<li ng-repeat="dep in List.depList" dp-state-mark="id:tickets.triggers.editdep.department-{{ ng_var('dep.id') }}">
									<a href="{{ ng_href('tickets.triggers.editdep', "{type: List.eventType, id: 'department-' + dep.id}") }}">
										<h4><span class="title-text">{{ ng_var('dep.title') }}</span></h4>
									</a>
									<ul class="dp-item-list sublist" ng-show="dep.children.length">
										<li ng-repeat="subdep in dep.children" dp-state-mark="id:tickets.triggers.editdep.department-{{ ng_var('subdep.id') }}">
											<a href="{{ ng_href('tickets.triggers.editdep', "{type: List.eventType, id: 'department-' + subdep.id}") }}">
												<h4>
													<span class="tree-char middle" ng-if="!$last"></span>
													<span class="tree-char last" ng-if="$last"></span>
													<span class="title-text">{{ ng_var('subdep.title') }}</span>
												</h4>
											</a>
										</li>
									</ul>
								</li>
							</ul>
							<ul class="dp-item-list" ng-if="List.eventType == 'update'">
								<li ng-repeat="dep in List.depList" dp-state-mark="id:tickets.triggers.editdepchanged.department-changed-{{ ng_var('dep.id') }}">
									<a href="{{ ng_href('tickets.triggers.editdep', "{type: List.eventType, id: 'department-changed-' + dep.id}") }}">
										<h4><span class="title-text">{{ ng_var('dep.title') }}</span></h4>
									</a>
									<ul class="dp-item-list sublist" ng-show="dep.children.length">
										<li ng-repeat="subdep in dep.children" dp-state-mark="id:tickets.triggers.editdepchanged.department-changed-{{ ng_var('subdep.id') }}">
											<a href="{{ ng_href('tickets.triggers.editdep', "{type: List.eventType, id: 'department-changed-' + subdep.id}") }}">
												<h4>
													<span class="tree-char middle" ng-if="!$last"></span>
													<span class="tree-char last" ng-if="$last"></span>
													<span class="title-text">{{ ng_var('subdep.title') }}</span>
												</h4>
											</a>
										</li>
									</ul>
								</li>
							</ul>
						</div>
					</div>
				</li>

				{#######################}
				{# Email Acc Triggers  #}
				{#######################}

				<li class="with-drag-handle" data-id="emailGroup" dp-li-group-section ng-if="List.accounts.length" data-move-to-pos="{{ ng_var('emailaccount_order') }}" data-trigger-id="emailaccounts">
					<a href="{{ ng_href('tickets.triggers', '{type: List.eventType}') }}" class="toggle">
						<i class="fa fa-bars drag-handle"></i>
						<div class="pull-right toggle-wrapper">
							<button dp-toggle-switch ng-model="List.emailTriggersEnabled" ng-change="List.updateEmailTriggersEnabledState();"></button>
						</div>
						<h4>
							<i class="fa fa-folder as-closed"></i>
							<i class="fa fa-folder-open as-open"></i>
							<span class="title-text"><span ng-pluralize count="List.accounts.length" when="{{ ng_plural_phrase('adm.ticket_triggers.count_email_triggers') }}"></span></span>
							&nbsp;
							<i class="fa fa-caret-down as-closed"></i>
							<i class="fa fa-caret-up as-open"></i>
						</h4>
					</a>
					<div class="group-section-wrapper">
						<div class="group-section-shadow"></div>
						<div class="group-section-content">
							<div class="help-box">
								Use these triggers if you want to perform actions based on the email address a user sends
								a new ticket to.
							</div>

							<ul class="dp-item-list">
								<li ng-repeat="acc in List.accounts" dp-state-mark="id:tickets.triggers.editemailacc.emailaccount-{{ ng_var('acc.id') }}">
									<a href="{{ ng_href('tickets.triggers.editemailacc', "{type: List.eventType, id: 'emailaccount-' + acc.id}") }}">
										<h4><span class="title-text">{{ ng_var('acc.address') }}</span></h4>
									</a>
								</li>
							</ul>
						</div>
					</div>
				</li>

				{#######################}
				{# Custom Triggers     #}
				{#######################}

				<li class="with-drag-handle" ng-repeat="trigger in List.triggers" dp-state-mark="id:tickets.triggers.edit.{{ ng_var('trigger.id') }}" data-trigger-id="{{ ng_var('trigger.id') }}" data-run-order="{{ ng_var('trigger.run_order') }}">
					<a href="{{ ng_href('tickets.triggers.edit', '{type: List.eventType, id: trigger.id}') }}">
						<i class="fa fa-bars drag-handle"></i>
						<div class="pull-right toggle-wrapper">
							<button dp-toggle-switch ng-model="trigger.is_enabled" ng-change="List.updateTriggerEnabledState(trigger);"></button>
						</div>
						<div class="pull-right">
							<em class="tag" ng-if="trigger.by_agent">
								agent
								<span ng-if="trigger.event_trigger_options.by_agent.length == 3"><span>&rsaquo; all</span></span>
									<span ng-if="trigger.event_trigger_options.by_agent.length != 3">
										&rsaquo; <span dp-comma-separated>
											<span ng-if="trigger.event_trigger_options.by_agent.indexOf('web') !== -1">web</span>
											<span ng-if="trigger.event_trigger_options.by_agent.indexOf('email') !== -1">email</span>
											<span ng-if="trigger.event_trigger_options.by_agent.indexOf('api') !== -1">api</span>
										</span>
									</span>
							</em>
							<em class="tag" ng-if="trigger.by_user" style="margin-left: 6px;">
								user
								<span ng-if="trigger.event_trigger_options.by_user.length == 5"><span>&rsaquo; all</span></span>
									<span ng-if="trigger.event_trigger_options.by_user.length != 5">
										&rsaquo; <span dp-comma-separated>
											<span ng-if="trigger.event_trigger_options.by_user.indexOf('portal') !== -1 || trigger.event_trigger_options.by_user.indexOf('form') !== -1 || trigger.event_trigger_options.by_user.indexOf('widget') !== -1">web</span>
											<span ng-if="trigger.event_trigger_options.by_user.indexOf('email') !== -1">email</span>
											<span ng-if="trigger.event_trigger_options.by_user.indexOf('api') !== -1">api</span>
										</span>
									</span>
							</em>
							<span class="btn btn-danger btn-xs only-icon" ng-show="delete_mode" style="margin-top: -3px;" ng-click="List.startTriggerDelete(trigger); $event.preventDefault();"><i class="fa fa-trash-o"></i></span>
						</div>
						<h4>
							<span class="title-text">{{ ng_var('trigger.title') }}</span>
						</h4>
					</a>
				</li>
			</ul>
			<div class="dp-add-control">
				<a class="btn btn-default" href="{{ ng_href('tickets.triggers.gocreate', '{type: List.eventType}') }}" ng-class="{'active': isStateActive('.create') }"><i class="fa fa-plus"></i> {{ phrase('agent.general.add') }}</a>
			</div>
		</article>
	</section>
{% endblock %}
{% block listpane_help %}
	<header>

		<h1>Triggers are automatic processes that perform actions in response to ticket events.</h1>
		<p ng-if="List.eventType == 'newreply'">Triggers in this section can run when a <strong>new reply</strong> is made by a user or agent.</p>
		<p ng-if="List.eventType == 'newticket'">Triggers in this section can run when a <strong>new ticket</strong> is created.</p>
		<p ng-if="List.eventType == 'update'">Triggers in this section can run when a ticket is <strong>updated</strong>.</p>

	</header>

	<article>
		<section>
		
				<p>Triggers have <strong>criteria</strong> they check before they run their defined <strong>actions</strong>.</p>
		
				<p>The triggers are checked in order from the top down. You can drag them to change the order.</p>
			
		
<h2>Simple triggers</h2>		
				<p>DeskPRO automatically creates <strong>Department Triggers</strong> for each of your departments. They run when a user creates a ticket in the matching department via the web.</p>
			
				
				
				<p>There are also <strong>Email Account Triggers</strong> that run when a user submits a ticket via the matching email account.</p>
				
				<p>You can change the actions on these triggers to quickly carry out simple configuration changes like:</p>
				
					<ul>
						<li>assigning all tickets from an email account to a particular agent</li>
						<li>sending different acknowledgement emails based on department<li>
										
					</ul>
								
				<p>You can also view and edit these triggers from <strong>Tickets > Departments</strong> and <strong>Tickets > Email Accounts</strong>.</p>
	
	
	<h2> Advanced triggers</h2>
			
			
		
			<p>For advanced triggers, you can use the <strong>Event</strong> section to refine when the trigger is checked. You can choose to have the trigger respond only to user actions or only to agent actions; or to respond only to certain interfaces (email, web, the API etc.).</p>
			
			<p>If you are using an advanced trigger to send a response email, don't forget to disable the corresponding simple triggers to avoid sending the same email twice.</p>
	
		
			<p><strong>Actions</strong>, it can automatically do most of the things you would do to a ticket in the agent interface.</p>
			
			
			<p>
				Special <strong>Trigger Control</strong> actions can affect any following triggers lower in the list. The Stop Processing Triggers action prevents following triggers running. You can also use Prevent Emails to User or Prevent Emails to Agents to stop any email notifications that lower triggers try to send. These only prevent triggers that are running immediately afterwards - i.e. that are being checked due to the same user/agent action.
				
			</p>
		
				
		
							
		</section>
		
		<section>
			
			<h2><span>FAQ</span></h2>
		
			<dl>
				<dt><em>Q:</em>My triggers aren't behaving as I expect. How do I troubleshoot them?</dt>
				<dd><em>A:</em>
				You can see which triggers ran and in what order using the ticket <strong>Full Log</strong> tab in the agent interface.
				</dd>


			</dl>
			

		
		</section>
		
		<section>
		<h2><span>Related Content</span></h2>
		<ul>
			<li>[MANUAL]<a href="#ticket-triggers" target="_blank">Ticket triggers</a>
			<li>[MANUAL]<a href="#actions-guide" target="_blank">Actions guide</a>
			<li>[ARTICLE]<a href="https://support.deskpro.com/kb/articles/192" target="_blank">Send an email to the user when their ticket is assigned</a></li>
			<li>[ARTICLE]<a href="https://support.deskpro.com/kb/articles/193" target="_blank">Sending different auto-responses based on email address</a></li>
			<li>[ARTICLE]<a href="https://support.deskpro.com/kb/articles/194">Automatically assign agents to tickets they reply to by email</a></li>
		</ul>
	</section>
</article>
{% endblock %}