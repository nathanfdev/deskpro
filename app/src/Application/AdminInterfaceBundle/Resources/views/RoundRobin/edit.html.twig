{% extends 'AdminInterfaceBundle:Layout:list-editpane.html.twig' %}
{% block editpane_content %}
    <form role="form" name="Form" ng-submit="EditCtrl.save()">
        <section class="dp-paneblock dp-editpane">
            <article class="form-horizontal dp-form">
                <div class="panel panel-fill indent">
                    <div class="panel-body">
                        <div class="form-group">
                            <div class="col-lg-3">
                                <h3>{{phrase('adm.round_robins.title')}} *</h3>
                            </div>
                            <div class="col-lg-9">
                                <div class="inner-group" dp-error-class="Form.title">
                                    <input type="text" class="form-control" name="title" ng-model="EditCtrl.robin.title" style="width: 50%;" required autofocus/>
									<span class="help-block">
										{{phrase('adm.departments.title_explain')}}
									</span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-lg-3">
                                <h3>{{phrase('adm.round_robins.agents')}} *</h3>
                            </div>
                            <div class="col-lg-9">
                                <ul  class="checkbox-list" style="overflow-y: scroll; max-height: {{ 20 * 24 }}px;min-width: 250px;">
                                    <li ng-repeat="agent in EditCtrl.agents">
                                        <label style="width: 100%;">
                                            <input type="checkbox" ng-checked="EditCtrl.robin.agents.indexOf(agent) > -1"
                                                    ng-click="EditCtrl.handleAgent(agent); EditCtrl.sortAgents();" />
                                            {{ ng_var('agent.display_name') }}
                                            <span ng-if="EditCtrl.robin.next === agent" class="label label-default">{{ phrase('adm.round_robins.next') }} </span>
                                        </label>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-lg-9 col-lg-offset-3">
                                <span class="help-block">
					                {{ phrase('adm.round_robins.help_bulk') }}
				                </span>
                                <select ui-select2 ng-model="EditCtrl.bulk" style="width: 200px;">
                                    <optgroup label="Departments">
                                        <option ng-repeat="dep in EditCtrl.deps" value="d.{{ ng_var('dep.id') }}">
                                            {{ ng_var('dep.title') }}
                                        </option>
                                    </optgroup>
                                    <optgroup label="Teams">
                                        <option ng-repeat="team in EditCtrl.teams" value="t.{{ ng_var('team.id') }}">
                                            {{ ng_var('team.name') }}
                                        </option>
                                    </optgroup>
                                    <optgroup label="Permission Groups">
                                        <option ng-repeat="group in EditCtrl.groups" value="g.{{ ng_var('group.id') }}">
                                            {{ ng_var('group.title') }}
                                        </option>
                                    </optgroup>
                                </select>
                                &nbsp;<button class="btn btn-default" type="button" ng-click="EditCtrl.handleBulk()">Add</button>
                            </div>
                        </div>

                    </div>
                </div>
            </article>


            <footer>
                <div class="dp-content">
                    <div class="text-danger ng-hide" ng-show="Form.$attempted && Form.$invalid">
                        <p><strong>{{phrase('adm.general.please_correct_errors')}}</strong></p>
                        <ul>
                            <li ng-show="Form.label.$error.required">{{phrase('adm.general.label_edit_error')}}</li>
                        </ul>
                    </div>

                    <div class="dp-delete-control" ng-if="EditCtrl.robin.id">
                        <button type="button" class="btn btn-danger" ng-click="EditCtrl.delete()">Delete</button>
                    </div>

                    <div class="dp-btn-controls" ng-hide="Form.$attempted && Form.$invalid">
                        <div dp-hide-spinning="saving">
                            <button class="btn btn-primary" dp-submit-form>{{phrase('agent.general.save')}}</button>
                        </div>
                        <div dp-show-spinning="saving">
                            <i class="spinner-flat"></i>
                        </div>
                    </div>
                </div>
            </footer>
        </section>
    </form>

    <div dp-register-message="saved">Label {{ng_var('EditCtrl.robin.title')}} was saved successfully</div>
    <div dp-register-message="modal_title">Delete {{ng_var('EditCtrl.robin.title')}}</div>
    <div dp-register-message="modal_message">
        Are you sure you want to delete {{ng_var('EditCtrl.robin.title')}}? This operation could not be undone.
    </div>
{% endblock %}