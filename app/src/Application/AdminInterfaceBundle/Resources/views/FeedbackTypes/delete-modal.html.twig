<div>
	<div class="modal-header">
		<button type="button" class="close" ng-click="dismiss()">&times;</button>
		<h4 class="modal-title">{{ phrase('adm.feedback_types.delete_feedback_type') }}</h4>
	</div>
	<div class="modal-body">
		<p>
			{{ phrase('adm.feedback_types.delete_feedback_type_confirm') }}
		</p>

		<p>
			{{ phrase('adm.feedback_types.delete_feedback_types_moved') }}
		</p>

		<p style="margin-bottom: 0;">
			<select ui-select2 ng-model="selected.move_to_id" style="width: 240px">
				<option value="{{ ng_var('type.id') }}" ng-repeat="type in move_feedback_types_list">{{ ng_var('type.title') }}</option>
			</select>
		</p>
	</div>
	<div class="modal-footer">
		<button class="btn btn-success" ng-click="dismiss()"><i class="fa fa-undo"></i> {{ phrase('agent.general.cancel') }}</button>
		<button class="btn btn-danger" ng-click="confirm()"><i class="fa fa-trash-o"></i> {{ phrase('agent.general.delete') }}</button>
	</div>
</div>
