{% extends 'AdminInterfaceBundle:Layout:fullpage-pane.html.twig' %}
{% block fullpane_content %}
	<section class="dp-paneblock dp-panelink">
		<a href="{{ ng_href('tickets.ticket_accounts.emailsources') }}">
			<em><i class="fa fa-chevron-down"></i></em>
			<h3>Incoming Email</h3>
		</a>
	</section>

	<section class="dp-paneblock dp-listpane">
		<header>
			<nav class="dp-blocktabs">
				<menu>
					<button class="btn btn-default dropdown-toggle"><span><i class="fa fa-cog"></i></span> <i class="fa fa-caret-down"></i></button>
					<ul class="dropdown-menu pull-right">
						<li><a ng-click="ViewSource.startDelete()"><i class="fa fa-trash-o"></i> Delete Email</a></li>
						<li><a ng-click="ViewSource.startReprocess()"><i class="fa fa-repeat"></i> Reprocess Email</a></li>
					</ul>
				</menu>
			</nav>
			<h3>Email #{{ ng_var('ViewSource.source.id') }}</h3>
		</header>
		<table class="table">
			<tbody>
				<tr>
					<th width="140">Date</th>
					<td>{{ ng_var('ViewSource.source.date_created + " UTC" | amDateFormat:"MMM D, YYYY @ HH:mm"') }}</td>
				</tr>
				<tr>
					<th>Status</th>
					<td>
						{{ ng_var('ViewSource.source.status') }} ({{ ng_var('ViewSource.source.date_status + " UTC" | amDateFormat:"MMM D, YYYY @ HH:mm"') }})
						<div ng-if="ViewSource.source.status == 'error'">
							{{ ng_var('ViewSource.source.error_code') }} &mdash;
							<button class="btn btn-primary btn-xs" ng-click="ViewSource.startReprocess()">Reprocess Email</button>
						</div>
					</td>
				</tr>
				<tr ng-if="ViewSource.source.object_type">
					<th>Created Object</th>
					<td ng-switch="ViewSource.source.object_type">
						<div ng-switch-when="ticket">
							<div ng-if="ViewSource.ticket">
								New Ticket #{{ ng_var('ViewSource.ticket.id') }}: <a ng-href="../agent/#t:{{ ng_var('ViewSource.ticket.id') }}" target="_blank">{{ ng_var('ViewSource.ticket.subject') }}</a>
							</div>
							<div ng-if="!ViewSource.ticket">
								New Ticket #{{ ng_var('ViewSource.source.object_id') }} <em>(no longer exists)</em>
							</div>
						</div>
						<div ng-switch-when="ticket_message">
							<div ng-if="ViewSource.ticket_message">
								New Reply #{{ ng_var('ViewSource.ticket_message.id') }}
							</div>
							<div ng-if="!ViewSource.ticket_message">
								New Reply #{{ ng_var('ViewSource.source.object_id') }} <em>(no longer exists)</em>
							</div>
							<div ng-if="ViewSource.ticket">
								On Ticket #{{ ng_var('ViewSource.ticket.id') }}: <a ng-href="../agent/#t:{{ ng_var('ViewSource.ticket.id') }}" target="_blank">{{ ng_var('ViewSource.ticket.subject') }}</a>
							</div>
							<div ng-if="!ViewSource.ticket">
								<em>(Ticket no longer exists)</em>
							</div>
						</div>
						<div ng-switch-default>
							Unknown object: {{ ng_var('ViewSource.source.object_type') }} #{{ ng_var('ViewSource.source.object_id') }}
						</div>
					</td>
				</tr>
				<tr>
					<th>Account</th>
					<td>
						<a href="{{ ng_href('tickets.ticket_accounts.edit', '{id: ViewSource.source.email_account.id}') }}">
							{{ ng_var('ViewSource.source.email_account.address') }}
						</a>
					</td>
				</tr>
				<tr>
					<th>Raw "From"</th>
					<td>{{ ng_var('ViewSource.source.header_from') }}</td>
				</tr>
				<tr>
					<th>Raw "To"</th>
					<td>{{ ng_var('ViewSource.source.header_to') }}</td>
				</tr>
				<tr>
					<th>Raw "Subject"</th>
					<td>{{ ng_var('ViewSource.source.header_subject') }}</td>
				</tr>
				<tr>
					<th>
						Raw Source
						<br/>
						<a class="btn btn-default btn-xs" ng-href="{{ ng_var('ViewSource.source.blob.download_url') }}" target="_blank">Download</a>
					</th>
					<td>
						<textarea class="form-control" style="width: 95%; height: 300px; font-family: Monaco, Consolas, monospace;">{{ ng_var('ViewSource.source_raw') }}</textarea>
					</td>
				</tr>
				<tr ng-if="ViewSource.source.log_blob">
					<th>
						Process Log
						<br/>
						<a class="btn btn-default btn-xs" ng-href="{{ ng_var('ViewSource.source.log_blob.download_url') }}" target="_blank">Download</a>
					</th>
					<td>
						<textarea class="form-control" style="width: 95%; height: 300px; font-family: Monaco, Consolas, monospace;">{{ ng_var('ViewSource.source_log') }}</textarea>
					</td>
				</tr>
				<tr ng-if="ViewSource.source_info">
					<th>
						Status Context
					</th>
					<td>
						<textarea class="form-control" style="width: 95%; height: 180px; font-family: Monaco, Consolas, monospace;">{{ ng_var('ViewSource.source_info') }}</textarea>
					</td>
				</tr>
			</tbody>
		</table>
	</section>
{% endblock %}