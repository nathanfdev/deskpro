{% extends 'AdminInterfaceBundle:Layout:fullpage-pane.html.twig' %}
{% block fullpane_content %}
	<section class="dp-paneblock dp-panelink">
		<a href="{{ ng_href('tickets.ticket_accounts') }}">
			<em><i class="fa fa-chevron-down"></i></em>
			<h3>Email Accounts</h3>
		</a>
	</section>

	<section class="dp-paneblock dp-panelink">
		<a href="{{ ng_href('tickets.ticket_accounts.sendmailqueue') }}">
			<em><i class="fa fa-chevron-down"></i></em>
			<h3>Outgoing Email</h3>
		</a>
	</section>

	<section class="dp-paneblock dp-listpane">
		<header>
			<h3>Incoming Email</h3>
		</header>
		<article class="dp-padded">
			<div class="alert alert-info">
				<div ng-show="!filter_open">
					<div style="float:right; position: relative; top: 3px;" dp-hide-spinning="loading_page">
						<button type="button" class="btn btn-default btn-xs" ng-click="ListCtrl.updateFilter()"><i class="fa fa-refresh" style="margin:0;"></i></button>
					</div>
					Showing all incoming emails. <button class="btn" ng-click="filter_open = true"><i class="fa fa-filter"></i> Filter</button>
				</div>
				<div ng-show="filter_open">
					<table>
						<tr>
							<td width="50">Status</td>
							<td width="150">
								<select
									multiple
									ui-select2
									ng-model="ListCtrl.filter.statuses"
									style="width: 100%;"
								>
									<option value="inserted">Pending</option>
									<option value="processing">Processing</option>
									<option value="complete">Complete</option>
									<option value="rejected">Rejected</option>
									<option value="retry">Retry</option>
									<option value="error">Error</option>
								</select>
							</td>

							<td width="50" style="padding-left: 15px;">Account</td>
							<td width="150">
								<select ui-select2 ng-model="ListCtrl.filter.account">
									<option value="0">Any</option>
									<option ng-repeat="acc in email_accounts" value="{{ ng_var('acc.id') }}">{{ ng_var('acc.use_email_address') }}</option>
								</select>
							</td>

							<td width="50" style="padding-left: 15px;">Date</td>
							<td colspan="2">
								<select
									ui-select2
									ng-model="ListCtrl.filter_date_mode"
									style="width: 90px;"
								>
									<option value="none">&nbsp;</option>
									<option value="before">Before</option>
									<option value="after">After</option>
									<option value="between">Between</option>
								</select>
								<span ng-if="ListCtrl.filter_date_mode == 'after' || ListCtrl.filter_date_mode == 'between'">
									<input type="text" class="form-control" style="width: 140px; display: inline-block;" datepicker-popup="dd MMMM yyyy" ng-model="ListCtrl.filter_date1" datepicker-options="{'show-weeks': false}" />
								</span>
								<span ng-if="ListCtrl.filter_date_mode == 'before' || ListCtrl.filter_date_mode == 'between'">
									<input type="text" class="form-control" style="width: 140px; display: inline-block;" datepicker-popup="dd MMMM yyyy" ng-model="ListCtrl.filter_date2" datepicker-options="{'show-weeks': false}" />
								</span>
							</td>
						</tr>
						<tr>
							<td width="50">To</td>
							<td width="150">
								<input type="text" class="form-control" style="width: 200px; display: inline-block;"  ng-model="ListCtrl.filter.to" />
							</td>

							<td width="50" style="padding-left: 15px;">From</td>
							<td width="150">
								<input type="text" class="form-control" style="width: 200px; display: inline-block;"  ng-model="ListCtrl.filter.from" />
							</td>

							<td width="80" style="padding-left: 15px;">Subject</td>
							<td width="150">
								<input type="text" class="form-control" style="width: 200px; display: inline-block;"  ng-model="ListCtrl.filter.subject" />
							</td>
						</tr>
					</table>
					<div class="text-center" style="border-top: 1px solid #aed7e0; padding-top: 8px; margin-top: 8px;">
						<button class="btn btn-primary" ng-click="ListCtrl.updateFilter()">Filter</button>
						<button class="btn btn-default" ng-click="ListCtrl.clearFilter()">Clear Filter</button>
					</div>
				</div>
			</div>

			<table class="table">
				<colgroup>
					<col width="1%" />
					<col width="1%" />
					<col width="1%" />
					<col width="25%" />
					<col width="25%" />
					<col width="25%" />
					<col width="100%" />
					<col width="5%" />
					<col width="1%" />
				</colgroup>
				<thead>
					<tr>
						<th><input type="checkbox" ng-model="ListCtrl.massActionsAll" ng-change="ListCtrl.toggleMassActions()" /></th>
						<th>ID</th>
						<th>Date</th>
						<th>From</th>
						<th>To</th>
						<th>Account</th>
						<th>Subject</th>
						<th>Ticket</th>
						<th>Status <i class="fa fa-question-circle qmark-icon" ng-click="showStatusHelp()" tooltip="Click for more details" tooltip-placement="left" style="cursor: pointer;"></i></th>
					</tr>
				</thead>
				<tbody>
					<tr ng-repeat="result in ListCtrl.results">
						<td class=""><input type="checkbox" ng-model="ListCtrl.massActions[result.id]" ng-change="" style="margin: 0;" /></td>
						<td class="alt dp-id-col"><a href="{{ ng_href('tickets.ticket_accounts.emailsourcesview', '{id: result.id}') }}"><em class="dp-id">{{ ng_var('result.id') }}</a></td>
						<td style="white-space: nowrap" nowrap dp-date="result.date_created"></td>
						<td class="overflow-ellipsis">{{ ng_var('result.header_from') }}</td>
						<td class="overflow-ellipsis">{{ ng_var('result.header_to') }}</td>
						<td class="overflow-ellipsis">
							<a href="{{ ng_href('tickets.ticket_accounts.edit', '{id: result.email_account.id}') }}">
								{{ ng_var('result.email_account.use_email_address') }}
							</a>
						</td>
						<td class="overflow-ellipsis">{{ ng_var('result.header_subject') }}</td>
						<td nowrap>
							<div ng-if="result.object_info.ticket_id">
								<i class="fa fa-envelope"></i> <a ng-href="../agent/#t:{{ ng_var('result.object_info.ticket_id') }}" target="_blank">{{ ng_var('result.object_info.ticket_id') }}</a>
								<span ng-if="result.object_type == 'ticket_message'">(reply)</span>
							</div>
							<div ng-if="!result.object_info.ticket_id">
								<span ng-if="result.object_id == 0">
									&mdash;
								</span>
								<span ng-if="result.object_id != 0">
									<span ng-if="result.object_type == 'ticket'" title="New Ticket"><i class="fa fa-envelope"></i> {{ ng_var('result.object_id') }}</span>
									<span ng-if="result.object_type == 'ticket_message'" title="Reply to a ticket"><i class="fa fa-envelope-o"></i> {{ ng_var('result.object_id') }}</span>
								</span>
							</div>
						</td>
						<td nowrap ng-class="{'danger': result.status == 'error', 'warning': result.status == 'rejected', 'success': result.status == 'complete'}">
							{{ ng_var('result.status | uppercase') }}
							<span ng-if="result.error_code" ng-switch="result.error_code">
								&middot; {{ ng_var('result.error_code') }} <i class="fa fa-question-circle qmark-icon" ng-click="showStatusHelp(result.error_code)" tooltip="Click for more details" tooltip-placement="left" style="cursor: pointer;"></i>
							</span>
						</td>
					</tr>
				</tbody>
			</table>

			<div ng-show="ListCtrl.hasAnyMassActions()">
				With selected: <select ng-model="ListCtrl.massActionsOp" ui-select2>
					<option value="reprocess">Reprocess Emails</option>
					<option value="delete">Delete Emails</option>
				</select>
				<button ng-hide="massActionsLoading" class="btn btn-primary" type="button" ng-click="ListCtrl.performMassActions()">Perform Actions &rarr;</button>
				<span ng-show="massActionsLoading"><i class="spinner-flat"></i></span>

				<div ng-switch="ListCtrl.massActionsOp" style="width: 400px;" class="help-block">
					<div ng-switch-when="reprocess">
						<i class="fa fa-question-circle"></i> Reprocess Emails: By selecting this option, you will reschedule the
						selected emails for processing. The system will process the emails the next time the email queue is processed.
					</div>
					<div ng-switch-when="delete">
						<i class="fa fa-question-circle"></i> Delete: Deleting the email will remove the raw email source and processing
						log from the system. If the email is already processed (e.g., a ticket or ticket message was created),
						that will remain. If the email is NOT already processed, it never will be.
					</div>
				</div>
			</div>

			<div style="text-align: center;" dp-show-spinning="loading_page"><i class="spinner-flat"></i></div>

			<div class="dp-btn-pagination">
				<button class="btn" ng-show="ListCtrl.page != 1" ng-click="ListCtrl.goPrevPage()">&lt; Prev</button>
				<select
					ng-model="ListCtrl.page"
					ui-select2
					style="width: 130px;"
				>
					<option ng-repeat="page in ListCtrl.page_nums" value="{{ ng_var('page') }}">Page {{ ng_var('page') }}</option>
				</select>
				<button class="btn" ng-show="ListCtrl.page < ListCtrl.num_pages" ng-click="ListCtrl.goNextPage()">Next &gt;</button>
			</div>
		</article>
	</section>

	<div dp-register-message="reprocess_done">The selected emails have been scheduled for reprocessing.</div>
	<div dp-register-message="delete_done">The selected emails have been deleted.</div>

	{{ ng_tpl('AdminInterfaceBundle:EmailStatus:emailsource-status-code-modal.html.twig', 'EmailStatus/emailsource-status-code-modal.html') }}
{% endblock %}
