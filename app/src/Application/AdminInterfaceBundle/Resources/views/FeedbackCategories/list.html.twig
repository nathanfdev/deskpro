<div class="pane">
	<header class="pane-header">
		<h3><i class="fa fa-folder-open"></i> {{ phrase('adm.general.apps_portal') }} &rarr; {{ phrase('agent.general.feedback') }} &rarr; {{ phrase('agent.general.categories') }}</h3>
		<button class="btn help-page-trigger"><i class="fa fa-question-circle"></i></button>
	</header>
    <article class="pane-content no-pad">
        <div class="panel panel-fill">
            <div class="panel-heading">
                <nav class="dp-controls">
                    <ul>
                        <li>
                            <span dp-ping-flash="display_orders" class="saved-ping">
								<i class="fa fa-check-square-o-square"></i>
								{{ phrase('agent.general.saved') }}
							</span>
                        </li>
                        <li>
                            <span class="btn btn-danger" ng-class="{active: delete_mode}" ng-click="delete_mode = !delete_mode;">
								<i class="fa fa-trash-o"></i>
								{{ phrase('agent.general.delete') }}
							</span>
                        </li>
                        <li>
                            <a class="btn btn-success" href="{{ ng_href('portal.feedback_categories.gocreate') }}">
                                <i class="fa fa-plus"></i> {{ phrase('agent.general.add') }}
                            </a>
                        </li>
                    </ul>
                </nav>
                <h3 ng-pluralize count="FeedbackCategoriesList.feedback_categories.length || 0" when="{{ ng_plural_phrase('adm.general.x_feedback_categories') }}"></h3>
            </div>
            <ul class="dp-item-list" ui-sortable="FeedbackCategoriesList.sortedListOptions">
                <li class="with-drag-handle" ng-repeat="category in FeedbackCategoriesList.parent_data" dp-state-mark="portal.feedback_categories.edit.{{ ng_var('category.id') }}" data-id="{{ ng_var('category.id') }}">
                    <a href="{{ ng_href('portal.feedback_categories.edit', '{id: category.id}') }}">
                        <i class="fa fa-bars drag-handle"></i>
                        <div class="pull-right">
                            <span class="badge" ng-hide="delete_mode" style="margin-top: -2px;" tooltip="The ID can be used in the API" tooltip-placement="left">
                                ID: {{ ng_var('category.id') }}
                            </span>
                            <span class="btn btn-danger btn-xs only-icon" ng-show="delete_mode" style="margin-top: -3px;" ng-click="FeedbackCategoriesList.startDelete(category); $event.preventDefault();">
                                <i class="fa fa-trash-o"></i>
                            </span>
                        </div>
                        <h4><span class="title-text">{{ ng_var('category.title') }}</span></h4>
                    </a>

					<ul class="dp-item-list sublist" ng-if="FeedbackCategoriesList.child_data[category.id]" ui-sortable="FeedbackCategoriesList.sortedListOptions">
						<li class="with-drag-handle" ng-repeat="sub_category in FeedbackCategoriesList.child_data[category.id]" dp-state-mark="portal.feedback_categories.edit.{{ ng_var('sub_category.id') }}" data-id="{{ ng_var('sub_category.id') }}">
							<a href="{{ ng_href('portal.feedback_categories.edit', '{id: sub_category.id}') }}">
								<i class="fa fa-bars drag-handle"></i>

								<div class="pull-right">
									<span class="badge" ng-hide="delete_mode" style="margin-top: -2px;" tooltip="The ID can be used in the API" tooltip-placement="left">
										ID: {{ ng_var('sub_category.id') }}
									</span>
									<span class="btn btn-danger btn-xs only-icon " ng-show="delete_mode" style="margin-top: -3px;" ng-click="FeedbackCategoriesList.startDelete(sub_category); $event.preventDefault();">
										<i class="fa fa-trash-o"></i>
									</span>
								</div>
								<h4>
									<span class="tree-char middle" ng-if="!$last"></span>
									<span class="tree-char last" ng-if="$last"></span>
									<span class="title-text">{{ ng_var('sub_category.title') }}</span>
								</h4>
							</a>
						</li>
					</ul>

                </li>
            </ul>
        </div>
    </article>
</div>
<div dp-register-message="saved_settings">{{ phrase('adm.general.save_settings_success') }}</div>
{% include 'AdminInterfaceBundle:FeedbackCategories:help-page.html.twig' %}