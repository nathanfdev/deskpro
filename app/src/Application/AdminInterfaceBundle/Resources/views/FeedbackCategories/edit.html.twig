<div class="pane">
	<header class="pane-header">
		<h3 ng-if="FeedbackCategoriesEdit.feedback_category.id">{{ phrase('adm.general.apps_portal') }} &rarr; {{ phrase('agent.general.feedback') }} &rarr; {{ phrase('agent.general.edit') }} <em>{{ ng_var('FeedbackCategoriesEdit.feedback_category.title') }}</em></h3>
		<h3 ng-if="!FeedbackCategoriesEdit.feedback_category.id">{{ phrase('adm.feedback_categories.new_category') }}</h3>
	</header>
	<article class="pane-content no-pad">
		<form class="form-horizontal dp-form" role="form" name="form_props" ng-submit="FeedbackCategoriesEdit.saveForm()">

			<div class="panel-body">
				<div class="form-group">
					<div class="col-lg-3">
						<h3>{{ phrase('adm.feedback_categories.title') }} *</h3>
					</div>
					<div class="col-lg-9">
						<div class="inner-group" dp-error-class="form_props.title">
							<input type="text" class="form-control" name="title" ng-model="FeedbackCategoriesEdit.feedback_category.title" style="width: 50%;" required autofocus/>
							<span class="help-block">
								{{ phrase('adm.feedback_categories.title_explain') }}
							</span>
						</div>
					</div>
				</div>

				<div class="form-group">
					<div class="col-lg-3">
						<h3>{{ phrase('agent.general.parent') }}</h3>
					</div>
					<div class="col-lg-9">
						<select
								ui-select2
								ng-model="FeedbackCategoriesEdit.feedback_category.options.parent_id"
								style="min-width: 240px"
								class="no-search"
								>
							<option value="{{ ng_var('category.id') }}" ng-repeat="category in FeedbackCategoriesEdit.feedback_categories_parent_list">{{ ng_var('category.title') }}</option>
						</select>
						<span class="help-block">
							{{ phrase('adm.feedback_categories.parent_explain') }}
						</span>
					</div>
				</div>
			</div>

			<div class="inner-footer">
				<div class="text-danger ng-hide" ng-show="form_props.$attempted && form_props.$invalid">
					<p><strong>{{ phrase('adm.general.please_correct_errors') }}</strong></p>
					<ul>
						<li ng-show="form_props.title.$error.required">{{ phrase('adm.feedback_categories.title_error') }}</li>
					</ul>
				</div>

				<div class="text-center" ng-hide="form_props.$attempted && form_props.$invalid">
					<div dp-hide-spinning="saving_feedback_category">
						<button class="btn btn-primary" dp-submit-form>{{ phrase('agent.general.save') }}</button>
						<button class="btn btn-default" ng-click="FeedbackCategoriesEdit.resetForm()">{{ phrase('agent.general.reset') }}</button>
					</div>
					<div dp-show-spinning="saving_feedback_category">
						<i class="spinner-flat"></i>
					</div>
				</div>
			</div>
		</form>
	</article>
	<div dp-register-message="saved_feedback_category">{{ ng_var('FeedbackCategoriesEdit.feedback_category.title') }} was saved successfully</div>
</div>