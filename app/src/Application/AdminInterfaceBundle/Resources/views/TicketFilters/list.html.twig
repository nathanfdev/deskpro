<div class="pane">
	<header class="pane-header">
		<h3><i class="icon-briefcase"></i> {{ phrase('adm.general.apps_tickets') }} &rarr; {{ phrase('adm.ticket_filters.filters') }}</h3>
		<button class="btn help-page-trigger"><i class="icon-question-sign"></i></button>
	</header>
	<article class="pane-content no-pad">
		<div class="panel panel-fill">
			<div class="panel-heading">
				<nav class="dp-controls">
					<ul>
						<li>
							<span dp-ping-flash="run_orders" class="saved-ping"><i class="icon-check-sign"></i> {{ phrase('agent.general.saved') }}</span>
						</li>
						<li><span class="btn btn-danger" ng-class="{active: delete_mode}" ng-click="delete_mode = !delete_mode;"><i class="icon-trash"></i> {{ phrase('agent.general.delete') }}</span></li>
						<li><a class="btn btn-success" href="{{ ng_href('tickets.filters.gocreate') }}"><i class="icon-plus"></i> {{ phrase('agent.general.add') }}</a></li>
					</ul>
				</nav>
				<h3 ng-pluralize count="ListCtrl.list.length" when="{{ ng_plural_phrase('adm.ticket_filters.count_filters') }}"></h3>
			</div>
			<ul class="dp-item-list" ui-sortable="ListCtrl.sortedListOptions" ng-if="ListCtrl.list.length">
				<li class="with-drag-handle" ng-repeat="filter in ListCtrl.list" dp-state-mark="tickets.filters.edit.{{ ng_var('filter.id') }}" data-id="{{ ng_var('filter.id') }}">
					<a href="{{ ng_href('tickets.filters.edit', '{id: filter.id}') }}">
						<i class="icon-reorder drag-handle"></i>
						<div class="pull-right">
							<em class="tag"style="margin-left: 6px;">
								<span ng-if="filter.is_global">global</span>
								<span ng-if="filter.person_id">{{ ng_var('filter.person.display_name') }}</span>
								<span ng-if="filter.agent_team_id">{{ ng_var('filter.agent_team.name') }}</span>
							</em>
							<span class="btn btn-danger btn-xs only-icon" ng-show="delete_mode" style="margin-top: -3px;" ng-click="ListCtrl.startDelete(filter); $event.preventDefault();"><i class="icon-trash"></i></span>
						</div>
						<h4>
							<span class="title-text">{{ ng_var('filter.title') }}</span>
						</h4>
					</a>
				</li>
			</ul>
			<p ng-if="!ListCtrl.list.length" style="padding: 15px;">
				{{ phrase('adm.ticket_filters.no_filters') }}
			</p>
		</div>
	</article>
</div>

{{ ng_tpl('AdminInterfaceBundle:TicketFilters:delete-modal.html.twig') }}
{% include 'AdminInterfaceBundle:TicketFilters:help-page.html.twig' %}