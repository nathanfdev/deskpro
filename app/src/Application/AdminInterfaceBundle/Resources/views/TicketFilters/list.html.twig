{% extends 'AdminInterfaceBundle:Layout:list.html.twig' %}

{% block listpane_content %}

<!-- Admin items sidebar -->
<div class="admin-content-sidebar">
<div class="admin-content-sidebar-panel">
	<div class="admin-sidebar-header">
	<h1>Filter Sets</h1><i class="fa fa-question-circle"></i>
	</div>

	<div class="admin-sidebar-content">
    	<ul class="admin-list" ui-sortable="ListCtrl.sortedListOptions" ng-if="ListCtrl.list.length">
    		<li class="with-drag-handle" ng-repeat="filter in filterList" data-id="{{ ng_var('filter.id') }}">
    			<a href="{{ ng_href('tickets.ticket_filters.edit', '{id: filter.id}') }}" class="item">
                    <i class="fa fa-bars drag-handle"></i>
                    {{ ng_var('filter.title') }}
                </a>
    		</li>
    		<li ng-show="foobar.addingNewFilterSet" class="ng-hide">
    			<input type="text" ng-model="foobar.new_filterset_name" placeholder="My new filter set" />
    			<button class="btn btn-primary" ng-href="#here" ng-click="addFilterSet()">Save</button>
    			<button ng-click="foobar.addingNewFilterSet=false" class="btn btn-danger">cancel</button>
    		</li>
    	</ul>

    	<div class="sidebar-content-wrapper">
    		<button ng-click="foobar.addingNewFilterSet=true" class="sidebar-control">Create a new filter set</button>
    	</div>
	</div>
</div>

<div class="admin-content-sidebar-panel">
	<div class="admin-sidebar-header">
	<h1>Filter Views</h1><i class="fa fa-question-circle"></i>
	</div>

	<div class="admin-sidebar-content">
    	<ul class="admin-list" ng-if="ListCtrl.viewList.length">
    		<li class="with-drag-handle" ng-repeat="filterView in filterViewList" data-id="{{ ng_var('filterView.id') }}">
    			<a href="{{ ng_href('tickets.ticket_filters.edit_view', '{id: filterView.id}') }}" class="item">
                    <i class="fa fa-bars drag-handle"></i>
                    {{ ng_var('filterView.title') }}
                </a>
    		</li>
    		<li ng-show="foobar.addingNewFilterView" class="ng-hide">
    			<input type="text" ng-model="foobar.new_filterset_name" placeholder="My new filter set" />
    			<button class="btn btn-primary" ng-href="#here" ng-click="addFilterSet()">Save</button>
    			<button ng-click="foobar.addingNewFilterSet=false" class="btn btn-danger">cancel</button>
    		</li>
    	</ul>

    	<div class="sidebar-content-wrapper">
    		<button ng-click="foobar.addingNewFilterSet=true" class="sidebar-control">Add a filter view</button>
    	</div>
	</div>
</div>

<div class="admin-content-sidebar-panel">
	<div class="admin-sidebar-header">
	<h1>Manage Agent Filters</h1><i class="fa fa-question-circle"></i>
	</div>

	<div class="admin-sidebar-content">
	<ul class="admin-list">
		<li>
		<a style="background-image: url(./img/avatar.jpg)" class="chat-avatar"></a>
		<a href="#" class="item">Nelson Manning</a>
		</li>
		<li>
		<a style="background-image: url(./img/avatar5.png)" class="chat-avatar"></a>
		<a href="#" class="item">Cameron Sauders</a>
		</li>
		<li>
		<a style="background-image: url(./img/avatar6.png)" class="chat-avatar"></a>
		<a href="#" class="item">Caitlin Fraser</a>
		</li>
	</ul>
	</div>
</div>
</div>
<!-- End Admin items sidebar -->


{% endblock %}
{% block listpane_help %}

{% endblock %}
