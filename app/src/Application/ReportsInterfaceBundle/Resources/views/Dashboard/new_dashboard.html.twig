<section class="popup">

    <!-- Popup Header & Title -->
    <header>
        <h1>Create new dashboard</h1>
        <div class="controls"><a ng-click="cancel()"><i class="fa fa-times"></i></a></div>
    </header>

    <!-- Popup Sidebar -->
    <div class="popup-sidebar" style="height: 579px;"><!-- Need to calculate the height of popup with js and update the sidebar -->
        <div class="popup-sidebar-content">
            <ul>
                <li ng-class="{'active': state == 'info'}">
                    <a ng-click="state = 'info'">Dashboard Info</a>
                </li>
                {#<li ng-class="{'active': state == 'permissions'}">
                    <a ng-click="state = 'permissions'" >Agent Permissions</a>
                </li>#}
            </ul>
        </div>
    </div>
    <!-- End Popup Sidebar -->



    <!-- Popup Content -->
    <div class="popup-content">
        <!-- Content Form -->
        {# FFFFFFFFFUUUUUUUU #}
        <form ng-show="state == 'info'" class="popup-form-default">

            <!-- Form Row (left label, input & possible side content) -->
            <div class="bucket">
                <label class="label">Dashboard Title:</label>
                <div class="bucket-column"><input type="text" ng-model="dashboard.title" placeholder="Name of your new dashboard"></div>
            </div>
            <!-- End Form Row -->

            <hr>

            <h2>Create reports for this dashboard</h2>

            <div class="bucket" ng-if="!report.deleted" ng-repeat="report in dashboard.reports">
                <label class="label"><i class="fa fa-bars"></i></label>
                <div class="bucket-column-last">
                    <span class="meta"><a ng-click="removeReport(report)">Remove</a></span>
                </div>
                <div class="bucket-column">
                    <input type="text" ng-model="report.title" placeholder="Report title">
                    <ul ng-if="report.cloning" class="clone-list">
                        <li ng-repeat="db in dashboards track by $index"
                            ng-class="{'current': db.id === dashboard.id, 'expanded': isExpanded(db)}">

                            <a ng-show='!isExpanded(db)' ng-click="expandDashboard(db)" class="control"><i class="fa fa-plus-square-o"></i></a>
                            <a ng-show='isExpanded(db)' ng-click="collide(db)" class="control">
                                <i class="fa fa-minus-square-o"></i>
                            </a>

                            <a>{{ ng_var('db.title') }} <span ng-show="db.id === dashboard.id">(Your current dashboard)</span></a>
                            <ul ng-show='isExpanded(db) && db.reports.length > 0'>
                                <li ng-repeat="rp in db.reports track by $index">
                                    <a ng-click="cloneReport(rp)">{{ ng_var('rp.title') }}</a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>

            <hr>

            <div class="bucket">
                <label class="label">Reports:</label>
                <div class="bucket-column">
                    <a ng-click="addNewReport()" class="button button-secondary half-width">Add new report</a>
                    <a ng-click="cloneExisting()" class="button button-secondary half-width">Clone existing report</a>
                </div>
            </div>

        </form>

        <div ng-show="state == 'permissions'" class="popup-blurb">
            <h2>Choose agents that can see this dashboard</h2>
            <p>Bit of text about the agents and the dashboard</p>
        </div>

        <div ng-show="state == 'permissions'" class="agent-list">
            <table>
                <thead>
                <td class="agent-name"></td>
                <td>View</td>
                <td>Edit</td>
                </thead>

                <tr ng-repeat="agent in permissions track by agent.id">
                    <td class="agent-name">
                        <span class="avatar" style="background-image: url({{ ng_var('agent.avatar') }})"></span>
                        {{ ng_var('agent.name') }}
                    </td>
                    <td>
                        <span class="c-check">
                            <input ng-click='setPermissions(agent, 1)'
                                   ng-checked="agent.permissions == 1 || agent.permissions == 2"
                                   type="checkbox"
                                   id="checkbox1_{{ ng_var('$index') }}">
                            <label for="checkbox1_{{ ng_var('$index') }}"></label>
                        </span>
                    </td>
                    <td>
                        <span class="c-check">
                            <input ng-click='setPermissions(agent, 2)'
                                   ng-checked="agent.permissions == 2"
                                   type="checkbox"
                                   id="checkbox2_{{ ng_var('$index') }}">
                            <label for="checkbox2_{{ ng_var('$index') }}"></label>
                        </span>
                    </td>
                </tr>

            </table>
        </div>
    </div>

    <footer>
        <a ng-click="saveDashboard()" class="button">Save Changes</a>
    </footer>
    <!-- End Popup Content -->

</section>

<div class="cover"></div><!-- Transparent background to the popup -->