<div class="modal-header">
    <h3 class="modal-title">New dashboard</h3>
</div>
<div class="modal-body">
    <form role="form">
        <div class="form-group">
            <label for="name">Name</label>
            <input type="text"
                   class="form-control"
                   ng-model="ReportsModalInstanceCtrl.newDashboard.name"
                   id="name"
                   placeholder="Enter name">
        </div>
        <div class="form-group">
            <label for="cols">Columns</label>
            <input
                    type="number"
                    class="form-control"
                    ng-model="ReportsModalInstanceCtrl.newDashboard.cols"
                    id="cols"
                    placeholder="Enter columns"
                    >
        </div>


    </form>
</div>
<div class="modal-footer">
    <button
            class="btn btn-primary"
            ng-click="ReportsModalInstanceCtrl.createDashboard()">
        Create
    </button>
    <button
            class="btn btn-warning"
            ng-click="ReportsModalInstanceCtrl.cancel()">
        Cancel
    </button>
</div>