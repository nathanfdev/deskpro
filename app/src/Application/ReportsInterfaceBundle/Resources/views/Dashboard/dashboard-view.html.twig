<header class="reports-header">
    <div class="right">
        <div class="report-access-avatars">
            <span class="title">On this dashboard:</span>
            <a
                ng-repeat='agent in (filteredPermissions = (dashboard.permissions | filter:permissionsFilter) | limitTo:6) track by $index '
                class="avatar"
                title="{{ ng_var('agent.name') }}"
                style="background-image: url({{ ng_var('agent.avatar') }});">
            </a>
            <a ng-if="filteredPermissions.length > 6" class="avatar avatar-blank"><span>+{{ ng_var('filteredPermissions.length - 6') }}</span></a>
            <a ng-click="openEdit('permissions')" class="avatar edit-access-link"><span>Edit Agent Access <i class="fa fa-user"></i></span></a>
        </div>
    </div>

    <div class="left">
        <div class="dashboard-main-list" dp-dropdown="dp-select-dashboard-dropdown" dp-dropdown-opener="dp-select-dashboard-opener">
            <a class="link-pointer" id="dp-select-dashboard-opener">
                <span>Dashboard:</span>
                <span class='logo-deskpro' ng-if="dashboard.is_default"></span>
                {{ ng_var('dashboard.title') }} <i class="fa fa-sort"></i>
            </a>

            <ul id="dp-select-dashboard-dropdown">
                <li class="type-heading">
                    <span>Built-in Dashboards</span>
                </li>
                <li ng-repeat="db in (dashboards|filter:defaultDashboardsFilter) track by db.id">
                    <a class='link-pointer' ui-sref-active="current" dp-dropdown-item ui-sref="reports.dashboards.view.index({ dashboard_id: db.id })">
                        <span class='logo-deskpro'></span>
                        {{ ng_var('db.title') }}
                    </a>
                </li>
                <li class="type-heading">
                    <a ng-click="openCreate()"><i class="fa fa-plus"></i> Create</a>
                    <span>Custom Dashboards</span>
                </li>
                <li ng-repeat="db in (dashboards|filter:customDashboardsFilter) track by db.id">
                    <a class='link-pointer' ui-sref-active="current" dp-dropdown-item ui-sref="reports.dashboards.view.index({ dashboard_id: db.id })">
                        {{ ng_var('db.title') }}
                    </a>
                </li>
            </ul>
        </div>

        <nav class="reports-control">
            <ul>
                <li ng-show="!dashboard.is_default"><a class='link-pointer' ng-click="openEdit()"><i class="fa fa-cog"></i> Edit Dashboard</a></li>
                <li>
                    <a ng-click="openCreate()" class='link-pointer' id="dp-add-dashboard-opener"><i class="fa fa-plus"></i>Create Dashboard</a>
                </li>
                <li ng-show="!dashboard.is_default"><a class='link-pointer' ng-click="deleteDashboard(dashboard)"><i class="fa fa-times"></i> Delete Dashboard</a></li>
            </ul>
        </nav>
        <hr>
    </div>
</header>

<div class="report-tabs">
    <ul>
        <li dp-dropdown="dp-add-report-dropdown" dp-dropdown-opener="dp-add-report-opener" dp-dropdown-closer="dp-add-report-closer" ng-if='!dashboard.default' class="add-report-link">
            <a id="dp-add-report-dropdown-opener" class='link-pointer'><i class="fa fa-plus"></i></a>
        </li>

        <li ng-if="!report.deleted" ng-repeat="report in dashboard.reports track by $index" ui-sref-active="active-tab">
            <a class='link-pointer' ui-sref="reports.dashboards.view.report({ report_id: report.id })">{{ ng_var('report.title') }}</a>
        </li>
    </ul>
</div>

<div ui-view></div>