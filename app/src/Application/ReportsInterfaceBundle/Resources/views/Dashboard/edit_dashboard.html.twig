            <hr>

            <div class="bucket">
                <label class="label">Reports:</label>
                <div class="bucket-column">
                    <a ng-click="addNewReport()" class="button button-secondary half-width">Add new report</a>
                    <a ng-click="cloneExisting()" class="button button-secondary half-width">Clone existing report</a>
                </div>
            </div>

        </form>

        <div ng-show="state == 'permissions'" class="popup-blurb">
            <h2>Choose agents that can see this dashboard</h2>
            <p>Bit of text about the agents and the dashboard</p>
        </div>

        <div ng-show="state == 'permissions'" class="agent-list">
            <table>
                <thead>
                <td class="agent-name"></td>
                <td>View</td>
                <td>Edit</td>
                </thead>

                <tr ng-repeat="agent in permissions track by agent.id">
                    <td class="agent-name">
                        <span class="avatar" style="background-image: url({{ ng_var('agent.avatar') }})"></span>
                        {{ ng_var('agent.name') }}
                    </td>
                    <td>
                        <span class="c-check">
                            <input ng-click='setPermissions(agent, 1)'
                                   ng-checked="agent.permissions == 1 || agent.permissions == 2"
                                   type="checkbox"
                                   id="checkbox1_{{ ng_var('$index') }}">
                            <label for="checkbox1_{{ ng_var('$index') }}"></label>
                        </span>
                    </td>
                    <td>
                        <span class="c-check">
                            <input ng-click='setPermissions(agent, 2)'
                                   ng-checked="agent.permissions == 2"
                                   type="checkbox"
                                   id="checkbox2_{{ ng_var('$index') }}">
                            <label for="checkbox2_{{ ng_var('$index') }}"></label>
                        </span>
                    </td>
                </tr>

            </table>
        </div>
    </div>

    <footer>
        <a ng-click="saveDashboard()" class="button">Save Changes</a>
    </footer>
    <!-- End Popup Content -->

</section>

<div class="cover"></div><!-- Transparent background to the popup -->