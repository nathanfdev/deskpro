<section class="popup no-footer" style="width: 850px">

    <!-- Popup Header & Title -->
    <header>
        <h1>Add new stat</h1>
        <div class="controls"><a class="link-pointer" ng-click="cancel()"><i class="fa fa-times"></i></a></div>
    </header>

    <div class="popup-breadcrumbs">
        You are creating a {{ ng_var('typeName') }} chart <i class="fa fa-bar-chart"></i>
        <a ng-click="changeType()" class="link-pointer">Change stat type?</a>
    </div>

    <div class="big-list-of-stats-filters">
        <div class="bucket">
            <form>
                <label>Filter:</label>
                <div class="box">
                    <input type="text" ng-model="searchText" placeholder="Filter stats by name">
                </div>
            </form>
        </div>

        <div class="bucket" dp-dropdown="dp-select-label-dropdown" dp-dropdown-opener="dp-select-label-opener" dp-dropdown-toggle="true">
            <a id="dp-select-label-opener" class="link-pointer select">Select labels: <i class="fa fa-caret-down"></i></a>

            <!-- Needs to be same width as the .select above -->
            <div id="dp-select-label-dropdown" class="select-label-dropdown">
                <a ng-repeat="label in labels track by $index" ng-class="{'active': label.active}"
                   ng-click="toggleLabel(label)" class="link-pointer stat-label">
                    <i class="fa fa-tag"></i>{{ ng_var('label.title') }}
                </a>
            </div>
        </div>
    </div>

    <div class="big-list-of-stats">
        <ul class="stat-list">
            {#<li class="active">#}
                {#<span class="mark"></span>#}
                {#<h1>Number of tickets grouped by <a href="#" class="select-data">Awaiting Agent <i class="fa fa-caret-down"></i></a> and something else.</h1>#}
                {#<p>#}
                    {#Print this page to PDF for the complete set of vectors. Or to use on the desktop, install FontAwesome.otf, set it as the font in your application, and copy and paste the icons (not the unicode) directly from this page into your designs.#}
                    {#<a href="#" class="stat-label"><i class="fa fa-tag"></i> Agents</a> <a href="#" class="stat-label"><i class="fa fa-tag"></i> Agents</a>#}
                {#</p>#}
                {#<div class="controls">#}
                    {#<a href="./reports-main.html">Preview <i class="fa fa-external-link"></i></a> <a href="./reports-main.html">Insert into report</a>#}
                {#</div>#}
            {#</li>#}

            <li ng-class="{'active': report.id == widget.widget_id}"
                ng-repeat="report in prefilteredReports | filter:filterBySearchText track by $index">
                <span ng-click="makeChoice(report)" class="mark"></span>

                <h1>
                    <dp-report-widget-select-box change-widget-params="changeWidgetParams(params)" report-id="report.id" value-to-decorate="report.title" possible-values="groupParams"></dp-report-widget-select-box>
                </h1>

                <p>
                    <a ng-repeat="label in report.labels" class="link-pointer stat-label"
                       ng-class="{'active': isActiveLabel(label)}" ng-click="toggleLabel(label)">
                        <i class="fa fa-tag"></i> {{ ng_var('label') }}
                    </a>
                </p>

                <div class="controls" ng-show="report.id == widget.widget_id">
                    <a class='link-pointer' ng-click="preview()">Preview <i class="fa fa-external-link"></i></a>
                    <a class='link-pointer' ng-click="insert()">Insert into report</a>
                </div>
            </li>

            {#<li>
                <span class="mark"></span>
                <h1>Number of tickets grouped by <a href="#" class="select-data">Field 1 <i class="fa fa-caret-down"></i></a> &amp; <a href="#" class="select-data">Field 2 <i class="fa fa-caret-down"></i></a>.</h1>
                <p><a href="#" class="stat-label"><i class="fa fa-tag"></i> Agents</a> <a href="#" class="stat-label"><i class="fa fa-tag"></i> Agents</a></p>
                <div class="select-data-dropdown">
                    <ul>
                        <li><a href="#">Agent</a></li>
                        <li><a href="#">User</a></li>
                        <li><a href="#">Awaiting User</a></li>
                        <li><a hrefRD="#">Awaiting Agent</a></li>
                        <li><a href="#">Resolved</a></li>
                        <li><a href="#">Agent</a></li>
                    </ul>
                </div>
            </li>

          #}
        </ul>
    </div>

</section>

<div class="cover"></div><!-- Transparent background to the popup -->