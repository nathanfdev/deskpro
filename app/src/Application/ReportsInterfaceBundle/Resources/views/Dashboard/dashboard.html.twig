<link href="//maxcdn.bootstrapcdn.com/font-awesome/4.1.0/css/font-awesome.min.css" rel="stylesheet">
<link rel="stylesheet" type="text/css" href="//cdn.datatables.net/1.10.3/css/jquery.dataTables.css">

<div class="container">
    <div class="edit-zone">
        <div class="btn-group" data-toggle="buttons-radio" style="float:left;">
            <label class="btn btn-primary" ng-repeat="db in dashboards track by db.id" ng-model="radioModel" ng-click="changeDashboard(db)" btn-radio="'{{ ng_var('db.name') }}'">{{ ng_var('db.name') }}</label>
        </div>
        <button class="btn btn-primary add-btn" ng-click="NewDashboardModal()" title="Add new dashboard">+</button>
    <span style="font-size: 16px" class="pull-right">
        <a ng-click="NewWidgetModal()" title="Add new widget" ng-if="dashboards.length > 0">
            <i class="fa fa-plus-circle"></i>
        </a>

    </span>

    </div>

    <div class="list-group">
        <div class="list-group-item db-title active">
            <h4 class="list-group-item-heading">
                {{ ng_var('dashboard.name') }}
                <a ng-click="editDashboardModal()" title="edit dashboard" ng-if="dashboards.length > 0">
                    <i class="fa fa-edit"></i>
                </a>
                <a ng-click="deleteDashboard(dashboard)" title="delete dashboard" ng-if="dashboards.length > 0">
                    <i class="fa fa-delete">XXX</i>
                </a>

            </h4>
            <div>

            </div>
        </div>
        <div>
            <div gridster="gridsterOptions" class="dashboard">
                <ul>
                    <li gridster-item="widget" ng-repeat="widget in dashboard.widgets">
                        <div class="box-header">
                            <h3 class="ng-binding">{{ ng_var('widget.name') }}</h3>
                            <div class="box-header-btns pull-right">
                                <a title="Remove widget" ng-click="DashboardCtrl.removeWidget(widget)"><i class="glyphicon glyphicon-trash">XXX</i></a>
                            </div>
                        </div>
                        <div class="box" ng-if="widget.type=='stat'">
                            <dashboard-stat title="{{ ng_var('widget.name') }}" value="{{ ng_var('widget.data.value') }}" wtype="{{ ng_var('widget.type') }}"></dashboard-stat>
                        </div>
                        <div class="box" ng-show="widget.type=='graph'">
                            <dashboard-amcharts
                                    my-index="{{ ng_var('$index') }}"
                                    title="{{ ng_var('widget.name') }}"
                                    chart-id = "{{ ng_var('widget.id') }}"
                                    chtype="{{ ng_var('widget.type') }}">
                            </dashboard-amcharts>
                        </div>
                        <div class="box" ng-if="widget.type=='table'">
                            <dashboard-table my-index="{{ ng_var('$index') }}" title="{{ ng_var('widget.name') }}" table-data="{{ ng_var('widget.data') }}" wtype="{{ ng_var('widget.type') }}"> </dashboard-table>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>