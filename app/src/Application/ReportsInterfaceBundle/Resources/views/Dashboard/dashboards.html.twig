<section class="content reports">
<header class="reports-header">
    <div class="right">
        <div class="report-access-avatars">
            <span class="title">On this dashboard:</span>
            <a href="#" class="avatar" style="background-image: url(./img/avatar2.png);"></a>
            <a href="#" class="avatar" style="background-image: url(./img/avatar3.jpg);"></a>
            <a href="#" class="avatar" style="background-image: url(./img/avatar4.jpg);"></a>
            <a href="#" class="avatar" style="background-image: url(./img/avatar2.png);"></a>
            <a href="#" class="avatar" style="background-image: url(./img/avatar3.jpg);"></a>
            <a href="#" class="avatar" style="background-image: url(./img/avatar4.jpg);"></a>
            <a href="#" class="avatar avatar-blank"><span>+4</span></a>
            <a href="./reports-main-create-dashboard-agent-permissions.html" class="avatar edit-access-link"><span>Edit user access <i class="fa fa-user"></i></span></a>
        </div>
    </div>

    <div class="left">
        <div class="dashboard-main-list" ng-click='selecting=!selecting' ng-class = "{'expanded': selecting}">
            <a class="link-pointer">
                <span>Dashboard:</span> {{ ng_var('dashboard.title') }} <i class="fa fa-sort"></i>
            </a>

            <ul ng-show="selecting">
                <li ng-repeat="db in dashboards track by db.id">
                    <a class='link-pointer' ng-class='{"current": db.id === dashboard.id}' ng-click="changeDashboard(db)">
                        <span class='logo-deskpro' ng-show="db.default"></span>
                        {{ ng_var('db.title') }}
                    </a>
                </li>
            </ul>
        </div>

        <nav class="reports-control">
            <ul>
                <li{# ng-show="!dashboard.default"#}><a class='link-pointer' ng-click="editDashboardModal()"><i class="fa fa-cog"></i> Edit Dashboard</a></li>
                <li><a class='link-pointer' ng-click='addingDashboard = true'><i class="fa fa-plus"></i>Create Dashboard</a></li>
            </ul>
        </nav>
        <hr>
    </div>

</header>



<div class="report-tabs">
    <ul>
        <li class="add-report-link">
            <a ng-click='addingReport = true'><i class="fa fa-plus"></i></a>
        </li>

        <li ng-repeat="report in dashboard.reports track by report.id" ng-class="{'active-tab':currentReport.id===report.id}">
            <a ng-click="changeReport(report)">{{ ng_var('report.title') }}</a>
        </li>
    </ul>
</div>

<div class="report-info">

    <div class="report-extras">
        <a href="#">
            <div><i class="fa fa-print"></i></div>
            <span>Print Report</span>
        </a>

        <a href="#">
            <div><i class="fa fa-file-pdf-o"></i></div>
            <span>Download PDF</span>
        </a>
    </div>

    <h1><span>Report:</span> {{ ng_var('currentReport.title') }}</h1>

    <nav class="reports-control">
        <ul>
            <li><a ng-click='editReport()' ng-class="{'control-inactive':dashboard.default}"><i class="fa fa-cog"></i> Edit Report</a></li>
            <li><a ng-click="cloningReport = true"><i class="fa fa-copy"></i> Clone Report</a></li>
        </ul>
    </nav>

    <div class="report-date-range-picker">
        <a href="#" class="date-range-button">Date range <i class="fa fa-calendar-o"></i></a>

        <span class="selected-date"><span>Selected:</span> January 2014</span>

              <span class="date-jumper">
                <a href="#"><i class="fa fa-caret-left"></i></a>
                <a href="#"><i class="fa fa-caret-right"></i></a>
              </span>
    </div>
</div>


<div class="graph-container">
    <div class="graph-container-controls">
        <!-- default or control-active(when selected) or control-inactive(when disabled for default dashboards) -->
        <a href="#" class="control control-inactive">Dashboard Layout <i class="fa fa-columns"></i></a>
        <a href="./presentation-only-active-filters.html" class="control">Filters <i class="fa fa-filter"></i></a>

        <span class="generated-graph-info">Report generated at 6.32PM, Aug 24, 2014 <a href="#"><i class="fa fa-refresh"></i></a></span>
    </div>

    <!--<div class="graph-filters">
      <span class="label">Departments:</span> <a href="#" class="active">Billing &amp; Sales <i class="fa fa-caret-down"></i></a>
      <span class="label">Agents:</span> <a href="#">Billing &amp; Sales <i class="fa fa-caret-down"></i></a>
    </div>-->
</div>

<div style="padding: 50px; width: 500px;">
    <div ng-show='addingReport' class="reports-dropdown expanded">
        <header>
            <a ng-click="addingReport = !addingReport" class="hide-dropdown"><i class="fa fa-times"></i></a>
            <i class="fa fa-plus"></i> Create new report
        </header>
        <div class="reports-dropdown-content">
            <p>Bit of text about adding a report into your current dashboard lorel ipsum.</p>
        </div>
        <hr>
        <div class="reports-dropdown-content">
            <h2>Create new report</h2>
            <form>
                <button>Create report</button>
                <div class="input-bucket"><input type="text" ng-model='newReport.title' placeholder="Name your report"></div>
            </form>
        </div>
        <hr>
        <div class="reports-dropdown-content">
            <h2>Or clone an existing report</h2>
            <ul class="clone-list">
                <li ng-repeat="db in dashboards track by db.id"
                    ng-class="{'current': db.id === dashboard.id, 'expanded': isExpanded(db)}">

                    <a ng-show='!isExpanded(db)' ng-click="expandDashboard(db)" class="control"><i class="fa fa-plus-square-o"></i></a>
                    <a ng-show='isExpanded(db)' ng-click="collide(db)" class="control">
                        <i class="fa fa-minus-square-o"></i>
                    </a>

                    <a>{{ ng_var('db.title') }} <span ng-show="db.id === dashboard.id">(Your current dashboard)</span></a>
                    <ul ng-show='isExpanded(db) && db.reports.length > 0'>
                        <li ng-repeat="report in db.reports track by report.id">
                            <a ng-click="alert('clone!')">{{ ng_var('report.title') }}</a>
                        </li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</div>



<!-- Inline styles for rpesentation, remove -->
<div style="padding: 50px; width: 500px;">
    <div ng-show="addingDashboard" class="reports-dropdown expanded">
        <header>
            <a ng-click="addingDashboard = !addingDashboard" class="hide-dropdown"><i class="fa fa-times"></i></a>
            <i class="fa fa-plus"></i> Create Dashboard
        </header>
        <hr>

        <div class="dropdown-content">
            <ul class="big-actions">
                <li>
                    <a ng-click="newDashboardModal()"><i class="fa fa-bar-chart"></i> Create a new dashboard</a>
                </li>

                <li>
                    <a ng-click="cloneDashboardModal()"><i class="fa fa-copy"></i> Clone the <span>{{ ng_var('dashboard.title') }}</span> dashboard</a>
                </li>
            </ul>
        </div>
    </div>
</div>



<!-- Inline styles for rpesentation, remove -->
<div style="padding: 50px; width: 500px;">
    <div ng-show='cloningReport' class="reports-dropdown expanded">
        <header>
            <a ng-click="cloningReport = !cloningReport" class="hide-dropdown"><i class="fa fa-times"></i></a>
            <i class="fa fa-copy"></i> Clone report
        </header>

        <div class="reports-dropdown-content">
            <p>Bit of text about adding a report into your current dashboard lorel ipsum.</p>
        </div>

        <hr>

        <div class="reports-dropdown-content">
            <h2>Existing Dashboards</h2>
            <ul class="clone-list">
                <li ng-repeat="db in dashboards track by db.id"
                    ng-class="{'current': db.id === dashboard.id, 'expanded': isExpanded(db)}">

                    <a ng-show='!isExpanded(db)' ng-click="expandDashboard(db)" class="control"><i class="fa fa-plus-square-o"></i></a>
                    <a ng-show='isExpanded(db)' ng-click="collide(db)" class="control">
                        <i class="fa fa-minus-square-o"></i>
                    </a>

                    <a>{{ ng_var('db.title') }} <span ng-show="db.id === dashboard.id">(Your current dashboard)</span></a>
                    <ul ng-show='isExpanded(db) && db.reports.length > 0'>
                        <li ng-repeat="report in db.reports track by report.id">
                            <a ng-click="alert('clone!')">{{ ng_var('report.title') }}</a>
                        </li>
                    </ul>
                </li>
            </ul>
        </div>

        <hr>

        <div class="reports-dropdown-content">
            <a href="#" class="footer-link"><i class="fa fa-copy"></i> Or create a new dashboard and clone into it</a>
        </div>
    </div>
</div>



