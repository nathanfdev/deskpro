{% extends 'ReportsInterfaceBundle:Layout:list.html.twig' %}
{% set list_class = 'report-builder' %}
{% block listpane_content %}

	<section class="dp-paneblock dp-listpane">
		<div class="dp-add-control">
			<a class="btn btn-default" ng-class="{'active': isStateActive('.create') }"
			   href="{{ ng_href('builder.create', '{type: \'custom\'}') }}">
				<i class="fa fa-plus"></i> Create Custom Report
			</a>
		</div>
	</section>

	<section class="dp-paneblock dp-listpane">
		<header>
			<h3>
				Custom Reports
			</h3>
		</header>
		<article>
			<ul class="dp-item-list">
				<li ng-repeat="report in ListCtrl.custom_data_list"
					dp-state-mark="builder.edit.{{ ng_var('report.id') }}" data-id="{{ ng_var('report.id') }}">
					<a href="{{ ng_href('builder.edit', '{id: report.id, type: \'custom\'}') }}">
						<h4>
							<span class="title-text">{{ ng_var('report.title') }}</span>
						</h4>
					</a>
				</li>
			</ul>
		</article>
	</section>

	<section class="dp-paneblock dp-listpane dp-report-category"
			 ng-repeat="category in ['Tickets', 'Chats', 'People & Organizations', 'Knowledgebase', 'News', 'Downloads', 'Feedback', 'Tasks', 'Twitter']"
			 ng-show="ListCtrl.built_in_data_list[category]">
		<article class="sublist-open">
			<em><i class="fa fa-chevron-down"></i></em>

			<a href="#" class="header">
				<span class="inner">{{ ng_var('category') }} Built-In Reports</span>
			</a>

			<ul class="dp-item-list" dp-nav-subnav>
				<li ng-repeat="report in ListCtrl.built_in_data_list[category]"
					dp-state-mark="builder.edit.{{ ng_var('report.id') }}"
					data-id="{{ ng_var('report.id') }}">
					<dp-report-builder-select-box
							report-id="report.id"
							value-to-decorate="report.title"
							possible-values="ListCtrl.group_params">

					</dp-report-builder-select-box>
				</li>
			</ul>


		</article>
	</section>
{% endblock %}

{% block listpane_help %}
	{% include 'ReportsInterfaceBundle:Builder:help-page.html.twig' %}
{% endblock %}