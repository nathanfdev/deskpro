<!DOCTYPE html>
<html ng-app>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width">
	<title>{{ phrase('admin.general.deskpro_reports_interface') }}</title>
	<!--[if IE]><meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" /><![endif]-->

	<link rel="stylesheet" href="{{ asset('app/bower_components/font-awesome/css/font-awesome.min.css') }}"/>
	<link rel="stylesheet" href="{{ asset('app/bower_components/select2/select2.css') }}"/>
	<link rel="stylesheet" href="{{ asset('app/Reports/build/css/reports-style.css') }}"/>
</head>
<body>

<header class="dp-app-header">
	<div class="user-profile pull-left">
		<img class="gravatar pull-left" src="{{ app.user.getPictureUrl(32) }}">
		<div class="username">{{ phrase('agent.chrome.hello-user', {name: app.user.name}) }}</div>
		<ul class="nav-profile">
			<li id="user_settings_link"><i class="fa fa-cog"></i> <a>{{ phrase('agent.chrome.link_preferences') }}</a></li>
			<li id="dp_header_help_trigger"><i class="fa fa-question-circle"></i> <a>{{ phrase('agent.chrome.link_help') }}</a></li>
			<li onclick="window.location='{{ path('user_logout', {'auth': static_security_token('user_logout', 0)}) }}?to=agent'; return false;"><i class="fa fa-sign-out"></i> <a>{{ phrase('agent.chrome.link_logout') }}</a></li>
		</ul>
	</div>

	<div class="group pull-right">
		<a href="http://www.deskpro.com/" target="_blank" class="logo"></a>
	</div>
</header>

<div id="dp_main_view" ng-controller="Reports_Main_Ctrl_MainPage">
	<!-- Left Navigation Column -->
	<nav class="dp-appstrip">
		<ul>
			<li tooltip="Overview" tooltip-append-to-body="true" tooltip-placement="right"
				dp-state-mark="home" class="state-on">
				<a class="app-icon app-icon-home" href="#/"></a>
			</li>
			<li tooltip="Report Builder" tooltip-append-to-body="true" tooltip-placement="right"
				dp-state-mark="report_builder">
				<a class="app-icon app-icon-cog" href="#/report_builder"></a>
			</li>
			<li tooltip="Billing" tooltip-append-to-body="true"
				tooltip-placement="right" dp-state-mark="billing">
				<a class="app-icon app-icon-chat" href="#/billing"></a>
			</li>
			<li tooltip="Agent Activity" tooltip-append-to-body="true"
				tooltip-placement="right" dp-state-mark="agent_activity">
				<a class="app-icon app-icon-ticket" href="#/agent_activity"></a>
			</li>
			<li tooltip="Agent Hours" tooltip-append-to-body="true" tooltip-placement="right"
				dp-state-mark="agent_hours">
				<a class="app-icon app-icon-crm" href="#/agent_hours"></a>
			</li>
			<li tooltip="Ticket Satisfaction" tooltip-append-to-body="true"
				tooltip-placement="right" dp-state-mark="ticket_satisfaction">
				<a class="app-icon app-icon-publish" href="#/ticket_satisfaction"></a>
			</li>
		</ul>
	</nav>
	<div class="dp-layout" ui-view></div>
</div>

<script type="text/javascript">
window.DP_ASSET_URL      = '{{ asset('') }}';
window.DP_BASE_URL       = '/{{ path('user')|trim('/') }}';
window.DP_BASE_API_URL   = '{{ path('user')|rtrim('/') }}/api';
window.DP_BASE_ADMIN_URL = '{{ path('user')|rtrim('/') }}/adm';
window.DP_BASE_REPORTS_URL = '{{ path('reports')|rtrim('/') }}';
window.DP_API_TOKEN      = '{{ api_token.getKeyString() }}';
window.DP_SESSION_ID     = '{{ session.session_code }}';
window.DP_REQUEST_TOKEN  = '{{ initial_request_token }}';
window.DP_PERSON_ID      = '{{ app.user.id }}';
window.DP_PERSON_EMAIL   = '{{ app.user.getPrimaryEmailAddress() }}';
window.DP_PERSON_LANG_ID = {{ app.user.language.id }};
window.DP_IS_DEBUG       = {% if app.isDebug() %}true{% else %}false{% endif %};
window.DP_IS_TESTING     = {% if app.isTesting() %}true{% else %}false{% endif %};
</script>
<script	type="text/javascript" src="{{ asset('app/DeskPRO/preboot.js') }}"></script>
<script
	type="text/javascript"
	data-main="{{ asset('app/Reports/loader.js') }}"
	src="{{ asset('app/bower_components/requirejs/require.js') }}"
></script>
</body>
</html>