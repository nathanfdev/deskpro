
<section class="report-wrapper">
	<header>
		<h2>
			<span class="label-sum"> {{ ng_var('tickets_resolved.sum') }}</span>
			Tickets were 'Resolved' {{ ng_var('tickets_resolved.date_choice') }}
		</h2>
		<h3>Showing Grouped by {{ ng_var('tickets_resolved.grouping_field') }}
	</header>
	<article ng-if="tickets_resolved.values">
		<table class="stat-table" width="100%">
			<tr ng-repeat="stat in tickets_resolved.stats">
				<td class="title"><span>{{ ng_var('stat.title') }}</span></td>
				<td width="100%">
					<table width="100%" class="stat-value">
						<tr>
							<td class="value" width="{{ ng_var('stat.left_percentage') }}%">
								<div>&nbsp;</div>
							</td>
							<td width="{{ ng_var('stat.right_percentage') }}%">
								{{ ng_var('stat.value') }}
							</td>
						</tr>
					</table>
				</td>
			</tr>
			<tr class="total-row">
				<td class="title">Total:</td>
				<td class="val">{{ ng_var('tickets_resolved.sum') }}</td>
			</tr>
		</table>
		<div class="no-data" ng-if="!tickets_resolved.values">
			<h3>No matching data</h3>
		</div>
	</article>
</section>