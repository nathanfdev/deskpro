<div class="alert alert-info">
    <div>
        Showing Agent Hours from:
			<span>
				<input type="text" class="form-control"
                       style="width: 140px; display: inline-block;"
                       datepicker-popup="dd MMMM yyyy" ng-model="service.date1"
                       datepicker-options="{'show-weeks': false}"/>
			</span>
        to
			<span>
				<input type="text" class="form-control"
                       style="width: 140px; display: inline-block;"
                       datepicker-popup="dd MMMM yyyy" ng-model="service.date2"
                       datepicker-options="{'show-weeks': false}"/>
			</span>

        <button class="btn btn-primary" ng-click="service.updateFilter()">Show</button>
    </div>
</div>

