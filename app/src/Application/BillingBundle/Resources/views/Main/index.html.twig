<!DOCTYPE HTML>
<html lang="en">
<head>
	<title>{{ phrase('billing.main.deskpro_billing_interface') }}</title>
	<meta charset="utf-8" />
	<meta name="robots" content="NOINDEX" />
	<meta http-equiv="X-UA-Compatible" content="IE=100" />
	{% if app.getSetting('core.favicon_blob_id') %}
	<link rel="shortcut icon" id="favicon" href="{{ path('favicon', {}, true) }}" />
	{% else %}
	<link rel="shortcut icon" id="favicon" href="{{ asset('images/favicon.ico') }}" />
	{% endif %}

	<script type="text/javascript">
		{% if constant('DP_DEBUG') %}
		DP_DEBUG = true;
		{% else %}
		DP_DEBUG = false;
		{% endif %}
	</script>

	{{ dp_asset_html('agent_vendors_css') }}
	{{ dp_asset_html('agent_interface_css') }}
	{{ dp_asset_html('admin_interface_css') }}

	{{ dp_asset_html('agent_vendors') }}
	{{ dp_asset_html('agent_common') }}
	{{ dp_asset_html('agent_deskpro_ui') }}
	{{ dp_asset_html('admin_admin_ui') }}
	{{ dp_asset_html('admin_admin_handlers') }}

	<script type="text/javascript" src="{{ asset('vendor/less/less.min.js') }}"></script>
</head>
<body id="billing_interface">

<div id="billing_placeholder">
	<table cellspacing="0" cellpadding="0" border="0" width="100%" height="100%"><tr><td align="center" valign="center" style="text-align: center; vertical-align: middle;">
		<h1>{{ phrase('billing.main.coming_soon') }}</h1>
	</td></tr></table>
</div>

</body>
</html>
