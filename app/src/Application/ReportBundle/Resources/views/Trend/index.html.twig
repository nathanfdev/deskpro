{% set this_page = 'trends_index' %}
{% extends 'ReportBundle::layout.html.twig' %}
{% import "ReportBundle:Common:macros.html.twig" as stat_macros %}
{% block html_head %}
{{ dp_asset_html('report_dashboard') }}
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
	window.DeskPRO_Page = new DeskPRO.Report.PageHandler.Trend();
}
</script>
{% endblock %}
{% block pagebar %}
	<ul>
		<li>{{ phrase('agent.global.trends') }}</li>
	</ul>
{% endblock %}
{% block page %}

<script type="text/javascript">
	$(function() {
		$('.sparkline').sparkline('html', { width: '100%', height: '25px'});
	});
</script>

<div class="table-list-wrap">

	<table class="table-list stat-list" cellspacing="0" cellpadding="0" width="100%">
		<thead>
			<tr>
				<th width="20"></th>
				<th>{{ phrase('agent.global.title') }}</th>
				<th width="100">{{ phrase('agent.global.group_by') }}</th>
				<th width="100">{{ phrase('agent.report.trend.updates') }}</th>
				<th width="200">{{ phrase('agent.global.author') }}</th>
				<th width="200">{{ phrase('agent.global.trend') }}</th>
				<th width="60" class="center">{{ phrase('agent.global.prev') }}</th>
				<th width="60" class="center">{{ phrase('agent.report.trend.current') }}</th>
				<th width="90" class="center">{{ phrase('agent.report.trend.difference_') }}</th>
				<th width="10"></th>
				<th width="16" class="icon"></th>
				<th width="16" class="icon"></th>
			</tr>
		</thead>
		<tbody>
			{% for stat in stats %}
				<tr>
					<td class="{{ stat.starred ? 'starred' : '' }}"></td>
					<td>{{ stat.title }}</td>
					<td>{{ stat.getGroupingName }} </td>
					<td class="period">{{ stat.period }}</td>
					<td>{{ stat.authorName }}</td>
					<td><span class="sparkline">{{ stat.trendPoints|join(',') }}</span></td>
					{% for prev_value in stat.getEndData(2) %}
						<td class="prev-value">{{ stat.formatData(prev_value, chart.getDisplayUnits)|default('-') }}</td>
					{% endfor %}
					<td class="center difference {{ stat_macros.difference_class(stat.difference, stat.variation) }}">{{ stat.difference(true) }}%</td>
					<td></td>
					<td class="icon">
						{% if stat.isEditable %}
							<a href="{{ path('report_trend_edit', { 'stat_id': stat.id }) }}" class="edit-trend" title="{{ phrase('agent.report.trend.edit_trend') }}"><img src="{{ asset('images/report/icons/edit.png') }}" alt="{{ phrase('agent.report.trend.edit_bracket') }}"/></a></td>
						{% endif %}
					<td class="icon">
						{% if stat.isClonable %}
							<a href="{{ path('report_trend_clone', { 'stat_id': stat.id }) }}" class="clone-trend" title="{{ phrase('agent.report.trend.clone_trend') }}"><img src="{{ asset('images/report/icons/clone.png') }}" alt="{{ phrase('agent.report.trend.clone_bracket') }}"/></a>
						{% endif %}
					</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
</div>

<div id="edit_overlay_wrapper" style="width: 700px; height: 450px; display: none;">
	<div class="overlay-title">
		<span class="close-overlay"></span>
		<h4>{{ phrase('agent.report.trend.edit_trend') }}</h4>
	</div>
	<div class="overlay-content">
	</div>
	<div class="overlay-loader">
		<img src="{{ asset('images/spinners/loading-big-circle.gif') }}" alt="{{ phrase('agent.global.loading_dot') }}" />
	</div>
	<div class="overlay-footer">

	</div>
</div>

<div id="clone_overlay_wrapper" style="width: 700px; height: 650px; display: none;">
	<div class="overlay-title">
		<span class="close-overlay"></span>
		<h4>{{ phrase('agent.report.trend.clone_trend') }}</h4>
	</div>
	<div class="overlay-content">

	</div>
	<div class="overlay-loader">
		<img src="{{ asset('images/spinners/loading-big-circle.gif') }}" alt="{{ phrase('agent.global.loading_dot') }}" />
	</div>
	<div class="overlay-footer">

	</div>
</div>

{% endblock %}
