<form id="edit_trend_form" action="{{ path('report_trend_edit', {'stat_id': stat.id|default(0)}) }}" method="post">
	<input type="hidden" name="process" value="1" />

	<div class="dp-form">
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('global.title') }}</label>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.title) }}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('agent.report.trend.difference') }}</label>
				<span>{{ phrase('agent.report.trend.is_a_positive_number_good_bad_or_neutral') }}</span>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.variation) }}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('agent.report.trend.star_the_statistic') }}</label>
				<span>{{ phrase('agent.report.trend.starred_statistic_display_at_the_top_of_the') }}</span>
			</div>
			<div class="dp-form-input">
				<label>{{ form_widget(form.starred) }} {{ phrase('agent.report.trend.starred') }}</label>
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('agent.report.trend.disable_the_statistic') }}</label>
				<span>{{ phrase('agent.report.trend.disabling_the_statistic_will_cause_future_data_to') }}</span>
			</div>
			<div class="dp-form-input">
				<label>{{ form_widget(form.disabled) }} {{ phrase('agent.report.trend.disable') }}</label>
			</div>
		</div>

	</div>

	{{ form_rest(form) }}

	<button class="btn primary save-trigger" id="edit_trend_save">{{ phrase('global.save') }}</button>
</form>

<script type="text/javascript">
	$(function() {
		var self     = this;

		$('#edit_trend_save').click(function(ev) {
			$('#edit_overlay_wrapper .overlay-loader').css('display', 'block');

			ev.preventDefault();
			ev.stopPropagation();

			var form = $('#edit_trend_form');
			var postData = form.serializeArray();

			$.ajax({
				url: form.attr('action'),
				type: 'POST',
				data: postData,
				dataType: 'json',
				success: function(data) {
					// Just do a redict for now
					self.location = data.redirect;
				}
			});
		});
	});
</script>
