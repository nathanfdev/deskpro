{% set this_page = 'report_agent_feedback_feed' %}
{% extends 'ReportBundle::layout.html.twig' %}

{% block nav_block %}
    {% include 'ReportBundle:AgentFeedback:nav.html.twig' %}
{% endblock %}

{% block page_js_exec %}
<script type="text/javascript">
    $(document).ready(
            function() {
                $('.timeago').timeago();
            }
    );
</script>
{% endblock %}

{% block pagebar %}
{% endblock %}

{% block page %}
<style type="text/css">
    
</style>

<div class="reports_agent_feed_section">
    {% if feedback is empty %}
    <p>There is no feedback.</p>
    {% else %}
    <div>
        {% for f in feedback %}
            <div>
                <span>{{ f.date_created|date('fulltime') }}</span>
                {% set img_src = 'images/report/feedback/rating_' ~ f.rating ~ '.png' %}
                <img src="{{ asset(img_src) }}" />
                <span>Ticket #<a>{{ f.ticket.id }}</a> "{{ f.ticket.subject }}" by <a>{{ f.ticket.person.name }} &lt;{{ f.ticket.person.name }}&gt;</a></span>
            </div>
            <div>
                <div class="fieldbox">
                    <div>Agent: <a>{{ f.ticket_message.person.name }}</a></div>
                    <div>Time User Waiting: <time class="timeago" data-timeago-no-ago="1" datetime="{{ f.ticket.date_user_waiting|date('c') }}"></time>{{f.ticket.date_user_waiting}}</div>
                </div>
                <div class="message">
                    {{ f.message }}
                </div>
            </div>
        {% endfor %}
    </div>
    {% if page != 0 %}
    <a href="{{ path('report_agent_feedback_feed', {'page':page - 1}) }}">Previous Page</a>
    {% endif %}
    <a href="{{ path('report_agent_feedback_feed', {'page':page + 1}) }}">Next Page</a>
    {% endif %}
</div>
{% endblock %}