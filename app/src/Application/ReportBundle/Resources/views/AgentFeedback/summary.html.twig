{% set this_page = 'report_agent_feedback_index' %}
{% extends 'ReportBundle::layout.html.twig' %}

{% block nav_block %}
{% include 'ReportBundle:AgentFeedback:nav.html.twig' %}
{% endblock %}

{% block page_js_exec %}
<script type="text/javascript">
    $(document).ready(function(){
        $('.datepicker > span').datepicker(
                {
                    'changeMonth': true,
                    'changeYear': true,
                    'changeDay': false,
                    'showButtonPanel': true,
                    'dateFormat': 'yy-mm',
                    'closeText': 'Done',
                    'defaultDate': new Date({{ view_date|date('Y') }}, {{ view_date|date('m') }} -1, {{ view_date|date('d') }}),
                    'onClose': function(dateText, inst) {
                        var month = $("#ui-datepicker-div .ui-datepicker-month :selected").val();
                        var year = $("#ui-datepicker-div .ui-datepicker-year :selected").val();
                        $(this).datepicker('setDate', new Date(year, month, 1));
                    }
                }
        );
        $('.datepicker > a').on('click', function(){
            if($('.datepicker > span').hasClass('hidden')) {
                $('.datepicker > span').removeClass('hidden');
                $('.reports-popup-page-overlay').removeClass('hidden');
            }
            else {
                $('.datepicker > span').addClass('hidden');
                $('.reports-popup-page-overlay').addClass('hidden');
            }
        });
        $('.reports-popup-page-overlay').on('click', function() {
            $('.datepicker > a').click();
        });
    });
</script>
{% endblock %}

{% block pagebar %}
{% endblock %}

{% block page %}
<style>
    .datepicker.nodays .ui-datepicker-calendar {
        display: none;
    }​
</style>
<div class="reports_agent_feedback_summary_section">
    <table>
        <tr>
            <td><span class="datepicker nodays drop-down"><a>{{ view_date|date('M Y') }}<em></em></a><span class="hidden"></span></span></td>
            {% for agent in agents %}
                <th colspan="2">{{ agent.name }}</th>
            {% endfor %}
        </tr>
        {% for i,day in days %}
            <tr>
                <td>{{ day|date('jS') }}</td>

                {% for agent in agents %}
                    <td>
                        {{ summary[i][agent.id][0] }}
                    </td>
                    <td>
                        {{ summary[i][agent.id][0] }}
                    </td>
                {% endfor %}
            </tr>
        {% endfor %}
        <tr>
            <th>Total</th>
            {% for agent in agents %}
                <td>{{ totals[agent.id][0] }}</td>
                <td>{{ totals[agent.id][1] }}</td>
            {% endfor %}
        </tr>
    </table>
    <div class="reports-popup-page-overlay hidden"></div>
</div>
{% endblock %}