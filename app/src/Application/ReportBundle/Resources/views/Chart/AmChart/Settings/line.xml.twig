<?xml version="1.0" encoding="UTF-8"?>

<settings>

	<redraw>1</redraw>
	<colors>{{ chart.getColorCodes|join(',') }}</colors>

	<strings>
		<no_data>{{ chart.getNoDataLabel }}</no_data>
	</strings>

	<plot_area>
		<margins>
			<left>60</left>
			<top>20</top>
			<right>20</right>
			<bottom>60</bottom>
		</margins>
	</plot_area>

	<indicator>
		<x_balloon_enabled>false</x_balloon_enabled>
	</indicator>

	<balloon>
		<only_one>1</only_one>
		<text_color>FFFFFF</text_color>
		<text_size>16</text_size>
	</balloon>

	<error_messages>
		<color>#cccccc</color>
	</error_messages>

	{% if dashboard_stat.getShowLegend() == true %}
		<legend>
			<enabled>1</enabled>
		</legend>
	{% else %}
		<legend>
			<enabled>0</enabled>
		</legend>
	{% endif %}

	<axes>
		<x>
			<width>1</width>
		</x>
		<y_left>
			<width>1</width>
		</y_left>
	</axes>

	<labels>
		<label lid="0">
			<x>10</x>
			<y>100%</y>
			<rotate>true</rotate>
			<align>center</align>
			<text><![CDATA[{{ chart.yLabel }}]]></text>
		</label>
		<label lid="1">
			<x>0</x>
			<y>!25</y>
			<align>center</align>
			<text><![CDATA[{{ chart.xLabel|default('xxx') }}]]></text>
		</label>
	</labels>

	<graphs>
		{% for label in chart.labels %}
			<graph gid="{{ loop.index }}">
				<axis>left</axis>
				<title>{{ label|default('') }}</title>
				<balloon_text>
					<![CDATA[{{ label|default('') }}: {value}{{ chart.getDisplayUnits }}]]>
				</balloon_text>
			</graph>
		{% endfor %}
	</graphs>

	<data>
		<chart>
			<series>
				{% for series in chart.series %}
					<value xid="{{ loop.index0 }}">{{ series }}</value>
				{% endfor %}
			</series>
			<graphs>
				{% for graphs in chart.graphs %}
					<graph gid="{{ loop.index }}">
						{% for point in graphs.data %}
							<value xid="{{ loop.index0 }}">{{ chart.formatData(point)|default('0') }}</value>
						{% endfor %}
					</graph>
				{% endfor %}
			</graphs>
		</chart>
	</data>
</settings>
