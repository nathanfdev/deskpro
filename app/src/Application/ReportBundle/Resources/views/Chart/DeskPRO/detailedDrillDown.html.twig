{% import "ReportBundle:Common:macros.html.twig" as stat_macros %}

<div class="detailed-drill-down" id="dashboard-chart-{{ dashboard_stat.id }}">
	{% if chart.isChartRenderable %}
		<table>
			<thead>
				<tr>
					<th class="name">{{ chart.getDataLabel }}</th>
					<th class="trend">{{ phrase('global.trend') }}</th>
					{% for series in chart.getEndSeries(3) %}
						<th class="prev-value">{{ series }}</th>
					{% endfor %}
					<th class="diff">{{ phrase('agent.report.deskpro.diff_') }}</th>
				</tr>
			</thead>
			<tbody>
				{% for row in chart.rows %}
					<tr>
						<td class="name">{{ row.label|default('no group') }}</td>
						<td class="trend" data-trendline="{{ row.data|join(',') }}"></td>
						{% for prev_value in chart.getEndData(row, 3) %}
							<td class="prev-value">{{ chart.formatData(prev_value, chart.getDisplayUnits)|default('-') }}</td>
						{% endfor %}
						<td class="diff {{ stat_macros.difference_class(chart.getDifference(row.data), chart.differenceDirection) }}">{{ chart.getDifference(row.data, true) }}%</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	{% else %}
		<div class="chart-not-renderable">{{ chart.getNoDataLabel }}</div>
	{% endif %}
</div>