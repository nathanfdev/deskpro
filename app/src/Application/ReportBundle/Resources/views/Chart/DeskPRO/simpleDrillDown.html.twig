<div class="simple-drill-down" id="dashboard-chart-{{ dashboard_stat.id }}">
	{% if chart.isChartRenderable %}
		<table>
			<thead>
				<tr>
					<th class="name">{{ chart.getDataLabel }}</th>
					<th class="trend">{{ phrase('agent.global.trend') }}</th>
					<th class="value">{{ phrase('agent.global.value') }}</th>
					<th class="bar"></th>
				</tr>
			</thead>
			<tbody>
				{% for row in chart.rows %}
					<tr>
						<td class="name">{{ row.label|default('no group') }}</td>
						<td class="trend" data-trendline="{{ row.data|join(',') }}"></td>
						<td class="value">{{ chart.formatData(row.sum_data, chart.getDisplayUnits)|default('-') }}</td>
						<td class="bar">
							<span style="width: {{ chart.calculateRowValuePercentage(row.sum_data) }}%">&nbsp;</span>
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	{% else %}
		<div class="chart-not-renderable">{{ chart.getNoDataLabel }}</div>
	{% endif %}
</div>