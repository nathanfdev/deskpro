{% import "ReportBundle:Common:macros.html.twig" as stat_macros %}

<div class="variation-change-chart" id="dashboard-chart-{{ dashboard_stat.id }}">
	{% if chart.isChartRenderable %}
		<div class="main">
			<table>
				<tr>
					<td class="prev">
						<span class="value">{{ chart.formatData(chart.getDataPoint(1, true, true), chart.getDisplayUnits)|default('0') }}</span>
						<span class="label">{{ chart.getDataPoint(1, false, true)|default('-') }}</span>
					</td>
					<td class="variation direction {{ stat_macros.difference_class(chart.difference, chart.differenceDirection) }}">
						<span class="amount">{{ chart.getDifference(true)|default('-') }}%</span>
					</td>
					<td class="actual">
						<span class="value">{{ chart.formatData(chart.getLastDataPoint(), chart.getDisplayUnits)|default('0') }}</span>
						<span class="label">{{ chart.getLastDataPoint(false)|default('-') }}</span>
					</td>
				</tr>
			</table>
		</div>

		<div class="footer">
		      <div class="sparkline">{{ chart.dataPoints|join(',') }}</div>
		</div>
	{% else %}
		<div class="chart-not-renderable">{{ chart.getNoDataLabel }}</div>
	{% endif %}
</div>