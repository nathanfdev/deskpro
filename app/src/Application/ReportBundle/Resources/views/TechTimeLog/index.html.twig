{% set this_page = 'agent_time_log_index' %}
{% extends 'ReportBundle::layout.html.twig' %}
{% block nav_block %}
{% endblock %}
{% block page %}
{% set blocks_in_hour = (60 / block_size) %}
{% set blocks_in_day = blocks_in_hour * 24 %}
<style type="text/css">
.dp-page-box {
    background-color: #FFFFFF;
}

.time_cell {
    width: 4px;
    vertical-align: middle;
    padding: 0px;
}

.time_cell.active .bar {
    background-color: #90ee90;
    height: 8px;
    border-bottom-style: solid;
    border-bottom-color: #999999;
    border-bottom-width: 1px;
    border-top-style: solid;
    border-top-color: #999999;
    border-top-width: 1px;
}

.time_cell.active.first .bar {
    border-left-style: solid;
    border-left-color: #999999;
    border-left-width: 1px;
}

.time_cell.active.last .bar {
    border-right-style: solid;
    border-right-color: #999999;
    border-right-width: 1px;
}

.time_row.last .time_cell {
    border-bottom-style: solid;
    border-bottom-color: #CCCCCC;
    border-bottom-width: 1px;
}

.left_panel {
    padding: 4px;
}

.left_panel.agent_total {
    border-right-style: solid;
    border-right-color: #CCCCCC;
    border-right-width: 1px;
}

.hour_title.first {
    border-left-style: solid;
    border-left-color: #CCCCCC;
    border-left-width: 1px;
}

.chart_container {
    padding: 0px;
    width: {{ 4*blocks_in_day }}px;
    height: 100%;
}

.chart_container > div {
    position: relative;
}

.chart_container > div > table {
    position: absolute;
}

.border_table {
    width: 100%;
    height: 100%;
}

.border_table td {
    border-right-style: solid;
    border-right-color: #CCCCCC;
    border-right-width: 1px;
    padding: 0px;
}

.date_today {
    padding: 8px;
    text-align: center;
}

.hour_title {
    text-align: center;
    border-right-style: solid;
    border-right-color: #CCCCCC;
    border-right-width: 1px;
    border-bottom-style: solid;
    border-bottom-color: #CCCCCC;
    border-bottom-width: 1px;
    border-top-style: solid;
    border-top-color: #CCCCCC;
    border-top-width: 1px;
    padding: 0px;
    width: {{ (4 * blocks_in_hour) -1 }}px;
}

.datepicker {
    position: relative;
}

.datepicker > span {
    position:absolute;
    z-index: 100;
    top: 24px;
    left: 0px;
}

.datepicker > span.hidden {
    display:none;
}

.datechooser {
    text-align: right;
}

.datepicker a {
    background: -moz-linear-gradient(#FAFCFD, #F0F2F3) repeat scroll 0 0 padding-box transparent;
    border: 1px solid #B6BABF;
    border-radius: 3px 3px 3px 3px;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.3), 0 1px 0 rgba(255, 255, 255, 0.5) inset, 0 0 0 1px rgba(255, 255, 255, 0.25) inset;
    color: #626A73;
    cursor: pointer;
    font-family: Arial,Helvetica,sans-serif;
    font-weight: bold;
    line-height: 12px;
    padding: 2px 8px 3px 6px;
    position: relative;
    text-shadow: 0 1px 0 #FFFFFF;
    font-size: 10px;
}

.datepicker em {
    background-image: url("../../../../web/images/agent/button-downarrow.png");
    background-repeat: no-repeat;
    display: inline-block;
    height: 5px;
    margin: 5px 0 0 5px;
    overflow: hidden;
    width: 7px;
}

.agent-hours-overlay {
    position: fixed;
    z-index: 50;
    bottom: 0px;
    right: 0px;
    left: 0px;
    top: 0px;
    background-color: #000000;
    opacity: 0.55;
}

.agent-hours-overlay.hidden {
    display:none;
}
</style>
<script type="text/javascript">
    $(document).ready(function(){
        $('.datepicker > span').datepicker(
                {
                    'onSelect': function(dateText) {
                        document.location = "{{ path('agent_time_log_list_date', {'date':''}) }}/" + dateText;
                    },
                    'dateFormat': 'yy-mm-dd',
                    'minDate': new Date({{ min_date|date('Y') }}, {{ min_date|date('m') }} -1, {{ min_date|date('d') }}),
                    'maxDate': new Date({{ max_date|date('Y') }}, {{ max_date|date('m') }} -1, {{ max_date|date('d') }}),
                    'defaultDate': new Date({{ today|date('Y') }}, {{ today|date('m') }} -1, {{ today|date('d') }})
                }
        );
        $('.datepicker > a').on('click', function(){
            if($('.datepicker > span').hasClass('hidden')) {
                $('.datepicker > span').removeClass('hidden');
                $('.agent-hours-overlay').removeClass('hidden');
            }
            else {
                $('.datepicker > span').addClass('hidden');
                $('.agent-hours-overlay').addClass('hidden');
            }
        });
        $('.agent-hours-overlay').on('click', function() {
            $('.datepicker > a').click();
        });
        {#$('.datechooser select').on('change', function() {
            document.location = $(this).val();
        });#}
        function resize()
        {
            $('.agent_row').each(function(i , element) {
                element = $(element);
                $('#agent_time_row-' + element.attr('id').split('-')[1]).css('height', element.height()+"px");
            });
        }

        $(window).on('resize', resize);
        resize();
    });

</script>
{#{% if dates|length %}
<div class="datechooser">
    <form>
        View Agent Activity for: <select>
            {% for date in dates %}
                <option {% if date|date('Y-m-d') == today|date('Y-m-d') %}selected="selected"{% endif %} value="{{ path('agent_time_log_list_date', {'date':date|date('Y-m-d')}) }}">
                    {{ date|date('dS F Y') }}
                </option>
            {% endfor %}
        </select>
    </form>
</div>
{% endif %}#}

<table class="chart_parent_table">
    <tr>
        <th rowspan="{% if agents|length %}2{% else %}1{% endif %}" colspan="2" class="left_panel empty"></th>
        <th class="date_today" colspan="24">
            {% if agents|length %}
            Agent activity for:
            {% else %}
            No agent activity for:
            {% endif %}
             {#{{ today|date('dS F Y') }}#}
        <span class="datepicker"><a>{{ today|date('jS F Y') }}<em></em></a><span class="hidden"></span></span>
        </th>
    </tr>
    {% if agents|length %}
    <tr>
        {% for i in range(0, 23) %}
            <td class="hour_title {% if loop.first %}first{% endif %}">
                {{ '%02d'|format(i) }}:00
            </td>
        {% endfor %}
    </tr>
    {% for agent in agents %}
    {% set last_active = 0 %}
    <tr id="agent_row-{{ agent.id }}" class="agent_row">
        <td class="left_panel agent_name">{{ agent.name }}</td>
        <td class="left_panel agent_total">({{ totals[agent.id].hours }}hrs, {{ totals[agent.id].minutes }}mins)</td>
        {% if loop.first %}
        <td class="chart_container" colspan="24" rowspan="{{ agents|length }}">
            <div><table>
                {% for agent in agents %}
                <tr id="agent_time_row-{{ agent.id }}" class="time_row {% if loop.last %}last{% endif %}">
                    {% for i in range(0, blocks_in_day - 1) %}
                    <td class="time_cell
                            {% if times[agent.id][i] is defined %}
                                {% if loop.first or not last_active %}first{% endif %}
                                {% if loop.last or not times[agent.id][i + 1] is defined %}last{% endif %}
                                {% set last_active = 1 %}
                                active
                            {% else %}
                            {% set last_active = 0 %}
                            {% if ((i + 1) % blocks_in_hour) == 0 %}hour{% endif %}
                        {% endif %}
                        "><div class="bar"></div></td>
                    {% endfor %}
                </tr>
                {% endfor %}
            </table></div>
            <table class="border_table">
                <tr>
                    {% for i in range(0, 23) %}
                    <td>&nbsp;</td>
                    {% endfor %}
                </tr>
            </table>
        </td>
        {% endif %}
    </tr>
    {% endfor %}
    {% endif %}
</table>

<div class="agent-hours-overlay hidden"></div>
{% endblock %}