{% set this_page = 'tech_time_log_index' %}
{% extends 'ReportBundle::layout.html.twig' %}
{% block nav_block %}
{% endblock %}
{% block page %}
<style type="text/css">
.dp-page-box {
    background-color: #FFFFFF;
}

.time_cell {
    width: 4px;
    vertical-align: middle;
}

.time_cell.active div {
    background-color: #90ee90;
    height: 6px;
    border-bottom-style: solid;
    border-bottom-color: #AAAAAA;
    border-bottom-width: 1px;
    border-top-style: solid;
    border-top-color: #AAAAAA;
    border-top-width: 1px;
}

.time_cell.active.first div {
    border-left-style: solid;
    border-left-color: #AAAAAA;
    border-left-width: 1px;
}

.time_cell.active.last div {
    border-right-style: solid;
    border-right-color: #AAAAAA;
    border-right-width: 1px;
}

.time_cell.hour {
    width: 3px;
    border-right-style: solid;
    border-right-color: #AAAAAA;
    border-right-width: 1px;
}

.time_cell.active {
}

.time_row.last .time_cell {
    border-bottom-style: solid;
    border-bottom-color: #AAAAAA;
    border-bottom-width: 1px;
}

.left_panel.agent_name {
    padding: 4px;
    border-right-style: solid;
    border-right-color: #AAAAAA;
    border-right-width: 1px;
}

.hour_title.first {
    border-left-style: solid;
    border-left-color: #AAAAAA;
    border-left-width: 1px;
}

.date_today {
    padding: 8px;
    border-bottom-style: solid;
    border-bottom-color: #AAAAAA;
    border-bottom-width: 1px;
}

.hour_title {
    text-align: center;
    border-right-style: solid;
    border-right-color: #AAAAAA;
    border-right-width: 1px;
    border-bottom-style: solid;
    border-bottom-color: #AAAAAA;
    border-bottom-width: 1px;
}
</style>
{% set blocks_in_hour = (60 / block_size) %}
{% set blocks_in_day = blocks_in_hour * 24 %}
<table border="1">

    <tr>
        <th rowspan="2" class="left_panel empty"></th>
        <th class="date_today" colspan="{{ blocks_in_day }}">Agent activity for {{ today|date('Y:m:d') }}</th>
    </tr>
    <tr>
        {% for i in range(0, 23) %}
            <td class="hour_title {% if loop.first %}first{% endif %}" colspan="{{ blocks_in_hour }}">
                {{ '%02d'|format(i) }}:00
            </td>
        {% endfor %}
    </tr>

    {% set last_active = 0 %}
    {% for agent in agents %}
        <tr class="time_row {% if loop.last %}last{% endif %}">
            <td class="left_panel agent_name">{{ agent.name }}</td>

            {% for i in range(0, blocks_in_day - 1) %}
                <td class="time_cell
                {% if times[agent.id][i] is defined %}
                    {% if not loop.first and not last_active %}first{% endif %}
                    {% if loop.last or not times[agent.id][i + 1] is defined %}last{% endif %}
                    {% set last_active = 1 %}
                    active
                {% else %}
                    {% set last_active = 0 %}
                    {% if ((i + 1) % blocks_in_hour) == 0 %}hour{% endif %}
                {% endif %}
                "><div></div></td>
            {% endfor %}
        </tr>
    {% endfor %}
</table>
{% endblock %}