<!DOCTYPE HTML>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="robots" content="NOINDEX" />
	<meta http-equiv="X-UA-Compatible" content="IE=100" />

	{{ dp_asset_html('agent_vendors_css') }}
	{{ dp_asset_html('agent_interface_css') }}
	{{ dp_asset_html('admin_interface_css') }}

	{{ dp_asset_html('agent_vendors') }}
	{{ dp_asset_html('agent_common') }}
	{{ dp_asset_html('agent_deskpro_ui') }}
	{{ dp_asset_html('admin_admin_ui') }}
	{{ dp_asset_html('admin_admin_handlers') }}
	{{ dp_asset_html('report_report_ui') }}

	{{ dp_asset_html('report_graphs') }}
	{{ dp_asset_html('report_interface_css') }}

	<script type="text/javascript" charset="utf-8">
		var DP_TINYMCE_URL = '{{ asset('javascripts/tiny_mce/tiny_mce.js') }}';
		var BASE_URL = '{{ app.request.getBaseUrl() }}';
		var ASSETS_BASE_URL = '{{ asset('') }}';
		if (!window.DESKPRO_URL_REGISTRY) window.DESKPRO_URL_REGISTRY = {};

		window._page_exec_stack = [];
		function _win_exec() {
			window.DeskPRO_Window = new DeskPRO.Report.Window();
			window.DeskPRO_Window.initPage();

			if (window._page_exec) {
				window._page_exec_stack.push(_page_exec);
			}

			for (var i = 0; i < window._page_exec_stack.length; i++) {
				window._page_exec_stack[i]();
			}

			if (window.DeskPRO_Page) {
				DeskPRO_Page.initPage();
			}

			// Init all others too
			var re = /^DeskPRO_Page_/;
			for (i in window) {
				if (re.test(i)) {
					window[i].initPage();
				}
			}
		}

		{% block html_headjs_load %}{% endblock %}

		$(document).ready(function() {
			_win_exec();
		});
	</script>
	{% block html_head %}{% endblock %}
	{% block page_js_exec %}{% endblock %}

	<script type="text/javascript" src="{{ asset('vendor/less/less.min.js') }}"></script>
</head>
<body class="{% if is_demo %}is-demo{% endif %}">

<!-- BEGIN HEADER BAR -->
<div id="dp_header">
	<!-- BEGIN USER SECTION -->
	<div id="DP-UserSection">
		<div id="DP-userControl">
			<div class="currentUserAvatar">
				<div class="userWrapper">
					<a onclick="toggle_visibility('userSetting');"><img src="{{ app.user.getPictureUrl(20) }}" alt="" /></a>
				</div>
				<span class="dropdownIcon" onclick="toggle_visibility('userSetting');"></span>
			</div>
		</div>
		<!-- Header - User Control Dropdown -->
		<div id="userSetting" style="display:none;">
			<div class="userProfileDropdown" >
				<div class="userProfileDropdownHeader">
					<a onclick="toggle_visibility('userSetting');"><img src="{{ app.user.getPictureUrl(20) }}" alt="" /></a>
				</div>
				<ul>
					<li class="logggedAs"><p>{{ phrase('global.logged_in_as') }}</p></li>
					<li class="currentUsername"><p>{{ app.user.display_name }}</p></li>
					<li class="setting" id="user_settings_link"><a>{{ phrase('global.settings') }}</a></li>
					<li class="help"><a>{{ phrase('global.help') }}</a></li>
					<li class="logout"><a href="{{ app.request.getBaseUrl() }}/logout/{{ static_security_token('user_logout', 0) }}?to=admin">{{ phrase('global.log_out') }}</a></li>
				</ul>
			</div>
		</div>
	<!-- END USER SECTION -->
	</div>

	<!-- BEGIN INTERFACE SECTION -->
	<div id="DP-InterfaceSwitcher">
		<div class="DP-adminSwitch">
			<div class="adminSwitcher">
				<a class="reports">{{ phrase('global.reports_interface') }}<span class="dropdownIcon"></span></a>
			</div>
		</div>
		<!-- Header - Switch Button Interfaces- Dropdown -->
		<div id="interfacesToggle" style="display:none;">
		<div class="dropdownSwitcherWrap">
			<div class="switcherHeader">
				<a class="reports"><span>{{ phrase('global.reports_interface') }}</span></a>
			</div>
			<ul>
				{% if app.user.can_admin %}<li><a class="admin" href="{{ app.request.getBaseUrl() }}/admin/login?dpsid-agent={{ app.getSession().getId() }}"><span>{{ phrase('global.admin_interface') }}</span></a></li>{% endif %}
				{% if app.user.can_agent %}<li><a class="agent" href="{{ app.request.getBaseUrl() }}/agent/"><span class="check">{{ phrase('global.agent_interface') }}</span></a></li>{% endif %}
				{% if app.user.can_billing %}<li><a class="billing" href=""><span class="check">{{ phrase('global.billing_interface') }}</span></a></li>{% endif %}
				{% if app.user.can_reports %}<li><a class="reports" href="{{ app.request.getBaseUrl() }}/reports"><span class="check">{{ phrase('global.report_interface') }}</span></a></li>{% endif %}
				{% if app.getSetting('user.portal_enabled') %}<li><a class="user" href="{{ app.request.getBaseUrl() }}/"><span class="check">{{ phrase('global.user_interface') }}</span></a></li>{% endif %}
			</ul>
		</div>
		</div>
	</div>
	<!-- END INTERFACE SECTION -->
</div>
<!-- /BEGIN HEADER BAR -->

<!-- BEGIN NAV BAR -->
<div id="dp_admin_nav">
	<nav>
		<ul>
			<li class="{% if this_page == 'trends_index' %}on{% endif %}"><a href="{{ path('report_trend_index') }}">{{ phrase('global.trends') }}</a></li>

			{% for dashboard in app.dashboards %}
				<li data-dashboard-id="{{ dashboard.id }}" class="dashboard {% if this_page == 'dashboard_' ~ dashboard.id %}on{% endif %}"><a href="{{ path('report_trend_dashboard_view', { 'dashboard_id': dashboard.id }) }}">{{ dashboard.title }}</a></li>
			{% endfor %}
			<li class="new"><a href="{{ path('report_trend_dashboard_new') }}" class="new">{{ phrase('report.views.new_dashboard') }}</a></li>
		</ul>
	</nav>
</div>

<div id="dp_page_wrap">

	{% set pagebar %}{% block pagebar %}{% endblock %}{% endset %}
	{% if pagebar|trim|length %}
		<div id="dp_admin_pagebar">{{ pagebar|raw }}</div>
	{% endif %}

	<div id="dp_admin_page" {% if not pagebar|trim|length %}class="no-header"{% endif %}>
		{% block content %}
			<div class="dp-page-box">
				<div class="page-content">
					{% block page %}{% endblock %}
				</div>
			</div>
		{% endblock %}
	</div>
</div>

</body>
</html>
