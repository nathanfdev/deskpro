<!DOCTYPE HTML>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="robots" content="NOINDEX" />
	<meta http-equiv="X-UA-Compatible" content="IE=100" />
	<title>DeskPRO Reports</title>

	{{ dp_asset_html('agent_vendors_css') }}
	{{ dp_asset_html('agent_interface_css') }}
	{{ dp_asset_html('admin_interface_css') }}

	{{ dp_asset_html('agent_vendors') }}
	{{ dp_asset_html('agent_common') }}
	{{ dp_asset_html('agent_deskpro_ui') }}
	{{ dp_asset_html('admin_admin_ui') }}
	{{ dp_asset_html('admin_admin_handlers') }}
	{{ dp_asset_html('report_report_ui') }}

	{{ dp_asset_html('report_interface_css') }}

	<script type="text/javascript" charset="utf-8">
		var DP_TINYMCE_URL = '{{ asset('javascripts/tiny_mce/tiny_mce.js') }}';
		var BASE_URL = '{{ app.request.getBaseUrl() }}';
		var ASSETS_BASE_URL = '{{ asset('') }}';
		if (!window.DESKPRO_URL_REGISTRY) window.DESKPRO_URL_REGISTRY = {};

		window._page_exec_stack = [];
		function _win_exec() {
			window.DeskPRO_Window = new DeskPRO.Report.Window();
			window.DeskPRO_Window.initPage();

			if (window._page_exec) {
				window._page_exec_stack.push(_page_exec);
			}

			for (var i = 0; i < window._page_exec_stack.length; i++) {
				window._page_exec_stack[i]();
			}

			if (window.DeskPRO_Page) {
				DeskPRO_Page.initPage();
			}

			// Init all others too
			var re = /^DeskPRO_Page_/;
			for (i in window) {
				if (re.test(i)) {
					window[i].initPage();
				}
			}
		}

		{% block html_headjs_load %}{% endblock %}

		$(document).ready(function() {
			_win_exec();
		});
	</script>
	{% block html_head %}{% endblock %}
	{% block page_js_exec %}{% endblock %}

	<script type="text/javascript" src="{{ asset('vendor/less/less.min.js') }}"></script>
</head>
<body class="reports-interface {% if is_demo %}is-demo{% endif %}">

<!-- BEGIN HEADER BAR -->
<div id="dp_header">
	{# User Logo #}
	<div id="dp_header_user">
	<div class="button-wrap" id="userSetting_trigger">
		<h1>
			<cite style="background-image: url({{ app.user.getPictureUrl(24) }});"></cite>
			<span class="drop"></span>
		</h1>
	</div>
</div>
	<!-- Header - User Control Dropdown -->
	<div id="userSetting" style="display:none;">
		<div class="userProfileDropdown" >
			<div class="userProfileDropdownHeader">
				<a><em style="background-image: url({{ app.user.getPictureUrl(24) }});"></em></a>
				<span class="drop"></span>
			</div>
			<ul>
				<li class="currentUsername"><p>{{ app.user.display_name }}</p></li>
				<li class="help"><a href="http://support.deskpro.com/">{{ phrase('agent.general.help') }}</a></li>
				<li class="logout"><a href="{{ app.request.getBaseUrl() }}/logout/{{ static_security_token('user_logout', 0) }}?to=admin">{{ phrase('agent.general.log_out') }}</a></li>
			</ul>
		</div>
	</div>
	<section class="trends {% if this_page == 'overview' %}on{% endif %}">
		<nav><h1
			class="tipped"
			data-tipped-options="hook: 'topleft', maxWidth: 500, skin: 'cloud', border: 1, shadow: {opacity:  0.5}"
			title="Overview gives you a clear, simple, interactive dashboard into the key metrics from your helpdesk. You can modify most statistics to sub-group the data by a particular property you are interested in or change the date range a statistic is generated for."
		><a href="{{ path('report') }}">{{ phrase('agent.report.overview') }}</a></h1></nav>
	</section>
	{#
	<section class="trends {% if 'dashboard_' in this_page %}on{% endif %}">
		<nav><h1
			class="tipped"
			data-tipped-options="hook: 'topleft', maxWidth: 500, skin: 'cloud', border: 1, shadow: {opacity:  0.5}"
			title="Trends show data that has been generated over time. Trend data is generated every hour, day, month or year capturing the situation at that time; for example you might want to see the trend for the number of tickets with a particular label over time. Most statistics tools will only show you the current status of tickets (i.e. the number of tickets that have a label right now) trends allows you to go back in time to see important helpdesk trends.<br /><br />Due to the nature of this data, trends have to be setup first and allowed to run before they can show you data."
		><a href="{{ path('report_trend_dashboard_index') }}">{{ phrase('agent.report.trends') }}</a></h1></nav>
	</section>
	#}
	<section class="builder {% if this_page == 'report_builder' %}on{% endif %}">
		<nav><h1
			class="tipped"
			data-tipped-options="hook: 'topleft', maxWidth: 500, skin: 'cloud', border: 1, shadow: {opacity:  0.5}"
			title="Report Builder is our powerful custom statistic and graph generator. With this tool you can generate almost any statistic about your helpdesk. The tools comes with a library of pre-built statistics and an editor to allow you to create your own."
		><a href="{{ path('report_builder') }}">{{ phrase('agent.report.report_builder') }}</a></h1></nav>
	</section>
	{% if app.getSetting('core_tickets.enable_billing') %}
	<section class="billing {% if this_page == 'report_billing' %}on{% endif %}">
		<nav><h1
			class="tipped"
			data-tipped-options="hook: 'topleft', maxWidth: 500, skin: 'cloud', border: 1, shadow: {opacity:  0.5}"
			title="Billing gives you access to reports on charges that agents have made to tickets. Billing reports include lists of charges and totals for charges per person, agent and organization."
		><a href="{{ path('report_billing') }}">Billing</a></h1></nav>
	</section>
	{% endif %}
	<section class="tech-activity {% if this_page == 'agent_activity_index' %}on{% endif %}">
		<nav><h1
			class="tipped"
			data-tipped-options="hook: 'topleft', maxWidth: 500, skin: 'cloud', border: 1, shadow: {opacity:  0.5}"
			title="Agent Activity gives you a detailed report into the activity of your agents on a specified date."
		><a href="{{ path('report_agent_activity_index') }}">{{ phrase('agent.report.agent_activity') }}</a></h1></nav>
	</section>
	<section class="tech-hours {% if this_page == 'report_agent_hours_index' %}on{% endif %}">
		<nav><h1
			class="tipped"
			data-tipped-options="hook: 'topleft', maxWidth: 500, skin: 'cloud', border: 1, shadow: {opacity:  0.5}"
			title="Agent Hours gives you an aggregate view of the time your agents are logged into the helpdesk on a specified date."
		><a href="{{ path('report_agent_hours_index') }}">{{ phrase('agent.report.agent_hours') }}</a></h1></nav>
	</section>
	<section class="feedback {% if this_page == 'report_agent_feedback_feed' or this_page == 'report_agent_feedback_index' %}on{% endif %}">
		<nav><h1
			class="tipped"
			data-tipped-options="hook: 'topleft', maxWidth: 500, skin: 'cloud', border: 1, shadow: {opacity:  0.5}"
			title="Feedback gives you a feed and aggregate view of the ticket feedback ratings from your customers."
		><a href="{{ path('report_agent_feedback_feed', {'page':0}) }}">Ticket Feedback</a></h1></nav>
	</section>

	{# DeskPRO Logo #}
	<div id="dp_logo_wrap">
		<div class="button-wrap">
			<h1>
				{{ phrase('agent.general.deskpro') }}
				<span class="drop"></span>
			</h1>
		</div>
	</div>
	<div id="dp_logo_expand_wrap">
		<div class="dropdown-header">
			<h1>
				{{ phrase('agent.general.deskpro') }}
				<span class="drop"></span>
			</h1>
		</div>
		<div class="dropdown-content">
			<a href="http://www.deskpro.com/" target="_blank">{{ phrase('agent.interface.powered_by') }} <span>{{ phrase('agent.interface.deskpro_website_host') }}</span></a>
		</div>
	</div>

	<!-- BEGIN INTERFACE SECTION -->
	<div id="DP-InterfaceSwitcher">
		<div class="DP-adminSwitch">
			<div class="adminSwitcher">
				<a class="reports">{{ phrase('agent.general.reports_interface') }}<span class="dropdownIcon"></span></a>
			</div>
		</div>
		<!-- Header - Switch Button Interfaces- Dropdown -->
		<div id="interfacesToggle" style="display:none;">
		<div class="dropdownSwitcherWrap">
			<div class="switcherHeader">
				<a class="reports"><span>{{ phrase('agent.general.reports_interface') }}</span></a>
			</div>
			<ul>
				{% if app.user.can_admin %}<li><a class="admin" href="{{ app.request.getBaseUrl() }}/admin/login?dpsid-agent={{ app.getSession().getId() }}"><span>{{ phrase('agent.general.admin_interface') }}</span></a></li>{% endif %}
				{% if app.user.can_agent %}<li><a class="agent" href="{{ app.request.getBaseUrl() }}/agent/"><span class="check">{{ phrase('agent.general.agent_interface') }}</span></a></li>{% endif %}
				{% if app.user.can_billing %}<li><a class="billing" href="{{ app.request.getBaseUrl() }}/billing" style="margin-right: -3px;"><span class="check">{% if app.isCloud() %}{{ phrase('agent.general.billing_interface') }}{% else %}{{ phrase('agent.general.license_interface') }}{% endif %}</span></a></li>{% endif %}
				{% if app.user.can_reports %}<li><a class="reports" href="{{ app.request.getBaseUrl() }}/reports"><span class="check">{{ phrase('agent.general.report_interface') }}</span></a></li>{% endif %}
				{% if app.getSetting('user.portal_enabled') %}<li><a class="user" href="{{ app.request.getBaseUrl() }}/"><span class="check">{{ phrase('agent.general.user_interface') }}</span></a></li>{% endif %}
			</ul>
		</div>
		</div>
	</div>
	<!-- END INTERFACE SECTION -->
</div>
<!-- /BEGIN HEADER BAR -->

{% block nav_block %}
<!-- BEGIN NAV BAR -->
<div id="dp_admin_nav" class="dp_admin_nav">
	<nav>
		<ul data-update-orders-url="{{ path('report_trend_dashboard_updateorders') }}">
			{% for dashboard in app.dashboards %}
				<li data-dashboard-id="{{ dashboard.id }}" class="dashboard {% if this_page == 'dashboard_' ~ dashboard.id %}on{% endif %}"><a href="{{ path('report_trend_dashboard_view', { 'dashboard_id': dashboard.id }) }}">{{ dashboard.title }}</a></li>
			{% endfor %}
			<li class="new" id="new_dashboard_trigger"><a href="{{ path('report_trend_dashboard_new') }}" class="new">{{ phrase('agent.report.new_dashboard') }}</a></li>
		</ul>
	</nav>
</div>
{% endblock %}

{% block all_page %}
<div id="dp_page_wrap" class="dp_page_wrap">

	{% set pagebar %}{% block pagebar %}{% endblock %}{% endset %}
	{% if pagebar|trim|length %}
		<div id="dp_admin_pagebar" class="dp_admin_pagebar">{{ pagebar|raw }}</div>
	{% endif %}

	<div id="dp_admin_page" class="dp_admin_page {% if not pagebar|trim|length %}no-header{% endif %}">
		{% block content %}
			<div class="dp-page-box">
				<div class="page-content">
					{% block page %}{% endblock %}
				</div>
			</div>
		{% endblock %}
	</div>
</div>
{% endblock %}

<div id="new_dashboard_overlay" style="width: 400px; height: 200px; overflow:auto; display: none;">
	<div class="overlay-title">
		<span class="close-overlay close-trigger"></span>
		<h4>{{ phrase('agent.report.new_dashboard') }}</h4>
	</div>
	<div class="overlay-content">
		<form action="{{ path('report_trend_dashboard_new') }}" method="post" id="new_dashboard_form">
			<input type="hidden" name="process" value="1" />

			<div class="dp-form">
				<div class="dp-form-row">
					<div class="dp-form-label">
						<label>{{ phrase('agent.general.title') }}</label>
					</div>
					<div class="dp-form-input">
						<input type="text" id="report_dashboard_title" name="report_dashboard[title]" />
					</div>
				</div>
			</div>
		</form>
	</div>
	<div class="overlay-footer">
		<button class="clean-white" onclick="$('#new_dashboard_form').submit();">{{ phrase('agent.general.save') }}</button>
	</div>
</div>

</body>
</html>
