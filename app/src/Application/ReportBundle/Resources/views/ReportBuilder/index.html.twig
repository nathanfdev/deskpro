{% extends 'ReportBundle:ReportBuilder:layout.html.twig' %}
{% block inner_page %}
	<form action="{{ path('report_builder')}}" method="post" class="dp-form">
		<div class="dp-form-row">
			<div class="dp-form-label"><label>DPQL Query</label></div>
			<div class="dp-form-input"><textarea name="query" style="height: 130px">{{ query }}</textarea></div>
		</div>
		<button class="btn primary">Run Query</button>
	</form>

	{% if query %}
		<div class="report-builder-results">
			<div style="overflow: hidden; zoom: 1">
				<pre style="width: 49%; float: left; overflow: auto">{{ query }}</pre>
				{% if statement %}
					<pre style="width: 49%; float: left; overflow: auto">{{ statement.toSql() }}</pre>
				{% endif %}
			</div>
			{% include 'ReportBundle:ReportBuilder:results.html.twig' %}
		</div>
	{% endif %}
{% endblock %}