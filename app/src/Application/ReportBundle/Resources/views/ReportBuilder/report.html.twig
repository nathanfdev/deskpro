{% extends 'ReportBundle:ReportBuilder:layout.html.twig' %}
{% block inner_page %}
	<h1>{{report.title}}</h1>
	{% if report.description %}<p>{{ report.description|nl2br }}</p>{% endif %}
	{% if report.parent %}
		<p>Clone of <a href="{{ path('report_builder_report', {'report_builder_id': report.parent.id})}}"
			>{{report.parent.title}}</a></p>
	{% endif %}

	<div>
		{% if report.isEditable() %}
		<a href="{{ path('report_builder_edit', {'report_builder_id': report.id}) }}">Edit</a>
		<a href="{{ path('report_builder_delete', {'report_builder_id': report.id}) }}">Delete</a>
		{% endif %}
		{% if report.isFavorited() %}
		<a href="{{ path('report_builder_favorite', {'report_builder_id': report.id, 'favorite': 0, 'token': security_token('report_builder_favorite')}) }}">Unfavorite</a>
		{% else %}
		<a href="{{ path('report_builder_favorite', {'report_builder_id': report.id, 'favorite': 1, 'token': security_token('report_builder_favorite')}) }}">Favorite</a>
		{% endif %}
	</div>

	<form action="{{ path('report_builder_report', {'report_builder_id' : report.id}) }}" method="post">
		<div>
			<textarea name="query" rows="5" cols="50" {{ report.isEditable() ? '' : 'readonly="readonly"' }}
			>{{ query }}</textarea>
			{% if not report.isEditable() %}
				<br />To customize this report, please clone it.
			{% endif %}
		</div>
		<button class="btn primary" name="run" value="1">Run Report</button>
		{% if query != report.query and error is empty and report.isEditable() %}
			<button class="btn" name="save" value="1">Save Changes</button>
		{% endif %}
		<button class="btn" name="clone" value="1">Clone</button>

		{% include 'ReportBundle:ReportBuilder:results.html.twig' %}

		{{ form_token() }}
	</form>
{% endblock %}