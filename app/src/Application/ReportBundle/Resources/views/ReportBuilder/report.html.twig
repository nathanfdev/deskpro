{% extends 'ReportBundle:ReportBuilder:layout.html.twig' %}
{% block inner_page %}
	<h1>
		{% if report.isEditable() %}
			<a href="{{ path('report_builder_delete', {'report_builder_id': report.id}) }}" class="report-action"
					><img src="{{ asset('images/report/icons/close.png') }}" alt="Delete" /></a>
			<a href="{{ path('report_builder_edit', {'report_builder_id': report.id}) }}" class="report-action"
					><img src="{{ asset('images/report/icons/edit.png') }}" alt="Edit" /></a>
		{% endif %}
		{% if report.isFavorited() %}
			<a href="{{ path('report_builder_favorite', {
				'report_builder_id': report.id,
				'favorite': 0,
				'token': security_token('report_builder_favorite')}
				) }}" class="report-favorite favorited" title="Remove Favorite">Remove Favorite</a>
		{% else %}
		<a href="{{ path('report_builder_favorite', {
				'report_builder_id': report.id,
				'favorite': 1,
				'token': security_token('report_builder_favorite')}
				) }}" class="report-favorite" title="Mark as Favorite">Mark as Favorite</a>
		{% endif %}
		{{report.title}}
	</h1>
	{% if report.description %}<p>{{ report.description|nl2br }}</p>{% endif %}
	{% if report.parent %}
		<p>Clone of <a href="{{ path('report_builder_report', {'report_builder_id': report.parent.id})}}"
			>{{report.parent.title}}</a></p>
	{% endif %}

	<form action="{{ path('report_builder_report', {'report_builder_id' : report.id}) }}" class="dp-form" method="post">
		{% include 'ReportBundle:ReportBuilder:query-editor.html.twig' with {'readOnly': not report.isEditable()} %}

		<button class="btn primary" name="run" value="1">Run Report</button>
		{% if error is empty and report.isEditable() and report.isQueryDifferent(query) %}
		<button class="btn" name="save" value="1">Save Changes</button>
		{% endif %}

		<div class="report-actions">
			<button class="btn" name="clone" value="1">Clone</button>
		</div>

		{% if run %}
			{% include 'ReportBundle:ReportBuilder:results.html.twig' %}
		{% endif %}

		{{ form_token() }}
	</form>
{% endblock %}