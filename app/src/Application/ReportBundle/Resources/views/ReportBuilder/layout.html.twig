{% set this_page = 'report_builder' %}
{% extends 'ReportBundle::layout.html.twig' %}
{% block nav_block %}
{% endblock %}
{% block pagebar %}
{% endblock %}
{% block html_head %}
{{ dp_asset_html('report_builder') }}

<style type="text/css">
	.report-builder-results h3, .report-builder-results pre, .report-builder-results table { margin: 10px 0; }

	.report-builder-results td,
	.report-builder-results th {
		padding: 2px;
		border: 1px solid black;
		text-align: center;
		vertical-align: middle;
	}

	.report-container:after {
		visibility: hidden;
		display: block;
		font-size: 0;
		content: " ";
		clear: both;
		height: 0;
	}
	.report-container { *zoom: 1; }

	.report-list {
		float: left;
		width: 200px;
	}

	.report-list li {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.report-page-body {
		padding-left: 10px;
		overflow: auto;
	}
</style>
{% endblock %}
{% block page %}
<div class="report-container">
	<div style="float: left; width: 200px" class="report-list">
		<div><a href="{{ path('report_builder_new') }}">Create Report</a></div>

		{% if favoriteReports %}
		<h3>Favorite Reports</h3>
		<ul>
			{% for report in favoriteReports %}
			<li><a href="{{ path('report_builder_report', {'report_builder_id': report.id}) }}"
					title="{{ report.title }}">{{ report.title }}</a></li>
			{% endfor %}
		</ul>
		{% endif %}

		{% if customReports %}
		<h3>Custom Reports</h3>
		<ul>
			{% for report in customReports %}
			<li><a href="{{ path('report_builder_report', {'report_builder_id': report.id}) }}"
				   title="{{ report.title }}">{{ report.title }}</a></li>
			{% endfor %}
		</ul>
		{% endif %}

		{% if builtInReports %}
		<h3>Built-In Reports</h3>
		<ul>
			{% for categoryName, reports in builtInReports %}
				<li><h4>{{ categoryName }}</h4>
					<ul>
					{% for report in reports %}
						<li><a href="{{ path('report_builder_report', {'report_builder_id': report.id}) }}"
							   title="{{ report.title }}">{{ report.title }}</a></li>
					{% endfor %}
					</ul>
				</li>
			{% endfor %}
		</ul>
		{% endif %}
	</div>
	<div class="report-page-body">
		{% block inner_page %}{% endblock %}
	</div>
</div>
{% endblock %}