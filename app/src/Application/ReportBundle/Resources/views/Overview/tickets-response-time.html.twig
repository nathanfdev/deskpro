{% import 'ReportBundle:Overview:macros.html.twig' as macros %}
<section class="report-wrapper">
	<header>
		<h2>
			Average First Response Time
			<span class="drop-option">
				<select class="grouping-field" name="date_choice">
					{% for field,title in {
						'today': 'Today',
						'this_week': 'This Week',
						'this_month': 'This Month',
						'this_year': 'This Year',
					} %}
						<option {% if data.date_choice == field %}selected="selected"{% endif %} value="{{ field }}">{{ title }}</option>
					{% endfor %}
				</select>
				<i></i>
			</span>
			| Showing Grouped by {{ macros.grouping_field_select(data.grouping_field, {none: true}) }}
		</h2>
	</header>
	<article>
		<div class="loading-overlay" style="display: none"><strong>Loading</strong></div>
		<table class="stat-table" width="100%">
			{% for id, title in data.titles %}
				<tr>
					<td class="title"><span>{{ title }}</span></td>
					<td width="100%">
						{% if not data.sub_titles %}
							{% if data.values[id] %}
								<table width="100%" class="stat-value"><tr>
									{% set perc = (data.values[id] / data.max|default(1)) * 100 %}
									{% if perc < 1.0 %}
										<td class="value" width="1%"><div>&nbsp;</div></td>
										<td><span style="white-space: nowrap;">{{ data.values[id]|default(0) }}</span></td>
									{% else %}
										<td class="value" width="{{ perc }}%"><div>&nbsp;</div></td>
										<td><span style="white-space: nowrap;">{{ data.values[id]|default(0) }}</span></td>
									{% endif %}
								</tr></table>
							{% endif %}
						{% else %}
							{% if data.group_total[id] %}
								<table width="100%"><tr>
									{% set perc = (data.group_total[id] / data.max|default(1)) * 100 %}
									<td width="{{ perc }}%">
										<table width="100%" class="stat-value stat-value-multi">
											<tr>
											{% for subid, subtitle in data.sub_titles %}
												{% if data.values[id][subid] %}
													{% set perc = (data.values[id][subid] / data.group_total[id]) * 100 %}
													{% if perc < 1.0 %}
														<td title="{{ subtitle }} ({{ data.values[id][subid] }})" class="value" width="1%"><div style="background-color:#{{data.group_keys[subid]}}">&nbsp;</div></td>
													{% else %}
														<td title="{{ subtitle }} ({{ data.values[id][subid] }})" class="value item-{{ data.group_keys[subid] }}" width="{{ perc }}%"><div style="background-color:#{{data.group_keys[subid]}}">&nbsp;</div></td>
													{% endif %}
												{% endif %}
											{% endfor %}
											</tr>
										</table>
									</td>
									<td><span style="white-space: nowrap;">{{ data.group_total[id]|default(0) }}</span></td>
								</tr></table>
							{% endif %}
						{% endif %}
					</td>
				</tr>
			{% endfor %}
		</table>
	</article>
</section>