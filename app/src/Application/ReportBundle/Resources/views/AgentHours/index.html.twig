{% set this_page = 'report_agent_hours_index' %}
{% extends 'ReportBundle::layout.html.twig' %}

{% block nav_block %}
{% endblock %}

{% block pagebar %}
	<ul>
		<li>
			<span class="dp-title">
				Viewing agent hours for
			</span>
			<span class="dp-nav-btn datepicker"><a>{{ view_date|date('jS F Y') }}</a><em class="drop"></em><span class="hidden"></span></span>
		</li>
	</ul>
{% endblock %}

{% block page %}
<div class="reports_agent_hours_section">
{% set blocks_in_hour = (60 / block_size) %}
{% set blocks_in_day = blocks_in_hour * 24 %}
<style type="text/css">

#dp_admin_pagebar {
	overflow: visible;
}

#dp_admin_pagebar .datepicker > a > em {
	height: 6px;
	margin-left: 8px;
}

#dp_admin_pagebar .datepicker > span {
	font-size: 100%;
	line-height: 100%;
	text-shadow: none;
}

.time_cell {
    width: 4px;
    vertical-align: middle;
    padding: 0px;
	margin: 0;
	overflow: hidden;
}

.time_cell.active .bar {
    background-color: #90ee90;
    height: 8px;
    border-bottom-style: solid;
    border-bottom-color: #999999;
    border-bottom-width: 1px;
    border-top-style: solid;
    border-top-color: #999999;
    border-top-width: 1px;
	position: relative;
	z-index: 1;
}

.time_cell.active.first .bar {
    border-left-style: solid;
    border-left-color: #999999;
    border-left-width: 1px;
}

.time_cell.active.last .bar {
    border-right-style: solid;
    border-right-color: #999999;
    border-right-width: 1px;
}

.left_panel {
    padding: 4px;
	width: 225px;
}

.left_panel.agent_total {
    border-right-style: solid;
    border-right-color: #CCCCCC;
    border-right-width: 1px;
}

.hour_title.first {
    border-left-style: solid;
    border-left-color: #CCCCCC;
    border-left-width: 1px;
}

.chart_container {
    padding: 0px;
    width: {{ 4*blocks_in_day }}px;
    height: 100%;
}

.chart_container > div {
    position: relative;
}

.chart_container > div > table {
    position: absolute;
}

.border_table {
    height: 100%;
	position: relative;
	left: 1px;
	border-collapse: collapse;
}

.border_table td {
    padding: 0px;
	width: 4px;
	border-right: 1px solid transparent;
	padding: 0;
	margin: 0;
	height: {{ (26 * agents|length) + 5 }}px;
}

.border_table td.hour {
	border-right: 1px solid #CCCCCC;
}

.date_today {
    padding: 8px;
    text-align: center;
}

.hour_title {
    text-align: center;
    border-right-style: solid;
    border-right-color: #CCCCCC;
    border-right-width: 1px;
    border-bottom-style: solid;
    border-bottom-color: #CCCCCC;
    border-bottom-width: 1px;
    border-top-style: solid;
    border-top-color: #CCCCCC;
    border-top-width: 1px;
    padding: 0px;
    width: {{ (4 * blocks_in_hour) -1 }}px;
}

</style>
<script type="text/javascript">
    $(document).ready(function(){
        $('.datepicker > span').datepicker(
                {
                    'onSelect': function(dateText) {
                        document.location = "{{ path('report_agent_hours_list_date', {'date':''}) }}/" + dateText;
                    },
                    'dateFormat': 'yy-mm-dd',
                    'minDate': new Date({{ min_date|date('Y') }}, {{ min_date|date('m') }} -1, {{ min_date|date('d') }}),
                    'maxDate': new Date({{ max_date|date('Y') }}, {{ max_date|date('m') }} -1, {{ max_date|date('d') }}),
                    'defaultDate': new Date({{ view_date|date('Y') }}, {{ view_date|date('m') }} -1, {{ view_date|date('d') }})
                }
        );
        $('.datepicker > a').on('click', function(){
            if($('.datepicker > span').hasClass('hidden')) {
                $('.datepicker > span').removeClass('hidden');
                $('.reports-popup-page-overlay').removeClass('hidden');
            }
            else {
                $('.datepicker > span').addClass('hidden');
                $('.reports-popup-page-overlay').addClass('hidden');
            }
        });
        $('.reports-popup-page-overlay').on('click', function() {
            $('.datepicker > a').click();
        });
        function resize()
        {
            $('.agent_row').each(function(i , element) {
                element = $(element);
                $('#agent_time_row-' + element.attr('id').split('-')[1]).css('height', element.height()+"px");
            });
        }

        $(window).on('resize', resize);
        resize();
    });

</script>

<div class="chart-wrapper" style="position:relative;">
	<table class="chart_parent_table">
		{% if not agents|length %}
		<tr>
			<th rowspan="1" colspan="2" class="left_panel empty"></th>
			<th class="date_today" colspan="24">
				{% if not agents|length %}No agent activity for {{ view_date|date('jS F Y') }}{% endif %}
				&nbsp;
			</th>
		</tr>
		{% endif %}
		{% if agents|length %}
			<tr>
				<td class="left_panel empty">&nbsp;</td>
				{% for i in range(0, 23) %}
					<td class="hour_title {% if loop.first %}first{% endif %}">
						{{ '%02d'|format(i) }}:00
					</td>
				{% endfor %}
			</tr>
			{% for agent in agents %}
				<tr>
					<td class="left_panel empty" style="text-align: right;">
						{{ agent.name }}
						<em style="font-style: normal; font-size: 10px;">({{ totals[agent.id].hours }}hrs, {{ totals[agent.id].minutes }}mins)</em>
					</td>
					{% for i in range(0, 23) %}
						<td class="hour_title {% if loop.first %}first{% endif %}">
							&nbsp;
						</td>
					{% endfor %}
				</tr>
			{% endfor %}
		{% endif %}
	</table>
	{% if agents|length %}
	<table class="chart_parent_table" style="position:absolute; top:0; left:0;">
		<tr>
			<td class="left_panel empty">&nbsp;</td>
			{% for i in range(0, 23) %}
				<td>
					&nbsp;
				</td>
			{% endfor %}
		</tr>
		{% for agent in agents %}
			{% set last_active = 0 %}
			<tr id="agent_row-{{ agent.id }}" class="agent_row">
				<td class="left_panel">&nbsp;</td>
				{% if loop.first %}
				<td class="chart_container" colspan="24" rowspan="{{ agents|length }}">
					<div><table>
						{% for agent in agents %}
						<tr id="agent_time_row-{{ agent.id }}" class="time_row {% if loop.last %}last{% endif %}">
							{% for i in range(0, blocks_in_day - 1) %}
							<td class="time_cell
									{% if times[agent.id][i] is defined %}
										{% if loop.first or not last_active %}first{% endif %}
										{% if loop.last or not times[agent.id][i + 1] is defined %}last{% endif %}
										{% set last_active = 1 %}
										active
									{% else %}
									{% set last_active = 0 %}
									{% if ((i + 1) % blocks_in_hour) == 0 %}hour{% endif %}
								{% endif %}
								"><div class="bar"></div></td>
							{% endfor %}
						</tr>
						{% endfor %}
					</table></div>
				</td>
				{% endif %}
			</tr>
    	{% endfor %}
	</table>
	{% endif %}
</div>

<div class="reports-popup-page-overlay hidden"></div>
</div>
{% endblock %}