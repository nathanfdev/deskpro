{% extends 'ReportBundle::layout.html.twig' %}
{% block page %}

<form action="{{ path('report_trend_dashboard_new') }}" method="post">
	<input type="hidden" name="process" value="1" />

	<div class="dp-form">
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('report.dashboard.title') }}</label>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.title) }}
			</div>
		</div>
	</div>

	{{ form_rest(form) }}

	<button class="btn primary save-trigger">{{ phrase('report.dashboard.save') }}</button>
</form>

{% endblock %}