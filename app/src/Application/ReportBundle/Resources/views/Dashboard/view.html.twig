{% set this_page = 'dashboard_' ~ dashboard.id %}
{% extends 'ReportBundle::layout.html.twig' %}
{% block html_head %}
{{ dp_asset_html('report_dashboard') }}
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
	window.DESKPRO_URL_REGISTRY['report_dashboard_ajaxfetchwidgets']  = '{{ path('report_dashboard_ajaxfetchwidgets', {'dashboard_id': dashboard.id }) }}';
	window.DESKPRO_URL_REGISTRY['report_trend_dashboard_stat_edit']  = '{{ path('report_trend_dashboard_stat_edit', {'dashboard_id': dashboard.id, 'dashboard_stat_id': '000' })|replace({'000': '{dashboard_stat_id}'}) }}';
	window.DESKPRO_URL_REGISTRY['report_dashboard_ajaxdeletewidget']  = '{{ path('report_dashboard_ajaxdeletewidget', {'dashboard_id': dashboard.id, 'dashboard_stat_id': '000' })|replace({'000': '{dashboard_stat_id}'}) }}';
    window.DESKPRO_URL_REGISTRY['report_chart_get_fullscreen_details']  = '{{ path('report_chart_get_fullscreen_details', {'dashboard_stat_id': '000'})|replace({'000': '{dashboard_stat_id}'}) }}';
	window.DESKPRO_URL_REGISTRY['report_chart_get']  = '{{ path('report_chart_get', {'dashboard_stat_id': '000'})|replace({'000': '{dashboard_stat_id}'}) }}';
	window.DESKPRO_URL_REGISTRY['report_chart_get_settings']  = '{{ path('report_chart_get_settings', {'dashboard_stat_id': '000', '_format': 'xml'})|replace({'000': '{dashboard_stat_id}'}) }}';

	var options = {};
	options.number_columns = {{ dashboard.number_columns }};
	window.DeskPRO_Page = new DeskPRO.Report.PageHandler.Dashboard({{ dashboard.id }}, options);
}
</script>
{% endblock %}
{% block pagebar %}
	<nav>
		<ul>
			<li id="report-dashboard-set-editable" class="edit"><a href="#">{{ phrase('agent.general.ucfirst_edit') }}</a></li>
		</ul>
	</nav>
	<ul>
		<li>{{ dashboard.title }}</li>
	</ul>
{% endblock %}
{% block page %}
	<div id="report-dashboard-options">
		<form id="dashboard_edit_form" action="{{ path('report_trend_dashboard_edit', {'dashboard_id': dashboard.id}) }}" method="post">
			<input type="hidden" name="process" value="1" />

			<div class="dp-form">
				<div class="dp-form-row">
					<div class="dp-form-label">
						<label>{{ phrase('agent.general.title') }}</label>
					</div>
					<div class="dp-form-input">
						{{ form_widget(form.title) }}
					</div>
				</div>

				<div class="dp-form-row">
					<div class="dp-form-label">
						<label>{{ phrase('agent.report.number_columns') }}</label>
					</div>
					<div class="dp-form-input">
						<div id="report-dashboard-options-num-columns-slider"></div>
					</div>
				</div>
			</div>

			<a id="report-dashboard-delete" href="{{ path('report_trend_dashboard_delete', {'dashboard_id': dashboard.id}) }}" class="btn secondary">{{ phrase('agent.general.ucfirst_delete') }}</a>
			<a id="report-dashboard-set-viewable" href="#" class="btn primary">{{ phrase('agent.general.save') }}</a>
		</form>
	</div>

	<div id="report-dashboard">
		<div style="clear: both"></div>
	</div>

	<div id="overlay_wrapper" style="width: 950px; height: 600px; display: none;">
		<div class="overlay-title">
			<span class="close-overlay"></span>
			<h4>{{ phrase('agent.report.add_dashboard_chart') }}</h4>
		</div>
		<div class="overlay-content">

		</div>
		<div class="overlay-loader">
			<img src="{{ asset('images/spinners/loading-big-circle.gif') }}" alt="{{ phrase('agent.general.loading_dot') }}" />
		</div>
		<div class="overlay-footer">

		</div>
	</div>

	<div id="fullscreen_overlay_wrapper" style="display: none; height: 200px; width: 100%;">
		<div class="overlay-title">
			<span class="close-overlay"></span>
			<h4>{{ phrase('agent.report.view_chart') }}</h4>
		</div>
		<div class="overlay-content"  style="padding: 0">
			<div id="fullscreen_overlay_wrapper_content"></div>
		</div>
		<div class="overlay-loader">
			<img src="{{ asset('images/spinners/loading-big-circle.gif') }}" alt="{{ phrase('agent.general.loading_dot') }}" />
		</div>
		<div class="overlay-footer">

		</div>
	</div>

	{% include 'ReportBundle:Dashboard:widget.html.twig' %}

{% endblock %}
