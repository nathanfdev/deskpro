<form action="{{ form_route }}" method="post" id="{{ form_id }}">
	<input type="hidden" name="process" value="1" />

	<div class="dp-form">
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('report.dashboard.title') }}</label>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.title, { 'placeholder': 'test' }) }}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('report.dashboard.chart_type') }}</label>
			</div>
			<div class="dp-form-input chart-type-select">
				{{ form_widget(form.chart_type) }}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('report.dashboard.show_legend') }}</label>
				<span>{{ phrase('report.dashboard.select_yes_to_display_the_chart_legend_works') }}</span>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.show_legend) }}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('report.dashboard.display_grouping_data') }}</label>
				<span>Select yes to display the data grouped by {{ stat.getGroupingName }}</span>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.display_grouping) }}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('report.dashboard.data_range') }}</label>
				<span>How many {{ stat.getRunPeriodLength() }} worth of data do you want to display?</span>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.number_data_points) }}
			</div>
		</div>
	</div>

	{{ form_rest(form) }}

	<button class="btn primary save-trigger">{{ phrase('report.dashboard.save') }}</button>
</form>
