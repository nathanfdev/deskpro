<form action="{{ form_route }}" method="post" id="{{ form_id }}">
	<input type="hidden" name="process" value="1" />

	<div class="dp-form">
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('agent.title') }}</label>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.title, { 'placeholder': 'test' }) }}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('agent.report.chart_type') }}</label>
			</div>
			<div class="dp-form-input chart-type-select">
				{{ form_widget(form.chart_type) }}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('agent.report.show_legend') }}</label>
				<span>{{ phrase('agent.report.select_show_chart_legend') }}</span>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.show_legend) }}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('agent.report.display_grouping_data') }}</label>
				<span>{{ phrase('agent.report.display_grouping_data', {'group_by': stat.getGroupingName }) }}</span>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.display_grouping) }}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('agent.report.data_range') }}</label>
				<span>{{ phrase('agent.report.ask_time_unit_amount', {'period_type': stat.getRunPeriodLength() }) }}</span>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.number_data_points) }}
			</div>
		</div>
	</div>

	{{ form_rest(form) }}

	<button class="btn primary save-trigger">{{ phrase('agent.save') }}</button>
</form>
