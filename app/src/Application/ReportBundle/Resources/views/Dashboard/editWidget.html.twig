<form action="{{ form_route }}" method="post" id="{{ form_id }}">
	<input type="hidden" name="process" value="1" />

	<div class="dp-form">
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('agent.general.title') }}</label>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.title) }}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('agent.report.chart_type') }}</label>
			</div>
			<div class="dp-form-input chart-type-select">
				{{ form_widget(form.chart_type) }}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('agent.report.show_legend') }}</label>
				<span>{{ phrase('agent.report.select_show_chart_legend') }}</span>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.show_legend) }}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('agent.report.display_grouping_data') }}</label>
				<span>{{ phrase('agent.report.display_grouping_data', {'group_by': stat.getGroupingName }) }}</span>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.display_grouping) }}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('agent.report.data_range') }}</label>
				<span>{{ phrase('agent.report.ask_time_unit_amount', {'period_type': stat.getRunPeriodLength() }) }}</span>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.number_data_points) }}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('agent.general.group_by') }}</label>
				<span>{{ phrase('agent.report.select_group_field') }}</span>
			</div>
			<div class="dp-form-input group-by">
				{{ form_widget(trend_form.grouping_ref) }}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label"><label>{{ phrase('agent.general.criteria') }}</label></div>
			<div class="dp-form-input">
				<div class="search-form criteria_list">
					<div class="search-terms"></div>
					<div class="term"><span class="add-term">+</span> {{ phrase('agent.general.add_a_new_term') }}</div>
				</div>
				{% include 'DeskPRO:Common:ticket-search-criteria.html.twig' with { 'classname': 'search-builder-tpl', 'term_options': term_options, 'search_context': 'filter' } %}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('agent.report.difference') }}</label>
				<span>{{ phrase('agent.report.ask_positive_number') }}</span>
			</div>
			<div class="dp-form-input">
				{{ form_widget(trend_form.variation) }}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>{{ phrase('agent.general.frequency') }}</label>
				<span>{{ phrase('agent.report.ask_run_interval') }}</span>
			</div>
			<div class="dp-form-input">
				{{ form_widget(trend_form.run_frequency) }}
			</div>
		</div>
	</div>

	{{ form_rest(form) }}
	{{ form_rest(trend_form) }}

	<button class="btn primary save-trigger">{{ phrase('agent.general.save') }}</button>

	<script type="text/x-json" class="set_terms_json">{{ stat.criteria|json_encode|raw }}</script>
</form>
