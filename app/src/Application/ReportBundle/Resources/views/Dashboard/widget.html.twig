<script id="dashboard_widget" type="text/x-jquery-tmpl">
	<div class="widget chart-widget" id="${widget.element_id}" data-id="${widget.widget_id}">
		<span class="inner">
			<span class="grid-slot-toolbar ui-corner-all">
				<a href="#" class="toolbar-title">${widget.title}</a>
				<span class="icons">
					<a href="#" class="edit">
						<img src="{{ asset('images/report/icons/edit.png') }}" alt="{{ phrase('agent.report.e') }}" />
					</a>
					<a href="#" class="delete">
						<img src="{{ asset('images/report/icons/close.png') }}" alt="{{ phrase('agent.report.x') }}" />
					</a>
				</span>
			</span>
			<span class="grid-slot-content">
				<span id="widget_content_${widget.element_id}" class="content">
				</span>
				<span class="content-loader"></span>
			</span>
		</span>
	</div>
</script>

<script id="dashboard_widget_create" type="text/x-jquery-tmpl">
	<div class="widget" id="dashboard-new-placeholder">
		<span class="inner">
			<a href="#" id="dashboard-new-placeholder-link">Click to Add Chart<br />Or Drop an Existing Chart</a>
		</span>
	</div>
</script>
