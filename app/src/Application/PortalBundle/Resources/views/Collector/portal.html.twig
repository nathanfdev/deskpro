{% extends 'WebProfilerBundle:Profiler:layout.html.twig' %}

{% block toolbar %}
	{% set icon %}
	<span class="sf-toolbar-icon">

	<span class="sf-toolbar-info-piece-additional-detail">
	<span class="sf-toolbar-info-with-delimiter">{{ collector.themeName }} Theme</span>
	<span class="sf-toolbar-info-with-delimiter">{{ collector.brandName }}</span>
	<span class="sf-toolbar-info-with-delimiter">mode: {{ collector.mode }}</span>
	<span>
		<img
			src="{{ asset('web/images/flags/'~collector.languageImage) }}"
			alt="{{ collector.languageCode }}" />
	</span>
	</span>
	</span>
	{% endset %}
	{% set text %}
	{% spaceless %}
		<div class="sf-toolbar-info-piece">
			<b>Theme ID</b>
			{{ collector.themeId }}
		</div>
		<div class="sf-toolbar-info-piece">
			<b>Brand ID</b>
			{{ collector.brandId }}
		</div>
		<div class="sf-toolbar-info-piece">
			<b>Language</b>
			<img
				src="{{ asset('web/images/flags/'~collector.languageImage) }}"
				alt="{{ collector.languageCode }}" />
			{{ collector.languageCode }} -
			{{ collector.languageId }}
		</div>
		<div class="sf-toolbar-info-piece">
			<b>Mode</b>
			{{ collector.mode }}
		</div>
	{% endspaceless %}
	{% endset %}
	{% include '@WebProfiler/Profiler/toolbar_item.html.twig' with { 'link': profiler_url } %}
{% endblock %}

{% block menu %}
	<span class="label">
    <span class="icon"><img
		    src="data:image/png;base64,"
		    alt="Request"></span>
    <strong>Portal</strong>
</span>
{% endblock %}

{% block panel %}
	<h2>Brand and Theme Info</h2>
	<table>
		<tr>
			<th>&nbsp;</th>
			<th>Name / Value</th>
			<th>Entity / ID</th>
		</tr>
		<tr>
			<th>Theme</th>
			<td>{{ collector.themeName }}</td>
			<td>{{ collector.themeId }}</td>
		</tr>
		<tr>
			<th>Brand</th>
			<td>{{ collector.brandName }}</td>
			<td>{{ collector.brandId }}</td>
		</tr>
		<tr>
			<th>Language</th>
			<td><img
					src="{{ asset('web/images/flags/'~collector.languageImage) }}"
					alt="{{ collector.languageCode }}" />
				{{ collector.languageCode }}</td>
			<td>{{ collector.languageId }}</td>
		</tr>
		<tr>
			<th>Mode</th>
			<td>{{ collector.mode }}</td>
			<td>&nbsp;</td>
		</tr>
	</table>

	<h2>Brand Settings</h2>
	<table>
		<tr>
			<th>Setting Name</th>
			<th>Setting Value</th>
		</tr>
		{% for key,val in collector.settings %}
			<tr>
				<td>{{ key }}</td>
				<td>{% if val[0] is defined %}{{ val }}{% else %}{{ dump(val) }}{% endif %}</td>
			</tr>
		{% endfor %}
	</table>
{% endblock %}
