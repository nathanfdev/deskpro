<?xml version="1.0" encoding="UTF-8" ?>
<rss version="2.0">
    <channel>
        {% if category %}
            <title>{{ brand_setting('core.deskpro_name') }} - {{ category.full_title  }}</title>
            <description>{{ brand_setting('core.deskpro_name') }} - {{ category.full_title }}</description>
            <link>{{ url('portal_downloads_browse', { slug: category.slug }) }}</link>
        {% else %}
            <title>{{ brand_setting('core.deskpro_name') }} - {{ phrase('portal.downloads.section-title') }}</title>
            <description>{{ brand_setting('core.deskpro_name') }} - {{ phrase('portal.downloads.section-title') }}</description>
            <link>{{ url('portal_downloads') }}</link>
        {% endif %}
        <lastBuildDate>{{ 'now'|date('r') }}</lastBuildDate>
        <pubDate>{{ 'now'|date('r') }}</pubDate>
        <ttl>1800</ttl>
        {% for file in pager %}
            <item>
                <title>{{ file.title }}</title>
                <description>{{ file.contentDesc }}</description>
                <link>{{ url('portal_downloads_view', { slug: file.slug }) }}</link>
                <guid>{{ url('portal_downloads_view', { slug: file.id }) }}</guid>
                <pubDate>{{ file.date_published|date('r') }}</pubDate>
            </item>
        {% endfor %}
    </channel>
</rss>
