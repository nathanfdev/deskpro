{% extends 'Theme::layout.html.twig' %}
{% import 'Theme:Articles:_macros.html.twig' as macros %}

{# TODO #}

{% block inner_content %}
    {{  page.knowledgebase_breadcrumbs()|raw }}

    <article class="news kb-article">
        <header>
            <h1>{{ article.realTitle }}</h1>

            <div class="article-meta">
                <span class="agent-avatar agent-avatar-mini"><img src="{{ person_picture_url(article.person, 20) }}"></span>
                {{ phrase('portal.articles.by-line', { name: article.person.name, date: article.date_published | date('Y-m-d') }) }}
                <span class="comments"><i class="fa fa-comments"></i> <a href="#">{{ phrase('portal.general.comments-count', {count: article.num_comments}) }}</a></span>
            </div>
        </header>

        <div class="header-button-container">
            <div class="header-buttons">

                {% if brand_setting('user.kb_subscriptions') %}
                    <a href="{{ path('portal_kb_article_toggle_subscription', { slug: article.slug }) }}">
                        {% if is_subscribed %}
                            {{ phrase('portal.general.btn-unsubscribe') }}
                        {% else %}
                            {{ phrase('portal.general.btn-subscribe') }}
                        {% endif %}
                        <i class="fa fa-rss"></i>
                    </a>
                {% endif %}

                <a href="#">{{ phrase('portal.general.btn-email') }} <i class="fa fa-envelope"></i></a>
                <a href="#">{{ phrase('portal.general.btn-print') }} <i class="fa fa-print"></i></a>
                <a href="#">{{ phrase('portal.general.btn-download-pdf') }} <i class="fa fa-file-pdf-o"></i></a>
            </div>
        </div>

        {% if is_subscribed %}
            <div>
                <hr/>
                <strong>You are subscribed to recieve notifications about this article</strong>
                <hr/>
            </div>
        {% endif %}

        <div class="article-content padded">
            {{ article.realContent|raw }}
        </div>

        {% if article.labels|length %}
            <div class="tag-list">
                <ul>
                    <li class="tag-list-header"><i class="fa fa-tags"></i> Tags</li>
                    {% for l in  article.labels %}
                        <li class="tag-list-item"><a href="#">{{ l }}</a></li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <div class="rate-article">
            <div class="titled-header">
                <h1>{{ phrase('portal.general.rate-page') }}</h1>
            </div>

            {% if rating %}
                <div class="rate-article" style="background-color: {% if rating.positive %}#93d06e{% else %}#dc7575{% endif %}; color: white;">
                    You marked this page as {% if rating.positive %}helpful{% else %}not helpful{% endif %}
                </div>
            {% endif %}

            <div class="rate-article">
                <a href="{{ path('portal_kb_article_vote_up', { slug: article.slug }) }}" class="rate-up">
                    {{ phrase('portal.general.rate-page-positive') }} <span>:)</span>
                </a>
                <a href="{{ path('portal_kb_article_vote_down', { slug: article.slug }) }}" class="rate-down">
                    <span>:(</span> {{ phrase('portal.general.rate-page-negative') }}
                </a>
            </div>
        </div>

        {{ page.related_content()|raw }}
    </article>
{% endblock inner_content %}
