<html>
<head>
</head>
<title>DeskPro - Portal</title>
<meta name="viewport" content="width=device-width">
<link href="{{ asset('web/portal/base/css/normalize.css') }}" media="all" rel="stylesheet" />
<link href="{{ asset('web/portal/base/css/styles.css') }}" media="all" rel="stylesheet" />
<link href="http://maxcdn.bootstrapcdn.com/font-awesome/4.2.0/css/font-awesome.min.css" rel="stylesheet">
<script src="//code.jquery.com/jquery-2.1.1.min.js" type="text/javascript"></script>
<link
	href='http://fonts.googleapis.com/css?family=Ubuntu:400,300,500,700|Open+Sans:400,300,600,700|Roboto:400,300,500,700|Lato:400,300,700'
	rel='stylesheet' type='text/css'>
<body>

{#
You can make new layouts (skinny, full-width, etc) by extendign this layout and overriding "body". It allows you
to keep the same "header" and "footer" to keep css/js/etc consistent among theme layouts
#}
{% block body %}

	{% block alerts %}
		<section>
			<div class="column-full">
				{{ alerts() }}
			</div>
		</section>
	{% endblock alerts %}

	{% block top_bar %}
		<section>
			<div class="column-full">
				{{ top_bar() }}
			</div>
		</section>
	{% endblock top_bar %}

	{% block top_search %}
		<section>
			<div class="column-full">
				{{ top_search() }}
			</div>
		</section>
	{% endblock top_search %}


	{% block top_tabs %}
		<section>
			<div class="column-full">
				{{ top_tabs() }}
			</div>
		</section>
	{% endblock top_tabs %}

	{% block content_layout %}
		<div class="wrapper">
			<div class="column-half-plus">
				{% block page_content %}
					<section>
						<div class="column-full">
							{% block inner_content %}
							{% endblock inner_content %}
						</div>
					</section>
				{% endblock page_content %}
			</div>

			<aside class="sidebar">
				{{ sidebar() }}
			</aside>
		</div>
	{% endblock content_layout %}

{% endblock body %}

</body>
</html>
