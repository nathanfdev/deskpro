{% macro downloads_cat_breadcrumbs(cat, parents, download) %}
    <div class="breadcrumbs">
        <ul>
            <li>
                <a href="{{ path('portal_index') }}">{{ brand_setting('core.deskpro_name') }}</a> <i
                    class="fa fa-angle-right"></i>
            </li>

            <li>
                <a href="{{ path('portal_downloads') }}">{{ phrase('portal.downloads.section-title') }}</a>{% if parents|length or cat or download %} <i
                    class="fa fa-angle-right">{% endif %}</i>
            </li>


            {% for parent in parents %}
                <a href="{{ path('portal_downloads_browse', { slug:parent.slug }) }}">{{ parent.title }}</a> <i
                class="fa fa-angle-right"></i>
            {% endfor %}

            {% if cat %}
                <li>
                    <a href="{{ path('portal_downloads_browse', { slug:cat.slug }) }}">{{ cat.title }}</a>
                </li>
            {% endif %}
        </ul>
        <hr>
    </div>
{% endmacro %}
