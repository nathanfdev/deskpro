<style>
    .form-error {
        color: red;
        border: 1px solid red;
    }

    .deskpro-form-widget {
        margin-bottom: 15px;
    }

    .deskpro-date-form-widget select {
        width: 30%;
    }
</style>

{{ form_errors(form) }}
{{ form_start(form, { attr: { class: 'form-ticket' } }) }}
<h1>Reply</h1>
{{ form_widget(form.ticket_message) }}
<h3 style="margin-top:20px;">Add Attachments</h3>
{{ form_widget(form.attachments) }}
<button style="margin-top: 40px;" type="submit">Submit Reply</button>
{{ form_rest(form) }}
{{ form_end(form) }}
