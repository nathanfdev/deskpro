{# TODO #}
{% for item in pager %}
    <div class="feedback-item">
        <div class="feedback-item-controls">
            <a href="#" class="i-agree">
                <i class="fa fa-thumbs-up"></i><div>{{ phrase('portal.feedback.btn-vote') }}</div>
                <span class="counter">123</span>
            </a>

            <a href="#" class="star">
                <i class="fa fa-star-o"></i><div>2</div>
            </a>
        </div>

        <div class="feedback-item-content">
            <span class="feedback-status">Awaiting Feedback</span>
            <h1>
                <span class="text-tag">Feature Request</span>
                <a href="{{ path('portal_feedback_view', { slug: item.slug }) }}">
                    {{ item.title }}
                </a>
            </h1>

            <div class="comment">
                <p>{{ item.content_html|raw }}</p>
            </div>

            <div class="feedback-item-meta">
                <ul>
                    <li><a href="#"><i class="fa fa-user"></i> {{ item.person.display_name }}</a></li>
                    <li><a href="#"><i class="fa fa-comment"></i> 3 comments</a></li>
                    <li><a href="#"><i class="fa fa-inbox"></i> Mobile App</a></li>
                    <li><a href="#"><i class="fa fa-tags"></i>Urgent, Important</a></li>
                </ul>
            </div>
        </div>
    </div>
{% endfor %}