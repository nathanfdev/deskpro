{% extends 'Theme::layout.html.twig' %}
{% import 'Theme:News:_macros.html.twig' as macros %}

{% block inner_content %}
	{{ macros.kb_news_cat_breadcrumbs(cat, cat.treeParents, article) }}
	<h1>{{ article.realTitle }}</h1>
	<p style="margin-bottom: 20px; font-weight: bold;">
		Posted by <a href="#">{{ article.person.name }}</a>
		on {{ article.date_published | date('M j, Y') }}
		in <a href="{{ path('portal_news_browse', { slug:article.category.slug }) }}">
			{{ article.category.realTitle }}
		</a>
	</p>
	{% if article.labels|length > 0 %}
		<p>
			<strong>Labeld as:</strong>
			{{ article.labels|join(',') }}
		</p><br>
	{% endif %}
	<div class="news">
		{{ article.realContent|raw }}
	</div>
{% endblock inner_content %}
