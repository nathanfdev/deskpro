{% extends 'Theme::layout.html.twig' %}

{% block page_content %}

    {% if app.request.query.get('retry') == 'auth' %}
        <div class="error">Bad Credentials. Please try again.</div>
    {% endif %}

    <header class="section-header">
        <h1>Log in to the support portal</h1>
    </header>


    <form class="form-ticket" action="{{ path('portal_login_submit') }}" method="post">
        <input type="hidden" name="_failure_path" value="{{ path('portal_login', {retry:'auth'}) }}"/>

        <div class="column-half">
            <div class="bucket">
                <label class="title">Your email:</label>
                <input type="text" tabindex="1" placeholder="Email" name="username">
            </div>
        </div>

        <div class="column-half omega">
            <div class="bucket">
                <div class="form-meta form-meta-grey"><a href="#">Need a password reminder?</a></div>
                <label class="title">Your password:</label>
                <input type="password" tabindex="2" placeholder="Your password (required)" name="password">
            </div>
        </div>


        <div class="column-full">
            <div class="bucket">
                <button class="button" tabindex="3">Log In</button>
                <div class="remember-me"><label for="remember_me"><input type="checkbox" name="remember_me"> Stay Logged In?</label></div>
            </div>
        </div>

        <div class="column-full">
            <div class="bucket">
                <div class="titled-header-left">
                    <h2>Or use an external service</h2>
                </div>

                <button class="button auth auth-facebook"><i class="fa fa-facebook"></i> Facebook</button>
                <button class="button auth auth-twitter"><i class="fa fa-twitter"></i>Twitter</button>
                <button class="button auth auth-google"><i class="fa fa-google"></i>Google</button>
            </div>
        </div>

        <div class="column-full">
            <div class="bucket">
                <div class="titled-header-left">
                    <h2>Create a new account</h2>
                </div>

                <button class="button button-secondary">Register</button>
            </div>
        </div>

    </form>

{% endblock page_content %}