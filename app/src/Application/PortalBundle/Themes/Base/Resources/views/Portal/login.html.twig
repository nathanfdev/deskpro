{% extends 'Theme::layout.html.twig' %}

{% block page_content %}

    {% if app.request.query.get('retry') == 'auth' %}
        <div class="error">Bad Credentials. Please try again.</div>
    {% endif %}

	<section>
		<div class="column-full">
            <form action="{{ path('portal_login_submit') }}" method="POST">
                <input type="text" name="username" />
                <input type="text" name="password" />
                <input type="hidden" name="_failure_path" value="{{ path('portal_login', {retry:'auth'}) }}"/>
              <button type="submit">Login!</button>
            </form>
		</div>
	</section>

{% endblock page_content %}