{% for cat in cats %}
	<div class="column-full">
		<article class="article-categories">
			<header>
				<h1>
					<img src="{{ asset('web/portal/base/img/icon-view-more.png') }}"> {{ cat.title }}</h1>
				<hr>
			</header>

			{{ kb_articles_forcat({'category':cat.id}|merge(articles_options)) }}
		</article>
	</div>
{% endfor %}