{% extends 'Theme::layout.html.twig' %}

{# TODO #}

{% block inner_content %}
    {{ page.downloads_breadcrumbs({category: download.category})|raw }}

    <article class="news kb-article">
        <header>
            <h1>{{ download.title }}</h1>

            <div class="article-meta">
                <span class="agent-avatar agent-avatar-mini"></span>
                {{ phrase('portal.articles.by-line', { name: download.person.name, date: download.date_published | date('Y-m-d') }) }}
                <span class="comments"><i class="fa fa-comments"></i> <a href="#">{{ phrase('portal.general.comments-count', {count: 1}) }}</a></span>
            </div>
        </header>

        <div class="article-extras">
            <a href="{{ path('portal_downloads_download', { slug:download.slug }) }}">{{ phrase('portal.downloads.btn-download', { size: download.readableFileSize }) }}</a>
        </div>

        <div class="header-button-container">
            <div class="header-buttons">
                <a href="#">{{ phrase('portal.general.btn-subscribe') }} <i class="fa fa-rss"></i></a>
                <a href="#">{{ phrase('portal.general.btn-email') }} <i class="fa fa-envelope"></i></a>
                <a href="#">{{ phrase('portal.general.btn-print') }} <i class="fa fa-print"></i></a>
                <a href="#">{{ phrase('portal.general.btn-download-pdf') }} <i class="fa fa-file-pdf-o"></i></a>
            </div>
        </div>

        <div class="article-content padded">
            {{ download.contentDesc }}
        </div>

        {% if download.labels|length %}
            <div class="tag-list">
                <ul>
                    <li class="tag-list-header"><i class="fa fa-tags"></i> Tags</li>
                    {% for l in download.labels %}
                        <li class="tag-list-item"><a href="#">{{ l }}</a></li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <div class="rate-article">
            <div class="titled-header">
                <h1>{{ phrase('portal.general.rate-page') }}</h1>
            </div>

            {% if rating %}
                <div class="rate-article"
                     style="background-color: {% if rating.positive %}#93d06e{% else %}#dc7575{% endif %}; color: white;">
                    You marked this page as {% if rating.positive %}helpful{% else %}not helpful{% endif %}
                </div>
            {% endif %}

            <div class="rate-article">
                <a href="{{ path('portal_downloads_vote_up', { slug: download.slug }) }}" class="rate-up">
                    {{ phrase('portal.general.rate-page-positive') }} <span>:)</span>
                </a>
                <a href="{{ path('portal_downloads_vote_down', { slug: download.slug }) }}" class="rate-down">
                    <span>:(</span> {{ phrase('portal.general.rate-page-negative') }}
                </a>
            </div>
        </div>

        {% if related_files|length %}
            <div class="related">

                <div class="titled-header">
                    <h1>{{ phrase('portal.general.related-pages') }}</h1>
                </div>

                <ul>
                    {% for related in related_files %}
                        <li>
                            <a href="{{ path('portal_downloads_view', { slug:related.slug }) }}"><i
                                        class="fa fa-file-text-o"></i> {{ related.realTitle }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
    </article>
{% endblock inner_content %}