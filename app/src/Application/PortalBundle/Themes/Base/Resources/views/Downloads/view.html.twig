{% extends 'Theme::layout.html.twig' %}

{% block inner_content %}
	<h1>{{ download.title }}</h1>
	<p class="info">
		size: {{ download.readableFileSize }}
	</p>
	<p>{{ download.contentDesc }}</p>
	<p><a href="{{ path('portal_downloads_download', { slug:download.urlSlug }) }}">Click here to download...</a></p>
{% endblock inner_content %}