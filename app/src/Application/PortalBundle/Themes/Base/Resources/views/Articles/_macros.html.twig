{% macro kb_article_cat_list(article, sep=',') %}
	{%- for cat in article.categories -%}
		<a href="{{ path('portal_kb_browse', {slug: cat.urlSlug}) }}">{{ cat.title }}{%- if not loop.last %}, {% endif -%}</a>
	{%- endfor -%}
{% endmacro %}

{% macro kb_article_cat_breadcrumbs(cat, parents, sep = ' > ') %}
	<a href="{{ path('portal_kb') }}">Knowledgebase</a>{{ sep }}
	{% for parent in parents %}
		<a href="{{ path('portal_kb_browse', { slug:parent.urlSlug }) }}">{{ parent.title }}</a>{{ sep }}
	{% endfor %}
	{{ cat.title }}
{% endmacro %}