{% extends 'Theme::layout.html.twig' %}
{% import 'Theme:News:_macros.html.twig' as macros %}

{% block inner_content %}
    {{ news_breadcrumbs({ category: category }) }}
    {{ news_list({ category: category }) }}

    <h1>{{ category.realTitle }}</h1>

    {{ news_posts_pretty({category: category, page: page, count: count, show_category_link: false}) }}
    {{ news_pager({category: category, show_pagination: show_pagination, page: page, count: count}) }}
{% endblock inner_content %}
