{% if child_cats|length > 0 %}
	<ul>
		{% for cat in child_cats %}
			<li>
				<a href="{{ path('portal_news_browse', { slug: cat.urlSlug }) }}">
					<img src="{{ asset('web/portal/base/img/icon-view-more.png') }}"> {{ cat.title }} -
					[{{ cat.articles|length }}]
				</a>
			</li>
		{% endfor %}
	</ul>
{% endif %}