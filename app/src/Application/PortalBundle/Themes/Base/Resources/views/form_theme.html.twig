{% extends 'form_div_layout.html.twig' %}

{# Generic Form Types #}
{% block form_widget -%}
    {% if compound %}
        {{- block('form_widget_compound') -}}
    {% else %}
        {{- block('form_widget_simple') -}}
    {% endif %}
    {% if form.vars.help %}
        <small class="help">{{ form.vars.help }}</small>
    {% endif %}
{%- endblock form_widget %}



{# A Checkbox #}
{% block checkbox_widget -%}
    <input style="margin-left: 20px;" type="checkbox" {{ block('widget_attributes') }}{% if value is defined %} value="{{ value }}"{% endif %}{% if checked %} checked="checked"{% endif %} />
    {% if form.vars.checkbox_label %}{{ form.vars.checkbox_label }}{% endif %}
{%- endblock checkbox_widget %}


{# Hidden Custom Fields #}
{% block deskpro_hidden_widget -%}
    {% if hidden %}
        {% set type = 'hidden' %}
    {% else %}
        {% set type = type|default('text') %}
    {% endif %}
    {{- block('form_widget_simple') -}}
{%- endblock deskpro_hidden_widget %}


{# TICKET ATTACHMENTS #}
{% block ticket_message_attachment_widget %}
{% if form.upload is defined %}
    {{ form_widget(form.upload) }}
{% else %}
    <a href="{{ form.vars.data.blob.downloadUrl }}">
        {% if form.vars.data.blob.is_image %}
            <img src="{{ form.vars.data.blob.thumbnailUrl }}" alt=""/>
        {% endif %}
        {{ form.vars.data.blob.filename }}
    </a>
    {{ form_widget(form.blob_auth) }}
{% endif %}
{{ dump(form) }}
{% endblock ticket_message_attachment_widget %}

{% block ticket_message_attachment_collection_widget %}
    {{ block('collection_widget') }}
{% endblock ticket_message_attachment_collection_widget %}


{# DISPLAY HTML #}
{% block deskpro_display_html_widget %}
{% set value = 'html' %}
{{ html|raw }}
{{ block('hidden_widget') }}
{% endblock deskpro_display_html_widget %}


{# DATES #}
{% block deskpro_date_widget %}
    {% set attr = attr|merge({'class': (attr.class|default('') ~ ' deskpro-date-form-widget')|trim}) %}
    {{ block('date_widget') }}
{% endblock deskpro_date_widget %}

{% block deskpro_datetime_widget %}
    {% set attr = attr|merge({'class': (attr.class|default('') ~ ' deskpro-date-form-widget')|trim}) %}
    {{ block('datetime_widget') }}
{% endblock deskpro_datetime_widget %}


{# RECAPTHCA #}
{% block deskpro_captcha_widget %}
    {% spaceless %}
                {% if attr.options is defined %}
                    <script type="text/javascript">
                        var RecaptchaOptions =
                        {{ attr.options|json_encode|raw }}
                    </script>
                {% endif %}
                <script src="{{ form.vars.url_challenge }}" type="text/javascript"></script>
                <noscript>
                    <iframe src="{{ form.vars.url_noscript }}" height="300" width="500"></iframe>
                    <br/>
                    <textarea name="recaptcha_challenge_field" rows="3" cols="40"></textarea>
                    <input type="hidden" name="recaptcha_response_field" value="manual_challenge"/>
                </noscript>
    {% endspaceless %}
{% endblock deskpro_captcha_widget %}


{###
HEIRARCHY
###}
{% block deskpro_heirarchical_entity_widget %}
    {% if expanded %}
        {{- block('deskpro_heirarchical_choice_widget_expanded') -}}
    {% else %}
        {{- block('deskpro_heirarchical_choice_widget_collapsed') -}}
    {% endif %}
{% endblock %}

{% block deskpro_heirarchical_choice_widget_expanded -%}
    <div data-heirarcy="" {{ block('widget_container_attributes') }}>
        {%- for child in form %}
            {{- form_widget(child) -}}
            {{- form_label(child) -}}
        {% endfor -%}
    </div>
{% endblock deskpro_heirarchical_choice_widget_expanded %}

{% block deskpro_heirarchical_choice_widget_collapsed -%}
    {% if required and empty_value is none and not empty_value_in_choices and not multiple -%}
        {% set required = false %}
    {%- endif -%}
    <select data-heirarchy="" {{ block('widget_attributes') }}{% if multiple %} multiple="multiple"{% endif %}>
        {% if empty_value is not none -%}
            <option value=""{% if required and value is empty %} selected="selected"{% endif %}>{{ empty_value|trans({}, translation_domain) }}</option>
        {%- endif %}
        {%- if preferred_choices|length > 0 -%}
            {% set options = preferred_choices %}
            {{- block('deskpro_heirarchical_choice_widget_options') -}}
            {% if choices|length > 0 and separator is not none -%}
                <option disabled="disabled">{{ separator }}</option>
            {%- endif %}
        {%- endif -%}
        {% set options = choices -%}
        {{- block('deskpro_heirarchical_choice_widget_options') -}}
    </select>
{%- endblock deskpro_heirarchical_choice_widget_collapsed %}

{% block deskpro_heirarchical_choice_widget_options -%}
    {% for group_label, choice in options %}
        {%- if choice is iterable -%}
            <optgroup label="{{ group_label|trans({}, translation_domain) }}">
                {% set options = choice %}
                {{- block('deskpro_heirarchical_choice_widget_options') -}}
            </optgroup>
        {%- else -%}
            <option
                    {% if choice.data.parent is defined and choice.data.parent is not null %} data-parent="{{ choice.data.parent.id }}"{% endif %}
                    {% if choice.data.id is defined %} data-id="{{ choice.data.id }}"{% endif %}
                    {% if choice.data.children is defined and choice.data.children|length > 0 %} disabled="disabled"{% endif %}
                    {% if choice is selectedchoice(value) %} selected="selected"{% endif %}
                    value="{{ choice.value }}"
            >
                {{ choice.label|trans({}, translation_domain) }}
            </option>
        {%- endif -%}
    {% endfor %}
{%- endblock deskpro_heirarchical_choice_widget_options %}

{###
END HEIRARCHY
###}