{% if not is_granted('ROLE_USER')  and auth_manager.isAuthVisible %}
<div class="small-form">
    <h1>Log in</h1>

    {% if auth_manager.isLoginFormVisible %}
    <form action="{{ path('portal_login_submit') }}" method="post">
        <input type="hidden" name="_failure_path" value="{{ path('portal_login', {retry:'auth'}) }}"/>
        <label>
            <span>Your email:</span>
            <input type="text" placeholder="email@example.com" name="username">
        </label>

        {% if auth_manager.isRememberMeEnabled %}
        <div class="permanent-login">
            <label>Stay Logged In? <input type="checkbox" name="remember_me"></label>
        </div>
        {% endif %}

        <label>
            <span>Your password:</span>
            <input type="password" placeholder="Your password" name="password">
        </label>

        <button>Log In</button>

        {% if auth_manager.isForgotPasswordVisible %}
        <div class="secondary-action">
            <a href="#">Forgot your password?</a>
        </div>
        {% endif %}
    </form>
    {% endif %}


    <a href="#" class="button auth-one">OneLogin</a>
    <a href="#" class="button auth-facebook">Login with Facebook</a>
    <hr>
</div>
{% endif %}