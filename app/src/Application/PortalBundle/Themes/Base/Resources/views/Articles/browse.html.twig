{% extends 'Theme::layout.html.twig' %}
{% import 'Theme:Articles:_macros.html.twig' as macros %}

{# TODO #}

{% block inner_content %}
    {{ macros.kb_article_cat_breadcrumbs(cat, cat.treeParents) }}
    {%  if cat.children|length > 0 %}
        <div style="background: #eee; padding: 10px;">
            Sub-Categories:
            <br/>
            {% for child in cat.children %}
                {{ knowledgebase({ parent:child.id }) }}
            {% endfor %}
            <br style="clear:both;"/>
        </div>
    {% endif %}
    <ul>
        {% for article in pager.currentPageResults %}
            <li>
                <a href="{{ path('portal_kb_view', { slug: article.slug }) }}">
                    {{ article.realTitle }}
                </a>
            </li>
        {% endfor %}
    </ul>
    {% if pager.haveToPaginate %}
        {{ pagerfanta(pager) }}
    {% endif %}
{% endblock inner_content %}
