<header class="top-bar">
	<div class="brand">
		<a href="{{ path('portal_index') }}">
			<h1>
				{{ global_settings.get('core.site_name')|default(global_settings.get('core.deskpro_name')) }}
			</h1>
		</a>
	</div>

	<ul id="menu">
		<li>
			<a href="{{ path('portal_user_registration') }}">Create a new account</a>
		</li>

		<li>
			<a href="{{ path('portal_login') }}" class="button">Log In</a>
		</li>

		{% if is_multi_language %}
		<li>
			<select onchange="location.href='/'+this.value" class="button button-dropdown button-dropdown-language">
				{% for language in enabled_languages %}
					<option value="{{ language.urlCode }}"
						{% if language.urlCode == current_language.urlCode %}selected="selected"{% endif %}>
						{{ language.title|capitalize }}
					</option>
				{% endfor %}
			</select>
		</li>
		{% endif %}

	</ul>
</header>
