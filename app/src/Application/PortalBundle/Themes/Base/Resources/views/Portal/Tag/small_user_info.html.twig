{% if not is_granted('ROLE_USER') %}

    {% if display_registration_link %}
        <li>
            <a href="{{ path('portal_user_registration') }}">Create a new account</a>
        </li>
    {% endif %}

    <li>
        <a href="{{ path('portal_login') }}" class="button">Log In</a>
    </li>

{% else %}

    <li>
        Hi, {{ app.user }}
        [
        <a href="{{ path('portal_user_profile') }}">Profile</a>
        {% if ticket_count > 0 %}
        |
        <a href="{{ path('portal_tickets') }}">Tickets ({{ ticket_count }})</a>
        {% endif %}
        ]
    </li>
    <li>
        <a href="{{ path('portal_logout') }}" class="button">Logout</a>
    </li>

{% endif %}