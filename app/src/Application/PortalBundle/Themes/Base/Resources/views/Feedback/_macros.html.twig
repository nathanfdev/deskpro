{% macro feedback_breadcrumbs(item) %}
    <div class="breadcrumbs">
        <ul>
            <li>
                <a href="{{ path('portal_index') }}">{{ global_settings.get('core.deskpro_name') }}</a> <i
                    class="fa fa-angle-right"></i>
            </li>

            <li>
                <a href="{{ path('portal_feedback') }}">Feedback</a>{% if item %}<i class="fa fa-angle-right">{% endif %}</i>
            </li>

            {% if item %}
                <li>
                    <a href="{{ path('portal_feedback_view', { slug:item.slug }) }}">{{ item.title }}</a>
                </li>
            {% endif %}
        </ul>
        <hr>
    </div>
{% endmacro %}
