{% extends 'Theme::layout.html.twig' %}
{% import 'Theme:News:_macros.html.twig' as macros %}

{% block inner_content %}
	{{ macros.kb_news_cat_breadcrumbs() }}
	<h1>News</h1>
	<ul>
		{% for article in news_articles %}
			<li>
				<a href="{{ path('portal_news_view', { slug: article.urlSlug }) }}">
					{{ article.realTitle }}
				</a>
			</li>
		{% endfor %}
	</ul>
	{% if pager.haveToPaginate %}
		{{ pagerfanta(pager, 'twitter_bootstrap') }}
	{% endif %}
{% endblock inner_content %}