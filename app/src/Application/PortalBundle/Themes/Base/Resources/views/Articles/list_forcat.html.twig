<article class="article-categories">
	<ul>
		{% for article in articles %}
			<li>
				<a href="{{ path('portal_kb_view', { slug:article.urlSlug }) }}">{{ article.realTitle }}</a>
			</li>
		{% endfor %}
	</ul>
</article>

<div class="list-meta">
	<a href="{{ path('portal_kb_browse', { 'slug':cat.urlSlug }) }}">
		View <span>{{ total_count }}</span> articles
		<img src="{{ asset('web/portal/base/img/icon-view-more.png') }}">
	</a>
</div>
