{% if pager|length > 0 %}
    <article class="article-categories">
        <ul>
            {% for article in pager %}
                <li>
                    <a href="{{ path('portal_kb_view', { slug:article.slug }) }}">{{ article.realTitle }}</a>
                </li>
            {% endfor %}
        </ul>
    </article>

    <div class="list-meta">
        <a href="{{ path('portal_kb_browse', { 'slug':cat.slug }) }}">
            View <span>{{ pager|length }}</span> articles
            <img src="{{ asset('web/portal/base/img/icon-view-more.png') }}">
        </a>
    </div>
{% else %}
    <strong>No articles yet</strong>
{% endif %}
