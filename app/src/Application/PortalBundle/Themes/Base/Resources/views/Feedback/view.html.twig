{% extends 'Theme::layout.html.twig' %}

{% block inner_content %}
    {{ page.feedback_breadcrumbs({ item: item} )|raw }}
    <h1>{{ item.title }}</h1>
    <pre>
        num_comments: {{ item.num_comments }}
        views: {{ item.view_count }}
        status: {{ item.status }}
        total rating: {{ item.total_rating }}
        num ratings: {{ item.num_ratings }}

        {{ item.content }}
    </pre>
{% endblock inner_content %}
