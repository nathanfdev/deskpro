<!-- Full width news -->
<section>
    <div class="column-full">
        <article class="news front-page-news">
            <div class="large-title clearfix"><h1>News</h1></div>
            {{ news_posts_pretty({ count: 3 }) }}
        </article>
    </div>
</section>


<!-- Knowledge Base -->
<section>
    {{ knowledgebase({'articles': { sort: 'title asc' }}) }}
</section>


<!-- Three Columns -->
<section>
    <div class="column-third">
        {{ news_posts_list({ count: 10 }) }}
    </div>

    <div class="column-third">
        {{ feedback_items_list({ count: 10 }) }}
    </div>

    <div class="column-third omega">
        {{ downloads_files_list() }}
    </div>
</section>