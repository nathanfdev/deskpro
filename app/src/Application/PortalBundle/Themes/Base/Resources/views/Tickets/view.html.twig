                        <span class="agent">Jane Doe</span>
                    </li>
                    <li>
                        <span class="agent-avatar agent-avatar-tiny agent-avatar-blank"><a href="#"
                                class="remove-agent"></a></span></span>
                        <span class="agent">John Doesonn</span>
                    </li>
                    <li>
                        <span class="agent-avatar agent-avatar-tiny"
                            style="background: url({{ asset('web/portal/base/img/avatar.png') }}) no-repeat; background-size: cover"><a href="#"
                                class="remove-agent"></a></span></span>
                        <span class="agent">Dennis Schipper</span>
                    </li>
                    <li class="option">
                        <span class="agent-avatar agent-avatar-tiny agent-avatar-add"></span>
