{% extends 'Theme::layout.html.twig' %}

{% block inner_content %}
<article class="ticket-page">
    <header>
        <h1>
            {{ ticket.subject }}
            <a href="#" class="ticket-status">Awaiting You</a>
        </h1>
        <span class="ticket-reference">
            Ticket reference: {{ ticket.ref }}
        </span>
        <span class="ticket-reference">
            <a href="{{ path('portal_tickets_edit', { id: ticket.id }) }}">
                EDIT TICKET
            </a>
        </span>
    </header>

    <h2>CC'ed peple</h2>
    <ul>
        {% for person in ticket.userParticipants %}
            <li>{{ person }} ({{ person.primary_email.email }})</li>
        {% else %}
            <li>None!</li>
        {% endfor %}
    </ul>

    <h2>Messages on Ticket</h2>
    <ul>
        {% for msg in ticket.messages %}
            <li>{{ msg.message }}</li>
        {% endfor %}
    </ul>

<br>
    <h3>Respond</h3>
    {{ form_start(form) }}
    {{ form_widget(form) }}
    <button type="submit">Submit Reply</button>
    {{ form_end(form) }}










    <hr style="margin-top:40px;margin-bottom:20px;" />

    <div class="container">

        <div class="ticket-agents">

            <div class="agent">
                <span class="agent-avatar"
