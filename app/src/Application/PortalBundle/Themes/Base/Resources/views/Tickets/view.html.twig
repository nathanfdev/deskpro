{% extends 'Theme::layout.html.twig' %}

{% block inner_content %}
<article class="ticket-page">

    <header>
        <h1>
            {{ ticket_view.ticket.subject }}
            <a href="#" class="ticket-status">Awaiting You</a>
        </h1>
        <span class="ticket-reference">
            Ticket reference: {{ ticket_view.ticket.public_id }}
        </span>
        <span class="ticket-reference">
            <a href="{{ path('portal_tickets_edit', { id: ticket_view.ticket.id }) }}">
                EDIT TICKET
            </a>
        </span>
    </header>

    <div class="container">

        <div class="ticket-agents">

            <div class="agent">
                <span class="agent-avatar"
                      style="background: url({{ ticket_view.ticket.agent ? person_picture_url(ticket_view.ticket.agent) : asset('web/portal/base/img/avatar.png') }}) no-repeat; background-size: cover;"></span>

                <div class="agent-info">
                    <span class="agent-meta">Assigned Agent:</span>
                    <span class="agent-name">
                        {% if ticket_view.ticket.agent %}
                            {{ ticket_view.ticket.agent.display_name_user }}
                        {% else %}
                            {{ phrase('user.tickets.unassigned') }}
                        {% endif %}
                    </span>
                </div>
            </div>


            <div class="agent">
                <span class="agent-avatar"
                      style="background: url({{ person_picture_url(ticket_view.ticket.person) }}) no-repeat; background-size: cover;"></span>

                <div class="agent-info">
                    <span class="agent-meta">Opened by:</span>
                    <span class="agent-name">{{ ticket_view.ticket.person.display_name_user }}</span>
                </div>
            </div>

        </div>

        {% if ticket_view.ticket.userParticipants|length %}
        <div class="agent-extras">


            <span class="grey">Also CC'ed:</span>

            {% for person in ticket_view.ticket.userParticipants %}
                <div class="agent">
                    <span class="agent-meta">{{ person.display_name_user }}</span>
                    <span class="agent-avatar agent-avatar-tiny agent-avatar-blank">
                        <a href="#" class="remove-agent"></a>
                    </span>
                </div>
            {% endfor %}



        </div>
        {% endif %}

    </div>
    <!-- End Container -->

    <hr>

    <div class="container">
        <table>
            
            <tr>
                <td>Date Opened</td>
                <td>{{ ticket_view.ticket.date_created|date() }}</td>
            </tr>

            {# see the TicketViewService in AppBundle's data services #}
            {% for attr,val in ticket_view.attribute_list %}
            <tr>
                <td>{{ attr }}</td>
                <td>{{ val }}</td>
            </tr>
            {% endfor %}

        </table>
    </div>
    <hr>

    <div class="ticket-timeline">

        {% for msg in ticket_view.ticket.messages %}
            <div class="item reply">
                    <span class="badge"
                          style="background: url({{ person_picture_url(msg.person, 50) }}) no-repeat; background-size: cover"></span>

                <h1>{{ msg.person.display_name_user }} <span>wrote:</span></h1>

                <div class="comment agent-reply">
                    {{ msg.message }}
                    {% if msg.attachments|length > 0 %}
                        <h3>Attachements:</h3>
                        {% for attachment in msg.attachments %}
                            <a href="{{ attachment.blob.downloadUrl }}" class="attachement">
                                {% if attachment.blob.is_image %}
                                    <img src="{{ attachment.blob.thumbnailUrl }}" alt="{{ attachment.blob.filename }}">
                                {% endif %}
                                {{ attachment.blob.filename }}
                                <span class="attachement-size">{{ attachment.blob.filesize }} bytes </span>
                            </a><br>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
        {% endfor %}

    </div>

