{% extends 'Theme::layout.html.twig' %}

{% block page_content %}


	<!-- Full width news -->
	<section>
		<div class="column-full">
			{{ news_posts({ count: 3 }) }}
		</div>
	</section>


	<!-- Knowledge Base -->
	<section>
		{{ knowledgebase({'articles': { sort: 'title asc' }}) }}
	</section>


	<!-- Three Columns -->
	<section>
		<div class="column-third">
			{{ news_posts_list({ count: 10 }) }}
		</div>

		<div class="column-third">
			{{ feedback_list_small({ count: 10 }) }}
		</div>

		<div class="column-third omega">
			{{ files_list({ count: 10 }) }}
		</div>
	</section>

{% endblock page_content %}
