{% extends 'Theme::layout.html.twig' %}

{% block page_content %}

	<!-- Full width news -->
	<section>
		<div class="column-full">
			{{ news_list({ count: 3 }) }}
		</div>
	</section>


	<!-- Knowledge Base -->
	<section>
		{{ kb_categories() }}
	</section>

	<!-- Three Columns -->
	<section>
		<div class="column-third">
			{{ news_list_small({ count: 5 }) }}
		</div>

		<div class="column-third">
			{{ feedback_list({ count: 5 }) }}
		</div>

		<div class="column-third omega">
			{{ downloads_list({ count: 5 }) }}
		</div>
	</section>

{% endblock page_content %}