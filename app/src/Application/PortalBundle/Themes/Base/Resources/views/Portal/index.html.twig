{% extends 'Theme::layout.html.twig' %}

{% block page_content %}

	<!-- Full width news -->
	<section>
		<div class="column-full">
			{{ news_list({ count: 3 }) }}
		</div>
	</section>


	<!-- Knowledge Base -->
	<section>
		{{ kb_cats_home() }}
	</section>




	<!-- TEMP -->
	<section>
		{{ kb_cats_summary() }}
	</section>
	<section>
		{{ kb_cats_small() }}
	</section>
	<section>
		{{ kb_cats_expander() }}
	</section>
	<section>
		{{ kb_articles_xsmall({category: 1}) }}
	</section>
	<section>
		{{ kb_articles_small({category:2}) }}
	</section>
	<section>
		{{ kb_articles_forcat({category:1}) }}
	</section>
	<!-- END TEMP -->




	<!-- Three Columns -->
	<section>
		<div class="column-third">
			{{ news_list_small({ count: 5 }) }}
		</div>

		<div class="column-third">
			{{ feedback_list_small({ count: 5 }) }}
		</div>

		<div class="column-third omega">
			{{ downloads_list_small({ count: 5 }) }}
		</div>
	</section>

{% endblock page_content %}