{% extends 'Theme::layout.html.twig' %}

{% block page_content %}

	<!-- Full width news -->
	<section>
		<div class="column-full">
			<viewer path="blocks/news/news.html"></viewer>
		</div>
	</section>


	<!-- Knowledge Base -->
	<section>
		<viewer path="blocks/kb/kb-list-articles.html"></viewer>
	</section>

	<!-- Three Columns -->
	<section>
		<div class="column-third">
			<viewer path="blocks/news/news-tiny.html"></viewer>
		</div>

		<div class="column-third">
			<viewer path="blocks/feedback/feedback.html"></viewer>
		</div>

		<div class="column-third omega">
			<viewer path="blocks/downloads/downloads.html"></viewer>
		</div>
	</section>

{% endblock page_content %}