{% extends 'ThemeParent::layout.html.twig' %}
{% block body %}

    <div class="world">

        <section>
            <div class="column-full">
                {{ page_top() }}
            </div>
        </section>

        <section>
            <div class="column-full">
                {{ page_search_box() }}
            </div>
        </section>

        <section>
            <div class="column-full">
                {{ page_tabs() }}
            </div>
        </section>

        <div class="wrapper">
            <div class="column-half-plus">
                {% block page_content %}
                    <section>
                        <div class="column-full">
                            {% block inner_content %}
                            {% endblock inner_content %}
                        </div>
                    </section>
                {% endblock page_content %}
            </div>

            <aside class="sidebar">
                {{ sidebar() }}
            </aside>
        </div>

    </div>

{% endblock body %}