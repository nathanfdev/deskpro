#!/bin/bash


##################################
# ESTABLISH CONTEXT
##################################
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd $SCRIPT_DIR
cd ..


# if "coverage" is first arg, do all coverage and show coveralls output but DOES NOT submit to coveralls server
IS_COVERAGE=0
if [ "$1" = "coverage" ]; then
    IS_COVERAGE=1
fi

# if IS_TRAVIS, we do submit to coveralls
IS_TRAVIS=0
if [ "$2" = "travis" ]; then
    IS_TRAVIS=1
fi



##################################
# PHPUNIT
##################################
IS_PHPUNIT_ERROR=0
if [[ "$IS_COVERAGE" -eq "1" ]]; then
    bin/phpunit -c phpunit.xml.cov
else
    bin/phpunit
fi

if [[ $? -ne 0 ]] ; then
    IS_PHPUNIT_ERROR=1
fi






##################################
# PHPSPEC
##################################
IS_PHPSPEC_ERROR=0
if [[ "$IS_COVERAGE" -eq "1" ]]; then
    bin/phpspec run --format=dot --config=phpspec.yml.cov
else
    bin/phpspec run
fi

if [[ $? -ne 0 ]] ; then
    IS_PHPSPEC_ERROR=1
fi






##################################
# BEHAT
##################################
IS_BEHAT_ERROR=0

if [[ "$IS_COVERAGE" -eq "1" ]]; then
    bin/behat --config=behat.yml.cov --profile=api
    bin/behat --config=behat.yml.cov --profile=portal
else
    bin/behat --profile=api
    bin/behat --profile=portal
fi

if [[ $? -ne 0 ]] ; then
    IS_BEHAT_ERROR=1
fi






##################################
# EXIT IF ERROR
##################################
IS_ERROR=$((IS_PHPSPEC_ERROR + IS_BEHAT_ERROR + IS_PHPUNIT_ERROR))
if [[ "$IS_ERROR" -ne "0" ]]; then
    if [[ "$IS_PHPSPEC_ERROR" -ne "0" ]]; then
        echo "
        --- PHPSPEC FAILED --- "
    fi
    if [[ "$IS_PHPUNIT_ERROR" -ne "0" ]]; then
        echo "
        --- PHPUNIT FAILED --- "
    fi
    if [[ "$IS_BEHAT_ERROR" -ne "0" ]]; then
        echo "
        --- BEHAT FAILED --- "
    fi
    exit 1
fi






##################################
# SUCCESS SCRIPT
##################################
if [[ "$IS_COVERAGE" -eq "1" ]]; then
    bin/phpcov merge --clover coverage/combined-clover.xml coverage/cov

    if [[ "$IS_TRAVIS" -eq "1" ]]; then
        bin/coveralls -c app/tests/coveralls.yml -v
    else
        bin/coveralls -c app/tests/coveralls.yml -v --dry-run
    fi
fi

exec travis-ci/after-success

exit 0
