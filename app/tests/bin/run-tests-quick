#!/bin/bash


##################################
# ESTABLISH CONTEXT
##################################
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd $SCRIPT_DIR
cd ..


# if "coverage" is first arg, do all coverage and show coveralls output but DOES NOT submit to coveralls server
IS_COVERAGE=0
if [ "$1" = "coverage" ]; then
    IS_COVERAGE=1
fi

# if IS_TRAVIS, we do submit to coveralls
IS_TRAVIS=0
if [ "$2" = "travis" ]; then
    IS_TRAVIS=1
fi

##################################
# PHPUNIT
##################################
IS_PHPUNIT_ERROR=0

bin/phpunit

if [[ $? -ne 0 ]] ; then
    IS_PHPUNIT_ERROR=1
fi

##################################
# PHPSPEC
##################################
IS_PHPSPEC_ERROR=0

bin/phpspec run

if [[ $? -ne 0 ]] ; then
    IS_PHPSPEC_ERROR=1
fi

##################################
# EXIT IF ERROR
##################################
IS_ERROR=$((IS_PHPSPEC_ERROR + IS_PHPUNIT_ERROR))
if [[ "$IS_ERROR" -ne "0" ]]; then
    if [[ "$IS_PHPSPEC_ERROR" -ne "0" ]]; then
        echo "
        --- PHPSPEC FAILED --- "
    fi
    if [[ "$IS_PHPUNIT_ERROR" -ne "0" ]]; then
        echo "
        --- PHPUNIT FAILED --- "
    fi
    exit 1
fi

echo "All OK"

exit 0
