#!/bin/bash


##################################
# ESTABLISH CONTEXT
##################################
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd $SCRIPT_DIR
cd ..

# if "coverage" is first arg, do all coverage and show coveralls output but DOES NOT submit to coveralls server
IS_COVERAGE=0
if [ "$1" = "coverage" ]; then
    IS_COVERAGE=1
fi

# if IS_TRAVIS, we do submit to coveralls
IS_TRAVIS=0
if [ "$2" = "travis" ]; then
    IS_TRAVIS=1
fi

##################################
# PHPUNIT
##################################
IS_PHPUNIT_ERROR=0

bin/phpunit

if [[ $? -ne 0 ]] ; then
    IS_PHPUNIT_ERROR=1
fi

##################################
# PHPSPEC
##################################
IS_PHPSPEC_ERROR=0

bin/phpspec run

if [[ $? -ne 0 ]] ; then
    IS_PHPSPEC_ERROR=1
fi

##################################
# BEHAT @basic scenarios
##################################
IS_BEHAT_API_ERROR=0
bin/behat --profile=api --tags '@basic'
if [[ $? -ne 0 ]] ; then
    IS_BEHAT_API_ERROR=1
fi

IS_BEHAT_PORTAL_ERROR=0
bin/behat --profile=portal --tags '@basic'
if [[ $? -ne 0 ]] ; then
    IS_BEHAT_PORTAL_ERROR=1
fi

##################################
# Jest
##################################
IS_JEST_ERROR=0

cd ../../pub
npm test

if [[ $? -ne 0 ]] ; then
    IS_JEST_ERROR=1
fi

##################################
# EXIT IF ERROR
##################################
IS_ERROR=$((IS_PHPSPEC_ERROR + IS_PHPUNIT_ERROR + IS_BEHAT_API_ERROR + IS_BEHAT_PORTAL_ERROR + IS_JEST_ERROR))
if [[ "$IS_ERROR" -ne "0" ]]; then
    if [[ "$IS_PHPSPEC_ERROR" -ne "0" ]]; then
        echo "
        --- PHPSPEC FAILED --- "
    fi
    if [[ "$IS_PHPUNIT_ERROR" -ne "0" ]]; then
        echo "
        --- PHPUNIT FAILED --- "
    fi
    if [[ "$IS_BEHAT_API_ERROR" -ne "0" ]]; then
        echo "
        --- BEHAT API FAILED --- "
    fi
    if [[ "$IS_BEHAT_PORTAL_ERROR" -ne "0" ]]; then
        echo "
        --- BEHAT PORTAL FAILED --- "
    fi
    if [[ "IS_JEST_ERROR" -ne "0" ]]; then
        echo "
        --- JEST FAILED --- "
    fi
    exit 1
fi

echo "All OK"

exit 0
