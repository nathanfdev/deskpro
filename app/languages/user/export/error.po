msgid "user.error.attach_ext-allowed"
msgstr "Only the following file types can be uploaded: {{error_detail}}"

msgid "user.error.attach_ext-not-allow"
msgstr "The type of file you uploaded is not allowed."

msgid "user.error.attach_failed"
msgstr "Your attachment failed to upload (did you cancel it?). You should try again."

msgid "user.error.attach_no-file"
