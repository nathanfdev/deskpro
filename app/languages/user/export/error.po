msgid "user.error.form_choice_max"
msgstr "Please select at most 1 option|Please select at most {{count}} options"

msgid "user.error.form_choice_min"
msgstr "Please select at least 1 option|Please select at least {{count}} options"

msgid "user.error.form_date_invalid"
msgstr "Please enter a valid date"

