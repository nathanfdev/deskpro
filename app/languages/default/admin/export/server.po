msgstr "While not recommended, you can {{link}}."

msgid "admin.server.notice_most_efficient_storage"
msgstr "You are currently using the most efficient storage mechanism."

msgid "admin.server.notice_transfer_is_gradually_done"
msgstr "The transfer is done gradually via a scheduled task. It may take some time before all of your files are completely transferred. All normal attachment functions like uploading and downloading will continue to work."

