msgid "admin.server.upload_effect_max"
msgstr "Effective Maximum Filesize"

msgid "admin.server.upload_effect_max_explain"
msgstr "Based on the three values above, this is the effective maximum filesize your server is currently able to accept."

msgid "admin.server.upload_memory_limit_explain"
msgstr "This is the maximum amount of memory PHP can use. A file must be read into memory for DeskPRO to process and save it. The maximum filesize you can accept through an upload will be about 1/3 of this value."

