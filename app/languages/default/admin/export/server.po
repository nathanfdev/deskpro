msgid "admin.server.max_post_size"
msgstr "This is the max size of any POST request that PHP will accept. That is, the size of any file uploads comboned with the size of actual form data cannot exceed this value. This setting and upload_max_filesize are generally about the same."

msgid "admin.server.max_single_file_size"
msgstr "This is the maximum size for any single file that PHP will accept from a client upload. The max size is also affected by post_max_size. The effective maximum is essentially the smallest of upload_max_filesize and post_max_size."

msgid "admin.server.memory_limit"
msgstr "memory_limit"

