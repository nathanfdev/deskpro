msgstr "You are currently storing files in the filesystem at {{path}}.<br /><br />Are you sure you want to switch back to using the database storage mechanism?"

msgid "admin.server.confirm_switch_to_fs"
msgstr "You are currently storing files in the database. Do you want to switch to the filesystem storage mechanism? Files will be stored on your server at {{path}}"

