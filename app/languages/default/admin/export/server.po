msgstr "Uploading and File Storage"

msgid "admin.server.php_settings"
msgstr "PHP Settings"

msgid "admin.server.php_upload_location"
msgstr "This is where PHP saves files to temporarily before they are processed by DeskPRO. This path must be writable by the web server for file uploads to work."

msgid "admin.server.php_version"
msgstr "php_version"

msgid "admin.server.recommend_fs_storage"
