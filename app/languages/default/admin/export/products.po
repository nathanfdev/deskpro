msgid "admin.products.add_new_product"
msgstr "Add New Product"

msgid "admin.products.back_to_products"
msgstr "Back to products"

msgid "admin.products.confirm_delete_product"
msgstr "Are you sure you want to delete the product \"<strong>{{title}}</strong>\"?"

msgid "admin.products.confirm_delete_product_top_level"
msgstr "Are you sure you want to delete the product \"<strong>{{title}}</strong>\"? Since this is a top-level product, <strong>all of these child-products will be deleted too</strong>"

msgid "admin.products.delete_product"
msgstr "Delete Product"

msgid "admin.products.edit_product"
msgstr "Edit Product"

msgid "admin.products.edit_product_title"
msgstr "Edit Product Title"

msgid "admin.products.new_product"
msgstr "New Product"

msgid "admin.products.no_products_created"
msgstr "You have not created any products yet. Click the \"{{subphrase}}\" button to create one now."

