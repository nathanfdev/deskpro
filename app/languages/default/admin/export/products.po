msgid "admin.products.notice_product_will_be_removed"
msgstr "Any tickets that use this product will have it removed, resulting in the ticket having no product set on it."

msgid "admin.products.notice_products_allow_categorization"
msgstr "Products are a type of categorization that you can use across the entire helpdesk. Create a product, which is usually a real product or service your company offers, and use it categorize all kinds of content like tickets, feedback and articles."

msgid "admin.products.notice_products_will_be_removed"
msgstr "Any tickets that use any of these products will have it removed, resulting in the ticket having no product set on it."

msgid "admin.products.parent_product"
msgstr "Parent Product"
