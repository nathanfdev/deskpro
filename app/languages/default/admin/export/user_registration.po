msgid "admin.user_registration.enter_dsn_mysql"
msgstr "Enter the DSN connection string for the database. Refer to the manual for the string format (<a href=\"http://www.php.net/manual/en/ref.pdo-mysql.connection.php\">MySQL</a>). For example: <var>mysql:host=localhost;dbname=mydb</var>"

msgid "admin.user_registration.enter_email_field_here"
msgstr "If your schema has a unique \"email\" field users can use to log in, enter it here. Note that you must specify the username or email fields, or both."

msgid "admin.user_registration.enter_facebook_api_key"
msgstr "Enter your Facebook API application key"

msgid "admin.user_registration.enter_facebook_api_secret"
msgstr "Enter your Facebook API application secret"

msgid "admin.user_registration.enter_name_field_here"
msgstr "If your schema has a field that stores the users full name, enter it here."

msgid "admin.user_registration.enter_port_here"
msgstr "If you are using a non-standard port (389, or 636 for secure connections), enter it here"

msgid "admin.user_registration.enter_raw_php_code"
msgstr "Enter the raw PHP code to use when checking the validity of an inputted password against\n"
"				a found user record. The following variables are available for use:\n"
"				<ul>\n"
"					<li>&middot; $userinfo is the full row from your table</li>\n"
"					<li>&middot; $userinfo_password is the password field from the row. This is the same as $userinfo['yourpasswordfield']</li>\n"
"					<li>&middot; $password_input is the password inputted by the user. This is what you need to check against $userinfo_password.</li>\n"
"					<li>&middot; $pass is a boolean value. If the password is correct, set this variable to true. If it is invalid, set it to false.</li>\n"
"				</ul>\n"
"                Here is some example code to check a salted password:<br />\n"
"				<code>$pass = (md5($password_input . $userinfo['salt']) == $userinfo_password);</code>"

msgid "admin.user_registration.enter_table_prefix_here"
msgstr "If your installation is using a table prefix, enter it here."

msgid "admin.user_registration.enter_the_dsn"
msgstr "Enter the DSN connection string for the database. Refer to the manual for the string format ({{links}}). For example, for a MySQL database: <var>mysql:host=localhost;dbname=mydb</var>"

msgid "admin.user_registration.enter_twitter_key"
msgstr "Enter your Twitter consumer key"

msgid "admin.user_registration.enter_twitter_secret"
msgstr "Enter your Twitter consumer secret"

msgid "admin.user_registration.enter_username_field_here"
msgstr "If your schema has a unique \"username\" field users can use to log in, enter it here. This field is optional and allows users to enter usernames into the login form instead of email addresses."

msgid "admin.user_registration.explain_default_filter"
msgstr "By default, the filter performed when looking up users is <var>(&(objectClass=user)(sAMAccountName=%s))</var>. Use <var>%s</var> as the input placeholder."

msgid "admin.user_registration.explain_lost_password"
msgstr "When a user has logged-in using this usersource and later clicks the \"Forgot Password\" link, this is the URL they will be given to reset their password."

msgid "admin.user_registration.explain_must_login_mode"
msgstr "With this mode, the helpdesk is readable by everyone but users must register or log in to submit content such as new tickets, new feedback, or new comments."

msgid "admin.user_registration.explain_open_helpdesk"
msgstr "With an open helpdesk, anyone can use the helpdesk and anyone can register and log in. New profiles are created for users automatically when they submit new content."

msgid "admin.user_registration.explain_user_source"
msgstr "A user source is any database that DeskPRO will use to authenticate users when they want to log in."

