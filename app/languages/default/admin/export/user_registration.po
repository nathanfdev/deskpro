msgid "admin.user_registration.lbl_fqdn"
msgstr "The FQDN name for users in this directory. For example, a user alice@acme.com would have a domain of acme.com. This option is not required, but if it is not supplied, usernames in principal name form (e.g., alice@acme.com) are not supported."

msgid "admin.user_registration.lbl_password_field"
msgstr "The field in the table that contains the users password."

msgid "admin.user_registration.lbl_password_key"
msgstr "The secret key inside the password check service file you uploaded"

msgid "admin.user_registration.lbl_short_user_domain"
msgstr "The \"short\" domain name for users in this directory, \"ACME\". Note that there is a 1:1 mapping between this short name and the domain name above. This option should be used to specify the NetBIOS domain name for Windows networks. This option is not required but if it is not supplied, usernames in backslash form (e.g., ACME\alice) are not supported."

