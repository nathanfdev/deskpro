msgid "admin.settings.cron_explain"
msgstr "To perform tasks such as processing email, running triggers and sending notifications DeskPRO requires that you schedule the <var>cron.php</var> file in the root folder to be regularly run with a cron script (on linux) or a scheduled task (on windows). It is recommend that you run the <var>cron.php</var> file every minute."

msgid "admin.settings.cron_notice_php_path_not_found"
msgstr "Note: We could not automatically detect the path to the PHP CLI. You should edit <var>config.php</var> to specify the path, and then refresh this page for the proper command."

