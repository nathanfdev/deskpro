msgid "agent.login.ie_compat_mode_explain"
msgstr "Some versions of IE have a feature called Compatibility Mode meant to make old websites work with the newest browser technology. Sometimes this feature can be turned on erroneously. If you are using IE8 or IE9 but you still see the browser requirements page, it is probable that Compatibility Mode is enabled. To use DeskPRO you need to disable this feature:"

msgid "agent.login.ie_compat_mode_step1"
msgstr "If the Tools menu is not already visible, press the Alt key on your keyboard to reveal the main menu"

msgid "agent.login.ie_compat_mode_step2"
msgstr "From the Tools menu choose Compatibility View Setttings"

msgid "agent.login.ie_compat_mode_step3"
msgstr "Locate this website URL in the list and click the Remove button"

msgid "agent.login.ie_compat_mode_step4"
msgstr "Close this window and refresh the page"

msgid "agent.login.ie_compat_mode_title"
msgstr "Are you already using IE8 or later? <a href=\"{{url}}\">Make sure Compatibility Mode is not enabled.</a>"

