msgid "admin.agents.be_careful_who_you_allow_to_manage_email"
msgstr "Be careful who you allow to manage email addresses. Since an agent can add any email address, including ones they might have control over, it means they could use that to gain access to the account if they really wanted to."

msgid "admin.agents.be_careful_who_you_allow_to_reset_user"
msgstr "Be careful who you allow to reset user passwords. Since an agent can reset the password to anything they want, it means they can gain access to the account if they really wanted to."

msgid "admin.agents.if_an_agent_does_not_have_this_permission"
msgstr "If an agent does not have this permission, then any new content they create or edits they make will be held in a validation queue before they appear live on the site."

