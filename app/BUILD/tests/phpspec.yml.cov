extensions:
    - PhpSpec\Extension\CodeCoverageExtension

suites:
    default:
        src_path: ../src
        spec_path: ./

code_coverage:
    show_uncovered_files: true
    whitelist:
      - ../src/DeskPRO/Bundle/AppBundle
      - ../src/DeskPRO/Bundle/PortalBundle
      - ../src/DeskPRO/Bundle/ApiBundle
    blacklist:
      - ../vendor
      - ../vendor-src
    format:
      - clover
      - php
    output:
      clover: coverage/phpspec-clover.xml
      php: coverage/cov/phpspec.cov
