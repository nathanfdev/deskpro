#!/bin/bash

SCRIPT_DIR=$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )
ROOT_DIR=$SCRIPT_DIR/../../../../
cd $ROOT_DIR

DATABASE_NAME=$DATABASE_PREFIX
API_THREADS_NUM=${2:-6}
PORTAL_THREADS_NUM=${3:-6}
THREADS_NUM=$(( API_THREADS_NUM > PORTAL_THREADS_NUM ? API_THREADS_NUM : PORTAL_THREADS_NUM ))

SECONDS=0
echo "Init project deps"
if [ "$1" = "sequential-build" ] ; then
    echo "Building on top of the previous build"
    rm -rf $ROOT_DIR/www/BUILD/pub/build
    rm -rf $ROOT_DIR/var/cache/*/
    rm -rf $ROOT_DIR/var/kernel_cache/*/
    rm -rf $ROOT_DIR/var/tmp/*/
    rm -f $ROOT_DIR/www/BUILD/pub/src/DeskPRO/Bundle/AgentBundle/AgentApp_Reducers.js
    find $ROOT_DIR/var/ -type d -print0 | xargs -0 chmod 755

    cd $ROOT_DIR
    git submodule init
    git submodule update

    cd $ROOT_DIR/app/BUILD
    composer install --ignore-platform-reqs -o

    cd $ROOT_DIR/www/assets/BUILD/pub
    npm install
    rm -rf $ROOT_DIR/www/assets/BUILD/pub/node_modules/@deskpro/react-components/node_modules/react
    npm run-script gulp-prod
    npm run-script gulp-refresh-reducers

    cd $ROOT_DIR/www/assets/BUILD/web
    npm install
    npm run-script sassdoc

    echo "Building legacy assets"
    chmod 0755 $ROOT_DIR/www/assets/BUILD/web/node_modules/gulp-smartsprites/smartsprites-0.2.9/smartsprites.sh
    $ROOT_DIR/bin/console dp:assetic -r ALL --kernel dp --env prod --verbose
elif [ "$1" = "fresh-build" ] ; then
    echo "Building from the ground up"
    $ROOT_DIR/dev/bin/init-project
else
    echo 'First arg must be either "sequential-build" or "fresh-build"'
fi
echo "--> Done in $SECONDS seconds"

cd $ROOT_DIR

echo "Creating test databases ($THREADS_NUM DBs for parallel tests execution and one for production mode instance)"
mysql -e "DROP DATABASE IF EXISTS ${DATABASE_NAME};"
mysql -e "CREATE DATABASE ${DATABASE_NAME};"
mysql -e "GRANT ALL PRIVILEGES ON ${DATABASE_NAME}.* TO 'deskpro'@'localhost' identified by 'deskpro' WITH GRANT OPTION;"
for ((i=1;i<=$THREADS_NUM;i++)); do
    mysql -e "DROP DATABASE IF EXISTS ${DATABASE_NAME}_${i};"
    mysql -e "CREATE DATABASE ${DATABASE_NAME}_${i};"
    mysql -e "GRANT ALL PRIVILEGES ON ${DATABASE_NAME}_${i}.* TO 'deskpro'@'localhost' identified by 'deskpro' WITH GRANT OPTION;"
done
echo "--> Done"

echo "Creating testing config.all.php"
cp app/BUILD/tests/config/config.all.dist.php app/BUILD/tests/config/config.all.php
echo "--> Done"

echo "Copying configs"
cp -a app/BUILD/config_new/. config/
echo "--> Done"

echo "Modifying copied configs"
echo "\$DB_CONFIG['user']     = 'deskpro';" >> config/config.database.php
echo "\$DB_CONFIG['password'] = 'deskpro';" >> config/config.database.php
echo "\$DB_CONFIG['dbname']   = '${DATABASE_NAME}';" >> config/config.database.php
echo "\$prodModeFlagFile = realpath(__DIR__ . '/../../var/tmp/behat_production_mode_flag.tmp');" >> config/advanced/config.env.php
echo "\$ENV_CONFIG['environment'] = file_exists(\$prodModeFlagFile) ? 'prod' : 'dev';" >> config/advanced/config.env.php
echo "\$SETTINGS['core.deskpro_url'] = '${INSTANCE_URL}/';" >> config/advanced/config.settings.php
echo "\$SETTINGS['enable_agent_v2'] = true;" >> config/advanced/config.settings.php
echo "--> Done"

echo "Copying E2E configs"
cp www/assets/BUILD/pub/src/tests/E2E/config.js.dist www/assets/BUILD/pub/src/tests/E2E/config.js
cp www/assets/BUILD/pub/nightwatch.conf.js.dist www/assets/BUILD/pub/nightwatch.conf.js
echo "--> Done"

echo "Modifying copied E2E configs"
echo "module.exports.test_settings.cbt.username = '${CBT_USERNAME}';" >> www/assets/BUILD/pub/nightwatch.conf.js
echo "module.exports.test_settings.cbt.password = '${CBT_PASSWORD}';" >> www/assets/BUILD/pub/nightwatch.conf.js
echo "exports.config.baseUrl = '${INSTANCE_URL}';" >> www/assets/BUILD/pub/src/tests/E2E/config.js
echo "exports.config.users.admin.email = 'admin@deskpro.dev';" >> www/assets/BUILD/pub/src/tests/E2E/config.js
echo "exports.config.users.admin.password = 'pass';" >> www/assets/BUILD/pub/src/tests/E2E/config.js
echo "--> Done"

echo "Ensuring permissions"
chmod -R 0777 var
chmod -R 0777 www/assets/BUILD/pub/src/tests/E2E/reports
echo "--> Done"

echo "Running full tests suite"
app/BUILD/tests/jenkins/run-tests $API_THREADS_NUM $PORTAL_THREADS_NUM
exit $?
