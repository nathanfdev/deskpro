#!/bin/bash

##############################################
# DETERMINE THREADS NUMBER
##############################################

THREADS_NUM=$1
if [ "$THREADS_NUM" -eq "$THREADS_NUM" ] 2>/dev/null ; then
    printf "\n --- Running tests in $THREADS_NUM threads --- \n\n"
else
  echo "You must provide integer threads number argument!"
  exit 1
fi

##############################################
# ESTABLISH CONTEXT
##############################################

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd $SCRIPT_DIR
cd ..
LOGS_DIR="$SCRIPT_DIR/../../../../var/logs/parallel-tests"
rm -rf $LOGS_DIR/*
mkdir -p $LOGS_DIR

##############################################
# RUN 6 SMALL TEST SUITES IN PARALLEL
##############################################

# Hack: see https://trello.com/c/xv8IRWTo/382-test-is-failing-when-running-for-the-first-time
bin/phpunit phpunit/DpTest/Application/EmailBundle/Templating/EngineTest.php > /dev/null
# ---

SECONDS=0
echo "Running small test suites in parallel (phpunit, phpspec, jest, beaht install/production/system-api)"
(export DP_PARALLEL_TESTING_PROCESS_NUM=1; bin/phpunit --testsuite DeskPRO &> "$LOGS_DIR/phpunit.txt"; bin/phpunit --testsuite DeskPRO-TermEngine &> "$LOGS_DIR/phpunit-term-engine.txt"; bin/phpunit --testsuite DeskPRO-Portal &> "$LOGS_DIR/phpunit-portal.txt") &
(bin/phpspec run --format=dot &> "$LOGS_DIR/phpspec.txt") &
(cd ../../../www/assets/BUILD/pub/ && npm test &> "$LOGS_DIR/jest.txt") &
(export DP_PARALLEL_TESTING_PROCESS_NUM=2 && bin/behat --profile=install &> "$LOGS_DIR/behat-install.txt") &
(export DP_PARALLEL_TESTING_PROCESS_NUM=3 && bin/behat --profile=system-api &> "$LOGS_DIR/behat-system-api.txt") &
(bin/behat --profile=production &> "$LOGS_DIR/behat-production.txt") &
wait
echo "--> Done in $SECONDS seconds"

##############################################
# TAG FEATURES TO RUN IN THREADS
##############################################

jenkins/tag-features --tag=parallel --num=$THREADS_NUM

##############################################
# BEHAT API IN PARALLEL THREADS
##############################################

SECONDS=0
echo "Running behat api suite in $THREADS_NUM parallel threads"
for ((i=1;i<=$THREADS_NUM;i++)); do
    (export DP_PARALLEL_TESTING_PROCESS_NUM=$i && bin/behat --profile=api --tags="@parallel-$i" &> "$LOGS_DIR/behat-api-$i.txt") &
done
wait
echo "--> Done in $SECONDS seconds"

##############################################
# BEHAT PORTAL IN PARALLEL THREADS
##############################################

SECONDS=0
echo "Running behat portal suite in $THREADS_NUM parallel threads"
for ((i=1;i<=$THREADS_NUM;i++)); do
    (export DP_PARALLEL_TESTING_PROCESS_NUM=$i && bin/behat --profile=portal --tags="@parallel-$i" &> "$LOGS_DIR/behat-portal-$i.txt") &
done
wait
echo "--> Done in $SECONDS seconds"

##############################################
# WAIT FOR THREADS TO FINISH GUARANTEED
##############################################

sleep 3

##############################################
# PRINT RESULTS
##############################################

echo ""
echo ""
echo "-----------------------------------------------------------------------------------------------------------------"
echo "PHPUnit"
echo "-----------------------------------------------------------------------------------------------------------------"
echo ""
tail -n 50 "$LOGS_DIR/phpunit.txt"; sleep .1
tail -n 50 "$LOGS_DIR/phpunit-term-engine.txt"; sleep .1
tail -n 50 "$LOGS_DIR/phpunit-portal.txt"; sleep .1

echo ""
echo "-----------------------------------------------------------------------------------------------------------------"
echo "PHPSpec"
echo "-----------------------------------------------------------------------------------------------------------------"
tail -n 50 "$LOGS_DIR/phpspec.txt"; sleep .1

echo ""
echo "-----------------------------------------------------------------------------------------------------------------"
echo "Jest"
echo "-----------------------------------------------------------------------------------------------------------------"
echo ""
tail -n 10 "$LOGS_DIR/jest.txt"; sleep .1

echo ""
echo ""
echo "-----------------------------------------------------------------------------------------------------------------"
echo "Behat install"
echo "-----------------------------------------------------------------------------------------------------------------"
echo ""
tail -n 10 "$LOGS_DIR/behat-install.txt"; sleep .1

echo ""
echo "-----------------------------------------------------------------------------------------------------------------"
echo "Behat system-api"
echo "-----------------------------------------------------------------------------------------------------------------"
echo ""
tail -n 10 "$LOGS_DIR/behat-system-api.txt"; sleep .1

echo ""
echo "-----------------------------------------------------------------------------------------------------------------"
echo "Behat production"
echo "-----------------------------------------------------------------------------------------------------------------"
echo ""
tail -n 25 "$LOGS_DIR/behat-production.txt"; sleep .1

echo ""
echo "-----------------------------------------------------------------------------------------------------------------"
echo "Behat api"
echo "-----------------------------------------------------------------------------------------------------------------"
for ((i=1;i<=$THREADS_NUM;i++)); do
    printf "\n\n--- api thread $i ---\n\n"; tail -n 50 "$LOGS_DIR/behat-api-$i.txt"; sleep .1
done

echo ""
echo "-----------------------------------------------------------------------------------------------------------------"
echo "Behat portal"
echo "-----------------------------------------------------------------------------------------------------------------"
for ((i=1;i<=$THREADS_NUM;i++)); do
    printf "\n\n--- portal thread $i ---\n\n"; tail -n 50 "$LOGS_DIR/behat-portal-$i.txt"; sleep .1
done

##############################################
# SUMMARIZE RESULTS
##############################################

echo ""
echo "-----------------------------------------------------------------------------------------------------------------"
echo "Build summary"
echo "-----------------------------------------------------------------------------------------------------------------"

phpunit=$(tail -n 2 "$LOGS_DIR/phpunit.txt" | tr '\n' ' ')
phpunit_term_engine=$(tail -n 2 "$LOGS_DIR/phpunit-term-engine.txt" | tr '\n' ' ')
phpunit_portal=$(tail -n 2 "$LOGS_DIR/phpunit-portal.txt" | tr '\n' ' ')
phpspec=$(tail -n 3 "$LOGS_DIR/phpspec.txt" | tr '\n' ' ')
jest=$(tail -n 1 "$LOGS_DIR/jest.txt" | tr '\n' ' ')
behat_install=$(tail -n 3 "$LOGS_DIR/behat-install.txt" | tr '\n' ' ')
behat_system_api=$(tail -n 3 "$LOGS_DIR/behat-system-api.txt" | tr '\n' ' ')
behat_production=$(tail -n 3 "$LOGS_DIR/behat-production.txt" | tr '\n' ' ')
for ((i=1;i<=$THREADS_NUM;i++)); do
    behat_api[$i]=$(tail -n 3 "$LOGS_DIR/behat-api-$i.txt" | tr '\n' ' ')
done
for ((i=1;i<=$THREADS_NUM;i++)); do
    behat_portal[$i]=$(tail -n 3 "$LOGS_DIR/behat-portal-$i.txt" | tr '\n' ' ')
done

echo "
(1) PHPUnit:

 - DeskPRO: $phpunit
 - DeskPRO-TermEngine: $phpunit_term_engine
 - DeskPRO-Portal: $phpunit_portal

(2) PHPSpec: $phpspec

---------------

(3) Jest: $jest

---------------

(4) Behat install: $behat_install

(5) Behat system-api: $behat_system_api

(6) Behat production: $behat_production

---------------

Behat api:
"
for ((i=1;i<=$THREADS_NUM;i++)); do
    echo "($i) ${behat_api[i]}"
done

echo "
---------------

Behat portal:
"
for ((i=1;i<=$THREADS_NUM;i++)); do
    echo "($i) ${behat_portal[i]}"
done

echo ""
echo "-----------------------------------------------------------------------------------------------------------------"
echo "Build status"
echo "-----------------------------------------------------------------------------------------------------------------"

phpunit_failed=0
if [[ "$phpunit" =~ "FAILURES" ]] || [[ "$phpunit_term_engine" =~ "FAILURES" ]] || [[ "$phpunit_portal" =~ "FAILURES" ]] ; then
    phpunit_failed=1
    echo "PHPUnit failed"
fi

phpspec_failed=0
if [[ "$phpspec" =~ "failed" ]] ; then
    phpspec_failed=1
    echo "PHPSpec failed"
fi

jest_failed=0
if [[ "$jest" =~ "fail" ]] ; then
    jest_failed=1
    echo "Jest failed"
fi

behat_install_failed=0
if [[ "$behat_install" =~ "failed" ]] ; then
    behat_install_failed=1
    echo "Behat install failed"
fi

behat_system_api_failed=0
if [[ "$behat_system_api" =~ "failed" ]] ; then
    behat_system_api_failed=1
    echo "Behat system-api failed"
fi

behat_production_failed=0
if [[ "$behat_production" =~ "failed" ]] ; then
    behat_production_failed=1
    echo "Behat production failed"
fi

behat_api_failed=0
for ((i=1;i<=$THREADS_NUM;i++)); do
    if [[ "${behat_api[i]}" =~ "failed" ]] ; then
        behat_api_failed=1
        echo "Behat api failed"
        break
    fi
done

behat_portal_failed=0
for ((i=1;i<=$THREADS_NUM;i++)); do
    if [[ "${behat_portal[i]}" =~ "failed" ]] ; then
        behat_portal_failed=1
        echo "Behat portal failed"
        break
    fi
done

##############################################
# EXIT 0/1
##############################################

echo ""
status=$((phpunit_failed + phpspec_failed + jest_failed + behat_install_failed + behat_system_api_failed + behat_production_failed + behat_api_failed + behat_portal_failed))
if [[ "$status" -ne "0" ]]; then
    echo "-------------------------------------------------------------------------------------------------------------"
    echo ""
    echo "--- FAILED --- "
    echo ""
    exit 1
else
    echo "--- ALL OK --- "
    echo ""
    exit 0
fi
