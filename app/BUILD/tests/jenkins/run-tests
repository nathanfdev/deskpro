#!/bin/bash

#################################################
# DETERMINE THREADS NUMBER
#################################################

API_THREADS_NUM=$1
API_NEW_THREADS_NUM=5
PORTAL_THREADS_NUM=$2

#################################################
# ESTABLISH CONTEXT
#################################################

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd $SCRIPT_DIR
cd ..
LOGS_DIR="$SCRIPT_DIR/../../../../var/logs/parallel-tests"
rm -rf $LOGS_DIR/*
mkdir -p $LOGS_DIR

#################################################
# Tag behat features
#################################################
jenkins/tag-features --tag=parallel --num=$API_THREADS_NUM --path=../features/api
jenkins/tag-features --tag=parallel --num=$PORTAL_THREADS_NUM --path=../features/portal
jenkins/tag-features --tag=new-parallel --num=$API_NEW_THREADS_NUM --path=../features/api

#################################################
# WARM UP ALL CACHES
#################################################

SECONDS=0
echo "---"
php -v
echo "---"

# Hack: see https://trello.com/c/xv8IRWTo/382-test-is-failing-when-running-for-the-first-time
bin/phpunit phpunit/DpTest/Application/EmailBundle/Templating/EngineTest.php > /dev/null
# ---

././../../bin/console cache:warmup --kernel api --env=test
././../../bin/console cache:warmup --kernel api --env=test --no-debug
././../../bin/console cache:warmup --kernel portal --env=test
././../../bin/console cache:warmup --kernel portal --env=test --no-debug

#################################################
# RUN SYSTEM API TESTS
#################################################

echo "Running a single system-api behat thread to generate caches w/o concurrency"
(export DP_PARALLEL_TESTING_PROCESS_NUM=1 && bin/behat --profile=system-api --tags="~@skip-ci" --verbose &> "$LOGS_DIR/behat-system-api.txt") &
wait
echo "--> Done in $SECONDS seconds"

#################################################
# RUN E2E AND JEST TESTS
#################################################

SECONDS=0
#echo "Running E2E"
#(cd ../../../www/assets/BUILD/pub/ && npm run-script test:e2e -- -e cbt --test=src/tests/E2E/tests/rough-tests.js &> "$LOGS_DIR/e2e.txt") &
echo "Running Jest"
(cd ../../../www/assets/BUILD/pub/ && npm run-script test:unit &> "$LOGS_DIR/jest.txt") &
wait
echo "--> Done in $SECONDS seconds"

#################################################
# RUN 6 SMALL TEST SUITES IN PARALLEL + API @new
#################################################

SECONDS=0
echo "Running small test suites in parallel (phpunit, phpspec, beaht install/production)"
(export DP_PARALLEL_TESTING_PROCESS_NUM=1; bin/phpunit --testsuite DeskPRO &> "$LOGS_DIR/phpunit.txt"; bin/phpunit --testsuite DeskPRO-TermEngine &> "$LOGS_DIR/phpunit-term-engine.txt"; bin/phpunit --testsuite DeskPRO-Portal &> "$LOGS_DIR/phpunit-portal.txt") &
(export DP_PARALLEL_TESTING_PROCESS_NUM=2 && bin/behat --profile=install --tags="~@skip-ci" --verbose &> "$LOGS_DIR/behat-install.txt") &
(bin/phpspec run --format=dot &> "$LOGS_DIR/phpspec.txt") &
(bin/behat --verbose --profile=production &> "$LOGS_DIR/behat-production.txt") &

echo "Running @new API behat tests in $API_NEW_THREADS_NUM parallel threads"
for ((i=1;i<=$API_NEW_THREADS_NUM;i++)); do
    num=$((i + 2))
    (export DP_PARALLEL_TESTING_PROCESS_NUM=$num && bin/behat --profile=api --tags="@new-parallel-$i&&@new&&~@skip-ci" --verbose &> "$LOGS_DIR/behat-api-new-$i.txt") &
done

wait
echo "--> Done in $SECONDS seconds"

#################################################
# BEHAT API IN PARALLEL THREADS
#################################################

SECONDS=0
echo "Running behat api suite in $API_THREADS_NUM parallel threads"
for ((i=1;i<=$API_THREADS_NUM;i++)); do
    (export DP_PARALLEL_TESTING_PROCESS_NUM=$i && bin/behat --profile=api --tags="@parallel-$i&&~@new&&~@skip-ci" --verbose &> "$LOGS_DIR/behat-api-$i.txt") &
done
wait
echo "--> Done in $SECONDS seconds"

#################################################
# BEHAT PORTAL IN PARALLEL THREADS
#################################################

SECONDS=0
echo "Running behat portal suite in $PORTAL_THREADS_NUM parallel threads"
for ((i=1;i<=$PORTAL_THREADS_NUM;i++)); do
    (export DP_PARALLEL_TESTING_PROCESS_NUM=$i && bin/behat --profile=portal --tags="@parallel-$i&&~@skip-ci" --verbose &> "$LOGS_DIR/behat-portal-$i.txt") &
done
wait
echo "--> Done in $SECONDS seconds"

#################################################
# WAIT FOR THREADS TO FINISH GUARANTEED
#################################################

sleep 2

#################################################
# PRINT RESULTS
#################################################

echo ""
echo ""
echo "-----------------------------------------------------------------------------------------------------------------"
echo "PHPUnit"
echo "-----------------------------------------------------------------------------------------------------------------"
echo ""
tail -n 50 "$LOGS_DIR/phpunit.txt"; sleep .1
tail -n 50 "$LOGS_DIR/phpunit-term-engine.txt"; sleep .1
tail -n 50 "$LOGS_DIR/phpunit-portal.txt"; sleep .1

echo ""
echo "-----------------------------------------------------------------------------------------------------------------"
echo "PHPSpec"
echo "-----------------------------------------------------------------------------------------------------------------"
tail -n 50 "$LOGS_DIR/phpspec.txt"; sleep .1

echo ""
echo "-----------------------------------------------------------------------------------------------------------------"
echo "Jest"
echo "-----------------------------------------------------------------------------------------------------------------"
echo ""
tail -n 10 "$LOGS_DIR/jest.txt"; sleep .1

echo ""
echo ""
echo "-----------------------------------------------------------------------------------------------------------------"
echo "Behat install"
echo "-----------------------------------------------------------------------------------------------------------------"
echo ""
tail -n 10 "$LOGS_DIR/behat-install.txt"; sleep .1

echo ""
echo "-----------------------------------------------------------------------------------------------------------------"
echo "Behat system-api"
echo "-----------------------------------------------------------------------------------------------------------------"
echo ""
tail -n 10 "$LOGS_DIR/behat-system-api.txt"; sleep .1

echo ""
echo "-----------------------------------------------------------------------------------------------------------------"
echo "Behat production"
echo "-----------------------------------------------------------------------------------------------------------------"
echo ""
tail -n 10 "$LOGS_DIR/behat-production.txt"; sleep .1

echo ""
echo "-----------------------------------------------------------------------------------------------------------------"
echo "Behat api"
echo "-----------------------------------------------------------------------------------------------------------------"
for ((i=1;i<=$API_THREADS_NUM;i++)); do
    printf "\n\n--- api thread $i ---\n\n"; tail -n 50 "$LOGS_DIR/behat-api-$i.txt"; sleep .1
done
for ((i=1;i<=$API_NEW_THREADS_NUM;i++)); do
    printf "\n\n--- api new thread $i ---\n\n"; tail -n 25 "$LOGS_DIR/behat-api-new-$i.txt"; sleep .1
done

echo ""
echo "-----------------------------------------------------------------------------------------------------------------"
echo "Behat portal"
echo "-----------------------------------------------------------------------------------------------------------------"
for ((i=1;i<=$PORTAL_THREADS_NUM;i++)); do
    printf "\n\n--- portal thread $i ---\n\n"; tail -n 50 "$LOGS_DIR/behat-portal-$i.txt"; sleep .1
done

#echo ""
#echo "-----------------------------------------------------------------------------------------------------------------"
#echo "E2E"
#echo "-----------------------------------------------------------------------------------------------------------------"
#echo ""
#tail -n 10 "$LOGS_DIR/#.txt"; sleep .1

#################################################
# SUMMARIZE RESULTS
#################################################

echo ""
echo "-----------------------------------------------------------------------------------------------------------------"
echo "Build summary"
echo "-----------------------------------------------------------------------------------------------------------------"

phpunit=$(tail -n 2 "$LOGS_DIR/phpunit.txt" | tr '\n' ' ')
phpunit_portal=$(tail -n 2 "$LOGS_DIR/phpunit-portal.txt" | tr '\n' ' ')
phpspec=$(tail -n 3 "$LOGS_DIR/phpspec.txt" | tr '\n' ' ')
jest=$(tail -n 3 "$LOGS_DIR/jest.txt" | tr '\n' ' ')
behat_install=$(tail -n 3 "$LOGS_DIR/behat-install.txt" | tr '\n' ' ')
behat_system_api=$(tail -n 3 "$LOGS_DIR/behat-system-api.txt" | tr '\n' ' ')
behat_production=$(tail -n 3 "$LOGS_DIR/behat-production.txt" | tr '\n' ' ')
#e2e=$(tail -n 3 "$LOGS_DIR/e2e.txt" | tr '\n' ' ')
for ((i=1;i<=$API_THREADS_NUM;i++)); do
    behat_api[$i]=$(tail -n 3 "$LOGS_DIR/behat-api-$i.txt" | tr '\n' ' ')
done
for ((i=1;i<=$API_NEW_THREADS_NUM;i++)); do
    behat_api_new[$i]=$(tail -n 3 "$LOGS_DIR/behat-api-new-$i.txt" | tr '\n' ' ')
done

for ((i=1;i<=$PORTAL_THREADS_NUM;i++)); do
    behat_portal[$i]=$(tail -n 3 "$LOGS_DIR/behat-portal-$i.txt" | tr '\n' ' ')
done

echo "
(1) PHPUnit:

 - DeskPRO: $phpunit
 - DeskPRO-Portal: $phpunit_portal

(2) PHPSpec: $phpspec

---------------

(3) Jest: $jest

---------------

(4) Behat install: $behat_install

(5) Behat system-api: $behat_system_api

(6) Behat production: $behat_production

---------------

Behat api:
"
for ((i=1;i<=$API_THREADS_NUM;i++)); do
    echo "($i) ${behat_api[i]}"
done
for ((i=1;i<=$API_NEW_THREADS_NUM;i++)); do
    echo "($i new) ${behat_api_new[i]}"
done

echo "
---------------

Behat portal:
"
for ((i=1;i<=$PORTAL_THREADS_NUM;i++)); do
    echo "($i) ${behat_portal[i]}"
done

echo "
---------------

E2E:
"
echo "$e2e";

echo ""
echo "-----------------------------------------------------------------------------------------------------------------"
echo "The following @skip-ci scenarios were not executed"
echo "-----------------------------------------------------------------------------------------------------------------"

bin/behat --profile=api --tags='@skip-ci' --dry-run | grep -i '.feature:' | grep -v '#'
bin/behat --profile=portal --tags='@skip-ci' --dry-run | grep -i '.feature:' | grep -v '#'

echo ""
echo "-----------------------------------------------------------------------------------------------------------------"
echo "Build status"
echo "-----------------------------------------------------------------------------------------------------------------"

phpunit_failed=0
if [[ ${phpunit} =~ "FAILURES" ]] || [[ ! ${phpunit} =~ "OK (" ]] ; then
    phpunit_failed=1
    mv "$LOGS_DIR/phpunit.txt" "$LOGS_DIR/FAILED-phpunit.txt"
    echo "- PHPUnit failed"
fi
if [[ ${phpunit_portal} =~ "FAILURES" ]] || [[ ! ${phpunit_portal} =~ "OK (" ]] ; then
    phpunit_failed=1
    mv "$LOGS_DIR/phpunit-portal.txt" "$LOGS_DIR/FAILED-phpunit-portal.txt"
    echo "- PHPUnit Portal failed"
fi

phpspec_failed=0
if [[ ${phpspec} =~ "failed" ]] || [[ ${phpspec} =~ "broken" ]] || [[ ! ${phpspec} =~ "passed)" ]] ; then
    phpspec_failed=1
    mv "$LOGS_DIR/phpspec.txt" "$LOGS_DIR/FAILED-phpspec.txt"
    echo "- PHPSpec failed"
fi

jest_failed=0
if [[ ${jest} =~ "fail" ]] || [[ ! ${jest} =~ "tests passed" ]] ; then
    jest_failed=1
    mv "$LOGS_DIR/jest.txt" "$LOGS_DIR/FAILED-jest.txt"
    echo "- Jest failed"
fi

behat_install_failed=0
if [[ ${behat_install} =~ "failed" ]] || [[ ! ${behat_install} =~ "passed" ]] ; then
    behat_install_failed=1
    mv "$LOGS_DIR/behat-install.txt" "$LOGS_DIR/FAILED-behat-install.txt"
    echo "- Behat install failed"
fi

behat_system_api_failed=0
if [[ ${behat_system_api} =~ "failed" ]] || [[ ! ${behat_system_api} =~ "passed" ]] ; then
    behat_system_api_failed=1
    mv "$LOGS_DIR/behat-system-api.txt" "$LOGS_DIR/FAILED-behat-system-api.txt"
    echo "- Behat system-api failed"
fi

behat_production_failed=0
if [[ ${behat_production} =~ "failed" ]] || [[ ! ${behat_production} =~ "passed" ]] ; then
    behat_production_failed=1
    mv "$LOGS_DIR/behat-production.txt" "$LOGS_DIR/FAILED-production.txt"
    echo "- Behat production failed"
fi

behat_api_failed=0
for ((i=1;i<=$API_THREADS_NUM;i++)); do
    if [[ ${behat_api[i]} =~ "failed" ]] || [[ ! ${behat_api[i]} =~ "passed" ]] ; then
        behat_api_failed=1
        mv "$LOGS_DIR/behat-api-${i}.txt" "$LOGS_DIR/FAILED-behat-api-${i}.txt"
    fi
done
for ((i=1;i<=$API_NEW_THREADS_NUM;i++)); do
    if [[ ${behat_api_new[i]} =~ "failed" ]] || [[ ! ${behat_api_new[i]} =~ "passed" ]] ; then
        behat_api_failed=1
        mv "$LOGS_DIR/behat-api-new-${i}.txt" "$LOGS_DIR/FAILED-behat-api-new-${i}.txt"
    fi
done
if [[ "$behat_api_failed" -ne "0" ]]; then
    echo "- Behat api failed"
fi


behat_portal_failed=0
for ((i=1;i<=$PORTAL_THREADS_NUM;i++)); do
    if [[ ${behat_portal[i]} =~ "failed" ]] || [[ ! ${behat_portal[i]} =~ "passed" ]] ; then
        behat_portal_failed=1
        mv "$LOGS_DIR/behat-portal-${i}.txt" "$LOGS_DIR/FAILED-behat-portal-${i}.txt"
    fi
done
if [[ "$behat_portal_failed" -ne "0" ]]; then
    echo "- Behat portal failed"
fi

e2e_failed=0
#if [[ ! ${e2e} =~ "OK." ]] ; then
#    e2e_failed=1
#    mv "$LOGS_DIR/e2e.txt" "$LOGS_DIR/FAILED-e2e.txt"
#    echo "- E2E failed"
#fi

#################################################
# EXIT 0/1
#################################################

echo ""
status=$((phpunit_failed + phpspec_failed + jest_failed + behat_install_failed + behat_system_api_failed + behat_production_failed + behat_api_failed + behat_portal_failed + e2e_failed))
if [[ "$status" -ne "0" ]]; then
    echo "-------------------------------------------------------------------------------------------------------------"
    echo ""
    echo "--- FAILED --- "
    echo ""
    exit 1
else
    echo "--- ALL OK --- "
    echo ""
    exit 0
fi
