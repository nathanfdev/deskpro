#!/bin/bash

SCRIPT_DIR=$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )
ROOT_DIR=$SCRIPT_DIR/../../../../

TESTS_ERROR=1

cd $ROOT_DIR

DATABASE_NAME=$DATABASE_PREFIX

echo "Init project deps"
$ROOT_DIR/dev/bin/init-project
echo "--> Done"

echo "Creating test databases"
mysql -e "CREATE DATABASE ${DATABASE_NAME};"
mysql -e "CREATE DATABASE ${DATABASE_NAME}_test;"
mysql -e "GRANT ALL PRIVILEGES ON ${DATABASE_NAME}.* TO 'deskpro'@'localhost' identified by 'deskpro' WITH GRANT OPTION;"
mysql -e "GRANT ALL PRIVILEGES ON ${DATABASE_NAME}_test.* TO 'deskpro'@'localhost' identified by 'deskpro' WITH GRANT OPTION;"
echo "--> Done"

echo "Creating config.all.php"
cp app/BUILD/tests/config/config.all.dist.php app/BUILD/tests/config/config.all.php
echo "--> Done"

echo "Ensuring permissions"
chmod -R 0777 data
chmod -R 0777 app/BUILD/sys/cache
echo "--> Done"

if [ "$1" = "quick" ]; then
    echo "Running quick tests"
    app/BUILD/tests/bin/run-tests-quick
else
    echo "Running full tests suite"
    app/BUILD/tests/bin/run-tests coverage
fi

if [[ $? -eq 0 ]]; then
    TESTS_ERROR=0
fi

echo "Removing test databases"
mysql -e "DROP DATABASE ${DATABASE_NAME};"
mysql -e "DROP DATABASE ${DATABASE_NAME}_test;"
echo "--> Done"

exit $TESTS_ERROR
