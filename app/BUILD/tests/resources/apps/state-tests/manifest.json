{
  "appVersion":"0.1.0",
  "author":{
    "name":"DeskPRO Ltd.",
    "email":"apps@deskpro.com",
    "url":"https://deskpro.com"
  },
  "description":"Enables agents to link Deskpro tickets and Jira issues. Allows creating, searching and listing Jira issues from within Deskpro.",
  "name":"@deskproapps/jira",
  "version":"2.3.0",
  "title":"Jira BETA",
  "isSingle":true,
  "scope":"agent",
  "storage":[
    {
      "name":"oauth:jira",
      "isBackendOnly":true,
      "permRead":"EVERYBODY",
      "permWrite":"OWNER"
    },
    {
      "name":"oauth:jira:tokens",
      "isBackendOnly":true,
      "permRead":"OWNER",
      "permWrite":"OWNER"
    },
    {
      "name":"rsaPrivateKey",
      "isBackendOnly":false,
      "permRead":"EVERYBODY",
      "permWrite":"OWNER"
    },
    {
      "name":"rsaPublicKey",
      "isBackendOnly":false,
      "permRead":"EVERYBODY",
      "permWrite":"OWNER"
    },
    {
      "name":"jiraInstanceUrl",
      "isBackendOnly":false,
      "permRead":"EVERYBODY",
      "permWrite":"OWNER"
    },
    {
      "name":"jiraClientId",
      "isBackendOnly":false,
      "permRead":"EVERYBODY",
      "permWrite":"OWNER"
    }
  ],
  "targets":[
    {
      "target":"ticket-sidebar",
      "url":"html/index.html"
    },
    {
      "target":"install",
      "url":"html/install.html"
    }
  ],
  "settings":[
    {
      "name":"rsaPrivateKey",
      "defaultValue":"",
      "title":"Your private key",
      "required":true,
      "type":"textarea"
    },
    {
      "name":"rsaPublicKey",
      "defaultValue":"",
      "title":"Your public key",
      "required":true,
      "type":"textarea"
    },
    {
      "name":"jiraInstanceUrl",
      "defaultValue":"",
      "title":"The Jira instance you want to connect to",
      "required":true,
      "type":"text"
    },
    {
      "name":"jiraClientId",
      "defaultValue":"",
      "title":"The consumer key",
      "required":true,
      "type":"text"
    }
  ],
  "customFields":[
    {
      "type":"dataList",
      "attachedTo":"ticket",
      "alias":"jiraCards",
      "title":"Jira linked issues"
    }
  ],
  "deskproApiTags":[
    "tickets.*"
  ],
  "externalApis":[
    "/^https?://([^.]+\\.)*atlassian.net/?.*$/"
  ]
}
