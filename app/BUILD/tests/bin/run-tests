#!/bin/bash


##################################
# ESTABLISH CONTEXT
##################################
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd $SCRIPT_DIR
cd ..

##################################
# PHPUNIT
#
# ToDo: run coverage "-c phpunit.xml.cov --log-junit junit-results.xml" for all suits, combine into a single report
##################################

# Hack: see https://trello.com/c/xv8IRWTo/382-test-is-failing-when-running-for-the-first-time
bin/phpunit phpunit/DpTest/Application/EmailBundle/Templating/EngineTest.php > /dev/null
# ---

IS_PHPUNIT_ERROR=0
bin/phpunit --testsuite DeskPRO
if [[ $? -ne 0 ]] ; then
    IS_PHPUNIT_ERROR=1
fi

IS_PHPUNIT_TERM_ENGINE_ERROR=0
bin/phpunit --testsuite DeskPRO-TermEngine
if [[ $? -ne 0 ]] ; then
    IS_PHPUNIT_TERM_ENGINE_ERROR=1
fi

IS_PHPUNIT_PORTAL_ERROR=0
bin/phpunit --testsuite DeskPRO-Portal
if [[ $? -ne 0 ]] ; then
    IS_PHPUNIT_PORTAL_ERROR=1
fi

##################################
# PHPSPEC
##################################
IS_PHPSPEC_ERROR=0

bin/phpspec run --format=dot

if [[ $? -ne 0 ]] ; then
    IS_PHPSPEC_ERROR=1
fi

##################################
# BEHAT
##################################
IS_BEHAT_INSTALL_ERROR=0
bin/behat --config=behat.yml --profile=install
if [[ $? -ne 0 ]] ; then
    IS_BEHAT_INSTALL_ERROR=1
fi

IS_BEHAT_API_ERROR=0
bin/behat --config=behat.yml --profile=api
if [[ $? -ne 0 ]] ; then
    IS_BEHAT_API_ERROR=1
fi

IS_BEHAT_PORTAL_ERROR=0
bin/behat --config=behat.yml --profile=portal
if [[ $? -ne 0 ]] ; then
    IS_BEHAT_PORTAL_ERROR=1
fi

IS_BEHAT_PRODUCTION_ERROR=0
bin/behat --profile=production
if [[ $? -ne 0 ]] ; then
    IS_BEHAT_PRODUCTION_ERROR=1
fi

##################################
# Jest
##################################
IS_JEST_ERROR=0

cd ../../../www/assets/BUILD/pub/
npm test

if [[ $? -ne 0 ]] ; then
    IS_JEST_ERROR=1
fi

##################################
# EXIT IF ERROR
##################################
IS_ERROR=$((IS_PHPSPEC_ERROR + IS_PHPUNIT_ERROR + IS_PHPUNIT_TERM_ENGINE_ERROR + IS_PHPUNIT_PORTAL_ERROR + IS_BEHAT_INSTALL_ERROR + IS_BEHAT_API_ERROR + IS_BEHAT_PORTAL_ERROR + IS_BEHAT_PRODUCTION_ERROR + IS_JEST_ERROR))
if [[ "$IS_ERROR" -ne "0" ]]; then
    if [[ "$IS_PHPSPEC_ERROR" -ne "0" ]]; then
        echo "
        --- PHPSPEC FAILED --- "
    fi
    if [[ "$IS_PHPUNIT_ERROR" -ne "0" ]]; then
        echo "
        --- PHPUNIT FAILED --- "
    fi
    if [[ "IS_PHPUNIT_TERM_ENGINE_ERROR" -ne "0" ]]; then
        echo "
        --- PHPUNIT TERM ENGINE FAILED --- "
    fi
    if [[ "IS_PHPUNIT_PORTAL_ERROR" -ne "0" ]]; then
        echo "
        --- PHPUNIT PORTAL FAILED --- "
    fi
    if [[ "$IS_BEHAT_INSTALL_ERROR" -ne "0" ]]; then
        echo "
        --- BEHAT INSTALL FAILED --- "
    fi
    if [[ "$IS_BEHAT_API_ERROR" -ne "0" ]]; then
        echo "
        --- BEHAT API FAILED --- "
    fi
    if [[ "$IS_BEHAT_PORTAL_ERROR" -ne "0" ]]; then
        echo "
        --- BEHAT PORTAL FAILED --- "
    fi
    if [[ "$IS_BEHAT_PRODUCTION_ERROR" -ne "0" ]]; then
        echo "
        --- BEHAT PRODUCTION MODE FAILED --- "
    fi
    if [[ "IS_JEST_ERROR" -ne "0" ]]; then
        echo "
        --- JEST FAILED --- "
    fi
    exit 1
fi

##################################
# Coverage
##################################
# bin/phpcov merge --clover coverage/combined-clover.xml coverage/cov


echo "All OK"

exit 0
