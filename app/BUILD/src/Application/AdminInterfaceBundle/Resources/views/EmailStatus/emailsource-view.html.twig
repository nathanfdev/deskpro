{% extends 'AdminInterfaceBundle:Layout:fullpage-pane.html.twig' %}
{% block fullpane_content %}
	<section class="dp-paneblock dp-panelink">
		<a href="{{ ng_href('emails.ticket_accounts.emailsources') }}">
			<em><i class="fa fa-chevron-down"></i></em>
			<h3>Incoming Email</h3>
		</a>
	</section>

	<section class="dp-paneblock dp-listpane">
		<header>
			<nav class="dp-blocktabs">
				<menu dropdown>
					<button class="btn btn-default dropdown-toggle"><span><i class="fa fa-cog"></i></span> <i class="fa fa-caret-down"></i></button>
					<ul class="dropdown-menu pull-right">
						<li><a ng-click="ViewSource.startDelete()"><i class="fa fa-trash-o"></i> Delete Email</a></li>
						<li><a ng-click="ViewSource.startReprocess()"><i class="fa fa-repeat"></i> Reprocess Email</a></li>
					</ul>
				</menu>
			</nav>
			<h3>Email #{{ ng_var('ViewSource.source.id') }}</h3>
		</header>
		<table class="table">
			<tbody>
				<tr>
					<th width="140">Date</th>
					<td dp-date="ViewSource.source.date_created" format="fulltime"></td>
				</tr>
				<tr>
					<th>Status <i class="fa fa-question-circle qmark-icon" ng-click="showStatusHelp(ViewSource.source.status)" tooltip="Click for more details" tooltip-placement="right" style="cursor: pointer;"></i></th>
					<td ng-class="{'danger': ViewSource.source.status == 'error', 'warning': ViewSource.source.status == 'rejected', 'success': ViewSource.source.status == 'complete'}">
						{{ ng_var('ViewSource.source.status | uppercase') }} (<span dp-date="ViewSource.source.date_status" format="fulltime"></span>)
						<div ng-if="ViewSource.source.status == 'error'">
							{{ ng_var('ViewSource.source.error_code') }} &mdash;
							<button class="btn btn-primary btn-xs" ng-click="ViewSource.startReprocess()">Reprocess Email</button>
						</div>
					</td>
				</tr>
				<tr ng-if="ViewSource.source.object_type && ViewSource.source.object_id != 0">
					<th>Created Object</th>
					<td ng-switch="ViewSource.source.object_type">
						<div ng-switch-when="ticket">
							<div ng-if="ViewSource.ticket">
								New Ticket #{{ ng_var('ViewSource.ticket.id') }}: <a ng-href="../agent/#t:{{ ng_var('ViewSource.ticket.id') }}" target="_blank">{{ ng_var('ViewSource.ticket.subject') }}</a>
							</div>
							<div ng-if="!ViewSource.ticket">
								New Ticket #{{ ng_var('ViewSource.source.object_id') }} <em>(no longer exists)</em>
							</div>
						</div>
						<div ng-switch-when="ticket_message">
							<div ng-if="ViewSource.ticket_message">
								New Reply #{{ ng_var('ViewSource.ticket_message.id') }}
							</div>
							<div ng-if="!ViewSource.ticket_message">
								New Reply #{{ ng_var('ViewSource.source.object_id') }} <em>(no longer exists)</em>
							</div>
							<div ng-if="ViewSource.ticket">
								On Ticket #{{ ng_var('ViewSource.ticket.id') }}: <a ng-href="../agent/#t:{{ ng_var('ViewSource.ticket.id') }}" target="_blank">{{ ng_var('ViewSource.ticket.subject') }}</a>
							</div>
							<div ng-if="!ViewSource.ticket">
								<em>(Ticket no longer exists)</em>
							</div>
						</div>
						<div ng-switch-default>
							Unknown object: {{ ng_var('ViewSource.source.object_type') }} #{{ ng_var('ViewSource.source.object_id') }}
						</div>
					</td>
				</tr>
				<tr>
					<th>Account</th>
					<td>
						<a href="{{ ng_href('emails.ticket_accounts.edit', '{id: ViewSource.source.email_account.id}') }}">
							{{ ng_var('ViewSource.source.email_account.address') }}
						</a>
					</td>
				</tr>
				<tr>
					<th>From</th>
					<td>{{ ng_var('ViewSource.source.header_from') }}</td>
				</tr>
				<tr>
					<th>To</th>
					<td>{{ ng_var('ViewSource.source.header_to') }}</td>
				</tr>
				<tr>
					<th>Cc</th>
					<td>{{ ng_var('ViewSource.source.header_cc') }}</td>
				</tr>
				<tr>
					<th>Subject</th>
					<td>{{ ng_var('ViewSource.source.header_subject') }}</td>
				</tr>
				<tr>
					<th>
						<label style="line-height: 15px; font-weight: bold;">
							<input type="radio" ng-model="render_type" value="raw" style="vertical-align: middle; margin: 0 2px 0 0;" />
							Raw Source
						</label>
						<label style="line-height: 15px; font-weight: bold;">
							<input type="radio" ng-model="render_type" value="summary" style="vertical-align: middle; margin: 0 2px 0 0;" />
							Summary
						</label>
						<label style="line-height: 15px; font-weight: bold;">
							<input type="radio" ng-model="render_type" value="rendered" style="vertical-align: middle; margin: 0 2px 0 0;" />
							Rendered
						</label>
					</th>
					<td>
						<div ng-show="render_type == 'raw'">
							<textarea class="form-control" style="width: 95%; height: 300px; font-family: Monaco, Consolas, monospace;">{{ ng_var('ViewSource.source_raw') }}</textarea>
							<div style="margin-top: 2px;">
								<a class="btn btn-default btn-xs" ng-href="{{ ng_var('ViewSource.source.blob.download_url') }}" target="_blank" style="font-weight: normal;"><i class="fa fa-download" style="margin: 0;"></i> Download Email</a>
							</div>
						</div>
						<div ng-show="render_type == 'summary'">
							<textarea class="form-control" style="width: 95%; height: 300px; font-family: Monaco, Consolas, monospace;" ng-if="ViewSource.rendered.summary">{{ ng_var('ViewSource.rendered.summary') }}</textarea>
						</div>
						<div ng-show="render_type == 'rendered'">
							<div ng-if="ViewSource.rendered.html" style="margin-bottom: 10px;">
								<strong>Rendered HTML</strong><br/>
								<div style="width: 95%; max-height: 500px; overflow: auto; border: 1px solid #cccccc; padding: 8px; border-radius: 2px;" ng-bind-html="ViewSource.rendered.html"></div>
							</div>
							<div ng-if="ViewSource.rendered.text">
								<strong>Plain Text</strong><br/>
								<textarea class="form-control" style="width: 95%; height: 200px; font-family: Monaco, Consolas, monospace;">{{ ng_var('ViewSource.rendered.text') }}</textarea>
							</div>
						</div>
						<div ng-show="loading_render_type">
							<i class="flat-spinner"></i>
						</div>
					</td>
				</tr>
				<tr ng-if="ViewSource.source.log_blob">
					<th>
						Process Log
					</th>
					<td>
						<textarea class="form-control" style="width: 95%; height: 300px; font-family: Monaco, Consolas, monospace;">{{ ng_var('ViewSource.source_log') }}</textarea>
						<div style="margin-top: 2px;">
							<a class="btn btn-default btn-xs" ng-href="{{ ng_var('ViewSource.source.log_blob.download_url') }}" target="_blank"><i class="fa fa-download" style="margin: 0;"></i> Download Log File</a>
						</div>
					</td>
				</tr>
				<tr ng-if="ViewSource.source_info">
					<th>
						Status Context
					</th>
					<td>
						<textarea class="form-control" style="width: 95%; height: 180px; font-family: Monaco, Consolas, monospace;">{{ ng_var('ViewSource.source_info') }}</textarea>
					</td>
				</tr>
			</tbody>
		</table>
	</section>

	{{ ng_tpl('AdminInterfaceBundle:EmailStatus:emailsource-status-code-modal.html.twig', 'EmailStatus/emailsource-status-code-modal.html') }}
{% endblock %}
