{% extends 'AdminInterfaceBundle:Layout:fullpage-pane.html.twig' %}
{% block fullpane_content %}
	<section class="dp-paneblock dp-panelink">
		<a href="{{ ng_href('emails.ticket_accounts.sendmailqueue') }}">
			<em><i class="fa fa-chevron-down"></i></em>
			<h3>Outgoing Email Log</h3>
		</a>
	</section>

	<section class="dp-paneblock dp-listpane">
		<header>
			<nav class="dp-blocktabs">
				<menu dropdown>
					<button class="btn btn-default dropdown-toggle"><span><i class="fa fa-cog"></i></span> <i class="fa fa-caret-down"></i></button>
					<ul class="dropdown-menu pull-right">
						<li><a ng-click="ViewSource.startDelete()"><i class="fa fa-trash-o"></i> Delete Email</a></li>
						<li><a ng-click="ViewSource.startResend()"><i class="fa fa-repeat"></i> Resend email</a></li>
					</ul>
				</menu>
			</nav>
			<h3>Outgoing Email #{{ ng_var('ViewSource.sendmail.id') }}</h3>
		</header>
		<table class="table">
			<tbody>
				<tr>
					<th width="140">Ref</th>
					<td>{{ ng_var('ViewSource.sendmail.ref') }}</td>
				</tr>
				<tr>
					<th width="140">Date</th>
					<td><span am-time-ago="ViewSource.sendmail.date_created" title="{{ ng_var('ds.format(ViewSource.sendmail.date_created, "fulltime")') }}"></span></td>
				</tr>
				<tr>
					<th>Status</th>
					<td>
						{{ ng_var('ViewSource.sendmail.status') }}
						<span ng-if="ViewSource.sendmail.status == 'error' && ViewSource.sendmail.error_code">
							({{ ng_var('ViewSource.sendmail.error_code') }})
						</span>
						<div ng-if="ViewSource.sendmail.status == 'error' && ViewSource.sendmail.error_code == 'rate_limit'" style="padding: 15px; background: #FFC2B6;">
							You have exceeded the number of outgoing emails your account can send during the demo period.
							You can <a href="#/license">enter your billing details</a> to lift the limit, or you can use a
							<a href="#/emails/ticket_accounts">custom SMTP account</a> to send your email.
						</div>
					</td>
				</tr>
				<tr>
					<th>Is Sent?</th>
					<td ng-class="{'bg-danger': !ViewSource.sendmail.date_send && ViewSource.sendmail.date_status == 'error', 'bg-success': !!ViewSource.sendmail.date_sent}">
						<span ng-if="ViewSource.sendmail.date_sent">Yes &middot; <span am-time-ago="ViewSource.sendmail.date_sent" title="{{ ng_var('ViewSource.sendmail.date_sent') }}"></span></span>
						<span ng-if="!ViewSource.sendmail.date_sent">No</span>
					</td>
				</tr>
				<tr>
					<th>Attempts</th>
					<td>
						{{ ng_var('ViewSource.sendmail.exec_count') }}
						<span ng-if="ViewSource.sendmail.date_next_attempt">&middot; Next attempt: <span am-time-ago="ViewSource.sendmail.date_next_attempt" title="{{ ng_var('ViewSource.sendmail.date_next_attempt') }}"></span></span>
					</td>
				</tr>
				<tr>
					<th>From</th>
					<td>
						<div ng-if="ViewSource.sendmail.email_account">
							<a href="{{ ng_href('emails.ticket_accounts.edit', '{id: ViewSource.sendmail.email_account.id}') }}">
								{{ ng_var('ViewSource.sendmail.header_from') }}
							</a>
						</div>
						<div ng-if="!ViewSource.sendmail.email_account">
							{{ ng_var('ViewSource.sendmail.header_from') }}
						</div>
					</td>
				</tr>
				<tr>
					<th>To</th>
					<td>{{ ng_var('ViewSource.sendmail.header_to') }}</td>
				</tr>
				<tr>
					<th>Subject</th>
					<td>{{ ng_var('ViewSource.sendmail.header_subject') }}</td>
				</tr>
				<tr>
					<th>
                        <label style="line-height: 15px; font-weight: bold;">
                            <input type="radio" ng-model="render_type" value="raw" style="vertical-align: middle; margin: 0 2px 0 0;" />
                            Raw Source
                        </label>
                        <label style="line-height: 15px; font-weight: bold;">
                            <input type="radio" ng-model="render_type" value="summary" style="vertical-align: middle; margin: 0 2px 0 0;" />
                            Summary
                        </label>
                        <label style="line-height: 15px; font-weight: bold;">
                            <input type="radio" ng-model="render_type" value="rendered" style="vertical-align: middle; margin: 0 2px 0 0;" />
                            Rendered
                        </label>
					</th>
					<td>
                        <div ng-show="render_type == 'raw'">
                            <textarea class="form-control" style="width: 95%; height: 300px; font-family: Monaco, Consolas, monospace;">{{ ng_var('ViewSource.sendmail_raw') }}</textarea>
                            <div style="margin-top: 2px;">
                                <a class="btn btn-default btn-xs" ng-href="{{ ng_var('ViewSource.sendmail.raw_download_url') }}" target="_blank"><i class="fa fa-download" style="margin: 0;"></i> Download Email</a>
                            </div>
                        </div>
                        <div ng-show="render_type == 'summary'">
                            <textarea class="form-control" style="width: 95%; height: 300px; font-family: Monaco, Consolas, monospace;" ng-if="ViewSource.rendered.summary">{{ ng_var('ViewSource.rendered.summary') }}</textarea>
                        </div>
                        <div ng-show="render_type == 'rendered'">
                            <div ng-if="ViewSource.rendered.html" style="margin-bottom: 10px;">
                                <strong>Rendered HTML</strong><br/>
                                <div style="width: 95%; max-height: 500px; overflow: auto; border: 1px solid #cccccc; padding: 8px; border-radius: 2px;" ng-bind-html="ViewSource.rendered.html"></div>
                            </div>
                            <div ng-if="ViewSource.rendered.text">
                                <strong>Plain Text</strong><br/>
                                <textarea class="form-control" style="width: 95%; height: 200px; font-family: Monaco, Consolas, monospace;">{{ ng_var('ViewSource.rendered.text') }}</textarea>
                            </div>
                        </div>
                        <div ng-show="loading_render_type">
                            <i class="flat-spinner"></i>
                        </div>
					</td>
				</tr>
                <tr>
                    <th>
                        Process Log
                    </th>
                    <td>
                        <textarea class="form-control" style="width: 95%; height: 300px; font-family: Monaco, Consolas, monospace;">{{ ng_var('ViewSource.log') }}</textarea>
                        <div style="margin-top: 2px;">
                            <a class="btn btn-default btn-xs" ng-href="{{ ng_var('ViewSource.sendmail.log_download_url') }}" target="_blank"><i class="fa fa-download" style="margin: 0;"></i> Download Log</a>
                        </div>
                    </td>
                </tr>
                <tr ng-if="ViewSource.statuses">
					<th>
						Statuses
						<br/>
					</th>
					<td>
						<table class="table">
							<tr>
								<td>Title</td>
								<td>Description</td>
								<td>Date</td>
							</tr>
							<tr ng-repeat="status in ViewSource.statuses">
								<td>{{ ng_var('status.email') }}: <strong>{{ ng_var('status.event') }}</strong></td>
								<td>{{ ng_var('status.info') }}</td>
								<td>{{ ng_var('status.date_created') }}</td>
							</tr>
						</table>
					</td>
				</tr>
			</tbody>
		</table>
	</section>
{% endblock %}
