<div class="dp-layout-list">
	<div class="dp-layout-list-listpane">
		<div class="dp-pane">

			<section class="dp-paneblock dp-listpane">
				<header>
					<h3>Knowledgebase Settings</h3>
				</header>
				<article>
					<ul class="dp-item-list">
						<li dp-state-mark="portal.kb_settings">
							<a href="{{ ng_href('portal.kb_settings') }}">
								<h4>General Settings</h4>
							</a>
						</li>
					</ul>
				</article>
			</section>

			<section class="dp-paneblock dp-panelink">
				<a href="{{ ng_href('portal.kb_labels') }}">
					<em><i class="fas fa-chevron-down"></i></em>
					<h3>Knowledgebase Labels</h3>
				</a>
			</section>
			<section class="dp-paneblock dp-panelink">
				<header>
					<a href="{{ ng_href('portal.kb_custom_fields') }}">
						<em><i class="fas fa-chevron-down"></i></em>
						<h3>Knowledgebase Custom Fields</h3>
					</a>
				</header>
				<article dp-state-mark="portal.kb_custom_fields">
					<ul class="dp-item-list">
						<li>
						</li>
					</ul>
				</article>
			</section>
		</div>
	</div>
	<div class="dp-layout-list-editpane">

		<form class="form-horizontal dp-form" role="form" name="form_props" ng-submit="form_props.$valid && Ctrl.save()">
			<section class="dp-paneblock dp-listpane">
				<header>
					<h3>Knowledgebase Settings</h3>
				</header>

				<article>
					<div class="panel panel-innertable">
						<div class="form-group">
							<div class="labels-group">
								<label>
									<input type="radio" ng-model="settings.enabled" ng-value="true" />
									<h4>Enable the Knowledgebase section</h4>
									<span class="help-block" ng-show="settings.enabled">
										Enable the knowledgebase section.
									</span>
								</label>
								<label>
									<input type="radio" ng-model="settings.enabled" ng-value="false" />
									<h4>Disable the Knowledgebase section</h4>
									<span class="help-block" ng-show="!settings.enabled">
										Disable the knowledgebase section.
									</span>
								</label>
							</div>
						</div>
					</div>
				</article>
				<article ng-show="settings.enabled">
					<div class="panel panel-innertable">
						<div class="form-group">
							<label>
								<input type="checkbox" ng-model="settings.tab_enabled" />
								<h4>Enable the Knowledgebase tab in the portal tab bar</h4>
								<span class="help-block">
									<p>
										Enable the Knowledgebase tab in the navigation tab bar? When not checked, the Knowledgebase tab will not be visible
										but the Knowledgebase section will still be active (e.g., you could create your own link to the knowledgebase URL).
									</p>
									<p>
										Use the <a href="{{ ng_href('portal.portal_editor') }}">Portal Editor</a> to re-order items in the tab bar.
									</p>
								</span>
							</label>
						</div>
					</div>
					<div class="panel panel-innertable">
						<div class="form-group">
							<label>
								<input type="checkbox" ng-model="settings.subscriptions" />
								<h4>Enable Knowledgebase subscriptions</h4>
								<span class="help-block">
									<p>
										Allow users to subscribe to Knoweldgebase articles and categories.
									</p>
								</span>
							</label>
						</div>
					</div>
					<div class="panel panel-innertable">
						<div class="form-group">
							<label>
								<input type="checkbox" ng-model="settings.knowledgebase_deep_tree">
								<h4>Enable Knowledgebase deep tree category preview</h4>
								<span class="help-block">
									<p>
										In a category, in addition to each category articles, also display articles from its sub-categories.
									</p>
								</span>
							</label>
						</div>
					</div>
                    <div class="panel panel-innertable">
                        <div class="form-group">
                            <label>
                                <input type="checkbox" ng-model="settings.require_review_date">
                                <h4>Require Review Date</h4>
                                <span class="help-block">
									<p>
										Force the entry of a review date for an article.
									</p>
								</span>
                            </label>

                            <div ng-if="settings.require_review_date">
                                <div>
                                    <label>
                                        <input type="checkbox" ng-model="settings.min_review_date">
                                        <h4>Minimum review date of
                                            <input type="number" ng-model="settings.min_review_date_interval" style="width: 50px">
                                            <select class="review-date-control-select" ng-model="settings.min_review_date_unit">
                                                <option value="days">{{ phrase('agent.general.days')|capitalize }}</option>
                                                <option value="months">{{ phrase('agent.general.months')|capitalize }}</option>
                                                <option value="years">{{ phrase('agent.general.years')|capitalize }}</option>
                                            </select>
                                        </h4>
                                    </label>
                                </div>
                                <div>
                                    <label>
                                        <input type="checkbox" ng-model="settings.max_review_date">
                                        <h4>Maximum review date of
                                            <input type="number" ng-model="settings.max_review_date_interval" style="width: 50px">
                                            <select class="review-date-control-select" ng-model="settings.max_review_date_unit">
                                                <option value="days">{{ phrase('agent.general.days')|capitalize }}</option>
                                                <option value="months">{{ phrase('agent.general.months')|capitalize }}</option>
                                                <option value="years">{{ phrase('agent.general.years')|capitalize }}</option>
                                            </select>
                                        </h4>
                                    </label>
                                </div>
                                <div>
                                    <label>
                                        <input type="checkbox" ng-model="settings.default_review_date">
                                        <h4>Default review date of
                                            <input type="number" ng-model="settings.default_review_date_interval" style="width: 50px">
                                            <select class="review-date-control-select" ng-model="settings.default_review_date_unit">
                                                <option value="days">{{ phrase('agent.general.days')|capitalize }}</option>
                                                <option value="months">{{ phrase('agent.general.months')|capitalize }}</option>
                                                <option value="years">{{ phrase('agent.general.years')|capitalize }}</option>
                                            </select>
                                        </h4>
                                    </label>
                                </div>
                                <div>
                                    <label>
                                        <input type="checkbox" ng-model="settings.auto_unpublish_review">
                                        <h4>Auto-unpublish
                                            <input type="number" ng-model="settings.auto_unpublish_review_interval" style="width: 50px">
                                            <select class="review-date-control-select" ng-model="settings.auto_unpublish_review_unit">
                                                <option value="days">{{ phrase('agent.general.days')|capitalize }}</option>
                                                <option value="months">{{ phrase('agent.general.months')|capitalize }}</option>
                                                <option value="years">{{ phrase('agent.general.years')|capitalize }}</option>
                                            </select>
                                            after review date
                                        </h4>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
				</article>

				<footer>
					<div class="dp-content">
                        <div class="text-danger ng-hide" ng-show="form_errors.errors[0].message">
                            <p><strong>{{ phrase('adm.general.please_correct_errors') }}</strong></p>
                            <ul>
                                <li ng-show="form_errors.errors[0].message">{{ ng_var('form_errors.errors[0].message') }}</li>
                            </ul>
                        </div>

						<div class="dp-btn-controls" ng-hide="form_props.$attempted && form_props.$invalid">
							<div dp-hide-spinning="saving">
								<button class="btn btn-primary" dp-submit-form>{{ phrase('agent.general.save') }}</button>
							</div>
							<div dp-show-spinning="saving">
								<i class="spinner-flat"></i>
							</div>
						</div>
					</div>
				</footer>

			</section>
		</form>


	</div>
</div>

