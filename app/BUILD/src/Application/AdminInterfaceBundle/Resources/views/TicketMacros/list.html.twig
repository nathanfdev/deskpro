{% extends 'AdminInterfaceBundle:Layout:list.html.twig' %}
{% block listpane_content %}
	<section class="dp-paneblock dp-listpane">
		<header>
			<nav>
				<span class="dp-order-ctrl dropdown">
					<a class="title dropdown-toggle" data-toggle="dropdown">
						Showing:
						<span ng-show="display_filter.type == 'all'">All Macros</span>
						<span ng-show="display_filter.type == 'global'">Global Macros</span>
						<span ng-show="display_filter.type == 'agent'">Agent Macros</span>
						<i class="fa fa-caret-down"></i>
					</a>
					<ul class="dropdown-menu" style="width: 200px">
						<li class="dropdown-header">Show</li>
						<li><a ng-click="$event.preventDefault(); display_filter.type = 'all';">All Macros <i class="fa fa-check" ng-show="display_filter.type == 'all'"></i></a></li>
						<li><a ng-click="$event.preventDefault(); display_filter.type = 'global';">Global Macros <i class="fa fa-check" ng-show="display_filter.type == 'global'"></i></a></li>
						<li><a ng-click="$event.preventDefault(); display_filter.type = 'agent';">Agent Macros <i class="fa fa-check" ng-show="display_filter.type == 'agent'"></i></a></li>

						<li class="divider" ng-show="display_filter.type == 'agent'"></li>
						<li class="dropdown-header" ng-show="display_filter.type == 'agent'">Filter</li>
						<li ng-show="display_filter.type == 'agent'">
							<select ui-select2 ng-model="display_filter.agent" style="width:185px; margin-left: 8px;">
								<option value="0">All agent macros</option>
								<option ng-repeat="agent in ListCtrl.agents" value="{{ ng_var('agent.id') }}">{{ ng_var('agent.display_name') }}</option>
							</select>
						</li>
					</ul>
				</span>
				{% include 'AdminInterfaceBundle:Layout:standard-settings-menu.html.twig' %}
			</nav>
			<h3 ng-pluralize count="ListCtrl.list.length" when="{{ ng_plural_phrase('adm.ticket_macros.count_macros') }}"></h3>
		</header>
		<article>
			<p class="dp-empty-list-notice" ng-if="!ListCtrl.list.length">
				{{ phrase('adm.ticket_macros.no_macros') }}
			</p>
			<div class="dp-pane-help-box">
				You can view and manage permissions on macros here. To create and edit macros, you need to
				go to the Agent Interface.
			</div>
			<ul class="dp-item-list" ng-if="ListCtrl.list.length" dp-max-height>
				<li ng-repeat="macro in filterList" dp-state-mark="tickets.macros.edit.{{ ng_var('macro.id') }}" data-id="{{ ng_var('macro.id') }}">
					<a href="{{ ng_href('tickets.macros.edit', '{id: macro.id}') }}">
						<div class="pull-right">
							<em class="tag"style="margin-left: 6px;">
								<span ng-if="macro.is_global">Global</span>
								<span ng-if="!macro.is_global && macro.person">{{ ng_var('macro.person.display_name') }}</span>
								<span ng-if="!macro.is_global && macro.department">{{ ng_var('macro.department.title') }}</span>
							</em>
							<span class="btn btn-danger btn-xs only-icon" ng-show="delete_mode" style="margin-top: -3px;" ng-click="ListCtrl.startDelete(macro); $event.preventDefault();"><i class="far fa-trash-alt"></i></span>
						</div>
						<h4>
							<span class="title-id" title="ID">#{{ ng_var('macro.id') }}</span>
							<span class="title-text">{{ ng_var('macro.title') }}</span>
						</h4>
					</a>
				</li>
			</ul>
			{#
			<div class="dp-add-control">
				<a class="btn btn-default" href="{{ ng_href('tickets.macros.gocreate') }}" ng-class="{'active': isStateActive('.create') }"><i class="fa fa-plus"></i> {{ phrase('agent.general.add') }}</a>
			</div>
			#}
		</article>
	</section>
	{{ ng_tpl('AdminInterfaceBundle:TicketMacros:delete-modal.html.twig') }}
{% endblock %}
{% block listpane_help %}
	<header>
		<h1>Macros are pre-defined sequences of actions.</h1>
		<p>An agent can apply a macro to a ticket with a couple of clicks. Using macros to perform commonly-repeated sequences of actions helps agents work more efficiently.</p>
	</header>
	<article>
		<section>
			<p>When a macro runs, the actions it contains are applied to the ticket it is run on (or to the user associated with that ticket).
			<p>Macros can either be global (available to everyone), or limited to a specific agent. Agents can run macros from the content pane using the <strong>Macros</strong> button or the <strong>Send Reply</strong> control. They can also apply a macro as a mass action from the list pane.</p>

			<p>Agents can create macros in the Preferences area of the agent interface. They choose whether or not their macros are global. If you notice that several agents have created similar macros, it may be a good idea to create a global version that all agents can use.</p>

		</section>

		<section>
		<h2><span>FAQ</span></h2>

		<dl>
				<dt><em>Q:</em>Why do some of my agents get an error message when they try to run a global macro?</dt>
				<dd><em>A:</em>
					A macro can only run if the agent running it has permissions to do all of the actions in the macro. To fix this, you need to grant the agent running the macro the appropriate extra permissions; bear in mind that this will enable them to do the corresponding actions manually too.
				</dd>


				<dt><em>Q:</em>How can agents use macros to quickly enter commonly-repeated text, standard greetings, canned answers etc?</dt>
				<dd><em>A:</em>
					In Deskpro, the system for automatically entering text is called <strong>snippets</strong>. It is accessible from the agent interface only.
				</dd>

					<dt><em>Q:</em>How do I add a signature to a macro reply?</dt>
					<dd><em>A:</em>
					Replies created by a macro do not include the agent signatures. However, you can use the following variable to insert the signature of the agent who ran the macro: <code>{{agent_signature|raw}}</code>.
				</dd>

				<dt><em>Q:</em>Applying macros from the agent interface Reply button doesn't seem to work.</dt>
				<dd><em>A:</em>
					When you select a macro from the Macros drop down, the actions are applied instantly.
		When you select a macro from the reply button; the actions are only applied when the reply button itself is clicked.
				</dd>
	</dl>

		</section>

		<section class="related-content">
			<h2><span>Related Content</span></h2>
			<ul>

				<li><i class="fa fa-book"></i> <a href="https://support.deskpro.com/guides/topic/377" target="_blank">Macros</a></li>
				<li><i class="fa fa-file-text"></i> <a href="https://support.deskpro.com/kb/articles/185" target="_blank">Ticket assignment workflows</a></li>

			</ul>
	</section>
	</article>
{% endblock %}
