{% extends 'AdminInterfaceBundle:Layout:fullpage-pane.html.twig' %}
{% block fullpane_content %}
    <div class="form-horizontal dp-form" ng-if="Ctrl.info.next_check_desc">
        <section class="dp-paneblock dp-listpane">
            <header style="margin-bottom: 15px;">
                <h3>Next Update</h3>
            </header>

            {##################################################################################################}

            <article class="form-horizontal dp-form">
                <div class="panel panel-innertable">
                    <div class="form-group">
                        <p>
                            The system is scheduled to check for updates in {{ ng_var('Ctrl.info.next_check_desc') }}
                            <span style="color: #aaa">(<span dp-date="Ctrl.info.next_check">{{ ng_var('Ctrl.info.next_check') }}</span>)</span>
                        </p>
                    </div>
                    <div class="form-group" style="margin-top: 5px; padding-to: 15px;">
                        <p>
                            To watch the update as it progresses, open the update status viewer:
                            <br/>
                            <a ng-href="{{ ng_var('Ctrl.info.watcher_url') }}" target="_blank" class="btn btn-primary">View Update Status</a>
                        </p>
                    </div>
                </div>
            </article>
        </section>
    </div>

