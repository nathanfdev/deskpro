    <div class="form-horizontal dp-form">
        <section class="dp-paneblock dp-listpane">
            <header style="margin-bottom: 15px;">
                <h3>Schedule Update</h3>
            </header>

            {##################################################################################################}

            <article class="form-horizontal dp-form">
                <div class="panel panel-innertable">
                    <div class="form-group">
                        <p>
                            You can manually start the updater by clicking the button below. The system will check for
                            an update and automatically install it if there is one available.
                        </p>
                        <p>
                            <label><input type="checkbox" ng-model="allowManualBtn" /> I want to manually start the updater to run in </label>
                            <select ng-model="Ctrl.manualForm.delay">
                                <option value="60">1 minute</option>
                                <option value="300">5 minutes</option>
                                <option value="900">15 minutes</option>
                                <option value="1800">30 minutes</option>
                                <option value="2700">45 minutes</option>
                                <option value="3600">1 hour</option>
                                <option value="7200">2 hours</option>
                                <option value="10800">3 hours</option>
                                <option value="14400">4 hours</option>
                                <option value="18000">5 hours</option>
                                <option value="21600">6 hours</option>
                                <option value="25200">7 hours</option>
                                <option value="28800">8 hours</option>
                            </select>
                            <br/>
                            <div dp-hide-spinning="saving_manual">
                                <button ng-disabled="!allowManualBtn" class="btn btn-default" ng-click="Ctrl.doManualSchedule()">Schedule an update &rarr;</button>
                            </div>
                            <div dp-show-spinning="saving_manual">
                                <i class="spinner-flat"></i>
                            </div>
                        </p>
                    </div>
                </div>
                <div ng-show="Ctrl.didManualSet && Ctrl.info.next_check_desc" style="padding: 5px; background: #eee; margin-top: 4px; ">
                    Next check in {{ ng_var('Ctrl.info.next_check_desc') }}
                    <span style="color: #aaa">(<span dp-date="Ctrl.info.next_check">{{ ng_var('Ctrl.info.next_check') }}</span>)</span>
                </div>
            </article>
        </section>
    </div>

    <div class="form-horizontal dp-form">
        <section class="dp-paneblock dp-listpane">
            <header style="margin-bottom: 15px;">
                <h3>Update from the command line</h3>
            </header>

            {##################################################################################################}

            <article class="form-horizontal dp-form">
                <div class="panel panel-innertable">
                    <div class="form-group">
                        <p>
                            You can always run the updater yourself from the command-line by issuing the following command:
                        </p>
                        <div>
                            <input type="text" class="form-control" ng-model="Ctrl.info.cli_command" style="width: 75%; font-family: Monaco, Consolas, monospace" />
                        </div>
                        <p style="maring-top:5px;">
                            Running this will start the updater. It will check for updates and prompt you to install them if any
                            are available
                        </p>
                    </div>
                </div>
            </article>
        </section>
    </div>
{% endblock %}
