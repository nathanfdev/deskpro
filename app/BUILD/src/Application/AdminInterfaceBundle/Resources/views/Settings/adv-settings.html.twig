{% extends 'AdminInterfaceBundle:Layout:fullpage-pane.html.twig' %}
{% block fullpane_content %}
	<form class="form-horizontal dp-form" role="form" name="form_props" ng-submit="form_props.$valid && Settings.save()">
	<section class="dp-paneblock dp-listpane">
	<header>
		<h3>Advanced Settings</h3>
	</header>

	{##################################################################################################}

	<article class="form-horizontal dp-form">
		<div class="panel panel-innertable">
			<div class="alert alert-danger">
				<h3>Careful!</h3>
				<p>
					Be careful modifying settings from this page. You can seriously damage your helpdesk by changing settings
					listed here. You should only change values here on the advice of a Deskpro support agent.
				</p>
			</div>

			<div style="width: 100%; height: 600px;" ng-grid="{
				data: 'settings',
				enableCellEditOnFocus: true,
				showFilter: true,
				enableRowSelection: false,
				columnDefs: [
					{field: 'name', displayName: 'Setting', enableCellEdit: false},
					{field: 'default_value', displayName: 'Default Value', enableCellEdit: false},
					{field: 'value', displayName: 'Current Value', enableCellEdit: true}
				]
			}"></div>
		</div>
	</article>

	{##################################################################################################}

	<footer>
		<div class="dp-content">
			<div class="dp-btn-controls" ng-hide="form_props.$attempted && form_props.$invalid">
				<div dp-hide-spinning="saving">
					<button class="btn btn-primary" dp-submit-form>{{ phrase('agent.general.save') }}</button>
					<button class="btn btn-default" ng-click="TicketDepsEdit.resetForm()">{{ phrase('agent.general.reset') }}</button>
				</div>
				<div dp-show-spinning="saving">
					<i class="spinner-flat"></i>
				</div>
			</div>
		</div>
	</footer>
	</section>
	</form>
	<div dp-register-message="saved_settings">Settings saved successfully.</div>
{% endblock %}
