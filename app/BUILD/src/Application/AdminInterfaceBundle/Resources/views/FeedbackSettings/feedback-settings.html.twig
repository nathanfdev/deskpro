<div class="dp-layout-list">
	<div class="dp-layout-list-listpane">
		<div class="dp-pane">

			<section class="dp-paneblock dp-listpane">
				<header>
					<h3>Feedback Settings</h3>
				</header>
				<article>
					<ul class="dp-item-list">
						<li dp-state-mark="portal.feedback_settings">
							<a href="{{ ng_href('portal.feedback_settings') }}">
								<h4>General Settings</h4>
							</a>
						</li>
					</ul>
				</article>
			</section>

			<section class="dp-paneblock dp-panelink">
				<a href="{{ ng_href('portal.feedback_statuses') }}">
					<em><i class="fa fa-chevron-down"></i></em>
					<h3>Feedback Statuses</h3>
				</a>
			</section>

			<section class="dp-paneblock dp-panelink">
				<a href="{{ ng_href('portal.feedback_types') }}">
					<em><i class="fa fa-chevron-down"></i></em>
					<h3>Feedback Types</h3>
				</a>
			</section>
			<section class="dp-paneblock dp-panelink">
				<a href="{{ ng_href('portal.feedback_categories') }}">
					<em><i class="fa fa-chevron-down"></i></em>
					<h3>Feedback Categories</h3>
				</a>
			</section>
			<section class="dp-paneblock dp-panelink">
				<a href="{{ ng_href('portal.feedback_labels') }}">
					<em><i class="fa fa-chevron-down"></i></em>
					<h3>Feedback Labels</h3>
				</a>
			</section>
		</div>
	</div>
	<div class="dp-layout-list-editpane">

		<form class="form-horizontal dp-form" role="form" name="form_props" ng-submit="form_props.$valid && Ctrl.save()">
			<section class="dp-paneblock dp-listpane">
				<header>
					<h3>Feedback Settings</h3>
				</header>

				<article>
					<div class="panel panel-innertable">
						<div class="form-group">
							<div class="labels-group">
								<label>
									<input type="radio" ng-model="settings.enabled" ng-value="true" />
									<h4>Enable the Feedback section</h4>
								<span class="help-block" ng-show="settings.enabled">
									<p>Enable the feedback section.</p>
								</span>
								</label>
								<label>
									<input type="radio" ng-model="settings.enabled" ng-value="false" />
									<h4>Disable the Feedback section</h4>
								<span class="help-block" ng-show="!settings.enabled">
									Disable the feedback section.
								</span>
								</label>
							</div>
						</div>
					</div>
				</article>
				<article ng-show="settings.enabled">
					<div class="panel panel-innertable">
						<div class="form-group">
							<label>
								<input type="checkbox" ng-model="settings.tab_enabled" />
								<h4>Enable the Feedback tab in the portal tab bar</h4>
							<span class="help-block">
								<p>
									Enable the Feedback tab in the navigation tab bar? When not checked, the Feedback tab will not be visible
									but the Feedback section will still be active (e.g., you could create your own link to the feedback URL).
								</p>
								<p>
									Use the <a href="{{ ng_href('portal.portal_editor') }}">Portal Editor</a> to re-order items in the tab bar.
								</p>
							</span>
							</label>
						</div>
					</div>
					<div class="panel panel-innertable">
						<div class="form-group">
							<label>
								<input type="checkbox" ng-model="settings.subscriptions" />
								<h4>Enable Feedback subscriptions</h4>
							<span class="help-block">
								<p>
									Allow users to subscribe to Feedback items.
								</p>
							</span>
							</label>
						</div>
					</div>
				</article>

				<footer>
					<div class="dp-content">
						<div class="dp-btn-controls" ng-hide="form_props.$attempted && form_props.$invalid">
							<div dp-hide-spinning="saving">
								<button class="btn btn-primary" dp-submit-form>{{ phrase('agent.general.save') }}</button>
							</div>
							<div dp-show-spinning="saving">
								<i class="spinner-flat"></i>
							</div>
						</div>
					</div>
				</footer>

			</section>
		</form>

	</div>
</div>
