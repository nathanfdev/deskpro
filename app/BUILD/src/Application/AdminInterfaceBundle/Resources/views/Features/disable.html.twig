{% extends 'AdminInterfaceBundle:Layout:list-editpane.html.twig' %}
{% block editpane_content %}
    <form role="form">
        <section class="dp-paneblock dp-editpane">
            <h4>
                Disable Beta feature {{ ng_var('Features.feature.title') }}
            </h4>
            <div ng-bind-html="Features.disable_description">
            </div>
            <button class="btn btn-danger" ng-click="Features.disableFeature()">Disable Beta Feature</button>
        </section>
    </form>
{% endblock %}
