{% extends 'AdminInterfaceBundle:Layout:list.html.twig' %}

{% block listpane_content %}
    <section class="dp-paneblock dp-listpane">
        <header>
            <h3>Enable Beta feature {{ ng_var('Features.feature.title') }}</h3>
        </header>
        <article class="padd">
            <p ng-bind-html="Features.feature.enable_description"></p>
            <div class="padd">
                <button ng-show="!Features.feature.enabled" class="btn btn-success" ng-click="Features.enableFeature()">Enable Beta Feature</button>
                <div class="alert alert-warning" ng-show="Features.feature.enabled">
                    This feature is already enabled
                </div>
            </div>
        </article>
    </section>
{% endblock %}