{##################################################################################################}
{# Outgoing Account Details #}
{##################################################################################################}

<div class="form-group" ng-hide="form.incoming_type == 'gmail' || form.incoming_type == 'office365'">
	<div class="col-lg-3">
		<h3>Outgoing Email *</h3>
	</div>
	<div class="col-lg-9">

		{############}
		{# Selector #}
		{############}

		<div class="inner-group" style="padding-top: 3px;">
			<select
				ui-select2
				ng-model="form.outgoing_type"
				style="min-width: 240px"
			>
				<option value="">Select type</option>
				<option value="php_mail">Send mail using PHP mail()</option>
				<option value="smtp">SMTP</option>
				<option value="gmail">GMail or Google Apps</option>
				<option value="office365">Office365</option>
				<option value="exchange">MS Exchange</option>
			</select>
		</div>

		{############}
		{# PHP Mail #}
		{############}

		<div class="ng-hide" ng-show="form.outgoing_type == 'php_mail'">
			<div class="inner-group">
				<table width="100%" class="inner-form-table">
					<tr>
						<th width="75">PHP Mail</th>
						<td>
							Send mail through the server <code><a href="http://www.php.net/mail" target="_blank">mail()</a></code> function.
						</td>
					</tr>
					<tr>
						<th>&nbsp;</th>
						<td>
							<button class="btn btn-info" ng-click="TicketAccountsEdit.testOutgoingModal(); $event.preventDefault();"><i class="fa fa-bolt"></i> Test Account Settings</button>
						</td>
					</tr>
				</table>
			</div>
		</div>

		{############}
		{# SMTP     #}
		{############}

		<div class="ng-hide" ng-show="form.outgoing_type == 'smtp'">
			<div class="inner-group">
				<table width="100%" class="inner-form-table">
					<tr>
						<th width="75">Host</th>
						<td><input type="text" class="form-control" name="title" ng-model="form.out_smtp_account.host" style="width: 50%;" placeholder="localhost" /></td>
					</tr>
					<tr>
						<th>Port</th>
						<td><input type="text" class="form-control" name="title" ng-model="form.out_smtp_account.port" style="width: 80px;" placeholder="25" /></td>
					</tr>
					<tr>
						<th>Secure</th>
						<td>
							<label style="display: inline-block">
								<input type="checkbox" ng-model="form.out_smtp_account.secure" /> Enable secure network connection
							</label>
							<div style="display: inline-block;" ng-show="form.out_smtp_account.secure">
								<select ui-select2 ng-model="form.out_smtp_account.secure_mode" style="width: 80px;">
									<option value="ssl">SSL</option>
									<option value="tls">TLS</option>
								</select>
							</div>
						</td>
					</tr>
					<tr ng-show="form.out_smtp_account.secure">
						<th>No validation</th>
						<td>
							<label style="display: inline-block">
								<input type="checkbox" ng-model="form.out_smtp_account.disable_cert_validation" /> Disable certificate validation
							</label>
						</td>
					</tr>
					<tr>
						<th>Username</th>
						<td><input type="text" class="form-control" name="title" ng-model="form.out_smtp_account.user" style="width: 50%;" /></td>
					</tr>
					<tr>
						<th>Password</th>
						<td><input type="password" class="form-control" name="title" ng-model="form.out_smtp_account.password" style="width: 50%;" /></td>
					</tr>
					<tr>
						<th>&nbsp;</th>
						<td>
							<button class="btn btn-info" ng-click="TicketAccountsEdit.testOutgoingModal(); $event.preventDefault();"><i class="fa fa-bolt"></i> Test Account Settings</button>
						</td>
					</tr>
				</table>
			</div>
		</div>

		{############}
		{# Gmail    #}
		{############}

		<div class="ng-hide" ng-show="form.outgoing_type == 'gmail'">
			<div class="inner-group">
				<table width="100%" class="inner-form-table">
					<tr>
						<th width="100">Email Address</th>
						<td>
							<span ng-show="form.address">{{ ng_var('form.address') }}</span>
							<span ng-hide="form.address">Enter your email address above</span>
						</td>
					</tr>
					<tr ng-show="form.out_gmail_account.type === 'password'">
						<th>Password</th>
						<td><input type="password" class="form-control" name="title" ng-model="form.out_gmail_account.password" style="width: 50%;" /></td>
					</tr>
					<tr ng-show="form.out_gmail_account.type === 'oauth' && !form.out_gmail_account.token && !form.out_gmail_account.code">
						<th>&nbsp;</th>
						<td>
							<button class="btn btn-info" type="button" ng-click="TicketAccountsEdit.getCode('{{ path('gmail_access_code') }}')">
								Get Access Code
							</button>
						</td>
					</tr>
					<tr ng-if="form.out_gmail_account.type === 'oauth' && !form.out_gmail_account.token">
						<th></th>
						<td>
							<input type="text" class="form-control" style="width: 50%;" ng-model="form.out_gmail_account.code" placeholder="Access Code" />
						</td>
					</tr>
					<tr ng-show="form.out_gmail_account.type === 'oauth' && !form.out_gmail_account.token && form.out_gmail_account.code">
						<th>&nbsp;</th>
						<td>
							<input type="hidden" ng-model="form.out_gmail_account.token" />
							<input type="hidden" ng-model="form.out_gmail_account.refreshToken" />
							<button class="btn btn-info" type="button" ng-click="TicketAccountsEdit.getAccessToken('{{ path('gmail_token') }}', 'out')">
								Get Access Token
							</button>
						</td>
					</tr>
					<tr ng-show="form.out_gmail_account.type === 'oauth' && form.out_gmail_account.token">
						<th>&nbsp;</th>
						<td>
							<button class="btn btn-danger" type="button" ng-click="form.out_gmail_account.token = null">
								Reset Access Token
							</button>
						</td>
					</tr>
					<tr>
						<th>&nbsp;</th>
						<td ng-show="form.out_gmail_account.type === 'oauth'">
							<button class="btn btn-warning" type="button" ng-click="form.out_gmail_account.type = 'password'">
								Use password instead
							</button>
						</td>
						<td ng-show="form.out_gmail_account.type === 'password'">
							<button class="btn btn-warning" type="button" ng-click="form.out_gmail_account.type = 'oauth'">
								Use OAuth instead
							</button>
						</td>
					</tr>
					<tr ng-show="form.out_gmail_account.type === 'password' || form.out_gmail_account.token">
						<th>&nbsp;</th>
						<td>
							<button class="btn btn-info" type="button" ng-click="TicketAccountsEdit.testOutgoingModal()">
								<i class="fa fa-bolt"></i> Test Account Settings
							</button>
						</td>
					</tr>
				</table>
			</div>
		</div>

		{##############}
		{# Office 365 #}
		{##############}

		<div class="ng-hide" ng-show="form.outgoing_type == 'office365'">
			<div class="inner-group">
				<table width="100%" class="inner-form-table">
					<tr>
						<th width="100">Email Address</th>
						<td>
							<span ng-show="form.address">{{ ng_var('form.address') }}</span>
							<span ng-hide="form.address">Enter your email address above</span>
						</td>
					</tr>
					<tr>
						<th>Password</th>
						<td><input type="password" class="form-control" name="title" ng-model="form.out_office365_account.password" style="width: 50%;" /></td>
					</tr>
					<tr>
						<th>&nbsp;</th>
						<td>
							<button class="btn btn-info" ng-click="TicketAccountsEdit.testOutgoingModal(); $event.preventDefault();"><i class="fa fa-bolt"></i> Test Account Settings</button>
						</td>
					</tr>
				</table>
			</div>
		</div>

		{############}
		{# Exchange #}
		{############}

		<div class="ng-hide" ng-show="form.outgoing_type == 'exchange'">
			<div class="inner-group">
				<table width="100%" class="inner-form-table">
					<tr>
						<th width="75">Host</th>
						<td>
							https://<input type="text" class="form-control" name="host" ng-model="form.out_exchange_account.host" style="display: inline-block; width: 50%;" />
							<br/>
							<span class="help-block">
								Deskpro communicates with Exchange through <a href="http://msdn.microsoft.com/en-us/library/office/dd877045%28v=exchg.140%29.aspx" target="_blank">Exchange Web Services</a>. Make
								sure EWS is configured and your firewall is not blocking connections.
							</span>
						</td>
					</tr>
					<tr>
						<th>Username</th>
						<td><input type="text" class="form-control" name="title" ng-model="form.out_exchange_account.user" style="width: 50%;" /></td>
					</tr>
					<tr>
						<th>Password</th>
						<td><input type="password" class="form-control" name="title" ng-model="form.out_exchange_account.password" style="width: 50%;" /></td>
					</tr>
					<tr>
						<th>&nbsp;</th>
						<td>
							<button class="btn btn-info" ng-click="TicketAccountsEdit.testOutgoingModal(); $event.preventDefault();"><i class="fa fa-bolt"></i> Test Account Settings</button>
						</td>
					</tr>
				</table>
			</div>
		</div>
	</div>
</div>
