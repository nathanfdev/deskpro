<div class="form-group" ng-if="form.account_type != 'outgoing'">
	<div class="col-lg-3">
		&nbsp;
	</div>
	<div class="col-lg-9">
		<div class="inner-group" style="margin-left: 23px; margin-top: 15px;">
			<a style="cursor: pointer" ng-click="show_adv = true" ng-show="!show_adv">Advanced Options &downarrow;</a>
			<a style="cursor: pointer" ng-click="show_adv = false" ng-show="show_adv">Advanced Options &uparrow;</a>
			<div ng-show="show_adv" style="margin-top: 5px;">
				<label>
					<input type="checkbox"  ng-model="form.encryption_enabled" />
					Enable Encryption and Signing (S/MIME)
				</label>
				<span class="help-block" ng-hide="form.encryption_enabled">
					<span>Upload a private key and certificate to process encrypted and signed emails.</span>
				</span>
				<div ng-show="form.encryption_enabled">
					<a href="javascript:;" class="file-upload-wrapper">
						<input type="file" ng-file-select="TicketAccountsEdit.onFileSelect($files, 'certificate')" accept="application/pkix-cert" />
						Upload Certificate
					</a><br />
					{{  ng_var('form.cert_file') }}
					{{  ng_var('form.certificate') }}
					<span ng-show="form.cert_file">
						<a ng-click="TicketAccountsEdit.deleteCertificate()">Delete</a>
					</span>
					<br />
					<a href="javascript:;" class="file-upload-wrapper">
						<input type="file" ng-file-select="TicketAccountsEdit.onFileSelect($files, 'key')" accept="application/x-pem-file" />
						Upload Key
					</a><br />
					{{  ng_var('form.key_file') }}
					<span ng-show="form.key_file">
						<a ng-click="TicketAccountsEdit.deleteKey()">Delete</a>
					</span><br />
					<span class="help-block">
						Your private key pass phrase (optional)
					</span>
					<input type="password" class="form-control" name="key_pass_phrase" ng-model="form.key_pass_phrase" style="width: 50%;" />
				</div>
			</div>
		</div>
	</div>
</div>
