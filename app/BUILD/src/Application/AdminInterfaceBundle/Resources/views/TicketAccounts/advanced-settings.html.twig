{% extends 'AdminInterfaceBundle:Layout:fullpage-pane.html.twig' %}
{% block fullpane_content %}
	<section class="dp-paneblock dp-panelink">
		<a href="{{ ng_href('emails.ticket_accounts') }}">
			<em><i class="fa fa-chevron-down"></i></em>
			<h3>{{ phrase('adm.ticket_accounts.email_accounts') }}</h3>
		</a>
	</section>

	<section class="dp-paneblock dp-listpane">
		<header>
			<h3>{{ phrase('adm.ticket_accounts.advanced_settings') }}</h3>
		</header>
        <article class="form-horizontal dp-form">
			<div class="row">
				<div class="col-lg-10">
					<div class="panel panel-innertable">
						<div class="inner-group">
							<label>
								<h4>
									Maximum collective size of attachments in <em>outgoing</em> emails sent by DeskPRO.
								</h4>
							</label>
							<div>
								<dp-filesize-with-unit ng-model="settings.sendemail_attach_maxsize"></dp-filesize-with-unit>
								<span class="help-block">
									If an email message contains attachments
									that collectively go over this limit, DeskPRO will insert <em>links</em> to the attachments instead of
									attaching them directly to the email message.
								</span>
								<span class="help-block">
									Note that your mail server may impose certain limits, and target mailservers used by your users may
									also have their own limits. Since you cannot control those limits, it's suggested that you leave
									the value here quite low (generally below 15MB).
								</span>
							</div>
						</div>
					</div>
				</div>
			</div>
            <div class="row">

                <div class="col-lg-6">
                    <div class="panel panel-innertable">
                        <div class="panel-heading">
                            <h3>
                                <span>{{ phrase('adm.ticket_accounts.user_attachments') }}</span>
                            </h3>
                        </div>
                        <div class="inner-group">
                            <label>
                                <h4>
                                    <input type="radio" name="attach_user_exts_limitmode" value="any" ng-model="attach_user_exts_limitmode" />
                                    {{ phrase('adm.ticket_accounts.allow_all') }}
                                </h4>
                            </label>
                            <br/>
                            <label>
                                <h4>
                                    <input type="radio" name="attach_user_exts_limitmode" value="allow" ng-model="attach_user_exts_limitmode" />
                                    {{ phrase('adm.ticket_accounts.allow_only') }}
                                </h4>
                            </label>
                            <div ng-show="attach_user_exts_limitmode == 'allow'">
                                <input type="text" ui-select2="{multiple: true, simple_tags: true, tags: [], tokenSeparators: [',', ' ']}" ng-model="settings.attach_user_must_exts" style="width: 350px;" placeholder="Example: zip, pdf" />
                            </div>
                            <br />
                            <label>
                                <h4>
                                    <input type="radio" name="attach_user_exts_limitmode" value="disallow" ng-model="attach_user_exts_limitmode" />
                                    {{ phrase('adm.ticket_accounts.disallow_only') }}
                                </h4>
                            </label>
                            <div ng-show="attach_user_exts_limitmode == 'disallow'">
                                <input type="text" ui-select2="{multiple: true, simple_tags: true, tags: [], tokenSeparators: [',', ' ']}" ng-model="settings.attach_user_not_exts" style="width: 350px;" placeholder="Example: exe, msi" />
                            </div>
                        </div>
                        <div class="inner-group">
                            <label>
                                <h4>
                                    {{ phrase('adm.ticket_accounts.max_file_size') }}
                                </h4>
                            </label>
                            <div>
                                <dp-filesize-with-unit ng-model="settings.attach_user_maxsize"></dp-filesize-with-unit>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="panel panel-innertable">
                        <div class="panel-heading">
                            <h3>
                                <span>{{ phrase('adm.ticket_accounts.agent_attachments') }}</span>
                            </h3>
                        </div>
                        <div class="inner-group">
                            <label>
                                <h4>
                                    <input type="radio" name="attach_agent_exts_limitmode" value="any" ng-model="attach_agent_exts_limitmode" />
                                    {{ phrase('adm.ticket_accounts.allow_all') }}
                                </h4>
                            </label>
                            <br/>
                            <label>
                                <h4>
                                    <input type="radio" name="attach_agent_exts_limitmode" value="allow" ng-model="attach_agent_exts_limitmode" />
                                    {{ phrase('adm.ticket_accounts.allow_only') }}
                                </h4>
                            </label>
                            <div ng-show="attach_agent_exts_limitmode == 'allow'">
                                <input type="text" ui-select2="{multiple: true, simple_tags: true, tags: [], tokenSeparators: [',', ' ']}" ng-model="settings.attach_agent_must_exts" style="width: 350px;" placeholder="Example: zip, pdf" />
                            </div>
                            <br />
                            <label>
                                <h4>
                                    <input type="radio" name="attach_agent_exts_limitmode" value="disallow" ng-model="attach_agent_exts_limitmode" />
                                    {{ phrase('adm.ticket_accounts.disallow_only') }}
                                </h4>
                            </label>
                            <div ng-show="attach_agent_exts_limitmode == 'disallow'">
                                <input type="text" ui-select2="{multiple: true, simple_tags: true, tags: [], tokenSeparators: [',', ' ']}" ng-model="settings.attach_agent_not_exts" style="width: 350px;" placeholder="Example: exe, msi" />
                            </div>
                        </div>
                        <div class="inner-group">
                            <label>
                                <h4>
                                    {{ phrase('adm.ticket_accounts.max_file_size') }}
                                </h4>
                            </label>
                            <div>
                                <dp-filesize-with-unit ng-model="settings.attach_agent_maxsize"></dp-filesize-with-unit>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <div class="row">
                <div class="col-lg-10">
                    <div class="panel panel-innertable">
                        <div class="inner-group">
                            <label>
                                <h4>
                                    <label>
                                        <input type="checkbox" ng-model="settings.core_tickets_enable_dupe_checking">
                                        Enable duplicate detection
                                    </label>
                                </h4>
                            </label>
                            <div>
								<span class="help-block">
									When enabled, DeskPRO will reject exact duplicate email messages from the same user that were submitted in a short period of time.
                                    <i class="fa fa-question-circle qmark-icon" tooltip="Example: If a user sends an email with two of your accounts in the To or CC lines (e.g., To: sales@example.com and support@example.com), then two separate email messages will arrive into DeskPRO. Without duplicate detection, this would cause two separate tickets to be created."></i>
								</span>
                                <span class="help-block">
                                    Rejected email is always logged in full to the <a href="{{ ng_href('emails.ticket_accounts.emailsources') }}">Incoming Email Log</a>.
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-10">
                    <div class="panel panel-innertable">
                      <div class="inner-group">
                        <label>
                          <h4>
                            <label>
                              <input type="checkbox" ng-model="settings.core_tickets_gateway_enable_subject_match">
                              Enable subject matching
                            </label>
                          </h4>
                        </label>
                        <div>
                          <span class="help-block">
                            DeskPRO sometimes uses the subject to route incoming email replies to their appropriate tickets.
                            For example, if a user sends two emails with the same subject, DeskPRO will guess that both messages
                            are related, and add the second email as a reply to the first ticket.
                          </span>
                          <span class="help-block">
                            DeskPRO has an advanced email processing algorithm and subject matching is just one part.
                            Many other techniques are used to make sure email replies are routed to the correct ticket.
                            However, disabling this setting <em>may</em> result in multiple tickets being created in some
                            cases, such as when the user removes tracking codes from messages (e.g., if they do not quote the original message).
                          </span>
                        </div>
                      </div>

                      <div style="margin-left: 45px;" ng-show="settings.core_tickets_gateway_enable_subject_match">
                        <div class="inner-group">
                          <label>
                            <h4>
                              <label>
                                <input type="checkbox" ng-model="settings.core_tickets_enable_same_account_subject_matching">
                                Only match subjects on the same email account
                              </label>
                            </h4>
                          </label>
                          <div>
                            <span class="help-block">
                              Enable this option to only have subject matching operate on messages on the same account.
                              For example, if the user sends two emails with the same subject to both "sales@example.com" and "support@example.com",
                              two tickets will be created because they were sent to two different accounts.
                            </span>
                          </div>
                        </div>

                        <div class="inner-group">
                          <label>
                            <h4>
                              <label>
                                <input type="checkbox" ng-model="settings.core_tickets_enable_exact_subject_matching">
                                Enable subject matching on ALL email messages
                              </label>
                            </h4>
                          </label>
                          <div>
                            <span class="help-block">
                              Usually, this subject-matching algorithm is only run on subjects that contain a reply prefix (like "RE:").
                              This means that replies (emails with "RE:") are added to existing tickets,
                              but new email conversations (emails without "RE:") are treated as new tickets.
                              </span>
                              <span class="help-block">
                                Enable this option if you want subject matching to run on ALL email messages, even those that do not
                                have the "RE:" prefix.
                                <i class="fa fa-question-circle qmark-icon" tooltip="Example: If the user sends in a new email, and then a day later sends in another new email with the same subject, then it would be added as a ticket reply. The only way for a new ticket to be created is if it has a different subject, or the existing ticket in DeskPRO is marked as resolved."></i>
                              </span>
                          </div>
                        </div>
                      </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-10">
                    <div class="panel panel-innertable">
                        <div class="inner-group">
                            <label>
                                <h4>
                                    <label>
                                        <input type="checkbox" ng-model="settings.core_tickets_enable_email_preview">
                                        {{ phrase('admin.ticket_accounts.email_preview') }}
                                    </label>
                                </h4>
                            </label>
                            <div>
								<span class="help-block">
									{{ phrase('admin.ticket_accounts.email_preview_help') }}
								</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-10">
                    <div class="panel panel-innertable">
                        <div class="panel-heading">
                            <h3>
                                <span>{{ phrase('adm.ticket_accounts.spf_and_dkim') }}</span>
                            </h3>
                        </div>
                        <div class="inner-group">
                            <span class="help-block">{{ phrase('adm.ticket_accounts.spf_and_dkim_help') }}</span>
                            <label>
                                <h4>
                                    <label>
                                        <input type="checkbox" ng-model="settings.core_tickets_reject_fail_spf">
                                        {{ phrase('adm.ticket_accounts.spf_level') }}
                                        <select ui-select2 ng-model="settings.core_tickets_reject_spf_level" style="width:185px; margin-left: 8px;" ng-show="settings.core_tickets_reject_fail_spf">
                                            <option value="hardfail">Fail</option>
                                            <option value="hardfail,softfail">Hard fail and Soft fail</option>
                                        </select>
                                    </label>
                                </h4>
                            </label>
                        </div>

                        <div class="inner-group">
                            <label>
                                <h4>
                                    <label>
                                        <input type="checkbox" ng-model="settings.core_tickets_reject_fail_dkim">
                                        {{ phrase('adm.ticket_accounts.dkim_level') }}
                                        <select ui-select2 ng-model="settings.core_tickets_reject_dkim_level" style="width:185px; margin-left: 8px;" ng-show="settings.core_tickets_reject_fail_dkim">
                                            <option value="fail">Fail</option>
                                            <option value="fail,discard">Fail and Discard</option>
                                        </select>
                                    </label>
                                </h4>
                            </label>
                        </div>
                    </div>
                </div>
            </div>

        </article>

        <footer>
            <div class="dp-content">
                <div class="dp-btn-controls" ng-hide="form_props.$attempted && form_props.$invalid">
                    <div dp-hide-spinning="saving">
                        <button class="btn btn-primary" ng-click="Settings.save()">{{ phrase('agent.general.save') }}</button>
                    </div>
                    <div dp-show-spinning="saving">
                        <i class="spinner-flat"></i>
                    </div>
                </div>
            </div>
        </footer>

	</section>

    <div dp-register-message="saved_settings">{{ phrase('adm.ticket_accounts.saved') }}</div>
{% endblock %}
