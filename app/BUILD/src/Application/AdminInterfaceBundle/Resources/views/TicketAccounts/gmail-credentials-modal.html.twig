<div>
    <div class="modal-header">
        <button type="button" class="close" ng-click="dismiss()">&times;</button>
        <h4 class="modal-title">Gmail OAuth credentials</h4>
    </div>
    <div class="modal-body">
        <div>
            <h5>Before you can use Oauth with Gmail you must create an API key for your organisation.
                [<a href="https://support.deskpro.com/kb/articles/725" target="_blank">Click here for instructions</a>].
            </h5>

            <form ng-submit="submit()" class="l-margin">
                <div class="form-group">
                    <label for="gmail_oauth_client_id">Client ID:</label>
                    <input id="gmail_oauth_client_id" type="text" class="form-control" ng-model="form.client_id">
                </div>

                <div class="form-group">
                    <label for="gmail_oauth_secret">Secret:</label>
                    <input id="gmail_oauth_secret" type="text" class="form-control" ng-model="form.client_secret">
                </div>

            </form>
        </div>
    </div>
    <div class="modal-footer">
        <div>
            <button class="btn btn-success" ng-click="submit()">Save</button>
            <button class="btn btn-default" ng-click="dismiss()">Cancel</button>
        </div>
    </div>
</div>
