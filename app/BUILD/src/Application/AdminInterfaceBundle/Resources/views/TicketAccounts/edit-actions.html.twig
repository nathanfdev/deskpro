<div class="form-group" ng-if="form.account_type != 'outgoing'">
	<div class="col-md-3">
		<h3>New Ticket Trigger</h3>
	</div>
	<div class="col-md-9">
		<div class="alert alert-danger" ng-if="!TicketAccountsEdit.trigger.is_enabled && !TicketAccountsEdit.trigger.emailaccount_triggers_enabled">
			<p>
				Warning: Email account triggers are disabled from
                {% set href = ng_href('tickets.triggers', {type: 'newticket'}) %}
				<a href="{{ href }}">
					New Ticket Triggers
				</a>
			</p>
		</div>
		<div class="dp-ob-set">
			<div class="dp-ob-setrow">
				<header>
					When a user submits a new ticket by emailing this address:
				</header>
				<article>
					<dp-option-builder types-def="TicketAccountsEdit.actionsTypeDef" save-target="actions_form" options="{tag_first: '', tag_after: 'then', fixedExpanded: ['SetBrand', 'SetDepartment', 'SendUserNewEmail'], fixOn: ['SetBrand', 'SetDepartment'] }" option-types="actionOptionTypes">
						<add-btn-label>Action</add-btn-label>
					</dp-option-builder>
				</article>
			</div>
		</div>
	</div>
</div>
