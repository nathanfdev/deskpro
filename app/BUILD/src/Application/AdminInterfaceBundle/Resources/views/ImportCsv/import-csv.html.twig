{% extends 'AdminInterfaceBundle:Layout:fullpage-pane.html.twig' %}
{% block fullpane_content %}
	<section class="dp-paneblock dp-listpane">
		<header>
			<h3>Import CSV File</h3>
		</header>

		{##################################################################################################}

		<article class="padd">

			<div ng-show="!processStarted">
				<p> You can import user data in CSV format.</p>
				<p>
					The exact format of the CSV file does not matter. You will map CSV columns to Deskpro fields in the next step.
				</p>
				<p> Each user must have a primary email address to be imported. If the email address matches an existing user record, no data will be imported for that user.</p>
				<p> See <a href="https://support.deskpro.com/guides/topic/332" target="_blank">more details about supported import fields and CSV file format</a>.
				</p>
				<br />
				<form id="fileupload"
					  method="POST"
					  enctype="multipart/form-data"
					  file-upload="fileUploadOptions"
					  action="{{ ng_var('fileUploadOptions.url') }}">

					<div class="fileinput-button btn btn-success btn-lg {{ ng_var('fileUploadOptions.disabled && "disabled"') }}" ng-show="!active() && !fileSelected">
						<span><i class="fa fa-upload"></i> Select CSV File</span>
						<input type="file" name="file">
					</div>

					<!-- 'queue=[];' is workaround due to strange behavior of uploader in case of single file instead of multiple-->

                    <br />

                    <div class="form-group" ng-show="!active() && fileSelected">
                        <label>
                            Field Delimiter
                            <select ui-select2 ng-model="delimeter" name="options[delimeter]" style="min-width: 100px;">
                                <option value="comma" selected>Comma</option>
                                <option value="semicolon">Semicolon</option>
                            </select>
                        </label>
                    </div>

                    <div class="form-group" ng-show="!active() && fileSelected">
                        <label>
                            Field Enclosure
                            <select ui-select2 ng-model="enclosure" name="options[enclosure]" style="min-width: 100px;">
                                <option value="none" selected>None</option>
                                <option value="quotes">Quotes</option>
                            </select>
                        </label>
                    </div>

                    <div class="pull-left" ng-show="!active() && fileSelected">
						<button type="button" class="btn btn-success btn-lg" ng-click="submit();queue=[];">
							<span>Prepare File &rarr;</span>
						</button>
					</div>

					<div class="pull-left file-upload-cancel" ng-show="!active() && fileSelected">
						or <a href="#" class="file-upload-cancel" ng-click="$event.preventDefault();">cancel</a>
					</div>

					<div class="clearfix"></div>

					<div class="file-upload-progress-block" ng-show="active() && fileSelected">
						<div class="progress progress-striped active" file-upload-progress="progress()">
							<div class="progress-bar progress-bar-success"
								 ng-style="{width: num + '%'}"></div>
						</div>
					</div>
				</form>
			</div>

			<article class="padd" ng-if="importStarted">
				<div class="well success-message">
					Your CSV import request has been started. The records will be imported in the background even if you
					navigate away from this page.
					<br><br>
					The current status will be updated here periodically:
				</div>
			</article>

			<div class="well danger-message upload-message" ng-if="importErrors.no_move">
				<strong>{{ phrase('admin.server.failed') }}</strong><br/>
				There was a problem uploading the file. Please refresh the page and try again.
			</div>

			<div class="well danger-message upload-message" ng-if="importErrors.no_email">
				<strong>{{ phrase('admin.server.failed') }}</strong><br/>
				You must select a field that maps to the primary email.
			</div>

			<div dp-show-spinning="saving">
				<br><i class="spinner-flat"></i>
			</div>

			<div ng-if="fileUploadResults && !fileUploadResults.upload_failed && !importStarted" dp-hide-spinning="saving">
				<table class="table">
					<thead>
						<tr>
							<th>
								Column Name
							</th>
							<th>
								Example Data
							</th>
							<th>
								Mapping Field
							</th>
						</tr>
					</thead>
					<tbody>
						<tr ng-repeat="column_title in fileUploadResults.columns track by $index">
							<td class="alt dp-id-col">
								{{ ng_var('column_title') }}
							</td>
							<td  class="alt dp-id-col">
								{{ ng_var('fileUploadResults.examples[$index]') }}
							</td>
							<td>
								<select
									ui-select2
									ng-model="importSettings.fieldMappings[$index]"
									style="min-width: 240px"
									class="no-search"
									ng-change="Ctrl.selectMapping($index, importSettings.fieldMappings[$index])"
								>
									<option value="">Do Not Map</option>
									<optgroup label="Basic Information">
										<option value="first_name">First Name</option>
										<option value="last_name">Last Name</option>
										<option value="name">Name</option>
										<option value="title_prefix">Title (Mr., Mrs., etc.)</option>
										<option value="primary_email">Primary Email</option>
										<option value="secondary_email">Secondary Email</option>
										<option value="password">Password</option>
										<option value="organization">Organization</option>
										<option value="organization_position">Organization Position</option>
										<option value="language">Language</option>
									</optgroup>
									<optgroup label="Contact Details">
										<option value="phone">Phone Number</option>
										<option value="website">Website URL</option>
										<option value="im">IM</option>
										<option value="twitter">Twitter</option>
										<option value="linkedin">LinkedIn</option>
										<option value="facebook">Facebook</option>
										<option value="address1">Address Line 1</option>
										<option value="address2">Address Line 2</option>
										<option value="city">City</option>
										<option value="state">State</option>
										<option value="zip">Post Code</option>
										<option value="country">Country</option>
									</optgroup>
									<optgroup label="Custom Fields">
										<option ng-repeat="field in fileUploadResults.custom_fields"
												ng-value="'custom_' + field.id">
											{{ ng_var('field.title') }}
										</option>
										<option value="new_custom">New Custom Field</option>
									</optgroup>
								</select>
								<span ng-if="importSettings.showExtraMappings.phone[$index]">
									<select
										ui-select2
										ng-model="importSettings.additionalMappings[$index].type"
										style="min-width: 120px"
										class="no-search"
									>
										<option value="phone">Phone</option>
										<option value="mobile">Mobile</option>
										<option value="fax">Fax</option>
									</select>
									<input type="text" ng-model="importSettings.additionalMappings[$index].label"
										   placeholder="Label">
								</span>
								<span ng-if="importSettings.showExtraMappings.website[$index]">
									<input type="text" ng-model="importSettings.additionalMappings[$index].label"
										   placeholder="Label">
								</span>
								<span ng-if="importSettings.showExtraMappings.im[$index]">
									<select
										ui-select2
										ng-model="importSettings.additionalMappings[$index].type"
										style="min-width: 120px"
										class="no-search"
									>
										<option value="aim">AIM</option>
										<option value="msn">MSN</option>
										<option value="yim">YIM</option>
										<option value="icq">ICQ</option>
										<option value="skype">Skype</option>
										<option value="gtalk">GTalk</option>
										<option value="other">Other</option>
									</select>
									<input type="text" ng-model="importSettings.additionalMappings[$index].label"
										   placeholder="Label">
								</span>
								<span ng-if="importSettings.showExtraMappings.twitter[$index]">
									<input type="text" ng-model="importSettings.additionalMappings[$index].label"
										placeholder="Label">
								</span>
								<span ng-if="importSettings.showExtraMappings.linkedin[$index]">
									<input type="text" ng-model="importSettings.additionalMappings[$index].label"
										   placeholder="Label">
								</span>
								<span ng-if="importSettings.showExtraMappings.facebook[$index]">
									<input type="text" ng-model="importSettings.additionalMappings[$index].label"
											placeholder="Label">
								</span>
								<span ng-if="importSettings.showExtraMappings.address1[$index]">
									<input type="text" ng-model="importSettings.additionalMappings[$index].label"
											placeholder="Label">
								</span>
								<span ng-if="importSettings.showExtraMappings.address2[$index]">
									<input type="text" ng-model="importSettings.additionalMappings[$index].label"
											placeholder="Label">
								</span>
								<span ng-if="importSettings.showExtraMappings.city[$index]">
									<input type="text" ng-model="importSettings.additionalMappings[$index].label"
											placeholder="Label">
								</span>
								<span ng-if="importSettings.showExtraMappings.state[$index]">
									<input type="text" ng-model="importSettings.additionalMappings[$index].label"
											placeholder="Label">
								</span>
								<span ng-if="importSettings.showExtraMappings.post_code[$index]">
									<input type="text" ng-model="importSettings.additionalMappings[$index].label"
											placeholder="Label">
								</span>
								<span ng-if="importSettings.showExtraMappings.country[$index]">
									<input type="text" ng-model="importSettings.additionalMappings[$index].label"
											placeholder="Label">
								</span>
								<span ng-if="importSettings.showExtraMappings.new_custom[$index]">
									<input type="text" ng-model="importSettings.additionalMappings[$index].title"
											placeholder="Title">
									{{ ng_var('importSettings.additionalMappings[$index].handler_class') }}
									<select
										ui-select2
										ng-model="importSettings.additionalMappings[$index].handler_class"
										style="min-width: 120px"
										class="no-search"
									>
										<option ng-value="text">
											Text
										</option>
										<option value="textarea">
											Textarea
										</option>
										<option value="choice">
											Choice
										</option>
										<option value="date">
											Date
										</option>
									</select>
								</span>
							</td>
						</tr>
					</tbody>
				</table>
				<div class="clearfix"></div>
				<div class="inner-group">
					<label style="font-weight: normal; display: block;">
						<input type="radio" ng-model="importSettings.skipFirst" value="1">
						Skip the first row <br>
						This should be selected if the "column name" values above contain labels rather than
						actual data.
					</label>
					<label style="font-weight: normal; display: block;">
						<input type="radio" ng-model="importSettings.skipFirst" value="0">
						Import the first row <br>
						This should be selected if the "column name" values above contain actual data.
					</label>
				</div>

				<div class="inner-group">
					<label style="font-weight: normal; display: block;">
						When a user from your CSV already exists in Deskpro:
						<select
								ui-select2
								ng-model="importSettings.updateIfExists"
								class="no-search"
								>
							<option value="1">Update the user with information from the CSV file</option>
							<option value="">Skip</option>
						</select>
					</label>
				</div>

				<div class="inner-group">
					<label><input type="checkbox" ng-model="importSettings.welcomeEmail" /> Send welcome email to every new user</label>
				</div>
				<div class="clearfix"></div>
				<button type="button" class="btn btn-success" ng-click="Ctrl.startImport()">
					<span>Click here to start import</span>
				</button>
			</div>

			<div class="well danger-message upload-message"
				 ng-if="fileUploadResults && fileUploadResults.upload_failed && fileUploadResults.error == 'no_file'">
				<strong>{{ phrase('admin.server.failed') }}</strong><br/>
				No file was provided; please re-upload the file.
			</div>

			<div class="well danger-message upload-message"
				 ng-if="fileUploadResults && fileUploadResults.upload_failed && fileUploadResults.error == 'no_move'">
				<strong>{{ phrase('admin.server.failed') }}</strong><br/>
				Problem with file upload; please check write permissions.
			</div>

			<div class="well danger-message upload-message"
				 ng-if="fileUploadResults && fileUploadResults.upload_failed && fileUploadResults.error == 'not_csv'">
				<strong>{{ phrase('admin.server.failed') }}</strong><br/>
				The uploaded file wasn't in CSV format. Please check that the file is formatted as comma separated values.

			</div>
			<div class="well danger-message upload-message"
				 ng-if="fileUploadResults && fileUploadResults.upload_failed && fileUploadResults.error == 'mailformed_data'">
				<strong>{{ phrase('admin.server.failed') }}</strong><br/>
				The uploaded file has mailformed data. Check the file's encoding.

			</div>

            <br />
            <span ng-show="!importStarted && !disabledOnDemo">Last import state: </span>
			<span ng-show="disabledOnDemo">Disabled in trial version</span>

            <span dp-status-update="/import_csv_status"
                status-update-conditions="importStarted"
                status-update-default-message="Checking status..."
                status-update-completed-growl-message="CSV Import finished"
                status-update-interval="8000"
                status-update-immediate="true"
                style="font-style:italic;">
            </span>
            <span ng-if="log">[<a href="{{ ng_var('log') }}" target="_blank">Error log</a>]</span>

		</article>

	</section>

    <section class="dp-paneblock dp-listpane">
        <header>
            <h3>Import Logs</h3>
        </header>

        <article class="padd">
            <table class="table table-condensed">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Filename</th>
                        <th>Imported Items</th>
                        <th>Skipped Items</th>
                        <th>Time Taken</th>
                        <th>Undo</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="log in logs">
                        <td>{{ ng_var('log.date | amDateFormat:"MMM D, YYYY @ HH:mm"') }}</td>
                        <td>{{ ng_var('log.data.file') }}</td>
                        <td>{{ ng_var('log.data.imported') }}</td>
                        <td>{{ ng_var('log.data.skipped') }}</td>
                        <td>{{ ng_var('log.time') }}</td>
                        <td>
                            <a ng-click="Ctrl.startDeleteUsers(log.name)"
                               style="cursor: pointer;"
                               ng-if="'waiting' != log.deletion_status"
                                    >
                                {{ phrase('adm.users_import.delete_users_link') }}
                            </a>
                            &nbsp;
                            <i class="fa fa-check text-success"
                               ng-if="'complete' == log.deletion_status"
                                    ></i>
                            <i class="fa fa-spinner fa-spin"
                               ng-if="'waiting' == log.deletion_status"
                                    ></i>
                            <i class="fa fa-times-circle text-danger"
                               ng-if="'error' == log.deletion_status"
                                    ></i>
                        </td>
                    </tr>
                </tbody>
            </table>
        </article>

    </section>

    <div dp-register-message="delete_users_prompt">{{ phrase('adm.users_import.delete_users_prompt') }}</div>
{% endblock %}
