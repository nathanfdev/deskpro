{% extends 'AdminInterfaceBundle:Layout:list.html.twig' %}
{% block listpane_content %}

<section class="dp-paneblock dp-listpane" ng-show="ListCtrl.custom_apps.length">
	<header>
		<h3>Your Widgets</h3>
	</header>
	<article>
		<ul class="dp-item-list">
			<li ng-repeat="app in ListCtrl.custom_apps" dp-state-mark="apps.apps.custom_instance.{{ ng_var('app.id') }}">
				<a href="{{ ng_href('apps.apps.custom_instance', "{custom_id: 'custom_' + app.id}") }}">
					<span class="title-text">{{ ng_var('app.title') }}</span>
				</a>
			</li>
		</ul>
	</article>
</section>

<section class="dp-paneblock dp-listpane" ng-show="ListCtrl.apps.length || ListCtrl.listInstalledAppsV2().length">
	<header>
		<h3 style="margin-bottom: 0;">Installed Apps</h3>
	</header>
	<article>
		<ul class="dp-item-list dp-icon-list compact">
			<li ng-repeat="app in ListCtrl.apps" dp-state-mark="apps.apps.instance.{{ ng_var('app.id') }}">
				<aside ng-if="!app.package.is_usersource_app">
					<a href="{{ ng_href('apps.apps.instance', '{id: app.id}') }}"><img ng-src="{{ ng_var('app.package.icon_32') }}" alt="Icon" /></a>
				</aside>
				<div class="content" ng-if="!app.package.is_usersource_app">
					<h4>
						<a href="{{ ng_href('apps.apps.instance', '{id: app.id}') }}">
							<span class="title-text">{{ ng_var('app.title') }}</span>
							<span class="title-alt" ng-if="app.package.title != app.title">({{ ng_var('app.package.title') }})</span>
						</a>
					</h4>
					<p class="info">
						by {{ ng_var('app.package.author_name') }} &bull; <a ng-href="{{ ng_var('app.package.author_link') }}" target="_blank">Website</a>
					</p>
				</div>
			</li>
			<li ng-repeat="app in ListCtrl.listInstalledAppsV2()" dp-state-mark="apps.apps.instance_v2.{{ ng_var('app.id') }}">
				<aside ng-if="!app.package.is_usersource_app">
					<a href="{{ ng_href('apps.apps.edit-v2', "{instanceId: app.id}") }}"><img ng-src="{{ ng_var('app.app.icon_32') }}" alt="Icon" /></a>
				</aside>
				<div class="content" ng-if="!app.package.is_usersource_app">
					<h4>
						<a href="{{ ng_href('apps.apps.edit-v2', "{instanceId: app.id}") }}">
							<span class="title-text">{{ ng_var('app.name') }}</span>
						</a>
					</h4>
					<p class="info">
						by {{ ng_var('app.app.manifest.author.name') }} &bull; <a ng-href="{{ ng_var('app.app.manifest.author.url') }}" target="_blank">Website</a>
					</p>
				</div>
			</li>
		</ul>
	</article>
</section>

{% macro package_row() %}
	<aside>
		<a href="{{ ng_href('apps.apps.package', '{name: package.name}') }}"><img ng-src="{{ ng_var('package.icon_48') }}" alt="Icon" /></a>
	</aside>
	<div class="content">
		<h4><a href="{{ ng_href('apps.apps.package', '{name: package.name}') }}"><span class="title-text">{{ ng_var('package.title') }}</span></a></h4>
		<p class="info">
			by {{ ng_var('package.author_name') }} &middot; <a ng-href="{{ ng_var('package.author_link') }}">Website</a>
		</p>
		<p ng-bind-html="package.description"></p>
	</div>
{% endmacro %}
{% macro package_v2_row() %}
	<aside>
		<a href="{{ ng_href('apps.apps.install-v2-reload', 'ListCtrl.getInstallerRouteParams(package)') }}" ><img ng-src="{{ ng_var('package.icon_48') }}" alt="Icon" /></a>
	</aside>
	<div class="content">
		<h4><a href="{{ ng_href('apps.apps.install-v2-reload', 'ListCtrl.getInstallerRouteParams(package)') }}" ><span class="title-text">{{ ng_var('package.manifest.title') }}</span></a></h4>
		<p class="info">
			by {{ ng_var('package.manifest.author.name') }} &middot; <a ng-href="{{ ng_var('package.manifest.author.url') }}">Website</a>
		</p>
		<p ng-bind-html="package.description"></p>
	</div>
{% endmacro %}

<section class="dp-paneblock dp-listpane" dp-max-height dp-height-add="-35">
	<header>
		<nav ng-show="ListCtrl.apps.length">
			<label style="margin: 10px 15px 0 0; font-size: 11px;">
				<input type="checkbox" ng-model="hide_installed" /> Hide apps that are already installed
				<i class="fa fa-question-circle qmark-icon" tooltip="Some apps can be installed multiple times. If you want to install a second instance of an app, uncheck this box so the app appears in the list." tooltip-placement="left"></i>
			</label>
		</nav>
		<h3>Apps</h3>
	</header>
	<article>
		<div class="alert alert-info dp-alert-ribbon">
			<button class="btn btn-default btn-xs" ng-click="ListCtrl.showNewApp()"><i class="fa fa-asterisk"></i> Create Widget</button>
			<button class="btn btn-default btn-xs" ng-click="ListCtrl.showUploadApp()"><i class="fa fa-upload"></i> Upload App</button>
		</div>
		<ul class="dp-item-list dp-icon-list">
			<li ng-repeat="package in ListCtrl.packages | filter:packagesFilter(hide_installed)" dp-state-mark="apps.apps.package.{{ ng_var('package.name') }}">
				{{ _self.package_row() }}
			</li>
			<li ng-repeat="package in ListCtrl.apps_v2_packages" dp-state-mark="apps.apps.package.{{ ng_var('package.name') }}">
				{{ _self.package_v2_row() }}
			</li>
		</ul>
	</article>
</section>

{% if not app.isCloud() %}
	<div style="margin-top: 4px; margin-bottom: 8px; margin-right: 18px; text-align: right;">
		<a href="{{ ng_href('apps.resync') }}">Re-sync app packages &rarr;</a>
	</div>
{% endif %}

{{ ng_tpl('AdminInterfaceBundle:Apps:new-app-modal.html.twig') }}
{% endblock %}
{% block listpane_help %}
	<header>
		<h1>You can extend DeskPRO with apps to add new functionality and integration with other services.</h1>
		<p>Click any app to install and configure it. You can also create your own widgets (basic apps based on HTML and Javascript) and full apps, or integrate with other services using the DeskPRO REST API.</p>
	</header>

	<article>
		<section>
			<p>The authentication apps allow agents or users to log in using credentials from other services, rather than a DeskPRO account.</p>
			<p>Most apps that operate with third-party services require you to set up an account with the service first. Some apps also require you to provide an <strong>API token</strong> or some other authentication code from the linked service: consult the support pages for the service to find out how to get it.</p>

		</section>

<section>
		<h2><span>FAQ</span></h2>
		<dl>
			<dt><em>Q:</em>How do I create my own widgets or apps?</dt>
			<dd><em>A:</em>
				See the <a href="https://manuals.deskpro.com/html/developer-apps/" target="_blank">Developer Manual</a> for details.
			</dd>

						<dt><em>Q:</em>I can't get an app to work - where can I get help?</dt>
			<dd><em>A:</em>
				There are  <a href="https://support.deskpro.com/guides/topic/411" target="_blank">full installation guides for most apps in the admin manual</a>; <a href="https://support.deskpro.com/guides/topic/426" target="_blank">see here for authentication app instructions</a>.
			</dd>


		</dl>
</section>

		<section class="related-content">
			<h2><span>Related Content</span></h2>
			<ul>
				<li><i class="fa fa-book"></i> <a href="https://support.deskpro.com/guides/topic/411" target="_blank">Installing apps</a> </li>

				<li> <i class="fa fa-book"></i> <a href="https://support.deskpro.com/guides/topic/426"
				target="_blank">Authentication and SSO apps</a>


			<li><i class="fa fa-globe"></i>  <a href="https://github.com/DeskPRO/DeskPRO-Apps" target="_blank">Full code for example DeskPRO apps</a> on GitHub</li>
			</ul>
		</section>
	</article>
{% endblock %}
