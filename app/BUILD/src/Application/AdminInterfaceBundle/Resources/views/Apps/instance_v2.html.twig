{% extends 'AdminInterfaceBundle:Layout:list-editpane.html.twig' %}
{% block editpane_content %}
	<section class="dp-paneblock dp-editpane">
		<article class="form-horizontal dp-form">
			<div class="panel panel-fill indent">
				<div class="panel-body">
					<div class="form-group">
						<div style="float: left;">
							<img ng-src="{{ ng_var('Ctrl.pack.icon_48') }}" alt="Icon" />
						</div>
						<div style="float:right">
							<a class="btn btn-default" href="{{ ng_href('apps.apps.package', '{name: Ctrl.pack.name}') }}"><i class="fa fa-dropbox"></i> View App</a>
						</div>
						<div style="margin-left: 52px;">
							<input type="text" class="form-control camo-input" ng-model="Ctrl.app.name" style="font-size: 22px; width: 75%; max-width: 350px; height: auto;" />
						</div>
						<div style="margin-left: 62px;">
							<p class="info">
								by {{ ng_var('Ctrl.pack.manifest.author.name') }} &middot; <a ng-href="{{ ng_var('Ctrl.pack.manifest.author.url') }}">Website</a>
							</p>
							<p ng-bind-html="Ctrl.pack.manifest.description"></p>
						</div>
					</div>
				</div>
			</div>
		</article>

		<footer ng-hide="has_own_footer" style="height: 60px;">
			<div class="dp-content">
				<a class="btn btn-default" href="{{ ng_href('apps.apps.update-v2-reload', "{instanceId: Ctrl.instanceId}") }}" style="float:left">Change Settings</a>

				<div class="dp-delete-control">
					<button class="btn btn-danger" ng-click="Ctrl.startDelete();">Uninstall App</button>
				</div>
			</div>
		</footer>
	</section>

	{{ ng_tpl('AdminInterfaceBundle:Apps:readme-modal.html.twig') }}
	{{ ng_tpl('AdminInterfaceBundle:Apps:instance-delete-modal.html.twig') }}
{% endblock %}
