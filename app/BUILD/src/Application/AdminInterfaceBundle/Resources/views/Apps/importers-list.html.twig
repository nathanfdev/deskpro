{% extends 'AdminInterfaceBundle:Layout:list.html.twig' %}
{% block listpane_content %}
    <section class="dp-paneblock dp-listpane" dp-max-height dp-height-add="-35">
        <header>
            <h3>Importers</h3>
        </header>
        <article>
            <ul class="dp-item-list dp-icon-list">
                <li ng-repeat="i in list" dp-state-mark="apps.importers.view.{{ ng_var('i.id') }}">
                    <aside>
                        <a href="{{ ng_href('apps.importers.view', '{id: i.id}') }}">
                            <img ng-src="{{ ng_var('i.icon') }}" alt="Icon"
                                 style="width: 40px; height: 40px;"/>
                        </a>
                    </aside>
                    <div class="content">
                        <h4 style="margin-top:5px;">
                            <a href="{{ ng_href('apps.importers.view', '{id: i.id}') }}">
                                <span class="title-text">{{ ng_var('i.title') }}</span>
                            </a>
                        </h4>

                        <p class="info">
                            {{ ng_var('i.description') }}
                        </p>
                    </div>
                </li>
            </ul>
        </article>
    </section>
{% endblock %}
{% block listpane_help %}
    <header>
        <h1>You can import tickets and other data into Deskpro.</h1>
        <p>If the legacy helpdesk you're importing from is not shown, you can
            still import your data if you can export it into CSV (simple comma-separated text format).
        </p>
    </header>

    <article>
        <section>
            <p>This data importer enables you to import your tickets, user/agent records, feedback items, Knowledgebase articles, download files and news posts from an existing helpdesk.</p>

        </section>

        <section>
            <h2><span>FAQ</span></h2>
            <dl>
                <dt><em>Q:</em>What format do the CSV files need to be in?</dt>
                <dd><em>A:</em>
                    See <a href="https://support.deskpro.com/guides/topic/486" target="_blank">this section of the Admin Manual</a> for details.
                </dd>

                <dt><em>Q:</em>How do I get my data from Zendesk?</dt>
                <dd><em>A:</em>
                    You need an admin login on the legacy Zendesk account. The procedure is <a href="https://support.deskpro.com/guides/topic/486" target="_blank">fully explained here</a>.
                </dd>

                <dt><em>Q:</em>How do I get my data from osTicket?</dt>
                <dd><em>A:</em>
                    You need to know the database connection details for the osTicket MySQL database. The procedure is <a href="https://support.deskpro.com/guides/topic/486" target="_blank">fully explained here</a>.
                </dd>

                <dt><em>Q:</em>This importer won't do what I want. Is there another way?</dt>
                <dd><em>A:</em>
                    A software developer can import data using Deskpro's REST API. See <a href="https://manuals.deskpro.com/html/developer-apps/api/api.html" target="_blank">the API section of the Developer Manual</a>.
                </dd>

            </dl>
        </section>

        <section class="related-content">
            <h2><span>Related Content</span></h2>
            <ul>
                <li><i class="fa fa-book"></i> <a href="https://support.deskpro.com/guides/topic/486" target="_blank">Importing from CSV</a> </li>

                <li> <i class="fa fa-book"></i> <a href="https://support.deskpro.com/guides/topic/486" target="_blank">Importing from Zendesk</a>

                <li> <i class="fa fa-book"></i> <a href="https://support.deskpro.com/guides/topic/486" target="_blank">Importing from osTicket</a>
            </ul>
        </section>
    </article>
{% endblock %}