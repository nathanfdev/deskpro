{% extends 'AdminInterfaceBundle:Layout:list.html.twig' %}
{% block listpane_content %}
	<section class="dp-paneblock dp-listpane">
		<header>
			<nav>
				{% include 'AdminInterfaceBundle:Layout:standard-settings-menu.html.twig' %}
			</nav>
			<h3>{{ phrase('agent.general.agents') }}</h3>
		</header>
		<article>
			<ul class="dp-item-list" dp-list-autoload dp-max-height>
				<li ng-repeat="agent in ListCtrl.agents" dp-state-mark="agents.agents.edit.{{ ng_var('agent.id') }}">
					<a href="{{ ng_href('agents.agents.edit', '{id: agent.id}') }}" title="{{ ng_var('agent.primary_email.email') }}">
						<div style="float:right">
							<span style="display: inline-block; font-size: 10pt; margin-right: 3px;" tooltip-placement="left" tooltip="Access to admin interface" ng-show="agent.can_admin"><i class="fa fa-wrench"></i></span>
							<span style="display: inline-block; font-size: 10pt;" tooltip-placement="left" tooltip="Access to reports interface" ng-show="agent.can_reports"><i class="fa fa-bar-chart-o"></i></span>
						</div>
						<h4>
                            {% include 'AdminInterfaceBundle:Agents:agent.html.twig' %}
						</h4>
					</a>
				</li>
			</ul>
			<div class="dp-add-control">
				<a class="btn btn-default" href="{{ ng_href('agents.agents.create') }}">
					<i class="fa fa-plus"></i>
					{{ phrase('agent.general.add') }}
				</a>
                <button class="btn btn-default" ng-click="ListCtrl.$modal.open({ templateUrl: ListCtrl.getTemplatePath('Agents/import.html') })">
                    <i class="fa fa-plus"></i>
                    {{ phrase('agent.general.add_bulk') }}
                </button>
			</div>
		</article>
	</section>

	<section class="dp-paneblock dp-panelink" ng-show="ListCtrl.deletedCount > 0">
		<a href="{{ ng_href('agents.agents_deleted') }}">
			<em><i class="fa fa-chevron-down"></i></em>
			<h3>{{ ng_var('ListCtrl.deletedCount') }} Deleted Agents</h3>
		</a>
	</section>

	<section class="dp-paneblock dp-panelink">
		<a href="{{ ng_href('agents.login_log') }}">
			<em><i class="fa fa-chevron-down"></i></em>
			<h3>View Login Log</h3>
		</a>
	</section>
{% endblock %}
{% block listpane_help %}
	<header>
		<h1>Agents use the helpdesk to provide assistance to users.</h1>
		<p>
			Agent <strong>permissions</strong> control what each agent is allowed to do.
			Click on each agent to edit their details and permissions, or use <b>permission groups</b> to set permissions for multiple agents at once.</p>
	</header>
	<article>
		<section>
		
			<p>Enter a <strong>working email address</strong> for each agent, so they can receive email notifications.</p>
		
			
			<p>Use an agent's personal email address (e.g. <code>susan.brown@example.com</code>) for their agent account, not an <code>info@</code> address that is set up to receive tickets in <strong>Tickets > Email Accounts</strong>.</p>
		
			<p><strong>Zones</strong> control which agents can access this admin interface, or the reports interface which shows data on helpdesk usage.</p>
			<p>Use the <strong>Departments</strong> tab to control access to tickets in each department:</p>
			<ul>
				<li><strong>Full</strong> means the agent can view and work on tickets in that department</li>
				<li><strong>Assign</strong> means the agent can assign tickets to the department, but nothing more (they can't view them afterwards)</li>
			</ul>
			<p>Permissions control what the agent is allowed to do in the agent interface.</p>
			<p>You can copy permission settings from another agent using the gear menu at top right.</p>
			<p>If you want to give several agents the same permission settings, it's quicker to use <a href="agent/#admin:/agents/groups/">Permission Groups</a>.</p>
			<p>Use <strong>Log in as this agent</strong> from the gear menu to see the agent interface as if you are logged in as the agent.</p>
			<p>For agents with more than one team, you can set the <strong>primary team</strong>; this is used when an automated action assigns a ticket to "the current agent's team".</p>

		</section>

		<section>
			<h2><span>FAQ</span></h2>
			<dl>
				<dt><em>Q:</em> I've used all the agents that my licence allows - how can I get more?</dt>
				<dd><em>A:</em> Either delete some unwanted agent accounts to free up agent seats, or extend your license in the <a href="agent/#admin:/license" target="_blank">Billing interface</a>.</dd>

				<dt><em>Q:</em> If I delete an agent, will their tickets be deleted?</dt>
				<dd><em>A:</em> No, whether you delete an agent or convert them to a user, any tickets they're assigned to will just become unassigned.</dd>

			</dl>
		</section>

		<section class="related-content">
			<h2><span>Related Content</span></h2>
			<ul>
				<li><i class="fa fa-book"></i> <a href="https://support.deskpro.com/guides/topic/339" target="_blank">Creating agents</a>
				<li><i class="fa fa-book"></i> <a href="https://support.deskpro.com/guides/topic/340" target="_blank">Agent permissions</a>
				<li><i class="fa fa-file-text"></i> <a href="https://support.deskpro.com/kb/articles/194" target="_blank">Automatically assign agents to tickets they reply to by email</a></li>
				<li><i class="fa fa-file-text"></i> <a href="https://support.deskpro.com/kb/articles/256" target="_blank">Limiting agent access to tickets by department</a>
				</li>
			</ul>
		</section>
	</article>
{% endblock %}
