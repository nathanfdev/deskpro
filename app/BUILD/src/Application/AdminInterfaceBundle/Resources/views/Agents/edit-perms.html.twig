<div class="panel panel-innertable">

    <div class="alert alert-info">
        <p>
            Permission groups are pre-defined sets of permissions you can easily apply to multiple agents.
        </p>

        <p>
            Select the permission groups to apply to this agent:
        </p>
        <ul class="checkbox-list" style="min-width: 250px">
            <li ng-repeat="group in EditCtrl.form.agent_groups">
                <label>
                    <input type="checkbox" ng-model="group.value" />
                    <span>{{ ng_var('group.title') }}</span>
                </label>
            </li>
        </ul>
    </div>

    <div ng-show="EditCtrl.hasPermOverrides">
        <div class="alert alert-warning">
            <p>
                <span class="fa fa-exclamation-triangle"></span>
                There are permission overrides set on this agent. Manage permission overrides below.
                <button class="btn btn-default btn-xs"
                        ng-click="$event.preventDefault(); showConfirm('Are you sure you want to unset all permission overrides?', EditCtrl.clearPermOverrides);"
                        style="float:right">Click here to remove overrides
                </button>
            </p>
        </div>
    </div>

    <div ng-show="EditCtrl.canCreateNewTicket() && !EditCtrl.hasAnyDepTicketsPerms()">
        <div class="alert alert-warning">
            <p>
                <span class="fa fa-exclamation-triangle"></span>
                Warning: This agent has permission to create new tickets, but they do not have permissions to use any
                departments. This means that the agent can't actually create new tickets. To fix this, grant at least
                "assign" permission in one or more departments.
            </p>
        </div>
    </div>
    {% include 'AdminInterfaceBundle:Agents:edit-perms-toggles-all.html.twig' %}

</div>
