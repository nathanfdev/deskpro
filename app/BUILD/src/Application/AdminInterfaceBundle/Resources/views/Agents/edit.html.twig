{% extends 'AdminInterfaceBundle:Layout:list-editpane.html.twig' %}
{% block editpane_content %}
	<form class="form-horizontal dp-form dp-agent-form" role="form" name="form_props" ng-submit="form_props.$valid && EditCtrl.saveAgent()">
		<section class="dp-paneblock dp-editpane">

			<div class="alert alert-success" style="margin: 8px;" ng-show="EditCtrl.created_agent">
				<p>
					An agent account for {{ ng_var('EditCtrl.agent.name') }} was created successfully.
					An email with login instructions has been sent to {{ ng_var('EditCtrl.agent.primary_email.email') }}.
				</p>
			</div>
			<nav class="dp-blocktabs responsive">
				<menu dropdown>
					<button class="btn btn-default" type="button" dropdown-toggle><span><i class="fa fa-cog"></i></span> <i class="fa fa-caret-down"></i></button>
					<ul class="dropdown-menu pull-right">
						<li><a ng-click="EditCtrl.showCopySettings()"><i class="fa fa-copy"></i> Copy settings from another profile</a></li>
						<li ng-if="EditCtrl.agent.id" class="divider"></li>
						<li><a ng-click="EditCtrl.showEditProfile()"><i class="fa fa-user"></i> Edit profile</a></li>
						<li ng-if="EditCtrl.agent.id" class="divider"></li>
						{% if app.authenticationManager.isDeskPROEnabled %}
						<li ng-if="EditCtrl.agent.id"><a ng-click="EditCtrl.showResetPassword()"><i class="fa fa-asterisk"></i> Reset password</a></li>
						{% endif %}
						<li ng-if="EditCtrl.agent.id"><a ng-click="EditCtrl.showLoginAs()"><i class="fa fa-globe"></i> Log in as this person</a></li>
					</ul>
				</menu>
				<ul class="formpart-tabs">
					<li class="active formpart-tab-main" dp-tab-btn="main.props"><a href="#"><i class="fa fa-pencil"></i> {{ phrase('agent.general.properties') }}</a></li>
					<li class="pipe" class="formpart-tab-main-sep">|</li>
					<li dp-tab-btn="main.perms" class="formpart-tab-perms"><a href="#"><i class="fa fa-key"></i> Permissions</a></li>
					<li class="pipe" class="formpart-tab-perms-sep">|</li>
					<li dp-tab-btn="main.deps" class="formpart-tab-depperms"><a href="#"><i class="fa fa-key"></i> Departments</a></li>
					<li class="pipe" class="formpart-tab-depperms-sep">|</li>
					<li dp-tab-btn="main.notif_prefs" class="formpart-tab-notifs"><a href="#"><i class="fa fa-envelope"></i> Ticket Notifications</a></li>
					<li class="pipe" class="formpart-tab-notifs-sep">|</li>
					<li dp-tab-btn="main.othernotif_prefs" class="formpart-tab-othernotifs"><a href="#"><i class="fa fa-envelope-o"></i> Other Notifications</a></li>
				</ul>
			</nav>
			<article class="form-horizontal dp-form">
				<div dp-tab-body="main.props">
					{% include 'AdminInterfaceBundle:Agents:edit-props.html.twig' %}
				</div>
				<div dp-tab-body="main.perms">
					{% include 'AdminInterfaceBundle:Agents:edit-perms.html.twig' %}
				</div>
				<div dp-tab-body="main.deps">
					{% include 'AdminInterfaceBundle:Agents:edit-deps.html.twig' %}
				</div>
				<div dp-tab-body="main.notif_prefs">
					{% include 'AdminInterfaceBundle:Agents:edit-ticket-notifs.html.twig' %}
				</div>
				<div dp-tab-body="main.othernotif_prefs">
					{% include 'AdminInterfaceBundle:Agents:edit-other-notifs.html.twig' %}
				</div>
			</article>
			<footer>
				<div class="dp-content">
					<div class="text-danger ng-hide" ng-show="(form_props.$attempted && form_props.$invalid) || EditCtrl.email_sysaccount_error || EditCtrl.invalid_phone_error">
						<p><strong>{{phrase('adm.general.please_correct_errors')}}</strong></p>
						<ul>
							<li ng-show="form_props.name.$error.required || form_props.name.$error.not_blank">
                                {{ phrase('adm.validation.required_name') }}
                            </li>
                            <li ng-show="form_props.override_name.$error.required || form_props.name.$error.not_blank">
                                {{ phrase('adm.validation.required_name') }}
                            </li>
							<li ng-show="form_props.email.$error.required || form_props.email.$error.emails_count || form_props.email.$error.email">
                                {{ phrase('adm.validation.email') }}
                            </li>
							<li ng-show="EditCtrl.email_sysaccount_error">
                                The email address you entered ({{ ng_var('EditCtrl.email_sysaccount_error') }}) belongs to a ticket account. You cannot re-use the same email address for agents and ticket accounts.
                            </li>
							<li ng-show="EditCtrl.invalid_phone_error && !form_props.primary_phone.$error.phone_number">
									Invalid phone number: {{ ng_var('EditCtrl.invalid_phone_error') }}
							</li>
							<li ng-show="!EditCtrl.invalid_phone_error && form_props.primary_phone.$error.phone_number">
								Invalid phone number
							</li>
						</ul>
					</div>

					<div class="dp-delete-control" ng-if="EditCtrl.agent.id" ng-hide="form_props.$attempted && form_props.$invalid">
						<button class="btn" ng-click="$event.preventDefault(); EditCtrl.showDelete();" ng-class="EditCtrl.isSelf() && 'btn-default' || 'btn-danger'">Delete</button>
					</div>

					<div class="dp-btn-controls" ng-hide="form_props.$attempted && form_props.$invalid">
						<div dp-hide-spinning="saving">
							<button class="btn btn-primary" dp-submit-form>{{phrase('agent.general.save')}}</button>
						</div>
						<div dp-show-spinning="saving">
							<i class="spinner-flat"></i>
						</div>
					</div>
				</div>
			</footer>
		</section>
	</form>
	{{ ng_tpl('AdminInterfaceBundle:Agents:reset-password-modal.html.twig') }}
	{{ ng_tpl('AdminInterfaceBundle:Agents:copy-settings-modal.html.twig') }}
	{{ ng_tpl('AdminInterfaceBundle:Agents:delete-modal.html.twig') }}
	{{ ng_tpl('AdminInterfaceBundle:Agents:edit-profile-modal.html.twig') }}
	{{ ng_tpl('AdminInterfaceBundle:Agents:login-as-modal.html.twig') }}
{% endblock %}
