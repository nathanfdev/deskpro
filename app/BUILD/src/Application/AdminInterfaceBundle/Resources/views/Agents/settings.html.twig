{% extends 'AdminInterfaceBundle:Layout:fullpage-pane.html.twig' %}
{% block fullpane_content %}
    <form class="form-horizontal dp-form" role="form" name="form_props" ng-submit="form_props.$valid && Settings.saveSettings()">

    <section class="dp-paneblock dp-listpane">
        <header>
            <h3>Agent Notifications</h3>
        </header>
        <article class="form-horizontal dp-form">
            <div class="panel panel-innertable">
                <div class="form-group">
                    <div class="col-lg-12">
                        <div class="inner-group">
                            <label>
                                <input type="checkbox" ng-model="settings.disable_notifications" />
                                <h4>Disable all email notifications</h4>
                            </label>
							<span class="help-block">
								This setting disables all email notifications based on subscriptions (the ones set in the Ticket Notifications and Other Notifications tabs in <a href="agent/#admin:/agents/agents/" target="_blank">Agents</a>, or in the agent's Preferences).
								Note that custom triggers that send messages to agents will not be disabled.
							</span>
                        </div>
                    </div>
                </div>
            </div>
        </article>
    </section>

    <section class="dp-paneblock dp-listpane">
        <header>
            <h3>Agent Password Policy</h3>
        </header>
        <article class="form-horizontal dp-form">
            <div class="panel panel-innertable" style="margin-top: 0;">
                <div class="form-group">
                    <div class="labels-group">
                        <label>
                            <input type="radio" ng-model="agent.standard_policy" ng-value="true" />
                            <h4>Standard Password Policy</h4>
							<span class="help-block" ng-show="agent.standard_policy">
								Passwords must be at least 5 characters long. No other requirements are enforced.
							</span>
                        </label>
                        <label>
                            <input type="radio" ng-model="agent.standard_policy" ng-value="false" />
                            <h4>Custom Password Policy</h4>
							<span class="help-block" ng-show="!agent.standard_policy">
								Specify custom password requirements.
							</span>
                        </label>
                    </div>

                    <div ng-if="!agent.standard_policy">
                        <div class="panel-heading">
                            <h3>
                                <span>Password Policy</span>
                            </h3>
                        </div>

                        <div class="inner-group" dp-error-class="form_props.min_length">
                            <label>
                                <h4>Minimum password length:</h4>
                            </label>
                            <input type="number" class="form-control" name="min_length" ng-model="agent.min_length"
                                   style="width: 100px; display: inline-block;" required integer min="0" /> characters
							<span class="help-block">
								The minimum number of characters the password has to be.
							</span>
                        </div>
                        <div class="inner-group" dp-error-class="form_props.max_age">
                            <label>
                                <h4>Maximum password age:</h4>
                            </label>
                            <input type="number" class="form-control" name="max_age" ng-model="agent.max_age"
                                   style="width: 100px; display: inline-block;" required integer min="0" /> days
							<span class="help-block">
								How many days a password can remain unchanged until Deskpro requires the agent to change it.
							</span>
                        </div>
                        <div class="inner-group">
                            <label>
                                <input type="checkbox" ng-model="agent.forbid_reuse" />
                                <h4>Forbid password reuse</h4>
                            </label>
							<span class="help-block">
								When enabled, agents will not be able to change their password to a password they have used in the past.
							</span>
                        </div>
                        <div class="inner-group" dp-error-class="form_props.require_num_lowercase">
                            <label>
                                <h4>Require this many lower-case characters:</h4>
                            </label>
                            <input type="number" class="form-control" name="require_num_lowercase"
                                   ng-model="agent.require_num_lowercase" style="width: 100px; display: inline-block;"
                                   required integer min="0" />
							<span class="help-block">
								Define the minimum number of lower-case (a-z) characters that must be used in the password.
							</span>
                        </div>
                        <div class="inner-group" dp-error-class="form_props.require_num_uppercase">
                            <label>
                                <h4>Require this many upper-case characters:</h4>
                            </label>
                            <input type="number" class="form-control" name="require_num_uppercase"
                                   ng-model="agent.require_num_uppercase" style="width: 100px; display: inline-block;"
                                   required integer min="0" />
							<span class="help-block">
								Define the minimum number of upper-case (A-Z) characters that must be used in the password.
							</span>
                        </div>
                        <div class="inner-group" dp-error-class="form_props.require_num_number">
                            <label>
                                <h4>Require this many numbers:</h4>
                            </label>
                            <input type="number" class="form-control" name="require_num_number"
                                   ng-model="agent.require_num_number" style="width: 100px; display: inline-block;"
                                   required integer min="0" />
							<span class="help-block">
								Define the minimum number of numbers (0-9) that must be used in the password.
							</span>
                        </div>
                        <div class="inner-group" dp-error-class="form_props.require_num_symbol">
                            <label>
                                <h4>Require this many symbols:</h4>
                            </label>
                            <input type="number" class="form-control" name="require_num_symbol"
                                   ng-model="agent.require_num_symbol" style="width: 100px; display: inline-block;"
                                   required integer min="0" />
							<span class="help-block">
								Define the minimum number of symbols (!, @, $, % etc) that must be used in the password.
							</span>
                        </div>
                    </div>
                </div>
            </div>
        </article>
    </section>

	{##################################################################################################}

    <section class="dp-paneblock dp-listpane">
        <header>
            <h3>Session Settings</h3>
        </header>
        <article class="form-horizontal dp-form">
            <div class="panel panel-innertable">
                <div class="form-group">
                    <div class="col-lg-12">
                        <div class="inner-group" dp-error-class="form_props.sessions_lifetime">
                            <label>
                                <h4>Session Lifetime</h4>
                            </label>
                            <br/>
                            <input type="number" name="sessions_lifetime" class="form-control"
                                   ng-model="settings.sessions_lifetime" style="width: 150px"
                                   required integer min="0" /> seconds
							<span class="help-block">
								Sessions that are not touched for this long will expire. This allows the system
								to clean up old sessions after agents have left the site or closed their browser window.
								For security reasons, we recommend you do not set this longer than an hour or two.
							</span>
                        </div>
                        <div class="inner-group">
                            <label>
                                <input type="checkbox" ng-model="settings.session_keepalive_require_page" />
                                <h4>Require Activity</h4>
                            </label>
							<span class="help-block">
								Enable this to log out agents who are idle. Otherwise, sessions will be kept alive if Deskpro is open in a browser window, even if the agent is not doing anything.
							</span>
                        </div>
						<div class="inner-group">
							<label>
								<input type="checkbox" ng-model="settings.enable_agent_rememberme" />
								<h4>Enable "Remember Me"</h4>
							</label>
							<span class="help-block">
								Enable this to allow agents to check "Remember Me" so they don't have to log in again from the same browser. Disabling this can increase security, at the
								cost of requiring the agent to log in more frequently.
							</span>
						</div>
                    </div>
                </div>
            </div>
        </article>
    </section>

	{##################################################################################################}

	<section class="dp-paneblock dp-listpane">
		<header>
			<h3>IP Whitelisting</h3>
		</header>
		<article class="form-horizontal dp-form">
			<div class="panel panel-innertable">
				<div class="form-group">
					<div class="col-lg-12">
						<div class="inner-group">
							<label>
								<input type="checkbox" ng-model="settings.ip_security_enabled" />
								<h4>Use IP Whitelisting</h4>
							</label>
							<span class="help-block">
								When IP whitelisting is enabled, agents can only log in from IP addresses
								that have been marked as trusted. When someone attempts to log in from an
								untrusted IP address, an email alert is sent . The email will contain
								a link to whitelist the IP address. Without clicking the link,
								any login from the untrusted IP address will be rejected.
							</span>
							<div ng-show="settings.ip_security_enabled">
								<select ng-model="settings.ip_security_mode">
									<option value="agents,admins">Enable for both agents and admins</option>
									<option value="admins">Enable for just admins</option>
								</select>
							</div>
						</div>
						<div class="inner-group" ng-show="settings.ip_security_enabled">
							<label>
								<h4>How long should IP addresses remain trusted until they must be re-validated?</h4>
							</label>
							<br/>
							<select
                                    dp-closest-number
                                    ng-model="settings.ip_security_whitelist_lifetime"
                                    ng-options="whitelist_time.id as whitelist_time.label for whitelist_time in ip_white_listing_times">
                            </select>

						</div>
					</div>
				</div>
			</div>
		</article>
	</section>

    {##################################################################################################}

        <section class="dp-paneblock dp-listpane">
            <article class="form-horizontal dp-form">
                <div class="panel panel-innertable">
                    <div class="form-group">
                        <div class="col-lg-12">
                            <div class="inner-group">
                                <label>
                                    <input type="checkbox" ng-model="settings.agent_enable_kb_shortcuts"/>
                                    <h4>Enable Keyboard Shortcuts</h4>
                                </label>
                        <span class="help-block">
                        </span>
                            </div>
                        </div>
                    </div>
                </div>
            </article>
        </section>

        {##################################################################################################}

    <section class="dp-paneblock dp-listpane">
        <header>
            <h3>{{ phrase('adm.settings.logo_title') }}</h3>
        </header>
        <article class="form-horizontal dp-form">
            <div class="panel panel-innertable">
                <div class="form-group">
                    <div class="col-lg-12">
                        <a href="javascript:;" class="file-upload-wrapper" style="display: inline-block;" ng-hide="logo_uploading">
                            <input type="file" ng-file-select="Settings.onFileSelect($files)" accept="image/*" />
                            <div ng-if="!logo_blob || logo_blob.empty" style="width: 300px; height: 75px; background: #eee; border: 1px solid #ccc;"></div>
                            <img ng-if="logo_blob && !logo_blob.empty" ng-src="{{ ng_var('logo_blob.thumbnail') }}&size-fit=1" />
                        </a>
                        <i class="spinner-flat" ng-show="logo_uploading"></i>
                    </div>
                </div>
            </div>
        </article>
    </section>

    {##################################################################################################}

    <section class="dp-paneblock dp-listpane">
        <footer>
            <div class="dp-content">

                <div class="text-danger ng-hide" ng-show="form_props.$attempted && form_props.$invalid">
                    <p><strong>{{phrase('adm.general.please_correct_errors')}}</strong></p>
                    <ul>
                        <li ng-show="form_props.sessions_lifetime.$error.required
                            || form.sessions_lifetime.$error.min
                            || form_props.sessions_lifetime.$error.integer">
                            {{ phrase('adm.validation.time') }}
                        </li>
                    </ul>
                </div>

                <div class="dp-btn-controls" ng-hide="form_props.$attempted && form_props.$invalid">
                    <div dp-hide-spinning="saving">
                        <button class="btn btn-primary" dp-submit-form>
                            {{ phrase('agent.general.save') }}
                        </button>
                    </div>
                    <div dp-show-spinning="saving">
                        <i class="spinner-flat"></i>
                    </div>
                </div>
            </div>
        </footer>
    </section>
    </form>
    <div dp-register-message="saved_settings">Settings saved successfully.</div>
{% endblock %}
