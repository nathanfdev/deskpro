{% extends 'AdminInterfaceBundle:Layout:fullpage-pane.html.twig' %}

{% block fullpane_content %}

	<section class="dp-paneblock dp-panelink">
		<a href="{{ ng_href('agents.audit_logs') }}">
			<em><i class="fa fa-chevron-down"></i></em>

			<h3>{{ phrase('admin.audit_logs.title') }}</h3>
		</a>
	</section>

	<section class="dp-paneblock dp-listpane">
		<header>
			<h3>{{ phrase('admin.audit_logs.log_title') }}{{ ng_var('AuditLogsView.log.id') }}</h3>
		</header>

		{##################################################################################################}

		<article class="form-horizontal dp-form">
			<div class="panel panel-fill indent">
				<div class="panel-body">
					<div class="form-group">
						<div class="col-sm-2">
							<strong>{{ phrase('admin.audit_logs.date_created') }}</strong>
						</div>
						<div class="col-sm-10">
							{{ ng_var('AuditLogsView.log.date_created | date : "yyyy-MM-d H:mm:ss"') }}
						</div>
					</div>
				</div>
                <div class="panel-body">
                    <div class="form-group">
                        <div class="col-sm-2">
                            <strong>{{ phrase('admin.audit_logs.performer') }}</strong>
                        </div>
                        <div class="col-sm-10">
                            {{ ng_var('AuditLogsView.log.performer_name') }}
                            <span ng-show="AuditLogsView.log.performer_id">(ID: {{ ng_var('AuditLogsView.log.performer_id') }})</span>
                        </div>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="form-group">
                        <div class="col-sm-2">
                            <strong>{{ phrase('admin.audit_logs.action') }}</strong>
                        </div>
                        <div class="col-sm-10">
                            {{ ng_var('AuditLogsView.log.action') }}
                        </div>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="form-group">
                        <div class="col-sm-2">
                            <strong>{{ phrase('admin.audit_logs.description') }}</strong>
                        </div>
                        <div class="col-sm-10">
                            {{ ng_var('AuditLogsView.log.description') }}
                        </div>
                    </div>
                </div>
                <div class="panel-body" ng-show="AuditLogsView.log.object_id">
                    <div class="form-group">
                        <div class="col-sm-2">
                            <strong>{{ phrase('admin.audit_logs.object_description') }}</strong>
                        </div>
                        <div class="col-sm-10">
                            {{ ng_var('AuditLogsView.log.object_name') }}
                            - {{ ng_var('AuditLogsView.log.object_type') }}{#
                            #}[{{ ng_var('AuditLogsView.log.object_id') }}]
                        </div>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="form-group">
                        <div class="col-sm-2">
                            <strong>{{ phrase('admin.audit_logs.changeset') }}</strong>
                        </div>
                        <div class="col-sm-10">
                            <pre>{#
                                #}{{ ng_var('AuditLogsView.getChangeSet()') }}
                            </pre>
                        </div>
                    </div>
                </div>
			</div>
		</article>

	</section>

{% endblock %}
