{% import 'AdminInterfaceBundle:Agents:edit-perms-toggles-row-' ~ (groups ? 'group' : 'agent') ~ '.html.twig' as macro %}

<nav class="dp-tabletabs">
    <ul>
        <li class="active" dp-tab-btn="main.perms.tickets">
            <a href="#"><i class="fa fa-envelope"></i> {{ phrase('adm.agents.perm_title_tickets') }}</a>
        </li>
        <li dp-tab-btn="main.perms.people">
            <a href="#"><i class="fa fa-user"></i> {{ phrase('adm.agents.perm_title_people') }}</a>
        </li>
        {% if isChatAvailable() %}
            <li dp-tab-btn="main.perms.chat">
                <a href="#"><i class="fa fa-comment"></i> {{ phrase('adm.agents.perm_title_chat') }}</a>
            </li>
        {% endif %}
        <li dp-tab-btn="main.perms.publish">
            <a href="#"><i class="fa fa-book"></i> {{ phrase('adm.agents.perm_title_publish') }}</a>
        </li>
        <li dp-tab-btn="main.perms.profile">
            <a href="#"><i class="fas fa-pencil-alt"></i> {{ phrase('adm.agents.perm_title_profile') }}</a>
        </li>
        <li dp-tab-btn="main.perms.others">
            <a href="#"><i class="fa fa-cogs"></i> {{ phrase('adm.agents.perm_title_others') }}</a>
        </li>
    </ul>

    {% include 'AdminInterfaceBundle:Agents:edit-perms-global-toggle.html.twig' with {tab: 'main.perms.tickets', type: 'perms', section: 'ticket'} %}
