<div>
	<div class="modal-header">
		<button type="button" class="close" ng-click="dismiss()">&times;</button>
		<h4 class="modal-title">Delete Ban</h4>
	</div>
	<div class="modal-body">
		<p>
			Are you sure you want to delete <span ng-if="!multiple">this ban</span><span ng-if="multiple">these bans</span>? This operation could not be undone.
		</p>
	</div>
	<div class="modal-footer">
		<button class="btn btn-success" ng-click="dismiss()"><i class="fa fa-undo"></i> {{ phrase('agent.general.cancel') }}</button>
		<button class="btn btn-danger" ng-click="confirm()"><i class="far fa-trash"></i> {{ phrase('agent.general.delete') }}</button>
	</div>
</div>
