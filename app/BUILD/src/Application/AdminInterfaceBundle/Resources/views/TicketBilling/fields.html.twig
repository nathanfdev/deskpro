{% extends 'AdminInterfaceBundle:Layout:list.html.twig' %}
{% block listpane_content %}

    <section class="dp-paneblock dp-listpane">
		<header>
			<nav>
				<span dp-ping-flash="display_orders" class="saved-ping">
                    <i class="far fa-check-square"></i> {{ phrase('agent.general.saved') }}
                </span>
				{% include 'AdminInterfaceBundle:Layout:standard-settings-menu.html.twig' %}
			</nav>
			<h3 ng-pluralize count="ListCtrl.custom_fields.length || 0"
				when="{{ ng_plural_phrase('adm.general.count_custom_fields') }}">
            </h3>
		</header>
		<article>
			<ul class="dp-item-list" ui-sortable="ListCtrl.sortedListOptions" dp-max-height>
				<li ng-repeat="field in ListCtrl.custom_fields"
					class="with-drag-handle"
					dp-state-mark="tickets.timelog_billing_fields.edit.{{ ng_var('field.id') }}"
					data-id="{{ ng_var('field.id') }}">
					<a href="{{ ng_href('tickets.timelog_billing_fields.edit', '{id: field.id}') }}">
						<i class="fa fa-bars drag-handle"></i>
						<div class="pull-right">
							<em class="tag tag-warn" ng-show="!field.is_enabled">Disabled</em>
						</div>
						<h4>
                            <span class="title-id" title="ID">#{{ ng_var('field.id') }}</span>
                            <span class="title-text">{{ ng_var('field.title') }}</span>
                        </h4>
					</a>
				</li>
			</ul>
			<div class="dp-add-control">
				<a class="btn btn-default" href="{{ ng_href('tickets.timelog_billing_fields.gocreate') }}"
				   ng-class="{'active': isStateActive('tickets.timelog_billing_fields.create') }">
					<i class="fa fa-plus"></i>
					{{ phrase('agent.general.add') }}
				</a>
			</div>
		</article>
	</section>

{% endblock %}
