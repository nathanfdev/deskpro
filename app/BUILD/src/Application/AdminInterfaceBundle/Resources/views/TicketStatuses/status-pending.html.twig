{% extends 'AdminInterfaceBundle:Layout:list-editpane.html.twig' %}
{% block editpane_content %}
	<section class="dp-paneblock dp-editpane">
		<article>
			<div class="panel panel-fill indent">
				<div class="panel-body">
					<p>
						You currently have <strong>{{ ng_var('getCount()') }}</strong> tickets in pending status.
					</p>
				</div>
			</div>
		</article>
  </section>

	<form class="form-horizontal dp-form" role="form" name="form_props" ng-submit="form_props.$valid && TicketStatusEdit.saveSettings()">
		<section class="dp-paneblock dp-editpane">
			<article class="form-horizontal dp-form">
				<div class="panel panel-fill indent">
					<div class="panel-body">
						<div class="form-group">
							<div class="col-lg-3">
								<h3>{{ phrase('adm.ticket_statuses.pending_time_title') }}</h3>
							</div>
							<div class="col-lg-9">
                <select
                  ui-select2
                  ng-model="settings.pending_waiting_time_mode"
                  style="min-width: 240px"
                  class="no-search"
                >
                  <option value="user">{{ phrase('adm.ticket_statuses.pending_time_user') }}</option>
                  <option value="agent">{{ phrase('adm.ticket_statuses.pending_time_agent') }}</option>
                  <option value="none">{{ phrase('adm.ticket_statuses.pending_time_none') }}</option>
                </select>
							</div>
						</div>
					</div>
				</div>
			</article>
			<footer>
				<div class="dp-content">
					<div class="dp-btn-controls" ng-hide="form_props.$attempted && form_props.$invalid">
						<div dp-hide-spinning="saving_settings">
							<button class="btn btn-primary" dp-submit-form>{{phrase('agent.general.save')}}</button>
						</div>
						<div dp-show-spinning="saving_settings">
							<i class="spinner-flat"></i>
						</div>
					</div>
				</div>
			</footer>
		</section>
	</form>
{% endblock %}
