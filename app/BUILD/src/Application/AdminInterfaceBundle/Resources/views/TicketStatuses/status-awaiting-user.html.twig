{% extends 'AdminInterfaceBundle:Layout:list-editpane.html.twig' %}
{% block editpane_content %}
    <section class="dp-paneblock dp-editpane dp-form">
        <article>
            <div class="panel panel-fill indent">
                <div class="panel-body">
                    <p>The Awaiting User status means the ticket is waiting for the user to reply.</p>

                    <p>
                        You currently have <strong>{{ ng_var('getCount()') }}</strong> tickets awaiting user.
                    </p>
                </div>
            </div>
        </article>

        {% for num in 1..3 %}
            <article
                    ng-controller="Admin_TicketEscalations_Ctrl_EditStatuses as ctrl"
                    ng-init="initWith({{ num }})"
                    >
                <div class="panel panel-fill indent">
                    <div class="panel-body">

                        <div class="inner-group">
                            <h4 style="margin-bottom: 3px;">
                                <label>
                                    <input type="checkbox" ng-model="ctrl.esc.is_enabled"
                                           ng-change="ctrl.escData.saveEnabledState(ctrl.esc)"/>
                                    After ticket has been awaiting user for
                                </label>
                                <dp-time-with-unit ng-model="ctrl.form.event_trigger_time"></dp-time-with-unit>
                            </h4>
                            <div ng-show="!ctrl.esc">
                                <i class="spinner-flat"></i>
                            </div>
                            <div ng-show="ctrl.esc" ng-class="{'is-disabled-builder':!ctrl.esc.is_enabled}">
                                {% if num == 1 %}
                                    {% if app.hasBeta('email_templates') %}
                                        <dp-option-builder types-def="ctrl.actionsTypeDef"
                                                           save-target="ctrl.form.actions"
                                                           options="{tag_first: '', tag_after: 'then', fixedExpanded: ['SendUserNewEmail'], fixOn: []}"
                                                           option-types="actionOptionTypes"
                                                >
                                            <add-btn-label>Action</add-btn-label>
                                        </dp-option-builder>
                                    {% else %}
                                        <dp-option-builder types-def="ctrl.actionsTypeDef"
                                                           save-target="ctrl.form.actions"
                                                           options="{tag_first: '', tag_after: 'then', fixedExpanded: ['SendUserEmail'], fixOn: []}"
                                                           option-types="actionOptionTypes"
                                                >
                                            <add-btn-label>Action</add-btn-label>
                                        </dp-option-builder>
                                    {% endif %}
                                    <span class="help-block">
                    Send the user an email when they have left their ticket open for some time. Typically these are alerts to tell the user to reply to their tickets, but you
                    can also perform other actions.
                  </span>
                                {% elseif num == 2 %}
                                    {% if app.hasBeta('email_templates') %}
                                        <dp-option-builder types-def="ctrl.actionsTypeDef" save-target="ctrl.form.actions"
                                                           options="{tag_first: '', tag_after: 'then', fixedExpanded: ['SendUserNewEmail'], fixOn: []}"
                                                           option-types="actionOptionTypes">
                                            <add-btn-label>Action</add-btn-label>
                                        </dp-option-builder>
                                     {% else %}
                                        <dp-option-builder types-def="ctrl.actionsTypeDef" save-target="ctrl.form.actions"
                                                           options="{tag_first: '', tag_after: 'then', fixedExpanded: ['SendUserEmail'], fixOn: []}"
                                                           option-types="actionOptionTypes">
                                            <add-btn-label>Action</add-btn-label>
                                        </dp-option-builder>
                                    {% endif %}
                                    <span class="help-block">
                    If the ticket is still open, send the user a second email alert reminding them of their open ticket.
                  </span>
                                {% else %}
                                    <dp-option-builder types-def="ctrl.actionsTypeDef" save-target="ctrl.form.actions"
                                                       options="{tag_first: '', tag_after: 'then', fixedExpanded: ['SetStatus'], fixOn: []}"
                                                       option-types="actionOptionTypes">
                                        <add-btn-label>Action</add-btn-label>
                                    </dp-option-builder>
                                    <span class="help-block">
                    If a ticket is still open after two email alerts, then usually you want to automatically resolve the ticket and you might want to perform other actions as well.
                  </span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </article>

        {% endfor %}

        <footer>
            <div class="dp-content">
                <div class="dp-btn-controls">
                    <div dp-hide-spinning="saving">
                        <button class="btn btn-primary"
                                ng-click="TicketStatusEdit.save()">{{ phrase('agent.general.save') }}</button>
                    </div>
                    <div dp-show-spinning="saving">
                        <i class="spinner-flat"></i>
                    </div>
                </div>
            </div>
        </footer>

    </section>

    <div dp-register-message="saved_settings">Settings saved successfully.</div>
{% endblock %}
