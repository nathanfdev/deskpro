{% extends 'AdminInterfaceBundle:Layout:list-editpane.html.twig' %}
{% block editpane_content %}
	<style>
		.picker {
			display: table-row;
			height: 25px;
			list-style: none;
		}
		.picker li {
			display: table-cell;
			width: 25px;
		}
		.picker-color {
			display: block;
			width: 25px;
			height: 25px;
			text-align: center;
			cursor: pointer;
		}
		label[for="picker-input"] {
			position: absolute;
			display: block;
			top: 6px;
			left: 20px;
			height: 20px;
			width: 20px;
			border-radius: 2px;
			cursor: pointer;
			z-index: 1;
		}
		#picker-input {
			padding-left: 30px;
		}
	</style>
	<form class="form-horizontal dp-form" role="form" name="form_props" ng-submit="form_props.$valid && CommunityStatusesEdit.saveCommunityStatus()">
		<section class="dp-paneblock dp-editpane">
			<article class="form-horizontal dp-form">
				<div class="panel panel-fill indent">
					<div class="panel-body">
						<div class="form-group">
							<div class="col-lg-3">
								<h3>{{ phrase('adm.community_statuses.title') }} *</h3>
							</div>
							<div class="col-lg-9">
								<div class="inner-group" dp-error-class="form_props.title">
									<input
											type="text"
											class="form-control"
											name="title"
											ng-model="CommunityStatusesEdit.community_status.title"
											dp-server-validation="title.not_blank,title.length"
											style="width: 50%;" autofocus required>
								<span class="help-block">
									{{ phrase('adm.community_statuses.title_explain') }}
								</span>
								</div>
							</div>
						</div>
						<div class="form-group">
							<div class="col-lg-3">
								<h3>{{ phrase('agent.general.color') }} *</h3>
							</div>
							<div class="col-lg-9">
								<div class="inner-group" dp-error-class="form_props.color">
									<label for="picker-input" style="background-color: {{ ng_var('CommunityStatusesEdit.community_status.color') }}"></label>
									<input
											id="picker-input"
											type="text"
											class="form-control"
											name="color"
											ng-model="CommunityStatusesEdit.community_status.color"
										    ng-focus="picker = true"
										    ng-blur="picker = false"
											style="width: 50%;">
									<div ng-show="picker" style="position: absolute;">
										<ul class="picker">
											<li ng-repeat="color in colors.slice(0, colors.length / 2)">
                                                    <span ng-mouseenter="CommunityStatusesEdit.community_status.color = color" class="picker-color" style="background-color: {{ ng_var('color') }}">
                                                    </span>
											</li>
										</ul>
										<ul class="picker">
											<li ng-repeat="color in colors.slice(colors.length / 2)">
                                                    <span ng-mouseenter="CommunityStatusesEdit.community_status.color = color" class="picker-color" style="background-color: {{ ng_var('color') }}">
                                                    </span>
											</li>
										</ul>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</article>
			<footer>
				<div class="dp-content">
					<div class="text-danger ng-hide" ng-show="form_props.$attempted && form_props.$invalid">
						<p><strong>{{ phrase('adm.general.please_correct_errors') }}</strong></p>
						<ul>
							<li ng-show="form_props.title.$error.required || form_props.title.$error.not_blank">
								{{ phrase('adm.community_statuses.title_error') }}
							</li>
							<li ng-show="form_props.title.$error.length">
								Title can't be less than 2 symbols
							</li>
						</ul>
					</div>

					<div class="dp-delete-control" ng-if="CommunityStatusesEdit.community_status.id"
                         ng-hide="form_props.$attempted && form_props.$invalid">
						<button class="btn btn-danger"
								ng-click="$event.preventDefault(); $parent.CommunityStatusesList.startDelete(CommunityStatusesEdit.community_status);">
							Delete
						</button>
					</div>

					<div class="dp-btn-controls" ng-hide="form_props.$attempted && form_props.$invalid">
						<div dp-hide-spinning="saving_community_status">
							<button class="btn btn-primary" dp-submit-form>{{ phrase('agent.general.save') }}</button>
						</div>
						<div dp-show-spinning="saving_community_status">
							<i class="spinner-flat"></i>
						</div>
					</div>
				</div>
			</footer>
		</section>
	</form>
	<div dp-register-message="saved_community_status">{{ ng_var('CommunityStatusesEdit.community_status.title') }} was saved successfully</div>
{% endblock %}
