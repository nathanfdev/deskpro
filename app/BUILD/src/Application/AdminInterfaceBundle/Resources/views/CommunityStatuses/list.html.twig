{% extends 'AdminInterfaceBundle:Layout:list.html.twig' %}
{% block listpane_content %}

	<section class="dp-paneblock dp-panelink">
		<a href="{{ ng_href('portal.community_settings') }}">
			<em><i class="fas fa-chevron-down"></i></em>
			<h3>Community Settings</h3>
		</a>
	</section>

	<section class="dp-paneblock dp-listpane">
		<header>
			<nav>
				<span dp-ping-flash="display_orders_active" class="far fa-check-square"></i> {{ phrase('agent.general.saved') }}</span>
				{% include 'AdminInterfaceBundle:Layout:standard-settings-menu.html.twig' %}
			</nav>
			<h3>{{ phrase('admin.community.community_statuses') }}</h3>
		</header>
		<article>
			<div class="dp-add-control">
			<h4 ng-pluralize count="CommunityStatusesList.community_active_statuses.length || 0" when="{{ ng_plural_phrase('adm.general.x_community_active_statuses') }}"></h4>
			</div>
			<ul class="dp-item-list" ui-sortable="CommunityStatusesList.sortedListOptions">
				<li class="with-drag-handle" ng-repeat="status in CommunityStatusesList.community_active_statuses" dp-state-mark="portal.community_statuses.edit.{{ ng_var('status.id') }}" data-id="{{ ng_var('status.id') }}" ng-if="status.brand == brand_id">
					<a href="{{ ng_href('portal.community_statuses.edit', '{id: status.id}') }}">
						<i class="fas fa-bars drag-handle"></i>
						<h4><span class="title-text">{{ ng_var('status.title') }}</span></h4>
					</a>
				</li>
			</ul>
			<div class="dp-add-control">
				<a class="btn btn-default" ng-class="{'active': isStateActive('.create', {type: activeType}) }" href="{{ ng_href('portal.community_statuses.gocreate', '{type: activeType}') }}"><i class="fas fa-plus"></i> {{ phrase('agent.general.add') }}</a>
			</div>
		</article>
		<article>
			<div class="dp-add-control">
				<h4 ng-pluralize count="CommunityStatusesList.community_closed_statuses.length || 0" when="{{ ng_plural_phrase('adm.general.x_community_closed_statuses') }}"></h4>
			</div>
			<ul class="dp-item-list" ui-sortable="CommunityStatusesList.sortedListOptions">
				<li class="with-drag-handle" ng-repeat="status in CommunityStatusesList.community_closed_statuses" dp-state-mark="portal.community_statuses.edit.{{ ng_var('status.id') }}" data-id="{{ ng_var('status.id') }}" ng-if="status.brand == brand_id">
					<a href="{{ ng_href('portal.community_statuses.edit', '{id: status.id}') }}">
						<i class="fas fa-bars drag-handle"></i>
						<h4><span class="title-id" title="ID">#{{ ng_var('status.id') }}</span> <span class="title-text">{{ ng_var('status.title') }}</span></h4>
					</a>
				</li>
			</ul>
			<div class="dp-add-control">
				<a class="btn btn-default" ng-class="{'active': isStateActive('.create', {type: closedType}) }" href="{{ ng_href('portal.community_statuses.gocreate', '{type: closedType}') }}"><i class="fas fa-plus"></i> {{ phrase('agent.general.add') }}</a>
			</div>
		</article>
	</section>

	<section class="dp-paneblock dp-panelink">
		<a href="{{ ng_href('portal.community_forums') }}">
			<em><i class="fas fa-chevron-down"></i></em>
			<h3>Community Forums</h3>
		</a>
	</section>
	<section class="dp-paneblock dp-panelink">
		<a href="{{ ng_href('portal.community_categories') }}">
			<em><i class="fas fa-chevron-down"></i></em>
			<h3>Community Categories</h3>
		</a>
	</section>
	<section class="dp-paneblock dp-panelink">
		<a href="{{ ng_href('portal.community_labels') }}">
			<em><i class="fas fa-chevron-down"></i></em>
			<h3>Community Topics Labels</h3>
		</a>
	</section>

	<div dp-register-message="saved_settings">{{ phrase('adm.general.save_settings_success') }}</div>
	<div dp-register-message="no_delete_last">{{ phrase('adm.community_statuses.no_delete_last') }}</div>
{% endblock %}
{% block listpane_help %}
	<header>
		<h1>Each community topic has a status which tracks what your company is doing with it.</h1>
		<p>Customize the statuses here. Click to edit, or drag to change the order in which they are displayed to users and agents.</p>
	</header>
	<article>
		<section>
			<p><strong>Active</strong> statuses mean your company is considering or implementing the topic. Active statuses are visible to users on the web portal.</p>
			<p><strong>Closed</strong> statuses mean you are not going to act on the topic further: either because you've rejected it, or because you've already implemented it. Community topics with closed statuses are not displayed on the portal.</p>
		</section>
		<section>
		<h2><span>FAQ</span></h2>
		<dl>
			<dt><em>Q:</em>Where are the settings for the survey where users rate support after a ticket resolution or chat?</dt>
			<dd><em>A:</em>
				This survey is part of the <strong>Satisfaction</strong> feature, which is a separate system from <strong>Community</strong>. Go to <a href="agent/#admin:tickets/satisfaction">Tickets > Satisfaction</a> to manage this feature.
			</dd>
		</dl>
		</section>
		<section class="related-content">
			<h2><span>Related Content</span></h2>
			<ul>
			<li><i class="fas fa-book"></i> <a href="https://support.deskpro.com/guides/topic/276" target="_blank">Community</a></li>
			</ul>
	</section>
	</article>
{% endblock %}
