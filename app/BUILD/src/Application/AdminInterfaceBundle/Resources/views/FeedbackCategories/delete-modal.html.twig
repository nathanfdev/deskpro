<div>
	<div class="modal-header">
		<button type="button" class="close" ng-click="dismiss()">&times;</button>
		<h4 class="modal-title">{{ phrase('adm.feedback_categories.delete_feedback_category') }}</h4>
	</div>
	<div class="modal-body">
		<p>
			{{ phrase('adm.feedback_categories.delete_feedback_category_confirm') }}
		</p>

		<p ng-if="move_community_channels_list">
			{{ phrase('adm.feedback_categories.delete_feedback_categories_moved') }}
		</p>

		<p style="margin-bottom: 0;" ng-if="move_community_channels_list">
			<select ui-select2 ng-model="model.move_to" style="width: 240px">
				<option value="{{ ng_var('channel.id') }}" ng-repeat="channel in move_community_channels_list">
                    {{ ng_var('channel.title') }}
                </option>
			</select>
		</p>
	</div>
	<div class="modal-footer">
		<button class="btn btn-success" ng-click="dismiss()"><i class="fas fa-undo-alt"></i> {{ phrase('agent.general.cancel') }}</button>
		<button class="btn btn-danger" ng-click="confirm()"><i class="far fa-trash-alt"></i> {{ phrase('agent.general.delete') }}</button>
	</div>
</div>
