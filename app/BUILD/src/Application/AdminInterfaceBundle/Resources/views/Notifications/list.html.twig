{% extends 'AdminInterfaceBundle:Layout:fullpage-pane.html.twig' %}
{% block fullpane_content %}
    <div class="form-horizontal dp-form">
        <section class="dp-paneblock dp-listpane">
            <header>
                <h3>About Notifications</h3>
            </header>
            <div class="panel panel-innertable" style="margin-top: 0;">
                <p>
                    If you want to use Pusher to deliver you notifications and make them more "real time" please enable it below. <br/>
                    In future we will provide you with flexible interface where you would able to fine tune any notifications and choose separate delivery options for each of them.

                </p>
            </div>
        </section>
        <section class="dp-paneblock dp-listpane">
            <header>
                <h3>
                    Pusher
                </h3>
                <input dp-slider-switch ng-model="pusher_enabled" />
            </header>
            <div ng-show="pusher_enabled">
                <div class="inner-group">
                    <label>
                        <h4>Pusher app key:</h4>
                        <input type="text" class="form-control" ng-model="key" />
                    </label>
                </div>
                <div class="inner-group">
                    <label>
                        <h4>Pusher app secret:</h4>
                        <input type="text" class="form-control" ng-model="secret" />
                    </label>
                </div>
                <div class="inner-group">
                    <label>
                        <h4>Pusher app id:</h4>

                        <input type="text" class="form-control" ng-model="id" />
                    </label>
                </div>
                <div class="inner-group">
                    <button class="btn btn-success" ng-click="Notifications.save()">Save</button>
                </div>
            </div>

        </section>
{% endblock %}