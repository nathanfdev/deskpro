{% extends 'AdminInterfaceBundle:Layout:list.html.twig' %}
{% block listpane_content %}
    <section class="dp-paneblock dp-listpane">
        <header>
            <h3>{{ phrase('admin.tickets.approval_types') }}</h3>
        </header>
        <article>
            <ul class="dp-item-list" dp-list-autoload>
                <li ng-repeat="type in TicketApprovalsList.types" dp-state-mark="tickets.approvals.type-{{ ng_var('type.id') }}">
                    <a href="{{ ng_href('tickets.approvals.type_edit', "{id: 'type-' + type.id}") }}">
                        {{ ng_var('type.name') }}
                    </a>
                </li>
            </ul>
        </article>
        <article>
            <div class="dp-add-control">
                <a class="btn btn-default"
                   href="{{ ng_href('tickets.approvals.type_gocreate') }}"
                   ng-class="{'active': isStateActive('.create') }"
                >
                    <i class="fas fa-plus"></i>
                    Add Approval Type
                </a>
            </div>
        </article>
    </section>

    <section class="dp-paneblock dp-listpane">
        <header>
            <h3>{{ phrase('admin.tickets.approval_templates') }}</h3>
        </header>
        <article>
            <ul class="dp-item-list" dp-list-autoload>
                <li ng-repeat="template in TicketApprovalsList.templates" dp-state-mark="tickets.approvals.template-{{ ng_var('template.id') }}">
                    <a href="{{ ng_href('tickets.approvals.template_edit', "{id: 'template-' + template.id}") }}">
                        {{ ng_var('template.title') }}
                    </a>
                </li>
            </ul>
        </article>
        <article>
            <div class="dp-add-control">
                <a class="btn btn-default"
                   href="{{ ng_href('tickets.approvals.template_gocreate') }}"
                   ng-class="{'active': isStateActive('.create') }"
                >
                    <i class="fas fa-plus"></i>
                    Add Approval Template
                </a>
            </div>
        </article>
    </section>

{% endblock %}
