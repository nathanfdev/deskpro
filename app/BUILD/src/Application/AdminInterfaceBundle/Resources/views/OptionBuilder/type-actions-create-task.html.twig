<dp-optionbuilder-row>
	<div class="dp-ob-standard-row">
		<table class="display-table">
			<tr>
				<td class="nowrap" width="50"><label class="row-label">Create Task</label></td>
				<td ng-show="rowOpts.rowEnabled" class="row-options">
					<table class="display-table spaced" width="100%">
						<tr>
							<td style="vertical-align: top; white-space: nowrap" nowrap width="100">
                               Task Title:
                            </td>
							<td>
								<input type="text" ng-model="model.title" class="form-control" />
							</td>
                        </tr>
                        <tr>
                            <td>Due Date</td>
                            <td>
                                <label><input type="radio" ng-model="model.due_type" value="none"> None</label>
                                <label><input type="radio" ng-model="model.due_type" value="rel"> Relative time</label>
                                <label><input type="radio" ng-model="model.due_type" value="abs"> On a specific date</label>
                            </td>
                        </tr>
                        <tr ng-show="model.due_type === 'rel'">
                            <td></td>
                            <td>
                                <input type="number" ng-min="0" ng-model="model.due_rel_period">
                                <select name="due-rel-unit" ng-model="model.due_rel_unit">
                                  <option value="min">Minute(s) later</option>
                                  <option value="hour">Hour(s) later</option>
                                  <option value="day">Day(s) later</option>
                                  <option value="week">Week(s) later</option>
                                </select>
                            </td>
                        </tr>
                        <tr ng-show="model.due_type === 'abs'">
                            <td></td>
                            <td>
                                <input type="text" class="form-control" style="width: 140px; display: inline-block;"
                                       ng-model="model.date_due"
                                       dp-datetime-popup="DD MMMM YYYY"
		                                />
                                <select ui-select2="{dropdownAutoWidth:true}" ng-model="model.offset"
                                        style="min-width: 200px;" placeholder="Timezone Offset">
                                    <option ng-repeat="tz in model.timezones" value="{{ ng_var('tz.id') }}">{{ ng_var('tz.title') }}</option>
                                </select>
                            </td>
                        </tr>
                        <tr>
                            <td style="vertical-align: top; white-space: nowrap" nowrap width="100">
                                Public:
                            </td>
                            <td>
                                <label>
                                    <input type="checkbox" ng-model="model.public" /> Yes
                                </label>
                            </td>
                        </tr>
                        <tr>
                            <td style="vertical-align: top; white-space: nowrap" nowrap width="100">
                                Creator:
                            </td>
                            <td>
                                <select ui-select2="{dropdownAutoWidth:true}" ng-model="model.creator"
                                        style="min-width: 200px;">
                                    <option ng-repeat="agent in model.agents"
                                            value="{{ ng_var('agent.id') }}">{{ ng_var('agent.display_name') }}</option>
                                </select>
                            </td>
                        </tr>
                        <tr>
                            <td style="vertical-align: top; white-space: nowrap" nowrap width="100">
                                Assignee:
                            </td>
                            <td>
                                <select ui-select2="{dropdownAutoWidth:true}" ng-model="model.assignee"
                                        style="min-width: 200px;">
                                    <optgroup label="Agents">
                                        <option ng-repeat="agent in model.agents"
                                                value="agent:{{ ng_var('agent.id') }}">{{ ng_var('agent.display_name') }}</option>
                                    </optgroup>
                                    <optgroup label="Teams">
                                        <option ng-repeat="team in model.teams"
                                                value="team:{{ ng_var('team.id') }}">{{ ng_var('team.name') }}</option>
                                    </optgroup>
                                </select>
                            </td>
                        </tr>
                        <tr>
                            <td style="vertical-align: top; white-space: nowrap" nowrap width="100">
                                Link to ticket:
                            </td>
                            <td>
                                <label>
                                    <input type="checkbox" ng-model="model.link" /> Yes
                                </label>
                            </td>
                        </tr>
					</table>
				</td>
			</tr>
		</table>
	</div>
</dp-optionbuilder-row>
