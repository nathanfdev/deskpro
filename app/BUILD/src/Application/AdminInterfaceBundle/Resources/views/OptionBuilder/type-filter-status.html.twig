{% macro substatuses_options(status_type, parent_title, ngIf) %}
  <option
    {% if ngIf %} ng-if="{{ ngIf }}"{% endif %}
    value="{{ ng_var('opt.status_code') }}"
    ng-repeat="opt in options | filter:{status_type:'{{status_type}}'}">
      {% if parent_title %}{{ parent_title }}&nbsp;>&nbsp;{% endif %}{{ ng_var('opt.title') }}
  </option>
{% endmacro %}
{% import _self as self_macro %}

<dp-optionbuilder-row>
	<div class="dp-ob-standard-row">
		<table class="display-table" width="100%">
			<tr>
				<td width="80" class="nowrap" style="padding-right: 8px;"><label>{{ ng_var('type_title') }}</label></td>
				<td>
                    <select ui-select2="{dropdownAutoWidth:true}" ng-model="model.op" style="min-width: 50px;">
                        <option value="is">is</option>
                        <option value="not">is not</option>
                    </select>
					<select ui-select2 ng-model="model.value" style="min-width: 140px" multiple="multiple">
						<option value="awaiting_agent">Awaiting Agent</option>
              {{ self_macro.substatuses_options('awaiting_agent', phrase('agent.tickets.status_awaiting_agent')) }}
						<option value="awaiting_user">Awaiting User</option>
              {{ self_macro.substatuses_options('awaiting_user', phrase('agent.tickets.status_awaiting_user')) }}
						<option value="resolved">Resolved</option>
              {{ self_macro.substatuses_options('resolved', phrase('agent.tickets.status_resolved')) }}
						<option value="archived" ng-if="!fieldOptions.noArchive">Archived</option>
              {{ self_macro.substatuses_options('archived', phrase('agent.tickets.status_archived'), '!fieldOptions.noArchive') }}
						<optgroup label="Hidden">
              {{ self_macro.substatuses_options('hidden') }}
						</optgroup>
					</select>
				</td>
			</tr>
		</table>
	</div>
</dp-optionbuilder-row>
