{% import 'AdminInterfaceBundle:OptionBuilder:type-filter-status.html.twig' as _macro %}

<dp-optionbuilder-row>
	<div class="dp-ob-standard-row">
		<table class="display-table">
			<tr>
				<td class="nowrap" style="padding-right: 8px;"><label class="row-label">{{ ng_var('type_title') }}</label></td>
				<td ng-show="rowOpts.rowEnabled" width="100%" class="row-options">
					<select ui-select2="{dropdownAutoWidth:true}" ng-model="model.op" style="min-width: 50px;">
						<option value="is">is</option>
						<option value="not">is not</option>
						<option value="changed">changed</option>
						<option value="changed_to">changed to</option>
						<option value="changed_from">changed from</option>
					</select>
					<select ng-if="model.op != 'changed'" ui-select2 ng-model="model.value" style="min-width: 260px" multiple>
						<option value="awaiting_agent">{{ phrase('agent.tickets.status_awaiting_agent') }}</option>
              {{ _macro.substatuses_options('awaiting_agent', phrase('agent.tickets.status_awaiting_agent')) }}
						<option value="awaiting_user">{{ phrase('agent.tickets.status_awaiting_user') }}</option>
              {{ _macro.substatuses_options('awaiting_user', phrase('agent.tickets.status_awaiting_user')) }}
						<option value="resolved">{{ phrase('agent.tickets.status_resolved') }}</option>
              {{ _macro.substatuses_options('resolved', phrase('agent.tickets.status_resolved')) }}
						<option value="archived">{{ phrase('agent.tickets.status_archived') }}</option>
              {{ _macro.substatuses_options('archived', phrase('agent.tickets.status_archived')) }}
						<optgroup label="{{ phrase('agent.tickets.status_hidden') }}">
              {{ _macro.substatuses_options('hidden') }}
						</optgroup>
					</select>
				</td>
			</tr>
		</table>
	</div>
</dp-optionbuilder-row>
