<dp-optionbuilder-row>
	<div class="dp-ob-standard-row">
		<table class="display-table">
			<tr>
				<td class="nowrap"><label class="row-label">Send Agent Email</label></td>
				<td ng-show="rowOpts.rowEnabled" class="row-options">
					<table class="display-table spaced">
						<tr>
							<td>Template:</td>
							<td>
								<select ng-if="!is_creating" ui-select2="{dropdownAutoWidth:true}" ng-model="model.template" style="min-width: 50px;" ng-init="model.template = model.template || 'SendmailBundle:emails_agent:ticket_new.html.twig'" ng-change="handleTemplateChange()">
									<optgroup label="Standard Agent Emails">
										{% for email,label in {
											'SendmailBundle:emails_agent:ticket_new.html.twig': 'New Ticket Notification',
											'SendmailBundle:emails_agent:ticket_update.html.twig': 'Ticket Updated Notification',
											'SendmailBundle:emails_agent:ticket_reply.html.twig': 'New Reply'
										} %}
											<option value="{{ email }}">{{ label }}</option>
										{% endfor %}
									</optgroup>
									<optgroup label="Custom Emails">
										<option ng-repeat="tpl in new_custom_email_tpls" value="{{ ng_var('tpl.name') }}">{{ ng_var('tpl.title') }}</option>
										<option value="CREATE">Create a new template...</option>
									</optgroup>
								</select>
								<span ng-if="is_creating">Creating a new template</span>
								<span ng-if="!is_creating && model.template" style="margin-left: 3px;">
									<a class="inline-edit-link expanded" ng-click="editTemplate()">
										<i class="fas fa-pencil-alt"></i>
										<em>edit template</em>
									</a>
								</span>
							</td>
						</tr>
						<tr>
							<td style="vertical-align: top;">Agents:</td>
							<td>
								<ul class="checkbox-list" style="min-width: 260px; max-height: 175px; overflow: auto;">
									<li style="border-bottom: 1px solid #ccc;" ng-if="object_type != 'escalation'">
										<label>
											<input type="checkbox" ng-model="model.agent_ids.notify_list" />
											Subscribed agents
											<i style="color: #aaa;" class="fa fa-question-circle" tooltip="All agents have notification subscription preferences. This option will send the email to any agent who is subscribed to whatever action initiated this event. For example, if this action was fired via a new ticket, then this option will send an email to any agent subscribed to 'new tickets'."></i>
										</label>
									</li>
									<li ng-repeat="agent in agents">
										<label>
											<input type="checkbox" ng-model="model.agent_ids[agent.id]" />
											{{ ng_var('agent.display_name') }}
										</label>
									</li>
									<li style="border-top: 1px solid #ccc;">
										<label>
											<input type="checkbox" ng-model="model.agent_ids.ticket_agent" />
											Assigned Agent
										</label>
									</li>
									<li>
										<label>
											<input type="checkbox" ng-model="model.agent_ids.ticket_team" />
											Agents of Assigned Team
										</label>
									</li>
									<li>
										<label>
											<input type="checkbox" ng-model="model.agent_ids.ticket_followers" />
											Ticket Followers
										</label>
									</li>
									<li>
										<label>
											<input type="checkbox" ng-model="model.agent_ids.ticket_follower_teams" />
											Teams of Ticket Followers
										</label>
									</li>
									<li ng-if="object_type != 'escalation'">
										<label>
											<input type="checkbox" ng-model="model.agent_ids.person" />
											Agent Performer
											<i style="color: #aaa;" class="fa fa-question-circle" tooltip="Send the email to the agent that caused this trigger to run."></i>
										</label>
									</li>
									<li ng-if="object_type != 'escalation'">
										<label>
											<input type="checkbox" ng-model="model.agent_ids.person_team" />
											Teams of Agent Performer
											<i style="color: #aaa;" class="fa fa-question-circle" tooltip="Send the email to the teams of the agent that caused this trigger to run."></i>
										</label>
									</li>
                                    <li ng-if="object_type != 'escalation'">
                                        <label>
                                            <input type="checkbox" ng-model="model.agent_ids.all_agents" />
                                            All Agents
                                            <i style="color: #aaa;" class="fa fa-question-circle" tooltip="Send the email to all agents."></i>
                                        </label>
                                    </li>
								</ul>
							</td>
						</tr>
						<tr>
							<td>From Name:</td>
							<td>
								<select ui-select2="{dropdownAutoWidth:true}" ng-model="model.from_name" ng-init="" style="min-width: 50px;">
									<option value="performer" ng-if="object_type != 'escalation'">Name of the person who initiated the action</option>
									<option value="helpdesk_name">Helpdesk Name ({{ brand_setting('core.deskpro_name')|e }})</option>
									{% if brand_setting('core.site_name') %}<option value="site_name">Site Name ({{ brand_setting('core.site_name') }})</option>{% endif %}
									<option value="custom">Enter a custom name</option>
								</select>
								<div style="padding-top: 3px; width: 250px;">
									<input type="text" class="form-control" ng-model="model.from_name_custom" ng-show="model.from_name == 'custom'" />
								</div>
							</td>
						</tr>
						<tr>
							<td>From Email:</td>
							<td>
								<select ui-select2="{dropdownAutoWidth:true}" ng-model="model.from_account" ng-init="" style="min-width: 50px;">
									<optgroup label="Default">
										<option value="0">The account set on the ticket</option>
									</optgroup>
									<optgroup label="Specific account">
										<option ng-repeat="acc in email_accounts" value="{{ ng_var('acc.id') }}">{{ ng_var('acc.address') }}</option>
									</optgroup>
								</select>
							</td>
						</tr>

                        {% include 'AdminInterfaceBundle:OptionBuilder:email-headers.html.twig' %}

					</table>
				</td>
			</tr>
		</table>
	</div>
</dp-optionbuilder-row>
