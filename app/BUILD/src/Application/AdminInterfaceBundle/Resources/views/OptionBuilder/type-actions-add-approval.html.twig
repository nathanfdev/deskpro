{% import 'AdminInterfaceBundle:OptionBuilder:type-filter-status.html.twig' as _macro %}

<dp-optionbuilder-row>
    <div class="dp-ob-standard-row">
        <table class="display-table">
            <tr>
                <td width="60" class="nowrap" style="padding-right: 8px;"><label class="row-label">{{ ng_var('type_title') }}</label></td>
                <td>
                    <table class="display-table spaced" width="100%">
                        <tr>
                            <td>{{ phrase('admin.tickets.approval_template') }}</td>
                        </tr>
                        <tr>
                            <td>
                                <select ui-select2="{dropdownAutoWidth:true}" ng-model="model.approval_template_id" style="min-width: 140px">
                                    <option value="{{ ng_var('opt.id') }}" ng-repeat="opt in model.approval_template_options">{{ ng_var('opt.name') }}</option>
                                </select>
                            </td>
                        </tr>
                        <tr>
                            <td>{{ phrase('admin.tickets.approval_description') }}</td>
                        </tr>
                        <tr>
                            <td>
                                <textarea ng-readonly="model.has_description" type="text" ng-model="model.description" class="form-control" style="width: 90%; height: 100px; font-family: Monaco, Consolas, monospace; font-size: 11px;"></textarea>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </div>
</dp-optionbuilder-row>
