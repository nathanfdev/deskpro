{% extends 'AdminInterfaceBundle:Layout:fill-page-alt.html.twig' %}
{% block alt_content %}
	<div class="dp-appalt-section">
		<header>
            <h2 style="width: 100%;">
                Agents
                <button class="btn btn-default btn-xs pull-right" ng-click="Home.$modal.open({ templateUrl: Home.getTemplatePath('Agents/import.html') })">
                    {{ phrase('agent.general.add_bulk') }}
                </button>
            </h2>
        </header>
		<section ng-if="Home.online_agents.length">
			<header><h3>Online</h3></header>
			<article>
				<ul class="dp-icon-list with-icons x22">
					<li class="media" ng-repeat="agent in Home.online_agents">
						<i class="icon-img" bg-img="agent.picture_url_22"></i>
						<a href="{{ ng_href('agents.agents.edit', '{id:agent.id}') }}"><span class="title">{{ ng_var('agent.display_name') }}</span></a>
					</li>
				</ul>
			</article>
		</section>

		<section ng-if="Home.offline_agents.length">
			<header><h3>Offline</h3></header>
			<article>
				<ul class="dp-icon-list with-icons x22">
					<li class="media" ng-repeat="agent in Home.offline_agents">
						<i class="icon-img" bg-img="agent.picture_url_22"></i>
						<a href="{{ ng_href('agents.agents.edit', '{id:agent.id}') }}"><span class="title">{{ ng_var('agent.display_name') }}</span></a>
					</li>
				</ul>
			</article>
		</section>

        <section ng-if="Home.unactive_agents.length">
            <header><h3>Never Logged In</h3></header>
            <article>
                <ul class="dp-icon-list with-icons x22">
                    <li class="media" ng-repeat="agent in Home.unactive_agents">
                        <i class="icon-img" bg-img="agent.picture_url_22"></i>
                        <a href="{{ ng_href('agents.agents.edit', '{id:agent.id}') }}"><span class="title">{{ ng_var('agent.display_name') }}</span></a>
                    </li>
                </ul>
            </article>
        </section>
	</div>

	<div class="dp-appalt-section">
		<header>
            <h2 style="width: 100%;">
                Invite Agent
                <button class="btn btn-default btn-xs pull-right" ng-click="Home.$modal.open({ templateUrl: Home.getTemplatePath('Agents/import.html') })">
                    {{ phrase('agent.general.add_bulk') }}
                </button>
            </h2>
        </header>
		<section>
			<article>
				<form>
					<div class="form-group">
						<input type="text" class="form-control" ng-model="new_agent.name" placeholder="Name" ng-change="new_agent.errors.name = false" />
						<span ng-show="new_agent.errors.name" class="text-danger">Please enter a name.</span>
					</div>
					<div class="form-group">
						<input type="email" class="form-control" ng-model="new_agent.email" placeholder="Email" ng-change="new_agent.errors.email = false" />
						<span ng-show="new_agent.errors.email" class="text-danger">Please enter a valid email address.</span>
					</div>
					<div dp-hide-spinning="saving_new_agent">
						<button class="btn btn-default" ng-click="$event.preventDefault(); Home.addNewAgent();">Add Agent</button>
					</div>
					<div dp-show-spinning="saving_new_agent">
						<i class="spinner-flat"></i>
					</div>
					<div class="alert alert-success" style="margin-top: 8px;" ng-show="created_agent">
						<p>
							An agent account for {{ ng_var('created_agent.name') }} was created successfully.
						</p>
						<p>
							An email with login instructions has been sent to {{ ng_var('created_agent.email') }}.
						</p>
					</div>
				</form>
			</article>
		</section>
	</div>
{% endblock %}
{% block fillpage_content %}

	<div ng-if="Home.last_login" class="alert alert-info">
		Welcome back, {{ app.user.display_name }}.
		You last logged in <span title="{{ ng_var('Home.last_login.date_created') }}" am-time-ago="Home.last_login.date_created_d"></span>
		from {{ ng_var('Home.last_login.ip_address') }}<span ng-if="Home.last_login.hostname != Home.last_login.ip_address"> ({{ ng_var('Home.last_login.hostname') }})</span>.
		<a href="{{ ng_href('agents.login_log') }}">View login logs &rarr;</a>
	</div>

	<div style="margin: 15px 15px 0 15px" ng-if="readable_config">
		<div class="alert alert-danger" style="margin-bottom: 0; position: relative; border-width: 10px; border-color: #f00;">
			<div style="float:left">
				<i class="fa fa-exclamation-circle" style="font-size: 40px;"></i>
			</div>
			<div style="margin-left: 50px;">
				<h3 style="margin-top: 8px;">
				  <span style="display: inline-block; border-bottom: 2px dotted #f00;">
					DANGER: Your web root contains Deskpro source files
				  </span>
				</h3>
				<p>
				  Your web server is not configured properly. We have detected source files that are world-readable.
				</p>
				<p>
				  This is a CRITICAL vulnerability in the way your web server is configured. This could result in leaking of very important details such as your database host and password, log files and other sensitive information like emails or attachments.
				</p>
				<p>
				  Do not ignore this notice. This requires IMMEDIATE attention from an administrator.
				</p>
			</div>
		</div>
	</div>

	<div style="margin: 15px" ng-if="missed_fk_found">
		<div class="alert alert-warning" style="margin-bottom: 0; position: relative;">
			<div style="float:left">
				<i class="fa fa-exclamation-circle" style="font-size: 40px;"></i>
			</div>
			<div style="margin-left: 50px;">
				<p>
					The system has detected that your database schema has one or more differences from the default.
					These differences are most likely trivial and can usually be ignored. But in some rare cases,
					this can be a sign of data corruption. It is highly recommended you check your schema with the
					automated schema maintenance tool as described here:
					<a href="https://support.deskpro.com/kb/articles/665" target="_blank">https://support.deskpro.com/kb/articles/665</a>
				</p>
			</div>
		</div>
	</div>

	<div style="margin: 15px 15px 0 15px" ng-if="missconfigured_web_root">
		<div class="alert alert-danger" style="margin-bottom: 0; position: relative; border-width: 10px; border-color: #f00;">
			<div style="float:left">
				<i class="fa fa-exclamation-circle" style="font-size: 40px;"></i>
			</div>
			<div style="margin-left: 50px;">
				<h3 style="margin-top: 8px;">
				  <span style="display: inline-block; border-bottom: 2px dotted #f00;">
					DANGER: You have missconfigured web root
				  </span>
				</h3>
				<p>
					Your web server is not configured properly. We have detected that you our test url is not handled by helpdesk system.
				</p>
				<p>
					This is a CRITICAL vulnerability in the way your web server is configured. This could result in leaking of very important details such as your database host and password, log files and other sensitive information like emails or attachments.
				</p>
				<p>
					Do not ignore this notice. This requires IMMEDIATE attention from an administrator.
				</p>
			</div>
		</div>
	</div>

	<div style="margin: 15px 15px 0 15px" ng-if="!valid_url">
		<div class="alert alert-danger">
			<div style="float:left">
				<i class="fa fa-exclamation-circle" style="font-size: 40px;"></i>
			</div>
			<div style="margin-left: 50px;">
				<h3 style="margin-top: 8px;">
					Your web server appears to be misconfigured. The URL in your browser does not match the URI the server thinks it is.
				</h3>
				<p>
					This is most commonly an issue with proxy servers and missing headers. Please refer to
					<a href="https://support.deskpro.com/en/kb/articles/176" target="_blank">
						this article
					</a>.
				</p>
			</div>
		</div>
	</div>

	<div style="margin: 15px" ng-if="http_method_errors">
		<div class="alert alert-danger" style="margin-bottom: 0; position: relative;">
			<div style="float:left">
				<i class="fa fa-exclamation-circle" style="font-size: 40px;"></i>
			</div>
			<div style="margin-left: 50px;">
				<h3 style="margin-top: 8px;">Some HTTP methods are being blocked by your server</h3>
				<p>
					Deskpro must handle multiple HTTP methods (GET, POST, PUT and DELETE). It appears
					as though your server is blocking some of these requests:
				</p>
				<ul>
					<li>GET <span class="label label-success" ng-show="http_method_checks.get">OK</span><span class="label label-danger" ng-show="!http_method_checks.get">FAILED</span></li>
					<li>POST <span class="label label-success" ng-show="http_method_checks.post">OK</span><span class="label label-danger" ng-show="!http_method_checks.post">FAILED</span></li>
					<li>PUT <span class="label label-success" ng-show="http_method_checks.put">OK</span><span class="label label-danger" ng-show="!http_method_checks.put">FAILED</span></li>
					<li>DELETE <span class="label label-success" ng-show="http_method_checks.delete">OK</span><span class="label label-danger" ng-show="!http_method_checks.delete">FAILED</span></li>
				</ul>
				<p>
					You must edit your server configuration to allow these HTTP methods. If you fail to fix this problem, many parts of the interface
					will not function.
				</p>
				{% if get_instance_ability('is_windows') %}
				<p>
					If you are using IIS, refer to our knowledgebase article: <a href="https://support.deskpro.com/kb/articles/210" target="_blank">Configuring HTTP verbs on IIS</a>
				</p>
				{% endif %}
			</div>
		</div>
	</div>

	<div class="dp-dashboard">
		<table cellspacing="15" width="100%">
			<tr>
				{# DESKRPO UPDATES #}
                {% if not app.getSetting('disable_admin_deskpro_updates') %}
                    <td width="50%" class="dp-item" ng-class="{'with-error': Home.latest_version_status == 'okay' && Home.latest_version.count_behind > 0 }">
                        <header>
                            <h3>Deskpro Updates</h3>
                        </header>
                        <article style="padding: 10px;">
                            <p>
                                You are currently using Deskpro version <strong>{{ ng_var('Home.version_info.build_name') }}</strong>.
                            </p>
                            <div class="status-content" ng-if="Home.latest_version_status == 'okay' && Home.latest_version.count_behind > 0">
                                <header>
                                    <div class="icon bad"><i class="fas fa-exclamation-triangle"></i></div>
                                    <strong>
                                        The latest version is {{ ng_var('Home.latest_version.build_name') }}.
                                        Your version is <a href="http://support.deskpro.com/news/1" target="_blank">{{ ng_var('Home.latest_version.days_old') }} day(s) old</a>.<br/>
                                    </strong>
                                </header>
                                <article>
                                    <p>
                                        <a class="btn btn-primary" href="{{ ng_href('setup.updater') }}">Update Deskpro Now &rarr;</a>
                                    </p>
                                </article>
                            </div>
                            <div class="status-content" ng-if="Home.latest_version_status == 'okay' && Home.latest_version.count_behind == 0">
                                <header>
                                    <div class="icon okay"><i class="fa fa-check"></i></div>
                                    <strong>You are up to date!</strong>
                                </header>
                            </div>
                            <div ng-show="Home.news_status == 'okay'" class="news-content">
                                <strong>News</strong>
                                <ul>
                                    <li ng-repeat="item in Home.news">
                                        <i class="fa fa-caret-right"></i>
                                        <a ng-href="{{ ng_var('item.link') }}" target="_blank">{{ ng_var('item.title') }}</a>
                                    </li>
                                </ul>
                            </div>
                        </article>
                    </td>
                {% endif %}

				{# HELP #}
				<td class="dp-item" {% if app.getSetting('disable_admin_deskpro_updates') %}colspan="2"{% endif %}>
					<header>
						<h3>Getting Help</h3>
					</header>
					<article>
						<div class="dp-mpadded">
							&bull; Visit the <a href="http://support.deskpro.com/">Deskpro Knowledgebase</a> for how-to articles, troubleshooting guides and other help articles.
						</div>
						<div class="dp-mpadded">
							&bull; Browse our manuals for in-depth information:
							<span style="display: inline-block; margin-left: 4px;"><i class="fa fa-book"></i> <a href="https://support.deskpro.com/guides/admin-guide/" target="_blank">Admin Manual</a></span>
							<span style="display: inline-block; margin-left: 4px;"><i class="fa fa-book"></i> <a href="https://support.deskpro.com/guides/agent-guide/" target="_blank">Agent Manual</a></span>
						</div>
					</article>

					<header>
						<h3>Contact Us</h3>
					</header>
					<article>
						<div class="dp-mpadded">
							<div class="form-group">
								<input type="text" class="form-control" ng-model="submit_ticket.subject" required placeholder="Enter a subject for your message" />
							</div>
							<div class="form-group">
								<textarea class="form-control" style="height: 80px;" ng-model="submit_ticket.message" placeholder="Enter your question here" ng-change="submit_ticket_message_error = false"></textarea>
								<span ng-show="submit_ticket_message_error" class="text-danger">Please enter a message</span>
							</div>
						</div>
						<div class="dp-mpadded">
							<div ng-hide="support_sent">
								<div dp-hide-spinning="sending_support_request">
									<button class="btn btn-default" ng-click="$event.preventDefault(); Home.sendSupportRequest();"><i class="far fa-envelope"></i> Send Message</button>
									&nbsp;&nbsp;&nbsp;
									<div style="display: inline-block" ng-show="submit_ticket_defaultemail" ng-init="submit_ticket_defaultemail = true">
										We will reply to <strong>{{ app.user.primary_email_address }}</strong>.
										<a href="#" ng-click="submit_ticket_defaultemail = false">Change?</a>
									</div>
									<div style="display: inline-block" ng-hide="submit_ticket_defaultemail">
										Reply To:
										<input type="email" class="form-control" style="padding: 2px 4px; margin: 0; height: auto; width: 175px; display: inline-block;" ng-model="submit_ticket.email" ng-init="submit_ticket.email = '{{ app.user.primary_email_address }}'" required />
									</div>
								</div>
								<div dp-show-spinning="sending_support_request">
									<i class="spinner-flat"></i>
								</div>
							</div>
							<p ng-show="support_sent" class="text-success">
								Your support request has been submitted successfully. One of our agents will respond
								to you as soon as possible. <button type="button" class="btn btn-default" ng-click="support_sent = false; submit_ticket.subject = ''; submit_ticket.message = '';">Click here to send another</button>
							</p>
						</div>
					</article>
				</td>
			</tr>
			<tr>
				{# STATS #}
				<td width="50%" class="dp-item">
					<header>
						<h3>Quick Stats</h3>
					</header>
					<article>
						<ul class="dp-display-list">
							<li>
								<i class="fa fa-envelope"></i>
								Tickets created today: {{ ng_var('Home.quick_stats.created_today') }}
							</li>
							<li>
								<i class="fa fa-check-square"></i>
								Tickets resolved today: {{ ng_var('Home.quick_stats.resolved_today') }}
							</li>
							<li>
								<i class="far fa-clock"></i>
								Tickets awaiting agent: {{ ng_var('Home.quick_stats.awaiting_agent') }}
							</li>
						</ul>
						<div class="dp-mpadded">
							<a class="btn btn-default" href="/{{ path('user')|ltrim('/') }}reports/" dp-click-href="#/go_to_reports">View more reports <i class="fas fa-long-arrow-alt-right"></i></a>
						</div>
					</article>
				</td>

				{# STATUS #}
				{% if not app.getSetting('disable_server_section') %}
					<td class="dp-item" ng-class="{'with-error':Home.cron_status.is_problem}">
						<header>
							<h3>Status</h3>
						</header>
						<article>
							<div class="dp-mpadded">
								<div class="status-content" ng-show="!Home.is_server_problem">
									<header>
										<div class="icon okay"><i class="fa fa-check"></i></div>
										<strong>Everything is running smoothly.</strong>
									</header>
								</div>
								<div class="status-content" ng-show="Home.is_server_problem">
									<header>
										<div class="icon bad"><i class="fas fa-exclamation-triangle"></i></div>
										<strong>We have detected problems you should look into</strong>
									</header>
									<article>
										<p ng-show="Home.cron_status.is_problem">
											<i class="far fa-clock"></i>
											Your <a href="{{ ng_href('server.cron') }}">scheduled task</a> is not running or has crashed.
											This means important routines like email processing and escalations are not running.
										</p>
										<p ng-show="Home.error_status.error_count > 0">
											<i class="fas fa-exclamation-triangle"></i>
											There are <a href="{{ ng_href('server.error_logs') }}">{{ ng_var('Home.error_status.error_count') }} system errors</a> in the error log.
										</p>
										<p ng-show="Home.error_status.error_log_size">
											<i class="fas fa-exclamation-triangle"></i>
											Your <a href="{{ ng_href('server.error_logs') }}">error log</a> has reached {{ ng_var('Home.error_status.error_log_max_size | filesize_display') }} in size,
											error logging has been disabled to conserve disk space. <a href="#" ng-click="Home.deleteLogFile();$event.preventDefault();">Delete log file.</a>
										</p>
										<p ng-show="Home.error_status.gateway_error_count > 0">
											<i class="fa fa-envelope"></i>
											There have been <a href="{{ ng_href('emails.ticket_accounts.emailsources') }}">{{ ng_var('Home.error_status.gateway_error_count') }} email errors</a>.
											These errors may have prevented the successful processing of tickets or ticket replies.
										</p>
										<p ng-show="Home.error_status.sendmail_error_count > 0">
											<i class="fa fa-envelope"></i>
											There have been <a href="{{ ng_href('emails.ticket_accounts.sendmailqueue') }}">{{ ng_var('Home.error_status.sendmail_error_count') }} outgoing email errors</a>.
											These errors will have prevented your users from receiving messages from the helpdesk (such as reply notifications).
										</p>
										<p ng-show="Home.apc_status.is_problem">
											<i class="far fa-hdd"></i>
											APC is reporting cache misses {{ ng_var('Home.apc_status.perc_miss_str') }}% of the time.
											<a href="https://support.deskpro.com/kb/articles/126" target="_blank">Read more about this error &rarr;</a>
										</p>
									</article>
								</div>
							</div>
						</article>
					</td>
				{% else %}
					<td class="dp-item">
						<header>
							<h3>Status</h3>
						</header>
						<article>
							<div class="dp-mpadded">
								<div class="status-content" ng-show="Home.error_status.gateway_error_count == 0 && Home.error_status.sendmail_error_count == 0">
									<header>
										<div class="icon okay"><i class="fa fa-check"></i></div>
										<strong>Everything is running smoothly.</strong>
									</header>
								</div>
								<div class="status-content" ng-show="!(Home.error_status.gateway_error_count == 0 && Home.error_status.sendmail_error_count == 0)">
									<header>
										<div class="icon bad"><i class="fas fa-exclamation-triangle"></i></div>
										<strong>We have detected problems you should look into</strong>
									</header>
									<article>
										<p ng-show="Home.error_status.gateway_error_count > 0">
											<i class="fa fa-envelope"></i>
											There have been <a href="{{ ng_href('emails.ticket_accounts.emailsources') }}">{{ ng_var('Home.error_status.gateway_error_count') }} email errors</a>.
											These errors may have prevented the successful processing of tickets or ticket replies.
										</p>
										<p ng-show="Home.error_status.sendmail_error_count > 0">
											<i class="fa fa-envelope"></i>
											There have been <a href="{{ ng_href('emails.ticket_accounts.sendmailqueue') }}">{{ ng_var('Home.error_status.sendmail_error_count') }} outgoing email errors</a>.
											These errors will have prevented your users from receiving messages from the helpdesk (such as reply notifications).
										</p>
									</article>
								</div>
							</div>
						</article>
					</td>
				{% endif %}
			</tr>
			<tr ng-show="keys(Home.features).length > 0">
				<td class="dp-item">
					<header>
						<h3>Beta features</h3>
					</header>
					<article>
						<div class="dp-mpadded">
							<div style="padding-bottom: 20px;" ng-repeat="(featureId, feature) in Home.features">
								<strong>{{ ng_var('feature.title') }}: </strong> <span ng-bind-html="feature.short_description"></span>
								<a ng-show="!feature.enabled && !feature.processing" class="btn btn-success" href="{{ ng_href('features.enable', '{id: feature.id}') }}">Enable</a>
								<a ng-show="feature.enabled && !feature.processing"  class="btn btn-danger" href="{{ ng_href('features.disable', '{id: feature.id}') }}">Disable</a>
								<span ng-show="feature.enabled && feature.processing">
									<br/>
									Please wait while the feature is <span style='color: red'>disabled</span>. This may take a few minutes
								</span>
								<span ng-show="!feature.enabled && feature.processing">
									Please wait while the feature is <span style='color: green'>enabled</span>. This may take a few minutes
								</span>
								<i ng-show="feature.processing" class="spinner-flat"></i>
							</div>
						</div>
					</article>
				</td>
				<td></td>
			</tr>
		</table>
	</div>
{% endblock %}
