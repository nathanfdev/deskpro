{% extends 'AdminInterfaceBundle:Layout:app.html.twig' %}
{% import 'AdminInterfaceBundle:Index:app-nav-macros.html.twig' as nav %}
{% block nav_content %}
	{{ nav.list() }}
		{{ nav.list_item('Settings', ng_href('setup.settings'), 'setup.settings', 'fa-cog') }}
		{% if app.isCloud() %}{{ nav.list_item('Domain / URL Setup', ng_href('setup.cloud_custom_domain'), 'setup.cloud_custom_domain', 'fa-link') }}{% endif %}
		{% if not app.isCloud() %}{{ nav.list_item('Automatic Updater', ng_href('setup.updater'), 'setup.updater', 'fa-cog') }}{% endif %}

		{{ nav.list_item_group('Anti-Abuse', 'fa-th-large') }}
			{{ nav.list_subitem('Rate Limiting', ng_href('setup.rate_limiting'), 'setup.rate_limiting', 'fa-clock-o') }}
			{{ nav.list_subitem('Email Rate Limiting', ng_href('setup.email_rate_limiting'), 'setup.email_rate_limiting', 'fa-download') }}
			{{ nav.list_subitem('CAPTCHA Settings', ng_href('setup.captcha_settings'), 'setup.captcha_settings', 'fa-thumbs-up') }}
		{{ nav.list_item_group_end() }}

		{{ nav.list_item('Languages', ng_href('setup.languages'), 'setup.languages', 'fa-globe') }}

		{% if app.canResetHelpdesk %}
			{{ nav.list_item('Reset Helpdesk', ng_href('setup.reset_demo'), 'setup.reset_demo', 'fa-trash-o') }}
		{% endif %}
	{{ nav.list_end() }}
{% endblock %}
