    <script type="text/javascript">
        window.DP_ASSET_URL         = '{{ asset('') }}';
        window.DP_BASE_URL          = '/{{ path('portal_home')|ltrim('/') }}';
        window.DP_BASE_API_URL      = '/{{ path('user')|ltrim('/') }}api';
        window.DP_BASE_ADMIN_URL    = '/{{ path('admin')|trim('/') }}';
        window.DP_API_TOKEN         = '{{ api_token.getKeyString() }}';
        window.DP_SESSION_ID        = '{{ app.getSession().getEntity().session_code }}';
        window.DP_REQUEST_TOKEN     = '{{ initial_request_token }}';
        window.DP_PERSON_ID         = {{ app.getUser().getId() }};
        window.DP_PERSON_EMAIL      = '{{ app.user.getPrimaryEmailAddress() }}';
        window.DP_PERSON_LANG_ID    = {{ app.user.language.id }};
        window.DP_PERSON_TZ         = '{{ app.user.timezone|default('UTC') }}';
        window.DP_IS_DEBUG          = {% if app.isDebug() %}true{% else %}false{% endif %};
        window.DP_IS_TESTING        = {% if app.isTesting() %}true{% else %}false{% endif %};
        window.DP_IS_CLOUD          = {% if app.isCloud() %}true{% else %}false{% endif %};
        window.DP_IS_DEV_ENV        = {% if app.isDevEnv() %}true{% else %}false{% endif %};
        window.DP_HAS_VOICE         = {% if app.hasVoice() %}true{% else %}false{% endif %};
        window.DP_HAS_DEV           = {% if app.hasFeature('dev') %}true{% else %}false{% endif %};
        window.DP_VERSION_NUMBER    = '{{ app.getVersionName() }}';
        window.DP_SECURE_LIC_SERVER = '{{ license_server }}';
        window.DP_ENABLED_LANGS     = [{% for language in enabled_languages() %}{{ '{' }}code: '{{ language.urlCode }}', locale: '{{ language.locale }}', title:'{{ language.title|capitalize }}',flag:'{{ language.flag_image }}'{{ '}' }}{% if not loop.last %},{% endif %}{% endfor %}];
        {% if app.isCloud() %}
        window.DPC_SITE_DOMAIN = '{{ constant('DPC_SITE_DOMAIN') }}';
        {% endif %}
        window.DP_USE_RJS_BUILD = {% if (not app.isDebug() or app.getSetting('core.dev_use_rjs_build') and not app.getSetting('core.disable_rjs_build')) %}true{% else %}false{% endif %};
        window.DP_BUILD_TIME    = {{ app.getBuildTime() }};
        {% if app.getSetting('custom_cloud_billing_authcode') %}
        window.DP_USES_CUSTOM_BILLING = true;
        {% endif %}

        {% if inhelp_states %}
        window.DP_INHELP_STATES = {{ inhelp_states|json_encode|raw }};
        {% endif %}

        window.DP_REDIRECT_TO_LICENSE = {% if redirect_license %}true{% else %}false{% endif %};

        window.DP_ADMIN_BUNDLE_PATH = '{{ asset('DeskPRO_AdminBundle.js', 'app_assets') }}';
        window.DP_DISABLE_RELATIVE_TIMES = {% if app.isRelativeTimesDisabled() %}true{% else %}false{% endif %};
    </script>
    {{ js_error_tracking('admin_interface') }}
    <script type="text/javascript" src="{{ asset('app/DeskPRO/preboot.js') }}"></script>
    <script type="text/javascript">
        window.name = "NG_DEFER_BOOTSTRAP!";
        window.DP_INTERFACE_LOADER = 'AdminLoad';
    </script>
    <script type="text/javascript" data-main="{{ asset('loader-build/requirejs-config.js') }}?v={{ app.getBuildTime() }}"
            src="{{ asset('bower_components/requirejs/require.js') }}"></script>
    <script type="text/javascript">{{ rjs_apps_config|raw }}</script>

    {% include 'DeskPRO:Common:notify-login-script.html.twig' with {show:true} %}

