    <script type="text/javascript">
//      IE/Edge Hack http://stackoverflow.com/questions/1481251/what-does-document-domain-document-domain-do
        document.domain = document.domain;
    </script>

    <style type="text/css">
        body {
            overflow:   hidden;
            background: #fff !important;
        }

        #agent_chats_wrapper, #agent_chat_panel {
            display: none;
        }

        {# Agent links that are us dont appear clickable #}
        .agent-link[data-agent-id="{{ app.user.id }}"]:hover, .agent-link[data-agent-id="0"]:hover {
            text-decoration: none;
            cursor:          text;
        }

        #admin_loading {
            position: absolute;
            top: 0;
            right: 0;
            bottom: 0;
            left: 0;
            background-color: #eceef0;
            z-index: 9999999;
        }

        #admin_loading .inner {
            border-radius: 3px;
            border: 1px solid #d0d9e6;
            position: absolute;
            top: 15px;
            right: 15px;
            bottom: 15px;
            left: 15px;

            background: #fff url({{ asset('images/spinners/loading-big-circle.gif') }}) no-repeat center center;
        }
    </style>
    <link type="text/css" rel="stylesheet" href="{{ asset('DeskPRO_AdminBundle_style.css', 'app_assets') }}" />
</head>
