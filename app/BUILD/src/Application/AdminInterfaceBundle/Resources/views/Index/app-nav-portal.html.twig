{% extends 'AdminInterfaceBundle:Layout:app.html.twig' %}
{% import 'AdminInterfaceBundle:Index:app-nav-macros.html.twig' as nav %}
{% block nav_content %}
	{#
	<div class="sidebar-list">
		<div class="sidebar-brand">
			<ul>
				<li>
					<a>
						<span class="brand-logo" style="background-image: url({{ asset('app/Interface/Resources/img/file-preview.png') }})"></span>
						<span class="faded">Brand:</span> <span>Default Brand <i class="fa fa-sort"></i></span>
					</a>
				</li>
			</ul>
		</div>
	</div>
	#}

	{{ nav.list() }}
		{{ nav.list_item_group('Setup', 'fa-th-large', ng_href('portal.setup'), 'portal.setup') }}
			{{ nav.list_subitem_regex_statemark('Knowledgebase', ng_href('portal.kb_settings'), 'kb', 'fa-book', null, '{"is-disabled": !Ctrl.settings.apps_kb || Ctrl.settings.portal_mode !== "publish"}') }}
			{{ nav.list_subitem_regex_statemark('News', ng_href('portal.news_settings'), 'news', 'fa-clock-o', null, '{"is-disabled": !Ctrl.settings.apps_news || Ctrl.settings.portal_mode !== "publish"}') }}
			{{ nav.list_subitem_regex_statemark('Downloads', ng_href('portal.downloads_settings'), 'downloads', 'fa-download', null, '{"is-disabled": !Ctrl.settings.apps_downloads || Ctrl.settings.portal_mode !== "publish"}') }}
			{{ nav.list_subitem_regex_statemark('Feedback', ng_href('portal.feedback_settings'), 'feedback', 'fa-thumbs-up', null, '{"is-disabled": !Ctrl.settings.apps_feedback || Ctrl.settings.portal_mode !== "publish"}') }}
		{{ nav.list_item_group_end() }}
		{{ nav.list_item('Portal', ng_href('portal.portal_editor'), 'portal.portal_editor', 'fa-home') }}
		{{ nav.list_item('Site Widget & Chat', ng_href('portal.widget_editor'), 'portal.widget_editor', 'fa-puzzle-piece') }}
		{{ nav.list_item('Ticket Form Widget', ng_href('portal.ticket_form_widget'), 'portal.ticket_form_widget', 'fa-envelope') }}
	{{ nav.list_end() }}
{% endblock %}
