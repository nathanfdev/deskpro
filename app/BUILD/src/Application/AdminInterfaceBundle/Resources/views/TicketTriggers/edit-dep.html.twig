{% extends 'AdminInterfaceBundle:Layout:list-editpane.html.twig' %}
{% block editpane_content %}
	<form role="form" name="form_props" ng-submit="form_props.$valid && TicketTriggersEdit.saveTrigger()">

		<section class="dp-paneblock dp-editpane">
			<article class="form-horizontal dp-form">
				<div class="panel panel-fill indent">
					<nav class="dp-blocktabs responsive">
						<menu dropdown>
							<button class="btn btn-default" type="button" dropdown-toggle><span><i class="fa fa-cog"></i></span> <i class="fa fa-caret-down"></i></button>
							<ul class="dropdown-menu pull-right">
								<li><a ng-click="TicketTriggersEdit.showCopySettings()"><i class="fa fa-copy"></i> {{ phrase('adm.ticket_triggers.copy_trigger') }}</a></li>
							</ul>
						</menu>
					</nav>
					<div class="panel-body">
						<div class="form-group">
							<h3>"{{ ng_var('TicketTriggersEdit.dep.title') }}" {{ phrase('adm.ticket_triggers.dep_trigger_title') }}</h3>
							<p style="margin-top: 15px;" ng-if="TicketTriggersEdit.eventType == 'newticket'">
								{{ phrase('adm.ticket_triggers.dep_trigger_description_newticket') }}
							</p>
							<p style="margin-top: 15px;" ng-if="TicketTriggersEdit.eventType == 'update'">
								{{ phrase('adm.ticket_triggers.dep_trigger_description_update') }}
							</p>
						</div>
					</div>
				</div>
			</article>
		</section>

		<section class="dp-paneblock dp-editpane">
			<article class="form-horizontal dp-form">
				<div class="panel panel-fill indent">
					<div class="panel panel-innertable" style="padding-top: 0; margin-top: 0;">
						<div class="panel-heading">
							<h3>
								<span>Criteria</span>
							</h3>
						</div>

						<div class="dp-ob-set">
							<div class="dp-ob-setrow">
								<header>
									<em class="dp-ob-row-tag if">when</em>
									The following conditions are met:
								</header>
								<article>
									<div class="dp-ob">
										<div class="dp-ob-options" ng-if="TicketTriggersEdit.eventType == 'newticket'">
											<div class="dp-ob-row">
												<div class="dp-ob-standard-row">
													<table cellspacing="0" cellpadding="0" width="100%" style="margin: 0; padding: 0; border: none;">
														<tbody>
															<tr>
																<td style="vertical-align: middle; padding: 0; margin: 0;" width="10"><div class="dp-ob-row-tag-wrap"><em class="dp-ob-row-tag if">if</em></div></td>
																<td style="vertical-align: middle; padding: 0; margin: 0;" width="100%">
																	Department is "{{ ng_var('TicketTriggersEdit.dep.title') }}"
																</td>
															</tr>
														</tbody>
													</table>
												</div>
											</div>
											<div class="dp-ob-row">
												<div class="dp-ob-standard-row">
													<table cellspacing="0" cellpadding="0" width="100%" style="margin: 0; padding: 0; border: none;">
														<tbody>
															<tr>
																<td style="vertical-align: middle; padding: 0; margin: 0;" width="10"><div class="dp-ob-row-tag-wrap"><em class="dp-ob-row-tag and">and</em></div></td>
																<td style="vertical-align: middle; padding: 0; margin: 0;" width="100%">
																	Ticket is created with this department (does not apply to tickets created by email).
																</td>
															</tr>
														</tbody>
													</table>
												</div>
											</div>
										</div>
										<div class="dp-ob-options" ng-if="TicketTriggersEdit.eventType == 'update'">
											<div class="dp-ob-row">
												<div class="dp-ob-standard-row">
													<table cellspacing="0" cellpadding="0" width="100%" style="margin: 0; padding: 0; border: none;">
														<tbody>
															<tr>
																<td style="vertical-align: middle; padding: 0; margin: 0;" width="10"><div class="dp-ob-row-tag-wrap"><em class="dp-ob-row-tag if">if</em></div></td>
																<td style="vertical-align: middle; padding: 0; margin: 0;" width="100%">
																	Department is changed to "{{ ng_var('TicketTriggersEdit.dep.title') }}"
																</td>
															</tr>
														</tbody>
													</table>
												</div>
											</div>
										</div>
									</div>
								</article>
							</div>
						</div>
					</div>

					<div class="panel panel-innertable">
						<div class="panel-heading">
							<h3>
								<span>Actions</span>
							</h3>
						</div>

						<div class="dp-ob-set">
							<div class="dp-ob-setrow">
								<header>
									<em class="dp-ob-row-tag then">then</em>
									The following actions will run:
								</header>
								<article ng-if="TicketTriggersEdit.eventType == 'newticket'">
									<dp-option-builder types-def="TicketTriggersEdit.actionsTypeDef" save-target="form.actions" options="{tag_first: '', tag_after: 'then', fixedExpanded: ['SetEmailAccount', 'SendUserNewEmail'], fixOn: ['SetEmailAccount'] }" option-types="actionOptionTypes">
										<add-btn-label>Action</add-btn-label>
									</dp-option-builder>
								</article>
								<article ng-if="TicketTriggersEdit.eventType == 'update'">
									<dp-option-builder types-def="TicketTriggersEdit.actionsTypeDef" save-target="form.actions" options="{tag_first: '', tag_after: 'then', fixedExpanded: ['SetEmailAccount'], fixOn: []}" option-types="actionOptionTypes">
										<add-btn-label>Action</add-btn-label>
									</dp-option-builder>
								</article>
							</div>
						</div>
					</div>
				</div>
			</article>
		</section>

		<section class="dp-paneblock dp-editpane">
			<footer>
				<div class="dp-content">
					<div class="dp-btn-controls" ng-hide="form_props.$attempted && form_props.$invalid">
						<div dp-hide-spinning="saving_dep">
							<button class="btn btn-primary" dp-submit-form>{{ phrase('agent.general.save') }}</button>
						</div>
						<div dp-show-spinning="saving_dep">
							<i class="spinner-flat"></i>
						</div>
					</div>
				</div>
			</footer>
		</section>
	</form>
{% endblock %}
