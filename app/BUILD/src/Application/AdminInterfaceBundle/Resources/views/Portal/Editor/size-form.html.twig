<div class="input">
    <input type="number" step="0.01" class="one-fourth" ng-model="values[variable.name].value" />
    <select class="one-sixth" ng-model="values[variable.name].unit">
        <option>px</option>
        <option>pt</option>
        <option>%</option>
        <option>em</option>
    </select>
    <span class="input-label" ng-bind="variable.label"></span>
</div>