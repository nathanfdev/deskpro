{% extends 'AdminInterfaceBundle:Layout:fullpage-pane.html.twig' %}
{% block fullpane_content %}
<div class="content-wrapper">
    <section class="content setup widget-editor">
        <h1><i class="fa fa-cog"></i> {{ phrase('admin.widget.settings_heading') }}</h1>
        <form class="widget-editor-form">
            <div class="content-section">
                <h2 class="with-divider form-header"><span>{{ phrase('admin.widget.button_settings') }}</span></h2>
                <ul class="options">
                    <li>
                        <label class="option-label">{{ phrase('admin.widget.button_size') }}:</label>
                        <div class="option-group">
                            <select ng-model="brand_settings.button.size">
                                <option value="small">S</option>
                                <option value="medium">M</option>
                                <option value="large">L</option>
                            </select>
                        </div>
                    </li>
                    <li>
                        <label class="option-label">{{ phrase('admin.widget.button_word') }}:</label>
                        <div class="option-group">
                            <ul class="errors">
                                <li ng-repeat="error in formErrors.brand.fields.button.fields.translations.errors">
                                    {{ ng_var('error.message') }}
                                </li>
                            </ul>

                            <div ng-if="languages.length" ng-repeat="translation in brand_settings.button.translations" ng-init="language = Ctrl.getLanguage(translation)">
                                <b>{{ ng_var('language.title') }}</b> <button ng-if="$index > 0" ng-click="brand_settings.button.translations.splice($index, 1)">x</button>:<br/>
                                <input type="hidden" ng-model="translation.language" />
                                <input type="text" ng-model="translation.name" />

                                <ul class="errors">
                                    <li ng-repeat="error in formErrors.brand.fields.button.fields.translations.fields['translations_' + $index].fields.name.errors">
                                        {{ ng_var('error.message') }}
                                    </li>
                                </ul>
                                <br/>
                            </div>

                            <div ng-if="(languages | filter:Ctrl.filterUsedLanguages(brand_settings.button.translations)).length">
                                <select ng-options="item.id as item.title for item in languages | filter:Ctrl.filterUsedLanguages(brand_settings.button.translations)" ng-model="newButtonTranslationLanguage"></select>
                                <button ng-click="Ctrl.addButtonTranslation(newButtonTranslationLanguage); newButtonTranslationLanguage = null" ng-disabled="!newButtonTranslationLanguage">{{ phrase('admin.widget.add_translation') }}</button>
                            </div>
                        </div>
                    </li>
                    <li>
                        <label class="option-label">{{ phrase('admin.widget.colors') }}:</label>
                        <ul class="option-group option-group-row">
                            <li>
                                <spectrum-colorpicker
                                    ng-model="brand_settings.button.colors.background"
                                    format="'hex'"
                                    class="color-picker"
                                    options="{
                                        showPalette: true,
                                        palette: ['#62ad8c'],
                                        showSelectionPalette: false,
                                        showInput: true
                                    }"
                                    ></spectrum-colorpicker>

                                <label>{{ phrase('admin.widget.background_color') }}</label>
                            </li>
                            <li>
                                <spectrum-colorpicker
                                    ng-model="brand_settings.button.colors.text"
                                    format="'hex'"
                                    class="color-picker"
                                    options="{
                                        showPalette: true,
                                        palette: ['#ffffff'],
                                        showSelectionPalette: false,
                                        showInput: true
                                    }"
                                    ></spectrum-colorpicker>

                                <label>{{ phrase('admin.widget.text_color') }}</label>
                            </li>
                        </ul>
                    </li>
                    <li>
                        <label class="option-label">{{ phrase('admin.widget.position') }}:</label>
                        <ul class="option-group option-group-inline">
                            <li>
                                <input type="radio" ng-model="brand_settings.widget.position" value="right" />
                                <label>{{ phrase('general.phrases.right') }}</label>
                            </li>
                            <li>
                                <input type="radio" ng-model="brand_settings.widget.position" value="left" />
                                <label>{{ phrase('general.phrases.left') }}</label>
                            </li>
                        </ul>
                    </li>
                    <li>
                        <label class="option-label">{{ phrase('admin.widget.widget_size') }}:</label>
                        <ul class="option-group option-group-inline">
                            <li>
                                <input type="radio" ng-model="brand_settings.widget.type" value="column" />
                                <label>{{ phrase('admin.widget.column') }}</label>
                            </li>
                            <li>
                                <input type="radio" ng-model="brand_settings.widget.type" value="bubble" />
                                <label>{{ phrase('admin.widget.corner') }}</label>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>

            <div class="content-section">
                <h2 class="with-divider form-header"><span>{{ phrase('admin.widget.chat_settings') }}</span></h2>

                <div class="switcher">
                    <button dp-toggle-switch ng-model="global_settings.chat.enabled"></button>
                    <h4><span class="title-text">{{ phrase('admin.widget.chat_switcher') }}</span></h4>
                </div>

                <div ng-if="global_settings.chat.enabled">
                    <div class="switcher">
                        <button dp-toggle-switch ng-model="brand_settings.chat.request_user_info"></button>
                        <h4><span class="title-text">{{ phrase('admin.widget.chat_request_person_for_comments') }}</span></h4>

                        <ul class="options" ng-if="brand_settings.chat.request_user_info">
                            <li>
                                <label class="option-label">{{ phrase('admin.widget.chat_begin_mode') }}:</label>
                                <div class="option-group">
                                    <select ng-model="brand_settings.chat.begin_mode">
                                        <option value="conversation">{{ phrase('admin.widget.chat_mode_conversation_style') }}</option>
                                        <option value="form">{{ phrase('admin.widget.chat_mode_form_style') }}</option>
                                    </select>
                                </div>
                            </li>
                            <li style="display: none">
                                <label class="option-label">{{ phrase('admin.widget.chat_email_validation') }}:</label>
                                <div class="option-group">
                                    {#<input type="checkbox" ng-model="global_settings.chat.email_validation" />#}
                                </div>
                            </li>
                        </ul>
                    </div>

                    <div class="switcher">
                        <button dp-toggle-switch ng-model="brand_settings.chat.proactive"></button>
                        <h4><span class="title-text">{{ phrase('admin.widget.proactive_chat') }}</span></h4>

                        <ul class="options" ng-if="brand_settings.chat.proactive">
                            <li>
                                <ul class="errors">
                                    <li ng-repeat="error in formErrors.brand.fields.chat.fields.popup.fields.translations.errors">
                                        {{ ng_var('error.message') }}
                                    </li>
                                </ul>

                                <div ng-if="languages.length" ng-repeat="translation in brand_settings.chat.popup.translations" ng-init="language = Ctrl.getLanguage(translation)">
                                    <b>{{ ng_var('language.title') }}</b> <button ng-if="$index > 0" ng-click="brand_settings.chat.popup.translations.splice($index, 1)">x</button>:<br/>
                                    <input type="hidden" ng-model="translation.language" />

                                    <label class="option-label">{{ phrase('admin.widget.proactive_chat_agent_title') }}:</label>
                                    <div class="option-group">
                                        <input type="text" ng-model="translation.title" />
                                        <ul class="errors">
                                            <li ng-repeat="error in formErrors.brand.fields.chat.fields.popup.fields.translations.fields['translations_' + $index].fields.title.errors">
                                                {{ ng_var('error.message') }}
                                            </li>
                                        </ul>
                                    </div>

                                    <label class="option-label">{{ phrase('admin.widget.proactive_chat_agent_message') }}:</label>
                                    <div class="option-group">
                                        <textarea ng-model="translation.message"></textarea>
                                        <ul class="errors">
                                            <li ng-repeat="error in formErrors.brand.fields.chat.fields.popup.fields.translations.fields['translations_' + $index].fields.message.errors">
                                                {{ ng_var('error.message') }}
                                            </li>
                                        </ul>
                                    </div>
                                </div>

                                <div ng-if="(languages | filter:Ctrl.filterUsedLanguages(brand_settings.chat.popup.translations)).length">
                                    <select ng-options="item.id as item.title for item in languages | filter:Ctrl.filterUsedLanguages(brand_settings.chat.popup.translations)" ng-model="newChatPopupTranslationLanguage"></select>
                                    <button ng-click="Ctrl.addChatPopupTranslation(newChatPopupTranslationLanguage); newChatPopupTranslationLanguage = null" ng-disabled="!newChatPopupTranslationLanguage">{{ phrase('admin.widget.add_translation') }}</button>
                                </div>

                                <br/><br/>
                            </li>
                            <li>
                                <label class="option-label">{{ phrase('admin.widget.proactive_chat_reply_type') }}:</label>
                                <div class="option-group">
                                    <select ng-model="brand_settings.chat.popup.reply_type">
                                        <option value="buttons">{{ phrase('admin.widget.proactive_chat_reply_form') }}</option>
                                        <option value="reply">{{ phrase('admin.widget.proactive_chat_reply_button') }}</option>
                                    </select>
                                </div>
                            </li>

                        </ul>
                    </div>
                    <div>
                        <ul class="options">
                            <li>
                                <label class="option-label">{{ phrase('admin.widget.chat_waiting_timeout') }}:</label>
                                <div class="option-group">
                                    <input type="text" ng-model="brand_settings.chat.waiting_timeout" />
                                    <span class="help-block">{{ phrase('admin.widget.chat_waiting_timeout_help') }}</span>
                                    <ul class="errors">
                                        <li ng-repeat="error in formErrors.brand.fields.chat.fields.waiting_timeout.errors">
                                            {{ ng_var('error.message') }}
                                        </li>
                                    </ul>
                                </div>
                            </li>
                            <li>
                                <label class="option-label">{{ phrase('admin.widget.chat_agent_polling_timeout') }}:</label>
                                <div class="option-group">
                                    <input type="text" ng-model="brand_settings.widget.agent_polling_timeout" />
                                    <ul class="errors">
                                        <li ng-repeat="error in formErrors.brand.fields.widget.fields.agent_polling_timeout.errors">
                                            {{ ng_var('error.message') }}
                                        </li>
                                    </ul>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="content-section">
                <h2 class="with-divider form-header"><span>{{ phrase('admin.widget.ticket_settings') }}</span></h2>
                <ul class="options">
                    <li>
                        <ul class="option-group no-label option-group-inline float-left">
                            <li>
                                <input type="radio" ng-model="brand_settings.ticket.select_department" value="default" />
                                <label>{{ phrase('admin.widget.ticket_default_department') }}</label>

                                <div class="sub-options">
                                    <select ng-model="brand_settings.ticket.default_department">
                                        <option ng-repeat="option in departments" ng-value="option.id" ng-selected="brand_settings.ticket.default_department == option.id">
                                            {{ ng_var('option.title') }}
                                        </option>
                                    </select>
                                    <ul class="errors">
                                        <li ng-repeat="error in formErrors.brand.fields.ticket.fields.default_department.errors">
                                            {{ ng_var('error.message') }}
                                        </li>
                                    </ul>
                                </div>
                            </li>
                            <li>
                                <input type="radio" ng-model="brand_settings.ticket.select_department" value="custom" />
                                <label>{{ phrase('admin.widget.ticket_user_select_department') }}</label>
                            </li>
                        </ul>
                        <ul class="errors">
                            <li ng-repeat="error in formErrors.brand.fields.ticket.fields.select_department.errors">
                                {{ ng_var('error.message') }}
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>

            <div class="form-footer">
                <hr>

                <div>
                    <button type="submit" ng-click="Ctrl.updateChatCode()" ng-hide="saving_code">{{ phrase('admin.widget.get_code') }}</button>
                    <div ng-show="saving_code">
                        <i class="spinner-flat"></i>
                    </div>
                </div>
            </div>

            <div class="editor-row" ng-if="!!code">
                <div class="editor-wrap">
                    <div
                         style="height: 500px;"
                         ng-model="code"
                         ui-ace="{
                             mode: 'html',
                             useWrapMode: false,
                             showGutter: false,
                             theme: 'textmate',
                             onLoad: embedEditorLoaded
                         }">
                    </div>
                </div>
            </div>

            <div class="form-footer">
                <br/>
                <hr>

                <h3>{{ phrase('admin.widget.apply_to_portal') }}</h3>
                <p>
                    {{ phrase('admin.widget.apply_to_portal_help') }}
                </p>

                <div>
                    <button type="submit" ng-click="Ctrl.applyPortalWidgetSettings()" ng-hide="applying_to_portal">
                        {{ phrase('admin.widget.apply_widget') }}
                    </button>
                </div>

                <div ng-if="enabled_on_portal" ng-hide="applying_to_portal">
                    <h3>{{ phrase('admin.widget.remove_widget') }}</h3>
                    <button ng-click="Ctrl.removeFromPortal()">{{ phrase('admin.widget.remove_widget_help') }}</button>
                </div>

                <div ng-show="applying_to_portal">
                    <i class="spinner-flat"></i>
                </div>
            </div>
        </form>

        <div class="widget-editor-live-demo-container">
            <div class="widget-editor-live-demo-loader" ng-hide="widgetLoaded"><i></i></div>
            <iframe id="live-demo" ng-show="widgetLoaded"></iframe>
        </div>

    </section>
</div>
{% endblock %}
