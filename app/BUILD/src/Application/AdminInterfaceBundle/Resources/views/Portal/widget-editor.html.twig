{% extends 'AdminInterfaceBundle:Layout:fullpage-pane.html.twig' %}
{% block fullpane_content %}
<div class="content-wrapper">
    <section class="content setup widget-editor">
        <h1><i class="fa fa-cog"></i> Site Widget & Chat</h1>
        <form class="widget-editor-form">
            <div class="content-section">
                <h2 class="with-divider form-header"><span>Button Settings</span></h2>
                <ul class="options">
                    <li>
                        <label class="option-label">Button size:</label>
                        <div class="option-group">
                            <select ng-model="brand_settings.button.size">
                                <option value="small">S</option>
                                <option value="medium">M</option>
                                <option value="large">L</option>
                            </select>
                        </div>
                    </li>
                    <li>
                        <label class="option-label">Button word:</label>
                        <div class="option-group">
                            <input type="text" ng-model="brand_settings.button.name" />
                            <ul class="errors">
                                <li ng-repeat="error in formErrors.brand.fields.button.fields.name.errors">
                                    {{ ng_var('error.message') }}
                                </li>
                            </ul>
                        </div>
                    </li>
                    <li>
                        <label class="option-label">Colors:</label>
                        <ul class="option-group option-group-row">
                            <li>
                                <spectrum-colorpicker
                                    ng-model="brand_settings.button.colors.background"
                                    format="'hex'"
                                    class="color-picker"
                                    options="{
                                        showPalette: true,
                                        palette: ['#62ad8c'],
                                        showSelectionPalette: false
                                    }"
                                    ></spectrum-colorpicker>

                                <label>Background Color</label>
                            </li>
                            <li>
                                <spectrum-colorpicker
                                    ng-model="brand_settings.button.colors.text"
                                    format="'hex'"
                                    class="color-picker"
                                    options="{
                                        showPalette: true,
                                        palette: ['#ffffff'],
                                        showSelectionPalette: false
                                    }"
                                    ></spectrum-colorpicker>

                                <label>Text Color</label>
                            </li>
                            <li>
                                <spectrum-colorpicker
                                    ng-model="brand_settings.button.colors.border"
                                    format="'hex'"
                                    class="color-picker"
                                    options="{
                                        showPalette: true,
                                        palette: ['#4e9576'],
                                        showSelectionPalette: false
                                    }"
                                    ></spectrum-colorpicker>

                                <label>Border Color</label>
                            </li>
                        </ul>
                    </li>
                    <li>
                        <label class="option-label">Position:</label>
                        <ul class="option-group option-group-inline">
                            <li>
                                <input type="radio" ng-model="brand_settings.widget.position" value="right" />
                                <label>Right</label>
                            </li>
                            <li>
                                <input type="radio" ng-model="brand_settings.widget.position" value="left" />
                                <label>Left</label>
                            </li>
                        </ul>
                    </li>
                    <li>
                        <label class="option-label">Widget Size:</label>
                        <ul class="option-group option-group-inline">
                            <li>
                                <input type="radio" ng-model="brand_settings.widget.type" value="column" />
                                <label>Column</label>
                            </li>
                            <li>
                                <input type="radio" ng-model="brand_settings.widget.type" value="bubble" />
                                <label>Corner</label>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>

            <div class="content-section">
                <h2 class="with-divider form-header"><span>Chat Settings</span></h2>

                <div class="switcher">
                    <button dp-toggle-switch ng-model="brand_settings.chat.enabled"></button>
                    <h4><span class="title-text">Enable / Disable Chat</span></h4>
                </div>

                <div ng-if="brand_settings.chat.enabled">
                    <div class="switcher">
                        <button dp-toggle-switch ng-model="global_settings.chat.require_login"></button>
                        <h4><span class="title-text">Require login</span></h4>
                    </div>

                    <div class="switcher" ng-if="!global_settings.chat.require_login">
                        <button dp-toggle-switch ng-model="brand_settings.chat.request_user_info"></button>
                        <h4><span class="title-text">Request Name/Email before Chat Commences</span></h4>

                        <ul class="options" ng-if="brand_settings.chat.request_user_info">
                            <li>
                                <label class="option-label">Begin chat mode:</label>
                                <div class="option-group">
                                    <select ng-model="brand_settings.chat.begin_mode">
                                        <option value="conversation">Conversation Style</option>
                                        <option value="form">Form Style</option>
                                    </select>
                                </div>
                            </li>
                            <li>
                                <label class="option-label">Email validation:</label>
                                <div class="option-group">
                                    <input type="checkbox" ng-model="global_settings.chat.email_validation" />
                                </div>
                            </li>
                        </ul>
                    </div>

                    <div class="switcher">
                        <button dp-toggle-switch ng-model="brand_settings.chat.proactive"></button>
                        <h4><span class="title-text">Proactive Chat</span></h4>

                        <ul class="options" ng-if="brand_settings.chat.proactive">
                            <li>
                                <label class="option-label">Agent Title:</label>
                                <div class="option-group">
                                    <input type="text" ng-model="brand_settings.chat.popup.title" />
                                </div>
                            </li>
                            <li>
                                <label class="option-label">Agent Message:</label>
                                <div class="option-group">
                                    <textarea ng-model="brand_settings.chat.popup.message"></textarea>
                                </div>
                            </li>
                            <li>
                                <label class="option-label">Reply Form Type:</label>
                                <div class="option-group">
                                    <select ng-model="brand_settings.chat.popup.reply_type">
                                        <option value="buttons">Reply Button</option>
                                        <option value="reply">Reply Form</option>
                                    </select>
                                </div>
                            </li>
                            <li>
                                <label class="option-label">Waiting Timeout:</label>
                                <div class="option-group">
                                    <input type="text" ng-model="brand_settings.chat.waiting_timeout" />
                                    <ul class="errors">
                                        <li ng-repeat="error in formErrors.brand.fields.chat.fields.waiting_timeout.errors">
                                            {{ ng_var('error.message') }}
                                        </li>
                                    </ul>
                                </div>
                            </li>
                            <li>
                                <label class="option-label">Online agent polling timeout:</label>
                                <div class="option-group">
                                    <input type="text" ng-model="brand_settings.widget.agent_polling_timeout" />
                                    <ul class="errors">
                                        <li ng-repeat="error in formErrors.brand.fields.widget.fields.agent_polling_timeout.errors">
                                            {{ ng_var('error.message') }}
                                        </li>
                                    </ul>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="content-section">
                <h2 class="with-divider form-header"><span>Ticket Settings</span></h2>
                <ul class="options">
                    <li>
                        <ul class="option-group no-label option-group-inline float-left">
                            <li>
                                <input type="radio" ng-model="brand_settings.ticket.select_department" value="default" />
                                <label>Default Department</label>

                                <div class="sub-options">
                                    <select ng-model="brand_settings.ticket.default_department">
                                        <option ng-repeat="option in departments" ng-value="option.id" ng-selected="brand_settings.ticket.default_department == option.id">
                                            {{ ng_var('option.title') }}
                                        </option>
                                    </select>
                                    <ul class="errors">
                                        <li ng-repeat="error in formErrors.brand.fields.ticket.fields.select_department.errors">
                                            {{ ng_var('error.message') }}
                                        </li>
                                    </ul>
                                </div>
                            </li>
                            <li>
                                <input type="radio" ng-model="brand_settings.ticket.select_department" value="custom" />
                                <label>User Selects Department</label>
                            </li>
                        </ul>
                        <ul class="errors">
                            <li ng-repeat="error in formErrors.brand.fields.chat.fields.waiting_timeout.errors">
                                {{ ng_var('error.message') }}
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>

            <div class="form-footer">
                <hr>

                <div>
                    <button type="submit" ng-click="Ctrl.updateChatCode()" ng-hide="saving_code">Get Code</button>
                    <div ng-show="saving_code">
                        <i class="spinner-flat"></i>
                    </div>
                </div>
            </div>

            <div class="editor-row" ng-if="!!code">
                <div class="editor-wrap">
                    <div
                         style="height: 220px;"
                         ng-model="code"
                         ui-ace="{
                             mode: 'html',
                             useWrapMode: false,
                             showGutter: false,
                             theme: 'textmate',
                             onLoad: embedEditorLoaded
                         }">
                    </div>
                </div>
            </div>

            <div class="form-footer">
                <br/>
                <hr>

                <h3>Apply to portal</h3>
                <p>
                    Apply these settings to your DeskPRO portal. This will enable the chat widget
                    on your helpdesk itself.
                </p>

                <div>
                    <button type="submit" ng-click="Ctrl.applyPortalWidgetSettings()" ng-hide="applying_to_portal">
                        Apply chat widget to the portal
                    </button>
                </div>

                <div ng-if="enabled_on_portal" ng-hide="applying_to_portal">
                    <h3>Remove from portal</h3>
                    <button ng-click="Ctrl.removeFromPortal()">Remove chat widget from the portal</button>
                </div>

                <div ng-show="applying_to_portal">
                    <i class="spinner-flat"></i>
                </div>
            </div>
        </form>

        <div class="widget-editor-live-demo-container">
            <div class="widget-editor-live-demo-loader" ng-hide="widgetLoaded"><i></i></div>
            <iframe id="live-demo" ng-show="widgetLoaded"></iframe>
        </div>

    </section>
</div>
{% endblock %}
