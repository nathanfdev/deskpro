{% extends 'AdminInterfaceBundle:Layout:fullpage-pane.html.twig' %}
{% block fullpane_content %}
<form class="ui form">
    <div class="ui grid">
        <div class="seven wide column">
            <h3><i class="icon setting"></i>{{ phrase('admin.widget.settings_heading') }}</h3>
            <div class="ui styled fluid accordion">
                <div class="element">
                    <div class="active title">
                        <i class="dropdown icon"></i>
                        {{ phrase('admin.widget.button_settings') }}
                    </div>
                    <div class="active content">
                        <div class="field">
                            <label for="label">Label</label>
                            <div class="inline fields">
                                <div class="thirteen wide field">
                                    <input type="text" name="label" placeholder="Help">
                                </div>
                                <div class="three wide field">
                                    <div class="ui left labeled language button">
                                        <a class="ui basic label">
                                            <i class="icon globe"></i>
                                        </a>
                                        <div class="ui button">
                                            1/5
                                            <div class="ui tiny progress">
                                                <div class="bar" style="width:20%"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="field">
                            <label for="size">Size</label>
                            <div class="inline fields">
                                <div class="field">
                                    <div class="ui radio checkbox">
                                        <input type="radio" name="size" checked="" class="hidden">
                                        <label>Small</label>
                                    </div>
                                </div>
                                <div class="field">
                                    <div class="ui radio checkbox">
                                        <input type="radio" name="size" class="hidden">
                                        <label>Medium</label>
                                    </div>
                                </div>
                                <div class="field">
                                    <div class="ui radio checkbox">
                                        <input type="radio" name="size" class="hidden">
                                        <label>Large</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="field">
                            <label>Colours</label>
                            <div class="inline field">
                                <spectrum-colorpicker
                                        ng-model="brand_settings.button.colors.background"
                                        format="'hex'"
                                        class="color-picker"
                                        options="{
                                        showPalette: true,
                                        palette: ['#62ad8c'],
                                        showSelectionPalette: false,
                                        showInput: true
                                    }"
                                ></spectrum-colorpicker>
                                <label for="background_color">Background</label>
                            </div>
                            <div class="inline field">
                                <spectrum-colorpicker
                                        ng-model="brand_settings.button.colors.text"
                                        format="'hex'"
                                        class="color-picker"
                                        options="{
                                        showPalette: true,
                                        palette: ['#ffffff'],
                                        showSelectionPalette: false,
                                        showInput: true
                                    }"
                                ></spectrum-colorpicker>
                                <label for="background_color">Text colour & icon background</label>
                            </div>
                        </div>
                        <div class="field">
                            <label>Widget type</label>
                            <div class="inline fields">
                                <div class="seven wide field">
                                    <img src="{{ asset('images/admin/widget-position-right-corner.png') }}"
                                         alt="left-corner">
                                    <div class="ui radio checkbox">
                                        <input type="radio" name="widget_type" class="hidden">
                                        <label>Corner</label>
                                    </div>
                                </div>
                                <div class="two wide field">
                                    - or -
                                </div>
                                <div class="seven wide field">
                                    <img src="{{ asset('images/admin/widget-position-right-column.png') }}"
                                         alt="left-corner">
                                    <div class="ui radio checkbox">
                                        <input type="radio" name="widget_type" class="hidden">
                                        <label>Column</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="field">
                            <label>Position</label>
                            <div class="inline fields">
                                <div class="seven wide field">
                                    <img src="{{ asset('images/admin/widget-position-right-corner.png') }}"
                                         alt="left-corner">
                                    <div class="ui radio checkbox">
                                        <input type="radio" name="widget_type" class="hidden">
                                        <label>Right</label>
                                    </div>
                                </div>
                                <div class="two wide field">
                                    - or -
                                </div>
                                <div class="seven wide field">
                                    <img src="{{ asset('images/admin/widget-position-left-corner.png') }}"
                                         alt="left-corner">
                                    <div class="ui radio checkbox">
                                        <input type="radio" name="widget_type" class="hidden">
                                        <label>Left</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="element">
                    <div class="title">
                        <i class="dropdown icon"></i>
                        {{ phrase('admin.widget.chat_settings') }}
                    </div>
                    <div class="content">
                        <div class="field">
                            <div class="inline field">
                                <div class="ui toggle checkbox">
                                    <label>Chat enabled <i class="icon help circle"></i></label>
                                    <input type="checkbox" class="hidden right">
                                </div>
                            </div>
                        </div>
                        <div class="field">
                            <label>Who can use chat</label>
                            <p>Manage which usergroups have access to chat</p>
                            <div class="inline field">
                                <div class="ui checkbox">
                                    <input type="checkbox" class="hidden">
                                    <label>Everyone</label>
                                </div>
                            </div>
                            <div class="inline field">
                                <div class="ui checkbox">
                                    <input type="checkbox" class="hidden">
                                    <label>Registered</label>
                                </div>
                            </div>
                            <div class="inline field">
                                <div class="ui checkbox">
                                    <input type="checkbox" class="hidden">
                                    <label>Special Users</label>
                                </div>
                            </div>
                        </div>
                        <div class="field">
                            <div class="inline field">
                                <div class="ui toggle checkbox">
                                    <label>Require information before chat commences</label>
                                    <input type="checkbox" class="hidden right">
                                </div>
                                <p>Require users to provide their name and email address as well as adding custom fields
                                or require departments.</p>
                                <div class="inline field">
                                    <div class="ui checkbox">
                                        <input type="checkbox" class="hidden">
                                        <label>Name</label>
                                    </div>
                                </div>
                                <div class="inline field">
                                    <div class="ui checkbox">
                                        <input type="checkbox" class="hidden">
                                        <label>Email address</label>
                                    </div>
                                </div>
                                <div class="inline field">
                                    <div class="ui checkbox">
                                        <input type="checkbox" class="hidden">
                                        <label>Deparment</label>
                                    </div>
                                </div>
                                <div class="inline field">
                                    <div class="ui checkbox">
                                        <input type="checkbox" class="hidden">
                                        <label>Order number</label>
                                    </div>
                                </div>
                                <button class="ui basic button">
                                    <i class="icon plus"></i> ADD CUSTOM FIELDS
                                </button>
                            </div>
                            <div class="field">
                                <label>Begin chat mode (automated)</label>
                                <div class="inline fields">
                                    <div class="eight wide field">
                                        <div class="ui radio checkbox">
                                            <input type="radio" name="widget_type" class="hidden">
                                            <label>Form Style</label>
                                        </div>
                                    </div>
                                    <div class="eight wide field">
                                        <div class="ui radio checkbox">
                                            <input type="radio" name="widget_type" class="hidden">
                                            <label>Conversation Style</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="element">
                    <div class="title">
                        <i class="dropdown icon"></i>
                        Proactive chat settings
                    </div>
                    <div class="content">
                        <div class="field">
                            <div class="inline field">
                                <div class="ui toggle checkbox">
                                    <label>Proactive chat enabled <i class="icon help circle"></i></label>
                                    <input type="checkbox" class="hidden right">
                                </div>
                                <p>Having proactive chat enabled switched on enabled a popup that encourages users to chat with you</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="element">
                    <div class="title">
                        <i class="dropdown icon"></i>
                        Ticket settings
                    </div>
                    <div class="content">
                        <p>Three common ways for a prospective owner to acquire a dog is from pet shops, private owners, or shelters.</p>
                        <p>A pet shop may be the most convenient way to buy a dog. Buying a dog from a private owner allows you to assess the pedigree and upbringing of your dog before choosing to take it home. Lastly, finding your dog from a shelter, helps give a good home to a dog who may not find one so readily.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
<script src="/assets/BUILD/web/node_modules/semantic-ui-less/definitions/modules/accordion.js"></script>
<script src="/assets/BUILD/web/node_modules/semantic-ui-less/definitions/modules/checkbox.js"></script>
<script type="application/javascript">
    $('.accordion').accordion();
    $('.checkbox').checkbox();
</script>
{% endblock %}
