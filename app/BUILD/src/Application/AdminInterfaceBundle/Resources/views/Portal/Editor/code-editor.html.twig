<div ng-show="visible">
    <div class="dp-code-editor-backdrop"></div>
    <div class="dp-code-editor"
         ui-ace="{theme: 'monokai', mode: syntax}"
         ng-model="info.code"
    ></div>
    <div class="dp-code-editor-controls">
        <button class="btn btn-warning" ng-click="revert()" ng-show="info.is_custom"><i class="fa fa-step-backward"></i> Revert To Default</button>
        <button class="btn btn-default" ng-click="cancel()">Cancel</button>
        <button class="btn btn-success" ng-click="save()"><i class="fa fa-save"></i> {{ phrase('agent.general.save') }}</button>
    </div>
</div>
