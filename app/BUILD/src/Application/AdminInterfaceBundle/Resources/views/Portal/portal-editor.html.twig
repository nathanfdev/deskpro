{% extends 'AdminInterfaceBundle:Layout:fullpage-pane.html.twig' %}
{% block fullpane_content %}
<div class="content-wrapper portal-editor-wrap">
    <section class="content editor">

        <div class="editor-panel" dp-match-min-height watch="sidebar">

            <div class="panel-wrapper" dp-match-min-height watched-as="sidebar">
                <div class="current-theme-actions">
                    <a href ng-click="Portal.save()" class="save-changes">Preview Changes</a>
                    <a href ng-click="Portal.discard()" class="discard-changes">Discard Changes</a>
                    <a href ng-click="Portal.commit()" class="save-changes">Save Changes</a>
                </div>

                <!-- Theme -->

                <div class="panel-title">
                    <a ng-click="Portal.togglePanel('theme')">
                        Theme
                        <i class="fa fa-caret-right" ng-show="!Portal.isOpen('theme')"></i>
                        <i class="fa fa-caret-down" ng-show="Portal.isOpen('theme')"></i>
                    </a>
                </div>

                <div class="site-text" ng-show="Portal.isOpen('theme')">
                    <select ng-model="Portal.selected_theme"
                            ng-change="Portal.editTheme()"
                            ng-options="item.id as item.title for item in Portal.available_themes">
                    </select>
                </div>

                <!-- Welcome -->

                <div class="panel-title">
                    <a ng-click="Portal.togglePanel('site_copy')">
                        Welcome Message
                        <i class="fa fa-caret-right" ng-show="!Portal.isOpen('site_copy')"></i>
                        <i class="fa fa-caret-down" ng-show="Portal.isOpen('site_copy')"></i>
                    </a>
                </div>

                <div class="site-text" ng-show="Portal.isOpen('site_copy')">
                    <form>
                        <input type="text" placeholder="Welcome Box title" ng-model="welcome_box.title">
                        <textarea placeholder="Content (HTML)" style="height: 200px;" ng-model="welcome_box.message"></textarea>
                        <div class="footer">
                            <div style="float:left" ng-show="welcome_box.title || welcome_box.message">
                                <button ng-click="Portal.clearWelcomeBox()">Clear</button>
                            </div>
                            <button ng-click="Portal.saveWelcomeBox()">Set &amp; Preview</button>
                        </div>
                    </form>
                </div>

                <!-- Logo -->
                <div class="panel-title">
                    <a ng-click="Portal.togglePanel('logo')">
                        Logo
                        <i class="fa fa-caret-right" ng-show="!Portal.isOpen('logo')"></i>
                        <i class="fa fa-caret-down" ng-show="Portal.isOpen('logo')"></i>
                    </a>
                </div>
                <div class="alert alert-danger inner-group" ng-show="errors.logo">
                    <span ng-if="errors.logo">{{ ng_var('errors.logo') }}</span>
                </div>
                <div class="logo-options" ng-show="Portal.isOpen('logo')">
                    <div class="logo-box logo-size-desktop">
                        <input type="file" ng-file-select="Portal.uploadLogo($files)" />

                        <div class="bucket" ng-if="Portal.custom_logo">
                            <div class="logo-container">
                                <img ng-src="{{ '{{ Portal.custom_logo }}' }}">
                            </div>

                            <a href ng-click="Portal.deleteLogo()">Delete logo</a>
                        </div>
                    </div>
                </div>


                <!-- Favicon -->
                <div class="panel-title">
                    <a ng-click="Portal.togglePanel('favicon')">
                        Favicon
                        <i class="fa fa-caret-right" ng-show="!Portal.isOpen('favicon')"></i>
                        <i class="fa fa-caret-down" ng-show="Portal.isOpen('favicon')"></i>
                    </a>
                </div>
                <div class="alert alert-danger inner-group" ng-show="errors.favicon">
                    <span ng-if="errors.favicon">{{ ng_var('errors.favicon') }}</span>
                </div>
                <div ng-show="Portal.isOpen('favicon')">
                    <div class="logo-box logo-size-desktop">
                        <input type="file" ng-file-select="Portal.uploadFavicon($files)" />

                        <div class="bucket" ng-if="Portal.custom_favicon">
                            <div class="logo-container">
                                <img ng-src="{{ '{{ Portal.custom_favicon }}' }}" style="width: 16px; height: 16px;">
                            </div>
                            <a href ng-click="Portal.deleteFavicon()">Delete favicon</a>
                        </div>
                    </div>
                </div>


                <!-- Vars -->

                <div ng-repeat="(group, variables) in Portal.groups">
                    <div class="panel-title">
                        <a ng-click="Portal.togglePanel(group)">
                            <span ng-bind="Portal.label(group)"></span>
                            <i class="fa fa-caret-right" ng-show="!Portal.isOpen(group)"></i>
                            <i class="fa fa-caret-down" ng-show="Portal.isOpen(group)"></i>
                        </a>
                    </div>
                    <div>
                        <div class="color-scheme font-options" ng-show="Portal.isOpen(group)">
                            <div ng-repeat="variable in variables" ng-init="variable.label = Portal.label(variable.name)">
                                <dp-portal-designer-variable-form
                                    variable="variable"
                                    values="values">
                                </dp-portal-designer-variable-form>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- End of variables settings -->

                <!-- Advanced edit ------------------------------------------------------------------------------------>

                <div class="panel-title">
                    <a ng-click="Portal.togglePanel('advanced')">
                        Page Layout &amp; Design
                        <i class="fa fa-caret-down" ng-show="!Portal.isOpen('advanced')"></i>
                        <i class="fa fa-caret-down" ng-show="Portal.isOpen('advanced')"></i>
                    </a>
                </div>

                <div class="code-editor"
                     ng-class="{'code-editor-extended': Portal.isAdvancedTab('assets')}"
                     ng-show="Portal.isOpen('advanced')">
                    <nav>
                        <ul>
                            <li ng-class="{active: Portal.isAdvancedTab('header')}">
                                <a href ng-click="Portal.openAdvancedTab('header')">Header &amp; Footer</a>
                            </li>
                            <li ng-class="{active: Portal.isAdvancedTab('homepage')}">
                                <a href ng-click="Portal.openAdvancedTab('homepage')">Home</a>
                            </li>
                            <li ng-class="{active: Portal.isAdvancedTab('sidebar')}" ng-show="Portal.selected_theme == 'sidebar'">
                                <a href ng-click="Portal.openAdvancedTab('sidebar')">Side</a>
                            </li>
                            <li ng-class="{active: Portal.isAdvancedTab('scss')}">
                                <a href ng-click="Portal.openAdvancedTab('scss')">CSS</a>
                            </li>
                            <li ng-class="{active: Portal.isAdvancedTab('assets')}">
                                <a href ng-click="Portal.openAdvancedTab('assets')">Assets</a>
                            </li>
                        </ul>
                    </nav>

                    <!-- Header / Footer -->
                    <div class="the-code" ng-show="Portal.isAdvancedTab('header')">
                        <p>
                            These temlpates let you put HTML code at the very top or very bottom of the page.
                        </p>
                        <div style="text-align: center; padding-top: 8px;">
                            <div>
                                <button class="btn btn-default" ng-click="Portal.openTemplateEditor('Theme:Internal:custom-header.html.twig')">Edit Header</button>

                                <button class="btn btn-default" ng-click="Portal.openTemplateEditor('Theme:Internal:custom-footer.html.twig')">Edit Footer</button>
                            </div>
                            <br />
                            <div style="margin-top: 4px;">
                                <button class="btn btn-default" ng-click="Portal.openTemplateEditor('Theme:Internal:custom-head-include.html.twig')">Edit Head Include</button>
                            </div>
                        </div>
                    </div>

                    <!-- Home -->
                    <div class="the-code" ng-show="Portal.isAdvancedTab('homepage')">
                        <p>
                            Edit the homepage template to add or remove elements from the main portal homepage.
                        </p>
                        <div style="text-align: center; padding-top: 8px;"><button class="btn btn-default" ng-click="Portal.openTemplateEditor('Theme:Portal:home.html.twig')">Edit Homepage Template</button></div>
                    </div>

                    <!-- Sidebar -->
                    <div class="the-code" ng-show="Portal.isAdvancedTab('sidebar')">
                        <p>
                            Edit the sidebar template to add or remove elements from the site-wide sidebar.
                        </p>
                        <div style="text-align: center; padding-top: 8px;"><button class="btn btn-default" ng-click="Portal.openTemplateEditor('Theme:Portal:sidebar.html.twig')">Edit Sidebar Template</button></div>
                    </div>

                    <!-- CSS -->
                    <dp-code-editor
                        info="Portal.css_template_info"
                        syntax="css"
                        visible="Portal.css_template_selected && Portal.css_template_info.loaded"
                        save="Portal.saveCssEditor()"
                        cancel="Portal.cancelCssEditor()"
                        revert="Portal.resetCssEditor()"
                    >
                    </dp-code-editor>
                    <div class="the-code" ng-show="Portal.isAdvancedTab('scss')">
                        <p>
                            Your custom CSS is appended to the main CSS stylesheet. Use this to override default styles
                            or add custom styles.
                        </p>
                        <div style="text-align: center; padding-top: 8px;"><button class="btn btn-default" ng-click="Portal.openCssEditor('custom_scss')">Edit Custom CSS</button></div>
                        <div style="text-align: center; padding-top: 8px;"><button class="btn btn-default" ng-click="Portal.openCssEditor('main_scss')">Edit Main CSS</button></div>
                    </div>

                    <!-- Assets -->
                    <div class="the-assets" ng-show="Portal.isAdvancedTab('assets')">
                        <a href="javascript:void(null)" class="drag-and-drop-area" ng-file-drop="Portal.upload($files)">
                            <span ng-show="!Portal.uploading_files_count">
                                <span class="hint">
                                    <i class="fa fa-upload"></i> Drag &amp; Drop here or select files to upload:
                                </span>
                                <input type="file" ng-file-select="Portal.upload($files)" multiple />
                            </span>
                            <span ng-show="Portal.uploading_files_count">
                                Uploading {{ '{{ Portal.uploading_files_count }}' }} file(s)...
                            </span>
                        </a>
                        <div class="file-list">
                            <ul>
                                <li ng-repeat="file in Portal.asset_files">
                                    <a ng-href="{{ '{{ file.url }}' }}" target="_blank" class="file">
                                        <i class="fa fa-file"></i> {{ '{{ file.name }}' }}
                                    </a>
                                    <a href dp-clipboard data-clipboard-text="{{ ng_var('file.url') }}" ngclipboard-success="Portal.notifyUrlCopied()" class="file-url-copy">Copy file URL</a>
                                    <a href ng-click="Portal.delete(file)" class="file-url-copy">Delete</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- End of the Advanced edit ------------------------------------------------------------------------->

                <div class="panel-title" style="z-index: 10;">
                    <a ng-click="Portal.togglePanel('expert')" style="z-index: 99;">
                        Template Editor
                        <i class="fa fa-caret-down" ng-show="!Portal.isOpen('expert')"></i>
                        <i class="fa fa-caret-down" ng-show="Portal.isOpen('expert')"></i>
                    </a>
                </div>

                <div class="template-picker" ng-show="Portal.isOpen('expert') && !(Portal.selected_template && Portal.selected_template_info_loaded) && !(Portal.css_template_selected && Portal.css_template_info.loaded)">
                    <select ui-select2='{ containerCssClass : "select2-container-template-picker", dropdownCssClass : "select2-dropdown-template-picker" }'
                            clas="template-picker"
                            style="width: 300px;"
                            data-placeholder="Choose a template"
                            ng-model="Portal.selected_template"
                            ng-change="Portal.editTemplate()"
                            ng-options="t.value as t.name group by t.group for t in Portal.template_options">
                    </select>
                </div>

                <div ng-show="Portal.selected_template">Loading template...</div>

                <dp-code-editor
                    info="Portal.selected_template_info"
                    syntax="twig"
                    visible="Portal.selected_template && Portal.selected_template_info_loaded"
                    save="Portal.saveTemplateEditor()"
                    cancel="Portal.cancelTemplateEditor()"
                    revert="Portal.revertTemplateEditor()"
                >
                </dp-code-editor>

                <br/><br/>
            </div><!-- End panel wrapper -->

        </div><!-- End editor panel -->

        <section class="preview-panel">
            <iframe ng-if="Portal.canPreview()" ng-src="{{ '{{ Portal.preview_url }}' }}" width="100%" height="100%" frameborder="0"></iframe>
            <div ng-show="(Portal.preview_as == 'user' || Portal.preview_as == 'agent') && !Portal.preview_as_email">
                You need to select {{ '{{ Portal.preview_as }}' }} email
            </div>
            <div ng-show="Portal.savingMulti || Portal.recompiling">Applying changes...</div>
            <div ng-show="Portal.commiting">Saving changes...</div>

            <div class="widescreen-info">
                The editor works better on screens over 1280 pixels. Something about full screen and hiding the sidebar
            </div>

            <div class="preview-tools">
                <ul>
                    <li>
                        <a href ng-click="Portal.preview_as_expanded = !Portal.preview_as_expanded">
                            Preview as
                            <span ng-bind="Portal.preview_as"></span>
                            <span ng-show="Portal.preview_as == 'user' || Portal.preview_as == 'agent'" ng-bind="Portal.preview_as_email"></span>
                            <i class="fa fa-user"></i> <i class="fa fa-caret-down"></i>
                        </a>

                        <ul ng-show="Portal.preview_as_expanded">
                            <li><a href ng-click="Portal.previewAs('myself')" ng-class="{active: Portal.preview_as == 'myself'}"> <i class="fa fa-check"></i> myself</a></li>
                            <li><a href ng-click="Portal.previewAs('guest')"  ng-class="{active: Portal.preview_as == 'guest'}">  <i class="fa fa-users"></i> guest</a></li>
                            <li><a href ng-click="Portal.previewAs('agent')"  ng-class="{active: Portal.preview_as == 'agent'}">  <i class="fa fa-user"></i>  agent</a></li>
                            <li><a href ng-click="Portal.previewAs('user')"   ng-class="{active: Portal.preview_as == 'user'}">   <i class="fa fa-user"></i>  user</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </section>
    </section>
</div>
{% endblock %}
