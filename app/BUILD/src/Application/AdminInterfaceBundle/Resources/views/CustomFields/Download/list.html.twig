{% extends 'AdminInterfaceBundle:Labels:layout.html.twig' %}
{% block listpane_content %}
    <section class="dp-paneblock dp-panelink">
        <a href="{{ ng_href('portal.downloads_settings') }}">
            <em><i class="fa fa-chevron-down"></i></em>
            <h3>Downloads Settings</h3>
        </a>
    </section>

    <section class="dp-paneblock dp-panelink">
        <a href="{{ ng_href('portal.downloads_labels') }}">
            <em><i class="fa fa-chevron-down"></i></em>
            <h3>Downloads labels</h3>
        </a>
    </section>

    <section class="dp-paneblock dp-listpane">
        <header>
            <h3>Downloads Custom Fields</h3>
        </header>
        <article>
            <ul class="dp-item-list" dp-max-height>
                <li ng-repeat="field in fields" dp-state-mark="portal.download_custom_fields.edit.{{ ng_var('field.id') }}">
                    <a href="{{ ng_href('portal.download_custom_fields.edit', '{id: field.id}') }}">
                        <h4>
                            <span class="title-text" dp-label="field.title" style="display: inline-block; padding: 1% 2%; border-radius: 3px"></span>
                        </h4>
                    </a>

                </li>
            </ul>
            <div class="dp-add-control">
                <a class="btn btn-default" href="{{ ng_href('portal.download_custom_fields.gocreate') }}" ng-class="{'active': isStateActive('.create') }"><i class="fa fa-plus"></i> {{phrase('agent.general.add')}}</a>
            </div>
        </article>
    </section>

{% endblock %}