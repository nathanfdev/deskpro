{% extends 'AdminInterfaceBundle:Layout:list.html.twig' %}
{% block listpane_content %}
	<section class="dp-paneblock dp-panelink">
		<a href="{{ ng_href('portal.community_settings') }}">
			<em><i class="fas fa-chevron-down"></i></em>
			<h3>Community Settings</h3>
		</a>
	</section>

	<section class="dp-paneblock dp-panelink">
		<a href="{{ ng_href('portal.community_statuses') }}">
			<em><i class="fas fa-chevron-down"></i></em>
			<h3>{{ phrase('admin.community.community_statuses') }}</h3>
		</a>
	</section>

    <section class="dp-paneblock dp-listpane">
        <header>
            <h3>{{ phrase('admin.community.community_custom_fields') }}</h3>
        </header>
        <article>
            <ul class="dp-item-list" dp-max-height>
                <li ng-repeat="field in fields" dp-state-mark="portal.community_custom_fields.edit.{{ ng_var('field.id') }}" ng-if="field.brand == brand_id">
                    <a href="{{ ng_href('portal.community_custom_fields.edit', '{id: field.id}') }}">
                        <h4>
                            <span class="title-text" dp-label="field.title" style="display: inline-block; padding: 1% 2%; border-radius: 3px"></span>
                        </h4>
                    </a>

                </li>
            </ul>
            <div class="dp-add-control">
                <a class="btn btn-default" href="{{ ng_href('portal.community_custom_fields.gocreate') }}" ng-class="{'active': isStateActive('.create') }"><i class="fa fa-plus"></i> {{phrase('agent.general.add')}}</a>
            </div>
        </article>
    </section>

    <section class="dp-paneblock dp-panelink">
        <a href="{{ ng_href('portal.community_forums') }}">
            <em><i class="fas fa-chevron-down"></i></em>
            <h3>Community Forums</h3>
        </a>
    </section>

	<section class="dp-paneblock dp-panelink">
		<a href="{{ ng_href('portal.community_labels') }}">
			<em><i class="fas fa-chevron-down"></i></em>
			<h3>Community Topics Labels</h3>
		</a>
	</section>
{% endblock %}
