{% extends 'AdminInterfaceBundle:CustomFields:Common/edit.html.twig' %}
{% block extra_types_choose %}
{% endblock %}
{% block extra_types_titleswitch %}
{% endblock %}
{% block pre_bottomdefault_fields %}
    <div class="form-group">
        <div class="col-lg-3">
            <h3>Auto-add to new forums</h3>
        </div>
        <div class="col-lg-9">
            <label><input type="checkbox" ng-model="EditCtrl.form.is_global" /> When enabled, this field will be added to all new forums you create by default. (You can still edit the forum later to remove it.)</label>
        </div>
    </div>

    <div class="form-group">
        <div class="col-lg-3">
            <h3>Community Forums</h3>
        </div>
        <div class="col-lg-9">
            <div class="inner-group">
                <div style="padding-top:6px;" ui-sortable="CommunityForumsEdit.sortedCustomFieldsOptions">
                    <label
                            class="with-drag-handle"
                            data-id="{{ ng_var('forum.id') }}"
                            ng-repeat="forum in EditCtrl.community_forums"
                            style="font-weight: normal; display: block;"
                    >
                        <input type="checkbox" ng-model="EditCtrl.selectedForums[forum.id]">
                        {{ ng_var('forum.title') }}
                    </label>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block bottomdefault_fields %}
{% endblock %}

{% block bottomdefault_buttons %}
    <div class="dp-content">
        <div class="text-danger ng-hide" ng-show="form_props.$attempted && form_props.$invalid">
            <p><strong>{{phrase('adm.general.please_correct_errors')}}</strong></p>
            <ul>
                <li ng-show="form_props.title.$error.required">{{ phrase('adm.custom_fields.title_error') }}</li>
            </ul>
        </div>

        <div class="dp-delete-control" ng-if="EditCtrl.field.id && EditCtrl.field.sys_name == null" ng-hide="form_props.$attempted && form_props.$invalid">
            <button class="btn btn-danger" type="button" ng-click="EditCtrl.startDelete();">Delete</button>
        </div>

        <div class="dp-btn-controls" ng-hide="form_props.$attempted && form_props.$invalid">
            <div dp-hide-spinning="saving">
                <button class="btn btn-primary" dp-submit-form>{{phrase('agent.general.save')}}</button>
            </div>
            <div dp-show-spinning="saving">
                <i class="spinner-flat"></i>
            </div>
        </div>
    </div>
{% endblock %}
