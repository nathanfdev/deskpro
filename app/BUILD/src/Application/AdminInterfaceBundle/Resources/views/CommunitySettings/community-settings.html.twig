<div class="dp-layout-list">
	<div class="dp-layout-list-listpane">
		<div class="dp-pane">

			<section class="dp-paneblock dp-listpane">
				<header>
					<h3>Community Settings</h3>
				</header>
				<article>
					<ul class="dp-item-list">
						<li dp-state-mark="portal.community_settings">
							<a href="{{ ng_href('portal.community_settings') }}">
								<h4>General Settings</h4>
							</a>
						</li>
					</ul>
				</article>
			</section>

			<section class="dp-paneblock dp-panelink">
				<a href="{{ ng_href('portal.community_statuses') }}">
					<em><i class="fas fa-chevron-down"></i></em>
					<h3>{{ phrase('admin.community.community_statuses') }}</h3>
				</a>
			</section>

			<section class="dp-paneblock dp-panelink">
				<a href="{{ ng_href('portal.community_forums') }}">
					<em><i class="fas fa-chevron-down"></i></em>
					<h3>Community Forums</h3>
				</a>
			</section>
			<section class="dp-paneblock dp-panelink">
				<a href="{{ ng_href('portal.community_categories') }}">
					<em><i class="fas fa-chevron-down"></i></em>
					<h3>Community Categories</h3>
				</a>
			</section>
			<section class="dp-paneblock dp-panelink">
				<a href="{{ ng_href('portal.community_labels') }}">
					<em><i class="fas fa-chevron-down"></i></em>
					<h3>Community Topics Labels</h3>
				</a>
			</section>
		</div>
	</div>
	<div class="dp-layout-list-editpane">

		<form class="form-horizontal dp-form" role="form" name="form_props" ng-submit="form_props.$valid && Ctrl.save()">
			<section class="dp-paneblock dp-listpane">
				<header>
					<h3>Community Settings</h3>
				</header>

				<article>
					<div class="panel panel-innertable">
						<div class="form-group">
							<div class="labels-group">
								<label>
									<input type="radio" ng-model="settings.enabled" ng-value="true" />
									<h4>Enable the Community section</h4>
								<span class="help-block" ng-show="settings.enabled">
									<p>Enable the community section.</p>
								</span>
								</label>
								<label>
									<input type="radio" ng-model="settings.enabled" ng-value="false" />
									<h4>Disable the Community section</h4>
								<span class="help-block" ng-show="!settings.enabled">
									Disable the community section.
								</span>
								</label>
							</div>
						</div>
					</div>
				</article>
				<article ng-show="settings.enabled">
					<div class="panel panel-innertable">
						<div class="form-group">
							<label>
								<input type="checkbox" ng-model="settings.tab_enabled" />
								<h4>Enable the Community tab in the portal tab bar</h4>
							<span class="help-block">
								<p>
									Enable the Community tab in the navigation tab bar? When not checked, the Community tab will not be visible
									but the Community section will still be active (e.g., you could create your own link to the community URL).
								</p>
								<p>
									Use the <a href="{{ ng_href('portal.portal_editor') }}">Portal Editor</a> to re-order items in the tab bar.
								</p>
							</span>
							</label>
						</div>
					</div>
					<div class="panel panel-innertable">
						<div class="form-group">
							<label>
								<input type="checkbox" ng-model="settings.subscriptions" />
								<h4>Enable Community subscriptions</h4>
							<span class="help-block">
								<p>
									Allow users to subscribe to Community topics.
								</p>
							</span>
							</label>
						</div>
					</div>
				</article>

				<footer>
					<div class="dp-content">
						<div class="dp-btn-controls" ng-hide="form_props.$attempted && form_props.$invalid">
							<div dp-hide-spinning="saving">
								<button class="btn btn-primary" dp-submit-form>{{ phrase('agent.general.save') }}</button>
							</div>
							<div dp-show-spinning="saving">
								<i class="spinner-flat"></i>
							</div>
						</div>
					</div>
				</footer>

			</section>
		</form>

	</div>
</div>
