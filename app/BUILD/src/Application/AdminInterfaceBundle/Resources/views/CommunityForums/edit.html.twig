{% extends 'AdminInterfaceBundle:Layout:list-editpane.html.twig' %}
{% block editpane_content %}
	<style>
		.picker {
			display: table-row;
			height: 25px;
			list-style: none;
		}
		.picker li {
			display: table-cell;
			width: 25px;
			position: relative;
			z-index: 2;
		}
		.picker-color {
			display: block;
			width: 25px;
			height: 25px;
			text-align: center;
			cursor: pointer;
		}
		label[for="picker-input"] {
			position: absolute;
			display: block;
			top: 6px;
			left: 20px;
			height: 20px;
			width: 20px;
			border-radius: 2px;
			cursor: pointer;
			z-index: 1;
		}
		#picker-input {
			padding-left: 30px;
		}
		.splash-image {
			position: relative;
			z-index: 1;
		}
	</style>
	<form role="form" name="form_props" ng-submit="form_props.$valid && CommunityForumsEdit.saveCommunityForum()">
		<section class="dp-paneblock dp-editpane">
			<article class="form-horizontal dp-form">
				<div class="panel panel-fill indent">
					<div class="panel-body">
						<div class="form-group">
							<div class="col-lg-3">
								<h3>{{ phrase('adm.community_forums.title') }} *</h3>
							</div>
							<div class="col-lg-9">
								<div class="inner-group" dp-error-class="form_props.title">
									<input type="text"
										   class="form-control"
										   name="title"
										   ng-model="CommunityForumsEdit.community_forum.title"
										   dp-server-validation="title.not_blank"
										   style="width: 50%;"
										   autofocus required>
									{% if app.getLanguages().isMultiLang() %}
										<span
												class="translate-button"
												tooltip="{{ phrase('adm.general.translate') }}"
												dp-open-phrase-editor="{ context: 'agent', phraseId: 'obj_communityforum.' + CommunityForumsEdit.community_forum.id + '_title'}"
										></span>
									{% endif %}
								<span class="help-block">
									{{ phrase('adm.community_forums.title_explain') }}
								</span>
								</div>
							</div>
							<div class="col-lg-3">
								<h3>{{ phrase('adm.community_forums.noun') }} *</h3>
							</div>
							<div class="col-lg-9">
								<div class="inner-group" dp-error-class="form_props.noun">
									<input type="text"
										   class="form-control"
										   name="noun"
										   ng-model="CommunityForumsEdit.community_forum.noun"
										   dp-server-validation="noun.not_blank"
										   style="width: 50%;"
										   autofocus required>
									{% if app.getLanguages().isMultiLang() %}
										<span
												class="translate-button"
												tooltip="{{ phrase('adm.general.translate') }}"
												dp-open-phrase-editor="{ context: 'agent', phraseId: 'obj_community_forum_noun.' + CommunityForumsEdit.community_forum.id }"
										></span>
									{% endif %}
								<span class="help-block">
									{{ phrase('adm.community_forums.noun_explain') }}
								</span>
								</div>
							</div>
							<div class="col-lg-3">
								<h3>{{ phrase('adm.community_forums.plural') }} *</h3>
							</div>
							<div class="col-lg-9">
								<div class="inner-group" dp-error-class="form_props.plural">
									<input type="text"
										   class="form-control"
										   name="plural"
										   ng-model="CommunityForumsEdit.community_forum.plural"
										   dp-server-validation="plural.not_blank"
										   style="width: 50%;"
										   autofocus required>
									{% if app.getLanguages().isMultiLang() %}
										<span
												class="translate-button"
												tooltip="{{ phrase('adm.general.translate') }}"
												dp-open-phrase-editor="{ context: 'agent', phraseId: 'obj_community_forum_plural.' + CommunityForumsEdit.community_forum.id }"
										></span>
									{% endif %}
								<span class="help-block">
									{{ phrase('adm.community_forums.plural_explain') }}
								</span>
								</div>
							</div>
							<div class="col-lg-3">
								<h3>{{ phrase('adm.community_forums.verb') }} *</h3>
							</div>
							<div class="col-lg-9">
								<div class="inner-group" dp-error-class="form_props.verb_action">
									<input type="text"
										   class="form-control"
										   name="verb_action"
										   ng-model="CommunityForumsEdit.community_forum.verb_action"
										   dp-server-validation="verb_action.not_blank"
										   style="width: 50%;"
										   autofocus required>
									{% if app.getLanguages().isMultiLang() %}
										<span
												class="translate-button"
												tooltip="{{ phrase('adm.general.translate') }}"
												dp-open-phrase-editor="{ context: 'agent', phraseId: 'obj_communityforum.' + CommunityForumsEdit.community_forum.id + '_verb_action'}"

										></span>
									{% endif %}
								<span class="help-block">
									{{ phrase('adm.community_forums.verb_explain') }}
								</span>
								</div>
							</div>
						</div>
						<div class="form-group" dp-error-class="description">
							<div class="col-lg-3">
								<h3>{{ phrase('agent.general.description') }} *</h3>
							</div>
							<div class="col-lg-9">
								<div class="inner-group" dp-error-class="form_props.description">
                                    <textarea class="form-control" name="description" ng-model="CommunityForumsEdit.community_forum.description"
											  style="width: 50%; height: 80px;"></textarea>
								</div>
							</div>
						</div>
						<div class="form-group">
							<div class="col-lg-3">
								<h3>{{ phrase('adm.community_forums.usergroups') }}</h3>
							</div>
							<div class="col-lg-9">
								<div class="inner-group">
									<div style="padding-top:6px;">
										<label ng-repeat="usergroup in CommunityForumsEdit.usergroups" style="font-weight: normal; display: block;">
											<input type="checkbox" ng-model="CommunityForumsEdit.selected_usergroups[usergroup.id]">
											{{ ng_var('usergroup.title') }}
										</label>
									</div>
								<span class="help-block">
									{{ phrase('adm.community_forums.usergroups_explain') }}
								</span>
								</div>
							</div>
						</div>
						<div class="form-group">
							<div class="col-lg-3">
								<h3>{{ phrase('admin.community.statuses') }}</h3>
							</div>
							<div class="col-lg-9">
								<div class="inner-group">
									<div style="padding-top:6px;">
										<label style="font-weight: normal; display: block;">
											<strong>{{ phrase('admin.community.active_statuses') }}</strong>
										</label>
									</div>
									<div
											data-type="active"
											style="padding-top:6px;"
											ui-sortable="CommunityForumsEdit.sortedStatusesOptions"
									>
										<label
												data-id="{{ ng_var('status.id') }}"
												class="with-drag-handle"
												ng-repeat="status in CommunityForumsEdit.community_statuses.active | filter:{brand:brand_id} | orderBy: 'display_order'"
												style="font-weight: normal; display: block;"
										>
											<i class="fas fa-bars drag-handle"></i>
											<input type="checkbox" ng-model="CommunityForumsEdit.selectedStatuses[status.id]">
											{{ ng_var('status.title') }}
										</label>
									</div>
									<div style="padding-top:6px;">
										<label style="font-weight: normal; display: block;">
											<strong>{{ phrase('admin.community.closed_statuses') }}</strong>
										</label>
									</div>
									<div
											data-type="closed"
											style="padding-top:6px;"
											ui-sortable="CommunityForumsEdit.sortedStatusesOptions"
									>
										<label
												data-id="{{ ng_var('status.id') }}"
												class="with-drag-handle"
												ng-repeat="status in CommunityForumsEdit.community_statuses.closed | filter:{brand:brand_id} | orderBy: 'display_order'"
												style="font-weight: normal; display: block;"
										>
											<i class="fas fa-bars drag-handle"></i>
											<input type="checkbox" ng-model="CommunityForumsEdit.selectedStatuses[status.id]">
											{{ ng_var('status.title') }}
										</label>
									</div>
								</div>
							</div>
						</div>
						<div class="form-group" ng-if="(CommunityForumsEdit.custom_fields| filter:{brand:brand_id}).length > 0">
							<div class="col-lg-3">
								<h3>{{ phrase('admin.general.custom_fields') }}</h3>
							</div>
							<div class="col-lg-9">
								<div class="inner-group">
									<div style="padding-top:6px;" ui-sortable="CommunityForumsEdit.sortedCustomFieldsOptions">
										<label
												class="with-drag-handle"
												data-id="{{ ng_var('custom_field.id') }}"
												ng-repeat="custom_field in CommunityForumsEdit.custom_fields | filter:{brand:brand_id} | orderBy: 'display_order'"
												style="font-weight: normal; display: block;"
										>
											<i class="fas fa-bars drag-handle"></i>
                                            <input type="checkbox" ng-model="CommunityForumsEdit.selectedCustomFields[custom_field.id]">
											{{ ng_var('custom_field.title') }}
										</label>
									</div>
								</div>
							</div>
						</div>
						<div class="form-group">
							<div class="col-lg-3">
								<h3>{{ phrase('agent.general.icon') }}</h3>
							</div>
							<div class="col-lg-9">
								<div class="bucket">
									<div id="community_forum_icon_picker" class="category-icon">
										<input type="hidden" name="icon_urn" ng-model="CommunityForumsEdit.community_forum.icon_property.urn" />
										<input type="hidden" name="icon_style" ng-model="CommunityForumsEdit.community_forum.icon_property.style" />
										<input type="hidden" name="icon_color" ng-model="CommunityForumsEdit.community_forum.icon_property.color" />
										<input type="hidden" name="icon_url" ng-model="CommunityForumsEdit.community_forum.icon_property.url" />
										<button class="dp-btn btn-default" type="button">
											{{ phrase('agent.publish.pick_icon') }}
										</button>
									</div>
								</div>
							</div>
						</div>
						<div class="form-group">
							<div class="col-lg-3">
								<h3>{{ phrase('agent.general.color') }}</h3>
							</div>
							<div class="col-lg-9">
								<div class="inner-group" dp-error-class="form_props.color">
									<label for="picker-input" style="background-color: {{ ng_var('CommunityForumsEdit.community_forum.color') }}"></label>
									<input
											id="picker-input"
											type="text"
											class="form-control"
											name="color"
											ng-model="CommunityForumsEdit.community_forum.color"
											ng-focus="picker = true"
											ng-blur="picker = false"
											style="width: 50%;">
									<div ng-show="picker" style="position: absolute;">
										<ul class="picker">
											<li ng-repeat="color in colors.slice(0, colors.length / 2)">
												<span ng-mouseenter="CommunityForumsEdit.community_forum.color = color" class="picker-color" style="background-color: {{ ng_var('color') }}">
												</span>
											</li>
										</ul>
										<ul class="picker">
											<li ng-repeat="color in colors.slice(colors.length / 2)">
												<span ng-mouseenter="CommunityForumsEdit.community_forum.color = color" class="picker-color" style="background-color: {{ ng_var('color') }}">
												</span>
											</li>
										</ul>
									</div>
								</div>
							</div>
						</div>
						<div class="form-group">
							<div class="col-lg-3">
								<h3>{{ phrase('agent.general.splash_image') }}</h3>
							</div>
							<div class="col-lg-9">
								<div ng-hide="CommunityForumsEdit.community_forum.custom_splash_image">
									<input type="file" ng-file-select="CommunityForumsEdit.uploadSplashImage($files)" />

									<button class="btn btn-default" ng-click="CommunityForumsEdit.openUnsplashModal()" type="button" >Browse Free Images</button>
								</div>
								<div class="bucket" ng-if="CommunityForumsEdit.community_forum.custom_splash_image">
									<div class="splash-image">
										<img ng-src="{{ '{{ CommunityForumsEdit.community_forum.custom_splash_image }}' }}">
									</div>
									<a href ng-click="CommunityForumsEdit.deleteSplashImage()">Delete splash image</a>
								</div>
							</div>
						</div>
					</div>
				</div>
			</article>
			<footer>
				<div class="dp-content">
					<div class="text-danger ng-hide" ng-show="form_props.$attempted && form_props.$invalid">
						<p><strong>{{ phrase('adm.general.please_correct_errors') }}</strong></p>
						<ul>
							<li ng-show="form_props.title.$error.required || form_props.title.$error.not_blank">
								{{ phrase('adm.community_forums.title_error') }}
							</li>
						</ul>
					</div>

					<div class="dp-delete-control" ng-if="CommunityForumsEdit.community_forum.id" ng-hide="form_props.$attempted && form_props.$invalid">
						<button class="btn btn-danger"
								ng-click="$event.preventDefault(); $parent.CommunityForumsList.startDelete(CommunityForumsEdit.community_forum);">
							Delete
						</button>
					</div>

					<div class="dp-btn-controls" ng-hide="form_props.$attempted && form_props.$invalid">
						<div dp-hide-spinning="saving_community_forum">
							<button class="btn btn-primary" dp-submit-form>{{ phrase('agent.general.save') }}</button>
						</div>
						<div dp-show-spinning="saving_community_forum">
							<i class="spinner-flat"></i>
						</div>
					</div>
				</div>
			</footer>
		</section>
	</form>
	<div dp-register-message="saved_community_forum">{{ ng_var('CommunityForumsEdit.community_forum.title') }} was saved successfully</div>
{% endblock %}
