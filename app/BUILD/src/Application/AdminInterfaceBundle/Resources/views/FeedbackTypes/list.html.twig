{% extends 'AdminInterfaceBundle:Layout:list.html.twig' %}
{% block listpane_content %}
	<section class="dp-paneblock dp-panelink">
		<a href="{{ ng_href('portal.feedback_settings') }}">
			<em><i class="fas fa-chevron-down"></i></em>
			<h3>Community Settings</h3>
		</a>
	</section>

	<section class="dp-paneblock dp-panelink">
		<a href="{{ ng_href('portal.feedback_statuses') }}">
			<em><i class="fas fa-chevron-down"></i></em>
			<h3>Community Statuses</h3>
		</a>
	</section>

	<section class="dp-paneblock dp-listpane">
		<header>
			<nav>
				<span dp-ping-flash="display_orders" class="saved-ping"><i class="far fa-check-square"></i> {{ phrase('agent.general.saved') }}</span>
				{% include 'AdminInterfaceBundle:Layout:standard-settings-menu.html.twig' %}
			</nav>
			<h3 ng-pluralize count="FeedbackTypesList.community_channels.length || 0" when="{{ ng_plural_phrase('adm.general.x_community_channels') }}"></h3>
		</header>
		<article>
			<ul class="dp-item-list" ui-sortable="FeedbackTypesList.sortedListOptions">
				<li class="with-drag-handle" ng-repeat="channel in FeedbackTypesList.community_channels" dp-state-mark="portal.community_channels.edit.{{ ng_var('channel.id') }}" data-id="{{ ng_var('channel.id') }}" ng-if="channel.brand == brand_id">
					<a href="{{ ng_href('portal.community_channels.edit', '{id: channel.id}') }}">
						<i class="fas fa-bars drag-handle"></i>
						<h4><span class="title-id" title="ID">#{{ ng_var('channel.id') }}</span> <span class="title-text">{{ ng_var('channel.title') }}</span></h4>
					</a>
				</li>
			</ul>
			<div class="dp-add-control">
				<a class="btn btn-default" href="{{ ng_href('portal.feedback_channels.gocreate') }}" ng-class="{'active': isStateActive('.create') }"><i class="fas fa-plus"></i> {{ phrase('agent.general.add') }}</a>
			</div>
		</article>
	</section>

	<section class="dp-paneblock dp-panelink">
		<a href="{{ ng_href('portal.community_custom_channels') }}">
			<em><i class="fas fa-chevron-down"></i></em>
			<h3>Community Channels</h3>
		</a>
	</section>
	<section class="dp-paneblock dp-panelink">
		<a href="{{ ng_href('portal.feedback_labels') }}">
			<em><i class="fas fa-chevron-down"></i></em>
			<h3>Community Topics Labels</h3>
		</a>
	</section>

	<div dp-register-message="saved_settings">{{ phrase('adm.general.save_settings_success') }}</div>
	<div dp-register-message="no_delete_last">{{ phrase('adm.feedback_channels.no_delete_last') }}</div>
{% endblock %}
{% block listpane_help %}
	<header>
		<h1>Channels help agents to organize incoming community topics.</h1>
		<p>Users have to choose a channel when they submit a topic. The channel field can be used to record whether the topic is a suggestion, complaint, bug report etc.</p>
	</header>

	<article>
			<section>
				<p>Customize the channels available here. Click to edit, or drag to change the order in which they are displayed to users and agents.</p>
			</section>

		<section class="related-content">
				<h2><span>Related Content</span></h2>
				<ul>
				<li><i class="fas fa-book"></i> <a href="https://support.deskpro.com/guides/topic/277" target="_blank">Community channels</a></li>

				</ul>
			</section>
	</article>
{% endblock %}
