{% extends 'AdminInterfaceBundle:Layout:fullpage-pane.html.twig' %}
{% block fullpane_content %}

	<section class="dp-paneblock dp-listpane">
		<header>
			<h3>Storage Mechanism</h3>
		</header>

		{##################################################################################################}

		<article class="padd" ng-show="updating_method">
			<i class="spinner-editor"></i>
		</article>

		<article class="padd" ng-show="!updating_method">
			<div ng-if="data.filestorage_method == 'db'">
				<p>
					You are currently using the <strong>database storage mechanism</strong> for file storage.
				</p>
				<p>
					Using the database to store files is the most portable and easy to configure mechanism. However, it is very inefficient
					and will quickly increase the size of your database.
				</p>
				<p>
					If possible, we suggest switching to one of the other storage mechanisms.
				</p>
				<p>
					<button class="btn btn-primary" type="button" ng-click="Ctrl.startSwitchStorage()"><i class="far fa-copy"></i> Change Storage Mechanism</button>
				</p>
			</div>

			<div ng-if="data.filestorage_method == 'fs'">
				<p>
					You are currently using the <strong>filesystem storage mechanism</strong> for file storage.
				</p>
				<p>
					Files are being stored at <var>{{ ng_var('data.file_storage_path') }}</var>.
				</p>
				<p>
					<button class="btn btn-default" type="button" ng-click="Ctrl.startSwitchStorage()"><i class="far fa-copy"></i> Change Storage Mechanism</button>
				</p>
			</div>

			<div ng-if="data.filestorage_method == 's3'">
				<p>
					You are currently using the <strong>Amazon S3 storage mechanism</strong> for file storage.
				</p>
				<p>
					Files are being stored on AmazonS3 in the bucket named <var>{{ ng_var('data.s3_bucket') }}</var>.
				</p>
				<p>
					<button class="btn btn-default" type="button" ng-click="Ctrl.startSwitchStorage()"><i class="far fa-copy"></i> Change Storage Mechanism</button>
				</p>
			</div>
		</article>

		<article class="padd" ng-if="data.moving_files.id || fileTransferStarted">
			<span dp-status-update="/server_file_uploads/switch_status"
				  status-update-conditions="update_started"
				  status-update-default-message="Requesting transferring status information..."
				  status-update-completed-growl-message="Transferring of files finished"
				  status-update-interval="15000"
				  status-update-immediate="false"
				  style="font-style:italic;">
			</span>
		</article>
	</section>

	{##################################################################################################}

	<section class="dp-paneblock dp-listpane">
		<header>
			<h3>{{ phrase('admin.server.test_a_file_upload') }}</h3>
		</header>

		<article class="padd">
			<form id="fileupload"
				  method="POST"
				  enctype="multipart/form-data"
				  file-upload="fileUploadOptions"
				  action="{{ ng_var('fileUploadOptions.url') }}">

				<div class="fileinput-button btn btn-success" ng-show="!active() && !fileSelected">
					<span>Select File</span>
					<input type="file" name="file">
				</div>

				<!-- 'queue=[];' is workaround due to strange behavior of uploader in case of single file instead of multiple-->

				<div class="pull-left" ng-show="!active() && fileSelected">
					<button type="button" class="btn btn-warning" ng-click="submit();queue=[];">
						<span>Upload File</span>
					</button>
				</div>

				<div class="pull-left file-upload-cancel" ng-show="!active() && fileSelected">
					<a href="#" class="file-upload-cancel" ng-click="$event.preventDefault();">cancel</a>
				</div>

				<div class="clearfix"></div>

				<div class="file-upload-progress-block" ng-show="active() && fileSelected">
					<div class="progress progress-striped active" file-upload-progress="progress()">
						<div class="progress-bar progress-bar-success"
							 ng-style="{width: num + '%'}"></div>
					</div>
				</div>
			</form>

			<div class="well success-message upload-message"
				 ng-if="fileUploadResults && !fileUploadResults.upload_failed">
				<strong>Upload was {{ phrase('admin.server.success') }}</strong><br>
				<a ng-href="{{ ng_var('fileUploadResults.uploaded_file_url') }}" target="_blank">
					{{ phrase('admin.server.download_attachment') }}
				</a>
			</div>

			<div class="well danger-message upload-message"
				 ng-if="fileUploadResults && fileUploadResults.upload_failed">
				<strong>{{ phrase('admin.server.failed') }}: {{ ng_var('fileUploadResults.upload_failed') }}</strong><br/>
				We detected a problem while trying to upload your file. The most likely reasons are:
				<ul style="margin-top: 3px;">
					<li style="margin-bottom: 3px;" ng-if="tmpIsNotWritable()">
						The temporary storage directory (upload_tmp_dir in php.ini) is currently set to
						<strong ng-if="php_vars.upload_tmp_dir">{{ ng_var('data.php_vars.upload_tmp_dir') }}</strong>
						<strong ng-if="!php_vars.upload_tmp_dir">{{ ng_var('data.php_vars.upload_tmp_dir_real') }}</strong>
						.
						This directory <strong>is not writable</strong> by the web server. This means
						uploads can not be saved and will always fail. Edit php.ini and specify a path that is
						writable by the server, or change permissions on the directory so the server can write to it.
					</li>
					<li ng-if="fileUploadResults.upload_failed == '{{ phrase('agent.general.attach_error_size') }}' ">
						You have chosen a file that is larger than your server
						configuration allows <strong>({{ ng_var('data.php_vars.upload_max_filesize') }})</strong>. File limits are set using the
						options in php.ini as displayed below.
					</li>
					<li ng-if="fileUploadResults.upload_failed && fileUploadResults.upload_status === 414">
						Your web server (such as IIS, nginx or Apache) enforces its own limits.
						Limits enforced by the web server cannot be detected by the helpdesk and need to be
						checked manually.
					</li>
					<li ng-if="fileUploadResults.upload_failed && fileUploadResults.upload_status !== 414">
						Your web server respond with error while trying to upload test file.<br/>
						Check the information below and contact your system administrator handing they this information:
						<br/>
						<pre>
Error message: {{ ng_var('fileUploadResults.error_message') }}
Response status: {{ ng_var('fileUploadResults.upload_status') }}
Headers: {{ ng_var('fileUploadResults.response_headers') }}
						</pre>
					</li>
				</ul>
			</div>
		</article>
	</section>

	{##################################################################################################}

	<section class="dp-paneblock dp-listpane">
		<header>
			<h3>File Upload Configuration</h3>
		</header>

		<article class="padd">
			<p>
				These settings control the maximum file size allowed by your server. Deskpro has its own local settings that you can change from <strong>Setup > Settings</strong>, but your server configuration will also impose hard limits.
                The max file size supported by your server is {{ ng_var('data.php_vars.upload_max_filesize') }}.
			</p>
		</article>

		<article class="padd">
			<h4>Deskpro Settings</h4>
			<p>
				You can edit these settings from the main <a href="{{ ng_href('setup.settings') }}">Settings</a> page.
			</p>
			<table class="table table-bordered" style="margin-top: 15px;">
				<thead>
					<tr>
						<th>
							Setting
						</th>
						<th>
							Users
						</th>
						<th>
							Agents
						</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>Max Upload Size</td>
						<td>
							{{ ng_var('data.restrictions.attach_user_maxsize | filesize_display') }}
						</td>
						<td>
							{{ ng_var('data.restrictions.attach_agent_maxsize | filesize_display') }}
						</td>
					</tr>
					<tr>
						<td>File Types</td>
						<td>
						<span ng-if="data.restrictions.attach_user_not_exts && !data.restrictions.attach_user_must_exts">
							All file types except these are allowed:
							<br>{{ ng_var('data.restrictions.attach_user_must_exts') }}
						</span>
						<span ng-if="!data.restrictions.attach_user_not_exts && data.restrictions.attach_user_must_exts">
							Only these file types allowed:
							<br>{{ ng_var('data.restrictions.attach_user_not_exts') }}
						</span>
						<span ng-if="!data.restrictions.attach_user_not_exts && !data.restrictions.attach_user_not_exts">
							All file types are allowed
						</span>
						</td>
						<td>
						<span ng-if="data.restrictions.attach_agent_not_exts && !data.restrictions.attach_agent_must_exts">
							All file types except these are allowed:
							<br>{{ ng_var('data.restrictions.attach_agent_must_exts') }}
						</span>
						<span ng-if="!data.restrictions.attach_agent_not_exts && data.restrictions.attach_agent_must_exts">
							Only these file types allowed:
							<br>{{ ng_var('data.restrictions.attach_agent_not_exts') }}
						</span>
						<span ng-if="!data.restrictions.attach_agent_not_exts && !data.restrictions.attach_agent_not_exts">
							All file types are allowed
						</span>
						</td>
					</tr>
				</tbody>
			</table>
		</article>

		<article class="padd">
			<h4>Server Settings</h4>
			<p>
				{{ phrase('admin.server.edit_php_ini_to_make_changes') }}
				<a ng-href="{{ ng_var('data.url_to_learn_php_ini') }}">
					{{ phrase('admin.server.learn_about_editing_php_ini') }}
				</a>
			</p>

			<p ng-if="data.php_ini_path">
				We have detected the path to your php.ini file at {{ ng_var('data.php_ini_path') }}
			</p>

			<table class="table table-bordered" style="margin-top: 15px;">
				<thead>
					<tr>
						<th>
							{{ phrase('admin.server.php_settings') }}
						</th>
						<th>
							{{ phrase('agent.general.value') }}
						</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>
							<a href="http://www.php.net/manual/en/ini.core.php#ini.file-uploads">file_uploads</a>

							<p>{{ phrase('admin.server.required_for_upload') }}</p>
						</td>
						<td width="200">
							{{ ng_var('data.php_vars.file_uploads') }}
						</td>
					</tr>
					<tr>
						<td>
							<a href="http://www.php.net/manual/en/ini.core.php#ini.upload-tmp-dir">upload_tmp_dir</a>

							<p>{{ phrase('admin.server.php_upload_location') }}</p>

							<div ng-if="!data.php_vars.upload_tmp_dir">
								<p>
									<strong>Note:</strong> There is currently no value set in php.ini for
									upload_tmp_dir. The value shown to the right
									is your system temp directory which is used by default. If you are having problems
									uploading files, you should
									edit php.ini and set a specific path for upload_tmp_dir.
								</p>
							</div>
						</td>
						<td>
							<span ng-if="data.php_vars.upload_tmp_dir">
								{{ ng_var('data.php_vars.upload_tmp_dir') }}
							</span>
							<span ng-if="!data.php_vars.upload_tmp_dir">
								{{ ng_var('data.php_vars.upload_tmp_dir_real') }}
							</span>
						</td>
					</tr>
					<tr>
						<td>
							<a href="http://www.php.net/manual/en/ini.core.php#ini.upload-max-filesize">upload_max_filesize</a>

							<p>{{ phrase('admin.server.max_single_file_size') }}</p>
						</td>
						<td>
							{{ ng_var('data.php_vars.upload_max_filesize') }}
						</td>
					</tr>
					<tr>
						<td>
							<a href="http://www.php.net/manual/en/ini.core.php#ini.post-max-size">post_max_size</a>

							<p>{{ phrase('admin.server.max_post_size') }}</p>
						</td>
						<td>
							{{ ng_var('data.php_vars.post_max_size') }}
						</td>
					</tr>
					<tr>
						<td>
							<a href="http://www.php.net/manual/en/ini.core.php#ini.memory-limit">memory_limit</a>

							<p>{{ phrase('admin.server.upload_memory_limit_explain') }}</p>
						</td>
						<td>
							<span ng-if="data.php_vars.memory_limit_real == -1">
								No limit
							</span>

							<span ng-if="data.php_vars.memory_limit_real != -1">
								{{ ng_var('data.php_vars.memory_limit_real | filesize_display') }}
							</span>

							<div
									style="font-size: 11px;"
									ng-if="data.php_vars.memory_limit &&
									 data.php_vars.memory_limit
									  != data.php_vars.memory_limit_real
									  ">
								Successfully changed to
								{{ ng_var('data.php_vars.memory_limit | filesize_display') }}
								at runtime
							</div>
						</td>
					</tr>
					<tr>
						<td>
							{{ phrase('admin.server.upload_effect_max') }}

							<p>{{ phrase('admin.server.upload_effect_max_explain') }}</p>
						</td>
						<td>
							Approximately {{ ng_var('data.effective_max_upload_size') }}
						</td>
					</tr>
				</tbody>
			</table>
		</article>
	</section>

{% endblock %}
