{% extends 'AdminInterfaceBundle:Layout:fullpage-pane.html.twig' %}

{% block fullpane_content %}

	<section class="dp-paneblock dp-panelink">
		<a href="{{ ng_href('server.audit_logs') }}">
			<em><i class="fa fa-chevron-down"></i></em>

			<h3>{{ phrase('admin.audit_logs.title') }}</h3>
		</a>
	</section>

	<section class="dp-paneblock dp-listpane">
		<header>
			<h3>{{ phrase('admin.audit_logs.log_title') }}{{ ng_var('ServerAuditLogsView.log.id') }}</h3>
		</header>

		{##################################################################################################}

		<article class="form-horizontal dp-form">
			<div class="panel panel-fill indent">
				<div class="panel-body">
					<div class="form-group">
						<div class="col-sm-3">
							<h3>{{ phrase('admin.audit_logs.date_created') }}</h3>
						</div>
						<div class="col-sm-9">
							{{ ng_var('ServerAuditLogsView.log.date_created') }}
						</div>
					</div>
				</div>
                <div class="panel-body">
                    <div class="form-group">
                        <div class="col-sm-3">
                            <h3>{{ phrase('admin.audit_logs.performer') }}</h3>
                        </div>
                        <div class="col-sm-9">
                            {{ ng_var('ServerAuditLogsView.log.performer_name') }}{#
                            #}<span ng-show="ServerAuditLogsView.log.performer_id">[{{ ng_var('ServerAuditLogsView.log.performer_id') }}]</span>
                        </div>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="form-group">
                        <div class="col-sm-3">
                            <h3>{{ phrase('admin.audit_logs.action') }}</h3>
                        </div>
                        <div class="col-sm-9">
                            {{ ng_var('ServerAuditLogsView.log.action') }}
                        </div>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="form-group">
                        <div class="col-sm-3">
                            <h3>{{ phrase('admin.audit_logs.description') }}</h3>
                        </div>
                        <div class="col-sm-9">
                            {{ ng_var('ServerAuditLogsView.log.description') }}
                        </div>
                    </div>
                </div>
                <div class="panel-body" ng-show="ServerAuditLogsView.log.object_id">
                    <div class="form-group">
                        <div class="col-sm-3">
                            <h3>{{ phrase('admin.audit_logs.object_description') }}</h3>
                        </div>
                        <div class="col-sm-9">
                            {{ ng_var('ServerAuditLogsView.log.object_name') }}
                            - {{ ng_var('ServerAuditLogsView.log.object_type') }}{#
                            #}[{{ ng_var('ServerAuditLogsView.log.object_id') }}]
                        </div>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="form-group">
                        <div class="col-sm-3">
                            <h3>{{ phrase('admin.audit_logs.changeset') }}</h3>
                        </div>
                        <div class="col-sm-9">
                            <pre>{#
                                #}{{ ng_var('ServerAuditLogsView.getChangeSet()') }}
                            </pre>
                        </div>
                    </div>
                </div>
			</div>
		</article>

	</section>

{% endblock %}
