{% extends 'AdminInterfaceBundle:Layout:fullpage-pane.html.twig' %}

{% block fullpane_content %}

	<section class="dp-paneblock dp-panelink">
		<a href="{{ ng_href('server.incidents') }}">
			<em><i class="fa fa-chevron-down"></i></em>
			<h3>Incidents</h3>
		</a>
	</section>

	<section class="dp-paneblock dp-listpane">
		<header>
			<h3>
				{{ phrase('admin.general.event') }} #{{ ng_var('View.event.id') }}
				&mdash; {{ ng_var('View.event.class') }}
			</h3>
		</header>

		{##################################################################################################}

		<article class="padd">
			<table class="table table-bordered">
				<tr>
					<td>Date</td><td>{{ ng_var('View.event.date_created') }}</td>
				</tr>
				<tr>
					<td>Message</td><td>{{ ng_var('View.event.message') }}</td>
				</tr>
			</table>
		</article>
		<article class="padd">
			<h4>Trace</h4>
			<table>
				<tr ng-repeat="(key, value) in View.event.trace">
					<td>
						<pre class="trace">{{ ng_var('value | json') }}</pre>
					</td>
				</tr>
			</table>
		</article>
	</section>

{% endblock %}
