{% extends 'AdminInterfaceBundle:Layout:fullpage-pane.html.twig' %}

{% block fullpane_content %}
    <section class="dp-paneblock dp-listpane" ng-if="usersourceSettings.has_agent_login_form">
        <header>
            <h3>Agent Login Lockout</h3>
        </header>

        <article class="form-horizontal dp-form">
            <div class="panel panel-innertable">
                <div class="form-group">
                    <div class="col-lg-12">
                        <div class="inner-group">
                            <label>
                                <input type="checkbox" ng-model="agent_rate_settings.enabled" />
                                <h4>{{ phrase('adm.settings.rate_limit_enabled_title') }}</h4>
                            </label>
                            <span class="help-block">
                                {{ phrase('adm.settings.rate_limit_help') }}
                            </span>
                            <div ng-show="agent_rate_settings.enabled">
                                After
                                <input type="number" min="1" ng-model="agent_rate_settings.attempts" class="form-control" style="width: 50px;" />
                                failed login attempts within
                                <dp-time-with-unit ng-model="agent_rate_settings.attempts_time"></dp-time-with-unit>
                                , lock the account for
                                <dp-time-with-unit ng-model="agent_rate_settings.lock_time"></dp-time-with-unit>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </article>
    </section>

    <section class="dp-paneblock dp-listpane" ng-if="usersourceSettings.has_user_login_form">
        <header>
            <h3>User Login Lockout</h3>
        </header>

        <article class="form-horizontal dp-form">
            <div class="panel panel-innertable">
                <div class="form-group">
                    <div class="col-lg-12">
                        <div class="inner-group">
                            <label>
                                <input type="checkbox" ng-model="user_rate_settings.enabled" />
                                <h4>{{ phrase('adm.settings.rate_limit_enabled_title') }}</h4>
                            </label>
                            <span class="help-block">
                                {{ phrase('adm.settings.rate_limit_help') }}
                            </span>
                            <div ng-show="user_rate_settings.enabled">
                                After
                                <input type="number" min="1" ng-model="user_rate_settings.attempts" class="form-control" style="width: 50px;" />
                                failed login attempts within
                                <dp-time-with-unit ng-model="user_rate_settings.attempts_time"></dp-time-with-unit>
                                , lock the account for
                                <dp-time-with-unit ng-model="user_rate_settings.lock_time"></dp-time-with-unit>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </article>
    </section>

    <section class="dp-paneblock dp-listpane">
        <footer>
            <div class="dp-content">
                <div class="dp-btn-controls" ng-hide="form_props.$attempted && form_props.$invalid">
                    <div dp-hide-spinning="saving_settings">
                        <button class="btn btn-primary"  ng-click="LoginLockoutSettings.save()">{{ phrase('agent.general.save') }}</button>
                    </div>
                    <div dp-show-spinning="saving_settings">
                        <i class="spinner-flat"></i>
                    </div>
                </div>
            </div>
        </footer>
    </section>

    <div dp-register-message="saved_settings">Settings saved successfully.</div>
{% endblock %}
