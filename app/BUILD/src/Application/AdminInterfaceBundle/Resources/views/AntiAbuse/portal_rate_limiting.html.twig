                                <h4>{{ phrase('admin.settings.portal_rate_limit_share_rate_limit') }}</h4>
                            </label>
                            <div ng-show="settings.guest_rate_limit.share_content.enabled">
                                {{ phrase('admin.settings.portal_rate_limit_share_attempted') }}
                                <input type="number" min="1" ng-model="settings.guest_rate_limit.share_content.limit" class="form-control" style="width: 60px;" />
                                {{ phrase('admin.settings.portal_rate_limit_times_within') }}
                                <input type="number" min="1" ng-model="settings.guest_rate_limit.share_content.time" class="form-control" style="width: 60px;" />
                                {{ phrase('admin.settings.portal_rate_limit_minutes') }}
                                <select ng-model="settings.guest_rate_limit.share_content.response">
                                    <option value="captcha">{{ phrase('admin.settings.portal_rate_limit_show_captcha') }}</option>
                                    <option value="lockout">{{ phrase('admin.settings.portal_rate_limit_reject_form') }}</option>
                                </select>
                                <span ng-show="settings.guest_rate_limit.share_content.response === 'lockout'">
                                    {{ phrase('admin.settings.portal_rate_limit_within') }}
                                    <input
                                            type="number"
                                            min="1"
                                            ng-model="settings.guest_rate_limit.share_content.lockout_time"
                                            class="form-control" style="width: 60px;" />
                                    {{ phrase('admin.settings.portal_rate_limit_minutes') }}
                                </span>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </article>
    </section>

    <section class="dp-paneblock dp-listpane">
        <footer>
            <div class="dp-content">
                <div class="dp-btn-controls" ng-hide="form_props.$attempted && form_props.$invalid">
                    <div dp-hide-spinning="saving_settings">
                        <button class="btn btn-primary"  ng-click="PortalRateLimiting.save()">{{ phrase('agent.general.save') }}</button>
                    </div>
                    <div dp-show-spinning="saving_settings">
                        <i class="spinner-flat"></i>
                    </div>
                </div>
            </div>
        </footer>
    </section>

    <div dp-register-message="saved_settings">{{ phrase('admin.general.save_settings_success') }}</div>
{% endblock %}
