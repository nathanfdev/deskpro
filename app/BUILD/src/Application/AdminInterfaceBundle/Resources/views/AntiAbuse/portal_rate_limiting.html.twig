{% extends 'AdminInterfaceBundle:Layout:fullpage-pane.html.twig' %}

{% block fullpane_content %}
    <section class="dp-paneblock dp-listpane" ng-if="usersourceSettings.reg_enabled || usersourceSettings.has_user_login_form">
        <header>
            <h3>Account Rate Limiting</h3>
        </header>

        <article class="form-horizontal dp-form" ng-if="usersourceSettings.has_user_login_form">
            <div class="panel panel-innertable">
                <div class="form-group">
                    <div class="col-lg-12">
                        <div class="inner-group">
                            <label>
                                <input type="checkbox" ng-model="settings.account_rate_limit.login_settings.enabled" />
                                <h4>Login Rate Limiting (<a href="{{ ng_href('setup.login_lockout_settings') }}">see also Login Lockout</a>)</h4>
                            </label>
                            <div ng-show="settings.account_rate_limit.login_settings.enabled">
                                After a user has attempted to login
                                <input type="number" min="1" ng-model="settings.account_rate_limit.login_settings.limit" class="form-control" style="width: 60px;" />
                                times within
                                <input type="number" min="1" ng-model="settings.account_rate_limit.login_settings.time" class="form-control" style="width: 60px;" />
                                minutes,
                                <select ng-model="settings.account_rate_limit.login_settings.response">
                                    <option value="captcha">show a CAPTCHA to the user </option>
                                    <option value="lockout">disable login form for the user</option>
                                </select>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </article>

        <article class="form-horizontal dp-form" ng-if="usersourceSettings.reg_enabled">
            <div class="panel panel-innertable">
                <div class="form-group">
                    <div class="col-lg-12">
                        <div class="inner-group">
                            <label>
                                <input type="checkbox" ng-model="settings.account_rate_limit.registration_settings.enabled" />
                                <h4>Registration Rate Limiting</h4>
                            </label>
                            <div ng-show="settings.account_rate_limit.registration_settings.enabled">
