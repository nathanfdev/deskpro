{% extends 'AdminInterfaceBundle:Layout:fullpage-pane.html.twig' %}

{% block fullpane_content %}
    <section class="dp-paneblock dp-listpane">
        <header>
            <h3>
                <span>Rate-limiting CAPTCHA</span>
            </h3>
        </header>

        <article class="form-horizontal dp-form">
            <div class="panel panel-innertable">
                <div class="panel-help inhelp-body">
                    <p>
                        This option limits the rate of interactions with the helpdesk from
                        a given IP address by displaying a CAPTCHA test to make sure the traffic is coming from a human and not an automated program posting spam.
                    </p>
                    <p>Note that this is separate from <a href="/admin/#/setup/login_lockout_settings">Login attempt rate limiting</a>, which locks an account after multiple failed login attempts.</p>
                </div>
                <div class="form-group">
                    <div class="col-lg-12">

                        <div class="inner-group">
                            <label>
                                <h4>
                                    <input type="checkbox" class="form-control" ng-model="general_settings.rate_limit_disabled" style="width: auto;vertical-align: middle;margin-top: 1px;" />
                                    Disable rate-limiting
                                </h4>
                            </label>
                        </div>

                        <div class="inner-group">
                            <label>
                                <h4>
                                    Whitelist IP addresses
                                    <i class="fa fa-question-circle qmark-icon" tooltip="If many agents/users are coming from a shared IP address and are seeing CAPTCHAs all the time, whitelist the address. Separate multiple addresses with commas." tooltip-placement="right"></i>
                                </h4>
                            </label>
                            <div>
                                <input type="text" class="form-control"
                                       ng-model="general_settings.rate_limit_ips"
                                       style="width: 40%;"
                                       ng-list
                                />
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </article>
    </section>

    <section class="dp-paneblock dp-listpane" ng-hide="general_settings.rate_limit_disabled">
        <header>
            <h3>CAPTCHA System</h3>
        </header>

        <article class="form-horizontal dp-form">
            <div class="row">
                <div class="col-lg-10">
                    <div class="panel panel-innertable">
                        <div class="inner-group">
                            <label>
                                <input type="radio" ng-model="settings.use_recaptcha2" value="0">
                                <h4>Use DeskPRO's built-in CAPTCHA system</h4>
                            </label>
                            <span class="help-block">
                                DeskPRO comes with an image-based CAPTCHA system that is suitable for most helpdesks.
                            </span>
                        </div>
                        <div class="inner-group">
                            <label>
                                <input type="radio" ng-model="settings.use_recaptcha2" value="1">
                                <h4>Use reCAPTCHA (from Google)</h4>
                            </label>
                            <div ng-show="settings.use_recaptcha2 == 1">
                                <span class="help-block">
                                    reCAPTCHA is a service operated by Google. reCAPTCHA uses advanced techniques to detect
                                    abusive users and it may be more effective than DeskPRO's built-in system.
                                </span>
                                <span class="help-block">
                                    To use reCAPTCHA, you must register for a free API key <a href="https://www.google.com/recaptcha/admin" target="_blank">here</a>.
                                </span>
                                <span class="help-block">
                                    Site Key: <input type="text" ng-model="settings.recaptcha2_site_key" />
                                    &nbsp;&nbsp;&nbsp;
                                    Secret Key: <input type="text" ng-model="settings.recaptcha2_secret_key" /><br/>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </article>
    </section>

    <section class="dp-paneblock dp-listpane" ng-hide="general_settings.rate_limit_disabled">
        <header>
            <h3>CAPTCHA Settings</h3>
        </header>

        <article class="form-horizontal dp-form">
            <div class="row">
                <div class="col-lg-10">
                    <div class="panel panel-innertable">
                        <div class="inner-group">
                            <span class="help-block">
                                Normally CAPTCHA is only displayed in response to an user going over your defined <a href="{{ ng_href('setup.email_rate_limiting') }}">rate limits</a>.
                            </span>
                            <span class="help-block">
                                However, to reduce abuse/spam, you can choose to always enable CAPTCHA on certain features.
                            </span>
                        </div>
                        <div class="inner-group">
                            Enable captcha on new tickets
                            <select ng-model="settings.tickets">
                                <option value="">based on rate limits</option>
                                <option value="guests">for guests</option>
                                <option value="everyone">for everyone</option>
                            </select>
                        </div>
                        <div class="inner-group">
                            Enable captcha on new comments
                            <select ng-model="settings.comments">
                                <option value="">based on rate limits</option>
                                <option value="guests">for guests</option>
                                <option value="everyone">for everyone</option>
                            </select>
                        </div>
                        <div class="inner-group">
                            Enable captcha on new feedback
                            <select ng-model="settings.feedback">
                                <option value="">based on rate limits</option>
                                <option value="guests">for guests</option>
                                <option value="everyone">for everyone</option>
                            </select>
                        </div>
                        <div class="inner-group">
                            Enable captcha on registration
                            <select ng-model="settings.register">
                                <option value="">based on rate limits</option>
                                <option value="everyone">always</option>
                            </select>
                        </div>
                        <div class="inner-group">
                            Enable captcha on sharing content
                            <select ng-model="settings.sharing">
                                <option value="">based on rate limits</option>
                                <option value="guests">for guests</option>
                                <option value="everyone">for everyone</option>
                            </select>
                        </div>
                    </div>
                    </div>
                </div>
            </div>
        </article>
    </section>

    <section class="dp-paneblock dp-listpane">
        <footer>
            <div class="dp-content">
                <div class="dp-btn-controls" ng-hide="form_props.$attempted && form_props.$invalid">
                    <div dp-hide-spinning="saving_settings">
                        <button class="btn btn-primary"  ng-click="CaptchaSettings.save()">{{ phrase('agent.general.save') }}</button>
                    </div>
                    <div dp-show-spinning="saving_settings">
                        <i class="spinner-flat"></i>
                    </div>
                </div>
            </div>
        </footer>
    </section>

    <div dp-register-message="saved_settings">Settings saved successfully.</div>
{% endblock %}
