<div class="panel panel-fill indent">
	<div class="panel-body">
		<div class="form-group">
			<div class="col-md-3">
				<h3>{{ phrase('agent.general.title') }} *</h3>
			</div>
			<div class="col-md-9">
				<div class="inner-group" dp-error-class="form_props.title">
					<input type="text" class="form-control" name="title" ng-model="EditCtrl.form.title" style="width: 50%;" required dp-server-validation="department.title.required,department.title.test" autofocus />
					{% if app.getLanguages().isMultiLang() %}
						<span
							class="translate-button"
							tooltip="{{ phrase('adm.general.translate') }}"
							dp-open-phrase-editor="{ context: 'agent', phraseId: 'obj_department.' + EditCtrl.dep.id }"
						></span>
					{% endif %}
					<span class="help-block">
						{{ phrase('adm.departments.title_explain') }}
					</span>
				</div>

				<div class="inner-group">
					<label>
						<input type="checkbox" ng-model="EditCtrl.form.enable_user_title" value="1" />
						<h4>{{ phrase('adm.departments.user_title') }}</h4>
					</label>
					<div ng-show="EditCtrl.form.enable_user_title">
						<input type="text" class="form-control" ng-model="EditCtrl.form.user_title" style="width: 50%;" />
						{% if app.getLanguages().isMultiLang() %}<span class="translate-button" tooltip="{{ phrase('adm.general.translate') }}" ng-if="EditCtrl.dep.id" dp-open-phrase-editor="{ context: 'agent', phraseId: 'obj_department.' + EditCtrl.dep.id + '_user' }"></span>{% endif %}
					</div>
					<span class="help-block">

					</span>
				</div>
			</div>
		</div>
		<div class="form-group" ng-if="!EditCtrl.dep.has_children" ng-show="EditCtrl.brands.length > 1">
			<div class="col-lg-3">
				<h3>{{ phrase('agent.general.brands') }}</h3>
			</div>
			<div class="col-lg-9">
				<ul class="dp-item-list checkbox-list" ng-model="EditCtrl.form.brands"
					style="overflow-y: auto; max-height: {{ 20 * 24 }}px;min-width: 250px;max-width:400px;">
					<li ng-repeat="brand in EditCtrl.brands">
						<label style="width: 100%;padding-left:20px;position: relative;white-space: nowrap;">
							<input type="checkbox" value="{{ ng_var('brand.id') }}" ng-click="EditCtrl.handleBrand(brand.id, $event)" ng-checked="EditCtrl.form.brands.indexOf(brand.id) > -1" />
							{{ ng_var('brand.name') }}
						</label>
					</li>
				</ul>
			</div>
		</div>
		<div class="form-group">
			<div class="col-lg-3">
				<h3>Department Avatar</h3>
			</div>
			<div class="col-lg-9">
				<div class="inner-group">
					<label>
						<input type="checkbox" ng-model="EditCtrl.form.enable_avatar" />
						<h4>Enable department avatar</h4>
					</label>
				</div>

				<div ng-show="EditCtrl.form.enable_avatar">
					<img ng-src="{{ ng_var('icon_image') }}" ng-show="icon_image" height="50" />&nbsp;&nbsp;&nbsp;
					<a href="javascript:;" ng-click="EditCtrl.$modal.open({ templateUrl: ListCtrl.getTemplatePath('Index/modal-icons.html'), scope: this })">Pick Avatar</a>
					|
					<a href="javascript:;" class="file-upload-wrapper">
						<input type="file" ng-file-select="EditCtrl.onFileSelect($files)" accept="image/*" />
						Upload Avatar
					</a>
					<i class="spinner-flat" ng-show="uploading"></i>
				</div>
			</div>
		</div>
		<div class="form-group" ng-if="!EditCtrl.dep.has_children">
			<div class="col-md-3">
				<h3>{{ phrase('agent.general.parent') }}</h3>
			</div>
			<div class="col-md-9">
				<select
					ui-select2
					ng-model="EditCtrl.form.parent_id"
					style="min-width: 240px"
					class="no-search"
				>
					<option value="0">No Parent</option>
					<option value="{{ ng_var('dep.id') }}" ng-repeat="dep in EditCtrl.dep_parent_list">{{ ng_var('dep.title') }}</option>
				</select>
				<span class="help-block">
					{{ phrase('adm.departments.parent_explain') }}
				</span>

				<div class="alert alert-info ng-hide" ng-show="show_parent_warning">
					<p>
						<strong>{{ phrase('adm.departments.parent_not_parent') }}</strong>
					</p>
					<ul>
						<li>{{ phrase('adm.departments.parent_convert', {title: 'ng_var(show_parent_warning.title)' }) }}</li>
						<li>{{ phrase('adm.departments.parent_convert_move', {title: 'ng_var(show_parent_warning.title)', title2: 'ng_var(EditCtrl.form.title)' }) }}</li>
					</ul>
				</div>
			</div>
		</div>

		{##############################################################################################}

		<div class="form-group" ng-if="!EditCtrl.dep.has_children">
			<div class="col-md-3">
				<h3>New Ticket Trigger</h3>
			</div>
			<div class="col-md-9">
				<div class="alert alert-danger" ng-if="!EditCtrl.trigger.is_enabled && !EditCtrl.trigger.department_triggers_enabled">
					<p>
						Warning: Department triggers are disabled from
						{% set href = ng_href('tickets.triggers', {type: 'newticket'}) %}
						<a href="{{ href }}">
							New Ticket Triggers
						</a>
					</p>
				</div>
				<div class="dp-ob-set">
					<div class="dp-ob-setrow">
						<header>
							When a new ticket is submitted through the portal in this department:
						</header>
						<article>
							<dp-option-builder types-def="EditCtrl.actionsTypeDef" save-target="actions_form" options="{tag_first: '', tag_after: 'then', fixedExpanded: ['SetEmailAccount', 'SendUserNewEmail'], fixOn: ['SetEmailAccount'] }" option-types="actionOptionTypes">
								<add-btn-label>Action</add-btn-label>
							</dp-option-builder>
						</article>
					</div>
				</div>
			</div>
		</div>

		<div class="form-group" ng-if="!EditCtrl.dep.has_children">
			<div class="col-md-3">
				<h3>Ticket Changed Trigger</h3>
			</div>
			<div class="col-md-9">
				<div class="alert alert-danger" ng-if="!EditCtrl.trigger2.is_enabled && !EditCtrl.trigger2.department_triggers_enabled">
					<p>
						Warning: Department triggers are disabled from
                        {% set href = ng_href('tickets.triggers', {type: 'update'}) %}
						<a ng-href="{{ href }}">
							Ticket Update Triggers
						</a>
					</p>
				</div>
				<div class="dp-ob-set">
					<div class="dp-ob-setrow">
						<header>
							When a ticket department is changed to this department:
						</header>
						<article>
							<dp-option-builder types-def="EditCtrl.actionsTypeDef" save-target="actions_form2" options="{tag_first: '', tag_after: 'then', fixedExpanded: ['SetEmailAccount'], fixOn: []}" option-types="actionOptionTypes">
								<add-btn-label>Action</add-btn-label>
							</dp-option-builder>
						</article>
					</div>
				</div>
			</div>
		</div>

		<div ng-if="EditCtrl.dep.has_children">
			<div class="alert alert-info">
				<p>
					This is a <strong>parent department</strong>. Parent departments act as simple containers for other sub-departments.
				</p>
				<p>
					Tickets can never be assigned directly to a parent department.
				</p>
				<p>
					Since this department is only a container, none of the other properties like permissions or layouts apply.
				</p>
			</div>
		</div>
	</div>
</div>
