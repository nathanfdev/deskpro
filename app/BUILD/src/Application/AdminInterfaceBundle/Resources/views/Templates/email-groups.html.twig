<div class="dp-email-templates">
    <div class="editor">
        <div class="ui celled grid">
            <div class="row">
                <div class="sixteen wide column">
                    <button class="ui button basic">
                        <i class="icon users"></i>
                        User email templates
                    </button>
                    <button class="ui button basic">
                        <i class="flag gb"></i>
                        English
                    </button>
                    <button class="ui right floated button">
                        + New Template
                    </button>
                </div>
            </div>
            <div class="row">
                <div class="seven wide column">
                    <i class="icon mail"></i>
                    Register Welcome Email
                    <i class="fa fa-caret-down"></i>
                </div>
                <div class="three wide column">
                    <i class="icon dollar"></i>
                    Variables
                    <i class="fa fa-caret-down"></i>
                </div>
                <div class="three wide column">
                    <i class="icon globe"></i>
                    Phrases
                    <i class="fa fa-caret-down"></i>
                </div>
                <div class="three wide column">
                    <i class="icon image"></i>
                    Media
                    <i class="fa fa-caret-down"></i>
                </div>
            </div>
        </div>
        <div class="dp-code-editor">
            Email subject:
            <div class="email-subject with-ace-editor">

            </div>
            Email:
            <div class="email-body with-ace-editor">

            </div>
        </div>
        <div class="footer">
            <button class="ui primary small button">Save changes</button>
            <button class="ui basic small button">Undo changes</button>
            <button class="ui right floated basic small button">Reset template</button>
        </div>
    </div>
    <div class="preview">
        <div class="header">
            <p>
                Enter details below to send a test email to yourself or a colleague.
            </p>
            <form class="ui form">
                <div class="fields">
                    <div class="six wide field">
                        <label>From</label>
                        <div class="ui selection dropdown">
                            <input type="hidden">
                            <i class="dropdown icon"></i>
                                <span class="item">support@deskpro.com</span>
                            </i>
                        </div>
                    </div>
                    <div class="six wide field">
                        <label for="test_email_to">To</label>
                        <input type="text" name="to" id="test_email_to" />
                    </div>
                    <div class="four wide field">
                        <label>&nbsp;</label>
                        <input type="submit" class="ui basic button" value="Send">
                    </div>
                </div>
            </form>

        </div>
        <div class="email-preview">
            <div class="email">
                Test preview email
            </div>
        </div>
    </div>
</div>
