<div class="ui left labeled language button" dp-open-phrase-map-editor="{phrase_map: translations, key: key, languages: languages}">
    <a class="ui basic label">
        <i class="icon globe"></i>
    </a>
    <div class="ui button" ng-if="languages">
        {{ ng_var('getProgress()') }}
        <div class="ui tiny progress" ng-if="getPercent() < 100">
            <div class="bar" ng-style="{width: getPercent() + '%'}"></div>
        </div>
        <i class="icon check" ng-if="getPercent() == 100"></i>
    </div>
</div>
