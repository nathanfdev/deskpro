{% extends 'AdminInterfaceBundle:Layout:list-editpane.html.twig' %}

{% block editpane_content %}

		<section class="dp-paneblock dp-editpane">

			<nav class="dp-blocktabs responsive">
				<ul>
					<li class="active" dp-tab-btn="logs.list"><a href="#"><i class="fa fa-table"></i> {{ phrase('adm.api_logs.title') }}</a></li>
                    <li class="pipe">|</li>
					<li dp-tab-btn="logs.config"><a href="#"><i class="fa fa-settings"></i> {{ phrase('adm.api_logs.config') }}</a></li>
				</ul>
			</nav>

			<article>
				<div dp-tab-body="logs.list" class="dp-tabletabs-contentwrap">
                    <div class="dp-btn-pagination">
                        <button class="btn btn-primary" ng-click="LogsCtrl.refreshList()">
                            {{ phrase('adm.api_logs.refresh') }}
                        </button>
                        <select
                                ng-model="LogsCtrl.pagination.page"
                                ui-select2
                                style="width: 130px;"
                                >
                            <option ng-repeat="page in LogsCtrl.pagination.page_nums" value="{{ ng_var('page') }}">
                                Page {{ ng_var('page') }}
                            </option>
                        </select>
                    </div>
					<table dp-hide-spinning="loading" class="table table-hover" style="word-break: break-word;">
						<thead>
						<tr>
							<th> {{ phrase('adm.api_logs.request_id') }}</th>
							<th>
                                <select
                                    ng-model="LogsCtrl.filtration.mode"
                                    ui-select2="{allowClear: true}"
                                    data-placeholder = "{{ phrase('adm.api_logs.mode') }}"
                                    style="width: 130px;">
                                    <option></option>
                                    <option ng-repeat="mode in LogsCtrl.modes" value="{{ ng_var('mode') }}">
                                        {{ ng_var('mode') }}
                                    </option>
                                </select>
                            </th>
                            <th> {{ phrase('adm.api_logs.requested_uri') }}</th>
                            <th>
                                <select
                                    ng-model="LogsCtrl.filtration.method"
                                    ui-select2="{allowClear: true}"
                                    data-placeholder = "{{ phrase('adm.api_logs.request_method') }}">
                                    <option></option>
                                    <option ng-repeat="method in LogsCtrl.methods" value="{{ ng_var('method') }}">
                                        {{ ng_var('method') }}
                                    </option>
                                </select>

                            </th>
                            <th style="width: 75px;"> {{ phrase('adm.api_logs.response_status') }}</th>
                            <th> {{ phrase('adm.api_logs.start_time') }}</th>
                            <th style="width: 50px;"> {{ phrase('adm.api_logs.time_taken') }}</th>
                        </tr>
						</thead>
						<tbody>

						<tr ng-repeat="log in LogsCtrl.list | filter:LogsCtrl.filtration">
							<td><a href="{{ ng_href('apps.api_keys.logs_view', '{id: log.id}') }}">{{ ng_var('log.request_id') }}</a></td>
							<td>{{ ng_var('log.mode') }}</td>
							<td>{{ ng_var('log.requested_uri') }}</td>
							<td>{{ ng_var('log.method') }}</td>
							<td>{{ ng_var('log.status') }}</td>
							<td nowrap="nowrap">{{ ng_var('log.start_date_time') }}</td>
							<td>{{ ng_var('log.end_time - log.start_time') }}</td>
						</tr>
						</tbody>
					</table>
                    <div dp-show-spinning="loading" class="dp-layout-loading">
                        <i></i>
                    </div>
                    <div class="dp-btn-pagination">
                        <select
                                ng-model="LogsCtrl.pagination.page"
                                ui-select2
                                style="width: 130px;"
                                ng-options='page as ("Page " + page) for page in LogsCtrl.pagination.page_nums'
                                >
                        </select>
                    </div>
				</div>
                <div dp-tab-body="logs.config" class="panel panel-fill indent">
                    <div class="panel-body">
                        <div class="form-horizontal dp-form">
                            <div class="form-group">
                                <div class="col-lg-3">
                                    <h3>Enabled</h3>
                                </div>
                                <div class="col-lg-9">
                                    <label>
                                        <input type="checkbox" ng-model="LogsCtrl.options.enabled"/>
                                    </label>
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-lg-3">
                                    <h3>Max request body length (bytes)</h3>
                                </div>
                                <div class="col-lg-9">
                                    <input type="input" ng-model="LogsCtrl.options.request_length"/>
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-lg-3">
                                    <h3>Max response body length (bytes)</h3>
                                </div>
                                <div class="col-lg-9">
                                    <input type="input" ng-model="LogsCtrl.options.response_length"/>
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-lg-12 api-logs__max-logs-per-key">
                                    <h3>Keep logs for max </h3>
                                    <input type="number" step="1" min="1" ng-model="LogsCtrl.options.keep_days"/>
                                    <h3 > days and keep at most </h3>
                                    <input type="number" step="1" min="1" ng-model="LogsCtrl.options.per_key"/>
                                    <h3> records for each key</h3>
                                </div>
                                <span class="help-block" ng-show="LogsCtrl.isCloud">
                                    Note: non-key logs will be affected only by "max days to keep" setting
                                </span>
                                {% if app.isCloud() %}
                                <span class="help-block" ng-show="LogsCtrl.isCloud">
                                    Note: you're using Cloud account and "max per key" logs count is bounded by number of 2500
                                </span>
                                {% endif %}
                            </div>
                            <div class="form-group">
                                <button class="btn btn-primary" ng-click="LogsCtrl.updateOptions()">Save</button>
                            </div>
                        </div>
                    </div>
                </div>
			</article>
		</section>

{% endblock %}
