{% extends 'AdminInterfaceBundle:Labels:layout.html.twig' %}
{% block listpane_content %}
	<section class="dp-paneblock dp-panelink">
		<a href="{{ ng_href('portal.feedback_settings') }}">
			<em><i class="fa fa-chevron-down"></i></em>
			<h3>Settings</h3>
		</a>
	</section>

	<section class="dp-paneblock dp-panelink">
		<a href="{{ ng_href('portal.feedback_statuses') }}">
			<em><i class="fa fa-chevron-down"></i></em>
			<h3>Statuses</h3>
		</a>
	</section>

	<section class="dp-paneblock dp-panelink">
		<a href="{{ ng_href('portal.feedback_types') }}">
			<em><i class="fa fa-chevron-down"></i></em>
			<h3>Types</h3>
		</a>
	</section>
	<section class="dp-paneblock dp-panelink">
		<a href="{{ ng_href('portal.feedback_categories') }}">
			<em><i class="fa fa-chevron-down"></i></em>
			<h3>Categories</h3>
		</a>
	</section>

    {% set prefix = 'portal.feedback_labels' %}
	<section class="dp-paneblock dp-listpane">
		<header>
			<nav>
				<dp-order-menu ng-model="sortOrder" order-dir-prefs="{'label': 'ASC', 'total': 'DESC'}">
					<option value="label">Label</option>
					<option value="total">Count</option>
				</dp-order-menu>
			</nav>

			<h3 ng-pluralize count="countDefinitions()" when="{{ ng_plural_phrase('adm.general.count_labels') }}"></h3>
		</header>
		<article>
			<ul class="dp-item-list" dp-max-height>
				<li ng-repeat="label in labels | orderObjectBy:order:orderReverse"
					dp-state-mark="label!:{{ prefix }}.edit.{{ ng_var('label.label|murmurhash') }}">

					<a href="{{ ng_href(prefix ~ '.edit', '{label: label.label}') }}">
						<div class="pull-right">
                        <span class="badge" ng-show="!delete_mode"
							  tooltip="The number of organizations with this label"
							  tooltip-placement="left" style="margin-top: -2px;">
                            {{ng_var('label.total')}}
                        </span>
						</div>
						<h4>
							<span class="title-text" dp-label="label" style="display: inline-block; padding: 1% 2%; border-radius: 3px"></span>
						</h4>
					</a>

				</li>
			</ul>
			<div class="dp-add-control">
				<a class="btn btn-default" href="{{ ng_href(prefix ~ '.gocreate') }}" ng-class="{'active': isStateActive('.create') }"><i class="fa fa-plus"></i> {{phrase('agent.general.add')}}</a>
			</div>
		</article>
	</section>

{% endblock %}
{% block listpane_help %}
	<header>
		<h1>Labeling feedback items helps agents and users find them.</h1>
<p>Labels are text tags that agents can use to help organize your helpdesk content.</p>
</header>
<article>
<section>
<p>Labels are used to match items when agents or users search helpdesk content.</p>

<p>You can rename misspelled or unhelpful labels using this screen.</p>
</section>
<section>
<h2><span>FAQ</span></h2>
<dl>
		<dt><em>Q:</em>How do I merge two labels?</dt>
		<dd><em>A:</em>
		Edit one label to have the same name as another, and the labels will be merged.
		</dd>

</dl>



</section>
<section class="related-content">
<h2><span>Related Content</span></h2>
<ul>
<li><i class="fa fa-book"></i> <a href="https://manuals.deskpro.com/html/admin/labels/managing-labels.html" target="_blank">Managing labels</a></li>
</ul>
    </section>

</article>

	</article>
{% endblock %}
