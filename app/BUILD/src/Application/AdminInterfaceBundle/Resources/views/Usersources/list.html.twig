{% extends 'AdminInterfaceBundle:Layout:list.html.twig' %}
{% block listpane_content %}
	<section class="dp-paneblock dp-listpane">
		<header>
				<nav>
					<span class="status-pinger saved-ping" dp-ping-flash="display_orders"><i
							class="fa fa-check-square-o-square"></i> {{ phrase('agent.general.saved') }}</span>
					{% include 'AdminInterfaceBundle:Layout:standard-settings-menu.html.twig' %}
				</nav>
			<h3>Authentication and SSO</h3>
		</header>
		<article>
			<ul class="dp-item-list" ui-sortable="ListCtrl.sortedListOptions">
				<li ng-repeat="source in ListCtrl.usersources"
					dp-state-mark="{{ ng_var('ListCtrl.show_url') }}.{{ ng_var('source.app ? source.app.id : "deskpro"') }}"
					class="with-drag-handle"
					data-id="{{ ng_var('source.usersource.id') }}">
					<a ng-href="{{ ng_href_var('ListCtrl.show_url', '{id: source.app ? source.app.id : "deskpro" }') }}">
						<aside style="display: inline-block">
							<i class="fa fa-bars drag-handle"></i>
							<span class="title-id" title="ID">#{{ ng_var('source.usersource.id') }}</span>
							<img ng-if="source.app" ng-src="{{ ng_var('source.app.package.icon_16') }}"
								alt="{{ ng_var('source.usersource.title') }}" style="vertical-align: inherit;" />
							<img ng-if="!source.app" ng-src="{{ asset('images/dp-logo-16.png') }}"
								alt="{{ ng_var('source.usersource.title') }}" style="vertical-align: inherit;" />
						</aside>

						<h4 style="line-height: normal; display: inline-block;">
							<span class="title-text">{{ ng_var('source.usersource.title') }}</span>
						</h4>

						<div class="pull-right">
							<em class="tag tag-warn" ng-show="source.usersource.is_sso">SSO</em>
							<em class="tag tag-warn" ng-show="source.usersource.sync_enabled">Sync</em>
							<em class="tag tag-warn" ng-show="!source.usersource.is_enabled">Disabled</em>
						</div>
					</a>
				</li>
			</ul>
			<div class="dp-add-control">
				<a class="btn btn-default" ng-href="{{ ng_href_var('ListCtrl.new_url') }}"><i class="fa fa-plus"></i> {{ phrase('agent.general.add') }}</a>
			</div>
		</article>
	</section>
	<section class="dp-paneblock dp-listpane" ng-show="ListCtrl.show_sync_section">
		<header>
			<h3>Sync</h3>
		</header>
		<article>
			<div class="dp-add-control" ng-show="!ListCtrl.sync_status.running_now">
				<p>
					<strong>Next Sync:</strong> {{ ng_var('ListCtrl.sync_next_text') }}
					<button ng-click="ListCtrl.startSync()" class="btn btn-default btn-xs navbar-right" style="margin-right: 10px;">
						Start Sync
					</button>
				</p>
			</div>
			<div class="dp-add-control" ng-show="ListCtrl.sync_status.running_now">
				<div class="alert alert-warning" style="margin-right: 10px;">

						<i class="spinner-flat"></i>
					The sync is currently running.
					<button ng-click="ListCtrl.stopSync()" class="btn btn-default btn-xs navbar-right" style="margin-right: 10px;">
						Stop Syncing
					</button>
				</div>
			</div>
			<ul class="dp-item-list" ui-sortable="ListCtrl.sortedListOptions">
				<li ng-repeat="source in ListCtrl.usersources"
					ng-if="source.usersource.sync_enabled"
					dp-state-mark="{{ ng_var('ListCtrl.sync_url') }}.{{ ng_var('source.app.id') }}"
					data-id="{{ ng_var('source.usersource.id') }}">
					<a ng-href="{{ ng_href_var('ListCtrl.sync_url', '{id: source.app.id }') }}">
						<aside style="display: inline-block">
							<img ng-if="source.app" ng-src="{{ ng_var('source.app.package.icon_16') }}"
								alt="{{ ng_var('source.usersource.title') }}" style="vertical-align: inherit;" />
							<img ng-if="!source.app" ng-src="{{ asset('images/dp-logo-16.png') }}"
								alt="{{ ng_var('source.usersource.title') }}" style="vertical-align: inherit;" />
						</aside>

						<h4 style="line-height: normal; display: inline-block;">
							<span class="title-text">{{ ng_var('source.usersource.title') }}</span>
						</h4>

						<div class="pull-right">
							{#<em class="tag tag-warn" ng-show="source.usersource.is_sso">SSO</em>#}
							{#<em class="tag tag-warn" ng-show="!source.usersource.is_enabled">Disabled</em>#}
						</div>
					</a>
				</li>
			</ul>
		</article>
	</section>
{% endblock %}
{% block listpane_help %}
	<header>
		<h1>Add authentication apps to enable agents/users to sign in with existing accounts from other services</h1>
		<p>Install authentication apps from the Apps section. Supported services include Microsoft Active Directory, LDAP, and social media accounts.</p>
	</header>
	<article>
		<section>
			{# <p>Change the order of authentication apps here to change the order in which Deskpro checks them.</p> #}
			<p>Supported authentication services are:</p>
			{# should auto-generate this #}
					<ul>
						<li>Active Directory</li>
						<li>Database Authentication (using an existing MySQL, PostgreSQL, SQLite, MsSQL or Oracle database)</li>
						<li>LDAP</li>
						<li>Okta</li>
						<li>OneLogin</li>
						<li>SAML</li>
						<li>JSON Web Token</li>
						<li>Facebook</li>
						<li>Google +</li>
						<li>Twitter</li>
						<li>Magento</li>
						<li>Joomla</li>
						<li>ez Publish</li>
						<li>phpBB</li>
						<li>vBulletin</li>
						<li>XenForo</li>
					</ul>
		</section>



		<section>
			<h2><span>FAQ</span></h2>
			<dl>
				<dt><em>Q:</em> Why are there two different apps for Google authentication?</dt>
				<dd><em>A:</em> The Google Authentication app uses an older authentication system which is being retired by Google. You should only use Google+ Sign-In. If you are currently using Google Authentication, switch to Google+ Sign-In.</dd>
			</dl>
		</section>


				<section class="related-content">
			<h2><span>Related Content</span></h2>

				<ul>

				<li><i class="fa fa-globe"></i> <a href="https://support.deskpro.com/guides/topic/426" target="_blank">Authentication and SSO</a></li>

				<li><i class="fa fa-file-text"></i> <a href="https://support.deskpro.com/kb/articles/344" target="_blank">How do I debug setting up an authentication app?</a> 		</li>
				</ul>
        	</section>
	</article>
	<div dp-register-message="usersource_sync_starting">{{ phrase('admin.usersources.sync_starting') }}</div>
	<div dp-register-message="usersource_sync_stopping">{{ phrase('admin.usersources.sync_stopping') }}</div>
{% endblock %}
