<form class="form-horizontal dp-form" role="form" name="form_props" ng-submit="form_props.$valid && Ctrl.saveUsersource()">
    <section class="dp-paneblock dp-listpane">
        <header>
            <h3>Registration</h3>
        </header>

        {##################################################################################################}

        <article class="form-horizontal dp-form">
            <div class="panel panel-innertable" style="margin-top: 0;">
                <div class="form-group">
                    <div class="labels-group">
                        <label>
                            <input type="radio" ng-model="settings.reg_enabled" ng-value="true" />
                            <h4>Enable Registration</h4>
							<span class="help-block" ng-show="settings.reg_enabled">
								With registration enabled, new users will be able to create accounts on your helpdesk. This means
                                users can register manually and they will register automatically by submitting new tickets or other content like feedback or comments.
							</span>
                        </label>
                        <label>
                            <input type="radio" ng-model="settings.reg_enabled" ng-value="false" />
                            <h4>Disable Registration</h4>
							<span class="help-block" ng-show="!settings.reg_enabled">
								With registration <strong>disabled</strong>, no new users will be able to create new accounts. This means
								to submit content to the helpdesk (such as tickets or comments), users must already exist or be manually created by an agent.
                                For example, if a user sends the helpdesk an email but they don't exist, their email will be completely rejected.
							</span>
                        </label>

                        <div class="inner-group" ng-if="can_disable_deskpro && !settings.reg_enabled" style="padding-left: 25px; padding-top: 10px;">
                            <label>
                                <input type="checkbox" ng-model="Ctrl.usersource.is_disabled" class="ng-pristine ng-valid">
                                <h4>Completely disable Deskpro User Management</h4>
                            </label>
                            <span class="help-block">
                                When Deskpro user management is disabled, no users can be entered into the system except through another user source. For example,
                                this means even agents cannot create new users.
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </article>

        <article class="form-horizontal dp-form">
            <div class="panel panel-innertable">
                <div class="form-group">
                    <div class="inner-group">
                        <label>
                            <input type="checkbox" ng-model="settings.everyone_group_enabled" />
                            <h4>Enable the "Everyone" Group</h4>
                        </label>
						<span class="help-block">
							Guests are able to perform a number of actions defined by permissions granted by the Everyone usergroup. Turning the Everyone usergroup off will require all users to log in to do anything on the helpdesk.
						</span>
						<span class="help-block">
							If you just want to manage what users can do, you can set usergroup permissions from the <a href="{{ ng_href('crm.groups') }}">User Permission Groups</a> section.
						</span>
                    </div>
                </div>
            </div>
        </article>
    </section>

    {##################################################################################################}

    <section class="dp-paneblock dp-listpane">
        <header>
            <h3>User Password Policy</h3>
        </header>
        <article class="form-horizontal dp-form">
            <div class="panel panel-innertable" style="margin-top: 0;">
                <div class="form-group">
                    <div class="labels-group">
                        <label>
                            <input type="radio" ng-model="policy_user.standard_policy" ng-value="true" />
                            <h4>Standard Password Policy</h4>
							<span class="help-block" ng-show="policy_user.standard_policy">
								Passwords must be at least 5 characters long. No other requirements are enforced.
							</span>
                        </label>
                        <label>
                            <input type="radio" ng-model="policy_user.standard_policy" ng-value="false" />
                            <h4>Custom Password Policy</h4>
							<span class="help-block" ng-show="!policy_user.standard_policy">
								Specify custom password requirements.
							</span>
                        </label>
                    </div>

                    <div ng-if="!policy_user.standard_policy">
                        <div class="panel-heading">
                            <h3>
                                <span>Password Policy</span>
                            </h3>
                        </div>

                        <div class="inner-group" dp-error-class="form_props.min_length">
                            <label>
                                <h4>Minimum password length:</h4>
                            </label>
                            <input type="number" class="form-control" name="min_length" ng-model="policy_user.min_length"
                                   style="width: 100px; display: inline-block;" required min="0" /> characters
							<span class="help-block">
								The minimum number of characters the password has to be.
							</span>
                        </div>
                        <div class="inner-group" dp-error-class="form_props.max_age">
                            <label>
                                <h4>Maximum password age:</h4>
                            </label>
                            <input type="number" class="form-control" name="max_age" ng-model="policy_user.max_age"
                                   style="width: 100px; display: inline-block;" required min="0" /> days
							<span class="help-block">
								How many days a password can remain unchanged until Deskpro requires the user to change it.
							</span>
                        </div>
                        <div class="inner-group">
                            <label>
                                <input type="checkbox" ng-model="policy_user.forbid_reuse" />
                                <h4>Forbid password reuse</h4>
                            </label>
							<span class="help-block">
								When enabled, users will not be able to change their password to a password they have used in the past.
							</span>
                        </div>
                        <div class="inner-group" dp-error-class="form_props.require_num_lowercase">
                            <label>
                                <h4>Require this many lower-case characters:</h4>
                            </label>
                            <input type="number" class="form-control" name="require_num_lowercase"
                                   ng-model="policy_user.require_num_lowercase"
                                   style="width: 100px; display: inline-block;" required min="0" />
							<span class="help-block">
								Define the minimum number of lower-case (a-z) characters that must be used in the password.
							</span>
                        </div>
                        <div class="inner-group" dp-error-class="form_props.require_num_uppercase">
                            <label>
                                <h4>Require this many upper-case characters:</h4>
                            </label>
                            <input type="number" class="form-control" name="require_num_uppercase"
                                   ng-model="policy_user.require_num_uppercase"
                                   style="width: 100px; display: inline-block;" required min="0" />
							<span class="help-block">
								Define the minimum number of upper-case (A-Z) characters that must be used in the password.
							</span>
                        </div>
                        <div class="inner-group" dp-error-class="form_props.require_num_number">
                            <label>
                                <h4>Require this many numbers:</h4>
                            </label>
                            <input type="number" class="form-control" name="require_num_number" ng-model="policy_user.require_num_number"
                                   style="width: 100px; display: inline-block;" required min="0" />
							<span class="help-block">
								Define the minimum number of numbers (0-9) that must be used in the password.
							</span>
                        </div>
                        <div class="inner-group" dp-error-class="form_props.require_num_symbol">
                            <label>
                                <h4>Require this many symbols:</h4>
                            </label>
                            <input type="number" class="form-control" name="require_num_symbol"
                                   ng-model="policy_user.require_num_symbol"
                                   style="width: 100px; display: inline-block;" required min="0" />
							<span class="help-block">
								Define the minimum number of symbols (!, @, $, % etc) that must be used in the password.
							</span>
                        </div>
                    </div>
                </div>
            </div>
        </article>
    </section>

    {##################################################################################################}

    <section class="dp-paneblock dp-listpane">
        <footer>
            <div class="dp-content">
                <div class="dp-btn-controls" ng-hide="form_props.$attempted && form_props.$invalid">
                    <div dp-hide-spinning="saving_settings">
                        <button class="btn btn-primary" dp-submit-form>{{ phrase('agent.general.save') }}</button>
                    </div>
                    <div dp-show-spinning="saving_settings">
                        <i class="spinner-flat"></i>
                    </div>
                </div>
            </div>
        </footer>
    </section>
</form>
<div dp-register-message="saved_settings">Settings saved successfully.</div>
