{% extends 'AdminInterfaceBundle:Layout:list-editpane.html.twig' %}
{% block editpane_content %}
	<section class="dp-paneblock dp-editpane">
		<ul class="dp-item-list dp-icon-list compact">
			<li ng-if="NewCtrl.usersourceType == 'user'">
				<aside>
					<a href="{{ ng_href_var('install_deskpro_url') }}"><img
								ng-src="{{ asset('images/dp-logo-48.png') }}" alt="Icon" /></a>
				</aside>
				<div class="content">
					<h4><a href="{{ ng_href_var('install_deskpro_url') }}"><span
									class="title-text">Dekspro</span></a></h4>

					<p class="info">
						by Dekspro &middot; <a
								ng-href="https://deskpro.com">Website</a>
					</p>

					<p>Enables local Deskpro authentication.</p>
				</div>
			</li>
			<li ng-repeat="package in NewCtrl.packages">

				<aside>
					<a href="{{ ng_href_var('install_url', '{name: package.name}') }}"><img
							ng-src="{{ ng_var('package.icon_48') }}" alt="Icon" /></a>
				</aside>
				<div class="content">
					<h4><a href="{{ ng_href_var('install_url', '{name: package.name}') }}"><span
								class="title-text">{{ ng_var('package.title') }}</span></a></h4>

					<p class="info">
						by {{ ng_var('package.author_name') }} &middot; <a
							ng-href="{{ ng_var('package.author_link') }}">Website</a>
					</p>

					<p ng-bind-html="package.description"></p>
				</div>
			</li>
		</ul>
	</section>
{% endblock %}
