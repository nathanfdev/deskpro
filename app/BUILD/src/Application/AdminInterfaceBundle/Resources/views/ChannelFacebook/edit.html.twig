{% extends 'AdminInterfaceBundle:Layout:list-editpane.html.twig' %}
{% block editpane_content %}
	<form role="form" name="form_props" ng-submit="ChannelFacebookEdit.saveAccount()">
		<section class="dp-paneblock dp-editpane">
			<article class="form-horizontal dp-form">
				<div class="panel panel-fill indent">
					<div class="panel-body">
						<div class="row" style="margin-bottom: 50px;">
							<div class="col-lg-12">
								<img
									ng-src="{{ ng_var('form.page.picture_url') }}"
									height="64" width="64" style="float: left; margin-right: 20px;">
								<h2 style="display: inline;">
									{{ ng_var('form.page.name') }}
									<br>
									<small ng-show="form.page.app">
										Facebook App:
										<img
											ng-src="{{ ng_var('form.page.app.icon_url') }}"
											height="16" width="16">
										{{ ng_var('form.page.app.name') }}
									</small>
								</h2>
								<button class="btn btn-default dropdown-toggle pull-right">
									<span><i class="fa fa-cog"></i></span> <i class="fa fa-caret-down"></i>
								</button>
								<ul class="dropdown-menu pull-right">
									<li>
										<a ng-click="ChannelFacebookEdit.refresh()">
											<i class="fas fa-sync"></i>
											{{ phrase('admin.channels.facebook_sync_page_info') }}
										</a>
									</li>
									<li>
										<a ng-click="ChannelFacebookEdit.changeAppDetails()">
											<i class="fa fa-key"></i>
											{{ phrase('admin.channels.facebook_change_app') }}
										</a>
									</li>
								</ul>
							</div>
						</div>
						<form name="form_props">
							<div class="form-group">
								<div class="col-lg-3">
									<h3>{{ phrase('admin.general.enabled') }}</h3>
								</div>
								<div class="col-lg-9">
									<label>
										<input type="checkbox" ng-model="form.page.is_enabled" />
										{{ phrase('admin.channels.facebook_enable_page') }}
									</label>
									<span class="help-block" style="margin-bottom: 15px;"
										ng-show="!form.page.is_enabled">
										{{ phrase('admin.channels.facebook_enable_page_help') }}
									</span>
									<span class="help-block" style="margin-bottom: 15px;"
										ng-show="form.page.is_enabled">
										{{ phrase('admin.channels.facebook_disable_page_help') }}
									</span>
								</div>
							</div>
							<div class="form-group">
								<div class="col-lg-3">
									<h3>{{ phrase('admin.channels.facebook_wall_posts') }}</h3>
								</div>
								<div class="col-lg-9">
									<label>
										<input type="checkbox" ng-model="form.page.import_wall_posts"
											/>
										{{ phrase('admin.channels.facebook_import_wall_posts') }}
									</label>
									<span class="help-block" style="margin-bottom: 15px;"
										ng-show="!form.page.import_wall_posts">
										{{ phrase('admin.channels.facebook_import_wall_posts_help') }}
									</span>
									<span class="help-block" style="margin-bottom: 15px;"
										ng-show="form.page.import_wall_posts">
										{{ phrase('admin.channels.facebook_disable_import_wall_posts_help') }}
									</span>
								</div>
							</div>
							<div class="form-group">
								<div class="col-lg-3">
									<h3>{{ phrase('admin.channels.facebook_own_wall_posts') }}</h3>
								</div>
								<div class="col-lg-9">
									<label>
										<input type="checkbox" ng-model="form.page.disable_own_wall_posts"
											/>
										{{ phrase('admin.channels.facebook_disable_own_wall_posts') }}
									</label>
									<span class="help-block" style="margin-bottom: 15px;"
										ng-show="!form.page.import_wall_posts">
										{{ phrase('admin.channels.facebook_disable_own_posts_help') }}
									</span>
									<span class="help-block" style="margin-bottom: 15px;"
										ng-show="form.page.import_wall_posts">
										{{ phrase('admin.channels.facebook_enable_own_wall_posts_help') }}
									</span>
								</div>
							</div>
							<div class="form-group">
								<div class="col-lg-3">
									<h3>{{ phrase('admin.channels.facebook_import_direct_messages') }}</h3>
								</div>
								<div class="col-lg-9">
									<label>
										<input type="checkbox" ng-model="form.page.import_direct_messages"
											/>
										{{ phrase('admin.channels.facebook_import_direct_messages_label') }}
									</label>
									<span class="help-block" style="margin-bottom: 15px;"
										ng-show="!form.page.import_wall_posts">
										{{ phrase('admin.channels.facebook_disable_import_direct_messages_help') }}
									</span>
									<span class="help-block" style="margin-bottom: 15px;"
										ng-show="form.page.import_wall_posts">
										{{ phrase('admin.channels.facebook_import_direct_messages_help') }}
									</span>
								</div>
							</div>
						</form>
					</div>
				</div>
			</article>
			<footer ng-hide="form_props.$attempted && form_props.$invalid">
				<div class="dp-content">
					<div class="text-danger ng-hide" ng-show="form_props.$attempted && form_props.$invalid">
						<p><strong>{{ phrase('adm.general.please_correct_errors') }}</strong></p>
						<ul>
							{#<li ng-show="form_props.sid.$error.required">Your Twillio AccountSID is required</li>#}
							{#<li ng-show="form_props.auth_token.$error.required">Your Twillio AuthToken is required</li>#}
						</ul>
					</div>
					<div class="dp-delete-control" ng-if="ChannelFacebookEdit.page.id"
						ng-hide="form_props.$attempted && form_props.$invalid">
						<button class="btn btn-danger"
							ng-click="$event.preventDefault(); $parent.ChannelFacebookList.startDelete(ChannelFacebookEdit.page.id);">
							{{ phrase('agent.general.delete') }}
						</button>
					</div>
					<div class="dp-btn-controls"
						ng-hide="form_props.$attempted && form_props.$invalid">
						<div dp-hide-spinning="saving_page">
							<button class="btn btn-primary" type="submit" ng-click="ChannelFacebookEdit.savePage()">
								{{ phrase('agent.general.save') }}
							</button>
						</div>
						<div dp-show-spinning="saving_page">
							<i class="spinner-flat"></i>
						</div>
					</div>
				</div>
			</footer>
		</section>
		<div dp-register-message="saved_page">{{ phrase('admin.general.save_settings_success') }}</div>
	</form>
{% endblock %}
