<header class="reports-header">
    <div class="right">
        <div class="report-access-avatars">
            <span class="title">On this dashboard:</span>
            <a
                ng-repeat='permission in (filteredPermissions = dashboard.permissions | filter:filterPermissions | limitTo:6) track by $index '
                ng-if="permission.person"
                class="avatar"
                title="{{ ng_var('agents[permission.person].name') }}"
            >
                <span class="text">{{ ng_var('getInitials(agents[permission.person])') }}</span>
                <span class="image" style="background-image: url({{ ng_var('agents[permission.person].avatar.url') }});"/>
            </a>
            <a ng-if="(dashboard.permissions | filter:filterPermissions).length > 6" class="avatar avatar-blank"><span>+{{ ng_var('(dashboard.permissions | filter:filterPermissions).length - 6') }}</span></a>
            <a ng-if="canEdit()" ng-click="openEdit('permissions')" class="avatar edit-access-link"><span>Edit Agent Access <i class="fa fa-user"></i></span></a>
        </div>
    </div>

    <div class="left">
        <nav class="reports-control">
            <ul>
                <li class="dashboard-title">{{ ng_var('dashboard.title') }}</li>
                <li ng-show="!dashboard.is_default && canEdit()"><a class='link-pointer' ng-click="openEdit()"><i class="fa fa-cog"></i> Edit Dashboard</a></li>
                <li ng-show="!dashboard.is_default && canEdit()"><a class='link-pointer' ng-click="deleteDashboard(dashboard)"><i class="fa fa-times"></i> Delete Dashboard</a></li>
            </ul>
        </nav>
    </div>
</header>

<div class="report-tabs">
    <ul>
        <li ng-if='!dashboard.is_default' class="add-report-link">
            <a ng-click="openCreateReport()" class='link-pointer'><i class="fa fa-plus"></i></a>
        </li>

        <li ng-if="!report.deleted" ng-repeat="report in reports track by $index" ui-sref-active="active-tab">
            <a class='link-pointer' ui-sref="reports.dashboards.view.report({ report_id: report.id })">{{ ng_var('report.title') }}</a>
        </li>
    </ul>
</div>

<div ui-view></div>
