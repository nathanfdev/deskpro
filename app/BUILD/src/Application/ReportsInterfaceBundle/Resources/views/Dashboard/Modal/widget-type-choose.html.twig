<section class="popup add-widget choose-type" style="width: 850px">

    <!-- Popup Header & Title -->
    <header>
        <h1>Add widget</h1>
        <h3>Select display type</h3>
        <div class="controls">
            <a class="link-pointer" ng-click="cancel()"><i class="fa fa-times"></i></a>
        </div>
    </header>
    <div class="big-list-of-stats-filters">
        <div class="bucket">
            <div class="box">
                <label class="widget-title" for="widget-name">Enter widget name</label>
                <input class="widget-title" type="text" ng-model="widget.title" placeholder="Enter widget name" />
            </div>
        </div>
        <div class="bucket" ng-if="widget.widget_id == 'advanced'">
            <div class="box">
                <label class="widget-js-code" for="widget-name">Enter widget JS code</label>
                <div class="editor" style="height: 200px; margin-top: 10px" ng-model="widget.js_code" ui-ace="{
						mode: 'javascript',
						useWrapMode: true,
						theme: 'textmate',
						onLoad: aceLoadedMessage
					}"></div>
            </div>
        </div>
    </div>

    <!-- Popup Content -->
    <div class="popup-content">
        <div class="popup-stat-list">
            <a
              name='pie'
              ng-click="makeChoice('pie')"
              class="link-pointer stat-preview-bucket"
              ng-class="{'selected' : widget.type == 'pie'}"
            >
                <span class="title">Pie Chart</span>
                <div class="stat-preview stat-preview-pie"></div>
            </a>

            <a
              name="bars"
              ng-click="makeChoice('simple_bars')"
              class="link-pointer stat-preview-bucket"
              ng-class="{'selected' : widget.type == 'simple_bars'}"
            >
                <span class="title">Bars</span>
                <div class="stat-preview stat-preview-bars"></div>
            </a>

            <a
              name='lines'
              ng-click="makeChoice('simple_lines')"
              class="link-pointer stat-preview-bucket"
              ng-class="{'selected' : widget.type == 'simple_lines'}"
            >
                <span class="title">Lines</span>
                <div class="stat-preview stat-preview-line"></div>
            </a>

            <a
              name='area'
              ng-click="makeChoice('simple_area')"
              class="link-pointer stat-preview-bucket"
              ng-class="{'selected' : widget.type == 'simple_area'}"
            >
                <span class="title">Area</span>
                <div class="stat-preview stat-preview-area"></div>
            </a>

            <a
                    name='gauge'
                    ng-click="makeChoice('gauge')"
                    class="link-pointer stat-preview-bucket"
                    ng-class="{'selected' : widget.type == 'gauge'}"
            >
                <span class="title">Gauge</span>
                <div class="stat-preview stat-preview-gauge"></div>
            </a>

            <a
                    name='bubble'
                    ng-click="makeChoice('bubble')"
                    class="link-pointer stat-preview-bucket"
                    ng-class="{'selected' : widget.type == 'bubble'}"
            >
                <span class="title">Bubble</span>
                <div class="stat-preview stat-preview-bubble"></div>
            </a>

            <a
              name='table_data'
              ng-click="makeChoice('table')"
              class="link-pointer stat-preview-bucket"
              ng-class="{'selected' : widget.type == 'table'}"
            >
                <span class="title">Table data</span>
                <div class="stat-preview stat-preview-multi-group"></div>
            </a>
            <a name='simple_stat' ng-click="makeChoice('simple_stat')" class="link-pointer stat-preview-bucket"
               ng-class="{'selected' : widget.type == 'simple_stat'}">
                <span class="title">Simple Stat</span>

                <div class="stat-preview stat-preview-simple-stat"></div>
            </a>
        </div>

        <!-- needs js to fit verticaly to it's container -->
        <div class="popup-stat-preview">
            <div class="stat-preview-header">Chart Preview</div>
            <div class="stat-preview" ng-if="widgetPreview && widgetPreview.type=='graph' && widgetPreview.rendered_result">
                <div>
                    <dashboard-amcharts
                            my-index="{{ ng_var('$index') }}"
                            title="{{ ng_var('widgetPreview.title') }}"
                            widget-id="{{ ng_var('reportWidget.id') }}"
                            chart-data="{{ ng_var('widgetPreview.rendered_result') }}"
                            render-type="test"
                            widget-type="{{ ng_var('widgetPreview.type') }}"
                            chart-type="{{ ng_var('widgetPreview.rendered_result.chartType') }}"
                    />
                </div>
            </div>
            <div class="stat-preview" ng-if="widgetPreview && widgetPreview.type=='table' && widgetPreview.rendered_result">
                <div style="height: 100%; overflow: hidden;">
                    <dashboard-table
                            render-type = "test"
                            my-index="{{ ng_var('$index') }}"
                            title="{{ ng_var('widgetPreview.title') }}"
                            table-data="{{ ng_var('widgetPreview.rendered_result') }}"
                            widget-id="{{ ng_var('reportWidget.id') }}"
                    />
                </div>
            </div>
            <div class="stat-preview" ng-if="widgetPreview && widgetPreview.type=='simple_stat' && widgetPreview.rendered_result">
                <div class="stat-box">
                    <dashboard-stat
                            render-type="test"
                            my-index="{{ ng_var('$index') }}"
                            title="{{ ng_var('widgetPreview.title') }}"
                            value="{{ ng_var('widgetPreview.rendered_result.value') }}"
                            description="{{ ng_var('widgetPreview.rendered_result.description') }}"
                            widget-id="{{ ng_var('reportWidget.id') }}"
                    />
                </div>
            </div>
            <div class="stat-preview" style="padding: 20px" ng-if="widgetPreview && !widgetPreview.rendered_result && !widgetPreview.js_code">
                No results to show. Please, try another graph type and/or another variables values.
            </div>
        </div>
    </div>

    <footer>
        <a ng-click="back()" style="max-width: 100px; margin-right: 10px;" class="link-pointer button">Back</a>
        <a ng-click="saveChoice()" class="link-pointer button">Save</a>
    </footer>
    <!-- End Popup Content -->

</section>

<div class="cover"></div><!-- Transparent background to the popup -->