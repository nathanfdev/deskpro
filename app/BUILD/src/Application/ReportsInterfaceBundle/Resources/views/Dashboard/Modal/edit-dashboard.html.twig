<section class="popup">
    <!-- Popup Header & Title -->
    <header>
        <h1 ng-if="!is_new">Edit dashboard</h1>
        <h1 ng-if="is_new">Create dashboard</h1>
        <div class="controls"><a ng-click="cancel()"><i class="fa fa-times"></i></a></div>
    </header>

    <!-- Popup Sidebar -->
    <div class="popup-sidebar" style="height: 500px;"><!-- Need to calculate the height of popup with js and update the sidebar -->
        <div class="popup-sidebar-content">
            <ul>
                <li ng-class="{'active': activeTab == 'info'}">
                    <a ng-click="activeTab = 'info'">Properties</a>
                </li>
                <li ng-class="{'active': activeTab == 'permissions'}">
                    <a ng-click="activeTab = 'permissions'">Agent Permissions</a>
                </li>
                <li ng-show="dashboard.id" ng-class="{'active': activeTab == 'shareable_links'}">
                    <a ng-click="activeTab = 'shareable_links'; shareLink = null; shareLinkView = null">Shareable Links</a>
                </li>
            </ul>
        </div>
    </div>
    <!-- End Popup Sidebar -->

    <!-- Popup Content -->
    <div class="popup-content" ng-show="!loaded">
        <div style="margin: 40px; text-align: center;">
            <i class="spinner-big-circle"></i>
        </div>
    </div>
    <div class="popup-content" ng-show="loaded" style="height: 500px;">

        {##############################################################################################################}
        {# Properties #}
        {##############################################################################################################}

        <form ng-show="activeTab == 'info'" class="popup-form-default">

            <div ng-if="dashboard.is_default">
                <div class="bucket" style="margin: 40px;">
                    <h2>"{{ ng_var('dashboard.title') }}" is a built-in dashboard</h2>
                    <p>
                        You cannot edit the properties of this built-in dashboard.
                    </p>
                </div>
            </div>

            <div ng-if="!dashboard.is_default">
                <div class="bucket">
                    <label class="label">Dashboard Title:</label>
                    <div class="bucket-column"><input type="text" ng-model="dashboard.title" placeholder="Name of your new dashboard"></div>
                    <div ng-if="error" class="alert alert-error">
                        {{ ng_var('error') }}
                    </div>
                </div>

                <hr>

                <div class="bucket reports-list-form">
                    <label class="label">Reports:</label>
                    <div class="bucket-column">
                        <p style="margin-top: 9px;">
                            Reports appear as tabs on your dashboard. Use reports to create groups of stats that you want
                            to see all at once.
                        </p>
                        <div style="margin: 15px 0;" ui-sortable="sortableOptions" ng-model="reports">
                            <div class="report-row" ng-if="!report.deleted" ng-repeat="report in reports track by report.id">
                                <label class="drag-handle"><i class="fa fa-bars"></i></label>
                                <span class="meta"><a ng-click="removeReport(report)">Remove</a></span>
                                <div class="row-input">
                                    <input type="text" ng-model="report.title" placeholder="Report title" ng-change="did_edit_reports = true">
                                    <div ng-if="report.isNew" class="new-report-info">
                                        <i class="fa fa-asterisk"></i> New report
                                    </div>
                                    <div ng-if="report.fromDashboardTitle" class="new-report-info">
                                        <i class="fa fa-copy"></i> Cloned from dashboard "{{ ng_var('report.fromDashboardTitle') }}"
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div>
                            <div>
                                <div ng-show="show_clone_menu">
                                    <div style="float:right; position: relative; top: -5px;">
                                        <span class="meta"><a ng-click="closeCloneMenu()">Cancel</a></span>
                                    </div>
                                    <h2>Clone a report or dashboard</h2>
                                    <ul class="clone-list">
                                        <li ng-repeat="db in dashboards" ng-if="db.reports.length">
                                            <a ng-click="cloneDashboard(db)">{{ ng_var('db.title') }}</a>
                                            <ul>
                                                <li ng-repeat="r in db.reports">
                                                    <a ng-click="cloneReport(db, r)">{{ ng_var('r.title') }}</a>
                                                </li>
                                            </ul>
                                        </li>
                                    </ul>
                                </div>

                                <div ng-hide="show_clone_menu">
                                    <a ng-click="addReport()" class="button button-secondary half-width">Add new report</a>
                                    <a ng-click="openCloneMenu()" class="button button-secondary half-width">Clone existing report</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <hr>

                <div class="bucket">
                    <div class="inner-group">
                        <label>
                            <label>
                                <input ng-model="dashboard.is_agent" type="checkbox">
                                <span>Make this an agent dashboard</span>
                            </label>
                        </label>
                        <span class="help-block">
                            This allows you to restrict the agent and team selections on reports to only the currently logged-in agent.<br/>
                            For more information on agent dashboards, <a href="https://support.deskpro.com/kb/articles/682">refer to this knowledgebase article</a>.

                        </span>
                    </div>
                </div>
            </div>
        </form>

        {##############################################################################################################}
        {# Permissions #}
        {##############################################################################################################}

        <form ng-show="activeTab == 'permissions'" class="popup-form-default">
            <div class="popup-blurb">
                <h2>Choose agents that can see this dashboard</h2>
            </div>
            <div class="agent-list">
                <table>
                    <thead>
                    <td class="agent-name"></td>
                    <td>View</td>
                    <td ng-if="!dashboard.is_default">Edit</td>
                    </thead>

                    <tr>
                        <td class="agent-name" style="height: 36px">
                            All agents
                        </td>
                        <td>
                            <input ng-click='toggleAllAgentsViewDashboard()' ng-checked="canAllAgentsViewDashboard()" type="checkbox">
                        </td>
                        <td ng-if="!dashboard.is_default">
                            <input ng-click='toggleAllAgentsEditDashboard()' ng-checked="canAllAgentsEditDashboard()" type="checkbox">
                        </td>
                    </tr>
                </table>
            </div>

            <div class="popup-blurb">
                <h2>Choose agent teams that can see this dashboard</h2>
            </div>

            <div class="agent-list">
                <table>
                    <thead>
                    <td class="agent-name"></td>
                    <td>View</td>
                    <td ng-if="!dashboard.is_default">Edit</td>
                    </thead>

                    <tr ng-repeat="team in teams track by team.id">
                        <td class="agent-name">
                            <span class="avatar" style="background-image: url({{ ng_var('team.avatar.url') }})"></span>
                            {{ ng_var('team.name') }}
                        </td>
                        <td>
                            <input
                                    ng-title="Toogle view permission for {{ ng_var('team.name') }}"
                                    ng-click='toggleTeamViewDashboard(team.id)'
                                    ng-checked="canTeamViewDashboard(team.id)"
                                    type="checkbox"
                            />
                        </td>
                        <td ng-if="!dashboard.is_default">
                            <input
                                    ng-title="Toogle edit permission for {{ ng_var('team.name') }}"
                                    ng-click='toggleTeamEditDashboard(team.id)'
                                    ng-checked="canTeamEditDashboard(team.id)"
                                    type="checkbox"
                            />
                        </td>
                    </tr>
                </table>
            </div>

            <div class="popup-blurb">
                <h2>Choose agents that can see this dashboard</h2>
            </div>

            <div class="agent-list">
                <table>
                    <thead>
                    <td class="agent-name"></td>
                    <td ng-if="dashboard.is_agent">View All Agents/teams</td>
                    <td>View</td>
                    <td ng-if="!dashboard.is_default">Edit</td>
                    </thead>

                    <tr ng-repeat="agent in agents track by agent.id">
                        <td class="agent-name">
                            <span class="avatar">
                                <span class="text">{{ ng_var('getInitials(agent)') }}</span>
                                <span class="image" style="background-image: url({{ ng_var('agent.avatar.url') }})"></span>
                            </span>
                            {{ ng_var('agent.name') }}
                        </td>
                        <td ng-if="dashboard.is_agent">
                            <input ng-click='toggleViewAllAgents(agent.id)' ng-checked="canViewAllAgents(agent.id)" type="checkbox">
                        </td>
                        <td>
                            <input
                                ng-title="Toogle view permission for {{ ng_var('agent.name') }}"
                                ng-click='toggleAgentViewDashboard(agent.id)'
                                ng-checked="canAgentViewDashboard(agent.id) || agent.can_reports || agent.can_admin"
                                ng-disabled="dashboard.permissions.all == 'view' || dashboard.permissions.all == 'full' || agent.can_reports || agent.can_admin"
                                type="checkbox"
                            />
                        </td>
                        <td ng-if="!dashboard.is_default">
                            <input
                                ng-title="Toogle edit permission for {{ ng_var('agent.name') }}"
                                ng-click='toggleAgentEditDashboard(agent.id)'
                                ng-checked="canAgentEditDashboard(agent.id) || agent.can_reports || agent.can_admin"
                                ng-disabled="dashboard.permissions.all == 'full' || agent.can_reports || agent.can_admin"
                                type="checkbox"
                            />
                        </td>
                    </tr>
                </table>
            </div>
        </form>

        {##############################################################################################################}
        {# Shareable Links #}
        {##############################################################################################################}

        <div ng-show="activeTab == 'shareable_links'" class="popup-form-default">
            <div class="popup-blurb">
                <h2>Create public, shareable permalinks here to give read-only access to the dashboard.</h2>
            </div>

            <div ng-if="!shareLink" class="shareable-links-list">
                <div class="new-shareable-link">
                    <a ng-click="openNewShareLinkForm()">Create New Link</a>
                </div>
                <table ng-if="shareLinks.length > 0">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="shareLink in shareLinks track by shareLink.id">
                            <td>{{ ng_var('shareLink.title') }}</td>
                            <td class="shareable-link-options">
                                <a ng-click="openShareLinkForm(shareLink)">Share</a>
                                <a ng-click="openEditShareLinkForm(shareLink)">Edit</a>
                                <a ng-click="deleteShareLink(shareLink)">Delete</a>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div ng-if="!shareLinks.length">
                    No shareable links are created yet.
                </div>
            </div>

            <form ng-if="shareLinkView == 'new' || shareLinkView == 'edit'" class="shareable-link-form popup-form-default">
                <div class="popup-blurb">
                    <h2 ng-if="!shareLink.id">New Link</h2>
                    <h2 ng-if="shareLink.id">Edit Link</h2>
                </div>

                <div class="bucket">
                    <label class="label">Description</label>
                    <div class="bucket-column">
                        <input type="text" ng-model="shareLink.title" placeholder="Share link description">
                    </div>
                    <div ng-if="error" class="alert alert-error">
                        {{ ng_var('error') }}
                    </div>
                </div>

                <div ng-if="reports.length > 0" class="bucket">
                    <label class="label">Default report tab to select</label>
                    <div class="bucket-column">
                        <select ng-model="shareLink.default_report" ui-select2>
                            <option ng-repeat="report in reports track by report.id" ng-value="report.id" ng-selected="shareLink.default_report == report.id">{{ ng_var('report.title') }}</option>
                        </select>
                    </div>
                </div>

                <div class="bucket">
                    <label class="label">Who can use the link?</label>
                    <div class="bucket-column">
                        <div class="ui radio checkbox">
                            <input type="radio" name="who_can_use" ng-model="shareLink.who_can_use" value="anyone" />
                            <label>Anyone with the link?</label>
                        </div>
                        <div class="ui radio checkbox">
                            <input type="radio" name="who_can_use" ng-model="shareLink.who_can_use" value="whitelist" />
                            <label>Whitelist IP addresses</label>
                        </div>
                    </div>
                </div>

                <div ng-if="shareLink.who_can_use == 'whitelist'" class="bucket">
                    <div class="bucket-column">
                        <input type="text" ng-model="shareLink.ip_whitelist" placeholder="Comma-separated list of IP addresses (CIDR format)" />
                    </div>
                </div>
            </form>
            <form ng-if="shareLink && shareLink.id && shareLinkView == 'share'" class="shareable-link-form popup-form-default">
                <div class="popup-blurb">
                    <h2>Share Link {{ ng_var('shareLink.title') }}</h2>
                </div>

                <div class="bucket">
                    <label class="label">Permalink</label>
                    <div class="bucket-column">
                        <input type="text" id="permalink" readonly ng-value="shareLink.permalink" />
                        <a dp-clipboard class="copy-to-clipboard" data-clipboard-target="#permalink" ngclipboard-success="successAlert('The permalink was copied to your clipboard')">copy</a>
                    </div>
                </div>

                <div class="bucket">
                    <label class="label">Short URL</label>
                    <div ng-if="shareLink.short_url" class="bucket-column">
                        <input type="text" id="short_url" readonly ng-value="shareLink.short_url.redirect_url" />
                        <a dp-clipboard class="copy-to-clipboard" data-clipboard-target="#short_url" ngclipboard-success="successAlert('The short url was copied to your clipboard')">copy</a>
                    </div>
                    <div ng-if="!shareLink.short_url" class="bucket-column">
                        <a ng-click="createShortUrlForShareLink(shareLink)" class="create-short-url">Create temporary short URL</a>
                        <p>
                            If you need to use this link on a device such as TV where a long URL is difficult to type, you can instead create a temporary short URL that lasts for 1 hour.
                            The short URL is easier to type and redirects to the full secure permalink.
                        </p>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <footer ng-show="loaded" ng-if="activeTab == 'info' || activeTab == 'permissions'">
        <div ng-hide="saving">
            <a ng-click="saveDashboard()" class="button">Save Dashboard</a>
        </div>
        <div ng-show="saving">
            <i class="spinner-flat"></i>
        </div>
    </footer>
    <footer ng-show="loaded" ng-if="activeTab == 'shareable_links' && (shareLinkView == 'new' || shareLinkView == 'edit')">
        <div ng-hide="saving">
            <a ng-click="saveShareLink()" class="button">Save Share Link</a>
        </div>
        <div ng-show="saving">
            <i class="spinner-flat"></i>
        </div>
    </footer>
    <!-- End Popup Content -->

</section>
<div class="cover"></div><!-- Transparent background to the popup -->