<section class="popup">

    <!-- Popup Header & Title -->
    <header>
        <h1>Add report</h1>
        <div class="controls"><a ng-click="cancel()"><i class="fa fa-times"></i></a></div>
    </header>

    <!-- Popup Content -->
    <div class="popup-content">
        <!-- Content Form -->
        <form class="popup-form-default">

            <!-- Form Row (left label, input & possible side content) -->
            <div class="bucket">
                <label class="label">Report Title:</label>
                <div class="bucket-column"><input type="text" ng-model="report.title" placeholder="Name of your new report"></div>
            </div>
            <div class="bucket" ng-if="!report.id">
                <label class="label">Columns:</label>
                <div class="bucket-column"><input type="text" ng-model="report.options.columns" placeholder="How much columns this report will have?"></div>
            </div>
            <!-- End Form Row -->
            <hr>
        </form>
    </div>

    <footer>
        <a ng-click="saveReport()" class="button">{{ ng_var('title') }}</a>
    </footer>
    <!-- End Popup Content -->

</section>

<div class="cover"></div><!-- Transparent background to the popup -->