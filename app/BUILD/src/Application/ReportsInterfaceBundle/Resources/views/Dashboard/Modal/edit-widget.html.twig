<section class="popup">

    <!-- Popup Header & Title -->
    <header>
        <h1>Edit Widget</h1>
        <div class="controls"><a ng-click="cancel()"><i class="fa fa-times"></i></a></div>
    </header>

    <!-- Popup Content -->
    <div class="popup-content">
        <!-- Content Form -->
        <form class="popup-form-default">

            <!-- Form Row (left label, input & possible side content) -->
            <div class="bucket">
                <label class="label">Widget Title:</label>
                <div class="bucket-column"><input type="text" ng-model="widget.title" placeholder="Name of your widget"></div>
            </div>
            <div class="bucket">
                <label class="label">Widget Options:</label>
                <div class="bucket-column"><textarea ng-model="widget.options" placeholder="Put json string here"></textarea></div>
            </div>
            <!-- End Form Row -->

            <hr>
        </form>
    </div>

    <footer>
        <a ng-click="saveWidget()" class="button">Save Changes</a>
    </footer>
    <!-- End Popup Content -->

</section>

<div class="cover"></div><!-- Transparent background to the popup -->