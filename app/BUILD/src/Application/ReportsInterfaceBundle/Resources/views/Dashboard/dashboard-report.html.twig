<div ng-if="!loaded">
    <div class="report-info">
        <div style="margin: 40px; text-align: center;">
            <i class="spinner-big-circle"></i>
        </div>
    </div>
</div>
<div ng-if="loaded">
    <div class="report-info">
        <h1><span>Report:</span> {{ ng_var('report.title') }}</h1>

        <nav class="reports-control" ng-show="report.id" ng-hide="dashboard.is_default">
            <ul>
                <li>
                    <a
                        ng-click='editReportModal(report)'
                        ng-class="{'control-inactive': dashboard.is_default}">
                        <i class="fa fa-cog"></i> Edit Report
                    </a>
                </li>
            </ul>
        </nav>
        <nav class="reports-control" ng-show="report.id">
            <ul>
                <li ng-repeat="(index, var) in report.variables">
                    {{ ng_var('var.name') }}
                    <select ng-change="changeReportLevelVar()" style="min-width: 150px;" ui-select2 ng-model="report.variables[index].value" ng-if="var.type != 'dates'">
                        <option ng-if="key != 'from_report_value'" ng-repeat="(key, param) in groupParams[var.type][var.field_type]" ng-value="key" ng-selected="key === report.variables[index].value">
                            {{ ng_var('param[0]') }}
                        </option>
                    </select>
                    <select ng-change="changeReportLevelVar()" style="min-width: 150px;" ui-select2 ng-model="report.variables[index].value" ng-if="var.type == 'dates'">
                        <option ng-if="key != 'from_report_value'" ng-repeat="(key, param) in groupParams[var.type]" ng-value="key" ng-selected="key === report.variables[index].value">
                            {{ ng_var('param[0]') }}
                        </option>
                    </select>
                </li>
            </ul>
        </nav>
    </div>


    <div class="graph-container">
        <div class="graph-container-controls" ng-if="!dashboard.is_default">
            <a
                ng-click="toggleLayoutEdit()"
                class="control"
                ng-class="{'control-active': layoutEditing}">
                Dashboard Layout <i class="fa fa-columns"></i>
            </a>
            <a
                ng-click='openAddWidget({})'
                ng-class="{'control-inactive': dashboard.is_default}"
                class="control"
            >
                Add Widget <i class="fa fa-plus"></i>
            </a>
        </div>
    </div>

    <div class="list-group">
        <div gridster="gridsterOptions" class="dashboard">
            <div class="dp-gridster-wrap">
                <div ng-if="!widget.deleted" gridster-item="widget" ng-repeat="widget in report.widgets" class="dp-gridster-item">
                    <div class="box-header">
                        <div ng-show='layoutEditing && !dashboard.is_default' class="box-header-btns pull-right">
                            <a title="Edit widget" ng-click="openEditWidget(widget)"><i class="fa fa-cog"></i></a>
                            <a title="Remove widget" ng-click="removeWidget(widget)"><i class="fa fa-times"></i></a>
                        </div>
                        <h3 class="ng-binding">{{ ng_var('widget.title') }}</h3>
                    </div>
                    <div class="box" ng-if="widget.type=='graph'">
                        <dashboard-amcharts
                            report-level-vars={{ ng_var('report.variables') }}
                            title="{{ ng_var('widget.title') }}"
                            widget-id = "{{ ng_var('widget.id') }}"
                            chart-data = "{{ ng_var('widget.data') }}"
                            chtype="{{ ng_var('widget.type') }}"
                        />
                    </div>
                    <div class="box" ng-if="widget.type=='table'">
                        <dashboard-table
                            title="{{ ng_var('widget.title') }}"
                            table-data="{{ ng_var('widget.data') }}"
                            widget-id = "{{ ng_var('widget.id') }}"
                            wtype="{{ ng_var('widget.type') }}"
                        />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>