<div style="padding: 8px 0 8px 15px; border-bottom: 1px solid #ccc;">
    Jump to month:
    {% set start_year = ("@" ~ app.getSetting('core.install_timestamp'))|date('Y') %}
    {% set end_year   = (("now"|date('Y')) - 1) %}
    <select ui-select2 ng-model="service.view_date" ng-change="service.loadSummaryResults()">
        {% if start_year <= end_year %}
            {% for year in start_year .. end_year %}
                {% for month in 1..12 %}
                    {% set month_year %}{{ year }}-{% if month < 10 %}0{% endif %}{{ month }}{% endset %}
                    <option value="{{ month_year }}">{{ month_year }}</option>
                {% endfor %}
            {% endfor %}
        {% endif %}
        {% for month in 1 .. ("now"|date('m')) %}
            {% set month_year %}{{ "now"|date('Y') }}-{% if month < 10 %}0{% endif %}{{ month }}{% endset %}
            <option value="{{ month_year }}">{{ month_year }}</option>
        {% endfor %}
    </select>
</div>

<div>
    <div class="panel panel-fill indent">
        <span dp-show-spinning="service.loading_summary_results" class="padd">
            <i class="spinner-flat"></i>
        </span>

        <section class="padd clearfix js-append-here" ng-bind-html="service.summary_html" dp-hide-spinning="service.loading_summary_results">

        </section>
    </div>
</div>