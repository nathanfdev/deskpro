<div class="report-list-wrapper">
    <div class="report-list-content">

        <div class="reports-list">
            {##########################################################################################################}
            {# FILTERS #}
            {##########################################################################################################}

            <div class="big-list-of-stats-filters">
                <div class="bucket">
                    <form>
                        <label>Filter:</label>
                        <div class="box">
                            <input type="text" ng-model="searchText" placeholder="Filter stats by name">
                        </div>
                    </form>
                </div>

                <div class="bucket" style="position: relative;" dp-dropdown="dp-select-label-dropdown" dp-dropdown-opener="dp-select-label-opener" dp-dropdown-toggle="true">
                    <a id="dp-select-label-opener" class="link-pointer select">Select labels: <i class="fa fa-caret-down"></i></a>

                    <!-- Needs to be same width as the .select above -->
                    <div id="dp-select-label-dropdown" class="select-label-dropdown">
                        <a ng-repeat="label in labels track by $index" ng-class="{'active': label.active}"
                           ng-click="toggleLabel(label)" class="link-pointer stat-label">
                            <i class="fa fa-tag"></i>{{ ng_var('label.title') }}
                        </a>
                    </div>
                </div>
            </div>

            {##########################################################################################################}
            {# LIST #}
            {##########################################################################################################}

            <div class="big-list-of-stats">
                <div ng-show="!loaded" style="text-align: center; padding: 45px;">
                    <i class="spinner-big-circle"></i>
                </div>
                <div ng-show="loaded" class="stat-list-wrapper">
                    <ul class="stat-list">
                        <li ng-repeat="report in custom_data_list_prefiltered | filter:filterBySearchText track by report.id" ui-sref-active="active">
                            <span class="mark"></span>
                            <h1>
                                <a ui-sref="reports.stats.view({ widget_id: report.id })">
                                    <dp-report-variables change-widget-params="changeWidgetParams(params)" report-id="report.id" value-to-decorate="report.title" possible-values="group_params"></dp-report-variables>
                                </a>
                            </h1>
                            <p ng-if="report.description.length">{{ ng_var('report.description.length') }}</p>
                            <p ng-if="report.labels.length">
                                <a href="#" class="stat-label" ng-class="{'active': isActiveLabel(label)}" ng-repeat="label in report.labels"><i class="fa fa-tag"></i> {{ ng_var('label') }}</a>
                            </p>
                        </li>
                        <li ng-repeat="report in built_in_data_list_prefiltered | filter:filterBySearchText track by report.id" ui-sref-active="active">
                            <span class="mark"></span>
                            <h1>
                                <a ui-sref="reports.stats.view({ widget_id: report.id })">
                                    <dp-report-variables change-widget-params="changeWidgetParams(params)" report-id="report.id" value-to-decorate="report.title" possible-values="group_params"></dp-report-variables>
                                </a>
                            </h1>
                            <p ng-if="report.description.length">{{ ng_var('report.description.length') }}</p>
                            <p ng-if="report.labels.length">
                                <a href="#" class="stat-label" ng-class="{'active': isActiveLabel(label)}" ng-repeat="label in report.labels"><i class="fa fa-tag"></i> {{ ng_var('label') }}</a>
                            </p>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="stat-large-preview-wrapper" ui-view></div>