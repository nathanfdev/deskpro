{% extends 'ReportsInterfaceBundle:Layout:fill-page.html.twig' %}

{% block fillpage_content %}

	<div class="alert alert-info">
		<div>
			Showing Agent Hours from:
			<span>
				<input type="text" class="form-control"
					   style="width: 140px; display: inline-block;"
					   dp-datetime-popup="DD MMM YYYY" ng-model="AgentHours.date1" />
			</span>
			to
			<span>
				<input type="text" class="form-control"
					   style="width: 140px; display: inline-block;"
					   dp-datetime-popup="DD MMM YYYY" ng-model="AgentHours.date2" />
			</span>

			<button class="btn btn-primary" ng-click="AgentHours.updateFilter()">Show</button>
		</div>
	</div>

	<span dp-show-spinning="loading_results" class="padd">
		<i class="spinner-flat"></i>
	</span>

	<section class="padd" ng-bind-html="AgentHours.html" dp-hide-spinning="loading_results">

	</section>

{% endblock %}
