<div class="alert alert-info">
    <div>
        Showing Agent Hours from:
			<span>
				<input type="text" class="form-control"
                       style="width: 140px; display: inline-block;"
					   dp-datetime-popup="DD MMM YYYY"
                       ng-model="service.date1"
                       />
			</span>
        to
			<span>
				<input type="text" class="form-control"
                       style="width: 140px; display: inline-block;"
					   dp-datetime-popup="DD MMM YYYY"
					   ng-model="service.date2"
                       />
			</span>

        <button class="btn btn-primary" ng-click="service.updateFilter()">Show</button>
    </div>
</div>

