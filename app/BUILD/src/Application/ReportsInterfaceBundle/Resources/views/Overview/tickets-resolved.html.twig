{% import 'ReportsInterfaceBundle:Overview:macros.html.twig' as macros %}
<section class="report-wrapper">
	<header>
		<h2 style="float: left;">
			<span class="label-sum"> {{ ng_var('tickets_resolved.sum') }}</span>
			Tickets were 'Resolved'
		</h2>
		<div style="float: left; padding-bottom: 5px;">
			<select ui-select2 ng-model="tickets_resolved.date_choice" style="min-width: 120px" class="no-search" ng-change="Overview.getStats('tickets_resolved')">
				{% for field,title in {
					'today': 'Today',
					'this_week': 'This Week',
					'this_month': 'This Month',
					'this_year': 'This Year',
				} %}
					<option value="{{ field }}">
						{{ title }}
					</option>
				{% endfor %}
			</select>
		</div>
		<div class="clearfix"></div>
		<h3>
			Showing Grouped by
			{{ macros.grouping_field_select('tickets_resolved') }}
		</h3>
	</header>
	<article>
		<div class="dp-layout-loading" ng-show="tickets_resolved.loading"><i></i></div>
		<table class="stat-table" width="100%" ng-if="!tickets_resolved.empty"
			   ng-hide="tickets_resolved.loading">
			<tr ng-repeat="stat in tickets_resolved.stats">
				<td class="title"><span>{{ ng_var('stat.title') }}</span></td>
				<td width="100%">
					<table width="100%" class="stat-value">
						<tr>
							<td class="value" width="{{ ng_var('stat.left_percentage') }}%">
								<div>&nbsp;</div>
							</td>
							<td width="{{ ng_var('stat.right_percentage') }}%">
								{{ ng_var('stat.value') }}
							</td>
						</tr>
					</table>
				</td>
			</tr>
			<tr class="total-row">
				<td class="title">Total:</td>
				<td class="val">{{ ng_var('tickets_resolved.sum') }}</td>
			</tr>
		</table>
		<div class="no-data" ng-if="tickets_resolved.empty" ng-hide="tickets_resolved.loading">
			<h3>No matching data</h3>
		</div>
	</article>
</section>
