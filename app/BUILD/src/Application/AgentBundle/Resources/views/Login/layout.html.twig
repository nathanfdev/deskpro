		i { font-style: italic; }
		ins { text-decoration: none; }
		del { text-decoration: line-through; }
		table { border-collapse: collapse; border-spacing: 0; }
		td { vertical-align: top; }

		html {
      background: #3297CE;
      background-image: radial-gradient(circle, #3297ce, #2d88be, #2779ae, #226a9e, #1c5c8e);
			-webkit-background-size: cover;
			-moz-background-size: cover;
			-o-background-size: cover;
			background-size: cover;
      height:100%;
		}

		body {
			font-family: Helvetica, Arial, Geneva, sans-serif;
			font-size: 13px;
		}

		.pull-left {
			float: left;
		}
		.pull-right {
			float: right;
		}
		a {
			color: #1b72b3;
			text-decoration: none;
		}
		a:hover {
			color: #1b72b3;
			text-decoration: underline;
		}

		.text-info {
			line-height: 145%;
		}

		.text-info p {
			margin: 17px 0;
		}

		.text-info ul {
			list-style-type: disc;
			margin-left: 25px;
		}

		.text-info ol {
			list-style-type: decimal;
		}

		.text-info ol li {
			margin: 15px 0;
		}

		.text-info ol li img {
			max-width: 100%;
