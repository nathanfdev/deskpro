{% import 'AgentBundle:Common:optionbox-macros.html.twig' as optionbox %}
<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.ManualTopicView';
pageMeta.title = {{manual_topic.title|json_encode|raw}};
pageMeta.manual_topic_id = {{manual_topic.id}};
pageMeta.url_fragment  = '{{ url_fragment('agent_manual_topic_view', {'manual_topic_id': manual_topic.id}) }}';
pageMeta.obj_code = 'manual_topic_{{ manual_topic.id }}';
pageMeta.canEdit   = {% if not perms.can_edit %}false{% else %}true{% endif %};
pageMeta.canDelete = {% if not perms.can_delete %}false{% else %}true{% endif %};

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
{# scroll containers #}
<div class="layout-content page-listing page-manual-topic-view {% if not perms.can_edit %}perm-no-edit{% endif %} {% if not perms.can_delete %}perm-no-delete{% endif %}">
<div class="dp-page-content">
{# /scroll containers #}

<div class="delete-notice" {% if manual_topic.status_code != "hidden.deleted" %}style="display: none;"{% endif %}>
	{{ phrase('agent.general.record_deleted') }} <button class="clean-gray xxx-small undelete">{{ phrase('agent.general.undelete') }}</button>
</div>

<header class="page-header">
	<h4 class="id-number">#{{ manual_topic.id }}</h4>
	<div style="float:left; padding-left: 8px;">
		<select id="{{ baseId }}_status">
			<option {% if manual_topic.status == 'published' %}selected="selected"{% endif %} value="published">{{ phrase('agent.publish.status_published') }}</option>
			<option {% if manual_topic.getStatusCode == 'hidden.unpublished' %}selected="selected"{% endif %} value="hidden.unpublished">{{ phrase('agent.publish.status_hidden_unpublished') }}</option>
			<option {% if manual_topic.status == 'archived' %}selected="selected"{% endif %} value="archived">{{ phrase('agent.publish.status_archived') }}</option>
			<option {% if manual_topic.getStatusCode() == 'hidden.draft' %}selected="selected"{% endif %} value="hidden.draft">{{ phrase('agent.publish.status_hidden_draft') }}</option>
		</select>
	</div>
	<h1>
		<span id="{{baseId}}_showname">{{ manual_topic.title }}</span>
		<span id="{{baseId}}_editname" style="display: none"><input type="text" name="name" value="{{ manual_topic.title }}" /></span>
		<span id="{{baseId}}_editname_start" class="edit-name-gear"></span>
		<a id="{{baseId}}_editname_end" class="edit-name-save clean-white" style="display: none">{{ phrase('agent.general.done') }}</a>
	</h1>
	<br class="clear" />
	<table width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-top: 2px;">
		<tr>
			<td valign="middle" style="vertical-align: middle;">
				{% include 'AgentBundle:Common:select-standard.html.twig' with {
					'name': 'category_id',
					'add_classname': 'category_id',
					'add_attr': '',
					'with_blank': 0,
					'blank_title': '',
					'categories': manuals,
					'selected': manual_topic.manual.id,
					'allow_parent_sel': true,
					'id': baseId ~ '_cat'
				} %}
			</td>
		</tr>
	</table>
	<br class="clear" />
</header>


<div class="profile-box-container-outer">
	<div class="profile-box-container">
		<header>
			<h4>{{ phrase('agent.general.properties') }}</h4>
		</header>
		<section class="description-area">
			<dl class="info-list">
				<dt>{{ phrase('agent.publish.slug') }}</dt>
				<dd>
					<span id="{{ baseId }}_slug">{{ manual_topic.slug }}</span>
					<button class="clean-white" id="{{ baseId }}_editslug" data-prompt="{{ phrase('agent.publish.slug_edit_prompt') }}">
						{{ phrase('agent.publish.slug_edit') }}
					</button>
				</dd>

				<dt>{{ phrase('agent.general.rating') }}</dt>
				<dd>
                    {% set phrase_part %}
                    <span class="link-look who-voted-trigger">{{ phrase('agent.general.count_votecount_votes', {'count': manual_topic.num_ratings}) }}</span>
                    {% endset %}
                    {{ phrase('agent.general.percent_helpful_subphrase', {'percent':manual_topic.rating_percent,'subphrase':phrase_part}, true) }}<br />
                    <small>{{ phrase('agent.general.found_article_helpful_or_not', {'up_votes':manual_topic.up_votes,'down_votes':manual_topic.down_votes}) }}</small>
				</dd>

				<dt></dt>
				<dd>
					{{ phrase('agent.general.created_timeago_by_x_on_y', {
						'timeago': '<time class="timeago" datetime="' ~ manual_topic.date_created|date('c', 'UTC') ~'"></time>',
						'name': manual_topic.person.display_name|escape,
						'date': '<time>' ~ manual_topic.date_created|date('fulltime') ~ '</time>'
					}, true) }}
				</dd>


				<dd id="{{baseId}}_auto_unpub" {% if not (manual_topic.status == 'published') %}style="display: none"{% endif %}>
					<span class="auto-unpublish" {% if not manual_topic.date_end %}style="display: none"{% endif %}>
						{% set phrase_part1 %}<span class="end-action opt" data-val="{{manual_topic.end_action|default('unpublish')}}">{{manual_topic.end_action|default(phrase('agent.general.unpublish'))}}</span>{% endset %}
						{% set phrase_part2 %}
							<div style="display: inline-block; position: relative;">
								<span class="end-date opt" {% if manual_topic.date_end %}data-val="{{ manual_topic.date_end|date('j M, y') }}"{% endif %}> {% if manual_topic.date_end %}{{ manual_topic.date_end|date('day') }}{% else %}{{ phrase('agent.publish.click_to_set_date') }}{% endif %}</span>
							</div>
						{% endset %}
						{{ phrase('user.knowledgebase.auto_action_on_date', {action: phrase_part1, date: phrase_part2}, true) }}
						<input type="text" class="end-date-input" value="{{ manual_topic.date_end|date('j M, y') }}" style="display: none; height: 10px;" />
						(<span class="remove-auto-unpublish options-text">{{ phrase('agent.general.remove') }}</span>)
					</span>
					<span class="options-text auto-unpublish-set" {% if manual_topic.date_end %}style="display: none"{% endif %}>
						{{ phrase('agent.publish.set_auto_unpublish_date') }}
					</span>
					<br />

					<ul class="end-action-menu" style="display: none">
						<li data-action="unpublish">{{ phrase('agent.general.unpublish') }}</li>
						<li data-action="archive">{{ phrase('agent.general.archive') }}</li>
					</ul>
				</dd>

				<dd id="{{baseId}}_auto_pub" {% if not (manual_topic.hidden_status == 'unpublished') %}style="display: none"{% endif %}>
					<span class="auto-publish" {% if not manual_topic.date_published %}style="display: none"{% endif %}>
						{% set phrase_part1 %}{{ phrase('agent.general.publish') }}{% endset %}
						{% set phrase_part2 %}
							<div style="display: inline-block; position: relative;">
								<span class="pub-date opt" {% if manual_topic.date_published %}data-val="{{ manual_topic.date_published|date('U') }}"{% endif %}> {% if manual_topic.date_published %}{{ manual_topic.date_published|date('day') }}{% else %}{{ phrase('agent.publish.click_to_set_date') }}{% endif %}</span>
							</div>
						{% endset %}
						{{ phrase('user.knowledgebase.auto_action_on_date', {action: phrase_part1, date: phrase_part2}, true) }}
						<input type="text" class="pub-date-input" value="{{ manual_topic.date_published|date('j M, y') }}000" style="display: none; height: 10px;" />
						(<span class="remove-auto-publish options-text">{{ phrase('agent.general.remove') }}</span>)
					</span>
					<span class="options-text auto-publish-set" {% if manual_topic.date_published %}style="display: none"{% endif %}>
						{{ phrase('agent.publish.set_auto_publish_date') }}
					</span>
				</dd>

			</dl>

			<div class="controls" id="{{baseId}}_action_buttons">
				<button class="clean-white delete nodelete-hide" {% if manual_topic.status_code == "hidden.deleted" %}style="display:none"{% endif %}>{{ phrase('agent.general.delete') }}</button>
				<button class="clean-white permalink" data-prompt="{{ phrase('agent.publish.permalink_copy_prompt') }}">
					{{ phrase('agent.general.copy_permalink') }}
				</button>
				<button class="clean-white view-user-interface">{{ phrase('agent.general.view_in_user_interface') }}</button>
				<br class="clear" />
			</div>
		</section>
	</div>
</div>

{% if (manual_topic.no_content == false) %}
<div class="profile-box-container reply-box-wrap">
	<header>
		<nav  id="{{baseId}}_bodytabs">
			<ul>
				<li class="on" data-tab-for="#{{baseId}}_tab_contents .manual-topic-content"><span>{{ phrase('agent.general.page') }}</span></li>
				<li data-tab-for="#{{baseId}}_tab_contents .comments-tab"><span>{{ phrase('agent.general.comments') }} (<span id="{{baseId}}_count_comments">{{comments|length|default(0)}}</span>)</span></li>
				<li data-tab-for="#{{baseId}}_tab_contents .revisions-tab"><span>{{ phrase('agent.general.label_revisions') }} (<span id="{{baseId}}_count_revs">{{manual_topic.revisions|length|default(0)}}</span>)</span></li>
				<li data-tab-for="#{{baseId}}_tab_contents .related-content-tab"><span>{{ phrase('agent.general.related_content') }} (<span id="{{baseId}}_count_related">0</span>)</span></li>
				<li data-tab-for="#{{baseId}}_tab_contents .search-tab"><span>{{ phrase('agent.general.search') }}</span></li>
			</ul>
		</nav>
	</header>
	<section>

		{# Tab Contents #}
		<div id="{{baseId}}_tab_contents">
			{# Tab: Content #}
			<div class="deskpro-tab-item manual-topic-content on">
				{# Content #}
				<nav class="sub-box-nav noedit-hide">
					<ul class="option-buttons right" id="{{baseId}}_content_edit_btns">
						<li class="kb-editor-edit edit" id="{{baseId}}_edit_btn"><span>{{ phrase('agent.general.ucfirst_edit') }}</span></li>
					</ul>
				</nav>
				<div id="{{baseId}}_content_ed" class="manual-topic-content content-tab-item">
				{% include 'AgentBundle:Manual:view-content-tab.html.twig' %}
				</div>
				{# /Content #}
			</div>

			{# Tab: Comments #}
			<div class="deskpro-tab-item content-tab-item comments-tab">
				<div class="§-comments">
					<div class="full-tab-content">
						<div class="messages-wrap" id="{{baseId}}_comments_wrap">
							{% for comment in comments %}
								{% set comment_num = loop.index %}
								{% include 'AgentBundle:Manual:view-comment.html.twig' %}
							{% endfor %}
						</div>
					</div>

					<div class="messages-wrap new-note">
						<article
							class="content-message agent-message"
							data-comment-id="{{comment.id}}"
							data-content-type="{{ comment.object_content_type }}"
						>
							<div class="avatar">
								<img src="{{ app.user.getPictureUrl(40) }}" alt="" width="40" height="40" />
							</div>
							<div class="content">
								<header>
									<h4>{{ phrase('agent.general.new_comment') }}</h4>
								</header>
								<div class="body-text">
									<textarea style="width:99%; height: 80px;"></textarea>
								</div>
								<div class="footer-text">
									<div class="loading-off">
										<button class="clean-white">{{ phrase('agent.general.add_comment') }}</button>
									</div>
									<div class="loading-on" style="display:none">
										{{ phrase('agent.general.saving') }}
									</div>
								</div>
							</div>
						</article>
					</div>
				</div>
			</div>
			{# /Tab: Comments #}

			{# Tab: Revisions #}
			<div id="{{baseId}}_revs" class="deskpro-tab-item content-tab-item revisions-tab">
				{% include 'AgentBundle:Manual:view-revisions-tab.html.twig' %}
			</div>
			{# /Tab: Revisions #}

			{# Tab: Related #}
			<div id="{{baseId}}_related_content" class="deskpro-tab-item content-tab-item related-content-tab">
				{% include 'AgentBundle:Common:content-related-list.html.twig' %}
			</div>
			{# /Tab: Related #}

			{# Tab: Search #}
			<div id="{{baseId}}_searchtab" class="deskpro-tab-item search-tab">
				<section class="description-area sticky-search-words">
					<dl class="info-list">
						<dt class="type-labels">{{ phrase('agent.publish.sticky_words_title') }}</dt>
						<dd class="noedit-tags">
							<input type="text" value="{% for label in sticky_search_words %}{{label}},{% endfor %}" id="{{baseId}}_stickysearch_input" />
							<div class="explain">
								{{ phrase('agent.publish.search_sticky_words_explain') }}
							</div>
						</dd>
					</dl>
				</section>

				<br />

				{% include 'AgentBundle:Publish:rated-searches.html.twig' %}
			</div>
			{# /Tab: Search #}
		</div>
		{# /Main Tabs #}
</section>
</div>
{% endif %}

<div class="inline-editable" style="display:none">
	<div class="title">
		<input type="text" name="title" value="{{ manual_topic.title }}"/>
		<input type="hidden" name="action" value="title" />
	</div>
</div>

{# scroll containers #}
</div>
</div>
{# /scroll containers #}
