<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.NewTopic';

pageMeta.title = '{{ phrase('agent.publish.new_topic') }}';
pageMeta.uploadAttachUrl = '{{ path('agent_accept_upload') }}';

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
<div class="layout-content page-new-topic page-new-content">
<div class="drop-file-zone"><h1>{{ phrase('agent.publish.drop_file_to_add') }}</h1></div>
<div class="dp-page-content">

<a class="tab-anchor" href="#">&nbsp;</a>

<a class="tab-anchor" href="#">&nbsp;</a>

<div class="form-header-error" style="display: none">
	{{ phrase('agent.publish.no_guides_error') }}
</div>
<div class="form-outer">

<form id="{{baseId}}_new-topic" class="keybound-submit">

<div class="first section cat-section" id="{{baseId}}_cat_section">
	<div class="content dp-control-group">
		<div class="col">
			<h4>{{ phrase('agent.general.brand') }}</h4>
			<select name="newtopic[brand]" id="new_topic_brand_id">
				{% for brand in brands %}
					<option value="{{ brand.id }}" {% if selected_brand_id == brand.id %}selected="selected"{% endif %}>
						{{ brand.name }}
					</option>
				{% endfor %}
			</select>
		</div>
		<div class="col">
			<h4>{{ phrase('agent.general.guide') }}</h4>
			{% include 'AgentBundle:Common:select-standard.html.twig' with {
				'name': 'newtopic[guide_id]',
				'id': 'new_topic_guide_id',
				'add_classname': 'guide_id',
				'add_attr': '',
				'categories': guides,
				'allow_parent_sel': true,
				'selected': state.topic.guide_id
			} %}
			<div class="error-message guide_id">{{ phrase('agent.publish.please_select_guide') }}</div>
		</div>
		<div class="col">
			<h4 class="light">{{ phrase('agent.general.status') }}</h4>
			<select name="newtopic[status]">
				{% if app.user.hasPerm('agent_publish.validate') %}
					<option value="published">{{ phrase('agent.publish.status_published') }}</option>
				{% endif %}
				<option value="hidden.unpublished">{{ phrase('agent.publish.status_hidden_unpublished') }}</option>
				<option value="hidden.draft">{{ phrase('agent.publish.status_hidden_draft') }}</option>
			</select>
		</div>
		<div class="col">
			<h4>{{ phrase('agent.general.parent') }}</h4>
            {% include 'AgentBundle:Common:select-standard.html.twig' with {
            'name': 'newtopic[parent_id]',
            'id': baseId ~ '_parent',
            'add_classname': 'parent_id',
            'add_attr': '',
            'categories': topics,
            'allow_parent_sel': true,
            'selected': state.topic.parent_id
            } %}
		</div>
		<br class="clear" />
	</div>
</div>

<div class="section title-section" id="{{baseId}}_title_section">
	<div class="content">
		<h4 id="{{baseId}}_topic_title" style="display: none">{{ phrase('agent.general.title') }}</h4>
		<h4 id="{{baseId}}_section_title">{{ phrase('agent.general.section_title') }}</h4>
		<input type="text" name="newtopic[title]" id="{{baseId}}_title" value="{{ state.topic.title }}" style="width: 80%;" />
		<div class="error-message title">{{ phrase('agent.publish.please_enter_title') }}</div>
	</div>
</div>

<div class="section article-section" id="{{baseId}}_content_section" style="display:none;">
	<div class="content">
		<h4>{{ phrase('agent.publish.post') }}</h4>
		<textarea type="text" name="newtopic[content]" id="{{baseId}}_content">{{ state.topic.content }}</textarea>
		<input type="hidden" name="newtopic[content_input]" id="{{baseId}}_content_input" value="">
		<input type="hidden" name="newtopic[content_input_type]" id="{{baseId}}_content_input_type" value="markdown">
	</div>
</div>


<div class="section other-section" id="{{baseId}}_other_section">
	<div class="content">
		{# Tab Container #}
		<div class="tab-container">
			<nav id="{{baseId}}_other_props_tabs_wrap">
				<ul id="{{baseId}}_other_props_tabs">
					<li data-tab-for="> .tab-properties">{{ phrase('agent.general.properties') }}</li>
				</ul>
			</nav>
			<div class="content-wrapper" id="{{baseId}}_other_props_tabs_content" style="display: none">
				{# Tab Properties #}
				<div class="tab-properties" style="display: none">
					<dl>
						<dt class="prop">{{ phrase('agent.general.labels') }}</dt>
						<dd class="prop">
							<div class="tags-wrap article-tags">
								<input type="text" value="{% for label in state.newnews.labels %}{{label}},{% endfor %}" data-allow-new="{{ app.user.hasPerm('agent_publish.articles_create_labels') ? 1 : 0 }}" />
							</div>
						</dd>
					</dl>
				</div>
				{# /Tab Properties #}
			</div>
		</div>
		{# /Tab Container #}
	</div>
</div>

<footer class="pop-footer">
	<div class="is-not-loading">
		<button class="submit-trigger clean-white"><span id="{{baseId}}_topic_submit" style="display: none">{{ phrase('agent.general.create_topic') }}</span><span id="{{baseId}}_section_submit">{{ phrase('agent.general.create_section') }}</span> <kbd class="noshowmac">{{ phrase('agent.general.altc') }}</kbd><kbd class="showmac">{{ phrase('agent.general.ctrlc') }}</kbd></button>
	</div>
	<div class="is-loading" style="padding-top: 9px;">
		<img src="{{ asset('images/spinners/loading-small.gif') }}" />
	</div>
</footer>

</form>

</div>
</div>
</div>
