{% import 'AgentBundle:Common:optionbox-macros.html.twig' as optionbox %}
<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.TopicView';
pageMeta.title = {{topic.title|json_encode|raw}};
pageMeta.topic_id = {{topic.id}};
pageMeta.url_fragment  = '{{ url_fragment('agent_topic_view', {'topic_id': topic.id}) }}';
pageMeta.obj_code = 'topic_{{ topic.id }}';
pageMeta.permalink = '{{ portal_url(topic, 'permalink') }}';
pageMeta.canEdit   = {% if not perms.can_edit %}false{% else %}true{% endif %};
pageMeta.canDelete = {% if not perms.can_delete %}false{% else %}true{% endif %};

{% set baseId = el_uid() %}
{% set noContent = (topic.no_content or topic.parent is null) %}
pageMeta.baseId = '{{ baseId }}';
</script>
{# scroll containers #}
<div class="layout-content page-listing page-topic-view {% if not perms.can_edit %}perm-no-edit{% endif %} {% if not perms.can_delete %}perm-no-delete{% endif %}">
<div class="dp-page-content">
{# /scroll containers #}

<div class="delete-notice" {% if topic.status_code != "hidden.deleted" %}style="display: none;"{% endif %}>
	{{ phrase('agent.general.record_deleted') }} <button class="clean-gray xxx-small undelete">{{ phrase('agent.general.undelete') }}</button>
</div>

<header class="page-header">
	<h4 class="id-number">#{{ topic.id }}</h4>
	<div style="float:left; padding-left: 8px;">
		<select id="{{ baseId }}_status">
			<option {% if topic.status == 'published' %}selected="selected"{% endif %} value="published">{{ phrase('agent.publish.status_published') }}</option>
			<option {% if topic.getStatusCode == 'hidden.unpublished' %}selected="selected"{% endif %} value="hidden.unpublished">{{ phrase('agent.publish.status_hidden_unpublished') }}</option>
			<option {% if topic.status == 'archived' %}selected="selected"{% endif %} value="archived">{{ phrase('agent.publish.status_archived') }}</option>
			<option {% if topic.getStatusCode() == 'hidden.draft' %}selected="selected"{% endif %} value="hidden.draft">{{ phrase('agent.publish.status_hidden_draft') }}</option>
		</select>
	</div>
	<h1>
		<span id="{{baseId}}_showname">{{ topic.title }}</span>
		<span id="{{baseId}}_editname" style="display: none"><input type="text" name="name" value="{{ topic.title }}" /></span>
		<span id="{{baseId}}_editname_start" class="edit-name-gear"></span>
		<a id="{{baseId}}_editname_end" class="edit-name-save clean-white" style="display: none">{{ phrase('agent.general.done') }}</a>
	</h1>
	<br class="clear" />
	<table width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-top: 2px;">
		<tr>
			<td valign="middle" style="vertical-align: middle;">
				{% include 'AgentBundle:Common:select-standard.html.twig' with {
					'name': 'category_id',
					'add_classname': 'category_id',
					'add_attr': '',
					'with_blank': 0,
					'blank_title': '',
					'categories': guides,
					'selected': topic.guide.id,
					'allow_parent_sel': true,
					'id': baseId ~ '_cat'
				} %}
			</td>
		</tr>
	</table>
</header>

{% if noContent %}
	<div class="profile-box-container" id="{{baseId}}_no_content_block">
		<header>
			<h4>{{ phrase('agent.general.properties') }}</h4>
		</header>
		{% include 'AgentBundle:Guide:view-properties-tab.html.twig' %}
	</div>
{% endif %}

<div class="profile-box-container reply-box-wrap" id="{{baseId}}_with_content_block" {% if noContent %}style="display: none"{% endif %}>
	<header>
		<nav  id="{{baseId}}_bodytabs">
			<ul>
				<li class="on" data-tab-for="#{{baseId}}_tab_contents .topic-content"><span>{{ phrase('agent.general.page') }}</span></li>
				<li data-tab-for="#{{baseId}}_tab_contents .topic-props"><span>{{ phrase('agent.general.properties') }}</span></li>
				<li data-tab-for="#{{baseId}}_tab_contents .comments-tab"><span>{{ phrase('agent.general.comments') }} (<span id="{{baseId}}_count_comments">{{comments|length|default(0)}}</span>)</span></li>
				<li data-tab-for="#{{baseId}}_tab_contents .revisions-tab"><span>{{ phrase('agent.general.label_revisions') }} (<span id="{{baseId}}_count_revs">{{topic.revisions|length|default(0)}}</span>)</span></li>
				{#<li data-tab-for="#{{baseId}}_tab_contents .related-content-tab"><span>{{ phrase('agent.general.related_content') }} (<span id="{{baseId}}_count_related">0</span>)</span></li>#}
				<li data-tab-for="#{{baseId}}_tab_contents .search-tab"><span>{{ phrase('agent.general.search') }}</span></li>
			</ul>
		</nav>
	</header>
	<section>

		{# Tab Contents #}
		<div id="{{baseId}}_tab_contents">
			{# Tab: Content #}
			<div class="deskpro-tab-item topic-content on">
				{# Content #}
				<nav class="sub-box-nav noedit-hide">
					<ul class="option-buttons right" id="{{baseId}}_content_edit_btns">
						<li class="kb-editor-edit edit" id="{{baseId}}_edit_btn"><span>{{ phrase('agent.general.ucfirst_edit') }}</span></li>
					</ul>
				</nav>
				<div id="{{baseId}}_content_ed" class="topic-content content-tab-item">
				{% include 'AgentBundle:Guide:view-content-tab.html.twig' %}
				</div>
				{# /Content #}
			</div>

			{# Tab: Properties #}
			<div class="deskpro-tab-item content-tab-item topic-props">
                {% include 'AgentBundle:Guide:view-properties-tab.html.twig' %}
			</div>


			{# Tab: Comments #}
			<div class="deskpro-tab-item content-tab-item comments-tab">
				<div class="§-comments">
					<div class="full-tab-content">
						<div class="messages-wrap" id="{{baseId}}_comments_wrap">
							{% for comment in comments %}
								{% set comment_num = loop.index %}
								{% include 'AgentBundle:Guide:view-comment.html.twig' %}
							{% endfor %}
						</div>
					</div>

					<div class="messages-wrap new-note">
						<article
							class="content-message agent-message"
							data-comment-id="{{comment.id}}"
							data-content-type="{{ comment.object_content_type }}"
						>
							<div class="avatar">
								<img src="{{ app.user.getPictureUrl(40) }}" alt="" width="40" height="40" />
							</div>
							<div class="content">
								<header>
									<h4>{{ phrase('agent.general.new_comment') }}</h4>
								</header>
								<div class="body-text">
									<textarea style="width:99%; height: 80px;"></textarea>
								</div>
								<div class="footer-text">
									<div class="loading-off">
										<button class="clean-white">{{ phrase('agent.general.add_comment') }}</button>
									</div>
									<div class="loading-on" style="display:none">
										{{ phrase('agent.general.saving') }}
									</div>
								</div>
							</div>
						</article>
					</div>
				</div>
			</div>
			{# /Tab: Comments #}

			{# Tab: Revisions #}
			<div id="{{baseId}}_revs" class="deskpro-tab-item content-tab-item revisions-tab">
				{% include 'AgentBundle:Guide:view-revisions-tab.html.twig' %}
			</div>
			{# /Tab: Revisions #}

			{# Tab: Related #}
			<div id="{{baseId}}_related_content" class="deskpro-tab-item content-tab-item related-content-tab">
				{% include 'AgentBundle:Common:content-related-list.html.twig' %}
			</div>
			{# /Tab: Related #}

			{# Tab: Search #}
			<div id="{{baseId}}_searchtab" class="deskpro-tab-item search-tab">
				<section class="description-area sticky-search-words">
					<dl class="info-list">
						<dt class="type-labels">{{ phrase('agent.publish.sticky_words_title') }}</dt>
						<dd class="noedit-tags">
							<input type="text" value="{% for label in sticky_search_words %}{{label}},{% endfor %}" id="{{baseId}}_stickysearch_input" />
							<div class="explain">
								{{ phrase('agent.publish.search_sticky_words_explain') }}
							</div>
						</dd>
					</dl>
				</section>

				<br />

				{% include 'AgentBundle:Publish:rated-searches.html.twig' %}
			</div>
			{# /Tab: Search #}
		</div>
		{# /Main Tabs #}
</section>
</div>

<div class="inline-editable" style="display:none">
	<div class="title">
		<input type="text" name="title" value="{{ topic.title }}"/>
		<input type="hidden" name="action" value="title" />
	</div>
</div>

{# scroll containers #}
</div>
</div>
{# /scroll containers #}
