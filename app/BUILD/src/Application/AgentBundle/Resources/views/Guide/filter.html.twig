{% extends 'AgentBundle::list-pane-layout.html.twig' %}
{% set tplvars = { baseId: el_uid() } %}

{######################################################################################################################}
{# METADATA #}
{######################################################################################################################}
{% block top %}
    <script>
      pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.GuideList';
      pageMeta.refreshUrl = '{{ path('agent_guides_list', {'guide_id': guide.id}) }}';
      pageMeta.url_fragment = '{{ url_fragment('agent_guides_list', {'guide_id': guide.id}) }}';
      pageMeta.baseId = '{{ tplvars.baseId }}';
      pageMeta.guideId = {{ guide.id }};
      pageMeta.display_fields = {{ display_fields|json_encode|raw }};
      pageMeta.canEdit = {% if not perms.can_edit %}false{% else %}true{% endif %};
      pageMeta.useVolumes = {% if guide.isUseVolumes() %}true{% else %}false{% endif %};
    </script>
{% endblock top %}

{######################################################################################################################}
{# HEADER #}
{######################################################################################################################}

{% block pane_header %}
    <ul class="pane-tabs" data-element-handler="DeskPRO.ElementHandler.SimpleTabs" data-active-classname="active">
        <li class="tab active" data-tab-for="#{{ tplvars.baseId }}_tab_main"><i class="far icon-dp-article"></i> {{ phrase('agent.publish.guide_list_title', {count: total_results|default(0)}) }}</li>

        {% if guide %}
            <li class="tab" data-tab-for="#{{ tplvars.baseId }}_tab_cat"><i class="fas fa-folder"></i> <span>{{ guide.title }}</span></li>
        {% endif %}
    </ul>
{% endblock pane_header %}

{######################################################################################################################}
{# CONTENT #}
{######################################################################################################################}

{% block pane_content %}

    {##################################}
    {# Posts #}
    {##################################}

    <div id="{{ tplvars.baseId }}_tab_main">

        {% include 'AgentBundle:Guide:filter-display-options.html.twig' %}
        {% include 'AgentBundle:Guide:filter-control-bar.html.twig' %}

        <section class="guide-simple-list list-listing no-check"></section>


        {% if not results|length %}
            <section class="list-listing no-results">
                <p>{{ phrase('agent.general.there_are_no_results') }}</p>
            </section>
        {% endif %}

        {% if results|length %}
            <footer class="results-nav">
                <div class="cursor">
                    {% set phrase_part1 %}<span class="results-showing-count" id="{{ tplvars.baseId }}_showing_count">{{ ((cur_page - 1) * 50) + 1 }} - {{ showing_to }}</span>{% endset %}
                    {% set phrase_part2 %}<span class="results-total-count" id="{{ tplvars.baseId }}_total_count">{{ total_results }}</span>{% endset %}
                    {{ phrase('agent.general.showing_results_x_of_y', {'display_count':phrase_part1,'size':phrase_part2}, true) }}
                </div>
                {% if total_results > 50 %}
                    <ul class="pagenav {% if cur_page == 1 %}no-prev{% endif %} {% if cur_page == num_pages %}no-next{% endif %}">
                        {% if cur_page > 1 %}
                            <li class="prev" data-route="listpane:{{ path('agent_guides_list', {'guide_id': guide.id, p: cur_page - 1 }) }}"></li>
                        {% else %}
                            <li class="prev no-prev"></li>
                        {% endif %}

                        {% if cur_page < num_pages %}
                            <li class="next" data-route="listpane:{{ path('agent_guides_list', {'guide_id': guide.id, p: cur_page + 1 }) }}"></li>
                        {% else %}
                            <li class="next no-next"></li>
                        {% endif %}
                    </ul>
                {% endif %}
                <div class="loading">

                </div>
            </footer>
        {% endif %}

    </div>

    {##################################}
    {# Guide #}
    {##################################}

    {% if guide %}
        <style>
            .picker {
                display: table-row;
                height: 25px;
                list-style: none;
            }
            .picker-modal {
                z-index: 1;
            }
            .picker li {
                display: table-cell;
                width: 25px;
            }
            .picker-color {
                display: block;
                width: 25px;
                height: 25px;
                text-align: center;
                cursor: pointer;
            }
            label[for="picker-input"] {
                position: absolute;
                display: block;
                top: 8px;
                left: 13px;
                height: 19px;
                width: 19px;
                border-radius: 2px;
                cursor: pointer;
                z-index: 1;
            }
            #picker-input {
                padding-left: 30px;
            }
        </style>
        <div class="list-listing {% if not perms.can_delete %}perm-no-delete{% endif %} {% if not perms.can_edit %}perm-no-edit{% endif %}">
            <div id="{{ tplvars.baseId }}_tab_cat" style="display: none;">

                <section class="pane-section last nodelete-hide" id="{{ tplvars.baseId }}_del_guide">
                    <header><h1>{{ phrase('agent.publish.delete_guide') }}</h1></header>
                    <article style="padding: 10px;">
                        <div class="dp-not-loading">
                            <button class="dp-btn guide-del-trigger" data-save-url="{{ path('agent_publish_cats_adddel', {type: 'topics', category_id: guide.id}) }}">{{ phrase('agent.publish.delete_guide_btn') }}</button>
                        </div>
                        <div class="dp-is-loading">
                            <i class="spinner-flat"></i>
                        </div>
                    </article>
                </section>

                <section class="pane-section">
                    <header><h1>{{ phrase('agent.publish.edit_guide_btn') }}</h1></header>
                    <article>
                        <div class="pane-form">
                            <table class="pane-form-table">
                                <tbody>
                                <tr>
                                    <th width="100">{{ phrase('agent.general.title') }}</th>
                                    <td>
                                        <input type="hidden" name="category[id]" value="{{ guide.id }}" />
                                        <input type="text"
                                               name="category[title]"
                                               autocomplete="{{ "now" | date("U") }}"
                                               value="{{ guide.title }}" {% if not perms.can_edit %} disabled {% endif %}/>
                                    </td>
                                </tr>
                                <tr>
                                    <th width="100">{{ phrase('agent.general.description') }}</th>
                                    <td>
                                        <input type="text"
                                               name="category[description]"
                                               autocomplete="{{ "now" | date("U") }}"
                                               value="{{ guide.description }}" {% if not perms.can_edit %} disabled {% endif %} />
                                    </td>
                                </tr>
                                <tr>
                                    <th width="100">{{ phrase('agent.guides.use_volumes') }}</th>
                                    <td>
                                        <input type="checkbox"
                                               name="category[use_volumes]"
                                               {% if guide.useVolumes %}checked{% endif %}
                                               value="1" {% if not perms.can_edit %} disabled {% endif %} />
                                    </td>
                                </tr>
                                <tr class="vtop">
                                    <th>{{ phrase('agent.general.permissions') }}</th>
                                    <td>
                                        <ul>
                                            {% for ug in app.getUsergroups().getUserUsergroups() %}
                                                <li>
                                                    <label>
                                                        <input class="ug-check ug-{{ ug.id }} {% if ug.sys_name %}ug-{{ ug.sys_name }}{% endif %}" type="checkbox" name="category[usergroups][]" value="{{ ug.id }}" {% if ug.id in cat_usergroups %}checked="checked"{% endif %} {% if not perms.can_edit %} disabled="disabled" {% endif %} />
                                                        {{ ug.title }}
                                                    </label>
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    </td>
                                </tr>
                                <tr>
                                    <th>{{ phrase('agent.general.icon') }}</th>
                                    <td>
                                        <div id="{{ tplvars.baseId }}_pick_cat_icon" class="category-icon">
                                            <input type="hidden" name="icon_urn" value={{ guide.icon.urn }} />
                                            <input type="hidden" name="icon_style" value={{ guide.icon.options.style }} />
                                            <input type="hidden" name="icon_color" value={{ guide.icon.options.color }} />
                                            <input type="hidden" name="icon_url" value={{ guide.icon.blob.download_url }} />
                                            <button class="dp-btn btn-default" type="button">
                                                {{ phrase('agent.publish.pick_icon') }}
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <th width="100">{{ phrase('agent.general.color') }}</th>
                                    <td style="position: relative" id="{{ tplvars.baseId }}_color_picker">
                                        <label for="picker-input" style="background-color: {{ guide.color }}"></label>
                                        <input
                                                id="picker-input"
                                                type="text"
                                                name="category[color]"
                                                autocomplete="{{ "now" | date("U") }}"
                                                value="{{ guide.color }}" {% if not perms.can_edit %} disabled {% endif %} />
                                        <div style="position: absolute; display:none" class="picker-modal">
                                            <ul class="picker">
                                                {% for color in colors|slice(0, colors|length / 2) %}
                                                    <li>
											<span data-color="{{ color }}" class="picker-color" style="background-color: {{ color }}">
											</span>
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                            <ul class="picker">
                                                {% for color in colors|slice(colors|length / 2, colors|length / 2) %}
                                                    <li>
											<span data-color="{{ color }}" class="picker-color" style="background-color: {{ color }}">
											</span>
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <th width="100">{{ phrase('agent.general.splash_image') }}</th>
                                    <td class="splash-image" id="{{ tplvars.baseId }}_splash_image_td">
                                        {% include 'AgentBundle:Guide:splash-image-td.html.twig' %}
                                    </td>
                                </tr>
                            {% if (brands|length) > 1 %}
                                <tr>
                                    <th>{{ phrase('agent.general.brand') }}</th>
                                    <td>
                                        <select class="dp-select-widget-simple brand_id" name="category[brand_id]" id="publish_brand_id" style="width: 100%" {% if not perms.can_edit %} disabled="disabled" {% endif %}>
                                            {% for brand in brands %}
                                                <option value="{{ brand.id }}" {% if guide.brand_id == brand.id %}selected="selected"{% endif %}>
                                                    {{ brand.name }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </td>
                                </tr>
                            {% endif %}
                                </tbody>
                            </table>
                        </div>
                    </article>
                </section>

                <section class="pane-section last noedit-hide">
                    <header><h1>{{ phrase('agent.publish.reorder_guide_title') }}</h1></header>
                    <article>
                        <div style="padding: 10px;" id="{{ tplvars.baseId }}_cattree" data-treedata="{{ cat_structure_data|json_encode }}"></div>
                        <input type="hidden" id="{{ tplvars.baseId }}_cattree_struct" name="category_structure" value="" />
                    </article>
                </section>

                <footer class="pane-footer noedit-hide" id="{{ tplvars.baseId }}_guidefoot">
                    <div class="dp-not-loading">
                        <button class="dp-btn guide-save-trigger" data-save-url="{{ path('agent_publish_savecats', {type: 'topics'}) }}">{{ phrase('agent.general.save') }}</button>
                    </div>
                    <div class="dp-is-loading">
                        <i class="spinner-flat"></i>
                    </div>
                </footer>
            </div>
        </div>
    {% endif %}
{% endblock pane_content %}
