{% extends 'AgentBundle:Common:display-options-layout.html.twig' %}
{% block other_options %}
	<ul class="order-by-menu">
		<li>
			<input type="checkbox" id="guide_unpublished" name="unpublished" {% if 'unpublished' in display_fields %}checked="checked"{% endif %} />
			<label for="guide_unpublished">Display unpublished topics</label>
		</li>
		<li>
			<input type="checkbox" id="guide_archived" name="archived" {% if 'archived' in display_fields %}checked="checked"{% endif %} />
			<label for="guide_archived">Display archived topics</label>
		</li>
		<li>
			<input type="checkbox" id="guide_draft" name="draft" {% if 'draft' in display_fields %}checked="checked"{% endif %} />
			<label for="guide_draft">Display topic drafts</label>
		</li>
	</ul>
{% endblock %}
