{% extends 'AgentBundle::list-pane-layout.html.twig' %}
{% set baseId = el_uid() %}

{######################################################################################################################}
{# METADATA #}
{######################################################################################################################}

{% block top %}
	<script>
	pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.OrganizationList';

	pageMeta.refreshUrl = '{{ path('agent_orgsearch_customfilter') }}?cache_id={{cache_id}}';
	pageMeta.saveListPrefsUrl = '{{ path('agent_ajax_save_prefs') }}';
	pageMeta.fetchResultsUrl = '{{ path('agent_orgsearch_getpage') }}';
	pageMeta.baseId = '{{ baseId }}';

	pageMeta.resultId = {{cache_id}};
	pageMeta.perPage = {{ per_page }};
	pageMeta.orgResultIds = {{ org_ids|json_encode|raw }};
	pageMeta.url_fragment = '{{ url_fragment('agent_orgsearch_customfilter') }}';

    pageMeta.page = {{ page }};
    pageMeta.organizations = {{ organizations_json|raw }};
    pageMeta.displayFields = {{ display_fields|json_encode|raw }};
	</script>
{% endblock top %}

{######################################################################################################################}
{# HEADER #}
{######################################################################################################################}

{% block pane_header %}
	<h1><i class="fa icon-dp-organization"></i> {{ phrase('agent.organizations.list_title', {count: org_ids|length|default(0)}) }}</h1>
{% endblock pane_header %}

{######################################################################################################################}
{# CONTENT #}
{######################################################################################################################}

{% block pane_content_header %}
    {% include 'AgentBundle:OrganizationSearch:filter-display-options.html.twig' %}
    {% include 'AgentBundle:OrganizationSearch:filter-control-bar.html.twig' %}
{% endblock %}

{% block pane_content %}

    <div ng-show="organizations.length">

		<section class="downloads-simple-list list-listing no-check">

            <div ng-if="'list' === listType">
                {% include 'AgentBundle:OrganizationSearch:filter-page.html.twig' %}
            </div>

            <div class="table-result-list"
                 ng-if="'table' === listType"
                    >
                <table cellspacing="0" width="100%">

                    {% include 'AgentBundle:OrganizationSearch:filter-table-head.html.twig' %}

                    <tbody>
                    <tr
                            ng-repeat="org in organizations"
                            class="row-item org org-{{ ng_var('org.id')}} downloads-{{ ng_var('org.id')}}"
                            data-route="page:{{ path('agent_org_view', {'organization_id': '0000'})|replace({'0000': ng_var('org.id')})|raw }}"
                            data-route-title="@selector(a.row-title)"
                            data-route-openclass="open"
                            >
                        {% include 'AgentBundle:OrganizationSearch:filter-table-row.html.twig' %}
                    </tr>
                    </tbody>

                </table>
            </div>

		</section>

        {% include 'AgentBundle::list-pane-nav.html.twig' with {
            listName: 'organizations',
            page: page,
            perPage: per_page,
	        total: org_ids|length,
	        ids: org_ids,
            displayFields: display_fields,
            url: path('agent_orgsearch_getpage')
        } only %}
	</div>

    <section class="list-listing no-results" ng-show="!organizations.length">
        <article class="row-item no-results">
            <p style="padding: 15px;">{{ phrase('agent.general.there_are_no_results') }}</p>
        </article>
    </section>

{% endblock pane_content %}
