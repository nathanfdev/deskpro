{% extends 'AgentBundle::list-pane-layout.html.twig' %}
{% set tplvars = { baseId: el_uid() } %}

{######################################################################################################################}
{# METADATA #}
{######################################################################################################################}
{% block top %}
	<script>
		pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.KbPendingReviewArticles';
    pageMeta.url_fragment = '{{ url_fragment('agent_public_pending_review') }}';
	</script>

{% endblock top %}

{######################################################################################################################}
{# HEADER #}
{######################################################################################################################}

{% block pane_header %}
	<h1><i class="far icon-dp-article"></i> {{ phrase('agent.publish.kb_list_title', {count: articles|length|default(0)}) }}</h1>
{% endblock pane_header %}

{######################################################################################################################}
{# CONTENT #}
{######################################################################################################################}

{% block pane_content %}

	{% include 'AgentBundle:Publish:kb-pending-review-massactions-bar.html.twig' %}

	<section class="comments-list list-listing">
		{% include 'AgentBundle:Publish:kb-pending-review-page.html.twig' %}
	</section>

{% endblock pane_content %}
