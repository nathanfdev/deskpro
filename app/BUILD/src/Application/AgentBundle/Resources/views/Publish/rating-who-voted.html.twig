<div class="alert-overlay mass-actions-overlay" style="width: 750px; height: 600px; overflow: auto;">
	<div class="overlay-title">
		<span class="close-trigger"></span>
		<h4>
      {{ phrase('agent.publish.who_voted') }}
		</h4>
	</div>
	<div class="overlay-content">
		<div style="border: 1px solid #ccc; border-radius: 4px; overflow: hidden;">
			<table cellspacing="0" cellpadding="0" width="100%" class="data-display-table with-head">
				<tbody>
					<tr>
						<th class="col-head">{{ phrase('agent.general.user') }}</th>
            {% if object_type != 'feedback' %}
              <th class="col-head">{{ phrase('agent.general.rating') }}</th>
            {% endif %}
						<th class="col-head" width="60">{{ phrase('agent.general.when') }}</th>
					</tr>
					{% for rating in ratings %}
            <tr class="line-2">
              <td>
                {% if rating.person %}
                  {{ rating.person.display_name }}
                  {% if rating.person.primary_email_address %}
                    &lt;{{ rating.person.primary_email_address }}&gt;
                  {% endif %}
                {% else %}
                  {% if rating.name %}
                    {{ rating.name }}
                  {% else %}
                    {{ phrase('agent.general.anonymous') }}
                  {% endif %}
                  {% if rating.email %}
                    &lt;{{ rating.email }}&gt;
                  {% endif %}
                {% endif %}
                {% if rating.ip_address %}from {{ rating.ip_address }}{% endif %}
              </td>
              {% if object_type != 'feedback' %}
                <td>
                  {% if rating.rating >= 1 %}
                    {{ phrase('agent.publish.helpful') }}
                  {% else %}
                    {{ phrase('agent.publish.not_helpful') }}
                  {% endif %}
                </td>
              {% endif %}
              <td>
                {{ rating.date_created|date('day') }}
              </td>
            </tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
</div>