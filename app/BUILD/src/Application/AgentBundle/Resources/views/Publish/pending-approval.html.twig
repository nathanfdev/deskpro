{% extends 'AgentBundle:Publish:drafts.html.twig' %}
{% set tplvars = { baseId: el_uid() } %}

{######################################################################################################################}
{# METADATA #}
{######################################################################################################################}
{% block top %}
	<script>
		pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.PublishDraftsList';
		pageMeta.url_fragment = '{{ url_fragment('agent_public_pending_approval') }}';
	</script>
{% endblock top %}

{######################################################################################################################}
{# HEADER #}
{######################################################################################################################}

{% block pane_header %}
	<h1><i class="fa icon-dp-article"></i> {{ phrase('agent.publish.pending_approval_list_title', {count: drafts|length|default(0)}) }}</h1>
{% endblock pane_header %}

{######################################################################################################################}
{# CONTENT #}
{######################################################################################################################}

{% block pane_content %}

	{% include 'AgentBundle:Publish:drafts-massactions-bar.html.twig' %}

	<section class="comments-list list-listing">
		{% include 'AgentBundle:Publish:drafts-page.html.twig' %}
	</section>

{% endblock pane_content %}
