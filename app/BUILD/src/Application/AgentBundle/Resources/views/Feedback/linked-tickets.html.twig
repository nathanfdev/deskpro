<table cellspacing="0" cellpadding="0" width="100%" class="field-holders-table th-la sla-table linked-tickets-table">
	<tbody>
    {% for tfl in ticket_feedback_links %}
      <tr class="ticket_row">
        <td>
          <div class="fade-container">
            <div class="line">
              <a data-route="ticket:{{ path('agent_ticket_view', {'ticket_id': tfl.ticket.id}) }}" data-route-title="@text">
                <span class="id-number">#{{ tfl.ticket.id }}</span>
                {{tfl.ticket.subject}}
              </a>
            </div>
            <div class="bound-fade"></div>
          </div>
        </td>
        <td {% if not tfl.ticket.agent %}colspan="2"{% endif %}>
          <div class="status-pill status urgency-{{ tfl.ticket.urgency }} {{ tfl.ticket.status_code|replace({'.': '_'}) }}" style="float: right; position: relative; top: 0px;">
            <label>{{ phrase('agent.tickets.status_' ~ tfl.ticket.status_code|replace({'.': '_'})) }}</label>
            {% if tfl.ticket.status == 'awaiting_agent' %}<i class="ticket-urgency" data-urgency="{{ tfl.ticket.urgency }}">{{ tfl.ticket.urgency }}</i>{% endif %}
          </div>
        </td>
        {% if tfl.ticket.agent %}
          <td width="16" style="width: 16px; padding:0; padding-right: 4px;">
            <span
              class="tipped"
              title="{{ tfl.ticket.agent.display_name }}"
              style="background: url('{{ tfl.ticket.agent.getPictureUrl(16) }}') no-repeat 0 50%; height: 16px; width: 16px; overflow: hidden; display: block;"
              ></span>
          </td>
        {% endif %}
        <td width="10" style="text-align: right;">
          <img src="{{ asset('images/agent/icons/cross.png') }}" style="cursor: pointer;" class="unlink-ticket" data-ticket-id="{{ tfl.ticket.id }}" data-id="{{ tfl.id }}" />
        </td>
      </tr>
    {% endfor %}
	</tbody>
</table>
