{% for f in custom_fields %}
	<dt class="type-labels" ng-non-bindable>{{ f.title }}</dt>
	<dd ng-non-bindable>
		{{ render_custom_field_form(f) }}
	</dd>
{% endfor %}

{% for f in custom_fields_definitions %}
    <dt class="type-labels" ng-non-bindable>{{ form_label(f) }}</dt>
    <dd>
        {{ form_widget(f) }}
    </dd>
{% endfor %}
