{{ dp_app_loc(baseId, 'right_col.top') }}

{# Box Contact #}
{{ dp_app_loc(baseId, 'contact.before') }}
<div data-deskproapp="org-contact-before"></div>

<div class="profile-box-container contact">
    <header>
        {% if app.user.hasPerm('agent_org.edit') %}
            <span class="edit-gear contact-edit"></span>
        {% endif %}
        <nav data-element-handler="DeskPRO.ElementHandler.SimpleTabs">
            <ul>
                <li data-tab-for="#{{ baseId }}_contact_body">{{ phrase('agent.people.contact_info') }}</li>
            </ul>
        </nav>
    </header>
    <section>
        <div id="{{ baseId }}_contact_body">
            <div class="table-content contact-list contact-list-wrapper">
                {% include 'AgentBundle:Organization:view-contact-display.html.twig' %}
            </div>
        </div>
        {{ dp_widget_tabs(baseId, 'organization', 'contact', 'section', org_api) }}
    </section>
</div>
{{ dp_app_loc(baseId, 'contact.after') }}
<div data-deskproapp="org-contact-after"></div>
{# /Box Contact #}

{# Properties Box #}
{{ dp_app_loc(baseId, 'properties.before') }}
<div data-deskproapp="org-properties-before"></div>
<div class="profile-box-container properties" id="{{ baseId }}_properties_box">
    <header>
        {% if app.user.hasPerm('agent_org.edit') %}
            <div class="controls">
                <span class="edit-gear prop-edit-trigger"></span>
                <div class="is-loading">{{ phrase('agent.general.saving') }}</div>
                <button class="cancel" style="display: none">{{ phrase('agent.general.cancel') }}</button>
                <button class="save" style="display: none">{{ phrase('agent.general.save') }}</button>
            </div>
        {% endif %}
        <nav data-element-handler="DeskPRO.ElementHandler.SimpleTabs">
            <ul>
                <li data-tab-for="#{{ baseId }}_properties_body">{{ phrase('agent.general.properties') }}</li>
            </ul>
        </nav>
    </header>
    <section>
        <div id="{{ baseId }}_properties_body">
            {{ dp_app_loc(baseId, 'properties.body.before') }}

            <dl class="table-list" id="{{ baseId }}_custom_fields_rendered">
                {% include 'AgentBundle:Organization:view-customfields-rendered-rows.html.twig' %}
            </dl>
            <dl class="table-list" id="{{ baseId }}_custom_fields_editable" style="display: none">
                {% include 'AgentBundle:Organization:view-customfields-edit-rows.html.twig' %}
            </dl>

            <div>
                <dl class="table-list">
                    <dt class="type-labels">{{ phrase('agent.general.date_created') }}</dt>
                    <dd>
                        <time
                            {% if not app.isRelativeTimesDisabled() %}class="timeago"{% endif %}
                            datetime="{{ org.date_created|date('c', 'UTC') }}"
                        >
                            {{ org.date_created|date('fulltime') }}
                        </time>
                    </dd>
                </dl>
                <br class="clear" />
            </div>

            {{ dp_app_loc(baseId, 'properties.body.after') }}
        </div>
    </section>
    {{ dp_app_loc(baseId, 'properties.tab') }}
</div>
{{ dp_app_loc(baseId, 'properties.after') }}
<div data-deskproapp="org-properties-after"></div>
{# /Properties Box #}

{# Email Associations Box #}
{{ dp_app_loc(baseId, 'email_assoc.before') }}
<div data-deskproapp="org-email-assoc-before"></div>

<div id="{{ baseId }}_email_assoc_box">
    {% include 'AgentBundle:Organization:orgemail-display.html.twig' %}
</div>
{{ dp_app_loc(baseId, 'email_assoc.after') }}
<div data-deskproapp="org-email-assoc-after"></div>

{# Usergroup Box #}
{% if app.usergroups.getUserUsergroups() %}
    {{ dp_app_loc(baseId, 'usergroups.before') }}
    <div data-deskproapp="org-usergroups-before"></div>

    <div class="profile-box-container summary {% if org.getUsergroups()|length < 1 %}no-section{% endif %}"
         id="{{ baseId }}_ug_box">
        <header>
            {% if app.user.hasPerm('agent_org.edit') %}
                <div class="controls">
                    <span class="edit-gear edit-trigger"></span>
                    <div class="is-loading">{{ phrase('agent.general.saving') }}</div>
                    <button class="cancel cancel-trigger"
                            style="display: none">{{ phrase('agent.general.cancel') }}</button>
                    <button class="save save-trigger" style="display: none">{{ phrase('agent.general.save') }}</button>
                </div>
            {% endif %}
            <nav data-element-handler="DeskPRO.ElementHandler.SimpleTabs">
                <ul>
                    <li data-tab-for="#{{ baseId }}_usergroups_body">{{ phrase('agent.general.usergroups') }}</li>
                </ul>
            </nav>
        </header>
        <section>
            <div id="{{ baseId }}_usergroups_body"
                 {% if org.getUsergroups()|length < 1 %}style="display:none"{% endif %}>
                <div id="{{ baseId }}_ug_display_box" class="contact-list">
                    <ul>
                        {% for id,usergroup in app.usergroups.getUserUsergroups()
                        if usergroup.sys_name != 'registered' and usergroup.sys_name != 'everyone' %}
                            <li
                                  class="ug-row ug-row-{{ id }}"
                                  {% if not org.usergroups[id] %}style="display: none"{% endif %}>
                                {{ usergroup.title }}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
                <div id="{{ baseId }}_ug_edit_box" class="contact-list" style="display: none;">
                    <ul>
                        {% for id,usergroup in app.usergroups.getUserUsergroups()
                        if usergroup.sys_name != 'registered' and usergroup.sys_name != 'everyone' %}
                            <div>
                                <label>
                                    <input
                                          type="checkbox"
                                          value="{{ id }}"
                                          name="usergroup_ids[]"
                                          class="ug-check ug-check-{{ id }}"
                                          {% if org.usergroups[id] %}checked="checked"{% endif %}
                                    />
                                    {{ usergroup.title }}
                                </label>
                            </div>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </section>
        {{ dp_app_loc(baseId, 'usergroups.tab') }}
    </div>
    {{ dp_app_loc(baseId, 'usergroups.after') }}
    <div data-deskproapp="org-usergroups-after"></div>
{% endif %}
{# /Usergroup Box #}

<div data-deskproapp="org-hierarchy-before"></div>
<div class="profile-box-container summary" id="{{ baseId }}_hierarchy_box">
    <header>
        <nav data-element-handler="DeskPRO.ElementHandler.SimpleTabs">
            <ul>
                <li>{{ phrase('agent.general.hierarchy') }}</li>
            </ul>
        </nav>
    </header>
    <section>

        <ul>
            <li style="padding: 6px 10px;">
                {{ phrase('agent.general.parent') }}:
                {% if org.parent %}
                    <a href="#" data-route="page:{{ path('agent_org_view', {'organization_id': org.parent.id}) }}">
                        {{ org.parent.name }}
                    </a>
                {% else %}
                    {{ phrase('agent.general.none') }}
                {% endif %}
            </li>
            <li style="padding: 6px 10px; border-top: 1px solid #CAD0D7" ng-show="children && children.length">
                {{ phrase('agent.general.children') }}:
                <ul id="{{ baseId }}_children-list" style="margin-left:10px;">
                    <li ng-repeat="child in children">
                        <i class="fa fa-caret-right" style="font-size: 90%;"></i>
                        <a href="#"
                           data-route="page:{{ path('agent_org_view', {'organization_id': '0000'})|replace({'0000': ng_var('child.id')}) }}">
                            {{ ng_var('child.name') }}
                        </a>
                        <a class="remove-child" ng-click="removeChild(child)" style="color:#999; font-size: 80%"
                           title="{{ phrase('agent.general.remove_association') }}"><i class="fa fa-times"></i></a>
                    </li>
                </ul>
            </li>
            <li style="padding: 6px 10px; border-top: 1px solid #CAD0D7">
                {{ phrase('agent.general.add_child') }}:

                <div style="position: relative; height: 25px; display: inline-block;">

                    <input type="text" ng-model="searchChildTitle"
                           placeholder="{{ phrase('agent.general.find') }}{% if app.user.hasPerm('agent_org.create') %}/{{ phrase('agent.general.add')|lower }}{% endif %} {{ phrase('agent.general.organization')|lower }}" />

                    <div class="person-search-box org" style="position: absolute; top: 25px; min-width: 155px;"
                         ng-show="searchChildrenResults.length || searchChildTitle">
                        <section>
                            <ul class="results-list">
                                <li ng-repeat="result in searchChildrenResults">
                                    <a ng-click="addChild(result)" ng-if="!result.parent_id && result.id != root_id">
										<span class="org-name">
											{{ ng_var('result.name') }}
										</span>
                                    </a>
                                    <a>
										<span class="org-name" style="color: gray;"
                                              ng-if="result.parent_id || result.id == root_id">
											{{ ng_var('result.name') }}
										</span>
                                        <div dp-sticky-tip offset-top="24">
                                            <article ng-if="root_id == result.id">
                                                {{ phrase('agent.organizations.already_grandparent', {'name':org.name}) }}
                                            </article>
                                            <article ng-if="result.parent_id">
                                                {{ phrase('agent.organizations.already_child', {'name':ng_var('result.parent_name')}) }}
                                            </article>
                                        </div>
                                    </a>
                                </li>
                            </ul>
                            {% if app.user.hasPerm('agent_org.create') %}
                                <footer ng-show="showCreateChild" ng-click="addChild()">
									<span class="create-org">
										{{ phrase('agent.general.create') }}:
										<em>
											{{ ng_var('searchChildTitle') }}
										</em>
									</span>
                                </footer>
                            {% endif %}
                        </section>
                    </div>
                </div>
            </li>
        </ul>

    </section>
    {{ dp_app_loc(baseId, 'usergroups.tab') }}
</div>
<div data-deskproapp="org-hierarchy-after"></div>

{{ dp_app_loc(baseId, 'right_col.bottom') }}
