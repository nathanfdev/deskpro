<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.NewOrganization';
pageMeta.title = '{{ phrase('agent.general.new_organization') }}';

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
<div class="layout-content page-new-content page-new-org">
<div class="dp-page-content">
{{ start_counter('steps') }}

<a class="tab-anchor" href="#">&nbsp;</a>

<form id="{{baseId}}_neworg" class="keybound-submit">
	<script class="template-upload" type="text/x-tmpl">
		{{ '{% for (var i=0, file; file=o.files[i]; i++) { %}' }}
		<p>{{ '{%=file.name%}' }} ({{ phrase('agent.general.saving') }})</p>
		{{ '{% } %}' }}
	</script>
	<script class="template-download" type="text/x-tmpl">
		<div style="display:none"></div>
	</script>

<div class="first section cat-section" id="{{baseId}}_cat_section">
	<div class="content">
		<h4>{{ phrase('agent.general.name') }}</h4>
		<input type="text" class="fill" name="neworg[name]" id="{{baseId}}_name" value="" />
	</div>
</div>

{% if custom_fields|length %}
<div class="section title-section" id="{{baseId}}_fields_section">
	<div class="content">
        {% for f in custom_fields %}
        	<h4>{{ f.title }}</h4>
        	{{ render_custom_field_form(f) }}
        	<br />
        {% endfor %}
	</div>
</div>
{% endif %}

<div class="section other-section" id="{{baseId}}_other_section">
	<div class="content">
		{# Tab Container #}
		<div class="tab-container">
			<nav id="{{baseId}}_other_props_tabs_wrap">
				<ul id="{{baseId}}_other_props_tabs">
					<li class="on" data-tab-for="> .tab-properties">{{ phrase('agent.general.properties') }}</li>
				</ul>
			</nav>
			<div class="content-wrapper" id="{{baseId}}_other_props_tabs_content" style="display: none">
				{# Tab Properties #}
				<div class="tab-properties">
					<table cellspacing="0" cellpadding="0" width="100%" class="field-holders-table">
						<tr class="labels-input-row">
							<th width="150">{{ phrase('agent.general.labels') }}</th>
							<td>
								<input
										type="hidden"
										id="{{ baseId }}_labels_input"
										class="labels-input dpe_select dpe_select_noborder"
										data-select-width="auto"
										data-placeholder="{{ phrase('agent.general.add_a_label') }}"
										data-allow-new="{% if app.user.hasPerm('agent_people.create_labels') %}1{% endif %}"
								/>
							</td>
						</tr>
					</table>
				</div>
				{# /Tab Properties #}
			</div>
		</div>
		{# /Tab Container #}
	</div>
</div>

<footer class="pop-footer">
	<div class="is-not-loading">
		<button class="submit-trigger clean-white">{{ phrase('agent.organizations.create_organization') }} <kbd class="noshowmac">{{ phrase('agent.general.altc') }}</kbd><kbd class="showmac">{{ phrase('agent.general.ctrlc') }}</kbd></button>
	</div>
	<div class="is-loading" style="padding-top: 9px;">
		<img src="{{ asset('images/spinners/loading-small.gif') }}" />
	</div>
</footer>

</form>

</div>
</div>
