<div class="list-pane-instance ng-hide" ng-show="true">
	<div class="list-pane-header">
		<h1><div><i class="icon-dp-ticket"></i> {{ ng_bind('ticketCount') }} {{ phrase('agent.general.tickets') }}</div></h1>
	</div>
	<div class="list-pane-content list-pane-view with-header with-subheader with-footer" ng-class="{'with-alert-subheader': hasUnloadedUpdates}">
		<header class="view-header">
			<div ng-non-bindable>{% include 'AgentBundle:TicketSearch:filter-display-options-overlay.html.twig' %}</div>
			{% include 'AgentBundle:TicketSearch:filter-control-bar.html.twig' %}
		</header>
		<header class="view-subheader">
			<header class="list-selection-bar">
				<input class="selection-control" type="checkbox" ng-model="checkedTicketsToggle" />
				{{ phrase('agent.general.x_selected', {'num_placeholder': '{{ checkedTicketsCount }}'}, true) }}

				<span ng-show="!paneVis.tabs && checkedTicketsCount > 0">
					&mdash;
					<a class="clean-white" ng-click="openMassActions()">{{ phrase('agent.general.perform_mass_actions') }}</a>
				</span>

				<div class="realtime-indicator half-realtime" ng-show="halfrealtime && massActionsOpen">
					<em>{{ phrase('agent.tickets.real_time_updates_limited') }}</em>
					<div dp-sticky-tip offset-top="18" right-align>
						<article>
							<div class="content-text" style="max-width: 200px;">
              {{ phrase('agent.tickets.real_time_updates_limited_desc_1') }}
								<br/><br/>
								{{ phrase('agent.tickets.real_time_updates_limited_desc_2') }}
							</div>
						</article>
					</div>
				</div>
				<div class="realtime-indicator" ng-class="{'realtime-on': realtime}" ng-hide="halfrealtime || massActionsOpen">
					<span class="status" ng-click="toggleRealtimeUpdates();">
						<div ng-show="realtime">
							<em>{{ phrase('agent.tickets.real_time_updates') }}</em>
							<i class="icon-retweet"></i>
							<div dp-sticky-tip offset-top="25" right-align>
								<article>
									<div class="content-text">
										{{ phrase('agent.tickets.real_time_updates_description') }}
									</div>
								</article>
							</div>
						</div>
						<div ng-show="!realtime">
							<em>{{ phrase('agent.tickets.real_time_updates_disabled') }}</em>
							<i class="icon-retweet"></i>
							<div dp-sticky-tip offset-top="25" right-align>
								<article>
									<div class="content-text">
                    {{ phrase('agent.tickets.real_time_updates_disabled_desc') }}
									</div>
								</article>
							</div>
						</div>
					</span>
				</div>

                {% include 'AgentBundle:TicketSearch:filter-massactions-overlay-frame.html.twig' %}
			</header>
		</header>
		<header class="view-alert-subheader hidden">
			{{ phrase('agent.tickets.real_time_updates_new_updates') }}
			<button class="clean-white" ng-click="refreshCursor();">
				<span ng-hide="refreshCursorLoading">{{ phrase('agent.tickets.real_time_updates_refresh') }}</span>
				<span ng-show="refreshCursorLoading"><i class="spinner-flat"></i></span>
			</button>
		</header>
		<article class="view-body">
			<div style="padding: 20px; text-align: center;" ng-show="refreshCursorLoading">
				<i class="spinner-circle-32"></i>
			</div>

			<section class="list-listing" ng-hide="refreshCursorLoading" ng-class="{'list-animation': isLoaded && !pauseListAnim}">

				{% include 'AgentBundle:TicketSearch:filter-grouping-bar.html.twig' %}

                <div
                    ng-if="listType == 'list'"
					bindonce
					ng-repeat="ticket in tickets track by ticket.id"
					dp-removed="uncheckTicketId(ticket.id)"
				>
					<script type="text/plain" dp-tpl tpl-id="ticket_list_row" watch-vars="['ticket', 'ticket.version_id']" watch-vars-deep="['display_fields']">
						{% include 'AgentBundle:TicketSearch:ticket-list-row.html.twig' %}
					</script>
				</div>

                <div ng-if="listType == 'table'" class="table-result-list">
                    <table cellspacing="0" width="100%" dp-settable-table>
						<script type="text/plain" dp-tpl="thead" tpl-id="ticket_list_thead" watch-vars-deep="['display_fields']">
                        	{% include 'AgentBundle:TicketSearch:ticket-list-table-head.html.twig' %}
                        </script>

                        <tbody
							bindonce
							class="row-item ticket-row-{{ ng_var('ticket.id') }} sla-status-{{ ng_var('ticket.worst_sla_status') }}"
							ng-repeat="ticket in tickets track by ticket.id"
							dp-removed="uncheckTicketId(ticket.id)"
							data-ticket-id="{{ ng_var('ticket.id') }}"
							data-route="ticket:{{ path('agent_ticket_view', {'ticket_id': '0000'})|replace({'0000': '{{ ticket.id }}'})|raw }}"
							data-route-title="@selector(a.subject)"
							data-route-openclass="open"
							ng-class="{'open': openTickets[ticket.id]}"
						>
							<script type="text/plain" dp-tpl="tr" tpl-id="ticket_list_tr_row" watch-vars="['ticket', 'ticket.version_id']" watch-vars-deep="['display_fields']">
								{% include 'AgentBundle:TicketSearch:ticket-list-table-row.html.twig' %}
							</script>
                        </tbody>

                    </table>
                </div>
			</section>

		</article>
		<footer class="view-footer results-nav">
			<div class="cursor">
				{% set phrase_part1 %}
					{{ ng_bind('pageCursorStart') }} - {{ ng_bind('pageCursorEnd') }}
				{% endset %}
				{% set phrase_part2 %}
					{{ ng_bind('ticketCount') }}
				{% endset %}
				{{ phrase('agent.general.showing_results_x_of_y', {'display_count':phrase_part1,'size':phrase_part2}, true) }}
                {% if filter %}
                    {% set refresh_url %}{{ path('agent_ticketsearch_runfilter', {'filter_id': filter_id}) }}?set_group_term={{ set_group_term }}&set_group_option={{ set_group_option }}&view_name={{ view_name }}{% endset %}
                {% elseif sla_id %}
                    {% set refresh_url %}{{ path('agent_ticketsearch_runsla', {'sla_id': sla_id}) }}?set_group_term={{ set_group_term }}&set_group_option={{ set_group_option }}&view_name={{ view_name }}{% endset %}
                {% else %}
                    {% set refresh_url %}{{ path('agent_ticketsearch_runcustomfilter', {'cache_id': cache_id}) }}?set_group_term={{ set_group_term }}&set_group_option={{ set_group_option }}&view_name={{ view_name }}{% endset %}
                {% endif %}
                <a ng-if="listType == 'table'" title="{{ phrase('agent.tickets.export_to_csv') }}" target="_blank" href="{{ refresh_url }}&view_type=csv&_rt={{ security_token('request_token', 10800) }}">
                    <button class="clean-white">
                        <i class="fa fa-file-excel-o"></i>
                    </button>
                </a>
			</div>
			<ul class="pagenav" ng-class="{'no-prev': !hasPrevPage, 'no-next': !hasNextPage}">
				<li class="prev" ng-click="loadPrevCursorPage();"></li>
				<li class="next" ng-click="loadNextCursorPage();"></li>
			</ul>
		</footer>
	</div>
</div>
