<li
	class="inside feedback feedback-row-{{ topic.id }}"
	data-class-id="feedback-row-{{ ticket.id }}"
	data-type="community"
	data-route="page:{{ path('agent_community_topic_view', {'communityTopicId': topic.id}) }}"
	data-route-notabreload="1"
>
	<div class="dismiss"><i class="fas fa-ban"></i></div>
	<time></time>
	<big>{{ topic.title }}</big>
	<small>
		{{ phrase('agent.publish.new_community_topic_by', {name: topic.person.getDisplayContact()}) }}
	</small>
</li>
