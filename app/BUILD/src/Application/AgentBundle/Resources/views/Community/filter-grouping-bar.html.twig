{% if grouped and grouped.items[-1].total %}
	<header class="list-grouping-bar">
		<ul>
			<li class="{% if not subgroup %}on{% endif %}">
				<a data-route="listpane:{{ tplvars.subgroup_url|replace({'SUBGROUP_ID': ''}) }}">
					{{ phrase('agent.general.all') }}
					<span class="count">{{ grouped.items[-1].total }}</span>
				</a>
			</li>
			{% for channel in grouped.items %}
				{% if channel.id != '-1' %}
					<li class="{% if subgroup == channel.id %}on{% endif %}">
						<a data-route="listpane:{{ tplvars.subgroup_url|replace({'SUBGROUP_ID': channel.id}) }}">
							{{ channel.title }}
							<span class="count">{{ channel.total }}</span>
						</a>
					</li>
				{% endif %}
			{% endfor %}
		</ul>
		<br class="clear" />
	</header>
{% endif %}
