{% if grouped and grouped.items[-1].total %}
	<header class="list-grouping-bar">
		<ul>
			<li class="{% if not subgroup %}on{% endif %}">
				<a data-route="listpane:{{ tplvars.subgroup_url|replace({'SUBGROUP_ID': ''}) }}">
					{{ phrase('agent.general.all') }}
					<span class="count">{{ grouped.items[-1].total }}</span>
				</a>
			</li>
			{% for forum in grouped.items %}
				{% if forum.id != '-1' %}
					<li class="{% if subgroup == forum.id %}on{% endif %}">
						<a data-route="listpane:{{ tplvars.subgroup_url|replace({'SUBGROUP_ID': forum.id}) }}">
							{{ forum.title }}
							<span class="count">{{ forum.total }}</span>
						</a>
					</li>
				{% endif %}
			{% endfor %}
		</ul>
		<br class="clear" />
	</header>
{% endif %}
