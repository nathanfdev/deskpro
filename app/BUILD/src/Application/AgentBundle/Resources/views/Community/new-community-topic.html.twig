<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.NewCommunityTopic';
pageMeta.title = '{{ phrase('agent.general.new_community') }}';
pageMeta.uploadAttachUrl = '{{ path('agent_accept_upload') }}';
{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
<div class="layout-content page-new-community-topic page-new-content">
<div class="dp-page-content">

<a class="tab-anchor" href="#">&nbsp;</a>

<a class="tab-anchor" href="#">&nbsp;</a>

<div class="form-header-error" style="display: none">
	{{ phrase('agent.community.no_community_cats_error') }}
</div>
<div class="form-outer">

<form id="{{baseId}}_newcomunitytopic" class="keybound-submit">

<input type="hidden" name="newcommunitytopic[linked_ticket]" id="{{baseId}}_linked_ticket" value="{% if ticket %}{{ ticket.id }}{% endif %}" />

{% if ticket %}
  <div class="pending-info" id="{{baseId}}_linked_ticket_section">
    <div class="content">
      <div class="col">
        <h4>{{ phrase('agent.tickets.linking_with_ticket') }} {{ ticket.subject }}</h4>

        {% if brand_setting('user.community_subscriptions') %}
          <br class="clear" />
          <div style="display: block;">
            <input type="checkbox" id="{{baseId}}_is_subscribe_owner" name="newcommunitytopic[is_subscribe_ticket_owner]" checked="checked">
            <label for="{{baseId}}_is_subscribe_owner">{{ phrase('agent.tickets.link_existing_community_topic_subscr_owner', {'name': ticket.person.display_name, 'email': ticket.person.email_address}) }}</label>
          </div>
          <div style="display: block;">
            <input type="checkbox" id="{{baseId}}_is_subscribe_participants" name="newcommunitytopic[is_subscribe_ticket_participants]">
            <label for="{{baseId}}_is_subscribe_participants">{{ phrase('agent.tickets.link_existing_community_topic_subscr_part', {'count': ticket.participants.count}) }}</label>
          </div>
        {% else %}
          <input type="hidden" id="{{baseId}}_is_subscribe_owner" name="newcommunitytopic[is_subscribe_ticket_owner]">
          <input type="hidden" id="{{baseId}}_is_subscribe_participants" name="newcommunitytopic[is_subscribe_ticket_participants]">
        {% endif %}
      </div>
      <br class="clear" />
    </div>
  </div>
{% endif %}

<div class="{% if not ticket %}first{% endif %} section cat-section" id="{{baseId}}_cat_section">
	<div class="content">
        <div class="col">
            <h4>{{ phrase('agent.general.brand') }}</h4>
            <select name="newcommunitytopic[brand]" id="new_topic_brand_id">
                {% for brand in brands %}
                    <option value="{{ brand.id }}" {% if selected_brand_id == brand.id %}selected="selected"{% endif %}>
                        {{ brand.name }}
                    </option>
                {% endfor %}
            </select>
        </div>
		<div class="col">
			<h4>{{ phrase('agent.general.type') }}</h4>
			{% include 'AgentBundle:Common:select-standard.html.twig' with {
				'name': 'newcommunitytopic[category_id]',
				'id': baseId ~ '_cat',
				'add_classname': 'category_id',
				'add_attr': '',
				'categories': community_channels,
				'selected': state.newcommunitytopic.channel_id|default(0)
			} %}
			<div class="error-message category_id">{{ phrase('agent.general.choose_a_type') }}</div>
		</div>
		<div class="col">
			<h4 class="light">{{ phrase('agent.general.status') }}</h4>
			{% include 'AgentBundle:Common:select-community-topic-status.html.twig' with {'name': 'newcommunitytopic[status_code]', 'add_classname': 'status_id'} %}
		</div>
		<div class="col">
			<h4 class="light">{{ phrase('agent.general.labels') }}</h4>
      <div class="tags-wrap article-tags" style="width:250px">
        <input type="text"
               autocomplete="{{ "now" | date("U") }}"
               value="{% for label in state.newcommunitytopic.labels %}{{label.label}},{% endfor %}"
               data-allow-new="{{ app.user.hasPerm('agent_publish.articles_create_labels') ? 1 : 0 }}" />
      </div>
		</div>
		<div class="col">
			<h4 class="light">{{ phrase('agent.general.attachments') }}</h4>
      {% include 'AgentBundle:Common:attach-row-tmpl.html.twig' with {formname: 'newcommunitytopic[attach_ids][]'} %}
      <div class="file-input">
        <input type="file" name="file-upload" multiple="multiple" />
      </div>
      <ul class="files file-list">
        {% for attachment in attachments %}
          <li class="in" style="height: 18px;">
            <input type="hidden" name="newcommunitytopic[attach_ids][]" value="{{ attachment.blob.id }}">
            <em class="remove-attach-trigger"></em>
            <label><a href="{{ attachment.url }}" target="_blank">{{ attachment.blob.filename }}</a><span>&nbsp;{{ attachment.filesize_readable }}</span></label>
          </li>
        {% endfor %}
      </ul>
		</div>
    <br class="clear" />
	</div>
</div>

<div class="section user-section" id="{{baseId}}_user_section">
	<div class="content">
		<h4>{{ phrase('agent.general.user') }}</h4>
    <div id="{{baseId}}_choose_user" style="display: none">
      <div
        id="{{baseId}}_user_searchbox"
        data-element-handler="DeskPRO.Agent.ElementHandler.PersonSearchBox"
        data-search-url="{{ path('agent_peoplesearch_performquick', {'format': 'json', 'limit': 10, 'start_with': 'a', 'with_agents': 1}) }}"
        data-highlight-term="1"
        data-touch-focus="1"
        data-search-param="term"
        data-position-bound="#{{baseId}}_userselect"
      >
        <input type="text" name="person_input_choice"
               id="{{baseId}}_userselect"
               class="select-user term"
               autocomplete="{{ "now" | date("U") }}"
               placeholder="{{ phrase('agent.general.choose_person_for_community_topic') }}"
               style="width: 80%;" />
        <input type="hidden" name="newcommunitytopic[person][id]" value="{{ topic_person.id }}" class="person-id" id="{{baseId}}_person_id" />

        <script type="text/x-deskpro-tmpl" class="user-row-tpl">
          <li>
            <a>
            <span class="user-name"></span>
            <address>&lt;<span class="user-email"></span>&gt;</address>
            <div class="bound-fade"></div>
          </a></li>
        </script>
        <script type="text/x-deskpro-tmpl" class="user-selected-tpl">
          <a class="as-popover dp-btn dp-btn-small" data-route="">
            <span class="text">
              <span class="user-name"></span>
              (<span class="user-email"></span>)
            </span>
          </a>
        </script>
        <div class="person-search-box" style="display: none">
          <section>
            <ul class="results-list">

            </ul>
          </section>
        </div>
      </div>
    </div>
    <div>
      <span id="{{baseId}}_user_choice">
          <a class="as-popover dp-btn dp-btn-small" data-route="person:{{ path('agent_people_view', {'person_id': topic_person.id}) }}">
            <span class="text">
              <span class="user-name">{{topic_person.display_name}}</span>
              (<span class="user-email">{{topic_person.email}}</span>)
            </span>
          </a>
      </span>
      <a id="{{baseId}}_switch_user"><i class="fas fa-edit"></i></a>
    </div>
	</div>
</div>

<div class="section title-section" id="{{baseId}}_title_section">
	<div class="content">
		<h4>{{ phrase('agent.general.title') }}</h4>
		<input type="text"
               name="newcommunitytopic[title]"
               id="{{baseId}}_title"
               autocomplete="{{ "now" | date("U") }}"
               value="{% if ticket %}{{ ticket.subject }}{% else %}{{ state.newcommunitytopic.title }}{% endif %}"
               style="width: 80%;" />
		<div class="error-message title">{{ phrase('agent.general.enter_a_title') }}</div>
	</div>
</div>

<div class="section article-section" id="{{baseId}}_content_section">
	<div class="content" style="padding-right: 10px;">
		<h4>{{ phrase('agent.general.description') }}</h4>
		<textarea type="text"
                  name="newcommunitytopic[content]"
                  autocomplete="{{ "now" | date("U") }}"
                  id="{{baseId}}_content">
            {% if message %}{{message.getMessageHtml()}}{% else %}{{ state.newcommunitytopic.content }}{% endif %}
        </textarea>
        <div class="error-message content">{{ phrase('agent.general.enter_a_content') }}</div>
	</div>
</div>

<footer class="pop-footer">
	<div class="is-not-loading">
		<button class="submit-trigger clean-white">{{ phrase('agent.general.create_community') }} <kbd class="noshowmac">{{ phrase('agent.general.altc') }}</kbd><kbd class="showmac">{{ phrase('agent.general.ctrlc') }}</kbd></button>
	</div>
	<div class="is-loading" style="padding-top: 9px;">
		<img src="{{ asset('images/spinners/loading-small.gif') }}" />
	</div>
</footer>

</form>

</div>

</div>
</div>
