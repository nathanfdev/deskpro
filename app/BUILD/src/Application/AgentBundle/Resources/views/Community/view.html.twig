{% import 'AgentBundle:Common:optionbox-macros.html.twig' as optionbox %}
<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.CommunityTopicView';
pageMeta.title = {{topic.title|json_encode|raw}};
pageMeta.topic_id = {{topic.id}};
pageMeta.url_fragment  = '{{ url_fragment('agent_community_topic_view', {'communityTopicId': topic.id}) }}';
pageMeta.url  = '{{ path('agent_community_topic_view', {'communityTopicId': topic.id}) }}';
pageMeta.obj_code = 'community_{{ topic.id }}';

pageMeta.permalink = '{{ permalink }}';
pageMeta.labelsSaveUrl = '{{ path('agent_community_ajax_labels_save', {'communityTopicId': topic.id}) }}';

pageMeta.canEdit   = {% if not perms.can_edit %}false{% else %}true{% endif %};
pageMeta.canDelete = {% if not perms.can_delete %}false{% else %}true{% endif %};

{% if not topic.is_reviewed %}
pageMeta.isValidating = true;
{% endif %}

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
<div class="layout-content full-page page-community-topic-view {% if not perms.can_edit %}perm-no-edit{% endif %} {% if not perms.can_delete %}perm-no-delete{% endif %}">
<div class="dp-page-content">
<div class="delete-notice" {% if topic.status_code != "hidden.deleted" %}style="display: none;"{% endif %}>
	{{ phrase('agent.community.community_topic_deleted') }} <button class="clean-gray xxx-small undelete">{{ phrase('agent.general.undelete') }}</button>
</div>

<div class="spam-notice" {% if topic.status_code != "hidden.spam" %}style="display: none;"{% endif %}>
	{{ phrase('agent.general.record_marked_spam') }} <button class="clean-gray xxx-small unspam">{{ phrase('agent.community.status_closed') }}</button>
</div>

{% if not topic.is_reviewed %}
	{% include 'AgentBundle:Publish:view-approve-header.html.twig' %}
{% endif %}

<header class="page-header">
	<h4 class="id-number">#{{ topic.id }}</h4>
	<h1>
		<span id="{{baseId}}_showname">{{ topic.title }}</span>
		<span id="{{baseId}}_editname" style="display: none">
			<input type="text"
					name="name"
					autocomplete="{{ "now" | date("U") }}"
					value="{{ topic.title }}" />
		</span>
		<span id="{{baseId}}_editname_start" class="edit-name-gear"></span>
		<a id="{{baseId}}_editname_end" class="edit-name-save clean-white" style="display: none">{{ phrase('agent.general.done') }}</a>
	</h1>
	<div class="labels-line">
		<input
			type="hidden"
			id="{{baseId}}_labels_input"
			class="dpe_select dpe_select_noborder"
			data-select-width="auto"
			data-placeholder="{{ phrase('agent.general.add_a_label') }}"
			value="{% for label in topic.labels %}{{ label.label }},{% endfor %}"
			data-allow-new="{% if app.user.hasPerm('agent_publish.community_create_labels') %}1{% endif %}"
		/>
	</div>
	<br class="clear" />
	<div class="meta-line flat">
		<div style="float:left;position: relative;top:1px;">
			{% if not(topic.is_reviewed == 0 and topic.status == 'hidden') %}
				<select name="status" id="{{baseId}}_status">
					<optgroup label="{{ phrase('agent.community.status_active') }}">
						{% for cat in active_status_cats %}
							<option value="active.{{cat.id}}" {% if topic.status_code == 'active.' ~ cat.id %}selected="selected"{% endif %}>{{ cat.title }}</option>
						{% endfor %}
					</optgroup>
					<optgroup label="{{ phrase('agent.community.status_closed') }}">
						{% for cat in closed_status_cats %}
							<option value="closed.{{cat.id}}" {% if topic.status_code == 'closed.' ~ cat.id %}selected="selected"{% endif %}>{{ cat.title }}</option>
						{% endfor %}
					</optgroup>
				</select>
			{% endif %}
		</div>
		<div class="category" id="{{baseId}}_cat_trigger"><span>{{ phrase('agent.general.forum') }}: <span id="{{baseId}}_cat_label">{{ topic.forum.full_title }}</span></span></div>
	</div>
	<br class="clear" />
</header>

<div id="{{ baseId }}_header_profile_box" class="header-profile-box">
  <div class="profile-box-container dp-simpletab-container">
    <header id="{{ baseId }}_properties_header">
        <nav data-element-handler="DeskPRO.ElementHandler.SimpleTabs">
            <ul>
                <li data-tab-for="#{{ baseId }}_fields_display_main_wrap">{{ phrase('agent.general.properties') }}</li>
                {% if ticket_community_topics_links|length and app.user.hasPerm('agent_tickets.use') %}
                    <li data-tab-for="#{{ baseId }}_linked_tickets_wrap"><i
                          class="fas fa-link"></i> {{ phrase('agent.tickets.linked_tickets') }} (<span
                          id="{{ baseId }}_linked_tickets_count"
                          data-count="{{ ticket_community_topics_links|length }}">{{ ticket_community_topics_links|length }}</span>)
                    </li>
                {% endif %}
                  <li data-tab-for="#{{ baseId }}_subscribed_persons_wrap"><i
                        class="fas fa-link"></i> {{ phrase('agent.community.subscribed_users') }}
                        {% if subscribed_persons|length %}
                          (<span id="{{ baseId }}_subscribed_persons_count"
                                 data-count="{{ subscribed_persons|length }}">{{ subscribed_persons|length }}</span>)
                        {% endif %}
                  </li>
            </ul>
        </nav>
    </header>
    <section class="description-area">
      <article id="{{ baseId }}_fields_display_main_wrap" class="headerbox" style="position: relative;">
        <dl class="info-list">

          <dt>{{ phrase('agent.publish.slug') }}</dt>
          <dd>
            <span id="{{ baseId }}_slug">{{ topic.slug }}</span>
            <button class="clean-white" id="{{ baseId }}_editslug" data-prompt="{{ phrase('agent.publish.slug_edit_prompt') }}">
              {{ phrase('agent.publish.slug_edit') }}
            </button>
          </dd>

          <dt>{{ phrase('agent.general.votes') }}:</dt>
          <dd>
            <span class="link-look who-voted-trigger">
                        {% set phrase_part %}
                        <span id="{{baseId}}_num_votes">{{ topic.num_ratings }}</span>
                        {% endset %}
                        {{ phrase('agent.community.count_votes', {'display_count':phrase_part,'count':topic.num_ratings}, true) }}
                    </span>
          </dd>

          <dt>{{ phrase('agent.general.author') }}:</dt>
          <dd>
            {% for author in topic.authors %}
              <a class="as-popover dp-btn dp-btn-small" data-route="person:{{ path('agent_people_view', {'person_id': author.id}) }}">
                <span class="text" style="background: url({{ author.getPictureUrl(15) }}) no-repeat 0 50%; padding-left: 18px;">
                  {{ author.getNameWithTitle() }}
                  ({{ author.primary_email_address }})
                </span>
              </a>
            {% endfor %}
          </dd>
        </dl>

        {% if custom_fields|length %}
          <dl class="info-list" id="{{baseId}}_custom_fields_rendered">
            {% include 'AgentBundle:Community:view-customfields-rendered-rows.html.twig' %}
          </dl>
          <dl class="info-list" id="{{baseId}}_custom_fields_editable" style="display: none">
            {% include 'AgentBundle:Community:view-customfields-edit-rows.html.twig' %}
          </dl>
        {% endif %}

        <div class="controls" id="{{baseId}}_properties_controls">
          <div class="showing-editing-fields" style="display: none">
            <button class="clean-white save-fields-trigger"><span>{{ phrase('agent.general.save') }}</span></button>
          </div>
          <div class="showing-rendered-fields" id="{{baseId}}_action_buttons">
            {% if custom_fields|length %}
              <button class="clean-white edit-fields-trigger noedit-hide"><span>{{ phrase('agent.general.edit_properties') }}</span></button>
            {% endif %}
            <button class="clean-white delete delete-type nodelete-hide" {% if topic.status_code == "hidden.deleted" %}style="display:none"{% endif %}>{{ phrase('agent.general.delete') }}</button>
            <span class="merge menu-fitted noedit-hide" data-menu-button="> a"><a class="clean-white arrow">{{ phrase('agent.general.merge') }} <em></em></a></span>
            <button class="clean-white permalink" data-prompt="{{ phrase('agent.publish.permalink_copy_prompt') }}">
              {{ phrase('agent.general.copy_permalink') }}
            </button>
            <button class="clean-white view-user-interface">{{ phrase('agent.general.view_in_user_interface') }}</button>
          </div>
        </div>

        <ul id="{{baseId}}_merge_menu" style="display: none;">
          <li class="elm no-choice">{{ phrase('agent.community.merge_howto') }}</li>
        </ul>
      </article>
      {% if ticket_community_topics_links|length and app.user.hasPerm('agent_tickets.use') %}
        <article id="{{ baseId }}_linked_tickets_wrap">
            {% include 'AgentBundle:Community:linked-tickets.html.twig' %}
        </article>
      {% endif %}
      <article id="{{ baseId }}_subscribed_persons_wrap">
          {% include 'AgentBundle:Community:view-subscribed-persons.html.twig' %}
      </article>
    </section>
  </div>
</div>

<div class="profile-box-container reply-box-wrap">
	<header>
		<nav id="{{baseId}}_bodytabs">
			<ul>
				<li class="tab-trigger" data-tab-for="#{{baseId}}_content_tab">{{ phrase('agent.general.description') }}</li>
				<li class="tab-trigger" data-tab-for="#{{baseId}}_comments_tab">{{ phrase('agent.general.comments') }} (<span id="{{baseId}}_count_comments">{{topic_comments|length|default(0)}}</span>)</li>
				<li class="tab-trigger" data-tab-for="#{{baseId}}_revs">{{ phrase('agent.general.label_revisions') }} (<span id="{{baseId}}_count_revs">{{topic.revisions|length|default(0)}}</span>)</li>
				<li class="tab-trigger" data-tab-for="#{{baseId}}_related_content">{{ phrase('agent.general.related_content') }} (<span id="{{baseId}}_count_related">0</span>)</li>
				<li class="tab-trigger" data-tab-for="#{{baseId}}_searchtab">{{ phrase('agent.general.search') }}</li>
			</ul>
		</nav>
	</header>
	<section>

		{# Tab Contents #}
		<div id="{{baseId}}_tab_contents">
			{# Tab: Content #}
			<div id="{{baseId}}_content_tab" class="deskpro-tab-item content-tab on" style="display: block">
				<nav class="sub-box-nav noedit-hide">
					<ul class="option-buttons right" id="{{baseId}}_content_edit_btns">
						<li class="kb-editor-edit edit" id="{{baseId}}_edit_btn"><span>{{ phrase('agent.general.ucfirst_edit') }}</span></li>
						<li class="editor-save-trigger save" id="{{baseId}}_save_btn"><span>{{ phrase('agent.general.save') }}</span></li>
						<li class="editor-cancel-trigger cancel" id="{{baseId}}_cancel_btn"><span>{{ phrase('agent.general.cancel') }}</span></li>
					</ul>
				</nav>
				<div id="{{baseId}}_content_ed" class="content-tab-item">
				{% include 'AgentBundle:Community:view-content-tab.html.twig' %}
				</div>
			</div>
			{# /Tab: Content #}

			{# Tab: Comments #}
			<div id="{{baseId}}_comments_tab" class="deskpro-tab-item content-tab-item comments-tab">
				<div class="topic-comments">
					<div class="full-tab-content">
						<div class="messages-wrap" id="{{baseId}}_comments_wrap">
							{% for comment in topic_comments %}
								{% set comment_num = loop.index %}
								{% include 'AgentBundle:Community:view-comment.html.twig' %}
							{% endfor %}
						</div>
					</div>

					<div class="messages-wrap new-note">
						<article
							class="content-message agent-message"
							data-comment-id="{{comment.id}}"
							data-content-type="{{ comment.object_content_type }}"
						>
							<div class="avatar">
								<img src="{{ app.user.getPictureUrl(40) }}" alt="" width="40" height="40" />
							</div>
							<div class="content">
								<header>
									<h4>{{ phrase('agent.general.new_comment') }}</h4>
								</header>
								<div class="body-text">
									<textarea style="width:99%; height: 80px;"></textarea>
								</div>
								<div class="footer-text">
									<div class="loading-off">
										<button class="clean-white">{{ phrase('agent.general.add_comment') }}</button>
									</div>
									<div class="loading-on" style="display:none">
										{{ phrase('agent.general.saving') }}
									</div>
								</div>
							</div>
						</article>
					</div>
				</div>
			</div>
			{# /Tab: Comments #}

			{# Tab: Revisions #}
			<div id="{{baseId}}_revs" class="deskpro-tab-item content-tab-item revisions-tab">
				{% include 'AgentBundle:Community:view-revisions-tab.html.twig' %}
			</div>
			{# /Tab: Revisions #}

			{# Tab: Related #}
			<div id="{{baseId}}_related_content" class="deskpro-tab-item content-tab-item related-content-tab">
				{% include 'AgentBundle:Common:content-related-list.html.twig' %}
			</div>
			{# /Tab: Related #}

			{# Tab: Search #}
			<div id="{{baseId}}_searchtab" class="deskpro-tab-item search-tab">
				<section class="description-area sticky-search-words">
					<dl class="info-list">
						<dt class="type-labels">{{ phrase('agent.publish.sticky_words_title') }}</dt>
						<dd class="noedit-tags">
							<input type="text"
								   autocomplete="{{ "now" | date("U") }}"
								   value="{% for label in sticky_search_words %}{{label}},{% endfor %}"
								   id="{{baseId}}_stickysearch_input" />
							<div class="explain">
								{{ phrase('agent.publish.search_sticky_words_explain') }}
							</div>
						</dd>
					</dl>
				</section>

				<br />

				{% include 'AgentBundle:Publish:rated-searches.html.twig' %}
			</div>
			{# /Tab: Search #}
		</div>
		{# /Tab Contents #}
	</section>
</div>

<div class="inline-editable" style="display:none">
	<div class="title">
		<input type="text" name="title" value="{{ topic.title }}" autocomplete="{{ "now" | date("U") }}" />
		<input type="hidden" name="action" value="title" />
	</div>
</div>

{{ optionbox.category_ob(community_forums, phrase('agent.general.forum'), phrase('agent.general.apply'), {'id': baseId ~ '_cat_ob'}) }}

{# scroll containers #}
</div>
</div>
{# /scroll containers #}
