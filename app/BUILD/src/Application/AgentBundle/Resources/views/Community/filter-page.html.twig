 <section class="search-results page-set" data-page="{{ page }}">
	{% for result in display %}
	 	{% set topic = result.topic %}
		<article
			class="row-item community community-{{topic.id}} related-is-linkable"
			data-content-type="community"
			data-content-id="{{ topic.id }}"
			data-route="community:{{ path('agent_community_topic_view', {'communityTopicId': topic.id}) }}"
			data-route-title="@selector(a.community-title)"
			data-route-openclass="open"
		>
			<input class="item-select" type="checkbox" value="{{topic.id}}" />
			<div class="top-row">
				<div class="top-row-left">
					<span class="votes">
						{{ topic.num_ratings|default(0) }}
					</span>
					<h3>
						<a class="topic-title click-through"><span class="obj-title-community-topic_{{ topic.id }}">{{ topic.title }}</span></a>
					</h3>


				</div>

				<div class="top-row-right">
					<div class="bound-fade"></div>

				</div>
				<div class="top-row-right visible-related-content-controls">
					<div class="bound-fade"></div>
					<span class="tipped related-link" title="{{ phrase('agent.general.add_as_related') }}"></span>
					<span class="tipped related-unlink" title="{{ phrase('agent.general.remove_as_related') }}"></span>
				</div>
			</div>
			<hr class="clear-top" />
			{% if display_fields|length %}
				<div class="extra-fields">
					<ul>
						{% for field in display_fields %}
							{% if field == 'category' %}
								<li>
									<span class="prop-title">{{ phrase('agent.general.type') }}:</span>
									<span class="prop-val">{{ topic.channel.full_title }}</span>
								</li>
							{% elseif field == 'user_cat' and result.user_category %}
								<li>
									<span class="prop-title">{{ phrase('agent.general.category') }}:</span>
									<span class="prop-val">{{ result.user_category.getTitle() }}</span>
								</li>
							{% elseif field == 'author' %}
								<li>
									<span class="prop-title">{{ phrase('agent.general.author') }}:</span>
									<span class="prop-val">{{ topic.person.display_name }} {% if topic.person.primary_email_address %}({{ topic.person.primary_email_address }}){% endif %}</span>
								</li>
							{% elseif field == 'date_created' %}
								<li>
									<span class="prop-title">{{ phrase('agent.general.date_created') }}:</span>
									<span class="prop-val">{{ topic.date_created|date('day')}}</span>
								</li>
							{% endif %}
						{% endfor %}
					</ul>
					<br class="clear" />
				</div>
			{% else %}
				<br class="clear" />
			{% endif %}
		</article>
	{% endfor %}
 </section>
