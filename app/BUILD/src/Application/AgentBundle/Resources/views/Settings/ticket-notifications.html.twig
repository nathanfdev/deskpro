                         {% if app.user.getPref('agent_notify_override.forward.alert') %}checked="checked"{% endif %} />
                  <span class="small-light-icon tipped" data-tipped-options="maxWidth: 250"
                        title="{{ phrase('agent.settings.notif_tip_event_email') }}"></span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      {% endif %}
