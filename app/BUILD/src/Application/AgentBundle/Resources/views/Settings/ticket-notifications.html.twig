                  &nbsp;
                </td>
                <td class="prop">
                  <input type="checkbox" name="filter_sub[{{ sys_ids.all }}][alert_user_activity]" value="1"
                         {% if my_subs[sys_ids.all].alert_user_activity %}checked="checked"{% endif %} />
                  <span class="small-light-icon tipped" data-tipped-options="maxWidth: 250"
                        title="{{ phrase('agent.settings.notif_tip_all_user_reply') }}"></span>
