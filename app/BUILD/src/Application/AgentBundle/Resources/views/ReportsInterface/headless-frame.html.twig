<div class="app-container report-wrapper" id="dp_app_container" style="left: 0;">
    <div class="list-group">
        <div gridster="gridsterOptions" class="dashboard">
            <div class="dp-gridster-wrap">
                <div ng-if="!widget.deleted" gridster-item="widget" ng-repeat="widget in report.widgets" class="dp-gridster-item">
                    <div class="box-header">
                        <h3 class="ng-binding">{{ ng_var('widget.title') }}</h3>
                    </div>
                    <div class="box stat-box" ng-if="widget.data === null">
                        <div class="stat">
                            <div class="stat-value no-data">no data</div>
                        </div>
                    </div>
                    <div class="box" ng-if="widget.data && widget.widget_type === 'graph'">
                        <dashboard-amcharts
                                report-level-vars={{ ng_var('report.variables') }}
                                title="{{ ng_var('widget.title') }}"
                                widget-id = "{{ ng_var('widget.id') }}"
                                chart-data = "{{ ng_var('widget.data') }}"
                                widget-type="{{ ng_var('widget.widget_type') }}"
                                chart-type="{{ ng_var('widget.type') }}"
                                options="{{ ng_var('widget.options') }}"
                                js-code="{{ ng_var('widget.js_code') }}"
                        />
                    </div>
                    <div class="box" ng-if="widget.data && widget.type === 'table'">
                        <dashboard-table
                                title="{{ ng_var('widget.title') }}"
                                table-data="{{ ng_var('widget.data') }}"
                                widget-id = "{{ ng_var('widget.id') }}"
                                wtype="{{ ng_var('widget.type') }}"
                                options="{{ ng_var('widget.options') }}"
                                js-code="{{ ng_var('widget.js_code') }}"
                        />
                    </div>
                    <div class="box stat-box" ng-if="widget.data && widget.type === 'simple_stat'">
                        <dashboard-stat
                                my-index="{{ ng_var('$index') }}"
                                title="{{ ng_var('widget.title') }}"
                                value="{{ ng_var('widget.data.value') }}"
                                description="{{ ng_var('widget.data.description') }}"
                                widget-id = "{{ ng_var('widget.id') }}"
                                data="{{ ng_var('widget.rendered_result') }}"
                                options="{{ ng_var('widget.options') }}"
                                js-code="{{ ng_var('widget.js_code') }}"
                        />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
