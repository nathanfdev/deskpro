<div id="dp_center" style="left: 52px;">
    <div id="dp_source" style="left: 0px;">
        <section id="tickets_outline" class="on"><div class="source-pane-wrapper"><div class="source-pane-instance ">
                    <div id="react_dp_agent_filters">
                        <div class="dp-column" role="tree" style="width: 213px;">
                            <h1 class="dp-heading"><i class="dp-icon fa fa-bar-chart"></i> Reports</h1>
                            <ul class="dp-list dp-column-drawer-list">
                                <li class="dp-list__element dp-column-drawer">
                                    <h1 class="dp-heading">Dashboards</h1>
                                    <div class="dp-column-drawer__body dp-column-drawer__body--opened">
                                        <ul class="dp-list dp-drawer-item-list">
                                            <li  ng-if="hasAccessToBuiltIn"  class="dp-list__element dp-drawer-item">
                                                <span class="dp-drawer-item__pos-middle">Built-in dashboards</span>
                                            </li>
                                            <li class="dp-list__element dp-drawer-item"
                                                ng-repeat="dashboard in (dashboards|filter:defaultDashboardsFilter) track by dashboard.id">
                                                <a ui-sref="reports.dashboards.view.index({ dashboard_id: dashboard.id })">
                                                    {{ ng_var('dashboard.title') }}
                                                </a>
                                            </li>
                                            <li
                                                class="dp-list__element dp-drawer-item"
                                                ng-if="hasAccessToCustom" class="type-heading">
                                                Custom dashboards
                                            </li>
                                            <li
                                                class="dp-list__element dp-drawer-item"
                                                ng-repeat="dashboard in (dashboards|filter:customDashboardsFilter) track by dashboard.id">
                                                    <a ui-sref="reports.dashboards.view.index({ dashboard_id: dashboard.id })">
                                                        {{ ng_var('dashboard.title') }}
                                                    </a>
                                            </li>
                                            <li
                                                ng-if="canUseReports()"
                                                class="dp-list__element dp-drawer-item" style="margin-top: 10px;">
                                                <h1 class="dp-heading">
                                                    <a ng-click="openCreate()" class='link-pointer' id="dp-add-dashboard-opener">
                                                        [<i style="margin-right: 5px" class="fa fa-plus"></i>ADD]
                                                    </a>
                                                </h1>
                                            </li>
                                        </ul>
                                    </div>
                                </li>
                                <li class="dp-list__element dp-column-drawer">
                                    <h1 class="dp-heading">
                                        <a ng-if="canUseReports()" ui-sref="reports.stats">Stat Builder</a>
                                    </h1>
                                    <h1 class="dp-heading">
                                        <a ng-if="canUseReports()" ui-sref="reports.agent_activity">Agent Activity</a>
                                    </h1>
                                    <h1 class="dp-heading">
                                        <a ng-if="canUseReports()" ui-sref="reports.agent_hours">Agent Hours</a>
                                    </h1>
                                    <h1 class="dp-heading">
                                        <a ng-if="canUseReports()" ui-sref="reports.ticket_satisfaction">Ticket Satisfaction</a>
                                    </h1>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

<div class="app-container report-wrapper" id="dp_app_container" ui-view></div>
