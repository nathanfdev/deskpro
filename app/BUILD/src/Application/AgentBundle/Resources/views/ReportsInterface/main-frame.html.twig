<div class="app-nav-wrapper">
    <header class="app-nav-header">
        <h1><i class="fa fa-bar-chart"></i> Reports</h1>
    </header>
    <section class="nav-section">
        <h1 class="nav-title">Dashboards</h1>
        <ul class="nav-link-list">
            <li ng-if="hasAccessToBuiltIn" class="type-heading">Built-in dashboards</li>
            <li ng-repeat="dashboard in (dashboards|filter:defaultDashboardsFilter) track by dashboard.id">
                <a ui-sref="reports.dashboards.view.index({ dashboard_id: dashboard.id })">
                    {{ ng_var('dashboard.title') }}
                </a>
            </li>
            <li ng-if="hasAccessToCustom" class="type-heading">Custom dashboards</li>
            <li ng-repeat="dashboard in (dashboards|filter:customDashboardsFilter) track by dashboard.id">
                <a ui-sref="reports.dashboards.view.index({ dashboard_id: dashboard.id })">
                    {{ ng_var('dashboard.title') }}
                </a>
            </li>
            <li ng-if="canUseReports()" class="type-heading">
                <a ng-click="openCreate()" class='link-pointer' id="dp-add-dashboard-opener">[<i class="fa fa-plus"></i>Add]</a>
            </li>
        </ul>
    </section>
    <a ng-if="canUseReports()" class="nav-section nav-title" ui-sref="reports.stats">Stat Builder</a>
    <a ng-if="canUseReports()" class="nav-section nav-title" ui-sref="reports.agent_activity">Agent Activity</a>
    <a ng-if="canUseReports()" class="nav-section nav-title" ui-sref="reports.agent_hours">Agent Hours</a>
    <a ng-if="canUseReports()" class="nav-section nav-title" ui-sref="reports.ticket_satisfaction">Ticket Satisfaction</a>
</div>
<div class="app-container report-wrapper" id="dp_app_container" ui-view></div>