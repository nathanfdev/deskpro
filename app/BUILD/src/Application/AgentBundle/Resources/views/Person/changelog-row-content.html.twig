{%- macro contact_prop(item) -%}
    {%- if item is empty or item.contact_type is not defined -%}
    {%- elseif 'twitter' == item.contact_type -%}{{ phrase('agent.general.twitter_username') }}
    {%- elseif 'phone' == item.contact_type or 'fax' == item.contact_type or 'mobile' == contact_type -%}
        {{ item.type }}
    {%- elseif 'address' == item.contact_type -%}{{ phrase('agent.general.address')|lower }}
    {%- elseif 'facebook' == item.contact_type -%}{{ phrase('agent.general.facebook') }} {{ phrase('agent.general.account')|lower }}
    {%- elseif 'instant_message' == item.contact_type -%}{{ item.service }} {{ phrase('agent.general.account')|lower }}
    {%- elseif 'linked_in' == item.contact_type -%}{{ phrase('agent.general.linkedin') }} {{ phrase('agent.general.account')|lower }}
    {%- elseif 'skype' == item.contact_type -%}{{ phrase('agent.general.skype') }} {{ phrase('agent.general.account')|lower }}
    {%- elseif 'website' == item.contact_type -%}{{ phrase('agent.general.website')|lower }} {{ phrase('agent.general.url')|lower }}
    {%- endif -%}
{%- endmacro -%}

{%- macro contact_val(item) -%}
	<span class="new-val">
    {%- if item is empty or item.contact_type is not defined -%}
    {%- elseif 'twitter' == item.contact_type or 'instant_message' == item.contact_type or 'skype' == item.contact_type -%}
        {{ item.username }}
    {%- elseif 'phone' == item.contact_type or 'fax' == item.contact_type or 'mobile' == contact_type  -%}
        <a href="tel:{{ item.country_calling_code }}{{ item.number }}">{{ item.country_calling_code }}{{ item.number }}</a>
    {%- elseif 'address' == item.contact_type -%}
        <address style="margin-left: 10px;">
        {% for key, val in item if key != 'contact_type' %}
            <strong><abbr title="{{ key }}">{{ key }}</abbr></strong>: {{ val }}<br/>
        {% endfor %}
        </address>
    {%- elseif 'facebook' == item.contact_type or 'linked_in' == item.contact_type -%}{{ item.display }}
    {%- elseif 'website' == item.contact_type -%}{{ item.url }}
    {%- endif -%}
	</span>
{%- endmacro -%}

{%- macro prop(property) -%}
    {%- if 'primary_email' == property -%}primary email
    {%- elseif 'emails' == property -%}email
    {%- elseif 'labels' == property -%}label
    {%- elseif 'usergroups' == property -%}usergroup
    {%- elseif 'first_name' == property -%}first name
    {%- elseif 'last_name' == property -%}last name
    {%- elseif 'title_prefix' == property -%}title prefix
    {%- else -%}{{ property }}
    {%- endif -%}
{%- endmacro -%}


{% if 'user_merged' == entry.event %}

    <div class="log-row log-{{entry.id}} data-log-id="{{ sublog.id }}">
        <div class="info">
        </div>

        <div class="{{ entry.event }}" style="padding-left: 21px; background: transparent url({{ asset('images/agent/elbow-end.gif') }}) no-repeat;">
            <address>
                {% for key, val in entry.details %}
                    <strong><abbr title="{{ key }}">{{ key }}</abbr></strong>: <span class="new-val">{{ val }}</span><br/>
                {% endfor %}
            </address>
        </div>
    </div>

{% else %}


    {% if 0 == entry.details.add|length and 0 == entry.details.del|length %}

        <div class="log-row log-{{entry.id}} data-log-id="{{ sublog.id }}">
            <div class="info">
            </div>

            <div class="{{ entry.event }}" style="padding-left: 21px; background: transparent url({{ asset('images/agent/elbow-end.gif') }}) no-repeat;">
                {% if 'password' == entry.details.property %}
                    {{ phrase('agent.general.changed') }} {{ phrase('agent.general.password') }}
                {% elseif 'picture_blob' == entry.details.property %}
                    {{ phrase('agent.general.changed') }} Picture
                {% elseif 'contact_data' == entry.details.property %}
	                {% if null == entry.details.old %}
		                {{ phrase('agent.general.added') }} {{ _self.contact_prop(entry.details.new) }} {{ _self.contact_val(entry.details.new) }}
	                {% elseif null == entry.details.new %}
		                {{ phrase('agent.general.removed') }} {{ _self.contact_prop(entry.details.old) }} {{ _self.contact_val(entry.details.old) }}
	                {% else %}
		                {{ phrase('agent.general.changed') }} {{ _self.contact_prop(entry.details.new) }}
		                {{ phrase('agent.general.from')|lower }} {{ _self.contact_val(entry.details.old) }}
		                {{ phrase('agent.general.to')|lower }} {{ _self.contact_val(entry.details.new) }}
	                {% endif %}
                {% elseif 'is_disabled' == entry.details.property %}
                    {{ phrase('agent.general.user') }} <span class="new-val">{% if entry.details.new %}{{ phrase('agent.general.disabled')|lower }}{% else %}{{ phrase('agent.general.enabled')|lower }}{% endif %}</span>
                {% elseif 'custom_data' == entry.details.property %}
                    {{ phrase('agent.general.set') }} <strong>{{ entry.details.new.title }}</strong> {{ phrase('agent.general.to')|lower }} <span class="new-val">{{ entry.details.new.value }}</span>
                {% else %}
                    {{ phrase('agent.general.set') }} {{ _self.prop(entry.details.property) }} {{ phrase('agent.general.to')|lower }} <span class="new-val">{{ entry.details.new }}</span>
                {% endif %}
            </div>
        </div>

    {% endif %}

    {% for item in entry.details.add %}
        <div class="log-row">
            <div class="info">
            </div>

            <div style="padding-left: 21px; background: transparent url({{ asset('images/agent/elbow-end.gif') }}) no-repeat;">
                {{ phrase('agent.general.added') }}
                {% if 'contact_data' == entry.details.property %}
                    {{ _self.contact_prop(item) }} <span class="new-val">{{ _self.contact_val(item) }}</span>
                {% elseif 'custom_data' == entry.details.property %}
                    <strong>{{ item.title }}</strong>: <span class="new-val">{{ item.value }}</span>
                {% else %}
                    {{ _self.prop(entry.details.property) }} <span class="new-val">{{ item }}</span>
                {% endif %}
            </div>
        </div>
    {% endfor %}

    {% for item in entry.details.del %}
        <div class="log-row">
            <div class="info">
            </div>

            <div style="padding-left: 21px; background: transparent url({{ asset('images/agent/elbow-end.gif') }}) no-repeat;">
                {{ phrase('agent.general.removed') }}
                {% if 'contact_data' == entry.details.property %}
                    {{ _self.contact_prop(item) }} <span class="new-val">{{ _self.contact_val(item) }}</span>
                {% elseif 'custom_data' == entry.details.property %}
                    <strong>{{ item.title }}</strong>: <span class="new-val">{{ item.value }}</span>
                {% else %}
                    {{ _self.prop(entry.details.property) ~ ' ' ~ item }}
                {% endif %}
            </div>
        </div>
    {% endfor %}

{% endif %}
