<style>
    .editable-visible {
        display: none;
    }

    .editable .editable-visible {
        display: inline-block;
    }

    .editable .editable-hidden {
        display: none;
    }
</style>
{{ dp_app_loc(baseId, 'left_col.top') }}
<div data-deskproapp="person-content-before"></div>

{# Box Summary #}
{{ dp_app_loc(baseId, 'summary.before') }}
<div data-deskproapp="person-summary-before"></div>
{% if person.summary|length or perms.edit %}
    <div class="profile-box-container dp-simpletab-container dp-simpletab-container summary"
		 id="{{ baseId }}_summary_saver"
         data-element-handler="DeskPRO.Agent.ElementHandler.FormSaver"
         data-form-save-url="{{ path('agent_people_ajaxsave', {'person_id': person.id}) }}"
    >
        <header>
            {% if perms.edit %}
                <div class="controls">
                    <div class="is-loading">{{ phrase('agent.general.saving') }}</div>
                    <div class="saved" style="display: none">{{ phrase('agent.general.saved') }}</div>
                    <div class="save" style="display: none">{{ phrase('agent.general.save') }}</div>
                </div>
            {% endif %}
			<nav>
                <ul>
                    <li data-tab-for="#{{ baseId }}_summary_body">{{ phrase('agent.general.summary') }}</li>
                    <div data-deskproapp="person-summary-new-tab"></div>
                </ul>
            </nav>
        </header>
        <section>
            <div id="{{ baseId }}_summary_body">
                <input type="hidden" name="action" value="set-summary" />
                <div class="textarea-section"><textarea class="integrated" id="{{ baseId }}_summary" name="summary"
                                                        {% if not perms.edit %}onkeydown="return false;"{% endif %}>{{ person.summary }}</textarea>
                </div>
            </div>
            {{ dp_app_loc(baseId, 'summary.tab') }}
        </section>
    </div>
{% endif %}
{{ dp_app_loc(baseId, 'summary.after') }}
<div data-deskproapp="person-summary-after"></div>
{# /Box Summary #}

{# Properties Box #}
{{ dp_app_loc(baseId, 'properties.before') }}
<div data-deskproapp="person-properties-before"></div>
<div class="profile-box-container dp-simpletab-container properties" id="{{ baseId }}_properties_box">
    <header>
        {% if perms.edit %}
            <div class="controls">
                <span class="edit-gear prop-edit-trigger"></span>
                <div class="is-loading">{{ phrase('agent.general.saving') }}</div>
                <button class="cancel" style="display: none">{{ phrase('agent.general.cancel') }}</button>
                <button class="save" style="display: none">{{ phrase('agent.general.save') }}</button>
            </div>
        {% endif %}
		<nav>
            <ul>
                <li data-tab-for="#{{ baseId }}_properties_body">{{ phrase('agent.general.properties') }}</li>
                <div data-deskproapp="person-summary-new-tab"></div>
            </ul>
        </nav>
    </header>
    <section>
        <div id="{{ baseId }}_properties_body">
            <div class="table-list" id="{{ baseId }}_custom_fields_rendered">
                {% include 'AgentBundle:Person:view-customfields-rendered-rows.html.twig' %}
            </div>
            {% if perms.edit %}
                <div class="table-list" id="{{ baseId }}_custom_fields_editable" style="display: none">
                    {% include 'AgentBundle:Person:view-customfields-edit-rows.html.twig' %}
                </div>
            {% endif %}
        </div>
        {{ dp_app_loc(baseId, 'properties.tab') }}
    </section>
</div>
{{ dp_app_loc(baseId, 'properties.after') }}
<div data-deskproapp="person-properties-after"></div>
{# /Properties Box #}

{# Interaction Tabs #}
{{ dp_app_loc(baseId, 'interactions.before') }}
{% if person_tickets_count or person_chats_count or person_charges %}
    <div class="profile-box-container dp-simpletab-container tabbed">
        <header>
            <nav>
                <ul>
                    {% if person_tickets_count %}
                        <li
                              data-tab-for="#{{ baseId }}_tickets_tab"
                              data-class-show='tickets-tab-show'
                              class="on"
                        >
                            {{ phrase('agent.general.tickets') }}
                            <span class="count">{{ person_tickets_count }}</span>
                        </li>
                    {% endif %}
                    {% if person_chats_count %}
                        <li
                              data-tab-for="#{{ baseId }}_chats_tab"
                              data-class-show='chats-tab-show'
                        >
                            {{ phrase('agent.general.chats') }}
                            <span class="count">{{ person_chats_count }}</span>
                        </li>
                    {% endif %}
                    {% if person_charges %}
                        <li
                              data-tab-for="#{{ baseId }}_billing_tab"
                              data-class-show='billing-tab-show'
                        >
                            {{ phrase('agent.general.billing') }}
                            <span class="count">
							{{ person_charge_totals.count }}
						</span>
                        </li>
                    {% endif %}
                    <div data-deskproapp="person-content-box-new-tab"></div>
                </ul>
            </nav>
            <button
                  class="save sort-trigger tickets-tab-show tabs-control"
                  id="{{ baseId }}_sort_tickets_menu_trigger" style="float: right; margin: 5px;">Sort Tickets By
                <em class="downarrow"></em>
            </button>
            <button
                  class="save sort-trigger chats-tab-show tabs-control"
                  id="{{ baseId }}_sort_chats_menu_trigger" style="display: none; float: right; margin: 5px;">Sort Chats
                By
                <em class="downarrow"></em>
            </button>
        </header>
        <section>
            {# Tickets Tab #}
            {% if person_tickets_count %}
                <article id="{{ baseId }}_tickets_tab" class="on">
                    <table class="tickets-simple" width="100%" border="0" cellpadding="0" cellspacing="0">
                        <tbody id="{{ baseId }}_tickets_initial">
                            {% for ticket in person_tickets_initial %}
                                <tr>
                                    <td>
                                        <div class="fade-container">
                                            <div class="line">
                                                <a data-route="ticket:{{ path('agent_ticket_view', {'ticket_id': ticket.id}) }}"
                                                   data-route-title="@text"><span
                                                          class="id-number">#{{ ticket.id }}</span> {{ ticket.subject }}
                                                </a>
                                            </div>
                                            <div class="bound-fade"></div>
                                        </div>
                                    </td>
                                    <td {% if not ticket.agent %}colspan="2"{% endif %}>
                                        <div class="status-pill status urgency-{{ ticket.urgency }} {{ ticket.status_code|replace({'.': '_'}) }}"
                                             style="float: right; position: relative; top: 0px;">
                                            <label>{{ phrase('agent.tickets.status_' ~ ticket.status_code|replace({'.': '_'})) }}</label>
                                            {% if ticket.status == 'awaiting_agent' %}<i class="ticket-urgency"
                                                                                         data-urgency="{{ ticket.urgency }}">{{ ticket.urgency }}</i>{% endif %}
                                        </div>
                                    </td>
                                    {% if ticket.agent %}
                                        <td width="16" style="width: 16px; padding:0; padding-right: 4px;">
									<span
                                          class="tipped"
                                          title="{{ ticket.agent.display_name }}"
                                          style="background: url('{{ ticket.agent.getPictureUrl(16) }}') no-repeat 0 50%; height: 16px; width: 16px; overflow: hidden; display: block;"
                                    ></span>
                                        </td>
                                    {% endif %}
                                </tr>
                            {% endfor %}
                            {% if person_tickets|length %}
                                {% if person_tickets|length >= 250 %}
                                    <tr class="more">
                                        <td colspan="100">
                                            <button class="clean-white"
                                                    data-route="listpane:{{ path('agent_ticketsearch_runcustomfilter') }}?search_person_id={{ person.id }}">
                                                {{ phrase('agent.general.view_all_x_tickets', {'count':person_tickets_count}) }}
                                            </button>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr class="more">
                                        <td colspan="100">
                                            <button class="clean-white" id="{{ baseId }}_tickets_viewall">
                                                {{ phrase('agent.general.view_all_x_tickets', {'count':person_tickets_count}) }}
                                            </button>
                                        </td>
                                    </tr>
                                {% endif %}
                            {% endif %}
                        </tbody>
                        {% if person_tickets|length <= 250 %}
                            <tbody id="{{ baseId }}_tickets_rest" style="display: none;">
                                {% for ticket in person_tickets %}
                                    <tr>
                                        <td>
                                            <div class="fade-container">
                                                <div class="line">
                                                    <a data-route="ticket:{{ path('agent_ticket_view', {'ticket_id': ticket.id}) }}"
                                                       data-route-title="@text"><span
                                                              class="id-number">#{{ ticket.id }}</span> {{ ticket.subject }}
                                                    </a>
                                                </div>
                                                <div class="bound-fade"></div>
                                            </div>
                                        </td>
                                        <td {% if not ticket.agent %}colspan="2"{% endif %}>
                                            <div class="status-pill status urgency-{{ ticket.urgency }} {{ ticket.status_code|replace({'.': '_'}) }}"
                                                 style="float: right; position: relative; top: 0px;">
                                                <label>{{ phrase('agent.tickets.status_' ~ ticket.status_code|replace({'.': '_'})) }}</label>
                                                {% if ticket.status == 'awaiting_agent' %}<i class="ticket-urgency"
                                                                                             data-urgency="{{ ticket.urgency }}">{{ ticket.urgency }}</i>{% endif %}
                                            </div>
                                        </td>
                                        {% if ticket.agent %}
                                            <td width="16" style="width: 16px; padding:0; padding-right: 4px;">
										<span
                                              class="tipped"
                                              title="{{ ticket.agent.display_name }}"
                                              style="background: url('{{ ticket.agent.getPictureUrl(16) }}') no-repeat 0 50%; height: 16px; width: 16px; overflow: hidden; display: block;"
                                        ></span>
                                            </td>
                                        {% endif %}
                                    </tr>
                                {% endfor %}
                            </tbody>
                        {% endif %}
                    </table>
                    <ul id="{{ baseId }}_sort_tickets_menu" style="display: none;">
                        <li data-sort-by="status">{{ phrase('agent.general.status') }}</li>
                        <li data-sort-by="date_last_user_reply">{{ phrase('agent.general.date_of_last_user_reply') }}</li>
                        <li data-sort-by="date_last_agent_reply">{{ phrase('agent.general.date_of_last_agent_reply') }}</li>
                        <li data-sort-by="last_reply">{{ phrase('agent.general.date_of_last_reply') }}</li>
                        <li data-sort-by="date_created">{{ phrase('agent.general.date_created') }} </li>
                    </ul>
                </article>

            {% endif %}
            {# /Tickets Tab #}

            {% if person_chats_count %}
                <article id="{{ baseId }}_chats_tab">
                    <table class="tickets-simple" id="{{ baseId }}_chats_initial" width="100%" border="0"
                           cellpadding="0" cellspacing="0">
                        <tbody>
                            {% for chat in person_chats %}
                                <tr>
                                    <td>
                                        <div class="fade-container">
                                            <div class="line">
                                                {{ chat.date_created|date('day_short') }}
                                                <a data-route="page:{{ path('agent_userchat_view', {'conversation_id': chat.id}) }}"
                                                   data-route-notabreload="1"
                                                   data-route-title="@text">{{ chat.getSubjectLine() }}</a>
                                            </div>
                                            <div class="bound-fade"></div>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    <ul id="{{ baseId }}_sort_chats_menu" style="display: none;">
                        <li data-order-dir="ASC"
                            data-order-by="date_created">{{ phrase('agent.general.date_created') }} {{ phrase('agent.general.date_oldestnewest') }}</li>
                        <li data-order-dir="DESC"
                            data-order-by="date_created">{{ phrase('agent.general.date_created') }} {{ phrase('agent.general.date_newestoldest') }}</li>
                        <li data-order-dir="ASC"
                            data-order-by="date_assigned">{{ phrase('agent.general.date_assigned') }} {{ phrase('agent.general.date_oldestnewest') }}</li>
                        <li data-order-dir="DESC"
                            data-order-by="date_assigned">{{ phrase('agent.general.date_assigned') }} {{ phrase('agent.general.date_newestoldest') }}</li>
                        <li data-order-dir="ASC"
                            data-order-by="date_ended">{{ phrase('agent.general.date_ended') }} {{ phrase('agent.general.date_oldestnewest') }}</li>
                        <li data-order-dir="DESC"
                            data-order-by="date_ended">{{ phrase('agent.general.date_ended') }} {{ phrase('agent.general.date_newestoldest') }}</li>
                    </ul>
                </article>
            {% endif %}

            {% if person_charges %}
                <article id="{{ baseId }}_billing_tab">
                    <table class="tickets-simple" width="100%" border="0" cellpadding="0" cellspacing="0">
                        {% for charge in person_charges %}
                            {% include 'AgentBundle:Common:billing-row-simple.html.twig' %}
                        {% endfor %}
                        <tr>
                            <th colspan="2">
                                Totals:
                                {{ person_charge_totals.count }} charges &bull;
                                {% if person_charge_totals.charge_time %}{{ person_charge_totals.charge_time|time_length }}{% if person_charge_totals.charge %} &bull; {% endif %}{% endif %}
                                {% if person_charge_totals.charge %}{{ person_charge_totals.charge|number_format(2) }} {{ app.getSetting('core_tickets.billing_currency') }}{% endif %}
                            </th>
                        </tr>
                    </table>
                </article>
            {% endif %}
            {{ dp_app_loc(baseId, 'interactions.tab') }}
        </section>
    </div>
{% endif %}
{{ dp_app_loc(baseId, 'interactions.after') }}
{# /Interaction Tabs #}

{# Interaction Tabs #}
{{ dp_app_loc(baseId, 'files.before') }}
<div class="profile-box-container dp-simpletab-container tabbed" id="{{ baseId }}_files_box">
    <header>
        <nav>
            <ul>
                <li data-tab-for="#{{ baseId }}_files_tab" class="on">{{ phrase('agent.general.files') }} <span
                          class="count">{{ person_files_count }}</span></li>
                <li data-tab-for="#{{ baseId }}_add_file_tab" class="off">Add File</li>
            </ul>
        </nav>
    </header>
    <section>
        {# Files Tab #}
        <article id="{{ baseId }}_files_tab" class="on">
            <div class="notes-wrap profile-files-wrap">
                <ul id="{{ baseId }}_files_initial">
                    {% for file in person_files %}
                        {% include 'AgentBundle:Person:file-row.html.twig' with { 'file' : file } %}
                    {% else %}
                        <li class="note profile-file-row empty-notice"><p style="padding:10px;">No files.</p></li>
                    {% endfor %}
                </ul>
            </div>
        </article>
        {# /Files Tab #}
        {# Add File Tab #}
        <article id="{{ baseId }}_add_file_tab" class="off">
            <form id="{{ baseId }}_add_file_form" method="POST"
                  action="{{ path('agent_people_ajaxsave_file', {person_id: person.id}) }}">
                <table class="tickets-simple" width="100%" border="0" cellpadding="0" cellspacing="0">
                    <tbody id="{{ baseId }}_add_file_initial">
                        <tr>
                            <td colspan="2"><textarea style="width: 97%" placeholder="comment"
                                                      id="input_note"></textarea>
                        </tr>
                        <tr>
                            <td style="width: 70%;"><h4 style="float:left;">{{ phrase('agent.general.file') }}</h4>
                                <br class="clear" />
                                <div id="{{ baseId }}_file_section_up">
                                    <input type="file" name="file-upload" multiple="multiple" />
                                </div>
                                {% include 'AgentBundle:Common:attach-row-tmpl.html.twig' with {formname: 'blob_id' } %}
                                <ul class="files file-list"></ul>
                            </td>
                            <td style="width: 30%"><input type="submit" class="save-trigger" value="save" /></td>
                        </tr>
                    </tbody>
                </table>
            </form>
        </article>
        {# /Add file Tab #}
        {{ dp_app_loc(baseId, 'files.tab') }}
    </section>
</div>
{{ dp_app_loc(baseId, 'files.after') }}
{# /Interaction Tabs #}

{# Info Tabs #}
{{ dp_app_loc(baseId, 'details.before') }}
<div data-deskproapp="person-notes-before"></div>
<div class="profile-box-container dp-simpletab-container tabbed">
    <header>
		<nav>
            <ul>
                {% if notes|length or perms.notes %}
                    <li data-tab-for="#{{ baseId }}_notes_tab" class="on">{{ phrase('agent.general.notes') }} <span
                      class="count" id="{{ baseId }}_notes_count">{{ notes|length }}</span></li>{% endif %}
                {% if changelog|length %}
                    <li
                    data-tab-for="#{{ baseId }}_changelog_tab">{{ phrase('agent.general.changelog') }}</li>{% endif %}
                {% if activity_stream|length %}
                    <li
                    data-tab-for="#{{ baseId }}_activity_tab">{{ phrase('agent.general.activity_stream') }}</li>{% endif %}
                <li data-tab-for="#{{ baseId }}_tracking_tab">{{ phrase('agent.general.detail') }}</li>
                <div data-deskproapp="person-notes-new-tab"></div>
            </ul>
        </nav>
    </header>
    <section>
        {# Notes Tab #}
        {% if notes|length or perms.notes %}
            <article id="{{ baseId }}_notes_tab" class="on">
                <div class="notes-wrap">
                    <ul>
                        {% for note in notes|reverse %}
                            {% include 'AgentBundle:Person:note-li.html.twig' with {'note': note} %}
                        {% endfor %}
                        {% if perms.notes %}
                            <li class="new-note"
								id="{{ baseId }}_new_note"
                                data-element-handler="DeskPRO.Agent.ElementHandler.FormSaver"
                                data-form-list-selector="ul"
                                data-form-result-html-key="note_li_html"
                                data-form-save-url="{{ path('agent_people_ajaxsave_note', {'person_id': person.id}) }}"
                                data-form-count-el="#{{ baseId }}_notes_count"
                            >
                                <header>
                                    <div class="controls">
                                        <div class="is-loading">{{ phrase('agent.general.saving') }}</div>
                                        <div class="saved"
                                             style="display: none">{{ phrase('agent.general.saved') }}</div>
                                        <div class="save" style="display: none">{{ phrase('agent.general.save') }}</div>
                                    </div>
                                    <h3>{{ phrase('agent.general.new_note') }}</h3>
                                </header>
                                <div class="textarea-section"><textarea class="integrated" name="note" placeholder=""
                                                                        data-not-blank="1"></textarea></div>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </article>
        {% endif %}
        {# /Notes Tab #}

        {# Changelog Tab #}
        {% if changelog|length %}
            <article id="{{ baseId }}_changelog_tab">
                <table class="tickets-simple" width="100%" border="0" cellpadding="0" cellspacing="0">
                    {% for entry in changelog %}
                        <tr>
                            <td>
                                {{ include('AgentBundle:Person:changelog-row.html.twig', {entry: entry}) }}
                            </td>
                        </tr>
                    {% endfor %}
                </table>
            </article>
        {% endif %}
        {# /Changelog Tab #}

        {# Activity Tab #}
        {% if activity_stream|length %}
            <article id="{{ baseId }}_activity_tab">
                <table class="tickets-simple" width="100%" border="0" cellpadding="0" cellspacing="0">
                    {% for action in activity_stream %}
                        <tr>
                            <td>
                                <div class="fade-container">
                                    <div {% if action.action_type != 'agent_login_as' %}class="line"{% endif %}>
									<span class="what">
										{% if action.action_type == 'registered' %}
                                            {{ phrase('agent.people.act_reg') }}
                                        {% elseif action.action_type == 'new_ticket' and action.details.ticket_id %}
                                            {{ phrase('agent.people.act_submitted_ticket') }}
                                            <a class="with-route"
                                               data-route="ticket:{{ path('agent_ticket_view', {'ticket_id': action.details.ticket_id }) }}">
                                                {{ action.details.subject }}
                                            </a>
                                        {% elseif action.action_type == 'new_chat' and action.details.convo_id %}
                                            Created a chat:
                                            {% set chat = person_chats[action.details.convo_id] %}
                                            <a data-route="page:{{ path('agent_userchat_view', {'conversation_id': action.details.convo_id}) }}"
                                               data-route-notabreload="1"
                                               data-route-title="@text">{{ chat.getSubjectLine()|default(action.details.convo_id) }}</a>
                                        {% elseif action.action_type == 'new_ticket_reply' and action.details.ticket_id %}
                                            {{ phrase('agent.people.act_replied_ticket') }}
                                            <a class="with-route"
                                               data-route="ticket:{{ path('agent_ticket_view', {'ticket_id': action.details.ticket_id }) }}">
												{{ action.details.subject }}
											</a>
                                        {% elseif action.action_type == 'agent_login_as' %}
                                            Agent logged in as this user:<br />
                                            <span style="font-size: 10px;">#{{ action.details.agent_id }} {{ action.details.agent_name }}
                                                ({{ action.details.agent_email }})</span>
                                        {% endif %}
									</span>
                                    </div>
                                    <div class="bound-fade"></div>
                                </div>
                                <time
                                    {% if not app.isRelativeTimesDisabled() %}class="timeago"{% endif %}
                                    datetime="{{ action.date_created|date('c', 'UTC') }}"
                                >
                                    {{ action.date_created|date('fulltime') }}
                                </time>
                            </td>
                        </tr>
                    {% endfor %}
                </table>
            </article>
        {% endif %}
        {# /Activity Tab #}

        {# Tracking Tab #}
        <article id="{{ baseId }}_tracking_tab">
            <table class="info-simple" width="100%" border="0" cellpadding="0" cellspacing="0">
                <tr>
                    <td class="label" width="80">{{ phrase('agent.general.id') }}</td>
                    <td class="value">
                        {{ person.id }}
                    </td>
                </tr>
                <tr>
                    <td class="label" width="80">{{ phrase('agent.general.created') }}</td>
                    <td class="value">
                        <time>{{ person.date_created|date('fulltime') }}</time>
                        (
                        <time class="timeago" datetime="{{ person.date_created|date('c', 'UTC') }}"></time>
                        )
                    </td>
                </tr>
                <tr>
                    <td class="label">{{ phrase('agent.people.creation_by') }}</td>
                    <td class="value">
                        {% if person.creation_system == 'web.person' %}
                            {{ phrase('agent.people.reg_website') }}
                        {% elseif person.creation_system == 'web.agent' %}
                            {{ phrase('agent.people.reg_agent') }}
                        {% elseif person.creation_system == 'gateway.person' %}
                            {{ phrase('agent.people.reg_gateway') }}
                        {% else %}
                            {{ person.creation_system }}
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <td class="label">{{ phrase('agent.general.last_login') }}</td>
                    <td class="value">
                        {% if person.date_last_login %}
                            <time>{{ person.date_last_login|date('fulltime') }}</time>
                            (
                            <time class="timeago" datetime="{{ person.date_last_login|date('c', 'UTC') }}"></time>)
                        {% else %}
                            {{ phrase('agent.general.never') }}
                        {% endif %}
                    </td>
                </tr>
                {% if session %}
                    <tr>
                        <td class="label">{{ phrase('agent.general.online_now') }}</td>
                        <td class="value">
                            <time>{{ session.date_created|date('fulltime') }}</time>
                            (
                            <time class="timeago" datetime="{{ session.date_created|date('c', 'UTC') }}"></time>
                            )
                        </td>
                    </tr>
                {% endif %}
                <tr>
                    <td class="label">Has confirmed? <span class="small-light-icon tipped"
                                                           title="If the user has ever confirmed their account e.g. by clicking a validatioin link in an email. Depending on the settings enabled by the administrator, an unconfirmed account may have limitations enforced until the user confirms their account."></span>
                    </td>
                    <td class="value">
                        <select id="{{ baseId }}_toggle_confirmed">
                            <option value="0"
                                    {% if not person.is_confirmed %}selected="selected"{% endif %}>Not confirmed</option>
                            <option value="1"
                                    {% if person.is_confirmed %}selected="selected"{% endif %}>Confirmed</option>
                        </select>
                    </td>
                </tr>
                <tr>
                    <td class="label">Auto-responder <span class="small-light-icon tipped"
                                                           title="If the system detects a user automatically responds to messages (e.g., a robot or script), then DeskPRO will disable outgoing auto-emails to the user. The user will still get normal email notifications (like agent replies), only automatic auto-confirmations are disabled."></span>
                    </td>
                    <td class="value">
                        <select id="{{ baseId }}_disable_autoresponses">
                            <option value="0"
                                    {% if not person.disable_autoresponses %}selected="selected"{% endif %}>{{ phrase('agent.people.user_not_autoresponder') }}</option>
                            <option value="1"
                                    {% if person.disable_autoresponses %}selected="selected"{% endif %}>{{ phrase('agent.people.user_is_autoresponder') }}</option>
                        </select>
                        {% if person.disable_autoresponses and person.disable_autoresponses_log %}
                            <div style="font-size:10px;" id="{{ baseId }}_disable_autoresponses_reason">
                                {{ person.disable_autoresponses_log }}
                            </div>
                        {% endif %}
                    </td>
                </tr>
            </table>
        </article>
        {# /Tracking Tab #}

        {{ dp_app_loc(baseId, 'details.tab') }}
    </section>
</div>
{{ dp_app_loc(baseId, 'details.after') }}
<div data-deskproapp="person-notes-after"></div>

{# /Info Tabs #}

{{ dp_app_loc(baseId, 'left_col.bottom') }}
<div data-deskproapp="person-content-after"></div>
