<div class="wrap">
{% for f in custom_fields %}
	{% if f.rendered %}
		<div class="row-table-cotent">
			<div class="col-table-content title-col" ng-non-bindable>
				<span>{{f.title}}</span>
			</div>
			<div class="col-table-content prop-val" ng-non-bindable>
				{{ render_custom_field(f) }}
			</div>
		</div>
	{% endif %}
{% endfor %}
</div>
