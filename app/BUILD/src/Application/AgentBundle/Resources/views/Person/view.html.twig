<script>
  pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.Person';
  pageMeta.title = {{ person.getDisplayName()|json_encode|raw }};
  pageMeta.person_id = {{ person.id }};
  pageMeta.url_fragment = '{{ url_fragment('agent_people_view', {'person_id': person.id}) }}';
  pageMeta.pageIdentity = 'person:{{ person.id }}';
  pageMeta.labelsAutocompleteUrl = '{{ path('agent_ajax_labels_autocomplete', { 'label_type': 'people'}) }}';
  pageMeta.labelsSaveUrl = '{{ path('agent_person_ajax_labels_save', {'person_id': person.id}) }}';
  pageMeta.saveFieldsUrl = '{{ path('agent_person_ajaxsavecustomfields', {'person_id': person.id }) }}';
  pageMeta.org_id = {{ person.organization.id|default(0) }};
  pageMeta.tabClassId = 'person-{{ person.id }}';

  {% if person.picture_blob %}
  pageMeta.personPicIcon = '{{ person.picture_blob.getThumbnailUrl(13) }}';
  {% elseif app.getSetting('core.use_gravatar') and person.primary_email %}
  pageMeta.personGravatarIcon = '{{ person.primary_email.getGravatarUrl() }}&s=13';
  {% endif %}

  pageMeta.person = {{ person_api|json_encode|raw }};
  pageMeta.api_data = {{ person.toApiData()|json_encode|raw }};

  pageMeta.perms = {{ perms|json_encode|raw }};

  {% set baseId = el_uid() %}
  pageMeta.baseId = '{{ baseId }}';

  {% if person.is_agent %}pageMeta.isAgent = true;{% endif %}
</script>
<div
      class="layout-sidebar dp-app-v2-sidebar"
      id="{{ baseId }}_layout_sidebar"
      data-deskproapp="person-sidebar"
      data-deskproapp-render="legacy-sidebar"
      data-deskproapp-render-sidebar="#{{ baseId }}_layout_sidebar"
      data-deskproapp-render-icons="#{{ baseId }}_layout_sidebar_icons > ul:first-child"
>
    <span class="pin-btn"><i class="fa fa-lock"></i><i class="fa fa-chevron-right"></i></span>
    <div class="dp-app-context dp-app-v2-container" data-deskproapp-marker></div>
</div>

{# the sidebar sizer is disabled for at the moment and the plan is to completely remove it #}
{#<div class="layout-sidebar-sizer" id="{{ baseId }}_layout_sidebar_sizer"></div>#}

{# Page Containers #}
<div id="{{ baseId }}_layout_content" class="profile layout-content {% if not perms.edit %}perm-no-edit{% endif %} {% if not perms.delete %}perm-no-delete{% endif %}">
    <div class="dp-page-content">
        {# /Page Containers #}

        <header class="page-header">
            <div id="{{ baseId }}_layout_sidebar_icons" class="layout-sidebar-icons">
                <ul></ul>
            </div>
            {{ dp_app_loc(baseId, 'header.top') }}
            <div data-deskproapp="person-header-top"></div>
            <table cellspacing="0" cellpadding="0" width="100%">
                <tr>
                    <td width="60">
                        <div class="person-picture-box tipped" style="cursor:pointer"
                             title="{{ phrase('agent.general.click_to_upload_picture') }}"
                             id="{{ baseId }}_change_user_picture">
                            <img src="{{ person.getPictureUrl(60) }}" id="{{ baseId }}_picture_display" />
                            {% if person.is_disabled %}<span class="person-disabled"></span>{% endif %}
                        </div>
                    </td>
                    <td>
                        <div class="titlewrap">
                            <h4 class="id-number">#{{ person.id }}</h4>
                            <h1>
                                <span id="{{ baseId }}_showname">{{ person.getNameWithTitle() }}</span>
                                <span id="{{ baseId }}_editname" style="display: none">
					{% set titles = [
                    phrase('agent.people.title_mr'),
                    phrase('agent.people.title_miss'),
                    phrase('agent.people.title_mrs'),
                    phrase('agent.people.title_ms'),
                    phrase('agent.people.title_dr'),
                    phrase('agent.people.title_hon'),
                    phrase('agent.people.title_prof'),
                    phrase('agent.people.title_rev')
                    ] %}
                                    <input type="text" name="title_prefix" id="{{ baseId }}_edittitle"
                                           value="{{ person.title_prefix }}" data-choices="{{ titles|join(', ') }}"
                                           style="width: 90px" />
					<input type="text" placeholder="{{ phrase('agent.people.enter_name_here') }}" name="name"
                           value="{{ person.getDisplayName() }}" />
				</span>
                                {% if perms.edit %}<span id="{{ baseId }}_editname_start"
                                                         class="edit-name-gear {% if person.getDisplayName() is empty %}auto-click{% endif %}"></span>{% endif %}
                                <a id="{{ baseId }}_editname_end" class="edit-name-save clean-white"
                                   style="display: none">{{ phrase('agent.general.done') }}</a>
                            </h1>
                            <div class="labels-line">
                                {% if person.labels|length or perms.edit %}
                                    <input
                                          type="hidden"
                                          id="{{ baseId }}_labels_input"
                                          class="dpe_select dpe_select_noborder"
                                          data-select-width="auto"
                                          data-placeholder="{{ phrase('agent.general.add_a_label') }}"
                                          value="{% for label in person.labels %}{{ label.label }},{% endfor %}"
                                          data-allow-new="{% if app.user.hasPerm('agent_people.create_labels') %}1{% endif %}"
                                    />
                                {% endif %}
                            </div>
                        </div>
                    </td>
                </tr>
            </table>

            <br class="clear" />
            <div class="meta-line">
                <nav class="actions" id="{{ baseId }}_action_buttons">
                    <ul>
                        {% if app.user.hasPerm('agent_tickets.create') %}
                            <li class="create-ticket"><a
                                      class="clean-white large">{{ phrase('agent.general.create_ticket') }}</a></li>
                        {% endif %}
                        {% if perms.merge %}
                            <li class="merge menu-fitted">
                                <a dp-menu="merge-menu-{{ baseId }}"
                                   class="clean-white large arrow">{{ phrase('agent.general.merge') }} <em></em></a>
                            </li>
                        {% endif %}
                        {% if perms.login_as %}
                            <li><a class="clean-white large"
                                   href="{{ path('agent_people_login_as', {'person_id': person.id, '_rt': security_token('request_token', 10800)}) }}"
                                   target="_blank">{{ phrase('agent.people.login_as_user') }}</a></li>
                        {% endif %}
                        {% if not person.is_agent and (perms.reset_password or perms.delete or perms.edit) %}
                            <li class="more menu-fitted" data-menu-button="> a"><a
                                      class="clean-white large arrow">{{ phrase('agent.general.more') }} <em></em></a>
                            </li>
                        {% endif %}
                    </ul>
                </nav>
            </div>
            <br class="clear" />

            <ul id="{{ baseId }}_more_actions_menu" style="display: none;">
                {% if perms.disable %}
                    {% if person.is_disabled %}
                        <li data-action="enable-user"
                            data-flip="{{ phrase('agent.people.disable_account') }}">{{ phrase('agent.people.enable_account') }}</li>
                    {% else %}
                        <li data-action="disable-user"
                            data-flip="{{ phrase('agent.people.enable_account') }}">{{ phrase('agent.people.disable_account') }}</li>
                    {% endif %}
                {% endif %}
                {% if perms.reset_password and app.authenticationManager.isDeskPROEnabled('user') %}
                    <li data-action="set-password"
                        class="set-password">{{ phrase('agent.general.set_password') }}</li>{% endif %}

                {% if perms.edit and app.authenticationManager.isDeskPROEnabled('user') %}
                    <li data-action="reset-password"
                        class="reset-password">{{ phrase('agent.general.reset_password') }}</li>
                {% endif %}

                {% if perms.delete %}
                    <li
                          data-action="ban"
                          data-delete-url="{{ path('agent_people_delete', {'person_id': person.id, 'security_token': security_token('delete_person'), ban: 1 }) }}"
                    >
                        {{ phrase('agent.people.delete_user_and_ban_email') }}
                    </li>
                    <li
                          data-action="delete"
                          data-delete-url="{{ path('agent_people_delete', {'person_id': person.id, 'security_token': security_token('delete_person') }) }}"
                          class="delete-trigger"
                    >
                        {{ phrase('agent.people.delete_user') }}
                    </li>
                    <li
                          data-action="upload-vcard"
                          class="upload-vcard-trigger address"
                    >
                        {{ phrase('agent.people.upload_vcard') }}
                    </li>
                {% endif %}
            </ul>

            <script id="merge-menu-{{ baseId }}" type="text/html">
                <div>
                    <section>
                        <header><strong>Search People</strong></header>
                        <article style="padding: 6px;">
                            <button class="trigger-search dp-btn dp-btn-small" ng-click="merge()">Find</button>
                        </article>
                    </section>
                </div>
                <div ng-if="mergeItems.open.length">
                    <section>
                        <header><strong>Open People</strong></header>
                        <article>
                            <ul>
                                <li ng-repeat="item in mergeItems.open" style="width:100%;float:none;"
                                    ng-mouseenter="highlightIdentity(item.identity)"
                                    ng-mouseleave="removeHighlight()"
                                    ng-click="merge(item.id)">
                                    <a>
                                        <strong>{{ ng_var('item.id') }}</strong>
                                        <span>{{ ng_var('item.title') }}</span>
                                    </a>
                                </li>
                            </ul>
                        </article>
                    </section>
                </div>
                <div ng-if="mergeItems.filter.length">
                    <section>
                        <header><strong>Filter Results</strong></header>
                        <article>
                            <ul>
                                <li ng-repeat="item in mergeItems.filter" style="width:100%;float:none;"
                                    ng-mouseenter="highlightIdentity(item.identity)"
                                    ng-mouseleave="removeHighlight()"
                                    ng-click="merge(item.id)">
                                    <a>
                                        <strong>{{ ng_var('item.id') }}</strong>
                                        <span>{{ ng_var('item.title') }}</span>
                                    </a>
                                </li>
                            </ul>
                        </article>
                    </section>
                </div>
            </script>

            {{ dp_app_loc(baseId, 'header.bottom') }}
            <div data-deskproapp="person-header-bottom"></div>
        </header>

        {{ dp_app_loc(baseId, 'header.after') }}
        <div data-deskproapp="person-header-after"></div>
        {{ dp_app_loc(baseId, 'main.before') }}

        <table class="layout-table" cellspacing="0" cellpadding="0" width="100%">
            <tr>
                <td valign="top" width="60%">
                    <section class="content-col">
                        {% include 'AgentBundle:Person:view-content-col.html.twig' %}
                    </section>
                </td>
                <td valign="top" width="40%">
                    <section class="property-col">
                        {% include 'AgentBundle:Person:view-property-col.html.twig' %}
                    </section>
                </td>
            </tr>
        </table>

        {{ dp_app_loc(baseId, 'main.after') }}
        {{ dp_app_loc(baseId, 'footer') }}
        <div data-deskproapp="person-footer"></div>

        {% include 'AgentBundle:Person:contact-overlay.html.twig' %}

        <div style="display: none">
            <div id="{{ baseId }}_delete_confirm">
                {{ phrase('agent.people.person_delete_confirm') }} <strong
                      class="warning">{{ phrase('agent.people.user_will_be_perm_deleted') }}</strong><br />
                {{ phrase('agent.general.deleted_reason') }}: <input type="text" value="" class="delete-reason"
                                                                     style="width: 200px;" />
                {% if person_object_counts.tickets or person_object_counts.chats %}
                    <br /><br />{{ phrase('agent.people.other_user_content_being_deleted') }}<br />
                    {% if person_object_counts.tickets %}&bull; {{ phrase('agent.general.count_tickets', {count: person_object_counts.tickets}) }}
                        <br />{% endif %}
                    {% if person_object_counts.chats %}&bull; {{ phrase('agent.general.count_chat', {count: person_object_counts.chats}) }}
                        <br />{% endif %}
                {% endif %}
            </div>

            <div id="{{ baseId }}_ban_confirm">
                {{ phrase('agent.people.person_ban_confirm') }} <strong
                      class="warning">{{ phrase('agent.people.user_will_be_perm_deleted_banned') }}</strong><br />
                {{ phrase('agent.general.deleted_reason') }}: <input type="text" value="" class="delete-reason"
                                                                     style="width: 200px;" />
                {% if person_object_counts.tickets or person_object_counts.chats %}
                    <br /><br />{{ phrase('agent.people.other_user_content_being_deleted') }}<br />
                    {% if person_object_counts.tickets %}&bull; {{ phrase('agent.general.count_tickets', {count: person_object_counts.tickets}) }}
                        <br />{% endif %}
                    {% if person_object_counts.chats %}&bull; {{ phrase('agent.general.count_chat', {count: person_object_counts.chats}) }}
                        <br />{% endif %}
                {% endif %}
            </div>

            <div id="{{ baseId }}_reset_password_confirm">
                {{ phrase('agent.people.person_reset_password_confirm') }}
            </div>
        </div>

        {# Page Containers #}
        {% if with_warn_for_email %}
            <div class="full-tab-warn">
                <div class="message">
                    {{ phrase('agent.people.warn_email_address', {'email': with_warn_for_email}) }}
                    <div class="controls">
                        <button class="clean-white dismiss-trigger">{{ phrase('agent.general.okay') }}</button>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</div>
{# /Page Containers #}

<div data-deskproapp="background" style="display: none"></div>
