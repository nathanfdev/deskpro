<div class="log-batch">
    <div
            class="log-row log-{{entry.id}} type-{{ entry.event }}"
            data-log-id="{{ entry.id }}"
            >
        <div class="info">
	        {% if entry.api_key %}
		        {{ phrase('agent.people.updated_by_api_key') }}: {{ entry.api_key }},
            {% elseif entry.person %}
                {{ phrase('agent.general.by')|lower }} <a class="as-popover" data-route="person:{{ path('agent_people_view', {'person_id': entry.person.id}) }}">{{ entry.person.display_name }}</a>,
            {% endif %}
            <time
                {% if not app.isRelativeTimesDisabled() %}class="timeago"{% endif %}
                title="{{ entry.timestamp|date('c', 'UTC') }}"
            >
                {{ entry.timestamp|date('fulltime') }}
            </time>
        </div>

        <div class="{{ entry.event }}">
            {% if 'entity_updated' == entry.event %}
                {{ phrase('agent.general.updated') }}
            {% elseif 'entity_created' == entry.event %}
                {{ phrase('agent.general.created') }}
            {% elseif 'user_merged' == entry.event %}
                {{ phrase('agent.general.merged') }}
            {% endif %}
        </div>
    </div>

    {% if entry.children|length %}
        {% for subentry in entry.getChildren() %}
            {{ include('AgentBundle:Person:changelog-row-content.html.twig', {entry: subentry}) }}
        {% endfor %}
    {% else %}
        {{ include('AgentBundle:Person:changelog-row-content.html.twig', {entry: entry}) }}
    {% endif %}

</div>
