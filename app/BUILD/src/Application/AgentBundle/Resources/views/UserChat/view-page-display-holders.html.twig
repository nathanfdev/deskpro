{% if not baseId %}{% set baseId = el_uid() %}{% endif %}

{% if errors|length %}
	<div class="errors-section">
		{% for error in errors %}
			<div class="error-message subject error-message-on">
				{{ error }}
			</div>
		{% endfor %}
	</div>
{% endif %}

<table cellspacing="0" cellpadding="0" width="100%" class="field-holders-table{% if errors|length %} error{% endif %}">
	{# Custom fields#}
	{% for f in custom_fields %}
		<tbody class="chat_field_{{f.id}} custom-field item" data-field-type="chat_field" data-item-id="{{f.id}}" data-custom-field-handler="{{f.field_handler}}">
			<tr class="mode-display">
				<th width="120">
					<span class="custom-field edit-trigger chat_field_{{f.id}}" data-item-id="{{f.id}}">{{f.title}}:</span>
				</th>
				<td>
					<div class="custom-field content chat_field_{{f.id}}" data-item-id="{{f.id}}" ng-non-bindable>
						{% if not convo.hasCustomField(f.id) %}
							{{ phrase('agent.general.none') }}
						{% else %}
							{{ render_custom_field(f) }}
						{% endif %}
					</div>
				</td>
			</tr>
			<tr class="mode-edit">
				{% if f.field_def.isFormField() %}
					<th width="120">{{ f.title }}:</th>
					<td>
						<div class="custom-field field-input chat_field_{{f.id}}" data-item-id="{{f.id}}" ng-non-bindable>
							{{ render_custom_field_form(f) }}
						</div>
					</td>
				{% else %}
					<td>
						<span class="custom-field edit-trigger chat_field_{{f.id}}" data-item-id="{{f.id}}">{{f.title}}:</span>
					</td>
					<td>
						<div class="custom-field content chat_field_{{f.id}}" data-item-id="{{f.id}}" ng-non-bindable>
							{% if not chat.hasCustomField(f.id) %}
								{{ phrase('agent.general.none') }}
							{% else %}
								{{ render_custom_field(f) }}
							{% endif %}
						</div>
					</td>
				{% endif %}
			</tr>
		</tbody>
	{% endfor %}
</table>
