<script>
    pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.VoiceCallInProgress';
    pageMeta.title = 'Call In Progress';
    pageMeta.callId = '{{ phone_call.id }}';
    pageMeta.tabIdClass = 'voice_tab_{{ phone_call.id }}_{{ call_sid }}';

    {% set baseId = el_uid() %}
    pageMeta.baseId = '{{ baseId }}';
</script>

<div id="{{baseId}}_react_container"></div>
<div id="{{baseId}}_closetab_prompt" style="display:none;">
    <div class="confirm-overlay mass-actions-overlay">
        <div class="overlay-title">
            <h4>Leave call?</h4>
        </div>
        <div class="overlay-content">
            Are you sure you want to end this call?
        </div>
    </div>
    <div class="overlay-footer prop-footer">
        <button class="clean-white end-trigger">
            End call
        </button>
    </div>
</div>
