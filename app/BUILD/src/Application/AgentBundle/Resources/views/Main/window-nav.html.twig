<!-- BEGIN NAVIGATION -->
<div id="react_dp_side_bar_container"></div>
<div id="react_dp_left_drawer_container"></div>
<div id="dp_nav">
	<div id="dp_nav_sections">
		<ul class="is-nav-section is-default">
			{% if app.user.hasPerm('agent_tickets.use') %}
				<li class="active" id="tickets_section" data-section-handler="DeskPRO.Agent.WindowElement.Section.Tickets"></li>
			{% endif %}

			{% if isChatAvailable() and app.user.hasPerm('agent_chat.use') %}
				<li  id="chat_section" data-section-handler="DeskPRO.Agent.WindowElement.Section.UserChat"></li>
			{% endif %}

			{% if app.user.hasPerm('agent_people.use') %}
				<li id="people_section" data-section-handler="DeskPRO.Agent.WindowElement.Section.People"></li>
			{% endif %}

			{% if brand_app_settings['core.apps_feedback']  %}
				<li id="feedback_section" data-section-handler="DeskPRO.Agent.WindowElement.Section.Feedback"></li>
			{% endif %}

			<li id="publish_section" data-section-handler="DeskPRO.Agent.WindowElement.Section.Publish"></li>

			{% if app.getSetting('core.apps_tasks') and app.user.hasPerm('agent_tasks.use')  %}
				<li id="tasks_section" data-section-handler="DeskPRO.Agent.WindowElement.Section.Tasks"></li>
			{% endif %}

			{% if (app.getConfig('enable_twitter') and app.user.getTwitterAccountIds()|length) %}
				<li id="twitter_section" data-section-handler="DeskPRO.Agent.WindowElement.Section.Twitter"></li>
			{% endif %}
		</ul>
	</div>
</div>
{% if app.user.can_reports %}
	<script
			id="reports_interface_trigger"
			data-frame-url="{{ app.request.getBaseUrl() }}/reports"
			data-element-handler="DeskPRO.Agent.ElementHandler.OverlayFrame"
			data-frame-id="reports"
			data-win-title="DeskPRO Reports Interface"
	></script>
	<script
			id="reports2_interface_trigger"
			data-frame-url="{{ app.request.getBaseUrl() }}/agent/reports-interface#/"
			data-element-handler="DeskPRO.Agent.ElementHandler.OverlayFrame"
			data-frame-id="reports-interface"
			data-win-title="DeskPRO Reports Interface"
	></script>
{% endif %}
{% if app.user.can_admin %}
	<script
			id="billings_interface_trigger"
			data-frame-url="{{ app.request.getBaseUrl() }}/admin/#/license"
			data-element-handler="DeskPRO.Agent.ElementHandler.GoToBilling"
			data-win-title="DeskPRO Billing"
	></script>
	<script
			id="admin_interface_trigger"
			data-frame-url="{{ app.request.getBaseUrl() }}/admin/admin-interface"
			data-frame-preload="true"
			data-element-handler="DeskPRO.Agent.ElementHandler.OverlayFrame"
			data-frame-id="admin"
			data-win-title="DeskPRO Admin Interface"
	></script>
{% endif %}
<!-- END NAVIGATION -->
