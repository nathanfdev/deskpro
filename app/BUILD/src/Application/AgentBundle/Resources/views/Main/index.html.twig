<!DOCTYPE html>
<html lang="en" class="person-{{ app.user.id }} {% for ug in app.user.usergroups %}person-ug-{{ ug.id }}{% endfor %}">
<head>
	<meta http-equiv="X-UA-Compatible" content="IE=Edge,chrome=1" />
	<meta charset="utf-8" />
	<meta name="robots" content="noindex,nofollow" />
	<meta name="viewport" content="width=device-width, height=device-height, user-scalable=yes, initial-scale=1.0" id="dp_meta_viewport" />
	<meta name="google" content="notranslate" />
	{% include 'AgentBundle:Main:ios-app-banner.html.twig' %}
	<script type="text/javascript">
		(function() {
			var h = 'device-height';
			var w = 'device-width';
			var d = false;

			if (window.innerWidth < 1000) {
				w = '1000';
				d = true;
			}
			if (window.innerHeight < 750) {
				h = 700;
				d = true;
			}

			if (d) {
				var vp = document.getElementById('dp_meta_viewport');
				if (vp) {
					vp.setAttribute('content','height='+h+', width='+w+', user-scalable=yes, initial-scale=1.0');
				}
			}
		})();
	</script>

	<style type="text/css">
		body,html {
			-ms-touch-action: none;
		}
	</style>

	<script type="text/javascript">var DP_IS_DOMDUMP_VIEW = false;</script>
	<script type="text/javascript">
		{% if app.isDebug() %}
			DP_DEBUG = true;
		{% else %}
			DP_DEBUG = false;
		{% endif %}

		{% if app.isCloud() %}
			DPC_IS_CLOUD = true;
		{% else %}
			DPC_IS_CLOUD = false;
		{% endif %}

		window.IS_BILLING_ERROR = {% if is_billing_error %}true{% else %}false{% endif %};

		window.DP_LOADED_TIME = (new Date()).getTime() / 1000;

		if (!window.console) window.console = {};
		if (!window.console.error) window.console.error = function(){};
		if (!window.console.log)   window.console.log   = function(){};
		if (!window.console.warn)  window.console.warn  = function(){};
		if (!window.console.info)  window.console.info  = function(){};
		if (!window.console.debug) window.console.debug = function(){};
		if (!window.console.trace) window.console.trace = function(){};
	</script>

	{% include 'AgentBundle:Main:page-vars.html.twig' %}

	{% if not app.user.timezone or app.user.timezone == 'UTC' %}
		<script type="text/javascript" src="{{ asset('vendor/detect_timezone.js') }}"></script>
	{% endif %}

	<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/CurrentTs.js?' ~ el_uid()) }}"></script>
	<script type="text/javascript">
		if (window.DP_LOAD_TIME_TS) {
			if (!DP_IS_DOMDUMP_VIEW) {
				(function() {
					var lastTime = (new Date()).getTime();

					setInterval(function() {
						var currentTime = (new Date()).getTime();
						if (currentTime > (lastTime + 360000)) {
							// Probably just woke up from sleep
							window.location.reload(false);
						}
						lastTime = currentTime;
					}, 240000);
				})();

				(function() {
					var now_ts = window.DP_LOAD_TIME_TS;
					var diff = Math.abs(now_ts - {{ 'now'|date('U') }});

					if (diff > 1200) {
						DESKPRO_TIME_OUT_OF_SYNC = diff;
						console.log("Time is off by %s seconds", diff);

						if (DESKPRO_TIME_OUT_OF_SYNC_IGNORE && Math.abs(diff - DESKPRO_TIME_OUT_OF_SYNC_IGNORE) < 480) {
							DESKPRO_TIME_OUT_OF_SYNC = null;
							console.log("Time offset is ignored");
						}
					}

					{% if is_first_login %}
						DESKPRO_TIME_OUT_OF_SYNC = null;
					{% endif %}
				})();
			}
		}
	</script>

	{% if app.getSetting('core.favicon_blob_id') %}
		<link rel="shortcut icon" id="favicon" href="{{ path('favicon', {}, true) }}" />
	{% else %}
		<link rel="icon" type="image/png" sizes="16x16" href="{{ asset('DeskPRO/Bundle/AppBundle/Resources/img/favicon-16x16.png', 'appsrc_assets') }}" />
		<link rel="icon" type="image/png" sizes="24x24" href="{{ asset('DeskPRO/Bundle/AppBundle/Resources/img/favicon-24x24.png', 'appsrc_assets') }}" />
		<link rel="icon" type="image/png" sizes="32x32" href="{{ asset('DeskPRO/Bundle/AppBundle/Resources/img/favicon-32x32.png', 'appsrc_assets') }}" />
		<link rel="icon" type="image/png" sizes="32x32" href="{{ asset('DeskPRO/Bundle/AppBundle/Resources/img/favicon-64x64.png', 'appsrc_assets') }}" />
		<link rel="icon" type="image/png" sizes="96x96" href="{{ asset('DeskPRO/Bundle/AppBundle/Resources/img/favicon-96x96.png', 'appsrc_assets') }}" />
	{% endif %}

	<title>{{ phrase('agent.interface.deskpro_agent_interface') }}</title>
	<style type="text/css">
	body {
		overflow: hidden;
		background: #fff !important;
	}
	#agent_chats_wrapper, #agent_chat_panel {
		display: none;
	}

	#dp_loading {
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		left: 0;
		z-index: 1000000000;
		background: #3297CE;
		background-image: radial-gradient(circle, #3297ce, #2d88be, #2779ae, #226a9e, #1c5c8e);
		text-align: center;
	}

	#dp_loading .msg-outer {
		width: 250px;

		position: absolute;
		top: 50%;
		left: 50%;
		margin-top: -120px;
		margin-left: -125px;
	}

	#dp_loading .msg {
		-webkit-border-radius: 3px;
		-moz-border-radius: 3px;
		border-radius: 3px;
		background: #ffffff;

		box-shadow: 0 3px 5px rgba(0, 0, 0, 0.4);
		-moz-box-shadow: 0 3px 5px rgba(0, 0, 0, 0.4);
		-webkit-box-shadow: 0 3px 5px rgba(0, 0, 0, 0.4);

		padding:  25px;
		text-align: center;
	}

	#dp_loading h1 {
		font-family: "Helvetica Neue", Helvetica, arial, sans-serif;
		font-size: 15px;
		color: rgba(0,0,0,0.9);
		width: 100%;
		display: inline-block;
		text-align: center;

		background: url({{ asset('images/spinners/logo-loading.svg') }}) no-repeat 50% 0;
		background-size: 50%;

		margin: 0;
		padding: 0;
		padding-top: 108px;
	}

	{# Agent links that are us dont appear clickable #}
	.agent-link[data-agent-id="{{ app.user.id }}"]:hover, .agent-link[data-agent-id="0"]:hover {
		text-decoration: none;
		cursor: text;
	}
	</style>
	<script type="text/javascript" src="{{ asset('vendor/html5shiv.min.js') }}"></script>
	<script type="text/javascript" src="{{ asset('app-build/clipboard.min.js') }}"></script>
</head>
<body class="dp {% if is_demo %}is-demo{% endif %} {% if is_billing_error %}with-billing-error{% endif %}"
      ng-class="{
        'panevis-source-on': paneVis.source,
        'panevis-source-off': !paneVis.source,
        'panevis-tabs-on': paneVis.tabs,
        'panevis-tabs-off': !paneVis.tabs,
        'panevis-list-on': paneVis.list,
        'panevis-list-off': !paneVis.list
      }"
        >
<script type="text/javascript">
	(function() {
		var ua = navigator.userAgent.toLowerCase();
		var is_ios = /(iPhone|iPod|iPad).*AppleWebKit/i.test(navigator.userAgent);
		var is_android = ua.indexOf("android") > -1;

		if (is_ios || is_android) {
			window.DP_NO_JS_SCROLL = true;
			document.body.className = document.body.className + " dp_no_js_scroll";
		}
	})();
</script>

<div id="dp_loading" class="window-loading-indicator"><div class="msg-outer"><div class="msg"><h1>{{ phrase('agent.general.loading_interface') }}</h1></div></div></div>
<div id="dp_window" ng-init="
    routes = {
        ticket: 'ticket:{{ path('agent_ticket_view', {'ticket_id': '0000'})|raw }}',
        person: 'person:{{ path('agent_people_view', {'person_id': '0000'})|raw }}',
        organization: 'page:{{ path('agent_org_view', {'organization_id': '0000'})|raw }}'
    };
    app_person_id = {{ app.user.id }};
    ">
	<div id="react_dp_agent_onboarding_container"></div>
{% include 'AgentBundle:Main:window-header.html.twig' %}
{% include 'AgentBundle:Main:window-nav.html.twig' %}
{% include 'AgentBundle:Main:window-col-layout.html.twig' %}
{% if not app.hasBeta('agent_chat') %}
	{% include 'AgentBundle:Main:window-chat.html.twig' %}
{% endif %}

{####################
 # RESOURCE LOADING
 ####################}

{% include 'AgentBundle:Main:global-templates.html.twig' %}

{# /dp_window #}
</div>

<audio preload="preload" loop="loop">
	<source src="{{ asset('sounds/new-chat.mp3') }}" />
	<source src="{{ asset('sounds/new-chat.ogg') }}" />
</audio>
<div id="volume_controls_back"></div>
<div id="volume_controls">
	<div class="slider"></div>
	<span class="mute-toggle tipped" id="sound_icon_in" title="{{ phrase('agent.interface.toggle_mute') }}"></span>
</div>

<div id="reload_overlay" style="display: none;">
	<table cellspacing="0" cellpadding="0" width="100%" height="100%"><tr><td width="100%" height="100%" valign="middle" align="center" style="vertical-align: middle; text-align: center">
		<article>
			<strong id="reload_overlay_updates" style="display: none; font-size: 11pt; position:relative; top: -3px;">
				{{ phrase('agent.general.performing_updates') }}
			</strong>
			<h3>{{ phrase('agent.general.please_wait') }}</h3>
		</article>
	</table>
</div>

{% if is_first_login %}
	{% include 'AgentBundle:Settings:welcome.html.twig' %}
{% endif %}

{{ js_error_tracking('agent_interface') }}
{% include 'AgentBundle:Main:resources.html.twig' with {'in_body': true} %}
{% include 'AgentBundle:Settings:settings-window.html.twig' %}
{% include 'AgentBundle:MediaManager:media-window.html.twig' %}
{% include 'AgentBundle:Main:page-init.html.twig' %}

{% include 'AgentBundle:Main:custom-page-init.html.twig' %}

