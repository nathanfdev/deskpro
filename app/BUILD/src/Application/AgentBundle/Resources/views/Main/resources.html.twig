<script	type="text/javascript" src="{{ path('agent_requirejs_loader') }}?v={{ app.getBuildTime() }}"></script>
<script	type="text/javascript">
	// Otherwise will try to re-load jquery
	// which will be 2.11 which doesnt support ie8
	// and some plugins in the agent interface dont support it either
	define("jquery", function() {
		return window.jQuery;
	});
</script>
