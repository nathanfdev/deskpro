	<script type="text/javascript" src="{{ asset('vendor/less/less.min.js') }}"></script>

	<style type="text/css">
		#dp_right_collapsed ul li span {
			left: 22px;
		}
	</style>
{% else %}
	{{ dp_asset_html('agent') }}
	{{ dp_asset_html('agent_vendor_out_css') }}
	{{ dp_asset_html('agent_css1') }}
