{######################################################################## #}
{# Tickets #}
{######################################################################## #}

<% if (group.type == 'ticket') { var ticket = result; var ticket_display = ticket; %>
	<article class="row-item no-check" route-notabreload="1" data-route="ticket:{{ path('agent_ticket_view', {'ticket_id': '0000'})|replace({'0000': '<%- ticket.id %>'})|raw }}">
		<div class="top-row">
			<div class="top-row-left">
				<h3>
					<span class="obj-id">#<%- ticket.id %></span>
					<a class="subject click-through">
						<%- ticket.subject %>
					</a>
				</h3>
			</div>
			<div class="top-row-right">
				<div class="bound-fade"></div>
				<% if (ticket_display.is_hold) { %><div class="on-hold">{{ phrase('agent.tickets.on_hold') }}</div><% } %>
				<div class="status-pill status urgency-<%= ticket_display.urgency %> <%= ticket_display.status %> <%= ticket_display.status %>_<%= ticket_display.hidden_status %>">
					<% if (ticket_display.status == 'awaiting_agent') { %>
						<label>{{ phrase('agent.tickets.status_awaiting_agent') }}</label>
					<% } %>
					<% if (ticket_display.status == 'awaiting_user') { %>
						<label>{{ phrase('agent.tickets.status_awaiting_user') }}</label>
					<% } %>
					<% if (ticket_display.status == 'resolved') { %>
						<label>{{ phrase('agent.tickets.status_resolved') }}</label>
					<% } %>
					<% if (ticket_display.status == 'archived') { %>
						<label>{{ phrase('agent.tickets.status_archived') }}</label>
					<% } %>
					<% if (ticket_display.status == 'hidden' && !ticket_display.hidden_status) { %>
						<label>{{ phrase('agent.tickets.status_hidden') }}</label>
					<% } %>
					<% if (ticket_display.status == 'hidden' && ticket_display.hidden_status == 'deleted') { %>
						<label>{{ phrase('agent.tickets.status_hidden_deleted') }}</label>
					<% } %>
					<% if (ticket_display.status == 'hidden' && ticket_display.hidden_status == 'spam') { %>
						<label>{{ phrase('agent.tickets.status_hidden_spam') }}</label>
					<% } %>

					<% if (ticket_display.status == 'awaiting_agent') { %>
						<i class="ticket-urgency"><%= ticket_display.urgency %></i>
					<% } %>
				</div>

				<% if (ticket_display.agent) { %>
					<span class="tipped agent-inline-icon" title="<%- ticket_display.agent.display_name %>" style="background-image: url('<%- ticket_display.agent.picture_url_16 %>'); width:16px; height: 16px;"></span>
				<% } %>

				<% if (ticket_display.flag) { %>
					<i class="flag <%= ticket_display.flag %>"></i>
				<% } %>
				<br class="clear" />
			</div>
		</div>
		<div class="userinfo">
			<a class="name click-through" route-notabreload="1" data-route="person:{{ path('agent_people_view', {'person_id': '0000'})|replace({'0000': '<%= ticket.person.id %>'})|raw }}" data-route-title="@selector(.person-tip)">
			<span class="with-icon" style="background-image: url('<%- ticket.person.picture_url_16 %>');"><%- ticket.person.display_name %></span></a>
			<span class="email" ng-if="result.person.primary_email">&lt;<%- ticket.person.primary_email.email %>&gt;</span>
			<div class="bound-fade"></div>
		</div>
	</article>
<% } %>

{######################################################################## #}
{# People #}
{######################################################################## #}

<% if (group.type == 'person') { var person = result; %>
<article class="row-item single-row" route-notabreload="1" data-route="person:{{ path('agent_people_view', {'person_id': '0000'})|replace({'0000': '<%= person.id %>'})|raw }}">
	<div class="userinfo" style="height: auto; overflow: auto;">
		<a class="name click-through" route-notabreload="1" data-route="person:{{ path('agent_people_view', {'person_id': '0000'})|replace({'0000': '<%= person.id %>'})|raw }}" data-route-title="@selector(.person-tip)">
			<span class="with-icon" style="background-image: url('<%- person.picture_url_16 %>');"><%- person.display_name %></span></a>
		<span class="email" ng-if="result.primary_email">&lt;<%- (person.primary_email || {}).email %>&gt;</span>
		<div class="bound-fade" style="width: auto;">
			<% if (person.tickets_count > 0) { %>
                <span class="sub-items-link" ng-click="loadPersonTickets(result); $event.stopPropagation()">
					<%- person.tickets_count + ' Ticket' + (1 === person.tickets_count ? '' : 's') %>
				</span>
			<% } %>
            <span class="sub-items-link" style="margin-right: 5px;" data-route="page:{{ path('agent_ticket_new', {person_id: '0000'})|replace({'0000': '<%= person.id %>'})|raw }}">
                + Ticket
            </span>
		</div>
	</div>
</article>
<div ng-if="expandedPerson && result === expandedPerson && expandedPerson.tickets && expandedPerson.tickets.length">
	<article ng-repeat="ticket in result.tickets" class="row-item single-row sub-item" route-notabreload="1" data-route="ticket:{{ path('agent_ticket_view', {'ticket_id': '0000'})|replace({'0000': '{{ ticket.id }}'})|raw }}">
		<div class="top-row">
			<div class="top-row-left">
				<h3>
					<span class="obj-id">#{{ ng_var('ticket.id') }}</span>
					<a class="subject click-through">
						{{ ng_var('ticket.subject') }}
					</a>
				</h3>
			</div>
			<div class="top-row-right">
				<div class="on-hold" ng-if="ticket.is_hold">{{ phrase('agent.tickets.on_hold') }}</div>
				<div class="status-pill status urgency-{{ ng_var('ticket.urgency') }} {{ ng_var('ticket.status') }}">
					<span ng-switch="ticket.status">
						<label ng-switch-when="awaiting_agent">{{ phrase('agent.tickets.status_awaiting_agent') }}</label>
						<label ng-switch-when="awaiting_user">{{ phrase('agent.tickets.status_awaiting_user') }}</label>
						<label ng-switch-when="resolved">{{ phrase('agent.tickets.status_resolved') }}</label>
						<label ng-switch-when="archived">{{ phrase('agent.tickets.status_archived') }}</label>
						<label ng-switch-when="hidden">{{ phrase('agent.tickets.status_hidden') }}</label>
					</span>

					<i ng-if="ticket.status == 'awaiting_agent'" class="ticket-urgency">{{ ng_var('ticket.urgency') }}</i>
				</div>
			</div>
		</div>
	</article>
	<article ng-if="result.tickets && result.tickets_count > 15" class="row-item single-row sub-item" ng-click="openAllTickets(result); $event.stopPropagation()">
		<div class="top-row">
			<div class="top-row-left">
				<h3>
					<a class="subject click-through">
						View all <%- person.tickets_count %> tickets
					</a>
				</h3>
			</div>
		</div>
	</article>
</div>
<% } %>

{######################################################################## #}
{# Organization #}
{######################################################################## #}

<% if (group.type == 'organization') { var org = result; %>
<article class="row-item single-row" route-notabreload="1" data-route="page:{{ path('agent_org_view', {'organization_id': '0000'})|replace({'0000': '<%- org.id %>'})|raw }}">
    <div class="userinfo">
        <span class="obj-id">#<%- org.id %></span>
        <a class="subject click-through">
            <%- org.name %>
        </a>
        <% if (org.members > 0) { %>
        <div class="bound-fade">
            <span class="sub-items-link" ng-click="loadOrgMembers(result); $event.stopPropagation()">
                <%- org.members + ' ' + (1 === org.members ? 'Member' : 'Members') %>
            </span>
        </div>
        <% } %>
    </div>
</article>
<div ng-if="expandedOrg && result === expandedOrg && expandedOrg.members_data && expandedOrg.members_data.length">
    <article ng-repeat="person in result.members_data" class="row-item single-row sub-item" route-notabreload="1" data-route="person:{{ path('agent_people_view', {'person_id': '0000'})|replace({'0000': '{{ person.id }}'})|raw }}">
        <div class="top-row">
            <div class="top-row-left" style="width: auto;">
                <h3>
                    <a class="name click-through">
                        <span class="with-icon" style="background-image: url('{{ ng_var('person.picture_url_16') }}');">
                            {{ ng_var('person.display_name') }}
                        </span>
                    </a>
                    <span class="email" ng-if="person.primary_email">
                        &lt;{{ ng_var('(person.primary_email || {}).email') }}&gt;
                    </span>
                </h3>
				<span class="sub-items-link" style="right: 5px; top: -17px;"
					  data-route="page:{{ path('agent_ticket_new', {person_id: '0000'})|replace({'0000': '{{ person.id }}'})|raw }}"
				>
					+ Ticket
				</span>
            </div>
        </div>
    </article>
    <article ng-if="result.members_data && result.members > 15" class="row-item single-row sub-item" ng-click="openAllMembers(result); $event.stopPropagation()">
        <div class="top-row">
            <div class="top-row-left">
                <h3>
                    <a class="subject click-through">
                        View all <%- org.members %> members
                    </a>
                </h3>
            </div>
        </div>
    </article>
</div>
<% } %>

{######################################################################## #}
{# Chat #}
{######################################################################## #}

<% if (group.type == 'chat_conversation') { var chat = result; %>
<article class="row-item no-check" route-notabreload="1" data-route="page:{{ path('agent_userchat_view', {'conversation_id': '0000'})|replace({'0000': '<%- chat.id %>'})|raw }}">
	<div class="top-row">
		<div class="top-row-left">
			<h3>
				<span class="obj-id">#<%- chat.id %></span>
				<a class="subject click-through">
					<%- chat.subject %>
				</a>
			</h3>
		</div>
		<div class="top-row-right">
			<div class="bound-fade"></div>

			<% if (chat.agent) { %>
			<span class="tipped agent-inline-icon" title="<%- chat.agent.display_name %>" style="background-image: url('<%- chat.agent.picture_url_16 %>'); width:16px; height: 16px;"></span>
			<% } %>

			<br class="clear" />
		</div>
	</div>
	<div class="userinfo">
		<% if (chat.person) { %>
			<a class="name click-through" route-notabreload="1" data-route="person:{{ path('agent_people_view', {'person_id': '0000'})|replace({'0000': '<%= chat.person.id %>'})|raw }}" data-route-title="@selector(.person-tip)">
				<span class="with-icon" style="background-image: url('<%- chat.person.picture_url_16 %>');"><%- chat.person.display_name %></span></a>
			<span class="email">&lt;<%- chat.person.primary_email.email %>&gt;</span>
		<% } else { %>
			Anonymous
		<% } %>
		<div class="bound-fade"></div>
	</div>
</article>
<% } %>

