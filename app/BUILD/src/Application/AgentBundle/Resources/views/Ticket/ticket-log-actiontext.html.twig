{% elseif log.action_type == 'feedback_link_removed' %}
	<span class="type">{{ phrase('agent.tickets.log_feedback_link_removed') }}</span>
	<span class="old-val">{{ phrase('agent.general.id') }} {{log.id_before}}</span>
{% elseif log.action_type == 'task_created' %}
	<span class="type">{{ phrase('agent.tasks.task_created') }}</span>
	<span class="new-val">{{log.details.task_id}}: {{ log.details.task_title}}</span>
{% elseif log.action_type == 'call.recording_downloaded' %}
	<span class="type">
		[{{ log.details.duration|date('H:i:s', '+00:00 GMT') }}] {{ phrase('agent.voice.recording_downloaded') }}
        {% if ticket_perms.modify_messages %}
			<a class="delete-record" href="{{ path('voice_phone_call_delete_record', {'phoneCall': log.id_object}) }}">({{ phrase('agent.voice.delete_record') }})</a>
		{% endif %}
	</span>
{% elseif log.action_type == 'call.recording_deleted' %}
	<span class="type">
		{{ phrase('agent.voice.record_deleted', {'phoneCallId': log.id_object}) }} ({{ log.details.filesize }} Kb)
	</span>
{% elseif not hide_unknow %}
	{{ log.action_type }}
{% endif %}
