<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.NewTicket';
pageMeta.title = '{{ phrase('agent.general.new_ticket') }}';
pageMeta.ticket_id = 0;
pageMeta.linked_ticket = {{ ticket.id|default(0) }};

pageMeta.labelsAutocompleteUrl        = '{{ path('agent_ajax_labels_autocomplete', {'label_type': 'ticket'}) }}';
pageMeta.uploadAttachUrl              = '{{ path('agent_accept_upload') }}';

pageMeta.auto_start_bill = {% if app.getSetting('core_tickets.enable_timelog') and app.getSetting('core_tickets.billing_auto_timer') %}true{% else %}false{% endif %};

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>

<script>
    $('.hijri input').calendarsPicker({calendar: $.calendars.instance('islamic')});
</script>
<div class="layout-content page-new-ticket page-new-content">
<div class="dp-page-content">

<a class="tab-anchor" href="#">&nbsp;</a>

<form id="{{baseId}}_newticket" class="keybound-submit">

<input type="hidden" name="for_comment_type" id="{{baseId}}_for_comment_type" value="" />
<input type="hidden" name="for_comment_id" id="{{baseId}}_for_comment_id" value="" />
<input type="hidden" name="for_chat_id" id="{{baseId}}_for_chat_id" value="" />
<input type="hidden" name="parent_ticket_id" id="{{baseId}}_parent_ticket_id" value="{{ ticket.id|default('0') }}" />
<input type="hidden" id="{{baseId}}_action" name="options[action]" value="" />
<input type="hidden" id="{{baseId}}_snippet_ids" name="options[snippet_ids]" value="" />

<div class="pending-info comment" style="display: none;">
	<i class="reset"></i>
	<h3>{{ phrase('agent.tickets.creating_a_ticket_for') }}: <span id="{{baseId}}_comment_title"></span></h3>
	<div class="pending-item pending-ticket">
		<div class="about">{{ phrase('agent.tickets.commented_on') }}: <a data-route="" class="with-route ticket-link" id="{{baseId}}_comment_object_link"></a></div>
		<div class="post-action">
			<select name="comment_action" id="{{baseId}}_comment_action">
				<option value="delete">{{ phrase('agent.general.delete') }}</option>
				<option value="approve">{{ phrase('agent.general.approve') }}</option>
			</select>
			{{ phrase('agent.tickets.coment_after_ticket_created') }}
		</div>
	</div>
</div>

<div class="errors-section" id="{{baseId}}_error_section" style="display: none;">
	<div style="display:none;" class="error-message subject">&bull; {{ phrase('agent.tickets.please_enter_subject') }}</div>
	<div style="display:none;" class="error-message person_id person_no_user">&bull; {{ phrase('agent.tickets.please_choose_or_create_user') }}</div>
	<div style="display:none;" class="error-message person_email_address">&bull; {{ phrase('agent.general.error_email_address') }}</div>
	<div style="display:none;" class="error-message person_email_address_gateway">&bull; {{ phrase('agent.tickets.email_is_ticket_account') }}</div>
	<div style="display:none;" class="error-message brand_id">&bull; {{ phrase('agent.general.select_a_brand') }}</div>
	<div style="display:none;" class="error-message department_id">&bull; {{ phrase('agent.general.select_a_department') }}</div>
	<div style="display:none;" class="error-message message">&bull; {{ phrase('agent.general.enter_a_message') }}</div>
	<div style="display:none;" class="error-message person_disabled">&bull; {{ phrase('agent.tickets.user_is_disabled') }}</div>
	<div style="display:none;" class="error-message free" id="{{ baseId }}_freemessage"></div>
</div>

{% if ticket.id %}
	<div class="pending-info ticket">
		{{ phrase('agent.tickets.linking_with_ticket') }} {{ ticket.subject }}
	</div>
{% endif %}

<div class="pending-info chat" style="display: none; padding: 7px; background: #FFFEFE; border-bottom: 1px solid #9CA7B1; font-size: 11px;">
	{{ phrase('agent.tickets.linking_with_chat') }} <span id="{{ baseId }}_chat_title"></span>
</div>

<div class="profile-box-container reply-box-wrap" style="position: relative">
	<header>
		<div class="controls">
			<button class="switch-user" id="{{baseId}}_switch_user" style="display: none">{{ phrase('agent.general.change_user') }}</button>
		</div>
		<nav data-element-handler="DeskPRO.ElementHandler.SimpleTabs"><ul>
			<li data-tab-for="#{{baseId}}_user_section">{{ phrase('agent.general.user') }}</li>
			<li data-tab-for="#{{baseId}}_cc_section">{{ phrase('agent.general.ccs') }}</li>
		</ul></nav>
	</header>
	<section id="{{baseId}}_user_section" class="user-section">
		<div id="{{baseId}}_choose_user" style="padding: 10px">
			<div
				id="{{baseId}}_user_searchbox"
				data-element-handler="DeskPRO.Agent.ElementHandler.PersonSearchBox"
				data-search-url="{{ path('agent_peoplesearch_performquick', {'format': 'json', 'limit': 10, 'start_with': 'a', 'with_agents': 1}) }}"
				data-highlight-term="1"
				data-touch-focus="1"
				data-search-param="term"
				data-position-bound="#{{baseId}}_userselect"
			>
				<input type="text" name="newticket[person_input_choice]" id="{{baseId}}_userselect" class="select-user term" placeholder="{{ phrase('agent.general.choose_person_for_ticket') }}" />
				<input type="hidden" name="newticket[person][id]" value="{{ person.id }}" class="person-id" id="{{baseId}}_person_id" />

				<script type="text/x-deskpro-tmpl" class="user-row-tpl">
					<li>
						<a>
						<span class="user-name"></span>
						<address>&lt;<span class="user-email"></span>&gt;</address>
						<div class="bound-fade"></div>
					</a></li>
				</script>
				<div class="person-search-box" style="display: none">
					<section>
						<ul class="results-list">

						</ul>
						{% if app.user.hasPerm('agent_people.create') %}
						<footer>
							<span class="create-user">{{ phrase('agent.general.create_a_new_person') }}</span>
						</footer>
						{% endif %}
					</section>
				</div>
			</div>
		</div>
		<div id="{{baseId}}_user_choice">

		</div>
	</section>
	<section id="{{baseId}}_cc_section" style="padding: 10px; display: none;">
		<div class="cc-input">
			<div
				id="{{baseId}}_user_ccbox"
				data-element-handler="DeskPRO.Agent.ElementHandler.PersonSearchBox"
				data-search-url="{{ path('agent_peoplesearch_performquick', {'format': 'json', 'limit': 10, 'start_with': 'a'}) }}"
				data-highlight-term="1"
				data-touch-focus="1"
				data-search-param="term"
				data-position-bound="#{{baseId}}_userccselect"
			>
				<input type="text" id="{{baseId}}_userccselect" class="cc-user term" placeholder="{{ phrase('agent.tickets.search_for_people_to_add') }}" />

				<script type="text/x-deskpro-tmpl" class="user-row-tpl">
					<li>
						<a>
						<span class="user-name"></span>
						<address>&lt;<span class="user-email"></span>&gt;</address>
						<div class="bound-fade"></div>
					</a></li>
				</script>
				<div class="person-search-box" style="display: none">
					<section>
						<ul class="results-list">

						</ul>
						<footer>
							<span class="create-user">{{ phrase('agent.general.create_a_new_person') }}</span>
						</footer>
					</section>
				</div>
			</div>
		</div>
		<ul id="{{baseId}}_cc_list" class="cc-list"></ul>
	</section>
</div>

<div class="profile-box-container reply-box-wrap" style="position: relative">
	<header>
            <nav data-element-handler="DeskPRO.ElementHandler.SimpleTabs">
                <ul>
                    <li data-tab-for="#{{baseId}}_properties_section">{{ phrase('agent.general.properties') }}</li>
                    <li data-tab-for="#{{baseId}}_labels_section">{{ phrase('agent.general.labels') }}</li>
                </ul>
            </nav>
	</header>
	<section class="ticketreply" id="{{baseId}}_properties_section">
		<article id="{{baseId}}_headerbox_box_props" class="headerbox">

			{# ----------------------------------------------------------------------------------------------------- #}

            {% if ticket.agent.id == app.user.id or not ticket.agent %}{% set agent_id = app.user.id %}
            {% else %}{% set agent_id = ticket.agent.id %}{% endif %}

			<table cellspacing="0" cellpadding="0" width="100%">
				<tr>
					<td style="padding-right: 5px;">
						<label class="field-label-title" style="white-space: nowrap">
                            {{ phrase('agent.general.agent') }}
						</label>
						<select id="{{ baseId }}_agent_sel" class="dpe_select" data-style-type="icons"
								data-select-icon-size="22" name="newticket[agent_id]">
								<option {% if not app.getSetting('core_tickets.new_assign') %}selected="selected"{% endif %}
										value="0">{{ phrase('agent.general.unassigned') }}</option>
                            {% for agent in app.getAgentData().getAgentAvatarList() %}
									<option
                                            {% if agent.id == agent_id and app.getSetting('core_tickets.new_assign') == 'assign' %}selected="selected"{% endif %}
											data-icon="{{ agent.getPictureUrl(20) }}"
											value="{{ agent.id }}">{{ agent.display_name }}</option>
                            {% endfor %}
						</select>
					</td>
                    {% if agent_teams|length %}
						<td style="padding-right: 5px;">
							<label class="field-label-title" style="white-space: nowrap">
                                {{ phrase('agent.general.team') }}
							</label>
							<select id="{{ baseId }}_agent_team_sel" class="dpe_select"
									data-select-nogrouptitle="1" data-style-type="icons"
									data-select-icon-size="22" name="newticket[agent_team_id]">
                                {% if not ticket.agent_team %}
									<option value="0"
                                            {% if not app.getSetting('core_tickets.new_assignteam') %}selected="selected"{% endif %}>{{ phrase('agent.general.none') }}</option>
                                {% endif %}

                                {% if app.user.getTeams()|length %}
									<optgroup label="{{ phrase('agent.general.your_teams') }}">
                                        {% set teams = app.user.getTeams() %}
                                        {% for team in agent_teams %}
                                            {% if team in teams %}
												<option value="{{ team.id }}"
														data-icon="{{ team.getAvatarUrl(20) }}"
                                                        {% if app.getSetting('core_tickets.new_assignteam') == 'assign' and (app.user.getPref('agent.ticket_default_team_id') == team.id or not app.user.getPref('agent.ticket_default_team_id')) %}selected="selected"{% endif %}
												>{{ team.name }}</option>
                                            {% endif %}
                                        {% endfor %}
									</optgroup>
                                {% endif %}

                                {% for team in agent_teams %}
                                    {% if team.id not in app.user.getTeamIds() %}
										<option value="{{ team.id }}"
												data-icon="{{ team.getAvatarUrl(20) }}"s>{{ team.name }}</option>
                                    {% endif %}
                                {% endfor %}
							</select>
						</td>
                    {% endif %}
					<td width="100%">
						<label class="field-label-title">
                            {{ phrase('agent.general.followers') }}
                            {% set show = '' %}
                            {% for a in agent_parts if a.person.id == app.user.id %}
                                {% set show = 'display:none;' %}
                            {% endfor %}
                    </span>
						</label>
						<div class="followers-list">
							<ul id="{{ baseId }}_followers_list">
                                {% for a in agent_parts %}
									<li class="agent-{{ a.person.id }}" data-agent-id="{{ a.person.id }}"><a
												class="dp-btn dp-btn-small agent-link"
												data-agent-id="{{ a.person.id }}"><span class="text"
																						style="background-image: url({{ a.person.getPictureUrl(15) }})">{{ a.person.display_name }}</span><span
													class="remove-row-trigger"> <i
														class="icon-remove"></i></span></a></li>
                                {% endfor %}
							</ul>
							<div class="new-follower" id="{{ baseId }}_followers_sel_wrap">
								<select id="{{ baseId }}_followers_sel" class="dpe_select"
										data-style-type="icons" data-select-icon-size="22" name="add_followers[]">
									<option value="0">{{ phrase('agent.general.select_agent') }}</option>
                                    {% for agent in app.getAgentData().getAgentAvatarList() %}
										<option data-icon="{{ agent.getPictureUrl(20) }}"
												value="{{ agent.id }}"
												data-icon-small="{{ agent.getPictureUrl(15) }}">{{ agent.display_name }}</option>
                                    {% endfor %}
								</select>
							</div>
							<a class="new-follower-btn" id="{{ baseId }}_add_follower_btn">
								<i class="icon-signin"></i>
                                {{ phrase('agent.tickets.add_follower') }}
							</a>
						</div>
					</td>
				</tr>
			</table>
			<div class="sep">-</div>


			{# ----------------------------------------------------------------------------------------------------- #}


			<table cellspacing="0" cellpadding="0" width="100%" class="field-holders-table" id="{{baseId}}_fields_container">
				<tbody class="labels-row">
				<tr>
					<th width="150"
						style="vertical-align: middle; padding-top: 0; padding-bottom: 0;">
                        {{ phrase('agent.general.subject') }}:
					</th>
					<td>
						<input type="text" name="newticket[subject]" class="subject" id="{{baseId}}_subject" />
					</td>
				</tr>
				</tbody>

				<tbody>
					{% if brands|length > 1 %}
						<tr>
							<th width="80">{{ phrase('agent.general.brand') }}</th>
							<td>
								{% include 'AgentBundle:Common:select-standard.html.twig' with {
								'name': "newticket[brand_id]",
								'id': baseId ~ '_brand',
								'add_classname': 'brand_id ' ~ add_classname,
								'with_blank': true,
								'categories': brands,
								'selected':   default_brand
								} %}
							</td>
						</tr>
					{% endif %}
					<tr {% if not app.getSetting('using_department') %}style="display: none"{% endif %}>
						<th width="80">{{ phrase('agent.general.department') }}</th>
						<td>
							{% if not ticket.department_id %}
								{% set dep = app.brandDefaultDepartment('agent').getId() %}
							{% else %}
								{% set dep = ticket.department_id %}
							{% endif %}
							{% include 'AgentBundle:Common:select-department.html.twig' with {
								'name': "newticket[department_id]",
								'id': baseId ~ '_dep',
								'departments': app.departments.getPersonDepartments(app.user, 'tickets', [], 'assign'),
								'selected': dep,
								'add_attr': 'data-style-type="icons" data-select-icon-size="22"',
								with_blank: true
							} %}
						</td>
					</tr>
				</tbody>

				{% if app.getSetting('core.problems.enabled') and app.user.hasPerm('agent_problems.view') and app.user.PermissionsManager.get('TicketChecker').canAssociateProblem(ticket) %}
					<tbody>
						<tr>
							<th>
								{{ phrase('agent.problems.problem') }}
							</th>
							<td>

								{% if app.user.hasPerm('agent_problems.create') %}
									{% set open_problems = [{id: -1, title: phrase('agent.problems.create_problem')}]|merge(open_problems) %}
								{% endif %}

								<div>
									{% include 'AgentBundle:Common:select-standard.html.twig' with {
									'name': 'problem_id',
									'add_classname': 'problem_id',
									'add_attr': '',
									'with_blank': 1,
									'blank_title': 'None',
									'categories': open_problems,
									'id': baseId ~ '_select_problem'
									} %}

									{% if app.user.hasPerm('agent_problems.create') %}
										<input id="{{ baseId }}_problem_title" type="text" name="problem_title"
											   style="display: none;" placeholder="{{ phrase('agent.problems.problem') }}"/>
									{% endif %}
								</div>
							</td>
						</tr>
					</tbody>
				{% endif %}

				{% if app.getSetting('core.use_ticket_category') %}
					<tbody class="col fieldprop ticket-field item-on category inline-field" style="display: none;" data-default-value="{{ app.getSetting('core.default_ticket_cat') }}">
						<tr>
							<th>{{ phrase('agent.general.category') }}</th>
							<td>
								<div>
									{% include 'AgentBundle:Common:select-category.html.twig' with {
										'name': "newticket[category_id]",
										'id': baseId ~ '_cat',
										'categories': ticket_options.ticket_categories_hierarchy,
										'selected': ticket.category_id,
										'with_blank': true
									} %}
								</div>
							</td>
						</tr>
					</tbody>
				{% endif %}

				{% if app.getSetting('core.use_ticket_priority') %}
					<tbody class="col fieldprop ticket-field item-on priority inline-field" style="display: none;" data-default-value="{{ app.getSetting('core.default_ticket_pri') }}">
						<tr>
							<th>{{ phrase('agent.general.priority') }}</th>
							<td>
								{% include 'AgentBundle:Common:select-priority.html.twig' with {
									'name': "newticket[priority_id]",
									'id': baseId ~ '_pri',
									'add_classname': 'ticket_priority',
									'selected': ticket.priority_id,
									'priorities': ticket_options.ticket_priorities,
									'with_blank': true
								} %}
							</td>
						</tr>
					</tbody>
				{% endif %}

				{% if app.getSetting('core.use_ticket_workflow') %}
					<tbody class="col fieldprop ticket-field item-on workflow inline-field" style="clear:both;display: none;" data-default-value="{{ app.getSetting('core.default_ticket_work') }}">
						<tr>
							<th>{{ phrase('agent.general.workflow') }}</th>
							<td>
								{% include 'AgentBundle:Common:select-workflow.html.twig' with {
									'name': "newticket[workflow_id]",
									'id': baseId ~ '_work',
									'add_classname': 'ticket_workflow',
									'selected': ticket.workflow_id,
									'workflows': ticket_options.ticket_workflows,
									'with_blank': true
								} %}
							</td>
						</tr>
					</tbody>
				{% endif %}

				{% if app.getSetting('core.use_product') %}
					<tbody class="col fieldprop ticket-field item-on product inline-field" style="clear:both;display: none;" data-default-value="{{ app.getSetting('core.default_prod_id') }}">
						<tr>
							<th>{{ phrase('agent.general.product') }}</th>
							<td>
								{% include 'AgentBundle:Common:select-product.html.twig' with {
									'name': "newticket[product_id]",
									'id': baseId ~ '_prod',
									'add_classname': 'ticket_product',
									'products': ticket_options.products_hierarchy,
									'selected': ticket.product_id,
									'with_blank': true
								} %}
							</td>
						</tr>
					</tbody>
				{% endif %}

				{% if custom_fields %}
					{% for f in custom_fields if f.field_def.getTypeName() != 'hidden' %}
						<tbody class="col fieldprop ticket-field item-on ticket-field-{{f.field_def.id}} {% for a in f.field_def.getAliases() %}ticket-field-{{ a.getQualifiedName() }}{% endfor %} item-on-{{f.field_def.id}} inline-field" style="clear:both;display: none;" data-default-value="{{ f.field_def.getStringDefaultValue() }}" data-custom-field-handler="{{ f.field_handler }}">
							<tr>
								<th>{{ f.title }}</th>
								<td>
									{{ render_custom_field_form(f) }}
								</td>
							</tr>
						</tbody>
					{% endfor %}
				{% endif %}

                {% include 'AgentBundle:Ticket:newticket-custom-fields-row.html.twig' with {
                    new_custom_fields: new_custom_fields,
                    custom_person_fields: custom_person_fields,
                    custom_org_fields: custom_org_fields
                } %}

			</table>
		</article>
	</section>
        <section id="{{baseId}}_labels_section">
            <article id="{{baseId}}_headerbox_box_props" class="headerbox">
                <table cellspacing="0" cellpadding="0" width="100%" class="field-holders-table">
                    <tbody class="always-bottom">
                        <tr>
                            <th width="80" style="vertical-align: middle; border-bottom: none; padding-top: 0; padding-bottom: 0;">{{ phrase('agent.general.labels') }}:</th>
                            <td style="vertical-align: middle; border-bottom: none; padding-top: 0; padding-bottom: 0; padding-right: 0;">
                                <div style="width: 98%" id="{{ baseId }}_labels_wrap">
                                    <input
                                            type="hidden"
                                            id="{{baseId}}_labels_input"
                                            class="dpe_select dpe_select_noborder"
                                            data-placeholder="{{ phrase('agent.general.add_a_label') }}"
                                            name="labels"
                                            value="{% for label in ticket.labels %}{{ label.label }},{% endfor %}"
											data-allow-new="{% if app.user.hasPerm('agent_tickets.create_labels') %}1{% endif %}"
                                    />
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
        </article>
        </section>
</div>

{% if app.getSetting('core_tickets.enable_billing') or app.getSetting('core_tickets.enable_timelog') %}
<div class="profile-box-container reply-box-wrap billing-form" style="position: relative">
	<header>
		<h4>{{ phrase('agent.tickets.billing') }}</h4>
	</header>
	<section class="ticketreply">
		<article id="{{baseId}}_headerbox_box_billing" class="headerbox">
			<table cellspacing="0" cellpadding="0" width="100%" class="field-holders-table billing-form" id="{{ baseId }}_billing_form">
				<tr>
					<th width="80">{{ phrase('agent.tickets.billing_charge') }}</th>
					<td>
						<ul class="billing-types">
							{% if app.getSetting('core_tickets.enable_billing') %}
								<li>
									{% if not app.getSetting('core_tickets.enable_timelog') %}
										<label><input type="hidden" name="{{ baseId }}_billing_type" value="amount" />{{ phrase('agent.tickets.billing_amount') }}:</label>
									{% else %}
										<label><input type="radio" name="{{ baseId }}_billing_type" value="amount" />{{ phrase('agent.tickets.billing_amount') }}:</label>
									{% endif %}
									<input type="text" id="{{ baseId }}_billing_amount" name="amount" size="7" placeholder="0.00" class="billing-form-amount" /> {{ app.getSetting('core_tickets.billing_currency') }}
								</li>
							{% endif %}
							{% if app.getSetting('core_tickets.enable_timelog') %}
								<li>
									{% if not app.getSetting('core_tickets.enable_billing') %}
										<label><input type="hidden" name="{{ baseId }}_billing_type" value="time" />{{ phrase('agent.tickets.billing_time') }}:</label>
									{% else %}
										<label><input type="radio" name="{{ baseId }}_billing_type" value="time" checked="checked" />{{ phrase('agent.tickets.billing_time') }}:</label>
									{% endif %}
									<span id="{{ baseId }}_billing_inputs" class="billing-form-time">
						<input type="text" id="{{ baseId }}_billing_hours" name="hours" size="2" placeholder="H" />:<input type="text" id="{{ baseId }}_billing_minutes" name="minutes" size="2" placeholder="M" maxlength="2" /><span class="billing-seconds-input">:<input type="text" id="{{ baseId }}_billing_seconds" name="seconds" size="2" placeholder="S" maxlength="2" /></span>
					</span>
					<span class="billing-form-buttons">
						<button class="clean-white" id="{{ baseId }}_billing_start">{{ phrase('agent.general.start') }}</button>
						<button class="clean-white" id="{{ baseId }}_billing_stop">{{ phrase('agent.general.pause') }}</button>
						<button class="clean-white" id="{{ baseId }}_billing_reset">{{ phrase('agent.general.reset') }}</button>
					</span>
								</li>
							{% endif %}
						</ul>
					</td>
				</tr>
				{% for f in billing_fields %}
				<tr>
					<th>
						{{ f.title }}
					</th>
					<td>
						{{ render_custom_field_form(f) }}
					</td>
				</tr>
				{% endfor %}
			</table>
		</article>
	</section>
</div>
{% endif %}

<div class="profile-box-container reply-box-wrap" style="position: relative" id="{{baseId}}_message_box">
	<div class="ticket-sending-overlay" style="display: none">
		<strong>{{ phrase('agent.tickets.sending_your_message') }}</strong>
	</div>
	<header>
        <nav>
            <ul id="{{ baseId }}_message_toggle">
                <li class="on">
                    {{ phrase('agent.general.message') }}
                </li>
                <li data-is-note="1">
                    {{ phrase('agent.general.note') }}
                </li>
            </ul>
        </nav>
	</header>
	<section class="ticketreply">
		<article>
			<section>
				<div class="option-rows">
					<ul id="{{baseId}}_option_rows">
						<li id="{{baseId}}_actions_row" class="actions-row" style="display: none;">
							<label><span>{{ phrase('agent.general.actions') }}</span></label>
							<ul></ul>
							<br class="clear"/>
						</li>
						{% if attachments | length %}
							<li id="{{baseId}}_attach_row" class="attach-row">
						{% else %}
							<li id="{{baseId}}_attach_row" class="attach-row is-hidden" style="display: none">
						{% endif %}
							<label><span>{{ phrase('agent.general.attachments') }}</span></label>
							<div>
								<ul class="files">
									{% for attachment in attachments %}
										<li class="in" style="height: 18px;">
											<input type="hidden" name="newticket[attach][]" value="{{ attachment.blob.id }}">
											<em class="remove-attach-trigger"></em>
											<label><a href="{{ attachment.url }}" target="_blank">{{ attachment.blob.filename }}</a><span>{{ attachment.blob.filesize }} KB</span></label>
										</li>
									{% endfor %}
								</ul>
								<br class="clear"/>
							</div>
						</li>
					</ul>
					<div class="drop-file-zone"><h1>{{ phrase('agent.general.drop_here_to_attach') }}</h1></div>
				</div>
				<div class="input-wrap unreset">
					<textarea id="{{baseId}}_message" name="newticket[message]">{{ message.getMessageHtml() }}</textarea>
					<textarea id="{{baseId}}_signature_value" class="signature-value" style="display: none;">{{ agent_signature }}</textarea>
					<textarea id="{{baseId}}_signature_value_html" class="signature-value-html" style="display: none;">{{ agent_signature_html }}</textarea>
					<input type="hidden" id="{{baseId}}_is_html_reply" name="newticket[is_html_reply]" value="0" />
					<div class="drop-file-zone drop-file-zone-rte"><h1>{{ phrase('agent.general.drop_here_to_insert_image') }}</h1></div>
				</div>
			</section>
		</article>
	</section>
	<footer id="{{ baseId }}_message_footer">
		<table cellpadding="0" cellspacing="0" border="0"><tr>
			<td valign="middle" style="vertical-align: middle;">
				<div id="{{ baseId }}_send_btn">
					<div class="dp-btn-group dp-dropup" id="{{ baseId }}_reply_btn_group">
						<span class="hide-note">
							<a class="dp-btn dp-btn-primary submit-trigger">
								<i class="icon-share-alt"></i>&nbsp;
								{% if app.getSetting('core_tickets.new_status') == 'awaiting_user' %}
									<span id="{{ baseId }}_reply_as_type" data-type="awaiting_user">{{ phrase('agent.tickets.kbd_send_awaiting_user') }}</span>
								{% elseif app.getSetting('core_tickets.new_status') == 'awaiting_agent' %}
									<span id="{{ baseId }}_reply_as_type" data-type="awaiting_agent">{{ phrase('agent.tickets.kbd_send_awaiting_agent') }}</span>
								{% elseif app.getSetting('core_tickets.new_status') == 'resolved' %}
									<span id="{{ baseId }}_reply_as_type" data-type="resolved">{{ phrase('agent.tickets.kbd_send_resolved') }}</span>
								{% else %}
									<span id="{{ baseId }}_reply_as_type" data-type="awaiting_user">{{ phrase('agent.tickets.kbd_send_awaiting_user') }}</span>
								{% endif %}
							</a>
						</span>
						<span class="hide-reply" style="display: none">
							<a class="dp-btn dp-btn-primary submit-trigger" style="position: relative; z-index: 50;">
								<i class="icon-share"></i>&nbsp;
                                {% if app.getSetting('core_tickets.new_status') == 'awaiting_user' %}
									<span id="{{ baseId }}_note_as_type" data-type="awaiting_user">{{ phrase('agent.tickets.save_note_as', {'status': phrase('agent.tickets.status_awaiting_user')}) }}</span>
									{% elseif app.getSetting('core_tickets.new_status') == 'awaiting_agent' %}
									<span id="{{ baseId }}_note_as_type" data-type="awaiting_agent">{{ phrase('agent.tickets.save_note_as', {'status': phrase('agent.tickets.status_awaiting_agent')}) }}</span>
									{% elseif app.getSetting('core_tickets.new_status') == 'resolved' %}
									<span id="{{ baseId }}_note_as_type" data-type="resolved">{{ phrase('agent.tickets.save_note_as', {'status': phrase('agent.tickets.status_resolved')}) }}</span>
									{% else %}
									<span id="{{ baseId }}_note_as_type" data-type="awaiting_user">{{ phrase('agent.tickets.save_note_as', {'status': phrase('agent.tickets.status_awaiting_user')}) }}</span>
                                {% endif %}
							</a>
						</span>
						<a class="dp-btn dp-btn-primary dp-dropdown-toggle status-menu-trigger"><span class="dp-caret dp-caret-up"></span></a>
					</div>
					<a id="discard-draft-btn" class="dp-btn dp-btn-primary" type="button" style="display: none;">
						<span>
							{{ phrase('agent.tickets.discard_draft') }}
						</span>
					</a>
				</div>
				<div id="{{ baseId }}_send_loading" style="display: none;">
					<span class="flat-spinner"></span>
				</div>
			</td><td valign="middle" style="vertical-align: middle;" id="{{ baseId }}_reply-controls">
				<div style="padding-top: 1px; line-height: 100%; margin-left: 10px; float:left;">
					<label class="hide-note">
						<input type="checkbox" name="options[notify_user]" {% if app.getSetting('core_tickets.new_default_send_user_notify') %}checked="checked"{% endif %} />
						<span class="opt-label-text">
							{{ phrase('agent.general.email_user') }}
							<span class="small-light-icon tipped" data-tipped-options="maxWidth: 250" title="{{ phrase('agent.tickets.email_user_newticket_info') }}"></span>
						</span>
					</label>
				</div>
				<div style="padding-top: 1px; line-height: 100%; margin-left: 10px; float:left;">
					<label>
						<input type="checkbox" id="{{ baseId }}_opt_open_tab" name="options[open_tab]" checked="checked" />
						<span class="opt-label-text">
							{{ phrase('agent.general.open_tab') }}
							<span class="small-light-icon tipped" data-tipped-options="maxWidth: 250" title="{{ phrase('agent.tickets.open_tab_info') }}"></span>
						</span>
					</label>
				</div>
			</td>
		</tr></table>
	</footer>
</div>

<div class="dp-menu replybox" id="{{ baseId }}_status_menu" style="min-width: 225px;">
	<section>
		<div class="dp-menu-area small">
			<input type="text" class="label-input macro-filter" placeholder="Filter" />
			<ul class="macro-list">
				{% import _self as metpl %}
				{% macro macroRow(item) %}
					{% import _self as metpl %}
					{% if item.type == 'item' %}
						{% set macro = item.item %}
						<li class="res-ticketmacro-{{ macro.id }}" data-type="macro:{{ macro.id }}" data-label="{{ phrase('agent.tickets.send_newticket_and_apply_x', {name: macro.title}) }}" data-get-macro-url="{{ path('agent_ticket_ajax_get_macro', {ticket_id: '0', macro_id: macro.id, macro_reply_context: 1 }) }}">
							<div class="on-icon"><i class="icon-ok"></i></div>
							<span class="macro-title">{{ item.title }}</span>
						</li>
					{% else %}
						<li class="coll">
							<span class="macro-title"><i class="fa fa-caret-right" style="float:right; position:relative;top:4px;"></i>{{ item.title }}</span>
							<div class="dp-menu replybox sub-menu" style="min-width: 225px;">
								<section>
									<div class="dp-menu-area small">
										<input type="text" class="label-input macro-filter" placeholder="{{ phrase('agent.tickets.reply_and_apply_macro') }}" />
										<ul class="macro-list">
											{% for sub_item in item.items %}
												{{ metpl.macroRow(sub_item) }}
											{% endfor %}
										</ul>
									</div>
								</section>
							</div>
						</li>
					{% endif %}
				{% endmacro %}
				{% for item in app.user.getHelper('Agent').getMacrosStructured() %}
					{{ metpl.macroRow(item) }}
				{% endfor %}
			</ul>
		</div>
	</section>
	<section>
		<div class="dp-menu-area dp-menu-area-primary">
			<label>{{ phrase('agent.tickets.reply_and_set_status') }}</label>
			<ul>
				<li
					data-type="awaiting_user"
					data-label="{{ phrase('agent.tickets.send_reply_as_x', {status: phrase('agent.tickets.status_awaiting_user')}) }}"
					data-note-label="{{ phrase('agent.tickets.save_note_as', {'status': phrase('agent.tickets.status_awaiting_user')}) }}"
				>
					<div class="on-icon"><i class="icon-ok"></i></div>
					{{ phrase('agent.tickets.kbd_awaiting_user') }}
				</li>
				<li
					data-type="awaiting_agent"
					data-label="{{ phrase('agent.tickets.send_reply_as_x', {status: phrase('agent.tickets.status_awaiting_agent')}) }}"
					data-note-label="{{ phrase('agent.tickets.save_note_as', {'status': phrase('agent.tickets.status_awaiting_agent')}) }}"
				>
					<div class="on-icon"><i class="icon-ok"></i></div>
					{{ phrase('agent.tickets.kbd_awaiting_agent') }}
				</li>
				<li
					data-type="resolved"
					data-label="{{ phrase('agent.tickets.send_reply_as_x', {status: phrase('agent.tickets.status_resolved')}) }}"
					data-note-label="{{ phrase('agent.tickets.save_note_as', {'status': phrase('agent.tickets.status_resolved')}) }}"
				>
					<div class="on-icon"><i class="icon-ok"></i></div>
					{{ phrase('agent.tickets.kbd_resolved') }}
				</li>
			</ul>
		</div>
	</section>
</div>

<div id="{{ baseId }}_editor_translations" style="display: none;"
	 data-attach-title="{{ phrase('agent.general.attach') }}"
	 data-attach-description="{{ phrase('agent.general.attach_description') }}"
	 data-snippets-title="{{ phrase('agent.general.snippets') }}"
	 data-snippets-description="{{ phrase('agent.general.snippets_description') }}"
		>
</div>

{% include 'AgentBundle:Common:attach-row-tmpl.html.twig' with {formname: 'newticket[attach][]'} %}

</form>

</div>
</div>
