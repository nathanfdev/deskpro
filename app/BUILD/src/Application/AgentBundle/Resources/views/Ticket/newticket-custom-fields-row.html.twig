{# todo why tbody included into loop? #}

{% for f in new_custom_fields %}
    <tbody class="col fieldprop ticket-field item-on custom-field custom-field-{{f.vars.def.id}} item-on-{{f.vars.def.id}} inline-field" style="clear:both;display: none;" data-default-value="{{ f.field_def.getStringDefaultValue() }}" data-custom-field-handler="{{ f.field_handler }}">
        <th>{{ form_label(f) }}</th>
        <td>
            {{ render_custom_field_form(f) }}
        </td>
    </tbody>
{% endfor %}

