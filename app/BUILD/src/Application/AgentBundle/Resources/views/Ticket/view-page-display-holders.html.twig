{% if not baseId %}{% set baseId = el_uid() %}{% endif %}
{% if app.languages.isMultiLang() %}
	<tbody class="ticket_language language_id language standard-field item-on {% if not ticket.language.title %}no-value{% endif %}" data-item-type="ticket_language">
		<tr class="mode-display" ng-show="!isEditMode('language')" ng-click="editField($event, 'language')">
			<th width="80">
				<span class="language_id label">{{ phrase('agent.general.language') }}:</span>
			</th>
			<td>
				<span class="prop-val language_id">{% if ticket.language %}{{ phrase_object(ticket.language) }}{% else %}None{% endif %}</span>
			</td>
		</tr>
		<tr class="mode-edit ng-hide" ng-show="isEditMode('language')">
			<th width="80">{{ phrase('agent.general.language') }}:</th>
			<td>
				{% include 'AgentBundle:Common:select-language.html.twig' with {
					'name': 'ticket[language_id]',
					'id': baseId ~ '_ticket_language_id',
					'selected': ticket.language.id,
					'languages': app.languages.getAll(),
					'add_classname': 'prop-input-language_id',
					'with_blank': true,
					'add_attr': 'data-prop-id="language_id"'
				} %}
			</td>
		</tr>
	</tbody>
{% endif %}

{# Standard fields #}
{% if app.getSetting('core.use_ticket_category') %}
    <tbody class="category category_id standard-field item off {% if not ticket.category %}no-value{% endif %}"
           data-item-type="ticket_category"
           data-default-value="{{ app.getSetting('core.default_ticket_cat') }}"
           ng-show="fields['category']"
    >
        <tr class="mode-display" ng-show="!isEditMode('category')" ng-click="editField($event, 'category')">
            <th width="80">
                <span class="category_id label">{{ phrase('agent.general.category') }}:</span>
            </th>
            <td>
                <span class="prop-val category_id">
                    {{ ticket.category.full_title|default(phrase('agent.general.none')) }}
                </span>
            </td>
        </tr>
        <tr class="mode-edit ng-hide" ng-show="isEditMode('category')">
            <th width="80">{{ phrase('agent.general.category') }}:</th>
            <td>
                <select name="ticket[category_id]" id="{{ baseId }}_ticket_category_id" data-prop-id="category_id"
                        class="prop-input-category_id">
                    <option value="0">{{ phrase('agent.general.none') }}</option>
                    {% for cat in ticket_options.ticket_categories_hierarchy %}
                        {% if cat.children|length %}
                            <optgroup label="{{ cat.title }}">
                                {% for subcat in cat.children %}
                                    <option {% if ticket.category.id == subcat.id %}selected="selected"{% endif %}
                                            value="{{ subcat.id }}"
                                            data-full-title="{{ cat.title }} &gt; {{ subcat.title }}">
                                        {{ subcat.title }}
                                    </option>
                                {% endfor %}
                            </optgroup>
                        {% else %}
                            <option {% if ticket.category.id == cat.id %}selected="selected"{% endif %}
                                    value="{{ cat.id }}">
                                {{ "--"|repeat(cat.depth) }} {{ cat.title }}
                            </option>
                        {% endif %}
                    {% endfor %}
                </select>
            </td>
        </tr>
    </tbody>
{% endif %}

{% if app.getSetting('core.problems.enabled') and app.user.hasPerm('agent_problems.view') %}
    <tbody class="problem problem_id standard-field item" data-item-type="ticket_problem">
        <tr class="mode-display" ng-show="!isEditMode('problem')" ng-click="editField($event, 'problem')">
            <th width="80">
                <span class="problem_id label">{{ phrase('agent.problems.problem') }}:</span>
            </th>
            <td>
                {% set problem = ticket.problems.first %}
                <span class="prop-val problem_id">
				{{ problem ? problem.title : phrase('agent.general.none') }}
			</span>
                &nbsp;
                {% if problem %}
                    [&nbsp;<a class="agent_link incident-link" data-problem-id="{{ problem.id }}"
                >{{ phrase('agent.problems.incidents') }}: {{ incidents }}</a>&nbsp;]

                    {% if problem.is_open and app.user.hasPerm('agent_problems.close') %}
                        [&nbsp;<a
                          class="agent_link close-problem-link">{{ phrase('agent.general.close_lc') }}</a>&nbsp;]
                    {% endif %}

                    {% if not problem.is_open %}
                        [&nbsp;<a class="agent_link reopen-problem-link">{{ phrase('agent.general.reopen') }}</a>&nbsp;]
                    {% endif %}
                {% endif %}
            </td>
        </tr>

        {% set _as = app.user.PermissionsManager.get('TicketChecker').canAssociateProblem(ticket) %}
        {% set _ds = app.user.PermissionsManager.get('TicketChecker').canDisassociateProblem(ticket) %}

        {% if (_as and ticket.problems.isEmpty()) or (_ds and not ticket.problems.isEmpty()) %}

            <tr class="mode-edit ng-hide" ng-show="isEditMode('problem')">
                <th width="80">{{ phrase('agent.problems.problem') }}:</th>
                <td>
                    {% set open_problems = open_problems ? open_problems : [] %}
                    {% set selected_problem = ticket.problems.first %}

                    {% if _as %}
                        {% if selected_problem and not selected_problem.is_open %}
                            {% set open_problems = [selected_problem]|merge(open_problems) %}
                        {% endif %}
                        {% if app.user.hasPerm('agent_problems.create') %}
                            {% set open_problems = [{id: -1, title: phrase('agent.problems.create_problem')}]|merge(open_problems) %}
                        {% endif %}
                    {% else %}
                        {% set open_problems = [selected_problem] %}
                    {% endif %}

                    <div>
                        {% include 'AgentBundle:Common:select-standard.html.twig' with {
                        'name': 'ticket[problem_id]',
                        'add_classname': 'prop-input-problem_id',
                        'add_attr': 'data-prop-id="problem_id" ',
                        'with_blank': _ds,
                        'blank_title': 'None',
                        'categories': open_problems,
                        'id': baseId ~ '_ticket_problem_id',
                        'selected': selected_problem ? selected_problem.id : null
                        } %}

                        {% if app.user.hasPerm('agent_problems.create') %}
                            <input id="{{ baseId }}_create_problem" type="text" data-prop-id="create_problem"
                                   name="ticket[create_problem]"
                                   style="display: none;" placeholder="{{ phrase('agent.problems.problem') }}"
                            />
                        {% endif %}

                    </div>
                </td>
            </tr>
        {% endif %}
    </tbody>
{% endif %}

{% if app.getSetting('core.use_product') %}
    <tbody class="product standard-field item off {% if not ticket.product %}no-value{% endif %}"
           data-item-type="product"
           data-default-value="{{ app.getSetting('core.default_prod_id') }}"
           ng-show="fields['product']"
    >
        <tr class="mode-display" ng-show="!isEditMode('product')" ng-click="editField($event, 'product')">
            <th width="80">
                <span class="product label">{{ phrase('agent.general.product') }}:</span>
            </th>
            <td>
                <span class="prop-val product">
                    {{ ticket.product.full_title|default(phrase('agent.general.none')) }}
                </span>
            </td>
        </tr>
        {% if ticket.product and app.getSetting('core.use_product_fields') and ticket.product.custom_data|length %}
            {% set product_field_data = ticket.product.getFieldDisplayArray() %}
            {% for f in product_field_data if ticket.product.hasCustomField(f.id) %}
                <tr class="mode-display">
                    <th width="80">{{ f.title }}</th>
                    <td>{{ render_custom_field(f) }}</td>
                </tr>
            {% endfor %}
        {% endif %}
        <tr class="mode-edit ng-hide" ng-show="isEditMode('product')">
            <th width="80">{{ phrase('agent.general.product') }}:</th>
            <td>
                <select name="ticket[product_id]" id="{{ baseId }}_ticket_product_id" data-prop-id="product"
                        class="prop-input-product">
                    <option value="0">{{ phrase('agent.general.none') }}</option>
                    {% for prod in ticket_options.products_hierarchy %}
                        {% if prod.children|length %}
                            <optgroup label="{{ prod.title }}">
                                {% for subprod in prod.children %}
                                    <option {% if ticket.product.id == subprod.id %}selected="selected"{% endif %}
                                            data-full-title="{{ prod.title }} &gt; {{ subprod.title }}"
                                            value="{{ subprod.id }}">
                                        {{ subprod.title }}
                                    </option>
                                {% endfor %}
                            </optgroup>
                        {% else %}
                            <option {% if ticket.product.id == prod.id %}selected="selected"{% endif %}
                                    value="{{ prod.id }}">
                                {{ prod.title }}
                            </option>
                        {% endif %}
                    {% endfor %}
                </select>
            </td>
        </tr>
    </tbody>
{% endif %}
