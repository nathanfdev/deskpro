{# Custom fields#}
{% for f in custom_fields %}
    <tbody
          class="ticket_field_{{ f.id }} custom-field item off {% if f.field_def.isFormField() and not ticket.hasCustomField(f.id) %}no-value{% endif %}"
          data-field-type="ticket_field"
          data-item-id="{{ f.id }}"
          data-custom-field-handler="{{ f.field_handler }}"
          data-default-value="{{ f.field_def.getStringDefaultValue() }}"
          ng-show="fields['ticket_field_{{ f.id }}']"
    >
        <tr class="mode-display" ng-show="!isEditMode('ticket_field_{{ f.id }}')"
            ng-click="editField($event, 'ticket_field_{{ f.id }}')">
            <th width="80"><span class="custom-field edit-trigger ticket_field_{{ f.id }}" data-item-id="{{ f.id }}">{{ f.title }}:</span>
            </th>
            <td>
                <div class="custom-field content ticket_field_{{ f.id }}" data-item-id="{{ f.id }}" ng-non-bindable>
                    {{ render_custom_field(f) }}
                </div>
            </td>
        </tr>
        <tr class="mode-edit ng-hide" ng-show="isEditMode('ticket_field_{{ f.id }}')">
            <th width="80">{{ f.title }}:</th>
            <td>
                <div class="custom-field field-input ticket_field_{{ f.id }}" data-item-id="{{ f.id }}" ng-non-bindable>
                    {{ render_custom_field_form(f) }}
                </div>
            </td>
        </tr>
    </tbody>
{% endfor %}

{% for f in custom_person_fields %}
    <tbody
          class="user_field_{{ f.id }} custom-field item off {% if f.field_def.isFormField() and not ticket.person.hasCustomField(f.id) %}no-value{% endif %}"
          data-field-type="person_field"
          data-item-id="{{ f.id }}"
          data-custom-field-handler="{{ f.field_handler }}"
