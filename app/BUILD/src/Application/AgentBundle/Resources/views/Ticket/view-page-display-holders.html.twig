    <tbody class="priority priority_id standard-field item off {% if not ticket.priority %}no-value{% endif %}"
           data-item-type="ticket_priority"
           data-default-value="{{ app.getSetting('core.default_ticket_pri') }}"
           ng-show="fields['priority']"
    >
        <tr class="mode-display" ng-show="!isEditMode('priority')" ng-click="editField($event, 'priority')">
            <th width="80">
                <span class="priority_id label">{{ phrase('agent.general.priority') }}:</span>
            </th>
            <td>
                <span class="prop-val priority_id">
                    {{ ticket.priority.title|default(phrase('agent.general.none')) }}
                </span>
            </td>
        </tr>
        <tr class="mode-edit ng-hide" ng-show="isEditMode('priority')">
            <th width="80">{{ phrase('agent.general.priority') }}:</th>
