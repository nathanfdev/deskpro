{% if app.getSetting('core.use_ticket_workflow') %}
    <tbody class="workflow workflow_id standard-field item off {% if not ticket.workflow %}no-value{% endif %}"
           data-item-type="ticket_workflow"
           data-default-value="{{ app.getSetting('core.default_ticket_work') }}"
           ng-show="fields['workflow']"
    >
        <tr class="mode-display" ng-show="!isEditMode('workflow')" ng-click="editField($event, 'workflow')">
            <th width="80">
                <span class="workflow_id label">{{ phrase('agent.general.workflow') }}:</span>
            </th>
            <td>
                <span class="prop-val workflow_id">
                    {{ ticket.workflow.title|default(phrase('agent.general.none')) }}
                </span>
            </td>
        </tr>
        <tr class="mode-edit ng-hide" ng-show="isEditMode('workflow')">
            <th width="80">{{ phrase('agent.general.workflow') }}:</th>
            <td>
                <select name="ticket[workflow_id]" id="{{ baseId }}_ticket_workflow_id" data-prop-id="workflow_id"
                        class="prop-input-workflow_id">
                    <option value="0">{{ phrase('agent.general.none') }}</option>
                    {% for id,work in ticket_options.ticket_workflows %}
                        <option {% if ticket.workflow.id == id %}selected="selected"{% endif %}
                                value="{{ id }}">
                            {{ work }}
                        </option>
                    {% endfor %}
                </select>
            </td>
