                    {{ render_custom_field(f) }}
                </div>
            </td>
        </tr>
        <tr class="mode-edit ng-hide" ng-show="isEditMode('user_field_{{ f.id }}')">
            <th width="80">{{ f.title }}:</th>
            <td>
                <div class="custom-field field-input user_field_{{ f.id }}" data-item-id="{{ f.id }}" ng-non-bindable>
                    {{ render_custom_field_form(f) }}
                </div>
            </td>
        </tr>
    </tbody>
{% endfor %}

{% for f in custom_org_fields if ticket.person.organization %}
