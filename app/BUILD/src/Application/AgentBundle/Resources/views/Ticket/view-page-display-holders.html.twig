        </tr>
    </tbody>
{% endfor %}

{% for f in new_custom_fields %}
    {% set id = f.vars.def.id %}
    <tbody class="custom_field_{{ id }} custom-field item off {% if not f.vars.rendered_data %}no-value{% endif %}"
           data-field-type="custom_field"
           data-item-id="{{ id }}"
           ng-show="fields['custom_field_{{ id }}']"
    >
        <tr class="mode-display" ng-show="!isEditMode('custom_field_{{ id }}')"
            ng-click="editField($event, 'custom_field_{{ id }}')">
            <th width="80"><span class="custom-field edit-trigger custom_field_{{ id }}" data-item-id="{{ id }}">{{ f.vars.label }}:</span></th>
            <td>
                <div class="custom-field content ticket_field_{{ id }}" data-item-id="{{ id }}" ng-non-bindable>
                    {{ render_custom_field(f) }}
                </div>
            </td>
        </tr>
        <tr class="mode-edit ng-hide" ng-show="isEditMode('custom_field_{{ id }}')">
            <th width="80">{{ form_label(f) }}:</th>
            <td>
                <div class="custom-field field-input custom_field_{{ id }}" data-item-id="{{ id }}" ng-non-bindable>
                    {{ form_widget(f) }}
                </div>
            </td>
        </tr>
    </tbody>
{% endfor %}

{% if linked_chat and app.user.hasPerm('agent_chat.use') %}
    <tbody>
        <tr>
            <th>
                {{ phrase('agent.general.linked_chat') }}
            </th>
            <td>
                <a data-route="page:{{ path('agent_userchat_view', { conversation_id: linked_chat.id }) }}">
                    {{ linked_chat.getSubjectLine() }}
                </a>
            </td>
        </tr>
    </tbody>
{% endif %}
