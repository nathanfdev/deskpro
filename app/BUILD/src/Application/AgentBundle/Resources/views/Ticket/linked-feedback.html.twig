<table cellspacing="0" cellpadding="0" width="100%" class="field-holders-table th-la sla-table linked-feedback-table">
	<tbody>
    <tr class="linked-title">
      <th colspan="7" style="background: #eee;">{{ phrase('agent.tickets.linked_feedback') }}</th>
    </tr>
    <tr class="linked-head-title">
      <th style="font-size: 11px; padding: 1px 4px;">{{ phrase('agent.general.id') }}</th>
      <th style="font-size: 11px; padding: 1px 4px;">{{ phrase('agent.general.title') }}</th>
      <th style="font-size: 11px; padding: 1px 4px;">{{ phrase('agent.general.type') }}</th>
      <th style="font-size: 11px; padding: 1px 4px;">{{ phrase('agent.general.status') }}</th>
      <th width="10">&nbsp;</th>
    </tr>
    {% for tfl in ticket_feedback_links %}
      <tr class="linked-feedback">
        <td nowrap="nowrap" style="overflow:hidden; text-overflow: ellipsis;"><a data-route="page:{{ path('agent_feedback_view', {feedback_id: tfl.feedback.id}) }}">{{ tfl.feedback.id }}</a></td>
        <td width="100%" style="overflow:hidden; text-overflow: ellipsis;"><a data-route="page:{{ path('agent_feedback_view', {feedback_id: tfl.feedback.id}) }}">{{ tfl.feedback.title }}</a></td>
        <td nowrap="nowrap" style="overflow:hidden; text-overflow: ellipsis;">{{ tfl.feedback.category ? tfl.feedback.category.title : '' }}</td>
        <td nowrap="nowrap" style="overflow:hidden; text-overflow: ellipsis;">{{ tfl.feedback.status_category ? tfl.feedback.status_category.title : '' }}</td>
        <td width="10" style="text-align: right;">
          <img src="{{ asset('images/agent/icons/cross.png') }}" style="cursor: pointer;" class="unlink-feedback" data-id="{{ tfl.id }}" />
        </td>
      </tr>
    {% endfor %}
	</tbody>
</table>
