{% import 'AgentBundle:Common:macro-flagname.html.twig' as flag %}
{% import 'AgentBundle:Common:agent-macros.html.twig' as agentui %}
<script>
  pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.Ticket';
  pageMeta.title = {{ ticket.subject|json_encode|raw }};
  pageMeta.ticket_id = {{ ticket.id }};
  pageMeta.tabClassId = 'ticket-{{ ticket.id }}';
  pageMeta.alert_id = 'ticket-{{ ticket.id }}';
  pageMeta.url_fragment = '{{ url_fragment('agent_ticket_view', {'ticket_id': ticket.id}) }}';
  pageMeta.pageIdentity = 'ticket:{{ ticket.id }}';

  pageMeta.labelsAutocompleteUrl = '{{ path('agent_ajax_labels_autocomplete', {'label_type': 'tickets'}) }}';
  pageMeta.labelsSaveUrl = '{{ path('agent_ticket_ajax_labels_save', {'ticket_id': ticket.id}) }}';
  pageMeta.labelsSearchUrl = '{{ path('agent_ticketsearch_runcustomfilter') }}?terms[0][type]=label&terms[0][op]=is&terms[0][label]=';
  pageMeta.getMacroUrl = '{{ path('agent_ticket_ajax_get_macro', {'ticket_id': ticket.id }) }}?macro_id=$macro_id';
  pageMeta.saveActionsUrl = '{{ path('agent_ticket_ajax_save_actions', {'ticket_id': ticket.id }) }}';
  pageMeta.getDataholdersUrl = '{{ path('agent_ticket_ajax_get_dataholders', {'ticket_id': ticket.id }) }}';
  pageMeta.deleteTicketUrl = '{{ path('agent_ticketsearch_ajax_delete_tickets') }}';
  pageMeta.uploadAttachUrl = '{{ path('agent_accept_upload') }}';
  pageMeta.getMessageQuoteUrl = '{{ path('agent_ticket_message_ajax_getquote', {'ticket_id': ticket.id, 'message_id': '000'})|replace({'000': '{message_id}'}) }}';
  pageMeta.viewPersonUrl = '{{ path('agent_people_view', {'person_id': ticket.person.id}) }}';
  pageMeta.lastMessageId = {{ last_message_id|default(0) }};
  pageMeta.lastLogId = {{ last_log_id|default(0) }};
  pageMeta.ticket_reverse_order = {% if app.user.getPref('agent.ticket_reverse_order') %}true{% else %}false{% endif %};

  pageMeta.dateFormat = '{{ app.getSetting('core.date_day')|to_jqueryui_dateformat }}';
  pageMeta.last_activity = {{ ticket.getLastActivityDate().getTimestamp() }};

  pageMeta.person_id = {{ ticket.person.id }};
  pageMeta.person_email = {{ ticket.person.primary_email_address|json_encode|raw }};
  pageMeta.person_name = {{ ticket.person.display_name|json_encode|raw }};

  pageMeta.ticket = {{ ticket_api|json_encode|raw }};
  pageMeta.api_data = {{ ticket.toApiData()|json_encode|raw }};
  pageMeta.api_v2_data = {{ api_v2_data|json_encode|raw }};
  pageMeta.hasBilling = {{ app.getSetting('core_tickets.enable_billing')? 'true' : 'false' }};
  pageMeta.billingCurrency = '{{ app.getSetting('core_tickets.billing_currency') }}';
  pageMeta.hasTimeLog = {{ app.getSetting('core_tickets.enable_timelog')? 'true' : 'false' }};

  pageMeta.ticket_perms = {{ ticket_perms|json_encode|raw }};
  {% if ticket.hasLock() %}
  pageMeta.isLocked = true;
  {% else %}
  pageMeta.isLocked = false;
  {% endif %}
  pageMeta.unlockOnClose = {{ app.getSetting('core_tickets.unlock_on_close') ? 'true' : 'false' }};

  {% if ticket.person.organization %}
  pageMeta.viewOrgUrl = '{{ path('agent_org_view', {'organization_id': ticket.person.organization.id}) }}';
  {% endif %}

  {% set baseId = el_uid() %}
  pageMeta.baseId = '{{ baseId }}';

  pageMeta.isDeleted = {% if ticket.hidden_status == 'deleted' %}true{% else %}false{% endif %};
  pageMeta.isArchived = {% if ticket.status == 'archived' %}true{% else %}false{% endif %};
  pageMeta.isSpam = {% if ticket.hidden_status == 'spam' %}true{% else %}false{% endif %};
  pageMeta.auto_start_bill = {% if app.getSetting('core_tickets.enable_timelog') and app.getSetting('core_tickets.billing_auto_timer') %}true{% else %}false{% endif %};
  pageMeta.goNextOnReply = {{ app.user.getPref('agent.ticket_go_next_reply') ? 'true' : 'false' }};
  pageMeta.lang = {{ {
      'find_ticket': phrase('agent.tickets.find_ticket'),
      'users_tickets': phrase('agent.tickets.users_tickets'),
      'open_tickets': phrase('agent.tickets.open_tickets'),
      'filter_results': phrase('agent.tickets.filter_results'),
      'search': phrase('agent.general.search'),
  }|json_encode|raw }};
</script>

<div
      class="layout-sidebar dp-app-v2-sidebar"
      id="{{ baseId }}_layout_sidebar"
      data-deskproapp="ticket-sidebar"
      data-deskproapp-render="legacy-sidebar"
      data-deskproapp-render-sidebar="#{{ baseId }}_layout_sidebar"
      data-deskproapp-render-icons="#{{ baseId }}_layout_sidebar_icons > ul:first-child"
>
	<span class="pin-btn"><i class="fa fa-lock"></i><i class="fa fa-chevron-right"></i></span>
    <div data-deskproapp-marker class="dp-app-context dp-app-v2-container"></div>
</div>

{# the sidebar sizer is disabled for at the moment and the plan is to completely remove it #}
{#<div class="layout-sidebar-sizer" id="{{ baseId }}_layout_sidebar_sizer"></div>#}

<div id="{{ baseId }}_layout_content" class="layout-content page-ticket {% if ticket.hasLock() %}locked{% endif %} {{ ticket.status_code|replace({'.': '_'}) }} urgency-{{ ticket.urgency }}">

    <div class="dp-page-content">
        <div id="{{ baseId }}_controls_react_container"></div>
        {% set locked_self = ticket.hasLock() and not ticket.isLocked(app.user) %}
        <div class="locked-overlay"
             id="{{ baseId }}_locked_overlay"{% if not ticket.isLocked() %} style="display: none;"{% endif %}></div>

        <form class="value-form" id="{{ baseId }}_value_form" style="display:none">
            <input type="hidden" name="department_id" class="department_id"
                   value="{{ ticket.department.id|default(0) }}" />
            <input type="hidden" name="agent_id" class="agent_id" value="{{ ticket.agent.id|default(0) }}" />
            <input type="hidden" name="agent_team_id" class="agent_team_id"
                   value="{{ ticket.agent_team.id|default(0) }}" />
            <input type="hidden" name="product_id" class="product_id" value="{{ ticket.product.id|default(0) }}" />
            <input type="hidden" name="category_id" class="category_id" value="{{ ticket.category.id|default(0) }}" />
            <input type="hidden" name="workflow_id" class="workflow_id" value="{{ ticket.workflow.id|default(0) }}" />
            <input type="hidden" name="priority_id" class="priority_id" value="{{ ticket.priority.id|default(0) }}" />
            <input type="hidden" name="language_id" class="language_id"
                   value="{{ ticket.language.id|default(app.languages.getDefaultId()) }}" />
            <input type="hidden" name="is_hold" class="is_hold" value="{{ ticket.is_hold|default(0) }}" />
            <input type="hidden" name="status" class="status" value="{{ ticket.status }}" />
            <input type="hidden" name="hidden_status" class="hidden_status" value="{{ ticket.hidden_status }}" />
        </form>

        {% if ticket.status == 'hidden' %}
            {% include 'AgentBundle:Ticket:view-hidden-bar.html.twig' %}
        {% endif %}

        <header class="main-header" id="{{ baseId }}_page_header">
            <div id="{{ baseId }}_layout_sidebar_icons" class="layout-sidebar-icons">
                <ul></ul>
            </div>
            {{ dp_app_loc(baseId, 'header.top') }}
            <div data-deskproapp="ticket-header-top"></div>

            <div id="{{baseId}}_locked_message" {% if not ticket.hasLock() %}style="display: none"{% endif %} data-locked-self="{% if locked_self %}1{% else %}0{% endif %}">
                <div class="locked-message">
                    <button class="dp-btn" id="{{baseId}}_unlock_ticket2" style="float:right">{{ phrase('agent.tickets.unlock') }}</button>
                    <div style="margin-right: 100px;">
                        <div id="{{baseId}}_locked_message_self" {% if not locked_self %}style="display: none"{% endif %}>
                            {% if app.getSetting('core_tickets.lock_on_view') %}
                                {{ phrase('agent.tickets.you_have_auto_lock') }}
                            {% else %}
                                {{ phrase('agent.tickets.you_have_locked') }}
                            {% endif %}
                            {% if app.getSetting('core_tickets.unlock_on_close') %}
                                <div class="auto-unlock-message">
                                    {{ phrase('agent.tickets.lock_auto_release') }}
                                </div>
                            {% endif %}
                        </div>
                        <div id="{{baseId}}_locked_message_other"{% if locked_self %} style="display:none;"{% endif %}>
                            {{ phrase('agent.tickets.agent_has_lock', {agent: '<span>' ~ ticket.locked_by_agent.display_name ~ '</span>'}, true) }}
                        </div>
                    </div>
                </div>
            </div>
            <div id="{{baseId}}_hold_message" {% if not ticket.is_hold %}style="display: none"{% endif %}>
                <div class="hold-message">
                    <button class="dp-btn set-hold unhold" id="{{baseId}}_unhold_btn" style="float:right">{{ phrase('agent.tickets.unhold_ticket') }}</button>
                    <div style="margin-right: 100px;">
                        {{ phrase('agent.tickets.currently_on_hold') }}
                    </div>
                </div>
            </div>
            <div class="row title first" id="{{ baseId }}_layout_header_first">
                <table cellspacing="0" cellpadding="0" width="100%">
                    <tr>
                        {% if brands|length > 1 %}
                            <td width="10">
                                <div class="id-number">
                            <span id="{{baseId}}_brandname" title="{{ phrase('agent.general.brand') }}">
                                {% if not ticket.brand.hasLogo() %}
                                    {{ ticket.brand.name }}
                                {% else %}
                                    <span id="{{ baseId }}_brand_icon" {% if not ticket.brand.hasLogo() %}style="display: none;"{% endif %} title="{{ ticket.brand.name }}"><img src="{{ ticket.brand.getLogoUrl(22) }}"/></span>
                                {% endif %}
                            </span>
                                </div>
                            </td>
                        {% endif %}
                        <td width="10" nowrap="nowrap">
                            <div class="id-number" id="{{ baseId }}_idref_switch">
                                <span id="{{ baseId }}_id_num" title="{{ phrase('agent.general.ticket_id') }}">
                                    <span class="copy-btn-outer"><span class="copy-btn" data-clipboard-text="{{ ticket.id }}" title="{{ phrase('agent.general.copy_to_clipboard') }}"><i class="fas fa-paste"></i></span></span>
                                    <span class="copy-btn-outer permalink"><span class="copy-btn" data-clipboard-text="{{ ticket_permalink }}" title="{{ phrase('agent.general.copy_permalink') }}"><i class="fas fa-link"></i></span></span>
                                    {{ phrase('agent.general.id') }}: {{ ticket.id }}
                                </span>
                                <span id="{{ baseId }}_ref_num" style="display: none;" title="Ticket Reference">
                                    <span class="copy-btn-outer"><span class="copy-btn" data-clipboard-text="{{ ticket.ref }}" title="{{ phrase('agent.general.copy_to_clipboard') }}"><i class="fas fa-paste"></i></span></span>
                                    <span class="copy-btn-outer permalink"><span class="copy-btn" data-clipboard-text="{{ ticket_permalink }}" title="{{ phrase('agent.general.copy_permalink') }}"><i class="fas fa-link"></i></span></span>
                                    {{ phrase('agent.general.id') }}: {{ ticket.ref }}
                                </span>

                            </div>
                        </td>
                        <td>
                            <h1>
                                <span id="{{baseId}}_showname">{{ ticket.subject }}</span>
                                <span id="{{baseId}}_editname" style="display: none"><input type="text" placeholder="Enter subject" name="name" value="{{ ticket.subject }}" /></span>
                                <a id="{{baseId}}_editname_end" class="edit-name-save clean-white" style="display: none">{{ phrase('agent.general.done') }}</a>
                            </h1>
                        </td>
                    </tr>
                </table>
            </div>
            <div class="row author last">
                <span class="ticket-person-holder">
                    {% if ticket.person.emails|length == 0 and not ticket.person.primary_email and ticket.person.phone_numbers|length > 0 %}
                        <div class="select-user-menu">
                            <label class="select-user-menu-header">Select the person who made this call:</label>
                            <ul>
                                {% for person in person_repo.findByPhoneNumber(ticket.person.phone_numbers[0].number) %}
                                    {% if ticket.person.id != person.id %}
                                        <li>
                                            <input type="radio" name="select_user" value="{{ person.id }}">
                                            <label>{{ person.getDisplayName() }}</label>
                                        </li>
                                    {% endif %}
                                {% endfor %}
                                <li>
                                    <input type="radio" name="select_user" value="find_person">
                                    <label>Find a different person</label>
                                    <div class="select-user-item-options">
                                        <section id="{{baseId}}_user_section" class="user-section">
                                            <div id="{{baseId}}_choose_user" style="padding: 10px">
                                                <div
                                                        id="{{baseId}}_user_searchbox"
                                                        data-element-handler="DeskPRO.Agent.ElementHandler.PersonSearchBox"
                                                        data-search-url="{{ path('agent_peoplesearch_performquick', {'format': 'json', 'limit': 10, 'start_with': 'a', 'with_agents': 1}) }}"
                                                        data-highlight-term="1"
                                                        data-touch-focus="1"
                                                        data-search-param="term"
                                                        data-position-bound="#{{baseId}}_userselect"
                                                >
                                                    <input type="text" id="{{baseId}}_userselect" class="select-user term" placeholder="{{ phrase('agent.general.choose_a_person') }}" />
                                                    <input type="hidden" name="select_user_find_id" class="person-id" id="{{baseId}}_person_id" />

                                                    <script type="text/x-deskpro-tmpl" class="user-row-tpl">
                                                    <li>
                                                        <a>
                                                        <span class="user-name"></span>
                                                        <address>&lt;<span class="user-email"></span>&gt;</address>
                                                        <div class="bound-fade"></div>
                                                    </a></li>
                                                </script>
                                                    <div class="person-search-box" style="display: none">
                                                        <section>
                                                            <ul class="results-list"></ul>
                                                        </section>
                                                    </div>
                                                </div>
                                            </div>
                                            <div id="{{baseId}}_user_choice"></div>
                                        </section>
                                    </div>
                                </li>
                                <li>
                                    <input type="radio" name="select_user" value="new_person">
                                    <label>New person</label>

                                    <div class="select-user-item-options">
                                        <table cellspacing="0" cellpadding="0" class="">
                                            <tbody>
                                            <tr>
                                                <th width="100">{{ phrase('agent.general.email_address') }}</th>
                                                <td>
                                                    <input type="text" name="select_user_email" class="email" value="" style="margin:0;" />
                                                </td>
                                            </tr>
                                            </tbody>
                                            <tbody>
                                            <tr>
                                                <th>{{ phrase('agent.general.name') }}</th>
                                                <td>
                                                    <input type="text" name="select_user_name" class="name" value="{{ person.name }}" style="margin:0;" />
                                                </td>
                                            </tr>
                                            </tbody>
                                            {% if not person.id and app.getLanguages().isLangSystemEnabled() %}
                                                <tbody>
                                                <tr>
                                                    <th>{{ phrase('agent.general.language') }}</th>
                                                    <td>
                                                        <select name="select_user_language">
                                                            {% for lang in app.getLanguages().getAll() %}
                                                                <option value="{{ lang.id }}" {% if lang.id == app.user.language.id %}selected="selected"{% endif %}>{{ phrase_object(lang, 'title') }}</option>
                                                            {% endfor %}
                                                        </select>
                                                    </td>
                                                </tr>
                                                </tbody>
                                            {% endif %}
                                        </table>
                                    </div>
                                </li>
                            </ul>
                            <button class="clean-white select-user-button">Set person</button>
                        </div>
                    {% else %}
                        {% include 'AgentBundle:Ticket:view-ticket-person.html.twig' %}
                    {% endif %}
                </span>

                {% if ticket_perms.modify_cc and not user_parts|length %}
                    <a class="cc-btn cc-btn-main" id="{{ baseId }}_cc_list_btn2"><i class="fas fa-envelope"></i>
                        <em>{{ phrase('agent.tickets.add_cc') }}</em></a>
                {% endif %}

                {% if ticket_perms.modify_cc or user_parts|length %}
                    <div
                          id="{{ baseId }}_cc_list"
                          class="cc-row {% if user_parts|length %}cc-open{% endif %}"
                          data-element-handler="DeskPRO.Agent.ElementHandler.TicketCcManage"
                          data-add-url="{{ path('agent_ticket_addpart', {'ticket_id': ticket.id}) }}"
                          data-delete-url="{{ path('agent_ticket_delpart', {'ticket_id': ticket.id}) }}"
                          data-replybox-container="#{{ baseId }}_replybox_wrap"
                          {% if not user_parts|length %}style="display: none;"{% endif %}
                    >
                        <ul class="cc-row-list" id="{{ baseId }}_cc_row_list">
                            {% for part in user_parts %}
                                {% if loop.index0 < 2 %}
                                    {% include 'AgentBundle:Ticket:view-user-cc-row.html.twig' with {'person': part.person, 'ticket_perms':ticket_perms } %}
                                {% else %}
                                    {% include 'AgentBundle:Ticket:view-user-cc-row.html.twig' with {'person': part.person, 'ticket_perms':ticket_perms } %}
                                {% endif %}
                            {% endfor %}
                        </ul>
                        <div class="cc-btn-holder">
                            {% if ticket_perms.modify_cc and user_parts|length %}
                                <a class="cc-btn cc-btn-main" id="{{ baseId }}_cc_list_btn"><i
                                          class="fas fa-envelope"></i> <em>{{ phrase('agent.tickets.add_cc') }}</em></a>
                            {% endif %}
                        </div>

                        {% if ticket_perms.modify_cc %}
                            <div class="cc-autocomplete addrow noedit-hide" style="display: none; clear:left;">
                                <input type="text" class="user-part cc-people-search-trigger"
                                       placeholder="{{ phrase('agent.general.choose_a_person') }}" />
                                <div class="person-search-box" style="display: none">
                                    <section>
                                        <ul class="results-list">
                                        </ul>
                                    </section>
                                </div>
                                <span class="is-not-loading">
                                    <button
                                          class="clean-white small cc-saverow-trigger"
                                          data-msg-invalid-email="{{ phrase('agent.general.error_email_address') }}"
                                          data-msg-invalid-email-isaccount="{{ phrase('agent.tickets.email_is_ticket_account') }}"
                                          data-msg-is-dupe="{{ phrase('agent.tickets.email_is_dupe') }}"
                                          data-msg-invalid-email-isagent="{{ phrase('agent.tickets.email_is_agent_use_followers')|e }}"
                                          data-msg-cc-limit="{{ phrase('agent.tickets.email_cc_limit_reached', {max: app.getSetting('core_tickets.email_cc_max_count')}) }}"
                                    >{{ phrase('agent.general.add') }}</button>
                                </span>
                                <span class="is-loading">{{ phrase('agent.general.saving') }}</span>
                            </div>
                        {% endif %}
                        <div style="clear:left;"></div>
                        <script type="text/x-deskpro-tmpl" class="user-row-tpl">
                            <li>
                                <a>
                                <span class="user-name"></span>
                                <address>&lt;<span class="user-email"></span>&gt;</address>
                                <div class="bound-fade"></div>
                            </a></li>
                        </script>
                    </div>
                {% endif %}
            </div>

            {{ dp_app_loc(baseId, 'header.bottom') }}
            <div data-deskproapp="ticket-header-bottom"></div>

            <div class="margin"></div>
        </header>

        <nav id="{{ baseId }}_header_nav_primary" class="header-nav header-nav-primary">
            <ul>
                <li title="{{ phrase('agent.general.department') }}" data-btn-id="department" {% if not app.getSetting('using_department') %}style="display: none" {% endif %}>
                    {% include 'AgentBundle:Common:select-department.html.twig' with {
                    'name': "department_id",
                    'with_blank': blank_option,
                    'blank_title': phrase('agent.general.none'),
                    'selected': ticket.department.id|default(0),
                    'id': baseId ~ '_department_id',
                    'add_attr': 'data-invisible-trigger="1" style="visibility: hidden" data-dropdown-css-class="ticket-header" data-style-type="icons" data-select-icon-size="22"',
                    'departments': app.departments.getPersonDepartments(app.user, 'tickets', [ticket.department.id|default(0)], 'assign')
                    } %}

                    <span id="{{ baseId }}_department_icon" class="avatar"
                          {% if not ticket.department.hasAvatar() %}style="display: none;"{% endif %}><img
                              src="{{ ticket.department.getAvatarUrl(22) }}" /></span>
                    <span id="{{ baseId }}_department_txt">{{ ticket.department.full_title|default(phrase('agent.general.none')) }}</span>

                    <span class="dp-caret"></span>
                </li>
                <li title="{{ phrase('agent.general.status') }}" data-btn-id="status">
                    <select name="status_code" class="status_code" id="{{ baseId }}_status_code"
                            data-invisible-trigger="1" style="display: none" data-dropdown-css-class="ticket-header"
                            data-dropdown-nosearch="1">
                        {% if ticket.status == 'hidden' %}
                            <option value="" selected="selected">{{ phrase('agent.general.hidden') }}</option>
                        {% endif %}
                        {% if ticket.status_code == 'awaiting_user' or ticket_perms.modify_set_awaiting_agent %}
                            <option value="awaiting_agent"
                                    {% if ticket.status_code == 'awaiting_agent' %}selected="selected"{% endif %}>{{ phrase('agent.tickets.status_awaiting_agent') }}</option>
                        {% endif %}
                        {% if ticket.status_code == 'awaiting_user' or ticket_perms.modify_set_awaiting_user %}
                            <option value="awaiting_user"
                                    {% if ticket.status_code == 'awaiting_user' %}selected="selected"{% endif %}>{{ phrase('agent.tickets.status_awaiting_user') }}</option>
                        {% endif %}
                        {% if ticket.status_code == 'resolved' or ticket_perms.modify_set_resolved %}
                            <option value="resolved"
                                    {% if ticket.status_code == 'resolved' %}selected="selected"{% endif %}>{{ phrase('agent.tickets.status_resolved') }}</option>
                        {% endif %}
                        {% if ticket.status_code == 'archived' %}
                            <option value="archived"
                                    {% if ticket.status_code == 'archived' %}selected="selected"{% endif %}>{{ phrase('agent.tickets.status_archived') }}</option>
                        {% endif %}
                    </select>

                    <span id="{{ baseId }}_status_txt" class="urgency-text">
				{{ phrase('agent.tickets.status_' ~ ticket.status_code|replace({'.': '_'})) }}
			</span>

                    <span class="dp-caret"></span>
                </li>
                <li title="{{ phrase('agent.general.urgency') }}" class="urgency-item" data-btn-id="urgency">
                    <select name="urgency" class="urgency" data-style-type="urgency" id="{{ baseId }}_urgency"
                            style="display: none" data-invisible-trigger="1" data-dropdown-css-class="ticket-header"
                            data-dropdown-nosearch="1">
                        {% for i in 1..10 %}
                            <option value="{{ i }}"
                                    {% if ticket.urgency == i %}selected="selected"{% endif %}>{{ i }}</option>
                        {% endfor %}
                    </select>

                    <span id="{{ baseId }}_urgency_txt"
                          class="urgency-value-{{ ticket.urgency }}">{{ ticket.urgency }}</span>

                    <span class="dp-caret"></span>
                </li>
                <li data-btn-id="flag">
                    <input type="hidden" id="{{ baseId }}_flag_old" value="{{ ticket_flagged }}" />
                    <select name="flag" class="flag" id="{{ baseId }}_flag" class="dpe_select" data-style-type="icons"
                            data-invisible-trigger="1" data-dropdown-css-class="ticket-header"
                            data-dropdown-nosearch="1">
                        <option
                              value=""
                              data-icon="{{ asset('images/agent/icons/flag-gray.png' ) }}"
                        >{{ phrase('agent.general.none') }}</option>
                        {% for color in ['blue', 'green', 'orange', 'pink', 'purple', 'red', 'yellow'] %}
                            <option
                                  value="{{ color }}"
                                  {% if ticket_flagged == color %}selected="selected"{% endif %}
                                  data-icon="{{ asset('images/agent/icons/flag-' ~ color ~ '.png' ) }}"
                            >{{ flag.flag_name(color) }}</option>
                        {% endfor %}
                    </select>

                    <i id="{{ baseId }}_flagicon" class="fas fa-flag flag-color-{{ ticket_flagged|default('none') }}"
                       style="margin:0; padding: 0;"></i>
                    <span id="{{ baseId }}_flagtext">{% if ticket_flagged %}{{ flag.flag_name(ticket_flagged) }}{% endif %}</span>

                    <span class="dp-caret"></span>
                </li>
            </ul>
        </nav>

        {{ dp_app_loc(baseId, 'header.after') }}
        <div data-deskproapp="ticket-header-after"></div>
        {{ dp_app_loc(baseId, 'properties.before') }}
        <div data-deskproapp="ticket-properties-before"></div>

        <div id="{{ baseId }}_header_profile_box" class="header-profile-box">
            <div class="profile-box-container dp-simpletab-container">
                <header id="{{ baseId }}_properties_header">
                    {% set sla_pips %}
                        {% for ticket_sla in ticket.ticket_slas %}<span class="sla-pip {{ ticket_sla.sla_status }}"
                                                                        data-sla-id="{{ ticket_sla.sla_id }}"></span>{% endfor %}
                    {% endset %}
                    <nav data-element-handler="DeskPRO.ElementHandler.SimpleTabs">
                        <ul>
                            <li data-tab-for="#{{ baseId }}_fields_display_main_wrap">{{ phrase('agent.general.properties') }}</li>
                            {% if linked_tickets.count %}
                            <li data-tab-for="#{{ baseId }}_linked_wrap"><i
                                      class="fas fa-link"></i> {{ phrase('agent.tickets.linked_tickets') }} (<span
                                      id="{{ baseId }}_linked_count"
                                      data-count="{{ linked_tickets.count }}">{{ linked_tickets.count }}</span>)
                                </li>{% endif %}
                            {% if ticket_feedback_links|length and app.user.hasPerm('agent_publish.use') and app.user.hasPerm('agent_publish.validate') %}
                                <li data-tab-for="#{{ baseId }}_linked_feedback_wrap"><i
                                      class="fas fa-link"></i> {{ phrase('agent.tickets.linked_feedback') }} (<span
                                      id="{{ baseId }}_linked_feedback_count"
                                      data-count="{{ ticket_feedback_links|length }}">{{ ticket_feedback_links|length }}</span>)
                                </li>
                            {% endif %}
                            {% if app.getSetting('core.apps_tasks') and app.user.hasPerm('agent_tasks.use') %}
                                <li data-tab-for="#{{ baseId }}_tasks_wrap">{{ phrase('agent.general.tasks') }} (<span
                                  id="{{ baseId }}_task_count">{{ tasks|length }}</span>)</li>{% endif %}
                            {% if app.hasBeta('follow_up') %}
                                <li data-tab-for="#{{ baseId }}_follow_ups_wrap">{{ phrase('agent.general.follow_ups') }} (<span
                                  id="{{ baseId }}_follow_up_count">{{ follow_ups|length }}</span>)</li>{% endif %}
                            {% if (addable_slas is not empty and ticket_perms.modify_slas) or ticket.ticket_slas is not empty %}
                                <li data-tab-for="#{{ baseId }}_sla_wrap">{{ phrase('agent.general.slas') }} {{ sla_pips|raw }}</li>
                            {% endif %}
                            {% if app.getSetting('core_tickets.enable_billing') or app.getSetting('core_tickets.enable_timelog') %}
                                <li data-tab-for="#{{ baseId }}_billing_wrap">
                                    {% if app.getSetting('core_tickets.enable_billing') and app.getSetting('core_tickets.enable_timelog') %}
                                        {{ phrase('agent.tickets.billing_and_timelog') }}
                                    {% elseif app.getSetting('core_tickets.enable_timelog') %}
                                        {{ phrase('agent.tickets.billing_timelog') }}
                                    {% else %}
                                        {{ phrase('agent.tickets.billing') }}
                                    {% endif %}
                                    <span id="{{ baseId }}_billing_tab_counter"></span>
                                </li>
                            {% endif %}
                            <!--
                            temporarily disable the ticket properties locations because by default it appears as an empty tab
                            <li data-deskproapp="ticket-properties-new-tab"></li>
                            -->
                        </ul>
                    </nav>
                </header>
                <section class="description-area" style="padding:0">
                    <div class="error-list {% if validator_errors %}on{% endif %}" id="{{ baseId }}_field_errors"
                         {% if not validator_errors %}style="display:none"{% endif %}>
                        <span class="title">{{ phrase('agent.tickets.save_errors') }}:</span>
                        <ul>
                            {% for i in validator_errors %}
                                <li>{{ i }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                    <article id="{{ baseId }}_fields_display_main_wrap" class="headerbox" style="position: relative;">
                        <div class="lock-overlay"{% if not ticket.isLocked(app.user) %} style="display: none;"{% endif %}></div>
                        <table cellspacing="0" cellpadding="0" width="100%">
                            <tr>
                                <td style="padding-right: 5px;">
                                    <label class="field-label-title" style="white-space: nowrap">
                                        {{ phrase('agent.general.agent') }}
                                        {% if ticket_perms.modify_assign_self or not ticket.agent %}
                                            <span id="{{ baseId }}_assign_me" class="assign-self-link-wrap"
                                                  style="{% if app.user.id == ticket.agent.id %}display:none;{% endif %}"
                                                  data-me="{{ app.user.id }}">
								&middot;
												<a class="assign-self-link">
									{{ phrase('agent.general.assign_to_me') }}
								</a>
							</span>
                                        {% endif %}
                                        {% if ticket_perms.modify_assign_agent %}
                                            <span id="{{ baseId }}_unassign_agent" class="assign-self-link-wrap"
                                                  {% if not ticket.agent %}style="display: none;" {% endif %}>
								&middot;
												<a class="assign-self-link">
									{{ phrase('agent.general.unassign') }}
								</a>
							</span>
                                        {% endif %}
                                    </label>
                                    <select id="{{ baseId }}_agent_sel" class="dpe_select" data-style-type="icons"
                                            data-select-icon-size="22">
                                        {% if ticket_perms.modify_assign_agent or not ticket.agent %}
                                            <option {% if not ticket.agent.id %}selected="selected"{% endif %}
                                                    value="0">{{ phrase('agent.general.unassigned') }}</option>{% endif %}
                                        {% if ticket_perms.modify_assign_self or ticket.agent.id == app.user.id %}
                                            <option
                                                  {% if app.user.id == ticket.agent.id %}selected="selected"{% endif %}
                                                  data-icon="{{ app.user.getPictureUrl(20) }}"
                                                  value="{{ app.user.id }}">{{ app.user.display_name }}</option>
                                        {% endif %}
                                        {% for agent in app.getAgentData().getAgentAvatarList() %}
                                            {% if agent.id != app.user.id and (ticket_perms.modify_assign_agent or ticket.agent.id == agent.id) %}
                                                <option
                                                      {% if agent.id == ticket.agent.id %}selected="selected"{% endif %}
                                                      data-icon="{{ agent.getPictureUrl(20) }}"
                                                      value="{{ agent.id }}">{{ agent.display_name }}</option>
                                            {% endif %}
                                        {% endfor %}
                                        {% if ticket.agent and (ticket.agent.is_deleted or not ticket.agent.is_agent) %}
                                            <option selected="selected" value="{{ ticket.agent.id }}"
                                                    data-icon="{{ agent.getPictureUrl(20) }}">
                                                {{ ticket.agent.display_name }}
                                            </option>
                                        {% endif %}
                                    </select>
                                </td>
                                {% if agent_teams|length %}
                                    <td style="padding-right: 5px;">
                                        <label class="field-label-title" style="white-space: nowrap">
                                            {{ phrase('agent.general.team') }}
                                            {% if app.user.agent.primaryTeam and ticket_perms.modify_assign_self %}
                                                <span id="{{ baseId }}_assign_team" class="assign-self-link-wrap"
                                                      style="{% if ticket.agent_team and app.user.agent.isTeamMember(ticket.agent_team.id) %}display: none;{% endif %}"
                                                      data-team="{{ app.user.agent.primaryTeam.id }}">
								&middot;
													<a class="assign-self-link">
                                    {% if 1 == app.user.teams|length %}
                                        {{ phrase('agent.general.assign_to_my_team') }}
                                    {% else %}
                                        {{ phrase('agent.general.assign_to_primary_team') }}
                                    {% endif %}
								</a>
                            </span>
                                            {% endif %}
                                            <span id="{{ baseId }}_unassign_team" class="assign-self-link-wrap"
                                                  style="{% if not ticket.agent_team  %}display: none;{% endif %}">
							&middot;
												<a class="assign-self-link">
								{{ phrase('agent.general.unassign') }}
                            </a>
                        </span>
                                        </label>
                                        <select id="{{ baseId }}_agent_team_sel" class="dpe_select"
                                                data-select-nogrouptitle="1" data-style-type="icons"
                                                data-select-icon-size="22">
                                            {% if ticket_perms.modify_assign_team or not ticket.agent_team %}
                                                <option value="0"
                                                        {% if not ticket.agent_team %}selected="selected"{% endif %}>{{ phrase('agent.general.none') }}</option>
                                            {% endif %}

                                            {% if app.user.getTeams()|length and (ticket_perms.modify_assign_self or (ticket.agent_team.id == team.id)) %}
                                                <optgroup label="{{ phrase('agent.general.your_teams') }}">
                                                    {% set teams = app.user.getTeams() %}
                                                    {% for team in agent_teams %}
                                                        {% if team in teams %}
                                                            <option value="{{ team.id }}"
                                                                    data-icon="{{ team.getAvatarUrl(20) }}"
                                                                    {% if ticket.agent_team.id == team.id %}selected="selected"{% endif %}>{{ team.name }}</option>
                                                        {% endif %}
                                                    {% endfor %}
                                                </optgroup>
                                            {% endif %}

                                            {% for team in agent_teams %}
                                                {% if (ticket_perms.modify_assign_team or ticket.agent_team.id == team.id) and team.id not in app.user.getTeamIds() %}
                                                    <option value="{{ team.id }}"
                                                            data-icon="{{ team.getAvatarUrl(20) }}"
                                                            {% if ticket.agent_team.id == team.id %}selected="selected"{% endif %}>{{ team.name }}</option>
                                                {% endif %}
                                            {% endfor %}
                                        </select>
                                    </td>
                                {% endif %}
                                <td width="100%">
                                    <label class="field-label-title">
                                        {{ phrase('agent.general.followers') }}
                                        {% set show = '' %}
                                        {% for a in agent_parts if a.person.id == app.user.id %}
                                            {% set show = 'display:none;' %}
                                        {% endfor %}
                                        {% if ticket_perms.modify_assign_agent %}
                                          <span id="{{ baseId }}_follower_me" class="assign-self-link-wrap"
                                                style="{{ show }}" data-me="{{ app.user.id }}">
                                                &middot;
                                                <a class="assign-self-link">
                                                  {{ phrase('agent.general.add_me') }}
                                                </a>
                                          </span>
                                        {% endif %}
                                    </label>
                                    <div class="followers-list">
                                        <ul id="{{ baseId }}_followers_list">
                                            {% for a in agent_parts %}
                                                <li class="agent-{{ a.person.id }}" data-agent-id="{{ a.person.id }}">
                                                    <a class="dp-btn dp-btn-small agent-link" data-agent-id="{{ a.person.id }}">
                                                        <span class="text" style="background-image: url({{ a.person.getPictureUrl(15) }})">{{ a.person.display_name }}</span>
                                                        {% if ticket_perms.modify_assign_agent %}
                                                        <span class="remove-row-trigger"> <i class="fas fa-times"></i></span>
                                                        {% endif %}
                                                    </a>
                                                </li>
                                            {% endfor %}
                                        </ul>
                                        {% if ticket_perms.modify_assign_agent %}
                                        <div class="new-follower" id="{{ baseId }}_followers_sel_wrap">
                                            <select id="{{ baseId }}_followers_sel" class="dpe_select"
                                                    data-style-type="icons" data-select-icon-size="22">
                                                <option value="0">{{ phrase('agent.general.select_agent') }}</option>
                                                {% for agent in app.getAgentData().getAgentAvatarList() %}
                                                    <option data-icon="{{ agent.getPictureUrl(20) }}"
                                                            value="{{ agent.id }}"
                                                            data-icon-small="{{ agent.getPictureUrl(15) }}">{{ agent.display_name }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                        <a class="new-follower-btn" id="{{ baseId }}_add_follower_btn">
                                            <i class="fas fa-sign-in-alt"></i>
                                            {{ phrase('agent.tickets.add_follower') }}
                                        </a>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        </table>
                        <div class="sep">-</div>
                        <div id="{{ baseId }}_field_holders">
                            <table cellspacing="0" cellpadding="0" width="100%"
                                   class="field-holders-table mode-edit-on">

                                {% if ticket_perms.modify_labels or ticket.labels|length %}
                                    <tbody class="labels-row">
                                        <tr>
                                            <th width="80"
                                                style="vertical-align: middle; padding-top: 0; padding-bottom: 0;">
                                                {{ phrase('agent.general.labels') }}:
                                            </th>
                                            <td style="vertical-align: middle; padding-top: 0; padding-bottom: 0; padding-right: 0;">
                                                <div style="width: 98%" id="{{ baseId }}_labels_wrap">
                                                    <input
                                                          type="hidden"
                                                          id="{{ baseId }}_labels_input"
                                                          class="dpe_select dpe_select_noborder"
                                                          data-placeholder="{{ phrase('agent.general.add_a_label') }}"
                                                          value="{% for label in ticket.labels %}{{ label.label }},{% endfor %}"
                                                          data-allow-new="{% if app.user.hasPerm('agent_tickets.create_labels') %}1{% endif %}"
                                                    />
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                {% endif %}

                                {% include 'AgentBundle:Ticket:view-page-display-holders.html.twig' %}

                                <tbody class="hidden-row off ng-hide" ng-show="hidden && !show_hidden">
                                    <tr>
                                        <td colspan="2" style="padding-top: 4px; padding-bottom: 4px;">
                                            <a ng-click="showHidden()">
                                                <span ng-bind-html="hidden"></span> hidden field<span
                                                      ng-show="hidden !== 1">s</span> without a value
                                            </a>
                                        </td>
                                    </tr>
                                </tbody>
                                <tbody class="controls-row off ng-hide" ng-show="edit_fields.length">
                                    <tr>
                                        <td colspan="2" style="text-align: center; background: #eee;">
								<span ng-hide="is_saving">
									<button class="save clean-white" ng-click="saveFields()">{{ phrase('agent.general.save') }}</button>
									<button class="cancel clean-white" ng-click="cancelEdit()">{{ phrase('agent.general.cancel') }}</button>
								</span>
                                            <i ng-show="is_saving" class="spinner-flat"></i>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </article>
                    <article id="{{ baseId }}_linked_wrap">
                        {% include 'AgentBundle:Ticket:linked-tickets.html.twig' %}
                    </article>
                    {% if ticket_feedback_links|length and app.user.hasPerm('agent_publish.use') and app.user.hasPerm('agent_publish.validate') %}
                      <article id="{{ baseId }}_linked_feedback_wrap">
                          {% include 'AgentBundle:Ticket:linked-feedback.html.twig' %}
                      </article>
                    {% endif %}
                    {% if app.getSetting('core.apps_tasks') and app.user.hasPerm('agent_tasks.use') %}
                        <article id="{{ baseId }}_tasks_wrap">
                            {% include 'AgentBundle:Ticket:view-tasks.html.twig' %}
                        </article>
                    {% endif %}
                    {% if app.hasBeta('follow_up') %}
                        <article id="{{ baseId }}_follow_ups_wrap"></article>
                    {% endif %}
                    {% if (addable_slas is not empty and ticket_perms.modify_slas) or ticket.ticket_slas is not empty %}
                        <article id="{{ baseId }}_sla_wrap">
                            {% include 'AgentBundle:Ticket:view-slas.html.twig' %}
                        </article>
                    {% endif %}
                    {% if app.getSetting('core_tickets.enable_billing') or app.getSetting('core_tickets.enable_timelog') %}
                        <article id="{{ baseId }}_billing_wrap" style="overflow-x: auto;">
                            {% include 'AgentBundle:Ticket:view-billing.html.twig' %}
                        </article>
                    {% endif %}
                    {{ dp_app_loc(baseId, 'properties.tab') }}
                </section>
            </div>

            {{ dp_app_loc(baseId, 'properties.after') }}
            <div data-deskproapp="ticket-properties-after"></div>
        </div>

        <nav id="{{ baseId }}_header_nav_secondary" class="header-nav header-nav-secondary">
            <ul>
                <li id="{{ baseId }}_unlock_ticket" {% if not ticket.hasLock() %}style="display: none"{% endif %}
                    data-btn-id="unlock">
                    <i class="fas fa-unlock"></i>
                    {{ phrase('agent.tickets.unlock') }}
                </li>
                <li id="{{ baseId }}_lock_ticket" {% if ticket.hasLock() %}style="display: none"{% endif %}
                    data-btn-id="lock">
                    <i class="fas fa-lock"></i>
                    {{ phrase('agent.tickets.lock') }}
                </li>
                {% if ticket_perms.modify_merge %}
                    <li class="merge-menu-trigger noedit-hide" data-btn-id="merge-menu">
                        <i class="fas fa-columns"></i>
                        {{ phrase('agent.general.merge') }}
                        <span class="dp-caret"></span>
                    </li>
                {% endif %}
                <li id="{{ baseId }}_macros_menu_trigger" data-btn-id="macros-menu">
                    <i class="fas fa-tasks"></i>
                    {{ phrase('agent.general.macros') }}
                    <span class="dp-caret"></span>
                </li>
                {% if ticket_perms.delete %}
                    {% if not (ticket.hidden_status in ['deleted', 'spam'] ) %}
                        <li id="{{ baseId }}_remove_menu_trigger" data-btn-id="remove-menu">
                            <i class="fas fa-trash-alt"></i>
                            {{ phrase('agent.general.remove') }}
                            <span class="dp-caret"></span>
                        </li>
                    {% endif %}
                {% endif %}
                <li id="{{ baseId }}_actions_menu_trigger" data-btn-id="actions-menu">
                    <i class="fas fa-edit"></i>
                    {{ phrase('agent.general.actions') }}
                    <span class="dp-caret"></span>
                </li>
            </ul>
        </nav>

        <ul style="display:none" id="{{ baseId }}_remove_menu">
            <li data-action="spam">{{ phrase('agent.tickets.set_as_spam') }}</li>
            <li data-action="delete">{{ phrase('agent.tickets.delete_ticket') }}</li>
            {% if app.user.hasPerm('agent_people.delete') %}
                {% if person_object_counts.tickets > 1 or person_object_counts.chats > 0 %}
                    {% if person_object_counts.tickets > 1 %}
                        <li data-action="delete.ban">{{ phrase('agent.tickets.perm_del_user_and_other_tickets', {ticket_count: person_object_counts.tickets}) }}</li>
                    {% else %}
                        <li data-action="delete.ban">{{ phrase('agent.tickets.perm_del_user_and_content') }}</li>
                    {% endif %}
                {% else %}
                    <li data-action="delete.ban">{{ phrase('agent.tickets.perm_del_user_and_ticket') }}</li>
                {% endif %}
            {% endif %}
        </ul>

        <ul style="display:none" id="{{ baseId }}_actions_menu">
            <li data-action="change-user">{{ phrase('agent.tickets.change_user_btn') }}</li>
            <li style="{% if ticket.is_hold %}display: none;{% endif %}" id="{{ baseId }}_menu_set_hold"
                data-action="set-hold">{{ phrase('agent.tickets.hold_btn') }}</li>
            <li style="{% if not ticket.is_hold %}display: none;{% endif %}" id="{{ baseId }}_menu_unset_hold"
                data-action="unset-hold">{{ phrase('agent.tickets.unhold_btn') }}</li>
            {% if ticket_perms.modify_merge %}
                <li data-action="split">{{ phrase('agent.tickets.split_messages_into_ticket') }}</li>{% endif %}
            {% if app.user.hasPerm('agent_tickets.create') %}
                <li data-action="linked_ticket">{{ phrase('agent.tickets.create_linked_ticket') }}</li>
                <li data-action="link_existing_ticket">{{ phrase('agent.tickets.link_existing_ticket') }}</li>
            {% endif %}
            {% if app.user.hasPerm('agent_publish.use') and app.user.hasPerm('agent_publish.validate') %}
              <li data-action="link_new_feedback">{{ phrase('agent.tickets.create_linked_feedback') }}</li>
              <li data-action="link_existing_feedback">{{ phrase('agent.tickets.link_existing_feedback') }}</li>
            {% endif %}
            <li data-action="kb-pending">{{ phrase('agent.tickets.create_new_pending_article') }}</li>
            <li><a target="_blank"
                   href="{{ path('agent_ticket_view', {'ticket_id': ticket.id,'view_print': 1, '_rt': security_token('request_token', 10800)}) }}">{{ phrase('agent.general.print') }}</a>
            </li>
            <li><a target="_blank"
                   href="{{ path('agent_ticket_view', {'ticket_id': ticket.id,'pdf': 1, '_rt': security_token('request_token', 10800)}) }}">{{ phrase('agent.general.download_pdf') }}</a>
            </li>
        </ul>

        <div class="pagecontent">

            {{ dp_app_loc(baseId, 'main.top') }}

            {% if app.user.getPref('agent.ticket_reverse_order') %}
                {% if ticket_perms.reply or ticket_perms.modify_notes %}
                    {{ dp_app_loc(baseId, 'replybox.before') }}
                    <div data-deskproapp="ticket-replybox-before"></div>
                    <div style="position:relative;" class="ticket_reverse_order">
                        <div class="lock-overlay"{% if not ticket.isLocked(app.user) %} style="display: none;"{% endif %}></div>
                        <div id="{{ baseId }}_replybox_wrap" class="replybox-wrap">
                            {% include 'AgentBundle:Ticket:replybox.html.twig' %}
                        </div>
                    </div>
                    {{ dp_app_loc(baseId, 'replybox.after') }}
                    <div data-deskproapp="ticket-replybox-after"></div>
                {% endif %}
            {% endif %}
            {{ dp_app_loc(baseId, 'messages.before') }}
            <div data-deskproapp="ticket-messages-before"></div>

            <div class="profile-box-container ticket-messages dp-simpletab-container">
                <header>
                    <nav id="{{ baseId }}_messagebox_tabs" data-element-handler="DeskPRO.ElementHandler.SimpleTabs">
                        <ul>
                            <li data-list-type="messages" class="on"
                                data-tab-for="#{{ baseId }}_messages_wrap">{{ phrase('agent.tickets.messages') }}</li>
                            <li class="logs" data-list-type="log"
                                data-tab-for="#{{ baseId }}_logs_wrap">{{ phrase('agent.tickets.full_log') }}</li>
                            {% if app.getSetting('core_tickets.enable_feedback') and app.getSetting('core_tickets.feedback_agents_read') and ticket.date_feedback_rating %}
                                <li data-list-type="feedback" data-tab-for="#{{ baseId }}_messages_wrap">
                                    {{ phrase('agent.tickets.ticket_feedback') }} <span
                                          class="feedback-rating feedback-{{ ticket.feedback_rating_type }}">{% if ticket.feedback_rating == 1 %}☺{% elseif ticket.feedback_rating == -1 %}☹{% else %}&mdash;{% endif %}</span>
                                </li>
                            {% endif %}
                            <li data-tab-for="#{{ baseId }}_times">{{ phrase('agent.general.dates_and_times') }}</li>
                            <div data-deskproapp="ticket-body-tabs-new-tab"></div>
                        </ul>
                    </nav>
                </header>
                <section class="messages-wrap" id="{{ baseId }}_messages_wrap" data-page="{{ message_page }}"
                         data-page-count="{{ message_page_count }}">
                    <div class="message-page-prev"
                         {% if message_page == message_page_count or app.user.getPref('agent.ticket_reverse_order') %}style="display: none"{% endif %}
                         id="{{ baseId }}_message_prev_page">
                        <strong>{% if not app.user.getPref('agent.ticket_reverse_order') %}{{ phrase('agent.tickets.view_older_messages') }}{% else %}{{ phrase('agent.tickets.view_newer_messages') }}{% endif %}</strong>
                    </div>
                    {% if active_drafts and app.user.getPref('agent.ticket_reverse_order') %}
                        {% for active_draft in active_drafts %}
                            {% if active_draft.message_html %}
                                {% include 'AgentBundle:Ticket:ticket-message-draft.html.twig' with {draft: active_draft} %}
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                    <div id="{{ baseId }}_message_page_wrap">
                        {{ ticket_messages_block|raw }}
                    </div>
                    {% if active_drafts and not app.user.getPref('agent.ticket_reverse_order') %}
                        {% for active_draft in active_drafts %}
                            {% if active_draft.message_html %}
                                {% include 'AgentBundle:Ticket:ticket-message-draft.html.twig' with {draft: active_draft} %}
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                    <div class="message-page-next"
                         {% if message_page == message_page_count or not app.user.getPref('agent.ticket_reverse_order') %}style="display: none"{% endif %}
                         id="{{ baseId }}_message_next_page">
                        <strong>{% if app.user.getPref('agent.ticket_reverse_order') %}{{ phrase('agent.tickets.view_older_messages') }}{% else %}{{ phrase('agent.tickets.view_newer_messages') }}{% endif %}</strong>
                    </div>
                </section>
                <section id="{{ baseId }}_logs_wrap" style="margin: 0;padding: 0;">
                    {{ logs_block|raw }}
                </section>
                <section id="{{ baseId }}_times" class="times-table-wrapper" style="display: none; padding: 0;">
                    <table cellspacing="0" cellpadding="0" width="100%" class="field-holders-table th-ra">
                        <tbody class="times-row-created">
                            <tr>
                                <th width="200">{{ phrase('agent.general.created') }}:</th>
                                <td>
                                    <time class="timeago" datetime="{{ ticket.date_created|date('c', 'UTC') }}"></time>
                                    ({{ ticket.date_created|date('fulltime') }})
                                </td>
                            </tr>
                        </tbody>
                        {% set times_work_hours = (ticket.getWorkHoursSet().getActiveTime() != 'all') %}
                        {% if ticket.status == 'awaiting_agent' and ticket.date_user_waiting %}
                            <tbody class="times-row-waiting-time">
                                <tr>
                                    <th>{{ phrase('agent.tickets.current_user_waiting_time') }}:</th>
                                    <td>
                                        {% if times_work_hours %}
                                            {{ ticket.current_user_waiting_work_time|time_length('hours') }}
                                            <span class="tipped small-light-icon"
                                                  title="Work hours only, real time: {{ ticket.current_user_waiting_time|time_length }}"></span>
                                        {% else %}
                                            <time
                                                {% if not app.isRelativeTimesDisabled() %}class="timeago"{% endif %}
                                                data-timeago-no-ago="1"
                                                datetime="{{ ticket.date_user_waiting|date('c', 'UTC') }}"
                                            >
                                                {{ ticket.date_user_waiting|date('fulltime') }}
                                            </time>
                                        {% endif %}
                                        ({{ phrase('agent.general.since_time', {time: ticket.date_user_waiting|date('fulltime')}) }}
                                        )
                                    </td>
                                </tr>
                            </tbody>
                        {% endif %}
                        {% if ticket.real_total_user_waiting %}
                            <tbody class="times-row-all-waiting-time">
                                <tr>
                                    <th>{{ phrase('agent.tickets.total_user_waiting_time') }}:</th>
                                    <td>
                                        {% if times_work_hours %}
                                            {{ ticket.total_user_waiting_work_time|time_length('hours') }}
                                            <span class="tipped small-light-icon"
                                                  title="Work hours only, real time: {{ ticket.real_total_user_waiting|time_length }}"></span>
                                        {% else %}
                                            <time class="timeago" data-timeago-no-ago="1"
                                                  datetime="{{ ("- " ~ ticket.real_total_user_waiting|default('1') ~ " seconds")|date('c', 'UTC') }}"></time>
                                        {% endif %}
                                    </td>
                                </tr>
                            </tbody>
                        {% endif %}
                        {% if ticket.total_to_first_reply and ticket.total_to_first_reply > 0 %}
                            <tbody class="times-row-time-first-reply">
                                <tr>
                                    <th>
                                        {% if not app.isRelativeTimesDisabled() %}
                                            {{ phrase('agent.tickets.waiting_til_first_reply') }}:
                                        {% else %}
                                            {{ phrase('agent.tickets.date_first_reply') }}:
                                        {% endif %}
                                    </th>
                                    <td>
                                        {% if times_work_hours %}
                                            {{ ticket.work_time_to_first_reply|time_length('hours') }}
                                            <span class="tipped small-light-icon"
                                                  title="Work hours only, real time: {{ ticket.total_to_first_reply|time_length }}"></span>
                                        {% elseif not app.isRelativeTimesDisabled() %}
                                            <time class="timeago" data-timeago-no-ago="1"
                                                  datetime="{{ ticket.date_first_agent_reply|date('c', 'UTC') }}"></time>
                                        {% else %}
                                            <time>{{ ticket.date_first_agent_reply|date('fulltime') }}</time>
                                        {% endif %}
                                    </td>
                                </tr>
                            </tbody>
                        {% endif %}
                        {% if ticket.status == 'awaiting_user' and ticket.date_agent_waiting %}
                            <tbody class="times-row-agent-waiting-time">
                                <tr>
                                    <th>{{ phrase('agent.tickets.current_agent_waiting_time') }}:</th>
                                    <td>
                                        <time class="timeago" data-timeago-no-ago="1"
                                              datetime="{{ ticket.date_agent_waiting|date('c', 'UTC') }}"></time>
                                        ({{ phrase('agent.general.since_time', {time: ticket.date_agent_waiting|date('fulltime')}) }}
                                        )
                                    </td>
                                </tr>
                            </tbody>
                        {% endif %}
                        {% if ticket.date_resolved %}
                            <tbody class="times-row-resolved">
                                <tr>
                                    <th>{{ phrase('agent.general.date_resolved') }}:</th>
                                    <td>
                                        <time class="timeago"
                                              datetime="{{ ticket.date_resolved|date('c', 'UTC') }}"></time>
                                        ({{ ticket.date_resolved|date('fulltime') }})
                                    </td>
                                </tr>
                            </tbody>
                            <tbody class="times-row-time-until-resolved">
                                <tr>
                                    <th>{{ phrase('agent.tickets.time_til_resolve') }}:</th>
                                    <td>
                                        {% if times_work_hours %}
                                            {{ ticket.work_time_until_resolution|time_length('hours') }}
                                            <span class="tipped small-light-icon"
                                                  title="Work hours only, real time: {{ ticket.time_until_resolution|time_length }}"></span>
                                        {% else %}
                                            <time class="timeago" data-timeago-no-ago="1"
                                                  datetime="{{ ("- " ~ ticket.time_until_resolution|default('1') ~ " seconds")|date('c', 'UTC') }}"></time>
                                        {% endif %}
                                    </td>
                                </tr>
                            </tbody>
                        {% endif %}
                        {% if ticket.date_archived %}
                            <tbody class="times-row-archived">
                                <tr>
                                    <th>{{ phrase('agent.general.date_archived') }}:</th>
                                    <td>
                                        <time class="timeago"
                                              datetime="{{ ticket.date_archived|date('c', 'UTC') }}"></time>
                                        ({{ ticket.date_archived|date('fulltime') }})
                                    </td>
                                </tr>
                            </tbody>
                        {% endif %}
                        {% if ticket.date_first_agent_assign %}
                            <tbody class="times-row-first-assigned">
                                <tr>
                                    <th>{{ phrase('agent.tickets.first_assignment') }}:</th>
                                    <td>
                                        <time class="timeago"
                                              datetime="{{ ticket.date_first_agent_assign|date('c', 'UTC') }}"></time>
                                        ({{ ticket.date_first_agent_assign|date('fulltime') }})
                                    </td>
                                </tr>
                            </tbody>
                        {% endif %}
                        {% if ticket.date_first_agent_reply %}
                            <tbody class="times-row-first-agent-reply">
                                <tr>
                                    <th>{{ phrase('agent.tickets.first_agent_reply') }}:</th>
                                    <td>
                                        <time class="timeago"
                                              datetime="{{ ticket.date_first_agent_reply|date('c', 'UTC') }}"></time>
                                        ({{ ticket.date_first_agent_reply|date('fulltime') }})
                                    </td>
                                </tr>
                            </tbody>
                        {% endif %}
                        {% if ticket.date_last_agent_reply %}
                            <tbody class="times-row-last-agent-reply">
                                <tr>
                                    <th>{{ phrase('agent.tickets.last_agent_reply') }}:</th>
                                    <td>
                                        <time class="timeago"
                                              datetime="{{ ticket.date_last_agent_reply|date('c', 'UTC') }}"></time>
                                        ({{ ticket.date_last_agent_reply|date('fulltime') }})
                                    </td>
                                </tr>
                            </tbody>
                        {% endif %}
                        {% if ticket.date_last_user_reply %}
                            <tbody class="times-row-last-user-reply">
                                <tr>
                                    <th>{{ phrase('agent.tickets.last_user_reply') }}:</th>
                                    <td>
                                        <time class="timeago"
                                              datetime="{{ ticket.date_last_user_reply|date('c', 'UTC') }}"></time>
                                        ({{ ticket.date_last_user_reply|date('fulltime') }})
                                    </td>
                                </tr>
                            </tbody>
                        {% endif %}
                    </table>
                </section>
