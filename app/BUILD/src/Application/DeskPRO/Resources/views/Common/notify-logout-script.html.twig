{% if show or (app.session and app.session.id and app.session.getFlash('is_from_logout')) %}
  <!-- IS_FROM_LOGOUT -->
  {% if constant('DP_NOTIFY_LOGOUT_SCRIPT') and not app.user.id %}
  <iframe src="{{ constant('DP_NOTIFY_LOGOUT_SCRIPT') }}?data={{ {
    master_domain: constant('DPC_SITE_DOMAIN') ?: null,
    url:           app.getSetting('core.deskpro_url')
  }|json_encode|url_encode }}" style="width: 1px; height: 1px; overflow: hidden; border: none; visibility: hidden; position: absolute; right: 0; bottom: 0;" frameborder="0" width="1" height="1"></iframe>
  {% endif %}
{% endif %}