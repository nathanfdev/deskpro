{% if show or (app.session and app.session.id and app.session.getFlash('is_from_login')) %}
  <!-- IS_FROM_LOGIN -->
  {% if constant('DP_NOTIFY_LOGIN_SCRIPT') and app.user.id and app.user.is_agent %}
  <iframe src="{{ constant('DP_NOTIFY_LOGIN_SCRIPT') }}?data={{ {
    name:          app.user.name,
    email:         app.user.primary_email_address,
    person_id:     app.user.id,
    is_agent:      app.user.is_agent ? true : false,
    is_admin:      app.user.is_admin ? true : false,
    is_demo:       app.getLicense().isDemo() ? true : false,
    demo_expire:   app.getLicense().getExpireDate() ? app.getLicense().getExpireDate().getTimestamp() : false,
    master_domain: constant('DPC_SITE_DOMAIN') ?: null,
    url:           brand_setting('core.deskpro_url')
  }|json_encode|url_encode }}" style="width: 1px; height: 1px; overflow: hidden; border: none; visibility: hidden; position: absolute; right: 0; bottom: 0;" frameborder="0" width="1" height="1"></iframe>
  {% endif %}
{% endif %}