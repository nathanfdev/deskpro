{{ set_tplvar('agent_notification_footer', 'ticket-notify') }}
{{ set_tplvar('agent_reply_above_line', true) }}
<dp:subject>
	{% if ticket.agent.id == person.id %}
		{{ phrase('agent.emails.subject_new_ticket_assigned') }}
	{% elseif ticket.agent_team and person.getHelper('AgentTeam').isTeamMember(ticket.agent_team.id) %}
		{{ phrase('agent.emails.subject_new_ticket_assignedteam') }}
	{% else %}
		{{ phrase('agent.emails.subject_new_ticket') }}
	{% endif %}
</dp:subject>

<dp:last-reply />

<br /><br />

<h1>{{ phrase('agent.general.ticket') }}</h1>

{{ phrase('agent.emails.ticket_was_created', {name: action_performer ? action_performer.getDisplayContact() : ticket.person.getDisplayContact()}) }}

{% set lastReply = ticket.getLastReply(true) %}
{% if lastReply and lastReply.isVoiceMessage() %}
    {% set phoneCall = lastReply.getPhoneCallAttribute().getPhoneCall() %}
	{% if phoneCall.getAgentVoicemailRecord() %}
		Click here to listen to the voicemail message:<br />
		{{ url('go_to_voicemail_recording', { id: phoneCall.getAgentVoicemailRecord().getId() }) }}
	{% endif %}
{% endif %}

<br /><br />

<dp:ticket-properties-table />
