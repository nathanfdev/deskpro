<dp:subject>{{ phrase('agent.emails.agent_approval_approved') }} : {{ approval.name }} ({{ approval.id }}){% if approval.ticket.agent and ticket.person %} : {{ approval.ticket.agent }} {{ phrase('agent.emails.agent_for') }} {{ ticket.person }}{% endif %}</dp:subject>

<h3>{{ phrase('agent.emails.agent_approval_approved') }}</h3>

<h3 class="dp-approval-name">{{ approval.name }} ({{ approval.id }})</h3>

{% if approval.responses|length %}
    <table class="dp-approval-table">
        <tbody>
        {% for response in approval.responses %}
            <tr>
                <td class="label-col">
                    {{ phrase(response.isApproved ? 'agent.emails.agent_approval_approved' : 'agent.emails.agent_approval_rejected') }}
                    {{ phrase('agent.emails.agent_by') }}
                </td>
                <td>
                    {{ response.approver }} ({{ response.createdAt|date }})<br />
                    "{{ response.message }}"
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}

<table class="dp-approval-table">
    <tbody>
    <tr>
        <td colspan="2">{{ approval.description }}</td>
    </tr>
    {% if approval.ticket.agent %}
        <tr>
            <td class="label-col">{{ phrase('agent.emails.agent_requesting_agent') }}</td>
            <td>{{ approval.ticket.agent }}</td>
        </tr>
    {% endif %}
    {% if ticket.person %}
        <tr>
            <td class="label-col">{{ phrase('agent.emails.agent_requesting_user') }}</td>
            <td>{{ ticket.person }}</td>
        </tr>
    {% endif %}
    <tr>
        <td class="label-col">{{ phrase('agent.emails.agent_status') }}</td>
        <td>{{ approval.statusName|capitalize }}</td>
    </tr>
    <tr>
        <td class="label-col">{{ phrase('agent.emails.agent_approval_approved') }}</td>
        <td>{{ approval.approvedResponsesCount }}/{{ approval.requiredApprovals }}</td>
    </tr>
    <tr>
        <td class="label-col">{{ phrase('agent.emails.agent_approval_rejected') }}</td>
        <td>{{ approval.rejectedResponsesCount }}/{{ approval.requiredRejections }}</td>
    </tr>
    <tr>
        <td class="label-col">{{ phrase('agent.emails.agent_awaiting_response') }}</td>
        <td>
            {% for awaitingApprover in approval.approversPendingResponse %}
                <div>{{ awaitingApprover }} ({{ awaitingApprover.primary_email }})</div>
            {% else %}
                <em>{{ phrase('agent.emails.agent_all_approvers_have_responded') }}</em>
            {% endfor %}
        </td>
    </tr>
    <tr>
        <td colspan="2">
            {{ phrase('agent.emails.agent_approval_criteria', {
                requiredApprovals: approval.requiredApprovals,
                approversCount: approval.approversCount,
                requiredRejections: approval.requiredRejections,
                approversCount: approval.approversCount,
            }) }}
        </td>
    </tr>
    </tbody>
</table>

{% if not has_recipient_responded %}
    <table class="dp-approval-table">
        <tbody>
        <tr>
            <td class="label-col">{{ phrase('agent.emails.agent_approval_approve') }}</td>
            <td>
                <a href="{{ approve_url }}" title="{{ phrase('agent.emails.agent_approval_approve')|e }}">
                    {{ approve_url }}
                </a>
            </td>
        </tr>
        <tr>
            <td class="label-col">{{ phrase('agent.emails.agent_approval_reject') }}</td>
            <td>
                <a href="{{ reject_url }}" title="{{ phrase('agent.emails.agent_approval_reject')|e }}">
                    {{ reject_url }}
                </a>
            </td>
        </tr>
        </tbody>
    </table>
{% endif %}
