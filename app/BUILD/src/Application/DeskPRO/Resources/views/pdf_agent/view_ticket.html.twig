{% if not print %}
	{% include 'DeskPRO:pdf_agent:header.html.twig' %}

	<sethtmlpageheader name="deskproHeader" page="ALL" value="on" show-this-page="1" />

	{% include 'DeskPRO:pdf_agent:footer.html.twig' %}

	<sethtmlpagefooter name="deskproFooter" page="ALL" value="on" show-this-page="1" />
{% endif %}

{% import 'AgentBundle:Common:macro-flagname.html.twig' as flag %}

<style type="text/css">
    body {
        font-family: -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Oxygen-Sans,Ubuntu,Cantarell,"Helvetica Neue",sans-serif;
    }

    .ticket_list_table {
        page-break-inside: avoid;
    }

    .ticket_list_table td {
        overflow: wrap;
    }

    #ticket_properties {
        margin-bottom: 15px;
    }

    .ticket-prop {
        padding: 5px;
    }

    .ticket-prop-label {
        width: 210px;
        text-overflow: ellipsis;
        float: left;
    }
    .ticket-prop-val {
        float: left;
    }
    .ticket-prop-over {
        clear: both;
    }
    .clearfix {
        height: 1px;
        width: 1px;
        overflow: hidden;
        clear: both;
    }
</style>
{{ include_code_plugin('agent_print') }}

{% macro row(fieldName, title, content, isHtml) %}
    {# wrapping in a div so css can target the row to e.g. display none it #}

    <div class="ticket-prop ticket-prop-{{ fieldName }}">
        <div class="ticket-prop-label">{{ title }}</div>
        <div class="ticket-prop-val">
            {% if isHtml %}{{ content|raw }}{% else %}{{ content }}{% endif %}
        </div>
        <div class="clearfix"></div>
    </div>

{% endmacro %}

<h1>{{ ticket.subject }}</h1>
<div id="ticket_properties">
    {{ _self.row('id', phrase('agent.general.ticket_id'), ticket.id) }}
    {{ _self.row('ref', phrase('agent.general.ticket_ref'), ticket.ref) }}
    {% if brands|length > 1 %}{{ _self.row('brand', phrase('agent.general.brand'), ticket.brand.name) }}{% endif %}
    {{ _self.row('urgency', phrase('agent.general.urgency'), ticket.urgency) }}
    {{ _self.row('status', phrase('agent.general.status'), phrase('agent.tickets.status_' ~ ticket.status_code|replace({'.': '_'}))) }}
    {{ _self.row('department', phrase('agent.general.department'), ticket.department.title) }}

    {% if ticket_flagged %}
        {% set rowVal %}
            {% for color in ['blue', 'green', 'orange', 'pink', 'purple', 'red', 'yellow'] %}
                {% if ticket_flagged == color %}{{ flag.flag_name(color) }}{% endif %}
            {% endfor %}
        {% endset %}
        {{ _self.row('flag', phrase('agent.general.flag'), rowVal, true) }}
    {% endif %}

    {% if ticket.linked_chat %}{{ _self.row('chat', phrase('agent.general.linked_chat'), ticket.linked_chat.getSubjectLine() ) }}{% endif %}

    {% if ticket.labels|length %}
        {% set rowVal %}
            <ul>
                {% for label in ticket.labels %}
                    <li>{{label.label}}</li>
                {% endfor %}
            </ul>
        {% endset %}
        {{ _self.row('labels', phrase('agent.general.labels'), rowVal, true) }}
    {% endif %}

    {{ _self.row('date-created', phrase('agent.general.created'), ticket.date_created|date('fulltime') ) }}

    {% set rowVal %}
        {{ ticket.person.display_name }}
        {% if ticket.person.organization %},
            {% if ticket.person.organization_position %}
                {{ ticket.person.organization_position }}
            {% endif %}
            {{ ticket.person.organization }}
        {% endif %}
        <span>&lt;{{ ticket.person_email_address }}&gt;</span>
    {% endset %}
    {{ _self.row('user', phrase('agent.general.user'), rowVal, true) }}

    {{ _self.row('agent', phrase('agent.general.agent'), ticket.agent.display_name|default(phrase('agent.general.no_agent_assigned')) ) }}
    {% if ticket.agent_team %}{{ _self.row('team', phrase('agent.general.team'), ticket.agent_team.name|default(phrase('agent.general.none')) ) }}{% endif %}

    {% if agent_parts %}
        {% set rowVal %}
            {% for part in agent_parts %}
                {{ part.person.display_name }}
                {% if not loop.last %}, {% endif %}
            {% endfor %}
        {% endset %}
        {{ _self.row('followers', phrase('agent.general.followers'), rowVal, true) }}
    {% endif %}

    {% if ticket.category %}{{ _self.row('category', phrase('agent.general.category'), ticket.category.title ) }}{% endif %}
    {% if ticket.priority %}{{ _self.row('priority', phrase('agent.general.priority'), ticket.priority.title ) }}{% endif %}
    {% if ticket.product %}{{ _self.row('product', phrase('agent.general.product'), ticket.product.title ) }}{% endif %}
    {% if ticket.workflow %}{{ _self.row('workflow', phrase('agent.general.workflow'), ticket.product.workflow ) }}{% endif %}

    {% for f in custom_fields if layout.has('ticket_' ~ f.name) %}
        {% set aliases %}{% for a in f.field_def.getAliases() %}ticket-prop-field-{{ a.getQualifiedName() }}{% endfor %}{% endset %}
        {{ _self.row('field ' ~ aliases, f.title, render_custom_field(f), true) }}
    {% endfor %}

</div>
<br><br>

{{ ticket_messages_block|raw }}
