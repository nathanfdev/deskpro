<dp:subject>{{ phrase('user.email_subjects.ticket-rate') }}</dp:subject>
<table border="0" width="100%" border="0" cellpadding="0" cellspacing="0"><tr>
	<td style="vertical-align: top;" valign="middle">
		<p>{{ phrase('user.emails.ticket_rate-request') }}</p>

		<table class="dp-layout" width="550"><tr>
			<td width="33%">
				<div style="padding: 10px">
					<div class="dp-rate-box dp-positive">
						<div class="rate-icon">
							&#128578;
						</div>
						<div class="rate-text">
							<a href="{{ url_full('user_tickets_feedback', {'ticket_ref': ticket.ref, 'auth': ticket.auth, 'message_id': 0, 'rating': 1}) }}">
								{{ phrase('user.tickets.rate-positive') }}
							</a>
						</div>
					</div>
				</div>
			</td>
			<td width="33%">
				<div style="padding: 10px">
					<div class="dp-rate-box dp-neutral">
						<div class="rate-icon">
							&#128528;
						</div>
						<div class="rate-text">
							<a href="{{ url_full('user_tickets_feedback', {'ticket_ref': ticket.ref, 'auth': ticket.auth, 'message_id': 0, 'rating': 0}) }}">
								{{ phrase('user.tickets.rate-neutral') }}
							</a>
						</div>
					</div>
				</div>
			</td>
			<td width="33%">
				<div style="padding: 10px">
					<div class="dp-rate-box dp-negative">
						<div class="rate-icon">
							&#128577;
						</div>
						<div class="rate-text">
							<a href="{{ url_full('user_tickets_feedback', {'ticket_ref': ticket.ref, 'auth': ticket.auth, 'message_id': 0, 'rating': -1}) }}">
								{{ phrase('user.tickets.rate-negative') }}
							</a>
						</div>
					</div>
				</div>
			</td>
		</tr></table>
	</td>
</tr></table>

<br /><br />

{{ phrase('user.emails.ticket_access_ticket_online') }}
<a href="{{ portal_url(ticket) }}">
	{{ portal_url(ticket) }}
</a>
