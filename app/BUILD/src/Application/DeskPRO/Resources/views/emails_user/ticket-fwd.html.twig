{{ set_tplvar('plain_email', true) }}
<dp:subject>{{ subject | default('FW: ' ~ ticket.subject) }}</dp:subject>

<div>{{ agent_message | raw }}</div>

<br><br/>

{% if app.isPortalEnabled() and attachments and attachments | safe_filter(a => not a.is_inline)  | length > 0 and can_login(person) %}
    <div style="{{ app.getSetting('core_tickets.disable_attachments_list') ? "display:none !important;" : "font-size:11px;" }}">
        <br />
        <strong>{{ phrase('helpcenter.general.attachments') }}</strong>
        {% for attach in attachments %}
            <br />
            &bull; <a href="{{ attach.download_url }}" style="{{ _self.link_style() }}">{{attach.filename}}</a> ({{ attach.readable_filesize }})
            <attachment id="{{ attach.blob_auth }}" filename="{{attach.filename}}" />
        {% endfor %}
    </div>

    <br><br/>
{% endif %}

---------- {{ phrase('agent.tickets.forwarded_message') }} ----------<br/>
{% for message in messages %}
<strong>{{ phrase('agent.general.from') }}:</strong> {{ message.person.display_name }} &lt;{{ message.person.primary_email_address }}&gt;<br/>
<strong>{{ phrase('agent.general.date') }}:</strong> {{ message.date_created|date('full') }}<br/>
<strong>{{ phrase('agent.general.subject') }}:</strong> {{ ticket.subject }}<br/>

<table border="0" cellspacing="0" cellpadding="3">
    <tr><td>
        <table border="0" cellspacing="0" cellpadding="0" width="100%"><tr><td>
            <div data-dp-type="blockquote" class="dp-quoted-message">{{ message.getMessageHtml(false)|raw }}</div>
        </td></tr></table>
    </td></tr>
</table>
<div class="dp-spacer">&nbsp;</div>
{% endfor %}
