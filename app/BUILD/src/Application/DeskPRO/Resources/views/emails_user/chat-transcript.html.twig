<dp:subject>{{ phrase('user.email_subjects.chat_transcript') }}</dp:subject>
{{ phrase('user.emails.chat_transcript') }}

<br /><br />





{% for message in convo_messages|reverse %}
	{% if message.is_sys %}
	<div>
	[{{ message.date_created|date('time') }}] *
	{% if message.metadata.phrase_id %}
		{% if message.is_html %}
				{% if message.metadata.phrase_id == 'message_user-joined' %}
					{{ phrase('helpcenter.messenger.message_user_joined', message.metadata) }}
				{% elseif message.metadata.phrase_id == 'message_user-left' %}
					{{ phrase('helpcenter.messenger.message_user_left', message.metadata) }}
				{% elseif message.metadata.phrase_id == 'message_agent-timeout' %}
					{{ phrase('helpcenter.messenger.message_agent_timeout', message.metadata) }}
				{% elseif message.metadata.phrase_id == 'message_assigned' %}
					{{ phrase('helpcenter.messenger.message_assigned', message.metadata) }}
				{% elseif message.metadata.phrase_id == 'message_chatting-with' %}
					{{ phrase('helpcenter.messenger.message_chatting_with', message.metadata) }}
				{% elseif message.metadata.phrase_id == 'message_ended' %}
					{{ phrase('helpcenter.messenger.message_ended', message.metadata) }}
				{% elseif message.metadata.phrase_id == 'message_ended-by' %}
					{{ phrase('helpcenter.messenger.message_ended_by', message.metadata) }}
				{% elseif message.metadata.phrase_id == 'message_ended-by-user' %}
					{{ phrase('helpcenter.messenger.message_ended_by_user', message.metadata) }}
				{% elseif message.metadata.phrase_id == 'message_finding-agent' %}
					{{ phrase('helpcenter.messenger.message_finding_agent', message.metadata) }}
				{% elseif message.metadata.phrase_id == 'message_long-wait' %}
					{{ phrase('helpcenter.messenger.message_long_wait', message.metadata) }}
				{% elseif message.metadata.phrase_id == 'message_set-department' %}
					{{ phrase('helpcenter.messenger.message_set_department', message.metadata) }}
				{% elseif message.metadata.phrase_id == 'message_started' %}
					{{ phrase('helpcenter.messenger.message_started', message.metadata) }}
				{% elseif message.metadata.phrase_id == 'message_unassigned' %}
					{{ phrase('helpcenter.messenger.message_unassigned', message.metadata) }}
				{% elseif message.metadata.phrase_id == 'message_uploading' %}
					{{ phrase('helpcenter.messenger.message_uploading', message.metadata) }}
				{% elseif message.metadata.phrase_id == 'message_user-returned' %}
					{{ phrase('helpcenter.messenger.message_user_returned', message.metadata) }}
				{% elseif message.metadata.phrase_id == 'message_user-timeout' %}
					{{ phrase('helpcenter.messenger.message_user_timeout', message.metadata) }}
				{% elseif message.metadata.phrase_id == 'message_wait' %}
					{{ phrase('helpcenter.messenger.message_wait', message.metadata) }}
				{% elseif message.metadata.phrase_id == 'message_wait-timeout' %}
					{{ phrase('helpcenter.messenger.message_wait_timeout', message.metadata) }}
				{% endif %}
			{% else %}
				{% if message.metadata.phrase_id == 'message_user-joined' %}
					{{ phrase('helpcenter.messenger.message_user_joined', message.metadata)|e }}
				{% elseif message.metadata.phrase_id == 'message_user-left' %}
					{{ phrase('helpcenter.messenger.message_user_left', message.metadata)|e }}
				{% elseif message.metadata.phrase_id == 'message_agent-timeout' %}
					{{ phrase('helpcenter.messenger.message_agent_timeout', message.metadata)|e }}
				{% elseif message.metadata.phrase_id == 'message_assigned' %}
					{{ phrase('helpcenter.messenger.message_assigned', message.metadata)|e }}
				{% elseif message.metadata.phrase_id == 'message_chatting-with' %}
					{{ phrase('helpcenter.messenger.message_chatting_with', message.metadata)|e }}
				{% elseif message.metadata.phrase_id == 'message_ended' %}
					{{ phrase('helpcenter.messenger.message_ended', message.metadata)|e }}
				{% elseif message.metadata.phrase_id == 'message_ended-by' %}
					{{ phrase('helpcenter.messenger.message_ended_by', message.metadata)|e }}
				{% elseif message.metadata.phrase_id == 'message_ended-by-user' %}
					{{ phrase('helpcenter.messenger.message_ended_by_user', message.metadata)|e }}
				{% elseif message.metadata.phrase_id == 'message_finding-agent' %}
					{{ phrase('helpcenter.messenger.message_finding_agent', message.metadata)|e }}
				{% elseif message.metadata.phrase_id == 'message_long-wait' %}
					{{ phrase('helpcenter.messenger.message_long_wait', message.metadata)|e }}
				{% elseif message.metadata.phrase_id == 'message_set-department' %}
					{{ phrase('helpcenter.messenger.message_set_department', message.metadata)|e }}
				{% elseif message.metadata.phrase_id == 'message_started' %}
					{{ phrase('helpcenter.messenger.message_started', message.metadata)|e }}
				{% elseif message.metadata.phrase_id == 'message_unassigned' %}
					{{ phrase('helpcenter.messenger.message_unassigned', message.metadata)|e }}
				{% elseif message.metadata.phrase_id == 'message_uploading' %}
					{{ phrase('helpcenter.messenger.message_uploading', message.metadata)|e }}
				{% elseif message.metadata.phrase_id == 'message_user-returned' %}
					{{ phrase('helpcenter.messenger.message_user_returned', message.metadata)|e }}
				{% elseif message.metadata.phrase_id == 'message_user-timeout' %}
					{{ phrase('helpcenter.messenger.message_user_timeout', message.metadata)|e }}
				{% elseif message.metadata.phrase_id == 'message_wait' %}
					{{ phrase('helpcenter.messenger.message_wait', message.metadata)|e }}
				{% elseif message.metadata.phrase_id == 'message_wait-timeout' %}
					{{ phrase('helpcenter.messenger.message_wait_timeout', message.metadata)|e }}
				{% endif %}
			{% endif %}
		{% elseif message.is_html %}
			{{message.content|raw}}
		{% else %}
			{{message.content}}
		{% endif %}
		</div>
	{% elseif message.author.is_agent and message.author.id != convo.person.id %}
		<div style="background-color: #EDEDED">
			[{{ message.date_created|date('time') }}] {{ message.author.display_name_user }}:
			{% if message.is_html %}
				{{message.content|raw}}
			{% else %}
				{{message.content}}
			{% endif %}
		</div>
	{% else %}
		<div style="background-color: #EDEDED">
			[{{ message.date_created|date('time') }}] {% if message.author %}{{ message.author.display_name_user }}{% else %}{{ convo.person_email }}{% endif %}:
			{% if message.is_html %}
				{{message.content|raw}}
			{% else %}
				{{message.content}}
			{% endif %}
		</div>
	{% endif %}
{% endfor %}
