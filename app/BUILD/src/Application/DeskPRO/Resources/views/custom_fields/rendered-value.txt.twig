{% set field_rendered %}
	{% block field_rendered %}
		{% if field_handler_name == 'Date' %}
			{{ data.value|date('full') }}
		{% elseif field_handler_name == 'DateTime' %}
			{{ data.value|date('fulltime') }}
		{% elseif field_handler_name == 'Toggle' %}
			{% if data.value == 1 %}
				Checked
			{% else %}
				Unchecked
			{% endif %}
        {% elseif field_handler_name == 'Choice' %}
			{{ data.value|raw }}
        {% elseif field_handler_name == 'File' %}
			{% for file in data.value %}
				<div>
                    <a href="{{ file.downloadUrl }}{{ file.is_image ? '' : '?dl=1' }}" target="_blank">
                        {{ file.filename }}
                        ({{ file.readableFilesize }})
                    </a>
				</div>
			{% endfor %}
		{% else %}
			{{ data.value }}
		{% endif %}
	{% endblock %}
{% endset %}
{% block content %}
	{{ field_rendered }}{{ field_def.getHtmlOption()|raw }}
{% endblock %}
