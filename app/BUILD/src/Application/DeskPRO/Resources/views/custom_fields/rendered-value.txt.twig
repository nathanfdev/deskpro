{% set field_rendered %}
	{% block field_rendered %}
		{% if field_handler_name == 'Date' %}
			{{ data.value|date('full', field_def.getOption('ignore_timezone') ? 'UTC' : null) }}
		{% elseif field_handler_name == 'DateTime' %}
			{{ data.value|date('fulltime', field_def.getOption('ignore_timezone') ? 'UTC' : null) }}
		{% elseif field_handler_name == 'Toggle' %}
			{% if data.value == 1 %}
				Checked
			{% else %}
				Unchecked
			{% endif %}
        {% elseif field_handler_name == 'Choice' %}
			{{ data.value|raw }}
        {% elseif field_handler_name == 'Javascript' %}
			{{ data.value.value|raw }}
        {% elseif field_handler_name == 'File' %}
			{% for file in data.value %}
				{{ file.getDownloadUrl(true) }}
			{% endfor %}
		{% else %}
			{{ data.value }}
		{% endif %}
	{% endblock %}
{% endset %}
{% block content %}
	{{ field_rendered }}{{ field_def.getHtmlOption()|raw }}
{% endblock %}
