<!-- DP_MESSAGE_BEGIN --><div {{ language_html_attr(ticket ? ticket.language : false) }} name="dp_message_{{ message.id }}_begin" class="dp_message_{{ message.id }}_begin">{% if message.primary_translation %}{{ message.primary_translation.message|raw }}{% else %}{{ message.getMessageHtml(false)|raw }}{% endif %}</div><!-- DP_MESSAGE_END -->
<a name="dp_message_{{ message.id }}_end" class="dp_message_{{ message.id }}_end dp_marker_link"></a>
{% if app.isPortalEnabled() and message.attachments.count and not app.getSetting('core_tickets.disable_attachments_list') %}
	{%- set attachmentsList -%}
		{% for attach in message.attachments %}
			{% if not attach.is_inline  %}
				<br />
				&bull; <a href="{{ attach.blob.getDownloadUrl(true) }}" style="{{ _self.link_style() }}">{{attach.blob.filename}}</a> ({{ attach.blob.getReadableFilesize() }})
			{% endif %}
		{% endfor %}
	{%- endset -%}
	{% if attachmentsList %}
	<div style="font-size:11px">
		<br />
		<strong>Attachments</strong>
		{{ attachmentsList }}
	</div>
	{% endif %}
{% endif %}
