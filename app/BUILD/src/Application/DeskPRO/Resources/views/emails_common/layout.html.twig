{% extends 'DeskPRO:emails_common:email-internal.html.twig' %}
{% import 'DeskPRO:emails_common:layout-macros.html.twig' as layout %}
{% block email_body %}
<html>
<head>
	<style type="text/css">
		{% include 'DeskPRO:emails_common:email-css.css.twig' %}
		{% include 'DeskPRO:emails_common:email-custom-css.css.twig' %}
	</style>
</head>
<body>
{%- if not tplvars.plain_email and user_mode == 'agent' and new_message and app.getSetting('core_tickets.enable_email_preview') -%}
	<!--DP_PREVIEW_TEXT_BEGIN--><div id="DP_PREVIEW_TEXT_MARK" class="DP_PREVIEW_TEXT_MARK" style="display:none;font-size:1px;color:#fefefe;line-height:1;max-height:0;max-width:0;opacity:0;overflow:hidden">{{ new_message.getMessagePreviewText(185) }}</div><!--DP_PREVIEW_TEXT_END-->
{% endif %}
<div class="dp-wrap">
{% if not tplvars.plain_email %}
{% if tplvars.agent_reply_above_line and app.getSetting('core_tickets.gateway_agent_require_marker') %}
=== <a class="DP_TOP_MARK dp_marker_link {{ app.getSetting('core_tickets.email_reply_as_note') ? 'DP_NEWMSG_AS_NOTE' : 'DP_NEWMSG_AS_REPLY' }}" id="DP_TOP_MARK {{ app.getSetting('core_tickets.email_reply_as_note') ? 'DP_NEWMSG_AS_NOTE' : 'DP_NEWMSG_AS_REPLY' }}" name="DP_TOP_MARK {{ app.getSetting('core_tickets.email_reply_as_note') ? 'DP_NEWMSG_AS_NOTE' : 'DP_NEWMSG_AS_REPLY' }}">&nbsp;</a>&nbsp;{{ phrase('agent.emails.reply_above_line') }} [<a href="https://www.deskpro.com/go/reply" class="dp-reply-help-link">{{ phrase('agent.chrome.link_help') }}</a>] ===<br />
{% if app.getSetting('core_tickets.email_reply_as_note') %}
--- {{ phrase('agent.emails.reply_is_as_note') }}<br />
{% else %}
--- {{ phrase('agent.emails.reply_sent_to_user', {user: ticket.person.getDisplayContact }) }}<br />
{% if ticket.userParticipants | length > 0 %}
--- {{ phrase('agent.emails.reply_sent_to_ccs', {count: ticket.userParticipants|length}) }} {% for p in ticket.userParticipants %}{{p.displayContact}}{% if not loop.last %}, {% endif %}{% endfor %}<br />
{% endif %}
{% endif %}
<br />
{% endif %}
{% if not tplvars.agent_reply_above_line %}<a class="DP_TOP_MARK dp_marker_link" id="DP_TOP_MARK" name="DP_TOP_MARK">&nbsp;</a>{% endif %}
{% endif %}

<table width="100%" border="0" cellpadding="0" cellspacing="0"><tr><td {% if not tplvars.agent_reply_above_line %}class="DP_TOP_MARK" name="DP_TOP_MARK"{% endif %}>

<table border="0" width="100%" border="0" cellpadding="0" cellspacing="0">
	<tr>
		<td valign="top" class="dp-layout-content">{% if not tplvars.plain_email %}{% include 'DeskPRO:emails_common:email-header.html.twig' %}{% endif %}{% block content %}{% endblock %}</td>
	</tr>
    {% if not tplvars.plain_email %}
	<tr>
		<td valign="top" class="dp-layout-bottom">
			<div class="dp-layout-bottom">
				{% include 'DeskPRO:emails_common:email-footer.html.twig' %}
			</div>
		</td>
	</tr>
	{% endif %}
</table>
{% block email_end %}{% endblock %}

{% if not tplvars.plain_email %}
	{% if tac %}
		{{ layout.replycode(tac.access_code) }}
	{% elseif ticket %}
		{{ layout.replycode(ticket.access_code) }}
	{% endif %}

	{% if tplvars.agent_reply_above_line %}<!--{{ app.getSetting('core_tickets.email_reply_as_note') ? 'DP_NEWMSG_AS_NOTE' : 'DP_NEWMSG_AS_REPLY' }}-->{% endif %}
{% endif %}

</td></tr></table>

</div>

{% if not tplvars.plain_email %}
	{% if not tplvars.agent_reply_above_line %}
		<!--DP_TOP_MARK--><a class="DP_TOP_MARK dp_marker_link {{ app.getSetting('core_tickets.email_reply_as_note') ? 'DP_NEWMSG_AS_NOTE' : 'DP_NEWMSG_AS_REPLY' }}" id="DP_TOP_MARK {{ app.getSetting('core_tickets.email_reply_as_note') ? 'DP_NEWMSG_AS_NOTE' : 'DP_NEWMSG_AS_REPLY' }}" name="DP_TOP_MARK {{ app.getSetting('core_tickets.email_reply_as_note') ? 'DP_NEWMSG_AS_NOTE' : 'DP_NEWMSG_AS_REPLY' }}">&nbsp;</a>
	{% endif %}
	<!--DP_BOTTOM_MARK--><a class="DP_BOTTOM_MARK dp_marker_link {{ app.getSetting('core_tickets.email_reply_as_note') ? 'DP_NEWMSG_AS_NOTE' : 'DP_NEWMSG_AS_REPLY' }}" id="DP_BOTTOM_MARK {{ app.getSetting('core_tickets.email_reply_as_note') ? 'DP_NEWMSG_AS_NOTE' : 'DP_NEWMSG_AS_REPLY' }}" name="DP_BOTTOM_MARK {{ app.getSetting('core_tickets.email_reply_as_note') ? 'DP_NEWMSG_AS_NOTE' : 'DP_NEWMSG_AS_REPLY' }}">&nbsp;</a>
{% endif %}
</body>
</html>
{% endblock %}
