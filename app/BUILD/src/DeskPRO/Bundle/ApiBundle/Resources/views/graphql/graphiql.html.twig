<!DOCTYPE>
<html>
    <head>
        <title>Deskpro</title>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width">

        <style>
            body {
                padding: 0;
                margin: 0;
            }

            #deskpro_auth_input {
                position: absolute;
                top: 16px;
                left: 350px;
                font-family: Helvetica, Arial, Geneva, sans-serif;
            }
        </style>
        <link href="https://cdnjs.cloudflare.com/ajax/libs/graphiql/0.11.11/graphiql.css" rel="stylesheet" type="text/css" />
    </head>
    <body>
        <div id="deskpro_auth_input">
            API Key: <input type="text" id="deskpro_api_key" placeholder="Eg: 1:ABCDEFG">
        </div>
        <div id="mount"></div>

        <script src="https://cdnjs.cloudflare.com/ajax/libs/react/16.2.0/umd/react.production.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/react-dom/16.2.0/umd/react-dom.production.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/graphiql/0.11.11/graphiql.js"></script>
        <script>
            (function() {
                var getParameter = function(name, defaultValue) {
                    var url = window.location.href;
                    name = name.replace(/[\[\]]/g, "\\$&");
                    var regex = new RegExp("[?&]" + name + "(=([^&#]*)|&|#|$)"),
                        results = regex.exec(url);
                    if (!results) return defaultValue;
                    if (!results[2]) return defaultValue;

                    return decodeURIComponent(results[2].replace(/\+/g, " "));
                };

                var fetcher = function(graphQLParams) {
                    var headers = {
                      'Content-Type': 'application/json'
                    };

                    var apikey = document.getElementById('deskpro_api_key').value || null;
                    if (apikey && apikey !== "") {
                      headers['Authorization'] = 'key ' + apikey;
                    }

                    return fetch(window.location.origin + '{{ url }}', {
                        method: 'post',
                        headers: headers,
                        body: JSON.stringify(graphQLParams)
                    }).then(function(resp) {
                        return resp.json();
                    });
                };

                var defaultQuery = " {\n" +
                  "   helpdesk_get_helpdesk_discover {\n" +
                  " 	is_deskpro\n" +
                  " 	helpdesk_url\n" +
                  " 	build\n" +
                  "   }\n" +
                  " }\n";

                ReactDOM.render(
                    React.createElement(GraphiQL, {
                        fetcher: fetcher,
                        query: getParameter('query'),
                        defaultQuery: defaultQuery
                    }),
                    document.getElementById('mount')
                );
            })();
        </script>
    </body>
</html>
