<!-- Please avoid to edit this template as it may break some functionalities -->

{%- if user_mode == 'agent' and new_message and app.getSetting('core_tickets.enable_email_preview') -%}
	<!--DP_PREVIEW_TEXT_BEGIN-->
	<div id="DP_PREVIEW_TEXT_MARK" class="DP_PREVIEW_TEXT_MARK" style="display:none;font-size:1px;color:#fefefe;line-height:1;max-height:0;max-width:0;opacity:0;overflow:hidden">
	    {{ new_message.getMessagePreviewText(185) }}
    </div>
    <!--DP_PREVIEW_TEXT_END-->
{% endif %}
<div class="dp-wrap">
{% if tplvars.agent_reply_above_line and app.getSetting('core_tickets.gateway_agent_require_marker') %}
=== <a class="DP_TOP_MARK dp_marker_link {{ app.getSetting('core_tickets.email_reply_as_note') ? 'DP_NEWMSG_AS_NOTE' : 'DP_NEWMSG_AS_REPLY' }}"
        id="DP_TOP_MARK {{ app.getSetting('core_tickets.email_reply_as_note') ? 'DP_NEWMSG_AS_NOTE' : 'DP_NEWMSG_AS_REPLY' }}"
        name="DP_TOP_MARK {{ app.getSetting('core_tickets.email_reply_as_note') ? 'DP_NEWMSG_AS_NOTE' : 'DP_NEWMSG_AS_REPLY' }}">&nbsp;</a>&nbsp;
    {{ phrase('agent.emails.reply_above_line') }}
    [<a href="https://www.deskpro.com/go/reply" class="dp-reply-help-link">{{ phrase('agent.chrome.link_help') }}</a>]
===<br />
    {% if app.getSetting('core_tickets.email_reply_as_note') %}
--- {{ phrase('agent.emails.reply_is_as_note') }}<br />
    {% else %}
--- {{ phrase('agent.emails.reply_sent_to_user', {user: ticket.person.getDisplayContact }) }}<br />
        {% if ticket.userParticipants | length > 0 %}
--- {{ phrase('agent.emails.reply_sent_to_ccs', {count: ticket.userParticipants|length}) }}
            {% for p in ticket.userParticipants %}
                {{p.displayContact}}
                {% if not loop.last %}, {% endif %}
            {% endfor %}
            <br />
        {% endif %}
    {% endif %}
<br />
{% endif %}
{% if not tplvars.agent_reply_above_line %}
    <a class="DP_TOP_MARK dp_marker_link" id="DP_TOP_MARK" name="DP_TOP_MARK">&nbsp;</a>
{% endif %}