<dp:subject>{{ phrase('portal.email_subjects.share-article', { author_name: author.name }) }}</dp:subject>

<html>
<head>
    {% include 'SendmailBundle:blocks:resources.html.twig' %}
</head>
<body>
{% include 'SendmailBundle:emails_common:email_code_top.html.twig' %}

{% include 'SendmailBundle:blocks:header.html.twig' %}

    <container>
        {{ phrase('portal.emails.greeting', {to_name: recipient.name}) }}

        <br /><br />

        {{ message }}<br />

        <a href="{{ article_link }}">{{ article.title }}</a>

        <br /><br />

        {{ phrase('portal.emails.end_greeting') }}
    </container>

{% include 'SendmailBundle:blocks:footer.html.twig' %}

{% include 'SendmailBundle:emails_common:email_code_bottom.html.twig' %}
</body>
</html>