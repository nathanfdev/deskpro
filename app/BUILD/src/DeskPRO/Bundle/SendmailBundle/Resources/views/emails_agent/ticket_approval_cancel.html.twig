<dp:subject>{{ phrase('agent.emails.agent_cancelled_approval') }}: {{ approval.name }}</dp:subject>

<html>
<head>
    {% include 'SendmailBundle:blocks:resources.html.twig' %}
</head>
<body>
{% include 'SendmailBundle:emails_common:email_code_top.html.twig' %}

{% include 'SendmailBundle:blocks:header.html.twig' %}

<container>

    <h3 class="dp-approval-name">{{ approval.name }}</h3>

    <table class="dp-approval-table">
        <tbody>
        {% if approval.cancelled_by and 'cancelled' == approval.status %}
            <tr>
                <td>{{ phrase('agent.emails.agent_cancelled_by') }}</td>
                <td>
                    {{ approval.cancelled_by.display_name }} ({{ approval.cancelled_at|date }})
                </td>
            </tr>
        {% endif %}
        {% for response in approval.responses %}
            <tr>
                <td class="label-col">
                    {{ phrase(response.isApproved ? 'agent.emails.agent_approval_approved' : 'agent.emails.agent_approval_rejected') }}
                    {{ phrase('agent.emails.agent_by') }}
                </td>
                <td>
                    {{ response.approver.display_name }} ({{ response.createdAt|date }})<br />
                    "{{ response.message }}"
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <table class="dp-approval-table">
        <tbody>
        <tr>
            <td colspan="2">{{ approval.description }}</td>
        </tr>
        {% if approval.created_by %}
            <tr>
                <td class="label-col">{{ phrase('agent.emails.agent_requesting_agent') }}</td>
                <td>{{ approval.created_by.display_name }}</td>
            </tr>
        {% endif %}
        {% if ticket.person %}
            <tr>
                <td class="label-col">{{ phrase('agent.emails.agent_requesting_user') }}</td>
                <td>{{ ticket.person.display_name }}</td>
            </tr>
        {% endif %}
        <tr>
            <td class="label-col">{{ phrase('agent.emails.agent_status') }}</td>
            <td>{{ approval.status_name|capitalize }}</td>
        </tr>
        <tr>
            <td class="label-col">{{ phrase('agent.emails.agent_approval_approved') }}</td>
            <td>{{ approval.approved_responses_count }}/{{ approval.required_approvals }}</td>
        </tr>
        <tr>
            <td class="label-col">{{ phrase('agent.emails.agent_approval_rejected') }}</td>
            <td>{{ approval.rejected_responses_count }}/{{ approval.required_rejections }}</td>
        </tr>
        <tr>
            <td class="label-col">{{ phrase('agent.emails.agent_awaiting_response') }}</td>
            <td>
                {% for awaitingApprover in approval.approvers_pending_response %}
                    <div>{{ awaitingApprover.display_name }}</div>
                {% else %}
                    <em>{{ phrase('agent.emails.agent_all_approvers_have_responded') }}</em>
                {% endfor %}
            </td>
        </tr>
        <tr>
            <td colspan="2">
                {{ phrase('agent.emails.agent_approval_criteria', {
                    requiredApprovals: approval.required_approvals,
                    approversCount: approval.approvers_count,
                    requiredRejections: approval.required_rejections,
                    approversCount: approval.approvers_count,
                }) }}
            </td>
        </tr>
        </tbody>
    </table>

    {% if not approval.has_recipient_responded %}
        <table class="dp-approval-table">
            <tbody>
            <tr>
                <td class="label-col">{{ phrase('agent.emails.agent_approval_approve') }}</td>
                <td>
                    <a href="{{ approve_url }}" title="{{ phrase('agent.emails.agent_approval_approve')|e }}">
                        {{ approve_url }}
                    </a>
                </td>
            </tr>
            <tr>
                <td class="label-col">{{ phrase('agent.emails.agent_approval_reject') }}</td>
                <td>
                    <a href="{{ reject_url }}" title="{{ phrase('agent.emails.agent_approval_reject')|e }}">
                        {{ reject_url }}
                    </a>
                </td>
            </tr>
            </tbody>
        </table>
    {% endif %}

</container>

{% include 'SendmailBundle:blocks:footer.html.twig' %}

{% include 'SendmailBundle:emails_common:email_code_bottom.html.twig' %}
</body>
</html>
