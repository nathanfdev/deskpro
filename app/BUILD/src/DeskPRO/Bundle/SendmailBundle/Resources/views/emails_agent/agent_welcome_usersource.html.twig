<dp:subject>{{ phrase('agent.emails.subject_new_agent') }}</dp:subject>
<html>
<head>
    {% include 'SendmailBundle:blocks:resources.html.twig' %}
</head>
<body>
{% include 'SendmailBundle:emails_common:email_code_top.html.twig' %}

{% include 'SendmailBundle:blocks:header.html.twig' %}

	<container>
		{% if app.isCloud() %}
			{% if app.isDemo() %}
				{{ phrase('agent.emails.newagent-about-cloud-demo') }}
			{% else %}
				{{ phrase('agent.emails.newagent-about-cloud') }}
			{% endif %}
		{% else %}
			{% if app.isDemo() %}
				{{ phrase('agent.emails.newagent-about-demo') }}
			{% else %}
				{{ phrase('agent.emails.newagent-about') }}
			{% endif %}
		{% endif %}

		<br/><br/>

		{{ phrase('agent.emails.newagent-login-link', { link: login_link }) }}<br />
		{{ phrase('agent.emails.newagent-login-your-email', { email: recipient.primary_email }) }}<br />
		{% if agent_password %}
			{{ phrase('agent.emails.newagent-login-initial-password', { password: agent_password }) }}<br/><br/>
		{% else %}
			{{ phrase('agent.emails.newagent-login-your-password') }}<br/><br/>
		{% endif %}

		{{ phrase('agent.emails.newagent-about-pdf') }}

		<br/><br/>

		{{ phrase('agent.emails.newagent-help') }}

		<br/><br/>

		{{ phrase('agent.emails.newagent-welcome-to-deskpro') }}
	</container>

{% include 'SendmailBundle:blocks:footer.html.twig' %}

{% include 'SendmailBundle:emails_common:email_code_bottom.html.twig' %}
</body>
</html>