{{ set_tplvar('agent_notification_footer', 'notify') }}
<dp:subject>
	{{ phrase('agent.feedback.new_feedback') }}	{{ topic.title }} {% if topic.status == 'hidden' and not topic.is_reviewed %}({{ phrase('agent.general.requires_validation') }}){% endif %}
</dp:subject>

<html>
<head>
	{% include 'SendmailBundle:blocks:resources.html.twig' %}
</head>
<body>
{% include 'SendmailBundle:emails_common:email_code_top.html.twig' %}

{% include 'SendmailBundle:blocks:header.html.twig' %}

	<container>
		{{ phrase('agent.feedback.user_submitted_new_feedback', {name: person.display_contact }) }}
		{% if topic.status == 'hidden' and not topic.is_reviewed %}({{ phrase('agent.general.requires_validation') }}){% endif %}

		<br /><br />

		{{ phrase('agent.emails.view_online_at') }} <a href="{{ login_link }}#app.community,i:{{ topic.id }}">{{ login_link }}#app.community,fb_content,i:{{ topic.id }}</a>

		<br /><br />

		{{ topic.content|raw }}
	</container>

{% include 'SendmailBundle:blocks:footer.html.twig' %}

{% include 'SendmailBundle:emails_common:email_code_bottom.html.twig' %}
</body>
</html>
