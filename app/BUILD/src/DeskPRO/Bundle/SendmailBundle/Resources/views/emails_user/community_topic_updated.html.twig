<dp:subject>{{ phrase('user.email_subjects.feedback_updated') }}</dp:subject>

<html>
<head>
    {% include 'SendmailBundle:blocks:resources.html.twig' %}
</head>
<body>
{% include 'SendmailBundle:emails_common:email_code_top.html.twig' %}

{% include 'SendmailBundle:blocks:header.html.twig' %}

	<container>
		{% if show == 'validated' %}
			{{ phrase('user.emails.feedback_published', {'title':topic.title}) }}
		{% elseif show == 'closed' %}
			{{ phrase('user.emails.feedback_closed', {'title':topic.title, 'status':topic.status_category.title}) }}
		{% elseif show == 'closed' %}
			{{ phrase('user.emails.feedback_updated', {'title': topic.title, 'status':topic.statuscategory.title}) }}
		{% endif %}

		<br /><br />

		{{ phrase('user.emails.feedback_votes', {'count': topic.votes}) }}
		<a href="{{ community_topic_link }}">
			{{ community_topic_link }}
		</a>
	</container>

{% include 'SendmailBundle:blocks:footer.html.twig' %}

{% include 'SendmailBundle:emails_common:email_code_bottom.html.twig' %}
</body>
</html>
