<dp:subject>{{ phrase('helpcenter.emails.community_topic_updated_subject') }}</dp:subject>

<html>
<head>
    {% include 'SendmailBundle:blocks:resources.html.twig' %}
</head>
<body>
{% include 'SendmailBundle:emails_common:email_code_top.html.twig' %}

{% include 'SendmailBundle:blocks:header.html.twig' %}

	{% if show == 'validated' %}
		{{ phrase('helpcenter.emails.community_topic_published', {'title':topic.title}) }}
	{% elseif show == 'closed' %}
		{{ phrase('helpcenter.emails.community_topic_closed', {'title':topic.title, 'status':topic.status_category.title}) }}
	{% elseif show == 'closed' %}
		{{ phrase('helpcenter.emails.community_topic_updated', {'title': topic.title, 'status':topic.statuscategory.title}) }}
	{% endif %}

	<br /><br />

	{{ phrase('helpcenter.emails.community_topic_votes', {'count': topic.votes}) }}
	<a href="{{ community_topic_link }}">
		{{ community_topic_link }}
	</a>

{% include 'SendmailBundle:blocks:footer.html.twig' %}

{% include 'SendmailBundle:emails_common:email_code_bottom.html.twig' %}
</body>
