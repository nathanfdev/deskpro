<dp:subject>{{ phrase('agent.emails.name_reset_your_password', {name: performer.display_name}) }}</dp:subject>

<html>
<head>
	{% include 'SendmailBundle:blocks:resources.html.twig' %}
</head>
<body>
{% include 'SendmailBundle:blocks:header.html.twig' %}

    <container>
        {{ phrase('agent.emails.name_reset_your_password', {name: performer.display_name}) }}

        <br/><br/>

        <strong>{{ phrase('agent.emails.login_url') }}:</strong> <a href="{{ login_link }}">{{ login_link }}</a><br />
        <strong>{{ phrase('agent.general.your_email_address') }}:</strong> {{ recipient.primary_email }}<br />
        <strong>{{ phrase('agent.general.new_password') }}:</strong> {{ new_password }}

        <br/><br/>

        {{ phrase('agent.emails.change_password_instructions') }}
    </container>

{% include 'SendmailBundle:blocks:footer.html.twig' %}
</body>
</html>
