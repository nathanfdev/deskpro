<dp:subject>{{ phrase('helpcenter.emails.tickets_re', {subject: ticket.subject}) }}</dp:subject>

<html>
<head>
	{% include 'SendmailBundle:blocks:resources.html.twig' %}
</head>
<body>
{% include 'SendmailBundle:emails_common:email_code_top.html.twig' %}

{% include 'SendmailBundle:blocks:header.html.twig' %}

	{{ phrase('helpcenter.emails.greeting', {to_name: recipient.name}) }}

	<br /><br />

	{{ phrase('helpcenter.emails.reject_resolved') }}

	<br /><br />

	{% if app.getSetting('user.portal_enabled') %}
		{{ phrase('helpcenter.emails.reject_resolved_new', {
			email_to: email_to,
			link: url_full('portal_new_ticket')
		}, true) }}
	{% else %}
		{{ phrase('helpcenter.emails.reject_resolved_newemail', {
			email_to: email_to
		}, true) }}
	{% endif %}

	{% if app.isPortalEnabled() and can_login(recipient.id) %}
		<br /><br />

		{{ phrase('helpcenter.emails.ticket_access_ticket_online') }}
		<a href="{{ ticket_link }}">{{ ticket_link }}</a>
	{% endif %}

{% include 'SendmailBundle:blocks:footer.html.twig' %}

{% include 'SendmailBundle:emails_common:email_code_bottom.html.twig' %}
</body>
</html>
