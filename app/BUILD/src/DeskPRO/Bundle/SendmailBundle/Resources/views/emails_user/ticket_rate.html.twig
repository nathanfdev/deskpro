<dp:subject>{{ phrase('helpcenter.emails.ticket_rate', {subject: ticket.subject}) }}</dp:subject>

<html>
<head>
	{% include 'SendmailBundle:blocks:resources.html.twig' %}
</head>
<body>
{% include 'SendmailBundle:emails_common:email_code_top.html.twig' %}

{% include 'SendmailBundle:blocks:header.html.twig' %}

	<table border="0" width="100%" border="0" cellpadding="0" cellspacing="0"><tr>
		<td style="vertical-align: top;" valign="middle">
			<p>{{ phrase('helpcenter.emails.ticket_rate_request', {subject: ticket.subject}) }}</p>

			<table class="dp-layout" width="550"><tr>
				<td width="33%">
					<div style="padding: 10px">
						<div class="dp-rate-box dp-positive">
							<div class="rate-icon">
								☺
							</div>
							<div class="rate-text">
								<a href="{{ url_full('user_tickets_feedback', {'ticket_ref': ticket.ref, 'auth': ticket.auth, 'message_id': 0, 'rating': 1}) }}">
									{{ phrase('helpcenter.tickets.rate_positive') }}
								</a>
							</div>
						</div>
					</div>
				</td>
				<td width="33%">
					<div style="padding: 10px">
						<div class="dp-rate-box dp-neutral">
							<div class="rate-icon">
								&mdash;
							</div>
							<div class="rate-text">
								<a href="{{ url_full('user_tickets_feedback', {'ticket_ref': ticket.ref, 'auth': ticket.auth, 'message_id': 0, 'rating': 0}) }}">
									{{ phrase('helpcenter.tickets.rate_neutral') }}
								</a>
							</div>
						</div>
					</div>
				</td>
				<td width="33%">
					<div style="padding: 10px">
						<div class="dp-rate-box dp-negative">
							<div class="rate-icon">
								☹
							</div>
							<div class="rate-text">
								<a href="{{ url_full('user_tickets_feedback', {'ticket_ref': ticket.ref, 'auth': ticket.auth, 'message_id': 0, 'rating': -1}) }}">
									{{ phrase('helpcenter.tickets.rate_negative') }}
								</a>
							</div>
						</div>
					</div>
				</td>
			</tr></table>
		</td>
	</tr></table>

	<br /><br />

	{{ phrase('helpcenter.emails.ticket_access_ticket_online') }}
	<a href="{{ ticket_link }}">
		{{ ticket_link }}
	</a>

{% include 'SendmailBundle:blocks:footer.html.twig' %}

{% include 'SendmailBundle:emails_common:email_code_bottom.html.twig' %}
</body>
</html>
