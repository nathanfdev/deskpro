<dp:subject>{{ phrase('helpcenter.emails.chat_transcript_subject') }}</dp:subject>

<html>
<head>
    {% include 'SendmailBundle:blocks:resources.html.twig' %}
</head>
<body>
{% include 'SendmailBundle:emails_common:email_code_top.html.twig' %}

{% include 'SendmailBundle:blocks:header.html.twig' %}

	{{ phrase('helpcenter.emails.chat_transcript') }}

	<br /><br />

	{% for message in convo_messages|reverse %}
		{% if message.is_sys %}
			<div>
				[{{ message.date_created|date('time') }}] *
				{% if message.metadata.phrase_id %}
					{% if message.is_html %}
						{{ phrase('helpcenter.chat.'~ message.metadata.phrase_id, message.metadata) }}
					{% else %}
						{{ phrase('helpcenter.chat.'~ message.metadata.phrase_id, message.metadata)|e }}
					{% endif %}
				{% elseif message.is_html %}
					{{message.content|raw}}
				{% else %}
					{{message.content}}
				{% endif %}
			</div>
		{% elseif message.author.is_agent and message.author.id != convo.person.id %}
			<div style="background-color: #EDEDED">
				[{{ message.date_created|date('time') }}] {{ message.author.display_name_user }}:
				{% if message.is_html %}
					{{message.content|raw}}
				{% else %}
					{{message.content}}
				{% endif %}
			</div>
		{% else %}
			<div style="background-color: #EDEDED">
				[{{ message.date_created|date('time') }}] {% if message.author %}{{ message.author.display_name_user }}{% else %}{{ convo.person_email }}{% endif %}:
				{% if message.is_html %}
					{{message.content|raw}}
				{% else %}
					{{message.content}}
				{% endif %}
			</div>
		{% endif %}
	{% endfor %}

{% include 'SendmailBundle:blocks:footer.html.twig' %}

{% include 'SendmailBundle:emails_common:email_code_bottom.html.twig' %}
</body>
</html>
