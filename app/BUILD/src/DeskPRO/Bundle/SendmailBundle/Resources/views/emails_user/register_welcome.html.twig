<dp:subject>{{ phrase('user.email_subjects.register-welcome') }}</dp:subject>

<html>
<head>
	{% include 'SendmailBundle:blocks:resources.html.twig' %}
</head>
<body>
{% include 'SendmailBundle:blocks:header.html.twig' %}

	<container>
		{{ phrase('user.emails.greeting', {to_name: recipient.name}) }}

		<br/><br/>

		{% if verify_url is null %}
			{{ phrase('user.emails.register-welcome') }}<br/>
			{% if portal_url is not defined %}
				{% set portal_url = url_full('portal_home') %}
			{% endif %}
			<a href="{{ portal_url }}">{{ portal_url }}</a>
		{% else %}
			{{ phrase('user.emails.register-confirm') }}<br/>
			<a href="{{ verify_url }}">{{ verify_url }}</a>
		{% endif %}
	</container>

  {% include 'SendmailBundle:blocks:footer.html.twig' %}
</body>
</html>
