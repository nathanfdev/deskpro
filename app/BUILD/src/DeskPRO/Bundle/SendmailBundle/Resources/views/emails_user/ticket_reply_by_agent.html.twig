<dp:subject>{{ phrase('user.email_subjects.tickets_re') }}</dp:subject>

<html>
<head>
	{% include 'SendmailBundle:blocks:resources.html.twig' %}
</head>
<body>
{% include 'SendmailBundle:blocks:header.html.twig' %}

	<container>
		{% set message = ticket_messages|first %}
		{% if message.person.is_agent %}
			{% include 'SendmailBundle:emails_common:ticket_message_agent.html.twig' with {message: message, ticketdisplay: context.ticketdisplay } %}
		{% else %}
			{% include 'SendmailBundle:emails_common:ticket_message.html.twig' with {message: message, ticketdisplay: context.ticketdisplay } %}
		{% endif %}

		{% if show_rating_link and app.isPortalEnabled() %}
			{% set message = ticket_messages|first %}
			{% include 'SendmailBundle:emails_common:ticket_rating_links.html.twig' with {message: message, ticket: ticket} %}
		{% endif %}

		<br /><br />

		{% for message in ticket_messages|slice(1) %}
			{% if not context.message_limit or loop.index0 < context.message_limit %}
				{% include 'SendmailBundle:emails_common:ticket_message_row.html.twig' with { message: message, ticketdisplay: context.ticketdisplay } %}
			{% endif %}
		{% endfor %}

		{% if app.isPortalEnabled() %}
			<br /><br />

			{{ phrase('user.emails.ticket_access_ticket_online') }}
			<a href="{{ ticket_link }}">{{ ticket_link }}</a>
		{% endif %}
	</container>

  {% include 'SendmailBundle:blocks:footer.html.twig' %}
</body>
</html>
