<dp:subject>{{ phrase('helpcenter.emails.tickets_re', {subject: ticket.subject}) }}</dp:subject>

<html>
<head>
	{% include 'SendmailBundle:blocks:resources.html.twig' %}
</head>
<body>
{% include 'SendmailBundle:emails_common:email_code_top.html.twig' %}

{% include 'SendmailBundle:blocks:header.html.twig' %}
	{% if reply.person.is_agent %}
		{% include 'SendmailBundle:emails_common:ticket_message_agent.html.twig' with {message: reply, ticketdisplay: context.ticketdisplay } %}
	{% else %}
		{% include 'SendmailBundle:emails_common:ticket_message.html.twig' with {message: reply, ticketdisplay: context.ticketdisplay } %}
	{% endif %}

	{% if show_rating_link and app.isPortalEnabled() and can_login(recipient.id) %}
		{% set message = reply %}
		{% include 'SendmailBundle:emails_common:ticket_rating_links.html.twig' with {message: message, ticket: ticket} %}
	{% endif %}

	<br /><br />

	{% for message in ticket_messages|slice(1) %}
		{% if not context.message_limit or loop.index0 < context.message_limit %}
			{% include 'SendmailBundle:emails_common:ticket_message_row.html.twig' with { message: message, ticketdisplay: context.ticketdisplay } %}
		{% endif %}
	{% endfor %}

	{% if app.isPortalEnabled() and can_login(recipient.id) %}
		<br /><br />

		{{ phrase('helpcenter.emails.ticket_access_ticket_online') }}
		<a href="{{ ticket_link }}">{{ ticket_link }}</a>
	{% endif %}

{% include 'SendmailBundle:blocks:footer.html.twig' %}

{% include 'SendmailBundle:emails_common:email_code_bottom.html.twig' %}
</body>
</html>
