<dp:subject>
	{{ phrase('user.email_subjects.feedback_sub_updated') }}
</dp:subject>

<html>
<head>
    {% include 'SendmailBundle:blocks:resources.html.twig' %}
</head>
<body>
{% include 'SendmailBundle:emails_common:email_code_top.html.twig' %}

{% include 'SendmailBundle:blocks:header.html.twig' %}

	<container>
		<h1>{{ phrase('user.emails.feedback-updated-items', {count: updated_items|length}) }}</h1>
		<ul>
			{% for item in updated_items %}
				<li><a href="{{ url_full('portal_feedback_view', {slug: item.slug}) }}">{{ item.title }}</a></li>
			{% endfor %}
		</ul>

		<div class="dp-hr">&nbsp;</div>
		{{ phrase('user.emails.feedback-explain', {deskpro_url: portal_home }) }}
	</container>

{% include 'SendmailBundle:blocks:footer.html.twig' %}

{% include 'SendmailBundle:emails_common:email_code_bottom.html.twig' %}
</body>
</html>