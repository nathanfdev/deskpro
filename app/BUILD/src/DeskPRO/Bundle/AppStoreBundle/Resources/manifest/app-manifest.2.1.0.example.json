{
  "appVersion": "0.1.0",
  "author": {
    "name": "Deskpro Apps",
    "email": "apps@deskpro.com",
    "url": "https://www.deskpro.com"
  },
  "description": "A foundation to get you started developing React DeskPro Apps with the best developer experience ",
  "name": "@deskproapps/app-boilerplate-react",
  "version": "2.1.0",
  "title": "Your app title",
  "isSingle": true,
  "scope": "agent",
  "state" : [
    {
      "name": "settings",
      "isBackendOnly": false,
      "permRead": "EVERYBODY",
      "permWrite": "OWNER"
    }
  ],
  "targets": [
    {
      "target": "ticket-sidebar",
      "url": "html/index.html"
    }
  ],
  "settings": [
    {
      "name": "my_setting",
      "type": "text/textarea/select/hidden",
      "defaultValue": "foo",
      "isPrivate": false,

      "options": [
        {"name": "example_option", "value": "foo"}
      ]
    }
  ],
  "deskproApiTags": ["tickets.*"],
  "externalApis": [
    "/^https?://([^.]+\\.)*mailchimp.com/?.*$/"
  ]
}
