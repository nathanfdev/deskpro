{
  "appVersion": "0.1.0",
  "author": {
    "name": "Deskpro Apps",
    "email": "apps@deskpro.com",
    "url": "https://www.deskpro.com"
  },
  "description": "A foundation to get you started developing React DeskPro Apps with the best developer experience ",
  "name": "@deskproapps/app-boilerplate-react",
  "version": "2.4.0",
  "title": "Your app title",
  "isSingle": true,
  "targets": [
    { "target": "ticket-sidebar", "url": "html/index.html" },
    { "target": "install", "url": "html/install.html" }
  ],
  "storage": [
    {
      "name": "install",
      "isBackendOnly": false,
      "permRead": "EVERYBODY",
      "permWrite": "OWNER"
    },
    {
      "name": "auth",
      "isBackendOnly": false,
      "permRead": "OWNER",
      "permWrite": "OWNER"
    },
    {
      "name": "cards",
      "isBackendOnly": false,
      "permRead": "EVERYBODY",
      "permWrite": "EVERYBODY"
    },

    {
      "name": "apiKey",
      "isBackendOnly": true,
      "permRead": "EVERYBODY",
      "permWrite": "OWNER"
    },
    {
      "name": "welcomeMessage",
      "isBackendOnly": false,
      "permRead": "EVERYBODY",
      "permWrite": "OWNER"
    },
    {
      "name": "foobar",
      "isBackendOnly": false,
      "permRead": "EVERYBODY",
      "permWrite": "OWNER"
    },
    {
      "name": "yesorno",
      "isBackendOnly": false,
      "permRead": "EVERYBODY",
      "permWrite": "OWNER"
    }
  ],
  "settings": [
    {
      "type": "text",
      "name": "apiKey",
      "title": "Third party api key",

      "defaultValue": "",
      "required": true,
      "validator": {
        "type": "regex",
        "pattern": "^.+"
      },
      "isBackendOnly": true
    },
    {
      "type": "text",
      "name": "welcomeMessage",
      "title": "Welcome message displayed by the app",

      "defaultValue": "",
      "required": true,
      "validator": {
        "type": "regex",
        "pattern": "^.+"
      }
    },
    {
      "type": "choice",
      "name": "foobar",
      "title": "choose foo or bar",

      "defaultValue": "foo",
      "required": true,
      "multi": false,
      "choices": [
        { "title": "Bar", "value": "bar" },
        { "title": "Foo", "value": "foo" }
      ]
    },
    {
      "type": "boolean",
      "name": "yesorno",
      "title": "choose yes or no",

      "defaultValue": false,
      "required": true
    }
  ],

  "customFields" : [
    {
      "alias": "adate",
      "attachedTo" : "organization",
      "type": "date",
      "title": "Field title"
    },
    {
      "alias": "trello-cards",
      "attachedTo" : "ticket",
      "type": "dataJson",
      "title": "Field title"
    }
  ],

  "deskproApiTags": [
    "tickets.*"
  ],
  "domainWhitelist": [
    "/^https?://([^.]+\\.)*mailchimp.com/?.*$/"
  ]
}
