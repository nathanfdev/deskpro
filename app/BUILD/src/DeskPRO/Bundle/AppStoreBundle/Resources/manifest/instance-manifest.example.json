      "is_private": false,

      "options": [
        {"name": "example_option", "value": "foo"}
      ]
    }
  ],
  "deskproApiTags": ["tickets.*"],
  "externalApis": [
    "/^https?://([^.]+\\.)*mailchimp.com/?.*$/"
  ]
}
