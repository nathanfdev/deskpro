<div class="dp-po-wrap-collapse-md">
    <div class="dp-po-comments comments-list dp-po-md-collapse-title dp-po-title">
        <span class="dp-po-comments-title-wrap">{{ phrase('portal.general.comments-title', { count: comments|length }) }}</span>
    </div>
    <div class="dp-po-comments-wrap dp-po-md-collapse-content">
        {% for comment in comments %}
            <div class="dp-po-comments-item">
                <div class="dp-po-subtitle">
                    <span class="dp-po-Avatar">
                        <img class="dp-po-Avatar-icon" src="{{ avatar_url(comment.person) }}" aria-hidden="true">
                        <span class="dp-po-Avatar-name">{{ comment.userName(true) }}</span>
                    </span>
                    <span class="dp-po-label label--time">
                        <span class="dp-po-Icon Icon--history Icon--primary"></span>
                        {{ comment.date_created|date }}
                    </span>
                </div>
                <p class="dp-po-comment-subtitle">
                    <p>{{ comment.content_html_plain|raw }}</p>
                </p>
                {% if not comment.is_visible %}
                    <p class="dp-po-comment-subtitle">{{ phrase('portal.general.comments-pending-validation') }}</p>
                {% endif %}
            </div>
        {% endfor %}
    </div>
</div>


