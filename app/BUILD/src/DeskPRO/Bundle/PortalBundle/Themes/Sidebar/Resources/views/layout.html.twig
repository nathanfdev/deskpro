<!DOCTYPE html>
<html {% if language.is_rtl %}class="as-rtl" dir="rtl"{% endif %}>
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=Edge,chrome=1" />
    <meta charset="utf-8" />
    <title>{% if page_title is defined %}{{ page_title }}{% else %}{{ global_settings.get('core.site_name')|default(global_settings.get('core.deskpro_name')) }}{% endif %}</title>
    <meta name="viewport" content="width=device-width">
    {% include 'Theme:Internal:head-include.html.twig' %}
    <link href="{{ portal_css_url() }}" media="all" rel="stylesheet" type="text/css" />
</head>
<body class="{% if is_agent() or is_admin() or is_impersonating() %}with-agent-bar{% endif %} portal-mode-{{ portal_mode() }}">
{% include 'Theme:Internal:custom-header.html.twig' %}
{% include 'Theme:Internal:body-include.html.twig' %}
{% block doc_begin %}{% endblock %}

<div class="dp-page-body">

    {% show agent_bar %}

    <div class="world">
        <section class="page-top-section">
            <div class="column-full">
              {% show section alerts %}
              {% show section page_top %}
            </div>
        </section>

        <section class="column-full page-main-section">
            <div class="column-half-plus">
              {% show section search_bar %}
                <div class="column-full">

                <section>
                    {% show section flashes %}
                    <div class="column-full">
                        {% block page_content %}
                            {% block content_header %}
                                <section class="welcome-news">
                                    {% show section nav_buttons %}
                                </section>
                            {% endblock content_header %}
                            <section>
                                <div class="column-full">
                                    {% block inner_content %}
                                    {% endblock inner_content %}
                                </div>
                            </section>
                        {% endblock page_content %}
                    </div>
                </section>
                    </div>
            </div>

            <aside class="sidebar">

              {#<div class="sidebar-content">#}

                {#<div class="sidebar-user-welcome">#}
                  {#<h1>#}
                    {#<span style="background: url(https://randomuser.me/api/portraits/med/men/36.jpg) no-repeat; background-size: cover" class="agent-avatar agent-avatar-mini"></span>#}
                    {#Welcome back, Jeff</h1>#}
                  {#<ul>#}
                    {#<li>#}
                      {#<a href="#"><i class="fa fa-user"></i> <span>Edit your profile</span></a>#}
                    {#</li>#}

                    {#<li>#}
                      {#<a href="#"><i class="fa fa-tags"></i> <span>View your 30 tickets</span></a>#}
                    {#</li>#}

                    {#<li>#}
                      {#<a href="#"><i class="fa fa-power-off"></i> <span>Log out</span></a>#}
                    {#</li>#}
                  {#</ul>#}
                {#</div>#}

              {#</div>#}

              {#<hr>#}

              {#<div class="sidebar-content">#}
                {#<div class="sidebar-nav-list">#}
                  {#<ul>#}
                    {#<li>#}
                      {#<a href="#" class="active"><i class="fa fa-list-alt"></i> <span>Knowledgebase</span></a>#}
                    {#</li>#}

                    {#<li>#}
                      {#<a href="#"><i class="fa fa-calendar-o"></i> <span>News</span></a>#}
                    {#</li>#}

                    {#<li>#}
                      {#<a href="#"><i class="fa fa-thumbs-o-up"></i> <span>Feedback</span></a>#}
                    {#</li>#}

                    {#<li>#}
                      {#<a href="#"><i class="fa fa-clone"></i> <span>Downloads</span></a>#}
                    {#</li>#}

                    {#<li>#}
                      {#<a href="#"><i class="fa fa-envelope-o"></i> <span>Contact Us</span></a>#}
                    {#</li>#}
                  {#</ul>#}
                {#</div>#}
              {#</div>#}

              {#<hr>#}




                {% show section sidebar %}
            </aside>
        </section>

        <section class="page-bottom-section">
            <div class="column-full">
                {% show section footer %}
            </div>
        </section>
    </div>
</div>

{% include 'Theme:Internal:custom-footer.html.twig' %}
{% block doc_end %}{% endblock %}
{% include 'Theme:Internal:foot-include.html.twig' %}

<script type="text/javascript">
    {{ portal_custom_js()|raw }}
</script>

</body>
</html>

