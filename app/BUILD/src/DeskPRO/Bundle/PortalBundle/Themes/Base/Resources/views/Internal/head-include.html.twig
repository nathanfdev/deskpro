    Note we only use async if we dont have a custom head include.
    Custom head includes often include jquery-type code, and
    so we need to make bundle load before that gets called.
#}
<script type="text/javascript" src="{{ asset('DeskPRO_PortalBundle.js', 'app_assets') }}" {% if not custom_include_code %}async="async"{% endif %}></script>

