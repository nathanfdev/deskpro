{% extends 'Theme::layout.html.twig' %}

{% block inner_content %}
    <article class="news kb-article">
        <header>
            <h1>{{ phrase(error_title) ?: error_title }}</h1>

            {% if error_description is defined %}
            <div class="article-meta">
                <p>{{ phrase(error_description) ?: error_description }}</p>
            </div>
            {% endif %}
        </header>
    </article>
{% endblock inner_content %}
