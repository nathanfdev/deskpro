{{ form_errors(form) }}
{{ form_start(form) }}
<div class="feedback-form">
    {{ form_errors(form.category) }}

    <div class="main-input dpx-form">
        <h3>{{ phrase('portal.feedback.form_i_have_a') }}:</h3>
        <div class="question-type">
            {{ form_widget(form.category) }}
        </div>
    </div>
</div>

<div class="feedback-form-expanded as-no-dpui dpx-form"{% if form_was_submitted %} data-do-show="true"{% endif %}>
    {% if is_user() %}
        <div>
            <a class="user-logged-in" href="#">
                <i class="fa fa-user"></i> {{ phrase('portal.feedback.form_logged_in_as') }}:
                <span>{{ user.name }}</span>, {{ phrase('portal.feedback.form_from_email') }}
                <span>{{ user.primary_email_address }}</span>
            </a>
        </div>
    {% endif %}

    <div class="bucket">
        <label>{{ phrase('portal.feedback.form_title') }}</label>
        {{ form_errors(form.title) }}
        {{ form_widget(form.title, { attr: { placeholder: 'A one-sentance summary', style: 'width: 100%' } }) }}
    </div>

    <div class="bucket">
        <label>{{ phrase('portal.feedback.form_tell_us_more') }}</label>
        {{ form_errors(form.content) }}
        {{ form_widget(form.content, { attr: { placeholder: 'More details...' } } ) }}
    </div>

    {{ form_widget(form.custom_data) }}

    <div class="bucket new-ticket-attachements">
        <div class="title">{{ phrase('portal.feedback.form_attach_files') }}:</div>
        {{ form_errors(form.attachments) }}
        {{ form_widget(form.attachments) }}
        {{ form_widget(form.more_attachments) }}
    </div>

    {% if form.name is defined %}
        <div class="bucket">
        {{ phrase('portal.feedback.form_name_not_shown') }}:<br>
        {{ form_errors(form.name) }}
        {{ form_widget(form.name) }}
        </div>
    {% endif %}

    {% if form.email is defined %}
        <div class="bucket">
        {{ phrase('portal.feedback.form_email_not_shown') }}:<br>
        {{ form_errors(form.email) }}
        {{ form_widget(form.email) }}
        </div>
    {% endif %}

    {% if form.captcha is defined %}
        <div class="bucket">
        {{ form_errors(form.captcha) }}
        {{ form_widget(form.captcha) }}
        </div>
    {% endif %}

    <button class="main-input button" type="submit">{{ phrase('portal.feedback.form_btn_submit') }}</button>
</div>
{{ form_rest(form) }}
{{ form_end(form) }}
