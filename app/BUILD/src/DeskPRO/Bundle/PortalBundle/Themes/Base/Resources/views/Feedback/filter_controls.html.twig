<script>
    window.FEEDBACK_FILTER_STATE = {{ filter_js|raw }};
</script>
<div class="feedback-filter">
    <ul class="flat-tabs">
        <li>
            <a href="{{ path('portal_feedback_browse', { filter_uri: 'all' }) }}"{% if status == 'all' %} class="active"{% endif %}>{{ phrase('portal.feedback.filter_all_items') }}</a>
        </li>

        <li>
            <a href="{{ path('portal_feedback_browse', { filter_uri: 'active' }) }}"{% if status == 'active' %} class="active"{% endif %}>{{ phrase('portal.feedback.filter_open_items') }} <span class="control active-control"><i class="fa fa-caret-down"></i></span></a>
        </li>

        <li>
            <a href="{{ path('portal_feedback_browse', { filter_uri: 'closed' }) }}"{% if status == 'closed' %} class="active"{% endif %}>{{ phrase('portal.feedback.filter_closed_items') }} <span class="control"><i class="fa fa-caret-down"></i></span></a>
        </li>

        {# My votes & stars not supported yet #}
        {#<li>#}
            {#<a href="#">{{ phrase('portal.feedback.filter_my_votes_and_stars') }}</a>#}
        {#</li>#}
    </ul>

    {% if feedback_types is defined and feedback_types|length > 0 %}
    <div>
        <ul class="slider-list">
            {% for type in feedback_types %}
            <li>
                <div class="slider-panel">
                    {% if type.id in types or types is empty %}
                        <a href="{{ path('portal_feedback_browse', { filter_uri: 'type-' ~ type.id }) }}" class="slider">
                            <span class="slider-status">{{ phrase('portal.general.toggle_on') }}</span>
                            <span class="slider-icon"><i class="fa fa-check"></i></span>
                        </a>
                        <span class="slider-label">{{ object_phrase(type) }}</span>
                        <span class="slider-options"><i class="fa fa-caret-down"></i></span>
                    {% else %}
                        <a href="{{ path('portal_feedback_browse', { filter_uri: 'type-' ~ type.id }) }}"
                           class="slider off">
                            <span class="slider-icon"><i class="fa fa-times"></i></span>
                            <span class="slider-status">{{ phrase('portal.general.toggle_off') }}</span>
                        </a>
                        <span class="slider-label">{{ object_phrase(type) }}</span>
                        <span class="slider-options"><i class="fa fa-caret-down"></i></span>
                    {% endif %}
                </div>
            </li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}
</div>
