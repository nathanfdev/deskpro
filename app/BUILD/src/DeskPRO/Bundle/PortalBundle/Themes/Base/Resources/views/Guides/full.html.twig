<!DOCTYPE html>
<html {% if language.is_rtl %}class="as-rtl" dir="rtl"{% endif %}>
<head>
    <title>{{ guide.title }}</title>
    <link href="{{ asset('DeskPRO_PortalBundle_vendors_style.css', 'app_assets') }}" media="all" rel="stylesheet" type="text/css" />
    <link href="{{ portal_css_url() }}" media="all" rel="stylesheet" type="text/css" />
    <style>
        @media print {
            .sf-toolbar {
                display: none !important;
            }
        }
        body {
            width: 1000px;
        }
    </style>
</head>
<body>
    <div class="guides pdf">
        {% for topic in guide.topics %}
            <div class="topic">
                <h1 id="{{ topic.slug }}">{{ topic.title }}</h1>
                {% for child in topic.children %}
                    {%  include 'Theme:Guides:full_topic.html.twig' with {'topic': child, 'depth': 2} %}
                {%  endfor %}
            </div>
        {% endfor %}
    </div>
</body>
