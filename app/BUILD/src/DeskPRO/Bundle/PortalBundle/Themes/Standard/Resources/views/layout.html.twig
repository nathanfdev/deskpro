<!DOCTYPE html>
<html {% if language.is_rtl %}class="as-rtl" dir="rtl"{% endif %}>
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=Edge,chrome=1" />
    <meta charset="utf-8" />
    <title>{% if page_title is defined %}{{ page_title }}{% else %}{{ global_settings.get('core.deskpro_name') }}{% endif %}</title>
    <meta name="viewport" content="width=device-width">
    {% include 'Theme:Internal:head-include.html.twig' %}
    {#<link href="{{ path('serve_brand_asset', { brand_id: brand('id'), file: 'DeskPRO/Bundle/Build/Resources/style/DeskPRO_PortalBundle_style.css' }) }}" media="all" rel="stylesheet" />#}
    <link href="{{ portal_css_url() }}" media="all" rel="stylesheet" type="text/css" />
</head>
<body class="{% if (is_agent() or is_admin() or is_impersonating()) and portal_mode() != 'preview' %}with-agent-bar{% endif %} portal-mode-{{ portal_mode() }}">
{% include 'Theme:Internal:custom-header.html.twig' %}
{% include 'Theme:Internal:body-include.html.twig' %}
{% block doc_begin %}{% endblock %}

<div class="dp-page-body">

{% show agent_bar %}

<div class="world with-searchbox">
    <section class="page-top-section">
        <div class="column-full">
          {% show section alerts %}
          {% show section page_top %}
        </div>
    </section>

    <section class="search-section">
        <div class="column-full">
          {% show section search_and_contact_bar %}
        </div>
    </section>

    {% show section flashes %}

    {% block page_content %}
        {% block content_header %}
            <section class="welcome-news">
                {% show section nav_buttons %}
            </section>
        {% endblock content_header %}
        <section class="with-dpx">
            <div class="column-full">
              {% block inner_content %}{% endblock inner_content %}
            </div>
        </section>
    {% endblock %}

  <section class="page-bottom-section">
    <div class="column-full">
      {% show section footer %}
    </div>
  </section>
</div>

</div>

{% include 'Theme:Internal:custom-footer.html.twig' %}
{% block doc_end %}{% endblock %}
{% include 'Theme:Internal:foot-include.html.twig' %}

<script type="text/javascript">
    {{ portal_custom_js()|raw }}
</script>

</body>
</html>

