      var guides = '{{ guides_json|raw }}';
      var commentsCaptcha = '{{ captcha|json_encode|raw }}';
      var topicCommentForm = {{ new_comment_form ? 'true' : 'false' }};
      var loggedIn = {{ app.user ? 'true' : 'false' }};
      var routePath = window.location.hash.replace(/#\//, '');
      var topicList = '{{ helpcenter.topics(guide)|json_encode|escape('js')|raw }}';
      var twoLevelSection = {{ helpcenter.guideTwoLevelSection(guide) ? 'true' : 'false' }};
      if (routePath[0] != '/')
        routePath = '/' + routePath;

      var reactProps = {
        routePath: routePath
      };

      window.document.getElementsByClassName('dp-po-guides-loading')[0].style.display = 'block';

      function start() {
        if (typeof window.HelpcenterBundle === 'undefined') {
          setTimeout(start.bind(this), 100);
        } else {
          window.HelpcenterBundle.render(reactProps, document.getElementById('main'));
        }
      }

      start();


    </script>
