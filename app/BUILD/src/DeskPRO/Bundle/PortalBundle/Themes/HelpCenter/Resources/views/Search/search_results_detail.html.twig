{% extends 'Theme::layout.html.twig' %}
{% import 'Theme:Search:search_macros.html.twig' as search_macros %}

{% block page_content %}
{% set ticket_info = results.ticket is defined ? results.ticket.pageinfo : null %}
{% set ticket_results = results.ticket is defined ? results.ticket.results : null %}
{% set article_info = results.article is defined ? results.article.pageinfo : null %}
{% set article_results = results.article is defined ? results.article.results : null %}
{% set news_info = results.news is defined ? results.news.pageinfo : null %}
{% set news_results = results.news is defined ? results.news.results : null %}
{% set community_info = results.community is defined ? results.community.pageinfo : null %}
{% set community_results = results.community is defined ? results.community.results : null %}
{% set download_info = results.download is defined ? results.download.pageinfo : null %}
{% set download_results = results.download is defined ? results.download.results: null %}
{% set guide_info = results.topic is defined ? results.topic.pageinfo : null %}
{% set guide_results = results.topic is defined ? results.topic.results : null %}

<div class="dp-po">
    <main id="main" tabindex="-1" class="dp-po-main dp-po-search-results-detail">
        <div class="container">
            <div class="row">
                <div class="col-sm-10 col-centered">
                    <div class="dp-po-title">
                        <img class="dp-po-title-svg" src="{{ asset('img/page-icons/search.svg', 'help_center') }}" />
                        <h1 class="dp-po-title-text">{{ phrase('helpcenter.search.search_results') }}</h1>
                    </div>
                    <div class="row">
                        <div class="col-sm-4">
                            <div class="dp-po-search-sidebar">
                                <ul class="dp-po-search-sidebar-list">
                                    {% if (can_use_articles()) %}
                                        <li class="dp-po-search-sidebar-item">
                                            <a href="" class="dp-po-search-sidebar-link {% if not article_results %}disabled{% endif %} {% if active == 'article' %}active{% endif %}" data-type="article">
                                                <img class="dp-po-search-sidebar-image icon-svg"
                                                     src="{{ asset('img/page-icons/knowledgebase.svg', 'help_center') }}">{{ phrase('helpcenter.general.nav_kb') }}
                                                <span class="dp-po-search-sidebar-count">{{ article_info.total_results | default(0) }}</span>
                                            </a>
                                        </li>
                                    {% endif %}
                                    {% if app.hasBeta('guides') and can_use_guides() %}
                                        <li class="dp-po-search-sidebar-item">
                                            <a class="dp-po-search-sidebar-link {% if not guide_results %}no-results{% endif %} {% if active == 'guide' %}active{% endif %}" href="" data-type="guide">
                                                <img class="dp-po-search-sidebar-image icon-svg"
                                                     src="{{ asset('img/page-icons/guides.svg', 'help_center') }}">{{ phrase('helpcenter.general.nav_guides') }}
                                                <span class="dp-po-search-sidebar-count">{{ guide_info.total_results | default(0) }}</span></a>
                                        </li>
                                    {% endif %}
                                    {% if can_use_community() %}
                                        <li class="dp-po-search-sidebar-item">
                                            <a class="dp-po-search-sidebar-link {% if not community_results %}no-results{% endif %} {% if active == 'community' %}active{% endif %}" href="" data-type="community">
                                                <img class="dp-po-search-sidebar-image icon-svg"
                                                     src="{{ asset('img/page-icons/community.svg', 'help_center') }}">{{ phrase('helpcenter.general.nav_community') }}
                                                <span class="dp-po-search-sidebar-count">{{ community_info.total_results | default(0) }}</span></a>
                                        </li>
                                    {% endif %}
                                    {% if can_use_news() %}
                                        <li class="dp-po-search-sidebar-item">
                                            <a class="dp-po-search-sidebar-link {% if not news_results %}no-results{% endif %} {% if active == 'news' %}active{% endif %}" href="" data-type="news">
                                                <img class="dp-po-search-sidebar-image icon-svg"
                                                     src="{{ asset('img/page-icons/news.svg', 'help_center') }}">{{ phrase('helpcenter.general.nav_news') }}
                                                <span class="dp-po-search-sidebar-count">{{ news_info.total_results | default(0) }}</span></a>
                                        </li>
                                    {% endif %}
                                    {% if can_use_downloads() %}
                                        <li class="dp-po-search-sidebar-item">
                                            <a class="dp-po-search-sidebar-link {% if not download_results %}no-results{% endif %} {% if active == 'download' %}active{% endif %}" href="" data-type="download">
                                                <img class="dp-po-search-sidebar-image icon-svg"
                                                     src="{{ asset('img/page-icons/download.svg', 'help_center') }}">{{ phrase('helpcenter.general.files_type') }}
                                                <span class="dp-po-search-sidebar-count">{{ download_info.total_results | default(0) }}</span></a>
                                        </li>
                                    {% endif %}
                                    {% if can_use_tickets() %}
                                        <li class="dp-po-search-sidebar-item">
                                            <a class="dp-po-search-sidebar-link {% if not ticket_results %}no-results{% endif %} {% if active == 'ticket' %}active{% endif %}" href="" data-type="ticket">
                                                <i class="dp-po-search-sidebar-image dp-po-icon fad fa-envelope"></i>{{ phrase('helpcenter.search.your_tickets') }}
                                                <span class="dp-po-search-sidebar-count">{{ ticket_info.total_results | default(0) }}</span></a>
                                        </li>
                                    {% endif %}
                                </ul>
                            </div>
                        </div>
                        <div class="col-sm-8">
                            <div class="dp-po-block dp-po-section">
                                <div id="article_tab" class="dp-po-search-details" {% if active != 'article' %}style="display: none" {% endif %}>
                                    <div class="dp-po-search-details-title">
                                        {{ phrase('helpcenter.search.showing_results_for', {type: phrase('helpcenter.general.nav_kb'), query: query}) }} <span class="count">({{ article_info.total_results | default(0) }})</span>
                                    </div>
                                    <ul class="dp-po-search-details-list">
                                        {% for result_set in article_results %}
                                            {{ search_macros.search_result(result_set, 'dp-po-search-details') }}
                                        {% endfor %}
                                    </ul>
                                </div>
                                <div id="guide_tab" class="dp-po-search-details" {% if active != 'guide' %}style="display: none" {% endif %}>
                                    <div class="dp-po-search-details-title">
                                        {{ phrase('helpcenter.search.showing_results_for', {type: phrase('helpcenter.general.nav_guides'), query: query}) }} <span class="count">({{ guide_info.total_results | default(0) }})</span>
                                    </div>
                                    <ul class="dp-po-search-details-list">
                                        {% for result_set in guide_results %}
                                            {{ search_macros.search_result(result_set, 'dp-po-search-details') }}
                                        {% endfor %}
                                    </ul>
                                </div>
                                <div id="community_tab" class="dp-po-search-details" {% if active != 'community' %}style="display: none" {% endif %}>
                                    <div class="dp-po-search-details-title">
                                        {{ phrase('helpcenter.search.showing_results_for', {type: phrase('helpcenter.general.nav_community'), query: query}) }} <span class="count">({{ community_info.total_results | default(0) }})</span>
                                    </div>
                                    <ul class="dp-po-search-details-list">
                                        {% for result_set in community_results %}
                                            {{ search_macros.search_result(result_set, 'dp-po-search-details') }}
                                        {% endfor %}
                                    </ul>
                                </div>
                                <div id="news_tab" class="dp-po-search-details" {% if active != 'news' %}style="display: none" {% endif %}>
                                    <div class="dp-po-search-details-title">
                                        {{ phrase('helpcenter.search.showing_results_for', {type: phrase('helpcenter.general.nav_news'), query: query}) }} <span class="count">({{ news_info.total_results | default(0) }})</span>
                                    </div>
                                    <ul class="dp-po-search-details-list">
                                        {% for result_set in news_results %}
                                            {{ search_macros.search_result(result_set, 'dp-po-search-details') }}
                                        {% endfor %}
                                    </ul>
                                </div>
                                <div id="download_tab" class="dp-po-search-details" {% if active != 'download' %}style="display: none" {% endif %}>
                                    <div class="dp-po-search-details-title">
                                        {{ phrase('helpcenter.search.showing_results_for', {type: phrase('helpcenter.general.files_type'), query: query}) }} <span class="count">({{ download_info.total_results | default(0) }})</span>
                                    </div>
                                    <ul class="dp-po-search-details-list">
                                        {% for result_set in download_results %}
                                            {{ search_macros.search_result(result_set, 'dp-po-search-details') }}
                                        {% endfor %}
                                    </ul>
                                </div>
                                <div id="ticket_tab" class="dp-po-search-details" {% if active != 'ticket' %}style="display: none" {% endif %}>
                                    <div class="dp-po-search-details-title">
                                        {{ phrase('helpcenter.search.showing_results_for', {type: phrase('helpcenter.general.your_tickets'), query: query}) }} <span class="count">({{ ticket_info.total_results | default(0) }})</span>
                                    </div>
                                    <ul class="dp-po-search-details-list">
                                        {% for result_set in ticket_results %}
                                            {{ search_macros.search_result(result_set, 'dp-po-search-details') }}
                                        {% endfor %}
                                    </ul>
                                </div>
                            </div>
                            {% for type, result_set in results %}
                                <div id="{{ type }}_pager" class="dp-po-search-pager" {% if active != type %}style="display: none" {% endif %}>
                                    {% include 'Theme:Common:pager.html.twig' with {
                                        pager: result_set.pager,
                                        pager_options: result_set.pager_options,
                                    } %}
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
{% endblock page_content %}
