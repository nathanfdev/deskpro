{% extends 'Theme::layout.html.twig' %}
{% import 'Theme:Portal:User/macros.html.twig' as macros %}

{% block page_content %}
    <div class="dp-po">
        <main id="main" tabindex="-1" class="dp-po-main {% if main_class is defined %}{{ main_class }}{% endif %}">
            <div class="container">
                <div class="row">
                    <div class="col-sm-7 col-centered">
                        <div class="dp-po-title">
                            <img class="dp-po-title-svg" src="{{ asset('img/page-icons/community.svg', 'help_center') }}">
                            <h1 class="dp-po-title-text">{{ phrase_object(current_forum, 'verb_action') }}
                            </h1>
                        </div>
                        <div class="dp-po-block">
                            {{  macros.lockout_notice(phrase('portal.account.community-lockout'), lockout, lockout_time) }}
                            <div class="dp-po-community-form dpx-form helpcenter-form">
                                {{ form_errors(form) }}
                                {{ form_start(form, {attr: {class: 'do-po-form'}}) }}

                                    {% if form.name is defined and form.email is defined %}
                                        <div class="row">
                                            <div class="col-sm-6">
                                                {{ form_row(form.name, {label: 'helpcenter.general.name'}) }}
                                            </div>
                                            <div class="col-sm-6">
                                                {{ form_row(form.email, {label: 'helpcenter.general.email_address'}) }}
                                            </div>
                                        </div>
                                    {% endif %}

                                    {{ form_row(form.title, {label: 'helpcenter.community.form_topic_title'}) }}

                                    {{ form_row(form.content, {label: 'helpcenter.community.form_description'}) }}

                                    {{ form_widget(form.custom_data) }}

                                    <div class="form-group">
                                        {{ form_label(form.attachments, phrase('helpcenter.forms.add_attachments_action')) }}
                                        {{ form_errors(form.attachments) }}
                                        {{ form_widget(form.attachments) }}
                                        {{ form_widget(form.more_attachments, {attr: {style: 'display: none;'}}) }}
                                    </div>

                                    {% if form.captcha is defined %}
                                        {{ form_row(form.captcha) }}
                                    {% endif %}

                                    <button type="submit" class="btn btn-primary btn-lg">
                                        {{ phrase_object(current_forum, 'verb_action') }}
                                    </button>

                                {{ form_rest(form) }}
                                {{ form_end(form) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
{% endblock page_content %}
