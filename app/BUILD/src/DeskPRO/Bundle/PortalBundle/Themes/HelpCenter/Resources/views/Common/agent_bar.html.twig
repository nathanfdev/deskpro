{% if impersonation_on %}
    {% set is_agent = impersonator.isAgent() %}
    {% set is_admin = impersonator.isAdmin() %}
{% else %}
    {% set is_agent = is_agent() %}
    {% set is_admin = is_admin() %}
{% endif %}
{#
if impersonation is ON "user" is the user being impersonated
if impersonation is ON "impersonator" is the agent
if impersonation is OFF "user" is the agent
if impersonation is OFF "impersonator" is the agent
#}
{% if is_agent or is_admin %}
<div class="dp-po-admin-wrapper">
    <div class="dp-po-admin-menu">
        <a class="dp-po-admin-menu-link" href="{{ path('agent') }}" data-toggle="dropdown" aria-haspopup="true"
           aria-expanded="false">
            <span class="dp-po-icon dp-po-icon-round"><i class="fal fa-user-headset" alt="agent icon" aria-label="agent icon"></i></span>
            {{ phrase('helpcenter.general.agent') }}
            <i class="dp-po-icon far fa-angle-down" aria-hidden="true"></i>
        </a>
        <div class="dropdown-menu dropdown-menu-left">
            <a class="dropdown-item" href="{{ path('agent') }}">
                <span class="dp-po-icon dp-po-icon-round"><i class="fal fa-user-headset"></i></span>
                {{ phrase('helpcenter.general.agent_bar_agent_home') }}
            </a>
            {% if content is defined and agent_can_edit(content) %}
                <div class="dp-po-admin-edit">
                    <a href="{{ agent_edit_link(content) }}" class="btn btn-icon btn-outline-secondary dp-po-admin-edit-btn" target="_blank"> <i
                                class="dp-po-icon fal fa-pencil"></i>
                        {{ phrase('helpcenter.general.edit_this_page') }}</a>
                </div>
            {% endif %}
            {% if app.user.hasPerm('agent_publish.use') %}
                <hr />
                <a class="dropdown-item" href="{{ path('agent') }}#app.community,ct_content">
                    {{ phrase('helpcenter.general.agent_bar_agent_community') }}
                </a>
                <a class="dropdown-item" href="{{ path('agent') }}#app.publish">
                    {{ phrase('helpcenter.general.agent_bar_agent_kb') }}
                </a>
                <a class="dropdown-item" href="{{ path('agent') }}#app.publish">
                    {{ phrase('helpcenter.general.agent_bar_agent_news') }}
                </a>
                {% if app.hasBeta('guides') %}
                    <a class="dropdown-item" href="{{ path('agent') }}#app.publish">
                        {{ phrase('helpcenter.general.agent_bar_agent_guides') }}
                    </a>
                {% endif %}
                <a class="dropdown-item" href="{{ path('agent') }}#app.publish">
                    {{ phrase('helpcenter.general.agent_bar_agent_dl') }}
                </a>
            {% endif %}
        </div>
    </div>
    {% if is_admin %}
    <div class="dp-po-admin-menu">
        <a class="dp-po-admin-menu-link" href="{{ path('agent') }}#admin:/" data-toggle="dropdown" aria-haspopup="true"
           aria-expanded="false">
            <span class="dp-po-icon dp-po-icon-round"><i class="fal fa-user-crown" alt="admin icon" aria-label="admin icon"></i></span>
            {{ phrase('helpcenter.general.admin') }}
            <i class="dp-po-icon far fa-angle-down" aria-hidden="true"></i>
        </a>
        <div class="dropdown-menu dropdown-menu-left">
            <a class="dropdown-item" href="{{ path('agent') }}#admin:/"><span class="dp-po-icon dp-po-icon-round"><i class="fal fa-user-crown"></i></span>
                {{ phrase('helpcenter.general.admin_home') }}
            </a>
            <hr />
            <a class="dropdown-item" href="{{ path('agent') }}#admin:/portal/{{ active_brand_id }}/portal_editor">
                {{ phrase('helpcenter.general.agent_bar_admin_portal') }}
            </a>
            <a class="dropdown-item" href="{{ path('agent') }}#admin:/setup/languages/default">
                {{ phrase('helpcenter.general.agent_bar_admin_lang') }}
            </a>
            <a class="dropdown-item" href="{{ path('agent') }}#admin:/portal/{{ active_brand_id }}/community/settings">
                {{ phrase('helpcenter.general.agent_bar_admin_community') }}
            </a>
            <a class="dropdown-item" href="{{ path('agent') }}#admin:/portal/{{ active_brand_id }}/kb/settings">
                {{ phrase('helpcenter.general.agent_bar_admin_kb') }}
            </a>
            <a class="dropdown-item" href="{{ path('agent') }}#admin:/portal/{{ active_brand_id }}/news/settings">
                {{ phrase('helpcenter.general.agent_bar_admin_news') }}
            </a>
            {% if app.hasBeta('guides') %}
                <a class="dropdown-item" href="{{ path('agent') }}#admin:/portal/{{ active_brand_id }}/guides/settings">
                    {{ phrase('helpcenter.general.agent_bar_admin_guides') }}
                </a>
            {% endif %}
            <a class="dropdown-item" href="{{ path('agent') }}#admin:/portal/{{ active_brand_id }}/downloads/settings">
                {{ phrase('helpcenter.general.agent_bar_admin_dl') }}
            </a>
        </div>
    </div>
    {% endif %}
</div>

{% if impersonation_on %}
<div class="dp-po-impersonation" >
    <p class="dp-po-impersonation-badge"><i class="dp-po-icon fas fa-user-secret"></i> {{ phrase('helpcenter.general.impersonation_mode') }}</p>
    <p class="dp-po-impersonation-user">{{ app.user.primary_email_address }} <a href="{{ logout_path('portal') }}&_dp_impersonate_exit=1"
                                                                               class="dp-po-impersonation-close"><i class="dp-po-icon fas fa-times-circle"></i></a></p>
</div>
{% endif %}
{% endif %}
