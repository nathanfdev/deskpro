{% extends 'Theme::layout.html.twig' %}

{% block page_content %}
<div class="dp-po">
    <main class="dp-po-main">
        <div class="container">
            <div class="row">
                <div class="col-sm-9">
                    <div class="dp-po-title">
                        <h2 class="dp-po-title-text">{{ guide.title }}</h2>
                    </div>
                </div>
                <div class="column-full">
                    {% show topic_list with {guide: guide} %}
                </div>
            </div>
        </div>
    </main>
</div>
{% endblock page_content %}
