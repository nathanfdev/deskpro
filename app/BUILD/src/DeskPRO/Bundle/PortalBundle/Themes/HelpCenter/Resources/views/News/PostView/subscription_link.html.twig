{% if brand_setting('user.news_subscriptions') %}
    <a href="{{ portal_path(post, 'toggle_subscription') }}" class="post-link" rel="noindex, nofollow">
        {% if is_subscribed %}
            {{ phrase('helpcenter.general.unsubscribe_action') }}
        {% else %}
            {{ phrase('helpcenter.general.subscribe_action') }}
        {% endif %}
        <i class="fas fa-rss"></i>
    </a>
{% endif %}
