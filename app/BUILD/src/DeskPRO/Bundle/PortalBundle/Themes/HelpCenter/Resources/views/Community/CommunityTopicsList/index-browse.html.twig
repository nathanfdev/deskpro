<div id="hc_community_page">
    <script>
        window.COMMUNITY_FILTER_STATE = {{ filter_js|raw }};
    </script>
    <div class="row">
        <div class="col-sm-6">
            {% include "Theme:Community:CommunityTopicsList/forum-selection.html.twig" with {
                forums: community_forums,
                current_forum: current_forum,
            } %}
        </div>
        <div class="col-sm-3">
            <div class="dp-po-community-title">
                <div class="dp-po-community-title-button">
                    <a href="" class="dp-po-community-title-button-link"><i class="dp-po-icon fad fa-money-check-edit"></i> Submit
                        suggestion</a>
                    <a class="dp-po-community-title-button-dropdown" href="" data-toggle="dropdown" aria-haspopup="true"
                       aria-expanded="false">
                        <i class="dp-po-icon dp-po-community-title-arrow far fa-angle-down"></i>
                    </a>
                    <div class="dropdown-menu dropdown-menu-right">
                        <a class="dropdown-item" href="#">
                            <i class="dp-po-icon dp-po-icon-danger fad fa-hands-helping"></i> Ask for Help
                        </a>
                        <a class="dropdown-item" href="#">
                            <i class="dp-po-icon dp-po-icon-success fad fa-comment-alt-check"></i> Submit Feedback
                        </a>
                        <a class="dropdown-item" href="#">
                            <i class="dp-po-icon dp-po-icon-pink fad fa-comments"></i> Start a Chat
                        </a>
                        <a class="dropdown-item" href="#">
                            <i class="dp-po-icon dp-po-icon-warning fad fa-code"></i> Ask Developers
                        </a>
                        <a class="dropdown-item" href="#">
                            <i class="dp-po-icon dp-po-icon-info fad fa-receipt"></i> Talk to Finance
                        </a>
                        <a class="dropdown-item" href="#">
                            <i class="dp-po-icon dp-po-icon-neutral fad fa-rocket"></i> Start a Discussion
                        </a>
                    </div>
                </div>

            </div>

        </div>
        <div class="col-sm-3">
            <div class="dp-po-subscribe dp-po-subscribe-large">
                {% if brand_setting('user.community_subscriptions') %}
                    <a href="{{ path('portal_community_root_toggle_subscription', {target: path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params'))}) }}"
                       class="dp-po-subscribe-btn"
                       rel="noindex, nofollow"
                    >
                        <i class="dp-po-icon fad fa-envelope"></i>
                        {{ phrase(is_subscribed ? 'portal.general.btn-unsubscribe' : 'portal.general.btn-subscribe') }}
                        <i class="dp-po-icon far fa-check"></i>
                    </a>
                {% endif %}
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-12">
            <article class="community-filter-interactive as-no-dpui">
                {% include 'Theme:Community:filter_controls.html.twig' with {
                    filter_js: filter_js,
                    current_forum: current_forum,
                    view: view,
                    filter_params: filter_params,
                    view_mode: view_mode,
                } %}
                <div class="paged-results">
                    {% include 'Theme:Community:CommunityTopicsList/detail.html.twig' with {
                        topics_list: topics_list,
                    } %}
                </div>
            </article>
        </div>
    </div>

</div>
