<div class="community-item-controls" ref="communityItemControls">
    <a
        {% if (not item.isClosed) %}
        href="{{ portal_path(item, user_up_voted(item) ? 'vote_down' : 'vote_up') }}"
        data-vote-up-url="{{ portal_path(item, 'vote_up') }}"
        data-vote-down-url="{{ portal_path(item, 'vote_down') }}"
        title="{{ phrase('helpcenter.community.btn-vote') }}"
        {% endif %}
       class="i-agree {% if user_up_voted(item) %} agreed{% endif %}{% if item.isClosed %} closed{% endif %}{% if not item.can_rate %} rate_forbidden{% endif %}"
       rel="noindex, nofollow"
    >
        <i class="fas fa-thumbs-up"></i>
        <div>
            {% if item.isClosed %}
                {{ phrase('helpcenter.community.btn-closed') }}
            {% else %}
                {{ phrase('helpcenter.community.btn-vote') }}
            {% endif %}
        </div>
        <span class="counter-wrapper">
          <span class="counter">{{ item.total_rating }}</span>
        </span>
    </a>
</div>
