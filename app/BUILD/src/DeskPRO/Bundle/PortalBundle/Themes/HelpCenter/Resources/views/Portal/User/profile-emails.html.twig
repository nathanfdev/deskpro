{% extends 'Theme::layout.html.twig' %}

{% block page_content %}
    <div class="dp-po">
        <main class="dp-po-main dp-po-your-account">
            <div class="container">
                <div class="dp-po-title">
                    <img src="{{ asset('img/page-icons/account.svg', 'help_center') }}" role="presentation" class="dp-po-title-svg">
                    <h2 class="dp-po-title-text">{{ phrase('helpcenter.account.section-title-your-account') }}</h2>
                </div>
                <div class="row">
                    <div class="col-sm-4">
                        <div class="dp-po-block">
                            {% include 'Theme:Portal:User/profile-sidebar.html.twig' with { active : 'emails' } %}
                        </div>
                    </div>
                    <div class="col-sm-8">
                        <div class="dp-po-block dp-po-section">
                            <div class="dp-po-account-email">
                                <h3 class="dp-po-account-email-title">{{ phrase('helpcenter.profile.email-address') }}</h3>
                                <ul class="dp-po-account-email-list">
                                    {% for email in person.emails %}
                                        <li class="dp-po-account-email-item">
                                            <p class="dp-po-account-email-address">
                                                <i class="dp-po-icon fad fa-envelope"></i>
                                                {{ email.email }}
                                            </p>
                                            {% if person.emails|length > 1 %}
                                                {% if email.isPrimary %}
                                                    <ul class="dp-po-account-email-action">
                                                        <li class="dp-po-account-email-action-item">{{ phrase('helpcenter.account.email-primary-description') }}</li>
                                                    </ul>
                                                {% else %}
                                                    <ul class="dp-po-account-email-action">
                                                        <li class="dp-po-account-email-action-item">
                                                            <a
                                                                    id="{{ email.email }}"
                                                                    href="{{ path('portal_user_profile_emails', { new_primary: email.id }) }}"
                                                                    class="dp-po-account-email-action-link">
                                                                {{ phrase('helpcenter.account.email-btn-make-primary') }}
                                                            </a>
                                                        </li>
                                                        <li class="dp-po-account-email-action-item">
                                                            <a
                                                                    href="{{ path('portal_user_profile_emails', { remove_email: email.id }) }}"
                                                                    class="dp-po-account-email-action-link">
                                                                {{ phrase('helpcenter.account.email-btn-remove') }}
                                                            </a>
                                                        </li>
                                                    </ul>
                                                {% endif %}
                                            {% endif %}
                                        </li>
                                    {% endfor %}
                                </ul>
                                {% if pending_emails|length  > 0 %}
                                    <h3 class="dp-po-account-email-title">{{ phrase('helpcenter.account.your-pending-email-addresses') }}</h3>
                                    <ul class="dp-po-account-email-list">
                                        {% for saved_form_id, email in pending_emails %}
                                            <li class="dp-po-account-email-item">
                                                <p class="dp-po-account-email-address">
                                                    <i class="dp-po-icon fad fa-envelope"></i>
                                                    {{ email }}
                                                </p>
                                                <ul class="dp-po-account-email-action">
                                                    <li class="dp-po-account-email-action-item">
                                                        <a
                                                            href="{{ path('portal_user_profile_emails_resend_validation', { id: saved_form_id}) }}"
                                                            class="dp-po-account-email-action-link">
                                                            {{ phrase('helpcenter.account.email-btn-resend-validation') }}
                                                        </a>
                                                    </li>
                                                    <li class="dp-po-account-email-action-item">
                                                        <a
                                                            href="{{ path('portal_user_profile_emails_remove_pending', { id: saved_form_id}) }}"
                                                            class="dp-po-account-email-action-link">
                                                            {{ phrase('helpcenter.account.email-btn-remove') }}
                                                        </a>
                                                    </li>
                                                </ul>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                                {% if add_email_form %}
                                    {{ form_start(add_email_form, { attr: { class: 'form-ticket' } }) }}
                                    {{ form_errors(add_email_form) }}
                                    {{ form_row(add_email_form.email) }}
                                    {{ form_rest(add_email_form) }}
                                    <button type="submit" class="btn btn-primary">{{ phrase('helpcenter.forms.label_save') }}</button>
                                    {{ form_end(add_email_form) }}
                                {% else %}
                                    <a href="javascript:void(0)" class="btn btn-primary">Add email</a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
{% endblock page_content %}
