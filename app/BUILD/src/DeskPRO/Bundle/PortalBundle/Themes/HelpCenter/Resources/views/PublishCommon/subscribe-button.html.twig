<div class="dp-po-subscribe dp-po-subscribe-large">
    <div class="dropdown">
        <button class="dp-po-subscribe-btn" type="button" id="dropdownMenu2" data-toggle="dropdown" aria-haspopup="true"
                aria-expanded="false" data-offset="0,10">
            <i class="dp-po-icon fad fa-envelope"></i> {{ phrase('portal.general.btn-subscribe') }} <i class="dp-po-icon far fa-check"></i>
        </button>
        <div class="dropdown-menu" aria-labelledby="dropdownMenu2">
            {% for sub in subscriptionInfo %}
                <a class="dropdown-item" href="{{ sub.toggleUrl }}">
                    <i class="dp-po-icon {{ sub.icon }}"></i> {{ sub.title }} <i
                            class="dp-po-icon far fa-check"></i></a>
            {% endfor %}
            <span class="dp-po-subscribe-divider"></span>
            <a class="dropdown-item dp-po-subscribe-manage" href="{{ url('portal_user_profile') }}">{{ phrase('portal.general.btn-manage_subscriptions') }}</a>
        </div>
    </div>
</div>
