{% extends 'Theme:Pdf:layout.html.twig' %}

{% block page_top %}

	{% include 'Theme:Pdf:breadcrumbs.html.twig' %}

	<div class="row mb-4">
		<div class="col-sm-9">
			<div class="dp-po-title">
				<h2 class="dp-po-title-text">
					{{ topic.realTitle }}
					{% if topic.statusCategory %}
						<span class="badge" style="background-color: {{ topic.statusCategory.color }};">
                            {{ topic.statusCategory.title }}
                        </span>
					{% endif %}
				</h2>
			</div>
			<div class="row align-items-end">
				<div class="col-sm-10">
					<div class="dp-po-post-user">
						<ul class="dp-po-post-user-list">
							{% include 'Theme:PublishCommon:post-user-list.html.twig' with { users: [topic.person], pdf: true } %}
							<li class="dp-po-post-user-item">
								<strong>{{ phrase('helpcenter.community.forum_name') }}:</strong> #{{ topic.forum.title }}
							</li>
						</ul>
					</div>
				</div>
				<div class="col-sm-2">
				</div>
			</div>
		</div>
		<div class="col-sm-3">

		</div>
	</div>
{% endblock page_top %}

{% block page_body %}
	<div class="dp-po-section">
		<div class="dp-po-post-content dp-po-block">
			{{ topic.getContentHtml()|raw }}
		</div>
	</div>

	{% if brand_setting('user.publish_comments') and topic.comments | length%}
		{% include 'Theme:PublishCommon:comments-list.html.twig' with { comments: topic.comments } %}
	{% endif %}

{% endblock page_body %}
