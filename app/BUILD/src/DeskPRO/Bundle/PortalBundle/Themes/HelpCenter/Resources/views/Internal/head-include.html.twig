<meta charset="utf-8" />
<meta http-equiv="X-UA-Compatible" content="IE=Edge,chrome=1" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

{% set favicon = portal_custom_favicon() %}
{% if favicon %}
<link rel="icon" href="{{ favicon.url }}" type="{{ favicon.type }}">
{% endif %}

<script src="https://cdn.jsdelivr.net/npm/css-vars-ponyfill@2"></script>
<script src="https://cdn.jsdelivr.net/npm/promise-polyfill@8/dist/polyfill.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/whatwg-fetch@3.0.0/dist/fetch.umd.min.js"></script>
<script type="text/javascript">
  cssVars({
    onlyLegacy: true,
  })
</script>

<style type="text/css">
    {# This is copy+pasted from dpx.scss. It needs to be inline because it needs to be instant. #}
    body .as-no-dpui { display: block; }
    body .as-dpui { display: none; }
    body.with-dpui .as-no-dpui { display: none; }
    body.with-dpui .as-dpui { display: block; }
    body.with-js .with-dpx { visibility: hidden; }
    body.with-js .with-dpx { visibility: hidden; }
    .without-dpui .dpx-placeholder { display: none; }
    body.with-js.with-dpui.with-pageload-dpx-done .dpx-placeholder { display: none; }
    body.with-js.without-dpui.with-pageload-done .with-dpx { visibility: visible; }
    body.with-js.with-dpui.with-pageload-dpx-done .with-dpx { visibility: visible; }
    .dp-po .img-fluid, .dp-po .img-thumbnail { max-width: 100%; height: auto; }
    .dp-po .fas, .dp-po .far { visibility: hidden; }
    .fontawesome-i2svg-active .dp-po .fas, .fontawesome-i2svg-active .dp-po .far { visibility: visible; }
</style>

{% include 'Theme:Internal:modernizr-include.html.twig' %}

<script type="text/javascript">
  (function() {
    window.DP_LOAD_FN = window.DP_LOAD_FN || [];
    window.onDeskproReady = function(cb) {
      if (window.DP_PAGE_IS_READY) {
        cb();
      } else {
        window.DP_LOAD_FN.push(cb);
      }
    };

    window.DESKPRO_BASE_URL = '{{ base_url() }}';
    window.DESKPRO_ROOT_URL = '{{ root_url() }}';
    window.DESKPRO_LEGACY_WEB_URL = '{{ asset('', 'legacy_web') }}';
    window.DESKPRO_APP_ASSETS_URL = '{{ asset('', 'app_assets') }}';
    window.DESKPRO_MULTI_LANG = {{ is_multi_lang() ? 'true' : 'false' }};
    window.DESKPRO_LANG = '{{ lang_code() }}';
    window.DESKPRO_LOCALE = '{{ lang_locale() }}';
    window.DESKPRO_ENABLED_LANGS = [{% for language in enabled_languages() %}{{ '{' }}code: '{{ language.urlCode }}', title:'{{ language.title|capitalize }}',flag:'{{ language.flag_image }}'{{ '}' }}{% if not loop.last %},{% endif %}{% endfor %}];
    window.DP_ASSET_URL = '{{ asset('') }}';
    window.DP_BASE_URL = '/{{ path('portal_home')|trim('/') }}';

    window.DESKPRO_USER_AVAILABLE = {{ app.user ? 'true' : 'false' }};
    window.DESKPRO_USERSOURCES = {{ auth_usersources_js_object() }};
    window.DESKPRO_HAS_LOGIN_FORM = {{ has_login_form() ? 'true' : 'false' }};
    window.DESKPRO_IS_FORGOT_PASSWORD_VISIBLE = {{ has_login_form() ? 'true' : 'false' }};
    window.DESKPRO_CAN_USE_TICKETS = {{ can_use_tickets() ? 'true' : 'false' }};
    window.DESKPRO_CAN_VIEW_TICKETS_LINK = {{ can_view_tickets_link() ? 'true' : 'false' }};
    window.DESKPRO_CAN_USE_ARTICLES = {{ can_use_articles() ? 'true' : 'false' }};
    window.DESKPRO_CAN_USE_NEWS = {{ can_use_news() ? 'true' : 'false' }};
    window.DESKPRO_CAN_USE_DOWNLOADS = {{ can_use_downloads() ? 'true' : 'false' }};
    window.DESKPRO_CAN_USE_COMMUNITY = {{ can_use_community() ? 'true' : 'false' }};
    window.DESKPRO_CAN_USE_GUIDES = {{ can_use_guides() ? 'true' : 'false' }};
    window.DESKPRO_CAN_USE_CHAT = {{ can_use_chat() ? 'true' : 'false' }};
    window.PORTAL_MODE = '{{ portal_mode() }}';

    window.DESKPRO_PHRASES = {};
    window.DP_SET_PHRASES = function(p) {
      window.DESKPRO_PHRASES = p;
      if (window.PortalApp && window.PortalApp.phrases) {
        window.PortalApp.phrases.setPhrases(p);
      }
    };
    window.FontAwesomeConfig = {
      autoReplaceSvg: true
    };
  })();
</script>

{% set custom_include_code %}{%- include 'Theme:Internal:custom-head-include.html.twig' -%}{% endset %}

{#
    Note we only use async if we dont have a custom head include.
    Custom head includes often include jquery-type code, and
    so we need to make bundle load before that gets called.
#}
<script type="text/javascript" src="{{ asset('DeskPRO_HelpcenterBundle.js', 'app_assets') }}" {% if not custom_include_code %}async="async"{% endif %}></script>

{# Async load vendor css #}
{% for styleFile in [
    asset('DeskPRO_PortalBundle_helpcenter_vendors_style.css', 'app_assets')
] %}
    <link rel="preload" href="{{ styleFile }}?cors_fix=1" as="style" />
    <link rel="stylesheet" href="{{ styleFile }}?cors_fix=1" media="print" onload="this.media='all'" />
{% endfor %}

<link href="{{ asset('style.css', 'help_center') }}?cors_fix=1" rel="stylesheet" type="text/css" />
{% if helpcenter_css_url() %}
    <link href="{{ helpcenter_css_url() }}" media="all" rel="stylesheet" type="text/css" />
{% endif %}

{% if portal_mode() == 'focus-window' or portal_mode() == 'fame-embed' %}
    <script type="text/javascript" src="{{ asset('iframeResizer_contentWindow.js', 'app_assets') }}" async="async"></script>
{% endif %}

{{ custom_include_code }}
