{% extends 'Theme::layout.html.twig' %}

{% block page_content %}
    <div class="dp-po">
        <main class="dp-po-main dp-po-download-home">
            <div class="container">
                <div class="row">
                    <div class="col-sm-7 col-centered">
                        <div class="dp-po-title">
                            <img class="dp-po-title-svg" src="{{ asset('img/page-icons/download.svg', 'help_center') }}">
                            {% if category %}
                                <h1 class="dp-po-title-text">{{ object_phrase(category) }}</h1>
                            {% else %}
                                <h1 class="dp-po-title-text">{{ phrase('helpcenter.general.downloads_type') }}</h1>
                            {% endif %}
                        </div>
                        <div class="dp-po-block">
                            {% include 'Theme:Downloads:DownloadList/simple.html.twig' with {
                                pager: pager,
                                category: category,
                                show_category_link: false
                            } %}
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
{% endblock page_content %}
