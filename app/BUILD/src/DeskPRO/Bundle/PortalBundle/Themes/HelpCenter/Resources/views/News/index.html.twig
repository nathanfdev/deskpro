{% extends 'Theme::layout.html.twig' %}

{# ------------------------------------------ #}
{# Main page body #}
{# ------------------------------------------ #}
{% block page_body %}
    <div class="row">
        <div class="col-sm-9">
            <div class="dp-po-title">
                <img class="dp-po-title-svg"
                     src="{{ asset('img/page-icons/news.svg', 'help_center') }}">

                {% if viewCategory %}
                    <h2 class="dp-po-title-text">{{ object_phrase(viewCategory) }}</h2>
                {% else %}
                    <h2 class="dp-po-title-text">{{ phrase('helpcenter.news.section-title') }}</h2>
                {% endif %}
            </div>
        </div>
        <div class="col-sm-3">
            <div class="dp-po-news-extra">
                <ul class="dp-po-news-extra-list">
                    {% if ics_link is defined and ics_link|length > 0 %}
                        <li class="dp-po-news-extra-item">
                            <a href="{{ ics_link }}" class="dp-po-news-extra-link" title="{{ phrase('helpcenter.general.ics_subscribe') }}">
                                <i class="dp-po-icon fal fa-calendar-alt"></i>
                            </a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </div>
    <div class="dp-po-section dp-po-block">
        <div class="dp-po-news-listing">
            {% if pager|length %}
                {% for item in pager %}
                    <div class="dp-po-news-listing-item">
                        <a href="{{ portal_path(item) }}" class="dp-po-news-listing-link">
                            <div class="dp-po-news-listing-date">
                                <span class="dp-po-news-listing-month">{{ item.date_published | date('M') | upper }} {{ item.date_published | date('j') }}</span>
                                <span class="dp-po-news-listing-year">{{ item.date_published | date('Y') }}</span>
                            </div>
                            {% if has_splash(item) %}
                                <figure class="dp-po-news-listing-figure">
                                    <img src="{{ get_splash_url(item, 300) }}"
                                         class="dp-po-news-listing-photo img-fluid" />
                                </figure>
                            {% endif %}
                            <div class="dp-po-news-listing-content">
                                <h3 class="dp-po-news-listing-title">{{ item.title }}</h3>
                                <div class="dp-po-avatar dp-po-avatar-round">
                                    {{ hc_avatar(item.person, '', 30) }}
                                    <strong>{{ item.person.display_name }}</strong>
                                </div>
                                <div class="dp-po-news-listing-comments">
                                    <i class="dp-po-icon far fa-comment-alt-lines"></i> {{ item.num_comments }}
                                </div>
                                <span class="badge badge-info" style="background-color: {{ icon_color(item.category) }}">{{ object_phrase(item.category) }}</span>
                            </div>
                        </a>
                    </div>
                {% endfor %}
            {% else %}
                <strong>{{ phrase('helpcenter.news.none') }}</strong>
            {% endif %}
        </div>
    </div>
{% endblock page_body %}

{# ------------------------------------------ #}
{# Page sidebar #}
{# ------------------------------------------ #}
{% block page_sidebar %}
    {# TODO active subscription state #}
    {% include 'Theme:PublishCommon:subscribe-button.html.twig' with {
        subscriptionInfo: [
            { toggleUrl: path('portal_news_root_category_toggle_subscription'), icon: 'fal fa-file-chart-line', title: phrase('helpcenter.articles.section-title'), active: false },
        ]
    } %}

    <div class="dp-po-sidebar dp-po-news-filter dp-po-news-filter-type">
        <h3 class="dp-po-news-filter-title">{{ phrase('helpcenter.news.filter-cat') }}</h3>
        <a class="dp-po-news-filter-collapse" data-toggle="collapse" href="#news_categories" role="button" aria-expanded="true" aria-controls="news_categories">
            <i class="dp-po-icon far fa-angle-down"></i>
        </a>
        <div class="collapse show" id="news_categories">
            <ul class="dp-po-news-filter-type-list">
                <li class="dp-po-news-filter-type-item">
                    {% if not viewCategory %}<i class="fa fa-long-arrow-alt-right"></i>{% endif %}
                    <div class="form-group dp-po-form-check">
                        <a href="{{ path('user_news_home') }}">
                            {{ phrase('helpcenter.news.all-news') }}
                        </a>
                    </div>
                </li>
                {% for cat in newsData.categories %}
                    <li class="dp-po-news-filter-type-item">
                        {% if viewCategory and viewCategory.id == cat.id %}<i class="fa fa-long-arrow-alt-right"></i>{% endif %}
                        <div class="form-group dp-po-form-check">
                            <a href="{{ portal_path(cat) }}">
                                {{ object_phrase(cat) }}
                            </a>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>

    <div class="dp-po-sidebar dp-po-news-filter dp-po-news-filter-date">
        <h3 class="dp-po-news-filter-title">{{ phrase('helpcenter.news.filter-date') }}</h3>
        <a class="dp-po-news-filter-collapse" data-toggle="collapse" href="#date_filter" role="button"
           aria-expanded="false" aria-controls="date_filter">
            <i class="dp-po-icon far fa-angle-down"></i>
        </a>
        <div class="collapse {{ filter_date ? 'show' }}" id="date_filter">
            <div class="dp-po-news-filter-date-option">
                <ul class="dp-po-news-filter-date-year-list">
                    <li class="dp-po-news-filter-date-year-item">
                        <a href="{{ _self.news_date_filter_path({date: ''}) }}"
                           class="dp-po-news-filter-date-year-link text-uppercase {{ not filter_date ? 'active' }}">
                            {{ phrase('helpcenter.news.any-date') }}
                        </a>
                    </li>
                    {% for y in newsData.ymCounts %}
                        <li class="dp-po-news-filter-date-year-item">
                            <a href="{{ _self.news_date_filter_path({date: y.year}) }}"
                               class="dp-po-news-filter-date-year-link {{ filter_date matches "/#{y.year}.*/" ? 'active' }}">
                                {{ y.year }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
                <ul class="dp-po-news-filter-date-month-list">
                    {% for y in newsData.ymCounts if y.year == filter_year %}
                        {% for m in y.months %}
                            {% set date = "#{y.year}-#{'%02d'|format(m.month)}" %}
                            <li class="dp-po-news-filter-date-month-item">
                                <a href="{{ _self.news_date_filter_path({date: date}) }}"
                                   class="dp-po-news-filter-date-month-link {{ filter_date matches "/#{date}.*/" ? 'active' }}" style="{{ filter_date and 0 == m.count ? 'color: #DDD;' }}">
                                    {{ date("#{m.year}-#{m.month}-01") | date('M') | upper }}
                                </a>
                            </li>
                        {% endfor %}
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
{% endblock %}

{%- macro news_date_filter_path(params) -%}
    {{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge(params)) }}
{%- endmacro -%}
