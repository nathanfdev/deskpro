{% extends 'Theme::layout.html.twig' %}

{# ------------------------------------------ #}
{# Main page body #}
{# ------------------------------------------ #}
{% block page_body %}
    <div class="row">
        <div class="col-sm-9">
            <div class="dp-po-title">
                <img class="dp-po-title-svg"
                     src="{{ asset('img/page-icons/news.svg', 'help_center') }}">

                {% if viewCategory %}
                    <h1 class="dp-po-title-text">{{ object_phrase(viewCategory) }}</h1>
                {% else %}
                    <h1 class="dp-po-title-text">{{ phrase('helpcenter.news.section_title') }}</h1>
                {% endif %}
            </div>
        </div>
        <div class="col-sm-3">
            <div class="dp-po-news-extra">
                <ul class="dp-po-news-extra-list">
                    {% if download_calendar is defined and download_calendar|length > 0 %}
                        <li class="dp-po-news-extra-item">
                            <a href="{{ download_calendar }}" class="dp-po-news-extra-link" title="{{ phrase('helpcenter.general.ics_subscribe') }}">
                                <i class="dp-po-icon fal fa-calendar-alt" title="calendar"></i>
                            </a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </div>
    <div class="d-block d-sm-none">
        <div class="dp-po-post-mobile-area">
        {% if brand_setting('user.news_subscriptions') %}
            {% include 'Theme:PublishCommon:subscribe-button.html.twig' with {
                buttonId: 'subscribeDropdownMenuMobile',
                subscriptionInfo: [
                    viewCategory ? { toggleUrl: portal_path(viewCategory, 'toggle_subscription'), icon: 'fal fa-file-spreadsheet', title: phrase('helpcenter.general.category'), active: is_subscribed_category, disabled: is_subscribed } : {},
                    { toggleUrl: path('portal_news_root_category_toggle_subscription'), icon: 'fal fa-file-chart-line', title: phrase('helpcenter.news.section_title'), active: is_subscribed },
                ]
            } %}
        {% endif %}
        <a href="javascript:void(0)" data-toggle="modal" data-target="#postExtraMobile"><i
            class="far fa-align-center" title="menu"></i></a>
        </div>
    </div>
    <div class="dp-po-section dp-po-block">
        <div class="dp-po-news-listing">
            {% if pager|length %}
                {% for item in pager %}
                    <div class="dp-po-news-listing-item">
                        <a href="{{ portal_path(item) }}" class="dp-po-news-listing-link">
                            <div class="dp-po-news-listing-date">
                                <span class="dp-po-news-listing-month">{{ phrase('helpcenter.general.date_day_month', {date: item.date_published}) | upper }}</span>
                                <span class="dp-po-news-listing-year">{{ item.date_published | date('Y') }}</span>
                            </div>
                            {% if has_splash(item) %}
                                <figure class="dp-po-news-listing-figure">
                                    <img src="{{ get_splash_url(item, 300) }}"
                                         class="dp-po-news-listing-photo img-fluid" role="presentation" alt="" />
                                </figure>
                            {% endif %}
                            <div class="dp-po-news-listing-content">
                                <h2 class="dp-po-news-listing-title">{{ item.title }}</h2>
                                <div class="dp-po-avatar dp-po-avatar-round">
                                    {{ hc_avatar(item.person, '', 60) }}
                                    <strong>{{ item.person.display_name }}</strong>
                                </div>
                                <div class="dp-po-news-listing-comments">
                                    <i class="dp-po-icon far fa-comment-alt-lines"></i> {{ item.num_comments }}
                                </div>
                                <span class="badge badge-info" style="background-color: {{ icon_color(item.category) }}">{{ object_phrase(item.category) }}</span>
                            </div>
                        </a>
                    </div>
                {% endfor %}
            {% else %}
                <strong>{{ phrase('helpcenter.news.none') }}</strong>
            {% endif %}
        </div>
    </div>
    <div class="dp-po-section">
        {% include 'Theme:Common:pager.html.twig' with {
            pager: pager,
            pager_options: {
                omitFirstPage: false
            }
        } %}
    </div>
    <!-- Mobile Modal -->
    <div class="modal fade mobile-modal" id="postExtraMobile" tabindex="-1" role="dialog"
        aria-labelledby="postExtraMobile" aria-hidden="true">
        <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
            </div>
            <div class="modal-body">
                <div class="dp-po-sidebar dp-po-news-filter dp-po-news-filter-type">
                    <h3 class="dp-po-news-filter-title">{{ phrase('helpcenter.news.filter_cat') }}</h3>
                    <a class="dp-po-news-filter-collapse" data-toggle="collapse" href="#news_categories_mobile" role="button" aria-expanded="true" aria-controls="news_categories_mobile">
                        <i class="dp-po-icon far fa-angle-down" title="collapse"></i>
                    </a>
                    <div class="collapse show" id="news_categories_mobile">
                        <ul class="dp-po-news-filter-type-list">
                            <li class="dp-po-news-filter-type-item">
                                {% if not viewCategory %}<i class="dp-po-icon fa fa-long-arrow-right"></i>{% endif %}
                                <div class="dp-po-form-check">
                                    <a href="{{ path('user_news_home') }}" class="dp-po-news-filter-type-link {% if not viewCategory %}active{% endif %}">
                                        {{ phrase('helpcenter.news.all_news') }}
                                    </a>
                                </div>
                            </li>
                            {% for cat in newsData.categories %}
                                <li class="dp-po-news-filter-type-item">
                                    {% if viewCategory and viewCategory.id == cat.id %}<i class="dp-po-icon fa fa-long-arrow-right"></i>{% endif %}
                                    <div class="dp-po-form-check">
                                        <a href="{{ portal_path(cat) }}" class="dp-po-news-filter-type-link {% if viewCategory and viewCategory.id == cat.id %}active{% endif %}">
                                            {{ object_phrase(cat) }}
                                        </a>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>

                <div class="dp-po-sidebar dp-po-news-filter dp-po-news-filter-date">
                    <h3 class="dp-po-news-filter-title">{{ phrase('helpcenter.news.filter_date') }}</h3>
                    <a class="dp-po-news-filter-collapse" data-toggle="collapse" href="#date_filter_mobile" role="button"
                    aria-expanded="false" aria-controls="date_filter_mobile">
                        <i class="dp-po-icon far fa-angle-down" title="collapse"></i>
                    </a>
                    <div class="collapse {{ filter_date ? 'show' }}" id="date_filter_mobile">
                        <div class="dp-po-news-filter-date-option">
                            <ul class="dp-po-news-filter-date-year-list">
                                <li class="dp-po-news-filter-date-year-item">
                                    <a href="{{ _self.news_date_filter_path({date: ''}) }}"
                                    class="dp-po-news-filter-date-year-link text-uppercase {{ not filter_date ? 'active' }}">
                                        {{ phrase('helpcenter.news.any_date') }}
                                    </a>
                                </li>
                                {% for y in newsData.ymCounts %}
                                    <li class="dp-po-news-filter-date-year-item">
                                        <a href="{{ _self.news_date_filter_path({date: y.year}) }}"
                                        class="dp-po-news-filter-date-year-link {{ filter_date matches "/#{y.year}.*/" ? 'active' }}">
                                            {{ y.year }}
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                            <ul class="dp-po-news-filter-date-month-list">
                                {% for y in newsData.ymCounts if y.year == filter_year %}
                                    {% for m in y.months %}
                                        {% set date = "#{y.year}-#{'%02d'|format(m.month)}" %}
                                        <li class="dp-po-news-filter-date-month-item">
                                            <a href="{{ _self.news_date_filter_path({date: date}) }}"
                                            class="dp-po-news-filter-date-month-link {{ filter_date matches "/#{date}.*/" ? 'active' }}" style="{{ filter_date and 0 == m.count ? 'color: #DDD;' }}">
                                                {{ m.formatted | upper }}
                                            </a>
                                        </li>
                                    {% endfor %}
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        </div>
    </div>
{% endblock page_body %}

{# ------------------------------------------ #}
{# Page sidebar #}
{# ------------------------------------------ #}
{% block page_sidebar %}
    <div class="d-none d-sm-block">
        {% if brand_setting('user.news_subscriptions') %}
            {% include 'Theme:PublishCommon:subscribe-button.html.twig' with {
                subscriptionInfo: [
                    viewCategory ? { toggleUrl: portal_path(viewCategory, 'toggle_subscription'), icon: 'fal fa-file-spreadsheet', title: phrase('helpcenter.general.category'), active: is_subscribed_category, disabled: is_subscribed } : {},
                    { toggleUrl: path('portal_news_root_category_toggle_subscription'), icon: 'fal fa-file-chart-line', title: phrase('helpcenter.news.section_title'), active: is_subscribed },
                ]
            } %}
        {% endif %}

        <div class="dp-po-sidebar dp-po-news-filter dp-po-news-filter-type">
            <h3 class="dp-po-news-filter-title">{{ phrase('helpcenter.news.filter_cat') }}</h3>
            <a class="dp-po-news-filter-collapse" data-toggle="collapse" href="#news_categories" role="button" aria-expanded="true" aria-controls="news_categories">
                <i class="dp-po-icon far fa-angle-down" title="collapse"></i>
            </a>
            <div class="collapse show" id="news_categories">
                <ul class="dp-po-news-filter-type-list">
                    <li class="dp-po-news-filter-type-item">
                        {% if not viewCategory %}<i class="dp-po-icon fa fa-long-arrow-right"></i>{% endif %}
                        <div class="dp-po-form-check">
                            <a href="{{ path('user_news_home') }}" class="dp-po-news-filter-type-link {% if not viewCategory %}active{% endif %}">
                                {{ phrase('helpcenter.news.all_news') }}
                            </a>
                        </div>
                    </li>
                    {% for cat in newsData.categories %}
                        <li class="dp-po-news-filter-type-item">
                            {% if viewCategory and viewCategory.id == cat.id %}<i class="dp-po-icon fa fa-long-arrow-right"></i>{% endif %}
                            <div class="dp-po-form-check">
                                <a href="{{ portal_path(cat) }}" class="dp-po-news-filter-type-link {% if viewCategory and viewCategory.id == cat.id %}active{% endif %}">
                                    {{ object_phrase(cat) }}
                                </a>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>

        <div class="dp-po-sidebar dp-po-news-filter dp-po-news-filter-date">
            <h3 class="dp-po-news-filter-title">{{ phrase('helpcenter.news.filter_date') }}</h3>
            <a class="dp-po-news-filter-collapse" data-toggle="collapse" href="#date_filter" role="button"
            aria-expanded="false" aria-controls="date_filter">
                <i class="dp-po-icon far fa-angle-down" title="collapse"></i>
            </a>
            <div class="collapse {{ filter_date ? 'show' }}" id="date_filter">
                <div class="dp-po-news-filter-date-option">
                    <ul class="dp-po-news-filter-date-year-list">
                        <li class="dp-po-news-filter-date-year-item">
                            <a href="{{ _self.news_date_filter_path({date: ''}) }}"
                            class="dp-po-news-filter-date-year-link text-uppercase {{ not filter_date ? 'active' }}">
                                {{ phrase('helpcenter.news.any_date') }}
                            </a>
                        </li>
                        {% for y in newsData.ymCounts %}
                            <li class="dp-po-news-filter-date-year-item">
                                <a href="{{ _self.news_date_filter_path({date: y.year}) }}"
                                class="dp-po-news-filter-date-year-link {{ filter_date matches "/#{y.year}.*/" ? 'active' }}">
                                    {{ y.year }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                    <ul class="dp-po-news-filter-date-month-list">
                        {% for y in newsData.ymCounts if y.year == filter_year %}
                            {% for m in y.months %}
                                {% set date = "#{y.year}-#{'%02d'|format(m.month)}" %}
                                <li class="dp-po-news-filter-date-month-item">
                                    <a href="{{ _self.news_date_filter_path({date: date}) }}"
                                    class="dp-po-news-filter-date-month-link {{ filter_date matches "/#{date}.*/" ? 'active' }}" style="{{ filter_date and 0 == m.count ? 'color: #DDD;' }}">
                                        {{ m.formatted | upper }}
                                    </a>
                                </li>
                            {% endfor %}
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{%- macro news_date_filter_path(params) -%}
    {{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge(params)) }}
{%- endmacro -%}
