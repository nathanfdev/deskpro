{% if brand_setting('core.iface_portal') %}
    <div class="dp-po-user">
        {% if is_guest() %}
            <a href="javascript:void(0)" class="dp-po-user-login" data-toggle="dropdown" aria-haspopup="true"
               aria-expanded="false" id="hc-top-login-btn">{{ phrase('helpcenter.general.log_in') }}</a>
            <div class="dropdown-menu dropdown-menu-right dp-po-user-dropdown">
                {% if helpcenter.getUserInfo().display_registration_link %}
                <h4 class="dropdown-item-text dp-po-user-dropdown-title">{{ phrase('helpcenter.account.new_to_brand', {brand: brand_setting('core.deskpro_name')|e}) }} <a href="{{ path('portal_user_registration') }}">{{ phrase('helpcenter.account.login_register_header') }}</a></h4>
                {% endif %}
                {% if has_login_form() %}
                <section class="dp-po-loginform">
                    <form class="do-po-form" id="login-sidebar">
                        <input type="hidden" name="_failure_path" value="{{ path('portal_login', {retry:'auth'}) }}" />
                        <div class="form-group">
                            <input
                                type="email"
                                class="form-control"
                                name="dropdown_username"
                                id="login-form-username"
                                tabIndex="21"
                                autocomplete="username"
                                aria-describedby="emailHelp"
                                placeholder="{{ phrase('helpcenter.general.email_address') }}"
                            >
                        </div>
                        <div class="form-group">
                            <div id="login-form-failed-reason"></div>
                            <input
                                type="password"
                                class="form-control"
                                id="login-form-password"
                                name="dropdown_password"
                                autocomplete="current-password"
                                placeholder="{{ phrase('helpcenter.general.password') }}"
                                tabIndex="22"
                            >
                        </div>
                        <div class="form-group dp-po-form-check">
                            <input
                                type="checkbox"
                                name="remember_me"
                                class="form-check-input"
                                id="login-form-remember-me"
                                tabIndex="23"
                                onclick="var event = arguments[0] || window.event; event.stopPropagation();"
                            >
                            <label class="form-check-label" for="login-form-remember-me" onclick="var event = arguments[0] || window.event; event.stopPropagation();">
                                {{ phrase('helpcenter.account.login_stay_logged_in') }}
                            </label>
                        </div>
                        <input type="submit" class="btn btn-primary btn-lg" tabIndex="24" value="{{ phrase('helpcenter.general.log_in') }}"/>
                        {% if has_login_form() %}
                            <a href="{{ path('portal_reset_password') }}" id="login-form-reset-password" tabIndex="25" class="dp-po-form-btntext">{{ phrase('helpcenter.account.login_password_reminder') }}</a>
                        {% endif %}
                    </form>
                </section>
                {% endif %}
                <section class="dp-po-social-login" id="login-form-usersources">
                </section>
            </div>
        {% else %}
            {% set user_notification_count = pageData.alerts.tickets_awaiting_reply | length + pageData.alerts.unread_direct_messages %}
            <a href="javascript:void(0)" class="dp-po-user-login dp-po-avatar" data-toggle="dropdown" aria-haspopup="true"
               aria-expanded="false">
                <span class="dp-po-user-login-figure">
                    {{ hc_avatar(app.user) }}
                    {% if user_notification_count > 0 %}
                        <span class="dp-po-user-login-count">{{ user_notification_count }}</span>
                    {% endif %}
                </span>
                <i class="dp-po-icon far fa-angle-down"></i>
            </a>
            <div class="dropdown-menu dropdown-menu-right dp-po-user-dropdown dp-po-user-menu">
                <div class="dp-po-avatar">
                    {{ hc_avatar(app.user, '', 50) }} {{ app.user }}
                </div>
                <ul class="dp-po-user-menu-list">
                    <li class="dp-po-user-menu-item">
                        <a class="dp-po-user-menu-link" href="{{ path('portal_user_profile') }}">
                            <img class="dp-po-user-menu-image dp-profile-svg" src="{{ asset('img/page-icons/account.svg', 'help_center') }}" role="presentation" alt=""> {{ phrase('helpcenter.general.view_profile') }}
                        </a>
                    </li>
                    {% if helpcenter.getUserInfo().ticket_count > 0 and can_use_tickets() %}
                        <li class="dp-po-user-menu-item">
                            <a class="dp-po-user-menu-link" href="{{ path('portal_tickets') }}">
                                <img class="dp-po-user-menu-image dp-profile-svg" src="{{ asset('img/page-icons/tickets.svg', 'help_center') }}" role="presentation" alt=""> {{ phrase('helpcenter.tickets.my_tickets') }}
                                {% if pageData.alerts.tickets_awaiting_reply | length > 0 %}
                                    ({{ pageData.alerts.tickets_awaiting_reply | length }})
                                {% endif %}
                            </a>
                        </li>
                    {% endif %}
                    {% if app.getSetting('portal.members_community') %}
                        <li class="dp-po-user-menu-item">
                            <a class="dp-po-user-menu-link" href="{{ path('portal_dm') }}">
                                <img class="dp-po-user-menu-image dp-profile-svg" src="{{ asset('img/page-icons/direct-message.svg', 'help_center') }}" role="presentation" alt=""> {{ phrase('helpcenter.tickets.my_messages') }}
                                {% if pageData.alerts.unread_direct_messages > 0 %}
                                    ({{ pageData.alerts.unread_direct_messages }})
                                {% endif %}
                            </a>
                        </li>
                    {% endif %}
                    {% if helpcenter.getUserInfo().chat_count > 0 and can_use_chat() %}
                        <li class="dp-po-user-menu-item">
                            <a class="dp-po-user-menu-link" href="{{ path('portal_chats') }}">
                                <img class="dp-po-user-menu-image dp-profile-svg" src="{{ asset('img/page-icons/chats.svg', 'help_center') }}" role="presentation" alt=""> {{ phrase('helpcenter.chats.my_chats') }}
                            </a>
                        </li>
                    {% endif %}

                    {% if helpcenter.getUserInfo().ticket_approval_count > 0 and app.getSetting('core_tickets.ticket_approvals') %}
                        <li class="dp-po-user-menu-item">
                            <span class="disc"></span>
                            <a class="dp-po-user-menu-link" href="{{ path('ticket_approvals') }}">
                                <img class="dp-po-user-menu-image dp-profile-svg" src="{{ asset('img/page-icons/approvals.svg', 'help_center') }}"> {{ phrase('helpcenter.approvals.my_approvals') }}
                            </a>
                        </li>
                    {% endif %}
                </ul>
                <a href="{{ logout_path('portal') }}" id="top-logout-btn" class="btn btn-primary">{{ phrase('helpcenter.account.logout_btn') }}</a>
            </div>
        {% endif %}
    </div>
{% endif %}
