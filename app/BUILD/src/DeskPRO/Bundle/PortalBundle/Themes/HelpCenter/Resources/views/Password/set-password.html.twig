{% extends 'Theme::layout.html.twig' %}
{% import 'Theme:Portal:User/macros.html.twig' as macros %}

{% block page_content %}
    {% if auth_manager.isForgotPasswordVisible %}
        <header class="section-header">
            <h1>{{ phrase('helpcenter.account.section-title-set-password') }}</h1>
        </header>

        {% if from_saved %}
            {{ macros.user_notice('auth', phrase('helpcenter.account.set-password-for-user')) }}
        {% endif %}

        <div class="form-ticket">
            {{ form_start(form) }}
            {{ form_rest(form) }}
            <div class="column-full">
                <div class="bucket">
                    <button type="submit">{{ phrase('helpcenter.account.set-password-btn') }}</button>
                </div>
            </div>
            {{ form_end(form) }}
        </div>
    {% endif %}
{% endblock page_content %}
