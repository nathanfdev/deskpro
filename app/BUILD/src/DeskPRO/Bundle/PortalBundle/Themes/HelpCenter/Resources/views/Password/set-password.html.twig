{% extends 'Theme::layout.html.twig' %}
{% import 'Theme:Portal:User/macros.html.twig' as macros %}

{% block page_content %}
    {% if auth_manager.isForgotPasswordVisible %}
        <div class="dp-po">
            <main class="dp-po-main">
                <div class="container">
                    <div class="row">
                        <div class="col-sm-7 col-centered">
                            <div class="dp-po-title">
                                <h2>{{ phrase('helpcenter.account.section-title-set-password') }}</h2>
                            </div>

                            <div class="dp-po-block">

                                {% if from_saved %}
                                    {{ macros.user_notice('auth', phrase('helpcenter.account.set-password-for-user')) }}
                                {% endif %}

                                <div class="form-ticket">
                                    {{ form_start(form) }}
                                    {{ form_rest(form) }}
                                    <div class="column-full">
                                        <div class="bucket">
                                            <button class="btn btn-primary" type="submit">{{ phrase('helpcenter.account.set-password-btn') }}</button>
                                        </div>
                                    </div>
                                    {{ form_end(form) }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    {% endif %}
{% endblock page_content %}
