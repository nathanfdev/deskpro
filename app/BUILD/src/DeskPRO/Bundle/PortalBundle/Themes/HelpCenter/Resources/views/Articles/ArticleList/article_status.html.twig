{% if is_agent() and brand_setting('user.non_published_articles_on_helpcenter')%}
    {% if article.status == 'published' %}
    <span class="badge badge-success badge-small">{{ phrase('helpcenter.articles.status-published') }}</span>
    {% elseif article.status == 'archived' %}
    <span class="badge badge-dark badge-small">{{ phrase('helpcenter.articles.status-archived') }}</span>
    {% elseif article.status == 'hidden' %}
        {% if article.hidden_status == 'draft' %}
            <span class="badge badge-dark badge-small">{{ phrase('helpcenter.articles.status-draft') }}</span>
        {% endif %}
    {% endif %}
{% endif %}
