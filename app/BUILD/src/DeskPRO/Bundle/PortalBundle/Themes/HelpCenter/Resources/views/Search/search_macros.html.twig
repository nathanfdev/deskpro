{% macro search_result(result) %}
    {% if result['type'] == 'news' %}
        {{ _self.news_search_result(result['object']) }}
    {% elseif result['type'] == 'ticket' %}
        {{ _self.ticket_search_result(result['object']) }}
    {% elseif result['type'] == 'article' %}
        {{ _self.article_search_result(result['object']) }}
    {% elseif result['type'] == 'community' %}
        {{ _self.community_search_result(result['object']) }}
    {% elseif result['type'] == 'download' %}
        {{ _self.dl_search_result(result['object']) }}
    {% elseif result['type'] == 'topic' %}
        {{ _self.topic_search_result(result['object']) }}
    {% endif %}
{% endmacro %}

{% macro article_search_result(article) %}
    <li class="dp-po-search-item">
        <a href="{{ portal_path(article) }}" class="dp-po-search-link">
          {{ article.title }}
            <div class="dp-po-time">
                <i class="dp-po-icon far fa-clock"></i>
                {{ date_ago(article.date_published) }}
            </div>
        </a>
  </li>
{% endmacro %}

{% macro ticket_search_result(ticket) %}
    <li class="dp-po-search-item">
        <a href="{{ portal_path(ticket) }}" class="dp-po-search-link">
            {{ ticket.subject }}
            <div class="dp-po-time">
                <i class="dp-po-icon far fa-clock"></i>
                {{ date_ago(ticket.getLastActivityDate()) }}
            </div>
        </a>
  </li>
{% endmacro %}

{% macro dl_search_result(dl) %}
  <li>
    {{ content_icon(dl) }}
    <a href="{{ portal_path(dl) }}">
      <span class="item-title">
        {{ dl.title }}
      </span>
    </a>
  </li>
{% endmacro %}

{% macro community_search_result(topic) %}
  <li>
    <a href="{{ portal_path(topic) }}">
      <span class="item-title">
          <span class="community-count"><i class="fas fa-thumbs-up"></i>{{ topic.total_rating >= 0 ? (topic.total_rating > 0 ? '+' : '') : '-' }}{{ topic.total_rating }}</span>
          {{ topic.title }}
      </span>
      <p>{{ topic.getContentHtml()|html_content_preview(350) }}</p>
    </a>
  </li>
{% endmacro %}


{% macro news_search_result(news) %}
    <li>
        <a href="{{ portal_path(news) }}">
          <span class="item-title"><span class="date-posted"><i class="far fa-calendar"></i> {{ date_ago(news.date_published) }}</span>{{ news.title }}</span>
          <p>{{ news.realContent|html_content_preview(350) }}</p>
        </a>
  </li>
{% endmacro %}


{% macro topic_search_result(topic) %}
    <li>
        {{ content_icon(topic) }}
        <a href="{{ portal_path(topic) }}">
          <span class="item-title">
            {{ topic.title }}
          </span>
          <p>{{ topic.realContent|html_content_preview(350) }}</p>
        </a>
    </li>
{% endmacro %}
