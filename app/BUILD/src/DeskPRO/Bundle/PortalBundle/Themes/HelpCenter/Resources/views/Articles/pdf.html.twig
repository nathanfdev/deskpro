{% extends 'Theme:Pdf:layout.html.twig' %}
{% block page_body %}

    <div class="breadcrumbs">
        {% include 'Theme:Common:pdf_breadcrumbs.html.twig' %}
    </div>

    <article class="news kb-article">
        <header>

            <h1>{{ article.translated_title }}</h1>

            <div class="article-meta">
                <span style="background: url({{ avatar_url(article.person) }}) no-repeat; background-size: cover" class="agent-avatar agent-avatar-mini"></span>
                {{ article.person.display_name_user }}
                -
                {{ article.date_updated | date('Y-m-d') }}
                -
            {% if brand_setting('user.publish_comments') %}
                <span class="comments"><i class="far fa-comments"></i> <a href="#comments">{{ phrase('helpcenter.general.comments_title', {count: article.calc_num_comments}) }}</a></span>
                -
            {% endif %}
                <a href="{{ portal_path(article.primary_category) }}">{{ object_phrase(article.primary_category) }}</a>
            </div>
            {% if article.status != 'published' and article.status != 'archived' and app.user.is_agent %}
              <div class="sub-note">{{ phrase('helpcenter.articles.view_as_agent') }}</div>
            {% endif %}
        </header>

        <div class="article-content padded dpx-kb-article-content">
            {{ article.translated_content|raw }}
        </div>

        {% if article.labels|length %}
            <div class="tag-list">
                <ul>
                    <li class="tag-list-header"><i class="fas fa-tags"></i> {{ phrase('helpcenter.general.tags') }}</li>
                    {% for l in  article.labels %}
                        <li class="tag-list-item"><a href="{{ path('portal_search_labels', { label: l }) }}">{{ l }}</a></li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
    </article>

    {% if article.attachments|length > 0 %}
        <div class="dp-po-kb-attachments">
            <h4 class="dp-po-kb-attachments-title">{{ phrase('helpcenter.general.attachments') }}</h4>
            <ul class="dp-po-kb-attachments-list">
                {% for attachment in article.attachments %}
                    {% set blob = attachment.blob %}
                    <li class="dp-po-kb-attachments-item">
                        <a href="{{ portal_path(attachment, 'serve') }}" class="dp-po-kb-attachments-link">
                            <i class="dp-po-icon fal fa-{{ content_fa_icon(blob) }}"></i>
                            {% if blob %}{{ blob.filename }} <span>({{ attachment.readableFileSize }})</span>{% endif %}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    {% if articleData.related_content %}
        {% include 'Theme:PublishCommon:related-content.html.twig' with {
            related_content: articleData.related_content
        } %}
    {% endif %}

    {% if brand_setting('user.publish_comments') and article.num_comments %}
        <div class="comment-box" id="comments">
            <div class="titled-header">
                <h1>{{ phrase('helpcenter.general.comments_title', {count: article.calc_num_comments}) }}</h1>
            </div>
            {% if articleData.comments | length %}
                {% include 'Theme:PublishCommon:comments-list.html.twig' with { comments: articleData.comments } %}
            {% endif %}
        </div>
    {% endif %}
{% endblock page_body %}
