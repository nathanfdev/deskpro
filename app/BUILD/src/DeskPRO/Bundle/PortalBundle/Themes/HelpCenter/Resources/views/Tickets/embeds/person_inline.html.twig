{% block person_inline %}
	<div class="dp-po-avatar dp-po-avatar-round">
	{% if person %}
		<img src="{{ avatar_url(person, 30) }}" />
		{% if include_email or not person.isAgent() %}
			You ({{ person.primary_email_address }})
		{% else %}
			{{ person.display_name_user }}
		{% endif %}
	{% else %}
		<img src="{{ avatar_default_url(person, 30) }}" />
		Helpdesk system
	{% endif %}
	</div>
{% endblock person_inline %}
