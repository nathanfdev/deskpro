{% extends 'Theme::layout.html.twig' %}
{% import 'Theme:Portal:User/macros.html.twig' as macros %}

{% block page_top %}
  <div class="row align-items-end mb-4">
    <div class="col-sm-9">
      <div class="dp-po-news-head">
        <div class="dp-po-news-head-left">
          <div class="dp-po-post-day">
            <span class="dp-po-post-day-month">{{ phrase('helpcenter.general.date_short_month', {date: post.date_published}) | upper }}</span>
            <span class="dp-po-post-day-date">{{ post.date_published | date('j') }}</span>
            <span class="dp-po-post-day-year">{{ post.date_published | date('Y') }}</span>
          </div>
        </div>
        <div class="dp-po-news-head-right">
          <div class="dp-po-title">
            <img class="dp-po-title-svg" src="{{ asset('img/page-icons/news.svg', 'help_center') }}">
            <h1 class="dp-po-title-text">{{ post.realTitle }}</h1>
          </div>
          <div class="row align-items-end">
            <div class="col-sm-10">
              {% include 'Theme:PublishCommon:post-avatars.html.twig' with {
                item: post
              } %}

              <div class="dp-po-post-info">
                <ul class="dp-po-post-info-list">
                  <li class="dp-po-post-info-item">
                    {{ phrase('helpcenter.general.published_by', {person_name: post.last_author.name}) | raw }}
                  </li>
                  <li class="dp-po-post-info-item">
                    {{ phrase('helpcenter.news.news_type') }}: <b>{{ post.category }}</b>
                  </li>
                </ul>
              </div>
            </div>
            <div class="col-sm-2">
              <div class="d-none d-sm-block">
                <div class="dp-po-post-extra">
                  <ul class="dp-po-post-extra-list">
                    <li class="dp-po-post-extra-item">
                      <a href="javascript:window.print();" class="dp-po-post-extra-link" aria-label="{{ phrase('helpcenter.general.print') }}">
                        <i class="dp-po-icon fal fa-print" title="{{ phrase('helpcenter.general.print') }}"></i>
                      </a>
                    </li>
                    <li class="dp-po-post-extra-item">
                      <a href="{{ path('portal_news_pdf', {slug: post.slug}) }}" class="dp-po-post-extra-link" aria-label="{{ phrase('helpcenter.general.download_pdf') }} - {{ post.title }}.pdf">
                        <i class="dp-po-icon fal fa-file-pdf" title="Pdf"></i>
                      </a>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>



    </div>
    <div class="col-sm-3">
      <div class="d-none d-sm-block">
        {% if brand_setting('user.news_subscriptions') %}
          {% include 'Theme:PublishCommon:subscribe-button.html.twig' with {
            subscriptionInfo: [
              { toggleUrl: portal_path(post, 'toggle_subscription'), icon: 'fal fa-file-alt', title: phrase('helpcenter.news.news_post_object'), active: is_subscribed },
              { toggleUrl: portal_path(category, 'toggle_subscription'), icon: 'fal fa-file-spreadsheet', title: phrase('helpcenter.general.category'), active: is_subscribed_category },
              { toggleUrl: path('portal_news_root_category_toggle_subscription'), icon: 'fal fa-file-chart-line', title: phrase('helpcenter.news.section_title'), active: is_subscribed_root },
            ]
          } %}
        {% endif %}
      </div>
    </div>
  </div>

  <div class="d-block d-sm-none">
    <div class="dp-po-post-mobile-area">
      {% if brand_setting('user.news_subscriptions') %}
        {% include 'Theme:PublishCommon:subscribe-button.html.twig' with {
            buttonId: 'subscribeDropdownMenuMobile',
            subscriptionInfo: [
              { toggleUrl: portal_path(post, 'toggle_subscription'), icon: 'fal fa-file-alt', title: phrase('helpcenter.news.news_post_object'), active: is_subscribed },
              { toggleUrl: portal_path(category, 'toggle_subscription'), icon: 'fal fa-file-spreadsheet', title: phrase('helpcenter.general.category'), active: is_subscribed_category },
              { toggleUrl: path('portal_news_root_category_toggle_subscription'), icon: 'fal fa-file-chart-line', title: phrase('helpcenter.news.section_title'), active: is_subscribed_root },
            ]
          } %}
      {% endif %}
      <a href="javascript:void(0)" data-toggle="modal" data-target="#postExtraMobile"><i class="far fa-ellipsis-v" title="menu"></i></a>
    </div>
  </div>

  <!-- Mobile Modal -->
  <div class="modal fade mobile-modal" id="postExtraMobile" tabindex="-1" role="dialog" aria-labelledby="postExtraMobile"
       aria-hidden="true">
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <div class="dp-po-post-extra-mobile">
            <ul class="dp-po-post-extra-mobile-list">
              {% if app.getSetting('core.show_share_widget') %}
                <li class="dp-po-post-extra-mobile-item">
                  <a href="" data-toggle="modal" data-target="#postShareMobile" class="dp-po-post-extra-mobile-link"><i
                            class="dp-po-icon fas fa-share-alt"></i> Share</a>
                </li>
              {% endif %}
              <li class="dp-po-post-extra-mobile-item">
                <a href="javascript:window.print();" class="dp-po-post-extra-mobile-link"><i class="dp-po-icon fal fa-print"></i>
                  {{ phrase('helpcenter.general.print') }}
                </a>
              </li>
              <li class="dp-po-post-extra-mobile-item">
                <a href="{{ path('portal_news_pdf', {slug: post.slug}) }}" class="dp-po-post-extra-mobile-link" aria-label="{{ phrase('helpcenter.general.download_pdf') }} - {{ post.title }}.pdf"><i class="dp-po-icon fal fa-file-pdf"></i>
                  {{ phrase('helpcenter.general.download_pdf') }}
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
{% endblock page_top %}

{% block page_body %}
  <div class="dp-po-section">
    <div class="dp-po-post-content dp-po-block">
      {{ post.realContent|raw }}

      {% if post.attachments|length > 0 %}
        <div class="dp-po-kb-attachments">
          <h4 class="dp-po-kb-attachments-title">{{ phrase('helpcenter.general.attachments') }}</h4>
          <ul class="dp-po-kb-attachments-list">
            {% for attachment in post.attachments %}
              {% set blob = attachment.blob %}
              <li class="dp-po-kb-attachments-item">
                <a href="{{ portal_path(attachment, 'serve') }}" class="dp-po-kb-attachments-link">
                  <i class="dp-po-icon fal fa-{{ content_fa_icon(blob) }}"></i>
                  {% if blob %}{{ blob.filename }} <span>({{ attachment.readableFileSize }})</span>{% endif %}
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
    </div>
  </div>

  {% if can_rate_news(post) %}
    {% include 'Theme:PublishCommon:rating.html.twig' with {
      item: post
    } %}
  {% endif %}

  {% if brand_setting('user.publish_comments') and (post.calc_num_comments or new_comment_form) %}
    {% if postData.comments | length %}
      {% include 'Theme:PublishCommon:comments-list.html.twig' with { comments: postData.comments } %}
    {% endif %}

    {% if new_comment_form %}
      {% include 'Theme:PublishCommon:comments-form.html.twig' %}
    {% endif %}
  {% endif %}
{% endblock page_body %}

{% block page_sidebar %}
  {% if postData.related_content %}
    {% include 'Theme:PublishCommon:related-content.html.twig' with {
      related_content: postData.related_content
    } %}
  {% endif %}

  {% include 'Theme:PublishCommon:share.html.twig' with {
    item: post
  } %}

  {% if post.labels | length %}
    {% include 'Theme:PublishCommon:Labels/sidebar-block.html.twig' with {
      title: phrase('helpcenter.general.labels'),
      labels: post.labels
    } %}
  {% endif %}

  {% include 'Theme:PublishCommon:recent-items.html.twig' with {
    title: phrase('helpcenter.news.recent_title'),
    items: helpcenter.getRecentNews({category: category}),
    viewAllPath: path('portal_news_browse', {slug: category.slug}),
    viewAllTitle: phrase('helpcenter.general.nav_news_desc_short')
  } %}

{% endblock page_sidebar %}
