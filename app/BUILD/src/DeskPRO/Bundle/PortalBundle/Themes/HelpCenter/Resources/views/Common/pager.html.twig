{% if pager.haveToPaginate %}
    <div class="dp-po-pagination">
        <nav aria-label="...">
            {{ pagerfanta(pager, null, {
                routeParams: {tag_options: null},
                prev_message: '<i class="dp-po-icon far fa-angle-left"></i>',
                css_prev_class: 'page-item-icon',
                next_message: '<i class="dp-po-icon far fa-angle-right"></i>',
                css_next_class: 'page-item-icon',
                css_active_class: 'active'
            }) }}
        </nav>
    </div>
{% endif %}
