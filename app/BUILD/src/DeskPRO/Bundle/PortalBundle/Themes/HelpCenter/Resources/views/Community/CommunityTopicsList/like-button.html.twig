<a
    {% if (not topic.isClosed) %}
        href="{{ portal_path(topic, user_up_voted(topic) ? 'vote_down' : 'vote_up') }}"
        data-vote-up-url="{{ portal_path(topic, 'vote_up') }}"
        data-vote-down-url="{{ portal_path(topic, 'vote_down') }}"
        title="{{ phrase('helpcenter.community.like_action') }}"
    {% endif %}
    class="dp-po-like {{ is_compact ? 'dp-po-like-small' }} {{ user_up_voted(topic) ? 'agreed' }}"
    rel="noindex, nofollow"
>
    <span class="dp-po-like-count counter">{{ topic.total_rating }}</span>
    <span class="dp-po-like-icon"><i class="dp-po-icon fas fa-thumbs-up"></i></span>
</a>
