{% extends 'Theme::layout.html.twig' %}

{% block page_content %}
    {% if auth_manager.isForgotPasswordVisible %}
        <div class="dp-po">
            <main class="dp-po-main">
                <div class="container">
                    <div class="row">
                        <div class="col-sm-7 col-centered">
                            <div class="dp-po-title">
                                <h2>{{ phrase('helpcenter.account.set_password_request_title') }}</h2>
                            </div>

                            <div class="dp-po-block">
                                <p>
                                    {{ phrase('helpcenter.account.set_password_request_desc') }}
                                </p>

                                {% if render_error %}
                                    <strong>{{ phrase('helpcenter.account.set_password_invalid_input') }}</strong>
                                {% endif %}

                                {{ form_start(form) }}
                                {{ form_rest(form) }}
                                <button class="btn btn-primary" type="submit">{{ phrase('helpcenter.account.set_password_btn') }}</button>
                                {{ form_end(form) }}
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    {% endif %}
{% endblock page_content %}
