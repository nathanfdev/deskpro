{% set cls = "column-half-plus wide" %}
{% extends 'Theme::layout.html.twig' %}
{% import 'Theme:Portal:User/macros.html.twig' as macros %}

{% block sidebar %}
{% endblock sidebar %}

{% block page_content %}
<div class="dp-po">
    <main class="dp-po-main">
        <div class="container">
            <div class="row">
                <div class="col-sm-7 col-centered">
                    <div id="login-page">
                    {% if auth_manager.isAuthVisible %}
                        <div class="dp-po-title">
                            <h1 class="dp-po-title-text">
                                {{ phrase('helpcenter.general.log_in') }}
                            </h1>
                        </div>
                        <p>{{ phrase('helpcenter.account.section_desc_login') }}</p>

                        <div class="dp-po-section dp-po-block">
                            <section class="padded">
                                {% if reset_success %}
                                    {{ macros.user_notice('success', phrase('helpcenter.account.reset_password_success')) }}
                                {% endif %}

                                {% if set_password_success %}
                                    {{ macros.user_notice('success', phrase('helpcenter.account.set_password_success')) }}
                                {% endif %}

                                {% if login_error %}
                                    {{ macros.user_notice('danger', phrase(login_error)) }}
                                {% endif %}

                                {{  macros.lockout_notice(phrase('helpcenter.account.login_lockout'), lockout_error, lockout_time) }}

                                {% if login_captcha_failed %}
                                    {{ macros.user_notice('danger', phrase('helpcenter.account.login_captcha_failed')) }}
                                {% endif %}

                                {% if saved_form %}
                                    {{ macros.user_notice('auth', phrase('portal.account.login-saved-' ~ saved_form_type)) }}
                                {% endif %}

                                {% if auth_manager.isLoginFormVisible %}
                                    <form id="login" class="form-ticket" action="{{ path('portal_login_submit') }}" method="post" novalidate>
                                        <input type="hidden" name="_failure_path" value="{{ path('portal_login', {retry:'auth'}) }}"/>
                                        {% if destination %}
                                            <input type="hidden" name="_destination" value="{{ destination }}"/>
                                        {% endif %}

                                        <div class="form-group">
                                            <label for="login_username" class="title{% if login_error %} error{% endif %}">{{ phrase('helpcenter.account.login_email') }}</label>
                                            <input type="text" placeholder="{{ phrase('helpcenter.account.login_email') }}" name="username"
                                                   id="login_username" value="{{ last_username }}" tabindex="1" class="form-control"
                                            >
                                        </div>

                                        <div class="form-group">
                                            <label for="login_password" class="title{% if login_error %} error{% endif %}">{{ phrase('helpcenter.account.login_password') }}</label>
                                            <input type="password" placeholder="{{ phrase('helpcenter.account.login_password') }}"
                                                   name="password" id="login_password" tabindex="2" class="form-control"
                                            >
                                            {% if auth_manager.isForgotPasswordVisible %}
                                                <div class="form-meta form-meta-grey form-meta-top">
                                                    <a href="{{ path('portal_reset_password', {'email': last_username}) }}" tabindex="5">
                                                        {{ phrase('helpcenter.account.login_reset_password_link') }}
                                                    </a>
                                                </div>
                                            {% endif %}
                                        </div>

                                        {% if captcha_form is not null %}
                                            {{ form_widget(captcha_form) }}
                                        {% endif %}

                                        <button class="btn btn-primary" id="login_button" tabindex="4">{{ phrase('helpcenter.general.log_in') }}</button>
                                        {% if auth_manager.isRememberMeEnabled %}
                                            <div class="form-group">
                                                <div class="remember-me checkboxes">
                                                    <label for="remember_me">
                                                        <input tabindex="3" type="checkbox" name="remember_me" id="remember_me">
                                                        <i></i>
                                                        <span>{{ phrase('helpcenter.account.login_stay_logged_in') }}</span>
                                                    </label>
                                                </div>
                                            </div>
                                        {% endif %}
                                    </form>
                                {% endif %}
                            </section>

                            {% if auth_manager.hasLoginIconUsersources or auth_manager.hasLoginTextButtonUsersources %}

                                {% if auth_manager.isLoginFormVisible %}
                                    <hr class="divider" />
                                {% endif %}
                                <header class="large-title">
                                    <h2>{{ phrase('helpcenter.account.login_external') }}</h2>
                                    <p>{{ phrase('helpcenter.account.section_desc_login_external') }}</p>
                                </header>

                                <section class="padded dp-po-social-login">
                                    {% for usersource in usersources_view %}
                                    <a
                                        href="{{ path('portal_login_authenticate', { usersource_id: usersource.id }) }}"
                                        class="btn btn-icon btn-lg btn-brand {{ usersource.classes|join(' ') }}"
                                    >
                                        {% if usersource.icon %}<i class="{{ usersource.icon }} dp-po-icon"></i>{% endif %}
                                        {{ usersource.text }}
                                    </a>
                                    {% endfor %}
                                </section>
                            {% endif %}

                            {% if auth_manager.isRegistrationFormVisible %}
                                {% if auth_manager.hasLoginIconUsersources or auth_manager.hasLoginTextButtonUsersources or auth_manager.isLoginFormVisible %}
                                    <hr class="divider" />
                                {% endif %}
                                <header class="large-title">
                                    <h1>{{ phrase('helpcenter.account.login_register_header') }}</h1>
                                    <p>{{ phrase('helpcenter.account.section_desc_register') }}</p>
                                </header>

                                <section class="padded">
                                    <a class="btn btn-secondary" href="{{ path('portal_user_registration') }}">{{ phrase('helpcenter.account.login_register_action') }}</a>
                                </section>
                            {% endif %}
                        </div>
                    {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
{% endblock page_content %}
