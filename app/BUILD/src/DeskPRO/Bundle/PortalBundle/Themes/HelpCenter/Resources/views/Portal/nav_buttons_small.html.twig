<ul class="big-button-collection thin small left dpx-toggle-mobile">

    {% if can_use_articles() and show_tab_articles() %}
      <li class="item-kb {{ is_page_kb() ? 'active' }}">
        <a href="{{ path('portal_kb') }}">
          <i class="far fa-list-alt"></i>
          <span class="title">{{ phrase('helpcenter.general.nav-kb') }}</span>
          <span class="subtitle">{{ phrase('helpcenter.general.nav-kb-desc') }}</span>
        </a>
      </li>
    {% endif %}

    {% if app.hasBeta('guides') and can_use_guides() and show_tab_guides() and has_any_guides() %}
      <li class="item-guides {{ is_page_guides() ? 'active' }}">
        <a href="{{ path('portal_guides') }}">
          <i class="fas fa-book"></i>
          <span class="title">{{ phrase('helpcenter.general.nav-guides') }}</span>
          <span class="subtitle">{{ phrase('helpcenter.general.nav-guides-desc') }}</span>
        </a>
      </li>
    {% endif %}

    {% if can_use_news() and show_tab_news() %}
      <li class="item-news {{ is_page_news() ? 'active' }}">
        <a href="{{ path('portal_news') }}">
          <i class="far fa-calendar"></i>
          <span class="title">{{ phrase('helpcenter.general.nav-news') }}</span>
          <span class="subtitle">{{ phrase('helpcenter.general.nav-news-desc') }}</span>
        </a>
      </li>
    {% endif %}

    {% if can_use_community() and show_tab_community() %}
      <li class="item-community {{ is_page_community() ? 'active' }}">
        <a href="{{ path('portal_community') }}">
          <i class="far fa-thumbs-up"></i>
          <span class="title">{{ phrase('helpcenter.general.nav-community') }}</span>
          <span class="subtitle">{{ phrase('helpcenter.general.nav-community-desc') }}</span>
        </a>
      </li>
    {% endif %}

    {% if can_use_downloads() and show_tab_downloads() %}
      <li class="item-downloads {{ is_page_downloads() ? 'active' }}">
        <a href="{{ path('portal_downloads') }}">
          <i class="far fa-copy"></i>
          <span class="title">{{ phrase('helpcenter.general.nav-downloads') }}</span>
          <span class="subtitle">{{ phrase('helpcenter.general.nav-downloads-desc') }}</span>
        </a>
      </li>
    {% endif %}

    {% if can_view_tickets_link() and show_tab_tickets() %}
      <li class="item-tickets {{ is_page_tickets() ? 'active' }}">
        <a href="{{ path('portal_new_ticket') }}">
          <i class="far fa-envelope"></i>
          <span class="title">{{ phrase('helpcenter.general.nav-newticket') }}</span>
          <span class="subtitle">{{ phrase('helpcenter.general.nav-newticket-desc') }}</span>
        </a>
      </li>
    {% endif %}

</ul>
