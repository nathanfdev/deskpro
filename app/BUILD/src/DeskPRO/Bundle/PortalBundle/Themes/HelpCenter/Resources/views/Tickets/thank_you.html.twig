{% extends 'Theme::layout.html.twig' %}

{% block page_content %}
<div class="dp-po">
    <main class="dp-po-main dp-po-ticket-create">
        <div class="container">
            <div class="row">
                <div class="col-sm-7 col-centered">
                    <div class="dp-po-title">
                        <img class="dp-po-title-svg" src="{{ asset('img/page-icons/contact-us.svg', 'help_center') }}">
                        <h1 class="dp-po-title-text">{{ phrase('helpcenter.tickets.new_section_title') }}</h1>
                    </div>
                    <div class="dp-po-block">
                        <div class="dp-po-ticket-success">
                            <img class="dp-po-title-svg" src="{{ asset('img/page-icons/rocket.svg', 'help_center') }}">
                            {% if verify_email %}
                                <h2 class="dp-po-ticket-success-title">{{ phrase('helpcenter.tickets.thank_you_check_email') }}</h2>
                            {% else  %}
                                <h2 class="dp-po-ticket-success-title">{{ phrase('helpcenter.tickets.thank_you') }}</h2>
                                <p class="dp-po-ticket-success-number">{{ phrase('helpcenter.tickets.reference_number', {ref: '<a href="' ~ path('portal_tickets_view', { ticket_ref: ticket_ref } ) ~ '">' ~ ticket_ref ~ '</a>'}, true) }}</p>
                            {% endif %}
                            <div class="footer">
                                {% if is_confirmed_user and create_pw_link %}
                                    {{ phrase('helpcenter.tickets.thank_you_create_pw_link', { create_pw_link: create_pw_link }) }}
                                {% elseif verify_email %}
                                    <p>{{ phrase('helpcenter.tickets.thank_you_check_email_desc') }}</p>
                                {% else %}
                                    <p>{{ phrase('helpcenter.tickets.thank_you_desc') }}</p>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
{% endblock %}
