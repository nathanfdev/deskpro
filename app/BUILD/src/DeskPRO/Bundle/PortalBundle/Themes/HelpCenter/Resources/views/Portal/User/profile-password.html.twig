{% extends 'Theme::layout.html.twig' %}

{% block page_content %}
<div class="dp-po">
    <main class="dp-po-main dp-po-your-account">
        <div class="container">
            <div class="dp-po-title">
                <img src="{{ asset('img/page-icons/account.svg', 'help_center') }}" role="presentation" class="dp-po-title-svg">
                <h1 class="dp-po-title-text">{{ phrase('helpcenter.account.section_title_your_account') }}</h1>
            </div>
            <div class="row">
                <div class="col-sm-4">
                    <div class="dp-po-block">
                        {% include 'Theme:Portal:User/profile-sidebar.html.twig' with { active : 'password' } %}
                    </div>
                </div>
                <div class="col-sm-8">
                    <div class="dp-po-block dp-po-section">
                        <section class="dp-po-account-form">
                            {{ form_start(password_form, { attr: { class: 'form-ticket' } }) }}
                            {{ form_errors(password_form) }}
                            {% if password_form.current_password is defined %}
                                {{ form_row(password_form.current_password) }}
                            {% endif %}
                            {{ form_row(password_form.new_password) }}
                            <button type="submit" class="btn btn-primary">{{ phrase('helpcenter.account.change_password_action') }}</button>
                            {{ form_rest(password_form) }}
                            {{ form_end(password_form) }}
                        </section>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
{% endblock page_content %}
