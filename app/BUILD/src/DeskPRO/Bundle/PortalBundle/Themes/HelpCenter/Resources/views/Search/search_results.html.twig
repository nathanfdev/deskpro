{% extends 'Theme::layout.html.twig' %}
{% import 'Theme:Search:search_macros.html.twig' as search_macros %}

{% block page_content %}
{% set ticket_info = results.ticket is defined ? results.ticket.pageinfo : null %}
{% set ticket_results = results.ticket is defined ? results.ticket.results : null %}
{% set article_info = results.article is defined ? results.article.pageinfo : null %}
{% set article_results = results.article is defined ? results.article.results : null %}
{% set news_info = results.news is defined ? results.news.pageinfo : null %}
{% set news_results = results.news is defined ? results.news.results : null %}
{% set community_info = results.community is defined ? results.community.pageinfo : null %}
{% set community_results = results.community is defined ? results.community.results : null %}
{% set download_info = results.download is defined ? results.download.pageinfo : null %}
{% set download_results = results.download is defined ? results.download.results: null %}
{% set guide_info = results.topic is defined ? results.topic.pageinfo : null %}
{% set guide_results = results.topic is defined ? results.topic.results : null %}
{% set active = 'article' %}
{% if article_results %}
    {% set active = 'article' %}
{% elseif guide_results %}
    {% set active = 'guide' %}
{% elseif community_results %}
    {% set active = 'community' %}
{% elseif news_results %}
    {% set active = 'news' %}
{% elseif download_results %}
    {% set active = 'guide' %}
{% elseif guide_results %}
    {% set active = 'download' %}
{% endif %}

<div class="dp-po">
    <main id="main" tabindex="-1" class="dp-po-main dp-po-search-results">
        <div class="container">
            <div class="row">
                <div class="col-sm-9 col-centered">
                    <div class="dp-po-title">
                        <img class="dp-po-title-svg" src="{{ asset('img/page-icons/search.svg', 'help_center') }}" />
                        <h1 class="dp-po-title-text">{{ phrase('helpcenter.search.search_results') }}</h1>
                    </div>
                    <div class="dp-po-block dp-po-section">
                        <p class="dp-po-search-no-results">
                            {{ phrase('helpcenter.general.no_search_query') }}
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
{% endblock page_content %}
