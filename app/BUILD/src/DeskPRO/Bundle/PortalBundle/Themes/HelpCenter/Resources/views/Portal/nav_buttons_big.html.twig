<div class="dp-po-homepage-navigation">
    <div class="dp-po-navigation-block">
        <ul class="dp-po-navigation-block-list">

            {% if can_use_community() and show_tab_community() %}
            <li class="dp-po-navigation-block-item">
                <a href="{{ path('portal_community') }}" class="dp-po-navigation-block-link">
                    <figure class="dp-po-navigation-block-figure">
                        <img class="dp-po-navigation-block-svg"
                             src="{{ asset('img/page-icons/community.svg', 'help_center') }}" />
                    </figure>
                    <div class="dp-po-navigation-block-right">
                        <span class="dp-po-navigation-block-title">{{ phrase('helpcenter.general.nav_community') }}</span>
                        <span class="dp-po-navigation-block-desc">{{ phrase('helpcenter.general.nav_community_desc') }}
                            <figure class="dp-po-icon">
                                <i class="far fa-angle-right"></i>
                            </figure>
                        </span>
                    </div>
                </a>
            </li>
            {% endif %}

            {% if app.hasBeta('guides') and can_use_guides() and show_tab_guides() and has_any_guides() %}
            <li class="dp-po-navigation-block-item">
                <a href="{{ path('portal_guides') }}" class="dp-po-navigation-block-link">
                    <figure class="dp-po-navigation-block-figure">
                        <img class="dp-po-navigation-block-svg"
                             src="{{ asset('img/page-icons/guides.svg', 'help_center') }}" />
                    </figure>
                    <div class="dp-po-navigation-block-right">
                        <span class="dp-po-navigation-block-title">{{ phrase('helpcenter.general.nav_guides') }}</span>
                        <span class="dp-po-navigation-block-desc">{{ phrase('helpcenter.general.nav_guides_desc') }}
                            <figure class="dp-po-icon">
                                <i class="far fa-angle-right"></i>
                            </figure>
                        </span>
                    </div>
                </a>
            </li>
            {% endif %}

            {% if can_use_articles() and show_tab_articles() %}
            <li class="dp-po-navigation-block-item">
                <a href="{{ path('portal_kb') }}" class="dp-po-navigation-block-link">
                    <figure class="dp-po-navigation-block-figure">
                        <img class="dp-po-navigation-block-svg"
                             src="{{ asset('img/page-icons/knowledgebase.svg', 'help_center') }}" />
                    </figure>
                    <div class="dp-po-navigation-block-right">
                        <span class="dp-po-navigation-block-title">{{ phrase('helpcenter.general.nav_kb') }}</span>
                        <span class="dp-po-navigation-block-desc">{{ phrase('helpcenter.general.nav_kb_desc') }}
                            <figure class="dp-po-icon">
                                <i class="far fa-angle-right"></i>
                            </figure>
                        </span>
                    </div>
                </a>
            </li>
            {% endif %}

            {% if can_use_news() and show_tab_news() %}
            <li class="dp-po-navigation-block-item">
                <a href="{{ path('portal_news') }}" class="dp-po-navigation-block-link">
                    <figure class="dp-po-navigation-block-figure">
                        <img class="dp-po-navigation-block-svg"
                             src="{{ asset('img/page-icons/news.svg', 'help_center') }}" />
                    </figure>
                    <div class="dp-po-navigation-block-right">
                        <span class="dp-po-navigation-block-title">{{ phrase('helpcenter.general.nav_news') }}</span>
                        <span class="dp-po-navigation-block-desc">{{ phrase('helpcenter.general.nav_news_desc') }}
                            <figure class="dp-po-icon">
                                <i class="far fa-angle-right"></i>
                            </figure>
                        </span>
                    </div>
                </a>
            </li>
            {% endif %}

            {% if can_use_downloads() and show_tab_downloads() %}
            <li class="dp-po-navigation-block-item">
                <a href="{{ path('portal_downloads') }}" class="dp-po-navigation-block-link">
                    <figure class="dp-po-navigation-block-figure">
                        <img class="dp-po-navigation-block-svg"
                             src="{{ asset('img/page-icons/download.svg', 'help_center') }}" />
                    </figure>
                    <div class="dp-po-navigation-block-right">
                        <span class="dp-po-navigation-block-title">{{ phrase('helpcenter.general.downloads_type') }}</span>
                        <span class="dp-po-navigation-block-desc">{{ phrase('helpcenter.general.nav_downloads_desc') }}
                            <figure class="dp-po-icon">
                                <i class="far fa-angle-right"></i>
                            </figure>
                        </span>
                    </div>
                </a>
            </li>
            {% endif %}

            {% if can_view_tickets_link() and show_tab_tickets() %}
            <li class="dp-po-navigation-block-item">
                <a href="{{ path('portal_new_ticket') }}" class="dp-po-navigation-block-link">
                    <figure class="dp-po-navigation-block-figure">
                        <img class="dp-po-navigation-block-svg"
                             src="{{ asset('img/page-icons/contact-us.svg', 'help_center') }}">
                    </figure>
                    <div class="dp-po-navigation-block-right">
                        <span class="dp-po-navigation-block-title">{{ phrase('helpcenter.general.nav_contact') }}</span>
                        <span class="dp-po-navigation-block-desc">{{ phrase('helpcenter.general.nav_contact_desc') }}
                            <figure class="dp-po-icon">
                                <i class="far fa-angle-right"></i>
                            </figure>
                        </span>
                    </div>
                </a>
            </li>
            {% endif %}

        </ul>
    </div>
</div>
