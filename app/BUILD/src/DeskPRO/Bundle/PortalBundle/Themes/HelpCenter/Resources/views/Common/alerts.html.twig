{% if alerts.display_alerts %}
    <div class="dp-po" role="complementary">
        {% if alerts.lang_diff %}
            <div class="dp-po-message-bar dp-po-message-bar-error">
                <div class="container">
                    <div class="dp-po-message-bar-wrap">
                        <p class="dp-po-message-bar-icon"> <i class="dp-po-icon far fa-times-circle"></i></p>
                        <p class="dp-po-message-bar-text">
                            {{ phrase('helpcenter.general.lang-diff', { active_lang: alerts.lang_diff.active_lang.title, person_lang: alerts.lang_diff.person_lang.title }) }}
                            <a href="{{ path('portal_change_language', {lang_code: alerts.lang_diff.active_lang.url_code}) }}" class="alert-button post-link">{{ phrase('helpcenter.general.lang-change-to-current', { lang: alerts.lang_diff.active_lang.title }) }}</a>
                            <a href="{{ path('portal_change_language', {lang_code: alerts.lang_diff.person_lang.url_code}) }}" class="alert-button post-link">{{ phrase('helpcenter.general.lang-switch', { lang: alerts.lang_diff.person_lang.title }) }}</a>
                        </p>
                        <a href="{{ path('portal_dismiss_lang_alert') }}" class="dp-po-message-bar-close"><i class="dp-po-icon fal fa-times"></i></a>
                    </div>
                </div>
            </div>
        {% endif %}

        {% for saved in alerts.saved_forms %}
            {% set alert_id = saved.link %}
            <span class="alert" data-alert-id="{{ alert_id }}">
                <div class="click-to-dismiss"><i class="fas fa-times"></i></div>
                {% if saved.dataType is defined %}{{ phrase('helpcenter.account.submit-saved-form' ~ saved.dataType) }}{% endif %}
                <a class="alert-button" href="{{ saved.link }}">{{ phrase('helpcenter.account.submit-saved-form-go') }}</a>
            </span>
        {% endfor %}

        {% if alerts.tickets_awaiting_reply | length > 0 %}
            <div class="dp-po-notification">
                <figure class="dp-po-notification-figure">
                    <img class="dp-po-notification-image" src="{{ asset('img/docs/notification.png', 'help_center') }}" role="presentation" alt="envelope icon">
                    <span class="dp-po-notification-count">{{ alerts.tickets_awaiting_reply | length }}</span>
                </figure>
                <span class="dp-po-notification-title">{{ phrase('helpcenter.alerts.tickets-to-respond', { count: alerts.tickets_awaiting_reply | length })}}
                    <a href="{{ path('portal_tickets') }}" class="dp-po-notification-link">{{ phrase('helpcenter.general.click-here-to-view') }}</a>
                </span>
            </div>
        {% endif %}
    </div>
{% endif %}
