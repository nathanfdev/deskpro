{% extends 'Theme::layout.html.twig' %}

{% block page_content %}
    {% if auth_manager.isForgotPasswordVisible %}
        <header class="section-header">
            <h1>{{ phrase('helpcenter.account.section-title-reset-password') }}</h1>
        </header>

        <div class="form-ticket">
            {{ form_start(form) }}
            {{ form_rest(form) }}
            <div class="column-full">
                <div class="bucket">
                    <button type="submit">{{ phrase('helpcenter.account.reset-password-btn') }}</button>
                </div>
            </div>
            {{ form_end(form) }}
        </div>
    {% endif %}
{% endblock page_content %}
