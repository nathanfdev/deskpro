<div class="dp-po-ticket-create" id="new_ticket_page">
    <div class="dp-po-ticket-create-form helpcenter-form dp_ticket_form{% if show_ticket_suggestions %} dpx-with-ticket-deflection{% endif %}">
        <p>{{ phrase('helpcenter.tickets.new_intro') }}</p>
        <form method="POST" class="dp-po-form" novalidate data-save-draft="new_ticket{{ app.user ? '-' ~ app.user.id : '' }}" name="ticket" enctype="multipart/form-data" data-visibility="{{ form.vars.visibility }}">
            {% if form_errors|length > 0 %}
                <div class="alert alert-danger" role="alert">
                    <h4>{{ phrase('helpcenter.tickets.view_reply_errors') }}</h4>
                    <ul>
                        {% for error in form_errors %}
                            {% set error_view = error.origin.createView() %}
                            <li>
                                    <span>
                                        {{ phrase_form_error(error) }}
                                        {% if error.cause %}
                                            <!--
                                                code: {{ error.cause.code }}
                                                message: {{ error.cause.message }}
                                                parameters: {{ error.cause.parameters|json_encode() }}
                                            -->
                                        {% endif %}
                                    </span>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            <div class="dynamic-fields-container">
                {% for widget in form.children if not widget.rendered and widget.vars.name not in ['_token', '_dp_csrf_token', 'submit'] %}
                    {% set hidden = widget.vars.name == 'department' and app.request.get('hide_department') %}
                    <div class="column-full deskpro-form-widget field_{{ widget.vars.name }}"
                         data-field="{{ widget.vars.name }}"
                         style="{% if hidden %}display: none;{% endif %}">
                        {{ form_row(widget) }}
                    </div>
                {% endfor %}
            </div>
            {{ form_widget(form.submit) }}
            {{ form_rest(form) }}
        {{ form_end(form) }}
    </div>

    <!-- BEGIN JS FORM -->
    <div class="js_form_tpl" style="display: none;">
        {% for widget in form_full.children if not widget.rendered and widget.vars.name not in ['_token', '_dp_csrf_token'] %}
            <div class="column-full deskpro-form-widget field_{{ widget.vars.name }}" data-field="{{ widget.vars.name }}">
                {{ form_row(widget) }}
            </div>
        {% endfor %}
    </div>
    <!-- END JS FORM -->
</div>
