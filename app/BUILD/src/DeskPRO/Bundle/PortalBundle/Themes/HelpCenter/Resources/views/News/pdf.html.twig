{% extends 'Theme:Pdf:layout.html.twig' %}
{% block page_body %}

    <div class="breadcrumbs">
        {% include 'Theme:Common:pdf_breadcrumbs.html.twig' %}
    </div>

    <article class="news kb-article">
        <header>
            <div class="news-header main-list">
                <h1>{{ post.realTitle }}</h1>

                <div class="article-meta">
                    {{ post.date_published | date('Y-m-d') }}

                    -

                    <span style="background: url({{ avatar_url(post.person) }}) no-repeat; background-size: cover" class="agent-avatar agent-avatar-mini"></span>{{ post.person.display_name_user }}

                    {% if brand_setting('user.publish_comments') %}
                        -

                        <span class="comments"><i class="fas fa-comments"></i>
                            <a href="#comments">{{ phrase('helpcenter.general.comments-count', {count: post.calc_num_comments}) }}</a>
                        </span>
                    {% endif %}

                    {% if post.category %}
                        -
                        {{ phrase('helpcenter.general.in') }} <a href="{{ portal_path(post.category) }}">{{ object_phrase(post.category) }}</a>
                    {% endif %}

                </div>
            </div>
            {% if post.status != 'published' and post.status != 'archived' and app.user.is_agent %}
                <div class="sub-note">{{ phrase('helpcenter.news.view-as-agent') }}</div>
            {% endif %}
        </header>

        <div class="article-content padded">
            {{ post.realContent|raw }}
        </div>

        {% if post.labels|length %}
            <div class="tag-list">
                <ul>
                    <li class="tag-list-header"><i class="fas fa-tags"></i> {{ phrase('helpcenter.general.tags') }}</li>
                    {% for l in post.labels %}
                        <li class="tag-list-item"><a href="{{ path('portal_search_labels', { label: l }) }}">{{ l }}</a></li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
    </article>

    {% show news_attachments %}

    {% if postData.related_content %}
        {% include 'Theme:PublishCommon:related-content.html.twig' with {
            related_content: postData.related_content
        } %}
    {% endif %}

    {% if brand_setting('user.publish_comments') and post.calc_num_comments %}
        <div class="comment-box" id="comments">
            <div class="titled-header">
                <h1>{{ phrase('helpcenter.general.comments-title', {count: post.calc_num_comments}) }}</h1>
            </div>
            {% if postData.comments | length %}
                {% include 'Theme:PublishCommon:comments-list.html.twig' with { comments: postData.comments } %}
            {% endif %}
        </div>
    {% endif %}
{% endblock page_body %}
