<script type="text/javascript">
  (function() {
    document.body.className = document.body.className + ' with-js';

    // Features that determine if 'DPUI' can be enabled for this user
    window.WITH_DPUI =
      Modernizr && !Modernizr.ie8compat &&
      Modernizr.json &&
      Modernizr.blobconstructor
    ;

    if (window.WITH_DPUI) {
      document.body.className += ' with-dpui';
    } else {
      document.body.className += ' without-dpui';
    }

    if ("ontouchstart" in document.documentElement) {
      document.body.className += ' with-touch-device';
    } else {
      document.body.className += ' without-touch-device';
    }
  })();
</script>

{% if portal_mode() != 'focus-window' and portal_mode() != 'fame-embed' and is_portal_widget_enabled() %}{{ portal_widget_loader() }}{% endif %}
{% if portal_mode() != 'focus-window' and portal_mode() != 'fame-embed' and is_portal_messenger_enabled() %}
	<script type="text/javascript">
    window.DESKPRO_MESSENGER_OPTIONS = {
			{% if app.user %}
			{% if is_widget_jwt_enabled() %}
      jwt: "{{ create_widget_jwt_token(app.user) }}",
			{% else %}
      user: {
        name: "{{ app.user.display_name }}",
        email: "{{ app.user.email }}",
        avatar: "{{ avatar_url(app.user) }}",
      },
			{% endif %}
      language: {
        id: "{{ app.user.getLanguage().getId() }}",
        locale: "{{ app.user.getLanguage().getLocale() }}"
      },
			{% else %}
      language: {
        id: "{{ language.getId() }}",
        locale: "{{ language.getLocale() }}"
      },
			{% endif %}
      helpdeskURL: "{{ root_url(false) }}",
      baseUrl: "{{ asset('', 'messenger_assets') }}",
			{% if root_url(false) matches '#/b/.+/?#' %}
			brandId: {{ brand('id') }},
			{% endif %}
    }
	</script>
	<script id="dp-messenger-loader" src="{{ asset('loader.js', 'messenger_loader_assets') }}"></script>
{% endif %}
