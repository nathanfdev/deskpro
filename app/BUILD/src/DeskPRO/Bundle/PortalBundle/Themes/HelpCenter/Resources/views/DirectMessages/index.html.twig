{% extends 'Theme::layout.html.twig' %}

{% block page_body %}
  <div class="browse-page">
    <header class="large-title">
      <h1>{{ phrase('portal.direct_messages.title') }}</h1>
    </header>

    <div class="content-list-wrap simple as-articles {% if pager|length %}with-items{% else %}with-no-items{% endif %}">
      <a href="{{ path('portal_dm_send') }}">{{ phrase('portal.direct_messages.create_thread') }}</a><br/>
      {% if pager|length %}
        <ul class="content-list">
          {% for thread in pager %}
            <li>
              <a href="{{ path('portal_dm_view', {'id': thread.id}) }}">
                Id: {{ thread.id }}<br/>
                Participant: {% for p in participants[thread.id] %}{% if p.person.id != app.user.id %}{{ p.person.display_name }}{% endif %}{% endfor%}<br/>
                Created: {{ thread.dateCreated|date('Y-m-d H:i') }}<br/>
                Last Message: {{ thread.dateLastMessage|date('Y-m-d H:i') }}<br/>
                {% for p in participants[thread.id] %}{% if p.person.id == app.user.id %}{% if p.isUnread %}<b>Has unread!</b>{% endif %}{% endif %}{% endfor%}
              </a>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <strong>{{ phrase('portal.direct_messages.none') }}</strong>
      {% endif %}
    </div>

  </div>
{% endblock page_body %}
