<section class="dp-po-Breadcrumbs-wrap">
    <div class="dp-po-container">
        <ul class="dp-po-Breadcrumbs Breadcrumbs--custom">
            {# TODO SMALL LOGO <li class="dp-po-Breadcrumb-item"><span class="dp-po-Icon Icon-Tech-company"></span></li> #}
            <li class="dp-po-Breadcrumb-item dp-po-support-centre"><a href="{{ path('portal_home') }}" class="dp-po-Breadcrumb-link">{{ brand_setting('core.deskpro_name')|e }}</a></li>
            {% if breadcrumbs is defined %}
                {% for item in breadcrumbs %}
                    <li class="dp-po-Breadcrumb-item {% if loop.last %}is-selected{% endif %}">
                        <a href="{{ item.url }}" class="dp-po-Breadcrumb-link">
                            {%- if item.phrase -%}
                                {{ phrase(item.phrase) }}
                            {%- elseif item.var['translated_title'] is defined -%}
                                {{ item.var.translated_title }}
                            {%- elseif item.var.title is defined -%}
                                {{ item.var.title }}
                            {%- elseif item.var.name is defined -%}
                                {{ item.var.name }}
                            {%- else -%}
                                {{ item.url }}
                            {%- endif -%}
                        </a>
                    </li>
                {% endfor %}
            {% endif %}
        </ul>
    </div>
</section>
