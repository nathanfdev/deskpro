<div class="dp-po">
    <nav class="breadcrumb-outer" aria-label="breadcrumb">
        <div class="container d-flex align-items-center">
            {% if portal_custom_logo() %}
                <div class="breadcrumb-image">
                    <a href="{{ brand_setting('core.site_url') | default(path('portal_home')) }}">
                        <img alt="{{ brand_setting('core.deskpro_name')|e }}" src="{{ portal_custom_logo() }}" class="logo" />
                    </a>
                </div>
            {% endif %}
            <ol class="breadcrumb">
                <li class="breadcrumb-item{% if breadcrumbs is not defined or breadcrumbs | length < 1 %} active{% endif %}"><a href="{{ path('portal_home') }}">{{ phrase('helpcenter.general.nav-support-center') }}</a></li>
                {% if breadcrumbs is defined %}
                    {% for item in breadcrumbs %}
                        <li class="breadcrumb-item{% if loop.last %} active{% endif %}">
                            <i class="dp-po-icon fal fa-angle-right"></i>
                            <a href="{{ item.url }}" class="dp-po-Breadcrumb-link">
                                {%- if item.phrase -%}
                                    {{ phrase(item.phrase) }}
                                {%- elseif item.var['translated_title'] is defined -%}
                                    {{ item.var.translated_title }}
                                {%- elseif item.var.title is defined -%}
                                    {{ item.var.title }}
                                {%- elseif item.var.name is defined -%}
                                    {{ item.var.name }}
                                {%- else -%}
                                    {{ item.url }}
                                {%- endif -%}
                            </a>
                        </li>
                    {% endfor %}
                {% endif %}
            </ol>
        </div>
    </nav>
</div>
