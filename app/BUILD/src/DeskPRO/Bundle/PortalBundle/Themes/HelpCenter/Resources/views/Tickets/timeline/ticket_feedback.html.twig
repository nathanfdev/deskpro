<div class="dp-po-ticket-block dp-po-ticket-block-mine dp-po-ticket-block-rate">
    <div class="dp-po-ticket-block-header">
        <img class="dp-po-icon icon-svg" src="{{ asset('img/page-icons/ticket-rate.svg', 'help_center') }}"> {{ phrase('helpcenter.tickets.rate_support') }}
    </div>
    <div class="dp-po-avatar dp-po-avatar-round">
        {{ hc_avatar(feedback.person) }}
        {% if feedback.person.id == app.user.id %}
            {{ phrase('helpcenter.tickets.you_rated_support', { email: app.user.email}) }}
        {% else %}
            {{ phrase('helpcenter.tickets.user_rated_support', { person: feedback.person, email: feedback.person.email }) }}
        {% endif %}
    </div>

    <div class="dp-po-ticket-block-feedback">
        <div class="dp-po-avatar dp-po-avatar-round">
            {{ hc_avatar(feedback.ticket_message.person) }}
            {{ feedback.ticket_message.person.display_name_user }}
        </div>
        <div class="dp-po-ticket-block-rating-label">
            {% if feedback.rating_type == 'negative' %}
                {{ phrase('helpcenter.tickets.rate_short_negative') }}
            {% elseif feedback.rating_type == 'neutral' %}
                {{ phrase('helpcenter.tickets.rate_short_neutral') }}
            {% elseif feedback.rating_type == 'positive' %}
                {{ phrase('helpcenter.tickets.rate_short_positive') }}
            {% endif %}
            <div class="dp-po-ticket-block-rating {% if feedback.rating == -1 %}dp-po-ticket-modal-rating-one{% elseif feedback.rating == 0%}dp-po-ticket-modal-rating-two{% endif %}">
                <i class="dp-po-icon fad fa-star"></i>
                <i class="dp-po-icon fad fa-star"></i>
                <i class="dp-po-icon fad fa-star"></i>
            </div>
        </div>
    </div>
    <div class="dp-po-ticket-block-content">
        <p class="dp-po-ticket-block-msg">
            {{ feedback.message }}
        </p>
    </div>

    <div class="dp-po-time">
        <i class="dp-po-icon far fa-clock"></i>
        {{ date_ago(feedback.date_created) }}
    </div>
</div>
