<dl class="dp-po-post-meta">
    <dt class="dp-po-post-meta-title">{{ phrase('helpcenter.sidebar.article_posted_by') }}</dt>
    <dd>{{ item.person.display_name_user }}</dd>
    <dt class="dp-po-post-meta-title">{{ phrase('helpcenter.tickets.list_date_created') }}</dt>
    <dd>{{ phrase('helpcenter.general.date_medium', { date:item.date_published }) }}</dd>
    {% if custom_data | length %}
        {% include 'Theme:PublishCommon:custom-data-sidebar-list.html.twig' %}
    {% endif %}
    {% if item['object_props_translations'] is defined and (item.object_props_translations | length > 0) %}
    <table class="table table-borderless">
        <tr>
            <th>
                <span class="dp-po-post-meta-title">{{ phrase('helpcenter.general.translations') }}</span>
            </th>
            {#<th class="text-right">
                <h3 class="dp-po-post-meta-title">{{ phrase('helpcenter.general.updated') }}</h3>
            </th>#}
        </tr>
        {% for translation in  item.object_props_translations %}
            {% if translation.prop_name == 'content' %}
            <tr>
                <td><img class="dp-po-icon" src="{{ asset('images/flags/' ~ translation.language.flag_image) }}" alt="" />
                    {{ translation.language.title_local }}</td>
                {#<td class="text-right text-success">23 days</td>#}
            </tr>
            {% endif %}
        {% endfor %}
    </table>
    {% endif %}
    {% if item['end_action'] is defined and item.end_action == 'unpublish' and app.user is not null and app.user.is_agent %}
    <dt class="dp-po-post-meta-title">{{ phrase('helpcenter.general.unpublished') }} <span class="dp-po-icon" data-toggle="tooltip" title="{{ phrase('helpcenter.general.field_viewed_by_agents_only') }}" data-placement="top">
            <i class="fal fa-info-circle text-primary" ></i>
        </span></dt>
    <dd>{{ phrase('helpcenter.general.date_medium', { date:item.date_end }) }}</dd>
    {% endif %}
</dl>
