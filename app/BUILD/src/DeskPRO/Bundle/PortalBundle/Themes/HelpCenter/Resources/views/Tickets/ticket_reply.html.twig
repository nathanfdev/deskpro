{% import 'Theme:Tickets:macros.html.twig' as macros %}

<div class="dp-po-section dp-po-comments">
    
    {% if ticket.resolved %}
        <div class="dp-po-title">
            <h2 class="dp-po-title-text dp-po-title-small">{{ phrase('portal.tickets.view_now_closed') }}</h2>
        </div>

        {% if ticket.date_resolved %}
            <p>{{ phrase('portal.tickets.view_closed', { ago: date_ago(ticket.date_resolved, null, false), day: ticket.date_resolved|date('day') }) }}</p>
        {% endif %}
        <hr>
        <p class="footer">{{ phrase('portal.tickets.view_closed_more', { kb_url: path('portal_kb'), new_ticket_url: path('portal_new_ticket') })|raw }}</p>
    
        {% if ticket.resolved and is_granted('TICKET_REOPEN_RESOLVED', ticket) %}
            <a href="{{ portal_path(ticket, 'unresolve') }}" class="button post-link">
                {{ phrase('portal.tickets.mark-unresolved') }}
            </a>
        {% endif %}
        
        <div class="ticket-reply-closed">
            <h1>{{ phrase('portal.tickets.view_now_closed') }}</h1>
            {% if ticket.date_resolved %}
                <p>{{ phrase('portal.tickets.view_closed', { ago: date_ago(ticket.date_resolved, null, false), day: ticket.date_resolved|date('day') }) }}</p>
            {% endif %}
            <hr>
            <p class="footer">{{ phrase('portal.tickets.view_closed_more', { kb_url: path('portal_kb'), new_ticket_url: path('portal_new_ticket') })|raw }}</p>
            
            {% if ticket.resolved and is_granted('TICKET_REOPEN_RESOLVED', ticket) %}
                <a href="{{ portal_path(ticket, 'unresolve') }}" class="button post-link">
                    {{ phrase('portal.tickets.mark-unresolved') }}
                </a>
            {% endif %}
        </div>
    {% endif %}
    
    {% if not ticket.archived and not ticket.resolved %}
        <div class="dp-po-title">
            <h2 class="dp-po-title-text dp-po-title-small">
                {% if not ticket.resolved %}
                    {{ phrase('portal.tickets.view_reply_or_close', { close_url: portal_path(ticket, 'resolve') }) }}
                {% else %}
                    {{ phrase('portal.tickets.view_reply') }}
                {% endif %}
            </h2>
        </div>
        <div class="dp-po-block">
            <div class="dp-po-comments-add">
                {{ form_errors(form) }}
                {{ form_start(form, { attr: { class: 'dp-po-form' } }) }}
                    {% if form_errors|length > 0 %}
                        <div class="column-full">
                            <div class="bucket">
                                <div class="form-error-list" style="max-width: 620px;">
                                    <h1>{{ phrase('portal.tickets.view_reply_errors') }}</h1>
                                    <ul>
                                        {% for error in form_errors %}
                                            {% set error_view = error.origin.createView() %}
                                            <li>
                                                <span>{{ phrase_form_error(error) }}</span>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                
                    <div class="form-group">
                        {{ form_widget(form.ticket_message) }}
                    </div>
                    {{ form_widget(form.attachments) }}
                    <div class="as-no-dpui">{{ form_widget(form.more_attachments, { attr: { class: 'btn btn-primary' }}) }}</div>
                
                    <div class="row align-items-center">
                        <div class="col-sm-2">
                            {{ form_widget(form.submit, { attr: { class: 'btn btn-primary' }}) }}
                        </div>
                    </div>
                    {{ form_rest(form) }}
                {{ form_end(form) }}
            </div>
        </div>
    {% else %}
        <div class="flashes">
            <div class="flash flash-notice">
                {{ phrase('portal.tickets.view_cant_reply_archived') }}
            </div>
        </div>
        {% if can_view_tickets_link() %}
            <a href="{{ path('portal_new_ticket') }}" class="button">
                <p>{{ phrase('portal.tickets.new_ticket_button') }}</p>
            </a>
        {% endif %}
    {% endif %}
</div>
