{% extends 'Theme::layout.html.twig' %}
{% import 'Theme:Portal:User/macros.html.twig' as macros %}

{% block page_content %}
    {{  macros.lockout_notice(phrase('helpcenter.account.reset_password_lockout'), lockout, lockout_time) }}
    {% if auth_manager.isForgotPasswordVisible %}
        <div class="dp-po">
            <main class="dp-po-main">
                <div class="container">
                    <div class="row">
                        <div class="col-sm-7 col-centered">
                            <div class="dp-po-title">
                                <h2>{{ phrase('helpcenter.account.reset_password_request_title') }}</h2>
                            </div>

                            <div class="dp-po-block">
                                <p>{{ phrase('helpcenter.account.reset_password_request_desc') }}</p>

                                {% if render_error %}
                                    <strong>{{ phrase('helpcenter.account.reset_password_invalid_input') }}</strong>
                                {% endif %}

                                <div class="form-ticket">
                                    {{ form_start(form) }}
                                    {{ form_rest(form) }}
                                    <div class="column-full">
                                        <div class="bucket">
                                            <button class="btn btn-primary" type="submit">{{ phrase('helpcenter.account.reset_password_action') }}</button>
                                        </div>
                                    </div>
                                    {{ form_end(form) }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    {% endif %}
{% endblock page_content %}
