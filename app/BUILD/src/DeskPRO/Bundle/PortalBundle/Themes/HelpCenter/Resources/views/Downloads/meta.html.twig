<dl class="dp-po-post-meta">
    <dt class="dp-po-post-meta-title">{{ phrase('helpcenter.general.first_published') }}</dt>
    <dd>{{ phrase('helpcenter.general.date_medium', {date: file.date_published}) }}</dd>
{#    <dt class="dp-po-post-meta-title">File type</h3>#}
{#    <dd>PDF</p>#}
    <dt class="dp-po-post-meta-title">{{ phrase('helpcenter.downloads.file_name') }}</dt>
    <dd>{{ file.filename}}</dd>
    <dt class="dp-po-post-meta-title">{{ phrase('helpcenter.downloads.file_size') }}</dt>
    <dd>{{ file.readable_file_size}}</dd>
    <dt class="dp-po-post-meta-title">{{ phrase('helpcenter.downloads.total_downloads') }}</dt>
    <dd>{{ file.num_downloads }}</dd>
    {% if custom_data | length %}
        {% include 'Theme:PublishCommon:custom-data-sidebar-list.html.twig' %}
    {% endif %}
</dl>

