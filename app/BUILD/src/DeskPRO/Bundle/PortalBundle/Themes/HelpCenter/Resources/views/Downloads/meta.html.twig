<div class="dp-po-post-meta">
    <h3 class="dp-po-post-meta-title">{{ phrase('helpcenter.general.first-published') }}</h3>
    <p>{{ file.date_published | date('day') }}</p>
{#    <h3 class="dp-po-post-meta-title">File type</h3>#}
{#    <p>PDF</p>#}
    <h3 class="dp-po-post-meta-title">{{ phrase('helpcenter.downloads.file-name') }}</h3>
    <p>{{ file.filename}}</p>
    <h3 class="dp-po-post-meta-title">{{ phrase('helpcenter.downloads.file-size') }}</h3>
    <p>{{ file.readable_file_size}}</p>
    <h3 class="dp-po-post-meta-title">{{ phrase('helpcenter.downloads.total-downloads') }}</h3>
    <p>{{ file.num_downloads }}</p>
</div>

