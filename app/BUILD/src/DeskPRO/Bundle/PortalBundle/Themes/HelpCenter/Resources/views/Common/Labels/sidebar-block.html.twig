<div class="dp-po-md-collapse dp-po-wrap-item dp-po-labels-wrap">
    <span class="dp-po-md-collapse-title dp-po-title">{{ title }}</span>
    <div class="dp-po-md-collapse-content">
        {% for l in  labels %}
            <span class="dp-po-label label--large label--success"><a href="{{ path('portal_search_labels', { label: l }) }}">{{ l }}</a></span>
        {% endfor %}
    </div>
</div>
