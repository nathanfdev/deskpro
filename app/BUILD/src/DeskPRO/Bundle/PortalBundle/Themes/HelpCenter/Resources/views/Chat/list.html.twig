                    </div>
                  </span>
                                    <span class="dp-po-table-cell dp-po-table-cell-large">{{ chat.subject_preview }}
                    <a href="{{ portal_path(chat) }}" class="dp-po-table-cell-view">{{ phrase('helpcenter.messenger.view_action') }}</a>
