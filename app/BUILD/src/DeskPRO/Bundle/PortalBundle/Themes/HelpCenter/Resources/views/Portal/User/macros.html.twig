{% macro user_notice(type, title, subtitle = null) %}

<div class="alert alert-icon alert-{{ type }}" {% if type == 'danger' %} aria-live="assertive" {% endif %}>
    <i class="dp-po-icon fas fa-lock"></i>
    {{ title }}
    <p>{{ subtitle }}</p>
</div>
{% endmacro %}

{% macro lockout_notice(title, lockout, lockout_time) %}
    {% import _self as this %}
    {% if lockout %}
        {{ this.user_notice('auth', title, lockout_time ? phrase('helpcenter.account.lockout_time', {minutes: lockout_time})) }}
    {% endif %}
{% endmacro %}
