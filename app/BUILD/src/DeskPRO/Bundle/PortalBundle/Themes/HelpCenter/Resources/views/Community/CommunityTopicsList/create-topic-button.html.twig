{# --------------------------------------------- #}
{# In sidebar #}
{# --------------------------------------------- #}

{% if is_sidebar is defined and is_sidebar %}
    <div class="dp-po-community-create">
      {% if current_forum is defined %}
        <a class="dp-po-community-create-link" href="{{ path('portal_community_topic_create', {id: current_forum.id}) }}">
          <i class="dp-po-icon fad fa-money-check-edit"></i>
            {{ phrase('helpcenter.community.create-topic-full') }}
            {# TODO when custom words are a feature {{ phrase('helpcenter.community.create-topic-in-forum', {forum: current_forum.title}) }} #}
        </a>
      {% else %}
        <a href="javascript:void(0);" class="dp-po-community-create-link" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
          <i class="dp-po-icon fad fa-money-check-edit"></i>
          {{ button_label|default(phrase('helpcenter.community.create-topic')) }}
        </a>
        {% if community_forums is defined %}
          <a class="dp-po-community-title-button-dropdown" href="" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <i class="dp-po-icon dp-po-community-title-arrow far fa-angle-down" title="dropdown"></i>
          </a>
        {% endif %}
      {% endif %}
    </div>

{# --------------------------------------------- #}
{# In header #}
{# --------------------------------------------- #}

{% else %}
    <div class="dp-po-community-title-button">
        {% if current_forum is defined and button_label is not defined %}
            <a href="{{ path('portal_community_topic_create', {id: current_forum.id}) }}" class="dp-po-community-title-button-link">
                <i class="dp-po-icon fad fa-money-check-edit"></i>
                {{ phrase('helpcenter.community.create-topic-in-forum', {forum: current_forum.title}) }}
            </a>
            <a class="dp-po-community-title-button-dropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <i class="dp-po-icon dp-po-community-title-arrow far fa-angle-down" title="dropdown"></i>
            </a>
        {% else %}
            <a href="javascript:void(0);" class="dp-po-community-title-button-link" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <i class="dp-po-icon fad fa-money-check-edit"></i>
                {{ button_label|default(phrase('helpcenter.community.create-topic')) }}
            </a>
            {% if community_forums is defined %}
                <a class="dp-po-community-title-button-dropdown" href="" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="dp-po-icon dp-po-community-title-arrow far fa-angle-down" title="dropdown"></i>
                </a>
            {% endif %}
        {% endif %}
        {% if community_forums is defined %}
            <div class="dropdown-menu dropdown-menu-right">
                {% for forum in community_forums if forum != current_forum|default(null) %}
                    <a class="dropdown-item" href="{{ path('portal_community_topic_create', {id: forum.id}) }}">
                        {% if forum.icon_property %}
                            {{ render_icon_from(forum, {as_download_url: true, is_rounded: true}) }}
                        {% endif %}
                        {{ forum.title }}
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endif %}
