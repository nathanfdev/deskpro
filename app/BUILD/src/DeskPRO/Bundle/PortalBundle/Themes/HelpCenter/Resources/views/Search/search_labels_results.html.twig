{% extends 'Theme::layout.html.twig' %}

{% block page_body %}
    <div class="search-results">
        <div class="search-results-content">
            <div class="form-ticket">
                <form method="post" novalidate>
                   <div class="form-widget">
                       {{ phrase('helpcenter.general.show') }}
                       <select name="type">
                           <option value="all"{% if type == 'all' %} selected="selected"{% endif %}>
                               {{ phrase('helpcenter.general.everything') }}
                           </option>
                           <option value="articles"{% if type == 'articles' %} selected="selected"{% endif %}>
                               {{ phrase('helpcenter.general.nav_kb') }}
                           </option>
                           <option value="news"{% if type == 'news' %} selected="selected"{% endif %}>
                               {{ phrase('helpcenter.general.nav_news') }}
                           </option>
                           <option value="downloads"{% if type == 'downloads' %} selected="selected"{% endif %}>
                               {{ phrase('helpcenter.general.nav_downloads') }}
                           </option>
                           <option value="community"{% if type == 'community' %} selected="selected"{% endif %}>
                               {{ phrase('helpcenter.general.nav_community') }}
                           </option>
                       </select>
                       {{ phrase('helpcenter.general.tagged_with') }}
                       <input type="text" name="label" value="{{ label }}" style="width:250px;" />
                       <button class="button button-small button-blank">
                           {{ phrase('helpcenter.general.btn_go') }}
                       </button>
                   </div>
                </form>
            </div>
            <div class="search-result-count">
                {% if pageinfo is not null and pageinfo.total_results %}
                    {% if label %}
                        {{ phrase('helpcenter.general.x_search_results', { num: num_results, query: label }) }}
                    {% else %}
                        {{ phrase('helpcenter.general.x_search_results_no_query', { num: num_results }) }}
                    {% endif %}
                {% else %}
                    {{ phrase('helpcenter.general.label_search_enter_label') }}
                {% endif %}
            </div>
            <div class="search-results">
                <div class="search-results-content">
                    {% if results|length > 0 %}
                        <ul class="search-result-items">
                            {% for result_item in results %}
                                {% set result = result_item['object'] %}
                                {% set type = result_item['type'] %}
                                <li class="search-result-item">
                                    <h1><a href="{{ portal_path(result) }}">{{ result.title }}</a></h1>
                                    <div class="search-result-meta">
                                        {% set cats = get_secure_content_cats(result) %}
                                        {% if cats|length > 0 %}
                                        <i class="fas fa-tags"></i>
                                        {% for cat in cats %}
                                            <a href="{{ portal_path(cat) }}">
                                                {% if cat.title is defined %}
                                                    {{ cat.title }}
                                                {% elseif cat.name is defined %}
                                                    {{ cat.name }}
                                                {% else %}
                                                    {{ portal_path(cat) }}
                                                {% endif %}
                                            </a>
                                            {% if not loop.last %}
                                                <i class="fas fa-angle-right"></i>
                                            {% endif %}
                                        {% endfor %}
                                        {% endif %}
                                        {% if result.date_published is not null %}
                                            <hr>
                                            <span>{{ date(result.date_published) }}</span>
                                        {% endif %}
                                        {% if result.calc_num_comments > 0 %}
                                            <hr>
                                            <a href="{{ portal_path(result) }}#comments">
                                                {{ phrase('helpcenter.general.comments_count', { count: result.calc_num_comments }) }}
                                            </a>
                                        {% endif %}
                                    </div>
                                    <p>{{ result.search_summary }}</p>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                    {% if pageinfo is not null and pager.haveToPaginate %}
                        {{ pagerfanta(pager) }}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock page_body %}
