{% extends 'Theme::layout.html.twig' %}
{% import 'Theme:Tickets:macros.html.twig' as macros %}
{% set main_class = 'dp-po-ticket-view' %}
{% block page_content %}
    
    <div class="dp-po">
        <main class="dp-po-main dp-po-ticket-view">
            <div class="container">
                <div class="row">
                    <div class="col-sm-9">
                        <div class="dp-po-title">
                            <img class="dp-po-title-svg" src="https://deskpro.github.io/portal-components/portal-style/static/img/page-icons/tickets.svg">
                            <h2 class="dp-po-title-text">{{ ticket.subject }}</h2>
                        </div>
                        <div class="row align-items-center">
                            <div class="col-sm-10">
                                <div class="dp-po-post-info">
                                    <ul class="dp-po-post-info-list">
                                        {% if ticket.isAwaitingUser() %}
                                            {# AWAITING USER #}
                                            <li class="dp-po-post-info-item">
                                                {{ phrase('portal.tickets.view_awaiting_user') }}
                                                <a href="#ticket-reply-form">
                                                    {{ phrase('portal.tickets.view_scroll_reply') }}
                                                </a>
                                            </li>
                                        {% elseif ticket.isAwaitingAgent() %}
                                            <li class="dp-po-post-info-item">
                                                {# only shows this if its been more than 10 minutes since the last message was posted #}
                                                {# to avoid "your last message was 1 second ago" after every reply #}
                                                {% if ticket.date_last_user_reply and ticket.messages|length > 1 and last_user_reply_in_seconds > 600 %}
                                                    {{ phrase('portal.tickets.view_last_message', { ago: date_ago(ticket.date_last_user_reply, null, false) }) }}
                                                    {# similarly, only show the "created ago" message if it has been more than 10 mins #}
                                                {% elseif created_in_seconds > 600 %}
                                                    {{ phrase('portal.tickets.view_you_created', { ago: date_ago(ticket.date_created, null, false) }) }}
                                                {% endif %}
                                            </li>
                                            {% if not ticket.date_last_agent_reply %}
                                                <li class="dp-po-post-info-item">
                                                    {{ phrase('portal.tickets.view_will_notify_you') }}
                                                </li>
                                            {% endif %}
                                        {% endif %}
                                    </ul>
                                </div>
                            </div>
                            <div class="col-sm-2">
                            
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-3">
                    
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-9">
                        {% include "Theme:Tickets:timeline/timeline.html.twig" %}
                        {% block page_specific_content %}
                        {% endblock page_specific_content %}
                        </div>
                    <div class="col-sm-3">
                        {{ block('page_sidebar') }}
                    </div>
                </div>
            </div>
        </main>
    </div>
{% endblock page_content %}


{% block ticket_attachment %}
    <div class="dpx-attachment">
        <a href="{{ attachment.download_url }}?dl=1"
           class="dp-po-chat-attachments-link {% if attachment.is_image %} dpx-attachment-full-image{% else %}dpx-attachment-file-icon{% endif %}"
           {% if not attachment.is_image %}data-content-type="{{ attachment.content_type }}"{% endif %}
        >
            
            {% if attachment.is_image %}
                <img class="thumbnail" src="{{ attachment.download_url }}" />
            {% endif %}
            {{ attachment.filename }} <span>({{ attachment.filesize_readable }})</span>
        </a>
    </div>
{% endblock %}

{% block page_sidebar %}
    <div class="dp-po-post-meta">
        <h3 class="dp-po-post-meta-title">{{ phrase('portal.tickets.view_assigned_agent') }}</h3>
        <p>
            {% include "Theme:Tickets:embeds/person_sidebar.html.twig" with {person: ticket.agent, avatar_link: false }%}
        </p>
    
        <h3 class="dp-po-post-meta-title">{{ phrase('portal.tickets.view_opened_by') }}</h3>
        <p>
            {% include "Theme:Tickets:embeds/person_sidebar.html.twig" with {person: ticket.person, avatar_link: false }%}
        </p>
        
        <h3 class="dp-po-post-meta-title">{{ phrase('portal.tickets.view_participants' ) }}</h3>
        <p>
        {% for participant in ticket.getCcs() %}
            <div class="dp-po-avatar dp-po-avatar-round">
                {% if participant.id %}
                    {% include "Theme:Tickets:embeds/person_sidebar.html.twig" with {person: participant.person, avatar_link: path('portal_tickets_cc_remove', { ticket_ref: ticket_public_id(ticket), cc_id: participant.id }) }%}
                {% else %}
                    <div class="dp-po-avatar dp-po-avatar-round">
                        {{ phrase('portal.tickets.no_participants') }}
                    </div>
                {% endif %}
            </div>
        {% endfor %}
        {% block page_sidebar_add_participant_form %}
            <a href="#" class="sidebar-person add-person clickaway-dropdown" data-clickaway-target="add-cc-user-popover">
                <span class="agent-avatar agent-avatar-mid"><i class="fas fa-plus"></i></span>
                <span class="avatar-meta">
                                                          <span class="primary single">
                                                              {{ phrase('portal.tickets.view_btn_add_cc') }}
                                                          </span>
                                                        </span>
            </a>
        
            <div class="add-cc-user-popover" id="add-cc-user-popover" style="display: none;">
                <form action="{{ portal_path(ticket, 'add-cc') }}" method="POST">
                
                    <div class="column-full">
                        <div>
                            <div class="bucket">
                                <label class="title">{{ phrase('portal.forms.label_name') }}: *</label>
                                <input placeholder="{{ phrase('portal.tickets.view_label_your_name_placeholder') }}" name="name" type="text" required>
                            </div>
                        
                            <div class="bucket">
                                <label class="title">{{ phrase('portal.forms.label_email') }}: *</label>
                                <input name="email" placeholder="{{ phrase('portal.tickets.view_label_your_email_placeholder') }}" type="text" required>
                            </div>
                        
                            <div class="bucket">
                                <input type="submit" value="{{ phrase('portal.tickets.view_btn_add_to_ticket') }}">
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        {% endblock page_sidebar_add_participant_form %}
        </p>
    
        <h3 class="dp-po-post-meta-title">{{ phrase('portal.tickets.ticket-ref') }}</h3>
        <p>
            {{ ticket_public_id(ticket) }}
            <div class="item-clear"></div>
        </p>
    </div>
    
    {% if ticket_view.getAttachments()|length > 0 %}
    <div class="dp-po-sidebar dp-po-chat-attachments">
        <h3 class="dp-po-sidebar-title">{{ phrase('portal.tickets.view_media') }}</h3>
        <ul class="dp-po-chat-attachments-list">
            {% for attachment in ticket_view.getAttachments() %}
                <li class="dp-po-chat-attachments-item">
                    {{ block('ticket_attachment') }}
                </li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}
    
    
    {% if ticket_view.hasAnyVisibleProperties() %}
    <div class="dp-po-post-meta">
        {% if can_edit and ticket.isOpen() and not edit_page %}
        <p>
            <a href="{{ portal_path(ticket, 'edit') }}" class="sidebar-edit">{{ phrase('portal.tickets.view_btn_edit') }} <i class="fas fa-edit"></i></a>
        </p>
        {% endif %}
    
        {% for property in ticket_view.properties %}
            {% set propValue = property.value is iterable ? property.value : property.value|smart_wrap(35) %}
            {% if property.isVisible %}
                <h3 class="dp-po-post-meta-title">{{ property.label }}</h3>
                {% if property.type == 'url' %}
                    <p><a href="{{ propValue }}" target="_blank">{{ propValue }}</a></p>
                {% elseif property.type == 'file' %}
                    {% for file in propValue %}
                        <div>
                            <a href="{{ file.downloadUrl }}{{ file.is_image ? '' : '?dl=1' }}" target="_blank">
                                {{ content_icon(file) }}
                                {{ file.filename }}
                                ({{ file.readableFilesize }})
                            </a>
                        </div>
                    {% endfor %}
                {% elseif property.type == 'javascript' %}
                    <p>{{ propValue }}</p>
                {% elseif property.isLinkify %}
                    <p>{{ propValue|safe_link_urls }}</p>
                {% else %}
                    <p>{{ propValue }}</p>
                {% endif %}
            {% endif %}
        {% endfor %}
    </div>
    {% endif %}
    
    {% if not ticket_view.hasAnyVisibleProperties() %}
        {% if can_edit and ticket.isOpen() and not edit_page %}
            <div class="dp-po-post-meta">
                <p>
                    <a href="{{ portal_path(ticket, 'edit') }}" class="ticket-sidebar-button ">{{ phrase('portal.tickets.view_btn_edit_full') }}</a>
                </p>
            </div>
        {% endif %}
    {% endif %}



{% endblock page_sidebar %}

{% block doc_end %}
    <script type="text/javascript">
        window.DP_DISMISS_ALERTS = window.DP_DISMISS_ALERTS || [];
        window.DP_DISMISS_ALERTS.push({
            alertId: '{{ portal_path(ticket) }}',
            alertVersion: {{ "now"|date('U') }}
        });
    </script>
{% endblock %}
