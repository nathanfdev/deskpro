{% extends 'Theme::layout.html.twig' %}
{% import 'Theme:Tickets:macros.html.twig' as macros %}
{% set main_class = 'dp-po-ticket-view' %}
{% block page_content %}
    <div class="dp-po">
        <main class="dp-po-main dp-po-ticket-view">
            <div class="container">
                <div class="row">
                    <div class="col-sm-9">
                        <div class="row">
                            <div class="col-sm-10">
                                <div class="dp-po-title">
                                    <img class="dp-po-title-svg" src="{{ asset('img/page-icons/tickets.svg', 'help_center') }}">
                                    <h1 class="dp-po-title-text">{{ ticket.subject }}</h1>
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <div class="dp-po-post-extra">
                                    <ul class="dp-po-post-extra-list">
                                        <li class="dp-po-post-extra-item">
                                            <a href="javascript:window.print();" class="dp-po-post-extra-link" aria-label="{{ phrase('helpcenter.general.print') }}"><i class="dp-po-icon fal fa-print"></i></a>
                                        </li>
                                        <li class="dp-po-post-extra-item">
                                            <a href="{{ path('portal_tickets_pdf', {ticketRef: ticket.ref }) }}" class="dp-po-post-extra-link" aria-label="{{ phrase('helpcenter.guides.download_pdf') }}"><i class="dp-po-icon fal fa-file-pdf"></i></a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-3">
                        {% block close_ticket %}
                            {% if can_edit and ticket.isOpen() %}
                                <div class="dp-po-ticket-close">
                                    <a href="#" class="dp-po-ticket-close-btn" data-toggle="modal" data-target="#closeConfirm">
                                        <span class="fa-layers">
                                          <i class="dp-po-icon fad fa-envelope"></i>
                                          <i class="dp-po-icon fa-inverse fas fa-circle" data-fa-transform="shrink-8"></i>
                                          <i class="dp-po-icon fas fa-times" data-fa-transform="shrink-10"></i>
                                        </span>
                                        {{ phrase('helpcenter.tickets.close_ticket') }}
                                    </a>
                                    <div class="modal fade dp-po-ticket-modal" id="closeConfirm" tabindex="-1" role="dialog" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered" role="document">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">{{ phrase('helpcenter.tickets.resolve_ticket_title') }}</h5>
                                                </div>
                                                <div class="modal-body">
                                                    <p>{{ phrase('helpcenter.tickets.resolve_ticket_explain') }}</p>
                                                </div>
                                                <div class="modal-footer">
                                                    {{ form_start(csrf_form) }}
                                                        <button type="button" id="closeTicketBtn" data-url="{{ path('portal_tickets_resolve', { ticket_ref: ticket.ref }) }}" class="btn btn-primary">{{ phrase('helpcenter.tickets.resolve_my_ticket_action') }}</button>
                                                        <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">{{ phrase('helpcenter.general.cancel_action') }}</button>
                                                        {{ form_rest(csrf_form) }}
                                                    {{ form_end(csrf_form) }}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% elseif not ticket.isOpen() %}
                                <div class="dp-po-ticket-close closed">
                                    <a class="dp-po-ticket-close-btn">
                                        <span class="fa-layers">
                                          <i class="dp-po-icon fad fa-envelope"></i>
                                          <i class="dp-po-icon fa-inverse fas fa-circle" data-fa-transform="shrink-8"></i>
                                          <i class="dp-po-icon fas fa-times" data-fa-transform="shrink-10"></i>
                                        </span>
                                        {{ phrase('helpcenter.tickets.ticket_closed') }}
                                    </a>
                                </div>
                            {% endif %}
                        {% endblock %}
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-9">
                        {% block page_specific_content %}
                        {% endblock page_specific_content %}
                        </div>
                    <div class="col-sm-3 dp-po-sticky">
                        {{ block('page_sidebar') }}
                    </div>
                </div>
            </div>
        </main>
    </div>
{% endblock page_content %}


{% block ticket_attachment %}
    <a href="{{ attachment.blob.download_url }}?dl=1"
       class="dp-po-post-attachments-link"
       {% if not attachment.blob.is_image %}data-content-type="{{ attachment.blob.content_type }}"{% endif %}
    >
        {{ attachment.blob.filename }} <span>({{ attachment.blob.readable_filesize }})</span> <i class="dp-po-icon fal fa-arrow-to-bottom"></i>
    </a>
{% endblock %}

{% block page_sidebar %}
    <div class="dp-po-sidebar dp-po-ticket-status">
      <h3 class="dp-po-sidebar-title">{{ phrase('helpcenter.tickets.ticket_status') }}</h3>
      {% set class = ticket.isResolved() ? 'badge-success' : 'badge-warning' %}
      {% set icon = ticket.isResolved() == 'resolved' ? 'fa-check' : 'fa-clock' %}
      <span class="badge {{ class }} badge-icon"><i class="dp-po-icon far {{ icon }}"></i> {{ ticket.ticket_status.title }}</span>
    </div>

    <div class="dp-po-ticket-meta">
        <h3 class="dp-po-ticket-meta-title">{{ phrase('helpcenter.tickets.view_ticket_id') }}</h3>
        <p>
            {{ ticket_public_id(ticket) }}
            <div class="item-clear"></div>
        </p>

        {% if (ticket.person) %}
            <h3 class="dp-po-ticket-meta-title">{{ phrase('helpcenter.tickets.view_requester') }}</h3>
            {% include 'Theme:Tickets:embeds/person_sidebar.html.twig' with {person: ticket.person, avatar_link: false }%}
        {% endif %}

        {% if (ticket.agent) %}
            <h3 class="dp-po-ticket-meta-title">{{ phrase('helpcenter.tickets.view_assigned_agent') }}</h3>
            {% include 'Theme:Tickets:embeds/person_sidebar.html.twig' with {person: ticket.agent, avatar_link: false }%}
        {% endif %}

        <div class="dp-po-ticket-meta-cc">
            <h3 class="dp-po-ticket-meta-title">{{ phrase('helpcenter.tickets.view_participants', {count: ticket.getCcs()|length} ) }}</h3>
            <ul class="dp-po-ticket-meta-cc-list">
                {% if ticket.getCcs()|length > 0 %}
                    {% for participant in ticket.getCcs() %}
                        {% if participant.id %}
                            <li class="dp-po-ticket-meta-cc-item">
                                {% include 'Theme:Tickets:embeds/ticket_cc_sidebar.html.twig' with {person: participant.person, avatar_link: path('portal_tickets_cc_remove', { ticket_ref: ticket_public_id(ticket), cc_id: participant.id }) }%}
                            </li>
                        {% endif %}
                    {% endfor %}
                {% else %}
                    <li class="dp-po-ticket-meta-cc-item">
                        <span class="dp-po-ticket-meta-cc-name">{{ phrase('helpcenter.tickets.no_participants') }}</span>
                    </li>
                {% endif %}
            </ul>

            {% block page_sidebar_add_participant_form %}
                <a href="#" data-clickaway-target="add-cc-user-popover" class="dp-po-ticket-meta-cc-link clickaway-dropdown">{{ phrase('helpcenter.tickets.view_btn_add_cc') }}</a>
                <div class="dp-po-ticket-meta-cc-form" id="add-cc-user-popover" style="display: none;">
                    <form action="{{ portal_path(ticket, 'add-cc') }}" method="POST" class="do-po-form">

                        <div class="form-group">
                            <input type="text" name="ticket_add_cc[name]" required class="form-control" placeholder="{{ phrase('helpcenter.tickets.view_label_your_name_placeholder') }}" />
                        </div>
                        <div class="form-group">
                            <input type="text" name="ticket_add_cc[email]" required class="form-control"  placeholder="{{ phrase('helpcenter.tickets.view_label_your_email_placeholder') }}" />
                        </div>

                        {% for widget in add_cc_form.children if widget.vars.name in ['_token', '_dp_csrf_token'] %}
                            {{ form_row(widget) }}
                        {% endfor %}

                        <button type="submit" class="btn btn-primary">{{ phrase('helpcenter.tickets.view_btn_add_to_ticket') }}</button>
                    </form>
                </div>
            {% endblock page_sidebar_add_participant_form %}
        </div>

        {% if ticket.isAwaitingUser() %}
        {# AWAITING USER #}
            <p>
                <a href="#ticket-reply-form">
                    {{ phrase('helpcenter.tickets.view_scroll_reply') }}
                </a>
            </p>
        {% elseif ticket.isAwaitingAgent() %}
            {# only shows this if its been more than 10 minutes since the last message was posted #}
            {# to avoid "your last message was 1 second ago" after every reply #}
            {% if ticket.date_last_user_reply and ticket.messages|length > 1 and last_user_reply_in_seconds > 600 %}
                <h3 class="dp-po-ticket-meta-title">{{ phrase('helpcenter.tickets.view_last_message') }}</h3>
                <p>{{ date_ago(ticket.date_last_user_reply, null, false) }}</p>
                {# similarly, only show the "created ago" message if it has been more than 10 mins #}
            {% elseif created_in_seconds > 600 %}
                <h3 class="dp-po-ticket-meta-title">{{ phrase('helpcenter.tickets.view_you_created') }}</h3>
                <p>{{ date_ago(ticket.date_created, null, false) }}</p>
            {% endif %}
        {% endif %}
    </div>

    {% if ticket_view.getAttachments()|length > 0 %}
    <div class="dp-po-sidebar dp-po-post-attachments">
        <h3 class="dp-po-sidebar-title">{{ phrase('helpcenter.general.attachments') }}</h3>
        <ul class="dp-po-post-attachments-list">
            {% for attachment in ticket_view.getAttachments() %}
                <li class="dp-po-post-attachments-item">
                    {{ block('ticket_attachment') }}
                </li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}


    {% if ticket_view.hasAnyVisibleProperties() %}
    <div class="dp-po-sidebar dp-po-ticket-meta">
        <h3 class="dp-po-sidebar-title">{{ phrase('helpcenter.tickets.ticket_properties') }}</h3>
        {% if can_edit and ticket.isOpen() and not edit_page %}
        <p>
            <a href="{{ portal_path(ticket, 'edit') }}" class="dp-po-sidebar-edit">{{ phrase('helpcenter.tickets.view_btn_edit') }} <i class="fas fa-pen"></i></a>
        </p>
        {% endif %}

        {% for property in ticket_view.properties %}
            {% set propValue = property.value is iterable ? property.value : property.value|smart_wrap(35) %}
            {% if property.isVisible and propValue %}
                <h3 class="dp-po-ticket-meta-title">{{ property.label }}</h3>
                {% if property.type == 'url' %}
                    <p><a href="{{ propValue }}" target="_blank">{{ propValue }}</a></p>
                {% elseif property.type == 'file' %}
                    {% for file in propValue %}
                        <div>
                            <a href="{{ file.downloadUrl }}{{ file.is_image ? '' : '?dl=1' }}" target="_blank">
                                {{ content_icon(file) }}
                                {{ file.filename }}
                                ({{ file.readableFilesize }})
                            </a>
                        </div>
                    {% endfor %}
                {% elseif property.type == 'javascript' %}
                    <p>{{ propValue }}</p>
                {% elseif property.isLinkify %}
                    <p>{{ propValue|safe_link_urls }}</p>
                {% else %}
                    <p>{{ propValue }}</p>
                {% endif %}
            {% endif %}
        {% endfor %}
    </div>
    {% endif %}

    {% if not ticket_view.hasAnyVisibleProperties() %}
        {% if can_edit and ticket.isOpen() and not edit_page %}
            <div class="dp-po-ticket-meta">
                <p>
                    <a href="{{ portal_path(ticket, 'edit') }}" class="ticket-sidebar-button ">{{ phrase('helpcenter.tickets.view_btn_edit_full') }}</a>
                </p>
            </div>
        {% endif %}
    {% endif %}



{% endblock page_sidebar %}

{% block doc_end %}
    <script type="text/javascript">
        window.DP_DISMISS_ALERTS = window.DP_DISMISS_ALERTS || [];
        window.DP_DISMISS_ALERTS.push({
            alertId: '{{ portal_path(ticket) }}',
            alertVersion: {{ "now"|date('U') }}
        });
    </script>
{% endblock %}
