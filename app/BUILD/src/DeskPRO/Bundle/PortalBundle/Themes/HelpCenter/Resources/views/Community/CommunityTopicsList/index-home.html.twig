<div class="row">
    <div class="col-sm">
        <div class="dp-po-title">
            <img class="dp-po-title-svg icon-svg" src="{{ asset('img/page-icons/community.svg', 'help_center') }}">
            <h1 class="dp-po-title-text">{{ phrase('helpcenter.community.section_title') }}</h1>
        </div>
    </div>
    {% if is_community_enabled %}
        <div class="col-sm-auto">
            <a href="{{ path('portal_members') }}">
                <img class="dp-po-title-svg" src="{{ asset('img/page-icons/direct-message.svg', 'help_center') }}">
                {{ phrase('helpcenter.members.title') }}
            </a>
        </div>
    {% endif %}
    <div class="col-sm-auto">
        <div class="d-none d-sm-block">
            {% include 'Theme:Community:CommunityTopicsList/create-topic-button.html.twig' with {
                community_forums: community_forums,
            } %}
        </div>
    </div>
    <div class="col-sm-auto">
        <div class="d-none d-sm-block">
            {% if brand_setting('user.community_subscriptions') %}
                {% include 'Theme:PublishCommon:subscribe-button.html.twig' with {
                    subscriptionInfo: [
                        {
                            toggleUrl: path('portal_community_root_toggle_subscription', {target: path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params'))}),
                            icon: 'fal fa-file-spreadsheet',
                            title: phrase('helpcenter.community.section_title'),
                            active: is_subscribed
                        }
                    ]
                } %}
            {% endif %}
        </div>
    </div>
</div>
<div class="d-block d-sm-none">
    <div class="dp-po-post-mobile-area">
        {% if brand_setting('user.community_subscriptions') %}
            {% include 'Theme:PublishCommon:subscribe-button.html.twig' with {
                buttonId: 'subscribeDropdownMenuMobile',
                subscriptionInfo: [
                    {
                        toggleUrl: path('portal_community_root_toggle_subscription', {target: path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params'))}),
                        icon: 'fal fa-file-spreadsheet',
                        title: phrase('helpcenter.community.section_title'),
                        active: is_subscribed
                    }
                ]
            } %}
        {% endif %}
        <div class="dp-po-community-create">
            {% include 'Theme:Community:CommunityTopicsList/create-topic-button.html.twig' with {
                community_forums: community_forums,
            } %}
        </div>
    </div>
</div>
<div class="row">
    <div class="col-sm-12">
        <div class="dp-po-community-row">
            <div class="dp-po-community-row-list">
                {% for forum in community_forums %}
                    {% set icon = forum.icon_property  %}
                    {% set splash = forum.splash_image_property  %}
                    <div class="dp-po-community-row-item {{ not splash ? 'dp-po-community-row-item-nocover' }}">
                        <div class="dp-po-community-row-left" style="{% if splash %}background: url('{{ get_splash_url(forum, 750) }}'); background-repeat: no-repeat; background-position: 0 0; background-size: cover;{% endif %}">
                            {% if icon %}
                                <div class="dp-po-community-row-icon">
                                    {{ render_icon_from(forum, {as_download_url: true, is_rounded: true}) }}
                                </div>
                            {% else %}
                                <div class="dp-po-community-row-icon" style="background-color: {{ forum.color | default('var(--brand-primary);') }};">
                                    <i class="dp-po-icon dp-po-icon-white fad fa-comments"></i>
                                </div>
                            {% endif %}
                            <h2 class="dp-po-community-row-title">{{ forum.title }}</h2>
                            <p class="dp-po-community-row-description">{{ forum.description }}</p>
                            <a href="{{ path('portal_community_browse', {filter_uri: "type-#{forum.id}"}) }}"
                               class="dp-po-community-row-btn">
                                {{ phrase('helpcenter.community.view_topics', {count: topic_count_per_forum[forum.id]}) }}
                            </a>
                        </div>
                        <div class="dp-po-community-row-right">
                            <div class="dp-po-community-row-activity">
                                <h3 class="dp-po-community-row-activity-heading">{{ phrase('helpcenter.community.recent_activity') }}</h3>
                                <ul class="dp-po-community-row-activity-list">
                                    {% for activity in latest_activity_per_forum[forum.id] %}
                                        <li class="dp-po-community-row-activity-item">
                                            <a href="{{ path('portal_community_topic_view', {slug: activity.topic.slug}) }}" class="dp-po-community-row-activity-link">
                                                {% if activity.comment %}
                                                    <div class="dp-po-avatar dp-po-avatar-round">
                                                        {{ hc_avatar(activity.comment.person) }}
                                                    </div>
                                                    <h4 class="dp-po-community-row-activity-title">
                                                        {{ activity.comment.content|truncate(80) }}
                                                    </h4>
                                                    <span class="dp-po-community-row-activity-time">
                                                        {{ date_ago(activity.comment.date_created) }}
                                                    </span>
                                                {% else %}
                                                    <div class="dp-po-avatar dp-po-avatar-round">
                                                        {{ hc_avatar(activity.topic.person) }}
                                                    </div>
                                                    <h4 class="dp-po-community-row-activity-title">
                                                        {{ activity.topic.content_plain|truncate(80) }}
                                                    </h4>
                                                    <span class="dp-po-community-row-activity-time">
                                                    {{ date_ago(activity.topic.date_created) }}
                                                </span>
                                                {% endif %}
                                            </a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
