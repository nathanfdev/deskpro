<img src="{{ avatar_url(person, 30) }}" />
<div class="dp-po-ticket-meta-cc-title">
	<span class="dp-po-ticket-meta-cc-name">{{person.display_name_user}}</span>
	{% if person.getEmailAddress() %}
		<span class="dp-po-ticket-meta-cc-email">{{person.getEmailAddress()}}</span>
	{% endif %}
</div>
{% if avatar_link %}
	<a href="{{ avatar_link }}" class="dp-po-ticket-meta-cc-remove post-link"><i class="far fa-times-circle"></i></a>
{% endif %}
