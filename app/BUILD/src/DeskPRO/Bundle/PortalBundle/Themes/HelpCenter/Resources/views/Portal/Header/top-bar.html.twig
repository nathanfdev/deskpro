<div class="dp-po">
    <header class="dp-po-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-3 col-sm-3">
                    <div class="dp-po-brand-left">
                        <div class="dp-po-homelink">
                            {% if portal_custom_logo() %}
                                <a href="{{ brand_setting('core.site_url') | default(path('portal_home')) }}">
                                    <span class="dp-po-logo">
                                        <img alt="{{ brand_setting('core.deskpro_name')|e }}" src="{{ portal_custom_logo() }}" />
                                    </span>
                                </a>
                            {% endif %}
                            <a href="{{ path('portal_home') }}">
                                <span class="dp-po-brand-name">{{ brand_setting('core.deskpro_name')|e }}</span>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-9 col-sm-9">
                    <div class="dp-po-header-right">
                        {% include 'Theme:Common:agent_bar.html.twig' %}
                        <div class="dp-po-language" id="hc-language-changer">
                            <a class="dp-po-language-link" href="">
                                <img src="{{ asset_data_url('images/flags/locale_en-US.png', 'legacy_web') }}" alt=""> English
                                <i class="dp-po-icon far fa-angle-down"></i>
                            </a>
                        </div>
                        <div class="dp-po-header-button">
                            <a href="{{ path('portal_new_ticket') }}" class="btn btn-primary" title="{{ phrase('helpcenter.general.nav-newticket') }}">{{ phrase('helpcenter.general.nav-newticket') }}</a>
                        </div>
                        {% include 'Theme:Portal:Header/user-menu.html.twig' %}
                    </div>

                </div>
            </div>
        </div>
    </header>
</div>
