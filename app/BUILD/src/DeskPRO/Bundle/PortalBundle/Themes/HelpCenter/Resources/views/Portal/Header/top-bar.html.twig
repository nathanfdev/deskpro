<div class="dp-po">
    <header class="dp-po-header">
        <div class="container-fluid">
            <div class="d-flex flex-row">
                <div>
                    <div class="dp-po-brand-left">
                        <div class="dp-po-homelink d-none d-sm-block">
                            {% if portal_custom_logo() %}
                                <a href="{{ brand_setting('core.site_url') | default(path('portal_home')) }}">
                                    <span class="dp-po-logo">
                                        <img alt="{{ brand_setting('core.deskpro_name')|e }}" src="{{ portal_custom_logo() }}" />
                                    </span>
                                </a>
                            {% endif %}
                            <a href="{{ path('portal_home') }}">
                                <span class="dp-po-brand-name text-truncate">{{ brand_setting('core.deskpro_name')|e }}</span>
                            </a>
                        </div>
                        <div class="dp-po-homelink d-block d-sm-none">
                            <a href="{{ brand_setting('core.site_url') | default(path('portal_home')) }}">
                                {% if portal_custom_favicon() %}
                                    <img alt="{{ brand_setting('core.deskpro_name')|e }}" src="{{ portal_custom_favicon().url }}" class="logo" />
                                {% elseif portal_custom_logo() %}
                                    <img alt="{{ brand_setting('core.deskpro_name')|e }}" src="{{ portal_custom_logo() }}" />
                                {% endif %}
                            </a>
                        </div>
                    </div>
                </div>
                <div class="flex-nowrap ml-auto">
                    <div class="dp-po-header-right">
                        {% include 'Theme:Common:agent_bar.html.twig' %}
                        {% if enabled_languages()| length > 1 %}
                        <div class="dp-po-language">
                            <a href="#" class="dp-po-language-link" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <img src="{{ asset_data_url('images/flags/' ~ current_language().flag_image, 'legacy_web') }}" alt=""> <span class="dp-po-language-link-text">{{ current_language().title }}</span>
                                <i class="dp-po-icon far fa-angle-down"></i>
                            </a>
                            <div class="dropdown-menu dropdown-menu-left">
                                {% for language in enabled_languages() %}
                                    {% if language.sys_name != current_language().sys_name %}
                                        <a href="{{ path('portal_change_language', { lang_code: language.locale }) }}" class="dropdown-item">
                                            <img class="dp-po-icon" src="{{ asset_data_url('images/flags/' ~ language.flag_image, 'legacy_web') }}" alt="">
                                            <span class="text">{{ language.title }}</span>
                                        </a>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </div>
                        {% endif %}
                        <div class="dp-po-header-button">
                            <a href="{{ path('portal_new_ticket') }}" class="btn btn-primary">{{ phrase('helpcenter.general.nav_newticket') }}</a>
                        </div>
                        {% include 'Theme:Portal:Header/user-menu.html.twig' %}
                    </div>

                </div>
            </div>
        </div>
    </header>
</div>
