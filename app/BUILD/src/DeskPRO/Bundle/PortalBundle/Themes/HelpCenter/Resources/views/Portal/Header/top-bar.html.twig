<div class="dp-po">
    <header class="dp-po-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <div class="dp-po-brand-left">
                        <a href="{{ path('portal_home') }}" class="dp-po-homelink">
                            {% if portal_custom_logo() %}
                                <span class="dp-po-logo">
                                    <img alt="{{ brand_setting('core.deskpro_name')|e }}" src="{{ portal_custom_logo() }}" />
                                </span>
                            {% endif %}
                            <span class="dp-po-brand-name">{{ brand_setting('core.deskpro_name')|e }}</span>
                        </a>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="dp-po-header-right">
                        <div class="dp-po-language">
                            <a class="dp-po-language-link" href="" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <img src="https://deskpro.github.io/portal-components/portal-style/static/img/docs/flag-uk.jpg" /> English
                                <i class="dp-po-icon far fa-angle-down"></i>
                            </a>
                            <div class="dropdown-menu dropdown-menu-left">
                                <a class="dropdown-item" href="#">
                                    <img class="dp-po-icon" src="https://deskpro.github.io/portal-components/portal-style/static/img/docs/flag-germany.jpg" />
                                    German
                                </a>
                                <a class="dropdown-item" href="#">
                                    <img class="dp-po-icon" src="https://deskpro.github.io/portal-components/portal-style/static/img/docs/flag-france.jpg" />
                                    French
                                </a>
                            </div>
                        </div>
                        <div class="dp-po-header-button">
                            <a href="{{ path('portal_new_ticket') }}" class="btn btn-primary" title="{{ phrase('portal.general.nav-newticket') }}">{{ phrase('portal.general.nav-newticket') }}</a>
                        </div>
                        <div class="dp-po-user">
                            <a href="javascript:void(0)" class="dp-po-user-login" data-toggle="dropdown" aria-haspopup="true"
                               aria-expanded="false">Login</a>
                            <div class="dropdown-menu dropdown-menu-right dp-po-user-dropdown">
                                <h4 class="dropdown-item-text dp-po-user-dropdown-title">New to Deskpro? <a href="">Register for an
                                        account</a></h4>
                                <%- include('_form-login.ejs'); %>
                                <%- include('_form-login-social.ejs'); %>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </header>
</div>
