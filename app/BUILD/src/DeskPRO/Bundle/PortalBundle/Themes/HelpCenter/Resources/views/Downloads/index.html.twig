{% extends 'Theme::layout.html.twig' %}

{% block page_content %}
<div class="dp-po">
    <main class="dp-po-main dp-po-download-home">
        <div class="container">
            <div class="row">
                <div class="col-sm-7 col-centered">
                    <div class="dp-po-title">
                        <img class="dp-po-title-svg" src="https://deskpro.github.io/portal-components/portal-style/static/img/page-icons/download.svg">
                        <h1 class="dp-po-title-text">{{ phrase('portal.downloads.section-title') }}</h1>
                    </div>
                    <div class="dp-po-block">
                        {% include 'Theme:Downloads:CategoryList/simple.html.twig' with {
                            category_children: helpcenter.getDownloadsCategories({})
                        } %}
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
{% endblock page_content %}
