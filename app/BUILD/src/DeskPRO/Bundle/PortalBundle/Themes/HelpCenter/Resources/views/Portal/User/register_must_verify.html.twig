{% extends 'Theme::layout.html.twig' %}

{% block page_content %}
    <div class="dp-po">
        <main class="dp-po-main dp-po-account-register">
            <div class="container">
                <div class="row">
                    <div class="col-sm-7 col-centered">
                        <div class="dp-po-block">
                            <div class="dp-po-register-success">
                                <i class="dp-po-icon fal fa-user"></i>
                                <h2 class="dp-po-register-success-title">Thank you for registering</h2>
                                <p class="dp-po-register-success-msg">We’ve sent you an email to {{ email }}<br />Please validate
                                    your
                                    email address to access your support centre.</p>
                                <a href="{{ path('portal_user_profile_emails_resend_validation', { id: saved_form_id}) }}" class="dp-po-register-success-link">Resend registration email</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
{% endblock page_content %}
