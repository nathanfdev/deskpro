{% extends 'Theme::layout.html.twig' %}

{% block page_content %}
    <div class="dp-po">
        <main id="main" tabindex="-1" class="dp-po-main dp-po-account-register">
            <div class="container">
                <div class="row">
                    <div class="col-sm-7 col-centered">
                        <div class="dp-po-block">
                            <div class="dp-po-register-success">
                                <figure class="dp-po-icon">
                                    <i class="fal fa-user"></i>
                                </figure>
                                <h2 class="dp-po-register-success-title">{{ phrase('helpcenter.account.thank_you_for_registering') }}</h2>
                                <p class="dp-po-register-success-msg">
                                    {{ phrase('helpcenter.account.validation_email_sent', {email: email}) }}
                                </p>
                                <a href="{{ path('portal_user_profile_emails_resend_validation', { id: saved_form_id}) }}" class="dp-po-register-success-link post-link">
                                    {{ phrase('helpcenter.account.resend_registration_email') }}
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
{% endblock page_content %}
