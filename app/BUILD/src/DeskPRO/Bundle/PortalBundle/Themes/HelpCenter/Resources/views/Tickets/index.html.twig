{%- macro sort_link(ticket_table, label, sort_value) -%}
    {% set sort = ticket_table.ticketFilter.sort %}
    {% set sort_param = ticket_table.sortName %}
    {% set sort_dir = ticket_table.ticketFilter.sortDirection %}
    {% set sort_dir_param = ticket_table.sortDirectionName %}

    {% set queryParams = app.request.query.all|merge({(sort_param):sort_value}) %}
    {% set isActive = sort_value == sort %}
    {% if isActive %}
        {% set linkDir = sort_dir == 'desc' ? 'asc' : 'desc' %}
    {% else %}
        {% set linkDir = 'desc' %}
    {% endif %}
    {% set queryParams = app.request.query.all|merge({(sort_param):sort_value, (sort_dir_param):linkDir, type: ticket_table.getTicketType()}) %}
    {% set url = path(app.request.attributes.get('_route'), queryParams) %}
    {% set sort_icon = sort_dir == 'desc' ? '<i
        class="dp-po-icon far fa-long-arrow-up"></i>' : '<i
        class="dp-po-icon far fa-long-arrow-down"></i>' %}
    {{ label }}<a href="{{ url }}">{% if isActive %}<span>{{ sort_icon|raw }}</span>{% else %}<i
        class="dp-po-icon far fa-arrows-v"></i>{% endif %}</a>
{%- endmacro -%}

{%- macro col_header(ticket_table, col) -%}
    {% if col.id == 'department_subject' %}
        {{ _self.sort_link(
        ticket_table,
        phrase('portal.tickets.list_department'),
        'department'
        ) }}
        /
        {{ _self.sort_link(
        ticket_table,
        phrase('portal.tickets.list_subject'),
        'subject'
        ) }}
    {% else %}
        {% set make_link = true %}
        {% if col.id == 'agent' %}
            {% set label = phrase('portal.tickets.list_agent' ) %}
        {% elseif col.id == 'department' %}
            {% set label = phrase('portal.tickets.list_department') %}
        {% elseif col.id == 'subject' %}
            {% set label = phrase('portal.tickets.list_subject') %}
        {% elseif col.id == 'user' %}
            {% set label = phrase('portal.tickets.list_user') %}
        {% elseif col.id == 'date_activity' %}
            {% set label = phrase('portal.tickets.list_last_action') %}
        {% elseif col.id == 'date_created' %}
            {% set label = phrase('portal.tickets.list_date_created') %}
        {% elseif col.id == 'date_user' %}
            {% set label = phrase('portal.tickets.list_date_last_user') %}
        {% elseif col.id == 'date_agent' %}
            {% set label = phrase('portal.tickets.list_date_last_agent') %}
        {% else  %}
            {% set label = col.label %}
            {% set make_link = false %}
        {% endif %}
        {% if make_link %}
            {{ _self.sort_link(
            ticket_table,
            label,
            col.id
            ) }}
        {% else %}
            {{ label }}
        {% endif %}
    {% endif %}
{%- endmacro -%}

{%- macro col_data(ticket, ticket_view, ticket_exceprpt, ticket_table, col) -%}
    {% if col.id == 'department_subject' %}
        <span class="focus">[{{ ticket.department_or_default.user_title }}]</span>
        {{ ticket.subject }}
    {% elseif col.id == 'agent' %}
        {% if ticket.agent %}

            <span class="person">{{ ticket.agent.display_name_user }}</span>
        {% endif %}
    {% elseif col.id == 'department' %}
        {{ ticket.department_or_default.user_title }}
    {% elseif col.id == 'subject' %}
        {{ ticket.subject }}
    {% elseif col.id == 'user' %}
        {% if ticket.person %}
            <span class="person">{{ ticket.person.display_name_user }}</span>
        {% endif %}
    {% elseif col.id == 'date_activity' %}
        <span class="date">{{ date_ago(ticket.last_activity_date) }}</span>
    {% elseif col.id == 'date_created' %}
        <span class="date">{{ ticket.date_created|date }}</span>
    {% elseif col.id == 'date_user' %}
        {% if ticket.date_last_user_reply %}
            {% if ticket.person %}
                <img src="{{ avatar_url(ticket.person) }}" class="avatar">
                <span class="person">{{ ticket.person.display_name_user }}</span>
            {% endif %}
            <span class="date">{{ ticket.date_last_user_reply|date }}</span>
        {% endif %}
    {% elseif col.id == 'date_agent' %}
        {% if ticket.date_last_agent_reply %}
            {% if ticket.agent %}
                <img src="{{ avatar_url(ticket.agent) }}" class="avatar">
                <span class="person">{{ ticket.agent.display_name_user }}</span>
            {% endif %}
            <span class="date">{{ ticket.date_last_agent_reply|date }}</span>
        {% endif %}
    {% else  %}
        {% set property = ticket_view.getProperty(col.id) %}
        {% if property and property.isVisible() %}
            {% if property.value is iterable %}
                {% for item in property.value %}
                    <div>
                        {% if col.widgetType == 'file' %}
                            <a href="{{ item.downloadUrl }}{{ item.is_image ? '' : '?dl=1' }}" target="_blank">
                                {{ content_icon(item) }}
                                {{ item.filename }}
                                ({{ item.readableFilesize }})
                            </a>
                        {% else %}
                            {{ item }}
                        {% endif %}
                    </div>
                {% endfor %}
            {% else %}
                {{ property.value }}
            {% endif %}
        {% endif %}
    {% endif %}
{%- endmacro -%}

{%- macro col_td_class(ticket, ticket_view, ticket_table, col) -%}
    {%- if col.id in ['department_subject'] -%}
    {%- elseif col.id in ['department'] -%}
        info-block centered small
    {%- elseif col.id in ['subject'] -%}
        info-block left long
    {%- else -%}
        info-block
    {%- endif -%}
{%- endmacro -%}

{% macro tickets_table(ticket_table, id, type, with_search, search_query) %}
    {% if ticket_table.pager|length > 0 %}
        {% if with_search %}
            <div class="row">
                <div class="col-sm-4">
                    <div class="dp-po-ticketbadge dp-po-ticketbadge-{{ type }}">
                        <span class="dp-po-ticketbadge-number">{{ ticket_table.pager|length }}</span>{{ ticket_table.title }}
                    </div>
                </div>
                <div class="col-sm-7">
                    <form class="dp-po-ticket-search" method="get">
                        <input type="text" name="q" placeholder="{{ phrase('helpcenter.tickets.search-tickets') }}" value="{{ search_query }}"></input>
                        <button type="submit"> <i class="dp-po-icon far fa-search"></i></button>
                    </form>
                </div>
                <div class="col-sm-1 text-right">
                    <div class="dp-po-columnfilter">
                        <a href="javascript:void(0)" class="dp-po-columnfilter-link" data-toggle="dropdown"
                           aria-haspopup="true" aria-expanded="false"><i class="dp-po-icon far fa-ballot-check"></i></a>
                        <div class="dropdown-menu dropdown-menu-right dp-po-columnfilter-dropdown">
                            <ul class="dp-po-columnfilter-list">
                                <li class="dp-po-columnfilter-item">
                                    <div class="form-group dp-po-form-check">
                                        <input type="checkbox" class="form-check-input" id="idCheck">
                                        <label class="form-check-label" for="idCheck">ID</label>
                                    </div>
                                </li>
                                <li class="dp-po-columnfilter-item">
                                    <div class="form-group dp-po-form-check">
                                        <input type="checkbox" class="form-check-input" id="SubjectCheck">
                                        <label class="form-check-label" for="SubjectCheck">Subject</label>
                                    </div>
                                </li>
                                <li class="dp-po-columnfilter-item">
                                    <div class="form-group dp-po-form-check">
                                        <input type="checkbox" class="form-check-input" id="DepartmentCheck" checked>
                                        <label class="form-check-label" for="DepartmentCheck">Department</label>
                                    </div>
                                </li>
                                <li class="dp-po-columnfilter-item">
                                    <div class="form-group dp-po-form-check">
                                        <input type="checkbox" class="form-check-input" id="UserCheck">
                                        <label class="form-check-label" for="UserCheck">User</label>
                                    </div>
                                </li>
                                <li class="dp-po-columnfilter-item">
                                    <div class="form-group dp-po-form-check">
                                        <input type="checkbox" class="form-check-input" id="agentCheck">
                                        <label class="form-check-label" for="agentCheck">Assigned agent</label>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="dp-po-ticketbadge dp-po-ticketbadge-{{ type }}">
                <span class="dp-po-ticketbadge-number">{{ ticket_table.pager|length }}</span>{{ ticket_table.title }}
            </div>
        {% endif %}

        <div class="dp-po-table dp-po-table-col6 dp-po-table-ticket dp-po-table-ticket-{{ type }} mb-4">
            <div class="dp-po-table-row dp-po-table-row-head">
                <span class="dp-po-table-cell dp-po-table-cell-indicator"></span>
                <span class="dp-po-table-cell">{{ phrase('portal.tickets.list_ticket_ref') }}</span>
                {% for col in ticket_table.columns %}
                    <span class="dp-po-table-cell" data-col="{{ col.id }}"{% if not ticket_table.isActive(col)  %} style="display:none;"{% endif %}>
                        {{ _self.col_header(ticket_table, col) }}
                    </span>
                {% endfor %}
            </div>
            {% for ticket in ticket_table.pager %}
                {% set ticket_view = ticket_view(ticket) %}
                {% set ticket_exceprpt = ticket_exceprpts[ticket.id] is defined ? ticket_exceprpts[ticket.id] : null %}
                <div class="dp-po-table-row">
                    <span class="dp-po-table-cell dp-po-table-cell-indicator"><i class="dp-po-icon fas fa-circle"></i></span>
                    <span class="dp-po-table-cell">
                        <a href="{{ portal_path(ticket) }}" class="dp-po-table-cell-link">{{ ticket_public_id(ticket) }}</a>
                    </span>
                    {% for col in ticket_table.columns %}
                        <span class="dp-po-table-cell" data-col="{{ col.id }}"{% if not ticket_table.isActive(col) %} style="display:none;"{% endif %}>
                            <a href="" class="dp-po-table-cell-link">{{ _self.col_data(ticket, ticket_view, ticket_exceprpt, ticket_table, col) }}</a>
                        </span>
                    {% endfor %}
{#                                <span class="dp-po-table-cell dp-po-table-cell-ratingwrap">#}
{#                                    <div class="dp-po-table-cell-rating">#}
{#                                        <img class="dp-po-table-cell-rating-img" src="/portal-components/portal-style/static/img/docs/avatar.png">#}
{#                                        <!--<i class="dp-po-icon fal fa-smile"></i>-->#}
{#                                        <i class="dp-po-icon fal fa-frown"></i>#}
{#                                        <!--<i class="dp-po-icon fal fa-meh"></i>-->#}
{#                                    </div>#}
{#                                    <a href="" class="dp-po-table-cell-rating-link">Add</a>#}
{#                                </span>#}
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endmacro %}

