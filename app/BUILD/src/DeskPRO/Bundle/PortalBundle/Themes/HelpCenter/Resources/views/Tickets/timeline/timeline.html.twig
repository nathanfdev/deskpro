{% import 'Theme:Tickets:macros.html.twig' as macros %}
  {% for line in timeline_pager %}
    <div class="dp-po-ticket-block dp-po-ticket-block-{{ line.type == 'agent_message' ? 'their' : 'mine' }}">
      {% if line.type == 'ticket_created' %}
        <div class="dp-po-ticket-block dp-po-ticket-block-timeline">
          <div class="dp-po-avatar dp-po-avatar-round">
            {% include "Theme:Tickets:embeds/person_inline.html.twig" with {person: line.person, include_email: line.type == 'user_message'} %}
          </div>
          <div class="dp-po-ticket-block-status">
            {{ phrase('portal.tickets.timeline_opened') }}
            <span class="badge"><i class="dp-po-icon far fa-envelope-open"></i>{{ phrase('portal.tickets.timeline_opened') }}</span>
          </div>
          <div class="dp-po-time">
            <i class="dp-po-icon far fa-clock"></i>
            {{ line.datetime|date('day') }}
          </div>
        </div>
      {% elseif line.type == 'ticket_reopened' %}
        <div class="dp-po-ticket-block dp-po-ticket-block-timeline">
          <div class="dp-po-avatar dp-po-avatar-round">
            {% include "Theme:Tickets:embeds/person_inline.html.twig" with {person: line.person, include_email: line.type == 'user_message'} %}
          </div>
          <div class="dp-po-ticket-block-status">
            {{ phrase('portal.tickets.timeline_re_opened') }}
            <span class="badge"><i class="dp-po-icon far fa-envelope-open"></i>{{ phrase('portal.tickets.timeline_re_opened') }}</span>
          </div>
          <div class="dp-po-time">
            <i class="dp-po-icon far fa-clock"></i>
            {{ line.datetime|date('day') }}
          </div>
        </div>
      {% elseif line.type == 'ticket_closed' %}
        <div class="dp-po-ticket-block dp-po-ticket-block-timeline">
          <div class="dp-po-avatar dp-po-avatar-round">
            {% include "Theme:Tickets:embeds/person_inline.html.twig" with {person: line.person, include_email: line.type == 'user_message'} %}
          </div>
          <div class="dp-po-ticket-block-status">
            {{ phrase('portal.tickets.timeline_marked') }}
            <span class="badge"><i class="dp-po-icon far fa-check"></i>{{ phrase('portal.tickets.timeline_marked_resolved') }}</span>
          </div>
          <div class="dp-po-time">
            <i class="dp-po-icon far fa-clock"></i>
            {{ line.datetime|date('day') }}
          </div>
        </div>
      {% elseif line.type == 'agent_message' %}
        {% set msg = line.message %}
        {% include 'Theme:Tickets:timeline/agent_message.html.twig' %}
      {% elseif line.type == 'user_message' %}
        {% set msg = line.message %}
        {% include 'Theme:Tickets:timeline/user_message.html.twig' %}
      {% endif %}
    </div>
  {% endfor %}

