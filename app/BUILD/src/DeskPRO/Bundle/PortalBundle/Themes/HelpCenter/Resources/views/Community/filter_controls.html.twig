<script>
    window.community_FILTER_STATE = {{ filter_js|raw }};
</script>
<div class="community-filter">
    <ul class="flat-tabs">
        <li>
            <div class="quick-jump">
                <a href="{{ path('portal_community_browse', { filter_uri: 'all/' ~ (types ? 'type-' ~ types | join (',') : 'type-1,2,3') }) }}"
                        {% if status == 'all' %} class="active"{% endif %}>
                    {{ phrase('portal.community.filter_all_items') }}
                </a>
            </div>
        </li>

        <li>
            <div class="quick-jump">
                <a href="{{ path('portal_community_browse', { filter_uri: 'active/' ~ (types ? 'type-' ~ types | join (',') : 'type-1,2,3') }) }}"
                        {% if status == 'active' %} class="active"{% endif %}>
                    {{ phrase('portal.community.filter_open_items') }}
                </a>
            </div>
        </li>

        <li>
            <div class="quick-jump">
                <a href="{{ path('portal_community_browse', { filter_uri: 'closed/' ~ (types ? 'type-' ~ types | join (',') : 'type-1,2,3') }) }}"
                        {% if status == 'closed' %} class="active"{% endif %}>
                    {{ phrase('portal.community.filter_closed_items') }}
                </a>
            </div>
        </li>
    </ul>

    {% if community_channels is defined and community_channels|length > 0 %}
    <div>
        <ul class="slider-list">
            {% for type in community_channels %}
            <li>
                <div class="slider-panel">
                    {% if type.id in types or types is empty %}
                        <a href="{{ path('portal_community_browse', { filter_uri: status ~ '/type-' ~ type.id }) }}" class="slider">
                            <span class="slider-status">{{ phrase('portal.general.toggle_on') }}</span>
                            <span class="slider-icon"><i class="fas fa-check"></i></span>
                        </a>
                        <span class="slider-label">{{ object_phrase(type) }}</span>
                    {% else %}
                        <a href="{{ path('portal_community_browse', { filter_uri: status ~ '/type-' ~ type.id }) }}"
                           class="slider off">
                            <span class="slider-icon"><i class="fas fa-times"></i></span>
                            <span class="slider-status">{{ phrase('portal.general.toggle_off') }}</span>
                        </a>
                        <span class="slider-label">{{ object_phrase(type) }}</span>
                    {% endif %}
                </div>
            </li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}
</div>
