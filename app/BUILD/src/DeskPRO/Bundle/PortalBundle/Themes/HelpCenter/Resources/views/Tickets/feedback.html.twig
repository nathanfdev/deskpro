{% extends 'Theme::layout.html.twig' %}

{% block page_body %}
    <div class="ticket-success-blurb">
    <div class="icon-mark"></div>
    <h1>{{ phrase('helpcenter.tickets.rate_support') }}</h1>
      <span class="agent-avatar agent-avatar-mid"
      style="background-image: url({{ avatar_url(message.person, 36) }}); background-size: contain;"></span>
      <p>{{ phrase('helpcenter.tickets.rate-intro', {name: message.person.display_name_user, subject: ticket.subject}) }}</p>
    <div class="footer">
        <article class="news kb-article helpcenter-form padded">
            {% if not setrating %}
                {# this is shown when the user resolves a ticket #}
                <p>{{ phrase('helpcenter.tickets.rate-question') }}</p>
                <form class="form-ticket" action="{{ path('portal_tickets_feedback', {'ticket_ref': ticket.ref, 'auth': ticket.auth, 'message_id': message.id}) }}" method="post">
                    <div class="dp-choice-widget-group with-dpx">
                        <div class="radio-button dpx-radio-button" tabindex="0">
                            <input type="radio" id="feedback_rating_p" name="rating" value="1" {% if feedback.rating == 1 %}checked="checked"{% endif %} />
                            <label style="text-align: left" class="title" for="feedback_rating_p">{{ phrase('helpcenter.tickets.rate-positive') }}</label>
                        </div>
                        <div class="radio-button dpx-radio-button" tabindex="0">
                            <input id="feedback_rating_0" type="radio" name="rating" value="0" {% if feedback.rating == 0 %}checked="checked"{% endif %} />
                            <label class="title" style="text-align: left" for="feedback_rating_0">{{ phrase('helpcenter.tickets.rate-neutral') }}</label>
                        </div>
                        <div class="radio-button dpx-radio-button" tabindex="0">
                            <input type="radio" id="feedback_rating_n" name="rating" value="-1" {% if feedback.rating == -1 %}checked="checked"{% endif %} />
                            <label class="title" style="text-align: left" for="feedback_rating_n">{{ phrase('helpcenter.tickets.rate-negative') }}</label>
                        </div>
                    </div>
                    <textarea name="message" style="width: 520px; height: 60px;" placeholder="{{ phrase('helpcenter.tickets.feedback_message_leave_comment') }}">{{ feedback.message }}</textarea>
                    <br />
                    <button class="dp-btn dp-btn-primary" type="submit" style="margin-top: 10px;">{{ phrase('helpcenter.tickets.submit_feedback') }}</button>
                </form>
            {% else %}
                {# this is shown when clicking an email link, #}
                <p>{{ phrase('helpcenter.tickets.rate-thanks-vialink') }}</p>

                <form action="{{ path('portal_tickets_feedback', {'ticket_ref': ticket.ref, 'auth': ticket.auth, 'message_id': message.id}) }}" method="post">
                    <input type="hidden" name="rating" value="{{ feedback.rating }}" />
                    <textarea name="message" style="width: 520px; height: 60px;" placeholder="{{ phrase('helpcenter.tickets.feedback_message_leave_comment') }}">{{ feedback.message }}</textarea>

                    <br />
                    <button class="dp-btn dp-btn-primary" type="submit" style="margin-top: 10px;">{{ phrase('helpcenter.tickets.submit_feedback') }}</button>
                </form>
            {% endif %}
        </article>
    </div>
</div>






