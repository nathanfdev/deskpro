{% block custom_field_file_collection_widget %}
    <div class="form-group">
        <div class="with-dpx">
            <div
                class="dpx-custom-field-attach"
                data-multiple="{{ form.vars.multiple }}"
                data-max-file-size="{{ form.vars.max_file_size | filesize_display }}"
                data-extensions-limit-mode="{{ form.vars.extensions_limit_mode }}"
                data-must-extensions="{{ form.vars.must_extensions|join(',') }}"
                data-not-extensions="{{ form.vars.not_extensions|join(',') }}"
                data-restriction-set="{{ form.vars.restriction_set }}"
            >
                {% if prototype is defined %}
                    {%- set attr = attr|merge({'data-prototype': form_row(prototype), attachments: true }) -%}
                {% endif %}
                {{- block('form_widget') -}}
            </div>
        </div>
    </div>
{% endblock %}

{% block custom_field_file_widget %}
    {% if form.vars.data %}
    <div
            class="attach-row"
            data-blob-id="{{ form.vars.data.id }}"
            data-blob-auth="{{ form.vars.data.authcode }}"
            data-blob-filename="{{ form.vars.data.filename }}"
            data-blob-download-url="{{ form.vars.data.downloadUrl }}"
            data-blob-filesize="{{ form.vars.data.readableFilesize }}"
            {% if form.vars.data.is_image %}data-blob-thumb-url="{{ form.vars.data.thumbnailUrl }}"{% endif %}
    >
        <div class="attach-row-icon" style="display: none;">
            {{ file_icon(form.vars.data) }}
        </div>
        <div class="attach-row-errors">
            {{ form_errors(form) }}
        </div>
        <a href="{{ form.vars.data.downloadUrl }}">
            {% if form.vars.data.is_image %}
                <img src="{{ form.vars.data.thumbnailUrl }}" alt=""/>
            {% else %}
                {{ content_icon(form.vars.data) }}
            {% endif %}
            {{ form.vars.data.filename }}
        </a>
        {{ form_widget(form) }}
    </div>
    {% else %}
        {{ form_widget(form) }}
    {% endif %}
{% endblock %}


