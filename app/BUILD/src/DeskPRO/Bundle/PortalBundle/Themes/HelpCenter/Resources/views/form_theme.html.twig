{% block form_row_toggle_checkbox %}
    {% set widgetClass = (errors|length > 0) ? 'form-control form-error' : '' %}
    {% if checkbox_label %}
        <fieldset class="form-group dp-toggle-checkbox">
            <legend class="title">{{ label|trans({}, translation_domain) }}</legend>
            {% if help %}
                <small class="form-text">{{ help }}</small>
            {% endif %}
            {{- form_widget(form, 1 ? {'attr': {'class': widgetClass}} : {}) -}}
            {{- form_errors(form) -}}
        </fieldset>
    {% else %}
        <div class="form-group dp-toggle-checkbox">
            {{- form_widget(form, 1 ? {'attr': {'class': widgetClass}} : {}) -}}
            {% if help %}
                <small class="form-text">{{ help }}</small>
            {% endif %}
            {{- form_errors(form) -}}
        </div>
    {% endif %}
{% endblock %}
