{% extends 'form_div_layout.html.twig' %}

{# form start - turn off novalidate #}
{%- block form_start -%}
    {% set method = method|upper %}
    {%- if method in ["GET", "POST"] -%}
        {% set form_method = method %}
    {%- else -%}
        {% set form_method = "POST" %}
    {%- endif -%}
    <form name="{{ name }}" method="{{ form_method|lower }}" action="{{ action }}"{% for attrname, attrvalue in attr %} {{ attrname }}="{{ attrvalue }}"{% endfor %}{% if multipart %} enctype="multipart/form-data"{% endif %} novalidate>
    {%- if form_method != method -%}
        <input type="hidden" name="_method" value="{{ method }}" />
    {%- endif -%}
{%- endblock form_start -%}


{# Basic structure #}

{%- block form_row -%}
    {% if toggle_checkbox %}
        {{ block('form_row_toggle_checkbox') }}
    {% else %}
        {% if help %}
            {{ block('form_row_help_text') }}
        {% else %}
            {{ block('form_row_nohelp') }}
        {% endif %}
    {% endif %}
{%- endblock form_row -%}

{%- block repeated_row -%}
    {% for child in form %}
        {#
        root_and_no_hidden means this form is a direct descendent of the parent (a "first-level" child) and it is
        not meant to be completely hidden to the user (input type=hidden)
        #}
        {% set root_and_not_hidden = has_root_parent and not fully_hidden %}

        {% if root_and_not_hidden %}
            <div class="form-group">
        {% endif %}

            {{ form_row(child) }}
{#        {% set widgetClass = (errors|length > 0) ? 'form-control form-error' : 'form-control' %}#}

{#        {{- form_label(child, null) -}}#}
{#        {{ var_dump(child) }}#}
{#        {{ var_dump(has_root_parent) }}#}
{#        {{- form_widget(child, {'attr': {'class': widgetClass}}) -}}#}
{#        {{- form_errors(child) -}}#}
{##}
        {% if root_and_not_hidden %}</div>{% endif %}
    {% endfor %}
{%- endblock repeated_row -%}


{%- block form_row_nohelp -%}
    {#
    root_and_no_hidden means this form is a direct descendent of the parent (a "first-level" child) and it is
    not meant to be completely hidden to the user (input type=hidden)
    #}
    {% set root_and_not_hidden = has_root_parent and not fully_hidden %}
    {% set applyClass = (has_root_parent and form.children | length < 1) or (not has_root_parent and form.children | length < 1) or form.vars.id == 'ticket_cc' %}
    {% if attr.attachments is defined and attr.attachments %}
        {% set widgetClass = '' %}
    {% else %}
        {% set widgetClass = (errors|length > 0) ? 'form-control form-error' : 'form-control' %}
    {% endif %}
    {# containers #}
    {% if root_and_not_hidden %}<{% if field_set %}fieldset{% else %}div{% endif %} class="form-group">{% endif %}
    {% if field_set %}<legend>{% endif %}
    {{- form_label(form, null) -}}
    {% if id == 'ticket_message_message' %}
        <small class="form-text">{{ phrase('helpcenter.forms.message_description') }}</small>
    {% endif %}
    {% if field_set %}</legend>{% endif %}
    {% if errors|length > 0 %}
        {% set ariaDescribed = id ~ '_errors' %}
    {% else %}
        {% set ariaDescribed = '' %}
    {% endif %}
    {{- form_widget(form, applyClass ? {'attr': {'class': widgetClass, 'aria-describedby' : ariaDescribed}} : {}) -}}
    {{- form_errors(form) -}}

    {# /containers #}
    {% if root_and_not_hidden %}</{% if field_set %}fieldset{% else %}div{% endif %}>{% endif %}
{%- endblock form_row_nohelp -%}

{%- block form_row_help_text -%}
    {#
    root_and_no_hidden means this form is a direct descendent of the parent (a "first-level" child) and it is
    not meant to be completely hidden to the user (input type=hidden)
    #}
    {% set root_and_not_hidden = has_root_parent and not fully_hidden %}
    {% set applyClass = (has_root_parent and form.children | length < 1) or (not has_root_parent and form.children | length < 1) %}
    {% set widgetClass = (errors|length > 0) ? 'form-control form-error' : 'form-control' %}
    {% if root_and_not_hidden %}<{% if field_set %}fieldset{% else %}div{% endif %} class="form-group">{% endif %}
    {% if field_set %}<legend>{% endif %}
    {{- form_label(form, null) -}}
    {% if field_set %}</legend>{% endif %}
    {% if (root_and_not_hidden and name != 'captcha_captcha_auto_added') or id == 'person_registration_password_password' %}
        <small class="form-text" {% if hint is defined %}id="{{ hint }}"{% endif %}>{{ help|nl2br }}</small>
    {% endif %}
    {% if errors|length > 0 %}
        {% set ariaDescribed = id ~ '_errors' %}
    {% else %}
        {% set ariaDescribed = '' %}
    {% endif %}
    {{- form_widget(form, applyClass ? {'attr': {'class': widgetClass, 'aria-describedby' : ariaDescribed}} : {}) -}}
    {% if root_and_not_hidden and name == 'captcha_captcha_auto_added' %}
        <small class="form-text">{{ help }}</small>
    {% endif %}
    {{- form_errors(form) -}}

    {% if root_and_not_hidden %}</{% if field_set %}fieldset{% else %}div{% endif %}>{% endif %}
{%- endblock form_row_help_text -%}

{%- block form_row_help_col -%}
    {#
    root_and_no_hidden means this form is a direct descendent of the parent (a "first-level" child) and it is
    not meant to be completely hidden to the user (input type=hidden)
    #}
    {% set root_and_not_hidden = has_root_parent and not fully_hidden %}
    {% set applyClass = (has_root_parent and form.children | length < 1) or (not has_root_parent and form.children | length < 1) %}
    {% set widgetClass = (errors|length > 0) ? 'form-control form-error' : 'form-control' %}
    {% if root_and_not_hidden %}
        <div class="form-group">
        <table class="dp-formtable-tablerow" width="100%"><tr><td class="dp-formtable-controls" valign="top">
    {% endif %}

    {{- form_label(form, null) -}}
    {{- form_widget(form, 1 ? {'attr': {'class': widgetClass}} : {}) -}}
    {{- form_errors(form) -}}

    {% if root_and_not_hidden %}
                </td>
                <td class="dp-formtable-help" valign="top" width="33%">
                    <div class="form-help">
                        <p>{{ help }}</p>
                    </div>
                </td>
            </tr>
        </table>
        </div>
    {% endif %}
{%- endblock form_row_help_col -%}

{% block button_widget %}
    {% spaceless %}
        {% if label is empty %}
            {% set label = name|humanize %}
        {% endif %}
        {% if type == 'submit' %}
            {% set attr = attr|merge({class: (attr.class is defined ? attr.class~' ' : '')~'btn btn-primary'}) %}
        {% elseif type == 'reset' %}
            {% set attr = attr|merge({class: (attr.class is defined ? attr.class~' ' : '')~'btn btn-outline-secondary btn-reset'}) %}
        {% else %}
            {% set attr = attr|merge({class: (attr.class is defined ? attr.class~' ' : '')~'btn btn-secondary'}) %}
        {% endif %}
        <button type="{{ type|default('button') }}" {{ block('button_attributes') }}>{{ label|trans({}, translation_domain) }}</button>
    {% endspaceless %}
{% endblock button_widget %}

{% block reset_widget %}{% endblock reset_widget %}

{%- block submit_widget -%}
    {%- set type = type|default('submit') -%}
    <div class="form-group dp-po-form-check">{{ block('button_widget') }}</div>
{%- endblock submit_widget -%}

{%- block combined_row -%}
    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                {{ form_row(form.children|first) }}
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                {{ form_row(form.children|last) }}
            </div>
        </div>
    </div>
{%- endblock -%}

{% block form_errors -%}
    {% if errors|length > 0 -%}
        <span id="{{ id }}_errors">
        {%- for error in errors -%}
            <small class="form-text text-danger">{{ phrase_form_error(error) }}</small>
        {%- endfor -%}
        </span>
    {%- endif %}
{%- endblock form_errors %}

{# Date and Time #}

{%- block datetime_widget -%}
    <div class="dpx-date-time with-dpx{% if widget != 'single_text' %} form-control{% endif %}" data-min-date="{{ form.vars.min_date }}" data-max-date="{{ form.vars.max_date }}" data-weekdays="{{ form.vars.weekdays }}">
        {% if widget == 'single_text' %}
            {{- block('form_widget_simple') -}}
        {%- else -%}
            <div class="fallback-input" aria-hidden="true">
                <div {{ block('widget_container_attributes') }}>
                    {{- form_errors(form.date) -}}
                    {{- form_errors(form.time) -}}
                    {{- form_widget(form.date, {nodpx: true}) -}}
                    {{- form_widget(form.time, {nodpx: true}) -}}
                </div>
            </div>
        {%- endif -%}
    </div>
{%- endblock datetime_widget -%}

{%- block date_widget -%}
    {% if not (nodpx is defined and nodpx) %}
        <div class="bb dpx-date with-dpx {{ form.vars.calendar }}{% if widget != 'single_text' %} form-control not-single-text{% endif %}" data-calendar="{{ form.vars.calendar }}" data-min-date="{{ form.vars.min_date }}" data-max-date="{{ form.vars.max_date }}" data-weekdays="{{ form.vars.weekdays }}">
    {% endif %}
        {%- if widget == 'single_text' -%}
            {{ block('form_widget_simple') }}
        {%- else -%}
            <div class="fallback-input">
                <div {{ block('widget_container_attributes') }}>
                    {{- date_pattern|replace({
                        '{{ year }}':  form_widget(form.year),
                        '{{ month }}': form_widget(form.month),
                        '{{ day }}':   form_widget(form.day),
                    })|raw -}}
                </div>
            </div>
        {%- endif -%}
    {% if not (nodpx is defined and nodpx) %}
        </div>
    {% endif %}
{%- endblock date_widget -%}

{%- block time_widget -%}
    {% if not (nodpx is defined and nodpx) %}
        <div class="dpx-time with-dpx{% if widget != 'single_text' %} form-control not-single-text{% endif %}">
    {% endif %}
        {%- if widget == 'single_text' -%}
            {{ block('form_widget_simple') }}
        {%- else -%}
            {%- set vars = widget == 'text' ? { 'attr': { 'size': 1 }} : {} -%}
            <div {{ block('widget_container_attributes') }}>
                {{ form_widget(form.hour, vars) }}{% if with_minutes %}:{{ form_widget(form.minute, vars) }}{% endif %}{% if with_seconds %}:{{ form_widget(form.second, vars) }}{% endif %}
            </div>
        {%- endif -%}
    {% if not (nodpx is defined and nodpx) %}
        </div>
    {% endif %}
{%- endblock time_widget -%}

{# Currency #}

{%- block money_widget -%}
    <div class="dp-money-field {{ form.vars.currency_code }}">
        {% if money_pattern matches '/^{{ widget }}/' %}
            {{ block('form_widget_simple') }} <span>{{ money_pattern|replace({'{{ widget }}': ''}) }}</span>
        {% elseif money_pattern matches '/{{ widget }}$/' %}
            <span>{{ money_pattern|replace({'{{ widget }}': ''}) }}</span> {{ block('form_widget_simple') }}
        {% else %}
            {{ block('form_widget_simple') }}
        {% endif %}
    </div>
{%- endblock money_widget -%}

{# Labels #}

{%- block form_label -%}
    {% if label is not sameas(false) -%}
        {% set label_attr = label_attr|merge({'class': (label_attr.class|default('') ~ ' title')|trim}) %}
        {% if not field_set %}
            {% if not compound -%}
                {% set label_attr = label_attr|merge({'for': id}) %}
            {% else %}
                {% if id == 'person_registration_primary_email' or 'ticket_person_user_email' %}
                    {% set label_attr = label_attr|merge({'for': id ~ '_email'}) %}
                {% else %}
                    {{ id }}
                    {% set label_attr = label_attr|merge({'for': id ~ '_data'}) %}
                {% endif %}
            {%- endif %}
        {% endif %}
        {% if required -%}
            {% set label_attr = label_attr|merge({'class': (label_attr.class|default('') ~ ' required')|trim}) %}
        {%- endif %}
        {% if label is empty -%}
            {%- if label_format is not empty -%}
                {% set label = label_format|replace({
                    '%name%': name,
                    '%id%': id,
                }) %}
            {%- else -%}
                {% set label = name|humanize %}
            {%- endif -%}
        {%- endif -%}
        <label{% for attrname, attrvalue in label_attr %} {{ attrname }}="{{ attrvalue }}"{% endfor %}>{{ label|trans({}, translation_domain) }}{% if required %} *{% endif %}{% if dp_include_link is defined and dp_include_link == 'manage_email' %}
            <span class="form-label-link manage-emails-link">
                <a href="{{ path('portal_user_profile_emails') }}">{{ phrase('helpcenter.account.email_management_from_form') }}</a>
            </span>
    {% endif %}</label>
    {%- endif -%}
{%- endblock form_label -%}

{%- block button_label -%}{%- endblock -%}

{# Checkbox #}
{% block checkbox_widget %}
    {% spaceless %}
        {% if checkbox_label is defined and checkbox_label %}
            <label for="{{ id }}"><input
                        type="checkbox" {{ block('widget_attributes') }}{% if value is defined %} value="{{ value }}"{% endif %}{% if checked %} checked="checked"{% endif %} />{{ checkbox_label|trans }}
            </label>
        {% else %}
            <label class="title" for="{{ id }}"><input type="checkbox" id="{{ id }}" value="{{ value }}"{% if checked %} checked="checked"{% endif %} {{ block('widget_attributes') }}><i></i><span class="label">{{ label }}</span></label>
        {% endif %}
    {% endspaceless %}
{% endblock checkbox_widget %}

{% block radio_widget %}
    {% spaceless %}
        <label class="title" for="{{ id }}"><input type="radio" id="{{ id }}" value="{{ value }}"{% if checked %} checked="checked"{% endif %} {{ block('widget_attributes') }}><i></i><span class="label">{{ label }}</span></label>
    {% endspaceless %}
{% endblock radio_widget %}

{% block single_checkbox_widget %}
    {# we use a special type if its a single checkbox (toggle type) #}
    <div class="dpx-checkbox-group dp-checkbox-group-widget">
        <input
            type="checkbox" {{ block('widget_attributes') }}{% if value is defined %} value="{{ value }}"{% endif %}{% if checked %} checked="checked"{% endif %} />
        <label for="{{ id }}">
            {{ checkbox_label|trans }}
        </label>
    </div>
{% endblock %}

{# letting logged in users choose their email #}
{% block deskpro_person_email_choice_widget %}
        {% set count = choices|length %}
        {% if count > 1 %}
            <select id="{{ id }}" name="{{ full_name }}" class="form-control">
               {% for choice in choices %}
                   <option data-id="{{ choice.value }}" data-name="{{ choice.label }}" value="{{ choice.value }}"{% if choice.value == value %} selected="selected"{% endif %}>{{ choice.label }}</option>
               {% endfor %}
            </select>
            <i class="far fa-angle-down fa-lg"></i>
        {% else %}
            <input id="{{ id }}" class="email-present form-control" type="text" disabled="disabled" value="{{ person.primary_email_address }}" />
        {% endif %}
{% endblock deskpro_person_email_choice_widget %}

{# letting logged in users choose their email #}
{% block deskpro_person_email_choice_label %}
    {# we setup a view variable here so that our form_label block can include a particular link (its hardcoded there) #}
    {% set dp_include_link = 'manage_email' %}
    {{ block('form_label') }}
{% endblock deskpro_person_email_choice_label %}


{% block custom_per_field_widget %}
    <div
        class="form-custom-per-field"
        data-id="{{ form.vars.custom_def.id }}"
        data-allow-edit="{{ form.vars.custom_def.options['allow_edit'] ? "true" : "false" }}"
        data-multiple="{{ form.vars.custom_def.options['multiple'] ? "true" : "false" }}"
        data-expanded="{{ form.vars.custom_def.options['expanded'] ? "true" : "false" }}"
        data-input-name="{{ form.vars.full_name }}"
        >
        {% set no_dp_title = true %}
        {{ block('form_widget') }}
    </div>
{% endblock %}

{% block custom_javascript_widget %}
    <div class="with-dpx form-control">
        <div
                class="dpx-javascript"
                data-code="{{ form.vars.custom_def.getOption('code') }}"
        >
            <input id="{{ id }}" name="{{ full_name }}" type="hidden" class="js-custom-field-hidden-input" value="{{ value }}" />
        </div>
    </div>
{% endblock %}

{%- block choice_widget_collapsed -%}
    {%- if required and placeholder is none and not placeholder_in_choices and not multiple -%}
        {% set required = false %}
    {%- endif -%}
    <div class="with-dpx">
        <select dpx-select {{ block('widget_attributes') }}{% if multiple %} multiple="multiple"{% endif %}>
            {%- if placeholder is not none -%}
                <option value=""{% if required and value is empty %} selected="selected"{% endif %}>{{ placeholder != '' ? placeholder|trans({}, translation_domain) }}</option>
            {%- endif -%}
            {%- if preferred_choices|length > 0 -%}
                {% set options = preferred_choices %}
                {{- block('choice_widget_options') -}}
                {%- if choices|length > 0 and separator is not none -%}
                    <option disabled="disabled">{{ separator }}</option>
                {%- endif -%}
            {%- endif -%}
            {%- set options = choices -%}
            {{- block('choice_widget_options') -}}
        </select>
    </div>
{%- endblock choice_widget_collapsed -%}

