<!DOCTYPE html>
<html {% if language.is_rtl %}class="as-rtl" dir="rtl"{% endif %}>
<head>
    <title>{% if page_title is defined %}{{ page_title }}{% else %}{{ brand_setting('core.deskpro_name')|e }}{% endif %}</title>

    <style type="text/css">
        @page {
            margin-top: 2cm;
            margin-bottom: 2.54cm;
            margin-left: 3.175cm;
            margin-right: 3.175cm;
        }
    </style>
    <link href="{{ asset('DeskPRO_PortalBundle_style.css', 'app_assets') }}" media="all" rel="stylesheet" type="text/css" />
    <style type="text/css">
      /*
        mPdf doesn't support `numeric` value for font-weight that appear in production assets
        https://mpdf.github.io/css-stylesheets/supported-css.html#common-text-styles
        has to overwrite such styles using aliases as value
      */
      strong {
        font-weight: bold;
      }
    </style>
</head>
<body>
    <div class="brand {% if portal_custom_logo() %}with-logo{% endif %}">
        <a href="{{ path('portal_home') }}">
            {% if portal_custom_logo() %}
                <img alt="{{ brand_setting('core.deskpro_name')|e }}"
                     src="{{ portal_custom_logo() }}"
                     height="49"
                     style="max-height: 49px"
                     class="logo" />
            {% else %}
                <h1>{{ brand_setting('core.deskpro_name')|e }}</h1>
            {% endif %}
        </a>
    </div>
    <br />

    {% block page_content %}
        <div class="dp-po">
            <main class="dp-po-main {% if main_class is defined %}{{ main_class }}{% endif %}">
                <div class="container">
                    {% if block("page_top") is defined %}
                        {{ block("page_top") }}
                    {% endif %}
                    <div class="row">
                        {% if block("page_sidebar") is defined %}
                            <div class="col-sm-9">
                                {{ block("page_body") }}
                            </div>
                            <div class="col-sm-3">
                                <div class="dp-po-sidebar-spacer"></div>
                                {{ block("page_sidebar") }}
                            </div>
                        {% else %}
                            <div class="dp-po-col-9 dp-po-md-12">
                                {{ block("page_body") }}
                            </div>
                        {% endif %}
                    </div>
                </div>
            </main>
        </div>
    {% endblock %}

</body>
</html>
