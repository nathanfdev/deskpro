{% extends 'Theme::layout.html.twig' %}

{% block page_body %}
  <article class="news kb-article">
    <header>
      <h1>{{ person.id }} {% if person.community_name %}-{{ person.community_name }} {% endif %}</h1>
    </header>

    <div class="article-content-wrapper">
      <div class="article-content padded dpx-kb-article-content">
        Id: {{ person.id }} <br/>
        Display name: {% if person.community_name %}{{ person.community_name }}{% else %}Not set{% endif %}<br/>
        Avatar: {% if avatar %}<img src="{{ avatar }}"/>{% else %}Not set{% endif %}
      </div>
      {% if custom_data|length %}
        <div class="ticket-view-sidebar">
          <div class="ticket-sidebar-container ticket-sidebar-meta">
            <ul>
              {% for custom in custom_data %}
                {% if custom['value'] %}
                  <li>
                    <h3>{{ custom['label'] }}</h3>
                    {% if custom['type'] == 'url' %}
                      <p><a href="{{ custom['value'] }}" target="_blank">{{ custom['value'] }}</a></p>
                    {% elseif custom['type'] == 'date' %}
                      <p>{{ custom['value']|date('full') }}</p>
                    {% elseif custom['type'] == 'datetime' %}
                      <p>{{ custom['value']|date('fulltime') }}</p>
                    {% elseif custom['type'] == 'file' %}
                      {% for file in custom['value'] %}
                        <div>
                          <a href="{{ file.downloadUrl }}{{ file.is_image ? '' : '?dl=1' }}" target="_blank">
                            {{ content_icon(file) }}
                            {{ file.filename }}
                            ({{ file.readableFilesize }})
                          </a>
                        </div>
                      {% endfor %}
                    {% else %}
                      <p>{% if custom['value'] is iterable %}{{ custom['value']|join(', ') }}{% else %}{{ custom['value'] }}{% endif %}</p>
                    {% endif %}
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>
        </div>
      {% endif %}
    </div>
  </article>

{% endblock page_body %}
