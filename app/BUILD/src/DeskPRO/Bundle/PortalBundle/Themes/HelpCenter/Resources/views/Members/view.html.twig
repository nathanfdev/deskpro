{% extends 'Theme::layout.html.twig' %}

{% block page_content %}
    <div class="dp-po">
        <main id="main" tabindex="-1" class="dp-po-main {% if main_class is defined %}{{ main_class }}{% endif %}">
            <div class="container">
                <div class="row">
                    <div class="col-sm-4">
                        <div class="dp-po-block">
                            <div class="dp-po-profile">
                                <figure class="dp-po-profile-figure">
                                    {{ hc_avatar(person, 'dp-po-profile-figure', 140) }}
                                </figure>
                                <h2 class="dp-po-profile-name">
                                    {{ person.community_name ? person.community_name : phrase('helpcenter.members.not_set') }}
                                </h2>
                                {% if person.organization %}
                                    <p class="dp-po-profile-title">
                                        {{ (person.organization_position ? "#{person.organization_position}, ") ~ person.organization.name }}
                                    </p>
                                {% endif %}
                                <hr>
                                <div class="dp-po-profile-extras">
                                    {% if person.primary_email %}
                                        <h3 class="dp-po-profile-extras-title">{{ phrase('helpcenter.general.email_address') }}</h3>
                                        <p class="dp-po-profile-extras-desc">{{ person.primary_email }}</p>
                                    {% endif %}
                                    {% if person.language %}
                                        <h3 class="dp-po-profile-extras-title">{{ phrase('helpcenter.members.language') }}</h3>
                                        <p class="dp-po-profile-extras-desc">
                                            <img class="dp-po-icon" src="{{ asset('images/flags/' ~ person.language.flag_image) }}" />
                                            {{ person.language.title_local }}
                                        </p>
                                    {% endif %}
                                    {% if person.timezone %}
                                        <h3 class="dp-po-profile-extras-title">{{ phrase('helpcenter.members.timezone') }}</h3>
                                        <p class="dp-po-profile-extras-desc">{{ null|date('(e P) ', person.timezone) ~ " #{person.timezone}" }}</p>
                                    {% endif %}
                                    <h3 class="dp-po-profile-extras-title">{{ phrase('helpcenter.members.date_joined') }}</h3>
                                    <p class="dp-po-profile-extras-desc">{{ date_ago(person.date_created) }}</p>
                                </div>
                                {% if person.primary_email %}
                                    <div>
                                        <a href="{{ path('portal_dm_send_to', {to: person.id}) }}" class="btn btn-primary">{{ phrase('helpcenter.members.send_message') }}</a>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-8">
                        <div class="dp-po-block dp-po-section">
                            <div class="dp-po-profile-activity">
                                <h3 class="dp-po-profile-activity-title">{{ phrase('helpcenter.members.recent_activity') }}</h3>
                                {% for group, activities in activities %}
                                    <div class="dp-po-timeline">
                                        <span class="dp-po-timeline-block">
                                            <span class="dp-po-icon">
                                                <i class="far fa-calendar"></i>
                                            </span>
                                            {% if group == 'today' %}
                                                {{ phrase('helpcenter.members.activity_group_today') }}
                                            {% elseif group == 'this_week' %}
                                                {{ phrase('helpcenter.members.activity_group_this_week') }}
                                            {% elseif group == 'last_week' %}
                                                {{ phrase('helpcenter.members.activity_group_last_week') }}
                                            {% elseif group == 'this_month' %}
                                                {{ phrase('helpcenter.members.activity_group_this_month') }}
                                            {% elseif group == 'last_month' %}
                                                {{ phrase('helpcenter.members.activity_group_last_month') }}
                                            {% elseif group == 'this_year' %}
                                                {{ phrase('helpcenter.members.activity_group_this_year') }}
                                            {% elseif group == 'last_year' %}
                                                {{ phrase('helpcenter.members.activity_group_last_year') }}
                                            {% elseif group == 'everything_else' %}
                                                {{ phrase('helpcenter.members.activity_group_everything_else') }}
                                            {% endif %}
                                        </span>
                                    </div>
                                    <ul class="dp-po-profile-activity-list">
                                        {% for activity in activities %}
                                            <li class="dp-po-profile-activity-item">
                                                {% include "Theme:Members:Activity/type_#{activity.type}.html.twig" with {
                                                    activity: activity,
                                                    truncateDescription: 100,
                                                } %}
                                                <div class="dp-po-time">
                                                    <i class="dp-po-icon far fa-clock"></i>
                                                    {{ date_ago(activity.date, null, true, true) }}
                                                </div>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <p>{{ phrase('helpcenter.members.no_activities') }}</p>
                                {% endfor %}
                            </div>
                        </div>
                        {% include 'Theme:Common:pager.html.twig' with {
                            pager: activities,
                            pager_options: { pageParameter: '[page]' }
                        } %}
                    </div>
                </div>
            </div>
        </main>
    </div>
{% endblock %}
