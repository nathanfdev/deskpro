{% extends 'Theme::layout.html.twig' %}

{# ------------------------------------------ #}
{# Main page body #}
{# ------------------------------------------ #}
{% block page_body %}
    <div class="dp-po-section">
        <div class="dp-po-title">
            {#<img class="dp-po-title-svg"
                 src="/portal-components/portal-style/static/img/page-icons/knowledgebase.svg">#}
            <h2 class="dp-po-title-text">{{ article.translated_title }}</h2>
        </div>
    </div>

    {% include 'Theme:PublishCommon:post-avatars.html.twig' %}

    <div class="row">
        <div class="col-sm-10">
            <div class="dp-po-post-info">
                <ul class="dp-po-post-info-list">
                    <li class="dp-po-post-info-item">
                        {{ phrase('helpcenter.general.last-updated', {date: article.date_updated | date('day'), person: article.person}) | raw }}
                    </li>
                    {#<li class="dp-po-post-info-item">
                        News type: <b>Product Release</b>
                    </li>#}
                </ul>
            </div>
        </div>
        <div class="col-sm-2">
            <div class="dp-po-post-extra">
                <ul class="dp-po-post-extra-list">
                    <li class="dp-po-post-extra-item">
                        <a href="" class="dp-po-post-extra-link"><i class="dp-po-icon fal fa-print"></i></a>
                    </li>
                    <li class="dp-po-post-extra-item">
                        <a href="" class="dp-po-post-extra-link"><i class="dp-po-icon fal fa-file-pdf"></i></a>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    {% if article.status != 'published' and article.status != 'archived' and app.user.is_agent %}
        <div class="alert alert-icon alert-danger" role="alert">
            <i class="dp-po-icon fal fa-calendar-alt"></i> {{ phrase('portal.articles.view-as-agent') }}
        </div>
    {% endif %}

    {% if article.end_action == 'unpublish' and app.user.is_agent %}
        <div class="alert alert-icon alert-danger" role="alert">
            <i class="dp-po-icon fal fa-calendar-alt"></i> {{ phrase('helpcenter.flashes.article_unpublish', {date: article.date_end | date('day')}) }}
        </div>
    {% endif %}

    <div class="dp-po-post-content dp-po-block">
        {{ article.translated_content|raw }}

        {# TODO attachments #}
        {#{% show kb_attachments %} #}
        {#
        <div class="dp-po-kb-attachments">
          <h4 class="dp-po-kb-attachments-title">Attachments</h4>
          <ul class="dp-po-kb-attachments-list">
            <li class="dp-po-kb-attachments-item">
              <a href="" class="dp-po-kb-attachments-link">
                <i class="dp-po-icon fal fa-file-pdf"></i> craft-sync-user-guide.pdf
              </a>
            </li>
            <li class="dp-po-kb-attachments-item">
              <a href="" class="dp-po-kb-attachments-link">
                <i class="dp-po-icon fal fa-file-word"></i> craft-sync-photoshop-help.docx
              </a>
            </li>
            <li class="dp-po-kb-attachments-item">
              <a href="" class="dp-po-kb-attachments-link">
                <i class="dp-po-icon fal fa-file-excel"></i> craft-sync-photoshop-help.xlsx
              </a>
            </li>
          </ul>
        </div>
      </div>
      #}
    </div>


    {% if can_rate_article(article) %}
        {% include 'Theme:PublishCommon:rating.html.twig' %}
    {% endif %}

    {% if brand_setting('user.publish_comments') %}
        {% if articleData.comments | length %}
            {% include 'Theme:PublishCommon:comments-list.html.twig' with { comments: articleData.comments } %}
        {% endif %}

        {% include 'Theme:PublishCommon:comments-form.html.twig' %}
    {% endif %}
{% endblock %}

{# ------------------------------------------ #}
{# Page sidebar #}
{# ------------------------------------------ #}
{% block page_sidebar %}
    <div class="dp-po-sidebar-spacer"></div>

    {# TODO active subscription state #}
    {% include 'Theme:PublishCommon:subscribe-button.html.twig' with {
        subscriptionInfo: [
            { toggleUrl: portal_path(category, 'toggle_subscription'), icon: 'fal fa-file-alt', title: phrase('portal.forms.label_kb_article'), active: false },
            { toggleUrl: portal_path(category, 'toggle_subscription'), icon: 'fal fa-file-spreadsheet', title: phrase('portal.forms.label_category'), active: false },
            { toggleUrl: path('portal_kb_article_root_category_toggle_subscription'), icon: 'fal fa-file-chart-line', title: phrase('portal.articles.section-title'), active: false },
        ]
    } %}

    {% if article.labels | length %}
        {% include 'Theme:PublishCommon:Labels/sidebar-block.html.twig' with {
            title: phrase('portal.general.labels'),
            labels: article.labels
        } %}
    {% endif %}

    {% if false %}
        {% embed 'Theme:Common:sidebar-block.html.twig' with {
            propertyList: [
                { label: phrase('portal.sidebar.article_posted_by'), value: article.person.display_name_user },
                { label: phrase('portal.tickets.list_date_created'), value: article.date_published | date('day') },
                { block: 'customFields' }
            ]
        } %}
            {% if custom_data | length %}
                {% block customFields %}
                    {% include 'Theme:PublishCommon:custom-data-sidebar-list.html.twig' %}
                {% endblock %}
            {% endif %}
        {% endembed %}
    {% endif %}

    {% include'Theme:Articles:meta.html.twig' %}

    {# TODO related content #}
    {#{% show related_content %}#}
{% endblock %}

{% block doc_end %}
    {{ insert_glossary_js(article) }}
{% endblock %}
