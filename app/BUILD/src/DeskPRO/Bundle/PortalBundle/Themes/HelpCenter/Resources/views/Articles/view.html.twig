{% extends 'Theme::layout.html.twig' %}

{# ------------------------------------------ #}
{# Main page body #}
{# ------------------------------------------ #}
{% block page_body %}
    <h2 class="dp-po-Title-page">{{ article.translated_title }}</h2>
    <ul class="dp-po-List List--avatars">
      <li>
          <span class="dp-po-Avatar Avatar--circle">
              <img class="dp-po-Avatar-icon" src="{{ avatar_url(article.person) }}" alt=""></img>
              <span class="dp-po-Avatar-tooltip">{{ article.person.display_name_user }}</span>
          </span>
      </li>
    </ul>

    <div class="dp-po-description-wrap">
      <span class="dp-po-description">{{ phrase('helpcenter.general.last-updated', {date: article.date_updated | date('day'), person: article.person}) | raw }}</span>
      <span class="dp-IconsWrapper">
          <a href="{{ path('portal_articles_pdf', {slug: article.slug, print: 1}) }}" class="dp-po-Icon Icon--print Icon--grey-dark"></a>
          <a href="{{ path('portal_articles_pdf', {slug: article.slug}) }}" class="dp-po-Icon Icon--pdf-file Icon--grey-dark"></a>
      </span>
    </div>

    <div class="dp-po-mobile-subscribe mobileCutBtn">
        <div class="dp-po-dropdown-share">
            <div class="dp-po-Icon Icon--Dots Icon--grey-darkest"></div>
            <ul class="dp-po-dropdown-menu Dropdown-share">
              <li class="dp-po-dropdown-menu-item dp-po-close"><span class="dp-po-Icon Icon--close"></span></li>
              <li class="dp-po-dropdown-menu-item dp-po-share"><span class="dp-po-Icon Icon--share"></span>Share<span class="dp-po-Icon Icon--caret-right dp-po-share-btn"></span>
                  <ul class="dp-po-dropdown-menu">
                      <li class="dp-po-dropdown-menu-item dp-po-back-btn"><span class="dp-po-Icon Icon--back"></span></li>
                      <li class="dp-po-dropdown-menu-item"><span class="dp-po-Icon Icon--ticket"></span>Email</li>
                      <li class="dp-po-dropdown-menu-item"><span class="dp-po-Icon Icon--fb"></span>Facebook</li>
                      <li class="dp-po-dropdown-menu-item"><span class="dp-po-Icon Icon--Messenger"></span>Messenger</li>
                      <li class="dp-po-dropdown-menu-item"><span class="dp-po-Icon Icon--tw"></span>Twitter</li>
                      <li class="dp-po-dropdown-menu-item"><span class="dp-po-Icon Icon--whatsapp"></span>Whats app</li>
                      <li class="dp-po-dropdown-menu-item"><span class="dp-po-Icon Icon--linkedin"></span>Linkedin</li>
                      <li class="dp-po-dropdown-menu-item"><span class="dp-po-Icon Icon--Instagram"></span>Instagram</li>
                      <li class="dp-po-dropdown-menu-item">Copy this link</li>
                      <li class="dp-po-dropdown-menu-item"><a href="" class="dp-po-support-btn">www.support.deskpro.com/guides/admin/h...</a></li>
                  </ul>
              </li>
              <li class="dp-po-dropdown-menu-item"><span class="dp-po-Icon Icon--pdf-file"></span>Download this article</li>
              <li class="dp-po-dropdown-menu-item"><span class="dp-po-Icon Icon--print"></span>Print this article</li>
            </ul>
        </div>
    </div>

    {% if article.status != 'published' and article.status != 'archived' and app.user.is_agent %}
        <div class="dp-po-publish-date dp-po-hidden-md">
          <span class="dp-po-publish-icon"><span class="dp-po-Icon Icon--article-notification Icon--danger"></span></span>
          <span class="dp-po-description">{{ phrase('portal.articles.view-as-agent') }}</span>
        </div>

        <!-- mobile -->
        <div class="dp-po-publish-date dp-po-hidden-md-up">
          <span class="dp-po-publish-icon"><span class="dp-po-Icon Icon--article-notification Icon--danger"></span></span>
          <span class="dp-po-description">{{ phrase('portal.articles.view-as-agent') }}</span>
        </div>
    {% endif %}

    {% if article.end_action == 'unpublish' %}
        <div class="dp-po-publish-date dp-po-hidden-md">
            <span class="dp-po-publish-icon"><span class="dp-po-Icon Icon-calendar Icon--danger"></span></span>
            <span class="dp-po-description">{{ phrase('helpcenter.flashes.article_unpublish', {date: article.date_end | date('day')}) }}</span>
        </div>

        <!-- mobile -->
        <div class="dp-po-publish-date dp-po-hidden-md-up">
            <span class="dp-po-publish-icon"><span class="dp-po-Icon Icon--article-notification Icon--danger"></span></span>
            <span class="dp-po-description">{{ phrase('helpcenter.flashes.article_unpublish', {date: article.date_end | date('day')}) }}</span>
        </div>
    {% endif %}

    <div class="dp-po-tex-wrap">
        <div class="dpx-kb-article-content">
            {{ article.translated_content|raw }}
        </div>

        {# TODO attachments #}
        {#{% show kb_attachments %} #}
    </div>

    {% if can_rate_article(article) %}
        {% include 'Theme:PublishCommon:rating.html.twig' %}
    {% endif %}

    {% if brand_setting('user.publish_comments') %}
        {% if articleData.comments | length %}
            {% include 'Theme:PublishCommon:comments-list.html.twig' with { comments: articleData.comments } %}
        {% endif %}

        {% include 'Theme:PublishCommon:comments-form.html.twig' %}
    {% endif %}
{% endblock %}

{# ------------------------------------------ #}
{# Page sidebar #}
{# ------------------------------------------ #}
{% block page_sidebar %}
    {# TODO active subscription state #}
    {% include 'Theme:PublishCommon:subscribe-button.html.twig' with {
        subscriptionInfo: [
            { toggleUrl: portal_path(category, 'toggle_subscription'), icon: 'Icon--subscribe-article', title: phrase('portal.forms.label_kb_article'), active: false },
            { toggleUrl: portal_path(category, 'toggle_subscription'), icon: 'Icon--subscribe-category', title: phrase('portal.forms.label_category'), active: false },
            { toggleUrl: path('portal_kb_article_root_category_toggle_subscription'), icon: 'Icon--subscribe-Knowledgebase', title: phrase('portal.articles.section-title'), active: false },
        ]
    } %}

    {% if article.labels | length %}
        {% include 'Theme:Common:Labels/sidebar-block.html.twig' with {
            title: phrase('portal.general.labels'),
            labels: article.labels
        } %}
    {% endif %}

    {% if false %}
        {% embed 'Theme:Common:sidebar-block.html.twig' with {
            propertyList: [
                { label: phrase('portal.sidebar.article_posted_by'), value: article.person.display_name_user },
                { label: phrase('portal.tickets.list_date_created'), value: article.date_published | date('day') },
                { block: 'customFields' }
            ]
        } %}
            {% if custom_data | length %}
                {% block customFields %}
                    {% include 'Theme:PublishCommon:custom-data-sidebar-list.html.twig' %}
                {% endblock %}
            {% endif %}
        {% endembed %}
    {% endif %}

    {% include'Theme:Articles:meta.html.twig' %}

    {# TODO related content #}
    {#{% show related_content %}#}
{% endblock %}

{% block doc_end %}
    {{ insert_glossary_js(article) }}
{% endblock %}
