<div class="dp-po-guides-carousel">
    <div class="dp-po-guides-carousel-list {% if guides | length > 2 %}with-cover{% endif %}">
        {% for guide in guides %}
            <div class="dp-po-guides-carousel-item">
                {% if guides | length > 2 %}
                    <figure class="dp-po-guides-carousel-image"></figure>
                {% endif %}
                <div class="dp-po-guides-carousel-content">
                    <a href="{{ portal_url(guide) }}" class="dp-po-guides-carousel-link">
                        {{ render_icon_from(guide, {as_download_url: true, is_rounded: true}) }} {{ guide }}
                    </a>
