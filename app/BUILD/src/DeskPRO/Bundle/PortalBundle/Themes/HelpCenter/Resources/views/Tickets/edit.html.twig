{% extends 'Theme:Tickets:base_view.html.twig' %}

{% block page_specific_content %}
    <div class="dp-po-block">
        {% if rerendering %}
            <strong>{{ phrase('helpcenter.tickets.switched_department_rerender') }}</strong>
        {% endif %}

        <div id="edit_ticket_page">
            {% include 'Theme:Tickets:ticket_form.html.twig' %}
        </div>

        <div class="row">
            <div class="col-sm-12">
                <a href="{{ portal_path(ticket) }}">{{ phrase('helpcenter.tickets.cancel_ticket_edit') }}</a>
            </div>
        </div>
    </div>
{% endblock page_specific_content %}

{% block doc_end %}
    <!-- DESKPRO_TICKET_DISPLAY -->
    <script type="text/javascript">
        {{ ticket_display_js|raw }}
    </script>
{% endblock doc_end %}
