{% if flashes|length > 0 %}
    <div class="dp-po">
        {% for type, flashMessages in flashes %}
            {% for flash in flashMessages | unique_array %}
                <div class="dp-po-message-bar dp-po-message-bar-{{ type }}">
                    <div class="container">
                        <div class="dp-po-message-bar-wrap">
                            <p class="dp-po-message-bar-icon">
                                {% if type == 'warning' %}
                                    <i class="dp-po-icon fal fa-exclamation-triangle"></i>
                                {% elseif type == 'error' %}
                                    <i class="dp-po-icon far fa-times-circle"></i>
                                {% else %}
                                    <i class="dp-po-icon far fa-check-circle"></i>
                                {% endif %}
                            </p>
                            <p class="dp-po-message-bar-text">
                                {{ flash }}
                            </p>
                            <a href="#" class="dp-po-message-bar-close" title="{{ phrase('helpcenter.general.close') }}" aria-label="{{ phrase('helpcenter.general.close') }}"><i class="dp-po-icon fal fa-times"></i></a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        {% endfor %}
    </div>
{% endif %}
