{% if flashes|length > 0 %}
    <div class="dp-po">
        <div class="dp-po-flashes">
            <div class="container">
                <div class="row">
                    <div class="col-sm-9 col-centered">
                        {% for type, flashMessages in flashes %}
                            {% for flash in flashMessages %}
                                {% if type == 'warning' %}
                                    <div class="alert alert-icon alert-{{ type }}" role="alert">
                                        <i class="dp-po-icon fal fa-exclamation-triangle"></i> {{ flash }}
                                    </div>
                                {% else %}
                                    <div class="alert alert-{{ type }}" role="alert">
                                        {{ flash }}
                                    </div>
                                {% endif %}
                            {% endfor %}
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endif %}
