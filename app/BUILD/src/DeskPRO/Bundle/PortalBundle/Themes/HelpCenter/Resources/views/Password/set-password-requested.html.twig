{% extends 'Theme::layout.html.twig' %}

{% block page_content %}
<div class="dp-po">
    <main class="dp-po-main">
        <div class="container">
            <div class="row">
                <div class="col-sm-7 col-centered">
                    <div class="dp-po-title">
                        <h2>{{ phrase('helpcenter.account.set_password_sent_title') }}</h2>
                    </div>

                    <div class="dp-po-block">
                        <p>{{ phrase('helpcenter.account.set_password_sent_desc') }}</p>

                        <p>{{ phrase('helpcenter.account.set_password_sent_to') }}: <strong>{{ email }}</strong></p>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
{% endblock page_content %}
