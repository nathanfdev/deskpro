{% extends 'Theme::layout.html.twig' %}

{% block chat_attachment %}
  <div class="dpx-attachment">
    <a href="{{ attachment.download_url }}?dl=1"
       class="dp-po-chat-attachments-link {% if attachment.is_image %} dpx-attachment-full-image{% else %}dpx-attachment-file-icon{% endif %}"
       {% if not attachment.is_image and attachment.content_type is defined %}data-content-type="{{ attachment.content_type }}"{% endif %}
    >

      {% if attachment.is_image %}
        <img class="thumbnail" src="{{ attachment.download_url }}" />
      {% endif %}
      {{ attachment.filename }} <span>({{ attachment.filesize_readable }})</span>
    </a>
  </div>
{% endblock %}

{% block chat_message %}

  <div class="dp-po-chat-log-item">
    <div class="dp-po-avatar dp-po-avatar-round">
      {{ hc_avatar(message.author, '', 60) }}
      {% if message.origin == 'agent' %}
        {{ message.author ? message.author.display_name_user : '' }}
      {% else %}
        {{ phrase('helpcenter.messenger.you') }} ({{ message.author.primary_email }})
      {% endif %}
      {% if message.origin == 'agent'  %}<span class="badge badge-primary badge-small">{{ phrase('helpcenter.general.agent') }}</span>{% endif %}
    </div>
    <div class="dp-po-time">
      <i class="dp-po-icon far fa-clock"></i>
      {{ date(message.date_created, 'time') }}
    </div>
    <div class="dp-po-chat-log-item-comment">
      {% if message.metadata.blob is defined %}
        {% set attachment = message.metadata.blob %}
        <div class="file-list">
          {{ block('chat_attachment') }}
        </div>
      {% elseif message.is_html %}
        {{message.content|raw}}
      {% else %}
        {{message.content}}
      {% endif %}
    </div>
  </div>
{% endblock %}

{% block page_content %}
  <div class="dp-po">
    <main id="main" tabindex="-1" class="dp-po-main dp-po-chat-view-log">
      <div class="container">
        <div class="row mb-4">
          <div class="col-sm-9">
            <div class="dp-po-title">
              <img class="dp-po-title-svg" src="{{ asset('img/page-icons/chats.svg', 'help_center') }}">
              <h1 class="dp-po-title-text">{{ phrase('helpcenter.messenger.your_chat_with', { person_name: chat.agent.display_name_user }) }}</h1>
            </div>
            <div class="row align-items-center">
              <div class="col-sm-10">

                <div class="dp-po-post-info">
                  <ul class="dp-po-post-info-list">
                    {% set lastMessage = chat_messages|filter(m => m.author)|last %}
                    {% set lastPerson = lastMessage.author %}
                    <li class="dp-po-post-info-item">
                      {{ phrase('helpcenter.general.last_update_by', { date_updated: lastMessage.date_created, person_name: lastPerson }) }}
                    </li>
                    <li class="dp-po-post-info-item">
                      <i class="dp-po-icon far fa-calendar-alt"></i> <b>{{ phrase('helpcenter.general.date_medium', { date:chat.date_created }) }}</b>
                    </li>
                  </ul>
                </div>
              </div>
              <div class="col-sm-2">
                {#
                <div class="dp-po-post-extra">
                  <ul class="dp-po-post-extra-list">
                    <li class="dp-po-post-extra-item">
                      <a href="javascript:window.print();" class="dp-po-post-extra-link" aria-label="{{ phrase('helpcenter.general.print') }}"><i class="dp-po-icon fal fa-print"></i></a>
                    </li>
                    <li class="dp-po-post-extra-item">
                      <a href="" class="dp-po-post-extra-link" aria-label="{{ phrase('helpcenter.guides.download_pdf') }}"><i class="dp-po-icon fal fa-file-pdf"></i></a>
                    </li>
                  </ul>
                </div>
                #}
              </div>
            </div>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-9">
            <div class="dp-po-block">
              {% for message in chat_messages %}
                {% if message.is_sys %}
                  <div class="dp-po-chat-log-notification dp-po-chat-log-notification-success">
                    <div class="dp-po-chat-log-notification-icon">
                      <i class="dp-po-icon fas fa-user"></i>
                    </div>
                    <h3 class="dp-po-chat-log-notification-title">
                      <span>
                      {% if message.metadata.phrase_id %}
                        {% if message.is_html %}
                          {% if message.metadata.phrase_id =='message_user-joined' %}
                            {{ phrase('helpcenter.messenger.chat_message_user_joined', message.metadata, true) }}
                          {% elseif message.metadata.phrase_id =='message_user-left' %}
                            {{ phrase('helpcenter.messenger.chat_message_user_left', message.metadata, true) }}
                          {% elseif message.metadata.phrase_id =='message_agent-timeout' %}
                            {{ phrase('helpcenter.messenger.chat_message_agent_timeout', message.metadata, true) }}
                          {% elseif message.metadata.phrase_id =='message_assigned' %}
                            {{ phrase('helpcenter.messenger.message_assigned', message.metadata, true) }}
                          {% elseif message.metadata.phrase_id =='message_chatting-with' %}
                            {{ phrase('helpcenter.messenger.message_chatting_with', message.metadata, true) }}
                          {% elseif message.metadata.phrase_id =='message_ended' %}
                            {{ phrase('helpcenter.messenger.message_ended', message.metadata, true) }}
                          {% elseif message.metadata.phrase_id =='message_ended-by' %}
                            {{ phrase('helpcenter.messenger.message_ended_by', message.metadata, true) }}
                          {% elseif message.metadata.phrase_id =='message_ended-by-user' %}
                            {{ phrase('helpcenter.messenger.message_ended_by_user', message.metadata, true) }}
                          {% elseif message.metadata.phrase_id =='message_finding-agent' %}
                            {{ phrase('helpcenter.messenger.message_finding_agent', message.metadata, true) }}
                          {% elseif message.metadata.phrase_id =='message_long-wait' %}
                            {{ phrase('helpcenter.messenger.message_long_wait', message.metadata, true) }}
                          {% elseif message.metadata.phrase_id =='message_set-department' %}
                            {{ phrase('helpcenter.messenger.message_set_department', message.metadata, true) }}
                          {% elseif message.metadata.phrase_id =='message_started' %}
                            {{ phrase('helpcenter.messenger.message_started', message.metadata, true) }}
                          {% elseif message.metadata.phrase_id =='message_unassigned' %}
                            {{ phrase('helpcenter.messenger.message_unassigned', message.metadata, true) }}
                          {% elseif message.metadata.phrase_id =='message_uploading' %}
                            {{ phrase('helpcenter.messenger.message_uploading', message.metadata, true) }}
                          {% elseif message.metadata.phrase_id =='message_user-returned' %}
                            {{ phrase('helpcenter.messenger.message_user_returned', message.metadata, true) }}
                          {% elseif message.metadata.phrase_id =='message_user-timeout' %}
                            {{ phrase('helpcenter.messenger.message_user_timeout', message.metadata, true) }}
                          {% elseif message.metadata.phrase_id =='message_wait' %}
                            {{ phrase('helpcenter.messenger.message_wait', message.metadata, true) }}
                          {% elseif message.metadata.phrase_id =='message_wait-timeout' %}
                            {{ phrase('helpcenter.messenger.message_wait_timeout', message.metadata, true) }}
                          {% endif %}
                        {% else %}
                          {% if message.metadata.phrase_id =='message_user-joined' %}
                            {{ phrase('helpcenter.messenger.chat_message_user_joined', message.metadata) }}
                          {% elseif message.metadata.phrase_id =='message_user-left' %}
                            {{ phrase('helpcenter.messenger.chat_message_user_left', message.metadata) }}
                          {% elseif message.metadata.phrase_id =='message_agent-timeout' %}
                            {{ phrase('helpcenter.messenger.chat_message_agent_timeout', message.metadata) }}
                          {% elseif message.metadata.phrase_id =='message_assigned' %}
                            {{ phrase('helpcenter.messenger.message_assigned', message.metadata) }}
                          {% elseif message.metadata.phrase_id =='message_chatting-with' %}
                            {{ phrase('helpcenter.messenger.message_chatting_with', message.metadata) }}
                          {% elseif message.metadata.phrase_id =='message_ended' %}
                            {{ phrase('helpcenter.messenger.message_ended', message.metadata) }}
                          {% elseif message.metadata.phrase_id =='message_ended-by' %}
                            {{ phrase('helpcenter.messenger.message_ended_by', message.metadata) }}
                          {% elseif message.metadata.phrase_id =='message_ended-by-user' %}
                            {{ phrase('helpcenter.messenger.message_ended_by_user', message.metadata) }}
                          {% elseif message.metadata.phrase_id =='message_finding-agent' %}
                            {{ phrase('helpcenter.messenger.message_finding_agent', message.metadata) }}
                          {% elseif message.metadata.phrase_id =='message_long-wait' %}
                            {{ phrase('helpcenter.messenger.message_long_wait', message.metadata) }}
                          {% elseif message.metadata.phrase_id =='message_set-department' %}
                            {{ phrase('helpcenter.messenger.message_set_department', message.metadata) }}
                          {% elseif message.metadata.phrase_id =='message_started' %}
                            {{ phrase('helpcenter.messenger.message_started', message.metadata) }}
                          {% elseif message.metadata.phrase_id =='message_unassigned' %}
                            {{ phrase('helpcenter.messenger.message_unassigned', message.metadata) }}
                          {% elseif message.metadata.phrase_id =='message_uploading' %}
                            {{ phrase('helpcenter.messenger.message_uploading', message.metadata) }}
                          {% elseif message.metadata.phrase_id =='message_user-returned' %}
                            {{ phrase('helpcenter.messenger.message_user_returned', message.metadata) }}
                          {% elseif message.metadata.phrase_id =='message_user-timeout' %}
                            {{ phrase('helpcenter.messenger.message_user_timeout', message.metadata) }}
                          {% elseif message.metadata.phrase_id =='message_wait' %}
                            {{ phrase('helpcenter.messenger.message_wait', message.metadata) }}
                          {% elseif message.metadata.phrase_id =='message_wait-timeout' %}
                            {{ phrase('helpcenter.messenger.message_wait_timeout', message.metadata) }}
                          {% endif %}
                        {% endif %}
                      {% elseif message.is_html %}
                        {{message.content|raw}}
                      {% else %}
                        {{message.content}}
                      {% endif %}
                      </span>
                    </h3>
                    <div class="dp-po-time">
                      <i class="dp-po-icon far fa-clock"></i>
                      {{ date(message.date_created, 'time') }}
                    </div>
                  </div>
                {% else %}
                  {{ block('chat_message') }}
                {% endif %}
              {% endfor %}
            </div>
          </div>

          <div class="col-sm-3">
            <div class="dp-po-post-meta">
              <h3 class="dp-po-post-meta-title">{{ phrase('helpcenter.messenger.assigned_agent' )}}</h3>
              <p>
                <div class="dp-po-avatar dp-po-avatar-round">
                  {{ hc_avatar(chat.agent, '', 60) }}
                  <span>{{chat.agent.display_name_user}}</span>
                </div>
              </p>
              {% set allAgentsExceptAssigned = chat.agent_participants|filter(a => a != chat.agent) %}
              {% if allAgentsExceptAssigned|length > 0 %}
              <h3 class="dp-po-post-meta-title">{{ phrase('helpcenter.general.agents') }}</h3>
              <p>
                <div class="dp-po-avatar dp-po-avatar-round">
                  {% for agent in allAgentsExceptAssigned %}
                    {{ hc_avatar(agent, '', 60) }}
                    <span>{{ agent.display_name_user }}</span>
                  {% endfor %}
                </div>
              </p>
              {% endif %}
            </div>
            <div class="dp-po-post-meta">
              <h3 class="dp-po-post-meta-title">{{ phrase('helpcenter.general.department') }}</h3>
              <p>{{ chat.department ? chat.department.user_title : '-' }}</p>
              <h3 class="dp-po-post-meta-title">{{ phrase('helpcenter.messenger.total_chat_time_label') }}</h3>
              <p>{{ date_diff(chat.date_created, chat.date_ended) }}</p>
              <h3 class="dp-po-post-meta-title">{{ phrase('helpcenter.general.last_activity') }}</h3>
              <p>{{date(lastMessage.date_created, 'l')}}, {{date(lastMessage.date_created, 'time')}}</p>
              {% for custom in custom_data %}
                {% if custom['value'] %}
                  <h3 class="dp-po-post-meta-title">{{ custom['label'] }}</h3>
                  <p>{{ custom['value'] }}</p>
                {% endif %}
              {% endfor %}
            </div>

            {% if chat_attachments|length  > 0 %}
            <div class="dp-po-sidebar dp-po-chat-attachments">
              <h3 class="dp-po-sidebar-title">{{ phrase('helpcenter.messenger.files_on_this_chat') }}</h3>
              <ul class="dp-po-chat-attachments-list">
                {% for attachment in chat_attachments %}
                  <li class="dp-po-chat-attachments-item">
                    {{ block('chat_attachment') }}
                  </li>
                {% endfor %}
              </ul>
            </div>
            {% endif %}
            {% if linked_ticket %}
              <div class="dp-po-sidebar dp-po-chat-links">
                <h3 class="dp-po-sidebar-title">{{ phrase('helpcenter.messenger.linked_ticket_label') }}</h3>
                <ul class="dp-po-chat-links-list">
                  <li class="dp-po-chat-links-item">
                    <a href="{{ portal_path(linked_ticket) }}" class="dp-po-chat-links-link">
                      {{ phrase('helpcenter.messenger.view_linked_ticket_action') }}: {{ linked_ticket.subject }}
                      <i class="dp-po-icon fal fa-link"></i>
                      {{ portal_path(linked_ticket) }}
                    </a>
                  </li>
                </ul>
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </main>
  </div>
{% endblock page_content %}
