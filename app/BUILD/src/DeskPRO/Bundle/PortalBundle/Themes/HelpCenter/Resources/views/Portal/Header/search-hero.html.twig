<section class="dp-po-Header-container">
    <form class="dp-po-Forms dp-po-Search-bar" method="POST" action="{{ path('portal_search') }}" id="omnisearch" autocomplete="off">
        <div class="dp-po-Searchbar-wrap">
            <input type="search" name="q" autocomplete="off" placeholder="{{ phrase('portal.general.search_btn') }}..."></input>
            <input type="hidden" name="search_log_id" {% if search_log_id is defined %} value="{{search_log_id}} {% endif %}"/>
            <span class="dp-po-Icon Icon--find Icon--primary"></span>
        </div>
    </form>
</section>
