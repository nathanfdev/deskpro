<div class="dp-po-md-collapse dp-po-wrap-item dp-po-article-details-wrap">
    <div class="dp-po-md-collapse-title dp-po-title dp-po-hidden-md-up">{{ phrase('helpcenter.articles.article_details') }}<span class="dp-po-Icon Icon--caret-down Icon--primary dp-po-hidden-md-up"></span></div>
    <div class="dp-po-md-collapse-content">
        <ul class="dp-po-List List--col dp-po-user-list">
            <li>
                <span class="dp-po-title">{{ phrase('portal.sidebar.article_posted_by') }}</span>
                <span>{{ article.person.display_name_user }}</span>
            </li>
            <li>
                <span class="dp-po-title">{{ phrase('portal.tickets.list_date_created') }}</span>
                <span>{{ article.date_published | date('day') }}</span>
            </li>

            {% if custom_data | length %}
                {% include 'Theme:PublishCommon:custom-data-sidebar-list.html.twig' %}
            {% endif %}

            {% if article.object_props_translations | length > 0 %}
                <li class="dp-po-space-between">
                    <span class="dp-po-title">{{ phrase('helpcenter.general.translations') }}</span>
                    {# <span class="dp-po-time-status">{{ phrase('helpcenter.general.updated') }}</span> #}
                </li>

                {% for translation in  article.object_props_translations %}
                    {% if translation.prop_name == 'content' %}
                        <li class="dp-po-space-between dp-po-Flag-item-list">
                                                    <span class="dp-po-Flag-wrap">
                                                        <span class="dp-po-Icon Icon--{{ translation.language.locale | upper }}"></span>
                                                        {{ translation.language.title_local }}
                                                    </span>
                           {# <span class="dp-po-time-status is-success">23 days</span> #}
                        </li>
                    {% endif %}
                {% endfor %}

            {% endif %}

            {% if article.end_action == 'unpublish' %}
                <li class="dp-po-Tooltip-article-info">
                                            <span class="dp-po-title">{{ phrase('helpcenter.articles.unpublished_date') }}
                                                <span class="dp-po-tooltip-wrap">
                                                    <span class="dp-po-Icon Icon--info Icon--primary"></span>
                                                    <span class="dp-po-tooltip">{{ phrase('helpcenter.general.viewed_by_agents_only') }}</span>
                                                </span>
                                            </span>
                    <span>{{ article.date_end | date('day') }}</span>
                </li>
            {% endif %}
        </ul>
    </div>
</div>
