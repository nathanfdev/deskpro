<!DOCTYPE html>
<html {% if language.is_rtl %}class="as-rtl" dir="rtl"{% endif %}>
    <head>
        <meta http-equiv="X-UA-Compatible" content="IE=Edge,chrome=1" />
        <meta charset="utf-8" />
        <title>{{ brand_setting('core.deskpro_name')|e }}</title>
        <link href="{{ portal_css_url() }}" media="all" rel="stylesheet" type="text/css" />
        <link href="{{ asset('DeskPRO_PortalBundle_vendors_style.css', 'app_assets') }}" media="all" rel="stylesheet" type="text/css" />
        <script type="text/javascript">
            window.DESKPRO_ROOT_URL = '{{ root_url() }}';
            window.DESKPRO_APP_ASSETS_URL = '{{ asset('', 'app_assets') }}';
        </script>
        <script type="text/javascript" src="{{ asset('DeskPRO_HelpcenterDisabledBundle.js', 'app_assets') }}" async="async"></script>
    </head>
<body>
    <div class="world with-searchbox">
        {% include 'Theme:Common:flashes.html.twig' with { flashes: pageData.flashes } %}
        <div class="column-full">
            {% if app.user and app.user.can_admin %}
                {{ phrase('helpcenter.general.helpcenter-disabled-re-enable-from-setup', {setup_link: path('agent')~'#admin:/portal/setup'}) }}
            {% else %}
                {{ phrase('helpcenter.general.helpcenter-disabled-click-below') }}
            {% endif %}
        </div>
        <section class="welcome-news">
            <ul class="big-button-collection big-buttons dpx-toggle-mobile">
                <li>
                    <a href="{{ path('agent') }}">
                        <i class="fas fa-user"></i>
                        <span class="title">{{ phrase('helpcenter.general.agent-interface') }}</span>
                    </a>
                </li>
                {% if app.user and app.user.can_admin %}
                    <li>
                        <a href="{{ path('agent') }}#admin:/">
                            <i class="fas fa-cog"></i>
                            <span class="title">{{ phrase('helpcenter.general.agent-interface') }}</span>
                        </a>
                    </li>
                {% endif %}
            </ul>
        </section>
    </div>
</body>
</html>
