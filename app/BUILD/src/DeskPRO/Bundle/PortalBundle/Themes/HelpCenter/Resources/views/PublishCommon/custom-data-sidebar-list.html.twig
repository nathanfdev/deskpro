{% for custom in custom_data %}
    {% if custom['value'] %}
        <dt class="dp-po-post-meta-title">{{ custom['label'] }}</dt>
        {% if custom['type'] == 'url' %}
            <dd><a href="{{ custom['value'] }}" target="_blank">{{ custom['value'] }}</a></dd>
        {% elseif custom['type'] == 'date' %}
            <dd>{{ custom['value']|date('full') }}</dd>
        {% elseif custom['type'] == 'datetime' %}
            <dd>{{ custom['value']|date('fulltime') }}</dd>
        {% elseif custom['type'] == 'file' %}
            {% for file in custom['value'] %}
                <dd>
                    <a href="{{ file.downloadUrl }}{{ file.is_image ? '' : '?dl=1' }}" target="_blank">
                        {{ content_icon(file) }}
                        {{ file.filename }}
                        ({{ file.readableFilesize }})
                    </a>
                </dd>
            {% endfor %}
        {% else %}
            <dd>{% if custom['value'] is iterable %}{{ custom['value']|join(', ') }}{% else %}{{ custom['value'] }}{% endif %}</dd>
        {% endif %}
    {% endif %}
{% endfor %}
