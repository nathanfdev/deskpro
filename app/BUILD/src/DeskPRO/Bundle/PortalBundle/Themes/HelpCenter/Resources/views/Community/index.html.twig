{% extends 'Theme::layout.html.twig' %}

{% import 'Theme:Portal:User/macros.html.twig' as macros %}

{% block page_content %}
    <div class="dp-po">
        <main class="dp-po-main {% if main_class is defined %}{{ main_class }}{% endif %}">
            <div class="container">

                <div class="row">
                    <div class="col-sm-9">
                        <div class="dp-po-title">
                            <img src="{{ asset('img/page-icons/community.svg', 'help_center') }}">
                            <h2 class="dp-po-title-text">Community</h2>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-12">
                        <div class="dp-po-community-row">
                            <div class="dp-po-community-row-list">
                                {% for forum in community_forums %}
                                    {% set icon = forum.icon_property  %}
                                    {% set splash = forum.splash_image_property  %}
                                    <div class="dp-po-community-row-item {{ not splash ? 'dp-po-community-row-item-nocover' }}">
                                        <div class="dp-po-community-row-left" style="{% if splash %}background: url('{{ get_splash_url(forum) }}'){% endif %}">
                                            {% if icon %}
                                                <div class="dp-po-community-row-icon">
                                                    {{ render_icon_from(forum, {as_download_url: true, is_rounded: true}) }}
                                                </div>
                                            {% endif %}
                                            <h2 class="dp-po-community-row-title">{{ forum.title }}</h2>
                                            <p class="dp-po-community-row-description">{{ forum.description }}</p>
                                            <a href="" class="dp-po-community-row-btn">View 78 topics</a>
                                        </div>
                                        <div class="dp-po-community-row-right">
                                            <div class="dp-po-community-row-activity">
                                                <h3 class="dp-po-community-row-activity-heading">Recent activity</h3>
                                                <ul class="dp-po-community-row-activity-list">
                                                    <li class="dp-po-community-row-activity-item">
                                                        <a href="" class="dp-po-community-row-activity-link">
                                                            <img src="/portal-components/portal-style/static/img/docs/profile.png" class="dp-po-community-row-activity-img">
                                                            <h4 class="dp-po-community-row-activity-title">Allow the ability for Admins to rest and this
                                                                is the long content which is cropped
                                                            </h4>
                                                            <span class="dp-po-community-row-activity-time">23m</span>
                                                        </a>
                                                    </li>
                                                    <li class="dp-po-community-row-activity-item">
                                                        <a href="" class="dp-po-community-row-activity-link">
                                                            <img src="/portal-components/portal-style/static/img/docs/profile.png" class="dp-po-community-row-activity-img">
                                                            <h4 class="dp-po-community-row-activity-title">Allow the ability for Admins to restr ...
                                                            </h4>
                                                            <span class="dp-po-community-row-activity-time">23m</span>
                                                        </a>
                                                    </li>
                                                    <li class="dp-po-community-row-activity-item">
                                                        <a href="" class="dp-po-community-row-activity-link">
                                                            <img src="/portal-components/portal-style/static/img/docs/profile.png" class="dp-po-community-row-activity-img">
                                                            <h4 class="dp-po-community-row-activity-title">Allow the ability for Admins to restr ...
                                                            </h4>
                                                            <span class="dp-po-community-row-activity-time">23m</span>
                                                        </a>
                                                    </li>
                                                    <li class="dp-po-community-row-activity-item">
                                                        <a href="" class="dp-po-community-row-activity-link">
                                                            <img src="/portal-components/portal-style/static/img/docs/profile.png" class="dp-po-community-row-activity-img">
                                                            <h4 class="dp-po-community-row-activity-title">Allow the ability for Admins to restr ...
                                                            </h4>
                                                            <span class="dp-po-community-row-activity-time">23m</span>
                                                        </a>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}



                            </div>
                        </div>
                    </div>
                </div>


            </div>
        </main>
    </div>
{% endblock page_content %}
