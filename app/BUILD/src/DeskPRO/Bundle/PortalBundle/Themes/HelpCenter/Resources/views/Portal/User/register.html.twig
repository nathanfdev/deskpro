{% set cls = "column-half-plus wide" %}

{% block sidebar %}
{% endblock sidebar %}

{% extends 'Theme::layout.html.twig' %}
{% import 'Theme:Portal:User/macros.html.twig' as macros %}

{% block page_content %}
<div class="dp-po">
    <main class="dp-po-main dp-po-account-register">
        <div class="container">
            <div class="row">
                <div class="col-sm-7 col-centered">
                    <div class="dp-po-title">
                        <h1 class="dp-po-title-text">{{ phrase('helpcenter.account.section_title_register') }}</h1>
                    </div>
                    <div class="dp-po-section dp-po-block">
                        <section class="dp-po-loginform">
                            {{ form_start(form) }}
                            {{ form_widget(form) }}
                            {{ form_rest(form) }}
                            <button type="submit" class="btn btn-primary btn-lg">{{ phrase('helpcenter.account.register_action') }}</button>
                            {{ form_end(form) }}
                        </section>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
{% endblock page_content %}
