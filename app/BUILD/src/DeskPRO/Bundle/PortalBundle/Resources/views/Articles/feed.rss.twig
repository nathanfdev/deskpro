<?xml version="1.0" encoding="UTF-8" ?>
<rss version="2.0">
    <channel>
        {% if category %}
            <title>{{ brand_setting('core.deskpro_name')|e }} - {{ category.full_title  }}</title>
            <description>{{ brand_setting('core.deskpro_name')|e }} - {{ category.full_title }}</description>
            <link>{{ url('portal_kb_browse', { slug: category.slug }) }}</link>
        {% else %}
            <title>{{ brand_setting('core.deskpro_name')|e }} - {{ phrase('portal.articles.section-title') }}</title>
            <description>{{ brand_setting('core.deskpro_name')|e }} - {{ phrase('portal.articles.section-title') }}</description>
            <link>{{ url('portal_kb') }}</link>
        {% endif %}
        <lastBuildDate>{{ 'now'|date('r') }}</lastBuildDate>
        <pubDate>{{ 'now'|date('r') }}</pubDate>
        <ttl>1800</ttl>
        {% for article in pager %}
            <item>
                <title>{{ article.title }}</title>
                <description>{{ article.content }}</description>
                <link>{{ url('portal_kb_view', { slug: article.slug }) }}</link>
                <guid>{{ url('portal_kb_view', { slug: article.id }) }}</guid>
                <pubDate>{{ article.date_updated|date('r') }}</pubDate>
            </item>
        {% endfor %}
    </channel>
</rss>
