{% extends 'AdminInterfaceBundle:Layout:fullpage-pane.html.twig' %}
{% block fullpane_content %}
	<form class="form-horizontal dp-form" role="form" name="form_props" ng-submit="Ctrl.save()">
	<section class="dp-paneblock dp-listpane">
	<header>
		<h3>Domain / URL Setup</h3>
	</header>

	<article>
		<div class="panel panel-innertable">
			<p>
				Every DeskPRO account comes with a free domain name (yours is {{ constant('DPC_SITE_DOMAIN') }}). But if you want to use your own domain name,
				you can configure that here.
			</p>
		</div>
	</article>

	{##################################################################################################}

	<article class="form-horizontal dp-form">
		<div class="panel panel-innertable">
			<div class="panel-heading">
				<label>
					<input type="radio" ng-model="form.domain_choice" value="default" style="display: inline-block; margin-right: 5px;" />
					<h3 style="display: inline-block">
						<span>No custom domain</span>
					</h3>
				</label>
			</div>
		</div>

		<div class="panel panel-innertable">
			<div class="panel-heading">
				<label>
					<input type="radio" ng-model="form.domain_choice" value="custom" style="display: inline-block; margin-right: 5px;" />
					<h3 style="display: inline-block">
						<span>
							Use a custom domain <em ng-show="form.cloud_custom_domain.length">(https://{{ ng_var('form.cloud_custom_domain') }}/)</em>
						</span>
					</h3>
				</label>
			</div>
			<div class="form-group" style="margin-left: 45px;">
				<div ng-show="form.domain_choice == 'custom'" style="margin-top: 5px;">
					<p>
						Even when you use a custom domain name, your default domain still works. If your domain expires or something else happens that renders your custom domain inactive&mdash;you can always come back to this page by entering the
						admin interface directly through <code>https://{{ constant('DPC_SITE_DOMAIN') }}/admin/</code> (it's a good idea to write that down, just in case).
					</p>
					<p>
						Enter your domain name here: https://<input type="text" ng-model="form.cloud_custom_domain" class="form-control input-sm" placeholder="support.example.com" style="width: 180px;" />/
					</p>
					<div style="margin-top: 5px; background: #d8edf6; padding: 8px; width: 560px;">
						<p>
							<strong>Important</strong>: You must edit your DNS to create a <code>CNAME</code> record to <code>{{ constant('DPC_SITE_DOMAIN') }}</code>
						</p>
						<p>
							You must create this CNAME record before trying to save this setting. You will get an error message below if you attempt to use a custom domain that is not configured with the CNAME.
						</p>
						<p>
							For more information, refer to <a href="http://support.deskpro.com/kb/articles/79-using-a-custom-domain-name" target="_blank">this DeskPRO knowledgebase article</a>.
						</p>
					</div>
				</div>
			</div>
		</div>
	</article>

	{##################################################################################################}

	<footer>
		<div class="dp-content">
			<div class="text-danger" ng-show="form_error || ma_error_message" ng-switch="form_error">
				<p>
					There was a problem saving your settings:
				</p>
				<ul>
					<li ng-switch-when="invalid_custom_domain">
						The custom domain you entered appears to be invalid.
					</li>
					<li ng-switch-when="error_activating_domain">
						There was a problem while trying to activate your custom domain. This is most likely a
						temporary issue; try again in a few minutes.
					</li>
					<li ng-switch-when="ma_error_message">
						{{ ng_var('ma_error') }}
					</li>
					<li ng-switch-default>
						There was a server error (code: {{ ng_var('form_error') }}) while trying to save
						your custom domain. If you continue to have this problem, please contact <a href="mailto:support@deskpro.com">support@deskpro.com</a>.
					</li>
				</ul>
			</div>
			<div class="text-info" ng-show="ma_pending_message" style="text-align: center;">
				<strong>{{ ng_var('ma_pending_message') }}</strong>
			</div>
			<div class="dp-btn-controls">
				<div dp-hide-spinning="saving">
					<button class="btn btn-primary" dp-submit-form>{{ phrase('agent.general.save') }}</button>
				</div>
				<div dp-show-spinning="saving">
					<i class="spinner-flat"></i>
				</div>
			</div>
		</div>
	</footer>
	</section>
	</form>

	{% if not app.isCloud() %}
		<div style="text-align: right; font-size: 11px; margin: 10px;">
			<a href="{{ ng_href('setup.settings_advanced') }}">View advanced settings editor &rarr;</a>
		</div>
	{% endif %}

	<div dp-register-message="saved_settings">Settings saved successfully.</div>
{% endblock %}
