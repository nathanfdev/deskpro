{
	"require": {
		"kriswallsmith/assetic": "1.1.*",
		"aws/aws-sdk-php": "2.3.*",
		"doctrine/common": "~2.4",
		"doctrine/dbal": "~2.4",
		"doctrine/orm": "~2.4",
		"doctrine/migrations": "dev-master",
		"doctrine/doctrine-fixtures-bundle": "dev-master",
		"facebook/php-sdk": "3.2.*",
		"guzzle/guzzle": "3.4.*",
		"imagine/imagine": "0.5.*",
		"mockery/mockery": "dev-master",
		"monolog/monolog": ">=1.0.0",
		"pda/pheanstalk": "2.1.*",
		"leth/ip-address": "dev-master",
		"symfony/symfony": "~2.3",
		"symfony/monolog-bundle": "*",
		"doctrine/doctrine-bundle": "*",
		"symfony/swiftmailer-bundle": "*",
		"swiftmailer/swiftmailer": ">=4.3",
		"twig/twig": "~1.14",
		"zendframework/zendframework": "2.0.*",
		"zendframework/zend-queue": "dev-master",
		"squizlabs/php_codesniffer": "1.4.7",
		"phpmd/phpmd": "1.5.0",
		"satooshi/php-coveralls": "~0.6",
		"codeception/codeception": "*",
		"erusev/parsedown": "dev-master",
		"deskpro/deskpro-api-php": "dev-master"
	},
	"scripts": {
		"pre-update-cmd":   ["test -d vendor && rm -rf vendor/ || true", "mkdir vendor"],
		"pre-install-cmd":  ["test -d vendor && rm -rf vendor/ || true", "mkdir vendor", "test -f composer.lock && rm composer.lock || true"],
		"post-update-cmd":  ["rm -rf vendor/**/.git", "rm -rf vendor/**/**/.git", "rm -rf vendor/**/**/**.git", "rm -rf vendor/**/**/**/**.git"],
 		"post-install-cmd": ["rm -rf vendor/**/.git", "rm -rf vendor/**/**/.git", "rm -rf vendor/**/**/**.git", "rm -rf vendor/**/**/**/**.git"]
	},
	"preferred-install": "dist"
}