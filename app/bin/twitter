#!/usr/bin/env php
<?php
if (php_sapi_name() != 'cli') {
	echo "This script must only be run using the command line interface of PHP\n";
	echo "Contact support@deskpro.com if you require assistance.\n";
	exit(1);
}

declare(ticks=1);

define('DP_ROOT', realpath(__DIR__ . '/../'));
require_once DP_ROOT.'/sys/autoload.php';
require_once DP_ROOT.'/config.php';

$env = 'dev';
if (isset($_SERVER['argv'][1])) {
	$env = trim($_SERVER['argv'][1]);
}

// fork process for each Twitter account
$bootstrap = function() use ($CONFIG, $env) {
	return \Doctrine\DBAL\DriverManager::getConnection($CONFIG['db']);
};

$pids = array();
$fork = function(array $account) use (&$pids, $bootstrap) {
	// fork process
	$pid = pcntl_fork();

	/**
	 * FAILURE
	 */
	if (-1 === $pid) {
		@error_log(sprintf("spawning child process failed (account: %d)\n", $account['id']));

	/**
	 * PARENT
	 */
	} else if (0 < $pid) {
		// store pid, continue
		$pids[$account['id']] = $pid;
		return;

	/**
	 * CHILD
	 */
	} else {
		// initialize User Stream consumer
		$consumer = new \Orb\Service\Phirehose\UserStream($account['oauth_token'], $account['oauth_token_secret']);
		$consumer->setConnection($bootstrap());
		$consumer->setAccount($account);

		// start consuming
		$consumer->consume();

		exit(0);
	}
};

define('TWITTER_CONSUMER_KEY', \Orb\Service\Twitter\Oauth::getConsumerKey());
define('TWITTER_CONSUMER_SECRET', \Orb\Service\Twitter\Oauth::getConsumerSecret());

// open database connection
$connection = $bootstrap();

$timer = 0;
while (true) {
	if (0 == $timer || 0 == $timer % 60) {
		$query = "SELECT * FROM twitter_accounts";
		if (count($pids) > 0) {
			$query .= sprintf(" WHERE id NOT IN (%s)", implode(',', array_keys($pids)));
		}

		foreach ($connection->fetchAll($query) as $account) {
			if (!in_array($account['id'], array_keys($pids))) {
				$fork($account);
			}
		}

		$connection->close();
	}

	if (0 == $timer || 0 == $timer % 600) {
		$timer = 0;
		echo sprintf(
			"pid: %d (forks: %d)\n  time: %s\n  memory: %s KB (peak: %s KB)\n",
			getmypid(), count($pids), date('r'),
			number_format((memory_get_usage(true) / 1024), 0, ',', '.'),
			number_format(memory_get_peak_usage(true) / 1024, 0, ',', '.')
		);
	}

	sleep(1);
	$timer++;
}
