#!/bin/bash

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd $SCRIPT_DIR
cd ..

if [ -d build ]; then
	echo "Resetting build files"
	rm -rf build
	echo "--> Done"
fi

mkdir build

IS_ERROR=0

echo ""
echo "=========================="
echo "Running Unit Tests"
echo "=========================="
echo ""

bin/codecept run unit

if [[ $? -ne 0 ]] ; then
	echo "!!! Unit Test Failure !!!"
	IS_ERROR=1
fi

if [ $IS_ERROR -ne 1 ] ; then

	# phpunit will have created cache dirs owned by the cli user
	# but we'll be making web requests now, so we need to make sure
	# the web server can write too
	sudo chmod -R 0777 ../sys/cache

	echo ""
	echo "========================"
	echo "Running Acceptance Tests"
	echo "========================"
	echo ""

	bin/codecept run acceptance -g StateTests

	if [[ $? -ne 0 ]] ; then
		echo "!!! Behat Test Failure !!!"
		IS_ERROR=1
	fi
fi

if [ $IS_ERROR -ne 0 ] ; then
	exit 1
fi
exit 0