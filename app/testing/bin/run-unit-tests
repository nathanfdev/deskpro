#!/bin/bash

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd $SCRIPT_DIR
cd ..

IS_ERROR=0

echo ""
echo "=========================="
echo "Running Unit Tests"
echo "=========================="
echo ""

bin/codecept run unit --steps

if [[ $? -ne 0 ]] ; then
	echo "!!! Unit Test Failure !!!"
	IS_ERROR=1
fi

if [ $IS_ERROR -ne 0 ] ; then
	exit 1
fi
exit 0