#!/usr/bin/env php
<?php
define('DP_BOOT_MODE', 'testing');
require(__DIR__. '/../../../index.php');
require(__DIR__. '/../src/DpTestEnv.php');
DpTestEnv::init();

$db = DpTestEnv::getContainer()->getDb();
$db_names = $db->fetchAllCol("SHOW DATABASES");
$db_names[] = DP_DATABASE_NAME;

foreach ($db_names as $db_name) {
	if (strpos($db_name, 'dp_test_') === 0) {
		echo "DROP DATABASE $db_name ... ";
		$db->exec("DROP DATABASE IF EXISTS $db_name");
		echo "Done\n";
	}
}

echo "Removing testing/data/dbset-cache ... ";
$db_set_cache = DP_ROOT.'/testing/data/dbset-cache';
`rm -rf $db_set_cache`;
echo "Done\n";

echo "Installing FreshDb into deskpro_testing ... ";

require_once(DP_ROOT . '/testing/data/DpDbSets/AbstractDbSet.php');
require_once(DP_ROOT . '/testing/data/DpDbSets/FreshDb.php');
$set = new \DpDbSets\FreshDb(\DpTestEnv::getContainer());

unset($GLOBALS['DP_TESTING_USEDB']);

$cache_path = DP_ROOT.'/testing/data/dbset-cache';
if (!is_dir($cache_path)) {
	mkdir($cache_path, 0777, true);
	chmod($cache_path, 0777);
}
$set->enableCache(
	$cache_path,
	'mysql',
	'mysqldump'
);
$set->install(true);
echo " Done\n";