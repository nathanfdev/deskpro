INSERT INTO `report_builder` VALUES (1,NULL,'article-views-date-x-grouped-date','Number of article views <1:date group, default: this_month> grouped by date <chart:line>','','DISPLAY TABLE, LINE\nSELECT COUNT() AS \'Views\'\nFROM articles\nWHERE articles.views.date_created = %1:DATE_GROUP%\nGROUP BY ALIAS(DATE(articles.views.date_created), \'Date\')',0,'kb',40),(2,NULL,'average-chat-length-chats-created-group-x','Average chat length for chats created <1:date group, default: this_month> grouped by <2:field group:chats, default: agent>','','DISPLAY TABLE, BAR\r\nSELECT AVG(chat_conversations.total_to_ended) / 60 AS \'Average Length (Minutes)\'\r\nFROM chat_conversations\r\nWHERE chat_conversations.date_created = %1:DATE_GROUP% AND chat_conversations.is_agent = 0 AND chat_conversations.status = \'ended\' AND chat_conversations.total_to_ended > 0\r\nGROUP BY %2:FIELD_GROUP:chats:chat_conversations%',0,'chat',30),(3,NULL,'average-time-first-re-tickets-created-date-group-x','Average time to first response in tickets created <1:date group, default: this_month> grouped by <2:field group:tickets> <chart:bar>','','DISPLAY TABLE, BAR\nSELECT AVG(UNIX_TIMESTAMP(tickets.date_first_agent_reply) - UNIX_TIMESTAMP(tickets.date_created)) / (60 * 60) AS \'Average Time (Hours)\', COUNT() AS \'Total Tickets\'\nFROM tickets\nWHERE tickets.date_created = %1:DATE_GROUP% AND tickets.date_first_agent_reply <> NULL\nGROUP BY %2:FIELD_GROUP:tickets%',0,'ticket',120),(4,NULL,'average-time-resolve-tickets-date-group-by-x','Average time to resolve tickets <1:date group, default: this_month> grouped by <2:field group:tickets> <chart:bar>','','DISPLAY TABLE, BAR\nSELECT AVG(UNIX_TIMESTAMP(tickets.date_resolved) - UNIX_TIMESTAMP(tickets.date_created)) / (60 * 60) AS \'Average Time (Hours)\', COUNT() AS \'Total Tickets\'\nFROM tickets\nWHERE tickets.status IN (\'resolved\', \'closed\') AND tickets.date_resolved = %1:DATE_GROUP% AND tickets.date_resolved <> NULL\nGROUP BY %2:FIELD_GROUP:tickets%',0,'ticket',100),(5,NULL,'average-total-wait-tickets-resolve-date-group-by-x','Average total waiting time for tickets resolved <1:date group, default: this_month> grouped by <2:field group:tickets> <chart:bar>','','DISPLAY TABLE, BAR\nSELECT AVG(tickets.total_user_waiting) / (60 * 60) AS \'Total Waiting Time (Hours)\', COUNT() AS \'Total Tickets\'\nFROM tickets\nWHERE tickets.status IN (\'resolved\', \'closed\') AND tickets.date_resolved = %1:DATE_GROUP%\nGROUP BY %2:FIELD_GROUP:tickets%',0,'ticket',110),(6,NULL,'feedback-views-date-x-grouped-date','Number of feedback views <1:date group, default: this_month> grouped by date <chart:line>','','DISPLAY TABLE, LINE\r\nSELECT COUNT() AS \'Views\'\r\nFROM feedback\r\nWHERE feedback.views.date_created = %1:DATE_GROUP%\r\nGROUP BY ALIAS(DATE(feedback.views.date_created), \'Date\')',0,'feedback',40),(7,NULL,'most-active-tickets-status-created-date','Most active tickets <1:status group:tickets, default: awaiting_agent> created <2:date group, default: this_month>','','DISPLAY TABLE\nSELECT tickets_messages.ticket.subject, COUNT() AS \'Messages\', tickets_messages.ticket.person, tickets_messages.ticket.department, tickets_messages.ticket.date_created, tickets_messages.ticket.agent\nFROM tickets_messages\nWHERE %1:STATUS_GROUP:tickets:tickets_messages.ticket% AND tickets_messages.ticket.date_created = %2:DATE_GROUP%\nGROUP BY tickets_messages.ticket.id\nORDER BY COUNT() DESC\nLIMIT 100',0,'ticket',210),(8,NULL,'most-popular-email-domains-ticket-usage','Most popular email domains by ticket usage','','DISPLAY TABLE\nSELECT COUNT() AS \'Total Uses\'\nFROM tickets\nGROUP BY tickets.person_email.email_domain\nORDER BY COUNT() DESC\nLIMIT 100',0,'person',0),(9,NULL,'most-popular-people-email-domains','Most popular primary email domains','','DISPLAY TABLE\nSELECT COUNT() AS \'Total People\'\nFROM people\nGROUP BY people.primary_email.email_domain\nORDER BY COUNT() DESC\nLIMIT 100',0,'person',0),(10,NULL,'number-article-com-created-date-group-by-article','Number of article comments created <1:date group, default: this_month> grouped by article <2:field group:articles, default: person> <chart:bar>','','DISPLAY TABLE, BAR\nSELECT COUNT() AS \'Comments Created\'\nFROM article_comments\nWHERE article_comments.date_created = %1:DATE_GROUP%\nGROUP BY %2:FIELD_GROUP:articles:article_comments.article%',0,'kb',30),(11,NULL,'number-article-comments-created-date-group-by-x','Number of article comments created <1:date group, default: this_month> grouped by <2:field group:article_comments, default: none> <chart:bar>','','DISPLAY TABLE, BAR\r\nSELECT COUNT() AS \'Comments Created\'\r\nFROM article_comments\r\nWHERE article_comments.date_created = %1:DATE_GROUP%\r\nGROUP BY %2:FIELD_GROUP:article_comments%',0,'kb',20),(12,NULL,'number-articles-created-date-group-by-x','Number of articles created <1:date group, default: this_month> grouped by <2:field group:articles, default: person> <chart:bar>','','DISPLAY TABLE, BAR\nSELECT COUNT() AS \'Entries Created\'\nFROM articles\nWHERE articles.date_created = %1:DATE_GROUP%\nGROUP BY %2:FIELD_GROUP:articles%',0,'kb',10),(13,NULL,'number-chats-created-date-grouped-by-x','Number of chats created <1:date group, default: this_month> grouped by <2:field group:chats, default: agent> <chart:bar>','','DISPLAY TABLE, BAR\nSELECT COUNT() AS \'Chats Created\'\nFROM chat_conversations\nWHERE chat_conversations.date_created = %1:DATE_GROUP% AND chat_conversations.is_agent = 0\nGROUP BY %2:FIELD_GROUP:chats:chat_conversations%',0,'chat',10),(14,NULL,'number-chats-missed-date-grouped-by-x','Number of chats missed <1:date group, default: this_month> grouped by <2:field group:chats, default: department> <chart:bar>','','DISPLAY TABLE, BAR\r\nSELECT COUNT() AS \'Chats Created\'\r\nFROM chat_conversations\r\nWHERE chat_conversations.date_created = %1:DATE_GROUP% AND chat_conversations.is_agent = 0 AND chat_conversations.agent_id = NULL\r\nGROUP BY %2:FIELD_GROUP:chats:chat_conversations%',0,'chat',20),(15,NULL,'number-feedback-com-created-date-group-by-feedback','Number of feedback comments created <1:date group, default: this_month> grouped by feedback <2:field group:feedback, default: type> <chart:bar>','','DISPLAY TABLE, BAR\r\nSELECT COUNT() AS \'Comments Created\'\r\nFROM feedback_comments\r\nWHERE feedback_comments.date_created = %1:DATE_GROUP%\r\nGROUP BY %2:FIELD_GROUP:feedback:feedback_comments.feedback%',0,'feedback',30),(16,NULL,'number-feedback-comments-created-date-group-by-x','Number of feedback comments created <1:date group, default: this_month> grouped by <2:field group:feedback_comments, default: none> <chart:bar>','','DISPLAY TABLE, BAR\r\nSELECT COUNT() AS \'Comments Created\'\r\nFROM feedback_comments\r\nWHERE feedback_comments.date_created = %1:DATE_GROUP%\r\nGROUP BY %2:FIELD_GROUP:feedback_comments%',0,'feedback',20),(17,NULL,'number-feedback-created-date-group-by-x','Number of feedback entries created <1:date group, default: this_month> grouped by <2:field group:feedback, default: type> <chart:bar>','','DISPLAY TABLE, BAR\nSELECT COUNT() AS \'Entries Created\'\nFROM feedback\nWHERE feedback.date_created = %1:DATE_GROUP%\nGROUP BY %2:FIELD_GROUP:feedback%',0,'feedback',10),(18,NULL,'number-feedback-votes-submitted-date-x-group-y','Number of feedback votes submitted <1:date group, default: this_month> grouped by <2:field group:feedback, default: type> <chart:bar>','','DISPLAY TABLE, BAR\r\nSELECT COUNT() AS \'Ratings\'\r\nFROM feedback\r\nWHERE feedback.ratings.date_created = %1:DATE_GROUP%\r\nGROUP BY %2:FIELD_GROUP:feedback%',0,'feedback',60),(19,NULL,'number-ticket-messages-written-agent-day','Number of ticket messages written per agent per [day]','','DISPLAY TABLE\nSELECT COUNT() AS \'Total Messages\'\nFROM tickets_messages\nWHERE tickets_messages.person.is_agent = 1\nSPLIT BY tickets_messages.person\nGROUP BY CONCAT(DAYOFMONTH(tickets_messages.date_created), \' \', MONTHNAME(tickets_messages.date_created), \' \', YEAR(tickets_messages.date_created)) AS \'Period\'\nORDER BY YEAR(tickets_messages.date_created) DESC, MONTH(tickets_messages.date_created) DESC, DAYOFMONTH(tickets_messages.date_created) DESC',0,'ticket',140),(20,NULL,'number-ticket-messages-written-agent-month','Number of ticket messages written per agent per [month]','','DISPLAY TABLE\nSELECT COUNT() AS \'Total Messages\'\nFROM tickets_messages\nWHERE tickets_messages.person.is_agent = 1\nSPLIT BY tickets_messages.person\nGROUP BY CONCAT(MONTHNAME(tickets_messages.date_created), \' \', YEAR(tickets_messages.date_created)) AS \'Period\'\nORDER BY YEAR(tickets_messages.date_created) DESC, MONTH(tickets_messages.date_created) DESC',0,'ticket',140),(21,NULL,'number-ticket-messages-written-agent-week','Number of ticket messages written per agent per [week]','','DISPLAY TABLE\nSELECT COUNT() AS \'Total Messages\'\nFROM tickets_messages\nWHERE tickets_messages.person.is_agent = 1\nSPLIT BY tickets_messages.person\nGROUP BY CONCAT(\'Week \', WEEKOFYEAR(tickets_messages.date_created), \', \', YEAR(tickets_messages.date_created)) AS \'Period\'\nORDER BY YEAR(tickets_messages.date_created) DESC, MONTH(tickets_messages.date_created) DESC, WEEKOFYEAR(tickets_messages.date_created) DESC',0,'ticket',140),(22,NULL,'number-ticket-messages-written-agent-year','Number of ticket messages written per agent per [year]','','DISPLAY TABLE\nSELECT COUNT() AS \'Total Messages\'\nFROM tickets_messages\nWHERE tickets_messages.person.is_agent = 1\nSPLIT BY tickets_messages.person\nGROUP BY YEAR(tickets_messages.date_created) AS \'Period\'\nORDER BY YEAR(tickets_messages.date_created) DESC',0,'ticket',140),(23,NULL,'number-tickets-created-date-grouped-by-date-and-x','Number of tickets created <1:date group, default: this_month> grouped by date created & <2:field group:tickets, default: none> <chart:area>','','DISPLAY TABLE, AREA\nSELECT COUNT() AS \'Tickets Created\'\nFROM tickets\nWHERE tickets.date_created = %1:DATE_GROUP%\nGROUP BY ALIAS(DATE(tickets.date_created), \'Date Created\'), %2:FIELD_GROUP:tickets%',0,'ticket',15),(24,NULL,'number-tickets-created-date-grouped-by-x-y','Number of tickets created <1:date group, default: this_month> grouped by <2:field group:tickets, default: department> & <3:field group:tickets, default: agent> <chart:bar>','','DISPLAY TABLE, BAR\nSELECT COUNT() AS \'Total Tickets\'\nFROM tickets\nWHERE tickets.date_created = %1:DATE_GROUP%\nGROUP BY MATRIX(%2:FIELD_GROUP:tickets%, %3:FIELD_GROUP:tickets%)',0,'ticket',10),(25,NULL,'number-tickets-created-date-grouped-first-agent-x','Number of tickets created <1:date group, default: this_month> grouped by first agent response time & <2:field group:tickets, default: none> <chart:bar>','','DISPLAY TABLE, BAR\nSELECT COUNT() AS \'Total Tickets\'\nFROM tickets\nWHERE tickets.date_created = %1:DATE_GROUP%\nGROUP BY MATRIX(ALIAS(DATE_OFFSET_GROUP(NOW(), tickets.date_first_agent_reply), \'Time Waiting\'), %2:FIELD_GROUP:tickets%)',0,'ticket',90),(26,NULL,'number-tickets-resolved-date-grouped-time-res-x','Number of tickets resolved <1:date group, default: this_month> grouped by time to resolution & <2:field group:tickets, default: none> <chart:bar>','','DISPLAY TABLE, BAR\nSELECT COUNT() AS \'Total Tickets\'\nFROM tickets\nWHERE tickets.status IN (\'resolved\', \'closed\') AND tickets.date_resolved = %1:DATE_GROUP%\nGROUP BY MATRIX(ALIAS(DATE_OFFSET_GROUP(tickets.date_resolved, tickets.date_created), \'Time To Resolve\'), %2:FIELD_GROUP:tickets%)',0,'ticket',80),(27,NULL,'number-tickets-resolved-date-grouped-total-wait-x','Number of tickets resolved <1:date group, default: this_month> grouped by total waiting time & <2:field group:tickets, default: none> <chart:bar>','','DISPLAY TABLE, BAR\nSELECT COUNT() AS \'Total Tickets\'\nFROM tickets\nWHERE tickets.status IN (\'resolved\', \'closed\') AND tickets.date_resolved = %1:DATE_GROUP%\nGROUP BY MATRIX(ALIAS(DATE_OFFSET_GROUP(tickets.total_user_waiting), \'Time Waiting\'), %2:FIELD_GROUP:tickets%)',0,'ticket',70),(28,NULL,'number-tickets-resolved-date-grouped-x-y','Number of tickets resolved <1:date group, default: this_month> grouped by <2:field group:tickets, default: department> & <3:field group:tickets, default: agent> <chart:bar>','','DISPLAY TABLE, BAR\nSELECT COUNT() AS \'Total Tickets\'\nFROM tickets\nWHERE tickets.date_resolved = %1:DATE_GROUP% AND tickets.status IN (\'resolved\', \'closed\')\nGROUP BY MATRIX(%2:FIELD_GROUP:tickets%, %3:FIELD_GROUP:tickets%)',0,'ticket',30),(29,NULL,'number-tickets-status-grouped-by-x-y','Number of tickets <1:status group:tickets, default: awaiting_agent> grouped by <2:field group:tickets, default: department> & <3:field group:tickets, default: agent> <chart:bar>','','DISPLAY TABLE, BAR\nSELECT COUNT() AS \'Total Tickets\'\nFROM tickets\nWHERE %1:STATUS_GROUP:tickets%\nGROUP BY MATRIX(%2:FIELD_GROUP:tickets%, %3:FIELD_GROUP:tickets%)',0,'ticket',20),(30,NULL,'number-tickets-wait-agent-grouped-time-wait-ag-x','Number of tickets awaiting agent grouped by time awaiting agent and <1:field group:tickets, default: none> <chart:bar>','','DISPLAY TABLE, BAR\nSELECT COUNT() AS \'Total Tickets\'\nFROM tickets\nWHERE tickets.status = \'awaiting_agent\'\nGROUP BY MATRIX(ALIAS(DATE_OFFSET_GROUP(NOW(), tickets.date_user_waiting), \'Time Waiting\'), %1:FIELD_GROUP:tickets%)',0,'ticket',50),(31,NULL,'number-tickets-wait-agent-grouped-total-wait-x','Number of tickets awaiting agent grouped by total waiting time and <1:field group:tickets, default: none> <chart:bar>','','DISPLAY TABLE, BAR\nSELECT COUNT() AS \'Total Tickets\'\nFROM tickets\nWHERE tickets.status = \'awaiting_agent\'\nGROUP BY MATRIX(ALIAS(DATE_OFFSET_GROUP(tickets.total_user_waiting), \'Time Waiting\'), %1:FIELD_GROUP:tickets%)',0,'ticket',60),(32,NULL,'number-views-per-article-date-x','Number of views per article <1:date group, default: this_month>','','DISPLAY TABLE\r\nSELECT articles.title, COUNT() AS \'Views\'\r\nFROM articles\r\nWHERE articles.views.date_created = %1:DATE_GROUP%\r\nGROUP BY articles.id\r\nORDER BY COUNT() DESC',0,'kb',50),(33,NULL,'number-views-per-feedback-date-x','Number of views per feedback entry <1:date group, default: this_month>','','DISPLAY TABLE\r\nSELECT feedback.title, COUNT() AS \'Views\'\r\nFROM feedback\r\nWHERE feedback.views.date_created = %1:DATE_GROUP%\r\nGROUP BY feedback.id\r\nORDER BY COUNT() DESC',0,'feedback',50),(34,NULL,'organizations-longest-total--wait','[Organizations] with longest total waiting time','','DISPLAY TABLE\nSELECT SUM(tickets.total_user_waiting) / (60 * 60) AS \'Total Wait (Hours)\', COUNT() AS \'Total Tickets\', AVG(tickets.total_user_waiting) / (60 * 60) AS \'Average Wait (Hours)\'\nFROM tickets\nGROUP BY tickets.organization\nORDER BY SUM(tickets.total_user_waiting) DESC\nLIMIT 100',0,'ticket',200),(35,NULL,'organizations-longest-total-first-reply-wait','[Organizations] with longest total first reply waiting time','','DISPLAY TABLE\nSELECT SUM(tickets.total_to_first_reply) / (60 * 60) AS \'Total Wait (Hours)\', COUNT() AS \'Total Tickets\', AVG(tickets.total_to_first_reply) / (60 * 60) AS \'Average Wait (Hours)\'\nFROM tickets\nGROUP BY tickets.organization\nORDER BY SUM(tickets.total_to_first_reply) DESC\nLIMIT 100',0,'ticket',190),(36,NULL,'people-longest-total--wait','[People] with longest total waiting time','','DISPLAY TABLE\nSELECT SUM(tickets.total_user_waiting) / (60 * 60) AS \'Total Wait (Hours)\', COUNT() AS \'Total Tickets\', AVG(tickets.total_user_waiting) / (60 * 60) AS \'Average Wait (Hours)\'\nFROM tickets\nGROUP BY tickets.person\nORDER BY SUM(tickets.total_user_waiting) DESC\nLIMIT 100',0,'ticket',200),(37,NULL,'people-longest-total-first-reply-wait','[People] with longest total first reply waiting time','','DISPLAY TABLE\nSELECT SUM(tickets.total_to_first_reply) / (60 * 60) AS \'Total Wait (Hours)\', COUNT() AS \'Total Tickets\', AVG(tickets.total_to_first_reply) / (60 * 60) AS \'Average Wait (Hours)\'\nFROM tickets\nGROUP BY tickets.person\nORDER BY SUM(tickets.total_to_first_reply) DESC\nLIMIT 100',0,'ticket',190),(38,NULL,'percent-ticket-create-date-resolved-24hour-group-x','Percentage of tickets created <1:date group, default: this_month> resolved within 24 hours, grouped by <2:field group:tickets> <chart:bar>','','DISPLAY TABLE, BAR\nSELECT PERCENT(tickets.date_resolved <> NULL AND UNIX_TIMESTAMP(tickets.date_resolved) - UNIX_TIMESTAMP(tickets.date_created) < 24 * 60 * 60) AS \'Percentage\'\nFROM tickets\nWHERE tickets.date_created = %1:DATE_GROUP%\nGROUP BY %2:FIELD_GROUP:tickets%',0,'ticket',131),(39,NULL,'percent-tickets-created-date-replied-hour-group-x','Percentage of tickets created <1:date group, default: this_month> replied to within an hour, grouped by <2:field group:tickets> <chart:bar>','','DISPLAY TABLE, BAR\nSELECT PERCENT(tickets.total_to_first_reply < 3600) AS \'Percentage\'\nFROM tickets\nWHERE tickets.date_created = %1:DATE_GROUP% AND tickets.total_to_first_reply > 0\nGROUP BY %2:FIELD_GROUP:tickets%',0,'ticket',130),(40,NULL,'percent-tickets-created-date-res-1-agent-group-x','Percentage of tickets created <1:date group, default: this_month> resolved by first response, grouped by <2:field group:tickets, default: agent> <chart:bar>','','DISPLAY TABLE, BAR\nSELECT PERCENT(tickets.count_agent_replies = 1) AS \'Percentage\'\nFROM tickets\nWHERE tickets.date_created = %1:DATE_GROUP% AND tickets.date_resolved <> NULL AND tickets.count_agent_replies > 0\nGROUP BY %2:FIELD_GROUP:tickets%',0,'ticket',135),(41,NULL,'sla-date-groupby-x','SLA Statuses for tickets created <1:date group, default: this_month> grouped by <2:field group:tickets, default: agent> <chart:bar>','','DISPLAY TABLE, BAR\nSELECT COUNT() AS \'Total Tickets\'\nFROM tickets\nWHERE tickets.date_created = %1:DATE_GROUP% AND tickets.ticket_slas.sla_status IN (\'ok\', \'warning\', \'fail\')\nGROUP BY %2:FIELD_GROUP:tickets%, tickets.ticket_slas.sla_status',0,'ticket',96),(42,NULL,'sla-status-date-splitby-x','SLA Statuses for tickets created <1:date group, default: this_month> split by <2:field group:tickets, default:sla> <chart:pie>','','DISPLAY TABLE, PIE\nSELECT COUNT() AS \'Total Tickets\'\nFROM tickets\nWHERE tickets.date_created = %1:DATE_GROUP% AND tickets.ticket_slas.sla_status IN (\'ok\', \'warning\', \'fail\')\nSPLIT BY %2:FIELD_GROUP:tickets%\nGROUP BY tickets.ticket_slas.sla_status',0,'ticket',95),(43,NULL,'tickets-awaiting-agent-split-by-field-ordered-by-x','Tickets awaiting agent split by <1:field group:tickets> ordered by <2:order group:tickets>','','DISPLAY TABLE\nSELECT tickets.id, tickets.subject, tickets.person, tickets.department, tickets.date_created, tickets.agent\nFROM tickets\nWHERE tickets.status = \'awaiting_agent\'\nSPLIT BY %1:FIELD_GROUP:tickets%\nORDER BY %2:ORDER_GROUP:tickets%\nLIMIT 100',0,'ticket',40),(44,NULL,'tickets-created-date-grouped-labels','Tickets created <1:date group, default: this_month> grouped by labels','','DISPLAY TABLE, BAR\nSELECT COUNT() AS \'Total Tickets\'\nFROM tickets\nWHERE tickets.labels.label <> NULL AND tickets.date_created = %1:DATE_GROUP%\nGROUP BY tickets.labels',0,'ticket',170),(45,NULL,'tickets-resolved-date-grouped-by-agent-resolving','Tickets resolved <1:date group, default: this_month> grouped by agent resolving ticket','','DISPLAY TABLE\nSELECT COUNT_DISTINCT(tickets_log.ticket_id) AS \'Tickets Resolved\'\nFROM tickets_log\nWHERE tickets_log.action_type = \'changed_status\' AND tickets_log.id_after = 200 AND tickets_log.ticket.status IN (\'resolved\', \'closed\') AND tickets_log.date_created = %1:DATE_GROUP%\nGROUP BY ALIAS(IF(tickets_log.person.is_agent, tickets_log.person, \'Non-Agent\'), \'Person\')\nORDER BY @\'Tickets Resolved\' DESC\nLIMIT 100',0,'ticket',160),(46,NULL,'tickets-split-by-labels','Tickets split by labels','','DISPLAY TABLE\nSELECT tickets.id, tickets.subject, tickets.person, tickets.department, tickets.date_created, tickets.agent\nFROM tickets\nWHERE tickets.labels.label <> NULL\nSPLIT BY tickets.labels\nORDER