#!/usr/bin/env php
<?php

$_SERVER['argv'][0] = str_replace('import', 'console', $_SERVER['argv'][0]);
if (isset($_SERVER['argv'][1])) {
    if (in_array($_SERVER['argv'][1], ['verify', 'apply', 'clean'])) {
        array_splice($_SERVER['argv'], 1, 1, ['import:'.$_SERVER['argv'][1]]);
    } else {
        array_splice($_SERVER['argv'], 1, 0, ['import']);
    }
}

$_SERVER['argv'][] = '--kernel';
$_SERVER['argv'][] = 'api';

require __DIR__.'/../app/run/targets/console.php';
