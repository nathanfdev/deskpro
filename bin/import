#!/usr/bin/env php
<?php

$_SERVER['argv'][0] = str_replace('import', 'console', $_SERVER['argv'][0]);

$actions = ['verify', 'apply', 'clean'];
if (array_intersect($_SERVER['argv'], $actions)) {
    foreach ($_SERVER['argv'] as &$arg) {
        if (in_array($arg, $actions)) {
            $arg = 'dp:import:'.$arg;
        }
    }
} else {
    array_splice($_SERVER['argv'], 1, 0, ['dp:import']);
}

$_SERVER['argv'][] = '--kernel';
$_SERVER['argv'][] = 'api';

require __DIR__.'/../app/run/targets/console.php';
