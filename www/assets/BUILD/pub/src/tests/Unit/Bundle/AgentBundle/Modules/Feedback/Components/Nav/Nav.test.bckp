// #define ~root DeskPRO/Bundle/AgentBundle/Modules/Feedback
// #define ~nav DeskPRO/Bundle/AgentBundle/Modules/Feedback/Components/Nav

jest.dontMock('~nav/Nav');

import React from 'react';
import ReactDOM from 'react-dom';
import { renderInFeedbackApp } from '../../feedback.test-helper';
import { IntlProvider } from 'react-intl';

describe('Feedback Navigation: Nav component', () => {
  const Nav = require('~nav/Nav').Nav;
  const Pending = require('~nav/Pending').Pending;
  const StatusTab = require('~nav/StatusTab').StatusTab;
  const TypeTab = require('~nav/TypeTab').TypeTab;
  const CategoryTab = require('~nav/CategoryTab').CategoryTab;
  const LoadIndicator = require('DeskPRO/Component/LoadIndicator').LoadIndicator;
  const intlProvider = new IntlProvider({ locale: 'en' }, {});
  const {intl} = intlProvider.getChildContext();
  let component;
  let node;

  function render(isLoaded = true) {
    component = renderInFeedbackApp({}, <Nav isLoaded={isLoaded} intl={intl}/>);
    node = ReactDOM.findDOMNode(component);
  }

  it("should render a spinner while data aren't loaded", () => {
    spyOn(LoadIndicator.prototype, 'render').and.callThrough();
    render(false);
    expect(LoadIndicator.prototype.render).toHaveBeenCalled();
  });

  it("shouldn't render pending while data aren't loaded", () => {
    spyOn(Pending.prototype, 'render');
    render(false);
    expect(Pending.prototype.render).not.toHaveBeenCalled();
  });

  it('should render "Feedback" header', () => {
    render();

    const h1 = node.querySelector('h1');
    expect(h1.textContent).toEqual('Feedback');
  });

  it('should render Pending section', () => {
    spyOn(Pending.prototype, 'render');

    render();

    expect(Pending.prototype.render).toHaveBeenCalled();
  });

  it('should render Status tab', () => {
    spyOn(StatusTab.prototype, 'render');

    render();

    expect(StatusTab.prototype.render).toHaveBeenCalled();
  });

  it('should render Type tab', () => {
    spyOn(TypeTab.prototype, 'render');

    render();

    expect(TypeTab.prototype.render).toHaveBeenCalled();
  });

  it('should render Category tab', () => {
    spyOn(CategoryTab.prototype, 'render');

    render();

    expect(CategoryTab.prototype.render).toHaveBeenCalled();
  });
});
