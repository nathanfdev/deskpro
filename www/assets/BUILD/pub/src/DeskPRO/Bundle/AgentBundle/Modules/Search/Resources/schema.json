{
  "description": "schema of a search query",
  "type": "array",
  "items": {
    "type": "object",
    "oneOf": [
      { "$ref": "#/definitions/op" },
      { "$ref": "#/definitions/set" },
      { "$ref": "#/definitions/exactValue" },
      { "$ref": "#/definitions/dateTime" },
      { "$ref": "#/definitions/numericRange" }
    ],
    "required": ["type", "value"]
  },
  "definitions": {
    "op": {
      "properties": {
        "type": {
          "enum": ["OP_AND", "OP_OR", "OP_NOT"]
        },
        "meta": {
          "type": "object",
          "properties": {
            "isExplicit": {
              "type": "boolean"
            }
          }
        },
        "value": {
          "type": "array",
          "items": {
            "type": "object",
            "oneOf": [
              { "$ref": "#/definitions/op" },
              { "$ref": "#/definitions/set" },
              { "$ref": "#/definitions/exactValue" },
              { "$ref": "#/definitions/dateTime" },
              { "$ref": "#/definitions/numericRange" }
            ],
            "required": ["type"]
          }
        }
      },
      "additionalProperties": false
    },
    "set": {
      "properties": {
        "type": {
          "type": "string"
        },
        "op": {
          "enum": ["ISSET", "NOT_ISSET"]
        }
      },
      "additionalProperties": false
    },
    "exactValue": {
      "properties": {
        "type": {
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        "op": {
          "enum": ["EQ", "NEQ", "LT", "LTE", "GT", "GTE", "IN", "NOT_IN"]
        },
        "meta": {
          "type": "array"
        }
      },
      "required": ["type", "value"],
      "additionalProperties": false
    },
    "dateTime": {
      "properties": {
        "type": {
          "type": "string"
        },
        "value": {
          "type": "object",
          "oneOf": [
            { "$ref": "#/definitions/dateTime/definitions/dateTimePreset" },
            { "$ref": "#/definitions/dateTime/definitions/dateTimeAbsolute" }
          ],
          "required": ["inputType"]
        },
        "op": {
          "enum": ["EQ", "NEQ", "LT", "LTE", "GT", "GTE", "IN", "NOT_IN"]
        }
      },
      "additionalProperties": false,
      "definitions": {
        "dateTimePreset": {
          "properties": {
            "inputType": {
              "enum": ["preset"]
            },
            "preset": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "dateTimeAbsolute": {
          "properties": {
            "inputType": {
              "enum": ["absolute"]
            },
            "date": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "numericRange": {
      "properties": {
        "type": {
          "type": "string"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "additionalProperties": false
    }
  }
}