{
  "presets": [
    "babel-preset-es2015",
    "babel-preset-react",
    "babel-preset-stage-0"
  ],
  "plugins": [
    ["babel-plugin-transform-decorators-legacy", "babel-plugin-transform-flow-strip-types"],
    ["babel-plugin-react-intl", {"messagesDir": "./build/messages/"}],
    ["babel-plugin-namespace", {
      "namespaces": {
        "DeskPRO": "src/DeskPRO/",
        "Ampliflux": "src/DeskPRO/Component/Ampliflux/",
        "Helpers": "src/tests/Helpers/",
        "Visual": "src/tests/Visual/",
        "DemoState": "src/tests/DemoState/"
      }
    }]
  ]
}
