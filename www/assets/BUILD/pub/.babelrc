{
  "presets": ["es2015", "react", "stage-0"],
  "plugins": [
    ["transform-decorators-legacy"],
    ["react-intl", {"messagesDir": "./build/messages/"}],
    ["namespace", {
      "namespaces": {
        "DeskPRO": "src/DeskPRO/",
        "Ampliflux": "src/DeskPRO/Component/Ampliflux/",
        "Helpers": "src/tests/Helpers/"
      }
    }]
  ]
}
