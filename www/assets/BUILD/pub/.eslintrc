{
  "extends": "airbnb",
  "env": {
    "browser": true,
    "mocha": true,
    "node": true,
    "jest": true,
    "jasmine": true
  },
  "parser": "babel-eslint",
  "rules": {
    "max-len": [
      1,
      {
        "code": 120
      }
    ],
    "react/no-multi-comp": 0,
    "jsx-quotes": [
      2,
      "prefer-double"
    ],
    "react/jsx-closing-bracket-location": [
      2,
      "after-props"
    ],
    "react/jsx-indent-props": 0,
    "react/prefer-stateless-function": 0,
    "react/jsx-space-before-closing": [
      2,
      "never"
    ],
    "react/jsx-uses-react": 2,
    "react/jsx-uses-vars": 2,
    "react/react-in-jsx-scope": 2,
    "no-var": 2,
    "vars-on-top": 0,
    "comma-dangle": 0,
    "new-cap": 0,
    "no-console": 0,
    "indent": [
      2,
      2,
      {
        "SwitchCase": 1
      }
    ],
    "valid-jsdoc": 2
  },
  "plugins": [
    "react"
  ]
}
