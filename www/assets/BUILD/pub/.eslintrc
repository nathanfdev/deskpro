{
  "extends": ["eslint:recommended", "plugin:react/recommended", "airbnb"],
  "env": {
    "browser": true,
    "mocha": true,
    "node": true,
    "jest": true,
    "jasmine": true
  },
  "parser": "babel-eslint",
  "rules": {
    "max-len": [
      1,
      {
        "code": 120,
        "ignoreComments": true,
        "ignoreUrls": true,
        "ignorePattern": "^import\\s.+"
      }
    ],
    "react/no-multi-comp": 0,
    "jsx-quotes": [
      2,
      "prefer-double"
    ],
    "key-spacing": [
      2,
      {
        "singleLine": {
          "beforeColon": false,
          "afterColon": true
        },
        "multiLine": {
          "beforeColon": false,
          "afterColon": true,
          "align": "value"
        }
      }
    ],
    "no-multi-spaces": [
      2,
      {
        "exceptions": {
          "VariableDeclarator": true
        }
      }
    ],
    "react/prefer-stateless-function": 0,
    "react/jsx-uses-react": 2,
    "react/jsx-uses-vars": 2,
    "react/react-in-jsx-scope": 2,
    "no-var": 2,
    "vars-on-top": 0,
    "comma-dangle": 0,
    "new-cap": 0,
    "no-console": 0,
    "indent": [
      2,
      2,
      {
        "SwitchCase": 1
      }
    ],
    "valid-jsdoc": 2
  },
  "plugins": [
    "react",
    "jsx-a11y"
  ],
  "settings": {
    "react": {
      "version": "0.14.8"
      // React version, default to the latest React stable release
    }
  },
  "parserOptions": {
    "ecmaFeatures": {
      "jsx": true
    }
  }
}
