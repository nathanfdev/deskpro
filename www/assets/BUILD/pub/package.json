  "jest": {
    "testDirectoryName": "tests/Unit",
    "cacheDirectory": "./.jest-cache",
    "scriptPreprocessor": "./jest-preprocessor",
    "setupEnvScriptFile": "./jest-env",
    "unmockedModulePathPatterns": [
      "react",
      "/node_modules/",
      "/tests/Helpers/",
      "/tests/DemoState/",
      "/Selectors/",
      "/Actions/",
      "/Reducers/",
      "/Constants/",
      "/DAL/",
      "/AgentBundle/AgentApp",
      "index.js",
      "/Application/Components/",
      "/Common/Components/",
      "/DeskPRO/Component/",
      "/DAL/",
      "/RecordsStore/",
      "App_Reducers.js",
      ".test-helper.js"
    ],
    "testFileExtensions": [
      "es6",
      "js"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "es6"
    ],
    "globals": {
      "__DEV__": true
    }
  },
  "private": true,
  "scripts": {
    "eslint": "eslint src || true",
    "eslint-pre-commit": "eslint",
    "eslint-fix": "eslint --fix",
    "resources:copy": "cpx \"src/**/Resources/**/*.{gif,png,jpg,svg,mp3,ogg,wav}\" build",
    "gulp-dev-all": "npm run-script resources:copy && node bin/refresh-widget-loader && npm run-script gulp-refresh-reducers && node bin/dev-server",
    "dev": "npm run-script resources:copy && node bin/refresh-widget-loader && && npm run-script gulp-refresh-reducers node bin/dev-server",
    "prod": "npm run-script webpack && npm run-script resources:copy",
    "gulp-prod": "npm run-script webpack && npm run-script resources:copy",
    "build:prod": "npm run-script webpack && npm run-script resources:copy",
    "gulp-refresh-reducers": "node ./build-tools/app-reducer-gen/refresh_reducers.js",
    "test:unit": "jest",
    "test:visual": "start-storybook -p 9001 -s src/tests/Visual/Resources",
    "test:visual:build": "build-storybook -o build/storybook",
    "test:e2e": "nightwatch",
    "test:e2e:setup": "node selenium-download.js",
    "flow": "flow; test $? -eq 0 -o $? -eq 2",
    "webpack": "rm -rf ./build && npm run-script gulp-refresh-reducers && node bin/refresh-widget-loader && webpack --config webpack.prod.config.js --progress --profile --colors --display-error-details"
  }
}
