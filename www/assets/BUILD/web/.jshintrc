{
  "asi": true,
  "bitwise": true,
  "curly": false,
  "eqeqeq": false,
  "esversion": 5,
  "expr": true,
  "eqnull": true,
  "forin": true,
  "freeze": true,
  "funcscope": true,
  "laxbreak": true,
  "laxcomma": true,
  "node": true,
  "noarg": true,
  "noempty": true,
  "nonew": true,
  "shadow": true,
  "strict": "implied",
  "sub": true,
  "undef": true,
  "predef": [
    "document",
    "window",
    "$",
    "jQuery",
    "DeskPRO",
    "DeskPRO_Window",
    "Orb",
    "BASE_URL",
    "DESKPRO_PERSON_ID"
  ]
}
