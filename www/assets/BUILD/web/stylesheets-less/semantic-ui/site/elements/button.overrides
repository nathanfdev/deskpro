/*******************************
         Site Overrides
*******************************/
.ui.basic.buttons .button,
.ui.basic.button {
  border: 1px solid @dp-greyscale-250;
}
.ui.basic.buttons .button:focus,
.ui.basic.button:focus {
  border: 1px solid @dp-greyscale-350;
}

.ui.buttons.state-buttons > .ui.button.active:not(.basic):not(.inverted), .ui.buttons.state-buttons:not(.basic):not(.inverted) > .button.active {

}

.ui.basic.buttons .button:hover,
.ui.basic.button:hover {
  border-color: @dp-sonic-primary;

}
.ui.basic.buttons .button:active,
.ui.basic.button:active,
.ui.basic.buttons .active.button,
.ui.basic.active.button {
  border-color: @dp-sonic-primary;

}

.ui.positive.buttons .button,
.ui.positive.button {

}
