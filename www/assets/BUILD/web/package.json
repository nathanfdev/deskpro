{
  "name": "DeskPRO",
  "version": "1.0.0",
  "dependencies": {
    "angular-ui-select2": "0.0.5",
    "Select2": "^3.5.7",
    "clipboard": "^1.5.12"
  },
  "devDependencies": {
    "autoprefixer": "^6.3.6",
    "babel": "^6.5.2",
    "babel-eslint": "^6.1.1",
    "babel-loader": "^6.2.4",
    "babel-preset-es2015": "^6.9.0",
    "babel-preset-stage-0": "^6.5.0",
    "bower": "^1.5.2",
    "coffee-loader": "^0.7.2",
    "coffee-script": "1.9.1",
    "coffeelint": "^1.15.7",
    "cpx": "^1.3.1",
    "del": "1.1.1",
    "exports-loader": "^0.6.3",
    "expose-loader": "^0.7.1",
    "extract-text-webpack-plugin": "^1.0.1",
    "imports-loader": "^0.6.5",
    "jshint": "^2.9.2",
    "karma": "0.12.24",
    "karma-chrome-launcher": "0.1.5",
    "karma-jasmine": "0.2.3",
    "kss": "^3.0.0-beta.14",
    "less": "^2.3.1",
    "less-loader": "^2.2.3",
    "node-sass": "3.8.0",
    "path": "^0.12.7",
    "postcss-cli": "^2.5.2",
    "postcss-discard-comments": "^2.0.4",
    "sassdoc": "^2.1.18",
    "semantic-ui-less": "^2.1.8",
    "webpack": "^1.13.1"
  },
  "scripts": {
    "bower-install": "bower install --config.interactive=false --allow-root",
    "coffeelint": "coffeelint",
    "jshint": "jshint",
    "sassdoc": "node sassdoc/transform2json.js",
    "copy": "cpx \"app/**/*.js\" compiled --clean",
    "coffee-compile": "coffee -c -o compiled/ app/",
    "css:sass": "node-sass -r --source-map true -o app-build/styles/Admin app/**/Resources/style/*-style.scss",
    "css:less": "lessc --source-map -rp=app/Admin/Resources/style/../../../ app/**/Resources/style/admin-style.less app-build/styles/Admin/admin-style.css",
    "build:css": "npm run css:sass && npm run css:less",
    "semantic:copy": "postcss --use autoprefixer --autoprefixer.browsers 'last 2 versions' --use postcss-discard-comments --postcss-discard-comments.removeAll true -d app-build/styles/Admin/ stylesheets-less/semantic-ui/semantic.css",
    "presemantic": "cpx \"stylesheets-less/semantic-ui/theme.config\" node_modules/semantic-ui-less/",
    "semantic": "npm run semantic:copy",
    "prebuild": "npm run copy && npm run coffee-compile && npm run build:css && npm run semantic",
    "build": "webpack --progress --colors",
    "postbuild": "npm run sassdoc"
  }
}
