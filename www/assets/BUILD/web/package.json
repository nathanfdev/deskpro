{
  "name": "DeskPRO",
  "version": "1.0.0",
  "dependencies": {
    "angular-ui-select2": "0.0.5",
    "Select2": "^3.5.7",
    "clipboard": "^1.5.12"
  },
  "devDependencies": {
    "autoprefixer": "^6.3.6",
    "bower": "^1.5.2",
    "coffee-loader": "^0.7.2",
    "coffee-script": "1.9.1",
    "coffeelint": "^1.15.7",
    "cpx": "^1.3.1",
    "del": "1.1.1",
    "exports-loader": "^0.6.3",
    "expose-loader": "^0.7.1",
    "extract-text-webpack-plugin": "^1.0.1",
    "gulp": "3.9.0",
    "gulp-cached": "1.0.2",
    "gulp-clean": "0.3.1",
    "gulp-coffee": "2.3.1",
    "gulp-debug": "2.0.0",
    "gulp-file-include": "0.8.0",
    "gulp-if": "1.2.5",
    "gulp-less": "3.0.0",
    "gulp-plumber": "0.6.6",
    "gulp-postcss": "^6.1.1",
    "gulp-r": "1.1.3",
    "gulp-rename": "1.2.0",
    "gulp-requirejs": "^0.1.3",
    "gulp-sass": "^2.0.4",
    "gulp-sourcemaps": "1.3.0",
    "gulp-using": "0.0.1",
    "gulp-util": "3.0.3",
    "gulp-watch": "4.1.1",
    "gulp-watch-less": "0.2.1",
    "imports-loader": "^0.6.5",
    "jshint": "^2.9.2",
    "karma": "0.12.24",
    "karma-chrome-launcher": "0.1.5",
    "karma-jasmine": "0.2.3",
    "kss": "^3.0.0-beta.14",
    "lazypipe": "0.2.2",
    "less": "^2.3.1",
    "less-loader": "^2.2.3",
    "node-sass": "3.7.0",
    "path": "^0.12.7",
    "postcss-cli": "^2.5.2",
    "postcss-discard-comments": "^2.0.4",
    "run-sequence": "1.0.2",
    "sassdoc": "^2.1.18",
    "semantic-ui-less": "^2.1.8",
    "webpack": "^1.13.1"
  },
  "scripts": {
    "bower-install": "bower install --config.interactive=false --allow-root",
    "coffeelint": "coffeelint",
    "jshint": "jshint",
    "gulp-prod": "gulp prod",
    "gulp": "gulp",
    "sassdoc": "gulp sassdoc",
    "copy": "cpx \"app/**/*.js\" compiled --clean",
    "coffee-compile": "coffee -c -o compiled/ app/",
    "css:sass": "node-sass -r --source-map true -o styles/Admin app/**/Resources/style/*-style.scss",
    "css:less": "lessc --source-map app/**/Resources/style/admin-style.less styles/Admin/less-style.css",
    "build:css": "npm run css:sass && npm run css:less",
    "semantic:copy": "postcss --use autoprefixer --autoprefixer.browsers 'last 2 versions' --use postcss-discard-comments --postcss-discard-comments.removeAll true -d styles/Admin/ stylesheets-less/semantic-ui/semantic.css",
    "presemantic": "cpx \"stylesheets-less/semantic-ui/theme.config\" node_modules/semantic-ui-less/",
    "semantic": "npm run semantic:copy",
    "prebuild": "npm run copy && npm run coffee-compile && npm run build:css && npm run semantic",
    "build": "webpack --progress --colors"
  }
}
