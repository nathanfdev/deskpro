{
  "name": "DeskPRO",
  "description": "Client-side scripts for DeskPRO",
  "version": "1.0.0",
  "dependencies": {
    "react": "15.1.0",
    "react-dom": "15.1.0",
    "angular-ui-select2": "0.0.5",
    "Select2": "^3.5.7",
    "clipboard": "^1.5.12"
  },
  "devDependencies": {
    "@kadira/storybook": "^1.1.0",
    "autoprefixer": "^6.3.6",
    "babel": "^6.5.2",
    "babel-eslint": "^6.1.1",
    "babel-loader": "^6.2.4",
    "babel-preset-es2015": "^6.9.0",
    "babel-preset-stage-0": "^6.5.0",
    "bower": "^1.5.2",
    "coffee-script": "1.10.0",
    "coffeelint": "^1.15.7",
    "cors": "^2.7.1",
    "cpx": "^1.3.1",
    "css-loader": "^0.23.1",
    "del": "1.1.1",
    "exports-loader": "^0.6.3",
    "expose-loader": "^0.7.1",
    "express": "^4.14.0",
    "extract-text-webpack-plugin": "^1.0.1",
    "file-loader": "^0.9.0",
    "gulp": "^3.9.1",
    "gulp-file-include": "^0.13.7",
    "gulp-if": "^2.0.1",
    "gulp-requirejs": "^0.1.3",
    "gulp-using": "^0.1.1",
    "imports-loader": "^0.6.5",
    "jshint": "^2.9.2",
    "karma": "0.12.24",
    "karma-chrome-launcher": "0.1.5",
    "karma-jasmine": "0.2.3",
    "kss": "^3.0.0-beta.14",
    "less": "^2.3.1",
    "less-loader": "^2.2.3",
    "node-sass": "^3.8.0",
    "onchange": "^2.5.0",
    "parallelshell": "^2.0.0",
    "path": "^0.12.7",
    "postcss-cli": "^2.5.2",
    "postcss-discard-comments": "^2.0.4",
    "raw-loader": "^0.5.1",
    "sass-loader": "^4.0.0",
    "sassdoc": "^2.1.18",
    "semantic-ui-less": "^2.1.8",
    "strip-loader": "^0.1.2",
    "style-loader": "^0.13.1",
    "webpack": "^1.13.1",
    "webpack-dev-middleware": "^1.6.1",
    "webpack-hot-middleware": "^2.12.1",
    "webpack-notifier": "^1.3.0"
  },
  "scripts": {
    "bower-install": "bower install --config.interactive=false --allow-root",
    "coffeelint": "coffeelint",
    "jshint": "jshint",
    "clean": "rimraf app-build && rimraf loader-build",
    "sassdoc": "node sassdoc/transform2json.js",
    "copy:js": "cpx \"app/**/*.js\" compiled --clean",
    "compile:coffee": "coffee -c -o compiled/ app/",
    "build:sass": "node-sass -r --source-map true -o app-build/styles/Admin app/**/Resources/style/*-style.scss",
    "build:less": "lessc --source-map -rp=app/Admin/Resources/style/../../../ app/**/Resources/style/admin-style.less app-build/styles/Admin/admin-style.css",
    "build:semantic-less": "lessc --source-map  node_modules/semantic-ui-less/semantic.less stylesheets-less/semantic-ui/semantic.css",
    "build:css": "npm run build:sass && npm run build:less",
    "semantic:copy": "postcss --use autoprefixer --autoprefixer.browsers 'last 2 versions' --use postcss-discard-comments --postcss-discard-comments.removeAll true -d app-build/styles/Admin/ stylesheets-less/semantic-ui/semantic.css",
    "presemantic": "cpx \"stylesheets-less/semantic-ui/theme.config\" node_modules/semantic-ui-less/",
    "semantic": "npm run semantic:copy",
    "prebuild": "npm run clean && npm run copy:js && npm run compile:coffee && npm run semantic",
    "postbuild": "npm run sassdoc",
    "tmp:old-agent": "cpx \"compiled/Agent/**/*.js\" \"app-build/Agent\" && cpx \"compiled/DeskPRO/**/*.js\" \"app-build/DeskPRO\" && gulp prod",
    "build:prod": "npm run prebuild && webpack --progress --colors --display-error-details --config webpack-prod.config.js -p && npm run tmp:old-agent && npm run postbuild",
    "build:dev": "npm run prebuild && webpack --progress --colors --display-error-details && npm run tmp:old-agent && npm run postbuild",
    "watch:webpack": "node webpack.server.js",
    "watch:coffee": "coffee -o compiled/ -cw app/",
    "watch:js": "cpx \"app/**/*.js\" compiled -w -v",
    "watch": "parallelshell 'npm run watch:js' 'npm run watch:coffee' 'npm run watch:webpack'",
    "test:visual": "start-storybook -p 9001 -s ."
  }
}
