a.dpw--panel-button {
  display: inline-block;
  text-transform: uppercase;
  font-size: 11px;
  font-weight: bold;
  background: #62ad8c;
  line-height: 1em;
  padding: 10px;
  color: #fff;
  border-radius: 2px;
  text-decoration: none;
}

// Code for all panels generated by dropdowns
.dpw-navigation-dropdown-panel {
  background: #fff;
  box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.2);
  margin-top: 10px;
  position: absolute;
  z-index: 1999;
  border: 1px solid #62ad8c;
  border-radius: 2px;
  padding-top: 0px;
  padding: 0px;

  .dpw-navigation-dropdown-header {
    background: #fff;
    color: #424242;
    border-bottom: 1px solid #d6d8da;
    padding: 10px 5px;
    font-size: 14px;

    > .fa {
      position: relative;
      color: #cbc6c6;
      margin-right: 5px;
      top: 0px;
    }

    .dpw-navigation-dropdown-header-options {
      float: right;
      display: block;
      width: 16px;
      height: 16px;
      background: #e5e5e5;
      border-radius: 2px;
      margin-right: 5px;

      font-size: 9px;
      text-align: center;
      color: #a3a3a3;
      padding-top: 3px;

      &:hover {
        background: #62ad8c;
        color: #fff;
      }
    }
  }

  .dpw-navigation-dropdown-mini-header {
    padding: 5px 5px 10px 5px;
    display: block;
    line-height: 1em;
    color: #9a9a9a;
  }

  .dpw-navigation-dropdown-panel-text-content {
    p {
      font-size: 11px;
      padding: 0px;
      margin: 0px;
      line-height: 1.7em;
    }
  }

  hr {
    margin: 0px;
    padding: 0px;
    background: #dcddde;
    border: 0;
    width: 100%;
    height: 1px;
  }

  &.dpw-navigation-dropdown-panel-corner-left {
    @include add-corner(4px, #62ad8c, 15px, left, nohover);// navigation-mixins.scss
  }

  .dpw-navigation-dropdown-panel-content {
    .dpw-navigation-dropdown-panel-content-line {
      margin-bottom: 3px;
      &:last-child { margin-bottom: 0px; }
      &:after { // Clearfix
        content: "";
        display: table;
        clear: both;
      }
    }

    .dpw-navigation-dropdown-panel-content-left, .dpw-navigation-dropdown-panel-content-right, .dpw-navigation-dropdown-panel-content-full {
      padding: 5px 5px;
    }

    .dpw-navigation-dropdown-panel-content-left.even, .dpw-navigation-dropdown-panel-content-right.even { width: 50%; }
    .dpw-navigation-dropdown-panel-content-left { float: left; }
    .dpw-navigation-dropdown-panel-content-right { float: right; }
    .dpw-navigation-dropdown-panel-content-of-three {// Three columns, same width
      padding: 5px 2px 5px 2px;
      width: 33.333333333333333333%;
      float: left;
      &:first-child { padding-left: 5px; }
      &:last-child { padding-right: 5px; }
    }

    .dpw-navigation-dropdown-panel-content-item {// An item in a content-*, inline
      display: inline-block;
      font-size: 11px;
      margin-right: 10px;
      &:last-child { margin-right: 0px; }
    }

    &.dpw-navigation-dropdown-panel-content-pale {
      background: #eef1f3;
    }
  }
}
