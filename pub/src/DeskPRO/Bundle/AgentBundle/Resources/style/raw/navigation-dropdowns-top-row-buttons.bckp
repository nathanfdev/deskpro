.ticket-controls-bulk-editing {
  transition: all 0.5s ease;
  width: 100%;
}

.ticket-controls-bulk-editing.expanded { width: 1000px; }

$nav-height: 27px;

.dpwd-navigation-top-row-mass-action-checkbox-container {
  height: $nav-height;
  width: $nav-height;
  border: 1px solid #e5e5e5;
  border-left: 0px;
  border-radius: 2px;
  border-top-left-radius: 0px;
  border-bottom-left-radius: 0px;
  position: absolute;
  left: 0px;
  top: 0px;

  .dpwd-navigation-top-row-mass-action-checkbox {
    border: 1px solid #9d9d9d;
    border-radius: 2px;
    width: 15px;
    height: 15px;
    text-align: center;
    margin: 0 auto;
    margin-top: 5px;
    cursor: pointer;

    i {
      font-size: 9px;
      color: #e4e4e4;
      position: relative;
      top: 1px;
    }
  }

  .dpwd-navigation-top-row-mass-action-checkbox.active i { color: #62ad8c; }

  .dpwd-navigation-top-row-mass-action-checkbox-count {
    display: block;
    width: 18px;
    height: 18px;
    text-align: center;
    border-radius: 19px;
    background: #9d9d9d;
    color: #e7e7e7;
    border: 2px solid #f6f6f6;
    position: absolute;
    bottom: -5px;
    right: -5px;

    span {
      font-size: 8px;
      font-weight: bold;
      position: relative;
      top: 2px;
    }
  }
}



.dpwd-navigation-dropdown-top-row {
  position: relative;
  padding-left: 35px;

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dpwd-navigation-dropdown-top-row-main-list {
    display: block;

    > li { display: inline-block; }

    > li > hr {
      display: inline-block;
      width: 1px;
      height: $nav-height;
      vertical-align: middle;
      border: 0px;
      padding: 0px;
      margin: 0px;
      background: #e5e5e5;
      margin-left: 4px;
      margin-right: 4px;
    }
  }

  // Mass action buttons
  .dpwd-navigation-dropdown-top-row-action-button {
    background: #d9d9d9;
    color: #777777;
    border: 0px;
    display: inline-block;
    vertical-align: middle;
    line-height: 1em;
    border-radius: 2px;
    text-decoration: none;
    font-size: 10px;
    text-transform: uppercase;
    font-weight: bold;
    position: relative;
    height: $nav-height;

    a {
      color: inherit;
      text-decoration: none;
    }

    .top-row-action-button-link {
      display: inline-block;
      position: relative;

      padding: 7px;
      padding-top: 8px;
      height: $nav-height;
      padding-right: 18px + 7px;
      border-radius: 2px;

      &:hover {
        background: #62ad8c;
        color: #fff;
      }
    }

    .top-row-action-button-link.active {
      background: #62ad8c;
      color: #fff;

      &:after {
        content: "";
        width: 0px;
        height: 0px;
        border: 5px solid rgba(0, 0, 0, 0.0);
        border-top: 5px solid #62ad8c;
        position: absolute;
        bottom: -10px;
        left: 50%;
        margin-left: -5px;
      }

      .top-row-action-button-link-extra { border-left: 1px solid #81bda3; }

    }

    .top-row-action-button-link-extra {
      width: 18px;
      height: $nav-height;
      text-align: center;
      position: absolute;
      top: 0px;
      right: 0px;
      padding: 7px 0px;
      padding-top: 8px;
      border-left: 1px solid #cecece;
    }



    .top-row-action-button-link:hover {
      background: #62ad8c;
      color: #fff;

      .top-row-action-button-link-extra { border-left: 1px solid #81bda3; }
    }

    .top-row-action-button-link:hover + .top-row-action-button-link-extra { border-left: 1px solid #62ad8c; }

    &.dpwd-navigation-dropdown-top-row-action-button-split {
      padding-right: 17px;
      .top-row-action-button-link {
        padding-right: 0px;
        padding-right: 7px;
        margin-right: 0px;
        border-top-right-radius: 0px;
        border-bottom-right-radius: 0px;
      }

      .top-row-action-button-link-extra {
        border-top-right-radius: 2px;
        border-bottom-right-radius: 2px;
        &:hover {
          background: #81bda3;
          color: #fff;
          border-left: 1px solid #81bda3;
        }
      }
    }

    &.dpwd-navigation-dropdown-top-row-action-button-flat {
      color: #fff;
      .top-row-action-button-link {
        margin-right: 0px;
        padding-right: 7px;
      }
    }
  }

  .dpwd-navigation-dropdown-top-row-button {
    background: #fff;
    color: #62ad8c;
    border: 1px solid #eaeaea;
    display: inline-block;
    vertical-align: middle;
    line-height: 1em;
    padding: 7px;
    border-radius: 2px;
    text-decoration: none;
    font-size: 11px;
    position: relative;
    height: $nav-height;

    .dpwd-navigation-dropdown-top-row-button-text { font-weight: bold; }

    .dpwd-navigation-dropdown-top-row-button-text-grey {
      color: #c2c2c2;
      font-weight: normal;
    }

    .dpwd-navigation-dropdown-top-row-button-icon { margin: 0px 3px; }
  }

  .dpwd-navigation-dropdown-top-row-button:hover, .dpwd-navigation-dropdown-top-row-button.active  {
    color: #fff;
    background: #62ad8c;
    border: 1px solid #62ad8c;

    &:after {
      content: "";
      width: 0px;
      height: 0px;
      border: 5px solid rgba(0, 0, 0, 0.0);
      border-top: 5px solid #62ad8c;
      position: absolute;
      bottom: -10px;
      left: 50%;
      margin-left: -5px;
    }

    .dpwd-navigation-dropdown-top-row-button-text-grey { color: #cde3d9; }
  }
}
