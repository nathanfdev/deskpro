{
  "stage": 0,
  "env": {
    "development": {
      "plugins": ["react-transform", "fbjs-scripts/babel/dev-expression"],
      "extra": {
        "react-transform": {
          "transforms": [
            {
              "transform": "react-transform-hmr",
              "imports": ["react"],
              "locals": ["module"]
            },
            {
              "transform": "react-transform-catch-errors",
              "imports": ["react", "redbox-react", "./redboxOptions"]
            }
          ]
        }
      }
    }
  }
}
