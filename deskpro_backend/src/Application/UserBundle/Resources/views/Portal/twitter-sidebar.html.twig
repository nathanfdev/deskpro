<div class="dp-sidebar-block dp-twitter-block">
	<div class="dp-box-header">
		<h3>
			<a href="http://twitter.com/{{ twitter_name }}">@{{ twitter_name }} on twitter</a>
		</h3>
	</div>
	<div class="dp-twitter-list">
		<ul>
			{% for item in feed_items %}
				<li>
					{{ item.description|raw }}
				</li>
			{% endfor %}
		</ul>
		<div class="dp-more">
			<a href="http://twitter.com/{{ twitter_name }}">View more from @{{ twitter_name }} &rarr;</a>
		</div>
	</div>
</div>
