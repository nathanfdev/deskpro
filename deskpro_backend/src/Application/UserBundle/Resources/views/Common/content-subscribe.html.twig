<div class="subscribe-box">
	{% if subscription %}
		{{ phrase('user.subscribed_to_page') }}
		<a href="{{ path('user_profile_subdel', {'type': page_type, 'id': page_id}) }}">{{ phrase('user.unsubscribe_link') }}</a>
		(<a href="{{ path('user_profile_subs') }}">{{ phrase('user.manage_all_subscriptions_link') }}</a>)
	{% else %}
		<a href="{{ path('user_profile_subadd', {'type': page_type, 'id': page_id}) }}">{{ phrase('user.subscribe_link') }}</a>
	{% endif %}
</div>
