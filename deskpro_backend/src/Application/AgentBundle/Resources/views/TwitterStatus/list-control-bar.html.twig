<header class="header">
    <div class="list-control-bar">
    	<ul class="order-by-menu" >
            <li>Sort by</li>
            <li><a class="button {% if sortByDate == 'asc' %}on{% endif %}" data-route="listpane:{{ path(twitter_list_route, {'account_id': account.id, 'sortbydate': 'asc' }) }}">Oldest First</a></li>
    		<li><a class="button {% if sortByDate == 'desc' %}on{% endif %}" data-route="listpane:{{ path(twitter_list_route, {'account_id': account.id, 'sortbydate': 'desc' }) }}">Newest First</a></li>
        </ul>

        <span>
            <input name="account" type="checkbox" />
            <label data-for="account">Show @{{ account.user.screen_name }}'s tweets</label>
        </span>
        <span>
            <input name="archived" type="checkbox" />
            <label data-for="archived">Show archived tweets</label>
        </span>
    </div>
</header>
