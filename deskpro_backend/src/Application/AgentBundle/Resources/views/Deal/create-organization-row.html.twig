<div class="add-new-org-container">
<div class="col">
	<h4>Name</h4>
	{% if organization.id %}
		{{ organization.name }}
	{% else %}
		<input type="text" name="newdeal[organizations][name]" class="name" value="{{ organization.name }}" />
	{% endif %}
</div>
<br class="clear" />
<footer>
   <button class="save-org-trigger clean-white small">Add organization</button>
   <button class="cancel-org-trigger clean-white small">Cancel</button>
</footer>
</div>
