{##################################}
{# People #}
{##################################}

<section class="source-section sys-filters-section">
	<header>
		<h1>{{ phrase('agent.people') }}</h1>
	</header>
	<article>
		<ul class="source-list" id="people_outline_people_list">
			<li class="people nav-people is-nav-item" id="people_nav_all">
				<h3 class="title auto-load-route " data-route="listpane:{{ path('agent_peoplesearch_customfilter') }}">
					<span class="list-counter">{{ people_count }}</span>
					{{ phrase('agent.people') }}
				</h3>
			</li>

			{% for id,title in usergroup_names %}
				<li
					class="usergroup-{{id}} nav-usergroup-{{id}} is-nav-item"
					id="people_nav_ug_{{id}}"
					data-usergroup-id="{{id}}"
					data-route="listpane:{{ path('agent_peoplesearch_customfilter') }}?terms[0][type]=person_usergroup&amp;terms[0][op]=is&amp;terms[0][usergroup]={{id}}"
				>
					<h3 class="title">
						<span class="list-counter">{{ usergroup_counts[id]|default(0) }}</span>
						{{title}}
					</h3>
				</li>
			{% endfor %}
		</ul>

		<section class="source-tabs" style="margin-top: 8px;">
			<ul>
				<li class="labels" ><span>{{ phrase('agent.labels') }}</span></li>
			</ul>
		</section>

		<section class="source-switcher-tabs spaced" id="people_outline_tabstrip" {% if not people_tag_index|length %}style="display:none"{% endif %}>
			<ul>
				<li data-tab-for="#people_outline_tagcloud" id="people_outline_tagcloud_tr" class="cloud on">{{ phrase('agent.labels_cloud') }}</li>
				<li data-tab-for="#people_outline_taglist" id="people_outline_taglist_tr" class="list">{{ phrase('agent.labels_list') }}</li>
			</ul>
		</section>

		<section class="source-labels-cloud deskpro-tab-item on" id="people_outline_tagcloud">
			{% include 'AgentBundle:PeopleSearch:window-people-label-cloud.html.twig' %}
		</section>

		<section class="source-labels-list deskpro-tab-item" id="people_outline_taglist">
			{% include 'AgentBundle:PeopleSearch:window-people-label-list.html.twig' %}
		</section>
	</article>
</section>

