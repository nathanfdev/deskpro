{% extends 'AdminBundle::layout.html.twig' %}
{% block pagetitle %}
	<h1>Settings</h1>
{% endblock %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/SettingsAdvanced.js') }}"></script>
<style type="text/css">
	.setting-input {
		background-color: #fff;
		border: 1px solid transparent;
		cursor: pointer;
		padding: 1px;
		width: 99%;
	}

	.setting-input:hover, .setting-input:focus {
		border: 1px solid #6D7985;
	}

	.setting-filter-form {
		float: right;
		font-size: 10px;
		font-weight: bold;
		padding: 1px 1px 0 0;
	}

	#settings_filter {
		margin-left: 8px;
		background-color: #fff;
		padding: 1px;
		border:  1px solid #979FAD;
		font-size: 10px;
		width: 150px;
	}
</style>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
	window.DeskPRO_Page = new DeskPRO.Admin.PageHandler.SettingsAdvanced();
}
</script>
{% endblock %}
{% block page %}

<div class="table-list-wrap">
	<div class="setting-filter-form">
		Filter: <input type="text" id="settings_filter" value="" />
	</div>
	<br class="clear" />
	<table class="table-list" cellspacing="0" cellpadding="0" width="100%">
		<thead>
			<tr>
				<th width="200">Name</th>
				<th>Default Value</th>
				<th>Set Value</th>
			</tr>
		</thead>
		<tbody id="settings_rows">
			{% for name,value in all_settings %}
				<tr>
					<td>{{name}}</td>
					<td><input class="setting-input" value="{{value}}" /></td>
					<td><input  value="{{ app.getSetting(name) }}" class="setting-input dp-set-value" data-setting-name="{{name}}" /></td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
</div>

{% endblock %}
