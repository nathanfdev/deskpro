{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block pagebar %}
	<ul>
		<li><a href="{{ path('admin_products') }}">Products</a></li>
		{% if product.id %}
			<li>Edit Product</li>
		{% else %}
			<li>New Product</li>
		{% endif %}
	</ul>
{% endblock %}
{% block page %}

<form action="{{ path('admin_products_edit', {'product_id': product.id|default(0)}) }}" method="post">
<input type="hidden" name="process" value="1" />

<div class="dp-form">
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Title</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.title) }}
		</div>
	</div>

	{% if form.parent %}
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>Parent Product</label>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.parent) }}
			</div>
		</div>
	{% endif %}
</div>

{{ form_rest(form) }}

<button class="btn primary save-trigger">Save</button>
</form>

{% if product.id %}
<div class="delete-link-wrap">
	<a href="{{ path('admin_products_del', {'product_id': product.id}) }}">delete</a>
</div>
{% endif %}
{% endblock %}
