{% extends 'AdminBundle::layout.html.twig' %}
{% set page_handler = 'DeskPRO.Admin.ElementHandler.TicketTriggersNewChoosePage' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/ElementHandler/TicketTriggersNewChoosePage.js') }}"></script>
{% endblock %}
{% block pagebar %}
	<ul>
		<li><a href="{{ path('admin_tickettriggers') }}">Triggers</a></li>
		<li>Choose Type</li>
	</ul>
{% endblock %}
{% block page %}

<p>
	Choose the event that should initiate the trigger
</p>

<form action="{{ path('admin_tickettriggers_edit', {'trigger_id': '0'}) }}" class="form" method="post" id="choice_form">

{% if with_urgency %}<input type="hidden" name="with-urgency" value="1" />{% endif %}

<ul class="item-list">
	<li>
		<input type="radio" name="trigger[event_trigger]" value="new_ticket" /> New Ticket
	</li>
	<li>
		<input type="radio" name="trigger[event_trigger]" value="new_reply" /> New Reply
	</li>
	<li>
		<input type="radio" name="trigger[event_trigger]" value="property_change" /> Ticket Updated
	</li>

	<li>
		<input type="radio" name="trigger[event_trigger]" value="time_open" />
		Ticket has been open for
		<span class="show-off">...</span>
		<span class="show-on">
			<input type="text" name="event_trigger_time" value="" size="10" style="width: 80px" class="small" />
			<select name="event_trigger_scale">
				{% for scale,label in {'minutes': 'Minutes', 'hours': 'Hours', 'days': 'Days', 'weeks': 'Weeks', 'months': 'Months'} %}
					<option value="{{ scale }}">{{ label }}</option>
				{% endfor %}
			</select>
		</span>
	</li>

	<li>
		<input type="radio" name="trigger[event_trigger]" value="time_user_waiting" /> The user has been waiting for an agent to reply for
		<span class="show-off">...</span>
		<span class="show-on">
			<input type="text" name="event_trigger_time" value="" size="10" style="width: 80px" class="small" />
			<select name="event_trigger_scale">
				{% for scale,label in {'minutes': 'Minutes', 'hours': 'Hours', 'days': 'Days', 'weeks': 'Weeks', 'months': 'Months'} %}
					<option value="{{ scale }}">{{ label }}</option>
				{% endfor %}
			</select>
		</span>
	</li>

	<li>
		<input type="radio" name="trigger[event_trigger]" value="time_total_user_waiting" /> The user has been waiting for a total of
		<span class="show-off">...</span>
		<span class="show-on">
			<input type="text" name="event_trigger_time" value="" size="10" style="width: 80px" class="small" />
			<select name="event_trigger_scale">
				{% for scale,label in {'minutes': 'Minutes', 'hours': 'Hours', 'days': 'Days', 'weeks': 'Weeks', 'months': 'Months'} %}
					<option value="{{ scale }}">{{ label }}</option>
				{% endfor %}
			</select>
		</span>
	</li>


	<li>
		<input type="radio" name="trigger[event_trigger]" value="time_agent_waiting" /> The agent has been waiting for the user to reply for
		<span class="show-off">...</span>
		<span class="show-on">
			<input type="text" name="event_trigger_time" value="" size="10" style="width: 80px" class="small" />
			<select name="event_trigger_scale">
				{% for scale,label in {'minutes': 'Minutes', 'hours': 'Hours', 'days': 'Days', 'weeks': 'Weeks', 'months': 'Months'} %}
					<option value="{{ scale }}">{{ label }}</option>
				{% endfor %}
			</select>
		</span>
	</li>

	<li>
		<input type="radio" name="trigger[event_trigger]" value="time_resolved" /> The ticket has been resolved for
		<span class="show-off">...</span>
		<span class="show-on">
			<input type="text" name="event_trigger_time" value="" size="10" style="width: 80px" class="small" />
			<select name="event_trigger_scale">
				{% for scale,label in {'minutes': 'Minutes', 'hours': 'Hours', 'days': 'Days', 'weeks': 'Weeks', 'months': 'Months'} %}
					<option value="{{ scale }}">{{ label }}</option>
				{% endfor %}
			</select>
		</span>
	</li>
</ul>

<br />
<button class="clean-white save-trigger">Continue &rarr;</button>

</form>
{% endblock %}
