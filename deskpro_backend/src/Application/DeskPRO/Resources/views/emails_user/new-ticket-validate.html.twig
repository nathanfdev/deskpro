{% extends 'DeskPRO:emails_user:layout.html.twig' %}
{% import 'DeskPRO:emails_user:layout-macros.html.twig' as layout %}
{% block content %}
	{{ layout.section_start('Validation required', 2) }}
		Thank you for your recent email "{{ticket.subject}}."
		Before our agents will read and reply to your email, you must validate your email address.
		<br /><br />
		Simply click on the following link to validate to your email address:<br />
		<a href="{{ url('user_validate_email', {'id': validating_email.id, 'auth': validating_email.auth}) }}">
			{{ url('user_validate_email', {'id': validating_email.id, 'auth': validating_email.auth}) }}
		</a>
	{{ layout.section_end() }}
{% endblock %}
