{% extends 'DeskPRO:emails_user:layout.html.twig' %}
{% import 'DeskPRO:emails_user:layout-macros.html.twig' as layout %}
{% block content %}
	{{ layout.section_start() }}
		An agent has reset your account password. You can log in with these credentials:
		<br /><br />
		<strong>URL: </strong> <a href="{{ url('user') }}">{{ url_display('user') }}</a><br />
