{% extends 'AdminBundle:Plugins:config.html.twig' %}
{% block inner_form %}

<div class="setting_field_row">
	<h4>API Configuration</h4>
	<div class="setting_fields">
		<div class="field_row">
			<label>Joomla URL</label>
			<input type="text" name="settings[joomla_url]" value="{{ app.getSetting(plugin.id ~ '.joomla_url') }}" style="width: 50%; padding: 5px" />
			<p>This is the URL to your Joomla site (without any trailing slash).</p>
		</div>

		<div class="field_row">
			<label>Joomla Secret Key</label>
			<input type="text" name="settings[joomla_secret]" value="{{ app.getSetting(plugin.id ~ '.joomla_secret') }}" style="width: 50%; padding: 5px" />
			<p>Enter the Joomla Secret Key. This needs to be copied to the DeskPRO plugin on your Joomla site. In Joomla, go to Admin &gt; Extensions &gt; Plug-in Manager &gt; Find "DeskPRO" and click on the title &gt; Click on the "Basic Options" tab.</p>
		</div>
	</div>
</div>

<div class="setting_field_row">
	<h4>Single Sign On</h4>
	<div class="setting_fields">
		<div class="field_row">
			<button class="clean-white" name="configure_usersource" value="1">Configure Joomla Single Sign On</button>
		</div>
	</div>
</div>

{% endblock %}