<div class="full-tab-content">
	<div class="download-content-wrap content-post-wrap">
		{# Top #}
		<div class="download-content-info">
			{% if download.blob.is_image %}
				<div class="thumb">
					<a href="{{ download.blob.download_url }}" target="_blank"><img src="{{ download.blob.getThumbnailUrl(50)  }}" /></a>
				</div>
			{% endif %}

			<a class="clean-white small" href="{{ download.blob.download_url }}" target="_blank" title="{{ download.blob.content_type }}">
				{{ download.blob.filename }}
			</a> ({{ download.blob.readable_filesize }})
			<br class="clear" />
		</div>
		{# /Top #}
		{{ download.content_html|raw }}
	</div>
	<div class="download-editor-wrap" style="display: none">
		<div class="download-editor">
			{% if state.download.content %}
				<div class="revert-message-notice">
					Unsaved changes were restored. <button class="revert-default">Discard and revert to default</button>
					<br />
					<textarea class="edit-content-field-default" style="display: none;">{{download.content}}</textarea>
				</div>
			{% endif %}
			<textarea class="edit-content-field" name="download[content]" rows="5" cols="50">{{ state.download.content|default(download.content) }}</textarea>

			<br />

			Upload a new file to replace the old one:
			<input type="file" name="file-upload" multiple="multiple" /> <button class="clean-gray xxx-small">Upload</button>
			<script class="template-upload" type="text/x-jquery-tmpl">
				<li class="uploading">${name} <span class="cancel"><button class="clean-gray xx-small">Cancel</button></span></li>
			</script>
			<script class="template-download" type="text/x-jquery-tmpl">
				<li class="uploaded">
					<input type="hidden" class="edit-content-attach" name="download[attach]" value="${blob_id}" />
					<a href="${download_url}" target="_blank">${filename}</a>
					<span class="size">${filesize_readable}</span>
				</li>
			</script>
			<ul class="files file-list"></ul>

			<br />

			<button class="dp-button editor-save-trigger small">Save</button>
			<button class="dp-button editor-cancel-trigger small">Cancel</button>
		</div>
	</div>
</div>
