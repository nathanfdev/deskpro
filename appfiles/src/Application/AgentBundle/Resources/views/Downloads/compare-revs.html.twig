<div class="revision-compare">
	<table class="list" cellspacing="0" width="100%">
		<tbody>
			<tr class="line-1">
				<td>Older</td>
				<td>
					By {{ rev_old.person.display_name }} ({{ rev_old.date_created|date('H:ia M j Y') }})
				</td>
			</tr>
			<tr class="line-2">
				<td>Newer</td>
				<td>
					By {{ rev_new.person.display_name }} ({{ rev_new.date_created|date('H:ia M j Y') }})
				</td>
			</tr>

			{% if new_blob %}
			<tr class="line-2">
				<td>File changed</td>
				<td>
					Old File: {% if not old_blob %}N/A
					{% else %}
						<a href="{{ old_blob.getDownloadUrl() }}">{{ old_blob.filename }}</a> ({{ old_blob.readable_filesize }})
					{% endif %}
					<br />
					New File: {% if not new_blob %}N/A
					{% else %}
						<a href="{{ new_blob.getDownloadUrl() }}">{{ new_blob.filename }}</a> ({{ new_blob.readable_filesize }})
					{% endif %}
				</td>
			</tr>
			{% endif %}

			{% if rendered_title_diff %}
			<tr class="line-2">
				<td>Changes in title</td>
				<td><div class="diff-box">{{ rendered_title_diff|raw }}</div></td>
			</tr>
			{% endif %}

			{% if rendered_content_diff %}
			<tr class="line-2">
				<td>Changes in post</td>
				<td><div class="diff-box">{{ rendered_content_diff|raw }}</div></td>
			</tr>
			{% endif %}

			{% if not rendered_title_diff and not rendered_content_diff %}
			<tr class="line-2">
				<td>&nbsp;</td>
				<td>No changes detected between these two revisions</td>
			</tr>
			{% endif %}
		</tbody>
	</table>
</div>
