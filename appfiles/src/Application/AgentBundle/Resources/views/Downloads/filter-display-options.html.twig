{% extends 'AgentBundle:Common:display-options-layout.html.twig' %}
{% block other_options %}
	Order By: <select name="order_by">
		<option value="downloads.date_created:desc">Date Created (Newest-Oldest)</option>
		<option value="downloads.date_created:asc">Date Created (Oldest-Newest)</option>
		<option value="downloads.num_downloads:desc">Number of Downloads (Highest-Lowest)</option>
		<option value="downloads.num_downloads:asc">Number of Downloads (Lowest-Highest)</option>
	</select>
{% endblock %}
{% block display_elements_list %}
	<li data-field="author"><input type="checkbox" name="author" /> Author</li>
	<li data-field="category"><input type="checkbox" name="category" /> Category</li>
	<li data-field="date_created"><input type="checkbox" name="date_created" /> Date Created</li>
	<li data-field="num_downloads"><input type="checkbox" name="num_downloads" /> Number of Downloads</li>
{% endblock %}