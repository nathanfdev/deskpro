<section class="search-reuslts page-set" data-page="{{ page }}">
	{% for download in results %}
		<article class="download download-{{download.id}} downloads-{{download.id}} related-is-linkable" data-content-type="downloads" data-content-id="{{ download.id }}">
			<input class="item-select" type="checkbox" value="{{download.id}}" />
			<div class="toprow">
				<div class="left">
					<span class="subject">
						<a class="with-route" data-route="page:{{ path('agent_downloads_view', {'download_id': download.id}) }}">{{ download.title }}</a>
					</span>
				</div>
				<div class="ticketinfo visible-ticket-controls">
					<div class="bound-faded"></div>
					<button class="clean-gray xxx-small dl-insert-link" data-download-id="{{ download.id }}">Insert Link</button>
					<button class="clean-gray xxx-small dl-insert-attach" data-download-id="{{ download.id }}">Add Attachment</button>
				</div>
				<div class="ticketinfo visible-related-content-controls">
					<div class="bound-faded"></div>
					<button class="clean-gray xxx-small related-link">Add as related</button>
					<button class="clean-gray xxx-small related-unlink">Remove as related</button>
				</div>
			</div>
			{% if display_fields|length %}
				<div class="extra-info">
					<ul>
						{% for field in display_fields %}
							{% if field == 'category' %}
								<li>
									<span class="prop-title">Category</span>
									<span class="prop-val">{{ download.category.full_title }}</span>
								</li>
							{% elseif field == 'author' %}
								<li>
									<span class="prop-title">Author</span>
									<span class="prop-val">{{ download.person.display_name }}</span>
								</li>
							{% elseif field == 'date_created' %}
								<li>
									<span class="prop-title">Date Created</span>
									<span class="prop-val">{{ download.date_created|date('M j, Y')}}</span>
								</li>
							{% elseif field == 'num_downloads' %}
								<li>
									<span class="prop-title">Number of downloads</span>
									<span class="prop-val">{{ download.num_downloads|default(0) }}</span>
								</li>
							{% endif %}
						{% endfor %}
					</ul>
					<br class="clear" />
				</div>
			{% else %}
				<br class="clear" />
			{% endif %}
		</article>
	{% endfor %}
</section>
