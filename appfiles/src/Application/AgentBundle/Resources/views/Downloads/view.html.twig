{% import 'AgentBundle:Common:optionbox-macros.html.twig' as optionbox %}
<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.DownloadsView';
pageMeta.title = {{download.title|json_encode|raw}};
pageMeta.download_id = {{download.id}};
pageMeta.url_fragment  = '{{ url_fragment('agent_downloads_view', {'download_id': download.id}) }}';
pageMeta.permalink = '{{ url('user_downloads_file', {'slug': download.url_slug }) }}';
pageMeta.labelsAutocompleteUrl        = '{{ path('agent_ajax_labels_autocomplete', {'label_type': 'downloads'}) }}';
pageMeta.labelsSaveUrl                = '{{ path('agent_downloads_ajax_labels_save', {'download_id': download.id}) }}';

{% if download.hidden_status == 'validating' %}
pageMeta.isValidating = true;
{% endif %}

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
{# scroll containers #}
<div class="layout-content with-scrollbar page-listing page-download-view">
<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
<div class="scroll-viewport"><div class="scroll-content">
{# /scroll containers #}

<div class="delete-notice" {% if download.status_code != "hidden.deleted" %}style="display: none;"{% endif %}>
	This download has been deleted. <button class="clean-gray xxx-small undelete">Undelete</button>
</div>

{% if download.status_code == "hidden.validating" %}
	{% include 'AgentBundle:Publish:view-approve-header.html.twig' %}
{% endif %}

<header class="page-header">
	<h4 class="id-number">#{{ download.id }}</h4>
	<h1 class="editable hover-edit" data-editable-for=".inline-editable .title">{{ download.title }}</h1>
	<br class="clear" />
	<div class="meta-line">
		<div class="status the-status download-status"><span>{{ download.status }}</span></div>
		<div class="category" id="{{baseId}}_cat_trigger"><span>Category: <span id="{{baseId}}_cat_label">{{ download.category.full_title }}</span></span></div>
	</div>
	<br class="clear" />
</header>

<section id="{{baseId}}_tabs_content_wrap" class="mid-page">
	<dl class="table-list">
		<dt class="type-labels">Labels</dt>
		<dd>
			<ul>
				<div class="tags-wrap download-tags">
					<ul>
						{% for label in download.labels %}
							<li><span>{{label.label}}</span></li>
						{% endfor %}
					</ul>
				</div>
			</ul>
		</dd>

		<dt>Rating</dt>
		<dd>
			{{ download.rating_percent }}% helpful (<span class="link-look who-voted-trigger">{{ download.num_ratings }} votes</span>)<br />
			<small>{{ download.up_votes }} found this download helpful, {{ download.down_votes }} found this download unhelpful</small>
		</dd>
	</dl>

	<br class="clear" />

	<div class="controls" id="{{baseId}}_action_buttons">
		<button class="clean-white delete" {% if article.status_code == "hidden.deleted" %}style="display:none"{% endif %}>Delete</button>
		<button class="clean-white permalink">Copy Permalink</button>
		<button class="clean-white view-user-interface">View in user interface</button>
		<br class="clear" />
	</div>

	<footer class="time-info">
		<ul>
			<li>
				Created <time class="timeago" datetime="{{news.date_created|date('c')}}"></time> by {{ news.person.display_name }} at <time>{{news.date_created|date('H:ia M j Y')}}</time>
			</li>
		</ul>
	</footer>
</section>

<nav class="page-tabs" id="{{baseId}}_bodytabs">
	<ul>
		<li class="on" data-tab-for="#{{baseId}}_tab_contents .dl-content"><span>Page</span></li>
		<li data-tab-for="#{{baseId}}_tab_contents .comments-tab"><span>Comments (<span id="{{baseId}}_count_comments">{{news_comments|length|default(0)}}</span>)</span></li>
		<li data-tab-for="#{{baseId}}_tab_contents .revisions"><span>Revisions</span></li>
		<li data-tab-for="#{{baseId}}_tab_contents .related-content"><span>Related Content</span></li>
		<li data-tab-for="#{{baseId}}_tab_contents .search-tab"><span>Search</span></li>
	</ul>
	<button class="clean-white small download-editor-edit" style="float:right; margin: 6px 10px 0 0;">Edit</button>
</nav>

{# Tab Contents #}
<div id="{{baseId}}_tab_contents" class="tabbed-page-contents">
	{# Tab: Content #}
	<div class="deskpro-tab-item dl-content on">

		{# Content #}
		<div class="download-content" id="{{baseId}}_content_ed">
		{% include 'AgentBundle:Downloads:view-content-tab.html.twig' %}
		</div>
		{# /Content #}

		<br class="clear" />
	</div>
	{# /Content #}

	{# Tab: Comments #}
	<div class="deskpro-tab-item comments-tab">
		<div class="download-comments">
			<div class="full-tab-content">
				<div class="messages-wrap" id="{{baseId}}_comments_wrap">
					{% for comment in download_comments %}
						{% include 'AgentBundle:Downloads:view-comment.html.twig' %}
					{% endfor %}
				</div>
			</div>

			<div class="message admin-message new-note">
				<div class="message-avatar left">
					<img src="{{ app.user.getPictureUrl(35) }}" alt="" width="35" height="35" />
				</div>
				<div class="message-body">
					<div class="message-meta">
						<span class="arrow-left"></span>
						<h4>{{ app.user.display_name }}</h4>
					</div>
					<div class="message-text">
						<p>
							<textarea style="width:98%; height: 80px;"></textarea>
							<div style="text-align:center; margin-top: 9px;">
								<div class="loading-off">
									<button class="dp-button x-small">Add Comment</button>
								</div>
								<div class="loading-on" style="display:none">
									Saving ...
								</div>
							</div>
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>
	{# /Tab: Comments #}

	{# Tab: Revisions #}
	<div id="{{baseId}}_revs" class="loaded deskpro-tab-item revisions">
		{% include 'AgentBundle:Downloads:view-revisions-tab.html.twig' %}
	</div>
	{# /Tab: Revisions #}

	{# Tab: Related #}
	<div id="{{baseId}}_related_content" class="deskpro-tab-item related-content">
		{% include 'AgentBundle:Common:content-related-list.html.twig' %}
	</div>
	{# /Tab: Related #}

	{# Tab: Search #}
	<div id="{{baseId}}_searchtab" class="deskpro-tab-item search-tab">
		<div class="tags-wrap sticky-search-words">
			<dl class="table-list">
				<dt class="type-labels">Search Words</dt>
				<dd>
					<ul>
						{% for word in sticky_search_words %}
							<li><span>{{word}}</span></li>
						{% endfor %}
					</ul>
					<div class="explain">
						When a user searches for any of these words, this page will always be listed in their top results.
					</div>
				</dd>
			</dl>
		</div>

		<br />

		{% include 'AgentBundle:Publish:rated-searches.html.twig' %}
	</div>
	{# /Tab: Search #}
</div>
{# /Tab Contents #}

<div class="inline-editable" style="display:none">
	<div class="title">
		<input type="text" name="title" value="{{ download.title }}"/>
		<input type="hidden" name="action" value="title" />
	</div>
</div>

<ul class="status-menu" data-option-name="status" style="display:none">
	<li data-option-value="published">{{ phrase('agent.kb.status_published') }}</li>
	<li data-option-value="hidden.unpublished">{{ phrase('agent.kb.hidden_status_unpublished') }}</li>
	<li data-option-value="archived">{{ phrase('agent.kb.status_archived') }}</li>
	{% if download.person.id == app.user.id %}
		<li data-option-value="hidden.draft">{{ phrase('agent.kb.hidden_status_draft') }}</li>
	{% endif %}
</ul>

{{ optionbox.category_ob(download_categories, 'Download Category', 'Apply', {'id': baseId ~ '_cat_ob'}) }}

</div></div> {# scrollbar divs #}
</div> {# main layout div #}
