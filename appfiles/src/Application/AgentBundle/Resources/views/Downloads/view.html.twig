<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.DownloadsView';
pageMeta.title = {{download.title|json_encode|raw}};
pageMeta.download_id = {{download.id}};
pageMeta.permalink = '{{ url('user_downloads_file', {'slug': download.url_slug }) }}';
pageMeta.labelsAutocompleteUrl        = '{{ path('agent_ajax_labels_autocomplete', {'label_type': 'downloads'}) }}';
pageMeta.labelsSaveUrl                = '{{ path('agent_downloads_ajax_labels_save', {'download_id': download.id}) }}';

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
<div class="layout-content full-page download-page with-scrollbar">
<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
<div class="scroll-viewport"><div class="scroll-content">

<section class="ticket-header" id="{{baseId}}_download_header">
	<div class="ticket-id">
		<span>#{{ download.id }}</span>
	</div>

	<div class="the-department">
		<div class="ticket-department prop-department-id" id="{{baseId}}_category">
			<div class="parent">
				{% if download.category.parent %}
					{{ download.category.parent.title }}
				{% else %}
					{{ download.category.title }}
				{% endif %}
			</div>
			<div class="sub">
				{% if download.category.parent %}
					{{ download.category.title }}
				{% endif %}
			</div>
		</div>
	</div>
	<div class="ticket-subject editable hover-edit" data-editable-for=".inline-editable .title">
		{{ download.title }}
	</div>
	<br style="clear:both;height: 1px;overflow: hidden;" />

	<div class="assignments">
		<div class="agent">
			<div class="desc">
				Created by <a class="agent-link prop-agent-id" style="background-image: url('{{ download.person.getPictureUrl(20) }}');">{{ download.person.display_name }}</a>
			</div>
			<br style="clear:both;height: 1px;overflow: hidden;" />
		</div>
	</div>

	<nav class="actions" id="{{baseId}}_action_buttons">
		<ul>
			<li class="delete"><button class="clean-gray xx-small">Delete</button></li>
			<li class="permalink"><button class="clean-gray xx-small">Copy Permalink</button></li>
			<li class="view-user-interface"><button class="clean-gray xx-small">View in user interface</button></li>
		</ul>
	</nav>

	<div class="times">
		Created <time class="timeago" datetime="{{download.date_created|date('c')}}"></time> at <time>{{download.date_created|date('H:ia M j Y')}}</time>.<br/>
	</div>
</section>

<div class="full-container-tabbed main-tabs">
	<div class="full-container-tabbed-contents-wrap field-section-bodytabs-tab-contents">
		<div class="full-container-tabbed-contents">
			<div class="table-content">
				<div class="row-table-cotent">
					<div class="col-table-content title-col">
						<span>Labels</span>
					</div>
					<div class="col-table-content">
						<div class="tags-wrap download-tags">
							<span class="tag-icon"></span>
							<ul>
								{% for label in download.labels %}
									<li><span>{{label.label}}</span></li>
								{% endfor %}
							</ul>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

{# Content #}
<div class="download-content" id="{{baseId}}_content_ed">
{% include 'AgentBundle:Downloads:view-content-tab.html.twig' %}
</div>
{# /Content #}

<br class="clear" />

{# Tab: Comments #}
<div class="download-comments">
	<div class="full-tab-content">
		<div class="messages-wrap">
			{% for comment in download_comments %}
				{% include 'AgentBundle:Downloads:view-comment.html.twig' %}
			{% endfor %}
		</div>
	</div>

	<div class="message admin-message new-note">
		<div class="message-avatar left">
			<img src="{{ app.user.getPictureUrl(35) }}" alt="" width="35" height="35" />
		</div>
		<div class="message-body">
			<div class="message-meta">
				<span class="arrow-left"></span>
				<h4>{{ app.user.display_name }}</h4>
			</div>
			<div class="message-text">
				<p>
					<textarea style="width:98%; height: 80px;"></textarea>
					<div style="text-align:center; margin-top: 9px;">
						<div class="loading-off">
							<button class="dp-button x-small">Add Comment</button>
						</div>
						<div class="loading-on" style="display:none">
							Saving ...
						</div>
					</div>
				</p>
			</div>
		</div>
	</div>
</div>
{# /Tab Comments #}

<div class="inline-editable" style="display:none">
	<div class="title">
		<input type="text" name="title" value="{{ download.title }}"/>
		<input type="hidden" name="action" value="title" />
	</div>
</div>

</div></div> {# scrollbar divs #}
</div> {# main layout div #}
