<table class="list revision-compare-table" width="100%">
	{% for rev in download.revisions %}
		<tr class="rev-{{rev.id}}">
			<td width="30">{{ loop.index }}</td>
			<td>
				<span style="float:right">
					{{ rev.date_created|date('Y-m-d') }}
				</span>
				{{ phrase('agent.by_x', {'name': rev.person.display_name}) }}
			</td>
			<td width="150">
				<input type="checkbox" class="rev-compare-check" value="{{rev.id}}" />
			</td>
		</tr>
	{% endfor %}
</table>
<div style="text-align: right">
	<button class="dp-button compare-trigger">{{ phrase('agent.publish.compare_selected') }}</button>
</div>
