<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.NewDownload';

pageMeta.title = 'New Download';
pageMeta.uploadAttachUrl              = '{{ path('agent_accept_upload') }}';

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
{# scroll containers #}
<div class="layout-content with-scrollbar page-new-download page-new-content">
<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
<div class="scroll-viewport"><div class="scroll-content">
{# /scroll containers #}

<form id="{{baseId}}_newdownload">

<div class="section cat-section" id="{{baseId}}_cat_section">
	<div class="step">
		<span class="num">1</span>
		<span class="check">Done</span>
	</div>
	<div class="content">
		<div class="col">
			<h4>Category</h4>
			{% include 'AgentBundle:Common:select-standard.html.twig' with {
				'name': 'newdownload[category_id]',
				'id': baseId ~ '_cat',
				'add_classname': 'category_id',
				'add_attr': '',
				'with_blank': 1,
				'blank_title': '',
				'categories': download_categories,
				'selected': state.newdownload.category_id
			} %}
		</div>
		<div class="col">
			<h4 class="light">Status</h4>
			<select name="newdownload[status]">
				<option value="published">Published</option>
				<option value="hidden.unpublished">Unpublished</option>
				<option value="hidden.draft">Draft</option>
				{% if constant('DP_DEBUG') %}
					<option value="hidden.validating" selected="selected">DEV: Validating</option>
				{% endif %}
			</select>
		</div>
		<br class="clear" />
	</div>
</div>

<div class="section title-section" id="{{baseId}}_title_section">
	<div class="step">
		<span class="num">2</span>
		<span class="check">Done</span>
	</div>
	<div class="content">
		<h4>Title</h4>
		<input type="title" name="newdownload[title]" id="{{baseId}}_title" value="{{ state.newdownload.title }}" />
	</div>
</div>

<div class="section file-section" id="{{baseId}}_file_section">
	<div class="step">
		<span class="num">3</span>
		<span class="check">Done</span>
	</div>
	<div class="content">
		<h4>File</h4>
		<input type="file" name="file-upload" multiple="multiple" /> <button class="clean-gray xxx-small">Upload</button>
		<script class="template-upload" type="text/x-jquery-tmpl">
            <li class="uploading">${name} <span class="cancel"><button class="clean-gray xx-small">Cancel</button></span></li>
        </script>
        <script class="template-download" type="text/x-jquery-tmpl">
            <li class="uploaded">
                <input type="hidden" name="newdownload[attach]" value="${blob_id}" />
                <a href="${download_url}" target="_blank">${filename}</a>
                <span class="size">${filesize_readable}</span>
            </li>
        </script>
        <ul class="files file-list"></ul>
	</div>
</div>

<div class="section article-section" id="{{baseId}}_content_section">
	<div class="step">
		<span class="num">4</span>
		<span class="check">Done</span>
	</div>
	<div class="content">
		<h4>Description</h4>
		<textarea type="text" name="newdownload[content]" id="{{baseId}}_content">{{ state.newdownload.content }}</textarea>
	</div>
</div>


<div class="section other-section" id="{{baseId}}_other_section">
	<div class="step">
		<span class="num">5</span>
		<span class="check">Done</span>
	</div>
	<div class="content">
		{# Tab Container #}
		<div class="tab-container">
			<nav id="{{baseId}}_other_props_tabs_wrap">
				<ul id="{{baseId}}_other_props_tabs">
					<li data-tab-for="> .tab-properties">Properties</li>
				</ul>
			</nav>
			<div class="content-wrapper" id="{{baseId}}_other_props_tabs_content" style="display: none">
				{# Tab Properties #}
				<div class="tab-properties" style="display: none">
					<dl>
						<dt class="prop">URL Slug</dt>
						<dd class="prop">
							<input type="input" name="newdownload[slug]" id="{{baseId}}_slug" value="{{ state.newdownload.slug }}" />
						</dd>

						<dt class="prop">Labels</dt>
						<dd class="prop">
							<div class="tags-wrap article-tags">
								<span class="tag-icon"></span>
								<ul>
									{% for l in state.newdownload.labels %}
										<li>{{ l }}</li>
									{% endfor %}
								</ul>
							</div>
						</dd>
					</dl>
				</div>
				{# /Tab Properties #}
			</div>
		</div>
		{# /Tab Container #}
	</div>
</div>

<div class="foot">
	<button class="dp-button submit-trigger">Create News Post</button>
</div>

</form>

{# scroll containers #}
</div></div>
</div>
{# /scroll containers #}
