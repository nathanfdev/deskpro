<section class="search-reuslts page-set" data-page="{{ page }}">
	{% for org in organizations %}
		<article
			class="row-item org org-{{org.id}} downloads-{{org.id}}"
			data-route="page:{{ path('agent_org_view', {'organization_id': org.id}) }}"
			data-route-title="@selector(a.row-title)"
			data-route-openclass="open"
		>
			<div class="top-row">
				<div class="top-row-left">
					<h3>
						<a class="row-title click-through">{{ org.name }}</a>
					</h3>
				</div>
			</div>
			<hr class="clear-top" />
			{% if display_fields|length %}
				<div class="extra-fields">
					<ul>
						{% for field in display_fields %}
							{% if field == 'members_count' %}
								<li>
									<span class="prop-title">Members</span>
									<span class="prop-val"><a class="with-route" data-route="listpane:{{ path('agent_peoplesearch_customfilter') }}?terms[0][rule_type]=organization&amp;terms[0][op]=is&amp;terms[0][organization]={{org.id}}">{{members_count[org.id]|default(0)}}</a></span>
								</li>
							{% else %}
								{% for f in org_field_defs %}
									{% if field == 'org_fields['~f.id~']' and org.hasCustomField(f.id) %}
									<li>
										<span class="prop-title">{{ f.title }}</span>
										<span class="prop-val">{{ org.renderCustomField(f.id) }}</span>
									</li>
									{% endif %}
								{% endfor %}
							{% endif %}
						{% endfor %}
					</ul>
					<br class="clear" />
				</div>
			{% else %}
				<br class="clear" />
			{% endif %}
		</article>
	{% endfor %}
</section>
