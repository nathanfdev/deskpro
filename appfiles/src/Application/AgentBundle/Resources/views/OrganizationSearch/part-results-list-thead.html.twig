<thead class="display-options-trigger dbl-click-trigger nosel">
	<tr>
		<th></th>
		{% for field in display_fields %}
			{% set extra = '' %}
			{% if loop.first %}{% set extra = 'Name / ' %}{% endif %}
			{% if field == 'members_count' %}
				<th>{{extra}}Number of members</th>
			{% else %}
				{% for f in org_field_defs %}
					{% if field == 'organization_fields['~f.id~']' %}
					<th data-field="organization_fields[{{f.id}}]">{{extra}}{{f.title}}</th>
					{% endif %}
				{% endfor %}
			{% endif %}
		{% else %}
			<th data-field="name">Name</th>
		{% endfor %}
	</tr>
</thead>