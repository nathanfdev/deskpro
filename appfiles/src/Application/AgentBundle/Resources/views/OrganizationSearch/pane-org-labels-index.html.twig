<dl id="ticket_labels_list">
	{% for letter,labels in labels_index %}
		<dt>{{letter}}</dt>
		<dd>
			<ul class="comma-list">
				{% for label in labels %}
					<li><a data-route="listpane:{{ path('agent_orgsearch_customfilter') }}?terms[0][rule_type]=label&amp;terms[0][op]=is&amp;terms[0][label]={{label}}">{{label}}</a></li>
				{% endfor %}
			</ul>
		</dd>
	{% else %}
		<dt></dt>
		<dd>You haven't labeled any organizations! View an organization label it.</dd>
	{% endfor %}
</dl>