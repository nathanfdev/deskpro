<div class="display-options overlay">
	<h1>Display Options</h1>
	<div style="float: right;">
		Order By: <select name="order_by">
			<option value="organization.name:asc">Name (A-Z)</option>
			<option value="organization.name:desc">Name (Z-A)</option>
		</select>
	</div>
	<div style="margin-right: 250px;">
		<strong>Display Elements</strong><br />
		<ul class="sortable-list">
			<li data-field="name"><input type="checkbox" name="name" /> Name</li>
			<li data-field="members_count"><input type="checkbox" name="members_count" /> Number of members</li>
			{% for f in org_field_defs %}
				<li data-field="organization_fields[{{f.id}}]"><input type="checkbox" name="organization_fields[{{f.id}}]" /> Field: {{f.title}}</li>
			{% endfor %}
		</ul>
	</div>
	<div class="buttons">
		<div class="loading-off">
			<button class="save-trigger dp-button small">Save</button>
			<button class="close-trigger dp-button gray small">Cancel</button>
		</div>
		<div class="loading-on">
			<span>Saving ...</span>
		</div>
	</div>
</div>