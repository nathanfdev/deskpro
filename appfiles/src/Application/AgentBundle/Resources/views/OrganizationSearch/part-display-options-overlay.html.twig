<div class="display-options overlay">
	<div class="overlay-title">
		<h4>{{ phrase('agent.display_options') }}</h4>
	</div>
	<div class="overlay-content">
		<div style="float: right;">
			Order By: <select name="order_by">
				<option value="organization.name:asc">Name (A-Z)</option>
				<option value="organization.name:desc">Name (Z-A)</option>
			</select>
		</div>
		<div style="margin-right: 250px;">
			<strong>Display Elements</strong><br />
			<ul class="sortable-list">
				<li data-field="name"><input type="checkbox" name="name" /> {{ phrase('agent.name') }}</li>
				<li data-field="members_count"><input type="checkbox" name="members_count" /> {{ phrase('agent.number_of_members') }}</li>
				{% for f in org_field_defs %}
					<li data-field="organization_fields[{{f.id}}]"><input type="checkbox" name="organization_fields[{{f.id}}]" />{{f.title}}</li>
				{% endfor %}
			</ul>
		</div>
	</div>
	<div class="overlay-actions">
		<div class="loading-off">
			<button class="save-trigger dp-button small">{{ phrase('agent.save') }}</button>
		</div>
		<div class="loading-on" style="display:none">
			<span>{{ phrase('agent.loading_saving') }}</span>
		</div>
	</div>
</div>
