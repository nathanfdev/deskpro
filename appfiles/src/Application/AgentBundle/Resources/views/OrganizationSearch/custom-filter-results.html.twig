<script>
{% if page_title %}
	pageMeta.title = {{ page_title|json_encode|raw }};
{% else %}
	pageMeta.title = 'Search';
{% endif %}
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.OrganizationCustomFilter';
pageMeta.pageUrl = '{{ path('agent_orgsearch_customfilter') }}?partial=1&cache_id={{cache_id}}&page=$page';
pageMeta.refreshUrl = '{{ path('agent_orgsearch_customfilter') }}?cache_id={{cache_id}}';
pageMeta.saveListPrefsUrl = '{{ path('agent_orgsearch_save_resultprefs', {'cache_id': cache_id}) }}';
{% if cache_id %}
	pageMeta.cache_id = {{cache_id}};
{% endif %}
{% if not people %}
	pageMeta.noResults = true;
{% endif %}
</script>
<div class="content">
	{% include 'AgentBundle:OrganizationSearch:part-display-options-overlay.html.twig' %}

	<div class="pad">
		<div class="inner-box-tab-content box-list no-pad">
			<table class="list" cellspacing="0" width="100%">
				{% include 'AgentBundle:OrganizationSearch:part-results-list-thead.html.twig' %}
				{% include 'AgentBundle:OrganizationSearch:part-results-list.html.twig' %}
			</table>
		</div>
	</div>

	{% if not organizations|length %}
		<section class="list-listing no-results">
			<p>{{ phrase('agent.there_are_no_results') }}</p>
		</section>
	{% endif %}
</div>
