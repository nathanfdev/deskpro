<tbody class="search-results page-set" data-page="{{page}}">
{% for org in organizations %}
	<tr class="{% if loop.index % 2 == 0 %}white{% endif %} organization-{{org.id}} line-1" data-organization-id="{{org.id}}">
		<td rowspan="2" width="20" style="vertical-align: middle; padding: 4px; white-space:nowrap;">
			<img class="agent-picture" src="{{ asset('images/pic-agent-2.png') }}" alt="" width="30" height="30" />
		</td>
		<td colspan="{{display_fields|length-1}}" class="subject">
			<a class="with-route" data-route="person:{{ path('agent_org_view', {'organization_id': org.id}) }}">{{org.name}}</a>
		</td>
	</tr>
	<tr class="{% if loop.index % 2 == 0 %}white{% endif %} person-{{org.id}} line-2" data-organization-id="{{org.id}}">
		{% for field in display_fields %}
			<td class="{{field}}" {% if loop.last and display_fields|length > 1 %}style="text-align:right"{% endif %}>
			{% if field == 'members_count' %}
				<a class="with-route" data-route="listpane:{{ path('agent_peoplesearch_customfilter') }}?terms[0][rule_type]=organization&amp;terms[0][op]=is&amp;terms[0][organization]={{org.id}}">{{members_count[org.id]|default(0)}}</a> members
			{% else %}
				{% for f in org_field_defs %}
					{% if field == 'org_fields['~f.id~']' %}
					<div class="prop-val org_fields_{{f.id}}">
						{{org.renderCustomField(f.id)}}
					</div>
					{% endif %}
				{% endfor %}
			{% endif %}
		{% endfor %}
	</tr>
{% endfor %}
</tbody>