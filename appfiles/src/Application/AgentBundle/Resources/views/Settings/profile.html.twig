<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.SettingsPage.Profile';
</script>
<form action="{{ path('agent_settings_profile_save') }}" method="post">
	<div class="dp-form">
		<div class="dp-form-row">
			<div class="dp-form-label"><label>Name</label></div>
			<div class="dp-form-input">
				{{ form_widget(form.name) }}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label"><label>Email</label></div>
			<div class="dp-form-input">
				{{ form_widget(form.email, {'attr': {'id': 'settings_profile_email'}}) }}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label"><label>Timezone</label></div>
			<div class="dp-form-input">
				{{ form_widget(form.timezone) }}
			</div>
		</div>

		<div class="dp-form-row new-picture">
			<div class="dp-form-label"><label>Picture</label></div>
			<div class="dp-form-input">
				<table cellspacing="0" cellpadding="0"><tr>
				{% if app.user.picture_blob %}
					<td style="padding-right: 15px;"><img src="{{ app.user.getPictureUrl(80) }}" /><br /><em class="desc">Your current picture</em></td>
				{% endif %}
				<td>
					<input type="file" name="file-upload" />
					<div class="files"></div>
				</td>
				</tr></table>
			</div>
			<script class="template-upload" type="text/x-jquery-tmpl">
				<p>Upliading ${name}...</p>
			</script>
			<script class="template-download" type="text/x-jquery-tmpl">
				<div>
					<input type="hidden" name="settings_profile[new_picture_blob_id]" class="new_blob_id" value="${blob_auth_id}" />
					<img src="${download_url}?s=80" class="pic-new" data-setted-size="${download_url}?s=60" />
				</div>
			</script>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label"><label>Change Password</label></div>
			<div class="dp-form-input double-password">
				{{ form_widget(form.password, {'attr': { 'placeholder': 'New password', 'class': 'password1' }}) }}
				{{ form_widget(form.password2, {'attr': { 'placeholder': 'Repeat password', 'class': 'password2' }}) }}
				<br /><em class="desc">Leave this field blank to keep your password the same</em>
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label"><label>Ticket Signature</label></div>
			<div class="dp-form-input">
				{{ form_widget(form.ticket_signature) }}
				<br /><em class="desc">This signature will be appended automatically when you send ticket replies</em>
			</div>
		</div>
	</div>

	<button type="submit" class="clean-white submit-trigger">Save</button>
</form>
