{% extends 'AgentBundle:Settings:settings-layout.html.twig' %}
{% block current_page "ticket-filters" %}
{% block head %}
<script type="text/javascript">
$(document).ready(function() {
	// Set up search builder
	var editor = new DeskPRO.Form.RuleBuilder($('#criteria_tpl'));
	editor.addEvent('newRow', function(new_row) {
		$('.remove', new_row).click(function() {
			new_row.remove();
		});
	});
	$('#criteria_list .add-term').data('add-count', 0).click(function() {
		var count = parseInt($(this).data('add-count'));
		var basename = 'terms['+count+']';

		$(this).data('add-count', count+1);

		editor.addNewRow($('#criteria_list .search-terms'), basename);
	});

	var count = 0;
	var terms = {{filter.terms|json_encode|raw}};
	if (terms) {
		Array.each(terms, function(info, x) {
			var basename = 'terms[initial_' + x + ']';
			editor.addNewRow($('#criteria_list .search-terms'), basename, {
				type: info.type,
				op: info.op,
				options: info.options
			});
		});
	}
});
</script>
{% endblock %}
{% block body %}

<form action="{{ path('agent_settings_ticketfilters_edit', { 'filter_id': filter.id|default(0) }) }}" method="post" accept-charset="utf-8">

<div class="form-panel">
	<div class="row">
		<label for="macro_title">Filter title</label>
		<input type="input" name="filter[title]" class="input-title" value="{{filter.title}}" />
	</div>
	<div class="row">
		<label for="macro_title">Order by</label>
		<select name="filter[order_by]">
			<option value="ticket.urgency:desc">Urgency (Highest-Lowest)</option>
			<option value="ticket.urgency:asc">Urgency (Lowest-Highest)</option>
			<option value="ticket.date_created:desc">Date Opened (Newer-Older)</option>
			<option value="ticket.date_created:asc">Date Opened (Older-Newer)</option>
			<option value="ticket.priority:desc">Priority (Highest-Lowest)</option>
			<option value="ticket.priority:asc">Priority (Lowest-Highest)</option>
		</select>
	</div>

	<div class="row">
		<label>Criteria</label>
		<div class="search-form" id="criteria_list">
			<div class="search-terms"></div>
			<div class="term"><span class="add-term">+</span> Add a new term</div>
		</div>
		{% include 'DeskPRO:Common:ticket-search-criteria.html.twig' with { 'classname': 'search-builder-tpl', 'id': 'criteria_tpl', 'term_options': term_options } %}
	</div>
</div>

<div style="text-align:center">
	<button type="submit" class="dp-button">Save Filter</button>
</div>

</form>

</form>
{% endblock %}