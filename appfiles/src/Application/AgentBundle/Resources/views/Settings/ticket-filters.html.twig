<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.SettingsPage.Filters';
</script>

<div style="text-align: right">
	<a class="clean-white" data-route="poppage:{{ path('agent_settings_ticketfilters_new') }}">Create Filter</a>
</div>

<br />

<ul class="item-list">
	{% for filter in filters %}
		<li>
			<div style="float:right">
				<ul class="controls">
					<li class="delete" data-route="poppage:{{ path('agent_settings_ticketfilters_del', { 'filter_id': filter.id }) }}"></li>
					<li class="edit" data-route="poppage:{{ path('agent_settings_ticketfilters_edit', { 'filter_id': filter.id }) }}">/li>
				</ul>
			</div>
			{{filter.title}}
		</li>
	{% endfor %}
</ul>
