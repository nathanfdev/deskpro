{% extends 'AgentBundle:Settings:settings-layout.html.twig' %}
{% block current_page "settings" %}
{% block content %}

<form action="{{ path('agent_settings') }}" method="post">

	<ul class="item-list">
		<li>
			<strong>Ticket Signature</strong><br />
			<textarea name="ticket_signature" style="width: 80%; height: 80px;">{{ ticket_signature }}</textarea>
			<br /><span style="font-size: 10px;">The signature that appears at the bottom of your replies automatically</span>
		</li>
	</ul>

	<br /><br />
	<div style="text-align:center">
		<button type="submit" class="dp-button">Save Settings</button>
	</div>
</form>

{% endblock %}