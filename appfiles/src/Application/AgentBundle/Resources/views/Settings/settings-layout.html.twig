{% extends 'AgentBundle:Common:iframe-layout.html.twig' %}
{% block header %}
	<nav class="deskpro-tabstrip">
		<ul>
			<li {% if current_page == 'settings' %}class="on"{% endif %}><a href="{{ path('agent_settings') }}">Settings</a></li>
			<li {% if current_page == 'picture' %}class="on"{% endif %}><a href="{{ path('agent_settings_picture') }}">Picture</a></li>
			<li {% if current_page == 'ticket-filters' %}class="on"{% endif %}><a href="{{ path('agent_settings_ticketfilters') }}">Ticket Filters</a></li>
			<li {% if current_page == 'ticket-macros' %}class="on"{% endif %}><a href="{{ path('agent_settings_ticketmacros') }}">Ticket Macros</a></li>
		</ul>
	</nav>
{% endblock %}
{% block head %}
<script type="text/javascript">
if (opener && opener.DeskPRO_Window) {
	var DeskPRO_Window = opener.DeskPRO_Window;
} else if (opener && parent.DeskPRO_Window) {
	var DeskPRO_Window = parent.DeskPRO_Window;
} else {
	var DeskPRO_Window = null;
}

var Settings = new DeskPRO.Agent.Settings();
$(document).ready(function() {
	Settings.initPage();
});
</script>
{% endblock %}
