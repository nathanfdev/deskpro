<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.SettingsPage.Macros';
</script>

<div style="text-align: right">
	<a class="dp-button green" href="{{ path('agent_settings_ticketmacros_new') }}">Create Macro</a>
</div>

<br />

<ul class="item-list">
	{% for macro in all_macros %}
		<li>
			<div style="float:right">
				<ul class="controls">
					<li class="delete"><a href="{{ path('agent_settings_ticketmacros_del', { 'macro_id': macro.id }) }}" onclick="return confirm('Are you sure you want to delete this macro?');">delete</a></li>
					<li class="edit"><a href="{{ path('agent_settings_ticketmacros_edit', { 'macro_id': macro.id }) }}">edit</a></li>
				</ul>
			</div>
			{{macro.title}}
		</li>
	{% else %}
		<li class="empty-list">
			You have no defined macros. <a href="{{ path('agent_settings_ticketmacros_new') }}">How about you make one?</a>
		</li>
	{% endfor %}
</ul>
