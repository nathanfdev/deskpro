{% extends 'AgentBundle:Settings:settings-layout.html.twig' %}
{% block head %}
<script type="text/javascript" charset="utf-8">
$(document).ready(function() {
	// Set up search builder
	var editor = new DeskPRO.Form.RuleBuilder($('.actions-tpl'));
	editor.addEvent('newRow', function(new_row) {
		$('.remove', new_row).click(function() {
			new_row.remove();
		});
	});

	var to_el = $('.search-form .action-terms');

	$('.search-form .add-term').data('add-count', 0).click(function() {
		var count = parseInt($(this).data('add-count'));
		var basename = 'actions['+count+']';

		$(this).data('add-count', count+1);

		editor.addNewRow(to_el, basename);
	});

	var count = 0;
	var actions = {{macro.actions|json_encode|raw}};
	if (actions) {
		Array.each(actions, function(info, x) {
			var basename = 'actions[initial_' + x + ']';
			editor.addNewRow($('.search-form .action-terms'), basename, {
				type: info.type,
				options: info.options
			});
		});
	}
});
</script>
{% endblock %}
{% block body %}

<form action="{{ path('agent_settings_ticketmacros_edit', { 'macro_id': macro.id|default(0) }) }}" method="post" accept-charset="utf-8">

<div class="form-panel">
	<div class="row">
		<label for="macro_title">Macro title</label>
		<input type="text" name="macro[title]" value="{{macro.title}}" class="input-title" id="macro_title" />
	</div>

	<div class="row">
		<label>Actions</label>
		<div class="search-form">
			<div class="action-terms"></div>
			<div class="term"><span class="add-term">+</span> Add a new action</div>
		</div>
	</div>
</div>

<div style="text-align:center">
	<button type="submit" class="dp-button">Save Macro</button>
</div>

</form>

{% include 'DeskPRO:Common:ticket-trigger-actions.html.twig' with {'term_options': ticket_options} %}

{% endblock %}