{% extends 'AgentBundle:Common:profile-contact-overlay.html.twig' %}
{% block list_extra %}
	<div class="row-type email {% if person.emails|length %}with-values{% endif %}">
		<h4>Email Address</h4>
		<div class="contact-info">
			<ul>
				{% for email in person.emails %}
					<li data-remove-name="remove_emails[]" data-remove-value="{{ email.id }}" data-confirm="Are you sure you want to remove this email address?">
						<div class="controls">
							{% if app.user.hasPerm('users.delete-emails') %}
								<span class="remove">x</span>
							{% endif %}
						</div>
						<div class="input">
							<span>{{ email.email }}</span>
						</div>
						<div class="label">
							<input type="text" size="10" name="emails_comment[{{ email.id }}]" value="{{ email.comment }}" placeholder="Add a label" />
						</div>
					<br class="clear" /></li>
				{% endfor %}
			</ul>
			{% if app.user.hasPerm('users.add-emails') %}
			<a class="add-trigger">
				<em class="with-none">Add an email address</em>
				<em class="with-some">Add another</em>
			</a>
			{% endif %}
		</div>
		<script type="text/x-deskpro-plain" class="tpl-new-row">
			<li>
				<div class="controls">
					<span class="remove">x</span>
				</div>
				<div class="input">
					<input type="text" class="single-input" name="new_emails[]" value="" placeholder="Email address" />
				</div>
				<div class="label">
					<input type="text" size="8" name="new_emails_comment[]" value="" placeholder="Add a label" />
				</div>
			<br class="clear" /></li>
		</script>
	</div>
{% endblock %}
