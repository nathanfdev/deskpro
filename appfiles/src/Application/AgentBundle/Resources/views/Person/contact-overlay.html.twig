{% extends 'AgentBundle:Common:profile-contact-overlay.html.twig' %}
{% block list_extra %}
	{% for email in person.emails %}
		<li class="email" data-remove-name="remove_emails[]" data-remove-value="{{ email.id }}">
			<div class="type">Email</div>
			<div class="input">
				<input type="text" size="15" name="emails[{{ email.id }}]" value="{{ email.email }}" />
			</div>
			<div class="remove">-</div>
		</li>
	{% endfor %}
{% endblock %}
{% block newmenu_options_extra %}
	<li data-tpl="tpl-new-email">Email</li>
{% endblock %}
{% block newtpl_extra %}
	<script type="text/x-deskpro-plain" class="tpl-new-email">
		<li class="email new">
			<div class="type">Email</div>
			<div class="input">
				<input type="text" name="new_emails[]" value="" />
			</div>
			<div class="remove">-</div>
		</li>
	</script>
{% endblock %}
