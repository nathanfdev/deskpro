{% extends 'AgentBundle:Common:profile-contact-overlay.html.twig' %}
{% block list_extra %}
	<div class="row-type website {% if person.emails|length %}with-values{% endif %}">
		<h4>Email Address</h4>
		<div class="contact-info">
			<ul>
				{% for email in person.emails %}
					<li data-remove-name="remove_emails[]" data-remove-value="{{ email.id }}">
						<div class="controls">
							<span class="remove">x</span>
						</div>
						<div class="input">
							<input type="text" class="single-input" name="emails[{{ email.id }}]" value="{{ email.email }}" placeholder="Email address "/>
						</div>
						<div class="label">
							<input type="text" size="10" name="contact_data[{{ contact.id }}][comment]" value="{{ contact.rec.comment }}" placeholder="Add a label" />
						</div>
					<br class="clear" /></li>
				{% endfor %}
			</ul>
			<a class="add-trigger">
				<em class="with-none">Add an email address</em>
				<em class="with-some">Add another</em>
			</a>
		</div>
		<script type="text/x-deskpro-plain" class="tpl-new-row">
			<li>
				<div class="controls">
					<span class="remove">x</span>
				</div>
				<div class="input">
					<input type="text" class="single-input" name="new_emails[]" value="" placeholder="Email address" />
				</div>
				<div class="label">
					<input type="text" size="8" name="new_emails_comment[]" value="" placeholder="Add a label" />
				</div>
			<br class="clear" /></li>
		</script>
	</div>
{% endblock %}
