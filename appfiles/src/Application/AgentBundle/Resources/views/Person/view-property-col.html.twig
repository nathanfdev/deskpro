{# Box Contact #}
<div class="profile-box-container summary">
	<header>
		<span class="edit-gear contact-edit">edit</span>
		<h4>Contact Information</h4>
	</header>
	<section>
		<div class="table-content contact-list contact-list-wrapper" id="{{baseId}}_contact_display">
			{% include 'AgentBundle:Person:view-contact-display.html.twig' %}
		</div>
	</section>
</div>
{# /Box Contact #}

<div id="{{baseId}}_contact_outside"></div>

{# Organization Box #}
<div class="profile-box-container summary">
	<header>
		<span class="edit-gear org-edit-trigger">edit</span>
		<h4>Organization</h4>
	</header>
	<section>
		<div class="org-info" id="{{baseId}}_org_display_wrap">
			{% if person.organization %}
				{% include 'AgentBundle:Person:view-org-info.html.twig' %}
			{% endif %}
		</div>
		<div class="org-edit" style="display: none" id="{{baseId}}_org_edit_wrap">
			<input type="text" class="org-set" placeholder="Company name" value="{{ person.organization.name }}" />
			<span class="new-company-notice" id="{{baseId}}_org_create_notice" style="display: none">No company with that name exists yet. A new one will be created.</span>
			<input type="text" class="org-pos-set" placeholder="Position" value="{{ person.organization_position }}" />

			<button class="clean-white small" id="{{baseId}}_org_edit_save">Set Organization</button>
		</div>
	</section>
</div>
{# /Organization Box #}

{# Properties Box #}
<div class="profile-box-container summary">
	<header>
		<h4>Properties</h4>
	</header>
	<section>
		<dl class="table-list">
			<dt class="type-labels">Labels</dt>
			<dd>
				<ul>
					{% for label in person.labels %}
						<li><span>{{label.label}}</span></li>
					{% endfor %}
				</ul>
			</dd>
		</dl>
		<br class="clear"/>

		{% if custom_fields|length %}
			{#
			<dl class="table-list" id="{{baseId}}_custom_fields_rendered">
				{% include 'AgentBundle:Person:view-customfields-rendered-rows.html.twig' %}
			</dl>
			<dl id="{{baseId}}_custom_fields_editable" style="display: none">
				{% include 'AgentBundle:Person:view-customfields-edit-rows.html.twig' %}
			</dl>
			<br class="clear"/>
			#}
		{% endif %}

		<dl class="table-list">
			<dt class="type-labels">Timezone</dt>
			<dd>
				<select id="{{baseId}}_timezone">
					{% for tz in timezone_options %}
						<option value="{{tz}}" {% if person.timezone == tz %}selected="selected"{% endif %}>{{ tz }}</option>
					{% endfor %}
				</select>
				<div class="timezone-info">
					{% include 'AgentBundle:Person:view-bit-timezoneinfo.html.twig' %}
				</div>
			</dd>
		</dl>
	</section>
</div>
{# /Properties Box #}
