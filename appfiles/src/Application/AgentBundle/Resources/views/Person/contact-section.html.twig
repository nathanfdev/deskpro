{% if person.emails %}
	<div class="row-table-cotent">
		<div class="col-table-content title-col">
			<span>Email</span>
		</div>
		<div class="col-table-content prop-val">
			<ul class="emails-list">
				{% for i in person.emails %}
					<li>{{i.email}}</li>
				{% endfor %}
			</ul>
		</div>
	</div>
{% endif %}
{% if person.phones %}
	<div class="row-table-cotent">
		<div class="col-table-content title-col">
			<span>Phone</span>
		</div>
		<div class="col-table-content prop-val">
			<ul class="phones-list">
				{% for i in person.phones %}
					<li>[{{i.comment}}] {{i.field_1}} {{i.field_2}}</li>
				{% endfor %}
			</ul>
		</div>
	</div>
{% endif %}
{% if person.addresses %}
	<div class="row-table-cotent">
		<div class="col-table-content title-col">
			<span>Address</span>
		</div>
		<div class="col-table-content prop-val">
			<ul class="addresses-list">
				{% for i in person.addresses %}
					<li>[{{i.comment}}] {{i.field_1}} {{i.field_2}}</li>
				{% endfor %}
			</ul>
		</div>
	</div>
{% endif %}
{% if person.ims %}
	<div class="row-table-cotent">
		<div class="col-table-content title-col">
			<span>Messaging</span>
		</div>
		<div class="col-table-content prop-val">
			<ul class="ims-list">
				{% for i in person.ims %}
					<li>[{{i.comment}}] {{i.field_1}} {{i.field_2}}</li>
				{% endfor %}
			</ul>
		</div>
	</div>
{% endif %}