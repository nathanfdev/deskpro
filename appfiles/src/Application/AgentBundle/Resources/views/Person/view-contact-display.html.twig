{% extends 'AgentBundle:Common:profile-view-contact-display.html.twig' %}
{% block top_extra %}
	{% for email in person.emails %}
		<li class="email {% if email.id == person.primary_email.id %}is-primary{% endif %} email-{{email.id}}">
			{{ email.email }}

			<span class="primary">primary</span>
			<span class="set-primary" data-email-id="{{ email.id }}">make primary</span>
		</li>
	{% endfor %}
{% endblock %}
