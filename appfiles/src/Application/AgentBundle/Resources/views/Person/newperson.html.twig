<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.NewPerson';
pageMeta.title = 'New Person';

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
{# scroll containers #}
<div class="layout-content with-scrollbar page-new-news page-new-content">
<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
<div class="scroll-viewport"><div class="scroll-content">
{# /scroll containers #}

<form id="{{baseId}}_newperson">

<div class="section cat-section" id="{{baseId}}_cat_section">
	<div class="step">
		<span class="num">1</span>
		<span class="check">Done</span>
	</div>
	<div class="content">
		<div class="col">
			<h4>Name</h4>
			<input type="input" name="newperson[name]" id="{{baseId}}_name" value="" />
		</div>
		<div class="col">
			<h4 class="light">Email</h4>
			<input type="input" name="newperson[email]" id="{{baseId}}_email" value="" />
		</div>
		<br class="clear" />
	</div>
</div>

<div class="section title-section" id="{{baseId}}_org_section">
	<div class="step">
		<span class="num">2</span>
		<span class="check">Done</span>
	</div>
	<div class="content">
		<div class="col">
			<h4>Organization</h4>
			<div id="{{baseId}}_org_container"></div>
		</div>
		<div class="col">
			<h4 class="light">Or create a new organization:</h4>
			<input type="input" name="newperson[new_organization]" id="{{baseId}}_new_org" value="" />
		</div>
		<br class="clear" />

		<strong>Position at the organization:</strong><br />
		<input type="input" name="newperson[organization_position]" value="" />
	</div>
</div>

<div class="section title-section" id="{{baseId}}_fields_section">
	<div class="step">
		<span class="num">3</span>
		<span class="check">Done</span>
	</div>
	<div class="content">
        {% for f in custom_fields %}
        	<h4>{{ f.title }}</h4>
        	{{ render_custom_field_form(f) }}
        	<br />
        {% endfor %}
	</div>
</div>

<div class="section other-section" id="{{baseId}}_other_section">
	<div class="step">
		<span class="num">4</span>
		<span class="check">Done</span>
	</div>
	<div class="content">
		{# Tab Container #}
		<div class="tab-container">
			<nav id="{{baseId}}_other_props_tabs_wrap">
				<ul id="{{baseId}}_other_props_tabs">
					<li data-tab-for="> .tab-properties">Properties</li>
				</ul>
			</nav>
			<div class="content-wrapper" id="{{baseId}}_other_props_tabs_content" style="display: none">
				{# Tab Properties #}
				<div class="tab-properties" style="display: none">
					<dl>
						<dt class="prop">Labels</dt>
						<dd class="prop">
							<div class="tags-wrap article-tags">
								<span class="tag-icon"></span>
								<ul>
									{% for l in state.newperson.labels %}
										<li>{{ l }}</li>
									{% endfor %}
								</ul>
							</div>
						</dd>

						<dt class="prop">Usergroups</dt>
						<dd class="prop">
							<div id="{{baseId}}_ug_container"></div>
						</dd>

						<dt class="prop">Timezone</dt>
						<dd class="prop">
							<select id="{{baseId}}_timezone" name="newperson[timezone]" data-placeholder="Choose a timezone" style="width: 200px">
								<option></option>
								{% for tz in timezone_options %}
									<option value="{{tz}}">{{ tz }}</option>
								{% endfor %}
							</select>
						</dd>
					</dl>
				</div>
				{# /Tab Properties #}
			</div>
		</div>
		{# /Tab Container #}
	</div>
</div>

<div class="foot">
	<button class="dp-button submit-trigger">Create Person</button>
</div>

</form>

{# scroll containers #}
</div></div>
</div>
{# /scroll containers #}
