{% for email in person.emails %}
	<li class="email {%if email.id == person.primary_email_id %}primary{%endif%} exists" data-email-id="{{email.id}}">
		<span class="delete trigger">delete</span>
		<span class="undelete trigger">don't delete</span>
		<span class="primary trigger">primary</span>
		<span class="set-primary trigger">set as primary</span>
		<span class="email-address">{{email.email}}</span>
	</li>
{% endfor %}
<li class="email new tpl">
	<span class="delete trigger">delete</span>
	<span class="undelete trigger">don't delete</span>
	<span class="set-primary trigger">set as primary</span>
	<span class="primary trigger">primary</span>
	<span class="email-address"></span>
</li>