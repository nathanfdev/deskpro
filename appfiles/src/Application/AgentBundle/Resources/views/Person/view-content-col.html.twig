{# Box Summary #}
<div class="table-container summary">
	<div class="table-title">
		<h4>Summary</h4>
	</div>
	<div class="wrap">
		<textarea id="{{baseId}}_summary"></textarea>
		<br />
		<button class="clean-white">Save</button>
	</div>
</div>
{# /Box Summary #}

{# Box Notes #}
{% if person_tickets|length %}
<div class="table-container">
	<div class="table-title">
		<h4>Tickets</h4>
	</div>
	<table class="tickets-simple" width="100%" border="0" cellpadding="0" cellspacing="0">
		<tr>
			{% for ticket in person_tickets %}
				<tr>
					<td>
						<a class="with-route" data-route="ticket:{{ path('agent_ticket_view', {'ticket_id': ticket.id}) }}">{{ticket.subject}}</a>
					</td>
					<td class="time" width="25">
						<time class="timeago" datetime="{{ ticket.date_created|date('c') }}">{{ ticket.date_created|date('M j, Y') }}</time>
					</td>
				</tr>
			{% endfor %}
			{% if person_tickets|length < person_tickets_count %}
				<tr class="more">
					<td colspan="100">
						User has <a class="with-route" data-route="listpane:{{ path('agent_peoplesearch') }}">{{ person_tickets_count - person_tickets|length }} more</a> tickets
					</td>
				</tr>
			{% endif %}
		</tr>
	</table>
</div>
{% endif %}

{# Box Notes #}
<div class="table-container">
	<div class="table-title">
		<h4>Notes</h4>
	</div>
	<div class="notes-wrap">
		<ul>
			{% for note in notes|reverse %}
				{% include 'AgentBundle:Person:note-li.html.twig' with {'note': note} %}
			{% endfor %}
            <li class="new-note">
            	<textarea></textarea>
				<div class="trigger-row">
					<button class="clean-white small trigger save">Add Note</button>
				</div>
				<div class="saving-row">
					Saving ...
				</div>
            </li>
		</ul>
	</div>
</div>
{# /Box Notes #}

{% if activity_stream|length %}
<div class="table-container">
	<div class="table-title">
		<h4>User Activity</h4>
	</div>
	<div class="table-content">
		<ul class="activity-stream">
			{% for action in activity_stream %}
				<li>
					<span class="what">
						{% if action.action_type == 'registered' %}
							Registered an account
						{% elseif action.action_type == 'new_ticket' %}
							Submitted a new ticket
							<a class="with-route" data-route="{{ path('agent_ticket_view', {'ticket_id': action.details.ticket_id }) }}">
								{{ action.details.subject }}
							</a>
						{% elseif action.action_type == 'new_ticket_reply' %}
							Replied to ticket
							<a class="with-route" data-route="{{ path('agent_ticket_view', {'ticket_id': action.details.ticket_id }) }}">
								{{ action.details.subject }}
							</a>
						{% endif %}
					</span>
					<time class="timeago" datetime="{{ action.date_created|date('c') }}">{{ action.date_created|date('M j, Y') }}</time>
				</li>
			{% endfor %}
		</ul>
	</div>
</div>
{% endif %}
