{% extends 'AgentBundle::layout.html.twig' %}
{% block extra_head %}

<script type="text/javascript">
$(document).ready(function() {
	var inline_edit = new DeskPRO.Form.InlineEdit({
		ajax: {
			url: '{{ path('agent_people_ajaxsave', {'person_id': person.id|default(0)}) }}'
		}
	});

	{% if person.id %}
		inline_edit.options.saveFinishCallback = function(data) {
			if (inline_edit.options['x-has-done-newurl']) return;
			inline_edit.options['x-has-done-newurl'] = true;

			// Replace the 0 that denotes no user, with the new user we got back
			inline_edit.options.ajax.url = inline_edit.options.ajax.url.replace(/\w0\w/, data.person_id);
		};
	{% endif %}}
});
</script>
{% endblock %}
{% block content %}

{% set form_url %}{{ path('agent_people_view', {'person_id': person.id}) }}{% endset %}
{{form.renderFormTag(['action': form_url])|raw}}
{{form.renderHiddenTags()|raw}}

<div class="block" id="block-tables">
	<div class="content">
		<h2 class="title">{{person.display_name}}</h2>

		<div class="inner">
			<table class="table">
				<tr class="even">
					<td width="200">Person ID</td>
					<td>{{person.id}}</td>
				</tr>
				<tr class="even">
					<td>Username</td>
					<td class="editable row-trigger" data-editable-for="edit_basic_fields_username">
						{{person.username}}
					</td>
				</tr>
				<tr class="even">
					<td>Password</td>
					<td class="editable row-trigger" data-editable-for="edit_basic_fields_password">
						********
					</td>
				</tr>
				<tr class="even">
					<td>Full Name</td>
					<td class="editable row-trigger" data-editable-for="edit_basic_fields_full_name">
						{{person.full_name}}
					</td>
				</tr>
				<tr class="even">
					<td>Informal Name</td>
					<td class="editable row-trigger" data-editable-for="edit_basic_fields_informal_name">
						{{person.informal_name}}
					</td>
				</tr>
				<tr class="even">
					<td>Nickname</td>
					<td class="editable row-trigger" data-editable-for="edit_basic_fields_nick_name">
						{{person.nick_name}}
					</td>
				</tr>

				{% for info in custom_fields %}
					<tr class="even">
						<td>{{info.field_def.title}}</td>
						<td class="editable row-trigger" data-editable-for="edit_{{info.form_field.getFormId()}}">
							{{info.rendered_value}}
						</td>
					</tr>
				{% endfor %}
			</table>
		</div>
	</div>
</div>
</form>

<div id="field_html_wrap" style="display: none">
	<div id="edit_basic_fields_username">
		{{form.findField('basic_fields.username').render()|raw}}
	</div>
	<div id="edit_basic_fields_password">
		{{form.findField('basic_fields.password').render()|raw}}
	</div>
	<div id="edit_basic_fields_full_name">
		{{form.findField('basic_fields.full_name').render()|raw}}
	</div>
	<div id="edit_basic_fields_informal_name">
		{{form.findField('basic_fields.informal_name').render()|raw}}
	</div>
	<div id="edit_basic_fields_nick_name">
		{{form.findField('basic_fields.nick_name').render()|raw}}
	</div>
	{% for info in custom_fields %}
		<div id="edit_{{info.form_field.getFormId()}}">
			{{info.form_field.render()|raw}}
		</div>
	{% endfor %}
</div>

{% endblock %}
{% block sidebar %}
	{% for assoc in person.usersource_assoc %}
		<div class="block">
			<div class="sidebar-block">
				<h4>
					{{assoc.usersource.title}}:
					{% if assoc.identity_friendly %}
						{{assoc.identity_friendly}}
					{% else %}
						{{assoc.identity}}
					{% endif %}
				</h4>
				<hr />
					First used: {{assoc.created_at|date("Y-m-d")}}<br />
					Last used: {{assoc.last_used_at|date("Y-m-d")}}<br />
				<hr />
				<small>
					{% for k, v in assoc.data %}
						{{k}}: {{v}}<br />
					{% endfor %}
				</small>
			</div>
		</div>
	{% endfor %}
{% endblock %}