<div class="change-picture-overlay {% if person.picture_blob %}with-existing{% endif %} mass-actions-overlay">
	<div class="overlay-title">
		<span class="close close-trigger">close</span>
		<h4>{{ phrase('agent.misc.change_pic_for', {'name': person.display_name}) }}</h4>
	</div>
	<div class="overlay-content">
		{% if person.picture_blob %}
		<div class="existing-picture">
			<header><h3>{{ phrase('agent.misc.people.existing_pic') }}</h3></header>
			<section>
				<img src="{{ person.getPictureUrl(150) }}" />
			</section>
		</div>
		{% endif %}
		<div class="new-picture">
			<header>
				<div class="upload-control">
					<input type="file" name="file-upload" />
					<button class="clean-white small">{{ phrase('agent.upload') }}</button>
				</div>
				<h3>{{ phrase('agent.misc.new_pic') }}</h3>
			</header>
			<section>
				<p class="explain">
					{{ phrase('agent.upload_explain') }}
				</p>
				<div class="files">
				</div>

				<script class="template-upload" type="text/x-jquery-tmpl">
					<p>{{ phrase('agent.loading') }} ${name}...</p>
				</script>
				<script class="template-download" type="text/x-jquery-tmpl">
					{{ '{{if error}} '}}
						<div class="error">
							${error}
						</div>
					{{ '{{else}} '}}
						<div>
							<input type="hidden" name="new_blob_id" class="new_blob_id" value="${blob_id}" />
							<input type="hidden" name="set_pic_opt" class="set_pic_opt" value="newpic" />
							<img src="${download_url}?s=150" class="pic-new" data-setted-size="${download_url}?s=60" />
							<div><button class="clean-white save-trigger small">{{ phrase('agent.misc.set_new_pic') }}</button></div>
						</div>
					{{ '{{/if}}' }}
				</script>
			</section>
		</div>
		<br class="clear" />
	</div>
</div>
