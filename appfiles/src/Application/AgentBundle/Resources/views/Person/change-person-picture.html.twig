<table cellpadding="50" cellspacing="0" width="100%">
	{% if person.picture_blob %}
	<tr>
		<td class="img">
			<img src="{{ person.getPictureUrl(80) }}" />
		</td>
		<td>
			<label>
				<input type="radio" name="set_pic_opt" class="set_pic_opt" value="nochange" /> Use the currently set picture
			</label>
		</td>
	</tr>
	{% endif %}

	{% if person.primary_email %}
	<tr>
		<td class="img">
			<img src="{{ person.primary_email.getGravatarUrl() }}&s=80" class="pic-gravatar" />
		</td>
		<td>
			<label>
				<input type="radio" name="set_pic_opt" class="set_pic_opt" value="gravatar" /> Use the default picture
				fetched from Gravatar
			</label>
		</td>
	</tr>
	{% endif %}

	<tr class="upload-new-photo">
		<td class="img">
			<ul class="files file-list"></ul>
		</td>
		<td>
			<label>
				<input type="radio" name="set_pic_opt" class="set_pic_opt" value="newpic" />
				Upload a new file (or drag and drop onto this area).
			</label>
			<br />
			<div class="file-input">
				<input type="file" name="file-upload" multiple="multiple" /> <button class="clean-gray xxx-small">Upload</button>
			</div>

			<script class="template-upload" type="text/x-jquery-tmpl">
				<li class="uploading">${name} <span class="cancel"><button class="clean-gray xx-small">Cancel</button></span></li>
			</script>
			<script class="template-download" type="text/x-jquery-tmpl">
				<li>
					<input type="hidden" name="new_blob_id" class="new_blob_id" value="${blob_id}" />
					<img src="${download_url}?s=80" class="pic-new" />
				</li>
			</script>
		</td>
	</tr>
</table>

<br />

<center><button class="dp-button save-trigger">Save</button></center>
