<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.Person';
pageMeta.title = {{ person.display_name|json_encode|raw }};
pageMeta.person_id = {{person.id}};
pageMeta.url_fragment  = '{{ url_fragment('agent_people_view', {'person_id': person.id}) }}';
pageMeta.pageIdentity = 'person1:{{person.id}}';
pageMeta.labelsAutocompleteUrl = '{{ path('agent_ajax_labels_autocomplete', { 'label_type': 'people'}) }}';
pageMeta.labelsSaveUrl = '{{ path('agent_person_ajax_labels_save', {'person_id': person.id}) }}';
pageMeta.saveFieldsUrl = '{{ path('agent_person_ajaxsavecustomfields', {'person_id': person.id }) }}';

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
{# Page Containers #}
<div class="profile layout-content with-scrollbar">
<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
<div class="scroll-viewport"><div class="scroll-content">
{# /Page Containers #}

<header class="page-header">
	<nav class="actions" id="{{baseId}}_action_buttons">
		<ul>
			<li class="create-ticket"><a class="clean-white large">{{ phrase('agent.create_ticket') }}</a></li>
			<li class="more menu-fitted" data-menu-button="> a"><a class="clean-white large arrow">{{ phrase('agent.more') }} <em></em></a></li>
		</ul>
	</nav>
	<div class="person-picture-box tipped" title="Click to upload a new picture" id="{{baseId}}_change_user_picture">
		<img src="{{ person.getPictureUrl(60) }}" id="{{baseId}}_picture_display" />
	</div>
	<div class="titlewrap">
		<h1>
			<span class="editable" data-editable-for="#{{baseId}}_editname">{{ person.name|default('Double-click to set Name') }}</span>
			<span class="edit-name-gear"></span>
			<div id="{{baseId}}_editname" style="display: none">
				<input type="hidden" name="action" value="name" />
				<input type="text" size="20" name="name" value="{{ person.name }}" />
			</div>
		</h1>
		<div class="meta-line">
			<div class="org"><span>
				{% if person.organization %}
					<span class="org-pos" {% if not person.organization_position %}style="display: none"{% endif %}><span class="org-pos-display">{{ person.organization_position }}</span>, </span>
					<span class="org-title-display"><a data-route="page:{{ path('agent_org_view', {'organization_id': person.organization.id}) }}" class="as-popover">{{ person.organization.name }}</a></span>
				{% else %}
					&nbsp;
				{% endif %}
			</span></div>
		</div>
	</div>

	<ul id="{{baseId}}_more_actions_menu" style="display: none;">
		{% if app.user.hasPerm('users.set-password') %}<li data-action="reset-password" class="reset-password">{{ phrase('agent.people.reset_password') }}</li>{% endif %}
		{% if app.user.hasPerm('users.delete') %}
			<li
				data-action="delete"
				data-delete-url="{{ path('agent_people_delete', {'person_id': person.id, 'security_token': security_token('delete_person') }) }}"
				class="delete-trigger">{{ phrase('agent.people.delete_user') }}</li>{% endif %}
	</ul>
	<br class="clear" />
</header>

<table class="layout-table" cellspacing="0" cellpadding="0" width="100%"><tr><td valign="top" width="60%">
	<section class="content-col">
		{% include 'AgentBundle:Person:view-content-col.html.twig' %}
	</section>
</td><td valign="top">
	<section class="property-col">
		{% include 'AgentBundle:Person:view-property-col.html.twig' %}
	</section>
</td></tr></table>

{% include 'AgentBundle:Person:contact-overlay.html.twig' %}

{# Page Containers #}
</div>
{% if with_warn_for_email %}
<div class="full-tab-warn">
	<div class="message">
		{{ phrase('agent.people.warn_email_address', {'email': with_warn_for_email}) }}
		<div class="controls">
			<button class="clean-white dismiss-trigger">{{ phrase('agent.okay') }}</button>
		</div>
	</div>
</div>
{% endif %}
</div>
</div>
{# /Page Containers #}
