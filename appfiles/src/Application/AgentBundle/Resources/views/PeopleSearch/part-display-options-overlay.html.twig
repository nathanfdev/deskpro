<div class="display-options overlay">
	<h1>Display Options</h1>
	<div style="float: right;">
		Order By: <select name="order_by">
			<option value="person.id:desc">Date Craeted (Newest-Oldest)</option>
			<option value="person.id:asc">Date Craeted (Oldest-Newest)</option>
			<option value="person.name:asc">Name (A-Z)</option>
			<option value="person.name:desc">Name (Z-A)</option>
		</select>
	</div>
	<div style="margin-right: 250px;">
		<strong>Display Elements</strong><br />
		<ul class="sortable-list">
			<li data-field="email_address"><input type="checkbox" name="email_address" /> Email Address</li>
			<li data-field="organization"><input type="checkbox" name="organization" /> Organization</li>
			<li data-field="locale"><input type="checkbox" name="locale" /> Locale</li>
			{% for f in person_field_defs %}
				<li data-field="person_fields[{{f.id}}]"><input type="checkbox" name="person_fields[{{f.id}}]" /> User Field: {{f.title}}</li>
			{% endfor %}
		</ul>
	</div>
	<div class="buttons">
		<div class="loading-off">
			<button class="save-trigger dp-button small">Save</button>
			<button class="close-trigger dp-button gray small">Cancel</button>
		</div>
		<div class="loading-on">
			<span>Saving ...</span>
		</div>
	</div>
</div>