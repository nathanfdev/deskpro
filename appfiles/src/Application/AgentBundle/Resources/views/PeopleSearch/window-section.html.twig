{##################################}
{# People #}
{##################################}

<section class="source-section sys-filters-section">
	<header>
		<h1>{{ phrase('agent.people') }}</h1>
	</header>
	<article>
		<ul class="source-list" id="people_outline_people_list">
			<li class="people nav-people">
				<h3 class="title auto-load-route " data-route="listpane:{{ path('agent_peoplesearch_customfilter') }}">
					<span class="list-counter">{{ people_count }}</span>
					{{ phrase('agent.people') }}
				</h3>
			</li>

			{% for id,title in usergroup_names %}
				<li
					class="usergroup-{{id}} nav-usergroup-{{id}}"
					data-usergroup-id="{{id}}"
					data-route="listpane:{{ path('agent_peoplesearch_customfilter') }}?terms[0][rule_type]=person_usergroup&amp;terms[0][op]=is&amp;terms[0][usergroup]={{id}}"
				>
					<h3 class="title">
						<span class="list-counter">{{ usergroup_counts[id]|default(0) }}</span>
						{{title}}
					</h3>
				</li>
			{% endfor %}
		</ul>

		<section class="source-tabs" id="people_outline_tabstrip" style="margin-top: 8px;">
			<ul>
				<li data-tab-for="#people_outline_tagcloud"><span>{{ phrase('agent.labels_cloud') }}</span></li>
				<li data-tab-for="#people_outline_taglist"><span>{{ phrase('agent.labels_list') }}</span></li>
			</ul>
		</section>

		<section class="source-labels-cloud deskpro-tab-item on" id="people_outline_tagcloud">
			<ul>
				{% for label,css_class in people_tag_cloud %}
					<li class="{{css_class}} nav-label-{{label|slugify}}" data-route="listpane:{{ path('agent_peoplesearch_customfilter') }}?terms[0][rule_type]=person_label&amp;terms[0][op]=is&amp;terms[0][label]={{label}}"><span>{{label}}</span></li>
				{% else %}
					<li>You haven't labeled any tickets. Load a ticket to label it.</li>
				{% endfor %}
			</ul>
			<br class="clear"/>
		</section>

		<section class="source-labels-list deskpro-tab-item" id="people_outline_taglist">
			<dl>
				{% for letter,labels in people_tag_index %}
					<dt>{{ letter }}</dt>
					<dd>
						<ul>
							{% for label in labels %}
								<li><span data-route="listpane:{{ path('agent_peoplesearch_customfilter') }}?terms[0][rule_type]=person_label&amp;terms[0][op]=is&amp;terms[0][label]={{label}}">{{label}}</span></li>
							{% endfor %}
						</ul>
					</dd>
				{% endfor %}
			</dl>
			<br class="clear"/>
		</section>
	</article>
</section>

{##################################}
{# Organizations #}
{##################################}

<section class="source-section sys-filters-section">
	<header>
		<h1>{{ phrase('agent.organizations') }}</h1>
	</header>
	<article>
		<ul class="source-list" id="people_outline_org_list">
			<li class="people nav-people">
				<h3 class="title" data-route="listpane:{{ path('agent_orgsearch_customfilter') }}">
					<span class="list-counter">{{ org_count|default('0') }}</span>
					{{ phrase('agent.organizations') }}
				</h3>
			</li>

			{% for id,title in usergroup_names %}
				<li
					class="usergroup-{{id}} nav-usergroup-org-{{id}}"
					data-usergroup-id="{{id}}"
					data-route="listpane:{{ path('agent_orgsearch_customfilter') }}?terms[0][rule_type]=usergroup&amp;terms[0][op]=is&amp;terms[0][usergroup]={{id}}"
				>
					<h3 class="title">
						<span class="list-counter">{{ org_usergroup_counts[id]|default(0) }}</span>
						{{title}}
					</h3>
				</li>
			{% endfor %}
		</ul>

		<section class="source-tabs" id="people_outline_org_tabstrip" style="margin-top: 8px;">
			<ul>
				<li data-tab-for="#people_outline_org_tagcloud"><span>{{ phrase('agent.labels_cloud') }}</span></li>
				<li data-tab-for="#people_outline_org_taglist"><span>{{ phrase('agent.labels_list') }}</span></li>
			</ul>
		</section>

		<section class="source-labels-cloud deskpro-tab-item on" id="people_outline_org_tagcloud">
			<ul>
				{% for label,css_class in org_tag_cloud %}
					<li class="{{css_class}}"><span data-route="listpane:{{ path('agent_orgsearch_customfilter') }}?terms[0][rule_type]=label&amp;terms[0][op]=is&amp;terms[0][label]={{label}}">{{label}}</span></li>
				{% else %}
					<li>{{ phrase('agent.no_people_labels') }}</li>
				{% endfor %}
			</ul>
		</section>

		<section class="source-labels-list deskpro-tab-item" id="people_outline_org_taglist">
			<dl>
				{% for letter,labels in org_tag_index %}
					<dt>{{ letter }}</dt>
					<dd>
						<ul>
							{% for label in labels %}
								<li><span data-route="listpane:{{ path('agent_orgsearch_customfilter') }}?terms[0][rule_type]=label&amp;terms[0][op]=is&amp;terms[0][label]={{label}}">{{label}}</span></li>
							{% endfor %}
						</ul>
					</dd>
				{% endfor %}
			</dl>
		</section>
	</article>
</section>
