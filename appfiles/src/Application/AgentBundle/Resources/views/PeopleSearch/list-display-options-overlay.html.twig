{% extends 'AgentBundle:Common:display-options-layout.html.twig' %}
{% block other_options %}
	<div style="display: none">
		Order By: <select name="order_by" class="sel-order-by">
			<option value="person.id:desc" class="date_created">Date Craeted (Newest-Oldest)</option>
			<option value="person.id:asc">Date Craeted (Oldest-Newest)</option>
			<option value="person.name:asc" class="people_name">Name (A-Z)</option>
			<option value="person.name:desc">Name (Z-A)</option>
			<option value="people.date_last_login:desc" class="last_login">Last Login Time</option>
			<option value="people.organization:asc" class="org">Organization</option>
			<option value="people.num_tickets:desc" class="num_tickets">Number of tickets</option>
		</select>
	</div>
{% endblock %}
{% block display_elements_list %}
	<li data-field="language"><input type="checkbox" name="language" {% if 'language' in display_fields %}checked="checked"{% endif %} /> {{ phrase('agent.language') }}</li>
	<li data-field="labels"><input type="checkbox" name="labels" {% if 'labels' in display_fields %}checked="checked"{% endif %} /> Labels</li>
	<li data-field="num_tickets"><input type="checkbox" name="num_tickets" {% if 'num_tickets' in display_fields %}checked="checked"{% endif %} /> Number of tickets</li>
	{% for f in person_field_defs %}
		<li data-field="person_fields[{{f.id}}]"><input type="checkbox" name="person_fields[{{f.id}}]" {% if "person_fields[#{f.id}]" in display_fields %}checked="checked"{% endif %} /> {{f.title}}</li>
	{% endfor %}
{% endblock %}
