<section class="search-reuslts page-set" data-page="{{page}}">
	{% for person in people %}
		<article class="person person-{{person.id}}">
			<h4 class="user-name">
				<a class="with-route name" data-route="person:{{ path('agent_people_view', {'person_id': person.id|default('0')}) }}">
					{{ person.display_name }}
				</a>
			</h4>
			{% if display_fields|length %}
			<div class="info">
				<ul>
					{% for field in display_fields %}
						{% if field == 'email_address' and person.primary_email_address %}
							<li><span class="prop-val email_address">{{ person.primary_email_address }}</span></li>
						{% elseif field == 'organization' and person.organization %}
							<li>
								<span class="prop-val org">{{ person.organization.name }}</span>
								{% if person.organization_position %}
									({{ person.organization_position }})
								{% endif %}
							</li>
						{% elseif field == 'locale' %}
							<li><span class="prop-val email_address">{{person.locale.title}}</span></li>
						{% else %}
							{% for f in person_field_defs %}
								{% if field == 'person_fields['~f.id~']' and person.hasCustomField(f.id) %}
								<li>
									{{ render_custom_field(person.getCustomFieldDisplayArray(f.id)) }}
								</li>
								{% endif %}
							{% endfor %}
						{% endif %}
					{% endfor %}
				</ul>
				<br class="clear" />
			</div>
			{% endif %}
		</article>
	{% endfor %}
</section>