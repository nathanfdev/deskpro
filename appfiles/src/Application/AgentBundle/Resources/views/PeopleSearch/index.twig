

{% if did_search %}
<table class="list" cellspacing="0" width="100%">
	<thead>
		<tr>
			<th>Name</th>
			<th>Email</th>
			<th>Labels</th>
		</tr>
	</thead>
	<tbody>
		{% for person in people_list %}
			<tr data-route="person:{% path 'agent_people_view' with ['person_id': person.id] %}">
				<td>{{person.display_name}}</td>
				<td>{{person.primary_email.email|default('No email')}}</td>
				<td>Labels...</td>
			</tr>
		{% else %}
			<tr><td colspan="3">No people match your criteria</td></tr>
		{% endfor %}
	</tbody>
</table>
{% endif %}