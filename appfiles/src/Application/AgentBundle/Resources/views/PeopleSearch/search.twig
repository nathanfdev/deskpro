<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.PeopleSearch';
</script>

<div class="listpane-top">
	<div class="search-form" style="display:none">
		<div class="toggle toggle-quick-search-form" style="float: right;">
			Quick Search &raquo;
		</div>
		<br />
		<form action="{% path 'agent_peoplesearch_perform' %}" method="post">
			<div class="search-form">
				<div class="search-terms"></div>
				<div class="term"><span class="add-term">+</span> Add a new search term</div>
			</div>
			<center><input type="submit" value="search" /></center>
		</form>
	</div>
	<div class="quick-search-form">
		<div class="toggle toggle-search-form" style="float:right;">
			Advanced Search &raquo;
		</div>
		<form action="{% path 'agent_peoplesearch_performquick' %}" method="post">
			<input type="search" name="q" placeholder="Begin typing a name, email address, label or company ..." style="width: 350px" />
			<img src="{% asset 'images/loading-small.gif' %}" alt="Searching..." class="quick-search-loading" style="display:none" />
		</form>
	</div>
	
	<div class="search-builder-tpl" style="display:none">
		<div class="row">
			<div class="term">
				<div class="type"></div>
				<div class="op"></div>
				<div class="choice"></div>
				<div class="remove">-</div>
			</div>
		</div>
		<div class="type" title="Department" data-rule-type="department">
			<div class="op">
				<select name="op">
					<option value="is">is</option>
					<option value="not">is not</option>
				</select>
			</div>
			<div class="choice">
				<select name="department">
					<option value="1">Sales</option>
					<option value="2">Support</option>
				</select>
			</div>
		</div>
		<div class="type" title="Priority" data-rule-type="priority">
			<div class="op">
				<select name="op">
					<option value="is">is</option>
					<option value="not">is not</option>
					<option value="lt">is less than</option>
					<option value="gt">is greater than</option>
				</select>
			</div>
			<div class="choice">
				<select name="priority">
					<option value="1">Low</option>
					<option value="2">High</option>
					<option value="3">Emergency</option>
				</select>
			</div>
		</div>
	</div>
</div>

<div class="search-results">

</div>