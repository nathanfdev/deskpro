<section class="search-reuslts page-set" data-page="{{page}}">
	{% for person in people %}
		<article class="row-item person person-{{person.id}}" data-route="person:{{ path('agent_people_view', {'person_id': person.id|default('0')}) }}" data-route-title="@selector(a.name)" data-route-openclass="open">
			<input type="checkbox" class="item-select" value="{{ ticket.id }}"/>
			<div class="top-row">
				<div class="top-row-left">
					<h3>
						<a class="name click-through">
							{{ person.display_name }}
						</a>
					</h3>
				</div>
			</div>
			<br class="clear" />
			{% if display_fields|length %}
				{% set extra_info_row %}
				{% set has_set = false %}
				<div class="extra-fields">
					<ul>
						{% for field in display_fields %}
							{% if field == 'email_address' and person.primary_email_address %}
								{% set has_set = true %}
								<li><span class="prop-val email_address">{{ person.primary_email_address }}</span></li>
							{% elseif field == 'organization' and person.organization %}
								{% set has_set = true %}
								<li>
									<span class="prop-val org">{{ person.organization.name }}</span>
									{% if person.organization_position %}
										({{ person.organization_position }})
									{% endif %}
								</li>
							{% elseif field == 'language' %}
								{% set has_set = true %}
								<li><span class="prop-val email_address">{{person.language.title}}</span></li>
							{% elseif field == 'num_tickets' %}
								{% set has_set = true %}
								<li><span class="prop-val num_tickets">Tickets: {{people_ticket_counts[person.id]|default(0)}}</span></li>
							{% else %}
								{% for f in user_all_custom_fields[person.id] %}
									{% if field == 'person_fields['~f.id~']' and person.hasCustomField(f.id) %}
									{% set has_set = true %}
									<li>
										<span class="prop-title">{{ f.title }}:</span>
										<span class="prop-val">{{ render_custom_field(f) }}</span>
									</li>
									{% endif %}
								{% endfor %}
							{% endif %}
						{% endfor %}
					</ul>
					<br class="clear" />
				</div>
				{% endset %}
				{% if has_set %}{{ extra_info_row }}{% endif %}
			{% endif %}
		</article>
	{% endfor %}
</section>
