<thead>
	<tr>
		{#
		{% if not disable_actions %}
			<th width="20" class="check-all check" width="5" valign="middle" style="vertical-align: middle;"><input type="checkbox" class="check-all-box selection-control" style="width:10px; margin: 0; margin-rght: 4px; padding: 0;"/></th>
		{% endif %}
		#}
		<th width="20%">Name</th>
		{% set perc = (80 / display_fields|length) %}
		{% for field in display_fields %}
			{% if field == 'email_address' %}<th width="{{perc}}%" data-field="email_address">Email Address</th>
			{% elseif field == 'organization' %}<th width="{{perc}}%" data-field="organization">Organization</th>
			{% elseif field == 'language' %}<th width="{{perc}}%" data-field="language">Language</th>
			{% else %}
				{% for f in person_field_defs %}
					{% if field == 'person_fields['~f.id~']' %}
					<th width="{{perc}}%" data-field="person_fields[{{f.id}}]">{{f.title}}</th>
					{% endif %}
				{% endfor %}
			{% endif %}
		{% endfor %}
	</tr>
</thead>
