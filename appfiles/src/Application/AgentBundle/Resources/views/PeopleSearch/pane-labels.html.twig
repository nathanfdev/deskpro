{% for label,css_class in cloud %}
	<li class="{{css_class}}"><a data-route="listpane:{{ path('agent_peoplesearch_customfilter') }}?terms[0][rule_type]=label&amp;terms[0][op]=is&amp;terms[0][label]={{label}}">{{label}}</a></li>
{% else %}
	<li>View a person to add labels to their profile. The most popular labels will show here.</li>
{% endfor %}