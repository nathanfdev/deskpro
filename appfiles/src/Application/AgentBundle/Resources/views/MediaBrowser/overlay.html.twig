<div class="media-browser overlay">
	<div class="overlay-title">
		<h4>Media</h4>
		<nav>
			<ul>
				<li class="tab-trigger new-file on" data-tab-for=".tab-content.new-file"><a>Choose Files</a></li>
				<li class="tab-trigger recent" data-tab-for=".tab-content.recent"><a>Recent Uploads</a></li>
				<li class="tab-trigger library" data-tab-for=".tab-content.library"><a>Library</a></li>
			</ul>
		</nav>
	</div>
	<div class="overlay-content no-footer">
		<section class="tab-content new-file" data-tab-trigger=".tab-trigger.new-file">
			<form action="{{ path('agent_mediabrowser_acceptupload') }}" method="POST" enctype="multipart/form-data" class="upload-form">
				<input type="hidden" name="protocol" value="http" />
				<label class="fileinput-button">
					<span>Choose files from your computer</span>
					<input type="file" name="files[]" multiple="multiple" />
				</label>
				or drag and drop files onto this window
			</form>
			<div class="files-list">
            </div>
		</section>
		<section class="tab-content recent" style="display: none;" data-tab-trigger=".tab-trigger.recent">
			Loading...
		</section>
		<section class="tab-content library" style="display: none;" data-tab-trigger=".tab-trigger.library">
			Loading...
		</section>
	</div>
</div>