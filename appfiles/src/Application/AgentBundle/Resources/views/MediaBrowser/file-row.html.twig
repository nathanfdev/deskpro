<div class="blob-row blob-{{blob.id}} {% if blob.isImage() %}is-image{% endif %}" data-blob-id="{{ blob.id }}">
	<div class="title">
		<label>
			Title:
			<input type="text" name="title" class="file-title" value="{{ blob.title|default(blob.filename) }}" />
		</label>
	</div>
	<div class="info">
		<div class="tags-wrap blob-tags">
			<span class="tag-icon"></span>
			<ul>
				{% for blob in blob.labels %}
					<li><span>{{label.label}}</span></li>
				{% endfor %}
			</ul>
		</div>
		<ul>
			<li><a href="{{ blob.download_url }}">Download file</a></li>
			<li>File name: {{ blob.filename }}</li>
			<li>File size: {{ blob.readable_filesize }}</li>
			{% if blob.dim_w %}
				<li>Dimentions: {{ blob.dim_w }}x{{ blob.dim_h }}</li>
			{% endif %}
		</ul>
	</div>
	<div class="footer">
		<button class="dp-button x-small remove-trigger" style="float: right">Remove</button>

		<button class="dp-button x-small link-trigger" data-code="[attach:{{ blob.id }} label:{{ blob.display_title }}]">Insert link to file</button>
		{% if blob.isImage() %}
			<button class="dp-button x-small image-trigger" data-code="[attach:{{ blob.id }} image]">Insert image</button>
			<button class="dp-button x-small image-edit-trigger">Insert edited image</button>
		{% endif %}
	</div>
</div>