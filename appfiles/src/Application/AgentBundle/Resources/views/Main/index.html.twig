	var DESKPRO_PERSON_ID = {{ person.id }};
	var DESKPRO_PROXY_KEY = '{{ proxy_key }}';

	$(document).ready(function() {
		$('pane_list_content').css('display', '');
		$('pane_content').css('display', '');

		window.DeskPRO_Window = new DeskPRO.Agent.Window({
			messageChanneler: {
				ajaxMessagesUrl: '{{ path('agent_messages_getnew') }}',
				ajaxSubscribeUrl: '{{ path('agent_messages_subscribe_channels') }}',
				ajaxUnsubscribeUrl: '{{ path('agent_messages_unsubscribe_channels') }}',
				lastMessageId: {{last_message_id}}
			}
		});

		{% if constant('DP_DEBUG') %}
			window.DeskPRO_Window.DEBUG = {
			};
		{% endif %}

		window.DeskPRO_Window.set('agent.ui.show-listpane', '{{ show_listpane|default('auto') }}');

