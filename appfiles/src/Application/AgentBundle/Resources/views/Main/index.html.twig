<!DOCTYPE HTML>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="robots" content="NOINDEX" />
	<meta http-equiv="X-UA-Compatible" content="IE=100" />
	<link rel="shortcut icon" id="favicon" href="{{ path('favicon', {}, true) }}" />

	<title>DeskPRO</title>
	<style type="text/css">
	body {
		overflow: hidden;
	}
	</style>

	<style type="text/css" id="loading_css_header">
		#header {
			display: none;
		}
	</style>
	<style type="text/css" id="loading_css">
	body {
		background: #fff !important;
	}
	#deskpro_layout, #agent_chats_wrapper, #agent_chat_panel {
		display: none;
	}

	#page_loading {
		position: absolute;
		top: 50px;
		left: 0;
		right: 0;

		padding-top: 28px;
		background: url({{ asset('images/tab-loading-inner.gif') }}) top center no-repeat;

		text-align: center;

		font-family: Arial, Verdana, Helvetica, sans-serif;
		font-size: 14px;
		font-weight: bold;
		color: #000;
	}
	</style>
</head>
<body class="{% if is_demo %}is-demo{% endif %}">
<div id="page_loading">
	Loading interface for {{ app.user.display_name }} ...
</div>

{% include 'AgentBundle:Main:header.html.twig' %}

{% include 'AgentBundle:Main:layout-wrappers.html.twig' %}

<div id="global_ajax_error" style="display:none; width: 340px; text-align: center;">
	<div class="overlay-content">
		<p>A network exception occurred and your last request did not complete. Please try again.</p>
		<div id="global_ajax_error_info" style="font-size: 9px; margin-top: 8px;"></div>
	</div>
</div>
<div id="alert_overlay" style="display:none; min-width: 150px;">
	<div class="overlay-content">
		<p id="alert_overlay_msg"></p>
	</div>
	<div class="overlay-actions">
		<button class="close-trigger dp-button small">Dismiss</button>
	</div>
</div>
<div id="confirm_overlay" style="display:none; min-width: 150px;">
	<div class="overlay-content">
		<p id="confirm_overlay_msg"></p>
	</div>
	<div class="overlay-actions">
		<button class="okay-trigger dp-button small green">Okay</button>
		<button class="cancel-trigger dp-button small">Cancel</button>
	</div>
</div>

{####################
 # RESOURCE LOADING
 ####################}

{% include 'AgentBundle:Main:resources.html.twig' %}
{% include 'AgentBundle:Main:page-init.html.twig' %}

</body>
</html>