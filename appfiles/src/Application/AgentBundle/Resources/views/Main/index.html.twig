<!DOCTYPE html>
<html>
<head>
	<meta charset="UTF-8"/>
	<meta name="robots" content="NOINDEX" />
	<meta http-equiv="X-UA-Compatible" content="IE=100" />
	<title>DeskPRO</title>

	<style type="text/css" media="screen">
		#window_loading_overlay {
			position:absolute;
			top: 0;
			right: 0;
			bottom: 0;
			left: 0;
			background-color: #165887;
			z-index: 10000000;
			text-align: center;
		}

		#window_loading_overlay .box {
			width: 400px;
			text-align: left;
			margin: 150px auto 0 auto;

			background-color: #fff;
			padding: 30px;

			-moz-border-radius: 20px;
			border-radius: 20px;

			-webkit-box-shadow: 5px 5px 5px #000000;
			-moz-box-shadow: 5px 5px 5px #000000;
			box-shadow: 5px 5px 5px #000000;

			text-align: center;
		}

		#window_loading_overlay .box h1 {
			font-family: Arial, Tahoma, Helvetica, sans-serif;
			font-size: 14pt;

			text-shadow: 1px 1px 2px #B2BBC2;
			filter: dropshadow(color=#B2BBC2, offx=1, offy=1);
		}

		#window_loading_overlay .box p {
			background: transparent url({{ asset('images/loading-big-circle.gif') }}) no-repeat top center;
			margin-top: 20px;
			padding-top: 52px;

			text-shadow: 0px 1px 1px #B2BBC2;
			filter: dropshadow(color=#B2BBC2, offx=1, offy=1);
		}
	</style>
</head>
<body class="{% if is_demo %}is-demo{% endif %}">

<div id="window_loading_overlay">
	<div class="box">
		<h1>Loading Interface</h1>
		<p>Please wait while the interface is loaded</p>
	</div>
</div>

<div id="header">
	<div id="header-top">
		<div class="wrapper">
			<div class="left box-header">
				<a href="index.html#" title="" class="logo">DeskPRO</a> 
			</div>

			<div class="left box-header select">
				<form id="search-form"action="index.html#" method="post">
					<input type="text" name="search" Value="Search">
				</form>
			</div>

			<div class="left box-header  notifications">
				<ul>
					<li><span class="icn-bar tickets"></span><div class="counter"><span class="counter">12</span></div></li>
					<li><span class="icn-bar chat"></span><div class="counter"><span class="counter">2</span></div></li>
				</ul>
				<span class="white-drop"></span>
			</div>

			<div class="right box-header current-user">
				<div class="wrapper-top-bar">
					<div class="current-user-avatar">

					</div>
					<div class="current-user-name">
						<span>{{person.display_name}}</span>
					</div>
					<span class="white-drop"></span>

				</div>
			</div>

			<div class="right box-header actions">
				<div class="wrapper-top-bar">
					<ul>
						<li class="help"><a href="index.html" title="Help">Help</a></li>
						<li class="multi"><a href="index.html" title="Multilingual">Multilingual</a></li>
						<li class="keyboard"><a href="index.html" title="Toggle keyboard shortcuts">Keyboard</a></li>
						<li class="network active"><a href="index.html" title="Network status">Network</a></li>
						<li class="sound"><a href="index.html" title="Toggle sound notifications">Sound</a></li>
					</ul>
				</div>
			</div>

			<div class="right box-header admin-actions">
				<div class="wrapper-top-bar">
					<ul>
						<li class="admin"><a href="{{ path('admin') }}" title="Go to agent interface">Admin</a></li>
						<li class="billing"><a href="index.html" title="">Billing</a></li>
						<li class="reports"><a href="index.html" title="">Reports</a></li>
					</ul>
				</div>
			</div>

		</div>
	</div>

	<div id="header-bottom">
		<div class="wrapper">


			<div class="left box-header-bot nav">
				<div class="wrapper-top-bar">
					<ul>
						<li class="tickets-nav"><a data-route="navpane:{{ path('agent_ticketsearch_queuespane') }}" title="">Tickets</a></li>
						<li class="chats-nav"><a href="index.html" title="">Chats</a></li>
						<li class="twitter-nav"><a href="index.html" title="">Twitter</a></li>
						<li class="facebook-nav"><a href="index.html" title="">Facebook</a></li>
						<li class="calls-nav"><a href="index.html" title="">Calls</a></li>
						<li class="users-nav"><a data-route="navpane:{{ path('agent_peoplesearch_findpane') }}" data-route-alt="listpane:{{ path('agent_peoplesearch') }}" title="">Users</a></li>
						<li class="deals-nav"><a href="index.html" title="">Deals</a></li>
						<li class="calendar-nav"><a href="index.html" title="">Calendar</a></li>
						<li class="tasks-nav"><a href="index.html" title="">Tasks</a></li>
						<li class="publish-nav"><a href="index.html" title="">Publish</a></li>
						<li class="ideas-nav"><a href="index.html" title="">Ideas</a></li>					
					</ul>
				</div>
			</div

		</div>
	</div>
</div>

{% include 'AgentBundle:Main:layout-wrappers.html.twig' %}

<div id="global_ajax_error" style="display:none; width: 340px; text-align: center;">
	<p>A network exception occurred and your last request did not complete. Please try again.</p>
	<div class="buttons" style="margin-top: 30px; text-align: center;">
		<button class="close-trigger dp-button small">Close</button>
	</div>
</div>
<div id="alert_overlay" style="display:none; min-width: 150px;">
	<p id="alert_overlay_msg"></p>
	<div class="buttons" style="margin-top: 30px; text-align: center;">
		<button class="close-trigger dp-button small">Okay</button>
	</div>
</div>
<div id="status_msg" style="display:none">
	<div class="help">(Click anywhere to hide)</div>
	<div class="message">Some kind of status message here</div>
	<div class="undo"><button class="dp-button x-small">Undo</button></div>
</div>

{####################
 # RESOURCE LOADING
 ####################}

<span id="test_route" data-route="page:{{ path('agent_ticket_new') }}" style="display:none"></span>

{% include 'AgentBundle:Main:resources.html.twig' %}

<script>
	var BASE_URL = '{{ path('user') }}';
	var ASSETS_BASE_URL = '{{ asset('') }}';
	var DESKPRO_PERSON_ID = {{ person.id }};
	var DESKPRO_PROXY_KEY = '{{ proxy_key }}';

	$(document).ready(function() {
		// Remove loading overlay
		$('#window_loading_overlay').remove();

		window.DeskPRO_Window = new DeskPRO.Agent.Window({
			messageChanneler: {
				ajaxMessagesUrl: '{{ path('agent_messages_getnew') }}',
				ajaxSubscribeUrl: '{{ path('agent_messages_subscribe_channels') }}',
				ajaxUnsubscribeUrl: '{{ path('agent_messages_unsubscribe_channels') }}',
				lastMessageId: {{last_message_id}}
			}
		});

		window.DeskPRO_Window.set('agent.ui.show-listpane', '{{ show_listpane|default('auto') }}');

		window.DeskPRO_Window.initPage();

		//window.DeskPRO_Window.runPageRouteFromElement($('#window_header_nav .tickets'));
		//window.DeskPRO_Window.runPageRouteFromElement($('#test_route'));

		// Debug: auto load a ticket tab
		window.DeskPRO_Window.runPageRoute('ticket:{{ path('agent_ticket_view', {'ticket_id': 3}) }}');
		//window.DeskPRO_Window.runPageRoute('person:{{ path('agent_people_view', {'person_id': 20001}) }}');
	});
</script>

</body>
</html>