<!DOCTYPE HTML>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="robots" content="NOINDEX" />
	<meta http-equiv="X-UA-Compatible" content="IE=100" />
	<link rel="shortcut icon" id="favicon" href="{{ path('favicon', {}, true) }}" />

	<title>DeskPRO</title>
	<style type="text/css">
	body {
		overflow: hidden;
	}
	</style>

	<style type="text/css" id="loading_css_header">
		#header {
			display: none;
		}
	</style>
	<style type="text/css" id="loading_css">
	body {
		background: #fff !important;
	}
	#deskpro_layout, #agent_chats_wrapper, #agent_chat_panel {
		display: none;
	}

	#page_loading {
		position: absolute;
		top: 50px;
		left: 0;
		right: 0;

		padding-top: 28px;
		background: url({{ asset('images/tab-loading-inner.gif') }}) top center no-repeat;

		text-align: center;

		font-family: Arial, Verdana, Helvetica, sans-serif;
		font-size: 14px;
		font-weight: bold;
		color: #000;
	}
	</style>
</head>
<body class="{% if is_demo %}is-demo{% endif %}">
<div id="dp_window">

{% include 'AgentBundle:Main:window-nav.html.twig' %}
{% include 'AgentBundle:Main:window-header.html.twig' %}
{% include 'AgentBundle:Main:window-col-layout.html.twig' %}
{% include 'AgentBundle:Main:window-chat.html.twig' %}

{####################
 # RESOURCE LOADING
 ####################}

{% include 'AgentBundle:Main:resources.html.twig' %}
{% include 'AgentBundle:Main:page-init.html.twig' %}
{% include 'AgentBundle:Main:global-templates.html.twig' %}

</div>{# /dp_window #}

</body>
</html>
