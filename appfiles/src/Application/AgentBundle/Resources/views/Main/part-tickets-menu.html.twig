<li class="tickets-nav" data-menu-handler="DeskPRO.Agent.WindowElement.MainMenu.Tickets">
	<span class="nav-counter" style="display:none">0</span>
	<a>Tickets</a>
	<ul class="wrap-dropdown-tabs">
		<li data-route="page:{{ path('agent_ticket_new') }}"><div class="new-ticket"><div>Create Ticket</div></div></li>
		<li class="slider-trigger" data-slide-to="tickets_search_section"><div class="search"><div>Search</div></div></li>
	</ul>
	<div class="wrap-dropdown n-drop tickets-drop has-tabs"><div class="x-track">
		{# tickets_main_section #}
		<div id="tickets_main_section">
			<div class="top-tickets-info">
				<ol>
					<li data-route="listpane:{{ path('agent_ticketsearch_runnamedfilter', {'filter_name': 'agent'}) }}">Yours<span class="ticket-counter" id="filter_agent_count">0</span></li>
					<li data-route="listpane:{{ path('agent_ticketsearch_runnamedfilter', {'filter_name': 'participant'}) }}">Participated<span class="ticket-counter" id="filter_participant_count">0</span></li>
					<li data-route="listpane:{{ path('agent_ticketsearch_runnamedfilter', {'filter_name': 'agent_team'}) }}">Your Teams<span class="ticket-counter" id="filter_agent_team_count">0</span></li>
					<li data-route="listpane:{{ path('agent_ticketsearch_runnamedfilter', {'filter_name': 'unassigned'}) }}">Unassigned<span class="ticket-counter" id="filter_unassigned_count">0</span></li>
					<li data-route="listpane:{{ path('agent_ticketsearch_runnamedfilter', {'filter_name': 'all'}) }}">All<span class="ticket-counter" id="filter_all_count">0</span></li>
				</ol>
			</div>

			<div class="tickets-content">

				<table cellspacing="0" cellpadding="0" width="100%"><tr><td valign="top" width="50%">

					<div class="inner-container">
						<div class="inner-container-title filters">
							<h3>Filters</h3>
						</div>
						<div class="inner-container-content with-scrollbar" id="filters_list_wrap">
							<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
							<div class="viewport"><div class="overview">
								<ol id="filters_list">
								</ol>
							</div></div>
						</div>
					</div>

					<div class="inner-container">
						<div class="inner-container-title tags-title">
							<div class="slider-trigger hoverview" data-slide-to="tickets_labels_list_section"><a>View all</a></div>
							<h3>Popular Labels</h3>
						</div>
						<div class="inner-container-content">
							<ol id="labels_cloud_list" class="tags tag-cloud"></ol>
						</div>
						<div style="text-align:center; margin-top: 8px;">
							<span data-route="listpane:{{ path('agent_ticketsearch_deletedlist') }}" style="cursor:pointer">View deleted tickets</span>
						</div>
					</div>

				</td><td valign="top" width="50%">

					<div class="inner-container">
						<div class="inner-container-title open-tickets">
							<h3>Grouped Tickets</h3>
						</div>
						<div class="inner-container-subtitle open-tickets" id="grouping_options">
							<span class="mode-menu-trigger mode menu" data-mode="agent">Your tickets</span>
							grouped by
							<span class="grouping-menu-trigger menu grouping1" data-groupby="department_id">Department</span>
							<span class="no-subgroup">(add <span class="grouping-menu-trigger menu">subgroup</span>)</span>
							<span class="with-subgroup" style="display:none">and <span class="grouping-menu-trigger menu grouping2" data-groupby=""></span></span>
						</div>
						<div class="inner-container-content with-scrollbar" id="overview_list_wrap">
							<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
							<div class="viewport"><div class="overview">
								<ol id="overview_list"></ol>
							</div></div>
						</div>
					</div>
					<ul id="overview_mode_menu" class="mode-menu" style="display:none">
						<li data-mode="agent">Your tickets</li>
						<li data-mode="participant">Participated tickets</li>
						<li data-mode="agent_team">Your teams tickets</li>
						<li data-mode="unassigned">Unassigned tickets</li>
						<li data-mode="all">All tickets</li>
					</ul>
					<ul id="overview_grouping_menu" class="grouping-menu" style="display:none">
						<li data-groupby="none">{{ phrase('core.none') }}</li>
						<li data-groupby="department_id">{{ phrase('core.department') }}</li>
						<li data-groupby="category_id">{{ phrase('core_tickets.category') }}</li>
						<li data-groupby="priority_id">{{ phrase('core_tickets.priority') }}</li>
						<li data-groupby="product_id">{{ phrase('core.product') }}</li>
						<li data-groupby="agent_id">{{ phrase('core_tickets.agent') }}</li>
						<li data-groupby="workflow_id">{{ phrase('core_tickets.workflow') }}</li>
					</ul>

					<div class="inner-container">
						<div class="inner-container-title flag-title">
							<div id="flagged_edit_btn"><a>Edit Names</a></div>
							<div id="flagged_save_btn"><a>Save Changes</a></div>
							<h3>Flagged</h3>
						</div>
						<div class="inner-container-content">
							<ol id="flagged_list" class="flags"></ol>
						</div>
					</div>

				</td></tr></table>
			</div>
		</div>
		{# /tickets_main_section #}

		{# tickets_labels_list_section #}
		<div id="tickets_labels_list_section" style="display:none">
			<div class="inner-container">
				<div class="inner-container-title flag-title">
					<div style="float:right; margin: 3px 3px 0 0;"><a class="slider-trigger" data-slide-to="tickets_main_section">Go Back</a></div>
					<h3>Labels Index</h3>
				</div>
				<div class="inner-container-content with-scrollbar" id="ticket_labels_index_content_wrap">
					<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
					<div class="viewport"><div class="overview">
						<div id="ticket_labels_index_content">Loading...</div>
					</div></div>
				</div>
			</div>
		</div>
		{# /tickets_labels_list_section #}

		{# tickets_search_section #}
		<div id="tickets_search_section" style="display:none">
			<div class="inner-container">
				<div class="inner-container-title flag-title">
					<div style="float:right; margin: 3px 3px 0 0;"><a class="slider-trigger" data-slide-to="tickets_main_section">Go Back</a></div>
					<h3>Ticket Search</h3>
				</div>
				<div class="inner-container-content with-scrollbar" id="tickets_search_section_wrap">
					<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
					<div class="viewport"><div class="overview">
						<div id="tickets_search_section_content">

							<div class="search-form">
								<form action="{{ path('agent_ticketsearch_runcustomfilter') }}" method="post" id="tickets_search_form">
									<div class="search-terms"></div>
									<div class="term"><span class="add-term">+</span> Add a new criteria</div>
									<div class="term">
										Order by
										<select name="filter[order_by]">
											<option value="ticket.date_created:desc">Date Opened (Newer-Older)</option>
											<option value="ticket.date_created:asc">Date Opened (Older-Newer)</option>
											<option value="ticket.priority:desc">Priority (Highest-Lowest)</option>
											<option value="ticket.priority:asc">Priority (Lowest-Highest)</option>
										</select>
									</div>
									<div class="term">
										Group by
										<select name="filter[group_by]">
											<option value="">(No grouping)</option>
											{% for id,name in {'priority_id':'Priority', 'status': 'Status', 'department_id': 'Department', 'category_id': 'Category', 'product_id': 'Product', 'agent_id': 'Agent', 'agent_team_id': 'Agent Team'} %}
												<option value="{{id}}" {%if filter.group_by == id %}selected="selected"{%endif%}>{{name}}</option>
											{% endfor %}
										</select>
									</div>
									<center><input type="submit" value="search" /></center>
								</form>
							</div>

							<div class="search-builder-tpl" style="display:none">
								<div class="row">
									<div class="term">
										<div class="type"></div>
										<div class="op"></div>
										<div class="choice"></div>
										<div class="remove">-</div>
									</div>
								</div>
								{% include 'AgentBundle:TicketSearch:termbuilder-html.html.twig' with {'term_options': ticket_options} %}
							</div>
						</div>
					</div></div>
				</div>
			</div>
		</div>
		{# /tickets_search_section #}
	</div></div>
</li>