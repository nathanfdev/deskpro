<li class="keyboard with-menu">
	<a href="" class="tipped" data-tipped="keyboard_shortcuts_tip" data-tipped-options="inline: true, hook: 'bottommiddle'">Keyboard</a>
	<div id="keyboard_shortcuts_tip" style="display: none">
		<table cellspacing="0" cellpadding="0" width="100%">
			<tr>
				<td>
					<h5>{{ phrase('agent.window.window_navigation') }}</h5>
					<div class="row">
						<kbd>ctrl+left</kbd> {{ phrase('agent.window.key_left_tab') }}
					</div>
					<div class="row">
						<kbd>ctrl+right</kbd> {{ phrase('agent.window.key_right_tab') }}
					</div>
					<div class="row">
						<kbd>ctrl+shift+c</kbd> {{ phrase('agent.window.key_close_tab') }}
					</div>
				</td>
				<td>
					<h5>Create Content</h5>
					<div class="row">
						<kbd>t</kbd> {{ phrase('agent.window.new_ticket') }}
					</div>
					<div class="row">
						<kbd>p</kbd> {{ phrase('agent.window.new_person') }}
					</div>
					<div class="row">
						<kbd>a</kbd> {{ phrase('agent.window.new_article') }}
					</div>
					<div class="row">
						<kbd>d</kbd> {{ phrase('agent.window.new_download') }}
					</div>
					<div class="row">
						<kbd>i</kbd> {{ phrase('agent.window.new_feedback') }}
					</div>
				</td>
			</tr>
		</table>
		<table cellspacing="0" cellpadding="0" width="100%">
			<tr>
				<td>
					<h5>{{ phrase('agent.window.tickets') }}</h5>
					<div class="row">
						<kbd>shit+r</kbd> {{ phrase('agent.window.focus_reply_box') }}
					</div>
					<div class="row">
						<kbd>shift+c</kbd> {{ phrase('agent.window.set_ticket_resolved') }}
					</div>
					<div class="row">
						<kbd>shift+a</kbd> {{ phrase('agent.window.assign_to_self') }}
					</div>
				</td>
				<td>
					<h5>People</h5>
					<div class="row">
						<kbd>shift+r</kbd> {{ phrase('agent.window.focus_notes_box') }}
					</div>
					<div class="row">
						<kbd>shift+t</kbd> {{ phrase('agent.window.create_ticket_person') }}
					</div>
				</td>
			</tr>
		</table>
	</div>
</li>
