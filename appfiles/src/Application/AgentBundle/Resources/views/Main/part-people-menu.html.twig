<li class="people-nav" data-menu-handler="DeskPRO.Agent.WindowElement.MainMenu.People">
	<a>People</a>
	<ul class="wrap-dropdown-tabs">
		<li id="people_search_section_btn"><span class="search">Search People</span></li>
		<li id="org_search_section_btn"><span class="search">Search Organizations</span></li>
	</ul>
	<div class="wrap-dropdown n-drop people-drop has-tabs"><div class="x-track">
		{# people_main_section #}
		<div id="people_main_section">
			<div class="people-content">

				<table cellspacing="0" cellpadding="0" width="100%"><tr><td colspan="2">

					<div class="inner-container">
						<div class="inner-container-title open-tickets">
							<h3>Directory</h3>
						</div>
						<div class="inner-container-content" style="text-align:center;">
							<a data-route="listpane:{{ path('agent_peoplesearch_customfilter') }}?terms[0][rule_type]=directory_name&amp;terms[0][op]=is&amp;terms[0][letter]=OTHER&amp;page_title={{ 'Directory Misc'|raw_url_encode }}">#</a> &middot;
							{% for a in range('A','Z') %}
								<a data-route="listpane:{{ path('agent_peoplesearch_customfilter') }}?terms[0][rule_type]=directory_name&amp;terms[0][op]=is&amp;terms[0][letter]={{a}}&amp;page_title={{ 'Directory ' ~ a|raw_url_encode }}">{{a}}</a>{% if not loop.last %} &middot; {% endif %}
							{% endfor %}
						</div>
					</div>

				</td></tr><tr><td valign="top" width="52%">

					<div class="inner-container">
						<div class="inner-container-title tags-title">
							<div id="people_labels_viewall"><a>View all labels</a></div>
							<h3>People Labels</h3>
						</div>
						<div class="inner-container-content">
							<ol id="people_labels_cloud_list" class="tags tag-cloud"></ol>
						</div>
					</div>

					<div class="inner-container">
						<div class="inner-container-title">
							<h3>Groups</h3>
						</div>
						<div class="inner-container-content">
							<ol id="people_groups_list"></ol>
						</div>
					</div>

				</td><td valign="top" width="48%">

					<div class="inner-container">
						<div class="inner-container-title tags-title">
							<div id="org_labels_viewall"><a>View all labels</a></div>
							<h3>Oragnization Labels</h3>
						</div>
						<div class="inner-container-content">
							<ol id="org_labels_cloud_list" class="tags tag-cloud"></ol>
						</div>
					</div>

				</td></tr></table>
			</div>
		</div>
		{# /people_main_section #}

		{# people_labels_list_section #}
		<div id="people_labels_list_section" style="display:none">
			<div class="inner-container">
				<div class="inner-container-title flag-title">
					<div id="people_labels_index_back" style="float:right; margin: 3px 3px 0 0;"><a>Go Back</a></div>
					<h3>People Labels Index</h3>
				</div>
				<div class="inner-container-content with-scrollbar" id="people_labels_index_content_wrap">
					<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
					<div class="viewport"><div class="overview">
						<div id="people_labels_index_content">Loading...</div>
					</div></div>
				</div>
			</div>
		</div>
		{# /people_labels_list_section #}

		{# org_labels_list_section #}
		<div id="org_labels_list_section" style="display:none">
			<div class="inner-container">
				<div class="inner-container-title flag-title">
					<div id="org_labels_index_back" style="float:right; margin: 3px 3px 0 0;"><a>Go Back</a></div>
					<h3>Organization Labels Index</h3>
				</div>
				<div class="inner-container-content with-scrollbar" id="org_labels_index_content_wrap">
					<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
					<div class="viewport"><div class="overview">
						<div id="org_labels_index_content">Loading...</div>
					</div></div>
				</div>
			</div>
		</div>
		{# /org_labels_list_section #}

		{# people_search_section #}
		<div id="people_search_section" style="display:none">
			<div class="inner-container">
				<div class="inner-container-title flag-title">
					<div id="people_search_section_back" style="float:right; margin: 3px 3px 0 0;"><a>Go Back</a></div>
					<h3>Search People</h3>
				</div>
				<div class="inner-container-content with-scrollbar" id="people_search_section_wrap">
					<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
					<div class="viewport"><div class="overview">
						<div id="people_search_section_content">

							<div class="search-form">
								<form action="{{ path('agent_peoplesearch_customfilter') }}" method="post">
									<div class="search-form">
										<div class="search-terms"></div>
										<div class="term"><span class="add-term">+</span> Add a new search term</div>
									</div>
									<center><input type="submit" value="search" id="people_search_submit" /></center>
								</form>
							</div>

							<div class="search-builder-tpl" style="display:none">
								<div class="row">
									<div class="term">
										<div class="type"></div>
										<div class="op"></div>
										<div class="choice"></div>
										<div class="remove">-</div>
									</div>
								</div>
								<div class="type" title="Organization" data-rule-type="organization">
									<div class="op">
										<select name="op">
											<option value="is">is</option>
											<option value="not">is not</option>
										</select>
									</div>
									<div class="choice">
										<select name="organization">
											{% for id,title in titles.organizations %}
												<option value="{{id}}">{{title}}</option>
											{% endfor %}
										</select>
									</div>
								</div>
								<div class="type" title="Usergroup" data-rule-type="usergroup">
									<div class="op">
										<select name="op">
											<option value="is">is</option>
											<option value="not">is not</option>
										</select>
									</div>
									<div class="choice">
										<select name="usergroup">
											{% for id,title in titles.usergroups %}
												<option value="{{id}}">{{title}}</option>
											{% endfor %}
										</select>
									</div>
								</div>
								<div class="type" title="Person ID" data-rule-type="id">
									<div class="op">
										<select name="op">
											<option value="gte">is greater than</option>
											<option value="lte">is less than</option>
										</select>
									</div>
									<div class="choice">
										<input type="text" name="id" value="" />
									</div>
								</div>
								<div class="type" title="Locale" data-rule-type="locale">
									<div class="op">
										<select name="op">
											<option value="is">is</option>
											<option value="not">is not</option>
										</select>
									</div>
									<div class="choice">
										<select name="locale">
											{% for id,title in titles.locales %}
												<option value="{{id}}">{{title}}</option>
											{% endfor %}
										</select>
									</div>
								</div>

								<div class="type" title="Email Domain" data-rule-type="email_domain">
									<div class="op">
										<select name="op">
											<option value="is">is</option>
											<option value="not">is not</option>
										</select>
									</div>
									<div class="choice">
										<input type="text" name="email_domain" value="" />
									</div>
								</div>
								<div class="type" title="Email Domain" data-rule-type="email_domain">
									<div class="op">
										<select name="op">
											<option value="is">is</option>
											<option value="not">is not</option>
										</select>
									</div>
									<div class="choice">
										<input type="text" name="email_domain" value="" />
									</div>
								</div>
								<div class="type" title="Labels" data-rule-type="label">
									<div class="op">
										<select name="op">
											<option value="is">includes label</option>
											<option value="not">does not include label</option>
										</select>
									</div>
									<div class="choice">
										<input type="text" name="label" value="" />
									</div>
								</div>
								<div class="type" title="Name" data-rule-type="name">
									<div class="op">
										<select name="op">
											<option value="contains">is</option>
											<option value="notcontains">is not</option>
										</select>
									</div>
									<div class="choice">
										<input type="text" name="name" value="" />
									</div>
								</div>
								<div class="type" title="Contact Phone" data-rule-type="contact_phone">
									<div class="op">
										<select name="op">
											<option value="contains">is</option>
											<option value="notcontains">is not</option>
										</select>
									</div>
									<div class="choice">
										<input type="text" name="phone" value="" />
									</div>
								</div>
								<div class="type" title="Contact Address" data-rule-type="contact_address">
									<div class="op">
										<select name="op">
											<option value="contains">is</option>
											<option value="notcontains">is not</option>
										</select>
									</div>
									<div class="choice">
										<input type="text" name="address" value="" />
									</div>
								</div>
								<div class="type" title="Contact Instant Messaging" data-rule-type="contact_im">
									<div class="op">
										<select name="op">
											<option value="contains">is</option>
											<option value="notcontains">is not</option>
										</select>
									</div>
									<div class="choice">
										<input type="text" name="im" value="" />
									</div>
								</div>
								{% if people_fields %}
									{% set op_lang = {'is': 'is', 'not': 'is not', 'contains': 'has', 'notcontains': 'does not have', 'gt': 'is greater than', 'lt': 'is less than'} %}
									{% for field in people_fields %}
										<div class="type" title="Field: {{field.field_def.title}}" data-rule-type="person_field[{{field.field_def.id}}]">
											<div class="op">
												<select name="op">
													{% for op in field.field_def.search_capabilities %}
														<option value="{{op}}">{{op_lang[op]}}</option>
													{% endfor %}
												</select>
											</div>
											<div class="choice">
												{{ form_field(field.form) }}
											</div>
										</div>
									{% endfor %}
								{% endif %}
							</div>
						</div>
					</div></div>
				</div>
			</div>
		</div>
		{# /people_search_section #}
	
		{# org_search_section #}
		<div id="org_search_section" style="display:none">
			<div class="inner-container">
				<div class="inner-container-title flag-title">
					<div id="org_search_section_back" style="float:right; margin: 3px 3px 0 0;"><a>Go Back</a></div>
					<h3>Search Organizations</h3>
				</div>
				<div class="inner-container-content with-scrollbar" id="org_search_section_wrap">
					<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
					<div class="viewport"><div class="overview">
						<div id="org_search_section_content">

							<div class="search-form">
								<form action="{{ path('agent_orgsearch_customfilter') }}" method="post">
									<div class="search-form">
										<div class="search-terms"></div>
										<div class="term"><span class="add-term">+</span> Add a new search term</div>
									</div>
									<center><input type="submit" value="search" id="org_search_submit" /></center>
								</form>
							</div>

							<div class="search-builder-tpl" style="display:none">
								<div class="row">
									<div class="term">
										<div class="type"></div>
										<div class="op"></div>
										<div class="choice"></div>
										<div class="remove">-</div>
									</div>
								</div>
								<div class="type" title="Organization ID" data-rule-type="id">
									<div class="op">
										<select name="op">
											<option value="gte">is greater than</option>
											<option value="lte">is less than</option>
										</select>
									</div>
									<div class="choice">
										<input type="text" name="id" value="" />
									</div>
								</div>
								<div class="type" title="Organization Name" data-rule-type="name">
									<div class="op">
										<select name="op">
											<option value="contains">is</option>
											<option value="notcontains">is not</option>
										</select>
									</div>
									<div class="choice">
										<input type="text" name="name" value="" />
									</div>
								</div>
								<div class="type" title="Contact Phone" data-rule-type="contact_phone">
									<div class="op">
										<select name="op">
											<option value="contains">is</option>
											<option value="notcontains">is not</option>
										</select>
									</div>
									<div class="choice">
										<input type="text" name="phone" value="" />
									</div>
								</div>
								<div class="type" title="Contact Address" data-rule-type="contact_address">
									<div class="op">
										<select name="op">
											<option value="contains">is</option>
											<option value="notcontains">is not</option>
										</select>
									</div>
									<div class="choice">
										<input type="text" name="address" value="" />
									</div>
								</div>
								<div class="type" title="Contact Instant Messaging" data-rule-type="contact_im">
									<div class="op">
										<select name="op">
											<option value="contains">is</option>
											<option value="notcontains">is not</option>
										</select>
									</div>
									<div class="choice">
										<input type="text" name="im" value="" />
									</div>
								</div>
								{% if org_fields %}
									{% set op_lang = {'is': 'is', 'not': 'is not', 'contains': 'has', 'notcontains': 'does not have', 'gt': 'is greater than', 'lt': 'is less than'} %}
									{% for field in org_fields %}
										<div class="type" title="Field: {{field.field_def.title}}" data-rule-type="organization_field[{{field.field_def.id}}]">
											<div class="op">
												<select name="op">
													{% for op in field.field_def.search_capabilities %}
														<option value="{{op}}">{{op_lang[op]}}</option>
													{% endfor %}
												</select>
											</div>
											<div class="choice">
												{{ form_field(field.form) }}
											</div>
										</div>
									{% endfor %}
								{% endif %}
							</div>
						</div>
					</div></div>
				</div>
			</div>
		</div>
		{# /org_search_section #}
	</div></div>
</li>