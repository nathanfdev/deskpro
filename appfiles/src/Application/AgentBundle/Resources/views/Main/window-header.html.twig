<!-- BEGIN HEADER BAR -->
<div id="dp_header">
	<!-- BEGIN NOTIFICATION SECTION -->
	<div id="DP-NotificationSection">
		<div id="notificationWrap" class="left">
			<div class="notifications" id="dp_notif_bed" style="display: none;">
				<div class="notifMail notif-item notif-tickets" style="display: none;"><span class="counter">0</span></div>
				<div class="notifChat notif-item notif-chat" style="display: none;"><span class="counter">0</span></div>
			</div>
		</div>
	</div>
	<div id="notificationDropdown" style="display:none;">
		<div class="notifDropdown">
			<div class="notifHead">
				<div class="notifMail notif-item notif-tickets" style="display: none;"><span class="counter">0</span></div>
				<div class="notifChat notif-item notif-chat" style="display: none;"><span class="counter">0</span></div>
			</div>
			<ul id="dp_notify_list">
				<li class="dismissAll" id="dp_notify_list_dismiss">
					<a>Dismiss all notifications</a>
				</li>
			</ul>
		</div>
	</div>
	<!-- END NOTIFICATION SECTION -->
	<!-- BEGIN SEARCH SECTION -->
	<div id="dp_omnibox_wrap">
		<div id="dp_omnibox">
			<div class="searchBoxWrap">

			</div>
		</div>
	<!-- END SEARCH SECTION -->
	</div>
	<!-- BEGIN CREATE SECTION -->
	<div id="DP-CreateSection">
		<div class="DP-createTicket">
			<div id="createContentTrigger" class="newContent">
				<a><span class="plusIcon">Create</span></a>
			</div>
		</div>
		<!-- Header - Create Ticket Dropdown on click -->
		<div id="createTicketToggle" style="display:none;">
			<div class="createHeader">
				<a>Create</a>
			</div>
			<div class="createDropdown">
				<ul class="createBtnPopups">
					<li id="create_ticket_btn"><a><span class="createTicket">Ticket <kbd>t</kbd></span></a></li>
					<li id="create_task_btn"><a><span class="createTask">Task <kbd>j</kbd></span></a></li>
					<li id="create_person_btn"><a><span class="createPerson">Person <kbd>p</kbd></span></a></li>
					<li id="create_organization_btn"><a><span class="createOrg">Organization <kbd>o</kbd></span></a></li>
					<li id="create_article_btn"><a><span class="createArticle">Article <kbd>k</kbd></span></a></li>
					<li id="create_news_btn"><a><span class="createNews">News Entry <kbd>n</kbd></span></a></li>
					<li id="create_download_btn"><a><span class="createDownload">Download <kbd>d</kbd></span></a></li>
					<li id="create_idea_btn"><a><span class="createIdeas">Ideas <kbd>i</kbd></span></a></li>
				</ul>
			</div>
		</div>
	<!-- END CREATE SECTION -->
	</div>
	<!-- BEGIN USER SECTION -->
	<div id="DP-UserSection">
		<div id="DP-userControl">
			<div class="currentUserAvatar">
				<div class="userWrapper">
					<a onclick="toggle_visibility('userSetting');"><img src="{{ app.user.getPictureUrl(20) }}" alt="" /></a>
				</div>
				<span class="dropdownIcon" onclick="toggle_visibility('userSetting');"></span>
			</div>
		</div>
		<!-- Header - User Control Dropdown -->
		<div id="userSetting" style="display:none;">
			<div class="userProfileDropdown" >
				<div class="userProfileDropdownHeader">
					<a onclick="toggle_visibility('userSetting');"><img src="{{ app.user.getPictureUrl(20) }}" alt="" /></a>
				</div>
				<ul>
					<li class="currentUsername"><p>{{ app.user.display_name }}</p></li>
					<li class="setting" id="user_settings_link"><a>Settings</a></li>
					<li class="help"><a>Help</a></li>
					<li class="logout"><a href="{{ path('user_logout', {'auth': security_token('user_logout')}) }}">Log out</a></li>
				</ul>
			</div>
		</div>
	<!-- END USER SECTION -->
	</div>

	<!-- BEGIN INTERFACE SECTION -->
	<div id="DP-InterfaceSwitcher">
		<div class="DP-adminSwitch">
			<div class="adminSwitcher">
				<a>Agent Interface<span class="dropdownIcon"></span></a>
			</div>
		</div>
		<!-- Header - Switch Button Interfaces- Dropdown -->
		<div id="interfacesToggle" style="display:none;">
		<div class="dropdownSwitcherWrap" >
			<div class="switcherHeader">
				<a><span>Agent Interface</span></a>
			</div>
			<ul>
				<li><a class="admin" href="{{ path('admin_login', {'dpsid-agent': app.getSession().getId() }) }}"><span>Admin Interface</span></a></li>
				<li><a class="billing" href=""><span>Billing Interface</span></a></li>
				<li><a class="report" href=""><span>Report Interface</span></a></li>
				<li><a class="portal" href="{{ path('user') }}"><span>User Interface</span></a></li>
			</ul>
		</div>
		</div>
	</div>
	<!-- END INTERFACE SECTION -->

	<!-- BEGIN STATUS SECTION -->
	<div id="DP-StatusSection">
		<div class="DP-adminStatus">
			<ul>
				<li class="agentStatus" id="agent_status_trigger">
					<a class="tipped on" id="agent_status" data-tipped="Toggle your away status" data-tipped-options="hook: 'bottommiddle'"><em class="label-away">Away</em><em class="label-dnd">DND</em></a>
					<div id="agent_status_menu" style="display:none;">
						<div class="createDropdown">
							<ul class="createBtnPopups">
								<li class="status_go_available"><a><span class="createTicket">Available</span></a></li>
								<li class="status_go_away"><a><span class="createTask">Away</span></a></li>
								<li class="status_go_dnd"><a><span class="createPerson">Do Not Disturb</span></a></li>
							</ul>
						</div>
					</div>
				</li>
				<li class="networkStatIndicator">
					<a class="tipped" data-tipped="<div id='network_status_tip'>Network status<br /><div class='network-status-green'>Everything seems okay</div><div class='network-status-red'>Red: Network problems, you may have been disconnected</div></div>" data-tipped-options="hook: 'bottommiddle'">
						Network
					</a>
				</li>
				<li class="soundIcon">
					<a class="tipped" id="sound_icon" title="Change or mute sound notifications" data-tipped-options="hook: 'bottommiddle'">Sound</a>
				</li>
			</ul>
		</div>
	</div>
	<!-- END STATUS SECTION -->
<!-- END HEADER BAR -->
</div>
