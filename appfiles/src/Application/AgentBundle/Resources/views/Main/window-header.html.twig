<!-- BEGIN HEADER BAR -->
<div id="dp_header">
	<!-- BEGIN NOTIFICATION SECTION -->
	<div id="DP-NotificationSection">
		<div id="notificationWrap" class="left">
			<div class="notifications" id="dp_notif_bed" style="display: none;">
				<div class="notifMail notif-item notif-tickets" style="display: none;"><span class="counter">0</span></div>
				<div class="notifChat notif-item notif-chat" style="display: none;"><span class="counter">0</span></div>
			</div>
		</div>
	</div>
	<div id="notificationDropdown" style="display:none;">
		<div class="notifDropdown">
			<div class="notifHead">
				<div class="notifMail notif-item notif-tickets" style="display: none;"><span class="counter">0</span></div>
				<div class="notifChat notif-item notif-chat" style="display: none;"><span class="counter">0</span></div>
			</div>
			<ul id="dp_notify_list">
				<li class="dismissAll" id="dp_notify_list_dismiss">
					<a>{{ phrase('agent.window.dismiss_notifications') }}</a>
				</li>
			</ul>
		</div>
	</div>
	<!-- END NOTIFICATION SECTION -->
	<!-- BEGIN SEARCH SECTION -->
	<div id="dp_omnibox_wrap">
		<div id="dp_omnibox">
			<div class="searchBoxWrap" id="dp_omniinput_wrap">
				<div class="type-icon">
					<span class="icon"></span>
				</div>
				<input type="input" id="dp_omniinput" size="4" placeholder="Search" data-element-handler="DeskPRO.Agent.ElementHandler.OmniQuickSearch" />
			</div>
		</div>
		<div id="dp_omnibox_adv">
			<a><span class="plusIcon">Advanced</span></a>
		</div>
	<!-- END SEARCH SECTION -->
	</div>
	<!-- BEGIN CREATE SECTION -->
	<div id="DP-CreateSection">
		<div class="DP-createTicket">
			<div id="createContentTrigger" class="newContent">
				<a><span class="plusIcon">{{ phrase('agent.create') }}</span></a>
			</div>
		</div>
		<!-- Header - Create Ticket Dropdown on click -->
		<div id="createTicketToggle" style="display:none;">
			<div class="createHeader">
				<a>{{ phrase('agent.create') }}</a>
			</div>
			<div class="createDropdown">
				<ul class="createBtnPopups">
					<li id="create_ticket_btn"><a><span class="createTicket">{{ phrase('agent.window.new_ticket') }} <kbd>t</kbd></span></a></li>
					<li id="create_task_btn"><a><span class="createTask">{{ phrase('agent.window.new_task') }} <kbd>k</kbd></span></a></li>
					<li id="create_person_btn"><a><span class="createPerson">{{ phrase('agent.window.new_person') }} <kbd>p</kbd></span></a></li>
					<li id="create_organization_btn"><a><span class="createOrg">{{ phrase('agent.window.new_organization') }} <kbd>o</kbd></span></a></li>
					<li id="create_article_btn"><a><span class="createArticle">{{ phrase('agent.window.new_article') }} <kbd>a</kbd></span></a></li>
					<li id="create_news_btn"><a><span class="createNews">{{ phrase('agent.window.new_news') }} <kbd>n</kbd></span></a></li>
					<li id="create_download_btn"><a><span class="createDownload">{{ phrase('agent.window.new_download') }} <kbd>d</kbd></span></a></li>
					<li id="create_feedback_btn"><a><span class="createFeedback">{{ phrase('agent.window.new_feedback') }} <kbd>i</kbd></span></a></li>
					{#<li id="create_deal_btn"><a><span class="createDeals">{{ phrase('agent.window.new_deal') }} <kbd>l</kbd></span></a></li>#}
				</ul>
			</div>
		</div>
	<!-- END CREATE SECTION -->
	</div>
	<!-- BEGIN USER SECTION -->
	<div id="DP-UserSection">
		<div id="DP-userControl">
			<div class="currentUserAvatar">
				<div class="userWrapper">
					<a onclick="toggle_visibility('userSetting');">
						<em style="background-image: url({{ app.user.getPictureUrl(20) }});"></em>
						<span class="drop"></span>
					</a>
				</div>
			</div>
		</div>
		<!-- Header - User Control Dropdown -->
		<div id="userSetting" style="display:none;">
			<div class="userProfileDropdown" >
				<div class="userProfileDropdownHeader" onclick="toggle_visibility('userSetting');">
					<a><em style="background-image: url({{ app.user.getPictureUrl(20) }});"></em></a>
					<span class="drop"></span>
				</div>
				<ul>
					<li class="currentUsername"><p>{{ app.user.display_name }}</p></li>
					<li class="setting" id="user_settings_link"><a>{{ phrase('agent.window.settings') }}</a></li>
					<li class="help"><a>{{ phrase('agent.window.help') }}</a></li>
					<li class="logout"><a href="{{ path('user_logout', {'auth': static_security_token('user_logout')}) }}?to=agent">{{ phrase('agent.window.logout') }}</a></li>
				</ul>
			</div>
		</div>
	<!-- END USER SECTION -->
	</div>

	<!-- BEGIN INTERFACE SECTION -->
	{% if app.user.can_admin or app.user.can_billing or app.user.can_reports or app.getSetting('user.portal_enabled') %}
	<div id="DP-InterfaceSwitcher">
		<div class="DP-adminSwitch">
			<div class="adminSwitcher">
				<a class="agent">Agent Interface<span class="dropdownIcon"></span></a>
			</div>
		</div>
		<!-- Header - Switch Button Interfaces- Dropdown -->
		<div id="interfacesToggle" style="display:none;">
		<div class="dropdownSwitcherWrap" >
			<div class="switcherHeader">
				<a class="agent"><span>{{ phrase('agent.window.agent_interface') }}</span></a>
			</div>
			<ul>
				{% if app.user.can_admin %}<li><a class="admin" href="{{ app.request.getBaseUrl() }}/admin/login?dpsid-agent={{ app.getSession().getId() }}"><span>{{ phrase('agent.window.admin_interface') }}</span></a></li>{% endif %}
				{% if app.user.can_billing %}<li><a class="billing" href=""><span>{{ phrase('agent.window.billing_interface') }}</span></a></li>{% endif %}
				{% if app.user.can_reports %}<li><a class="reports" href="{{ app.request.getBaseUrl() }}/reports"><span>{{ phrase('agent.window.reports_interface') }}</span></a></li>{% endif %}
				{% if app.getSetting('user.portal_enabled') %}<li><a class="user" href="{{ app.request.getBaseUrl() }}/"><span>{{ phrase('agent.window.user_interface') }}</span></a></li>{% endif %}
			</ul>
		</div>
		</div>
	</div>
	{% endif %}
	<!-- END INTERFACE SECTION -->

	<!-- BEGIN STATUS SECTION -->
	<div id="DP-StatusSection">
		<div class="DP-adminStatus">
			<ul>
				<li class="agentStatus" id="agent_status_trigger">
					<a class="tipped on" id="agent_status" data-tipped="{{ phrase('agent.window.toggle_away_status') }}" data-tipped-options="hook: 'bottommiddle'"><em class="label-away">{{ phrase('agent.window.away_short') }}</em><em class="label-dnd">{{ phrase('agent.window.do_not_disturb_short') }}</em></a>
					<div id="agent_status_menu" style="display:none;">
						<div class="createDropdown">
							<ul class="createBtnPopups">
								<li class="status_go_available"><a><span class="statusAvailable">{{ phrase('agent.window.available') }}</span></a></li>
								<li class="status_go_away"><a><span class="statusAway">{{ phrase('agent.window.away') }}</span></a></li>
								<li class="status_go_dnd"><a><span class="statusDnd">{{ phrase('agent.window.do_not_disturb') }}</span></a></li>
							</ul>
						</div>
					</div>
				</li>
				<li class="networkStatIndicator">
					<a class="tipped" data-tipped="<div id='network_status_tip'>{{ phrase('agent.window.network_status') }}<br /><div class='network-status-green'>{{ phrase('agent.window.network_status_okay') }}</div><div class='network-status-red'>{{ phrase('agent.window.network_status_bad') }}</div></div>" data-tipped-options="hook: 'bottommiddle'"></a>
				</li>
				<li class="soundIcon">
					<a class="tipped" id="sound_icon" title="{{ phrase('agent.window.sound_explain') }}" data-tipped-options="hook: 'bottommiddle'"></a>
				</li>
			</ul>
		</div>
	</div>
	<!-- END STATUS SECTION -->
<!-- END HEADER BAR -->
</div>

<div id="dp_omniresults" style="display: none">
	<script type="text/x-deskpro-plain" id="dp_omniresults_section">
		<section class="section {TYPE}">
			<header>{TITLE}</header>
			<article>
				<ul class="result-list"></ul>
			</article>
		</section>
	</script>
	<script type="text/x-deskpro-plain" id="dp_omniresults_result_row">
		<li class="result-item {TYPE}-{ID}"><span class="prop-id">{ID}</span> {TITLE}</li>
	</script>
</div>

<div id="dp_searchsheet" data-element-handler="DeskPRO.Agent.ElementHandler.OmniSearchSheet">
	<header>
		<span class="close close-search-sheet"></span>
		<em>Search:</em>
		<ul>
			<li data-tab-for="#dp_searchsheet_tickets">Tickets</li>
			<li data-tab-for="#dp_searchsheet_people">People</li>
			<li data-tab-for="#dp_searchsheet_orgs">Organizations</li>
			<li data-tab-for="#dp_searchsheet_content">Content</li>
		</ul>
	</header>

	{# Ticket Search Form #}
	<article id="dp_searchsheet_tickets">
		<form action="{{ path('agent_ticketsearch_runcustomfilter') }}">
			<ul class="property-list">
				<li class="ob">
					<label>Department</label>
					<div class="values">
						{% include 'AgentBundle:Common:select-department.html.twig' with {
							'name': 'set_term[department][]',
							'blank_title': phrase('agent.department'),
							'departments': ticket_options.departments_hierarchy,
							'add_attr': 'multiple="multiple"'
						} %}
					</div>
				</li>
				<li class="ob">
					<label>Status</label>
					<div class="values">
						<select name="set_term[status][]">
							<option value="awaiting_agent">Awaiting Agent</option>
							<option value="awaiting_user">Awaiting User</option>
							<option value="resolved">Resolved</option>
							<option value="closed">Closed</option>
							<option value="hidden">Hidden (awaiting validating, spam)</option>
						</select>
					</div>
				</li>
				<li class="ob">
					<label>Agent</label>
					<div class="values">
						{% include 'AgentBundle:Common:select-agent.html.twig' with {
							'name': 'set_term[agent][]',
							'blank_title': phrase('agent.agent'),
							'departments': ticket_options.agents,
							'add_attr': 'multiple="multiple"'
						} %}
					</div>
				</li>
				{% if app.getSetting('core.use_agent_team') %}
					<li class="ob">
						<label>Agent Team</label>
						<div class="values">
							{% include 'AgentBundle:Common:select-agent-team.html.twig' with {
								'name': 'set_term[agent_team][]',
								'blank_title': phrase('agent.agent_team'),
								'departments': ticket_options.agent_teams,
								'add_attr': 'multiple="multiple"'
							} %}
						</div>
					</li>
				{% endif %}
				<li class="ob">
					<label>Followers</label>
					<div class="values">
						{% include 'AgentBundle:Common:select-agent.html.twig' with {
							'name': 'set_term[participant][]',
							'blank_title': phrase('agent.agent'),
							'departments': ticket_options.agents,
							'add_attr': 'multiple="multiple"'
						} %}
					</div>
				</li>
				{% if app.getSetting('core.use_ticket_category') %}
				<li class="ob">
					<label>Category</label>
					<div class="values">
						{% include 'AgentBundle:Common:select-category.html.twig' with {
							'name': 'set_term[category][]',
							'blank_title': phrase('agent.category'),
							'categories': ticket_options.ticket_categories_hierarchy,
							'add_attr': 'multiple="multiple"'
						} %}
					</div>
				</li>
				{% endif %}
				{% if app.getSetting('core.use_product') %}
				<li class="ob">
					<label>Product</label>
					<div class="values">
						{% include 'AgentBundle:Common:select-product.html.twig' with {
							'name': 'actions[product][]',
							'blank_title': phrase('agent.product'),
							'products': ticket_options.products_hierarchy,
							'add_attr': 'multiple="multiple"'
						} %}
					</div>
				</li>
				{% endif %}
				{% if app.getSetting('core.use_ticket_priority') %}
				<li class="ob">
					<label>Priority</label>
					<div class="values">
						{% include 'AgentBundle:Common:select-priority.html.twig' with {
							'name': 'set_term[priority][]',
							'blank_title': phrase('agent.priority'),
							'priorities': ticket_options.ticket_priorities,
							'add_attr': 'multiple="multiple"'
						} %}
					</div>
				</li>
				{% endif %}
				{% if app.getSetting('core.use_ticket_workflow') %}
				<li class="ob">
					<label>Workflow</label>
					<div class="values">
						{% include 'AgentBundle:Common:select-workflow.html.twig' with {
							'name': 'set_term[workflow][]',
							'blank_title': phrase('agent.workflow'),
							'workflows': ticket_options.ticket_workflows,
							'add_attr': 'multiple="multiple"'
						} %}
					</div>
				</li>
				{% endif %}
			</ul>
			<br class="clear" />

			<div class="search-form" id="tickersearch_criteria_list" data-templates="#tickersearch_criteria_tpl">
				<div class="search-terms"></div>
				<div class="term"><span class="add-term">+</span> {{ phrase('agent.add_criteria_term') }}</div>
			</div>
		</form>

		{% include 'DeskPRO:Common:ticket-search-criteria.html.twig' with {
			classname: 'search-builder-tpl',
			id: 'tickersearch_criteria_tpl',
			term_options: term_options,
			no_show_fields: ['department', 'status', 'agent', 'agent_team', 'participant', 'category', 'product', 'priority', 'workflow'],
			search_context: 'filter'
		} %}
	</article>
	{# /Ticket Search Form #}

	{# People Search Form #}
	<article id="dp_searchsheet_people">
		<form action="{{ path('agent_peoplesearch_customfilter') }}">
			<ul class="property-list">
				{% if people_options.organizations %}
				<li class="ob">
					<label>Organization</label>
					<div class="values">
						<select name="set_term[person_organization]" multiple="multiple">
							{% for id,title in people_options.organizations %}
								<option value="{{id}}">{{title}}</option>
							{% endfor %}
						</select>
					</div>
				</li>
				{% endif %}
				{% if people_options.usergroups %}
				<li class="ob">
					<label>Usergroup</label>
					<div class="values">
						<select name="set_term[person_usergroup]" multiple="multiple">
							{% for id,title in people_options.usergroups %}
								<option value="{{id}}">{{title}}</option>
							{% endfor %}
						</select>
					</div>
				</li>
				{% endif %}
				<li class="field-input">
					<label>Label</label>
					<div class="values">
						<input class="form-label-input" type="text" name="set_term[person_label]" />
					</div>
				</li>
				<li class="field-input">
					<label>Name</label>
					<div class="values">
						<input type="text" name="set_term[person_name]" />
					</div>
				</li>
				<li class="field-input">
					<label>Email Address</label>
					<div class="values">
						<input type="text" name="set_term[person_email]" />
					</div>
				</li>
				<li class="field-input">
					<label>Phone</label>
					<div class="values">
						<input type="text" name="set_term[person_contact_phone]" />
					</div>
				</li>
			</ul>
			<br class="clear" />

			<div class="search-form" id="peoplesearch_criteria_list" data-templates="#peoplesearch_criteria_tpl">
				<div class="search-terms"></div>
				<div class="term"><span class="add-term">+</span> {{ phrase('agent.add_criteria_term') }}</div>
			</div>
		</form>

		{% include 'DeskPRO:Common:people-search-criteria.html.twig' with {
			classname: 'search-builder-tpl',
			id: 'peoplesearch_criteria_tpl',
			term_options: term_options,
			no_show_fields: ['person_organization', 'person_usergroup', 'person_label', 'person_name', 'person_email', 'person_phone'],
			search_context: 'filter'
		} %}
	</article>
	{# /People Search Form #}

	{# Orgs Search Form #}
	<article id="dp_searchsheet_orgs">
		<form action="{{ path('agent_orgsearch_customfilter') }}">
			<ul class="property-list">
				<li class="field-input">
					<label>Name</label>
					<div class="values">
						<input type="text" name="set_term[org_name]" />
					</div>
				</li>
				<li class="field-input">
					<label>Label</label>
					<div class="values">
						<input class="form-label-input" type="text" name="set_term[org_label]" />
					</div>
				</li>
				<li class="field-input">
					<label>Email Domain</label>
					<div class="values">
						<input type="text" name="set_term[org_email_domain]" />
					</div>
				</li>
				<li class="field-input">
					<label>Phone</label>
					<div class="values">
						<input type="text" name="set_term[org_contact_phone]" />
					</div>
				</li>
			</ul>
			<br class="clear" />

			<div class="search-form" id="orgsearch_criteria_list" data-templates="#orgsearch_criteria_tpl">
				<div class="search-terms"></div>
				<div class="term"><span class="add-term">+</span> {{ phrase('agent.add_criteria_term') }}</div>
			</div>
		</form>

		{% include 'DeskPRO:Common:org-search-criteria.html.twig' with {
			classname: 'search-builder-tpl',
			id: 'orgsearch_criteria_tpl',
			term_options: term_options,
			no_show_fields: ['org_name', 'org_label', 'org_email_domain', 'org_contact_phone'],
			search_context: 'filter'
		} %}
	</article>
	{# /Orgs Search Form #}

	{# Content Search Form #}
	<article id="dp_searchsheet_content">
		<form action="{{ path('agent_publish_search') }}">
			<ul class="property-list">
				<li class="search-input">
					<label>Search</label>
					<div class="values">
						<input type="text" name="query" />
						<br />
						Search in types:
						<select name="types">
							<option value="">All</option>
							<option value="article">Articles</option>
							<option value="download">Downloads</option>
							<option value="feedback">Feedback</option>
							<option value="news">News</option>
						</select>
					</div>
				</li>
			</ul>
			<br class="clear" />
		</form>
	</article>
	{# /Content Search Form #}

	<footer>
		<button id="omnisearch_submit">Search</button>
	</footer>
</div>
