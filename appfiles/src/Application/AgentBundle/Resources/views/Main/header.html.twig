<div id="header">
	<div id="header-top">
		<div class="wrapper">
			<div class="left box-header">
				<a href="index.html#" class="logo">DeskPRO</a>
			</div>

			{# search start #}
			<div class="left box-header select">
				{#
				<div class="type-select users">
					<span class="icn-dropdown floating"></span>
				</div>
				#}
				<div id="window_search_form" autocomplete="off" data-menu-handler="DeskPRO.Agent.WindowElement.MainMenu.SearchBoxResults">
					<form id="search-form" action="#" method="post">
						<div class="wrap">
							<input id="window_search_box" autocomplete="off" type="text" name="search" value="" />
							<div class="type" id="window_search_type" data-search-type="users" data-menu-handler="DeskPRO.Agent.WindowElement.MainMenu.SearchBoxType">
								<span class="type-text">All</span>
								<ul class="wrap-dropdown searchtype">
									<li data-search-type="all" class="search-all"><span>All</span></li>
									<li data-search-type="tickets" class="search-tickets"><span>Tickets</span></li>
									<li data-search-type="users" class="search-users"><span>Users</span></li>
								</ul>
							</div>
						</div>
					</form>

					<div class="wrap-dropdown search-drop">
						<div class="top-results" id="window_search_loading" style="display:none">
							<span>Loading results</span>
						</div>
						{#<div class="top-results">
							<a href="#" title="">Show All Results</a>
						</div>#}
						<div class="wrap-results" id="window_search_rusults_wrap">

							<div class="results" id="window_search_tickets" style="display:none">
								<div class="left title-list">
									<span class="title-list-tickets">Tickets</span>
								</div>
								<div class="right results-list">
									<ul>
									</ul>
								</div>
							</div>

							<div class="results" id="window_search_people" style="display:none">
								<div class="left title-list">
									<span class="title-list-people">People</span>
								</div>
								<div class="right results-list">
									<ul>
									</ul>
								</div>
							</div>

							<div class="results" id="window_search_organizations" style="display:none">
								<div class="left title-list">
									<span class="title-list-orga">Organizations</span>
								</div>
								<div class="right results-list">
									<ul>
									</ul>
								</div>
							</div>

						</div>
					</div>
				</div>
			</div>
			{# search end #}

			{# notifications start #}
			<div class="left box-header notifications" id="notifications_wrap" data-menu-handler="DeskPRO.Agent.WindowElement.MainMenu.Notifications" style="display:none">
				<ul class="noti-menu">
					<li style="display:none"><div class="counter"><span class="counter" id="tickets_counter">0</span></div><span class="icn-bar tickets">Tickets</span></li>
					<li style="display:none"><div class="counter"><span class="counter" id="chats_counter">0</span></div><span class="icn-bar chat">Chat</span></li>
				</ul>
				<span class="white-drop"></span>

				<div class="wrap-dropdown noti-drop">
					<ul id="notifications_list">
					</ul>
					<div class="bot-noti">
						<a class="mark-all-read">Mark all as read</a>
					</div>
				</div>
			</div>
			{# notifications end #}

			<div class="right box-header admin-actions create">
				<div class="wrapper-top-bar">
					<ul>
						<li class="new-content" id="create_content_trigger"><a>Create</a></li>
						<li class="border">&nbsp;</li>
					</ul>
				</div>
			</div>

			<div class="right box-header current-user">
				<div class="wrapper-top-bar">
					<div class="current-user-avatar">
						<img src="{{ app.user.getPictureUrl(40) }}" alt="" />
					</div>
					<div class="current-user-name">
						<span>{{ app.user.display_name }}</span>
					</div>
					<a class="logout tipped" href="{{ path('user_logout') }}" title="Log Out" data-tipped-options="hook: 'bottommiddle'">Log Out</a>
				</div>
			</div>

			{# actions start #}
			<div class="right box-header actions">
				<div class="wrapper-top-bar">
					<ul class="act-list">
						<li class="help">
							<a href="" class="tipped" data-tipped="View help" data-tipped-options="hook: 'bottommiddle'">Help</a>
						</li>
						{% include 'AgentBundle:Main:part-shortcuts-menu.html.twig' %}
						<li class="agent-status" id="agent_status">
							<a href="" class="tipped" data-tipped="Toggle your away status" data-tipped-options="hook: 'bottommiddle'">Away</a>
						</li>
						<li class="network active" id="network_status_indicator">
							<a href="" class="tipped" data-tipped="Network status<br /><div class='network-status-green'>Everything seems okay</div><div class='network-status-red'>Red: Network problems, you may have been disconnected</div>" data-tipped-options="hook: 'bottommiddle'">Network</a>
							<span>0</span>
						</li>
						<li class="sound" id="sound_icon"><a href="" class="tipped" data-tipped="Toggle sound notifications" data-tipped-options="hook: 'bottommiddle'">Sound</a></li>
					</ul>
				</div>
			</div>
			{# actions end #}

			<div class="right box-header zone-switcher admin-actions">
				<div class="wrapper-top-bar">
					<ul style="float: left;">
						<li class="admin"><a>Agent Interface</a></li>
					</ul>
					<span class="white-drop"></span>
				</div>

				<div class="wrap-dropdown switcher-drop">
					<ul>
						<li class="admin"><a href="{{ path('admin') }}">Admin Interface</a></li>
						<li class="billing"><a href="">Billing Interface</a></li>
						<li class="reports"><a href="">Reports Interface</a></li>
						<li class="portal"><a href="{{ path('user') }}">User Interface</a></li>
					</ul>
				</div>
			</div>

			<div class="right box-header admin-actions">
				<div class="wrapper-top-bar">
					<ul>
						<li class="border">&nbsp;</li>
						<li class="settings" id="user_settings_link"><a>Settings</a></li>
					</ul>
				</div>
			</div>

			<ul class="menu" id="create_content_menu" style="display: none;">
				<li><a class="with-route ticket" data-route="">Create Ticket</a></li>
				<li><a class="with-route article" data-route="">Create Article</a></li>
				<li><a class="with-route news" data-route="">Create News Entry</a></li>
				<li><a class="with-route download" data-route="">Create Download</a></li>
				<li><a class="with-route idea" data-route="">Create Idea</a></li>
			</ul>

		</div>
	</div>
</div>