<div id="header">
	<div id="header-top">
		<div class="wrapper">
			<div class="left box-header">
				<a href="index.html#" class="logo">DeskPRO</a>
			</div>

			{# search start #}
			<div class="left box-header select">
				<div class="type-select users" id="window_search_type" data-search-type="users" data-menu-handler="DeskPRO.Agent.WindowElement.MainMenu.SearchBoxType">
					<span class="icn-dropdown floating"></span>
					<ul class="wrap-dropdown searchtype">
						<li data-search-type="all" class="search-all"><span>Search All</span></li>
						<li data-search-type="tickets" class="search-tickets"><span>Tickets</span></li>
						<li data-search-type="users" class="search-users"><span>Users</span></li>
					</ul>
				</div>
				<div id="window_search_form" autocomplete="off" data-menu-handler="DeskPRO.Agent.WindowElement.MainMenu.SearchBoxResults">
					<form id="search-form" action="#" method="post">
						<input id="window_search_box" autocomplete="off" type="text" name="search" value="" />
					</form>

					<div class="wrap-dropdown search-drop">
						<div class="top-results" id="window_search_loading" style="display:none">
							<span>Loading results</span>
						</div>
						{#<div class="top-results">
							<a href="#" title="">Show All Results</a>
						</div>#}
						<div class="wrap-results" id="window_search_rusults_wrap">

							<div class="results" id="window_search_tickets" style="display:none">
								<div class="left title-list">
									<span class="title-list-tickets">Tickets</span>
								</div>
								<div class="right results-list">
									<ul>
									</ul>
								</div>
							</div>

							<div class="results" id="window_search_people" style="display:none">
								<div class="left title-list">
									<span class="title-list-people">People</span>
								</div>
								<div class="right results-list">
									<ul>
									</ul>
								</div>
							</div>

							<div class="results" id="window_search_organizations" style="display:none">
								<div class="left title-list">
									<span class="title-list-orga">Organizations</span>
								</div>
								<div class="right results-list">
									<ul>
									</ul>
								</div>
							</div>

						</div>
					</div>
				</div>
			</div>
			{# search end #}

			{# notifications start #}
			<div class="left box-header notifications" id="notifications_wrap" data-menu-handler="DeskPRO.Agent.WindowElement.MainMenu.Notifications" style="display:none">
				<ul class="noti-menu">
					<li style="display:none"><div class="counter"><span class="counter" id="tickets_counter">0</span></div><span class="icn-bar tickets">Tickets</span></li>
					<li style="display:none"><div class="counter"><span class="counter" id="chats_counter">0</span></div><span class="icn-bar chat">Chat</span></li>
				</ul>
				<span class="white-drop"></span>

				<div class="wrap-dropdown noti-drop">
					<ul id="notifications_list">
					</ul>
					<div class="bot-noti">
						<a class="mark-all-read">Mark all as read</a>
					</div>
				</div>
			</div>
			{# notifications end #}

			<div class="right box-header current-user">
				<div class="wrapper-top-bar">
					<div class="current-user-avatar">
						<img src="{{ app.user.getPictureUrl(16) }}" alt="" />
					</div>
					<div class="current-user-name">
						<span>{{ app.user.display_name }}</span>
					</div>
					<span class="white-drop"></span>

				</div>

				<div class="wrap-dropdown user-drop">
					<ul>
						<li class="ticket-noti"><a id="user_settings_link">Settings</a></li>
						<li class="ticket-noti"><a href="">Set status: away</a></li>
						<li class="ticket-noti"><a href="{{ path('agent_logout') }}">Log Out</a></li>
					</ul>
				</div>
			</div>

			{# actions start #}
			<div class="right box-header actions">
				<div class="wrapper-top-bar">
					<ul class="act-list">
						<li class="help">
							<a href="" class="tipped" data-tipped="View help" data-tipped-options="hook: 'bottommiddle', showDelay: 0, skin: 'light'">Help</a>
						</li>
						<li class="multi with-menu">
							<a href="" class="tipped" data-tipped="Change language" data-tipped-options="hook: 'bottommiddle', showDelay: 0, skin: 'light'">Multilingual</a>

							<div class="wrap-dropdown lang-drop">
								<ul>
									<li class="lang-en"><a href="">English</a></li>
									<li class="lang-es"><a href="">Español</a></li>
									<li class="lang-pr"><a href="">Portugues</a></li>
								</ul>
							</div>

						</li>
						{% include 'AgentBundle:Main:part-shortcuts-menu.html.twig' %}
						<li class="network active" id="network_status_indicator">
							<a href="" class="tipped" data-tipped="Network status<br /><div class='network-status-green'>Everything seems okay</div><div class='network-status-red'>Red: Network problems, you may have been disconnected</div>" data-tipped-options="hook: 'bottommiddle', showDelay: 0, skin: 'light'">Network</a>
							<span>0</span>
						</li>
						<li class="sound"><a href="" class="tipped" data-tipped="Toggle sound notifications" data-tipped-options="hook: 'bottommiddle', showDelay: 0, skin: 'light'">Sound</a></li>

					</ul>
				</div>
			</div>
			{# actions end #}

			<div class="right box-header admin-actions">
				<div class="wrapper-top-bar">
					<ul>
						<li class="admin"><a href="{{ path('admin') }}">Admin</a></li>
						<li class="portal"><a href="{{ path('user') }}">Portal</a></li>
						<li class="billing"><a href="">Billing</a></li>
						<li class="reports"><a href="">Reports</a></li>
					</ul>
				</div>
			</div>

		</div>
	</div>
</div>