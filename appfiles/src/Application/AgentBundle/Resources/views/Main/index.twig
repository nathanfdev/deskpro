<script src="{% asset 'javascripts/DeskPRO/Agent/PageFragment/NavPane/TicketFind.js' %}"></script>

<script src="{% asset 'javascripts/DeskPRO/Agent/PageFragment/Page/Ticket.js' %}"></script>
