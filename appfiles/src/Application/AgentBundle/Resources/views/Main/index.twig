<!DOCTYPE html>
<html>
<head>
	<meta charset="UTF-8"/>
	<meta name="robots" content="NOINDEX" />
	<meta http-equiv="X-UA-Compatible" content="IE=100" />
	<title>DeskPRO</title>

	<link rel="stylesheet" href="{% asset 'javascripts/jquery/jquery-ui/css/ui-lightness/jquery-ui.css' %}" type="text/css" media="screen"  />
	<link rel="stylesheet" href="{% asset 'javascripts/DeskPRO/UI/ui.css' %}" type="text/css" media="screen" />
	<link rel="stylesheet" href="{% asset 'javascripts/jquery/tipTip/tipTip.css' %}" type="text/css" media="screen"  />
	<link rel="stylesheet" href="{% asset 'stylesheets/agent/interface.css' %}" type="text/css" media="screen" />

	<!--[if IE 8]>
	<link rel="stylesheet" href="{% asset 'stylesheets/agent/interface-ie.css' %}" type="text/css" media="screen" />
	<![endif]-->

	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/jquery/jquery.min.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/jquery/jquery-ui/jquery-ui.min.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/jquery/jquery.layout.min.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/jquery/tipTip/jquery.tipTip.min.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/jquery/tag-it/tag-it.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/jquery/jquery.sizes.min.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/jquery/jquery.mousewheel.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/mootools/mootools-core.min.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/Orb/Orb.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/Orb/Compat.js' %}"></script>
	
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/UI/Overlay.js' %}"></script>
	
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Form/InlineEdit.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Form/RuleBuilder.js' %}"></script>
	
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/MessageBroker.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/AjaxPoller/Poller.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/AjaxPoller/MessagePoller.js' %}"></script>

	<!-- Agent Interface sources -->
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/Window.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/Shells/ThreePaned.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/TabManager.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/PageFragment/Basic.js' %}"></script>

	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/PageFragment/ListPane/Basic.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/PageFragment/ListPane/PeopleSearch.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/PageFragment/ListPane/TicketSearch.js' %}"></script>

	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/PageFragment/NavPane/Basic.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/PageFragment/NavPane/TicketFilters.js' %}"></script>

	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/PageFragment/Page/Ticket.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/PageFragment/Page/Person.js' %}"></script>

	<script type="text/javascript">
		var BASE_URL = '{% path 'index' %}';
		$(document).ready(function() {
			window.DeskPRO_Window = new DeskPRO.Agent.Window();
			window.DeskPRO_Window.runPageRouteFromElement($('#window_header_nav .tickets'));
			
			/*
			for (var i = 1; i <= 20; i++) {
				var page = window.DeskPRO_Window.createPageFragment('Testing', 'DeskPRO.Agent.PageFragment.NavPane.Basic');
				page.TYPENAME = 'ticket';
				page.setMetaData('title', 'Testing ' + i);
				
				window.DeskPRO_Window.getPanedShell().addTabPage(page);
			}
			*/
		});
	</script>
</head>
<body>

<div id="window_head">
	<div id="window_head_top">
		<div class="logo">DeskPRO</div>
		<ul class="current-user">
			<li class="person">{{person.display_name}} (Log Out)</li>
			<li class="settings">Settings</li>
			<li class="admin">Admin</li>
		</ul>
	</div>
	<div id="window_header_nav">
		<div class="section">
			<h1>Engage</h1>
			<ul>
				<li class="tickets" data-route="navpane:{% path 'agent_ticketsearch_filterspane' %}" data-route-alt="listpane:{% path 'agent_ticketsearch' %}">Tickets</li>
				<li class="tweets" data-route="navpane:{% path 'agent_ticketsearch_filterspane' %}" data-route-alt="listpane:{% path 'agent_ticketsearch' %}">Tweets</li>
				<li class="facebook" data-route="navpane:{% path 'agent_ticketsearch_filterspane' %}" data-route-alt="listpane:{% path 'agent_ticketsearch' %}">Facebook</li>
				<li class="chat" data-route="navpane:{% path 'agent_ticketsearch_filterspane' %}" data-route-alt="listpane:{% path 'agent_ticketsearch' %}">Chat</li>
				<li class="leads" data-route="navpane:{% path 'agent_ticketsearch_filterspane' %}" data-route-alt="listpane:{% path 'agent_ticketsearch' %}">Leads</li>
			</ul>
		</div>
		<div class="section">
			<h1>Publish</h1>
			<ul>
				<li class="knowledgebase" data-route="navpane:{% path 'agent_ticketsearch_filterspane' %}" data-route-alt="listpane:{% path 'agent_ticketsearch' %}">Knowledgebase</li>
				<li class="troubleshooters" data-route="navpane:{% path 'agent_ticketsearch_filterspane' %}" data-route-alt="listpane:{% path 'agent_ticketsearch' %}">Troubleshooters</li>
				<li class="ideas" data-route="navpane:{% path 'agent_ticketsearch_filterspane' %}" data-route-alt="listpane:{% path 'agent_ticketsearch' %}">Ideas</li>
				<li class="files" data-route="navpane:{% path 'agent_ticketsearch_filterspane' %}" data-route-alt="listpane:{% path 'agent_ticketsearch' %}">Files</li>
			</ul>
		</div>
		<div class="section">
			<h1>Manage</h1>
			<ul>
				<li class="people" data-route="navpane:{% path 'agent_peoplesearch_labelspane' %}" data-route-alt="listpane:{% path 'agent_peoplesearch' %}">People</li>
				<li class="organizations" data-route="navpane:{% path 'agent_peoplesearch_labelspane' %}" data-route-alt="listpane:{% path 'agent_peoplesearch' %}">Organizations</li>
			</ul>
		</div>
		<div class="search-box">
			<input type="text" name="q" />
		</div>
	</div>
</div>

<div id="pane_shell">
	<div id="pane_nav">

	</div>
	<div id="pane_shell_inner">
		<div id="pane_list">

		</div>
		<div id="pane_content">
			<div id="pane_tabbar">
				<div id="pane_tabs_scroll_left"></div>
				<div id="pane_tabs_scroll_right"></div>
				<ul id="pane_tabs"></ul>				
			</div>
			<div id="page" class="ui-layout-content">

			</div>
		</div>
	</div>
</div>

</body>
</html>