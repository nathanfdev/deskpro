<!DOCTYPE html>
<html>
<head>
	<meta charset="UTF-8"/>
	<meta name="robots" content="NOINDEX" />
	<meta http-equiv="X-UA-Compatible" content="IE=100" />
	<title>DeskPRO</title>

	<link rel="stylesheet" href="{% asset 'javascripts/jquery/jquery-ui/css/ui-lightness/jquery-ui.css' %}" type="text/css" media="screen"  />
	<link rel="stylesheet" href="{% asset 'javascripts/plupload/css/plupload.queue.css' %}" type="text/css" media="screen"  />
	<link rel="stylesheet" href="{% asset 'javascripts/DeskPRO/UI/ui.css' %}" type="text/css" media="screen" />
	<link rel="stylesheet" href="{% asset 'javascripts/jquery/tipTip/tipTip.css' %}" type="text/css" media="screen"  />
	<link rel="stylesheet" href="{% asset 'stylesheets/agent/interface.css' %}" type="text/css" media="screen" />

	<!--[if IE 8]>
	<link rel="stylesheet" href="{% asset 'stylesheets/agent/interface-ie.css' %}" type="text/css" media="screen" />
	<![endif]-->
	
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/jquery/jquery.min.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/jquery/jquery-ui/jquery-ui.min.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/jquery/jquery.cookie.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/jquery/jquery.layout.min.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/tiny_mce/jquery.tinymce.js' %}"></script>
	<script type="text/javascript" charset="utf-8">
		var DP_TINYMCE_URL = '{% asset 'javascripts/tiny_mce/tiny_mce.js' %}';
	</script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/jquery/tipTip/jquery.tipTip.min.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/jquery/tag-it/tag-it.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/jquery/jquery.sizes.min.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/jquery/jquery.mousewheel.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/mootools/mootools-core.min.js' %}"></script>
	
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/plupload/plupload.full.min.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/plupload/jquery.plupload.queue.min.js' %}"></script>
	
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/Orb/Orb.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/Orb/Compat.js' %}"></script>
	
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/UI/Overlay.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/UI/Menu.js' %}"></script>
	
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Form/InlineEdit.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Form/RuleBuilder.js' %}"></script>
	
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/MessageBroker.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/AjaxPoller/Poller.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/AjaxPoller/MessagePoller.js' %}"></script>

	<!-- Agent Interface sources -->
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/Window.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/Shells/ThreePaned.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/TabManager.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/PageFragment/Basic.js' %}"></script>

	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/PageFragment/ListPane/Basic.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/PageFragment/ListPane/PeopleSearch.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/PageFragment/ListPane/TicketSearch.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/PageFragment/ListPane/TicketFlagged.js' %}"></script>

	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/PageFragment/NavPane/Basic.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/PageFragment/NavPane/TicketFilters.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/PageFragment/NavPane/TicketFlagged.js' %}"></script>

	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/PageFragment/Page/Ticket.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/PageFragment/Page/Person.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/PageFragment/Page/PersonPopout.js' %}"></script>

	<script type="text/javascript">
		var BASE_URL = '{% path 'index' %}';
		var ASSETS_BASE_URL = '{% asset '' %}';
		
		$(document).ready(function() {
			window.DeskPRO_Window = new DeskPRO.Agent.Window();
			window.DeskPRO_Window.runPageRouteFromElement($('#window_header_nav .tickets'));
			window.DeskPRO_Window.runPageRoute('ticket:{% path 'agent_ticket_view' with ['ticket_id': 3] %}');
			/*
			for (var i = 1; i <= 20; i++) {
				var page = window.DeskPRO_Window.createPageFragment('Testing', 'DeskPRO.Agent.PageFragment.NavPane.Basic');
				page.TYPENAME = 'ticket';
				page.setMetaData('title', 'Testing ' + i);
				
				window.DeskPRO_Window.getPanedShell().addTabPage(page);
			}
			*/
			/*
			var menu = new DeskPRO.UI.Menu({
				triggerElement: '#test_menu_trigger',
				menuElement: '#test_menu'
			});
			*/
		});
	</script>
</head>
<body>

<div id="window_head">
	<div id="window_head_top">
		<div class="logo">DeskPRO</div>
		<ul class="current-user">
			<li class="person">{{person.display_name}} (Log Out)</li>
			<li class="dev-feature-inactive settings">Settings</li>
			<li class="dev-feature-inactive admin">Admin</li>
		</ul>
	</div>
	<div id="window_header_nav">
		<div class="section">
			<h1>Engage</h1>
			<ul>
				<li class="icon tickets" data-route="navpane:{% path 'agent_ticketsearch_filterspane' %}" data-route-alt="listpane.alt:alt:{% path 'agent_ticketsearch' %}">Tickets</li>
				<li class="dev-feature-inactive icon tweets" data-route="navpane:{% path 'agent_ticketsearch_filterspane' %}" data-route-alt="listpane.alt:{% path 'agent_ticketsearch' %}">Tweets</li>
				<li class="dev-feature-inactive icon facebook" data-route="navpane:{% path 'agent_ticketsearch_filterspane' %}" data-route-alt="listpane.alt:{% path 'agent_ticketsearch' %}">Facebook</li>
				<li class="dev-feature-inactive icon chat" data-route="navpane:{% path 'agent_ticketsearch_filterspane' %}" data-route-alt="listpane.alt:{% path 'agent_ticketsearch' %}">Chat</li>
				<li class="dev-feature-inactive icon leads" data-route="navpane:{% path 'agent_ticketsearch_filterspane' %}" data-route-alt="listpane.alt:{% path 'agent_ticketsearch' %}">Leads</li>
			</ul>
		</div>
		<div class="section">
			<h1>Publish</h1>
			<ul>
				<li class="dev-feature-inactive icon knowledgebase" data-route="navpane:{% path 'agent_ticketsearch_filterspane' %}" data-route-alt="listpane:{% path 'agent_ticketsearch' %}">Knowledgebase</li>
				<li class="dev-feature-inactive icon troubleshooters" data-route="navpane:{% path 'agent_ticketsearch_filterspane' %}" data-route-alt="listpane:{% path 'agent_ticketsearch' %}">Troubleshooters</li>
				<li class="dev-feature-inactive icon ideas" data-route="navpane:{% path 'agent_ticketsearch_filterspane' %}" data-route-alt="listpane:{% path 'agent_ticketsearch' %}">Ideas</li>
				<li class="dev-feature-inactive icon files" data-route="navpane:{% path 'agent_ticketsearch_filterspane' %}" data-route-alt="listpane:{% path 'agent_ticketsearch' %}">Files</li>
			</ul>
		</div>
		<div class="section">
			<h1>Manage</h1>
			<ul>
				<li class="icon people" data-route="navpane:{% path 'agent_peoplesearch_labelspane' %}" data-route-alt="listpane:{% path 'agent_peoplesearch' %}">People</li>
				<li class="dev-feature-inactive icon organizations" data-route="navpane:{% path 'agent_peoplesearch_labelspane' %}" data-route-alt="listpane:{% path 'agent_peoplesearch' %}">Organizations</li>
			</ul>
		</div>
		<div class="nav-right">
			<div class="search-box">
				<input type="text" name="q" />
			</div>
			<div class="create-box">
				<span id="create_new_menu_trigger">Create New</span>
				<ul id="create_new_menu" style="display:none">
					<li><span class="icon tickets">Ticket</span></li>
					<li class="sep">-</li>
					<li><span class="icon people">Person</span></li>
					<li><span class="icon organizations">Organization</span></li>
					<li class="sep">-</li>
					<li><span class="icon knowledgebase">Knowledgebase Article</span></li>
					<li><span class="icon troubleshooters">Troubleshooters</span></li>
					<li><span class="icon ideas">Idea</span></li>
					<li><span class="icon files">File</span></li>
				</ul>
			</div>
		</div>
	</div>
</div>

<div id="pane_shell">
	<div id="pane_nav">

	</div>
	<div id="pane_shell_inner">
		<div id="pane_list">
			
		</div>
		<div id="pane_content">
			<div id="pane_tabbar" class="nosel">
				<div id="pane_tabs_scroll_left"></div>
				<div id="pane_tabs_scroll_right"></div>
				<ul id="pane_tabs"></ul>				
			</div>
			<div id="page" class="ui-layout-content">

			</div>
		</div>
	</div>
</div>

</body>
</html>