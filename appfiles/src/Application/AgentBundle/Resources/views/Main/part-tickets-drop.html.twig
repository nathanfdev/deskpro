<div class="wrap-dropdown n-drop tickets-drop">
	<div class="top-tickets-info">
		<ol>
			<li data-route="listpane:{{ path('agent_ticketsearch_runnamedqueue', {'queue_name': 'agent'}) }}">Yours<span class="ticket-counter" id="filter_agent_count">0</span></li>
			<li data-route="listpane:{{ path('agent_ticketsearch_runnamedqueue', {'queue_name': 'participant'}) }}">Participated<span class="ticket-counter" id="filter_participant_count">0</span></li>
			<li data-route="listpane:{{ path('agent_ticketsearch_runnamedqueue', {'queue_name': 'agent_team'}) }}">Your Teams<span class="ticket-counter" id="filter_agent_team_count">0</span></li>
			<li data-route="listpane:{{ path('agent_ticketsearch_runnamedqueue', {'queue_name': 'unassigned'}) }}">Unassigned<span class="ticket-counter" id="filter_unassigned_count">0</span></li>
			<li data-route="listpane:{{ path('agent_ticketsearch_runnamedqueue', {'queue_name': 'all'}) }}">All<span class="ticket-counter" id="filter_all_count">0</span></li>
		</ol>
	</div>

	<div class="tickets-content">

		<table cellspacing="0" cellpadding="0" width="100%"><tr><td valign="top" width="50%">

			<div class="inner-container">
				<div class="inner-container-title filters">
					<h3>Filters</h3>
				</div>
				<div class="inner-container-content">
					<ol id="filters_list">
					</ol>
				</div>
			</div>

			<div class="inner-container">
				<div class="inner-container-title tags-title">
					<h3>Popular Labels</h3>
				</div>
				<div class="inner-container-content">
					<ol id="labels_cloud_list" class="tags tag-cloud"></ol>
				</div>
			</div>

		</td><td valign="top" width="50%">

			<div class="inner-container">
				<div class="inner-container-title open-tickets">
					<h3>Open Tickets</h3>
				</div>
				<div class="inner-container-subtitle open-tickets" id="grouping_options">
					<span class="mode-menu-trigger mode menu" data-mode="your">Your tickets</span>
					grouped by
					<span class="grouping-menu-trigger menu grouping1" data-groupby="department_id">Department</span>
					<span class="no-subgroup">(add <span class="grouping-menu-trigger menu">subgroup</span>)</span>
					<span class="with-subgroup" style="display:none">and <span class="grouping-menu-trigger menu grouping2" data-groupby=""></span></span>
				</div>
				<div class="inner-container-content">
					<ol id="overview_list"></ol>
				</div>
			</div>
			<ul id="overview_mode_menu" class="mode-menu" style="display:none">
				<li data-mode="your">Your tickets</li>
				<li data-mode="unassigned">Unassigned tickets</li>
				<li data-mode="others">Others tickets</li>
			</ul>
			<ul id="overview_grouping_menu" class="grouping-menu" style="display:none">
				<li data-groupby="none">None</li>
				<li data-groupby="department_id">Department</li>
				<li data-groupby="category_id">Category</li>
				<li data-groupby="priority_id">Priority</li>
			</ul>

			<div class="inner-container">
				<div class="inner-container-title flag-title">
					<div id="flagged_edit_btn"><a>Edit flag titles</a></div>
					<div id="flagged_save_btn"><a>Done, save changes</a></div>
					<h3>Flagged</h3>
				</div>
				<div class="inner-container-content">
					<ol id="flagged_list" class="flags"></ol>
				</div>
			</div>

		</td></tr></table>
	</div>
</div>