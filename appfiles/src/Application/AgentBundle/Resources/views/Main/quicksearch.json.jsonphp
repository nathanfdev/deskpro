<?php
$OUTPUT = array();

if ($results['ticket']) {
	$OUTPUT['ticket'] = array();
	foreach ($results['ticket'] as $r) {
		$OUTPUT['ticket'][] = array(
			'id' => $r->id,
			'person_id' => $r->person->id,
			'person' => $r->person->getDisplayName(),
			'subject' => $r->subject,
			'title' => $r->subject,
			'route' => 'ticket:' . $router->generate('agent_ticket_view', array('ticket_id' => $r->id))
		);
	}
}

if ($results['person']) {
	$OUTPUT['person'] = array();
	foreach ($results['person'] as $r) {
		$OUTPUT['person'][] = array(
			'id' => $r->id,
			'person_id' => $r->id,
			'person' => $r->getDisplayName(),
			'title' => $r->getDisplayName() . ($r->getPrimaryEmailAddress() ? '&lt;' . $r->getPrimaryEmailAddress() . '&gt;' : ''),
			'email' => $r->getPrimaryEmailAddress(),
			'organization' => $r->organization ? $r->organization->name : null,
			'route' => 'person:' . $router->generate('agent_people_view', array('person_id' => $r->id))
		);
	}
}

