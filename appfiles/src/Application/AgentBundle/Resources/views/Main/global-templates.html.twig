{#
	This file contains global JS templates and menus and other such
	resources used throughout.
#}
<div id="deskpro_window_templates" style="display: none;">

{# Agents Selector #}
<ul id="agent_selector_list">
	{% for id,title in agent_names %}
		<li data-agent-id="{{id}}">
			<img src="{{ path('serve_person_picture_size', {'person_id': id, 'size': 30}) }}" alt="" width="30" height="30" />
			<a>{{title}}</a>
		</li>
	{% endfor %}
</ul>

<div class="optionbox" id="set_agent_and_team_optionbox_radio">
	<section data-section-name="me">
		<ul>
			<li>
				<label>Me</label>
				<button class="clean-white small" data-type="agent" data-agent-id="{{ app.user.id }}">Assign</button>
			</li>
			{% if app.user.teams %}
				{% for team in app.user.teams %}
					<li>
						<label>My team {{ team.name }}</label>
						<button class="clean-white small" data-type="team" data-team-id="{{ team.id }}">Assign</button>
					</li>
				{% endfor %}
			{% endif %}
		</ul>
	</section>
	<section data-section-name="teams">
		<header>
			<h3>Teams</h3>
			<input type="text" class="filter-box" placeholder="Filter..." />
		</header>
		<ul>
			{% for team in agent_teams %}
				<li>
					<label>{{ team.name }}</label>
					<button class="clean-white small" data-type="team" data-team-id="{{ team.id }}">Assign</button>
				</li>
			{% endfor %}
		</ul>
	</section>
	<section data-section-name="agents">
		<header>
			<h3>Everyone</h3>
			<input type="text" class="filter-box" placeholder="Filter..." />
		</header>
		<ul>
			{% for agent in agents %}
				<li>
					<label>{{ agent.display_name }}</label>
					<button class="clean-white small" data-type="agent" data-agent-id="{{ agent.id }}">Assign</button>
				</li>
			{% endfor %}
		</ul>
	</section>
</div>

<div class="optionbox" id="agent_optionbox_check">
	<section data-section-name="followers">
		<header>
			<h3>Agents</h3>
			<input type="text" class="filter-box" placeholder="Filter..." />
		</header>
		<ul>
			<li class="me last-me {% if app.user.id in participant_ids %}on{% endif %}">
				<input type="checkbox" name="agent_optionbox_check" value="{{ app.user.id }}" {% if app.user.id in participant_ids %}checked="checked"{% endif %} />
				<label><span class="agent-pic agent-part-label-{{ app.user.id }}" style="background-image: url({{ app.user.getPictureUrl(16) }})">Me</span></label>
			</li>

			{% for agent in agents %}
				{% if agent.id != app.user.id %}
					<li {% if agent.id in participant_ids %}class="on"{% endif %}>
						<input type="checkbox" name="agent_optionbox_check" value="{{ agent.id }}" {% if agent.id in participant_ids %}checked="checked"{% endif %} />
						<label><span class="agent-pic agent-part-label-{{ agent.id }}" style="background-image: url({{ agent.getPictureUrl(16) }})">{{ agent.display_name }}</span></label>
						<div class="bound-fade"></div>
					</li>
				{% endif %}
			{% endfor %}
		</ul>
	</section>
</div>

<div class="optionbox" id="agent_optionbox_radio">
	<section data-section-name="agents">
		<header>
			<h3>Agents</h3>
			<input type="text" class="filter-box" placeholder="Filter..." />
		</header>
		<ul>
			{% for agent in agents %}
				<li>
					<input type="radio" name="agent_optionbox_radio" value="{{ agent.id }}" /><label>{{ agent.display_name }}</label>
				</li>
			{% endfor %}
		</ul>
	</section>
</div>

<div class="optionbox" id="agent_team_optionbox_radio">
	<section data-section-name="teams">
		<header>
			<h3>Teams</h3>
			<input type="text" class="filter-box" placeholder="Filter..." />
		</header>
		<ul>
			{% if app.user.teams %}
				<li class="group-title"><strong>Your Teams</strong></li>
				{% for team in app.user.teams %}
					<li><input type="radio" name="agent_team_optionbox_radio" value="{{ team.id }}" /><label>{{ team.name }}</label></li>
				{% endfor %}
				<li class="group-title"><strong>All Teams</strong></li>
			{% endif %}

			{% for team in agent_teams %}
				<li><input type="radio" name="agent_team_optionbox_radio" value="{{ team.id }}" /><label>{{ team.name }}</label></li>
			{% endfor %}
		</ul>
	</section>
</div>

{# Teams #}
<ul id="agent_teams_menu">
	{% if app.user.teams %}
		<li class="section-title">Your Teams</li>
		{% for team in app.user.teams %}
			<li data-team-id="{{ team.id }}">{{ team.name }}</li>
		{% endfor %}
		<li class="section-title">All Teams</li>
	{% endif %}

	{% for team in agent_teams %}
		<li data-team-id="{{ team.id }}">{{ team.name }}</li>
	{% endfor %}
</ul>

{# My Teams #}
{% if app.user.teams %}
	<ul id="agent_my_teams_menu">
		{% for team in app.user.teams %}
			<li data-team-id="{{ team.id }}">{{ team.name }}</li>
		{% endfor %}
	</ul>
{% endif %}

{# Department #}
<ul id="department_menu" data-menu-flag="copy-menu">
	{% for dep in ticket_options.departments_hierarchy %}
		{% if dep.children %}
			<li data-department-id="{{dep.id}}" data-full-title="{{ dep.title }}" class="section-title">{{dep.title}}</li>
			{% for subdep in dep.children %}
				<li data-department-id="{{subdep.id}}" data-full-title="{{ dep.title }}">{{subdep.title}}</li>
			{% endfor %}
			{% set last_with_child = true %}
		{% else %}
			<li data-department-id="{{dep.id}}" data-full-title="{{ dep.title }}">{{dep.title}}</li>
			{% set last_with_child = false %}
		{% endif %}
	{% endfor %}
</ul>

<script type="text/x-deskpro-plain" id="department_option_box_tpl">
	<div class="optionbox">
		<section data-section-name="department">
			<header>
				<h3>Department</h3>
				<input type="text" class="filter-box" placeholder="Filter..." />
			</header>
			<ul>
				{% for dep in ticket_options.departments_hierarchy %}
					<li
						class="top {% if dep.children %}parent-option{% endif %} item-{{ dep.id }}"
						data-item-id="{{ dep.id }}"
						data-full-title="{{ dep.title }}"
					>
						<input type="radio" name="%baseId%_dep_radio" value="{{ dep.id }}" />
						<label>{{ dep.title }}</label>
					</li>
					{% if dep.children %}
						{% for subdep in dep.children %}
							<li
								class="child item-{{ subdep.id }} child-of-{{ dep.id }}"
								data-item-id="{{ dep.id }}"
								data-parent-id="{{ dep.id }}"
								data-full-title="{{ dep.title }} &gt; {{ subdep.title }}"
							>
								<span class="elbow-end"></span>
								<input type="radio" name="%baseId%_dep_radio" value="{{ subdep.id }}" />
								<label>{{subdep.title}}</label>
							</li>
						{% endfor %}
					{% endif %}
				{% endfor %}
			</ul>
		</section>
	</div>
</script>

{# Products #}
<ul id="products_menu" data-menu-flag="copy-menu">
	{% for cat in ticket_options.products_hierarchy %}
		{% if cat.children %}
			<li data-product-id="{{cat.id}}" class="section-title prod-{{ cat.id }}">{{cat.title}}</li>
			{% for subcat in cat.children %}
				<li data-product-id="{{subcat.id}}" data-parent-id="{{ cat.id }}" class="prod-{{ subcat.id }}">{{subcat.title}}</li>
			{% endfor %}
			{% set last_with_child = true %}
		{% else %}
			<li data-product-id="{{cat.id}}" class="prod-{{ cat.id }}">{{cat.title}}</li>
			{% set last_with_child = false %}
		{% endif %}
	{% endfor %}
</ul>

{# Usergroups #}
{% if titles.usergroups %}
<ul id="usergroups_menu" data-menu-flag="copy-menu" data-menu-type="usergroups">
	{% for id,title in titles.usergroups %}
		<li data-usergroup-id="{{ id }}">{{ title }}</li>
	{% endfor %}
</ul>
{% endif %}

{# Organizations #}
{% if titles.organizations %}
<ul id="organizations_menu" data-menu-flag="copy-menu" data-menu-type="organizations">
	{% for id,title in titles.organizations %}
		<li data-organization-id="{{ id }}">{{ title }}</li>
	{% endfor %}
</ul>
{% endif %}

{# Organizations #}
{% if titles.organizations %}
	<select id="organizations_select">
	{% for id,title in titles.organizations %}
		<option value="{{ id }}">{{ title }}</option>
	{% endfor %}
	</select>
{% endif %}

{# Usergroups #}
{% if titles.usergroups %}
<select id="usergroups_select">
	{% for id,title in titles.usergroups %}
		<option value="{{ id }}">{{ title }}</option>
	{% endfor %}
</select>
{% endif %}


{# Ticket Status #}
<ul id="ticket_status_menu">
	<li class="section-title">Status</li>
	<li data-status="open">Open</li>
	<li data-status="pending">Pending</li>
	<li data-status="resolved">Resolved</li>
	<li data-status="closed">Closed</li>
</ul>

{# Comment Menu #}
<ul id="comment_tools_menu" data-menu-flag="copy-menu">
	<li data-action="edit">Edit Comment</li>
	<li data-action="delete">Delete Comment</li>
	<li data-action="create-ticket">Create Ticket</li>
</ul>

{# Comment Validation Menu #}
<ul id="comment_validation_menu" data-menu-flag="copy-menu">
