{#
	This file contains global JS templates and menus and other such
	resources used throughout.
#}
<div id="deskpro_window_templates" style="display: none;">

{# Agents Selector #}
<ul id="agent_selector_list">
	{% for id,title in agent_names %}
		<li data-agent-id="{{id}}">
			<img src="{{ path('serve_person_picture_size', {'person_id': id, 'size': 30}) }}" alt="" width="30" height="30" />
			<a>{{title}}</a>
		</li>
	{% endfor %}
</ul>

{# Teams #}
<ul id="agent_teams_menu">
	{% if app.user.teams %}
		<li class="section-title">Your Teams</li>
		{% for team in app.user.teams %}
			<li data-team-id="{{ team.id }}">{{ team.name }}</li>
		{% endfor %}
		<li class="sep">-</li>
	{% endif %}

	{% for team in agent_teams %}
		<li data-team-id="{{ team.id }}">{{ team.name }}</li>
	{% endfor %}
</ul>

{# My Teams #}
{% if app.user.teams %}
	<ul id="agent_my_teams_menu">
		{% for team in app.user.teams %}
			<li data-team-id="{{ team.id }}">{{ team.name }}</li>
		{% endfor %}
	</ul>
{% endif %}

{# Department #}
<ul id="department_menu" data-menu-flag="copy-menu">
	{% for dep in ticket_options.departments_hierarchy %}
		{% if last_with_child %}
			<li class="sep">-</li>
		{% endif %}
		{% if dep.children %}
			<li data-department-id="{{dep.id}}" class="section-title">{{dep.title}}</li>
			{% for subdep in dep.children %}
				<li data-department-id="{{subdep.id}}">{{subdep.title}}</li>
			{% endfor %}
			{% set last_with_child = true %}
		{% else %}
			<li data-department-id="{{dep.id}}">{{dep.title}}</li>
			{% set last_with_child = false %}
		{% endif %}
	{% endfor %}
</ul>

{# Products #}
<ul id="products_menu" data-menu-flag="copy-menu">
	{% for cat in ticket_options.products_hierarchy %}
		{% if last_with_child %}
			<li class="sep">-</li>
		{% endif %}
		{% if cat.children %}
			<li data-product-id="{{cat.id}}" class="section-title prod-{{ cat.id }}">{{cat.title}}</li>
			{% for subcat in cat.children %}
				<li data-product-id="{{subcat.id}}" data-parent-id="{{ cat.id }}" class="prod-{{ subcat.id }}">{{subcat.title}}</li>
			{% endfor %}
			{% set last_with_child = true %}
		{% else %}
			<li data-product-id="{{cat.id}}" class="prod-{{ cat.id }}">{{cat.title}}</li>
			{% set last_with_child = false %}
		{% endif %}
	{% endfor %}
</ul>

{# Ticket Status #}
<ul id="ticket_status_menu">
	<li data-status="open">Open</li>
	<li data-status="pending">Pending</li>
	<li data-status="resolved">Resolved</li>
	<li data-status="closed">Closed</li>
</ul>

{# Popover tempalte #}
<script type="text/x-deskpro-plain" id="popover_tpl">
	<ul class="popover-tabs" style="display:none">
		<li class="move-to-tab"><a>Move into tab</a></li>
		<li class="close"><a>Close</a></li>
	</ul>
	<div class="popover-outer" style="display:none"></div>
	<div class="popover-inner" style="display:none">
		Loading ...
	</div>
</script>

{##############################################################}
{# Articles related #}
{##############################################################}

<ul id="article_category_menu" data-menu-flag="copy-menu">
	{% for cat in article_categories %}
		{% if last_with_child %}
			<li>-</li>
		{% endif %}
		{% if cat.children %}
			<li data-category-id="{{cat.id}}" class="section-title cat-{{cat.id}}">{{cat.title}}</li>
			{% for subcat in cat.children %}
				<li data-category-id="{{subcat.id}}" data-parent-id="{{cat.id}}" class="cat-{{cat.id}} cat-{{subcat.id}}">{{subcat.title}}</li>
			{% endfor %}
			{% set last_with_child = true %}
		{% else %}
			<li data-category-id="{{cat.id}}" class="cat-{{cat.id}}">{{cat.title}}</li>
			{% set last_with_child = false %}
		{% endif %}
	{% endfor %}
</ul>

