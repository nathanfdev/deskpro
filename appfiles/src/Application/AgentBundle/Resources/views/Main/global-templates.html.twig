{# Search related #}
{##############################################################}

{# Omnisearch Tempaltes #}
<script type="text/x-deskpro-plain" id="omnisearch_term_tpl">
	<div class="term">
		<span class="remove-term-trigger">x</span>
		<span class="label"></span>
		<span class="value"></span>
	</div>
</script>
<script type="text/x-deskpro-plain" id="omnisearch_term_input_tpl">
	<div class="term input-term">
		<span class="remove-term-trigger">x</span>
		<div class="label"></div>
		<div class="value">
			<span class="display-value"></span>
			<input type="text" value="" />
		</div>
	</div>
</script>
<script type="text/x-deskpro-plain" id="omnisearch_term_date_tpl">
	<div class="term date-term">
		<span class="remove-term-trigger">x</span>
		<input type="hidden" class="op" value="is" />
		<div class="label"></div>
		<div class="value">
			<span class="display-value"></span>
			{% include 'DeskPRO:Common:rulebuilder-date-options.html.twig' %}
		</div>
	</div>
</script>

{# Ticket Search Menus #}
<div id="ticket_search_terms_global">
	{% include 'DeskPRO:Common:ticket-search-criteria.html.twig' with { 'id': 0, 'classname': 0, 'term_options': ticket_options }%}
</div>

</div>
