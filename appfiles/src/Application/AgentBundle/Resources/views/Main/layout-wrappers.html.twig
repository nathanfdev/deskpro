	 ##############################}
	<section id="deskpro_content" class="deskpro-pane">
		<nav id="deskpro_tabstrip">
			<ul>
			</ul>
		</nav>
		<section id="deskpro_viewport">
		</section>
	</section>

</section>

<section id="agent_chats_wrapper"></section>
<section id="agent_chat_panel">
	<nav><a class="show-section">View History</a></nav>
	<ul id="agent_online_list">
		<li class="no-agents">No other agents are online</li>
	</ul>
</section>

