				<a>Tickets</a>
			</li>
			<li class="people" id="people_section" data-section-handler="DeskPRO.Agent.WindowElement.Section.People">
				<div class="nav-counter" style="display:none"><span>0</span></div>
				<a>People</a>
			</li>
			<li class="publish" id="kb_section" data-section-handler="DeskPRO.Agent.WindowElement.Section.Kb">
				<div class="nav-counter" style="display:none"><span>0</span></div>
				<a>Publish</a>
			</li>
			<li class="twitter" id="twitter_section" data-section-handler="DeskPRO.Agent.WindowElement.Section.Twitter">
				<div class="nav-counter" style="display:none"><span>0</span></div>
				<a>Twitter</a>
			</li>
			{#
			<li class="deals">
				<div class="nav-counter" style="display:none"><span>0</span></div>
				<a>Deals</a>
			</li>
			#}
			{#
			<li class="tasks">
			  <div class="nav-counter" style="display:none"><span>0</span></div>
			  <a>Tasks</a>
			</li>
			#}
			<li class="ideas" id="ideas_section" data-section-handler="DeskPRO.Agent.WindowElement.Section.Ideas">
				<div class="nav-counter" style="display:none"><span>0</span></div>
				<a>Ideas</a>
			</li>

			<li class="user-chat" id="chat_section" data-section-handler="DeskPRO.Agent.WindowElement.Section.UserChat">
				<div class="nav-counter" style="display:none"><span>0</span></div>
				<a>Chat</a>
			</li>
		</ul>
		<div id="agent_chat_section" class="no-click-switch" data-section-handler="DeskPRO.Agent.WindowElement.Section.AgentChat">
			<div id="chat_online_count">0</div>
		</div>
	</nav>

	{##############################
	 # Outline pane (column 2)
	 ##############################}
	<section id="deskpro_outline" class="deskpro-pane">
	</section>

	{##############################
	 # List pane (column 3)
	 ##############################}
