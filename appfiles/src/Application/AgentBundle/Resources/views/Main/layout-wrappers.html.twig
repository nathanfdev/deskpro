<section id="deskpro_layout">

	{##############################
	 # Section Nav (column 1)
	 ##############################}
	<nav id="deskpro_sections" class="deskpro-pane">
		<ul>
			<li class="urgent" id="urgent_section">
				<div class="nav-counter"><span>6</span></div>
				<a>Urgent</a>
			</li>
			<li class="tickets" id="tickets_section" data-section-handler="DeskPRO.Agent.WindowElement.Section.Tickets">
				<div class="nav-counter" style="display:none"><span>0</span></div>
				<a>Tickets</a>
			</li>
			<li class="user-chat" id="chat_section" data-section-handler="DeskPRO.Agent.WindowElement.Section.UserChat">
				<div class="nav-counter" style="display:none"><span>0</span></div>
				<a>Chat</a>
			</li>
			<li class="twitter" id="twitter_section" data-section-handler="DeskPRO.Agent.WindowElement.Section.Twitter">
				<div class="nav-counter" style="display:none"><span>0</span></div>
				<a>Twitter</a>
			</li>
			<li class="people" id="people_section" data-section-handler="DeskPRO.Agent.WindowElement.Section.People">
				<div class="nav-counter" style="display:none"><span>0</span></div>
				<a>People</a>
			</li>
			{#
			<li class="deals">
				<div class="nav-counter" style="display:none"><span>0</span></div>
				<a>Deals</a>
			</li>
			#}
			{#
			<li class="tasks">
			  <div class="nav-counter" style="display:none"><span>0</span></div>
			  <a>Tasks</a>
			</li>
			#}
			<li class="ideas" id="ideas_section" data-section-handler="DeskPRO.Agent.WindowElement.Section.Ideas">
				<div class="nav-counter" style="display:none"><span>0</span></div>
				<a>Ideas</a>
			</li>
			<li class="publish" id="publish_section" data-section-handler="DeskPRO.Agent.WindowElement.Section.Publish">
				<div class="nav-counter" style="display:none"><span>0</span></div>
				<a>Publish</a>
			</li>
		</ul>
		<div id="agent_chat_section" class="no-click-switch" data-section-handler="DeskPRO.Agent.WindowElement.Section.AgentChat">
			<div id="chat_online_count">0</div>
		</div>
	</nav>

	{##############################
	 # Outline pane (column 2)
	 ##############################}
	<section id="deskpro_outline" class="deskpro-pane">
		<section id="deskpro_outline_loading" class="on"></section>
	</section>

	{##############################
	 # List pane (column 3)
	 ##############################}
	<section id="deskpro_list" class="deskpro-pane">
		<section id="deskpro_list_loading" class="on"></section>
	</section>

	{##############################
	 # Content pane (column 4)
	 ##############################}
	<section id="deskpro_content" class="deskpro-pane">
		<nav id="deskpro_tabstrip">
			<ul>
			</ul>
		</nav>
		<section id="deskpro_viewport">
		</section>
	</section>

</section>

<section id="agent_chats_wrapper"></section>
<section id="agent_chat_panel">
	<nav>
		<span class="close-trigger">x</span>
		<a class="show-section">View History</a>
		<div class="title">
			Agents
			<label>(<input type="checkbox" class="show-offline-opt" /> show offline)</label>
		</div>
	</nav>
	<div class="online-list">
		<h6>Online</h6>
		<ul id="agent_online_list" class="list">
			<li class="no-agents">No other agents are online</li>
		</ul>
	</div>
	<div class="offline-list">
		<h6>Offline</h6>
		<ul id="agent_offline_list" class="list">
			{% for agent in agents %}
				<li
					class="agent-{{ agent.id }}"
					{% if agent.id == app.user.id %}style="display: none"{% endif %}
					data-agent-id="{{ agent.id }}"
					data-agent-name="{{ agent.display_name }}"
					data-agent-short-name="{{ agent.getDisplayContactShort(4) }}"
					data-picture-url="{{ agent.getPictureUrl(10) }}"
				>
					<img src="{{ agent.getPictureUrl(10) }}" />
					{{ agent.display_name }}
				</li>
			{% endfor %}
		</ul>
	</div>
</section>

{% include 'AgentBundle:AgentChat:chat-layout-templates.html.twig' %}
{% include 'AgentBundle:UserChat:chat-layout-templates.html.twig' %}

{#
	This isnt a jQuery template. Its used in TabStrip.js because
	it needs an html string, and jQuery creates real HTML elements.
#}
<script type="text/x-deskpro-tmpl" id="tab_loading_template">
	<script>
	pageMeta.title = '{{ phrase('agent.tab_loading_title') }}';
	%endScript%
	<div class="tab-loading">
		{{ phrase('agent.tab_loading') }}
	</div>
</script>

{% include 'AgentBundle:Main:volume-menu.html.twig' %}
{% include 'AgentBundle:Main:audio-preload.html.twig' %}

<ul id="agent_selector_list" style="display: none">
	{% for id,title in agent_names %}
		<li data-agent-id="{{id}}">
			<img src="{{ path('serve_person_picture_size', {'person_id': id, 'size': 30}) }}" alt="" width="30" height="30" />
			<a>{{title}}</a>
		</li>
	{% endfor %}
</ul>