<div class="ticket-bar">
	{% if ticket.id %}
		{% include 'AgentBundle:Ticket:reply-form.html.twig' with {'with_ticket_context': true} %}
	{% else %}
		{% include 'AgentBundle:Ticket:reply-form.html.twig' with {'with_ticket_context': false} %}
	{% endif %}
	<div class="bar">
		<ul class="tools">
			<li class="submit-reply trigger" style="display:none;"><span class="icon icon-check">{% if ticket.id %}Reply{% else %}Create{% endif %}</span></li>
			<li class="macros-apply left-most" style="display:none"><span class="icon icon-check">Apply</span></li>
			<li class="macros-cancel" style="display:none"><span class="icon icon-cross">Cancel</span></li>
			<li class="macros left-most"><span class="icon icon-script-gear">Macros</span></li>
			<li class="actions"><span class="icon icon-mouse">Actions</span></li>
		</ul>
		<div class="placeholder">
			<input type="text" class="placeholder" value="Start typing a reply..." />
		</div>
	</div>
</div>