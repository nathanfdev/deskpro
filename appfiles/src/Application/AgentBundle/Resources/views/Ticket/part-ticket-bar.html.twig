<div class="tab-bottom-wrap">
	<div class="tab-bottom-open" style="display:none">
		<div class="tab-bottom-tabs">
			<ul>
				<li class="tab-trigger reply-reply on" data-tab-for=".tab-content.reply-reply"><a>Message</a></li>
				<li class="tab-trigger reply-cc" data-tab-for=".tab-content.reply-cc"><a>CC</a></li>
				<li class="tab-trigger reply-attach" data-tab-for=".tab-content.reply-attach"><a>Attachment</a></li>
			</ul>
			<a class="close-tab-open close-trigger">Close</a>
		</div>

		<div class="tab-bottom-contents">
			{# Reply area #}
			<div class="content-tab-bottom reply-reply tab-content on" data-tab-trigger=".tab-trigger.reply-reply">
				<div class="reply-form-fields">
					<textarea name="message"></textarea>
					<div style="float: right; padding: 5px 5px 0 0;">
						<button class="dp-button black x-small submit-reply-trigger">Add Reply</button>
					</div>
					<table cellspacing="0" cellpadding="0">
						<tr><td>
							<input type="hidden" name="options[agent_id]" value="{{person.id}}" />
							<input type="hidden" name="options[agent_team_id]" value="{{person.getAgentTeamIds[0]}}" />
							<input type="hidden" name="options[status]" value="pending" />

							<input class="small reply-assign-trigger" type="checkbox" name="options[do_assign]" value="1" checked="checked" /> Assign ticket to
							<span class="prop-val trigger agent_id">Me</span>
							and
							<span class="prop-val trigger agent_team_id">My Team</span>
						</td></tr>
						<tr><td>
							<input class="small" type="checkbox" name="options[do_status]" checked="checked" /> Change status to <span class="prop-val status trigger">Pending</span>
						</td></tr>
					</table>
				</div>
				<ul class="reply-agent_id-menu" style="display:none">
					<li data-option-id="standard" data-option-name="agent_id" data-option-value="{{person.id}}">Me</li>
					<li class="sep">-</li>
					{% for id,title in ticket_options.agents %}
						<li data-option-id="standard" data-option-name="agent_id" data-option-value="{{id}}">{{title}}</li>
					{% endfor %}
				</ul>
				<ul class="reply-agent_team_id-menu" style="display:none">
					<li data-option-id="standard" data-option-name="agent_team_id" data-option-value="{{person.getAgentTeamIds[0]}}">My Team</li>
					<li class="sep">-</li>
					{% for id,title in ticket_options.agent_teams %}
						<li data-option-id="standard" data-option-name="agent_team_id" data-option-value="{{id}}">{{title}}</li>
					{% endfor %}
				</ul>
				<ul class="reply-status-menu" style="display:none">
					<li data-option-id="standard" data-option-name="status" data-option-value="open">Open</li>
					<li data-option-id="standard" data-option-name="status" data-option-value="pending">Pending</li>
					<li data-option-id="standard" data-option-name="status" data-option-value="resolved">Resolved</li>
				</ul>
			</div>
			{# /Reply Area #}

			<div class="content-tab-bottom content-tab-bottom reply-attach tab-content" data-tab-trigger=".tab-trigger.reply-attach">
				<div class="file-input">
					<button class="dp-button x-small">Upload new file</button> or drag and drop files onto this area
					<input type="file" name="file" multiple="multiple" />
				</div>
				<ul class="file-list"></ul>
			</div>
			<div class="content-tab-bottom cc-area reply-cc tab-content" data-tab-trigger=".tab-trigger.reply-cc">
				<input type="text" value="" /> <button class="dp-button x-small">Add Email Address</button>
			</div>
		</div>
	</div>

	<div class="tab-bottom">
		<input type="text" class="placeholder" value="Start typing a reply..." />
		<div class="bar-actions">
			<ul>
				<li class="macro-on macros-apply" style="display:none">Apply</li>
				<li class="macro-on macros-cancel" style="display:none">Cancel</li>
				<li class="macros"><a href="" >Macros</a></li>
				<li class="actions"><a href="" >Actions</a></li>
			</ul>
		</div>
	</div>
</div>