<div class="bar-wrapper">
<div class="tab-bottom-wrap">
	<div class="tab-bottom-open">
		<div class="tab-bottom-tabs">
			<ul>
				<li class="tab-trigger reply-reply on" data-tab-for=".tab-content.reply-reply"><a>Message</a></li>
				<li class="tab-trigger reply-cc" data-tab-for=".tab-content.reply-cc"><a>CC</a></li>
				<li class="tab-trigger reply-attach" data-tab-for=".tab-content.reply-attach"><a>Attachment</a></li>
			</ul>
			<span class="bottom-tabs-button macros">Macros</span>
			<span class="bottom-tabs-button macros-apply" style="display: none;">Apply</span>
			<span class="bottom-tabs-button macros-cancel" style="display: none;">Cancel</span>
		</div>

		<div class="tab-bottom-contents" style="height:154px;">
			{# Reply area #}
			<div class="content-tab-bottom reply-reply tab-content on" data-tab-trigger=".tab-trigger.reply-reply">
				<div class="reply-form-fields">

					<script class="template-upload" type="text/x-jquery-tmpl">
						<li class="uploading">${name} <span class="cancel"><button class="clean-gray xx-small">Cancel</button></span></li>
					</script>
                    <script class="template-download" type="text/x-jquery-tmpl">
						<li class="uploaded">
							<input type="checkbox" checked="checked" name="attach[]" value="${blob_id}" />
							<a href="${download_url}" target="_blank">${filename}</a>
							<span class="size">${filesize_readable}</span>
						</li>
					</script>


					<textarea name="message"></textarea>
					<input type="hidden" name="options[agent_id]" value="{{app.user.id}}" />
					<input type="hidden" name="options[agent_team_id]" value="{{app.user.getAgentTeamIds[0]}}" />
					<input type="hidden" name="options[status]" value="pending" />

					<div class="send-reply" style="float:right; margin-right: 8px; margin-top: 4px;">
						<button class="dp-button">Add Reply</button>
						<div class="spinner"></div>
					</div>

					<table cellspacing="0" cellpadding="0" style="margin-top: 5px;">
						<tr>
							<td width="5" valign="middle" style="vertical-align:middle; padding-right: 5px;">
								<input id="foot_assign_check_{{ticket.id}}" class="small" type="checkbox" name="options[do_assign]" value="1" checked="checked" />
							</td>
							<td style="padding-right: 15px; vertical-align:middle;" valign="middle">
								<label for="foot_assign_check_{{ticket.id}}">Assign ticket to</label>
								<span class="prop-val trigger agent_id">Me</span>
								<label for="foot_assign_check_{{ticket.id}}">and</label>
								<span class="prop-val trigger agent_team_id">My Team</span>
							</td>
							<td width="5" valign="middle" style="vertical-align:middle; padding-right:5px;">
								<input id="foot_status_check_{{ticket.id}}" class="small" type="checkbox" name="options[do_status]" checked="checked" />
							</td>
							<td valign="middle" style="vertical-align:middle">
								<label for="foot_status_check_{{ticket.id}}">Change status to</label>
								<span class="prop-val status trigger">Pending</span>
							</td>
						</tr>
						<tr>
							<td width="5" valign="middle" style="vertical-align:middle; padding-right: 5px;">
								<input id="foot_close_tab_{{ticket.id}}" class="small" type="checkbox" name="options[close_tab]" value="1" checked="checked" />
							</td>
							<td style="padding-right: 15px; vertical-align:middle;" valign="middle">
								<label for="foot_close_tab_{{ticket.id}}">Close tab after reply</label>
							</td>
							<td width="5" valign="middle" style="vertical-align:middle; padding-right:5px;">
								<input id="foot_kb_pending_{{ticket.id}}" class="small" type="checkbox" name="options[kb_pending]" />
							</td>
							<td valign="middle" style="vertical-align:middle">
								<label for="foot_kb_pending_{{ticket.id}}">Mark as pending KB article</label>
							</td>
						</tr>
					</table>
				</div>
				<ul class="reply-agent_id-menu" style="display:none">
					<li data-option-id="standard" data-option-name="agent_id" data-option-value="{{app.user.id}}">Me</li>
					<li class="sep">-</li>
					{% for id,title in ticket_options.agents %}
						<li data-option-id="standard" data-option-name="agent_id" data-option-value="{{id}}">{{title}}</li>
					{% endfor %}
				</ul>
				<ul class="reply-agent_team_id-menu" style="display:none">
					<li data-option-id="standard" data-option-name="agent_team_id" data-option-value="{{app.user.getAgentTeamIds[0]}}">My Team</li>
					<li class="sep">-</li>
					{% for id,title in ticket_options.agent_teams %}
						<li data-option-id="standard" data-option-name="agent_team_id" data-option-value="{{id}}">{{title}}</li>
					{% endfor %}
				</ul>
				<ul class="reply-status-menu" style="display:none">
					<li data-option-id="standard" data-option-name="status" data-option-value="open">Open</li>
					<li data-option-id="standard" data-option-name="status" data-option-value="pending">Pending</li>
					<li data-option-id="standard" data-option-name="status" data-option-value="resolved">Resolved</li>
				</ul>
			</div>
			{# /Reply Area #}

			<div class="content-tab-bottom content-tab-bottom reply-attach tab-content" data-tab-trigger=".tab-trigger.reply-attach">
				<div class="file-input">
					Drag and drop files onto this area or choose a file:
					<input type="file" name="file-upload" multiple="multiple" />
				</div>
				<ul class="files file-list"></ul>
			</div>
			<div class="content-tab-bottom cc-area reply-cc tab-content" data-tab-trigger=".tab-trigger.reply-cc">
				{% include 'AgentBundle:Ticket:view-reply-cctab.html.twig' with {'participants': participants} %}
			</div>
		</div>
	</div>

	{#
	<div class="tab-bottom">
		<input type="text" class="placeholder" value="Start typing a reply..." />
		<div class="bar-actions">
			<ul>
				<li class="macro-on macros-apply" style="display:none"><a>Apply</a></li>
				<li class="macro-on macros-cancel" style="display:none"><a>Cancel</a></li>
				<li class="send-reply" style="display:none"><div class="spinner" style="float:left;display:none;"></div><a>Send Reply</a><a class="loading-msg">Sending</a></li>
				<li class="macros"><a>Macros</a></li>
				<li class="actions"><a>Actions</a></li>
			</ul>
		</div>
	</div>
	#}
</div>
</div>