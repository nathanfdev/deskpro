<div class="page-display-holders" style="display:none">
	{# Standard fields #}
	<div class="ticket_category category_id standard-field item" data-item-type="ticket_category">
		<div class="title">
			<span class="menu-trigger category_id label">Category</span>
		</div>
		<div class="content">
			<span class="prop-val menu-trigger category_id {% if not ticket.category %}no-value{% endif %}">{{ticket.category.full_title|default('None')}}</span>
		</div>
	</div>
	<div class="ticket_product product_id standard-field item" data-item-type="ticket_product">
		<div class="title">
			<span class="menu-trigger product_id label">Product</span>
		</div>
		<div class="content">
			<span class="prop-val menu-trigger product_id {% if not ticket.category %}no-value{% endif %}">{{ticket.product.title|default('None')}}</span>
		</div>
	</div>
	<div class="ticket_priority priority_id standard-field item" data-item-type="ticket_priority">
		<div class="title">
			<span class="menu-trigger priority_id label">Priority</span>
		</div>
		<div class="content">
			<span class="prop-val menu-trigger priority_id {% if not ticket.category %}no-value{% endif %}">{{ticket.priority.title|default('None')}}</span>
		</div>
	</div>
	<div class="ticket_workflow workflow_id standard-field item" data-item-type="ticket_workflow">
		<div class="title">
			<span class="menu-trigger workflow_id label">Workflow</span>
		</div>
		<div class="content">
			<span class="prop-val menu-trigger workflow_id {% if not ticket.workflow %}no-value{% endif %}">{{ticket.workflow.title|default('None')}}</span>
		</div>
	</div>

	{# Custom fields#}
	{% for f in custom_fields %}
		<div class="ticket_field_{{f.id}} custom-field item" data-field-type="ticket_field" data-item-id="{{f.id}}" data-custom-field-handler="{{f.field_handler}}">
			<div class="title">
				<span class="custom-field edit-trigger ticket_field_{{f.id}}" data-item-id="{{f.id}}">{{f.title}}</span>
			</div>
			<div class="content">
				<div class="custom-field content ticket_field_{{f.id}}" data-item-id="{{f.id}}">
					{{ render_custom_field(f) }}
				</div>
			</div>
		</div>
	{% endfor %}
</div>
<div class="page-display-input" style="display: none;">
	<div class="ticket_category category_id standard-field item" data-item-type="ticket_category">
		<div class="title">Category</div>
		<div class="content">
			<select name="ticket[category_id]" data-prop-id="category_id">
				<option value="0"></option>
				{% for cat in ticket_options.ticket_categories_hierarchy %}
					<option {% if ticket.category.id == cat.id %}selected="selected"{% endif %} value="{{ cat.id }}">{{ "--"|repeat(cat.depth) }} {{ cat.title }}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	<div class="ticket_product product_id standard-field item" data-item-type="ticket_product">
		<div class="title">Product</div>
		<div class="content">
			<select name="ticket[product]_id" data-prop-id="product_id">
				<option value="0"></option>
				{% for prod in ticket_options.products_hierarchy %}
					<option {% if ticket.product.id == prod.id %}selected="selected"{% endif %} value="{{ prod.id }}">{{ "--"|repeat(prod.depth) }} {{ prod.title }}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	<div class="ticket_priority priority_id standard-field item" data-item-type="ticket_priority">
		<div class="title">Priority</div>
		<div class="content">
			<select name="ticket[priority_id]" data-prop-id="priority_id">
				<option value="0"></option>
				{% for id,pri in ticket_options.priorities %}
					<option {% if ticket.priority.id == id %}selected="selected"{% endif %} value="{{ id }}">{{ pri }}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	<div class="ticket_workflow workflow_id standard-field item" data-item-type="ticket_workflow">
		<div class="title">Workflow</div>
		<div class="content">
			<select name="ticket[workflow_id]" data-prop-id="workflow_id">
				<option value="0"></option>
				{% for id,work in ticket_options.ticket_workflows %}
					<option {% if ticket.workflow.id == id %}selected="selected"{% endif %} value="{{ id }}">{{ work }}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	
	{% for f in custom_fields %}
		<div class="ticket_field_{{f.id}} custom-field item-input" data-field-type="ticket_field" data-item-id="{{f.id}}" data-custom-field-handler="{{f.field_handler}}">
			<div class="title">{{ f.title }}</div>
			<div class="content">
				<div class="custom-field field-input ticket_field_{{f.id}}" data-item-id="{{f.id}}">
					{{ render_custom_field_form(f) }}
				</div>
			</div>
		</div>
	{% endfor %}
</div>