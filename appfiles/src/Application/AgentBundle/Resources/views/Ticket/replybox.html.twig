<section class="reply-box" id="{{baseId}}_replybox">
	<nav class="reply-type">
		<ul>
			<li id="{{baseId}}_replybox_replytab_btn" class="on">Reply</li>
			<li id="{{baseId}}_replybox_notetab_btn">Note</li>
		</ul>
	</nav>
	<div class="top-area note-hide">
		<button class="clean-gray xx-small text-snippets" id="{{baseId}}_text_snippets_btn">Text Snippets</button>
		<ul class="related-content">
			<li class="similar-tickets"><a>Similar Tickets</a></li>
			<li class="suggested-articles"><a>Suggested Knowledgebase Articles</a></li>
		</ul>
		<br style="clear: both; height: 0; overflow: hidden;" />
	</div>
	<div class="reply-area">
		<textarea class="reply"></textarea>
		<div class="attachments">
			<script class="template-upload" type="text/x-jquery-tmpl">
				<li class="uploading">${name} <span class="cancel"><button class="clean-gray xx-small">Cancel</button></span></li>
			</script>
			<script class="template-download" type="text/x-jquery-tmpl">
				<li class="uploaded">
					<input type="checkbox" checked="checked" name="attach[]" value="${blob_id}" />
					<a href="${download_url}" target="_blank">${filename}</a>
					<span class="size">${filesize_readable}</span>
				</li>
			</script>
			<h6>Attachments</h6>
			<div class="file-input">
				<input type="file" name="file-upload" multiple="multiple" /> <button class="clean-gray xxx-small">Upload</button>
			</div>
			<ul class="files file-list"></ul>
		</div>
		<div class="cc-users note-hide">
			<h6>CC Users</h6>
			<div class="cc-input">
				<input type="text" class="new-cc" /> <button class="clean-gray xxx-small">Add</button>
			</div>
		</div>
		<br style="clear: both; height: 0; overflow: hidden;" />
	</div>
	<div class="options-area note-hide">
		<ul>
			<li>
				<input id="{{baseId}}_assign_opt" class="small" type="checkbox" name="options[do_assign]" value="1" checked="checked" />
				<label for="{{baseId}}_assign_opt">Assign to</label>
				<span class="prop-val trigger agent_id">Me</span>

				and
				<input id="{{baseId}}_assign_team_opt" class="small" type="checkbox" name="options[do_assign_team]" value="1" checked="checked" />
				<span class="prop-val trigger agent_id">My team</span>
			</li>

			<li>
				<input id="{{baseId}}_kbpending_opt" class="small" type="checkbox" name="options[do_kbpending]" value="1" checked="checked" />
				<label for="{{baseId}}_kbpending_opt">Mark as Pending KB Article</label>
			</li>

			<li>
				<input id="{{baseId}}_status_opt" class="small" type="checkbox" name="options[do_status]" value="1" checked="checked" />
				<label for="{{baseId}}_status_opt">Set as</label>
				<span class="prop-val status trigger">Awaiting User</span>
			</li>
		</ul>
		<br style="clear: both; height: 0; overflow: hidden;" />
	</div>
	<div class="options-area reply-hide" style="display: none;">
		<ul>
			<li>
				<input id="{{baseId}}_assign_opt" class="small" type="checkbox" name="options[do_assign]" value="1" />
				<span class="assign_opt_withval" style="display: none;">
					<label for="{{baseId}}_assign_opt">Assign to</label>
				</span>
				<span class="assign_opt_withoutval">
					<label for="{{baseId}}_assign_opt">Assign to...</label>
				</span>
				<span class="prop-val trigger agent_id"></span>
			</li>
			<li>
				<input id="{{baseId}}_assign_team_opt" class="small" type="checkbox" name="options[do_assign_team]" value="1" />
				<span class="assign_team_opt_withval" style="display: none;">
					<label for="{{baseId}}_assign_team_opt">Assign to team</label>
				</span>
				<span class="assign_team_opt_withoutval">
					<label for="{{baseId}}_assign_team_opt">Assign team...</label>
				</span>
				<span class="prop-val trigger agent_id"></span>
			</li>
		</ul>
		<div class="followers">
			<h6>Follwers</h6>
			<button class="clean-gray xx-small add-followers-trigger">Add Followers</button>

			<ul class="followers-list" id="{{baseId}}_newnote_followerslist">
			</ul>
		</div>
		<br style="clear: both; height: 0; overflow: hidden;" />
	</div>

	<div class="controls-area">
		<button class="dp-button add-reply-trigger note-hide">Add Reply (alt+r)</button>
		<button class="dp-button add-reply-trigger reply-hide" style="display: none;">Add Note (alt+r)</button>
	</div>
</section>

