{% extends 'AgentBundle::layout-popup.html.twig' %}
{% set current_page %}{% block current_page "view-unformatted" %}{% endset %}
{% block content %}
<nav class="top-tabs">
	<ul>
		<li {% if current_page == 'details' %}class="on"{% endif %}><a href="{{ path('agent_ticket_message_details', {'ticket_id': ticket.id, 'message_id': message.id}) }}">Details</a></li>
		<li {% if current_page == 'view-unformatted' %}class="on"{% endif %}><a href="{{ path('agent_ticket_message_unformatted', {'ticket_id': ticket.id, 'message_id': message.id}) }}">View Unformatted</a></li>
		{% if ticket.creation_system != 'web' %}<li {% if current_page == 'email-source' %}class="on"{% endif %}><a href="{{ path('agent_ticket_message_emailsource', {'ticket_id': ticket.id, 'message_id': message.id}) }}">View Email Source</a></li>{% endif %}
	</ul>
</nav>
<section class="body">
	{% block body %}{% endblock %}
</section>
{% endblock %}
