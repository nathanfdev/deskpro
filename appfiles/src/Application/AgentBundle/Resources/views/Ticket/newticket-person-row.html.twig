<input type="hidden" class="person_id" value="{{ person.id }}" />
<dl>
	<dt>Name</dt>
	<dd>
		<input type="text" name="person[name]" value="{{ person.name }}" />
		{% if person.id %}
			<a class="with-route" data-route="person:{{ path('agent_people_view', {'person_id': person.id}) }}">view profile</a>
		{% endif %}
	</dd>

	<dt class="more" {% if not person.organization %}style="display:none"{% endif %}>Organization</dt>
	<dd class="more" {% if not person.organization %}style="display:none"{% endif %}></dd>

	<dt class="more" {% if not person.organization %}style="display:none"{% endif %}>Organization Position</dt>
	<dd class="more" {% if not person.organization %}style="display:none"{% endif %}><input type="text" name="person[organization_position]" /></dd>
</dl>
<br class="clear" />

<button class="clean-gray xx-small more-fields">More...</button>