<div class="pad"><div class="inner-box-tab-content box-list no-pad">

<table class="list general ticketlog" cellspacing="0" width="100%">
	<thead>
		<tr>
			<th>Summary</th>
			<th>Who</th>
			<th>Date</th>
		</tr>
	</thead>
	<tbody>
		{% for log in ticket_logs %}
			<tr>
				<td>
					<div class="{{ log.action_type }}">
					{% if log.action_type == 'changed_agent' %}
						<span class="type">Assigned agent</span> changed from
						<span class="old-val">{{log.details.old_agent_name}}</span> to <span class="new-val">{{log.details.new_agent_name}}</span>
					{% elseif log.action_type == 'ticket_created' %}
						Ticket <span class="new-val">#{{log.details.ticket_id}}</span> created
					{% elseif log.action_type == 'changed_category' %}
						<span class="type">Category</span> changed from
						<span class="old-val">{{log.details.old_category_title|default('None')}}</span> to <span class="new-val">{{log.details.new_category_title}}</span>
					{% elseif log.action_type == 'changed_department' %}
						<span class="type">Department</span> changed from
						<span class="old-val">{{log.details.old_department_title}}</span> to <span class="new-val">{{log.details.new_department_title}}</span>
					{% elseif log.action_type == 'message_created' %}
						<span class="type">New reply</span> <span class="new-val">#{{log.details.message_id}}</span>
					{% elseif log.action_type == 'changed_priority' %}
						<span class="type">Priority</span> changed from
						<span class="old-val">{{log.details.old_priority_title}}</span> to <span class="new-val">{{log.details.new_priority_title}}</span>
					{% elseif log.action_type == 'changed_product' %}
						<span class="type">Product</span> changed from
						<span class="old-val">{{log.details.old_product_title}}</span> to <span class="new-val">{{log.details.new_product_title}}</span>
					{% elseif log.action_type == 'changed_status' %}
						<span class="type">Status</span> changed from
						<span class="old-val">{{log.details.old_status}}</span> to <span class="new-val">{{log.details.new_status}}</span>
					{% endif %}
					</div>
				</td>
				<td>
					<a class="with-route" data-route="person:{{ path('agent_people_view', {'person_id': log.person.id}) }}">
					{{log.person.display_name}}
					</a>
				</td>
				<td style="white-space:nowrap;"><time class="timeago" title="{{log.date_created|date('c')}}">
					{{log.date_created|date('Y-m-d H:m')}}
				</time></td>
			</tr>
		{% endfor %}
	</tbody>
</table>

</div></div>