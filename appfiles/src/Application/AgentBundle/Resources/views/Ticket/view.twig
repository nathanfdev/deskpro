<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.Ticket';
pageMeta.title = '{{ticket.subject}}';
pageMeta.ticket_id = {{ticket.id}};
pageMeta.pageIdentity = 'ticket:{{ticket.id}}';
</script>

<div class="ticket">

<div class="ticket-top">
	<h1>{{ticket.subject}}</h1>

	<div class="ticket-info">
		<div class="edit-btn ticket-info-edit-btn"></div>
		<dl class="ticket-opt-btn ticket-options-department-btn">
			<dt>Department</dt>
			<dd>{{ticket.department.title}}</dd>
		</dl>
		<dl class="ticket-opt-btn ticket-options-category-btn">
			<dt>Category</dt>
			<dd>{{ticket.category.title}}</dd>
		</dl>
		<dl class="ticket-opt-btn ticket-options-product-btn">
			<dt>Product</dt>
			<dd>{{ticket.product.title}}</dd>
		</dl>
		<dl class="ticket-opt-btn ticket-options-priority-btn">
			<dt>Priority</dt>
			<dd>{{ticket.priority.title}}</dd>
		</dl>
		<br style="clear:both" />
	</div>

	<br style="clear:both" />
	
	<div class="person-info-line">

		<div style="float:right">
			<strong>Assigned To:</strong><br />
			{% if not ticket.agent_id %}
				UNASSIGNED
			{% elseif ticket.agent_id == person.id %}
				YOU
			{% else %}
				{{ticket.agent.name}}
			{% endif %}
		</div>

		<div class="person-overview">
			<div class="img">
				<img src="http://a1.twimg.com/profile_images/582127009/Photo-on-2009-11-22-at-19.58-2-large_normal.jpg" />
			</div>
			<div class="info">
				<h1>{{ticket.person.name}}</h1>
				{% if ticket.person.primary_email %}
					{{ticket.person.primary_email.email}}
				{% endif %}
			</div>
		</div>
		
		<br style="clear:both" />
	</div>

	{% if custom_fields %}
		<div class="ticket-custom-fields-wrap">
			<div class="edit-btn ticket-custom-fields-edit-btn"><span>Edit Fields</span></div>
			<div class="ticket-custom-fields">
				<div class="wrap">
					{% include 'AgentBundle:Ticket:custom-fields-rendered.twig' with ['custom_fields': custom_fields] %}
				</div>
			</div>
		</div>
	
		<div class="ticket-custom-fields edit" style="display:none">
			{% for f in custom_fields %}
				<div class="field-wrap">
					<div class="label-wrap"><label>{{f.title}}</label></div>
					<div class="field-input">
						{{f.form|render}}
					</div>
				</div>
			{% endfor %}		
			<div class="buttons">
				<div class="loading-off">
					<button class="save-trigger dp-button small">Save</button>
					<button class="close-trigger dp-button gray small">Cancel</button>
				</div>
				<div class="loading-on">
					<span>Saving ...</span>
				</div>
			</div>
		</div>
	{% endif %}
	
	<ul class="ticket-tabs">
		<li class="tab-trigger messages on" data-tab-for=".tab-content.messages">Messages</li>
		<li class="tab-trigger attachments" data-tab-for=".tab-content.attachments">Attachments</li>
	</ul>
</div>

<div class="tab-content on messages" data-tab-trigger=".tab-trigger.messages">
	<ul>
		<li class="agent agent-reply">
			<div class="box">
				<div class="info">
					<cite>New Reply</cite>
				</div>
				<div class="message">
					<div class="placeholder">
						<textarea>Write a new reply...</textarea>
						<div class="editor-loading">Please wait a moment while the editor is loaded</div>
					</div>
					<div class="reply-area" style="display:none">
						<div class="ticket-attach-upload-btn"><span>Add Attachments</span></div>
						<ul class="ticket-newreply-attach-list">
						</ul>
						<textarea name="reply"></textarea>
						
						<div class="buttons">
							<button class="btn-submit dp-button small">Add Reply</button> or <a href="#" class="btn-cancel">cancel</a>
						</div>
						<div class="send-reply-load"><div>Your reply is being sent ...</div></div>
					</div>
				</div>
			</div>
		</li>
		{% for message in ticket.messages|reverse %}
			{% include 'AgentBundle:Ticket:ticket-message.twig' with ['message': message] %}
		{% endfor %}
	</ul>
</div>

<div class="tab-content attachments" data-tab-trigger=".tab-trigger.attachments">
		
	<table class="list" cellspacing="0" width="100%">
		<thead class="display-options-trigger">
			<tr>
				<th>Filename</th>
				<th width="100">View</th>
			</tr>
		</thead>
		<tbody>
			{% for ticket_attach in ticket.attachments %}
				<tr>
					<td><a href="{% path 'agent_show_blob' with ['blob_id': ticket_attach.blob_id] %}" target="_blank">{{ticket_attach.blob.filename}}</a></td>
					<td>{{ticket_attach.blob.filesize}} bytes</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
</div>

</div>

<div class="person-popout" style="display:none">
	<div class="tabbar">
		<div class="pin-icon"></div>
		<ul>
			<li class="tab icon icon-person tab-active"><div class="title"><span>Ticket User</span></div></li>
		</ul>
	</div>
	<br style="clear:both"/>
	<div class="content">
		{{person_inner_tab|raw}}
	</div>
</div>

<div class="person-overview-popout" style="display:none"></div>

<div class="person-overview-popout-content" style="display:none" data-route="person:{% path 'agent_people_view' with ['person_id': ticket.person_id] %}">
	<div class="img">
		<img src="http://a1.twimg.com/profile_images/582127009/Photo-on-2009-11-22-at-19.58-2-large_normal.jpg" />
	</div>
	<div class="info">
		<h1>{{ticket.person.name}}</h1>
		{% if ticket.person.primary_email %}
			{{ticket.person.primary_email.email}}
		{% endif %}
	</div>
	<div class="open-person">
		Open person in new tab
	</div>
</div>

<div class="ticket-attach overlay no-padd">
	<div class="ticket-attach-widget"></div>
	<div class="buttons">
		<button class="save dp-button small overlay-close-trigger">Done</button>
	</div>
</div>

<ul class="ticket-info-edit-menu" style="display:none">
	<li><span class="icon print-ticket">Print Ticket</span></li>
	<li><span class="icon merge-ticket">Merge Ticket</span></li>
	<li><span class="icon delete-ticket">Delete Ticket</span></li>
	<li><span class="icon change-ticket-owner">Change User Owner</span></li>
</ul>
<ul class="ticket-message-edit-menu" style="display:none">
	<li><span class="icon view-unformatted">View Unformatted</span></li>
	<li><span class="icon view-details">View Details</span></li>
	<li><span class="icon edit">Edit</span></li>
</ul>
<ul class="ticket-options-department-menu" data-option-name="department" style="display:none">
	{% for id,title in ticket_options.departments %}
		<li data-option-id="{{id}}">{{title}}</li>
	{% endfor %}
</ul>
<ul class="ticket-options-category-menu" data-option-name="category" style="display:none">
	{% for id,title in ticket_options.categories %}
		<li data-option-id="{{id}}">{{title}}</li>
	{% endfor %}
</ul>
<ul class="ticket-options-product-menu" data-option-name="product" style="display:none">
	{% for id,title in ticket_options.products %}
		<li data-option-id="{{id}}">{{title}}</li>
	{% endfor %}
</ul>
<ul class="ticket-options-priority-menu" data-option-name="priority" style="display:none">
	{% for id,title in ticket_options.priorities %}
		<li data-option-id="{{id}}">{{title}}</li>
	{% endfor %}
</ul>