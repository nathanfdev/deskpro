<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.Ticket';
pageMeta.title = '{{ticket.subject}}';
pageMeta.ticket_id = {{ticket.id}};
pageMeta.pageIdentity = 'ticket:{{ticket.id}}';
pageMeta.tagsAutocompleteUrl = '{{ path('agent_ajax_labels_autocomplete') }}';
</script>

<div class="ticket-content">
	<div class="ticket">

	<div class="ticket-top">
		<span class="ticket-flag icon icon-flag-{{ticket_flagged_color}}" data-flag="{{ticket_flagged_color}}"></span>
		<h1>
			<span class="ticket-opt-btn ticket-options-department-btn department {% if not ticket.department %}no-value{% endif %}">
				<span class="val" data-no-value="Choose Department">{{ticket.department.title}}</span>
				&rsaquo;
			</span>
			{{ticket.subject}}
		</h1>
		<div class="tags-field">
			<ul class="tagit">
				<li>Tag1</li>
				<li>Tag2</li>
			</ul>
		</div>

		{% include 'AgentBundle:Ticket:part-ticket-info.twig' %}

		<br style="clear:both" />
	
		<div class="person-info-line">

			<div class="ticket-opt-btn ticket-options-agent-btn agent" style="float:right">
				<strong>Agent:</strong><br />
				<span class="val {% if not ticket.agent %}no-value{% endif %}" data-no-value="Unassigned">{{ticket.agent.name}}</span>
			</div>

			<div class="person-overview">
				<div class="img">
					<img src="http://a1.twimg.com/profile_images/582127009/Photo-on-2009-11-22-at-19.58-2-large_normal.jpg" />
				</div>
				<div class="info">
					<h1>{{ticket.person.name}}</h1>
					{% if ticket.person.primary_email %}
						{{ticket.person.primary_email.email}}
					{% endif %}
					<div style="font-size: 7pt; color: #6D7C8C; padding-top: 4px;">Click to view information</div>
				</div>
			</div>
		
			<br style="clear:both" />
		</div>

		{% include 'AgentBundle:Ticket:part-custom-fields.twig' %}
	
		<ul class="ticket-tabs">
			<li class="tab-trigger messages on" data-tab-for=".tab-content.messages">Messages</li>
			{% if ticket.attachments.count() %}<li class="tab-trigger attachments" data-tab-for=".tab-content.attachments">Attachments</li>{% endif %}
			<li class="tab-trigger ticket-log" data-tab-for=".tab-content.ticket-log">Ticket Log</li>
		</ul>
	</div>

	<div class="tab-content on messages" data-tab-trigger=".tab-trigger.messages">
		<ul>
			{% for message in ticket.messages %}
				{% include 'AgentBundle:Ticket:ticket-message.twig' with {'message': message} %}
			{% endfor %}
		</ul>
	</div>

	<div class="tab-content attachments" data-tab-trigger=".tab-trigger.attachments">
		
		<table class="list" cellspacing="0" width="100%">
			<thead class="display-options-trigger">
				<tr>
					<th>Filename</th>
					<th width="100">View</th>
				</tr>
			</thead>
			<tbody>
				{% for ticket_attach in ticket.attachments %}
					<tr>
						<td><a href="{{ path('agent_show_blob', {'blob_id': ticket_attach.blob_id}) }}" target="_blank">{{ticket_attach.blob.filename}}</a></td>
						<td>{{ticket_attach.blob.filesize}} bytes</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>

	<div class="tab-content ticket-log" data-tab-trigger=".tab-trigger.ticket-log">
		<div class="loading-more" style="display:block">
			Loading ticket log ...
		</div>
	</div>

	</div>

	<div class="person-popout" style="display:none">
		<div class="tabbar nosel">
			<div class="pin-icon"></div>
			<ul>
				<li class="tab icon icon-person tab-active"><div class="title"><span>Ticket User</span></div></li>
			</ul>
		</div>
		<br style="clear:both"/>
		<div class="content">
			{{person_inner_tab|raw}}
		</div>
	</div>

	<div class="person-overview-popout" style="display:none"></div>

	<div class="person-overview-popout-content" style="display:none" data-route="person:{{ path('agent_people_view', {'person_id': ticket.person_id}) }}">
		<div class="img">
			<img src="http://a1.twimg.com/profile_images/582127009/Photo-on-2009-11-22-at-19.58-2-large_normal.jpg" />
		</div>
		<div class="info">
			<h1 title="Double-click to open person in a new tab">{{ticket.person.name}}</h1>
			{% if ticket.person.primary_email %}
				{{ticket.person.primary_email.email}}
			{% endif %}
		</div>
	</div>

	<div class="ticket-attach overlay no-padd">
		<div class="ticket-attach-widget"></div>
		<div class="buttons">
			<button class="save dp-button small overlay-close-trigger">Done</button>
		</div>
	</div>

	{% include 'AgentBundle:Ticket:part-ticket-menus.twig' %}
</div><!-- content -->

{% include 'AgentBundle:Ticket:part-ticket-bar.twig' %}