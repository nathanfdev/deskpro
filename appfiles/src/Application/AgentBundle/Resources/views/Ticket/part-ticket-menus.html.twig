{% include 'AgentBundle:Ticket:part-flag-menu.html.twig' %}
<ul class="ticket-info-edit-menu" style="display:none">
	<li data-option-id="delete"><span class="icon icon-page-delete">Delete Ticket</span></li>
	<li data-option-id="delete-block"><span class="icon icon-page-delete">Delete Ticket and Block User</span></li>
	<li data-option-id="spam"><span class="icon icon-page-delete">Mark as Spam</span></li>
	<li class="sep">-</li>
	<li data-option-id="print"><span class="icon print-ticket">Print Ticket</span></li>
	<li data-option-id="split"><span class="icon icon-page-split">Split Ticket</span></li>
	<li><span class="icon change-ticket-owner">Change User Owner</span></li>
</ul>
<ul class="ticket-message-edit-menu" style="display:none">
	<li data-option-id="view-details"><span class="icon view-unformatted">Detail</span></li>
	<li data-option-id="quote"><span class="icon icon-edit">Quote</span></li>
	<li data-option-id="print"><span class="icon icon-edit">Print single message</span></li>
	<li data-option-id="edit"><span class="icon icon-edit">Edit</span></li>
	<li data-option-id="split"><span class="icon icon-edit">Split ticket from here</span></li>
</ul>
<ul class="ticket-macros-menu" style="display:none" {% if baseId %}id="{{baseId}}_macros_menu"{% endif %}>
	{% for macro in macros %}
		<li data-macro-id="{{macro.id}}">{{macro.title}}</li>
	{% endfor %}
	{% if macros|length %}
		<li class="sep">-</li>
		<li data-no-macro="1">Edit macros</li>
	{% else %}
		<li data-no-macro="1">Create a macro</li>
	{% endif %}
</ul>

<ul class="ticket-actions-menu" style="display:none">
	<li data-op="delete">Delete ticket</li>
</ul>
<div class="delete-ticket-overlay overlay" style="display:none">
	<div class="overlay-title">
		<h4>Display Options</h4>
	</div>

	<div class="overlay-content">
		Reason for deleting: <input type="text" value="" class="delete-reason" style="width: 200px;" />
	</div>

	<div class="overlay-actions">
		<div class="loading-off">
			<button class="save-trigger dp-button small">Delete</button>
		</div>
		<div class="loading-on" style="display:none">
			<span>Deleting ...</span>
		</div>
	</div>
</div>
