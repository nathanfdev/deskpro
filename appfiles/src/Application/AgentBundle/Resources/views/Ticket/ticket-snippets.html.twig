<div class="ticket-snippets-overlay snippets-overlay" {% if ticket %}data-ticket-id="{{ ticket.id }}"{% endif %}>
	<nav>
		<ul>
			{% for category in ticket_snippet_cats %}
				{% include 'AgentBundle:Ticket:ticket-snippets-catrow.html.twig' %}
			{% endfor %}
			<li class="new-category tipped" title="Add new category">new category</li>
		</ul>
	</nav>
	<div class="snippet-sections">
	{% for category in ticket_snippet_cats %}
		{% set group = ticket_snippets[category.id] %}
		{% include 'AgentBundle:Ticket:ticket-snippets-catsection.html.twig' with {'category': category, 'snippets': group.snippets} %}
	{% endfor %}
	</div>

	<div class="new-snippet-category field-overlay" style="display: none">
		<dl>
			<dt>Title:</dt>
			<dd><input type="text" name="title" value="New Category" /></dd>

			<dt>Permissions:</dt>
			<dd>
				<label><input type="radio" class="perm-type-opt" name="perm_type" value="me" checked="checked" /> Just me</label><br />
				<label><input type="radio" class="perm-type-opt" name="perm_type" value="team" /> My Team</label><br />
				<label><input type="radio" class="perm-type-opt" name="perm_type" value="global" /> Everyone</label><br />
			</dd>

			<dt class="perm-teams" style="display: none">Teams:</dt>
			<dd class="perm-teams" style="display: none">
				<select name="teams[]" multiple="multiple" size="6">
					{% for team in agent_teams %}
						<option value="{{ team.id }}">{{ team.name }}</option>
					{% endfor %}
				</select>
			</dd>
		</dl>

		<div class="controls">
			<button class="dp-button xx-small new-cat-trigger">Add</button>
		</div>
	</div>
</div>