 <script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.NewTicket';
pageMeta.title = 'New Ticket';
pageMeta.ticket_id = 0;

pageMeta.labelsAutocompleteUrl        = '{{ path('agent_ajax_labels_autocomplete', {'label_type': 'ticket'}) }}';
pageMeta.uploadAttachUrl              = '{{ path('agent_accept_upload') }}';

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
{# scroll containers #}
<div class="layout-content with-scrollbar page-new-ticket page-new-content">
<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
<div class="scroll-viewport"><div class="scroll-content">
{# /scroll containers #}

<form id="{{baseId}}_newticket">

<input type="hidden" name="for_comment_type" id="{{baseId}}_for_comment_type" value="" />
<input type="hidden" name="for_comment_id" id="{{baseId}}_for_comment_id" value="" />

<div class="pending-info" style="display: none;">
	<h3>Creating ticket for comment</h3>
	<div class="pending-ticket">
		 Commented on <a data-route="" class="with-route ticket-link" id="{{baseId}}_comment_object_link"></a><br />
		 <select name="comment_action" id="{{baseId}}_comment_action">
		 	<option value="delete">Delete</option>
		 	<option value="approve">Validate</option>
		 </select> comment after ticket is created
	</div>
</div>

<div class="section user-section first" id="{{baseId}}_user_section">
	<div class="step">
		<span class="num">1</span>
		<span class="check">Done</span>
	</div>
	<div class="content">
		<button class="clean-white small switch-user" id="{{baseId}}_switch_user" style="display: none">Change User</button>
		<div id="{{baseId}}_choose_user">
			<div
				id="{{baseId}}_user_searchbox"
				data-element-handler="DeskPRO.Agent.ElementHandler.PersonSearchBox"
				data-search-url="{{ path('agent_peoplesearch_performquick', {'format': 'json', 'limit': 10, 'start_with': 'a'}) }}"
				data-highlight-term="1"
				data-touch-focus="1"
				data-search-param="term"
				data-position-bound="#{{baseId}}_userselect"
			>
				<input type="text" id="{{baseId}}_userselect" class="select-user term" placeholder="Choose a person to create this ticket for" />
				<input type="hidden" name="newticket[person][id]" value="{{ person.id }}" class="person-id" id="{{baseId}}_person_id" />

				<script type="text/x-deskpro-tmpl" class="user-row-tpl">
					<li>
						<a>
						<span class="user-name"></span>
						<address>&lt;<span class="user-email"></span>&gt;</address>
						<div class="bound-fade"></div>
					</a></li>
				</script>
				<div class="person-search-box" style="display: none">
					<section>
						<ul class="results-list">

						</ul>
						<footer>
							<span class="create-user">Create a new person</span>
						</footer>
					</section>
				</div>
			</div>
		</div>
		<div id="{{baseId}}_user_choice">

		</div>
		<br class="clear" />
	</div>
</div>

<div class="section department-section" id="{{baseId}}_dep_section">
	<div class="step">
		<span class="num">2</span>
		<span class="check">Done</span>
	</div>
	<div class="content">
		<div class="col">
			<h4>Department</h4>
			{% include 'AgentBundle:Common:select-department.html.twig' with {
				'name': "newticket[department_id]",
				'id': baseId ~ '_dep',
				'departments': ticket_options.departments_hierarchy
			} %}
		</div>
		<div class="col">
			<h4>Status</h4>
			<select name="newticket[status]" id="{{baseId}}_status">
				<option value="awaiting_agent" selected="selected">Awaiting agent</option>
				<option value="pending">Awaiting user</option>
				<option value="resolved">Resolved</option>
			</select>
		</div>
		<div class="col">
			<h4>Assignment</h4>
			<input type="hidden" name="newticket[agent_id]" value="0" id="{{baseId}}_agent_id" />
			<input type="hidden" name="newticket[agent_team_id]" value="0" id="{{baseId}}_agent_team_id" />
			<span id="{{baseId}}_assign_btn" class="agent-prop-links">
				<span id="{{baseId}}_agent_label">Me</span> and
				<span id="{{baseId}}_agent_team_label">No Team</span>
			</span>
		</div>
		<br class="clear" />
	</div>
</div>

<div class="section subject-section" id="{{baseId}}_subject_section">
	<div class="step">
		<span class="num">3</span>
		<span class="check">Done</span>
	</div>
	<div class="content">
		<h4>Subject</h4>
		<input type="text" name="newticket[subject]" class="subject" id="{{baseId}}_subject" value="" />
	</div>
</div>

<div class="section message-section" id="{{baseId}}_message_section">
	<div class="step">
		<span class="num">4</span>
		<span class="check">Done</span>
	</div>
	<div class="content">
		<h4>Message</h4>
		<div class="type-wrap">
			<div style="float: right">
				<button id="{{baseId}}_text_snippets_btn" class="clean-white">Text Snippets</button>
			</div>
			Template: <select name="ticket[notify_template]">
				<option value="ticket">Ticket</option>
				<option value="blank">Blank</option>
			</select>
		</div>
		<textarea name="newticket[message]" class="ticket-message" id="{{baseId}}_message"></textarea>
	</div>
</div>

<div class="section other-section" id="{{baseId}}_other_section">
	<div class="step">
		<span class="num">5</span>
		<span class="check">Done</span>
	</div>
	<div class="content">
		{# Tab Container #}
		<div class="tab-container">
			<nav id="{{baseId}}_other_props_tabs_wrap">
				<ul id="{{baseId}}_other_props_tabs">
					<li data-tab-for="> .tab-properties">Properties</li>
					<li data-tab-for="> .tab-cc">CC's</li>
					<li data-tab-for="> .tab-attach">Attachments</li>
				</ul>
			</nav>
			<div class="content-wrapper" id="{{baseId}}_other_props_tabs_content" style="display: none">
				{# Tab Properties #}
				<div class="tab-properties" style="display: none">
					<dl>
						<dt class="prop">Category</dt>
						<dd class="prop">
							{% include 'AgentBundle:Common:select-category.html.twig' with {
								'name': "newticket[category_id]",
								'id': baseId ~ '_cat',
								'categories': ticket_options.ticket_categories_hierarchy,
								'with_blank': true
							} %}
						</dd>

						<dt class="prop">Priority</dt>
						<dd class="prop">
							{% include 'AgentBundle:Common:select-priority.html.twig' with {
								'name': "newticket[priority_id]",
								'id': baseId ~ '_pri',
								'priorities': ticket_options.ticket_priorities,
								'with_blank': true
							} %}
						</dd>

						<dt class="prop">Workflow</dt>
						<dd class="prop">
							{% include 'AgentBundle:Common:select-workflow.html.twig' with {
								'name': "newticket[workflow_id]",
								'id': baseId ~ '_work',
								'workflows': ticket_options.ticket_workflows,
								'with_blank': true
							} %}
						</dd>

						<dt class="prop">Product</dt>
						<dd class="prop">
							{% include 'AgentBundle:Common:select-product.html.twig' with {
								'name': "newticket[product_id]",
								'id': baseId ~ '_work',
								'products': ticket_options.products_hierarchy,
								'with_blank': true
							} %}
						</dd>
					</dl>
				</div>
				{# /Tab Properties #}

				{# Tab CC #}
				<div class="tab-cc" style="display: none">
					<div class="cc-input">
						<input
							type="text"
							placeholder="Enter an email address..."
							name="newticket[new_parts]"
							value=""
							class="new-cc" id="{{baseId}}_add_cc_txt"
						/>
					</div>
				</div>
				{# /Tab CC #}

				{# Tab Attach #}
				<div class="tab-attach" style="display: none">
					<script class="template-upload" type="text/x-jquery-tmpl">
						<li class="uploading">${name} <span class="cancel"><button class="clean-gray xx-small">Cancel</button></span></li>
					</script>
					<script class="template-download" type="text/x-jquery-tmpl">
						<li class="uploaded">
							<input type="checkbox" checked="checked" name="newticket[attach][]" value="${blob_id}" />
							<a href="${download_url}" target="_blank">${filename}</a>
							<span class="size">${filesize_readable}</span>
						</li>
					</script>
					<h6>Attachments</h6>
					<div class="file-input">
						<input type="file" name="file-upload" multiple="multiple" /> <button class="clean-gray xxx-small">Upload</button>
					</div>
					<ul class="files file-list"></ul>
				</div>
				{# /Tab Attach #}
			</div>
		</div>
		{# /Tab Container #}
	</div>
</div>

<div class="foot">
	<button class="submit-trigger clean-white">Create Ticket</button>
</div>

</form>

<div class="optionbox reply-agent-team-ob newticket" id="{{baseId}}_agent_selector">
	<div class="col">
		<section data-section-name="agents">
			<header>
				<h3>Agents</h3>
				<input type="text" class="filter-box" placeholder="Filter..." />
			</header>
			<ul>
				<li class="me last-me {% if ticket.agent.id == app.user.id or not ticket.agent %}on{% endif %}">
					<input type="radio" name="{{baseId}}_agent" value="{{ app.user.id }}" {% if ticket.agent.id == app.user.id or not ticket.agent %}checked="checked"{% endif %} />
					<label><span class="agent-pic agent-label-{{ app.user.id }}" style="background-image: url({{ app.user.getPictureUrl(16) }})">Me</span></label>
				</li>

				<li>
					<input type="radio" name="{{baseId}}_agent" value="0" />
					<label><span class="agent-pic agent-label-0">Unassigned</span></label>
				</li>

				{% for agent in agents %}
					{% if agent.id != app.user.id %}
						<li {% if ticket.agent.id == agent.id %}class="on"{% endif %}>
							<input type="radio" name="{{baseId}}_agent" value="{{ agent.id }}" {% if ticket.agent.id == agent.id %}checked="checked"{% endif %} />
							<label><span class="agent-pic agent-label-{{ agent.id }}" style="background-image: url({{ agent.getPictureUrl(16) }})">{{ agent.display_name }}</span></label>
							<div class="bound-fade"></div>
						</li>
					{% endif %}
				{% endfor %}
			</ul>
		</section>
	</div>
	<div class="col">
		<section data-section-name="teams">
			<header>
				<h3>Teams</h3>
				<input type="text" class="filter-box" placeholder="Filter..." />
			</header>
			<ul>
				{% for team in app.user.getAgent().getTeams() %}
					<li class="me {% if loop.last %}last-me{% endif %} {% if ticket.agent_team.id == team.id %}on{% endif %}">
						<input type="radio" name="{{baseId}}_agent_team" value="{{ team.id }}" {% if ticket.agent_team.id == team.id %}checked="checked"{% endif %} />
						<label class="agent-team-label-{{ team.id }}">{{ team.name }}</label>
						<div class="bound-fade"></div>
					</li>
				{% endfor %}

				<li class="{% if not ticket.agent_team %}on{% endif %}">
					<input type="radio" name="{{baseId}}_agent_team" value="0" {% if not ticket.agent_team %}checked="checked"{% endif %} />
					<label><span class="agent-team-label-0">No Team</span></label>
				</li>

				{% for team in agent_teams %}
					{% if team.id not in app.user.getAgent().getTeamIds() %}
						<li {% if ticket.agent_team.id == team.id %}class="on"{% endif %}>
							<input type="radio" name="{{baseId}}_agent_team" value="{{ team.id }}" {% if ticket.agent_team.id == team.id %}checked="checked"{% endif %} />
							<label class="agent-team-label-{{ team.id }}">{{ team.name }}</label>
							<div class="bound-fade"></div>
						</li>
					{% endif %}
				{% endfor %}
			</ul>
		</section>
	</div>
	<br class="clear" />
</div>

{# scroll containers #}
</div></div>
</div>
{# /scroll containers #}
