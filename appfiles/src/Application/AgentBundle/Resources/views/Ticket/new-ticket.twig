<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.NewTicket';
pageMeta.title = 'New Ticket';
pageMeta.ticket_id = 0;
pageMeta.pageIdentity = 'ticket:new';
pageMeta.userSearchUrl = '{{ path('agent_peoplesearch_performquick') }}?ajax=1';
</script>

<div class="ticket-content new-ticket">
	<div class="ticket">
	
	<input type="hidden" name="ticket[department_id]" value="{{ticket.department.id}}" />
	<input type="hidden" name="ticket[category_id]" value="{{ticket.category.id}}" />
	<input type="hidden" name="ticket[product_id]" value="{{ticket.product.id}}" />
	<input type="hidden" name="ticket[priority_id]" value="{{ticket.priority.id}}" />
	<input type="hidden" name="ticket[status]" value="{{ticket.status}}" />
	<input type="hidden" name="ticket[person_id]" value="{{ticket.person.id}}" />

	<div class="ticket-top">
		<span class="ticket-flag icon icon-flag-{{ticket_flagged_color}}" data-flag="{{ticket_flagged_color}}"></span>
		<h1>
			<span class="ticket-opt-btn ticket-options-department-btn department">
				<span class="val {% if not ticket.category %}no-value{% endif %}" data-no-value="Choose Department">{{ticket.department.title}}</span>
				&rsaquo;
			</span>
			<input type="text" class="input-title" name="ticket[subject]" value="{{ticket.subject}}" placeholder="Enter ticket title" />
		</h1>

		{% include 'AgentBundle:Ticket:part-ticket-info.twig' %}

		<br style="clear:both" />
	
		<div class="person-info-line">

			<div class="ticket-opt-btn ticket-options-agent-btn agent" style="float:right">
				<strong>Agent:</strong><br />
				<span class="val {% if not ticket.agent %}no-value{% endif %}" data-no-value="Unassigned">{{ticket.agent.name}}</span>
			</div>
			
			<div class="person-select">
				<strong>User:</strong><br />
				<input type="text" class="person-name-search" style="width: 250px" placeholder="Begin typing a name or email address" />
			</div>
			
			<br style="clear:both" />
		</div>

		{% include 'AgentBundle:Ticket:part-custom-fields-edit.twig' %}

	</div>

	</div>

	{% include 'AgentBundle:Ticket:part-ticket-menus.twig' %}
</div><!-- content -->

{% include 'AgentBundle:Ticket:part-ticket-bar.twig' %}