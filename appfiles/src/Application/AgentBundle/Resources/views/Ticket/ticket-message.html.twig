<li data-message-id="{{message.id}}" class="message-{{message.id}} message-item {% if message.person.is_agent %}agent{% if message.is_agent_note %} is-note{% endif %}{%else%}person{%endif%}">
	<div class="box">
		<div class="info">
			<img class="person-picture" src="{{ path('serve_person_picture_size', {'person_id': message.person.id, 'size': 15}) }}" alt="" />
			<cite>
				{{message.person.name}}
			</cite>
			<span class="time">
				<span data-message-id="{{message.id}}" class="edit-btn ticket-message-edit-btn"></span>
				submitted online (from 76.167.170.198), {{message.date_created|date('Y-m-d')}}
			</span>
		</div>
		<div class="message">
			{{message.message_html|raw}}

			{% if message.attachments.count() %}
				<ul class="attachment-list">
					{% for ticket_attach in message.attachments %}
						<li class="{% if ticket_attach.blob.isImage() %}is-image{% else %}icon icon-attachment icon-filetype-{{ticket_attach.blob.extension|default('none')}}{% endif %}" rel="message-{{message.id}}">
							{% if ticket_attach.blob.isImage() %}
								<img src="{{ path('serve_blob', {'blob_auth_id': ticket_attach.blob.auth_id, 's': 50, 'size-fit': '1'}) }}" alt="" class="preview" />
							{% endif %}
							<a href="{{ ticket_attach.blob.download_url }}" target="_blank">{{ticket_attach.blob.filename}}</a>
							<span class="size">({{ ticket_attach.blob.readable_filesize }})</span>
						</li>
					{% endfor %}
				</ul>
			{%endif%}
		</div>
	</div>
</li>