{% if ticket_message_logs[message.id] %}
	{% for log_id in ticket_message_logs[message.id] %}
		{% set log = ticket_logs[log_id] %}
		{% include 'AgentBundle:Ticket:ticket-log-row.html.twig' %}
	{% endfor %}
{% endif %}

<div data-message-id="{{message.id}}" class="message message-{{message.id}} {% if message.is_agent_note %}note-message{% elseif message.person.is_agent %}admin-message{% else %}user-message{% endif %}">
	<div class="message-avatar left">
		<img src="{{ message.person.getPictureUrl(35) }}" alt="" width="35" height="35" {% if not message.person.is_agent %}class="person-overview" data-route="person:{{ path('agent_people_view', {'person_id': message.person.id}) }}"{% endif %} />
	</div>
	<div class="message-body">
		<div class="message-meta">
			<span class="arrow-left"></span>
			<h4
				{% if not message.person.is_agent %}
					class="person-overview" data-route="person:{{ path('agent_people_view', {'person_id': message.person.id}) }}"
				{% endif %}
			>{{message.person.name}}</h4>
			<span class="timestamp">
				submitted online (76.167.170.198),
				<span class="timeago" title="{{message.date_created|date('c')}}">{{message.date_created|date('Y-m-d')}}</span>
			</span>
			<span class="ticket-message-edit-btn count tipped" title="Click for tools" data-message-id="{{message.id}}">
				#{{ loop.index }}
			</span>
		</div>
		<div class="message-text">
			{{message.message_html|raw}}
			{% if ticket_message_attachments[message.id] %}
				<ul class="attachment-list">
					{% for attach_id in ticket_message_attachments[message.id] %}
						{% set ticket_attach = ticket_attachments[attach_id] %}
						<li class="{% if ticket_attach.blob.isImage() %}is-image{% else %}icon icon-attachment icon-filetype-{{ticket_attach.blob.extension|default('none')}}{% endif %}" rel="message-{{message.id}}">
							{% if ticket_attach.blob.isImage() %}
								<a href="{{ ticket_attach.blob.download_url }}" target="_blank"><img src="{{ path('serve_blob', {'blob_auth_id': ticket_attach.blob.auth_id, 's': 50, 'size-fit': '1'}) }}" alt="" class="preview" /></a>
							{% endif %}
							<a href="{{ ticket_attach.blob.download_url }}" target="_blank">{{ticket_attach.blob.filename}}</a>
							<span class="size">({{ ticket_attach.blob.readable_filesize }})</span>
						</li>
					{% endfor %}
				</ul>
			{%endif%}
		</div>
	</div>
</div>
