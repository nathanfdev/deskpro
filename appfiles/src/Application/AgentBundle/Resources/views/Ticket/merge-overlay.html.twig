<div class="ticket-merge overlay">
	<div class="overlay-title">
		<h4>{{ phrase('agent.merge_x_into', {'name': ticket.subject}) }}</h4>
	</div>

	<div class="overlay-content">
		{% if not open_tickets and not tickets_by_user %}
			<div class="group">
				<ul>
					<li>
						{{ phrase('agent.tickets.merge_none') }}
					</li>
				</ul>
			</div>
		{% endif %}

		{% if open_tickets %}
		<div class="group open-tickets">
			<h2>{{ phrase('agent.tickets.other_open_tickets') }}</h2>
			<ul>
				{% for ticket in open_tickets %}
					<li>
						<a data-route="ticket:{{ path('agent_ticket_view', {'ticket_id': ticket.id}) }}" class="with-route">{{ ticket.subject }}</a>
						<button class="clean-gray xx-small merge-trigger" data-ticket-id="{{ ticket.id }}">{{ phrase('agent.merge') }}</button>
					</li>
				{% endfor %}
			</ul>
		</div>
		{% endif %}

		{% if tickets_by_user %}
		<div class="group users-tickets">
			<h2>{{ phrase('agent.tickets.ticket_by_user') }}</h2>
			<ul>
				{% for ticket in tickets_by_user %}
					<li>
						<a data-route="ticket:{{ path('agent_ticket_view', {'ticket_id': ticket.id}) }}" class="with-route">{{ ticket.subject }}</a>
						<button class="clean-gray xx-small merge-trigger" data-ticket-id="{{ ticket.id }}">{{ phrase('agent.merge') }}</button>
					</li>
				{% endfor %}
			</ul>
		</div>
		{% endif %}
	</div>
</div>
