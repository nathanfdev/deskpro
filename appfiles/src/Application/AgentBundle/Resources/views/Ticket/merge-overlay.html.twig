<div class="ticket-merge overlay">
	<div class="overlay-title">
		<h4>Merge "{{ ticket.subject }}" into ...</h4>
	</div>

	<div class="overlay-content">
		{% if not open_tickets and not tickets_by_user %}
			<div class="group">
				<ul>
					<li>
						The user has no other tickets, and you don't have any other ticket tabs open. To merge
						this ticket into another one, try finding it and opening it in a tab first.
					</li>
				</ul>
			</div>
		{% endif %}

		{% if open_tickets %}
		<div class="group open-tickets">
			<h2>Currently open tickets</h2>
			<ul>
				{% for ticket in open_tickets %}
					<li>
						<a data-route="ticket:{{ path('agent_ticket_view', {'ticket_id': ticket.id}) }}" class="with-route">{{ ticket.subject }}</a>
						<button class="clean-gray xx-small merge-trigger" data-ticket-id="{{ ticket.id }}">Merge</button>
					</li>
				{% endfor %}
			</ul>
		</div>
		{% endif %}

		{% if tickets_by_user %}
		<div class="group users-tickets">
			<h2>Ticket by the same user</h2>
			<ul>
				{% for ticket in tickets_by_user %}
					<li>
						<a data-route="ticket:{{ path('agent_ticket_view', {'ticket_id': ticket.id}) }}" class="with-route">{{ ticket.subject }}</a>
						<button class="clean-gray xx-small merge-trigger" data-ticket-id="{{ ticket.id }}">Merge</button>
					</li>
				{% endfor %}
			</ul>
		</div>
		{% endif %}
	</div>
</div>