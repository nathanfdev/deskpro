{% set has_agent_parts = 0 %}
{% set has_user_parts = 0 %}
{% for part in participants %}
	{% if part.person.is_agent %}
		{% set has_agent_parts = 1 %}
	{% else %}
		{% set has_user_parts = 1 %}
	{% endif %}
{% endfor %}

{% if has_agent_parts %}
	<section class="cc-section cc-agent-parts">
		<strong>CC Agent Participants</strong>
		<div class="with-scrollbar">
			<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
			<div class="scroll-viewport"><div class="scroll-content">
			<ul>
				{% for part in participants %}{% if part.person.is_agent %}
					<li data-person-id="{{part.person.id}}" class="person-{{part.person.id}}">
						<div class="avatar">
							<img width="15" height="15" alt="" src="{{part.person.getPictureUrl(15)}}" />
						</div>
						<div class="name"><a>{{ part.person.display_name }}</a></div>
						<div class="choice">
							<input
								type="checkbox"
								class="person-choice-{{part.person.id}}"
								value="{{part.person.id}}"
								name="cc_person_ids[]"
								{% if part.default_on %}checked="checked"{% endif %}
							/>
						</div>
						<br style="clear: left; height: 1px; overflow: hidden;" />
					</li>
				{% endif%}{% endfor %}
			</ul>
			</div></div>
		</div>
	</section>
{% endif %}

{% if has_user_parts %}
	<section class="cc-section cc-user-parts">
		<strong>CC User Participants</strong>
		<div class="with-scrollbar">
			<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
			<div class="scroll-viewport"><div class="scroll-content">
			<ul>
				{% for part in participants %}{% if not part.person.is_agent %}
					<li data-person-id="{{part.person.id}}" class="person-{{part.person.id}}">
						<div class="avatar">
							<img width="15" height="15" alt="" src="{{part.person.getPictureUrl(15)}}" />
						</div>
						<div class="name"><a>{{ part.email_address }}</a></div>
						<div class="choice">
							<input
								type="checkbox"
								class="person-choice-{{part.person.id}}"
								value="{{part.person.id}}"
								name="cc_person_ids[]"
								{% if part.default_on %}checked="checked"{% endif %}
							/>
						</div>
						<br style="clear: left; height: 1px; overflow: hidden;" />
					</li>
				{% endif%}{% endfor %}
			</ul>
			</div></div>
		</div>
	</section>
{% endif %}

<section class="cc-section cc-new-parts">
	<strong>CC New Participants</strong>
	<div class="with-scrollbar">
		<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
		<div class="scroll-viewport"><div class="scroll-content">
		<ul>
			<li class="new-part">
				<input type="text" value="" /> <button class="dp-button x-small">Add</button>
			</li>
		</ul>
	</div>
</section>