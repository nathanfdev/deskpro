<div class="ticket-info">
	<dl class="menu-trigger category_id">
		<dt>Category</dt>
		<dd class="prop-val category_id {% if not ticket.category %}no-value{% endif %}" data-no-value-label="None">{{ticket.category.full_title|default('None')}}</dd>
	</dl>
	<dl class="menu-trigger product_id">
		<dt>Product</dt>
		<dd class="prop-val product_id {% if not ticket.category %}no-value{% endif %}" data-no-value-label="None">{{ticket.product.title|default('None')}}</dd>
	</dl>
	<dl class="menu-trigger priority_id">
		<dt>Priority</dt>
		<dd class="prop-val priority_id {% if not ticket.category %}no-value{% endif %}" data-no-value-label="None">{{ticket.priority.title|default('None')}}</dd>
	</dl>
	<dl class="menu-trigger workflow_id">
		<dt>Workflow</dt>
		<dd class="prop-val workflow_id {% if not ticket.workflow %}no-value{% endif %}" data-no-value-label="None">{{ticket.workflow.title|default('None')}}</dd>
	</dl>
	<dl class="menu-trigger status">
		<dt>Status</dt>
		<dd class="prop-val status">
			{# todo these will be phrases, so this big condition wont be needed #}
			{% if not ticket.status or ticket.status == 'open' %}
				Open
			{% elseif ticket.status == 'pending' %}
				Pending
			{% elseif ticket.status == 'resolved' %}
				Resolved
			{% endif %}
		</dd>
	</dl>
	<br style="clear:both" />
</div>