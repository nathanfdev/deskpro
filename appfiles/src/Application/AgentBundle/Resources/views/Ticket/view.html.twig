<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.Ticket';
pageMeta.title         = {{ticket.subject|json_encode|raw}};
pageMeta.ticket_id     = {{ticket.id}};
pageMeta.url_fragment  = '{{ url_fragment('agent_ticket_view', {'ticket_id': ticket.id}) }}';

pageMeta.labelsAutocompleteUrl        = '{{ path('agent_ajax_labels_autocomplete', {'label_type': 'tickets'}) }}';
pageMeta.labelsSaveUrl                = '{{ path('agent_ticket_ajax_labels_save', {'ticket_id': ticket.id}) }}';
pageMeta.getMacroUrl                  = '{{ path('agent_ticket_ajax_get_macro', {'ticket_id': ticket.id }) }}?macro_id=$macro_id';
pageMeta.saveActionsUrl               = '{{ path('agent_ticket_ajax_save_actions', {'ticket_id': ticket.id }) }}';
pageMeta.deleteTicketUrl              = '{{ path('agent_ticketsearch_ajax_delete_tickets') }}';
pageMeta.uploadAttachUrl              = '{{ path('agent_accept_upload') }}';
pageMeta.viewMessageUnformattedUrl    = '{{ path('agent_ticket_message_unformatted', {'ticket_id': ticket.id, 'message_id': '000'})|replace({'000': '{message_id}'}) }}';
pageMeta.getMessageQuoteUrl           = '{{ path('agent_ticket_message_ajax_getquote', {'ticket_id': ticket.id, 'message_id': '000'})|replace({'000': '{message_id}'}) }}';
pageMeta.tabTicketLogUrl              = '{{ path('agent_ticket_ajaxtab_ticketlog', {'ticket_id': ticket.id}) }}';
pageMeta.tabAttachmentsUrl            = '{{ path('agent_ticket_ajaxtab_attachments', {'ticket_id': ticket.id}) }}';
pageMeta.tabRelatedContentUrl         = '{{ path('agent_ticket_ajaxtab_releated_content', {'ticket_id': ticket.id}) }}';
pageMeta.getMessagesUrl               = '{{ path('agent_ticket_ajax_getmessages', {'ticket_id': ticket.id}) }}';
pageMeta.viewPersonUrl                = '{{ path('agent_people_view', {'person_id': ticket.person.id}) }}';
pageMeta.lastMessageId = {{ last_message_id|default(0) }};
pageMeta.lastLogId = {{ last_log_id|default(0) }};

{% if ticket.person.organization %}
	pageMeta.viewOrgUrl = '{{ path('agent_org_view', {'organization_id': ticket.person.organization.id}) }}';
{% endif %}
pageMeta.getUpdatedCountsUrl          = '{{ path('agent_ticket_ajaxgetupdatedcounts', {'ticket_id': ticket.id}) }}';

pageMeta.urls = {
	'snippetviewer': '{{ path('agent_ticket_snippetviewer', {'ticket_id': ticket.id}) }}'
};

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';

pageMeta.isDeleted = {% if ticket.hidden_status == 'deleted' %}true{% else %}false{% endif %};
pageMeta.isLocked = {% if ticket.is_locked == 'deleted' %}true{% else %}false{% endif %};
{% if agent_signature %}
pageMeta.agentSignature = {{ agent_signature|json_encode|raw }};
{% endif %}

</script>
<div class="layout-content with-scrollbar page-ticket {% if ticket.is_locked %}locked{% endif %}">
{% if ticket.is_locked %}
<div class="locked-bar" id="{{baseId}}_locked_bar">
	<button class="clean-gray xx-small dismiss">Dismiss</button>
	The ticket is in use by <cite>{{ ticket.locked_by_agent }}</cite>.
</div>
{% endif %}
<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
<div class="scroll-viewport"><div class="scroll-content">

{% if ticket.is_locked %}<div class="locked-overlay" id="{{baseId}}_locked_overlay"></div>{% endif %}

<div class="macro-controls" style="display: none;">
	<button class="clean-gray small save" id="macro_apply_btn">Apply Macro</button>
	<button class="clean-gray small cancel" id="macro_cancel_btn">Cancel</button>
</div>

<form class="value-form" style="display:none">
	<input type="hidden" name="agent_id" class="agent_id" value="{{ticket.agent.id|default(0)}}" />
	<input type="hidden" name="agent_team_id" class="agent_team_id" value="{{ticket.agent_team.id|default(0)}}" />
	<input type="hidden" name="department_id" class="department_id" value="{{ticket.department.id|default(0)}}" />
	<input type="hidden" name="category_id" class="category_id" value="{{ticket.category.id|default(0)}}" />
	<input type="hidden" name="product_id" class="product_id" value="{{ticket.product.id|default(0)}}" />
	<input type="hidden" name="priority_id" class="priority_id" value="{{ticket.priority.id|default(0)}}" />
	<input type="hidden" name="workflow_id" class="workflow_id" value="{{ticket.workflow.id|default(0)}}" />
	<input type="hidden" name="status" class="status" value="{{ticket.status}}" />
	<input type="hidden" name="hidden_status" class="hidden_status" value="{{ticket.hidden_status}}" />
</form>

{% if ticket.status == 'hidden' %}
	<div class="ticket-hidden-bar">
		{% if ticket.hidden_status == 'deleted' %}
			This ticket was deleted by {{ ticket_deleted.by_person.display_name }} on {{ ticket_deleted.date_created|date('Y-m-d') }}.
			{% if ticket_deleted.reason %}
				<br />Reason: {{ ticket_deleted.reason }}
			{% endif %}

			<br />
			<div style="padding: 5px">
				<button class="dp-button x-small undelete-trigger">Undelete Ticket</button>
			</div>
			{% if hard_delete_time %}
				This ticket will be permanantly purged from the system in {{hard_delete_time}}
			{% endif %}
		{% else %}
			This ticket is currently hidden because: <span>{{ phrase('core_tickets.hidden_status_' ~ ticket.hidden_status) }}</span><br />
			This means it won't show up in most search results and it will not generate agent notifications.
		{% endif %}
	</div>
{% endif %}

<section class="ticket-header" id="{{baseId}}_ticket_header">
	<div class="ticket-id">
		<span>#{{ ticket.id }}</span>
	</div>
	<div class="the-status">
		<div class="ticket-status prop-status-icon tipped" title="{{ ticket.status }}">
			<span class="ticket-{{ticket.status}}"></span>
		</div>
	</div>

	<div class="the-department">
		<div class="ticket-department prop-department-id">
			<div class="parent">
				{% if ticket.department.parent %}
					{{ ticket.department.parent.title }}
				{% else %}
					{{ ticket.department.title }}
				{% endif %}
			</div>
			<div class="sub">
				{% if ticket.department.parent %}
					{{ ticket.department.title }}
				{% endif %}
			</div>
		</div>
	</div>
	<div class="ticket-subject">
		{{ ticket.subject }}
	</div>
	<div class="ticket-urgency tipped" title="Urgency: 8<br />&middot; User waiting for response for 1 hour (+1)<br />&middot; Users first ticket (+1)<br />&middot; Priority high (+6)">
		<span>Urgency: 8</span>
	</div>
	<br style="clear:both;height: 1px;overflow: hidden;" />

	<div class="assignments">
		<div class="user">
			<div class="desc">
				Ticket owned by
					<a
						class="user-link person-overview"
						style="background-image: url('{{ ticket.person.getPictureUrl(20) }}');"
						data-route="person:{{ path('agent_people_view', {'person_id': ticket.person_id}) }}"
					>
						{{ ticket.person.display_name }}
						&lt;{{ ticket.person_email_address }}&gt;
					</a>
					{% if ticket.person.organization %}
						from <a
							style="background-image: url('{{ asset('images/icons/color_swatch.png') }}');"
							class="org-link org-overview"
							data-route="page:{{ path('agent_org_view', {'organization_id': ticket.person.organization.id}) }}"
						>{{ ticket.person.organization.name }}</a>
						{% if ticket.person.organization_position %}<span class="org-pos">({{ ticket.person.organization_position }})</span>{% endif %}
					{% endif %}
			</div>
			<div class="more user-participants-edit">
				<span class="user-part-count">{{ ticket.user_participants|length }}</span> users CC'ed
			</div>
			<br style="clear:both;height: 1px;overflow: hidden;" />
		</div>
		<div class="agent">
			<div class="desc">
				Ticket assigned to <a class="agent-link prop-agent-id" style="background-image: url('{{ ticket.agent.getPictureUrl(20) }}');">{{ ticket.agent.display_name }}</a>
				and team <a class="team-link prop-agent-team-id" style="background-image: url('{{ asset('images/icons/color_swatch.png') }}');">{{ ticket.agent_team.name }}</a>
			</div>
			<div class="more agent-participants-edit">
				<span class="agent-part-count">{{ ticket.agent_participants|length }}</span> agents subscribed
			</div>
			<br style="clear:both;height: 1px;overflow: hidden;" />
		</div>
		<div class="agents-list" style="display: none;">
			<ul id="{{baseId}}_agent_part_list">
				{% include 'AgentBundle:Ticket:view-participants-agents.html.twig' with {'participants': participants} %}
			</ul>
		</div>
		<div class="user-list" style="display: none;">
			<ul id="{{baseId}}_user_part_list">
				{% include 'AgentBundle:Ticket:view-participants-users.html.twig' with {'participants': participants} %}
			</ul>
		</div>
	</div>

	<nav class="actions" id="{{baseId}}_action_buttons">
		<ul>
			<li class="assign-me" {% if ticket.agent.id != app.user.id %}style="display: none"{% endif %}><button class="clean-gray xx-small">Assign To Me</button></li>
			<li class="assign-none" {% if ticket.agent.id == app.user.id %}style="display: none"{% endif %}><button class="clean-gray xx-small">Unassign</button></li>

			<li class="assign-to"><button class="clean-gray xx-small">Assign To</button></li>
			<li class="assign-to-team"><button class="clean-gray xx-small">Assign To Team</button></li>

			<li {% if not (ticket.status == 'open' or ticket.status == 'pending') %}style="display:none"{% endif %} class="set-resolved"><button class="clean-gray xx-small">Set Resolved</button></li>
			<li {% if not (ticket.status == 'open' or ticket.status == 'pending') %}style="display:none"{% endif %} class="set-closed"><button class="clean-gray xx-small">Close</button></li>
			<li {% if not (ticket.status == 'open' or ticket.status == 'pending') %}style="display:none"{% endif %} class="mark-spam"><button class="clean-gray xx-small">Mark As Spam</button></li>

			<li {% if not (ticket.status == 'resolved' or ticket.status == 'pending') %}style="display:none"{% endif %} class="set-open"><button class="clean-gray xx-small">Set Awaiting Agent</button></li>

			<li class="macros"><button class="clean-gray xx-small">Macros</button></li>
			<li class="more"><button class="clean-gray xx-small">More</button></li>
		</ul>
	</nav>

	<ul id="{{baseId}}_more_actions_menu" style="display: none;">
		<li class="merge-trigger">Merge Ticket</li>
		<li class="delete-trigger">Delete Ticket</li>
		<li class="change-user-trigger">Change User Owner</li>
	</ul>

	<div class="times">
		Ticket created <time>2 hours ago</time> by <span class="person-overview" data-route="person:{{ path('agent_people_view', {'person_id': ticket.person_id}) }}">{{ ticket.person.display_name }}</span> at <time>{{ticket.date_created|date('H:ia M j Y')}}</time>.<br/>
		User has been waiting <time>23 minutes</time> for a reply, and a total of <time>8 hours</time> since the ticket started.
	</div>
</section>

{# Main Tabs #}
<div class="full-container-tabbed main-tabs">
	{# Tab Triggers #}
	<div class="full-container-tabbed-tabs">
		<ul class="field-section-bodytabs-tabs" id="{{baseId}}_ticket_tabs">
			<li class="tab-trigger tab-details on" data-tab-for=".tab-details"><a>Ticket Details</a></li>
			<li class="tab-trigger tab-attachments" data-tab-for=".tab-attach"><a>Attachments</a></li>
		</ul>
	</div>

	<div class="full-container-tabbed-contents-wrap field-section-bodytabs-tab-contents">
		{# Tab: Details #}
		<div class="full-container-tabbed-contents tab-content tab-details">
			<div class="table-content">
				<div class="row-table-cotent">
					<div class="col-table-content title-col">
						<span>Labels</span>
					</div>
					<div class="col-table-content">
						<div class="tags-wrap">
							<span class="tag-icon"></span>
							<ul>
								{% for label in ticket.labels %}
									<li><span>{{label.label}}</span></li>
								{% endfor %}
							</ul>
						</div>
					</div>
				</div>
			</div>
			<div class="row-table-cotent" id="{{baseId}}_fields_display_main_wrap">
				<div class="col-table-content title-col">
					<span class="properties-edit-trigger edit-fields-trigger">
						Properties
					</span>
				</div>
				<div class="col-table-content">
					<div class="extra-info fields-show">
						<ul id="{{baseId}}_fields_display_main">
						</ul>
					</div>
					<div class="fields-edit" style="display: none;"></div>
				</div>
			</div>
		</div>
		{# /Tab: Details #}

		{# Tab: Attachments #}
		<div class="full-container-tabbed-contents tab-content tab-attach">
			{% include 'AgentBundle:Ticket:tab-attachments.html.twig' with {'message': message} %}
		</div>
		{# /Tab: Attachments #}
	</div>
</div>
{# /Top Tabs #}

{# Tab: Messages #}
<div class="full-tab-content messages-wrap">
	<div class="message-controls">
		<button class="clean-gray x-small goto-reply">Jump To Reply</button>
		<ul>
			<li><label><input type="checkbox" class="show-messages" checked="checked" />Show messages</label></li>
			<li><label><input type="checkbox" class="show-notes" checked="checked" />Show notes</label></li>
			<li><label><input type="checkbox" class="show-logs" />Show logs</label></li>
		</ul>
	</div>
	<div class="messages-wrap" id="{{baseId}}_messages_wrap">
		{{ ticket_messages_block|raw }}
	</div>
</div>
{# /Tab Messages #}

{# Wrapper around fields in the properties box #}
<script type="text/x-deskpro-plain" id="{{baseId}}_fields_display_main_wrap_tpl">
	<li class="display-item">
		<div class="prop-title display-title"></div>
		<div class="prop-val display-content"></div>
	</li>
</script>
<script type="text/x-deskpro-plain" id="{{baseId}}_fields_display_main_edit_tpl">
	<div class="fields-edit-container">
		<table>
			<tbody class="fields-edit-rows">

			</tbody>
			<tfoot>
				<tr>
					<td colspan="2">
						<div class="controls">
							<button class="clean-gray xx-small save-trigger">Save</button>
							<button class="clean-gray xx-small close-trigger">Cancel</button>
						</div>
						<div class="saving">
							Saving, please wait...
						</div>
					</td>
				</tr>
			</tfoot>
		</table>
	</div>
</script>
<script type="text/x-deskpro-plain" id="{{baseId}}_fields_display_main_edit_row_tpl">
	<tr>
		<td class="display-title"></td>
		<td class="display-content"></td>
	</tr>
</script>

{# New tab code for bottom tabs (for addition to tabstrip) #}
<script type="text/x-deskpro-plain" class="tpl-fields-maintabs-tab" id="{{baseId}}_fields_display_tabs_tab_tpl">
	<li class="tab-trigger {id} field-tab" data-tab-for=".{id}" data-field-tab-id="{id}">
		<a>{title}</a>
	</li>
</script>
<script type="text/x-deskpro-plain" class="tpl-fields-maintabs-content" id="{{baseId}}_fields_display_tabs_content_tpl">
	<div class="full-container-tabbed-contents tab-content field-tab-content {id}">
	</div>
</script>
<script type="text/x-deskpro-plain" id="{{baseId}}_fields_display_tabs_wrap_tpl">
	<div class="row-table-cotent display-item">
		<div class="col-table-content title-col display-title">
		</div>
		<div class="col-table-content display-content">
		</div>
	</div>
</script>

{% if ticket.hidden_status != 'deleted' %}
	{% include 'AgentBundle:Ticket:replybox.html.twig' %}
{% endif %}

{% include 'AgentBundle:Ticket:view-page-display-holders.html.twig' %}

{% include 'AgentBundle:Ticket:part-ticket-menus.html.twig' %}

<div class="macro-controls" style="display: none;">
	<button class="clean-gray small save" id="macro_apply_btn">Apply Macro</button>
	<button class="clean-gray small cancel" id="macro_cancel_btn">Cancel</button>
</div>

</div></div> {# /scroll #}
</div>{# /layout #}