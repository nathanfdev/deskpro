<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.Ticket';
pageMeta.title         = {{ticket.subject|json_encode|raw}};
pageMeta.ticket_id     = {{ticket.id}};
pageMeta.url_fragment  = '{{ url_fragment('agent_ticket_view', {'ticket_id': ticket.id}) }}';

pageMeta.labelsAutocompleteUrl        = '{{ path('agent_ajax_labels_autocomplete', {'label_type': 'tickets'}) }}';
pageMeta.labelsSaveUrl                = '{{ path('agent_ticket_ajax_labels_save', {'ticket_id': ticket.id}) }}';
pageMeta.getMacroUrl                  = '{{ path('agent_ticket_ajax_get_macro', {'ticket_id': ticket.id }) }}?macro_id=$macro_id';
pageMeta.saveActionsUrl               = '{{ path('agent_ticket_ajax_save_actions', {'ticket_id': ticket.id }) }}';
pageMeta.deleteTicketUrl              = '{{ path('agent_ticketsearch_ajax_delete_tickets') }}';
pageMeta.uploadAttachUrl              = '{{ path('agent_accept_upload') }}';
pageMeta.viewMessageUnformattedUrl    = '{{ path('agent_ticket_message_unformatted', {'ticket_id': ticket.id, 'message_id': '000'})|replace({'000': '{message_id}'}) }}';
pageMeta.getMessageQuoteUrl           = '{{ path('agent_ticket_message_ajax_getquote', {'ticket_id': ticket.id, 'message_id': '000'})|replace({'000': '{message_id}'}) }}';
pageMeta.tabTicketLogUrl              = '{{ path('agent_ticket_ajaxtab_ticketlog', {'ticket_id': ticket.id}) }}';
pageMeta.tabAttachmentsUrl            = '{{ path('agent_ticket_ajaxtab_attachments', {'ticket_id': ticket.id}) }}';
pageMeta.tabRelatedContentUrl         = '{{ path('agent_ticket_ajaxtab_releated_content', {'ticket_id': ticket.id}) }}';
pageMeta.getMessagesUrl               = '{{ path('agent_ticket_ajax_getmessages', {'ticket_id': ticket.id}) }}';
pageMeta.viewPersonUrl                = '{{ path('agent_people_view', {'person_id': ticket.person.id}) }}';
pageMeta.getUpdatedCountsUrl          = '{{ path('agent_ticket_ajaxgetupdatedcounts', {'ticket_id': ticket.id}) }}';

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';

pageMeta.isDeleted = {% if ticket.hidden_status == 'deleted' %}true{% else %}false{% endif %};
{% if agent_signature %}
pageMeta.agentSignature = {{ agent_signature|json_encode|raw }};
{% endif %}

</script>
<div class="layout-content with-scrollbar page-ticket">
<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
<div class="scroll-viewport"><div class="scroll-content">

<form class="value-form" style="display:none">
	<input type="hidden" name="agent_id" class="agent_id" value="{{ticket.agent.id|default(0)}}" />
	<input type="hidden" name="agent_team_id" class="agent_team_id" value="{{ticket.agent_team.id|default(0)}}" />
	<input type="hidden" name="department_id" class="department_id" value="{{ticket.department.id|default(0)}}" />
	<input type="hidden" name="category_id" class="category_id" value="{{ticket.category.id|default(0)}}" />
	<input type="hidden" name="product_id" class="product_id" value="{{ticket.product.id|default(0)}}" />
	<input type="hidden" name="priority_id" class="priority_id" value="{{ticket.priority.id|default(0)}}" />
	<input type="hidden" name="workflow_id" class="workflow_id" value="{{ticket.workflow.id|default(0)}}" />
	<input type="hidden" name="status" class="status" value="{{ticket.status}}" />
	<input type="hidden" name="hidden_status" class="hidden_status" value="{{ticket.hidden_status}}" />
</form>

{% if ticket.is_locked %}
	<div class="ticket-lock-bar">
		This ticket is currently in use by {{ ticket.locked_by_agent.display_name }}. You may want to avoid
		making changes until they are finished with it.
	</div>
{% endif %}

{% if ticket.status == 'hidden' %}
	<div class="ticket-hidden-bar">
		{% if ticket.hidden_status == 'deleted' %}
			This ticket was deleted by {{ ticket_deleted.by_person.display_name }} on {{ ticket_deleted.date_created|date('Y-m-d') }}.
			{% if ticket_deleted.reason %}
				<br />Reason: {{ ticket_deleted.reason }}
			{% endif %}

			<br />
			<div style="padding: 5px">
				<button class="dp-button x-small undelete-trigger">Undelete Ticket</button>
			</div>
			{% if hard_delete_time %}
				This ticket will be permanantly purged from the system in {{hard_delete_time}}
			{% endif %}
		{% else %}
			This ticket is currently hidden because: <span>{{ phrase('core_tickets.hidden_status_' ~ ticket.hidden_status) }}</span><br />
			This means it won't show up in most search results and it will not generate agent notifications.
		{% endif %}
	</div>
{% endif %}

<section class="ticket-header">
	<div class="ticket-id">
		<span>#{{ ticket.id }}</span>
	</div>
	<div class="the-status">
		<div class="ticket-status ticket-{{ticket.status}}">
			<span class="ticket-{{ticket.status}} prop-val menu-trigger status"></span>
		</div>
	</div>

	<div class="the-department">
		<div class="ticket-department">
			{% if ticket.department.parent %}
				<div class="ticket-source prop-val menu-trigger department_id saving" data-no-value="Choose Department">
					{{ ticket.department.parent.title|default('Choose Department') }}
				</div>
				<div class="sub-department">
					{{ ticket.department.title }}
				</div>
			{% else %}
				<div class="ticket-source prop-val menu-trigger department_id saving" data-no-value="Choose Department">
					{{ ticket.department.title|default('Choose Department') }}
				</div>
			{% endif %}
		</div>
	</div>
	<div class="ticket-subject">
		{{ ticket.subject }}
	</div>
	<div class="ticket-urgency tipped" title="Urgency: 8<br />&middot; User waiting for response for 1 hour (+1)<br />&middot; Users first ticket (+1)<br />&middot; Priority high (+6)">
		<span>Urgency: 8</span>
	</div>
	<br style="clear:both;height: 1px;overflow: hidden;" />

	<div class="assignments">
		<div class="user">
			<div class="desc">
				Ticket owned by <a class="user-link person-overview" style="background-image: url('{{ ticket.person.getPictureUrl(20) }}');" data-route="person:{{ path('agent_people_view', {'person_id': ticket.person_id}) }}">{{ ticket.person.display_name }} &lt;{{ ticket.person.primary_email_address }}&gt;</a>
			</div>
			<div class="more">
				3 users CC'ed
			</div>
			<br style="clear:both;height: 1px;overflow: hidden;" />
		</div>
		<div class="agent">
			<div class="desc">
				Ticket assigned to <a class="agent-link" style="background-image: url('{{ ticket.agent.getPictureUrl(20) }}');">{{ ticket.agent.display_name }}</a>
				and team <a class="team-link" style="background-image: url('{{ asset('images/icons/color_swatch.png') }}');">{{ ticket.agent_team.name }}</a>
			</div>
			<div class="more">
				6 agents subscribed
			</div>
			<br style="clear:both;height: 1px;overflow: hidden;" />
		</div>
	</div>

	<nav class="actions">
		<ul>
			<li class="assign-me"><button class="clean-gray xx-small">Assign To Me</button></li>
			<li class="assign-to"><button class="clean-gray xx-small">Assign To</button></li>
			<li class="assign-to-team"><button class="clean-gray xx-small">Assign To Team</button></li>
			<li class="set-resolved"><button class="clean-gray xx-small">Set Resolved</button></li>
			<li class="close"><button class="clean-gray xx-small">Close</button></li>
			<li class="mark-spam"><button class="clean-gray xx-small">Mark As Spam</button></li>
			<li class="more"><button class="clean-gray xx-small">More</button></li>
		</ul>
	</nav>

	<div class="times">
		Ticket created <time>2 hours ago</time> by <span class="person-overview" data-route="person:{{ path('agent_people_view', {'person_id': ticket.person_id}) }}">{{ ticket.person.display_name }}</span> at <time>{{ticket.date_created|date('H:ia M j Y')}}</time>.<br/>
		User has been waiting <time>23 minutes</time> for a reply, and a total of <time>8 hours</time> since the ticket started.
	</div>
</section>

{# Main Tabs #}
<div class="full-container-tabbed main-tabs">
	{# Tab Triggers #}
	<div class="full-container-tabbed-tabs">
		<ul class="field-section-bodytabs-tabs">
			<li class="tab-trigger tab-details on" data-tab-for=".tab-details"><a>Ticket Details</a></li>
			<li class="tab-trigger tab-attachments" data-tab-for=".tab-attach"><a>Attachments</a></li>
		</ul>
	</div>

	<div class="full-container-tabbed-contents-wrap field-section-bodytabs-tab-contents">
		{# Tab: Details #}
		<div class="full-container-tabbed-contents tab-content tab-details">
			<div class="table-content">
				<div class="row-table-cotent">
					<div class="col-table-content title-col">
						<span>Labels</span>
					</div>
					<div class="col-table-content">
						<div class="ticket-tags">
							<span class="tag-icon"></span>
							<ul>
								{% for label in ticket.labels %}
									<li><span>{{label.label}}</span></li>
								{% endfor %}
							</ul>
						</div>
					</div>
				</div>
			</div>
			<div class="row-table-cotent">
				<div class="col-table-content title-col">
					<span>Properties</span>
				</div>
				<div class="col-table-content">
					<div class="extra-info">
						<ul>
							<li>
								<span class="prop-title">Category:</span>
								<span class="prop-val">{{ ticket.category.title|default('None') }}</span>
							</li>
							<li>
								<span class="prop-title">Product:</span>
								<span class="prop-val">{{ ticket.product.title|default('None') }}</span>
							</li>
							<li>
								<span class="prop-title">Priority:</span>
								<span class="prop-val">{{ ticket.priority.title|default('None') }}</span>
							</li>
							<li>
								<span class="prop-title">Workflow:</span>
								<span class="prop-val">{{ ticket.workflow.title|default('None') }}</span>
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
		{# /Tab: Details #}

		{# Tab: Attachments #}
		<div class="full-container-tabbed-contents tab-content tab-attach">
			{% include 'AgentBundle:Ticket:tab-attachments.html.twig' with {'message': message} %}
		</div>
		{# /Tab: Attachments #}
	</div>
</div>
{# /Top Tabs #}

{# Tab: Messages #}
<div class="full-tab-content">
	<div class="message-controls">
		<ul>
			<li><label><input type="checkbox" class="show-messages" checked="checked" />Show messages</label></li>
			<li><label><input type="checkbox" class="show-notes" checked="checked" />Show notes</label></li>
			<li><label><input type="checkbox" class="show-logs" />Show logs</label></li>
		</ul>
	</div>
	<div class="messages-wrap">
		{{ ticket_messages_block|raw }}
	</div>
</div>
{# /Tab Messages #}

<ul class="person-popout-tabs" style="display:none">
	<li class="move-to-tab"><a>Move into tab</a></li>
	<li class="close"><a>Close</a></li>
</ul>
<div class="person-popout-outer" style="display:none"></div>
<div class="person-popout" style="display:none">
	Loading ...
</div>

{# Wrapper around fields in the properties box #}
<script type="text/x-deskpro-plain" class="fields-wrap-properties">
	<div class="row-table-cotent display-item">
		<div class="col-table-content title-col display-title">
		</div>
		<div class="col-table-content display-content">
		</div>
	</div>
</script>

{# New tab code for middle tabs #}
<script type="text/x-deskpro-plain" class="fields-new-middletabs-tab">
	<li class="tab-trigger {id} field-tab" data-tab-for=".field-tab-content.{id}" data-field-tab-id="{id}">
		<a>{title}</a>
	</li>
</script>
<script type="text/x-deskpro-plain" class="fields-new-middletabs-content">
	<div class="container-tabbed-contents field-tab-content {id}" data-tab-trigger=".field-tab.{id}" data-field-tab-id="{id}" style="display: none">
	</div>
</script>
<script type="text/x-deskpro-plain" class="fields-wrap-middletabs">
	<div class="row-table-cotent display-item">
		<div class="col-table-content title-col display-title">
		</div>
		<div class="col-table-content display-content">
		</div>
	</div>
</script>

{# New tab code for bottom tabs (for addition to tabstrip) #}
<script type="text/x-deskpro-plain" class="fields-new-bodytabs-tab">
	<li class="tab-trigger {id} field-tab" data-tab-for=".{id}" data-field-tab-id="{id}">
		<a>{title}</a>
	</li>
</script>
<script type="text/x-deskpro-plain" class="fields-new-bodytabs-content">
	<div class="full-container-tabbed-contents tab-content field-tab-content {id}" data-tab-trigger=".{id}" data-field-tab-id="{id}">
	</div>
</script>
<script type="text/x-deskpro-plain" class="fields-wrap-bodytabs">
	<div class="row-table-cotent display-item">
		<div class="col-table-content title-col display-title">
		</div>
		<div class="col-table-content display-content">
		</div>
	</div>
</script>

<script type="text/x-deskpro-plain" class="fields-edit-overlay">
	<div class="show-fields edit-fields-overlay edit {id}" style="display:none;">
		<div class="content" style="padding: 5px">

		</div>
		<div class="buttons">
			<button class="close-trigger dp-button gray x-small">Cancel</button>
			<button class="save-trigger dp-button x-small">Save</button>
		</div>
	</div>
</script>

{% include 'AgentBundle:Ticket:view-page-display-holders.html.twig' %}

{% if ticket.hidden_status != 'deleted' %}
	{% include 'AgentBundle:Ticket:replybox.html.twig' %}
{% endif %}

{#
{% if ticket.hidden_status != 'deleted' %}
	{% include 'AgentBundle:Ticket:part-ticket-bar.html.twig' %}
{% endif %}
#}

</div></div> {# /scroll #}
</div>{# /layout #}