{% import 'AgentBundle:Common:macro-flagname.html.twig' as flag %}
<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Basic';
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.Ticket';
pageMeta.title         = {{ticket.subject|json_encode|raw}};
pageMeta.ticket_id     = {{ticket.id}};
pageMeta.url_fragment  = '{{ url_fragment('agent_ticket_view', {'ticket_id': ticket.id}) }}';

pageMeta.labelsAutocompleteUrl        = '{{ path('agent_ajax_labels_autocomplete', {'label_type': 'tickets'}) }}';
pageMeta.labelsSaveUrl                = '{{ path('agent_ticket_ajax_labels_save', {'ticket_id': ticket.id}) }}';
pageMeta.getMacroUrl                  = '{{ path('agent_ticket_ajax_get_macro', {'ticket_id': ticket.id }) }}?macro_id=$macro_id';
pageMeta.saveActionsUrl               = '{{ path('agent_ticket_ajax_save_actions', {'ticket_id': ticket.id }) }}';
pageMeta.deleteTicketUrl              = '{{ path('agent_ticketsearch_ajax_delete_tickets') }}';
pageMeta.uploadAttachUrl              = '{{ path('agent_accept_upload') }}';
pageMeta.viewMessageUnformattedUrl    = '{{ path('agent_ticket_message_unformatted', {'ticket_id': ticket.id, 'message_id': '000'})|replace({'000': '{message_id}'}) }}';
pageMeta.getMessageQuoteUrl           = '{{ path('agent_ticket_message_ajax_getquote', {'ticket_id': ticket.id, 'message_id': '000'})|replace({'000': '{message_id}'}) }}';
pageMeta.getMessagesUrl               = '{{ path('agent_ticket_ajax_getmessages', {'ticket_id': ticket.id}) }}';
pageMeta.viewPersonUrl                = '{{ path('agent_people_view', {'person_id': ticket.person.id}) }}';
pageMeta.lastMessageId = {{ last_message_id|default(0) }};
pageMeta.lastLogId = {{ last_log_id|default(0) }};

{% if ticket.person.organization %}
	pageMeta.viewOrgUrl = '{{ path('agent_org_view', {'organization_id': ticket.person.organization.id}) }}';
{% endif %}

pageMeta.urls = {
	'snippetviewer': '{{ path('agent_ticket_snippetviewer', {'ticket_id': ticket.id}) }}'
};

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';

pageMeta.isDeleted = {% if ticket.hidden_status == 'deleted' %}true{% else %}false{% endif %};
pageMeta.isLocked = {% if ticket.is_locked == 'deleted' %}true{% else %}false{% endif %};
{% if agent_signature %}
pageMeta.agentSignature = {{ agent_signature|json_encode|raw }};
{% endif %}

</script>
<div class="macro-controls">
	<button class="save" id="macro_apply_btn">Apply Macro</button>
	<button class="cancel" id="macro_cancel_btn">Cancel</button>
</div>

<div class="layout-content with-scrollbar page-ticket {% if ticket.is_locked %}locked{% endif %} {% if ticket.hidden_status == 'deleted' %}deleted{% endif %}">
{% if ticket.is_locked %}
<div class="locked-bar" id="{{baseId}}_locked_bar">
	<button class="clean-white dismiss">Dismiss</button>
	The ticket is in use by <cite>{{ ticket.locked_by_agent }}</cite>.
</div>
{% endif %}
<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
<div class="scroll-viewport"><div class="scroll-content">

{% if ticket.is_locked %}<div class="locked-overlay" id="{{baseId}}_locked_overlay"></div>{% endif %}

<form class="value-form" style="display:none">
	<input type="hidden" name="agent_id" class="agent_id" value="{{ticket.agent.id|default(0)}}" />
	<input type="hidden" name="agent_team_id" class="agent_team_id" value="{{ticket.agent_team.id|default(0)}}" />
	<input type="hidden" name="department_id" class="department_id" value="{{ticket.department.id|default(0)}}" />
	<input type="hidden" name="category_id" class="category_id" value="{{ticket.category.id|default(0)}}" />
	<input type="hidden" name="product_id" class="product_id" value="{{ticket.product.id|default(0)}}" />
	<input type="hidden" name="priority_id" class="priority_id" value="{{ticket.priority.id|default(0)}}" />
	<input type="hidden" name="workflow_id" class="workflow_id" value="{{ticket.workflow.id|default(0)}}" />
	<input type="hidden" name="is_hold" class="is_hold" value="{{ticket.is_hold|default(0)}}" />
	<input type="hidden" name="status" class="status" value="{{ticket.status}}" />
	<input type="hidden" name="hidden_status" class="hidden_status" value="{{ticket.hidden_status}}" />
</form>

{% if ticket.status == 'hidden' %}
	<div class="ticket-hidden-bar">
		{% if ticket.hidden_status == 'deleted' %}
			This ticket was deleted by {{ ticket_deleted.by_person.display_name }} (<time class="timeago" title="{{ ticket_deleted.date_created|date('c') }}">{{ ticket_deleted.date_created|date('M j Y') }}</time>).
			{% if ticket_deleted.reason %}
				<br />Reason: {{ ticket_deleted.reason }}
			{% endif %}

			<br />
			<div style="padding: 5px">
				<button class="clean-white undelete-trigger">Undelete Ticket</button>
			</div>
			{% if hard_delete_time %}
				This ticket will be permanantly purged from the system in {{ hard_delete_time }}
			{% endif %}
		{% else %}
			This ticket is currently hidden because: <span>{{ phrase('core_tickets.hidden_status_' ~ ticket.hidden_status) }}</span><br />
			This means it won't show up in most search results and it will not generate agent notifications.
		{% endif %}
	</div>
{% endif %}

<header class="page-header">
	<h4 class="id-number">#{{ ticket.id }}</h4>
	<h1>{{ ticket.subject }}</h1>
	<br class="clear" />
	<div class="meta-line">
		<div class="status set-status open" {% if ticket.status_code != 'open' %}style="display: none"{% endif %}><span>Awaiting Agent</span></div>
		<div class="status set-status pending" {% if ticket.status_code != 'pending' %}style="display: none"{% endif %}><span>Awaiting User</span></div>
		<div class="status set-status closed" {% if ticket.status_code != 'closed' %}style="display: none"{% endif %}><span>Closed</span></div>
		<div class="status set-status resolved" {% if ticket.status_code != 'resolved' %}style="display: none"{% endif %}><span>Resolved</span></div>
		<div class="status set-status hidden_spam" {% if ticket.status_code != 'hidden.spam' %}style="display: none"{% endif %}><span>Spam</span></div>
		<div class="status set-status hidden_validating" {% if ticket.status_code != 'hidden.validating' %}style="display: none"{% endif %}><span>Validating</span></div>
		<div class="status set-status hidden_deleted" {% if ticket.status_code != 'hidden.deleted' %}style="display: none"{% endif %}><span>Deleted</span></div>

		<div class="category set-department"><span>Department: <span class="label-department-id">{{ ticket.department.full_title }}</span></span></div>

		<div class="set-hold hold" {% if ticket.is_hold %}style="display: none"{% endif %}><span>Set on hold</span></div>
		<div class="set-hold unhold" {% if not ticket.is_hold %}style="display: none"{% endif %}><span class="tipped" title="Click to release hold">Ticket on hold</span></div>
	</div>
	<br class="clear" />
</header>

<table cellspacing="0" cellpadding="0" width="100%"><tr><td class="col" valign="top" width="50%"><tr><td width="50%" valign="top">
	<div class="profile-box-container people-box first">
		<header>
			<h4>People</h4>
		</header>
		<section id="{{baseId}}_people_box_person">
			<article>
				<dl>
					<dt>Owner</dt>
					<dd>
						<a class="user-link clean-white as-popover preload" data-route="person:{{ path('agent_people_view', {'person_id': ticket.person_id}) }}">
							<span style="background-image: url('{{ ticket.person.getPictureUrl(20) }}');">
								{{ ticket.person.display_name }}{% if ticket.person.organization %},
									{% if ticket.person.organization_position %}{{ ticket.person.organization_position }}{% endif %}
									{{ ticket.person.organization }}
								{% endif %}
								<span class="email">&lt;{{ ticket.person_email_address }}&gt;</span>
							</span>
						</a>
						<div class="clear"></div>
					</dd>

					<dt>CC</dt>
					<dd
						class="cc-row"
						data-element-handler="DeskPRO.Agent.ElementHandler.TicketCcManage"
						data-add-url="{{ path('agent_ticket_addpart', {'ticket_id': ticket.id}) }}"
						data-delete-url="{{ path('agent_ticket_delpart', {'ticket_id': ticket.id}) }}"
					>
						<ul>
							{% for part in user_parts %}
								{% include 'AgentBundle:Ticket:view-user-cc-row.html.twig' with {'person': part.person } %}
							{% endfor %}
							<li class="newrow"><span class="btn-small-add"></span>Add a new user</li>
						</ul>
						<script type="text/x-deskpro-plain" class="addrow-tpl">
							<li class="addrow">
								<span class="btn-small-remove remove-row-trigger"></span>
								<input type="text" class="user-part" />
								<span class="is-not-loading"><button class="clean-white small cc-saverow-trigger">Add</button></span>
								<span class="is-loading">Saving...</span>
							</li>
						</script>
					</dd>
				</dl>
			</article>
		</section>
	</div>
</td><td width="50%" valign="top">
	<div class="profile-box-container people-box second">
		<header>
			<div class="controls">
				<span class="edit-gear" id="{{baseId}}_assign_ob_trigger"></span>
			</div>
			<h4>Agents</h4>
		</header>
		<section id="{{baseId}}_people_box_agent">
			<article>
				<dl>
					<dt>Assigned</dt>
					<dd>
						<span class="agent-link prop-agent-id" style="background-image: url('{{ ticket.agent.getPictureUrl(20) }}');">{{ ticket.agent.display_name|default('Unassigned') }}</span>
					</dd>

					<dt>Team</dt>
					<dd>
						<span class="prop-agent-team-id">{{ ticket.agent_team.name|default('None') }}</span>
					</dd>

					<dt>Followers</dt>
					<dd>
						<ul id="{{baseId}}_followers_list">
							{% for agent in agent_parts %}
								<li><span>{{ agent.person.display_name }}</span></li>
							{% else %}
								<li>No Followers</li>
							{% endfor %}
						</ul>
					</dd>
				</dl>
			</article>
		</section>
	</div>
</td></tr></table>

<div class="profile-box-container">
	<header>
		<h4>Properties</h4>
	</header>
	<section class="description-area" id="{{baseId}}_fields_display_main_wrap">
		<dl class="info-list">
			<dt class="type-labels">Flag:</dt>
			<dd
				class="flagged-wrap"
				id="{{baseId}}_flag_opt"
				data-element-handler="DeskPRO.ElementHandler.ListRadio"
			>
				<ul>
					<li class="flag-none tipped {% if not ticket_flagged %}on{% endif %}" data-value="none" title="No flag"><span></span></li>
					{% for color in ['blue', 'green', 'orange', 'pink', 'purple', 'red', 'yellow'] %}
						<li class="flag-{{color}} tipped {% if ticket_flagged == color %}on{% endif %}" data-value="{{ color }}" title="{{ flag.flag_name(color) }}"><span>{{ flag.flag_name(color) }}</span></li>
					{% endfor %}
				</ul>
				<br class="clear"/>
			</dd>

			<dt class="type-labels">Labels:</dt>
			<dd class="ticket-tags tags-wrap">
				<ul data-label-route="listpane:{{ path('agent_ticketsearch_runcustomfilter') }}?terms[0][rule_type]=label&amp;terms[0][op]=is&amp;terms[0][label]={LABEL}&amp;view_name=label&amp;view_extra={LABEL}">
					{% for label in ticket.labels %}
						<li><span>{{label.label}}</span></li>
					{% endfor %}
				</ul>
			</dd>

			<dt>Ticket Created:</dt>
			<dd>
				<time class="timeago" datetime="{{ticket.date_created|date('c')}}"></time>
				on {{ ticket.date_created|date('M j Y H:ia') }}
			</dd>

			<dt>User Waiting:</dt>
			<dd>
				User has been waiting <time>23 minutes</time> for a reply,
				and a total of <time>8 hours</time> since the ticket started.
			</dd>
		</dl>

		<div class="extra-info fields-show">
			<div class="info-list" id="{{baseId}}_fields_display_main"></div>
		</div>
		<div class="fields-edit" style="display: none;"></div>

		<div class="controls" id="{{baseId}}_properties_controls">
			<button class="clean-white properties-edit-trigger edit-fields-trigger"><span>Edit Properties</span></button>
			<button class="clean-white" id="{{baseId}}_merge_trigger"><span>Merge Ticket</span></button>
			{% if macros|length %}
				<button class="clean-white arrow" id="{{baseId}}_macros_menu_trigger"><span>Macros</span><em></em></button>
			{% endif %}
			<button class="clean-white arrow" id="{{baseId}}_more_menu_trigger"><span>More</span><em></em></button>
		</div>

		<ul id="{{baseId}}_more_menu" style="display: none;">
			<li data-op="delete">Delete</li>
			<li data-op="print">Print</li>
		</ul>
	</section>
</div>

<div class="profile-box-container ticket-messages">
	<header>
		<h4>Messages</h4>
		<ul class="tickets-msg-controls">
			<li><label><input type="checkbox" class="dp-checkbox show-messages" checked="checked" />Messages</label></li>
			<li><label><input type="checkbox" class="dp-checkbox show-attach" checked="checked" />Attachments</label></li>
			<li><label><input type="checkbox" class="dp-checkbox show-notes" checked="checked" />Agent Notes</label></li>
			<li><label><input type="checkbox" class="dp-checkbox show-logs" />Ticket Log</label></li>
		</ul>
	</header>
	<section class="messages-wrap" id="{{baseId}}_messages_wrap">
		{{ ticket_messages_block|raw }}
	</section>
</div>

<div id="{{baseId}}_replybox_wrap">
	{% include 'AgentBundle:Ticket:replybox.html.twig' %}
</div>

{# Wrapper around fields in the properties box #}
<script type="text/x-deskpro-plain" id="{{baseId}}_fields_display_main_wrap_tpl">
	<dl class="info-list display-item">
		<dt class="prop-title display-title"></dt>
		<dd class="prop-val display-content"></dd>
	</dl>
</script>
<script type="text/x-deskpro-plain" id="{{baseId}}_fields_display_main_edit_tpl">
	<div class="fields-edit-container">
		<div class="fields-edit-rows"></div>
		<div class="controls">
			<div class="is-not-loading">
				<button class="clean-white save-trigger">Save</button>
				<button class="clean-white close-trigger">Cancel</button>
			</div>
			<div class="is-loading">
				Saving, please wait...
			</div>
		</div>
	</div>
</script>
<script type="text/x-deskpro-plain" id="{{baseId}}_fields_display_main_edit_row_tpl">
	<dl class="info-list display-item">
		<dt class="display-title"></dt>
		<dd class="display-content"></dd>
	</dl>
</script>

{# New tab code for bottom tabs (for addition to tabstrip) #}
<script type="text/x-deskpro-plain" class="tpl-fields-maintabs-tab" id="{{baseId}}_fields_display_tabs_tab_tpl">
	<li class="tab-trigger {id} field-tab" data-tab-for=".{id}" data-field-tab-id="{id}">
		<a>{title}</a>
	</li>
</script>
<script type="text/x-deskpro-plain" class="tpl-fields-maintabs-content" id="{{baseId}}_fields_display_tabs_content_tpl">
	<div class="full-container-tabbed-contents tab-content field-tab-content {id}">
	</div>
</script>
<script type="text/x-deskpro-plain" id="{{baseId}}_fields_display_tabs_wrap_tpl">
	<dl class="info-list display-item">
		<dt class="display-title"></dt>
		<dd class="display-content"></dd>
	</dl>
</script>

{% include 'AgentBundle:Ticket:view-page-display-holders.html.twig' %}

{% include 'AgentBundle:Ticket:part-ticket-menus.html.twig' %}

<div class="macro-controls" style="display: none;">
	<button class="clean-white save" id="macro_apply_btn">Apply Macro</button>
	<button class="clean-white cancel" id="macro_cancel_btn">Cancel</button>
</div>

<div class="optionbox reply-agent-team-ob with-footer" id="{{baseId}}_agent_assign_ob">
	<header>
		<h4>Assignments and Followers</h4>
		<span class="close close-trigger"></span>
	</header>
	<div class="col">
		<section data-section-name="agents">
			<header>
				<h3>Agents</h3>
				<input type="text" class="filter-box" placeholder="Filter..." />
			</header>
			<ul>
				<li class="me last-me {% if ticket.agent.id == app.user.id or not ticket.agent %}on{% endif %}">
					<input type="radio" name="{{baseId}}_agent" value="{{ app.user.id }}" {% if ticket.agent.id == app.user.id or not ticket.agent %}checked="checked"{% endif %} />
					<label><span class="agent-pic agent-label-{{ app.user.id }}" style="background-image: url({{ app.user.getPictureUrl(16) }})">Me</span></label>
				</li>

				<li>
					<input type="radio" name="{{bsaeId}}_agent" value="0" />
					<label><span class="agent-pic agent-label-0">Unassigned</span></label>
				</li>

				{% for agent in agents %}
					{% if agent.id != app.user.id %}
						<li {% if ticket.agent.id == agent.id %}class="on"{% endif %}>
							<input type="radio" name="{{baseId}}_agent" value="{{ agent.id }}" {% if ticket.agent.id == agent.id %}checked="checked"{% endif %} />
							<label><span class="agent-pic agent-label-{{ agent.id }}" style="background-image: url({{ agent.getPictureUrl(16) }})">{{ agent.display_name }}</span></label>
							<div class="bound-fade"></div>
						</li>
					{% endif %}
				{% endfor %}
			</ul>
		</section>
	</div>
	<div class="col">
		<section data-section-name="teams">
			<header>
				<h3>Teams</h3>
				<input type="text" class="filter-box" placeholder="Filter..." />
			</header>
			<ul>
				{% for team in app.user.getAgent().getTeams() %}
					<li class="me {% if loop.last %}last-me{% endif %} {% if ticket.agent_team.id == team.id %}on{% endif %}">
						<input type="radio" name="{{baseId}}_agent_team" value="{{ team.id }}" {% if ticket.agent_team.id == team.id %}checked="checked"{% endif %} />
						<label class="agent-team-label-{{ team.id }}">{{ team.name }}</label>
						<div class="bound-fade"></div>
					</li>
				{% endfor %}

				<li class="{% if not ticket.agent_team %}on{% endif %}">
					<input type="radio" name="{{baseId}}_agent_team" value="0" {% if not ticket.agent_team %}checked="checked"{% endif %} />
					<label><span class="agent-team-label-0">No Team</span></label>
				</li>

				{% for team in agent_teams %}
					{% if team.id not in app.user.getAgent().getTeamIds() %}
						<li {% if ticket.agent_team.id == team.id %}class="on"{% endif %}>
							<input type="radio" name="{{baseId}}_agent_team" value="{{ team.id }}" {% if ticket.agent_team.id == team.id %}checked="checked"{% endif %} />
							<label class="agent-team-label-{{ team.id }}">{{ team.name }}</label>
							<div class="bound-fade"></div>
						</li>
					{% endif %}
				{% endfor %}
			</ul>
		</section>
	</div>
	<div class="col">
		<section data-section-name="followers">
			<header>
				<h3>Followers</h3>
				<input type="text" class="filter-box" placeholder="Filter..." />
			</header>
			<ul>
				<li class="me last-me {% if app.user.id in participant_ids %}on{% endif %}">
					<input type="checkbox" name="{{bsaeId}}_part" value="{{ app.user.id }}" {% if app.user.id in participant_ids %}checked="checked"{% endif %} />
					<label><span class="agent-pic agent-part-label-{{ app.user.id }}" style="background-image: url({{ app.user.getPictureUrl(16) }})">Me</span></label>
				</li>

				{% for agent in agents %}
					{% if agent.id != app.user.id %}
						<li {% if agent.id in participant_ids %}class="on"{% endif %}>
							<input type="checkbox" name="{{bsaeId}}_part" value="{{ agent.id }}" {% if agent.id in participant_ids %}checked="checked"{% endif %} />
							<label><span class="agent-pic agent-part-label-{{ agent.id }}" style="background-image: url({{ agent.getPictureUrl(16) }})">{{ agent.display_name }}</span></label>
							<div class="bound-fade"></div>
						</li>
					{% endif %}
				{% endfor %}
			</ul>
		</section>
	</div>
	<br class="clear" />
	<footer>
		<button class="save-trigger">Apply</button>
	</footer>
</div>

<div class="confirm-macro-overlay" id="{{baseId}}_confirm_macro_overlay" style="width: 400px; height: 400px; display: none;">
	<div class="overlay-title">
		<h4>Confirm: Apply Macro</h4>
	</div>
	<div class="overlay-content">
		This macro is defined to perform the following actions:
		<div class="actions-list"></div>
	</div>
	<div class="overlay-footer">
		<button class="clean-white" id="{{baseId}}_apply_macro_btn">Apply Macro</button>
	</div>
</div>

</div></div> {# /scroll #}
</div>{# /layout #}
