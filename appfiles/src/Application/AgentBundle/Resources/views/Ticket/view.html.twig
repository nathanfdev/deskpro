<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.Ticket';
pageMeta.title         = {{ticket.subject|json_encode|raw}};
pageMeta.ticket_id     = {{ticket.id}};
pageMeta.pageIdentity  = 'ticket:{{ticket.id}}';

pageMeta.labelsAutocompleteUrl        = '{{ path('agent_ajax_labels_autocomplete', {'label_type': 'tickets'}) }}';
pageMeta.labelsSaveUrl                = '{{ path('agent_ticket_ajax_labels_save', {'ticket_id': ticket.id}) }}';
pageMeta.getMacroUrl                  = '{{ path('agent_ticket_ajax_get_macro', {'ticket_id': ticket.id }) }}?macro_id=$macro_id';
pageMeta.saveActionsUrl               = '{{ path('agent_ticket_ajax_save_actions', {'ticket_id': ticket.id }) }}';
pageMeta.deleteTicketUrl              = '{{ path('agent_ticketsearch_ajax_delete_tickets') }}';
pageMeta.uploadAttachUrl              = '{{ path('agent_accept_upload') }}';
pageMeta.viewMessageUnformattedUrl    = '{{ path('agent_ticket_message_unformatted', {'ticket_id': ticket.id, 'message_id': '000'})|replace({'000': '{message_id}'}) }}';
pageMeta.getMessageQuoteUrl           = '{{ path('agent_ticket_message_ajax_getquote', {'ticket_id': ticket.id, 'message_id': '000'})|replace({'000': '{message_id}'}) }}';
pageMeta.tabTicketLogUrl              = '{{ path('agent_ticket_ajaxtab_ticketlog', {'ticket_id': ticket.id}) }}';
pageMeta.tabAttachmentsUrl            = '{{ path('agent_ticket_ajaxtab_attachments', {'ticket_id': ticket.id}) }}';
pageMeta.tabRelatedContentUrl         = '{{ path('agent_ticket_ajaxtab_releated_content', {'ticket_id': ticket.id}) }}';
pageMeta.getMessagesUrl               = '{{ path('agent_ticket_ajax_getmessages', {'ticket_id': ticket.id}) }}';
pageMeta.viewPersonUrl                = '{{ path('agent_people_view', {'person_id': ticket.person.id}) }}';
pageMeta.getUpdatedCountsUrl          = '{{ path('agent_ticket_ajaxgetupdatedcounts', {'ticket_id': ticket.id}) }}';

{#
pageMeta.widgets = [
{% for widget in widgets['agent.ticket.tabs']|merge(widgets['agent.ticket.display']) %}
	{{ widget.getJsInitObject('div.tab-content.widget-' ~ widget.id)|json_encode|raw }}
	{% if not loop.last %},{%endif%}
{% endfor %}
];

pageMeta.fieldHandlers = [
	{% for f in custom_fields %}
		{% if f.field_def.js_class %}
			['{{f.field_def.js_class', '{{f.elId}}_rendered_wrap', '{{f.elId}}_form_wrap'],
		{% endif %}
	{% endfor %}
	false,
];
#}
</script>
<div class="layout-content with-scrollbar">
<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
<div class="viewport"><div class="overview">

<form class="value-form" style="display:none">
	<input type="hidden" name="agent_id" class="agent_id" value="{{ticket.agent.id|default(0)}}" />
	<input type="hidden" name="agent_team_id" class="agent_team_id" value="{{ticket.agent_team.id|default(0)}}" />
	<input type="hidden" name="department_id" class="department_id" value="{{ticket.department.id|default(0)}}" />
	<input type="hidden" name="category_id" class="category_id" value="{{ticket.category.id|default(0)}}" />
	<input type="hidden" name="product_id" class="product_id" value="{{ticket.product.id|default(0)}}" />
	<input type="hidden" name="priority_id" class="priority_id" value="{{ticket.priority.id|default(0)}}" />
	<input type="hidden" name="workflow_id" class="workflow_id" value="{{ticket.workflow.id|default(0)}}" />
	<input type="hidden" name="status" class="status" value="{{ticket.status}}" />
	<input type="hidden" name="hidden_status" class="hidden_status" value="{{ticket.hidden_status}}" />
</form>
{% if ticket.is_locked %}
	<div class="ticket-lock-bar">
		This ticket is currently in use by {{ ticket.locked_by_agent.display_name }}. You may want to avoid
		making changes until they are finished with it.
	</div>
{% endif %}

{% if ticket.status == 'hidden' %}
	<div class="ticket-hidden-bar">
		{% if ticket.hidden_status == 'deleted' %}
			This ticket was deleted by {{ ticket_deleted.by_person.display_name }} on {{ ticket_deleted.date_created|date('Y-m-d') }}.
			{% if ticket_deleted.reason %}
				<br />Reason: {{ ticket_deleted.reason }}
			{% endif %}

			<br />
			<div style="padding: 5px">
				<button class="dp-button x-small undelete-trigger">Undelete Ticket</button>
			</div>
		{% else %}
			This ticket is currently hidden because: <span>{{ phrase('core_tickets.hidden_status_' ~ ticket.hidden_status) }}</span><br />
			This means it won't show up in most search results and it will not generate agent notifications.
		{% endif %}
	</div>
{% endif %}

<div class="inner-box-tab-content-2 ticket-element">
	<div class="ticket-actions-trigger">Actions</div>
	<div class="ticket-status ticket-{{ticket.status}}">
		<span class="ticket-{{ticket.status}} prop-val menu-trigger status">{{ phrase('core_tickets.status_' ~ ticket.status) }}</span>
	</div>
	<div class="ticket-info-top">
	<span class="ticket-source prop-val menu-trigger department_id" data-no-value="Choose Department">
		{{ticket.department.full_title|default('Choose Department')}}
	</span>
	<h3>
		{{ticket.subject}}
	</h3>
	</div>
</div>

{# Info Wrap #}
<div class="ticket-info-wrapper">

	{# Top Left #}
	<div class="ticket-info left">
		<div class="ticket-tags">
			<span class="tag-icon"></span>
			<ul>
				{% for label in ticket.labels %}
					<li><span>{{label.label}}</span></li>
				{% endfor %}
			</ul>
		</div>

		{# Top Tabs #}
		<div class="container-tabbed-wrap ticket-participants">

			<div class="container-tabbed-tabs">
				<ul>
					<li class="container-tabbed-tabs-active"><a href="#">Participants</a></li>
				</ul>
			</div>

			<div class="container-tabbed">
				<div class="container-tabbed-contents">

					{# Tab: Participants #}
					<div class="container-tabbed-content-tab">
						<table cellspacing="0" cellpadding="0" border="0" class="participants-table">
							<tr>
								<td class="col-inner name-image agent menu-trigger agent_id agent">
									<span>Agent</span>
									{% if ticket.agent %}
										<img class="agent-picture" data-picture-url="{{ path('serve_person_picture_size', {'person_id': '000', 'size': '30'})|replace({'000': '{value}'}) }}" src="{{ ticket.agent.getPictureUrl(30) }}" alt="" width="30" height="30" />
										<h4 data-picture-element="img.agent-picture" data-no-value-label="{{ phrase('core.unassigned') }}" class="prop-val agent_id">{{ ticket.agent.display_name }}</h4>
									{% else %}
										<img class="agent-picture" data-picture-url="{{ path('serve_person_picture_size', {'person_id': '000', 'size': '30'})|replace({'000': '{value}'}) }}" src="{{ asset('images/pic-agent-2.png') }}" alt="" width="30" height="30" />
										<h4 data-picture-element="img.agent-picture" data-no-value-label="{{ phrase('core.unassigned') }}" class="prop-val agent_id no-value">{{ phrase('core.unassigned') }}</h4>
									{% endif %}
								</td>
								<td class="col-inner name-image menu-trigger agent_team_id agent_team">
									<span>Team</span>
									{% if ticket.agent_team %}
										<img class="agent-picture" src="{{ asset('images/pic-agent-2.png') }}" alt="" width="30" height="30" />
										<h4 class="prop-val agent_team_id" data-no-value="{{ phrase('core.none') }}">{{ ticket.agent_team.name }}</h4>
									{% else %}
										<img class="agent-picture" src="{{ asset('images/pic-agent-2.png') }}" alt="" width="30" height="30" />
										<h4 class="prop-val agent_team_id no-value" data-no-value="{{ phrase('core.none') }}">{{ phrase('core.none') }}</h4>
									{% endif %}
								</td>
								<td class="col-inner partis">
									<span>Participants<a>edit</a></span>
									<ul>
									</ul>
								</td>
							</tr>
							<tr>
								<td class="col-inner name-image person-overview" data-route="person:{{ path('agent_people_view', {'person_id': ticket.person_id}) }}">
									<span>User</span>
									<img src="{{ ticket.person.getPictureUrl(30) }}" alt="" width="30" height="30" />
									<h4>{{ ticket.person.display_name }}</h4>
								</td>

								<td class="col-inner name-image with-route" {% if ticket.person.organization %}data-route="page:{{ path('agent_org_view', {'organization_id': ticket.person.organization.id}) }}"{% endif %}>
									<span>Organization</span>
									<img src="{{ asset('images/pic-agent-2.png') }}" alt="" width="30" height="30" />
									<h4>{{ ticket.person.organization.name|default('None') }}</h4>
								</td>

								<td class="col-inner partis">
									<span>Participants<a>edit</a></span>
									<ul>
									</ul>
								</td>
							</tr>
						</table>

					</div>
					{# /Tab: Participants #}
				</div>
			</div>

		</div>
		{# /Top Tabs #}
		<br class="clear" />
	</div>
	{# /Top Left #}

	{# Top Right #}
	<div class="ticket-properties right">

		{# Box Properties #}
		<div class="table-container">
			<div class="table-title">
				<span class="ticket-custom-fields-edit-btn">edit fields</span>
				<h4>Ticket Properties</h4>
			</div>
			<div class="table-content">

				<div class="row-table-cotent">
					<div class="col-table-content title-col">
						<span>Category</span>
					</div>
					<div class="col-table-content prop-val">
						<span class="prop-val menu-trigger category_id {% if not ticket.category %}no-value{% endif %}">{{ticket.category.full_title|default('None')}}</span>
					</div>
				</div>

				<div class="row-table-cotent dark product_id">
					<div class="col-table-content title-col">
						<span>Product</span>
					</div>
					<div class="col-table-content">
						<span class="prop-val menu-trigger product_id {% if not ticket.category %}no-value{% endif %}">{{ticket.product.title|default('None')}}</span>
					</div>
				</div>
				<div class="row-table-cotent">
					<div class="col-table-content title-col">
						<span>Priority</span>
					</div>
					<div class="col-table-content">
						<span class="prop-val menu-trigger priority_id {% if not ticket.category %}no-value{% endif %}">{{ticket.priority.title|default('None')}}</span>
					</div>
				</div>
				<div class="row-table-cotent dark workflow_id">
					<div class="col-table-content title-col">
						<span>Workflow</span>
					</div>
					<div class="col-table-content">
						<span class="prop-val menu-trigger workflow_id {% if not ticket.workflow %}no-value{% endif %}">{{ticket.workflow.title|default('None')}}</span>
					</div>
				</div>
				{{ ticket_custom_fields_block|raw }}
			</div>
		</div>
		{# /Box Properties #}

		{# Box Times #}
		<div class="table-container">
			<div class="table-title">
				<h4>Dates and Times</h4>
			</div>
			<div class="table-content">

				<div class="row-table-cotent">
					<div class="col-table-content title-col">
						<span>Created</span>
					</div>
					<div class="col-table-content">
						<span class="timeago" title="{{ticket.date_created|date('c')}}">{{ticket.date_created|date('Y-m-d')}}</span>
					</div>
				</div>

				<div class="row-table-cotent dark">
					<div class="col-table-content title-col">
						<span>Waiting Time</span>
					</div>
					<div class="col-table-content">
						<span>12 hours</span>
					</div>
				</div>
				<div class="row-table-cotent">
					<div class="col-table-content title-col">
						<span>Total Waiting Time</span>
					</div>
					<div class="col-table-content">
						<span>43 hours</span>
					</div>
				</div>
			</div>
		</div>
		{# /Box Times #}
	</div>
	{# /Top Right #}

	{% include 'AgentBundle:Ticket:part-ticket-menus.html.twig' %}
</div>
{# /Info Wrap #}


{# Main Tabs #}
<div class="full-container-tabbed messages-container">
	{# Tab Triggers #}
	<div class="full-container-tabbed-tabs">
		<ul>
			<li class="tab-trigger ticket-messages on" data-tab-for=".tab-content.ticket-messages"><a>Messages <em class="ticket-messages-count">({{counts.messages}})</em></a></li>
			<li class="tab-trigger ticket-notes" data-tab-for=".tab-content.ticket-notes"><a>Notes <em class="ticket-notes-count">({{counts.notes}})</em></a></li>
			<li class="tab-trigger ticket-attach" data-tab-for=".tab-content.ticket-attach"><a>Attachments <em class="ticket-attachments-count">({{counts.attachments}})</em></a></li>
			<li class="tab-trigger ticket-log" data-tab-for=".tab-content.ticket-log"><a>Log <em class="ticket-logs-count">({{counts.logs}})</em></a></li>
			{% if show_related_content %}
				<li class="tab-trigger ticket-related-content" data-tab-for=".tab-content.related-content"><a>Related Content</a></li>
			{% endif %}
			{% for widget in widgets['agent.ticket.tabs'] %}
				<li class="tab-trigger widget-{{widget.id}}" data-tab-for=".tab-content.widget-{{widget.id}}"><a>{{widget.tab_title|default(widget.note)}}</a></li>
			{% endfor %}
		</ul>
	</div>
	{# /Tab Triggers #}

	{# Tab Contents #}
	<div class="full-container-tabbed-contents-wrap">
		{# Tab: Messages #}
		<div class="full-container-tabbed-contents tab-content ticket-messages" data-tab-trigger=".tab-trigger.ticket-messages">
			<div class="full-tab-content">
				<div class="messages-wrap">
					{{ ticket_messages_block|raw }}
				</div>
			</div>
		</div>
		{# /Tab Messages #}

		{# Tab Notes #}
		<div class="full-container-tabbed-contents tab-content ticket-notes" data-tab-trigger=".tab-trigger.ticket-notes">
			<div class="full-tab-content">
				<div class="messages-wrap">
					{{ ticket_notes_block|raw }}

					<div class="message admin-message new-note">
						<div class="message-avatar left">
							<img src="{{ app.user.getPictureUrl(35) }}" alt="" width="35" height="35" />
						</div>
						<div class="message-body">
							<div class="message-meta">
								<span class="arrow-left"></span>
								<h4>{{ app.user.display_name }}</h4>
							</div>
							<div class="message-text">
								<p>
									<textarea style="width:98%; height: 80px;"></textarea>
									<div style="text-align:center; margin-top: 9px;">
										<div class="loading-off">
											<button class="dp-button x-small">Add Note</button>
										</div>
										<div class="loading-on" style="display:none">
											Saving ...
										</div>
									</div>
								</p>
							</div>
						</div>
					</div>

				</div>
			</div>
		</div>
		{# /Tab Notes #}

		{# Tab Attach #}
		<div class="full-container-tabbed-contents tab-content ticket-attach" data-tab-trigger=".tab-trigger.ticket-attach">
			{% include 'AgentBundle:Ticket:tab-attachments.html.twig' with {'message': message} %}
		</div>
		{# /Tab Attach #}

		{# Tab Log #}
		<div class="full-container-tabbed-contents tab-content ticket-log unloaded" data-tab-trigger=".tab-trigger.ticket-log">
			Loading ticket log ...
		</div>
		{# /Tab Log #}

		{# Tab Related Content #}
		{% if show_related_content %}
			<div class="full-container-tabbed-contents tab-content ticket-related-content unloaded" data-tab-trigger=".tab-trigger.related-content">

			</div>
		{% endif %}
		{# /Tab Related Content #}

		{% for widget in widgets['agent.ticket.tabs'] %}
			<div class="full-container-tabbed-contents tab-content widget-{{widget.id}}" data-tab-trigger=".tab-trigger.widget-{{widget.id}}">
				{% include widget.template_name %}
			</div>
		{% endfor %}
	</div>
	{# /Tab Contents #}

	<ul class="person-popout-tabs" style="display:none">
		<li class="move-to-tab"><a>Move into tab</a></li>
		<li class="close"><a>Close</a></li>
	</ul>
	<div class="person-popout-outer" style="display:none"></div>
	<div class="person-popout" style="display:none">
		Loading ...
	</div>
</div>
{# /Main Tabs #}

</div></div>
</div>
<div class="layout-footer">
	{% include 'AgentBundle:Ticket:part-ticket-bar.html.twig' %}
</div>