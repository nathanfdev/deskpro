<div class="inner-box-tab-content">
	<table class="list" cellspacing="0" width="100%">
		<thead class="display-options-trigger">
			<tr>
				<th>Filename</th>
				<th width="100">Size</th>
				<th width="100">Date</th>
				<th width="100">Who</th>
			</tr>
		</thead>
		<tbody>
			{% for ticket_attach in ticket_attachments %}
				<tr>
					<td><a href="{{ ticket_attach.blob.download_url }}" target="_blank">{{ticket_attach.blob.filename}}</a></td>
					<td>{{ticket_attach.blob.readable_filesize}}</td>
					<td>{{ticket_attach.blob.date_created|date('Y-m-d')}}</td>
					<td>{{ticket_attach.person.display_name}}</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="4">There are no files attached to this ticket</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
</div>