{% related_tickets %}
	<div class="related-content">
		<h4>Tickets</h4>
		{% for related in related_tickets %}
			<div class="item">
				<a data-route="{{ path('agent_ticket_view', {'ticket_id': related.id}) }}">{{related.subject}}</a><br />
			</div>
		{% endfor %}
	</div>
{% endif %}

{% related_articles %}
	<div class="related-content">
		<h4>Articles</h4>
		{% for related in related_articles %}
			<div class="item">
				{# todo link to KB editor + link to insert into reply? #}
				<a data-route="{{ path('agent_ticket_view', {'ticket_id': related.id}) }}">{{related.title}}</a><br />
			</div>
		{% endfor %}
	</div>
{% endif %}