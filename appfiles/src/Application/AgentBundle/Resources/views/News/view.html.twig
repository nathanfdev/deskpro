{% import 'AgentBundle:Common:optionbox-macros.html.twig' as optionbox %}
<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.NewsView';
pageMeta.title = {{news.title|json_encode|raw}};
pageMeta.news_id = {{news.id}};
pageMeta.url_fragment  = '{{ url_fragment('agent_news_view', {'news_id': news.id}) }}';
pageMeta.permalink = '{{news.permalink}}';
pageMeta.labelsSaveUrl = '{{ path('agent_news_ajax_labels_save', {'news_id': news.id}) }}';

{% if news.hidden_status == 'validating' %}
pageMeta.isValidating = true;
{% endif %}

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
{# scroll containers #}
<div class="layout-content with-scrollbar page-listing page-news-view">
<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
<div class="scroll-viewport"><div class="scroll-content">
{# /scroll containers #}

<div class="delete-notice" {% if news.status_code != "hidden.deleted" %}style="display: none;"{% endif %}>
	{{ phrase('agent.record_deleted') }} <button class="clean-gray xxx-small undelete">{{ phrase('agent.undelete') }}</button>
</div>

{% if news.status_code == "hidden.validating" %}
	{% include 'AgentBundle:Publish:view-approve-header.html.twig' %}
{% endif %}

<header class="page-header">
	<h4 class="id-number">#{{ news.id }}</h4>
	<h1 class="editable hover-edit" data-editable-for=".inline-editable .title">{{ news.title }}</h1>
	<br class="clear" />
	<div class="meta-line">
		<div class="status the-status article-status"><span>{{ news.status }}</span></div>
		<div class="category" id="{{baseId}}_cat_trigger"><span>Category: <span id="{{baseId}}_cat_label">{{ news.category.full_title }}</span></span></div>
	</div>
	<br class="clear" />
</header>

<section id="{{baseId}}_tabs_content_wrap" class="mid-page">
	<dl class="table-list">
		<dt class="type-labels">{{ phrase('agent.label_labels') }}</dt>
		<dd>
			<ul>
				<div class="tags-wrap news-tags">
					<ul>
						{% for label in news.labels %}
							<li><span>{{label.label}}</span></li>
						{% endfor %}
					</ul>
				</div>
			</ul>
		</dd>

		<dt>{{ phrase('agent.label_rating') }}</dt>
		<dd>
			{{ news.rating_percent }}% helpful (<span class="link-look who-voted-trigger">{{ news.num_ratings }} votes</span>)<br />
			<small>{{ news.up_votes }} found the post helpful, {{ article.news }} found the post unhelpful</small>
		</dd>
	</dl>

	<br class="clear" />

	<div class="controls" id="{{baseId}}_action_buttons">
		<button class="clean-white delete" {% if news.status_code == "hidden.deleted" %}style="display:none"{% endif %}>{{ phrase('agent.delete') }}</button>
		<button class="clean-white permalink">{{ phrase('agent.copy_permalink') }}</button>
		<button class="clean-white view-user-interface">{{ phrase('agent.view_in_user_interface') }}</button>
		<br class="clear" />
	</div>

	<footer class="time-info">
		<ul>
			<li>
				{{ phrase('agent.created_timeago_by_x_on_y', {
					'timeago': '<time class="timeago" datetime="' ~ news.date_created|date('c') ~'"></time>',
					'name': news.person.display_name,
					'date': '<time>' ~ news.date_created|date('H:ia M j Y') ~ '</time>'
				}) }}
			</li>
		</ul>
	</footer>
</section>

<nav class="page-tabs" id="{{baseId}}_bodytabs">
	<ul>
		<li class="on" data-tab-for="#{{baseId}}_tab_contents .news-content"><span>{{ phrase('agent.label_page') }}</span></li>
		<li data-tab-for="#{{baseId}}_tab_contents .comments-tab"><span>{{ phrase('agent.label_comments') }} (<span id="{{baseId}}_count_comments">{{news_comments|length|default(0)}}</span>)</span></li>
		<li data-tab-for="#{{baseId}}_tab_contents .revisions"><span>{{ phrase('agent.label_revisions') }}</span></li>
		<li data-tab-for="#{{baseId}}_tab_contents .related-content"><span>{{ phrase('agent.label_related_content') }}</span></li>
		<li data-tab-for="#{{baseId}}_tab_contents .search-tab"><span>{{ phrase('agent.label_search') }}</span></li>
	</ul>
	<button class="clean-white small news-editor-edit" style="float:right; margin: 6px 10px 0 0;">{{ phrase('agent.edit') }}</button>
</nav>

{# Tab Contents #}
<div id="{{baseId}}_tab_contents" class="tabbed-page-contents">
	{# Tab: Content #}
	<div class="deskpro-tab-item content-tab-item news-content on">
		{# Content #}
		<div class="news-content" id="{{baseId}}_content_ed">
		{% include 'AgentBundle:News:view-content-tab.html.twig' %}
		</div>
		{# /Content #}
	</div>

	{# Tab: Comments #}
	<div class="deskpro-tab-item comments-tab">
		<div class="news-comments">
			<div class="full-tab-content">
				<div class="messages-wrap" id="{{baseId}}_comments_wrap">
					{% for comment in news_comments %}
						{% include 'AgentBundle:News:view-comment.html.twig' %}
					{% endfor %}
				</div>
			</div>

			<div class="message admin-message new-note">
				<div class="message-avatar left">
					<img src="{{ app.user.getPictureUrl(35) }}" alt="" width="35" height="35" />
				</div>
				<div class="message-body">
					<div class="message-meta">
						<span class="arrow-left"></span>
						<h4>{{ app.user.display_name }}</h4>
					</div>
					<div class="message-text">
						<p>
							<textarea style="width:98%; height: 80px;"></textarea>
							<div style="text-align:center; margin-top: 9px;">
								<div class="loading-off">
									<button class="dp-button x-small">{{ phrase('agent.add_comment') }}</button>
								</div>
								<div class="loading-on" style="display:none">
									{{ phrase('agent.loading_saving') }}
								</div>
							</div>
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>
	{# /Tab: Comments #}

	{# Tab: Revisions #}
	<div id="{{baseId}}_revs" class="deskpro-tab-item revisions">
		{% include 'AgentBundle:News:view-revisions-tab.html.twig' %}
	</div>
	{# /Tab: Revisions #}

	{# Tab: Related #}
	<div id="{{baseId}}_related_content" class="deskpro-tab-item related-content">
		{% include 'AgentBundle:Common:content-related-list.html.twig' %}
	</div>
	{# /Tab: Related #}

	{# Tab: Search #}
	<div id="{{baseId}}_searchtab" class="deskpro-tab-item search-tab">
		<div class="tags-wrap sticky-search-words">
			<dl class="table-list">
				<dt class="type-labels">{{ phrase('agent.publish.sticky_words_title') }}</dt>
				<dd>
					<ul>
						{% for word in sticky_search_words %}
							<li><span>{{word}}</span></li>
						{% endfor %}
					</ul>
					<div class="explain">
						{{ phrase('agent.publish.search_sticky_words_explain') }}
					</div>
				</dd>
			</dl>
		</div>

		<br />

		{% include 'AgentBundle:Publish:rated-searches.html.twig' %}
	</div>
	{# /Tab: Search #}
</div>
{# /Main Tabs #}

<div class="inline-editable" style="display:none">
	<div class="title">
		<input type="text" name="title" value="{{ news.title }}"/>
		<input type="hidden" name="action" value="title" />
	</div>
</div>

<ul class="status-menu" data-option-name="status" style="display:none">
	<li data-option-value="published">{{ phrase('agent.kb.status_published') }}</li>
	<li data-option-value="hidden.unpublished">{{ phrase('agent.kb.hidden_status_unpublished') }}</li>
	<li data-option-value="archived">{{ phrase('agent.kb.status_archived') }}</li>
	{% if news.person.id == app.user.id %}
		<li data-option-value="hidden.draft">{{ phrase('agent.kb.hidden_status_draft') }}</li>
	{% endif %}
</ul>

{{ optionbox.category_ob(news_categories, 'News Categories', 'Apply', {'id': baseId ~ '_cat_ob'}) }}

{# scroll containers #}
</div></div></div></div>
{# /scroll containers #}
