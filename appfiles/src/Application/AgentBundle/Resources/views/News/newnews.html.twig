{% import 'AgentBundle:Common:agent-macros.html.twig' as agentui %}
<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.NewNews';

pageMeta.title = 'New Post';
pageMeta.uploadAttachUrl              = '{{ path('agent_accept_upload') }}';

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
{{ agentui.scroll_containers('page-new-news page-new-content') }}

<a class="tab-anchor" href="#">&nbsp;</a>

<form id="{{baseId}}_newnews" class="keybound-submit">

<div class="first section cat-section" id="{{baseId}}_cat_section">
	<div class="step">
		<span class="num">1</span>
		<span class="check">Done</span>
	</div>
	<div class="content">
		<div class="col">
			<h4>Category</h4>
			{% include 'AgentBundle:Common:select-standard.html.twig' with {
				'name': 'newnews[category_id]',
				'id': baseId ~ '_cat',
				'add_classname': 'category_id',
				'add_attr': '',
				'with_blank': 1,
				'blank_title': '',
				'categories': news_categories,
				'selected': state.newnews.category_id
			} %}
		</div>
		<div class="col">
			<h4 class="light">Status</h4>
			<select name="newnews[status]">
				<option value="published">Published</option>
				<option value="hidden.unpublished">Unpublished</option>
				<option value="hidden.draft">Draft</option>
				{% if constant('DP_DEBUG') %}
					<option value="hidden.validating" selected="selected">DEV: Validating</option>
				{% endif %}
			</select>
		</div>
		<br class="clear" />
	</div>
</div>

<div class="section title-section" id="{{baseId}}_title_section">
	<div class="step">
		<span class="num">2</span>
		<span class="check">Done</span>
	</div>
	<div class="content">
		<h4>Title</h4>
		<input type="title" name="newnews[title]" id="{{baseId}}_title" value="{{ state.newnews.title }}" />
	</div>
</div>

<div class="section article-section" id="{{baseId}}_content_section">
	<div class="step">
		<span class="num">3</span>
		<span class="check">Done</span>
	</div>
	<div class="content">
		<h4>Post</h4>
		<textarea type="text" name="newnews[content]" id="{{baseId}}_content">{{ state.newnews.content }}</textarea>
	</div>
</div>


<div class="section other-section" id="{{baseId}}_other_section">
	<div class="step">
		<span class="num">5</span>
		<span class="check">Done</span>
	</div>
	<div class="content">
		{# Tab Container #}
		<div class="tab-container">
			<nav id="{{baseId}}_other_props_tabs_wrap">
				<ul id="{{baseId}}_other_props_tabs">
					<li data-tab-for="> .tab-properties">Properties</li>
					<li data-tab-for="> .tab-attach">Attachments</li>
				</ul>
			</nav>
			<div class="content-wrapper" id="{{baseId}}_other_props_tabs_content" style="display: none">
				{# Tab Properties #}
				<div class="tab-properties" style="display: none">
					<dl>
						<dt class="prop">URL Slug</dt>
						<dd class="prop">
							<input type="input" name="newnews[slug]" id="{{baseId}}_slug" value="{{ state.newnews.slug }}" />
						</dd>

						<dt class="prop">Labels</dt>
						<dd class="prop">
							<div class="tags-wrap article-tags">
								<textarea>{% for label in state.newnews.labels %}{{label}},{% endfor %}</textarea>
							</div>
						</dd>
					</dl>
				</div>
				{# /Tab Properties #}

				{# Tab Attach #}
				<div class="tab-attach" style="display: none">
					<script class="template-upload" type="text/x-jquery-tmpl">
						<li class="uploading">${name} <span class="cancel"><button class="clean-gray xx-small">Cancel</button></span></li>
					</script>
					<script class="template-download" type="text/x-jquery-tmpl">
						<li class="uploaded">
							<input type="checkbox" checked="checked" name="newnews[attach][]" value="${blob_id}" />
							<a href="${download_url}" target="_blank">${filename}</a>
							<span class="size">${filesize_readable}</span>
						</li>
					</script>
					<h6>Attachments</h6>
					<div class="file-input">
						<input type="file" name="file-upload" multiple="multiple" /> <button class="clean-gray xxx-small">Upload</button>
					</div>
					<ul class="files file-list"></ul>
				</div>
				{# /Tab Attach #}
			</div>
		</div>
		{# /Tab Container #}
	</div>
</div>

<footer class="pop-footer">
	<div class="is-not-loading">
		<button class="submit-trigger clean-white">Create News Post <kbd>(alt+c)</kbd></button>
	</div>
	<div class="is-loading" style="padding-top: 9px;">
		<img src="{{ asset('images/spinners/loading-small.gif') }}" />
	</div>
</footer>

</form>

{{ agentui.scroll.containers.end() }}
