<section class="search-reuslts page-set" data-page="{{ page }}">
	{% for news in results %}
		<article class="row-item news news-{{news.id}} related-is-linkable" data-content-type="news" data-content-id="{{ news.id }}">
			<input class="item-select" type="checkbox" value="{{news.id}}" />
			<div class="top-row">
				<div class="top-row-left">
					<h3>
						<a data-route="page:{{ path('agent_news_view', {'news_id': news.id}) }}">{{ news.title }}</a>
					</h3>
				</div>
				<div class="top-row-right visible-related-content-controls">
					<div class="bound-faded"></div>
					<button class="clean-gray xxx-small related-link">Add as related</button>
					<button class="clean-gray xxx-small related-unlink">Remove as related</button>
				</div>
			</div>
			<hr class="clear-top" />
			{% if display_fields|length %}
				<div class="extra-fields">
					<ul>
						{% for field in display_fields %}
							{% if field == 'category' %}
								<li>
									<span class="prop-title">Category</span>
									<span class="prop-val">{{ news.category.full_title }}</span>
								</li>
							{% elseif field == 'author' %}
								<li>
									<span class="prop-title">Author</span>
									<span class="prop-val">{{ news.person.display_name }}</span>
								</li>
							{% elseif field == 'date_created' %}
								<li>
									<span class="prop-title">Date Created</span>
									<span class="prop-val">{{ news.date_created|date('M j, Y')}}</span>
								</li>
							{% endif %}
						{% endfor %}
					</ul>
					<br class="clear" />
				</div>
			{% else %}
				<br class="clear" />
			{% endif %}
		</article>
	{% endfor %}
</section>
