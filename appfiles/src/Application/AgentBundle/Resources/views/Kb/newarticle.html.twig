<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.NewArticle';

pageMeta.title = 'New Article';
pageMeta.uploadAttachUrl              = '{{ path('agent_accept_upload') }}';

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
{# scroll containers #}
<div class="layout-content with-scrollbar page-new-article page-new-content">
<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
<div class="scroll-viewport"><div class="scroll-content">
{# /scroll containers #}

<form id="{{baseId}}_newarticle">
<input type="hidden" name="pending_article_id" id="{{baseId}}_pending_article_id" value="0" />

<div class="pending-info" style="display: none;">
	<h3>Creating pending article (added by <span class="person-name"></span>)</h3>
	<div class="pending-ticket" style="display: none">
		 For Ticket:
		<a data-route="" class="with-route ticket-link"></a>
	</div>
	<div class="pending-reason" style="display: none"></div>
</div>

<div class="section cat-section" id="{{baseId}}_cat_section">
	<div class="step">
		<span class="num">1</span>
		<span class="check">{{ phrase('agent.done') }}</span>
	</div>
	<div class="content">
		<div class="col">
			<h4>Category</h4>
			{% include 'AgentBundle:Common:select-standard.html.twig' with {
				'name': 'newarticle[category_id]',
				'id': baseId ~ '_cat',
				'add_classname': 'category_id',
				'add_attr': '',
				'with_blank': 1,
				'blank_title': '',
				'categories': article_categories,
				'selected': state.newarticle.category_id|default(0)
			} %}
		</div>
		<div class="col">
			<h4 class="light">Status</h4>
			<select name="newarticle[status]">
				<option value="published">Published</option>
				<option value="hidden.unpublished">Unpublished</option>
				<option value="hidden.draft">Draft</option>
				{% if constant('DP_DEBUG') %}
					<option value="hidden.validating" selected="selected">DEV: Validating</option>
				{% endif %}
			</select>
		</div>
		<br class="clear" />
	</div>
</div>

<div class="section title-section" id="{{baseId}}_title_section">
	<div class="step">
		<span class="num">2</span>
		<span class="check">{{ phrase('agent.done') }}</span>
	</div>
	<div class="content">
		<h4>Title</h4>
		<input type="title" name="newarticle[title]" id="{{baseId}}_title" value="{{ state.newarticle.title }}" />
	</div>
</div>

<div class="section article-section" id="{{baseId}}_news_section">
	<div class="step">
		<span class="num">3</span>
		<span class="check">{{ phrase('agent.done') }}</span>
	</div>
	<div class="content">
		<h4>Article</h4>
		<textarea type="text" name="newarticle[content]" id="{{baseId}}_content">{{ state.newarticle.content }}</textarea>
	</div>
</div>


<div class="section other-section" id="{{baseId}}_other_section">
	<div class="step">
		<span class="num">5</span>
		<span class="check">{{ phrase('agent.done') }}</span>
	</div>
	<div class="content">
		{# Tab Container #}
		<div class="tab-container">
			<nav id="{{baseId}}_other_props_tabs_wrap">
				<ul id="{{baseId}}_other_props_tabs">
					<li data-tab-for="> .tab-properties">Properties</li>
					<li data-tab-for="> .tab-attach">Attachments</li>
				</ul>
			</nav>
			<div class="content-wrapper" id="{{baseId}}_other_props_tabs_content" style="display: none">
				{# Tab Properties #}
				<div class="tab-properties" style="display: none">
					<dl>
						<dt class="prop">URL Slug</dt>
						<dd class="prop">
							<input type="input" name="newarticle[slug]" id="{{baseId}}_slug" value="{{ state.newarticle.slug }}" />
						</dd>

						<dt class="prop">Labels</dt>
						<dd class="prop">
							<div class="tags-wrap article-tags">
								<span class="tag-icon"></span>
								<ul>
									{% for l in state.newarticle.labels %}
										<li>{{ l }}</li>
									{% endfor %}
								</ul>
							</div>
						</dd>
					</dl>
				</div>
				{# /Tab Properties #}

				{# Tab Attach #}
				<div class="tab-attach" style="display: none">
					<script class="template-upload" type="text/x-jquery-tmpl">
						<li class="uploading">${name} <span class="cancel"><button class="clean-gray xx-small">Cancel</button></span></li>
					</script>
					<script class="template-download" type="text/x-jquery-tmpl">
						<li class="uploaded">
							<input type="checkbox" checked="checked" name="newarticle[attach][]" value="${blob_id}" />
							<a href="${download_url}" target="_blank">${filename}</a>
							<span class="size">${filesize_readable}</span>
						</li>
					</script>
					<h6>Attachments</h6>
					<div class="file-input">
						<input type="file" name="file-upload" multiple="multiple" /> <button class="clean-gray xxx-small">Upload</button>
					</div>
					<ul class="files file-list"></ul>
				</div>
				{# /Tab Attach #}
			</div>
		</div>
		{# /Tab Container #}
	</div>
</div>

<div class="foot">
	<button class="dp-button submit-trigger">Create Article</button>
</div>

</form>

{# scroll containers #}
</div></div>
</div>
{# /scroll containers #}
