<table class="list" width="100%">
	{% for rev in article.revisions %}
		<tr class="rev-{{rev.id}}">
			<td width="30">{{ loop.index }}</td>
			<td>
				<span style="float:right">
					{{ rev.date_created|date('Y-m-d') }}
				</span>
				By {{ rev.person.display_name }}
			</td>
			<td width="150">
				<input type="radio" class="old" name="old" value="{{rev.id}}" /> |
				<input type="radio" class="new" name="new" value="{{rev.id}}" />
			</td>
		</tr>
	{% endfor %}
</table>
<div style="text-align: right">
	<button class="dp-button compare-trigger">Compare Selected</button>
</div>
