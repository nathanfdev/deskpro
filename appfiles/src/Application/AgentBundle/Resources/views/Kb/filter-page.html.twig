<section class="search-reuslts page-set" data-page="{{ page }}">
	{% for article in results %}
		<article class="article article-{{article.id}}">
			<input class="item-select" type="checkbox" value="{{article.id}}" />
			<div class="toprow">
				<div class="left">
					<span class="subject">
						<a class="with-route" data-route="page:{{ path('agent_kb_article', {'article_id': article.id}) }}">{{ article.title }}</a>
					</span>
				</div>
			</div>
			{% if display_fields|length %}
				<div class="extra-info">
					<ul>
						{% for field in display_fields %}
							{% if field == 'category' %}
								<li>
									<span class="prop-title">Category</span>
									<span class="prop-val">{{ article.category_names }}</span>
								</li>
							{% elseif field == 'author' %}
								<li>
									<span class="prop-title">Author</span>
									<span class="prop-val">{{ article.by_line }}</span>
								</li>
							{% elseif field == 'date_created' %}
								<li>
									<span class="prop-title">Date Created</span>
									<span class="prop-val">{{ article.date_created|date('M j, Y')}}</span>
								</li>
							{% elseif field == 'view_count' %}
								<li>
									<span class="prop-title">View Count</span>
									<span class="prop-val">{{ article.view_count|default(0) }}</span>
								</li>
							{% endif %}
						{% endfor %}
					</ul>
					<br class="clear" />
				</div>
			{% else %}
				<br class="clear" />
			{% endif %}
		</article>
	{% endfor %}
</section>