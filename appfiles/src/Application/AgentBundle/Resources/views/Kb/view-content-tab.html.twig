<div class="full-tab-content">
	<div class="article-content-wrap">
		{{ article.content|raw }}
		{% if article.attachments|length %}
			<ul class="attachment-list">
				{% for attach in article.attachments %}
					<li class="{% if attach.blob.isImage() %}is-image{% else %}icon icon-attachment icon-filetype-{{attach.blob.extension|default('none')}}{% endif %}" rel="message-{{message.id}}">
						{% if attach.blob.isImage() %}
							<a href="{{ attach.blob.download_url }}" target="_blank"><img src="{{ path('serve_blob', {'blob_auth_id': attach.blob.auth_id, 's': 50, 'size-fit': '1'}) }}" alt="" class="preview" /></a>
						{% endif %}
						<a href="{{ attach.blob.download_url }}" target="_blank">{{attach.blob.filename}}</a>
						<span class="size">({{ attach.blob.readable_filesize }})</span>
					</li>
				{% endfor %}
			</ul>
		{%endif%}
	</div>
	<div class="article-editor-wrap" style="display: none">
		<div class="article-editor">
			<textarea class="edit-content-field" name="aritcle[content]" rows="5" cols="50">{{ article.content }}</textarea>

			<br />

			Attached files:
			<input type="file" name="file-upload" multiple="multiple" /> <button class="clean-gray xxx-small">Upload</button>
			<script class="template-upload" type="text/x-jquery-tmpl">
				<li class="uploading">${name} <span class="cancel"><button class="clean-gray xx-small">Cancel</button></span></li>
			</script>
			<script class="template-download" type="text/x-jquery-tmpl">
				<li class="uploaded">
					<input type="checkbox" class="edit-content-attach" name="aritcle[attach]" value="${blob_id}" checked="checked" />
					<a href="${download_url}" target="_blank">${filename}</a>
					<span class="size">${filesize_readable}</span>
				</li>
			</script>
			<ul class="files file-list">
				{% for attach in article.attachments %}
					<li>
						<input type="checkbox" class="edit-content-attach" name="aritcle[attach]" value="{{ attach.blob.id }}" checked="checked" />
						<a href="{{ attach.blob.download_url }}" target="_blank">{{ attach.blob.filename }}</a>
						<span class="size">{{ attach.blob.readable_filesize }}</span>
					</li>
				{% endfor %}
			</ul>

			<br />

			<button class="dp-button editor-save-trigger small">Save</button>
			<button class="dp-button editor-cancel-trigger small">Cancel</button>
		</div>
	</div>
</div>
