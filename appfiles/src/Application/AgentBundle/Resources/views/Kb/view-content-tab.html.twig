<div class="full-tab-content">
	<div class="article-content-wrap">
		{{ content|raw }}
	</div>
	<div class="article-editor-wrap" style="display: none">
		<div class="article-editor">
			{% if state.article.content %}
				<div class="revert-message-notice">
					Unsaved changes were restored. <button class="revert-default">Discard and revert to default</button>
					<br />
					<textarea class="edit-content-field-default" style="display: none;">{{article.content}}</textarea>
				</div>
			{% endif %}
			<textarea class="edit-content-field" name="article[content]" rows="5" cols="50">{{ state.article.content|default(article.content) }}</textarea>

			<br />

			<button class="dp-button editor-save-trigger small">Save</button>
			<button class="dp-button editor-cancel-trigger small">Cancel</button>
		</div>
	</div>
</div>
