<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.KbPendingArticles';
pageMeta.title = 'Pending Articles';
</script>
<div class="content">
	<div class="add-dlg dp-overlay" style="display: none; width: 400px;">
		Add a description about the article that needs to be written:<br />
		<textarea class="comment" rows="2" cols="50" style="width: 98%;"></textarea><br />
		<div style="text-align: right">
			<button class="dp-button x-small save-trigger">Add</button>
		</div>
	</div>

	<div class="inner-box-tab-content top-box">
		<ul>
			<li>
				<label>Pending Articles</label>
				<span class="counter counter-pending">{{pending_articles|length}}</span>
			</li>
			<li class="total on">
				<label class="new-pending-article-trigger" style="cursor: pointer;">Add new pending article</label>
			</li>
		</ul>
	</div>

	<div class="pad pending-articles-wrap">
		<div class="inner-box-tab-content box-list no-pad">
			<table class="list" cellspacing="0" width="100%">
				<thead class="display-options-trigger dbl-click-trigger nosel">
					<tr>
						<th>Description</th>
						<th width="80">Create</th>
					</tr>
				</thead>

				<tbody class="pending-articles-list">
					{% for pending_article in pending_articles %}
						{% include 'AgentBundle:Kb:list-pending-row.html.twig' %}
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
</div>