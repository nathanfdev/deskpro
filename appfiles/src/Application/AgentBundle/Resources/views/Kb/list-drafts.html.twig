<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.KbList';
pageMeta.title = 'Drafts';
</script>
<div class="content">
	<div class="inner-box-tab-content top-box">
		<ul>
			<li>
				<label>Your Drafts</label>
				<span class="counter counter-your">{{your_articles|length}}</span>
			</li>
			<li>
				<label>Others Drafts</label>
				<span class="counter counter-other">{{others_articles|length}}</span>
			</li>
			<li class="total on">
				<label>Total</label>
				<span class="counter counter-total">{{your_articles|length + others_articles|length}}</span>
			</li>
		</ul>
	</div>

	{% if your_articles|length %}
	<div class="pad wrap-article">
		<h1>Your drafts</h1>
		<div class="inner-box-tab-content box-list no-pad">
			<table class="list" cellspacing="0" width="100%">
				<thead class="display-options-trigger dbl-click-trigger nosel">
					<tr>
						<th>Title</th>
					</tr>
				</thead>

				{% for art in your_articles %}
					<tr class="line-1 article article-{{art.id}}">
						<td>
							<a class="with-route" data-route="kb_article_edit:{{ path('agent_kb_article', {'article_id': art.id}) }}">
								{{ art.title }}
							</a>
						</td>
					</tr>
				{% endfor %}
			</table>
		</div>
	</div>
	{% endif %}

	{% if others_articles|length %}
	<div class="pad wrap-edit">
		<h1>Others drafts</h1>
		<div class="inner-box-tab-content box-list no-pad">
			<table class="list" cellspacing="0" width="100%">
				<thead class="display-options-trigger dbl-click-trigger nosel">
					<tr>
						<th>Title</th>
						<th>Author</th>
					</tr>
				</thead>

				{% for edit in validating_edits %}
					<tr class="line-1 article article-{{edit.article.id}}">
						<td>
							<a class="with-route" data-route="kb_article_edit:{{ path('agent_kb_article', {'article_id': edit.article.id}) }}">
								{{ edit.article.title }}
							</a>
						</td>
						<td>
							{{ edit.person.display_name }}
						</td>
					</tr>
				{% endfor %}
			</table>
		</div>
	</div>
	{% endif %}
</div>