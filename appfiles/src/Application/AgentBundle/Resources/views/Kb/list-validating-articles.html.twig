<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.KbValidatingArticles';
pageMeta.title = 'Validating Articles';
</script>
<div class="content">
	<div class="inner-box-tab-content top-box">
		<ul>
			<li>
				<label>Articles</label>
				<span class="counter counter-article">{{validating_articles|length}}</span>
			</li>
			<li>
				<label>Edits</label>
				<span class="counter counter-edit">{{validating_edits|length}}</span>
			</li>
			<li class="total on">
				<label>Total</label>
				<span class="counter counter-total">{{validating_articles|length + validating_edits|length}}</span>
			</li>
		</ul>
	</div>

	{% if validating_articles|length %}
	<div class="pad wrap-article">
		<h1>Articles awaiting validation</h1>
		<div class="inner-box-tab-content box-list no-pad">
			<table class="list" cellspacing="0" width="100%">
				<thead class="display-options-trigger dbl-click-trigger nosel">
					<tr>
						<th>Title</th>
						<th>Author</th>
						<th width="40"></th>
					</tr>
				</thead>

				{% for art in validating_articles %}
					<tr class="line-1 article article-{{art.id}}">
						<td>
							<a class="with-route" data-route="kb_article_view:{{ path('agent_kb_article', {'article_id': art.id, 'view': 1}) }}">
								{{ art.title }}
							</a>
						</td>
						<td>
							{{ art.person.display_name }}
						</td>
						<td>
							<a class="view-link article" href="{{ path('agent_kb_validating_preview_article', {'article_id': art.id}) }}">View</a>
						</td>
					</tr>
				{% endfor %}
			</table>
		</div>
	</div>
	{% endif %}

	{% if validating_edits|length %}
	<div class="pad wrap-edit">
		<h1>Edits awaiting validation</h1>
		<div class="inner-box-tab-content box-list no-pad">
			<table class="list" cellspacing="0" width="100%">
				<thead class="display-options-trigger dbl-click-trigger nosel">
					<tr>
						<th>Title</th>
						<th>Author</th>
						<th width="40"></th>
					</tr>
				</thead>

				{% for edit in validating_edits %}
					<tr class="line-1 article article-{{edit.article.id}}">
						<td>
							<a class="with-route" data-route="kb_article_view:{{ path('agent_kb_article', {'article_id': edit.article.id, 'view_edit': 1}) }}">
								{{ edit.article.title }}
							</a>
						</td>
						<td>
							{{ edit.person.display_name }}
						</td>
						<td>
							<a class="view-link edit" href="{{ path('agent_kb_validating_preview_edit', {'article_id': edit.article.id}) }}">View</a>
						</td>
					</tr>
				{% endfor %}
			</table>
		</div>
	</div>
	{% endif %}
</div>