<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.KbEditArticle';
pageMeta.title = {{article.title|json_encode|raw}};
pageMeta.article_id = {{article.id}};
</script>

<table cellspacing="0" cellpadding="0" width="100%">
	<tr>
		<td width="150">Title:</td>
		<td><input type="text" name="article[title]" value="{{article.title}}" style="width: 95%" /></td>
	</tr>
	<tr>
		<td width="150">Status:</td>
		<td>
			<label><input type="radio" name="article[status_code]" {% if article.status_code == 'published' %}checked="checked"{% endif %} value="published" /> Published</label><br />
			<label><input type="radio" name="article[status_code]" {% if article.status_code == 'archive' %}checked="checked"{% endif %} value="archive" /> Archived</label><br />
			<label><input type="radio" name="article[status_code]" {% if article.status_code == 'hidden.unpublished' %}checked="checked"{% endif %} value="hidden.unpublished" checked="checked" /> Unpublished</label><br />
			<label><input type="radio" name="article[status_code]" {% if article.status_code == 'hidden.draft' %}checked="checked"{% endif %} value="hidden.draft" /> Save as draft</label><br />
			<label><input type="radio" name="article[status_code]" {% if article.status_code == 'hidden.validating' %}checked="checked"{% endif %} value="hidden.validating" /> (Test validating)</label><br />
		</td>
	</tr>
	<tr>
		<td width="150">Publish date:</td>
		<td>
			<input type="text" name="article[date_published]" value="{% if article.date_published %}{{article.date_published|date('Y-m-d')}}{% endif %}" style="width: 75%" />
		</td>
	</tr>
	<tr>
		<td width="150">Unpublish date:</td>
		<td>
			<input type="text" name="article[date_end]" value="{% if article.date_end %}{{article.date_end|date('Y-m-d')}}{% endif %}" style="width: 75%" />
			<br />Action: <select name="article[end_action]">
				<option value="delete" {% if article.end_action == 'delete' %}checked="checked"{% endif %}>Archive article</option>
				<option value="archive" {% if article.end_action == 'archive' %}checked="checked"{% endif %}>Delete article</option>
			</select>
		</td>
	</tr>
	<tr>
		<td>Categories:</td>
		<td>
			<select name="article[categories][]" multiple="multiple" size="4">
				{% for k,v in category_names %}
					<option value="{{k}}" {% if k in article_categories %}selected="selected"{% endif %}>{{v}}</option>
				{% endfor %}
			</select>
		</td>
	</tr>
	{% if product_names %}
		<tr>
			<td>Products:</td>
			<td>
				<select name="article[products][]" multiple="multiple" size="4">
					{% for k,v in product_names %}
						<option value="{{k}}" {% if k in article_products %}selected="selected"{% endif %}>{{v}}</option>
					{% endfor %}
				</select>
			</td>
		</tr>
	{% endif %}
	<tr>
		<td>Content:</td>
		<td>
			<textarea name="article[content]" rows="10" cols="40" style="width: 95%">{% if validating_edit %}{{ validating_edit.content }}{% else %}{{article.content}}{% endif %}</textarea>
			{% if article.id and not validating_edit %}
				<br /><input type="checkbox" name="use_validating_edit" value="1" /> Put edit into validation (testing until we get permissions in admin)
			{% endif %}
		</td>
	</tr>
	{% if validating_edit %}
		<tr>
			<td>Highlighted Differences:</td>
			<td>
				<div class="diff-box" style="width: 95%; height: 200px; overflow: auto;">{{ validating_edit.renderDiff() }}</div>
			</td>
		</tr>
	{% endif %}
</table>

<div style="float:right">
	<button class="dp-button save-trigger">Save Article</button>
</div>