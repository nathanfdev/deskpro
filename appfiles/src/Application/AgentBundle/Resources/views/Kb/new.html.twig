<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.KbNewArticle';
pageMeta.title = 'New Article';
pageMeta.article_id = 0;
</script>

{% if pending_article %}
<div style="background: #EDEFF2; border:  2px solid #B2B9C2; padding:  8px;">
	<strong>Creating pending article</strong><br />
	{% if pending_article.ticket %}
		<a class="with-route" data-route="ticket:{{ path('agent_ticket_view', {'ticket_id': pending_article.ticket.id}) }}">
			{{ pending_article.ticket.subject }}
		</a><br />
	{% endif %}
	{{ pending_article.comment }}
	<input type="hidden" name="pending_article_id" value="{{pending_article.id}}" />
</div>
{% endif %}

<table cellspacing="0" cellpadding="0" width="100%">
	<tr>
		<td width="150">Title:</td>
		<td><input type="text" name="article[title]" value="{{article.title}}" style="width: 95%" /></td>
	</tr>
	<tr>
		<td width="150">Status:</td>
		<td>
			<label><input type="radio" name="article[status_code]" value="published" /> Published</label><br />
			<label><input type="radio" name="article[status_code]" value="hidden.unpublished" checked="checked" /> Unpublished</label><br />
			<label><input type="radio" name="article[status_code]" value="hidden.draft" /> Save as draft</label><br />
			<label><input type="radio" name="article[status_code]" value="hidden.validating" /> (Test validating)</label><br />
		</td>
	</tr>
	<tr>
		<td width="150">Publish date:</td>
		<td>
			<input type="text" name="article[date_published]" value="{% if article.date_published %}{{article.date_published|date('Y-m-d')}}{% endif %}" style="width: 75%" />
		</td>
	</tr>
	<tr>
		<td width="150">Unpublish date:</td>
		<td>
			<input type="text" name="article[date_end]" value="{% if article.date_end %}{{article.date_end|date('Y-m-d')}}{% endif %}" style="width: 75%" />
			<br />Action: <select name="article[end_action]">
				<option value="delete">Archive article</option>
				<option value="archive">Delete article</option>
			</select>
		</td>
	</tr>
	<tr>
		<td>Categories:</td>
		<td>
			<select name="article[categories][]" multiple="multiple" size="4">
				{% for k,v in category_names %}
					<option value="{{k}}" {% if k in article_categories %}selected="selected"{% endif %}>{{v}}</option>
				{% endfor %}
			</select>
		</td>
	</tr>
	{% if product_names %}
		<tr>
			<td>Products:</td>
			<td>
				<select name="article[products][]" multiple="multiple" size="4">
					{% for k,v in product_names %}
						<option value="{{k}}">{{v}}</option>
					{% endfor %}
				</select>
			</td>
		</tr>
	{% endif %}
	<tr>
		<td>Content:</td>
		<td><textarea name="article[content]" rows="10" cols="40" style="width: 95%">{{article.content}}</textarea></td>
	</tr>
</table>

<div style="float:right">
	<button class="dp-button save-trigger">Save Article</button>
</div>