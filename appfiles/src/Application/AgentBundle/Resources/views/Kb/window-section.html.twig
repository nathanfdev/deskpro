<header class="section-header">
	<h1>Knowledgebase</h1>
</header>
<section class="inbox">
	<ul class="nav-list">
		<li class="with-route" data-route="listpane:{{ path('agent_kb_validating') }}">
			<span class="list-counter" id="kb_validating_count">{{ kb_counts.awaiting_validation|default(0) }}</span>
			<a>Articles Validating</a>
		</li>
		<li class="with-route" data-route="listpane:{{ path('agent_kb_pending') }}">
			<span class="list-counter" id="kb_pending_count">{{ kb_counts.pending|default(0) }}</span>
			<a>Pending Articles</a>
		</li>
		<li class="with-route" data-route="listpane:{{ path('agent_kb_drafts') }}">
			<span class="list-counter" id="kb_pending_count">0</span>
			<a>Comments Validating</a>
		</li>
		<li class="with-route" data-route="listpane:{{ path('agent_kb_drafts') }}">
			<a>Draft Articles</a>
		</li>
		<li class="with-route" data-route="listpane:{{ path('agent_kb_glossary') }}">
			<a>Glossary</a>
		</li>
	</ul>
</section>


<header class="section-header with-tabs" style="margin-top: 28px;">
	<h1>Editor</h1>
	<nav id="kb_outline_tabstrip" class="deskpro-inner-tabstrip">
		<ul>
			<li class="user" data-tab-for="#kb_outline_usercats"><a>User</a></li>
			<li class="agent" data-tab-for="#kb_outline_agentcats"><a>Agent</a></li>
		</ul>
	</nav>
</header>
<section id="kb_outline_usercats" class="deskpro-tab-item" data-tab-trigger="#kb_outline_tabstrip li.user">
	<ul class="nav-list">
		{% for cat in kb_user_cats %}
			<li data-route="listpane:{{ path('agent_kb_cat', {'category_id':cat.id}) }}">
				<a {% if cat.depth %}style="margin-left: {{ 10 * cat.depth }}px"{% endif %}>{{ cat.title }}</a>
			</li>
		{% endfor %}
	</ul>
</section>
<section id="kb_outline_agentcats" class="deskpro-tab-item" data-tab-trigger="#kb_outline_tabstrip li.agent">
	<ul class="nav-list">
		{% for cat in kb_agent_cats %}
			<li data-route="listpane:{{ path('agent_kb_cat', {'category_id':cat.id}) }}">
				<a {% if cat.depth %}style="margin-left: {{ 10 * cat.depth }}px"{% endif %}>{{ cat.title }}</a>
			</li>
		{% endfor %}
	</ul>
</section>