<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.KbViewArticle';
pageMeta.title = {{article.title|json_encode|raw}};
pageMeta.article_id = {{article.id}};
</script>
{% if not is_preview %}
<div class="ticket-lock-bar" style="padding: 4px; text-align: right;">
	{% if article.status_code == "hidden.validating" %}
		<button class="dp-button x-small validate-trigger">Validate Article</button>
	{% endif %}
	<button class="dp-button x-small edit-trigger">Edit Article</button>
</div>
{% endif %}
		
<div style="float:right">
	{% if article.status_code == "published" %}Published
	{% elseif article.status_code == "archived" %}Archived
	{% elseif article.status_code == "hidden.unpublished" %}Unpublished
	{% elseif article.status_code == "hidden.draft" %}Draft
	{% elseif article.status_code == "hidden.validating" %}Validating
	{% elseif article.status_code == "hidden.deleted" %}Deleted
	{% endif %}
</div>
<h1>{{article.title}}</h1>
Author {{article.person.display_name}}<br /><br />

Date created: {{article.date_created|date('Y-m-d')}}<br />
{% if article.date_published %}Date published: {{article.date_published|date('Y-m-d')}}<br />{% endif %}
{% if article.date_end %}Date ends: {{article.date_end|date('Y-m-d')}} ({{ article.end_action }})<br />{% endif %}

{% if article_categories %}
<strong>Category:</strong>
<ul>
	{% for id in article_categories %}
		<li>{{ category_names[id] }}</li>
	{% endfor %}
</ul>

<br />
{% endif %}

{% if article_products %}
<strong>Product:</strong>
<ul>
	{% for id in article_products %}
		<li>{{ category_names[id] }}</li>
	{% endfor %}
</ul>
{% endif %}
<hr />
{{ article.content_html|raw }}