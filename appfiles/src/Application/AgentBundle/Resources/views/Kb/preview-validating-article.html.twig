<div class="diff-box">
	<input type="hidden" class="article_id" value="{{article.id}}" />
	<div class="overlay-title" style="padding:  6px;">
		{{ article.title }} added by {{ article.person.display_name }}
	</div>

	<div class="overlay-content" style="padding-bottom: 15px; max-height: 500px overflow: auto;">
		{{ article.content_plain_html }}
	</div>

	<div class="overlay-actions">
		<button class="approve-trigger dp-button small">Approve</button>
		<button class="disapprove-trigger dp-button small">Disapprove and delete</button>
	</div>
</div>