<section class="search-reuslts page-set" data-page="{{ page }}">
	{% for pending_article in pending_articles %}
		<article class="row-item pending-article pending-article-{{pending_article.id}}">
			<input
				class="item-select"
				type="checkbox"
				value="{{ pending_article.id }}"
				{% if pending_article.ticket %}
					data-ticket-route="page:{{ object_path_agent(pending_article.ticket) }}"
				{% endif %}
			/>
			{% if pending_article.ticket %}
				<div class="top-row">
					<div class="top-row-left">
						<h3>
							Ticket <a class="with-route" data-route="page:{{ object_path_agent(pending_article.ticket) }}">{{ pending_article.ticket.subject }}</a>
						</h3>
					</div>
					<div class="top-row-right buttons">
						<div class="bound-faded"></div>
						<button class="clean-white small pending-create">Create</button>
						<button class="clean-white small pending-delete">Delete</button>
					</div>
				</div>
			{% else %}
				<div class="top-row-right " style="padding: 3px; float: right;">
					<div class="bound-faded"></div>
					<span class="pending-create">Create</span>
					<span class="pending-delete">Delete</span>
				</div>
			{% endif %}
			{% if pending_article.comment %}
				<div class="comment-text" {% if not pending_article.ticket %}style="padding-top: 3px;" {% endif %}>
					{{ pending_article.comment }}
					<br class="clear" />
				</div>
			{% else %}
				<br class="clear" />
			{% endif %}
		</article>
	{% endfor %}
</section>
