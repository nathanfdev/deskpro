<!DOCTYPE HTML>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="robots" content="NOINDEX" />
	<meta http-equiv="X-UA-Compatible" content="IE=100" />
	<link rel="shortcut icon" id="favicon" href="{{ path('favicon', {}, true) }}" />

	<title>DeskPRO</title>

	{% include 'AgentBundle:Main:resources.html.twig' with {'no_interface_date': true} %}

	<script>
		var BASE_URL = '{{ path('user') }}';
		var ASSETS_BASE_URL = '{{ asset('') }}';
		var DESKPRO_PERSON_ID = {{ app.user.id }};
		var DESKPRO_SESSION_ID = {{ app.session.getEntityId() }};
		var DESKPRO_PROXY_KEY = '{{ app.session.getSessionSecret('proxy_key') }}';

		$(document).ready(function() {

			var findPerson = new DeskPRO.Agent.Widget.FindPerson();
			window.FIND_PERSON = findPerson;

			$('#person_find').click(function() {
				findPerson.open();
			});

			var agentSelector = new DeskPRO.Agent.Widget.AgentSelector({
				agentList: $('#agents_list'),
				multipleChoice: true
			});

			$('#agent_selector').click(function(ev) {
				agentSelector.open(ev);
			});
		});
	</script>
</head>
<body>

<button id="person_find" class="dp-button">Quick Find</button>
<button id="agent_selector" class="dp-button">Agent Selector</button>

<ul id="agents_list" style="display: none">
	{% for id,title in agent_names %}
		<li data-agent-id="{{id}}">
			<img src="{{ path('serve_person_picture_size', {'person_id': id, 'size': 30}) }}" alt="" width="30" height="30" />
			<a>{{title}}</a>
		</li>
	{% endfor %}
</ul>

</body>
</html>