<!DOCTYPE HTML>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="robots" content="NOINDEX" />
	<meta http-equiv="X-UA-Compatible" content="IE=100" />
	<link rel="shortcut icon" id="favicon" href="{{ path('favicon', {}, true) }}" />

	<title>DeskPRO</title>

	{% include 'AgentBundle:Main:resources.html.twig' with {'no_interface_date': true} %}

	<script>
		var BASE_URL = '{{ path('user') }}';
		var ASSETS_BASE_URL = '{{ asset('') }}';
		var DESKPRO_PERSON_ID = {{ app.user.id }};
		var DESKPRO_SESSION_ID = {{ app.session.getEntityId() }};
		var DESKPRO_PROXY_KEY = '{{ app.session.getSessionSecret('proxy_key') }}';

		$(document).ready(function() {

			var cw = $('#scrollable > .layout-content');
			cw.tinyscrollbar();
			$('div.scroll-content:first', this.contentWrapper).resize(function() {
				// When size changes within the pane, need to re-size the scroll
				cw.tinyscrollbar_update();
			});

			$('#add_height').click(function() {
				$('#test').append('<div>#<br />#<br />#<br />#<br />#<br />#<br />#<br /></div>');
			});
		});
	</script>

	<style>
		#test > div { background-color: #ccc; }
		#test > div:nth-child(2n+2) { background-color: red; }
	</style>
</head>
<body>

<button id="add_height">Add Lines</button>
<div id="scrollable" style="border:  1px solid #000; width: 300px; height: 200px; overflow: hidden; position: relative;">
	<div class="layout-content with-scrollbar page-new-ticket page-new-content">
		<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
		<div class="scroll-viewport">
			<div class="scroll-content" id="test">

				<div>#<br />#<br />#<br />#<br />#<br />#<br />#<br />#<br />#<br />#<br />#<br />#<br />#<br />#<br />#<br /></div>

			</div>
		</div>
	</div>
</div>

</body>
</html>
