{% for cat in cats %}
	<li class="{% if depth %}sub-list{% endif %} news-cat-{{ cat.id }}">
		<span class="list-counter" id="news_cat_count_{{ cat.id }}">{{ counts[cat.id]|default(0) }}</span>
		{% if cat.children|length %}
			<span class="sub-toggle">expand</span>
		{% endif %}
		<a data-route="listpane:{{ path('agent_news_list', {'category_id':cat.id}) }}">{{ cat.title }}</a>
		{% if cat.children|length %}
			<ul class="sub-group" style="display: none">
				{% include 'AgentBundle:Publish:news-cat-list.html.twig' with {'cats': cat.children, 'counts': counts, 'depth': depth+1 } %}
			</ul>
		{% endif %}
	</li>
{% endfor %}