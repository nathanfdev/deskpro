<section id="publish_outline_glossary" class="deskpro-tab-item">
	<ul class="navSimpleList">
		<li class="all">
			<span class="add-new tipped glossary-new-trigger" title="Add new glossary word">add</span>
			<a style="cursor: default;" class="groupHead">
				<span class="glossary-word-count">{{ glossary_count }}</span> words
			</span>
		</li>
	</ul>
	<div class="listingTicketLabels">
		<ul>
			{% for letter,words in glossary_words %}
				<li data-letter="{{letter}}" {% if not words|length %}style="display:none"{% endif %}>
					<a>{{ letter }}</a>
					<ul class="listingTicketChild">
						{% for id,word in words %}
							<li>
								<a class="glossary-word-trigger word-{{id}}" data-word-id="{{id}}">
								{{word}}
								</a>
							</li>
						{% endfor %}
					</ul>
				</li>
			{% endfor %}
		</ul>
	</div>

	<div class="glossary-add-dlg dp-overlay" style="display: none; width: 400px;">
		Add a new glossary word: <input type="text" class="word" value="" style="width: 150px;" /><br />
		<textarea class="content" rows="2" cols="50" style="width: 98%;"></textarea><br />
		<div style="text-align: right">
			<button class="dp-button x-small save-trigger">Add</button>
		</div>
	</div>

	<div class="glossary-edit-dlg dp-overlay" style="display: none; width: 400px;">
		<div class="form">
			<strong class="word"></strong>
			<input type="hidden" class="word_id" value="" />
			<textarea class="content" rows="2" cols="50" style="width: 98%;"></textarea><br />
			<div style="text-align: right">
				<button class="clean-gray xx-small delete-trigger">Delete</button>
				<button class="clean-gray xx-small save-trigger">Save</button>
			</div>
		</div>
		<div class="loading">Loading ...</div>
	</div>
</section>
