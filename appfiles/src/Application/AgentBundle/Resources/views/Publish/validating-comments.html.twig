<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.PublishValidatingComments';
</script>
<div class="layout-content">
<div class="content">

	<header class="section-header">
		<h1>
			Comments awaiting validating
		</h1>
	</header>

	<section class="comments-list deskpro-results-list">
		{% include 'AgentBundle:Publish:validating-comments-page.html.twig' %}
	</section>

</div>
</div>



<div class="content">
	<div class="inner-box-tab-content top-box">
		<ul>
			<li>
				<label>Comments</label>
				<span class="counter counter-your">{{comments|length}}</span>
			</li>
		</ul>
	</div>

	<div class="box-item-list">
		{% for comment in comments %}
			<div class="box-item comment comment-{{comment.id}}" data-comment-id="{{comment.id}}">
				<div class="head">
					<span style="float:right">
						By
						{% if comment.person %}
							<a class="with-route" data-route="person:{{ path('agent_person_view', {'person_id': comment.person.id}) }}">
								{{ comment.person.display_name }}
							</a>
						{% else %}

						{% endif %}
					</span>
					<a class="with-route" data-route="kb_article_edit:{{ path('agent_kb_article', {'article_id': comment.article.id}) }}">
						{{ comment.name }} &lt;{{comment.email}}&gt;
					</a>
				</div>
				<div class="content" style="display: none">
					{{ comment.content_html }}
				</div>
				<div class="foot">
					<div style="float:right">
						<button class="dp-button xx-small show-closed view-trigger">View</button>
						<button class="dp-button xx-small show-opened delete-trigger" style="display: none">Delete</button>
						<button class="dp-button xx-small show-opened ignore-trigger" style="display: none">Ignore</button>
						<button class="dp-button xx-small show-opened validate-trigger" style="display: none">Validate</button>
					</div>
					<span class="timeago" title="{{comment.date_created|date('c')}}">{{ comment.date_created|date('Y-m-d') }}</span>
				</div>
			</div>
		{% endfor %}
	</div>
</div>