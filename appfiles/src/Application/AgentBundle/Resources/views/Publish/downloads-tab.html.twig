<section id="publish_outline_downloads" class="deskpro-tab-item" data-editor-class="download-cat-editor">
	<div class="controls">
		<button class="clean-gray xxx-small" id="publish_outline_downloadscat_edittiles">Edit Titles</button>
		<button class="clean-gray xxx-small" id="publish_outline_downloadscat_addcat">Add Category</button>
	</div>
	<ul class="nav-list" id="publish_outline_downloadscat_list">
		<li class="all expanded">
			<span class="list-counter" id="dl_cat_count_0">{{ download_cats_counts[0]|default(0) }}</span>
			<a class="all-route" data-route="listpane:{{ path('agent_downloads_list') }}">All</a>
		</li>
		{% include 'AgentBundle:Publish:downloads-cat-list.html.twig' with {'cats': download_cats, 'counts': download_cats_counts, 'depth': 0 } %}
	</ul>

	{% include 'AgentBundle:Publish:category-editor.html.twig' with { 'categories': download_cats_full, 'classname': 'download-cat-editor', 'type': 'download', 'title': 'Download Categories' } %}
</section>
