<section id="publish_outline_downloads" class="deskpro-tab-item" data-editor-class="download-cat-editor">
	<ul class="source-list with-tree" id="publish_outline_downloadscat_list">
		<li class="all">
			<span class="edit-mode tipped" id="publish_outline_downloadscat_editmode" title="Edit categories">edit mode</span>
			<span class="add-new-cat tipped" id="publish_outline_downloadscat_addcat" title="Create a new category">create category</span>
			<span class="add-new-article tipped" id="publish_outline_downloads_add" title="Create a new download" data-newloader-name="newDownloadLoader">create download</span>
			<span class="all-route title" data-route="listpane:{{ path('agent_downloads_list') }}">{{ download_cats_counts['0_total']|default(0) }} Files</span>
		</li>
		{% include 'AgentBundle:Publish:downloads-cat-list.html.twig' with {'cats': download_cats, 'counts': download_cats_counts, 'depth': 0 } %}
	</ul>
</section>
