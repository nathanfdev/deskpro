<section class="source-section sys-filters-section">
	<ul class="source-list">
		<li data-route="listpane:{{ path('agent_publish_validatingcomments') }}">
			<h3 class="title">
				<span class="list-counter" id="publish_validating_comments_count">{{ counts.validating_comments|default(0) }}</span>
				{{ phrase('agent.publish.comments_to_validate') }}
			</h3>
		</li>
		<li class="with-route auto-load-route" data-route="listpane:{{ path('agent_public_validatingcontent') }}">
			<h3 class="title">
				<span class="list-counter" id="publish_validating_count">{{ counts.validating_content|default(0) }}</span>
				{{ phrase('agent.publish.content_to_validate') }}
			</h3>
		</li>
		<li data-route="listpane:{{ path('agent_kb_pending') }}">
			<h3 class="title">
				<span class="list-counter" id="kb_pending_count">{{ counts.pending|default(0) }}</span>
				{{ phrase('agent.publish.pending_articles') }}
			</h3>
		</li>
		<li data-route="listpane:{{ path('agent_public_drafts') }}">
			<h3 class="title">
				<span class="list-counter" id="publish_drafts_count">{{ counts.drafts|default(0) }}</span>
				{{ phrase('agent.publish.draft_content') }}
			</h3>
		</li>
		<li data-route="listpane:{{ path('agent_publish_searchlog') }}">
			<h3 class="title">{{ phrase('agent.publish.search_logs') }}</h3>
		</li>
	</ul>
</section>

<section class="source-tabs many" id="publish_outline_tabstrip">
	<ul>
		<li data-tab-for="#publish_outline_kb_tab"><span>Knowledgebase</span></li>
		<li data-tab-for="#publish_outline_news"><span>News</span></li>
		<li data-tab-for="#publish_outline_downloads" class="fill-out"><span>Files</span></li>
	</ul>
</section>

{% include 'AgentBundle:Publish:kb-tab.html.twig' %}
{% include 'AgentBundle:Publish:news-tab.html.twig' %}
{% include 'AgentBundle:Publish:downloads-tab.html.twig' %}

{# Category editor #}
<div id="publish_cat_editor_backdrop" class="backdrop cat-editor-backdrop" style="position: absolute; top:0;left:0;right:0;bottom:0; display: none;"></div>
<div id="publish_cat_editor_tab" class="cat-editor-tab" style="display: none">
	<input type="text" class="title" />
</div>
<div id="publish_cat_editor" class="cat-editor" style="display: none">
	<span class="close-trigger">x</span>
	<h5>{{ phrase('agent.usergroups') }}</h5>
	<div class="list">
		{% for ug in usergroups %}
			<label>
				<input type="checkbox" class="usergroup usergroup-{{ ug.id }} {% if ug.sys_name == 'everyone' %}everyone{% endif %}" value="{{ ug.id }}" />
				{% if ug.sys_name %}
					{{ phrase('agent.usergroup_' ~ ug.sys_name) }}
				{% else %}
					{{ ug.title }}
				{% endif %}
			</label>
		{% endfor %}
	</div>
</div>
<div id="publish_cat_editor_shadowbreak" class="cat-editor-shadow-breaker" style="display: none" />

<script type="text/x-deskpro-plain" id="publish_outline_cat_list_newitem">
	<li>
		<span class="edit-cat"></span>
		<span class="delete-cat"></span>
		<span class="sub-toggle"></span>
		<span class="title">
			<span class="title-edit">{{ phrase('agent.add_category') }}</span>
			<span class="list-counter" data-count="0">0</span>
		</span>
		<ul class="subGroup sub-group"></ul>
	</li>
</script>
