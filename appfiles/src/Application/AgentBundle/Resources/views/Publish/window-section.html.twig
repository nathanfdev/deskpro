<div class="yourPendingTicket">
	<ul class="navList">
		<li class="with-route" data-route="listpane:{{ path('agent_publish_validatingcomments') }}">
			<a class="groupHead">
				Comments To Validate
				<span class="listCounter" id="publish_validating_comments_count">{{ counts.validating_comments|default(0) }}</span>
			</a>
		</li>
		<li class="with-route auto-load-route" data-route="listpane:{{ path('agent_public_validatingcontent') }}">
			<a class="groupHead">
				Content To Validate
				<span class="listCounter" id="publish_validating_count">{{ counts.validating_content|default(0) }}</span>
			</a>
		</li>
		<li class="with-route" data-route="listpane:{{ path('agent_kb_pending') }}">
			<a class="groupHead">
				Pending Articles
				<span class="listCounter" id="kb_pending_count">{{ counts.pending|default(0) }}</span>
			</a>
		</li>
		<li class="with-route" data-route="listpane:{{ path('agent_public_drafts') }}">
			<a class="groupHead">
				Draft Content
				<span class="listCounter" id="publish_drafts_count">{{ counts.drafts|default(0) }}</span>
			</a>
		</li>
		<li class="with-route" data-route="listpane:{{ path('agent_publish_searchlog') }}">
			<a class="groupHead">Search Logs</a>
		</li>
	</ul>
</div>

<div class="listTabNavTicket" style="margin-top: 8px;">
	<div id="publish_outline_tabstrip" class="desproTabStrip">
		<ul>
			<li data-tab-for="#publish_outline_kb"><a>KB</a></li>
			<li data-tab-for="#publish_outline_news"><a>News</a></li>
			<li data-tab-for="#publish_outline_downloads"><a>Files</a></li>
			<li data-tab-for="#publish_outline_glossary"><a>Glossary</a></li>
		</ul>
		<br class="clear" />
	</div>
</div>

{% include 'AgentBundle:Publish:kb-tab.html.twig' %}
{% include 'AgentBundle:Publish:downloads-tab.html.twig' %}
{% include 'AgentBundle:Publish:news-tab.html.twig' %}
{% include 'AgentBundle:Publish:glossary-tab.html.twig' %}

{# Category editor #}
<div id="publish_cat_editor_backdrop" class="backdrop cat-editor-backdrop" style="position: absolute; top:0;left:0;right:0;bottom:0; display: none;"></div>
<div id="publish_cat_editor_tab" class="cat-editor-tab" style="display: none">
	<input type="text" class="title" />
</div>
<div id="publish_cat_editor" class="cat-editor" style="display: none">
	<span class="close-trigger">x</span>
	<h5>Usergroup Permissions</h5>
	<div class="list">
		<label><input type="checkbox" /> Usergroup 1</label>
		<label><input type="checkbox" /> Usergroup 2</label>
		<label><input type="checkbox" /> Usergroup 3</label>
		<label><input type="checkbox" /> Usergroup 4</label>
		<label><input type="checkbox" /> Usergroup 5</label>
		<label><input type="checkbox" /> Usergroup 6</label>
	</div>
</div>
<div id="publish_cat_editor_shadowbreak" class="cat-editor-shadow-breaker" style="display: none" />

<script type="text/x-deskpro-plain" id="publish_outline_cat_list_newitem">
	<li>
		<span class="listCounter" data-count="0">0</span>
		<span class="edit-cat">edit</span>
		<span class="delete-cat">delete</span>
		<span class="sub-toggle">expand</span>
		<a>New Category</a>
		<ul class="sub-group"></ul>
	</li>
</script>
