{% for cat in cats %}
	<li class="download-cat-{{ cat.id }} {% if cat.children|length %}has-children{% endif %}" data-category-id="{{ cat.id }}">
		<span class="list-counter" id="download_cat_count_{{ cat.id }}">{{ counts[cat.id]|default(0) }}</span>
		<span class="sub-toggle">expand</span>
		<a data-route="listpane:{{ path('agent_downloads_list', {'category_id':cat.id}) }}">{{ cat.title }}</a>
		<ul class="sub-group">
		{% if cat.children|length %}
			{% include 'AgentBundle:Publish:downloads-cat-list.html.twig' with {'cats': cat.children, 'counts': counts, 'depth': depth+1 } %}
		{% endif %}
		</ul>
	</li>
{% endfor %}
