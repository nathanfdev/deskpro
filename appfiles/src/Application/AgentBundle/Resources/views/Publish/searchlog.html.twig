{% import 'AgentBundle:Common:agent-macros.html.twig' as agentui %}
<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.PublishSearchLog';

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
{{ agentui.scroll_containers() }}

<header class="list-grouping-bar">
	<ul id="{{ baseId }}_tabs">
		<li data-tab-for="#{{ baseId }}_recentsearches" class="on">
			<a>Recent Searches</a>
		</li>
		<li data-tab-for="#{{ baseId }}_popularsearches">
			<a>Popular Searchs</a>
		</li>
		<li data-tab-for="#{{ baseId }}_popularlowsearches">
			<a>Popular Searches With Low Results</a>
		</li>
	</ul>
	<br style="clear: both; height: 1px; overflow: hidden; "/>
</header>

<div id="{{ baseId }}_recentsearches" style="display: none;">
	<div class="profile-box-container">
		<header>
			<h4>100 most recent searches</h4>
		</header>
		<section>
			<article>
				<table class="tickets-simple" width="100%" border="0" cellpadding="0" cellspacing="0">
					<thead>
						<tr>
							<th>Search Terms</th>
							<th width="100">Matches</th>
						</tr>
					</thead>
					<tbody>
						{% for search in recent_searches %}
							<tr class="line-1">
								<td>{{ search.query }}</td>
								<td>{{ search.num_results }}</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</article>
		</section>
	</div>
</div>

<div id="{{ baseId }}_popularsearches" style="display: none;">
	<div class="profile-box-container">
		<header>
			<h4>The most popular search terms</h4>
		</header>
		<section>
			<article>
				<table class="tickets-simple" width="100%" border="0" cellpadding="0" cellspacing="0">
					<thead>
						<tr>
							<th>Search Terms</th>
							<th width="100">Frequency</th>
							<th width="100">Matches</th>
						</tr>
					</thead>
					<tbody>
						{% for search in popular_searches %}
							<tr class="line-1">
								<td>{{ search.query }}</td>
								<td>{{ search.num_searches }}</td>
								<td>{{ search.num_results }}</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</article>
		</section>
	</div>
</div>

<div id="{{ baseId }}_popularlowsearches" style="display: none;">
	<div class="profile-box-container">
		<header>
			<h4>The most popular search terms that returned the least results</h4>
		</header>
		<section>
			<article>
				<table class="tickets-simple" width="100%" border="0" cellpadding="0" cellspacing="0">
					<thead>
						<tr>
							<th>Search Terms</th>
							<th width="100">Frequency</th>
							<th width="100">Matches</th>
						</tr>
					</thead>
					<tbody>
						{% for search in popular_searches_low %}
							<tr class="line-1">
								<td>{{ search.query }}</td>
								<td>{{ search.num_searches }}</td>
								<td>{{ search.num_results }}</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</article>
		</section>
	</div>
</div>

{{ agentui.scroll_containers_end() }}
