<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.PublishSearchLog';

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
<div class="layout-content">
<div class="content">

<header class="grouping-bar">
	<ul id="{{ baseId }}_tabs">
		<li data-tab-for="#{{ baseId }}_recentsearches" class="on">
			<span class="prop">Recent Searches</span>
		</li>
		<li data-tab-for="#{{ baseId }}_popularsearches">
			<span class="prop">Popular Searchs</span>
		</li>
		<li data-tab-for="#{{ baseId }}_popularlowsearches">
			<span class="prop">Popular Searches With Low Results</span>
		</li>
	</ul>
	<br style="clear: both; height: 1px; overflow: hidden; "/>
</header>

<div id="{{ baseId }}_recentsearches" style="display: none;">
	<div class="top-explain">
		These are the 100 most recent searches done by users.
	</div>
	<div class="inner-box-tab-content box-list">
		<table class="list" cellspacing="0" width="100%">
			<thead>
				<tr>
					<td>Search Terms</td>
					<td width="100">Matches</td>
				</tr>
			</thead>
			<tbody>
				{% for search in recent_searches %}
					<tr class="line-1">
						<td>{{ search.query }}</td>
						<td>{{ search.num_results }}</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
</div>

<div id="{{ baseId }}_popularsearches" style="display: none;">
	<div class="top-explain">
		These are the terms searched for most often.
	</div>
	<div class="inner-box-tab-content box-list">
		<table class="list" cellspacing="0" width="100%">
			<thead>
				<tr>
					<td>Search Terms</td>
					<td width="100">Frequency</td>
					<td width="100">Matches</td>
				</tr>
			</thead>
			<tbody>
				{% for search in popular_searches %}
					<tr class="line-1">
						<td>{{ search.query }}</td>
						<td>{{ search.num_searches }}</td>
						<td>{{ search.num_results }}</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
</div>

<div id="{{ baseId }}_popularlowsearches" style="display: none;">
	<div class="top-explain">
		These are the most popular search terms that get 0 results.
	</div>
	<div class="inner-box-tab-content box-list">
		<table class="list" cellspacing="0" width="100%">
			<thead>
				<tr>
					<td>Search Terms</td>
					<td width="100">Frequency</td>
					<td width="100">Matches</td>
				</tr>
			</thead>
			<tbody>
				{% for search in popular_searches_low %}
					<tr class="line-1">
						<td>{{ search.query }}</td>
						<td>{{ search.num_searches }}</td>
						<td>{{ search.num_results }}</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
</div>

</div>
</div>
