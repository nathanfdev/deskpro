<section class="search-reuslts page-set" data-page="{{ page }}">
	{% for comment in comments %}
		<article class="comment comment-{{comment.id}}">
			<div class="title">
				{{ comment.content_html_plain }}
			</div>
			<div class="info">
				<ul class="single-col">
					<li>
						By
						{% if comment.person %}<a class="with-route" data-route="page:{{ object_path_agent(comment.person) }}">{% endif %}
						{{ comment.user_name }} {% if comment.user_email %}&lt;{{ comment.user_email }}&gt;{% endif %}
						{% if comment.person %}</a>{% endif %}
					</li>
					<li>On <a class="with-route" data-route="page:{{ object_path_agent(comment.object) }}">{{ comment.object.title }}</a></li>
				</ul>
			</div>
			<div class="foot" style="padding-bottom: 3px; padding-left: 4px; padding-right: 4px;">
				<time class="timeago" datetime="{{ news.date_created|date('c') }}">{{ news.date_created|date('M d') }}</time>
				<div style="float:right;">
					<button class="dp-button x-small delete-trigger" data-url="{{ path('agent_publish_disapprove_comment', {'comment_id': comment.id, 'typename': get_type(comment, false) }) }}">Delete</button>
					<button class="dp-button x-small ignore-trigger">Ignore</button>
					<button class="dp-button x-small approve-trigger" data-url="{{ path('agent_publish_approve_comment', {'comment_id': comment.id, 'typename': get_type(comment, false) }) }}">Approve</button>
				</div>
				<br style="clear: both; height: 1px; overflow: hidden; "/>
			</div>
		</article>
	{% endfor %}
</section>