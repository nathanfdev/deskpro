<div class="category-editor field-overlay {{ classname }}" style="display: none">
	<span class="close-trigger">x</span>
	<div class="backdrop" style="display: none"></div>
	<div class="new-dlg field-overlay" style="display:none">
		<span class="new-close-trigger">x</span>
		Parent: <select>
			<option value="0" class="none">&lt;none&gt;</option>
		</select>
		<br />
		Title: <input type="text" value="" />
		<br />
		<button class="dp-button x-small add-save-trigger">Add</button>
	</div>
	<header>
		<div class="new">
			<button class="dp-button x-small add-trigger">Add Category</button>
		</div>
		<h4>{{ title }}</h4>
	</header>
	<section>
		<ul class="top">
			{% include 'AgentBundle:Publish:category-editor-set.html.twig' with {'categories': categories, 'depth': 0} %}
		</ul>
	</section>
	<footer>
		<button class="dp-button x-small save-all-trigger">Save Changes</button>
	</footer>
</div>