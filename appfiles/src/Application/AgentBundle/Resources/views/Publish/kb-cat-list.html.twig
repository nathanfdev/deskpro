{% for cat in cats %}
	<li class="kb-cat-{{ cat.id }} {% if cat.children|length %}has-children{% endif %}" data-category-id="{{ cat.id }}">
		<span class="edit-cat">edit</span>
		<span class="delete-cat" {% if counts[cat.id] %}style="display: none"{% endif %}>delete</span>
		<span class="sub-toggle">expand</span>
		<a data-route="listpane:{{ path('agent_kb_list', {'category_id':cat.id}) }}">
			<span class="title">{{ cat.title }}</span>
			<span class="listCounter list-counter"
				id="kb_cat_count_{{ cat.id }}"
				data-count="{{ counts[cat.id]|default(0) }}"
			>{{ counts[cat.id]|default(0) }}</span>
		</a>
		<ul class="subGroup sub-group">
			{% if cat.children|length %}
				{% include 'AgentBundle:Publish:kb-cat-list.html.twig' with {'cats': cat.children, 'counts': counts, 'depth': depth+1 } %}
			{% endif %}
		</ul>
	</li>
{% endfor %}
