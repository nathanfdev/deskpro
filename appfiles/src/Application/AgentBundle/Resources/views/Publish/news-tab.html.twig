<section id="publish_outline_news" class="deskpro-tab-item" data-editor-class="news-cat-editor">
	<ul class="source-list with-tree" id="publish_outline_newscat_list">
		<li class="all">
			<span class="edit-mode tipped" id="publish_outline_newscat_editmode" title="{{ phrase('agent.edit_categories') }}"></span>
			<span class="add-new-cat tipped" id="publish_outline_newscat_addcat" title="{{ phrase('agent.create_new_category') }}"></span>
				<span class="add-new-article tipped" id="publish_outline_news_add" title="{{ phrase('agent.create_news') }}" data-newloader-name="newNewsLoader"></span>
			<span class="all-route title" data-route="listpane:{{ path('agent_news_list') }}">{{ news_cats_counts['0_total']|default(0) }} Posts</span>
		</li>
		{% include 'AgentBundle:Publish:news-cat-list.html.twig' with {'cats': news_cats, 'counts': news_cats_counts, 'depth': 0 } %}
	</ul>
</section>
