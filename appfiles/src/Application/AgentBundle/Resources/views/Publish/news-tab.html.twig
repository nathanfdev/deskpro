<section id="publish_outline_news" class="deskpro-tab-item" data-editor-class="news-cat-editor">
	<div class="controls">
		<button class="clean-gray xxx-small" id="publish_outline_newscat_edittiles">Edit Titles</button>
		<button class="clean-gray xxx-small" id="publish_outline_newscat_addcat">Add Category</button>
	</div>
	<ul class="nav-list" id="publish_outline_newscat_list">
		<li class="all expanded">
			<span class="list-counter" id="news_cat_count_0">{{ news_cats_counts[0]|default(0) }}</span>
			<a class="all-route" data-route="listpane:{{ path('agent_news_list') }}">All</a>
		</li>
		{% include 'AgentBundle:Publish:news-cat-list.html.twig' with {'cats': news_cats, 'counts': news_cats_counts, 'depth': 0 } %}
	</ul>

	{% include 'AgentBundle:Publish:category-editor.html.twig' with { 'categories': news_cats_full, 'classname': 'news-cat-editor', 'type': 'news', 'title': 'News Categories' } %}
</section>
