<section id="publish_outline_kb" class="deskpro-tab-item" data-editor-class="kb-cat-editor">
	<ul class="nav-list">
		<li data-route="listpane:{{ path('agent_kb_list') }}">
			<a>All</a>
		</li>
		{% for cat in kb_cats %}
			<li data-route="listpane:{{ path('agent_kb_list', {'category_id':cat.id}) }}">
				<a {% if cat.depth %}style="margin-left: {{ 10 * cat.depth }}px"{% endif %}>{{ cat.title }}</a>
			</li>
		{% endfor %}
	</ul>

	{% include 'AgentBundle:Publish:category-editor.html.twig' with { 'categories': kb_cats_full, 'classname': 'kb-cat-editor', 'title': 'KB Categories' } %}
</section>