<article class="comment {{ info.content_type }}-{{content.id}} {{ get_type(comment.object)|lower }}">
	<div class="edit-comment" style="display: none">
		<textarea>{{ comment.content }}</textarea><br />
		<button class="clean-gray xxx-small comment-editsave-trigger">Save</button>
		<button class="clean-gray xxx-small comment-editcancel-trigger">Cancel</button>
	</div>
	<div class="comment-display">
		<input
			class="item-select"
			type="checkbox"
			value="{{ info.content_type }}.{{info.content_id}}"
			data-content-type="{{ info.content_type }}"
			data-comment-id="{{ comment.id }}"
		/>
		<div class="comment-row">
			<div class="rendered">
				{{ comment.content|raw }}
			</div>
		</div>
		<div class="comment-info">
			{{ get_type(comment.object) }}: <a class="with-route" data-route="page:{{ object_path_agent(comment.object) }}">{{ comment.object.title }}</a>
		</div>
		<div class="comment-foot">
			<div class="by-line">
				By
				{% if comment.person %}<a class="with-route person-tip" data-person-id="{{ comment.person.id }}" data-route="page:{{ object_path_agent(comment.person) }}">{% endif %}
				{{ comment.user_name }} {% if comment.user_email %}&lt;{{ comment.user_email }}&gt;{% endif %}
				{% if comment.person %}</a>{% endif %}
			</div>
			<div class="comment-controls">
				<div class="bound-faded"></div>
				<button class="clean-gray xxx-small validate-approve">Approve</button>
				<button class="clean-gray xxx-small validate-delete">Delete</button>
				<button class="clean-gray xxx-small validate-create-ticket">Create Ticket</button>
				<button class="clean-gray xxx-small validate-edit">Edit</button>
			</div>
		</div>
	</div>
</article>
