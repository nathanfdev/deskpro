<section id="publish_outline_glossary">
	<ul class="source-list">
		<li class="all on">
			<span class="add-new tipped glossary-new-trigger" title="Add new glossary word">add</span>
			<span class="title">
				Glossary
			</span>
		</li>
	</ul>

	<section class="source-labels-list">
		<dl>
			{% for letter,words in glossary_words %}
				<dt data-letter="{{ letter }}" {% if not words|length %}style="display: none"{% endif %}>{{ letter }}</dt>
				<dd data-letter="{{ letter }}" {% if not words|length %}style="display: none"{% endif %}>
					<ul>
						{% for id,word in words %}
							<li>
								<span class="glossary-word-trigger word-{{id}}" data-word-id="{{id}}">
								{{word}}
								</span>
							</li>
						{% endfor %}
					</ul>
				</dd>
			{% endfor %}
		</dl>
	</section>

	<div class="glossary-add-dlg dp-overlay" style="display:none;">
		<div class="overlay-title"><h4>Add a new glossary word</h4></div>
		<div class="overlay-content">
			<input type="text" class="word" value="" style="width: 150px; margin-bottom: 5px;" placeholder="Word title" /><br />
			<textarea class="content" rows="2" cols="50" style="width: 98%; height: 175px;" placeholder="Definition"></textarea>
		</div>
		<div class="overlay-footer">
			<button class="clean-white save-trigger">Add</button>
		</div>
	</div>

	<div class="glossary-edit-dlg dp-overlay" style="display:none;">
		<div class="overlay-title"><h4>Edit glossary word</h4></div>
		<div class="overlay-content">
			<div class="form">
				<strong class="word"></strong><br />
				<input type="hidden" class="word_id" value="" />
				<textarea class="content" rows="2" cols="50" style="width: 98%; height: 165px"></textarea>
			</div>
		</div>
		<div class="overlay-footer">
			<button class="clean-white delete-trigger">Delete</button>
			<button class="clean-white save-trigger">Save</button>
		</div>
	</div>
</section>
