<ul>
{% for status in statuses %}
	<li class="tweet-item" data-status-id="{{ status.id }}">
		<div class="head">
		{% if status.in_reply_to_status or status.in_reply_to_user %}
			{# <span class="response">In response to @ " ..."</span> #}
		{% endif %}
			<cite>{{ status.user.name }} / @{{ status.user.screen_name }}</cite>
		</div>
		<div class="photo" data-route="page:{{ path('agent_twitter_user', {'user_id': status.user.id}) }}"><img src="{{ status.user.profile_image_url }}" border="0" /></div>
		<div class="content">
			<div class="tweet">{{ status.text }}</div>
			<div class="notes">
				<div class="note">
					<em class="time">{{ status.date_created|date('m/d/Y H:i:s') }}{# 22 minutes ago #}</em>
				</div>
			{% for note in status.notes %}
				<div class="note" data-note-id="{{ note.id }}">
					<span class="person">{{ note.person.display_name }}</span>
					<em class="time">{{ status.date_created|date('m/d/Y H:i:s') }}</em>
					<div class="text">{{ note.text }}</div>
				</div>
			{% endfor %}
			</div>
			<div class="controls">
				<ul>
					<li class="archive"><a>{% if status.is_archived %}Archived{% else %}Archive{% endif %}</a></li>
					<li class="reply"><a>Reply</a></li>
					<li class="retweet"><a>Retweet</a></li>
					<li class="assign"><a>Assign</a></li>
					<li class="note"><a>Add Note</a></li>
				</ul>
			</div>
		</div>
	</li>
{% endfor %}
</ul>