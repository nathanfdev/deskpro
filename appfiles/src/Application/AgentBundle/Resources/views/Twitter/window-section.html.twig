{% for account in accounts %}
<header class="section-header" style="margin-top: 28px;">
	<nav class="mode-buttons">
		<ul>
			<li class="with-route" data-route="listpane:{{ path('agent_twitter_statuses_list', {'account_id': account.id}) }}">List</li>
		</ul>
	</nav>
	<h1>@{{ account.user.screen_name }}</h1>
</header>
<ul class="nav-list">
	<li class="" data-route="listpane:{{ path('agent_twitter_messages_list', {'account_id': account.id}) }}">
		<span class="list-counter" id="twitter_{{ account.id }}_direct_count">{{ account.timeline.count }}</span>
		Direct
	</li>
	<li class="" data-route="listpane:{{ path('agent_twitter_replies_list', {'account_id': account.id}) }}">
		<span class="list-counter" id="twitter_{{ account.id }}_replies_count">{{ account.user.replies.count }}</span>
		Replies
	</li>
	<li class="" data-route="listpane:{{ path('agent_twitter_mentions_list', {'account_id': account.id}) }}">
		<span class="list-counter" id="twitter_{{ account.id }}_mentions_count">{{ account.user.mentions.count }}</span>
		Mentions
	</li>
	<li class="" data-route="listpane:{{ path('agent_twitter_retweets_list', {'account_id': account.id}) }}">
		<span class="list-counter" id="twitter_{{ account.id }}_retweets_count">0</span>
		ReTweets
	</li>
	<li class="" data-route="">
		<span class="list-counter" id="twitter_{{ account.id }}_new_followers_count">0</span>
		New Followers
	</li>
	<li class="" data-route="">
		<span class="list-counter" id="twitter_{{ account.id }}_searches_count">{{ account.searches.count }}</span>
		Searches
	</li>
	<li class="" data-route="">
		<span class="list-counter" id="twitter_{{ account.id }}_followers_count">{{ account.followers.count }}</span>
		Followers
	</li>
	<li class="" data-route="listpane:{{ path('agent_twitter_outgoing_list', {'account_id': account.id}) }}">
		<span class="list-counter" id="twitter_{{ account.id }}_sent_count">{{ account.user.statuses.count }}</span>
		Sent
	</li>
</ul>
{% endfor %}