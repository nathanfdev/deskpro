{% block content %}
	<table cellspacing="0" cellpadding="0" width="100%">
	{% for account in accounts %}
		{% if loop.first or loop.index0 is divisibleby(3) %}<tr>{% endif %}
			<td valign="top" width="50%">
				<div class="inner-container">
					<div class="inner-container-title labels-index">
						<h3><a data-route="listpane:{{ path('agent_twitter_statuses', {'account_id': account.id}) }}">@{{ account.user.screen_name }}</a></h3>
					</div>
					<div class="inner-container-content with-scrollbar" id="twitter-account-{{ account.id }}">
						<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
						<div class="viewport"><div class="overview">
							<ol>
								<li class="" data-route="">
									<span class="list-counter" id="twitter_{{ account.id }}_direct_count">{{ account.timeline.count }}</span>
									Direct
								</li>
								<li class="" data-route="">
									<span class="list-counter" id="twitter_{{ account.id }}_replies_count">{{ account.user.replies.count }}</span>
									Replies
								</li>
								<li class="" data-route="">
									<span class="list-counter" id="twitter_{{ account.id }}_mentions_count">{{ account.user.mentions.count }}</span>
									Mentions
								</li>
								<li class="" data-route="">
									<span class="list-counter" id="twitter_{{ account.id }}_retweets_count">0</span>
									ReTweets
								</li>
								<li class="" data-route="">
									<span class="list-counter" id="twitter_{{ account.id }}_new_followers_count">0</span>
									New Followers
								</li>
								<li class="" data-route="">
									<span class="list-counter" id="twitter_{{ account.id }}_searches_count">{{ account.searches.count }}</span>
									Searches
								</li>
								<li class="" data-route="">
									<span class="list-counter" id="twitter_{{ account.id }}_followers_count">{{ account.followers.count }}</span>
									Followers
								</li>
								<li class="" data-route="">
									<span class="list-counter" id="twitter_{{ account.id }}_sent_count">{{ account.user.statuses.count }}</span>
									Sent
								</li>
							</ol>
						</div></div>
					</div>
				</div>
			</td>
		{% if loop.last or loop.index is divisibleby(3) %}</tr>{% endif %}
	{% endfor %}
	</table>
{% endblock %}
