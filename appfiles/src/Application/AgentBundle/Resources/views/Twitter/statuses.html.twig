<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.Twitter';
pageMeta.title = '@{{ account.user.screen_name|escape }}';
pageMeta.getStatusesUrl = '{{ path('agent_twitter_statuses', {'account_id': account.id}) }}?partial=1';
pageMeta.saveArchiveUrl = '{{ path('agent_twitter_ajaxsave_archive') }}';
pageMeta.saveNoteUrl = '{{ path('agent_twitter_ajaxsave_note') }}';
</script>

<style type="text/css" media="screen">
	.twitter-head {
		background-color: #F0EFE4;
		border-bottom: 1px solid #A6A594;
		padding: 4px;
	}

	.twitter-head .display-options {
		float: right;
		font-size: 10px;
	}

	.twitter-listing > ul > li {
		margin-bottom: 10px;
		background-color: #F7F9FA;
		clear: both;
	}

	.twitter-listing ul li .head {
		background-color: #DDE4EB;
		font-size: 10px;
		padding: 2px;
	}

	.twitter-listing ul li .head cite {

	}

	.twitter-listing ul li .head span.response {
		float: right;
	}

	.twitter-listing ul li .photo {
		float: left;
		width: 48px;
	}

	.twitter-listing ul li .photo img {
		width: 48px;
		height: 48px;
	}

	.twitter-listing ul li .content {
		margin-left: 55px;
	}

	.twitter-listing ul li .content .tweet {
		background-color: #fff;
		padding: 8px;
	}

	.twitter-listing ul li .content .notes {
		font-size: 10px;
		padding-left: 20px;
	}

	.twitter-listing ul li .content .note {

	}

	.twitter-listing ul li .content .note em {
		color: #838D96;
		padding-left: 5px;
	}

	.twitter-listing ul li .content .controls li {
		float: right;
		padding-right: 10px;
		font-size: 10px;
	}

	.twitter-note {
		display: none;
	}
</style>

<div class="twitter-note">
	<form>
		<textarea name="text" rows="2" cols="40"></textarea>
	</form>
</div>

<div class="twitter-head">
	@{{ account.user.screen_name }} stream
	<div class="display-options">
		<div style="float:right">
			<select name="sortbydate">
				<option name="asc">Oldest First</option>
				<option name="desc">Newest First</option>
			</select>
		</div>
		<div style="margin-right:120px">
			<input name="account" type="checkbox" /> Show @{{ account.user.screen_name }}'s tweets<br />
			<input name="archived" type="checkbox" /> Show archived tweets
		</div>
	</div>
	<br style="clear:both" />
</div>

<div class="twitter-listing">
	{% include 'AgentBundle:Twitter:part-statuses.html.twig' %}
</div>
