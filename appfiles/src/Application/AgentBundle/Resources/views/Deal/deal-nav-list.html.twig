{% set count = ''%}
{% set dealType = ''%}

<ul class="sub-group">
{% for  deals in opendeals%}
    {% for deal in deals%}
        {% if loop.index == 1%}
            {% set count = deal%}
        {%else%}
            {% set dealType = deal%}
        {%endif%}    
    {%endfor%}

    <li>
        <span class="title" data-route="listpane:">
                <span class="list-counter" id="deals_enterprise_sale">{{count|default(0)}}</span>
                {{dealType}}
        </span>
     </li>


{%endfor%}
</ul>