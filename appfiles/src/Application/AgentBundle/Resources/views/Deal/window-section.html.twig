<section class="source-section sys-filters-section">
	<header>
		<h1>Open Deals</h1>
	</header>
        <ul class="source-list">
             <li class="sub-expanded">
                <h3 class="title">
                    <span class="list-counter" id="">{{my_total_opendeals|default(0)}}</span>
                    My Deals
                </h3>
                 {% include 'AgentBundle:Deal:deal-nav-list.html.twig' with{'opendeals': myopendeals} %}
            </li>

            <li class="sub-expanded">
                <h3 class="title">
                    <span class="list-counter" id="">0</span>
                    Others Deals
                </h3>
                 {% include 'AgentBundle:Deal:deal-nav-list.html.twig' with{'opendeals': otheropendeals} %}
            </li>
        </ul>    
</section>

<section class="source-section sys-filters-section">
        <header>
            <h1>Closed Deals</h1>
	</header>

        <ul class="source-list">
            <li class="sub-expanded">
                <h3 class="title">
                    <span class="list-counter" id="">0</span>
                    My Deals
                </h3>
                <ul class="sub-group">
                     <li>
                        <span class="title" data-route="listpane:">
                                <span class="list-counter" id="mydeal_won">0</span>
                                Won
                        </span>
                     </li>
                     <li>
                        <span class="title" data-route="listpane:">
                                <span class="list-counter" id="mydeal_lost">0</span>
                                Lost
                        </span>
                     </li>
                </ul>
            </li>

            <li class="sub-expanded">
                <h3 class="title">
                    <span class="list-counter" id="">0</span>
                    Others Deals
                </h3>
                <ul class="sub-group">
                     <li>
                        <span class="title" data-route="listpane:">
                                <span class="list-counter" id="mydeal_won">0</span>
                                Won
                        </span>
                     </li>
                     <li>
                        <span class="title" data-route="listpane:">
                                <span class="list-counter" id="mydeal_lost">0</span>
                                Lost
                        </span>
                     </li>
                </ul>
            </li>

        </ul>
</section>

