        <div class="top-row-left">
            <h3>
                <a class="name click-through">{{deal.title}}</a>
            </h3>

        </div>
        <div class="top-row-right">
            <span>{{deal.deal_stage.name}}</span><span> {{deal.deal_currency.symbol}}{{deal.deal_value}}</span>
        </div>        
