            <li>User: Chris Parfield and Jhon Brigs</li>
            <li>|</li>
            <li>Organization: BBC</li>
        </ul>
    </div>
    <div class="clear"></div>
    <div class="extra-fields">
        <ul >
            <li><span class="prop-val email_address">Property: XYZ</span></li>
            <li><span class="prop-val email_address">Property: XYZ</span></li>
        </ul>
