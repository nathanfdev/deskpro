<article class="row-item item-list" data-route="page:{{ path('agent_deal_view', {'deal_id': deal.id|default('0')}) }}">
    <div class="top-row">
        <div class="top-row-left">
            <h3>
                <a class="name click-through">{{deal.title}}</a>
            </h3>

        </div>
        <div class="top-row-right">
            <span>{{deal.deal_stage.name}}</span><span> {{deal.deal_currency.symbol}}{{deal.deal_value}}</span>
        </div>        
    </div>
    <hr class="clear-top">
    <div style="margin-left: 22px;">
        <ul class="controls">
            <li>User: 
            {% for person in deal.peoples%}
                <a class="name click-through" data-route="person:{{ path('agent_people_view', {'person_id': person.id|default('0')}) }}">
                    {{ person.display_name }}
                </a>
                {% if loop.index >= 1 and loop.index != loop.last%}
                    and
                {%endif%}
                    
             {% endfor%}
            </li>
            <li>|</li>
            <li>Organization: 
            {% for organization in deal.organizations%} 
                <a class="with-route" data-route="person:{{ path('agent_org_view', {'organization_id': organization.id}) }}">{{organization.name}}</a>
                {% if loop.index >= 1 and loop.index != loop.last%}
                    and
                {%endif%}
            {% endfor%}
            </li>
        </ul>
    </div>
    <div class="clear"></div>
    <div class="extra-fields">
        <ul >
            <li><span class="prop-val email_address">Property: XYZ</span></li>
            <li><span class="prop-val email_address">Property: XYZ</span></li>
        </ul>
        <br class="clear">
    </div>
</article>
