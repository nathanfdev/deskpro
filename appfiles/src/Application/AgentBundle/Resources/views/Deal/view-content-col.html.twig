{#People BOX#}
<div class="profile-box-container people-box first" >

    <header>
        <h4>People</h4>
    </header>
    <section id="{{baseId}}_people_box_person">
    <article>
        <div class="meta-line">
            <dl class="table-list">
                <dt class="type-labels">Agent</dt>
                <dd class="controls">
                    <span class="agent-link prop-agent-id">{{deal.assigned_agent.display_name|default('Unassigned')}}</span><span class="edit-gear" id="{{baseId}}_assign_ob_trigger"></span>
                </dd>
                <dd class="assignments">
                    <ul id="{{baseId}}_assign_btn">
                            <li class="no-changes"><em>Set assignments</em></li>
                            <li style="display:none" class="assign-agent"><em>Assign agent</em>: <span class="label"></span></li>

                    </ul>
                </dd>    
            </dl>
        </div>
        
        <div class="meta-line">
            <dl class="table-list">
                <dt class="type-labels">Users</dt>
                <dd>
                    <ul class="controls" id="{{baseId}}_members_list">

                        {% for person in deal.peoples%}
                        <li class="member-row member-{{ person.id }}" data-person-id="{{ person.id }}">
                                <span data-person-id="{{ person.id }}"><b>{{ person.display_name }}</b> &lt;{{person.primary_email.email}}&gt; </span>
                                <span class="remove btn-small-remove remove-row-trigger">x</span>
                                
                        </li>
                        {% endfor%}
                        <li class="newpersonrow" id="{{baseId}}_person_assign_btn"><span class="btn-small-add"></span>Add User</li>
                        
                    </ul>
                </dd>
                <dd>                       
                        <button class="clean-white small switch-user" id="{{baseId}}_switch_user" style="display: none">Change User</button>
                        <div id="{{baseId}}_choose_user" style="display:none;" class="choose-user" >
                                <div
                                        id="{{baseId}}_user_searchbox"
                                        data-element-handler="DeskPRO.Agent.ElementHandler.PersonSearchBox"
                                        data-search-url="{{ path('agent_peoplesearch_performquick', {'format': 'json', 'limit': 10, 'start_with': 'a'}) }}"
                                        data-highlight-term="1"
                                        data-touch-focus="1"
                                        data-search-param="term"
                                        data-position-bound="#{{baseId}}_userselect"
                                >
                                    Person:
                                        <input type="text" id="{{baseId}}_userselect" class="select-user term" placeholder="Choose a person to create this ticket for" />
                                        <input type="hidden" name="newdeal[person][id]" value="{{ deal.person.id }}" class="person-id" id="{{baseId}}_person_id" />

                                        <script type="text/x-deskpro-tmpl" class="user-row-tpl">
                                                <li>
                                                    <a>
                                                        <span class="user-name"></span>
                                                        <address>&lt;<span class="user-email"></span>&gt;</address>
                                                        <div class="bound-fade"></div>
                                                    </a>
                                                </li>
                                        </script>
                                        <div class="person-search-box" style="display: none">
                                                <section>
                                                        <ul class="results-list">

                                                        </ul>
                                                        <footer>
                                                                <span class="create-user">Create a new person</span>
                                                        </footer>
                                                </section>
                                        </div>
                                </div>
                        </div>
                        <div id="{{baseId}}_user_choice">

                        </div>
                        <br class="clear" />
                </dd>
            </dl>
        </div>

        <div class="meta-line">
            <dl class="table-list">
                <dt class="type-labels">Organizations</dt>
                <dd>
                    <ul class="controls" id="{{baseId}}_organizations_list">
                        {% for organization in deal.organizations%} 
                            <li class="organization-row organization-{{ organization.id }}" data-organization-id="{{ organization.id }}">
                                <span> {{organization.name}} </span>
                                <span class="remove btn-small-remove remove-row-trigger"></span>
                            </li>
                        {% endfor%}
                            <li class="neworgrow" id="{{baseId}}_org_assign_btn"><span class="btn-small-add"></span>Add Organization</li>
                        
                    </ul>
                </dd>
                <dd>

                    <div class="choose-org" style="display: none" id="{{baseId}}_org_edit_wrap">
                            <div
                                    class="org-input"
                                    id="{{baseId}}_org_searchbox"
                                    data-element-handler="DeskPRO.Agent.ElementHandler.OrgSearchBox"
                                    data-search-url="{{ path('agent_orgsearch_quicknamesearch', {'format': 'json', 'limit': 10, 'start_with': 'a'}) }}"
                                    data-highlight-term="1"
                                    data-touch-focus="1"
                                    data-search-param="term"
                                    data-position-bound="@parent(.org-input)"
                            >
                                    Organization:
                                    <input type="text" class="org-name" id="{{baseId}}_orgselect" placeholder="Enter an organization name..." value="{{ person.organization.name }}" />
                                    <input type="hidden" class="org-id" name="newdeal[organizations][id]" value="{{ person.organization.id|default(0) }}" />
                                    <script type="text/x-deskpro-tmpl" class="user-row-tpl">
                                            <li>
                                                    <a>
                                                    <span class="org-name"></span>
                                                    <div class="bound-fade"></div>
                                            </a></li>
                                    </script>
                                    <div class="person-search-box org" style="display: none">
                                            <section>
                                                    <ul class="results-list">

                                                    </ul>
                                                    <footer>
                                                            <span class="create-org">Create a new organization</span>
                                                    </footer>
                                            </section>
                                    </div>
                            </div>
                    </div>
                    <div id="{{baseId}}_org_choice">

                        </div>
                        <br class="clear" />

                </dd>

            </dl>
        </div>
    </article>
    </secion>

</div>

<div class="optionbox reply-agent-team-ob" id="{{baseId}}_agent_assign_ob">
    	<header>
			<h4>Assignments</h4>
			<span class="close close-trigger"></span>
		</header>
    	<div class="col">
		<section data-section-name="agents">
			<header>
				<h3>Agents</h3>
				<input type="text" class="filter-box" placeholder="Filter..." />
			</header>
			<ul>
				<li class="me last-me {% if deal.assigned_agent.id == deal.person.id or not deal.assigned_agent %}on{% endif %}">
					<input type="radio" name="{{baseId}}_agent" value="{{ deal.person.id }}" {% if deal.assigned_agent.id == deal.person.id or not deal.assigned_agent.id %}checked="checked"{% endif %} />
					<label><span class="agent-pic agent-label-{{ deal.person.id }}" style="background-image: url({{ deal.person.getPictureUrl(16) }})">Me</span></label>
				</li>

				<li>
					<input type="radio" name="{{bsaeId}}_agent" value="0" />
					<label><span class="agent-pic agent-label-0">Unassigned</span></label>
				</li>

				{% for agent in agents %}
					{% if agent.id != deal.person.id %}
						<li {% if deal.assigned_agent.id == agent.id %}class="on"{% endif %}>
							<input type="radio" name="{{baseId}}_agent" value="{{ agent.id }}" {% if deal.assigned_agent.id == agent.id %}checked="checked"{% endif %} />
							<label><span class="agent-pic agent-label-{{ agent.id }}" style="background-image: url({{ agent.getPictureUrl(16) }})">{{ agent.display_name }}</span></label>
							<div class="bound-fade"></div>
						</li>
					{% endif %}
				{% endfor %}
			</ul>
		</section>
	</div>
    	
    	<br class="clear" />
    	<footer>
           <button class="save-trigger">Apply</button>
        </footer>
</div>


{#End People BOX#}

{#Property Tab#}
<div class="profile-box-container tabbed">
    <header>
            <nav>
                <ul>
                    <li data-tab-for="#{{baseId}}_property_tab" class="on">Properties</li>
                    <li data-tab-for="#{{baseId}}_tasks_tab" >Tasks <span class="count" id="{{baseId}}_tasks_count">{{ assoceated_tasks|length }}</span></li>
                    <li data-tab-for="#{{baseId}}_files_tab" >Files <span class="count" id="{{baseId}}_files_count">{{ deal_attachments|length }}</span></li>
                </ul>
            </nav>
    </header>

    <section>

            {# Property Tab #}
            <article id="{{baseId}}_property_tab" class="on">
                <dl class="table-list">
                    <dt class="type-labels">Labels</dt>
                    <dd class="deal-tags tags-wrap">
                        <ul data-label-route="listpane:{{ path('agent_peoplesearch') }}?terms[0][rule_type]=deal_label&amp;terms[0][op]=is&amp;terms[0][label]={LABEL}&amp;view_name=label&amp;view_extra={LABEL}">
                                {% for label in deal.labels %}
                                        <li><span>{{label.label}}</span></li>
                                {% endfor %}
                        </ul>
                    </dd>
		</dl>

                <div class="meta-line">
                    <dl class="table-list">
                        <dt class="type-labels">Created</dt>
                        <dd>
                            <span>by {{deal.person.first_name}},
                            <time class="timeago" title="{{deal.date_created|date('c')}}">{{deal.date_created|date('M j, Y')}}</time>
                            </span>
                        </dd>
                    </dl>
                </div>

                <div class="meta-line">
                    <dl class="table-list">
                        <dt class="type-labels">Custom Field A</dt>
                        <dd>
                            <span>Value X</span>
                        </dd>
                    </dl>
                </div>

            </article>
            {# /Property Tab #}

            {# Task Tab #}
            <article id="{{baseId}}_tasks_tab">
                {% include 'AgentBundle:Deal:tab-tasks.html.twig' %}
            </article>
            {# /Task Tab #}

            {# File Tab #}
            <article id="{{baseId}}_files_tab">
                {% include 'AgentBundle:Deal:tab-attachments.html.twig' %}
            </article>
            {# /File Tab #}


    </section>
</div>

{#/Property Tab#}



{# Notes Tabs #}
<div class="profile-box-container tabbed">
    <header>
        <nav>
            <ul>
                <li data-tab-for="#{{baseId}}_notes_tab" class="on">Notes <span class="count" id="{{baseId}}_notes_count">{{ notes|length }}</span></li>                    
            </ul>
        </nav>
    </header>
    <section>

    {# Notes Tab #}
		<article id="{{baseId}}_notes_tab" class="on">
			<div class="notes-wrap">
				<ul>

                                    {% for note in notes|reverse %}
						{% include 'AgentBundle:Deal:note-li.html.twig' with {'note': note} %}
				    {% endfor %}

                                    <li class="new-note"
						data-element-handler="DeskPRO.Agent.ElementHandler.FormSaver"
						data-form-list-selector="ul"
						data-form-result-html-key="note_li_html"
						data-form-save-url="{{ path('agent_deal_ajaxsave_note', {'deal_id': deal.id}) }}"
						data-form-count-el="#{{baseId}}_notes_count"
					>
						<header>
							<div class="controls">
								<div class="is-loading">Saving</div>
								<div class="saved" style="display: none">Saved</div>
								<div class="save" style="display: none">Save</div>
							</div>
							<h3>New Note</h3>
						</header>
						<div class="textarea-section"><textarea class="integrated" name="note" placeholder="Enter note ..." data-not-blank="1"></textarea></div>
					</li>
				</ul>
			</div>
		</article>
		{# /Notes Tab #}
    </section>

</div>
{# /Notes Tab #}