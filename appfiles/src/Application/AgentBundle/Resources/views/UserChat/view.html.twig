<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.UserChat';
pageMeta.title         = 'Chat';
pageMeta.url_fragment  = '{{ url_fragment('agent_userchat_view', {'conversation_id': convo.id}) }}';
pageMeta.conversation_id = {{convo.id}};
pageMeta.youName         = {{ app.user.display_name|json_encode|raw }};
pageMeta.tabIdClass      = 'user_chat_tab_{{convo.id}}';

{% if convo.person.id %}
pageMeta.viewPersonUrl = '{{ path('agent_people_view', {'person_id': convo.person.id}) }}';
{% elseif convo.session %}
pageMeta.viewPersonUrl = '{{ path('agent_people_viewsession', {'session_id': convo.session.id}) }}';
{% endif %}

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
<div class="userchat-page">

<header class="page-header">
	<div class="meta-line">
		<div class="category set-department"><span>Department: <span class="label-department-id">{{ convo.department.full_title }}</span></span></div>
	</div>
	<h1>
		Chat with {% if convo.person %}
			{{ convo.person.display_name }} &lt;{{ convo.person.primary_email_address }}&gt;
		{% elseif convo.person_name or convo.person_email %}
			{{ convo.person_name }} &lt;{{ convo.person_email }}&gt;
		{% else %}
			Anonymous
		{% endif %}
	</h1>
	<div class="assigned">
		<label>Chat assigned to: </label>
		<a class="agent-link prop-agent-id" style="background-image: url('{{ convo.agent.getPictureUrl(20) }}');">{{ convo.agent.display_name }}</a>
	</div>
</header>

<div class="profile-box-container tabbed">
	<header>
		<nav>
			<ul>
				<li data-tab-for="#{{baseId}}_chat" class="on">Chat</li>
				<li data-tab-for="#{{baseId}}_userinfo">User Information</li>
			</ul>
		</nav>
	</header>
	<section>
		<article id="{{baseId}}_chat" class="on chat-tab">
			<div class="messages">
				{% for message in convo_messages|reverse %}
					<div class="message {% if message.is_sys %}sys{% elseif message.author.is_agent and message.author.id != convo.person.id %}agent{% else %}user{% endif%}">
						<span class="author {% if message.is_sys %}{% elseif message.author.is_agent and message.author.id != convo.person.id %}{% else %}person-overview{% endif %}">{% if message.is_sys %}*{% else %}&lt;{{message.author_name}}&gt;{% endif %}</span>
						<span class="message">
							{% if message.is_html %}
								{{message.content|raw}}
							{% else %}
								{{message.content}}
							{% endif %}
						</span>
					</div>
				{% endfor %}
			</div>
			<div class="chatreply" id="{{baseId}}_replybox">
				<nav>
					<ul class="option-buttons">
						<li class="tipped attach" title="Send File">
							<input type="file" class="file" name="file-upload" />
							<span>Send File</span>
						</li>
						<li class="tipped snippets hide-note" id="{{replyBaseId}}_text_snippets_btn" title="Quick Replies"><span>Quick Replies</span></li>
					</ul>

					<ul class="option-buttons right">
						<li class="send" id="{{replyBaseId}}_send_btn"><span>Send</span></li>
					</ul>
				</nav>
				<div class="input-wrap">
					<textarea placeholder="" id="{{baseId}}_replybox_txt" name="message"></textarea>
				</div>
			</div>
		</article>
		<article id="{{baseId}}_userinfo">
			Userinfo
		</article>
	</section>
</div>

</div>
