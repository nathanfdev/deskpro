<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.OpenChats';
pageMeta.agent_id = {{ agent.id|default(0)}};
</script>
<header class="section-header">
	<h1>
		{% if agent %}
			{{ agent.display_name }}
		{% else %}
			Unassigned
		{% endif %}
	</h1>
</header>
<div class="pad">
	<div class="inner-box-tab-content box-list no-pad">
		<table class="list" cellspacing="0" width="100%">
			<thead class="display-options-trigger dbl-click-trigger nosel">
				<tr>
					<th>Subject</th>
					<th>User</th>
					<th>Time</th>
				</tr>
			</thead>
			<tbody>
				{% for convo in convos %}
					<tr class="line-1 with-route" data-route="page:{{ path('agent_userchat_view', {'conversation_id': convo.id}) }}">
						<td>{{ convo.subject }}</td>
						<td>{{ convo.person_name|default('Guest') }}</td>
						<td>{{ convo.date_created|date('H:m') }}</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
</div>