<script>
{% if filter.sys_name %}
	pageMeta.title = {{ phrase('agent.filter_' ~ filter.sys_name)|json_encode|raw }};
	pageMeta.url_fragment = '{{ url_fragment('agent_ticketsearch_runnamedfilter', {'filter_name': filter.sys_name}) }}';
{% else %}
	pageMeta.title = {{ filter.title|json_encode|raw }};
	pageMeta.url_fragment = '{{ url_fragment('agent_ticketsearch_runfilter', {'filter_id': filter.id}) }}';
{% endif %}
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.TicketFilter';
pageMeta.viewTypeUrl = '{{ path('agent_ticketsearch_runfilter', {'filter_id': filter_id}) }}?view_type=$view_type';
pageMeta.pageUrl = '{{ path('agent_ticketsearch_runfilter', {'filter_id': filter_id}) }}?partial=1&page=$page';
pageMeta.refreshUrl = '{{ path('agent_ticketsearch_runfilter', {'filter_id': filter_id}) }}?';
pageMeta.saveListPrefsUrl = '{{ path('agent_ajax_save_prefs') }}';
pageMeta.getMacroUrl = '{{ path('agent_ticketsearch_ajax_get_macro') }}?macro_id=$macro_id';
pageMeta.saveMacroUrl = '{{ path('agent_ticketsearch_ajax_save_macro') }}?macro_id=$macro_id';
pageMeta.deleteTicketUrl = '{{ path('agent_ticketsearch_ajax_delete_tickets') }}';
pageMeta.viewTicketUrl = '{{ path('agent_ticket_view', {'ticket_id': '0000'})|replace({'0000': '$ticket_id'}) }}';
pageMeta.massReplyUrl = '{{ path('agent_ticketsearch_ajax_mass_reply') }}';
pageMeta.loadFirst = {% if load_first %}true{% else %}false{% endif %};
pageMeta.loadSingleUrl = '{{ path('agent_ticketsearch_singleticketrow', {'filter_id': filter_id}) }}?ticket_id=$ticket_id&view_type=$view_type';
pageMeta.viewType = 'simple-ext';
{% if filter_id %}
	pageMeta.filter_id = {{filter_id}};
{% endif %}
{% if not tickets %}
	pageMeta.noResults = true;
{% endif %}

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
<div class="layout-content">
<div class="content">

	{% include 'AgentBundle:TicketSearch:part-display-options-overlay.html.twig' %}

	<header class="control-bar">
		<span class="detail-view-trigger tipped" title="View full-screen detailed list">Detail</span>
		<span class="display-options-trigger tipped" title="Change display options">Display Options</span>

		{{ count }} tickets ordered by <span class="menu-trigger" style="border-bottom: 1px dotted #888;">urgency</span>
		and grouped by <span class="menu-trigger" style="border-bottom: 1px dotted #888;">status</span>
	</header>
	<header class="grouping-bar">
		<ul>
			<li class="all on">All <span class="count">{{ count }}</span></li>
			<li>Open <span class="count">{{ count-2 }}</span></li>
			<li>Pending <span class="count">{{ count-3 }}</span></li>
			<li>Resolved <span class="count">{{ count-1 }}</span></li>
		</ul>
	</header>

	<header class="selection-bar" style="display: none">
		<span class="selected-count">0</span> selected
		<button class="clean-gray xx-small">
			<span>Perform Action</span>
		</button>
	</header>

	<section class="ticket-simple-ext-list deskpro-results-list">
		{% include 'AgentBundle:TicketSearch:part-results-simple-ext.html.twig' %}
	</section>

	<div class="loading-more">
		Loading more results ...
	</div>
	<div class="no-more-results">
		There are no more results.
	</div>

	{% include 'AgentBundle:Ticket:part-flag-menu.html.twig' %}
</div>

</div>