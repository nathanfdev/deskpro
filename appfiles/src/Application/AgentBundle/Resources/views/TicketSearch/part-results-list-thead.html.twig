<thead class="display-options-trigger dbl-click-trigger nosel">
	<tr>
		<th class="check-all check" width="5"><input type="checkbox" class="check-all-box" style="width:10px; margin: 0; margin-rght: 4px; padding: 0;"/></th>
		<th></th>
		{% for field in display_fields %}
			{% if field == 'person' %}<th data-field="person">User</th>
			{% elseif field == 'person_email' %}<th data-field="person">User Email</th>
			{% elseif field == 'person_organization' %}<th data-field="person_organization">Organization</th>
			{% elseif field == 'department' %}<th data-field="department">Department</th>
			{% elseif field == 'category' %}<th data-field="category">Category</th>
			{% elseif field == 'product' %}<th data-field="product">Product</th>
			{% elseif field == 'product' %}<th data-field="product">Product</th>
			{% elseif field == 'organization' %}<th data-field="organization">Organization</th>
			{% elseif field == 'agent' and 0 %}<th data-field="agent">Agent</th>
			{% elseif field == 'date_created' %}<th data-field="date_created">Date Opened</th>
			{% else %}
				{% for f in ticket_field_defs %}
					{% if field == 'ticket_fields['~f.id~']' %}
					<th data-field="ticket_fields[{{f.id}}]">{{f.title}}</th>
					{% endif %}
				{% endfor %}
				{% for f in person_field_defs %}
					{% if field == 'person_fields['~f.id~']' %}
					<th data-field="person_fields[{{f.id}}]">{{f.title}}</th>
					{% endif %}
				{% endfor %}
			{% endif %}
		{% endfor %}
		{% if show_flag and 0 %}<th class="flag" width="5"></th>{% endif %}
	</tr>
</thead>