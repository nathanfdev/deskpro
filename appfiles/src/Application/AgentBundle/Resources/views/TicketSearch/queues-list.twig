{% extends 'AgentBundle::layout.twig' %}
{% block content %}
<a href="{{ path('agent_ticketqueues_new') }}">Add a new queue</a>

{% if queues %}
	<br/><br />
	<h1>Defined Queues</h1>
	<ul>
		{% for queue in queues %}
			<li><a href="{{ path('agent_ticketqueues_edit', {'queue_id': queue.id}) }}">{{queue.title}}</a></li>
		{% endfor %}
	</ul>
{% endif %}
{% endblock %}