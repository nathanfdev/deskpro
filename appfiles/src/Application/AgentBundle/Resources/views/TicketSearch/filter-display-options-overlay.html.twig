{% extends 'AgentBundle:Common:display-options-layout.html.twig' %}
{% block title %}
	Display Options For
	{% if filter %}
		{{ filter.title }}
	{% else %}
		Results
	{% endif %}
{% endblock %}
{% block other_options %}
	<div style="display: none">
		Order By: <select name="order_by" class="sel-order-by">
			<option class="urgency" value="ticket.urgency:desc">Urgency (Highest-Lowest)</option>
			<option value="ticket.urgency:asc">Urgency (Lowest-Highest)</option>
			<option class="date_created" value="ticket.date_created:desc">Date Opened (Newer-Older)</option>
			<option value="ticket.date_created:asc">Date Opened (Older-Newer)</option>
			<option class="priority" value="ticket.priority:desc">Priority (Highest-Lowest)</option>
			<option value="ticket.priority:asc">Priority (Lowest-Highest)</option>
		</select>
	</div>
{% endblock %}
{% block display_elements_list %}
	{% set types = ['department','agent','agent_team','category','product','organization','date_user_waiting'] %}
	{% for t in types %}
		<li data-field="{{ t }}"><label><input type="checkbox" name="{{ t }}" {% if t in display_fields %}checked="checked"{% endif %} /> {{ phrase('agent.tickets.' ~ t) }}</label></li>
	{% endfor %}
	{% for f in ticket_field_defs %}
		{% set t = 'ticket_fields[' ~ f.id ~ ']' %}
		<li data-field="{{ t }}"><label><input type="checkbox" name="{{ t }}" {% if t in display_fields %}checked="checked"{% endif %} />{{f.title}}</label></li>
	{% endfor %}
	{% for f in person_field_defs %}
		{% set t = 'person_fields[' ~ f.id ~ ']' %}
		<li data-field="{{ t }}"><label><input type="checkbox" name="{{ t }}" {% if t in display_fields %}checked="checked"{% endif %} /> {{ phrase('agent.user_field') }}: {{f.title}}</label></li>
	{% endfor %}
{% endblock %}
