{% import 'AgentBundle:Common:macro-flagname.html.twig' as flagnamer %}
<script>
{% if filter %}
	{% if filter.sys_name %}
		pageMeta.url_fragment = '{{ url_fragment('agent_ticketsearch_runnamedfilter', {'filter_name': filter.sys_name}) }}';
	{% else %}
		pageMeta.url_fragment = '{{ url_fragment('agent_ticketsearch_runfilter', {'filter_id': filter.id}) }}';
	{% endif %}

	pageMeta.filter_id = {{filter_id}};
	pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.TicketFilter';
	pageMeta.refreshUrl = '{{ path('agent_ticketsearch_runfilter', {'filter_id': filter_id}) }}?set_group_term={{ set_group_term }}&set_group_option={{ set_group_option }}';
	pageMeta.viewTypeUrl = '{{ path('agent_ticketsearch_runfilter', {'filter_id': filter_id}) }}?set_group_term={{ set_group_term }}&set_group_option={{ set_group_option }}&view_type=$view_type';
{% else %}
	pageMeta.cache_id = {{cache_id}};
	pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.TicketCustomFilter';
	pageMeta.refreshUrl = '{{ path('agent_ticketsearch_runcustomfilter', {'cache_id': cache_id}) }}?set_group_term={{ set_group_term }}&set_group_option={{ set_group_option }}';
	pageMeta.viewTypeUrl = '{{ path('agent_ticketsearch_runcustomfilter', {'cache_id': cache_id}) }}?set_group_term={{ set_group_term }}&set_group_option={{ set_group_option }}&view_type=$view_type';
{% endif %}

pageMeta.saveListPrefsUrl = '{{ path('agent_ajax_save_prefs') }}';
pageMeta.getMacroUrl = '{{ path('agent_ticketsearch_ajax_get_macro') }}?macro_id=$macro_id';
pageMeta.saveMacroUrl = '{{ path('agent_ticketsearch_ajax_save_macro') }}?macro_id=$macro_id';
pageMeta.deleteTicketUrl = '{{ path('agent_ticketsearch_ajax_delete_tickets') }}';
pageMeta.viewTicketUrl = '{{ path('agent_ticket_view', {'ticket_id': '0000'})|replace({'0000': '$ticket_id'}) }}';
pageMeta.massReplyUrl = '{{ path('agent_ticketsearch_ajax_mass_reply') }}';
pageMeta.loadFirst = {% if load_first %}true{% else %}false{% endif %};
pageMeta.fetchResultsUrl = '{{ path('agent_ticketsearch_getpage', {'view_type': 'list'}) }}';
pageMeta.viewType = 'list';

{% if not tickets %}
	pageMeta.noResults = true;
{% endif %}

pageMeta.perPage = {{ per_page }};
pageMeta.ticketResultIds = {{ ticket_ids|json_encode|raw }};

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
<section class="dp-overlay">
	<header>
		<div class="controls">
			<button class="order-by-menu-trigger clean-white small arrow">Ordeded by <span class="label">{{ order_by_summary }}</span><em></em></button>
			<button class="group-by-menu-trigger clean-white small arrow">Grouped by <span class="label">{{ grouping_summary|default('None') }}</span><em></em></button>
			<button class="display-options-trigger clean-white small">Display Options</button>
		</div>

		<ul style="display: none" class="order-by-menu">
			<li data-order-by="urgency">Urgency</li>
			<li data-order-by="date_created">Date Opened</li>
			<li data-order-by="priority">Priority</li>
		</ul>
		<ul style="display: none" class="group-by-menu">
			<li data-group-by="">None</li>
			<li class="sep">-</li>
			<li data-group-by="department">Department</li>
			<li data-group-by="category">Category</li>
			<li data-group-by="priority">Priority</li>
			<li data-group-by="product">Product</li>
			<li data-group-by="workflow">Workflow</li>
			<li data-group-by="organization">Organization</li>
			<li data-group-by="language">Language</li>
			<li data-group-by="urgency">Urgency</li>
			<li data-group-by="agent">Agent</li>
			<li data-group-by="agent_team">Agent Team</li>
			<li data-group-by="time_waiting">Time Waiting</li>
			<li data-group-by="total_user_waiting">Total Time Waiting</li>
			<li data-group-by="date_created">Date Created</li>
		</ul>

		<span class="close close-trigger">close</span>
		<h1>Tickets</h1>
	</header>
	<article>
		{% include 'AgentBundle:TicketSearch:filter-display-options-overlay.html.twig' %}

		{% include 'AgentBundle:TicketSearch:filter-grouping-bar.html.twig' %}

		<div class="table-result-list">
			<table cellspacing="0" width="100%">
				{% include 'AgentBundle:TicketSearch:part-results-list-thead.html.twig' %}
				{% include 'AgentBundle:TicketSearch:part-results-list.html.twig' %}
			</table>
		</div>
	</article>
	<div class="full-loading" style="display: none">
		<em>Loading</em>
	</div>
	<footer class="is-ticket-list bottom-action-bar">
			<div class="check-count selection-bar">
				<span class="selected-count">0</span> selected

				<button class="clean-white perform-actions-trigger">
					<span>Perform Action</span>
				</button>
			</div>
			<div class="results-count">
				Showing <span class="results-showing-count"></span> of {{ ticket_ids|length }} tickets
			</div>
			<div class="more-btn">
				<button class="clean-white show-more is-not-loading">More Results</button>
				<div class="is-loading"></div>
			</div>

        	{% include 'AgentBundle:TicketSearch:filter-massactions-overlay.html.twig' %}
        </div>
	</footer>
</section>
