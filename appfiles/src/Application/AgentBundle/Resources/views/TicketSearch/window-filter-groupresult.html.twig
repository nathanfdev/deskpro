{% if grouped_info.counts[0].total > 0 %}
	<li data-grouping-option="0">
		<span class="title">
			<span class="list-counter">{{ grouped_info.counts[0].total }}</span>
			None
		</span>
	</li>
{% endif %}
{% for cat in grouped_info.group1_structure %}
	{% set count = grouped_info.counts[cat.id].total %}
	{% set count_all = count %}
	{% if cat.children %}
		{% for subcat in cat.children %}
			{% set count_all = count_all + grouped_info.counts[subcat.id].total %}
		{% endfor %}
	{% endif %}
	{% if count > 0 %}
		<li data-grouping-option="{{ cat.id }}">
			<span class="title">
				<span class="list-counter">{{ count }}{% if cat.children and count != count_all %}/{{ count_all }}{% endif %}</span>
				{{ cat.title }}
			</span>
		</li>
		{% if cat.children %}
			{% for subcat in cat.children %}
				{% set subcount = grouped_info.counts[subcat.id].total %}
				{% if subcount > 0 %}
					<li data-grouping-option="{{ subcat.id }}" class="sub-item">
						<span class="title">
							<span class="list-counter">{{ subcount }}</span>
							{{ subcat.title }}
						</span>
					</li>
				{% endif %}
			{% endfor %}
		{% endif %}
	{% endif %}
{% endfor %}
