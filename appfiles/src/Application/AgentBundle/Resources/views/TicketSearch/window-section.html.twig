{% import 'AgentBundle:Common:macro-flagname.html.twig' as flagnamer %}
<section class="source-section sys-filters-section">
	<header>
		<div class="hold-ticket-count">
			<span class="dp-checkbox checkbox show-hold-check"></span>
			<span class="count"></span>
			{{ phrase('agent.tickets.tickets_on_hold') }}
		</div>
		<h1>{{ phrase('agent.tickets.inbox') }}</h1>
		<span id="ticket_filter_launch_editor" class="settings"></span>
	</header>
	<article id="system_filters_wrap">
		<ul id="tickets_outline_sys_filters" class="source-list">
			{% for filter in sys_filters %}
				<li
					class="filter filter-{{filter.id}} filter-{{filter.sys_name}} nav-filter-{{filter.id}} {% if loop.index == 1 %}active{% endif %}"
					data-filter-id="{{filter.id}}"
					data-filter-name="{{filter.sys_name}}"
					{% if filter.sys_name == 'agent' %}data-grouping-ignore="agent,agent_team"{% endif %}
					{% if filter.sys_name == 'agent_team' %}
						{#{% if app.user.agent.is_single_team %}
							data-grouping-ignore="agent,agent_team"
						{% else %}
							data-grouping-ignore="agent"
						{% endif %}#}
						data-grouping-ignore="agent"
					{% endif %}
					{% if filter.sys_name == 'unassigned' %}data-grouping-ignore="agent,agent_team"{% endif %}
				>
					<h3 class="title {% if loop.first %}auto-load-route{% endif %}" data-route="listpane:{{ path('agent_ticketsearch_runfilter', {'filter_id': filter.id}) }}">
						<span class="list-counter" id="ticket_filter_{{filter.id}}_count">{{ filter_counts[filter.id]|default(0) }}</span>
						{{ filter.title }}
					</h3>
					<ul class="sub-group" style="display: none;"></ul>
				</li>
			{% endfor %}
		</ul>

		<ul id="tickets_outline_sys_hold_filters" class="source-list" style="display: none;">
			{% for filter in sys_filters_hold %}
				<li
					class="filter filter-{{filter.id}} filter-{{filter.sys_name}} is-hold-filter nav-filter-{{filter.id}} {% if loop.index == 1 %}active{% endif %}"
					data-filter-id="{{filter.id}}"
					data-filter-name="{{filter.sys_name}}"
				>
					<h3 class="title" data-route="listpane:{{ path('agent_ticketsearch_runfilter', {'filter_id': filter.id}) }}">
						<span class="list-counter" id="ticket_filter_{{filter.id}}_count">{{ filter_counts[filter.id]|default(0) }}</span>
						{{ filter.title }}
					</h3>
					<ul class="sub-group" style="display: none;"></ul>
				</li>
			{% endfor %}
		</ul>
	</article>
</section>

{% if custom_filters %}
<section class="source-section custom-filters-section">
	<header>
		<h1>{{ phrase('agent.tickets.filters') }}</h1>
		<span id="ticket_customfilters_launch_editor" class="add launch-customfilters-settings"></span>
		<span id="ticket_customfilters_launch_editor" class="settings launch-customfilters-editor"></span>
	</header>
	<article id="custom_filters_wrap">
		<ul id="tickets_outline_custom_filters" class="source-list">
			{% for filter in custom_filters %}
				<li
					class="filter filter-{{filter.id}} filter-{{filter.sys_name}} is-hold-filter nav-filter-{{filter.id}} {% if loop.index == 1 %}active{% endif %} {% if filter_show_options['agent.ui.filter-visibility.' ~ filter.id] == 'hidden' %}filter-hidden{% endif %}"
					data-filter-id="{{filter.id}}"
					data-filter-name="{{filter.sys_name}}"
				>
					<h3
						class="title {% if loop.first %}auto-load-route{% endif %}"
						data-route="listpane:{{ path('agent_ticketsearch_runfilter', {'filter_id': filter.id}) }}"
					>
						<span class="list-counter" id="ticket_filter_{{filter.id}}_count">{{ filter_counts[filter.id]|default(0) }}</span>
						{{ filter.title }}
					</h3>
				</li>
			{% endfor %}
			<li class="no-data launch-customfilters-editor">
				Click <span class="gear-icon"></span> to show filters
			</li>
		</ul>
	</article>
</section>
{% endif %}

<section class="source-tabs" id="tickets_outline_tabstrip">
	<ul>
		<li class="labels"  data-tab-for="#tickets_outline_labels"><span>{{ phrase('agent.labels') }}</span></li>
		<li class="flagged" data-tab-for="#tickets_outline_flagged"><span>{{ phrase('agent.flagged') }}</span></li>
		<li class="archive fill-out" data-tab-for="#tickets_outline_archive"><span>{{ phrase('agent.archive') }}</span></li>
	</ul>
</section>

<section id="tickets_outline_labels"  class="deskpro-tab-item">
	{{ phrase('agent.loading') }}
</section>
<section id="tickets_outline_flagged" class="deskpro-tab-item">
	<ul class="source-list" id="tickets_outline_flags_list" style="margin-top: 4px;">
		{% for color in flags %}
			<li class="flag flag-{{color}} nav-flag-{{color}}" data-flag="{{color}}" data-route="listpane:{{ path('agent_ticketsearch_runcustomfilter') }}?terms[0][type]=flagged&amp;terms[0][op]=is&amp;terms[0][flag]={{color}}">
				<span class="title">
					<span class="flag flag-{{color}}">{{ flagnamer.flag_name(color, person) }}</span>
					<span id="ticket_flag_{{color}}_count" class="list-counter">0</span>
				</span>
			</li>
		{% endfor %}
	</ul>
</section>
<section id="tickets_outline_archive" class="deskpro-tab-item">
	<ul class="source-list" id="tickets_outline_filters_list" style="margin-top: 4px;">
		<li class="with-route nav-archive-pending" data-route="listpane:{{ path('agent_ticketsearch_runcustomfilter') }}?terms[0][type]=status&amp;terms[0][op]=is&amp;terms[0][options][status]=pending&amp;view_name=pending">
			<span class="title">
				<span class="list-counter" id="ticket_archive_pending_count">{{ archive_counts['pending']|default(0) }}</span>
				{{ phrase('agent.tickets.status_pending') }}
			</span>
		</li>
		<li class="with-route nav-archive-resolved" data-route="listpane:{{ path('agent_ticketsearch_runcustomfilter') }}?terms[0][type]=status&amp;terms[0][op]=is&amp;terms[0][options][status]=resolved&amp;view_name=resolved">
			<span class="title">
				<span class="list-counter" id="ticket_archive_resolved_count">{{ archive_counts['resolved']|default(0) }}</span>
				{{ phrase('agent.tickets.status_resolved') }}
			</span>
		</li>
		<li class="with-route nav-archive-closed" data-route="listpane:{{ path('agent_ticketsearch_runcustomfilter') }}?terms[0][type]=status&amp;terms[0][op]=is&amp;terms[0][options][status]=closed&amp;view_name=closed">
			<span class="title">
				<span class="list-counter" id="ticket_archive_closed_count">{{ archive_counts['closed']|default(0) }}</span>
				{{ phrase('agent.tickets.status_closed') }}
			</span>
		</li>
		<li class="with-route nav-archive-validating" data-route="listpane:{{ path('agent_ticketsearch_runcustomfilter') }}?terms[0][type]=hidden_status&amp;terms[0][op]=is&amp;terms[0][options][hidden_status]=validating&amp;terms[1][type]=status&amp;terms[1][op]=is&amp;terms[1][options][status]=hidden&amp;view_name=validating">
			<span class="title">
				<span class="list-counter" id="ticket_archive_validating_count">{{ archive_counts['hidden.validating']|default(0) }}</span>
				{{ phrase('agent.tickets.hidden_status_validating') }}
			</span>
		</li>
		<li class="with-route nav-archive-spam" data-route="listpane:{{ path('agent_ticketsearch_runcustomfilter') }}?terms[0][type]=hidden_status&amp;terms[0][op]=is&amp;terms[0][options][hidden_status]=spam&amp;terms[1][type]=status&amp;terms[1][op]=is&amp;terms[1][options][status]=hidden&amp;view_name=spam">
			<span class="title">
				<span class="list-counter" id="ticket_archive_spam_count">{{ archive_counts['hidden.spam']|default(0) }}</span>
				{{ phrase('agent.tickets.hidden_status_spam') }}
			</span>
		</li>
		<li class="nav-archive-recycle-bin" data-route="listpane:{{ path('agent_ticketsearch_runcustomfilter') }}?terms[0][type]=hidden_status&amp;terms[0][op]=is&amp;terms[0][options][hidden_status]=deleted&amp;terms[1][type]=status&amp;terms[1][op]=is&amp;terms[1][options][status]=hidden&amp;view_name=deleted">
			<span class="title">
				<span class="list-counter" id="ticket_archive_recycle_bin_count">{{ archive_counts['hidden.deleted']|default(0) }}</span>
				{{ phrase('agent.recycle_bin') }}
			</span>
		</li>
	</ul>
</section>

<section id="ticket_filter_group_editor">
	<section class="filter-group-editor">
		<span class="close"></span>
		<script type="text/x-deskpro-plain" class="editor-row-tpl">
			<div class="filter-row">
				<div class="field-wrap"></div>
			</div>
		</script>
		<script type="text/x-deskpro-plain" class="editor-fields-tpl">
			<select>
				<option value="">{{ phrase('agent.group_by') }} {{ phrase('agent.none') }}</option>
				<option value="department">{{ phrase('agent.group_by') }} {{ phrase('agent.department') }}</option>
				<option value="category">{{ phrase('agent.group_by') }} {{ phrase('agent.category') }}</option>
				<option value="priority">{{ phrase('agent.group_by') }} {{ phrase('agent.priority') }}</option>
				<option value="product">{{ phrase('agent.group_by') }} {{ phrase('agent.product') }}</option>
				<option value="workflow">{{ phrase('agent.group_by') }} {{ phrase('agent.workflow') }}</option>
				<option value="organization">{{ phrase('agent.group_by') }} {{ phrase('agent.organization') }}</option>
				<option value="language">{{ phrase('agent.group_by') }} {{ phrase('agent.language') }}</option>
				<option value="urgency">{{ phrase('agent.group_by') }} {{ phrase('agent.urgency') }}</option>
				<option value="agent">{{ phrase('agent.group_by') }} {{ phrase('agent.agent') }}</option>
				<option value="agent_team">{{ phrase('agent.group_by') }} {{ phrase('agent.agent_team') }}</option>
				<option value="user_waiting">{{ phrase('agent.group_by') }} {{ phrase('agent.time_waiting') }}</option>
				<option value="total_user_waiting">{{ phrase('agent.group_by') }} {{ phrase('agent.total_time_waiting') }}</option>
				<option value="date_created">{{ phrase('agent.group_by') }} {{ phrase('agent.date_opened') }}</option>
			</select>
		</script>
	</section>
</section>

<section id="ticket_customfilter_group_editor">
	<section class="filter-group-editor">
		<span class="close"></span>
		<script type="text/x-deskpro-plain" class="editor-row-tpl">
			<div class="filter-row">
				<div class="field-wrap"></div>
			</div>
		</script>
		<script type="text/x-deskpro-plain" class="editor-fields-tpl">
			<label><input type="checkbox" checked="checked" /> {{ phrase('agent.show') }}</label>
		</script>
	</section>
</section>
