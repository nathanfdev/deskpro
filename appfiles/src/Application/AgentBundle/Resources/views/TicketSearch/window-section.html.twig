	<nav id="tickets_outline_viewtypetabs">
		<ul>
			<li class="on" data-tab-for="#tickets_outline_pending">Pending</li>
			<li data-tab-for="#tickets_outline_hold">On Hold</li>
		</ul>
	</nav>

	<div id="tickets_outline_pending">
		<ul id="tickets_outline_inbox_list" class="nav-list">
			{% for filter in sys_filters %}
				<li
