{% import 'AgentBundle:Common:macro-flagname.html.twig' as flagnamer %}
<section class="source-section sys-filters-section">
	<header>
		<div class="hold-ticket-count">
			<span class="dp-checkbox checkbox show-hold-check"></span>
			<span class="count"></span>
			Tickets On hold
		</div>
		<h1>Inbox</h1>
		<span id="ticket_filter_launch_editor" class="settings">edit display</span>
	</header>
	<article id="system_filters_wrap">
		<ul id="tickets_outline_sys_filters" class="source-list">
			{% for filter in sys_filters %}
				<li
					class="filter filter-{{filter.id}} filter-{{filter.sys_name}} nav-filter-{{filter.id}} {% if loop.first %}auto-load-route{% endif %} {% if loop.index == 1 %}active{% endif %}"
					data-filter-id="{{filter.id}}"
					data-filter-name="{{filter.sys_name}}"
				>
					<h3 class="title" data-route="listpane:{{ path('agent_ticketsearch_runfilter', {'filter_id': filter.id}) }}">
						<span class="list-counter" id="ticket_filter_{{filter.id}}_count">{{ filter_counts[filter.id]|default(0) }}</span>
						{% if filter.sys_name == 'agent_team' or filter.sys_name == 'agent_team_w_hold' %}
							{% if app.user.teams|length > 1 %}
								{{ phrase('agent_tickets.filter_agent_team') }}
							{% else %}
								{{ phrase('agent_tickets.filter_agent_teams') }}
							{% endif %}
						{% else %}
							{{ phrase('agent_tickets.filter_' ~ filter.sys_name) }}
						{% endif %}
					</h3>
					<ul class="sub-group" style="display: none;"></ul>
				</li>
			{% endfor %}
		</ul>

		<ul id="tickets_outline_sys_hold_filters" class="source-list" style="display: none;">
			{% for filter in sys_filters_hold %}
				<li
					class="filter filter-{{filter.id}} filter-{{filter.sys_name}} is-hold-filter nav-filter-{{filter.id}} {% if loop.first %}auto-load-route{% endif %} {% if loop.index == 1 %}active{% endif %}"
					data-filter-id="{{filter.id}}"
					data-filter-name="{{filter.sys_name}}"
				>
					<h3 class="title" data-route="listpane:{{ path('agent_ticketsearch_runfilter', {'filter_id': filter.id}) }}">
						<span class="list-counter" id="ticket_filter_{{filter.id}}_count">{{ filter_counts[filter.id]|default(0) }}</span>
						{% if filter.sys_name == 'agent_team' or filter.sys_name == 'agent_team_w_hold' %}
							{% if app.user.teams|length > 1 %}
								{{ phrase('agent_tickets.filter_agent_team') }}
							{% else %}
								{{ phrase('agent_tickets.filter_agent_teams') }}
							{% endif %}
						{% else %}
							{{ phrase('agent_tickets.filter_' ~ filter.sys_name) }}
						{% endif %}
					</h3>
					<ul class="sub-group" style="display: none;"></ul>
				</li>
			{% endfor %}
		</ul>
	</article>
</section>

{% if custom_filters %}
<section class="source-section custom-filters-section">
	<header>
		<h1>Filters</h1>
		<span class="settings">edit display</span>
	</header>
	<article id="custom_filters_wrap">
		<ul class="source-list">
			{% for filter in custom_filters %}
				<li
					class="filter filter-{{filter.id}} filter-{{filter.sys_name}} is-hold-filter nav-filter-{{filter.id}} {% if loop.first %}auto-load-route{% endif %} {% if loop.index == 1 %}active{% endif %}"
					data-filter-id="{{filter.id}}"
					data-filter-name="{{filter.sys_name}}"
				>
					<h3 class="title" data-route="listpane:{{ path('agent_ticketsearch_runfilter', {'filter_id': filter.id}) }}">
						<span class="list-counter" id="ticket_filter_{{filter.id}}_count">{{ filter_counts[filter.id]|default(0) }}</span>
						{{ filter.title }}
					</h3>
				</li>
			{% endfor %}
		</ul>
	</article>
</section>
{% endif %}

<section class="source-tabs" id="tickets_outline_tabstrip">
	<ul>
		<li class="labels"  data-tab-for="#tickets_outline_labels"><span>Labels</span></li>
		<li class="flagged" data-tab-for="#tickets_outline_flagged"><span>Flagged</span></li>
		<li class="archive fill-out" data-tab-for="#tickets_outline_archive"><span>Archive</span></li>
	</ul>
</section>

<section id="tickets_outline_labels"  class="deskpro-tab-item">
	Loading ...
</section>
<section id="tickets_outline_flagged" class="deskpro-tab-item">
	<ul class="source-list" id="tickets_outline_flags_list" style="margin-top: 4px;">
		{% for color in flags %}
			<li class="flag flag-{{color}} nav-flag-{{color}}" data-flag="{{color}}" data-route="listpane:{{ path('agent_ticketsearch_runflag', {'flag': color, 'view_name': 'flag', 'view_extra': color}) }}">
				<span class="title">
					<span>{{ flagnamer.flag_name(color, person) }}</span>
					<span id="ticket_flag_{{color}}_count" class="list-counter">0</span>
				</span>
			</li>
		{% endfor %}
	</ul>
</section>
<section id="tickets_outline_archive" class="deskpro-tab-item">
	<ul class="source-list" id="tickets_outline_filters_list" style="margin-top: 4px;">
		<li class="with-route nav-archive-spam" data-route="listpane:{{ path('agent_ticketsearch_runcustomfilter') }}?terms[0][type]=hidden_status&amp;terms[0][op]=is&amp;terms[0][options][hidden_status]=spam&amp;view_name=spam">
			<span class="title">Spam</span>
		</li>
		<li class="with-route nav-archive-validating" data-route="listpane:{{ path('agent_ticketsearch_runcustomfilter') }}?terms[0][type]=hidden_status&amp;terms[0][op]=is&amp;terms[0][options][hidden_status]=validating&amp;view_name=validating">
			<span class="title">Validating</span>
		</li>
		<li class="with-route nav-archive-pending" data-route="listpane:{{ path('agent_ticketsearch_runcustomfilter') }}?terms[0][type]=status&amp;terms[0][op]=is&amp;terms[0][options][status]=pending&amp;view_name=pending">
			<span class="title">Pending</span>
		</li>
		<li class="with-route nav-archive-resolved" data-route="listpane:{{ path('agent_ticketsearch_runcustomfilter') }}?terms[0][type]=status&amp;terms[0][op]=is&amp;terms[0][options][status]=resolved&amp;view_name=resolved">
			<span class="title">Resolved</span>
		</li>
		<li class="with-route nav-archive-closed" data-route="listpane:{{ path('agent_ticketsearch_runcustomfilter') }}?terms[0][type]=status&amp;terms[0][op]=is&amp;terms[0][options][status]=closed&amp;view_name=closed">
			<span class="title">Closed</span>
		</li>
		<li class="nav-archive-recycle-bin" data-route="listpane:{{ path('agent_recyclebin') }}">
			<span class="title">Recycle Bin</span>
		</li>
	</ul>
</section>

<section id="ticket_filter_group_editor">
	<section class="filter-group-editor">
		<span class="close"></span>
		<script type="text/x-deskpro-plain" class="editor-row-tpl">
			<div class="filter-row">
				<div class="field-wrap"></div>
			</div>
		</script>
		<script type="text/x-deskpro-plain" class="editor-fields-tpl">
			<select>
				<option value="">Group By: None</option>
				<option value="department">Group By: Department</option>
				<option value="category">Group By: Category</option>
				<option value="priority">Group By: Priority</option>
				<option value="product">Group By: Product</option>
				<option value="workflow">Group By: Workflow</option>
				<option value="organization">Group By: Organization</option>
				<option value="language">Group By: Language</option>
				<option value="urgency">Group By: Urgency</option>
				<option value="agent">Group By: Agent</option>
				<option value="agent_team">Group By: Agent Team</option>
				<option value="user_waiting">Group By: Time Waiting</option>
				<option value="total_time_waiting">Group By: Total Time Waiting</option>
				<option value="date_created">Group By: Time Since Creation</option>
			</select>
		</script>
	</section>
</section>
