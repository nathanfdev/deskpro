{% import 'AgentBundle:Common:macro-flagname.html.twig' as flagnamer %}
<!-- DeskPRO Source List Inbox -->
<div class="pendingTicket">
	<div class="titles">
		<div class="ticketHoldCheck">
			<div class="item">
				<span class="edit" id="ticket_filter_launch_editor">edit display</span>
			</div>
		</div>
			<h2>
				<div class="holdTicketCount">
					<span class="dp-checkbox checkbox show-hold-check"></span>
					<span class="count"></span>
					Tickets On hold
				</div>
				Inbox
			</h2>
		<br class="clear" />
	</div>
	<!-- DeskPro Inbox Ticket -->
	<div class="yourPendingTicket" id="system_filters_wrap">
		<ul id="tickets_outline_sys_filters" class="navList">
			{% for filter in sys_filters %}
				<li
					class="filter filter-{{filter.id}} filter-{{filter.sys_name}} nav-filter-{{filter.id}} {% if loop.first %}auto-load-route{% endif %} {% if loop.index == 1 %}active{% endif %}"
					data-filter-id="{{filter.id}}"
					data-filter-name="{{filter.sys_name}}"
				>
					<a class="groupHead {% if loop.index == 1 %}on{% endif %}" data-route="listpane:{{ path('agent_ticketsearch_runfilter', {'filter_id': filter.id}) }}">
						{{filter.title}}
						<span class="listCounter" id="ticket_filter_{{filter.id}}_count">
							{{ filter_counts[filter.id]|default(0) }}
						</span>
					</a>
					<ul class="subGroup" style="display: none;"></ul>
				</li>
			{% endfor %}
		</ul>
		<ul id="tickets_outline_sys_hold_filters" class="navList" style="display: none;">
			{% for filter in sys_filters_hold %}
				<li
					class="filter filter-{{filter.id}} filter-{{filter.sys_name}} is-hold-filter nav-filter-{{filter.id}} {% if loop.first %}auto-load-route{% endif %} {% if loop.index == 1 %}active{% endif %}"
					data-filter-id="{{filter.id}}"
					data-filter-name="{{filter.sys_name}}"
				>
					<a class="groupHead {% if loop.index == 1 %}on{% endif %}" data-route="listpane:{{ path('agent_ticketsearch_runfilter', {'filter_id': filter.id}) }}">
						{{filter.title}}
						<span class="listCounter" id="ticket_filter_{{filter.id}}_count">
							{{ filter_counts[filter.id]|default(0) }}
						</span>
					</a>
					<ul class="subGroup" style="display: none;"></ul>
				</li>
			{% endfor %}
		</ul>
	</div>
</div>
<!-- DeskPRO Source List Ticket Filter -->

{% if custom_filters %}
	<div class="filters">
		<div class="titles">
			<div class="ticketHoldCheck">
				<div class="item">
					<span class="edit">edit display</span>
				</div>
			</div>
			<h2>Filters</h2>
		</div>
		<div class="yourPendingTicket">
			<ul id="ticketsOutlineFiltersList" class="navList">
				{% for filter in custom_filters %}
					<li
						class="filter-{{filter.id}} nav-filter-{{filter.id}}"
						data-filter-id="{{filter.id}}"
					>
						<a class="groupHead" data-route="listpane:{{ path('agent_ticketsearch_runfilter', {'filter_id': filter.id}) }}">
							{{filter.title}}
							<span class="listCounter" id="ticket_filter_{{filter.id}}_count">
								{{ filter_counts[filter.id]|default(0) }}
							</span>
						</a>
					</li>
				{% endfor %}
			</ul>
		</div>
	</div>
{% endif %}

<div id="tickets_outline_tabstrip" class="listTabNavTicket">
	<div id="navTabStrip" class="desproTabStrip">
		<ul>
			<li class="labels"  data-tab-for="#tickets_outline_labels"><a>Labels</a></li>
			<li class="flagged" data-tab-for="#tickets_outline_flagged"><a>Flagged</a></li>
			<li class="archive" data-tab-for="#tickets_outline_archive"><a>Archive</a></li>
		</ul>
		<br class="clear" />
	</div>
</div>

<section id="tickets_outline_labels"  class="deskpro-tab-item">
	Loading ...
</section>
<section id="tickets_outline_flagged" class="deskpro-tab-item">
	<ul id="tickets_outline_flags_list" class="navSimpleList" style="margin-top: 4px;">
		{% for color in flags %}
			<li class="flag flag-{{color}} nav-flag-{{color}}" data-flag="{{color}}" data-route="listpane:{{ path('agent_ticketsearch_runflag', {'flag': color, 'view_name': 'flag', 'view_extra': color}) }}">
				<a>
					<span>{{ flagnamer.flag_name(color, person) }}</span>
					<span id="ticket_flag_{{color}}_count" class="listCounter">0</span>
				</a>
			</li>
		{% endfor %}
	</ul>
</section>
<section id="tickets_outline_archive" class="deskpro-tab-item">
	<ul id="tickets_outline_filters_list" class="navSimpleList" style="margin-top: 4px;">
		<li class="with-route nav-archive-spam" data-route="listpane:{{ path('agent_ticketsearch_runcustomfilter') }}?terms[0][type]=hidden_status&amp;terms[0][op]=is&amp;terms[0][options][hidden_status]=spam&amp;view_name=spam">
			<a>Spam</a>
		</li>
		<li class="with-route nav-archive-validating" data-route="listpane:{{ path('agent_ticketsearch_runcustomfilter') }}?terms[0][type]=hidden_status&amp;terms[0][op]=is&amp;terms[0][options][hidden_status]=validating&amp;view_name=validating">
			<a>Validating</a>
		</li>
		<li class="with-route nav-archive-pending" data-route="listpane:{{ path('agent_ticketsearch_runcustomfilter') }}?terms[0][type]=status&amp;terms[0][op]=is&amp;terms[0][options][status]=pending&amp;view_name=pending">
			<a>Pending</a>
		</li>
		<li class="with-route nav-archive-resolved" data-route="listpane:{{ path('agent_ticketsearch_runcustomfilter') }}?terms[0][type]=status&amp;terms[0][op]=is&amp;terms[0][options][status]=resolved&amp;view_name=resolved">
			<a>Resolved</a>
		</li>
		<li class="with-route nav-archive-closed" data-route="listpane:{{ path('agent_ticketsearch_runcustomfilter') }}?terms[0][type]=status&amp;terms[0][op]=is&amp;terms[0][options][status]=closed&amp;view_name=closed">
			<a>Closed</a>
		</li>
		<li>
			<a class="with-route nav-archive-recycle-bin" data-route="listpane:{{ path('agent_recyclebin') }}">Recycle Bin</a>
		</li>
	</ul>
</section>


<section id="ticket_filter_group_editor">
	<section class="filter-group-editor">
		<script type="text/x-deskpro-plain" class="editor-row-tpl">
			<div class="filter-row">
				<div class="field-wrap"></div>
			</div>
		</script>
		<script type="text/x-deskpro-plain" class="editor-fields-tpl">
			<select>
				<option value="">(none)</option>
				<option value="department">Department</option>
				<option value="category">Category</option>
				<option value="priority">Priority</option>
				<option value="product">Product</option>
				<option value="workflow">Workflow</option>
				<option value="organization">Organization</option>
				<option value="language">Language</option>
				<option value="urgency">Urgency</option>
				<option value="agent">Agent</option>
				<option value="agent_team">Agent Team</option>
				<option value="time_waiting">Time Waiting</option>
				<option value="date_created">Date Created</option>
			</select>
		</script>
	</section>
</section>
