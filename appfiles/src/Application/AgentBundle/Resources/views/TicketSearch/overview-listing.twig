<ul class="nav-list overview-list nosel">
	{% for group1 in counts %}
		<li data-route="listpane:{{ list_url_group1|replace({ '$group1_id': group1.id }) }}"><span class="count">{{group1.total}}</span>{{group1.title}}</li>
		{% if group1.sub %}
			{% for group2 in group1.sub %}
				<li data-route="listpane:{{ list_url_group2|replace({ '$group1_id': group1.id, '$group2_id': group2.id }) }}" class="sub"><span class="count">{{group2.total}}</span>{{group2.title}}</li>
			{% endfor %}
		{% endif %}
	{% endfor %}
</ul>