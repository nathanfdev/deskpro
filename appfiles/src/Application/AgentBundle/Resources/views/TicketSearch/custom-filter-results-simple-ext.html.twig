<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.TicketCustomFilter';
pageMeta.viewTypeUrl = '{{ path('agent_ticketsearch_runcustomfilter') }}?cache_id={{cache_id}}&view_type=$view_type';
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.TicketCustomFilter';
pageMeta.pageUrl = '{{ path('agent_ticketsearch_runcustomfilter') }}?partial=1&cache_id={{cache_id}}&page=$page';
pageMeta.refreshUrl = '{{ path('agent_ticketsearch_runcustomfilter') }}?cache_id={{cache_id}}';
pageMeta.saveListPrefsUrl = '{{ path('agent_ticketsearch_save_resultprefs', {'cache_id': cache_id}) }}';
{% if cache_id %}
	pageMeta.cache_id = {{cache_id}};
{% endif %}
{% if not tickets %}
	pageMeta.noResults = true;
{% endif %}
{% if is_new_recentsearch %}
pageMeta.isNewRecentSearch = true;
{% endif %}
{% if recent_search_id %}
pageMeta.recent_search_id = '{{ recent_search_id }}';
{% endif %}
{% if view_name %}
	pageMeta.view_name = '{{ view_name }}';
{% endif %}
{% if view_extra %}
	pageMeta.view_extra = '{{ view_extra }}';
{% endif %}
</script>
<div class="layout-content">
<div class="content">

	{% include 'AgentBundle:TicketSearch:part-display-options-overlay.html.twig' %}

	<header class="controlBar">
		<ul class="controlBarList">
			<li>Ordered by </li>
			<li class="tickerPicker"><a class="button"><span class="dropdownIcon">Urgency</span></a></li>
			<li><span class="borderBar"></span></li>
			<li>and Grouped by </li>
            <li><a class="button">Departement</a></li>
			<li class="displayOpt display-options-trigger"><a>Display option</a></li>
			<li class="detailView detail-view-trigger"><a class="setupIcon">Detail</a></li>
		</ul>
	</header>

	{% if grouped_info and grouped_info.counts[-1].total > 0 %}
		<header class="groupingBar">
			{% if grouped_info.counts[-1].total > 0 %}
				<li data-grouping-option="">
					<a>
						All
						<span>{{ grouped_info.counts[-1].total }}</span>
					</a>
				</li>
			{% endif %}
			{% if grouped_info.counts[0].total > 0 %}
				<li data-grouping-option="0">
					<a>
						None
						<span>{{ grouped_info.counts[0].total }}</span>
					</a>
				</li>
			{% endif %}
			{% for cat in grouped_info.group1_structure %}
				{% set count = grouped_info.counts[cat.id].total %}
				{% if count > 0 %}
					<li data-grouping-option="{{ cat.id }}">
						<a>
							{{ cat.title }}
							<span>{{ count }}</span>
						</a>
					</li>
					{% if cat.children %}
						{% for subcat in cat.children %}
							{% set subcount = grouped_info.counts[subcat.id].total %}
							{% if subcount > 0 %}
								<li class="subList" data-grouping-option="{{ subcat.id }}">
									<span class="borderLink"></span>
									<a>
										{{ cat.title }} &gt;
										{{ subcat.title }}
										<span>{{ subcount }}</span>
									</a>
								</li>
							{% endif %}
						{% endfor %}
					{% endif %}
				{% endif %}
			{% endfor %}
        </header>
	{% endif %}

	<header class="selectionBar selection-bar" style="display: none;">
		<span class="selected-count selectedCount">0</span> selected
		<a class="performActTrigger perform-actions-trigger"><span class="dropdownIcon">Perform Action</span></a>
	</header>

	<div class="contentList">
		<section class="ticketListWrap">
			{% include 'AgentBundle:TicketSearch:part-results-simple-ext.html.twig' %}
		</section>
	</div>

	{% include 'AgentBundle:Ticket:part-flag-menu.html.twig' %}
</div>

</div>
