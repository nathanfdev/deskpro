<tbody class="search-results page-set" data-page="{{page}}">
{% for ticket in tickets %}
	<tr class="line-1" data-ticket-id="{{ticket.id}}">
		<td rowspan="2" class="check-all"><input type="checkbox" value="{{ticket.id}}" class="ticket" style="width:10px; margin: 0; margin-rght: 4px; padding: 0;"/></td>
		<td colspan="{{display_fields|length}}">
			<abbr class="timeago" title="{{ticket.date_created|date('c')}}">{{ticket.date_created|date('Y-m-d')}}</abbr>
			<span class="subject with-route" data-route="ticket:{{ path('agent_ticket_view', {'ticket_id': ticket.id}) }}">{{ticket.subject}}</span>
		</td>
		{% if show_flag %}
			{% set ticket_flagged_color = flagged_tickets[ticket.id]|default('none') %}			
			<td rowspan="2" class="flag"><span class="ticket-flag icon icon-flag-{{ticket_flagged_color}}" data-flag="{{ticket_flagged_color}}"></span></td>
		{% endif %}
	</tr>
	<tr class="line-2" data-ticket-id="{{ticket.id}}">
		{% for field in display_fields %}
			<td class="{{field}}" {% if loop.last %}style="text-align:right"{% endif %}>
			{% if field == 'person' %}
				by <cite>{{ticket.person.name}}</cite>
			{% elseif field == 'department' %}
				{{ticket.department.title}}
			{% elseif field == 'category' %}
				{% if ticket.category %}
					{{ticket.category.title}}
				{% else %}
					None
				{% endif %}
			{% elseif field == 'product' %}
				{% if ticket.product %}
					{{ticket.product.title}}
				{% else %}
					None
				{% endif %}
			{% elseif field == 'organization' %}
				{% if ticket.organization %}
					{{ticket.organization.name}}
				{% else %}
					None
				{% endif %}
			{% elseif field == 'agent' %}
				{% if ticket.agent %}
					{{ticket.agent.display_name}}
				{% else %}
					Unassigned
				{% endif %}
			{% endif %}
		{% endfor %}
	</tr>
{% endfor %}
</tbody>