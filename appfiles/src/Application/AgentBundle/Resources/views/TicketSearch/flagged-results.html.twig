{% import 'AgentBundle:Common:macro-flagname.html.twig' as flagnamer %}
<script>
pageMeta.title = 'Flagged: {{flagnamer.flag_name(flag, person)}}';
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.TicketFlagged';
pageMeta.flag = '{{flag}}';
pageMeta.pageUrl = '{{ path('agent_ticketsearch_runflag', {'flag': flag}) }}?partial=1&page=$page';
{% if flag %}
	pageMeta.flag = '{{flag}}';
{% endif %}
</script>
{% set section = 'flagged' %}

<div class="content">
	<div class="pad">
		<div class="inner-box-tab-content box-list no-pad">
			<table class="list" cellspacing="0" width="100%">
				{% include 'AgentBundle:TicketSearch:part-results-list-thead.html.twig' %}
				{% include 'AgentBundle:TicketSearch:part-results-list.html.twig' %}
			</table>
		</div>
	</div>

	<div class="loading-more">
		Loading more results ...
	</div>
	<div class="no-more-results">
		There are no more results.
	</div>
</div>
{% include 'AgentBundle:TicketSearch:part-action-bar.html.twig' %}