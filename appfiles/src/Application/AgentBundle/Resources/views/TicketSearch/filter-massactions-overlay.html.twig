<div
	class="mass-actions-overlay-container mass-actions"
	data-base-id="{{baseId}}"
	data-upload-url="{{ path('agent_accept_upload') }}"
>
	<script type="text/x-deskpro-plain" class="radio-tpl">
		<button class="clean-white radio"><span class="radio-title"></span></button>
	</script>
	<section class="mass-actions-overlay">
		<header>
			<span class="close close-trigger">close</span>
			<h1>Apply actions to <span class="selected-tickets-count"></span> tickets</h1>
		</header>
		<article>
			{% if macros|length %}
				<div class="macro-load">
					<select class="macro">
						<option value="">Load a macro</option>
						<option value="">------------</option>
						{% for macro in macros %}
							<option value="{{ macro.id }}">{{ macro.title }}</option>
						{% endfor %}
					</select>

					<button class="clean-white apply-macro-trigger">Apply</button>
				</div>
			{% endif %}

			<dl>
				<dt>Change Status</dt>
				<dd>
					<label class="radio-item" data-attach-class="status status-resolved">
						<input type="radio" name="actions[status]" value="resolved" class="button-toggle" />
						<span class="radio-title">Resolve Ticket</span>
					</label>
					<label class="radio-item" data-attach-class="status status-pending">
						<input type="radio" name="actions[status]" value="pending" class="button-toggle" />
						<span class="radio-title">Set Awaiting User</span>
					</label>
					<label class="radio-item" data-attach-class="status status-open">
						<input type="radio" name="actions[status]" value="open" class="button-toggle" />
						<span class="radio-title">Set Awaiting Agent</span>
					</label>
				</dd>

				<dt>Assignments</dt>
				<dd class="assignments">
					<ul id="{{baseId}}_assign_btn">
						<li class="no-changes"><em>Set assignments</em></li>
						<li style="display:none" class="assign-agent"><em>Assign agent</em>: <span class="label"></span></li>
						<li style="display:none" class="assign-team"><em>Assign team</em>: <span class="label"></span></li>
						<li style="display:none" class="add-followers"><em>Add followers</em>: <span class="label"></span></li>
					</ul>
				</dd>

				<dt>Change Property</dt>
				<dd>
					{% include 'AgentBundle:Common:select-department.html.twig' with {
						'name': 'actions[department]',
						'with_blank': true,
						'with_blank2': true,
						'blank_title': 'Set Department',
						'departments': ticket_options.departments_hierarchy
					} %}

					{% include 'AgentBundle:Common:select-category.html.twig' with {
						'name': 'actions[category]',
						'with_blank': true,
						'with_blank2': true,
						'blank_title': 'Set Category',
						'categories': ticket_options.ticket_categories_hierarchy
					} %}

					{% include 'AgentBundle:Common:select-product.html.twig' with {
						'name': 'actions[product]',
						'with_blank': true,
						'with_blank2': true,
						'blank_title': 'Set Product',
						'products': ticket_options.products_hierarchy
					} %}

					{% include 'AgentBundle:Common:select-priority.html.twig' with {
						'name': 'actions[priority]',
						'with_blank': true,
						'with_blank2': true,
						'blank_title': 'Set Priority',
						'priorities': ticket_options.ticket_priorities
					} %}

					{% include 'AgentBundle:Common:select-workflow.html.twig' with {
						'name': 'actions[workflow]',
						'with_blank': true,
						'with_blank2': true,
						'blank_title': 'Set Workflow',
						'workflows': ticket_options.ticket_workflows
					} %}
				</dd>
			</dl>
			<div class="profile-box-container reply-box-wrap">
				<header>
					<nav>
						<ul><li>Reply</li></ul>
					</nav>
				</header>
				<section class="ticketreply">
					<nav id="{{baseId}}_header_rows">
						<ul class="option-buttons">
							<li class="tipped attach hide-note" title="Add attachments">
								<input type="file" class="file" name="file-upload" />
								<span>Attachments</span>
							</li>
							<li class="tipped snippets hide-note" id="{{baseId}}_text_snippets_btn" title="Insert text snippets"><span>Snippets</span></li>
						</ul>
					</nav>
					<article>
						<section>
							<ul id="{{baseId}}_attach_row" style="display: none">
								<li class="attach-row">
									<label><span>Attachments</span></label>
									<div>
										<ul class="files"></ul>
										<br class="clear"/>
									</div>
								</li>

								<script class="template-upload" type="text/x-jquery-tmpl">
									<li class="uploading">${name} (uploading)</li>
								</script>
								<script class="template-download" type="text/x-jquery-tmpl">
									<li>
										<input type="hidden" name="actions[reply][attach_ids][]" value="${blob_id}" />
										<em class="remove-attach-trigger">remove attachment</em>
										<label><a href="${download_url}" target="_blank">${filename}</a><span>${filesize_readable}</span></label>
									</li>
								</script>
							</ul>
							<div class="input-wrap">
								<textarea placeholder="Enter a mass reply" id="{{baseId}}_replybox_txt" name="actions[reply][reply_text]"></textarea>
							</div>
						</section>
					</article>
				</section>
			</div>
		</article>
		<footer>
			<button class="apply-actions">
				Apply
			</button>
		</footer>
	</section>

    <div class="optionbox reply-agent-team-ob" id="{{baseId}}_agent_selector">
    	<header>
			<h4>Assignments and Followers</h4>
			<span class="close close-trigger"></span>
		</header>
    	<div class="col">
    		<section data-section-name="agents">
    			<header>
    				<h3>Agents</h3>
    				<input type="text" class="filter-box" placeholder="Filter..." />
    			</header>
    			<ul>
    				<li class="on">
    					<input type="radio" name="{{baseId}}_agent" class="agent agent-none" value="-1" checked="checked" />
    					<label>Do not change agent</label>
    				</li>

    				<li class="me last-me">
    					<input type="radio" name="{{baseId}}_agent" class="agent agent-{{app.user.id}}" value="{{ app.user.id }}" />
    					<label><span class="agent-pic agent-label-{{ app.user.id }}" style="background-image: url({{ app.user.getPictureUrl(16) }})">Me</span></label>
    				</li>

    				<li>
    					<input type="radio" class="agent agent-0" name="{{baseId}}_agent" value="0" />
    					<label><span class="agent-pic agent-label-0">Unassigned</span></label>
    				</li>

    				{% for agent in agents %}
    					{% if agent.id != app.user.id %}
    						<li>
    							<input type="radio" class="agent agent-{{agent.id}}" name="{{baseId}}_agent" value="{{ agent.id }}" />
    							<label><span class="agent-pic agent-label-{{ agent.id }}" style="background-image: url({{ agent.getPictureUrl(16) }})">{{ agent.display_name }}</span></label>
    							<div class="bound-fade"></div>
    						</li>
    					{% endif %}
    				{% endfor %}
    			</ul>
    		</section>
    	</div>
    	<div class="col">
    		<section data-section-name="teams">
    			<header>
    				<h3>Teams</h3>
    				<input type="text" class="filter-box" placeholder="Filter..." />
    			</header>
    			<ul>
    				<li class="on">
    					<input type="radio" name="{{baseId}}_agent_team" value="-1" checked="checked" />
    					<label>Do not change team</label>
    				</li>
    				{% for team in app.user.getAgent().getTeams() %}
    					<li class="me {% if loop.last %}last-me{% endif %}">
    						<input type="radio" name="{{baseId}}_agent_team" value="{{ team.id }}" />
    						<label class="agent-team-label-{{ team.id }}">{{ team.name }}</label>
    						<div class="bound-fade"></div>
    					</li>
    				{% endfor %}

    				<li class="on">
    					<input type="radio" name="{{baseId}}_agent_team" value="0" />
    					<label><span class="agent-team-label-0">No Team</span></label>
    				</li>

    				{% for team in agent_teams %}
    					{% if team.id not in app.user.getAgent().getTeamIds() %}
    						<li>
    							<input type="radio" name="{{baseId}}_agent_team" value="{{ team.id }}" />
    							<label class="agent-team-label-{{ team.id }}">{{ team.name }}</label>
    							<div class="bound-fade"></div>
    						</li>
    					{% endif %}
    				{% endfor %}
    			</ul>
    		</section>
    	</div>
    	<div class="col">
    		<section data-section-name="followers">
    			<header>
    				<h3>Followers</h3>
    				<input type="text" class="filter-box" placeholder="Filter..." />
    			</header>
    			<ul>
    				<li class="me last-me">
    					<input type="checkbox" name="{{baseId}}_part" value="{{ app.user.id }}" />
    					<label><span class="agent-pic agent-part-label-{{ app.user.id }}" style="background-image: url({{ app.user.getPictureUrl(16) }})">Me</span></label>
    				</li>

    				{% for agent in agents %}
    					{% if agent.id != app.user.id %}
    						<li>
    							<input type="checkbox" name="{{baseId}}_part" value="{{ agent.id }}" />
    							<label><span class="agent-pic agent-part-label-{{ agent.id }}" style="background-image: url({{ agent.getPictureUrl(16) }})">{{ agent.display_name }}</span></label>
    							<div class="bound-fade"></div>
    						</li>
    					{% endif %}
    				{% endfor %}
    			</ul>
    		</section>
    	</div>
    	<br class="clear" />
    	<footer>
			<button class="save-trigger">Apply</button>
		</footer>
    </div>
</div>
