{% if grouped_info %}
<div class="inner-box-tab-content top-box">
	<ul>
		{% for info in grouped_info %}
			{% if info.id != -1 %}
				<li data-group-id="{{info.id}}">
					<label>
						{% if info.title == 'open' %}Open
						{% elseif info.title == 'pending' %}Pending
						{% elseif info.title == 'closed' %}Closed
						{% elseif info.title == 'resolved' %}Resolved
						{% elseif info.title == 'hidden' %}Hidden
						{% else %}{{info.title}}
						{% endif %}
					</span>
					<span class="counter">{{info.total}}</span>
				</li>
			{% endif %}
		{% endfor %}
		<li class="total on" data-group-id="NONE">
			<label>Total</label>
			<span class="counter">{{grouped_info[0].total}}</span>
		</li>
	</ul>
</div>
{% endif %}