<header class="list-selection-bar">
	<input class="selection-control" type="checkbox" />
	<span class="selected-count">0</span> selected

	<a class="perform-action perform-actions-trigger disabled">
		<span>Perform Action</span>
	</a>

	<div class="mass-actions-overlay-container">
		<script type="text/x-deskpro-plain" class="radio-tpl">
			<button class="clean-white radio"><span class="radio-title"></span></button>
		</script>
		<section class="mass-actions-overlay">
			<header>
				<span class="close close-trigger">close</span>
				<h1>Apply actions to <span class="selected-tickets-count"></span> tickets</h1>
			</header>
			<article>
				{% if macros|length %}
					<div class="macro-load">
						<select class="macro">
							<option value="">Load a macro</option>
							<option value="">------------</option>
							{% for macro in macros %}
								<option value="{{ macro.id }}">{{ macro.title }}</option>
							{% endfor %}
						</select>

						<button class="clean-white apply-macro-trigger">Apply</button>
					</div>
				{% endif %}

				<dl>
					<dt>Change Status</dt>
					<dd>
						<label class="radio-item" data-attach-class="status status-resolved">
							<input type="radio" name="actions[status]" value="resolved" />
							<span class="radio-title">Resolve Ticket</span>
						</label>
						<label class="radio-item" data-attach-class="status status-pending">
							<input type="radio" name="actions[status]" value="pending" />
							<span class="radio-title">Set Awaiting User</span>
						</label>
						<label class="radio-item" data-attach-class="status status-open">
							<input type="radio" name="actions[status]" value="open" />
							<span class="radio-title">Set Awaiting Agent</span>
						</label>
					</dd>

					<dt>Change Ownership</dt>
					<dd>
						<select name="actions[agent]">
							<option value="">Assign Agent</option>
							<option value="{{ app.user.id }}">Assign to me</option>
							<option value=""></option>
							{% for id,name in ticket_options.agents %}
								<option value="{{ id }}">{{ name }}</option>
							{% endfor %}
						</select>
						{% include 'AgentBundle:Common:select-agent-team.html.twig' with {
							'name': 'actions[agent_team]',
							'with_blank': true,
							'with_blank2': true,
							'blank_title': 'Assign Team',
							'agent_teams': ticket_options.agent_teams
						} %}
					</dd>

					<dt>Change Property</dt>
					<dd>
						{% include 'AgentBundle:Common:select-department.html.twig' with {
							'name': 'actions[department]',
							'with_blank': true,
							'with_blank2': true,
							'blank_title': 'Set Department',
							'departments': ticket_options.departments_hierarchy
						} %}

						{% include 'AgentBundle:Common:select-category.html.twig' with {
							'name': 'actions[category]',
							'with_blank': true,
							'with_blank2': true,
							'blank_title': 'Set Category',
							'categories': ticket_options.ticket_categories_hierarchy
						} %}

						{% include 'AgentBundle:Common:select-product.html.twig' with {
							'name': 'actions[product]',
							'with_blank': true,
							'with_blank2': true,
							'blank_title': 'Set Product',
							'products': ticket_options.products_hierarchy
						} %}

						{% include 'AgentBundle:Common:select-priority.html.twig' with {
							'name': 'actions[priority]',
							'with_blank': true,
							'with_blank2': true,
							'blank_title': 'Set Priority',
							'priorities': ticket_options.ticket_priorities
						} %}

						{% include 'AgentBundle:Common:select-workflow.html.twig' with {
							'name': 'actions[workflow]',
							'with_blank': true,
							'with_blank2': true,
							'blank_title': 'Set Workflow',
							'workflows': ticket_options.ticket_workflows
						} %}
					</dd>
				</dl>
				<div class="reply-area">
					<nav>
						<ul>
							<li class="on">Reply</li>
						</ul>
					</nav>
					<div class="reply-wrap">
						<textarea name="actions[reply][reply_text]"></textarea>
					</div>
					<div class="reply-foot">
						<button class="clean-white text-snippets">Text Snippets</button>
						<button class="clean-white attach-files">Attach Files</button>
					</div>
				</div>
			</article>
			<footer>
				<button class="apply-actions">
					Apply
				</button>
			</footer>
		</section>
	</div>
</header>
