{% for queue in queues %}
	{% if not queue.sys_name %}
		<li class="queue-{{queue.id}}" data-queue-id="{{queue.id}}" data-route="listpane:{{ path('agent_ticketsearch_runqueue', {'queue_id': queue.id}) }}">
			<span class="list-counter" id="filter_{{queue.id}}_count">-</span>
			<a>{{queue.title}}</a>
		</li>
	{% endif %}
{% endfor %}