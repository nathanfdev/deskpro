<script>
pageMeta.title = 'Ticket Queue';
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.TicketSearch';
pageMeta.pageUrl = '{{ path('agent_ticketsearch_runqueue', {'queue_id': queue_id}) }}?partial=1&page=$page';
{% if queue_id %}
	pageMeta.queue_id = {{queue_id}};
{% endif %}
</script>
<div class="display-options overlay">
	<h1>Display Options</h1>
	<div style="float: right; width: 100px;">
		Order By: <select name="order_by">
			<option value="id.asc">Date Opened</option>
		</select>
	</div>
	<div style="margin-right: 115px;">
		<strong>Display Elements</strong><br />
		<ul class="sortable-list">
			<li data-field="person"><input type="checkbox" name="person" /> Contact Name</li>
			<li data-field="department"><input type="checkbox" name="department" /> Department</li>
			<li data-field="category"><input type="checkbox" name="category" /> Category</li>
			<li data-field="product"><input type="checkbox" name="product" /> Product</li>
			<li data-field="organization"><input type="checkbox" name="organization" /> Organization Name</li>
			<li data-field="agent"><input type="checkbox" name="agent" /> Agent Name</li>
		</ul>
	</div>
	<div class="buttons">
		<div class="loading-off">
			<button class="save-trigger dp-button small">Save</button>
			<button class="close-trigger dp-button gray small">Cancel</button>
		</div>
		<div class="loading-on">
			<span>Saving ...</span>
		</div>
	</div>
</div>

<table class="list" cellspacing="0" width="100%">
	<thead class="display-options-trigger nosel">
		<tr>
			{% for field in display_fields %}
				{% if field == 'person' %}<th data-field="person">User</th>
				{% elseif field == 'department' %}<th data-field="department">Department</th>
				{% elseif field == 'category' %}<th data-field="category">Category</th>
				{% elseif field == 'product' %}<th data-field="product">Product</th>
				{% elseif field == 'product' %}<th data-field="product">Product</th>
				{% elseif field == 'organization' %}<th data-field="organization">Organization</th>
				{% elseif field == 'agent' %}<th data-field="agent">Agent</th>
				{% endif %}
			{% endfor %}
		</tr>
	</thead>
	{% include 'AgentBundle:TicketSearch:queue-results-list.twig' %}
</table>

<div class="loading-more">
	Loading more results ...
</div>
<div class="no-more-results">
	There are no more results.
</div>