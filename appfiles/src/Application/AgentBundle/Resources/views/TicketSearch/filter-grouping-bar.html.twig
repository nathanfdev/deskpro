{% if grouped_info and grouped_info.counts[-1].total > 0 %}
	{% set grouping_url = 'listpane:' ~ path('agent_ticketsearch_runfilter', {'filter_id': filter_id}) ~ '?group_by=' ~ group_by ~ '&grouping_option=' %}
	<header class="groupingBar">
		{% if grouped_info.counts[-1].total > 0 %}
			<li data-grouping-option="" {% if grouping_option == 'DP_NOT_SET' %}class="on"{% endif %}>
				<a data-route="{{ grouping_url }}">
					All
					<span>{{ grouped_info.counts[-1].total }}</span>
				</a>
			</li>
		{% endif %}
		{% if grouped_info.counts[0].total > 0 %}
			<li data-grouping-option="0" {% if grouping_option == '0' %}class="on"{% endif %}>
				<a data-route="{{ grouping_url ~ '0' }}">
					None
					<span>{{ grouped_info.counts[0].total }}</span>
				</a>
			</li>
		{% endif %}
		{% for cat in grouped_info.group1_structure %}
			{% set count = grouped_info.counts[cat.id].total %}
			{% set count_all = count %}
			{% if cat.children %}
				{% for subcat in cat.children %}
					{% set count_all = count_all + grouped_info.counts[subcat.id].total %}
				{% endfor %}
			{% endif %}
			{% if count > 0 %}
				<li data-grouping-option="{{ cat.id }}" {% if grouping_option == cat.id %}class="on"{% endif %}>
					<a data-route="{{ grouping_url ~ cat.id }}">
						{{ cat.title }}
						<span>{{ count }}{% if cat.children and count != count_all %}/{{ count_all }}{% endif %}</span>
					</a>
				</li>
				{% if cat.children %}
					{% for subcat in cat.children %}
						{% set subcount = grouped_info.counts[subcat.id].total %}
						{% if subcount > 0 %}
							<li class="subList {% if grouping_option == subcat.id %}on{% endif %}" data-grouping-option="{{ subcat.id }}">
								<span class="borderLink"></span>
								<a data-route="{{ grouping_url ~ subcat.id }}">
									{{ cat.title }} &gt;
									{{ subcat.title }}
									<span>{{ subcount }}</span>
								</a>
							</li>
						{% endif %}
					{% endfor %}
				{% endif %}
			{% endif %}
		{% endfor %}
		<br class="clear" />
	</header>
{% endif %}
