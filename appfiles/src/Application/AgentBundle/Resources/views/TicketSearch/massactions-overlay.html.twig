<div class="mass-actions overlay">
	<div class="overlay-title">
		<h4>Apply actions to <span class="check-count-overlay"></span> tickets</h4>
	</div>

	<div class="overlay-content" style="padding-bottom: 15px;">

		<div class="macro-selector">
			<div class="spinner"></div>
			<select class="apply-macro-select">
				<option value="0">Load a macro</option>
				<option value="0"></option>
				{% for macro in macros %}
					<option value="{{macro.id}}">{{macro.title}}</option>
				{% endfor %}
			</select>
		</div>

		<dl>
			<dt>Change Status</dt>
			<dd>
				<button class="clean-gray x-small radio-option group-status" data-radio-group="group-status">Close Ticket</button>
				<button class="clean-gray x-small radio-option group-status" data-radio-group="group-status">Set Awaiting User</button>
				<button class="clean-gray x-small radio-option group-status" data-radio-group="group-status">Set Awaiting Agent</button>
			</dd>

			<dt>Change Ownership</dt>
			<dd>
				<button class="clean-gray x-small radio-option group-assign" data-radio-group="group-assign">Assigned to Me</button>
				<button class="clean-gray x-small radio-option group-assign" data-radio-group="group-assign">Unassign</button>
				<select>
					<option>Assign to...</option>
				</select>

				&nbsp;&nbsp;&nbsp;&nbsp;

				<button class="clean-gray x-small radio-option">Assign to my Team</button>
				<select>
					<option>Assign to team...</option>
				</select>
			</dd>

			<dt>Change Property</dt>
			<dd>
				<select><option>Set Category</option></select>
				<select><option>Set Priority</option></select>
				<select><option>Set Language</option></select>
				<select><option>Set Product</option></select>
				<select><option>Set Workflow</option></select>
				<select><option>Set Flag</option></select>
				<select><option>Set Urgency</option></select>
			</dd>

			<dt>Add / Remove Label</dt>
			<dd>
				<select><option>Remove A Label</option></select>
				<button class="clean-gray x-small">Add Label</button>
			</dd>

			<dt>
				<input type="checkbox" class="reply-check" />
				Mass Reply
			</dt>
			<dd>
				<div class="reply-area" style="display: none;">
					<textarea></textarea><br/>
					<button class="dp-button x-small">Add Attachment</button>
				</div>
			</dd>
		</dl>
	</div>
	<div class="overlay-actions">
		<div class="loading-off">
			<button class="save-trigger dp-button small">View Changes</button>
		</div>
		<div class="loading-on" style="display:none">

		</div>
	</div>
</div>