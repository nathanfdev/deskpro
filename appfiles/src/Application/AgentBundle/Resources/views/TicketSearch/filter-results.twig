			<option value="id.asc">Date Opened</option>
		</select>
	</div>
	<div style="margin-right: 115px;">
		<strong>Display Elements</strong><br />
		<ul class="sortable-list">
			<li><input type="checkbox" name="display_fields[person]" /> Contact Name</li>
			<li><input type="checkbox" name="display_fields[department]" /> Department</li>
			<li><input type="checkbox" name="display_fields[product]" /> Category</li>
			<li><input type="checkbox" name="display_fields[product]" /> Product</li>
			<li><input type="checkbox" name="display_fields[organization]" /> Organization Name</li>
			<li><input type="checkbox" name="display_fields[agent]" /> Agent Name</li>
		</ul>
	</div>
	<div class="buttons">
		<button class="save dp-button">Save</button>
		<button class="cancel dp-button gray overlay-close-trigger">Cancel</button>
	</div>
</div>

