<script>
pageMeta.class = 'DeskPRO.Agent.PageFragment.ListPane.TicketSearch';
</script>

<div class="search-results">
	<table class="list" cellspacing="0" width="100%">
		{% for ticket in tickets %}
		<tbody>
			<tr data-route="person:{% path 'agent_ticket_view' with ['ticket_id': ticket.id] %}">
				<td>
					{{ticket.subject}}
				</td>
				<td width="100" align="right">
					{{ticket.date_created|date('Y-m-d')}}
				</td>
			</tr>
			<tr class="info-line" data-route="person:{% path 'agent_ticket_view' with ['ticket_id': ticket.id] %}">
				<td colspan="2">
					<div class="by">by <cite>{{ticket.person.name}}</cite></div>
					<div class="department">{{ticket.department.title}}</div>
				</td>
			</tr>
		</tbody>
		{% else %}
		<tr>
			<td colspan="4">No tickets</td>
		</tr>
		{% endfor %}
	</table>
</div>