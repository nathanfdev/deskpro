<script>
pageMeta.title = 'Ticket Queue';
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.TicketSearch';
pageMeta.pageUrl = '{% path 'agent_ticketsearch_runfilter' with {'filter_id': queue_id} %}?partial=1&page=$page';
{% if queue_id %}
	pageMeta.queue_id = {{queue_id}};
{% endif %}
</script>
<div class="display-options overlay">
	<h1>Display Options</h1>
	<div style="float: right; width: 100px;">
