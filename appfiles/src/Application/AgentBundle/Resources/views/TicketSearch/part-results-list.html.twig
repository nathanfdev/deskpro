<tbody class="search-results page-set" data-page="{{page}}">
{% for ticket in tickets %}
	<tr class="row-item {% if loop.index % 2 == 0 %}white{% endif %} ticket-{{ticket.id}} line-2 urgency-{{ticket.rounded_urgency}} {% if ticket.is_locked %}locked{% endif %}" data-ticket-id="{{ticket.id}}">
		<td class="check-all" style="vertical-align: middle;">
			<input type="checkbox" value="{{ticket.id}}" class="ticket item-select" style="width:10px; margin: 0; margin-rght: 4px; padding: 0;"/>
		</td>
		<td class="subject">
			<a
				style="background: url({{ asset('images/ticket-status-' ~ ticket.status ~ '.png') }}) no-repeat center left; line-height: 13px; padding-left: 15px;"
				class="subject-link"
				data-route="ticket:{{ path('agent_ticket_view', {'ticket_id': ticket.id}) }}"
				data-route-title="@selector(.tipped)"
			><span
				class="tipped"
				data-tipped="{{ path('agent_ticket_viewtip', {'ticket_id': ticket.id}) }}"
				data-tipped-options="skin: 'light', hook: { target: 'topleft', tooltip: 'bottomleft' }, ajax: true, maxWidth: 400, showDelay: 1.2"
			>{{ticket.subject}}</span></a>
		</td>
		<td>
			<a data-route="person:{{ path('agent_people_view', {'person_id': ticket.person.id|default('0')}) }}" data-route-title="@text">
				{{ticket.person.getDisplayName()}}
			</a>
		</td>
		{% for field in display_fields %}{% if field != 'agent' %}
			{% if field == 'date_created' %}
				<td class="{{field}}">
					<span class="timestamp timeago" title="{{ticket.date_created|date('c')}}">{{ticket.date_created|date('Y-m-d')}}</span>
				</td>
			{% elseif field == 'deleted_reason' %}
				<td class="{{field}}">
					{% if deleted_tickets[ticket.id] %}
						Deleted by {{ deleted_tickets[ticket.id].by_person.display_name }}
						{% if deleted_tickets[ticket.id].reason %}
							because: {{ deleted_tickets[ticket.id].reason }}
						{% endif %}
					{% endif %}
				</td>
			{% elseif field == 'person' %}
				<td class="{{field}}">
					{{ticket.person.display_name}}
				</td>
			{% elseif field == 'department' %}
				<td class="{{field}}">
					<span class="prop-val department_id" data-prop-value="{{ticket.department.id}}">
						{{ticket.department.title}}
					</span>
				</td>
			{% elseif field == 'category' %}
				<td class="{{field}}">
					<span class="prop-val category_id" data-prop-value="{{ticket.category.id}}">
					{% if ticket.category %}
						{{ticket.category.title}}
					{% else %}
						None
					{% endif %}
					</span>
				</td>
			{% elseif field == 'product' %}
				<td class="{{field}}">
					<span class="prop-val product_id" data-prop-value="{{ticket.product.id}}">
					{% if ticket.product %}
						{{ticket.product.title}}
					{% else %}
						None
					{% endif %}
					</span>
				</td>
			{% elseif field == 'organization' %}
				<td class="{{field}}">
					<span class="prop-val organization_id" data-prop-value="{{ticket.organization.id}}">
					{% if ticket.organization %}
						<a data-route="page:{{ path('agent_org_view', {'organization_id': ticket.organization.id}) }}" data-route-title="@text">{{ticket.organization.name}}</a>
					{% else %}
						None
					{% endif %}
					</span>
				</td>
			{% elseif field == 'agent' %}
				<td class="{{field}}">
					<span class="prop-val agent_id" data-prop-value="{{ticket.agent.id}}">
					{% if ticket.agent %}
						{{ticket.agent.display_name}}
					{% else %}
						Unassigned
					{% endif %}
					</span>
				</td>
			{% elseif field == 'agent_team' %}
				<td class="{{field}}">
					<span class="prop-val agent_team_id" data-prop-value="{{ticket.agent_team.name}}">
					{% if ticket.agent %}
						{{ticket.agent_team.name}}
					{% else %}
						Unassigned
					{% endif %}
					</span>
				</td>
			{% else %}
				{% for f in ticket_field_defs %}
					{% if field == 'ticket_fields['~f.id~']' %}
						<td class="ticket-field">
							<div class="prop-val ticket_fields_{{f.id}}">
								{% if ticket.hasCustomField(f.id) %}
									{{ render_custom_field(ticket.getCustomFieldDisplayArray(f.id)) }}
								{% endif %}
							</div>
						</td>
					{% endif %}
				{% endfor %}
				{% for f in person_field_defs %}
					{% if field == 'person_fields['~f.id~']' %}
						<td class="person-field">
							<div class="prop-val person_fields_{{f.id}}">
								{% if person.hasCustomField(f.id) %}
									{{ render_custom_field(person.getCustomFieldDisplayArray(f.id)) }}
								{% endif %}
							</div>
						</td>
					{% endif %}
				{% endfor %}
			{% endif %}
		{% endif %}{% endfor %}
	</tr>
{% endfor %}
</tbody>
