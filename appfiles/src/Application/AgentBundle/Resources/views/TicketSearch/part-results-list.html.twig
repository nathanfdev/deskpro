<tbody class="search-results page-set" data-page="{{page}}">
{% for ticket in tickets %}
	<tr class="{% if loop.index % 2 == 0 %}white{% endif %} ticket-{{ticket.id}} line-1 urgency-{{ticket.rounded_urgency}} {% if ticket.is_locked %}locked{% endif %}" data-ticket-id="{{ticket.id}}">
		<td class="check-all" rowspan="2" style="vertical-align: middle;">
			<input type="checkbox" value="{{ticket.id}}" class="ticket" style="width:10px; margin: 0; margin-rght: 4px; padding: 0;"/>
		</td>
		<td rowspan="2" width="20" style="vertical-align: middle; padding: 4px; white-space:nowrap;">
			{% if ticket.agent %}<img src="{{ticket.agent.getPictureUrl(35)}}" width="30" height="30" class="tipped" data-tipped="{{ticket.agent.display_name}}" />{% else %}<img src="http://www.gravatar.com/avatar/00000000000000000000000000000000?d=mm&amp;s=30" width="30" height="30" class="tipped" data-tipped="Unassigned" />{% endif %}
		</td>
		<td colspan="{{display_fields|length}}" class="subject tipped">
			<cite class="person-name">
				<a class="with-route" data-route="ticket:{{ path('agent_people_view', {'person_id': ticket.person.id}) }}">
					{{ticket.person.getDisplayContactShort(35)}}
				</a>
			</cite>
			<a
				style="background: url({{ asset('images/ticket-status-' ~ ticket.status ~ '.png') }}) no-repeat center left; line-height: 13px; padding-left: 15px;"
				class="with-route subject-link"
				data-route="ticket:{{ path('agent_ticket_view', {'ticket_id': ticket.id}) }}"
			><span
				class="tipped"
				data-tipped="{{ path('agent_ticket_viewtip', {'ticket_id': ticket.id}) }}"
				data-tipped-options="skin: 'light', hook: { target: 'topleft', tooltip: 'bottomleft' }, ajax: true, maxWidth: 400, showDelay: 1.2"
			>{{ticket.subject}}</span></a>
		</td>
		{% if show_flag and 0 %}
			{% set ticket_flagged_color = flagged_tickets[ticket.id]|default('none') %}
			<td rowspan="2" class="wrap-flag flag"><span class="ticket-flag icon icon-flag-{{ticket_flagged_color}}" data-flag="{{ticket_flagged_color}}"></span></td>
		{% endif %}
	</tr>
	<tr class="{% if loop.index % 2 == 0 %}white{% endif %} ticket-{{ticket.id}} line-2 urgency-{{ticket.rounded_urgency}} {% if ticket.is_locked %}locked{% endif %}" data-ticket-id="{{ticket.id}}">
		{% for field in display_fields %}{% if field != 'agent' %}
			<td class="{{field}}" {% if loop.last %}style="text-align:right"{% endif %}>
			{% if field == 'date_created' %}
				<span class="timestamp timeago" title="{{ticket.date_created|date('c')}}">{{ticket.date_created|date('Y-m-d')}}</span>
			{% elseif field == 'person' %}
				{{ticket.person.display_name}}
			{% elseif field == 'department' %}
				{{ticket.department.title}}
			{% elseif field == 'category' %}
				<span class="prop-val category_id" data-prop-value="{{ticket.category.id}}">
				{% if ticket.category %}
					{{ticket.category.title}}
				{% else %}
					None
				{% endif %}
				</span>
			{% elseif field == 'product' %}
				<span class="prop-val product_id" data-prop-value="{{ticket.product.id}}">
				{% if ticket.product %}
					{{ticket.product.title}}
				{% else %}
					None
				{% endif %}
				</span>
			{% elseif field == 'organization' %}
				<span class="prop-val organization_id" data-prop-value="{{ticket.organization.id}}">
				{% if ticket.organization %}
					<a class="with-route" data-route="page:{{ path('agent_org_view', {'organization_id': ticket.organization.id}) }}">{{ticket.organization.name}}</a>
				{% else %}
					None
				{% endif %}
				</span>
			{% elseif field == 'agent' %}
				<span class="prop-val agent_id" data-prop-value="{{ticket.agent.id}}">
				{% if ticket.agent %}
					{{ticket.agent.display_name}}
				{% else %}
					Unassigned
				{% endif %}
				</span>
			{% else %}
				{% for f in ticket_field_defs %}
					{% if field == 'ticket_fields['~f.id~']' %}
					<div class="prop-val ticket_fields_{{f.id}}">
						{{ticket.renderCustomField(f.id)}}
					</div>
					{% endif %}
				{% endfor %}
				{% for f in person_field_defs %}
					{% if field == 'person_fields['~f.id~']' %}
					<div class="prop-val person_fields_{{f.id}}">
						{{ticket.person.renderCustomField(f.id)}}
					</div>
					{% endif %}
				{% endfor %}
			{% endif %}
		{% endif %}{% endfor %}
	</tr>
	<tr class="ticket-{{ticket.id}} line-3 urgency-{{ticket.rounded_urgency}}" style="display:none"><td colspan="{{display_fields|length + 2}}"><ul></ul></td></tr>
{% endfor %}
</tbody>