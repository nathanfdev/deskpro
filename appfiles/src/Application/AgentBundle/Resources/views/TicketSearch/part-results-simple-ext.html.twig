<section class="search-reuslts page-set" data-page="{{page}}">
	{% for ticket in tickets %}
		<article class="ticket ticket-{{ticket.id}}">
			<input type="checkbox" class="ticket-select" value="{{ ticket.id }}"/>
			<div class="toprow">
				<div class="userinfo">
					<a class="with-route name" data-route="person:{{ path('agent_people_view', {'person_id': ticket.person.id|default('0')}) }}">
						<span class="person-tip" data-person-id="{{ ticket.person.id|default(0) }}">{{ ticket.person.display_name }}</span>
					</a>
					{% if ticket.person.primary_email %}
						<span class="email">(...@{{ ticket.person.primary_email.email_domain }})</span>
					{% endif %}
				</div>
				<div class="ticketinfo">
					<span class="urgency"><span>{{ rand(1,10) }}</span></span>
					<span class="status status-{{ ticket.status }}" title="{{ ticket.status }}">{{ ticket.status }}</span>
				</div>
			</div>
			<div class="preview">
				<span class="department">{{ ticket.department.title }}</span>
				<a class="with-route" data-route="ticket:{{ path('agent_ticket_view', {'ticket_id': ticket.id}) }}">
					<span class="subject">{{ ticket.subject }}</span>
				</a>
			</div>
			{% if display_fields|length %}
			<div class="extra-info">
				<ul>
					{% for field in display_fields %}
						{% if field == 'deleted_reason' %}
							<li class="{{field}}">
								{% if deleted_tickets[ticket.id] %}
									Deleted by {{ deleted_tickets[ticket.id].by_person.display_name }}
									{% if deleted_tickets[ticket.id].reason %}
										because: {{ deleted_tickets[ticket.id].reason }}
									{% endif %}
								{% endif %}
							</li>
						{% elseif field == 'category' and ticket.category %}
							<li class="{{field}}">
								<span class="prop-title">Category:</span>
								<span class="prop-val category_id" data-prop-value="{{ticket.category.id}}">
								{% if ticket.category %}
									{{ticket.category.title}}
								{% else %}
									None
								{% endif %}
								</span>
							</li>
						{% elseif field == 'agent' and ticket.agent %}
							<li class="{{field}}">
								<span class="prop-title">Agent:</span>
								<span class="prop-val agent_id" data-prop-value="{{ticket.agent.id}}">
								{% if ticket.agent %}
									<span style="background-image: url('{{ticket.agent.getPictureUrl(15)}}');">{{ ticket.agent.display_name }}</span>
								{% else %}
									Unassigned
								{% endif %}
								</span>
							</li>
						{% elseif field == 'agent_team' and ticket.agent_team %}
							<li class="{{field}}">
								<span class="prop-title">Agent Team:</span>
								<span class="prop-val agent_team_id" data-prop-value="{{ticket.agent_team.id}}">
								{% if ticket.agent_team %}
									<span class="agent-team agent-team-{{ ticket.agent_team.id }}" title="{{ ticket.agent_team.name }}">{{ ticket.agent_team.name }}</span>
								{% else %}
									No Team
								{% endif %}
								</span>
							</li>
						{% elseif field == 'product' and ticket.product %}
							<li class="{{field}}">
								<span class="prop-title">Product:</span>
								<span class="prop-val product_id" data-prop-value="{{ticket.product.id}}">
								{% if ticket.product %}
									{{ticket.product.title}}
								{% else %}
									None
								{% endif %}
								</span>
							</li>
						{% elseif field == 'date_user_waiting' %}
							<li class="{{field}}">
								<span class="prop-title">User Waiting:</span>
								<span class="prop-val">
									4 hours
								</span>
							</li>
						{% elseif field == 'organization' and ticket.organization %}
							<li class="{{field}}">
								<span class="prop-title">Organization:</span>
								<span class="prop-val organization_id" data-prop-value="{{ticket.organization.id}}">
								{% if ticket.organization %}
									<a class="with-route" data-route="page:{{ path('agent_org_view', {'organization_id': ticket.organization.id}) }}">{{ticket.organization.name}}</a>
								{% else %}
									None
								{% endif %}
								</span>
							</li>
						{% else %}
							{% for f in ticket_field_defs %}
								{% if field == 'ticket_fields['~f.id~']' and ticket.hasCustomField(f.id) %}
									<li class="ticket-field">
										<div class="prop-val ticket_fields_{{f.id}}">
											{{ render_custom_field(ticket.getCustomFieldDisplayArray(f.id)) }}
										</div>
									</li>
								{% endif %}
							{% endfor %}
							{% for f in person_field_defs %}
								{% if field == 'person_fields['~f.id~']' and person.hasCustomField(f.id) %}
									<li class="person-field">
										<span class="prop-title">{{ f.title }}:</span>
										<div class="prop-val person_fields_{{f.id}}">
											{{ render_custom_field(person.getCustomFieldDisplayArray(f.id)) }}
										</div>
									</li>
								{% endif %}
							{% endfor %}
						{% endif %}
					{% endfor %}
				</ul>
				<br style="height: 1px;overflow: hidden; clear: left;" />
			</div>
			{% endif %}
		</article>
	{% endfor %}
</section>