{% for label,css_class in cloud %}
	<li class="{{css_class}}"><a data-route="listpane:{{ path('agent_ticketsearch_runcustomfilter') }}?terms[0][type]=label&amp;terms[0][op]=is&amp;terms[0][label]={{label}}">{{label}}</a></li>
{% else %}
	<li>Load a ticket to add labels to it. The most popular labels will show here.</li>
{% endfor %}
