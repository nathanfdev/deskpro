{% for filter in filters %}
	{% if not filter.sys_name %}
		<li class="filter-{{filter.id}} tipped"
			data-filter-id="{{filter.id}}"
			data-route="listpane:{{ path('agent_ticketsearch_runfilter', {'filter_id': filter.id}) }}"
			data-tipped="{{ path('agent_ticketsearch_filter_getsummary', {'filter_id': filter.id}) }}"
			data-tipped-options="ajax:true, skin: 'light', target: 'mouse', hook: 'topmiddle', showDelay: 1.2, maxWidth: 350"
		>
			<span class="list-counter" id="filter_{{filter.id}}_count">-</span>
			<a>{{filter.title}}</a>
		</li>
	{% endif %}
{% endfor %}