{% import 'AgentBundle:Common:macro-flagname.html.twig' as flagnamer %}
<div class="tab-bottom-wrap">
	<div class="tab-bottom">
		<div class="check-count">
			<span>0</span> selected
		</div>
		<div class="bar-actions">
			<ul>
				<li class="macro-on macros-apply" style="display:none"><a>Apply</a></li>
				<li class="macro-on macros-cancel" style="display:none"><a>Cancel</a></li>
				<li class="actions"><a>Mass Actions</a></li>
			</ul>
		</div>
	</div>
	<div class="mass-actions overlay">
		<div class="overlay-title">
			<div class="macro-selector">
				<div class="spinner"></div>
				<select class="apply-macro-select">
					<option value="0">Apply a macro</option>
					<option value="0"></option>
					{% for macro in macros %}
						<option value="{{macro.id}}">{{macro.title}}</option>
					{% endfor %}
				</select>
			</div>
			<h4>Apply actions to <span class="check-count-overlay"></span> tickets</h4>
		</div>

		<div class="overlay-content" style="padding-bottom: 15px;">
			<div class="row">
				<div class="actions-form search-form">
					<div class="actions-terms search-terms"></div>
					<div class="term"><span class="add-term">+</span> Add a new action</div>
				</div>
			</div>

			<div class="tab-bottom-wrap inner ticket-reply" style="padding-top: 15px;">
				<div class="tab-bottom-open">
					<div class="tab-bottom-tabs">
						<ul>
							<li class="tab-trigger reply-reply on" data-tab-for=".tab-content.reply-reply"><a>Message</a></li>
							<li class="tab-trigger reply-attach" data-tab-for=".tab-content.reply-attach"><a>Attachment</a></li>
						</ul>
					</div>

					<div class="tab-bottom-contents" style="height:113px;">
						{# Reply area #}
						<div class="content-tab-bottom reply-reply tab-content on" data-tab-trigger=".tab-trigger.reply-reply">
							<div class="reply-form-fields">
								<textarea name="message"></textarea>
							</div>
						</div>
						{# /Reply Area #}

						<div class="content-tab-bottom content-tab-bottom reply-attach tab-content" data-tab-trigger=".tab-trigger.reply-attach">
							<div class="file-input">
								<button class="dp-button x-small">Upload new file</button> or drag and drop files onto this area
								<input type="file" name="file" multiple="multiple" />
							</div>
							<ul class="file-list"></ul>
						</div>
					</div>
				</div>
			</div>

			<div class="actions-tpl" style="display:none">
				<div class="row">
					<div class="term">
						<div class="type"></div>
						<div class="choice"></div>
						<div class="remove">-</div>
					</div>
				</div>
				<div class="type" title="Status" data-rule-type="status">
					<div class="choice">
						<select name="status">
							<option value="open">Open</option>
							<option value="pending">Pending</option>
							<option value="resolved">Resolved</option>
						</select>
					</div>
				</div>
				<div class="type" title="Department" data-rule-type="department">
					<div class="choice">
						<select name="department">
							{% for id,title in ticket_options.departments %}
								<option value="{{id}}">{{title}}</option>
							{% endfor %}
						</select>
					</div>
				</div>
				<div class="type" title="Category" data-rule-type="category">
					<div class="choice">
						<select name="category">
							{% for id,title in ticket_options.categories %}
								<option value="{{id}}">{{title}}</option>
							{% endfor %}
						</select>
					</div>
				</div>
				<div class="type" title="Product" data-rule-type="product">
					<div class="choice">
						<select name="product">
							{% for id,title in ticket_options.products %}
								<option value="{{id}}">{{title}}</option>
							{% endfor %}
						</select>
					</div>
				</div>
				<div class="type" title="Priority" data-rule-type="priority">
					<div class="choice">
						<select name="priority">
							{% for id,title in ticket_options.priorities %}
								<option value="{{id}}">{{title}}</option>
							{% endfor %}
						</select>
					</div>
				</div>
				<div class="type" title="Workflow" data-rule-type="workflow">
					<div class="choice">
						<select name="workflow">
							{% for id,title in ticket_options.ticket_workflows %}
								<option value="{{id}}">{{title}}</option>
							{% endfor %}
						</select>
					</div>
				</div>
				<div class="type" title="Agent" data-rule-type="agent">
					<div class="choice">
						<select name="agent">
							{% for id,title in ticket_options.agents %}
								<option value="{{id}}">{{title}}</option>
							{% endfor %}
						</select>
					</div>
				</div>
				<div class="type" title="Agent Team" data-rule-type="agent_team">
					<div class="choice">
						<select name="agent_team">
							{% for id,title in ticket_options.agent_teams %}
								<option value="{{id}}">{{title}}</option>
							{% endfor %}
						</select>
					</div>
				</div>
				<div class="type" title="Add Labels" data-rule-type="add_labels">
					<div class="choice">
						<input type="text" name="labels" />
					</div>
				</div>
				<div class="type" title="Remove Labels" data-rule-type="remove_labels">
					<div class="choice">
						<input type="text" name="labels" />
					</div>
				</div>
				<div class="type" title="Set Flag" data-rule-type="flag">
					<div class="choice">
						<select name="flag">
							{% for color in ['red', 'blue', 'yellow', 'green', 'orange', 'purple'] %}
								<option value="{{color}}">{{ flagnamer.flag_name(color, person) }}</option>
							{% endfor %}
						</select>
					</div>
				</div>
				{% if ticket_options.custom_ticket_fields %}
					{% for field in ticket_options.custom_ticket_fields %}
						<div class="type" title="Set Ticket Field: {{field.field_def.title}}" data-rule-type="ticket_field[{{field.field_def.id}}]">
							<div class="choice">
								{{ form_widget(field.formView) }}
							</div>
						</div>
					{% endfor %}
				{% endif %}
				<div class="type" title="Set User Organization" data-rule-type="person_organization_id">
					<div class="choice">
						<select name="person_organization_id">
							{% for id,title in ticket_options.people_organizations %}
								<option value="{{id}}">{{title}}</option>
							{% endfor %}
						</select>
					</div>
				</div>
				{% if ticket_options.custom_people_fields %}
					{% for field in ticket_options.custom_people_fields %}
						<div class="type" title="Set User Field: {{field.field_def.title}}" data-rule-type="people_field[{{field.field_def.id}}]">
							<div class="choice">
								{{ form_widget(field.formView) }}
							</div>
						</div>
					{% endfor %}
				{% endif %}
			</div>
		</div>
		<div class="overlay-actions">
			<div class="loading-off">
				<button class="save-trigger dp-button small">View Changes</button>
			</div>
			<div class="loading-on" style="display:none">
				
			</div>
		</div>
	</div>
</div>