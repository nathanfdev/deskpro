<section class="source-switcher-tabs spaced" id="tickets_outline_labels_switcher">
	<ul>
		<li data-tab-for="#ticket_labels_list" class="list on">List</li>
		<li data-tab-for="#ticket_labels_cloud" class="cloud">Cloud</li>
	</ul>
</section>

<section class="source-labels-list" id="ticket_labels_list">
	<dl>
		{% for letter,labels in labels_index %}
			<dt>{{ letter }}</dt>
			<dd>
				<ul>
					{% for label in labels %}
						<li class="nav-label-{{label|slugify}}" data-route="listpane:{{ path('agent_ticketsearch_runcustomfilter') }}?terms[0][type]=label&amp;terms[0][op]=is&amp;terms[0][label]={{label}}&amp;view_name=label&amp;view_extra={{label}}"><span>{{label}}</span></li>
					{% endfor %}
				</ul>
			</dd>
		{% endfor %}
	</dl>
</section>
<section class="source-labels-cloud" id="ticket_labels_cloud" style="display: none;">
	<ul>
		{% for label,css_class in labels_cloud %}
			<li class="{{css_class}} nav-label-{{label|slugify}}" data-route="listpane:{{ path('agent_ticketsearch_runcustomfilter') }}?terms[0][type]=label&amp;terms[0][op]=is&amp;terms[0][label]={{label}}&amp;view_name=label&amp;view_extra={{label}}"><span>{{label}}</span></li>
		{% else %}
			<li>You haven't labeled any tickets. Load a ticket to label it.</li>
		{% endfor %}
	</ul>
</section>
