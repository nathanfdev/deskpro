<div class="profile-contact-editor-wrapper mass-actions-overlay" style="display: none">
	<div class="overlay-title">
		<h4>Contact Information for {{ person.display_name }}</h4>
	</div>
	<div class="overlay-content">
		{% block list_extra %}{% endblock %}

		{############################################
		 # Phone
		 ############################################}

		<div class="row-type phone {% if contact_data.phone|length %}with-values{% endif %}">
			<h4>Phone</h4>
			<div class="contact-info">
				<ul>
					{% for contact in contact_data.phone %}
						<li data-remove-name="remove_contact_data[]" data-remove-value="{{ contact.id }}">
							<div class="controls">
								<span class="remove">x</span>
							</div>
							<div class="input">
								<select class="type" name="contact_data[{{ contact.id }}][type]">
									{% for type,label in {'phone': 'Phone', 'mobile': 'Mobile', 'fax': 'Fax'} %}
										<option value="{{ type }}" {% if contaxt.rec.field_3 == type %}selected="selected"{% endif %}>{{ label }}</option>
									{% endfor %}
								</select>
								+<span data-element-handler="DeskPRO.Agent.ElementHandler.PhoneCountryCode" data-options-list="#phone_countrycode_menu">
									<span class="icon-flag" style="display: none"></span>
									<input type="text" size="4" class="country-code" name="contact_data[{{ contact.id }}][country_calling_code]" value="{{ contact.rec.field_1 }}" placeholder="Country" />
								</span>
								<input type="text" size="4" class="phone-number" name="contact_data[{{ contact.id }}][number]" value="{{ contact.rec.field_2 }}" placeholder="Phone Number" />
							</div>
							<div class="label">
								<input type="text" size="10" name="contact_data[{{ contact.id }}][comment]" value="{{ contact.rec.comment }}" placeholder="Add a label" />
							</div>
						<br class="clear" /></li>
					{% endfor %}
				</ul>
				<a class="add-trigger">
					<em class="with-none">Add a phone number</em>
					<em class="with-some">Add another</em>
				</a>
			</div>
			<script type="text/x-deskpro-plain" class="tpl-new-row">
				<li>
					<div class="controls">
						<span class="remove">x</span>
					</div>
					<div class="input">
						<select class="type" name="new_contact_data[phone][%id%][type]">
							{% for type,label in {'phone': 'Phone', 'mobile': 'Mobile', 'fax': 'Fax'} %}
								<option value="{{ type }}" {% if contaxt.rec.field_3 == type %}selected="selected"{% endif %}>{{ label }}</option>
							{% endfor %}
						</select>
						+<span data-element-handler="DeskPRO.Agent.ElementHandler.PhoneCountryCode" data-options-list="#phone_countrycode_menu">
							<span class="icon-flag" style="display: none"></span>
							<input type="text" size="4" class="country-code" name="new_contact_data[phone][%id%][country_calling_code]" value="" placeholder="Country" />
						</span>
						<input type="text" size="4" class="phone-number" name="new_contact_data[phone][%id%][number]" placeholder="Phone Number" />
					</div>
					<div class="label">
						<input type="text" size="8" name="new_contact_data[phone][%id%][comment]" value="" placeholder="Add a label" />
					</div>
				<br class="clear" /></li>
			</script>
		</div>

		{############################################
		 # Website
		 ############################################}

		 <div class="row-type website {% if contact_data.website|length %}with-values{% endif %}">
			<h4>Website</h4>
			<div class="contact-info">
				<ul>
					{% for contact in contact_data.website %}
						<li data-remove-name="remove_contact_data[]" data-remove-value="{{ contact.id }}">
							<div class="controls">
								<span class="remove">x</span>
							</div>
							<div class="input">
								<input type="text" size="15" class="single-input" name="contact_data[{{ contact.id }}][url]" value="{{ contact.url }}" placeholder="Website URL" />
							</div>
							<div class="label">
								<input type="text" size="10" name="contact_data[{{ contact.id }}][comment]" value="{{ contact.rec.comment }}" placeholder="Add a label" />
							</div>
						<br class="clear" /></li>
					{% endfor %}
				</ul>
				<a class="add-trigger">
					<em class="with-none">Add a website URL</em>
					<em class="with-some">Add another</em>
				</a>
			</div>
			<script type="text/x-deskpro-plain" class="tpl-new-row">
				<li>
					<div class="controls">
						<span class="remove">x</span>
					</div>
					<div class="input">
						<input type="text" size="4" class="single-input" name="new_contact_data[website][%id%][url]" placeholder="Website URL" />
					</div>
					<div class="label">
						<input type="text" size="8" name="new_contact_data[website][%id%][comment]" value="" placeholder="Add a label" />
					</div>
				<br class="clear" /></li>
			</script>
		</div>

		{############################################
		 # IM
		 ############################################}

		 <div class="row-type im {% if contact_data.facebook|length %}with-values{% endif %}">
			<h4>IM</h4>
			<div class="contact-info">
				<ul>
					{% for contact in contact_data.facebook %}
						<li data-remove-name="remove_contact_data[]" data-remove-value="{{ contact.id }}">
							<div class="controls">
								<span class="remove">x</span>
							</div>
							<div class="input">
								<select name="contact_data[{{ contact.id }}][service]">
									<option {% if contact.service == 'aim' %} {% endif %} value="aim">AIM</option>
									<option {% if contact.service == 'msn' %} {% endif %} value="msn">MSN</option>
									<option {% if contact.service == 'yim' %} {% endif %} value="yim">YIM</option>
									<option {% if contact.service == 'icq' %} {% endif %} value="icq">ICQ</option>
									<option {% if contact.service == 'skype' %} {% endif %} value="icq">Skype</option>
									<option {% if contact.service == 'gtalk' %} {% endif %} value="gtalk">GTalk</option>
									<option {% if contact.service == 'other' %} {% endif %} value="other">Other</option>
								</select>
								<input type="text" size="15" class="single-input" name="contact_data[{{ contact.id }}][username]" value="{{ contact.url }}" placeholder="Account username" />
							</div>
							<div class="label">
								<input type="text" size="10" name="contact_data[{{ contact.id }}][comment]" value="{{ contact.rec.comment }}" placeholder="Add a label" />
							</div>
						<br class="clear" /></li>
					{% endfor %}
				</ul>
				<a class="add-trigger">
					<em class="with-none">Add an instant messaging account</em>
					<em class="with-some">Add another</em>
				</a>
			</div>
			<script type="text/x-deskpro-plain" class="tpl-new-row">
				<li>
					<div class="controls">
						<span class="remove">x</span>
					</div>
					<div class="input">
						<select name="new_contact_data[instant_message][%id%][service]">
							<option {% if contact.service == 'aim' %} {% endif %} value="aim">AIM</option>
							<option {% if contact.service == 'msn' %} {% endif %} value="msn">MSN</option>
							<option {% if contact.service == 'yim' %} {% endif %} value="yim">YIM</option>
							<option {% if contact.service == 'icq' %} {% endif %} value="icq">ICQ</option>
							<option {% if contact.service == 'skype' %} {% endif %} value="icq">Skype</option>
							<option {% if contact.service == 'gtalk' %} {% endif %} value="gtalk">GTalk</option>
							<option {% if contact.service == 'other' %} {% endif %} value="other">Other</option>
						</select>
						<input type="text" size="15" class="single-input" name="new_contact_data[instant_message][%id%][username]" value="" placeholder="Account username" />
					</div>
					<div class="label">
						<input type="text" size="8" name="new_contact_data[phone][%id%][instant_message]" value="" placeholder="Add a label" />
					</div>
				<br class="clear" /></li>
			</script>
		</div>

		{############################################
		 # Twitter
		 ############################################}

		 <div class="row-type twitter {% if contact_data.twitter|length %}with-values{% endif %}">
			<h4>Twitter</h4>
			<div class="contact-info">
				<ul>
					{% for contact in contact_data.twitter %}
						<li data-remove-name="remove_contact_data[]" data-remove-value="{{ contact.id }}">
							<div class="controls">
								<span class="remove">x</span>
							</div>
							<div class="input">
								<input type="text" size="15" class="single-input" name="contact_data[{{ contact.id }}][username]" value="{{ contact.url }}" placeholder="Twitter username" />
								<input type="hidden" name="contact_data[{{ contact.id }}][display_feed]" value="1" />
							</div>
							<div class="label">
								<input type="text" size="10" name="contact_data[{{ contact.id }}][comment]" value="{{ contact.rec.comment }}" placeholder="Add a label" />
							</div>
						<br class="clear" /></li>
					{% endfor %}
				</ul>
				<a class="add-trigger">
					<em class="with-none">Add a twitter profile</em>
					<em class="with-some">Add another</em>
				</a>
			</div>
			<script type="text/x-deskpro-plain" class="tpl-new-row">
				<li>
					<div class="controls">
						<span class="remove">x</span>
					</div>
					<div class="input">
						<input type="text" size="15" class="single-input" name="new_contact_data[twitter][%id%][username]" value="{{ contact.url }}" placeholder="Twitter username" />
						<input type="hidden" name="new_contact_data[twitter][%id%][display_feed]" />
					</div>
					<div class="label">
						<input type="text" size="8" name="new_contact_data[phone][%id%][twitter]" value="" placeholder="Add a label" />
					</div>
				<br class="clear" /></li>
			</script>
		</div>

		{############################################
		 # LinkedIn
		 ############################################}

		 <div class="row-type linkedin {% if contact_data.linkedin|length %}with-values{% endif %}">
			<h4>LinkedIn</h4>
			<div class="contact-info">
				<ul>
					{% for contact in contact_data.linkedin %}
						<li data-remove-name="remove_contact_data[]" data-remove-value="{{ contact.id }}">
							<div class="controls">
								<span class="remove">x</span>
							</div>
							<div class="input">
								<input type="text" size="15" name="contact_data[{{ contact.id }}][profile_url]" value="{{ contact.url }}" placeholder="LinkedIn profile URL" />
							</div>
							<div class="label">
								<input type="text" size="10" name="contact_data[{{ contact.id }}][comment]" value="{{ contact.rec.comment }}" placeholder="Add a label" />
							</div>
						<br class="clear" /></li>
					{% endfor %}
				</ul>
				<a class="add-trigger">
					<em class="with-none">Add a LinkedIn profile</em>
					<em class="with-some">Add another</em>
				</a>
			</div>
			<script type="text/x-deskpro-plain" class="tpl-new-row">
				<li>
					<div class="controls">
						<span class="remove">x</span>
					</div>
					<div class="input">
						<input type="text" size="15" class="single-input" name="new_contact_data[linkedin][%id%][profile_url]" value="{{ contact.url }}" placeholder="LinkedIn profile URL" />
					</div>
					<div class="label">
						<input type="text" size="8" name="new_contact_data[linkedin][%id%][comment]" value="" placeholder="Add a label" />
					</div>
				<br class="clear" /></li>
			</script>
		</div>

		{############################################
		 # Facebook
		 ############################################}

		 <div class="row-type facebook {% if contact_data.facebook|length %}with-values{% endif %}">
			<h4>Facebook</h4>
			<div class="contact-info">
				<ul>
					{% for contact in contact_data.facebook %}
						<li data-remove-name="remove_contact_data[]" data-remove-value="{{ contact.id }}">
							<div class="controls">
								<span class="remove">x</span>
							</div>
							<div class="input">
								<input type="text" size="15" class="single-input" name="contact_data[{{ contact.id }}][profile_url]" value="{{ contact.url }}" placeholder="Facebook profile URL" />
							</div>
							<div class="label">
								<input type="text" size="10" name="contact_data[{{ contact.id }}][comment]" value="{{ contact.rec.comment }}" placeholder="Add a label" />
							</div>
						<br class="clear" /></li>
					{% endfor %}
				</ul>
				<a class="add-trigger">
					<em class="with-none">Add a Facebook profile</em>
					<em class="with-some">Add another</em>
				</a>
			</div>
			<script type="text/x-deskpro-plain" class="tpl-new-row">
				<li>
					<div class="controls">
						<span class="remove">x</span>
					</div>
					<div class="input">
						<input type="text" size="15" class="single-input" name="new_contact_data[facebook][%id%][profile_url]" value="{{ contact.url }}" placeholder="Facebook profile URL" />
					</div>
					<div class="label">
						<input type="text" size="8" name="new_contact_data[facebook][%id%][comment]" value="" placeholder="Add a label" />
					</div>
				<br class="clear" /></li>
			</script>
		</div>

		{############################################
		 # Address
		 ############################################}

		 <div class="row-type address {% if contact_data.address|length %}with-values{% endif %}">
			<h4>Address</h4>
			<div class="contact-info">
				<ul>
					{% for contact in contact_data.address %}
						<li data-remove-name="remove_contact_data[]" data-remove-value="{{ contact.id }}">
							<div class="controls">
								<span class="remove">x</span>
							</div>
							<div class="input">
								<div class="line-1">
									<textarea class="address" name="contact_data[{{ contact.id }}][address]" placeholder="Address">{{ contact.address }}</textarea>
								</div>
								<div class="line-2">
									<input type="text" size="10" name="contact_data[{{ contact.id }}][city]" value="{{ contact.city }}" placeholder="City" />
									<input type="text" size="10" name="contact_data[{{ contact.id }}][state]" value="{{ contact.state }}" placeholder="State" />
									<input type="text" size="10" name="contact_data[{{ contact.id }}][zip]" value="{{ contact.state }}" placeholder="Post Code" />
								</div>
								<div class="line-3">
									<select name="contact_data[{{ contact.id }}][country]">
										{% for c in get_data('country_names') %}
											<option value="{{ c }}" {% if contact.country == c %}selected="selected"{% endif %}>{{ c }}</option>
										{% endfor %}
									</select>
								</div>
							</div>
							<div class="label">
								<input type="text" size="10" name="contact_data[{{ contact.id }}][comment]" value="{{ contact.rec.comment }}" placeholder="Add a label" />
							</div>
						<br class="clear" /></li>
					{% endfor %}
				</ul>
				<a class="add-trigger">
					<em class="with-none">Add an address</em>
					<em class="with-some">Add another</em>
				</a>
			</div>
			<script type="text/x-deskpro-plain" class="tpl-new-row">
				<li>
					<div class="controls">
						<span class="remove">x</span>
					</div>
					<div class="input">
						<div class="line-1">
							<textarea class="address" name="new_contact_data[address][%id%][address]" placeholder="Address">{{ contact.address }}</textarea>
						</div>
						<div class="line-2">
							<input type="text" size="10" name="new_contact_data[address][%id%][city]" value="{{ contact.city }}" placeholder="City" />
							<input type="text" size="10" name="new_contact_data[address][%id%][state]" value="{{ contact.state }}" placeholder="State" />
							<input type="text" size="10" name="new_contact_data[address][%id%][zip]" value="{{ contact.state }}" placeholder="Post Code" />
						</div>
						<div class="line-3">
							<select name="contact_data[{{ contact.id }}][country]">
								<option value=""></option>
								{% for c in get_data('country_names') %}
									<option value="{{ c }}" {% if contact.country == c %}selected="selected"{% endif %}>{{ c }}</option>
								{% endfor %}
							</select>
						</div>
					</div>
					<div class="label">
						<input type="text" size="8" name="new_contact_data[address][%id%][comment]" value="" placeholder="Add a label" />
					</div>
				<br class="clear" /></li>
			</script>
		</div>

	</div>
	<div class="overlay-footer">
		<button class="save-trigger clean-white">Save</button>
	</div>
</div>
