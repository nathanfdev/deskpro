					</tr>
					<tr>
						<td><input type="text" size="8" name="new_contact_data[phone][%id%][comment]" value=""/></td>
						<td><input type="text" size="4" name="new_contact_data[phone][%id%][country_code]" value=""/></td>
						<td><input type="text" size="12" name="new_contact_data[phone][%id%][number]" value=""/></td>
					</tr>
