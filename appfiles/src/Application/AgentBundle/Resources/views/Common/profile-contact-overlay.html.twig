<div class="profile-contact-editor-wrapper" style="display: none">

	<div class="contact-edit-list">
		<ul>
			{% block list_extra %}{% endblock %}

			{% for contact in contact_data.phone %}
				<li class="phone" data-remove-name="remove_contact_data[]" data-remove-value="{{ contact.id }}">
					<div class="type">Phone</div>
					<div class="input">
						<div class="label">
							<input type="text" name="contact_data[{{ contact.id }}][comment]" value="{{ contact.rec.comment }}" placeholder="Label" />
						</div>
						<div class="field">
							<input type="text" size="12" name="contact_data[{{ contact.id }}][number]" value="{{ contact.rec.field_2 }}" placeholder="Phone Number" />
						</div>
					</div>
					<div class="remove">-</div>
				</li>
			{% endfor %}

			{% for contact in contact_data.mobile %}
				<li class="mobile" data-remove-name="remove_contact_data[]" data-remove-value="{{ contact.id }}">
					<div class="type">Cell</div>
					<div class="input">
						<div class="label">
							<input type="text" name="contact_data[{{ contact.id }}][comment]" value="{{ contact.rec.comment }}" placeholder="Label" />
						</div>
						<div class="field">
							<input type="text" size="12" name="contact_data[{{ contact.id }}][number]" value="{{ contact.rec.field_2 }}" placeholder="Phone Number" />
						</div>
					</div>
					<div class="remove">-</div>
				</li>
			{% endfor %}

			{% for contact in contact_data.fax %}
				<li class="fax" data-remove-name="remove_contact_data[]" data-remove-value="{{ contact.id }}">
					<div class="type">Fax</div>
					<div class="input">
						<div class="label">
							<input type="text" name="contact_data[{{ contact.id }}][comment]" value="{{ contact.rec.comment }}" placeholder="Label" />
						</div>
						<div class="field">
							<input type="text" size="12" name="contact_data[{{ contact.id }}][number]" value="{{ contact.rec.field_2 }}" placeholder="Phone Number" />
						</div>
					</div>
					<div class="remove">-</div>
				</li>
			{% endfor %}

			{% for contact in contact_data.website %}
				<li class="website" data-remove-name="remove_contact_data[]" data-remove-value="{{ contact.id }}">
					<div class="type">Website</div>
					<div class="input">
						<div class="label">
							<input type="text" name="contact_data[{{ contact.id }}][comment]" value="{{ contact.rec.comment }}" placeholder="Label" />
						</div>
						<div class="field">
							<input type="text" size="15" name="contact_data[{{ contact.id }}][url]" value="{{ contact.url }}" placeholder="URL" />
						</div>
					</div>
					<div class="remove">-</div>
				</li>
			{% endfor %}

			{% for contact in contact_data.twitter %}
				<li class="twitter" data-remove-name="remove_contact_data[]" data-remove-value="{{ contact.id }}">
					<div class="type">Twitter</div>
					<div class="input">
						<div class="label">
							<input type="text" name="contact_data[{{ contact.id }}][comment]" value="{{ contact.rec.comment }}" placeholder="Label" />
						</div>
						<div class="field">
							<input type="text" size="15" name="contact_data[{{ contact.id }}][username]" value="{{ contact.username }}" placeholder="Twitter username" />
							&nbsp;&nbsp;&nbsp;
							<label><input type="checkbox" name="contact_data[{{ contact.id }}][display_feed]" value="1" {% if contact.display_feed %}checked="checked"{% endif %} /> Display tweets in profile</label>
						</div>
					</div>
					<div class="remove">-</div>
				</li>
			{% endfor %}

			{% for contact in contact_data.linkedin %}
				<li class="linkedin" data-remove-name="remove_contact_data[]" data-remove-value="{{ contact.id }}">
					<div class="type">LinkedIn</div>
					<div class="input">
						<div class="label">
							<input type="text" name="contact_data[{{ contact.id }}][comment]" value="{{ contact.rec.comment }}" placeholder="Label" />
						</div>
						<div class="field">
							<input type="text" size="15" name="contact_data[{{ contact.id }}][profile_url]" value="{{ contact.profile_url }}" placeholder="" />
						</div>
					</div>
					<div class="remove">-</div>
				</li>
			{% endfor %}

			{% for contact in contact_data.facebook %}
				<li class="facebook" data-remove-name="remove_contact_data[]" data-remove-value="{{ contact.id }}">
					<div class="type">Facebook</div>
					<div class="input">
						<div class="label">
							<input type="text" name="contact_data[{{ contact.id }}][comment]" value="{{ contact.rec.comment }}" placeholder="Label" />
						</div>
						<div class="field">
							<input type="text" size="15" name="contact_data[{{ contact.id }}][profile_url]" value="{{ contact.profile_url }}" placeholder="Facebook profile URL" />
						</div>
					</div>
					<div class="remove">-</div>
				</li>
			{% endfor %}

			{% for contact in contact_data.instant_message %}
				<li class="instant_message" data-remove-name="remove_contact_data[]" data-remove-value="{{ contact.id }}">
					<div class="type">IM</div>
					<div class="input">
						<div class="label">
							<input type="text" name="contact_data[{{ contact.id }}][comment]" value="{{ contact.rec.comment }}" placeholder="Label" />
						</div>
						<div class="field">
							<select name="contact_data[{{ contact.id }}][service]">
								<option {% if contact.service == 'aim' %} {% endif %} value="aim">AIM</option>
								<option {% if contact.service == 'msn' %} {% endif %} value="msn">MSN</option>
								<option {% if contact.service == 'yim' %} {% endif %} value="yim">YIM</option>
								<option {% if contact.service == 'icq' %} {% endif %} value="icq">ICQ</option>
								<option {% if contact.service == 'gtalk' %} {% endif %} value="gtalk">GTalk</option>
								<option {% if contact.service == 'other' %} {% endif %} value="other">Other</option>
							</select>
							<input type="text" size="15" name="contact_data[{{ contact.id }}][username]" value="{{ contact.username }}" placeholder="Username" />
						</div>
					</div>
					<div class="remove">-</div>
				</li>
			{% endfor %}

			{% for contact in contact_data.address %}
				<li class="address" data-remove-name="remove_contact_data[]" data-remove-value="{{ contact.id }}">
					<div class="type">Address</div>
					<div class="input">
						<div class="label">
							<input type="text" size="8" name="contact_data[{{ contact.id }}][comment]" value="{{ contact.rec.comment }}" placeholder="Label" />
						</div>
						<div class="field">
							<textarea cols="40" rows="3" name="contact_data[{{ contact.id }}][address]" value="{{ contact.address }}" />
						</div>
					</div>
					<div class="remove">-</div>
				</li>
			{% endfor %}
		</ul>
	</div>
	<div class="add-row">
		<span class="add-new-type-trigger">Add new...</span>
		<ul class="add-new-type-menu" style="display: none">
			{% block newmenu_options_extra %}{% endblock %}
			<li data-tpl="tpl-new-address">Address</li>
			<li data-tpl="tpl-new-phone">Phone</li>
			<li data-tpl="tpl-new-mobile">Cell</li>
			<li data-tpl="tpl-new-fax">Fax</li>
			<li data-tpl="tpl-new-website">Website</li>
			<li data-tpl="tpl-new-twitter">Twitter</li>
			<li data-tpl="tpl-new-facebook">Facebook</li>
			<li data-tpl="tpl-new-linkedin">LinkedIn</li>
			<li data-tpl="tpl-new-skype">Skype</li>
			<li data-tpl="tpl-new-instantmessage">Instant Messaging</li>
		</ul>
	</div>
	<div style="text-align: center; margin-top: 7px;">
		<button class="dp-button save-trigger">Save</button>
	</div>

	{% block newtpl_extra %}{% endblock %}
	<script type="text/x-deskpro-plain" class="tpl-new-phone">
		<li class="phone new">
			<div class="type">Phone</div>
			<div class="input">
				<div class="label">
					<input type="text" name="new_contact_data[address][%id%][comment]" value="" placeholder="Label" />
				</div>
				<div class="field">
					<input class="number" type="text" name="new_contact_data[phone][%id%][number]" value="" placeholder="Phone Number" />
				</div>
			</div>
			<div class="remove">-</div>
		</li>
	</script>
