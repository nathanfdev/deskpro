{% macro render_options(k, cat, selected, depth, parent_title) %}
	{% set id = cat.id|default(k) %}
	{% set title = cat.title|default(cat.name|default(cat)) %}
	{% if parent_title %}
		{% set full_title = parent_title ~ ' > ' ~ cat.title|default(cat.name|default(cat)) %}
	{% else %}
		{% set full_title = cat.title|default(cat.name|default(cat)) %}
	{% endif %}
	<option data-full-title="{{ full_title }}" value="{{ id }}" {% if id == selected %}selected="selected"{% endif %}>{% if depth %}{{ '--'|repeat(depth) }} {% endif %}{{ title }}</option>

	{% if cat.children %}
		{% for subk,subcat in cat.children %}
			{{ _self.render_options(subk, subcat, selected, depth+1, full_title) }}
		{% endfor %}
	{% endif %}
{% endmacro %}
<select {% if name %}name="{{ name }}"{% endif %} {% if id %}id="{{ id }}"{% endif %} class="{{add_classname}}" {{ add_attr }}>
	{% if with_blank %}<option value="">{{ blank_title }}</option>{% endif %}
	{% for k,cat in categories %}
		{{ _self.render_options(k, cat, selected, 0, '') }}
	{% endfor %}
</select>
