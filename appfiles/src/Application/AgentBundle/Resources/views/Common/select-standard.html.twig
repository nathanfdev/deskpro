<select {% if name %}name="{{ name }}"{% endif %} {% if id %}id="{{ id }}"{% endif %} class="{{add_classname}}" {{ add_attr }}>
	{% if with_blank %}<option value="">{{ blank_title }}</option>{% endif %}
	{% for cat in categories %}
		<option value="{{ cat.id }}" {% if cat.id == selected %}selected="selected"{% endif %}>{{ cat.title }}</option>
		{% if cat.children %}
			{% for subcat in cat.children %}
				<option value="{{subcat.id}}" {% if subcat.id == selected %}selected="selected"{% endif %}>-- {{subcat.title}}</option>
			{% endfor %}
		{% endif %}
	{% endfor %}
</select>