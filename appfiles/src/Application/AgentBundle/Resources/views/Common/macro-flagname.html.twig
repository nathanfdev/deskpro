{% macro flag_name(flag, person) %}
	{% set pref_names = person.getNamedPrefs('agent.ui.flag.blue', 'agent.ui.flag.green','agent.ui.flag.orange','agent.ui.flag.pink','agent.ui.flag.purple','agent.ui.flag.red','agent.ui.flag.yellow') %}
	{% if pref_names['agent.ui.flag.' ~ flag] %}{{pref_names['agent.ui.flag.' ~ flag]}}{% else %}{{ phrase('agent.flag_' ~ flag) }}{% endif %}
{% endmacro %}