<div
	data-comment-id="{{comment.id}}"
	data-content-type="{{ comment.object_content_type }}"
	class="message comment-{{comment.id}} {% if comment.person.is_agent %}admin-message{% else %}user-message{% endif %} {% if comment.status == 'validating' %}validating{% endif %}"
>
	<div class="message-avatar left">
		<img
			src="{% if comment.person %}{{ comment.person.getPictureUrl(35) }}{% else %}{{ path('serve_default_picture', {'s': 35}) }}{% endif %}"
			alt="" width="35" height="35"
		/>
	</div>
	<div class="message-body">
		<div class="message-meta">
			<span class="arrow-left"></span>
			{% if comment.person %}
				<h4 class="with-route" data-route="page:{{ path('agent_people_view', {'person_id': comment.person.id}) }}">{{ comment.person.name }}</h4>
			{% else %}
				{% if comment.name or comment.email %}
					{% if comment.name %}{{ comment.name }}{% endif %}
					{% if comment.email %}&lt;{{ comment.email }}&gt;{% endif %}
				{% else %}
					Anonymous
				{% endif %}
			{% endif %}
			<span class="timestamp">from {{ comment.ip_address }}, <span class="timeago" title="{{comment.date_created|date('c')}}">{{comment.date_created|date('Y-m-d')}}</span></span>
			<span class="comment-edit-btn count tipped">
				#{{ loop.index }}
			</span>

			<span class="comment-validate-btn count tipped" title="Comment is awaiting validation. Click to manage.">Validate comment</span>
		</div>
		<div class="message-text">
			<div class="rendered-message">{{ comment.content_html|raw }}</div>
		</div>
	</div>
</div>
