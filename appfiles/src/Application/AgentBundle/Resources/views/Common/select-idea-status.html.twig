<select name="{{ name }}">
	<option value="new">New</option>
	<optgroup label="Active">
		{% for cat in active_status_cats %}
			<option value="active.{{ cat.id }}">{{ cat.title }}</option>
		{% endfor %}
	</optgroup>
	<optgroup label="Closed">
		{% for cat in closed_status_cats %}
			<option value="closed.{{ cat.id }}">{{ cat.title }}</option>
		{% endfor %}
	</optgroup>
	{% if constant('DP_DEBUG') %}
		<option value="hidden.validating" selected="selected">DEV: Validating</option>
	{% endif %}
</select>
