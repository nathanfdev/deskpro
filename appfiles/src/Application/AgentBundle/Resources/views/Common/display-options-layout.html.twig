<div class="dp-overlay-container display-options">
	<section class="dp-overlay">
		<header>
			<span class="close close-trigger">close</span>
			<h1>Dislpay Options</h1>
		</header>
		<article>
			<ul class="sortable-list">
				{% block display_elements_list %}{% endblock %}
			</ul>

			{% block other_options %}{% endblock %}
		</article>
		<footer>
			<div class="loading-off">
				<button class="save-trigger clean-white">Apply</button>
			</div>
			<div class="loading-on" style="display:none">
				<span>Saving ...</span>
			</div>
		</footer>
	</section>
</div>
