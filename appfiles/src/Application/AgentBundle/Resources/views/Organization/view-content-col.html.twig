{# Box Summary #}
<div class="profile-box-container summary"
	data-element-handler="DeskPRO.Agent.ElementHandler.FormSaver"
	data-form-save-url="{{ path('agent_org_ajaxsave', {'organization_id': org.id}) }}"
>
	<header>
		<div class="controls">
			<div class="is-loading">Saving</div>
			<div class="saved" style="display: none">Saved</div>
			<div class="save" style="display: none">Save</div>
		</div>
		<h4>Summary</h4>
	</header>
	<section>
		<input type="hidden" name="action" value="set-summary" />
		<div class="textarea-section"><textarea class="integrated" id="{{baseId}}_summary" name="summary">{{ org.summary }}</textarea></div>
	</section>
</div>
{# /Box Summary #}

<div class="profile-box-container tabbed">
	<header>
		<nav>
			<ul>
				<li data-tab-for="#{{baseId}}_members_tab" class="on">Members <span class="count" id="{{baseId}}_members_count">{{members_count|default(0)}}</span></li>
				{% if org_tickets_count %}
					<li data-tab-for="#{{baseId}}_tickets_tab">Tickets <span class="count" id="{{baseId}}_tickets_count">{{ org_tickets_count|default(0) }}</span></li>
				{% endif %}
			</ul>
		</nav>
	</header>
	<section>
		{# Members Tab #}
		<article id="{{baseId}}_members_tab" class="on">
			<table class="tickets-simple" width="100%" border="0" cellpadding="0" cellspacing="0">
				<tbody id="{{baseId}}_members_list">
					<tr class="add-new-member" id="{{baseId}}_newmember_row">
						<td colspan="3" class="textarea-section">
							<div
								id="{{baseId}}_add_searchbox"
								data-element-handler="DeskPRO.Agent.ElementHandler.PersonSearchBox"
								data-search-url="{{ path('agent_peoplesearch_performquick', {'format': 'json', 'limit': 10, 'start_with': 'a', 'exclude_org': org.id}) }}"
								data-highlight-term="1"
								data-touch-focus="1"
								data-search-param="term"
								data-position-bound="@parent(td)"
							>
								<script type="text/x-deskpro-tmpl" class="user-row-tpl">
									<li>
										<a>
										<span class="user-name"></span>
										<address>&lt;<span class="user-email"></span>&gt;</address>
										<div class="bound-fade"></div>
									</a></li>
								</script>
								<div class="input-wrapper">
									<input type="input" id="{{baseId}}_add_searchbox_txt" style="width: 98%" class="term integrated" placeholder="Add a person to this organization" class="user-input" />
								</div>
								<input type="hidden" name="person_id" class="person-id" value="" />
								<div class="person-search-box" style="display: none">
									<section>
										<ul class="results-list">

										</ul>
										<footer>
											<span class="create-user">Create a new person</span>
										</footer>
									</section>
								</div>
							</div>
						</td>
					</tr>
					<tr class="add-new-member-named" style="display: none" id="{{baseId}}_newmember_row_named">
						<td>
							<div class="user-name" id="{{baseId}}_newmember_person_name"></div>
							<div class="user-email" id="{{baseId}}_newmember_person_email"></div>
						</td>
						<td colspan="2">
							<div class="position-input">
								<input type="text" class="role" placeholder="Enter position" id="{{baseId}}_newmember_position" value="" />
							</div>
							<div class="controls">
								<input type="hidden" id="{{baseId}}_newmember_person_id" value="" />
								<button class="clean-white small" id="{{baseId}}_newmember_btn">Add</button>
								<button class="clean-white small" id="{{baseId}}_newmember_cancel_btn">Cancel</button>
							</div>
						</td>
					</tr>
					{% for person in org_members %}
						{% include 'AgentBundle:Organization:view-members-row.html.twig' %}
					{% endfor %}
				</tbody>
			</table>
		</article>
		{# /Members Tab #}

		{# Tickets Tab #}
		{% if org_tickets_count %}
		<article id="{{baseId}}_tickets_tab">
			<table class="tickets-simple" width="100%" border="0" cellpadding="0" cellspacing="0">
				<tbody id="{{baseId}}_tickets_initial">
					{% for ticket in org_tickets %}
						<tr>
							<td>
								<div class="fade-container">
									<div class="line">
										<a data-route="ticket:{{ path('agent_ticket_view', {'ticket_id': ticket.id}) }}" data-route-title="@text">{{ticket.subject}}</a>
									</div>
									<div class="line">
										by <a class="as-popover" data-route="person:{{ path('agent_people_view', {'person_id': ticket.person.id}) }}">{{ticket.person.display_name}}</a>
									</div>
									<div class="bound-fade"></div>
								</div>
							</td>
							<td class="status {{ticket.status}}" width="25"><span class="status">{{ ticket.status }}</span></td>
						</tr>
					{% endfor %}
					{% if org_tickets|length < org_tickets_count %}
						<tr class="more">
							<td colspan="100">
								<button class="clean-white" id="{{baseId}}_tickets_viewall">View all {{ org_tickets_count }} tickets</button>
							</td>
						</tr>
					{% endif %}
				</tbody>
			</table>
		</article>
		{% endif %}
		{# /Tickets Tab #}
	</section>
</div>

<div class="profile-box-container tabbed">
	<header>
		<nav>
			<ul>
				<li data-tab-for="#{{baseId}}_notes_tab" class="on">Notes <span class="count" id="{{baseId}}_notes_count">{{ notes|length }}</span></li>
				{% if activity_stream|length %}<li data-tab-for="#{{baseId}}_activity_tab">Activity Stream</li>{% endif %}
			</ul>
		</nav>
	</header>
	<section>
		{# Notes Tab #}
		<article id="{{baseId}}_notes_tab" class="on">
			<div class="notes-wrap">
				<ul>
					{% for note in notes|reverse %}
						{% include 'AgentBundle:Organization:note-li.html.twig' with {'note': note} %}
					{% endfor %}
					<li class="new-note"
						data-element-handler="DeskPRO.Agent.ElementHandler.FormSaver"
						data-form-list-selector="ul"
						data-form-result-html-key="note_li_html"
						data-form-save-url="{{ path('agent_org_ajaxsave_note', {'organization_id': org.id}) }}"
						data-form-count-el="#{{baseId}}_notes_count"
					>
						<header>
							<div class="controls">
								<div class="is-loading">Saving</div>
								<div class="saved" style="display: none">Saved</div>
								<div class="save" style="display: none">Save</div>
							</div>
							<h3>New Note</h3>
						</header>
						<div class="textarea-section"><textarea class="integrated" name="note" placeholder="Enter note ..."></textarea></div>
					</li>
				</ul>
			</div>
		</article>
		{# /Notes Tab #}

		{# Activity Tab #}
		{% if activity_stream|length %}
		<article id="{{baseId}}_activity_tab">
			<ul class="activity-stream">
				{% for action in activity_stream %}
					<li>
						<span class="what">
							<a class="with-route" data-route="page:{{ path('agent_people_view', {'person_id': action.person.id }) }}">
								{{ action.person.display_name }}
							</a>
							{% if action.action_type == 'registered' %}
								Registered an account
							{% elseif action.action_type == 'new_ticket' %}
								Submitted a new ticket
								<a class="with-route" data-route="{{ path('agent_ticket_view', {'ticket_id': action.details.ticket_id }) }}">
									{{ action.details.subject }}
								</a>
							{% elseif action.action_type == 'new_ticket_reply' %}
								Replied to ticket
								<a class="with-route" data-route="{{ path('agent_ticket_view', {'ticket_id': action.details.ticket_id }) }}">
									{{ action.details.subject }}
								</a>
							{% endif %}
						</span>
						<time class="timeago" datetime="{{ action.date_created|date('c') }}">{{ action.date_created|date('M j, Y') }}</time>
					</li>
				{% endfor %}
			</ul>
		</article>
		{% endif %}
		{# /Activity Tab #}
	</section>
</div>
