<section class="ticket-header person-header" id="{{baseId}}_org_header">
	<div class="ticket-id">
		<span>#{{ org.id }}</span>
	</div>
	<div class="ticket-subject no-cat">
		<span class="editable" data-editable-for="#{{baseId}}_editname">{{ org.name|default('<em>Double-click to set Name</em>') }}</span>
		<div id="{{baseId}}_editname" style="display: none">
			<input type="hidden" name="action" value="name" />
			<input type="text" size="20" name="name" value="{{ org.name }}" />
		</div>
	</div>

	<br style="clear:both;height: 1px;overflow: hidden;" />

	<nav class="actions" id="{{baseId}}_action_buttons">
		<ul>
			<li class="more"><button class="clean-gray xx-small">More</button></li>
		</ul>
	</nav>

	<ul id="{{baseId}}_more_actions_menu" style="display: none;">
		<li data-action="" class="delete-trigger">Delete Organization</li>
	</ul>
</section>

<div class="inner-box-tab-content box-list no-pad org-members-table">
	<table class="list" cellspacing="0" width="100%">
		<thead class="display-options-trigger dbl-click-trigger nosel">
			<tr>
				<th>Member</th>
				<th width="30%">Position</th>
				<th width="35"></th>
			</tr>
		</thead>
		<tbody id="{{baseId}}_members_list">
			<tr class="add-new-member line-2">
				<td>
					<input type="input" style="width: 90%" class="name" />
				</td>
				<td>
					<input type="input" style="width: 90%" class="position" />
				</td>
				<td>
					<button class="clean-gray xxx-small">Add</button>
				</td>
			</tr>
			{% for person in org_members %}
				{% include 'AgentBundle:Organization:view-members-row.html.twig' %}
			{% endfor %}
		</tbody>
	</table>
</div>

{% if activity_stream|length %}
<div class="table-container">
	<div class="table-title">
		<h4>Activity from users in this organization</h4>
	</div>
	<div class="table-content">
		<div class="container-tabbed-content-tab">
			<div class="row">
				<ul class="activity-stream">
					{% for action in activity_stream %}
						<li>
							<span class="time">{{ action.date_created|date('M j, Y') }}</span>
							<span class="what">
								<a class="with-route" data-route="page:{{ path('agent_people_view', {'person_id': action.person.id }) }}">
									{{ action.person.display_name }}
								</a>
								{% if action.action_type == 'registered' %}
									Registered an account
								{% elseif action.action_type == 'new_ticket' %}
									Submitted a new ticket
									<a class="with-route" data-route="{{ path('agent_ticket_view', {'ticket_id': action.details.ticket_id }) }}">
										{{ action.details.subject }}
									</a>
								{% elseif action.action_type == 'new_ticket_reply' %}
									Replied to ticket
									<a class="with-route" data-route="{{ path('agent_ticket_view', {'ticket_id': action.details.ticket_id }) }}">
										{{ action.details.subject }}
									</a>
								{% endif %}
							</span>
						</li>
					{% endfor %}
				</ul>
			</div>
		</div>
	</div>
</div>
{% endif %}

{# Box Tickets #}
{% if org_tickets|length %}
<div class="table-container">
	<div class="table-title">
		<h4>Tickets</h4>
	</div>
	<div class="table-content">
		<ul class="tickets-plain-list">
			{% for ticket in org_tickets %}
				<li>
					<a class="with-route" data-route="ticket:{{ path('agent_ticket_view', {'ticket_id': ticket.id}) }}">{{ticket.subject}}</a> by
					<a class="with-route" data-route="page:{{ path('agent_people_view', {'person_id': ticket.person.id }) }}">{{ ticket.person.display_name }}</a>
				</li>
			{% endfor %}
			{% if org_tickets|length < person_tickets_count %}
				<li>
					There are <a class="with-route" data-route="listpane:{{ path('agent_peoplesearch') }}">{{ org_tickets_count - org_tickets|length }} more</a> tickets
				</li>
			{% endif %}
		</ul>
	</div>
</div>
{% endif %}
{# /Box Tickets #}

{# Box Notes #}
<div class="table-container">
	<div class="table-title">
		<h4>Notes</h4>
	</div>
	<div class="table-content">
		<div class="messages-wrap notes-wrap">
			<div class="note-list">
				{% for note in notes|reverse %}
					{% include 'AgentBundle:Organization:note-li.html.twig' with {'note': note} %}
				{% endfor %}
			</div>

			<div class="new-note-form message admin-message">
				<div class="message-avatar left">
					<img src="{{ app.user.getPictureUrl(35) }}" alt="" width="35" height="35" />
				</div>
				<div class="message-body">
					<div class="message-meta">
						<span class="arrow-left"></span>
						<h4>{{ app.user.display_name }}</h4>
					</div>
					<div class="message-text">
						<p>
							<textarea style="width:98%; height: 80px;"></textarea>
						</p>
						<div style="text-align:center; margin-top: 9px;">
							<div class="trigger-row">
								<button class="dp-button x-small trigger save">Add Note</button>
							</div>
							<div class="saving-row">
								Saving ...
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
{# /Box Notes #}
