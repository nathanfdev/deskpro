{% if organization.phones %}
	<div class="row-table-cotent">
		<div class="col-table-content title-col">
			<span>Phone</span>
		</div>
		<div class="col-table-content prop-val">
			<ul class="phones-list">
				{% for i in organization.phones %}
					<li>[{{i.comment}}] {{i.field_1}} {{i.field_2}}</li>
				{% endfor %}
			</ul>
		</div>
	</div>
{% endif %}
