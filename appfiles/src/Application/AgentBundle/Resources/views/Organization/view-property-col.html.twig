{# Box Contact #}
<div class="profile-box-container contact">
	<header>
		<span class="edit-gear contact-edit"></span>
		<h4>{{ phrase('agent.people.contact_info') }}</h4>
	</header>
	<section>
		<div class="table-content contact-list contact-list-wrapper">
			{% include 'AgentBundle:Organization:view-contact-display.html.twig' %}
		</div>
	</section>
</div>
{# /Box Contact #}

{# Properties Box #}
<div class="profile-box-container properties">
	<header>
		<div class="controls">
			<span class="edit-gear prop-edit-trigger"></span>
			<div class="is-loading">{{ phrase('agent.loading_saving') }}</div>
			<button class="cancel" style="display: none">{{ phrase('agent.cancel') }}</button>
			<button class="save" style="display: none">{{ phrase('agent.save') }}</button>
		</div>
		<h4>{{ phrase('agent.label_properties') }}</h4>
	</header>
	<section>
		<div>
			<dl class="table-list">
				<dt class="type-labels">{{ phrase('agent.label_labels') }}</dt>
				<dd class="org-tags tags-wrap">
					<ul data-label-route="listpane:{{ path('agent_orgsearch_customfilter') }}?terms[0][rule_type]=label&amp;terms[0][op]=is&amp;terms[0][label]={LABEL}&amp;view_name=label&amp;view_extra={LABEL}">
						{% for label in org.labels %}
							<li><span>{{label.label}}</span></li>
						{% endfor %}
					</ul>
				</dd>
			</dl>
			<br class="clear" />
		</div>

		{% if custom_fields|length %}
			<dl class="table-list" id="{{baseId}}_custom_fields_rendered">
				{% include 'AgentBundle:Organization:view-customfields-rendered-rows.html.twig' %}
			</dl>
			<dl class="table-list" id="{{baseId}}_custom_fields_editable" style="display: none">
				{% include 'AgentBundle:Organization:view-customfields-edit-rows.html.twig' %}
			</dl>
			<br class="clear" />
		{% endif %}

		<div>
			<dl class="table-list">
				<dt class="type-labels">{{ phrase('agent.date_created') }}</dt>
				<dd>
					<time class="timeago" datetime="{{org.date_created|date('c')}}">{{ org.date_created|date('M j, Y') }}</time>
				</dd>
			</dl>
			<br class="clear" />
		</div>
	</section>
</div>
{# /Properties Box #}

{# Email Associations Box #}
<div id="{{baseId}}_email_assoc_box">
	{% include 'AgentBundle:Organization:orgemail-display.html.twig' %}
</div>
