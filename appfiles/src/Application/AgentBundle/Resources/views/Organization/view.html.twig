<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.Organization';
pageMeta.title = {{ organization.name|json_encode|raw }};
pageMeta.organization_id = {{organization.id}};
pageMeta.labelsAutocompleteUrl = '{{ path('agent_ajax_labels_autocomplete', { 'label_type': 'organizations'}) }}';
pageMeta.labelsSaveUrl = '{{ path('agent_org_ajax_labels_save', {'organization_id': organization.id}) }}';
pageMeta.saveFieldsUrl = '{{ path('agent_org_ajaxsavecustomfields', {'organization_id': organization.id }) }}';
</script>

<div class="profile layout-content">

<div class="inner-box-tab-content-2">
	<div class="person-info-top">
		<div style="float:left; margin-right: 7px; padding: 4px 0;">
			<img class="agent-picture" src="{{ asset('images/pic-agent-2.png') }}" alt="" width="45" height="45" />
		</div>
		<h3 class="name editable hover-edit" data-editable-for=".inline-editable .name">{{organization.name}}</h3>
	</div>
</div>

{# Info Wrap #}
<div class="ticket-info-wrapper">

	{# Top Left #}
	<div class="ticket-info left">
		<div class="tags-wrap org-tags">
			<span class="tag-icon"></span>
			<ul>
				{% for label in organization.labels %}
					<li><span>{{label.label}}</span></li>
				{% endfor %}
			</ul>
		</div>

		{# Top Tabs #}
		<div class="container-tabbed-wrap ticket-participants">

			<div class="container-tabbed-tabs">
				<ul>
					<li class="container-tabbed-tabs-active"><a>Activity Stream</a></li>
				</ul>
			</div>

			<div class="container-tabbed">
				<div class="container-tabbed-contents">

					{# Tab: Stream #}
					<div class="container-tabbed-content-tab">
						<div class="row">
							<ul class="activity-stream">
								<li>
									<span class="time">14 mins</span>
									<span class="who">John Doe</span>
									<span class="what">updated profile fields <a href="">phone number and email address</a></span>
								</li>
								<li>
									<span class="time">42 mins</span>
									<span class="who">John Doe</span>
									<span class="what">created new ticket <a href="">trouble</a></span>
								</li>
								<li>
									<span class="time">1 day ago</span>
									<span class="who">System</span>
									<span class="what">auto-closed ticket <a href="">something or other</a></span>
								</li>
								<li>
									<span class="time">2 days</span>
									<span class="who">Ben</span>
									<span class="what">replied to ticket <a href="">something or other</a></span>
								</li>
								<li>
									<span class="time">2 days</span>
									<span class="who">John Doe</span>
									<span class="what">created ticket <a href="">something or other</a></span>
								</li>
								<li>
									<span class="time">2 days</span>
									<span class="who">John Doe</span>
									<span class="what">registered</span>
								</li>
							</ul>
						</div>
					</div>
					{# /Tab: Stream #}
				</div>
			</div>

		</div>
		{# /Top Tabs #}

	</div>
	{# /Top Left #}

	{# Top Right #}
	<div class="ticket-properties right">

		{# Box Contact #}
		<div class="table-container">
			<div class="table-title">
				<a class="hover-link edit-contact-info">edit</a>
				<h4>Contact Information</h4>
			</div>
			<div class="table-content contact-info-list-wrap">
				{% include 'AgentBundle:Organization:contact-section.html.twig' %}
			</div>
		</div>
		{# /Box Contact #}

		{# Box Properties #}
		<div class="table-container">
			<div class="table-title">
				<a class="hover-link person-custom-fields-edit">edit</a>
				<h4>Properties</h4>
			</div>
			<div class="table-content properties-info-list-wrap">
				<div class="row-table-cotent">
					<div class="col-table-content title-col">
						<span>Members</span>
					</div>
					<div class="col-table-content prop-val">
						<a class="with-route" data-route="listpane:{{ path('agent_peoplesearch_customfilter') }}?terms[0][rule_type]=organization&amp;terms[0][op]=is&amp;terms[0][organization]={{organization.id}}">{{members_count|default(0)}}</a> members
					</div>
				</div>

				{% if custom_fields %}
					<div class="person-custom-fields">
						{% include 'AgentBundle:Organization:custom-fields-rendered.html.twig' with {'custom_fields': custom_fields} %}
					</div>

					<div class="person-custom-fields edit show-fields edit-fields-overlay" style="display:none">
						{% for f in custom_fields %}
							<div class="field-wrap custom-field custom-field-{{f.field_def.id}}">
								<div class="label-wrap"><label>{{f.title}}</label></div>
								<div class="field-input">
									{{ form_widget(f.formView) }}
								</div>
							</div>
						{% endfor %}
						<div class="buttons">
							<div class="loading-off">
								<button class="save-trigger dp-button small">Save</button>
								<button class="close-trigger dp-button gray small">Cancel</button>
							</div>
							<div class="loading-on">
								<span>Saving ...</span>
							</div>
						</div>
					</div>
				{% endif %}
			</div>
		</div>
		{# /Box Properties #}
	</div>
	{# /Top Right #}

</div>
{# /Info Wrap #}

{# Main Tabs #}
<div class="full-container-tabbed messages-container">
	{# Tab Triggers #}
	<div class="full-container-tabbed-tabs">
		<ul>
			<li class="tab-trigger org-notes on" data-tab-for=".tab-content.org-notes"><a>Notes</a></li>
		</ul>
	</div>
	{# /Tab Triggers #}

	{# Tab Contents #}
	<div class="full-container-tabbed-contents-wrap">
		{# Tab: Notes #}
		<div class="full-container-tabbed-contents tab-content org-notes on" data-tab-trigger=".tab-trigger.org-notes">
			<div class="full-tab-content">
				<div class="messages-wrap notes-wrap">

					<div class="new-note-placeholder trigger new-note">
						<span>Add a new note</span>
					</div>

					<div class="new-note-form message admin-message" style="display:none">
						<div class="message-avatar left">
							<img src="{{ app.user.getPictureUrl(35) }}" alt="" width="35" height="35" />
						</div>
						<div class="message-body">
							<div class="message-meta">
								<span class="arrow-left"></span>
								<h4>{{ app.user.display_name }}</h4>
							</div>
							<div class="message-text">
								<p>
									<textarea style="width:98%; height: 80px;"></textarea>
									<div style="text-align:center; margin-top: 9px;">
										<button class="dp-button x-small trigger save">Add Note</button>
										or <a class="trigger cancel">cancel</a>
									</div>
								</p>
							</div>
						</div>
					</div>

					<div class="note-list">
						{% for note in notes %}
							{% include 'AgentBundle:Organization:note-li.html.twig' with {'note': note} %}
						{% endfor %}
					</div>
				</div>
			</div>
		</div>
		{# /Tab: Notes #}
	</div>
	{# /Tab Contents #}
</div>
{# /Main Tabs #}

<ul class="contact-info-edit-menu" style="display:none">
	<li data-edit-type="phone">Edit phone numbers</li>
	<li data-edit-type="address">Edit addresses</li>
	<li data-edit-type="im">Edit instant messaging</li>
</ul>

<div class="inline-editable" style="display:none">
	<div class="name">
		<input name="name" value="{{organization.name}}" />
		<input type="hidden" name="action" value="name" />
	</div>
</div>

<div class="contact-add-tpl im new show-fields edit" style="display:none; width: 375px">
	<input type="hidden" name="contact_type" value="instant_message" />
	<div class="field-wrap">
		{{contact_fields_tpl.instant_message.protocol.render|raw}}
		{{contact_fields_tpl.instant_message.im.render({'placeholder': 'ID/Nickname'})|raw}}
		{{contact_fields_tpl.instant_message.comment.render()|raw}}
	</div>
	<div class="buttons">
		<div class="loading-off">
			<button class="save trigger dp-button small">Save</button>
			<button class="close trigger dp-button gray small">Cancel</button>
		</div>
		<div class="loading-on">
			<span>Saving ...</span>
		</div>
	</div>
</div>
<div class="contact-add-tpl address new show-fields edit" style="display:none; width: 375px">
	<input type="hidden" name="contact_type" value="address" />
	<div class="field-wrap">
		{{contact_fields_tpl.address.address.render()|raw}}<br />
		{{contact_fields_tpl.address.country.render({'size': 10, 'placeholder': 'Country'})|raw}}
		{{contact_fields_tpl.address.comment.render()|raw}}
	</div>
	<div class="buttons">
		<div class="loading-off">
			<button class="save trigger dp-button small">Save</button>
			<button class="close trigger dp-button gray small">Cancel</button>
		</div>
		<div class="loading-on">
			<span>Saving ...</span>
		</div>
	</div>
</div>
<div class="contact-add-tpl phone new show-fields edit" style="display:none; width: 375px">
	<input type="hidden" name="contact_type" value="phone" />
	<div class="field-wrap">
		{{contact_fields_tpl.phone.country_code.render({'size': 4, 'placeholder': 'Country Code'})|raw}}
		{{contact_fields_tpl.phone.phone.render({'placeholder': 'Phone Number'})|raw}}
		{{contact_fields_tpl.phone.comment.render()|raw}}
	</div>
	<div class="buttons">
		<div class="loading-off">
			<button class="save trigger dp-button small">Save</button>
			<button class="close trigger dp-button gray small">Cancel</button>
		</div>
		<div class="loading-on">
			<span>Saving ...</span>
		</div>
	</div>
</div>