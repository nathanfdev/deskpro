<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.NewTask';
pageMeta.title = 'New Task';

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>

{# scroll containers #}
<div class="layout-content with-scrollbar page-new-ticket page-new-content">
<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
<div class="scroll-viewport"><div class="scroll-content">
{# /scroll containers #}
<form action="{{ path('agent_task_new') }}" method="post" {{ form_enctype(form) }}>
    
    <div class="section title-section first" id="{{baseId}}_title_section">
    
        <div class="step">
		<span class="num">1</span>
		<span class="check">Done</span>
	</div>
        <div class="content">
            <h4>Title</h4>
                {{ form_errors(form.title) }}
                {{ form_widget(form.title, {'attr': {'class' : 'user-search'}}) }}
            <span><a href="#" class="gear" id="{{baseId}}_gear_spn">Gear</a></span>
        </div>
    
    </div>
    <div class="taskpropertiec-section" id="{{baseId}}_task_proterties_section" style="display:none">
        <div class="due-date">
            <h4>Due Date</h4>
            {{ form_widget(form.date_due, {'attr': {'class' : 'user-search'}}) }}
        </div>
    </div>
    
    <div class="foot">
        <button id="{{baseId}}_save">Save</button>

	
    </div>
</form>
