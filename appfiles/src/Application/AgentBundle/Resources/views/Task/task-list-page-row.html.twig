<task class="task {{ info.content_type }}-{{task.id}}">
    <div class="task-display content">
        <div class="col isLeft hasMarnigRight-10px">
        <input
                class="item-select"
                type="checkbox"
                value="{{ info.content_type }}.{{info.content_id}}"
                data-content-type="{{ info.content_type }}"
                data-task-id="{{ task.id }}"
        />
        </div>
        <div class="col">
            <div class="task-row">
                <div class="rendered">
                        {{ task.title|raw }}
                </div>
            </div>
        </div>
        <div class="task-comments">
            
        </div>
        <div class="task-item-footer">
            {% include 'AgentBundle:Task:task-item-footer.html.twig' %}
        </div>
        <div style="clear:both;"></div>
   </div>
</task>