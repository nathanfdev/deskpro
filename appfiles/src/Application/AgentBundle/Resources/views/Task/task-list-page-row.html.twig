<article class="row-item task task-{{task.id}}">
   <input type="checkbox" class="item-select" value="{{ task.id }}" data-content-id="{{ task.id }}" data-content-type="{{ task.id }}"
          {% if task.is_completed == true %} checked="checked" {% endif %}/>
   <div class="top-row">
        <div class="top-row-left">
            <h3>
                <a class="with-route name" data-route="task:{{path('agent_task_view', {'task_id': task.id|default('0')})}}">
                        {{ task.title }}
                </a>
            </h3>
        </div>
   </div>
   <hr class="clear-top" />

<!-- Add comment property section start -->
 <article id="{{baseId}}_comment_tab" class="on">
    <div class="notes-wrap">
        <ul>

            {% for comment in task.comments|reverse %}
                    {% include 'AgentBundle:Task:comment-li.html.twig' with {'comment': comment} %}
                {% endfor %}
            
                <li class="new-note"
                        data-element-handler="DeskPRO.Agent.ElementHandler.FormSaver"
                        data-form-list-selector="ul"
                        data-form-result-html-key="comment_li_html"
                        data-form-save-url="{{ path('agent_task_ajaxsave_comment', {'task_id': task.id}) }}"
                        style="display:none;"                        

                >
            <header>
                <div class="controls">
                        <div class="is-loading">Saving</div>
                        <div class="saved" style="display: none">Saved</div>
                        <div class="save" style="display: none">Save</div>
                </div>
                <h3>New Comment</h3>
            </header>
                        <div class="textarea-section"><textarea class="" name="comment" placeholder="Enter comment ..."></textarea></div>
                </li>
        </ul>
    </div>
</article>
<!-- Add comment property section end -->

<!-- Add label property section start -->
   <div class="profile-box-container properties task-label" style="display:none;">
       <header>
           <h4>Labels</h4>
       </header>
       <section>
           <dl class="table-list">
                <dt class="type-labels">Labels</dt>
                <dd class="task-tags tags-wrap" title="{{ path('agent_task_ajax_labels_save', {'task_id': task.id}) }}">
                    <ul>
                            {% for label in task.labels %}
                                    <li><span>{{label.label}}</span></li>
                            {% endfor %}
                    </ul>
                </dd>
            </dl>
        <section/>

   </div>
    <!-- Add label property section end -->
    
    <!-- Change property section start -->
   <div class="profile-box-container properties task-due-date" style="display:none;"
        data-element-handler="DeskPRO.Agent.ElementHandler.FormSaver"
        data-form-save-url="{{ path('agent_task_ajaxsave_duedate', {'task_id': task.id}) }}"
        >
        <header>
            <div class="controls">
                    <div class="is-loading">Saving</div>
                    <div class="saved" style="display: none">Saved</div>
                    <div class="save" style="display: none">Save</div>
            </div>
            <h4>Due Date</h4>
        </header>
       <section>
           <div class="textarea-section">
               
               <input type="text" class="calender " id="{{task.id}}_date_due" name="date_due" value="{{task.date_due| date('m/d/Y')}}"/>
           </div>
       </section>
   </div>
   <!-- Change property section end -->

   <!-- Delegate property section start -->

   <div class="profile-box-container properties task-delegate" style="display:none;"
        data-element-handler="DeskPRO.Agent.ElementHandler.FormSaver"
        data-form-save-url="{{ path('agent_task_ajaxsave_delegate', {'task_id': task.id}) }}"
        >
        <header>
            <div class="controls">
                    <div class="is-loading">Saving</div>
                    <div class="saved" style="display: none">Saved</div>
                    <div class="save" style="display: none">Save</div>
            </div>
            <h4>Delegate</h4>
        </header>
       <section>
           
       </section>
   </div>
   <!-- Delegate property section end -->

    <div class="clear" />
   
    {% include 'AgentBundle:Task:task-item-footer.html.twig'%}
   
</article>