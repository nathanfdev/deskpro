<article class="row-item task task-{{task.id}}">
   <input type="checkbox" class="item-select" value="{{ task.id }}"/>
   <div class="top-row">
        <div class="top-row-left">
                <h3>
                        <a class="with-route name" data-route="task:">
                                {{ task.title }}
                        </a>
                </h3>
        </div>
   </div>
   <hr class="clear-top" />
    {% include 'AgentBundle:Task:task-item-footer.html.twig'%}
   
</article>