<header class="list-selection-bar">
	<input type="checkbox" class="selection-control" /> <span class="selected-count">0</span> selected
	<a class="perform-action perform-actions-trigger disabled">
		<span>Perform Action</span>
	</a>
	<ul class="actions-menu" data-menu-type="idea-massactions-menu" style="display: none">
		<li data-submenu-selector="#idea_status_menu">
			Set Status
		</li>
		<li data-submenu-selector="#idea_category_menu">
			Set Category
		</li>
		<li class="sep">-</li>
		<li data-action="delete">Delete</li>
		<li data-action="spam">Mark as spam</li>
	</ul>
</header>
