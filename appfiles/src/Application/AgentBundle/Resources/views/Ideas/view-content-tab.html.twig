<div class="full-tab-content">
	<div class="idea-content-wrap">
		{{ idea.content_html|raw }}
	</div>
	<div class="idea-editor-wrap" style="display: none">
		<div class="idea-editor">
			{% if state.idea.content %}
				<div class="revert-message-notice">
					Unsaved changes were restored. <button class="revert-default">{{ phrase('agent.publish.discard_unsaved_changes') }}</button>
					<br />
					<textarea class="edit-content-field-default" style="display: none;">{{idea.content}}</textarea>
				</div>
			{% endif %}
			<textarea class="edit-content-field" name="idea[content]" rows="5" cols="50">{{ state.idea.content|default(idea.content) }}</textarea>

			<br />

			<button class="dp-button editor-save-trigger small">{{ phrase('agent.save') }}</button>
			<button class="dp-button editor-cancel-trigger small">{{ phrase('agent.cancel') }}</button>
		</div>
	</div>
</div>
