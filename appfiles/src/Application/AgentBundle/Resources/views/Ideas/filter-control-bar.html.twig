<header class="list-control-bar">
	<ul>
		<li>Ordered by </li>
		<li class="order-by-menu-trigger"><a class="button">
			<span class="label">
				{% if 'popularity' in cache.criteria.order_by %}
					Popularity
				{% elseif 'num_ratings' in cache.criteria.order_by %}
					Votes
				{% else %}
					Date
				{% endif %}
			</span>
		</a></li>
		<li><span class="sep"></span></li>
		<li class="display-options display-options-trigger"><a>Display options</a></li>
	</ul>
	<ul class="order-by-menu" style="display: none">
		<li data-field="popularity">Popularity</li>
		<li data-field="votes">Votes</li>
		<li data-field="date">Date</li>
	</ul>
</header>
