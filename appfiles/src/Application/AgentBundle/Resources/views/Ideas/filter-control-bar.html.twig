<header class="list-control-bar">
	<ul>
		<li>{{ phrase('agent.ordered_by') }}  </li>
		<li class="order-by-menu-trigger"><a class="button">
			<span class="label">
				{% if 'popularity' in cache.criteria.order_by %}
					{{ phrase('agent.ideas.popularity') }}
				{% elseif 'num_ratings' in cache.criteria.order_by %}
					{{ phrase('agent.publish.votes') }}
				{% else %}
					{{ phrase('agent.date_created') }}
				{% endif %}
			</span>
		</a></li>
		<li><span class="sep"></span></li>
		<li class="display-options display-options-trigger"><a>{{ phrase('agent.display_options') }}</a></li>
	</ul>
	<ul class="order-by-menu" style="display: none">
		<li data-field="popularity">{{ phrase('agent.ideas.popularity') }}</li>
		<li data-field="votes">{{ phrase('agent.publish.votes') }}</li>
		<li data-field="date">{{ phrase('agent.date_created') }}</li>
	</ul>
</header>
