 <section class="search-reuslts page-set" data-page="{{ page }}">
	{% for idea in ideas %}
		<article class="row-item idea idea-{{idea.id}} ideas-{{idea.id}} related-is-linkable" data-content-type="ideas" data-content-id="{{ idea.id }}">
			<input class="item-select" type="checkbox" value="{{idea.id}}" />
			<div class="top-row">
				<div class="top-row-left">
					<span class="votes">
						{{ idea.num_ratings|default(0) }}
					</span>
					<h3>
						<a data-route="page:{{ path('agent_ideas_view', {'idea_id': idea.id}) }}">{{ idea.title }}</a>
					</h3>
				</div>
				<div class="top-row-right visible-related-content-controls">
					<div class="bound-faded"></div>
					<button class="clean-gray xxx-small related-link">Add as related</button>
					<button class="clean-gray xxx-small related-unlink">Remove as related</button>
				</div>
			</div>
			<hr class="clear-top" />
			{% if display_fields|length %}
				<div class="extra-fields">
					<ul>
						{% for field in display_fields %}
							{% if field == 'category' %}
								<li>
									<span class="prop-title">Category</span>
									<span class="prop-val">{{ idea.category.full_title }}</span>
								</li>
							{% elseif field == 'author' %}
								<li>
									<span class="prop-title">Author</span>
									<span class="prop-val">{{ idea.user_name }} {% if idea.user_email %}({{ idea.user_email }}){% endif %}</span>
								</li>
							{% elseif field == 'date_created' %}
								<li>
									<span class="prop-title">Date Created</span>
									<span class="prop-val">{{ idea.date_created|date('M j, Y')}}</span>
								</li>
							{% endif %}
						{% endfor %}
					</ul>
					<br class="clear" />
				</div>
			{% else %}
				<br class="clear" />
			{% endif %}
		</article>
	{% endfor %}
 </section>
