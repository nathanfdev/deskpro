 <section class="search-reuslts page-set" data-page="{{ page }}">
	{% for idea in ideas %}
		<article
			class="row-item idea idea-{{idea.id}} ideas-{{idea.id}} related-is-linkable"
			data-content-type="ideas"
			data-content-id="{{ idea.id }}"
			data-route="idea:{{ path('agent_ideas_view', {'idea_id': idea.id}) }}"
			data-route-title="@selector(a.idea-title)"
			data-route-openclass="open"
		>
			<input class="item-select" type="checkbox" value="{{idea.id}}" />
			<div class="top-row">
				<div class="top-row-left">
					<span class="votes">
						{{ idea.num_ratings|default(0) }}
					</span>
					<h3>
						<a class="idea-title click-through">{{ idea.title }}</a>
					</h3>
				</div>
				<div class="top-row-right visible-related-content-controls">
					<div class="bound-faded"></div>
					<span class="tipped related-link" title="{{ phrase('agent.add_related') }}"></span>
					<span class="tipped related-unlink" title="{{ phrase('agent.remove_related') }}"></span>
				</div>
			</div>
			<hr class="clear-top" />
			{% if display_fields|length %}
				<div class="extra-fields">
					<ul>
						{% for field in display_fields %}
							{% if field == 'category' %}
								<li>
									<span class="prop-title">{{ phrase('agent.category') }}</span>
									<span class="prop-val">{{ idea.category.full_title }}</span>
								</li>
							{% elseif field == 'author' %}
								<li>
									<span class="prop-title">{{ phrase('agent.author') }}</span>
									<span class="prop-val">{{ idea.person.display_name }} {% if idea.person.primary_email_address %}({{ idea.person.primary_email_address }}){% endif %}</span>
								</li>
							{% elseif field == 'date_created' %}
								<li>
									<span class="prop-title">{{ phrase('agent.date_created') }}</span>
									<span class="prop-val">{{ idea.date_created|date('M j, Y')}}</span>
								</li>
							{% endif %}
						{% endfor %}
					</ul>
					<br class="clear" />
				</div>
			{% else %}
				<br class="clear" />
			{% endif %}
		</article>
	{% endfor %}
 </section>
