<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.IdeaFilter';
pageMeta.pageUrl = '{{ path('agent_ideas_filter') }}?partial=1&cache_id={{cache_id}}&page=$page';
{% if list_type == 'category' %}
	pageMeta.refreshUrl = '{{ path('agent_ideas_category', {'category_id': category_id}) }}';
	{% set subgroup_url = path('agent_ideas_category', {'category_id': category_id, 'subgroup': 'SUBGROUP_ID'}) %}
{% elseif list_type == 'status' %}
	pageMeta.refreshUrl = '{{ path('agent_ideas_status', {'status': status}) }}?';
	{% set subgroup_url = path('agent_ideas_status', {'status': status, 'subgroup': 'SUBGROUP_ID'}) %}
{% elseif list_type == 'label' %}
	pageMeta.refreshUrl = '{{ path('agent_ideas_label', {'label': label}) }}?';
{% elseif list_type == 'validating' %}
	pageMeta.refreshUrl = '{{ path('agent_ideas_validating') }}?';
{% else %}
	pageMeta.refreshUrl = '{{ path('agent_ideas_filter') }}?cache_id={{cache_id}}';
{% endif %}
{% if cache_id %}
	pageMeta.cache_id = {{cache_id}};
{% endif %}
{% if not ideas %}
	pageMeta.noResults = true;
{% endif %}
</script>
<div class="layout-content">
<div class="content">

	{% include 'AgentBundle:Ideas:filter-display-options.html.twig' %}
	{% include 'AgentBundle:Ideas:filter-control-bar.html.twig' %}
	{% include 'AgentBundle:Ideas:filter-grouping-bar.html.twig' %}
	{% include 'AgentBundle:Ideas:filter-massactions-bar.html.twig' %}

	<section class="ideas-simple-list list-listing">
		{% include 'AgentBundle:Ideas:filter-page.html.twig' %}
	</section>
</div>
</div>
