<div class="ticket-merge idea-merge overlay">
	<div class="overlay-title">
		<h4>{{ phrase('agent.merge_x_into', {'name': idea.title|e}) }}</h4>
		<div class="info">
			{{ phrase('agent.ideas.merge_explain') }}
		</div>
	</div>

	<div class="overlay-content">
		{% if not open_ideas %}
			<div class="group">
				<ul>
					<li>
						{{ phrase('agent.ideas.merge_none_open') }}
					</li>
				</ul>
			</div>
		{% endif %}

		{% if open_ideas %}
		<div class="group open-tickets">
			<ul>
				{% for idea in open_ideas %}
					<li>
						<a data-route="page:{{ path('agent_ideas_view', {'idea_id': idea.id}) }}" class="with-route">{{ idea.title }}</a>
						<button class="clean-gray xx-small merge-trigger" data-idea-id="{{ idea.id }}">{{ phrase('agent.merge') }}</button>
					</li>
				{% endfor %}
			</ul>
		</div>
		{% endif %}
	</div>
</div>
