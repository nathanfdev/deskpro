<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.IdeaView';
pageMeta.title = {{idea.title|json_encode|raw}};
pageMeta.idea_id = {{idea.id}};

pageMeta.permalink = '{{ idea.permalink }}';
pageMeta.labelsSaveUrl = '{{ path('agent_ideas_ajax_labels_save', {'idea_id': idea.id}) }}';

{% if idea.hidden_status == 'validating' %}
pageMeta.isValidating = true;
{% endif %}

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
<div class="layout-content full-page idea-page with-scrollbar">
<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
<div class="scroll-viewport"><div class="scroll-content">

<div class="deleted-notice" {% if idea.status_code != "hidden.deleted" %}style="display: none;"{% endif %}>
	This idea has been deleted. <button class="clean-gray xxx-small undelete">Undelete</button>
</div>

{% if idea.status_code == "hidden.validating" %}
	{% include 'AgentBundle:Publish:view-approve-header.html.twig' %}
{% endif %}

<section class="ticket-header" id="{{baseId}}_idea_header">
	<div class="ticket-id">
		<span>#{{ idea.id }}</span>
	</div>

	{% if idea.status_code != "hidden.validating" %}
		<div class="the-status" {% if idea.status_code == "hidden.deleted" %}style="display:none"{% endif %}>
			<div class="ticket-status idea-status prop-status-icon tipped" title="{{ idea.status }}">
				<span class="ticket-{{idea.status}}"></span>
			</div>
		</div>
	{% endif %}

	<div class="the-department">
		<div class="ticket-department prop-department-id" id="{{baseId}}_category">
			<div class="parent">
				{% if idea.category.parent %}
					{{ idea.category.parent.title }}
				{% else %}
					{{ idea.category.title }}
				{% endif %}
			</div>
			<div class="sub">
				{% if idea.category.parent %}
					{{ idea.category.title }}
				{% endif %}
			</div>
		</div>
	</div>
	<div class="ticket-subject editable hover-edit no-cat" data-editable-for=".inline-editable .title">
		{{ idea.title }}
	</div>
	<br style="clear:both;height: 1px;overflow: hidden;" />

	<div class="assignments">
		<div class="agent">
			<div class="desc">
				By {% for author in idea.authors %}<cite>{{ author.display_name }}</cite>{% if not loop.last %}, {% endif %}{% endfor %}
			</div>
			<br style="clear:both;height: 1px;overflow: hidden;" />
		</div>
	</div>

	<nav class="actions" id="{{baseId}}_action_buttons">
		<ul>
			<li class="delete" {% if idea.status_code == "hidden.deleted" %}style="display:none"{% endif %}><button class="clean-gray xx-small">Delete</button></li>
			<li class="permalink"><button class="clean-gray xx-small">Copy Permalink</button></li>
			<li class="view-user-interface"><button class="clean-gray xx-small">View in user interface</button></li>
		</ul>
	</nav>

	<div class="times">
		Created <time class="timeago" datetime="{{idea.date_created|date('c')}}"></time> at <time>{{idea.date_created|date('H:ia M j Y')}}</time>.<br/>
	</div>
</section>

<div class="full-container-tabbed main-tabs">
	<div class="full-container-tabbed-contents-wrap field-section-bodytabs-tab-contents">
		<div class="full-container-tabbed-contents">
			<div class="table-content">
				<div class="row-table-cotent">
					<div class="col-table-content title-col">
						<span>Labels</span>
					</div>
					<div class="col-table-content">
						<div class="tags-wrap idea-tags">
							<span class="tag-icon"></span>
							<ul>
								{% for label in idea.labels %}
									<li><span>{{label.label}}</span></li>
								{% endfor %}
							</ul>
						</div>
					</div>
				</div>

				<div class="row-table-cotent">
					<div class="col-table-content title-col">
						<span>Rating</span>
					</div>
					<div class="col-table-content">
						{{ idea.rating_percent }}% in favor (<span class="link-look who-voted-trigger">{{ idea.num_ratings }} votes</span>)<br />
						<small>{{ idea.up_votes }} up, {{ idea.down_votes }} down</small>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

{# Main Tabs #}
<div class="full-container-tabbed messages-container" id="{{baseId}}_bodytabs">
	{# Tab Triggers #}
	<div class="full-container-tabbed-tabs">
		<span class="idea-editor-edit kb-editor-edit"><a>edit</a></span>
		<ul>
			<li class="tab-trigger" data-tab-for=".tab-content.content-tab"><a>Description</a></li>
			<li class="tab-trigger" data-tab-for=".tab-content.comments-tab"><a>Comments (<span id="{{baseId}}_count_comments">{{idea_comments|length|default(0)}}</span>)</a></li>
			<li class="tab-trigger" data-tab-for=".tab-content.revisions"><a>Revisions</a></li>
			<li class="tab-trigger" data-tab-for=".tab-content.related-content"><a>Related Content</a></li>
			<li class="tab-trigger" data-tab-for=".tab-content.search-tab"><a>Search</a></li>
		</ul>
	</div>
	{# /Tab Triggers #}

	{# Tab Contents #}
	<div class="full-container-tabbed-contents-wrap">
		{# Tab: Content #}
		<div class="full-container-tabbed-contents tab-content content-tab" style="display: block">
			<div id="{{baseId}}_content_ed">
			{% include 'AgentBundle:Ideas:view-content-tab.html.twig' %}
			</div>
		</div>
		{# /Tab: Content #}

		{# Tab: Comments #}
		<div class="full-container-tabbed-contents tab-content comments-tab">
			<div class="idea-comments">
				<div class="full-tab-content">
					<div class="messages-wrap" id="{{baseId}}_comments_wrap">
						{% for comment in idea_comments %}
							{% include 'AgentBundle:Ideas:view-comment.html.twig' %}
						{% endfor %}
					</div>
				</div>

				<div class="message admin-message new-note">
					<div class="message-avatar left">
						<img src="{{ app.user.getPictureUrl(35) }}" alt="" width="35" height="35" />
					</div>
					<div class="message-body">
						<div class="message-meta">
							<span class="arrow-left"></span>
							<h4>{{ app.user.display_name }}</h4>
						</div>
						<div class="message-text">
							<p>
								<textarea style="width:98%; height: 80px;"></textarea>
								<div style="text-align:center; margin-top: 9px;">
									<div class="loading-off">
										<button class="dp-button x-small">Add Comment</button>
									</div>
									<div class="loading-on" style="display:none">
										Saving ...
									</div>
								</div>
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
		{# /Tab: Comments #}

		{# Tab: Revisions #}
		<div id="{{baseId}}_revs" class="loaded full-container-tabbed-contents tab-content revisions">
			{% include 'AgentBundle:Ideas:view-revisions-tab.html.twig' %}
		</div>
		{# /Tab: Revisions #}

		{# Tab: Related #}
		<div id="{{baseId}}_related_content" class="full-container-tabbed-contents tab-content related-content">
			{% include 'AgentBundle:Common:content-related-list.html.twig' %}
		</div>
		{# /Tab: Related #}

		{# Tab: Search #}
		<div id="{{baseId}}_searchtab" class="full-container-tabbed-contents tab-content search-tab">
			<div class="tags-wrap sticky-search-words">
				<span class="tag-icon with-label">Search Words</span>
				<ul>
					{% for word in sticky_search_words %}
						<li><span>{{word}}</span></li>
					{% endfor %}
				</ul>
				<div class="explain">
					When a user searches for any of these words, this page will always be listed in their top results.
				</div>
			</div>

			<br />

			{% include 'AgentBundle:Publish:rated-searches.html.twig' %}
		</div>
		{# /Tab: Search #}
	</div>
	{# /Tab Contents $}
</div>
{# /Main Tabs #}

{% include 'AgentBundle:Common:menu-idea-status.html.twig' with {'active_status_cats': active_status_cats, 'closed_status_cats': closed_status_cats} %}

<div class="inline-editable" style="display:none">
	<div class="title">
		<input type="text" name="title" value="{{ idea.title }}"/>
		<input type="hidden" name="action" value="title" />
	</div>
</div>

</div>


</div></div> {# scrollbar divs #}

</div> {# main layout div #}

{% include 'AgentBundle:MediaBrowser:overlay.html.twig' %}
