<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.IdeaView';
pageMeta.title = {{idea.title|json_encode|raw}};
pageMeta.idea_id = {{idea.id}};
pageMeta.urls = {

};
</script>
<div class="layout-content with-scrollbar">
<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
<div class="scroll-viewport"><div class="scroll-content">

<div class="inner-box-tab-content-2 idea">
	<div class="idea-status idea-{{idea.status}}">
		<span class="prop-val menu-trigger status">{{ phrase('core_ideas.status_' ~ idea.status) }}</span>
	</div>
	<div class="idea-votes">
		{{idea.num_votes}}<br />
		<button class="who-voted-trigger">Who Voted</button>
	</div>
	<div class="ticket-info-top">
	<span class="ticket-source prop-val menu-trigger category_id" data-no-value="Choose Category">
		{{idea.category.full_title|default('Choose Category')}}
	</span>
	<h3 class="prop title editable hover-edit" data-editable-for=".inline-editable .title">
		{{idea.title}}
	</h3>
	</div>
</div>

<div class="messages-wrap">
	{% for comment in idea_comments %}
		{% include 'AgentBundle:Ideas:view-comment.html.twig' %}
	{% endfor %}

	<div class="message admin-message new-comment">
		<div class="message-avatar left">
			<img src="{{ app.user.getPictureUrl(35) }}" alt="" width="35" height="35" />
		</div>
		<div class="message-body">
			<div class="message-meta">
				<span class="arrow-left"></span>
				<h4>{{ app.user.display_name }}</h4>
			</div>
			<div class="message-text">
				<p>
					<textarea style="width:98%; height: 80px;"></textarea>
					<div style="text-align:center; margin-top: 9px;">
						<div class="loading-off">
							<button class="dp-button x-small">Add Comment</button>
						</div>
						<div class="loading-on" style="display:none">
							Saving ...
						</div>
					</div>
				</p>
			</div>
		</div>
	</div>
</div>

{% include 'AgentBundle:Ideas:view-menus.html.twig' %}

<div class="inline-editable" style="display:none">
	<span class="title">
		<input type="hidden" name="action" value="title" />
		<input type="text" name="title" value="{{idea.title}}" />
	</span>
</div>

{# Scrollbar elements #}
</div></div>
</div>
