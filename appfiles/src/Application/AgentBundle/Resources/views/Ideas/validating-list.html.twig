<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.IdeaFilter';
pageMeta.pageUrl = '{{ path('agent_ideas_validating') }}?partial=1&cache_id={{cache_id}}&page=$page';
pageMeta.refreshUrl = '{{ path('agent_ideas_validating') }}?cache_id={{cache_id}}';
pageMeta.submitFilterUrl = '{{ path('agent_ideas_validating') }}';
pageMeta.isValidating = true;
{% if cache_id %}
	pageMeta.cache_id = {{cache_id}};
{% endif %}
{% if not ideas %}
	pageMeta.noResults = true;
{% endif %}
</script>
<header class="section-header">
	<h1>
		{{ phrase('core_ideas.articles_awaiting_validation') }}
	</h1>
</header>
<div class="layout-content">
<div class="content">
	<section class="ideas-simple-list deskpro-results-list">
		{% include 'AgentBundle:Ideas:validating-list-part.html.twig' %}
	</section>

	<div class="loading-more">
		{{ phrase('agent.loading') }}
	</div>
	<div class="no-more-results">
		{{ phrase('agent.no_more_results') }}
	</div>
</div>
</div>
