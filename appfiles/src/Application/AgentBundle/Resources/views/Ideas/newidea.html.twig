<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.Page.NewIdea';
pageMeta.title = '{{ phrase('agent.publish.new_idea') }}';

{% set baseId = el_uid() %}
pageMeta.baseId = '{{ baseId }}';
</script>
{# scroll containers #}
<div class="layout-content with-scrollbar page-new-idea page-new-content">
<div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>
<div class="scroll-viewport"><div class="scroll-content">
{# /scroll containers #}

<form id="{{baseId}}_newidea">

<div class="section cat-section" id="{{baseId}}_cat_section">
	<div class="step">
		<span class="num">1</span>
		<span class="check">{{ phrase('agent.done') }}</span>
	</div>
	<div class="content">
		<div class="col">
			<h4>{{ phrase('agent.category') }}</h4>
			{% include 'AgentBundle:Common:select-standard.html.twig' with {
				'name': 'newidea[category_id]',
				'id': baseId ~ '_cat',
				'add_classname': 'category_id',
				'add_attr': '',
				'with_blank': 1,
				'blank_title': '',
				'categories': idea_categories,
				'selected': state.newidea.category_id|default(0)
			} %}
		</div>
		<div class="col">
			<h4 class="light">{{ phrase('agent.status') }}</h4>
			{% include 'AgentBundle:Common:select-idea-status.html.twig' with {'name': 'newidea[status_code]'} %}
		</div>
		<br class="clear" />
	</div>
</div>

<div class="section title-section" id="{{baseId}}_title_section">
	<div class="step">
		<span class="num">2</span>
		<span class="check">{{ phrase('agent.done') }}</span>
	</div>
	<div class="content">
		<h4>{{ phrase('agent.label_title') }}</h4>
		<input type="title" name="newidea[title]" id="{{baseId}}_title" value="{{ state.newidea.title }}" />
	</div>
</div>

<div class="section article-section" id="{{baseId}}_content_section">
	<div class="step">
		<span class="num">3</span>
		<span class="check">{{ phrase('agent.done') }}</span>
	</div>
	<div class="content">
		<h4>{{ phrase('agent.label_description') }}</h4>
		<textarea type="text" name="newidea[content]" id="{{baseId}}_content">{{ state.newidea.content }}</textarea>
	</div>
</div>


<div class="section other-section" id="{{baseId}}_other_section">
	<div class="step">
		<span class="num">5</span>
		<span class="check">{{ phrase('agent.done') }}</span>
	</div>
	<div class="content">
		{# Tab Container #}
		<div class="tab-container">
			<nav id="{{baseId}}_other_props_tabs_wrap">
				<ul id="{{baseId}}_other_props_tabs">
					<li data-tab-for="> .tab-properties">{{ phrase('agent.label_properties') }}</li>
				</ul>
			</nav>
			<div class="content-wrapper" id="{{baseId}}_other_props_tabs_content" style="display: none">
				{# Tab Properties #}
				<div class="tab-properties" style="display: none">
					<dl>
						<dt class="prop">{{ phrase('agent.label_url_slug') }}</dt>
						<dd class="prop">
							<input type="input" name="newidea[slug]" id="{{baseId}}_slug" value="{{ state.newidea.slug }}" />
						</dd>

						<dt class="prop">{{ phrase('agent.label_labels') }}</dt>
						<dd class="prop">
							<div class="tags-wrap article-tags">
								<span class="tag-icon"></span>
								<ul>
									{% for l in state.newidea.labels %}
										<li>{{ l }}</li>
									{% endfor %}
								</ul>
							</div>
						</dd>
					</dl>
				</div>
				{# /Tab Properties #}
			</div>
		</div>
		{# /Tab Container #}
	</div>
</div>

<div class="foot">
	<button class="dp-button submit-trigger">{{ phrase('agent.create') }}</button>
</div>

</form>

{# scroll containers #}
</div></div>
</div>
{# /scroll containers #}
