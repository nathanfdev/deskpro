<section class="source-section">
	<ul class="source-list">
		<li class="auto-load-route" data-route="listpane:{{ path('agent_public_validatingcontent', {'specific_type': 'ideas'}) }}">
			<h3 class="title">
				<span class="list-counter" id="ideas_validating_count">{{ counts.ideas_awaiting_validation|default(0) }}</span>
				{{ phrase('agent.ideas.ideas_to_validate') }}
			</h3>
		</li>
		<li data-route="listpane:{{ path('agent_publish_validatingcomments', {'specific_type': 'ideas'}) }}">
			<h3 class="title">
				<span class="list-counter" id="ideas_comments_validating_count">{{ counts.comments_awaiting_validation|default(0) }}</span>
				{{ phrase('agent.publish.comments_to_validate') }}
			</h3>
		</li>
	</ul>
</section>

<section class="source-tabs" id="ideas_outline_tabstrip">
	<ul>
			<li data-tab-for="#ideas_outline_status"><span>{{ phrase('agent.status') }}</span></li>
			<li data-tab-for="#ideas_outline_category"><span>{{ phrase('agent.category') }}</span></li>
			<li data-tab-for="#ideas_outline_labels"><span>{{ phrase('agent.labels') }}</span></li>
		</ul>
</section>

<section id="ideas_outline_status" class="deskpro-tab-item">
	<ul class="source-list">
		<li class="auto-load-route" data-route="listpane:{{ path('agent_ideas_status', {'status': 'new'}) }}">
			<span class="title">
				<span class="list-counter" id="ideas_status_new_count">{{ status_counts.new|default(0) }}</span>
				{{ phrase('agent.ideas.status_new') }}
			</span>
		</li>
		<li data-route="listpane:{{ path('agent_ideas_status', {'status': 'active'}) }}">
			<span class="title">
				<span class="list-counter" id="ideas_status_active_0_count">{{ status_counts.active[0]|default(0) }}</span>
				{{ phrase('agent.ideas.status_active') }}
			</span>
			<ul class="sub-group indented-list">
				{% for cat in active_status_cats %}
					<li class="indent" data-route="listpane:{{ path('agent_ideas_status', {'status': cat.id}) }}">
						<span class="title">
							<span class="list-counter" id="ideas_status_active_{{cat.id}}_count">{{ status_counts.active[cat.id]|default(0) }}</span>
							{{ cat.title }}
						</span>
					</li>
				{% endfor %}
			</ul>
		</li>
		<li data-route="listpane:{{ path('agent_ideas_status', {'status': 'closed'}) }}">
			<span class="title">
				<span class="list-counter" id="ideas_status_closed_0_count">{{ status_counts.closed[0]|default(0) }}</span>
				{{ phrase('agent.ideas.status_closed') }}
			</span>
			<ul class="sub-group indented-list">
				{% for cat in closed_status_cats %}
					<li class="indent" data-route="listpane:{{ path('agent_ideas_status', {'status': cat.id}) }}">
						<span class="title">
							<span class="list-counter" id="ideas_status_closed_{{cat.id}}_count">{{ status_counts.closed[cat.id]|default(0) }}</span>
							{{ cat.title }}
						</span>
					</li>
				{% endfor %}
			</ul>
		</li>
		<li data-route="listpane:{{ path('agent_ideas_status', {'status': 'hidden'}) }}">
			<span class="title">
				<span class="list-counter" id="ideas_status_hidden_hidden_count">{{ status_counts.hidden.hidden|default(0) }}</span>
				{{ phrase('agent.ideas.status_hidden') }}
			</span>
			<ul class="sub-group indented-list">
				<li class="indent" data-route="listpane:">
					<span class="title">
						<span class="list-counter" id="ideas_status_hidden_deleted_count">{{ status_counts.hidden.deleted|default(0) }}</span>
						{{ phrase('agent.ideas.status_deleted') }}
					</span>
				</li>
				<li class="indent" data-route="listpane:">
					<span class="title">
						<span class="list-counter" id="ideas_status_hidden_spam_count">{{ status_counts.hidden.spam|default(0) }}</span>
						{{ phrase('agent.ideas.status_spam') }}
					</span>
				</li>
			</ul>
		</li>
	</ul>
</section>
<section id="ideas_outline_category" class="deskpro-tab-item" data-tab-trigger="#ideas_outline_tabstrip li.categroies">
	<ul class="source-list">
		{% for cat in idea_cats %}
			<li
				data-route="listpane:{{ path('agent_ideas_category', {'category_id':cat.id}) }}"
				data-usergroup-ids="{{ ideas_cats_usergroups[cat.id]|default([])|join(',') }}"
			>
				<span class="title" {% if cat.depth %}style="padding-left: {{ (12 + (10 * cat.depth-1)) }}px"{% endif %}>
					<span class="list-counter" id="ideas_cat_{{cat.id}}_count">{{ category_counts[cat.id]|default(0) }}</span>
					{{ cat.title }}
				</span>
			</li>
		{% endfor %}
	</ul>
</section>
<section id="ideas_outline_labels" class="deskpro-tab-item" data-tab-trigger="#ideas_outline_tabstrip li.labels">
	<section class="source-labels-list">
		<dl>
			{% for letter,labels in ideas_tag_index %}
				<dt>{{ letter }}</dt>
				<dd>
					<ul>
						{% for label in labels %}
							<li><span data-route="listpane:{{ path('agent_ideas_label', {'label': label}) }}">{{label}}</span></li>
						{% endfor %}
					</ul>
				</dd>
			{% endfor %}
		</dl>
	</section>
</section>
