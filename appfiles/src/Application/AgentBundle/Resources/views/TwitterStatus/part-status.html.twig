{% for status in statuses %}
	<div class="status status-{{ status.id }}" data-status-id="{{ status.id }}" data-user-id="{{ status.user.id }}">
		<div class="avatar">
			<div class="photo" data-route="page:{{ path('agent_twitter_user', {'user_id': status.user.id}) }}">
				<img src="{{ status.user.profile_image_url }}" width="48" height="48" border="0" />
			</div>
			<div class="user-meta">
		{% if status.user.id is not sameas(account.user.id) %}
			{% if status.user.id in account.friend_ids %}
				<span class="unfollow"><a>Unfollow</a></span>
			{% else %}
				<span class="follow"><a>Follow</a></span>
			{% endif %}
		{% endif %}
			</div>
		</div>
		<div class="body">
			<div class="head">
				<span class="arrow-left"></span>
				<div class="user" data-route="page:{{ path('agent_twitter_user', {'user_id': status.user.id}) }}">
					<h4 class="screen_name">@{{ status.user.screen_name }}</h4>
					<span class="name">{{ status.user.name }}</span>
				</div>
			{% if status.in_reply_to_status %}
				<div class="reply">@{{ status.in_reply_to_status.user.screen_name }} "{{ status.in_reply_to_status.parsed_text|raw }}"</div>
			{% endif %}
			</div>
			<div class="text">
				<p>{{ status.parsed_text|raw }}</p>
			</div>
			<div class="meta">
				<span class="timestamp">
					<span class="timeago" title="{{ status.date_created|date('c') }}">{{ status.date_created|date('r') }}</span>
				</span>
				<span class="controls">
					<span class="archive"><a>{% if status.is_archived %}Archived{% else %}Archive{% endif %}</a></span>
					<span class="reply"><a>Reply</a></span>
				{% if status.isMessage is sameas(false) %}
					<span class="retweet"><a>Retweet</a></span>
				{% endif %}
					<span class="assign"><a>Assign</a></span>
					<span class="note"><a>Add Note</a></span>
				</span>
			</div>
		{% if status.notes.count %}
			<div class="notes">
			{% for note in status.notes %}
				<div class="note" data-note-id="{{ note.id }}">
					<span class="user">
						{{ note.person.name }}
					</span>
					<span class="timestamp">
						<span class="timeago" title="{{ note.date_created|date('c') }}">{{ note.date_created|date('r') }}</span>
					</span>
					<span class="text">
						{{ note.text }}
					</span>
				</div>
			{% endfor %}
			</div>
		{% endif %}
		</div>
	</div>
{% endfor %}