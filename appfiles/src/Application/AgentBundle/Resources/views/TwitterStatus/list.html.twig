<script>
pageMeta.fragmentClass = 'DeskPRO.Agent.PageFragment.ListPane.TwitterStatus';
pageMeta.title = '@{{ account.user.screen_name|escape }}';
pageMeta.accountId = '{{ account.id }}';
pageMeta.statusListUrl = '{{ path('agent_twitter_status_list', {'account_id': account.id}) }}?partial=1';
pageMeta.saveNoteUrl = '{{ path('agent_twitter_status_ajaxsave_note') }}';
pageMeta.saveRetweetUrl = '{{ path('agent_twitter_status_ajaxsave_retweet') }}';
pageMeta.saveReplyUrl = '{{ path('agent_twitter_status_ajaxsave_reply') }}';
pageMeta.saveArchiveUrl = '{{ path('agent_twitter_status_ajaxsave_archive') }}';
</script>

<style type="text/css" media="screen">
	.twitter-head {
		background-color: #F0EFE4;
		border-bottom: 1px solid #A6A594;
		padding: 4px;
	}

	.twitter-head .display-options {
		float: right;
		font-size: 10px;
	}

	.twitter-listing > ul > li {
		margin-bottom: 10px;
		background-color: #F7F9FA;
		clear: both;
	}

	.twitter-listing ul li .head {
		background-color: #DDE4EB;
		font-size: 10px;
		padding: 2px;
	}

	.twitter-listing ul li .head cite {

	}

	.twitter-listing ul li .head span.response {
		float: right;
	}

	.twitter-listing ul li .photo {
		float: left;
		width: 48px;
	}

	.twitter-listing ul li .photo img {
		width: 48px;
		height: 48px;
	}

	.twitter-listing ul li .content {
		margin-left: 55px;
	}

	.twitter-listing ul li .content .tweet {
		background-color: #fff;
		padding: 8px;
	}

	.twitter-listing ul li .content .notes {
		font-size: 10px;
		padding-left: 20px;
	}

	.twitter-listing ul li .content .note {

	}

	.twitter-listing ul li .content .note em {
		color: #838D96;
		padding-left: 5px;
	}

	.twitter-listing ul li .content .controls li {
		float: right;
		padding-right: 10px;
		font-size: 10px;
	}

	.twitter-note, .twitter-reply {
		display: none;
	}
</style>

<div class="twitter-note">
	<form>
		<textarea name="text" rows="2" cols="40"></textarea>
	</form>
</div>

<div class="twitter-reply">
	<form>
		<div class="type">
			<ul>
				<li>
					<input type="radio" id="twitter-reply-type-private" name="type" value="private" />
					<label for="twitter-reply-type-private">Private</label>
				</li>
				<li>
					<input type="radio" id="twitter-reply-type-public" name="type" value="public" checked="checked" />
					<label for="twitter-reply-type-public">Public</label>
				</li>
			</ul>
		</div>
		<div class="accounts">
			</ul>
			{% for person_account in person.twitter_accounts %}
				<li>
					<input type="radio" id="twitter-reply-account-{{ person_account.id }}" name="account" value="{{ person_account.id }}" {% if person_account.id == account.id %}checked="checked"{% endif %} />
					<label for="twitter-reply-account-{{ person_account.id }}">{{ person_account.user.screen_name }}</label>
				</li>
				{% endfor %}
			</ul>
		</div>
		<textarea name="text" rows="2" cols="40"></textarea>
	</form>
</div>

<div class="twitter-head">
	@{{ account.user.screen_name }} stream
	<div class="display-options">
		<div style="float:right">
			<select name="sortbydate">
				<option name="asc">Oldest First</option>
				<option name="desc">Newest First</option>
			</select>
		</div>
		<div style="margin-right:120px">
			<input name="account" type="checkbox" /> Show @{{ account.user.screen_name }}'s tweets<br />
			<input name="archived" type="checkbox" /> Show archived tweets
		</div>
	</div>
	<br style="clear:both" />
</div>

<div class="twitter-listing">
	{% include 'AgentBundle:TwitterStatus:part-status.html.twig' %}
</div>
