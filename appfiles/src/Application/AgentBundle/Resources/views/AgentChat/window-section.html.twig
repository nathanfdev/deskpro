<section class="source-section sys-filters-section">
	<header>
		<h1>{{ phrase('agent.chat.chat_history') }}</h1>
	</header>
	<ul class="source-list">
		{% for agent in agent_chatted %}
			<li>
				<h3 class="title" data-route="listpane:{{ path('agent_agentchat_history', {'agent_id': agent.id}) }}">
					{{ agent.display_name }}
				</h3>
			</li>
		{% endfor %}
	</ul>
</section>
