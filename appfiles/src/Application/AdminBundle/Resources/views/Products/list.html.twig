{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% import 'AdminBundle:Common:admin-macros.html.twig' as admin %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/ElementHandler/ProductList.js') }}"></script>
{% endblock %}
{% block pagebar %}
	<nav>
		<ul>
			<li class="add"><a id="newcat_open">Add New Product</a></li>
		</ul>
	</nav>
	<ul>
		<li>Products</li>
	</ul>
{% endblock %}
{% block content %}
<div class="dp-page-box">
<div
	class="page-content"
	data-element-handler="DeskPRO.Admin.ElementHandler.ProductList"
	data-order-url="{{ path('admin_products_updateorders') }}"
>

	{{ design.helpbox() }}
		<p>Products are a type of categorization that you can use across the entire helpdesk. Create a product, which
		is usually a real product or service your company offers, and use it categorize all kinds of content
		like tickets, ideas and articles.</p>
	{{ design.helpbox_end() }}

	{% if all_products|length %}
		{{ design.dpgrid({class: 'dep-list'}) }}
			{{ design.dpgrid_headerrow() }}
				{{ design.dpgrid_headercol({ class: 'l r tl tr', style: "width: 890px;"}) }}
					<h1>Product</h1>
				{{ design.dpgrid_headercol_end() }}
			{{ design.dpgrid_headerrow_end() }}

			{% for product in all_products %}
				{% include 'AdminBundle:Products:list-row.html.twig' %}
			{% endfor %}
		{{ design.dpgrid_end() }}
	{% else %}
		<div class="note-box">
			You have no created any products yet.
		</div>
	{% endif %}


	<div id="editcat_overlay" style="width: 400px; height: 180px; display: none;">
		<div class="overlay-title">
			<span class="close-overlay"></span>
			<h4>Edit Product Title</h4>
		</div>
		<div class="overlay-content">
			<form class="dp-form" method="POST" action="{{ path('admin_products_savetitle') }}">
				<div class="dp-form-row">
					<div class="dp-form-label">
						<label>Title</label>
					</div>
					<div class="dp-form-input">
						<input type="hidden" name="product_id" id="editcat_catid" value="" />
						<input type="text" name="title" id="editcat_title" value="" />
					</div>
				</div>
			</form>
		</div>
		<div class="overlay-footer">
			<button class="clean-white" id="editcat_savebtn">Save</button>
		</div>
	</div>

	<div id="newcat_overlay" style="width: 400px; height: 230px; display: none;">
		<div class="overlay-title">
			<span class="close-overlay"></span>
			<h4>New Product</h4>
		</div>
		<div class="overlay-content">
			<form class="dp-form" method="POST" action="{{ path('admin_products_savenew') }}">
				<div class="dp-form-row">
					<div class="dp-form-label">
						<label>Title</label>
					</div>
					<div class="dp-form-input">
						<input type="text" name="title" id="newcat_title" value="" />
					</div>
				</div>

				<div class="dp-form-row">
					<div class="dp-form-label">
						<label>Parent</label>
					</div>
					<div class="dp-form-input">
						<select name="parent_id" id="newcat_parent_id">
							<option value="0">No Parent</option>
							{% for product in all_products %}
								<option value="{{ product.id }}">{{ product.title }}</option>
							{% endfor %}
						</select>
					</div>
				</div>
			</form>
		</div>
		<div class="overlay-footer">
			<button class="clean-white" id="newcat_savebtn">Add</button>
		</div>
	</div>



</div>
</div>
{% endblock %}
