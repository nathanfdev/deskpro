{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% import 'AdminBundle:Common:admin-macros.html.twig' as admin %}
{% block section 'crm' %}
{% block sub_section 'usergroups' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/ProductsList.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
{% endblock %}
{% block prepage %}
	Products are a type of categorization that you can use across the entire helpdesk. Create a product, which
	is usually a real product or service your company offers, and use it categorize all kinds of content
	like tickets, ideas and articles.
{% endblock %}
{% block pagetitle %}
	<nav>
		<button class="clean-white ">Create New Product</button>
	</nav>
	Products
{% endblock %}
{% block content %}
<div class="dp-page-box">

<div class="page-content">
	{{ design.structure_table() }}
		{% for product in all_products %}
			{% include 'AdminBundle:Products:list-row.html.twig' %}
		{% endfor %}
	{{ design.structure_table_end() }}
</div>

</div>
{% endblock %}
