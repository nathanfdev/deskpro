{% extends 'AdminBundle::layout.html.twig' %}
{% block pagetitle %}
	<h1>{% if product.id %}Edit Product{% else %}New Product{% endif %}</h1>
	<nav>
		<a class="clean-white" href="{{ path('admin_products') }}">&larr; Back to products</a>
	</nav>
{% endblock %}
{% block page %}

<form action="{{ path('admin_products_edit', {'product_id': product.id|default(0)}) }}" method="post">
<input type="hidden" name="process" value="1" />

<div class="dp-form">
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Title</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.title) }}
		</div>
	</div>

	{% if form.parent %}
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>Parent Product</label>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.parent) }}
			</div>
		</div>
	{% endif %}
</div>

{{ form_rest(form) }}

<button class="btn primary save-trigger">Save</button>
</form>

<div class="delete-link-wrap">
	<a href="{{ path('admin_products_del', {'product_id': product.id}) }}">delete</a>
</div>
{% endblock %}
