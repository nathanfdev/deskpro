{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% if not depth %}
<tbody>
{% endif %}
	<tr data-item-id="{{ product.id }}" class="depth-{{ depth|default(0) }} product product-{{product.id}} {% if product.parent %}is-sub parent-{{ product.parent.id }}{% endif %} {% if product.children|length %}has-children{% endif %}" data-product-id="{{product.id}}">
		<td class="title">
			<a href="{{ path('admin_products_edit', {'product_id': product.id}) }}" class="popout-trigger" data-height="200" data-width="400">
				{{product.title}}
			</a>
		</td>
	</tr>
	{% if product.children|length %}
		{% for sub_prod in product.children %}
			{% include 'AdminBundle:Products:list-row.html.twig' with {'product': sub_prod, 'is_sub': true, 'depth': depth|default(0) + 1 } %}
		{% endfor %}
	{% endif %}
{% if not depth %}
</tbody>
{% endif %}
