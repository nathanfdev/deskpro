<li class="product product-{{product.id}}" data-product-id="{{product.id}}">
	<div class="drag-handle">ORDER</div>
	<div style="float:right">
		<ul class="controls">
			<li class="edit edit-trigger"><a href="{{ path('admin_products_edit', {'product_id': product.id}) }}" class="popout-trigger" data-height="200" data-width="400">edit</a></li>
			<li class="delete delete-trigger" data-product-id="{{product.id}}">delete</li>
		</ul>
	</div>
	<div>
		{% if not product.parent %}<strong>{{product.title}}</strong>
		{% else %}{{product.title}}
		{% endif %}
	</div>
</li>