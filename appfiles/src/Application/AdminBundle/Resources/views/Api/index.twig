{% extends 'AdminBundle::layout.twig' %}
{% block content %}

<div class="block" id="block-tables">
	<div class="content">
		<div style="float: right; padding: 5px 5px 0 0;">
			<a href="{{ path('admin_api_newkey') }}" class="button">
				<img src="{% asset 'images/icons/tick.png' %}" alt="New Style" /> Create New API Key
			</a>
		</div>
		<h2 class="title">API Keys</h2>
		<div class="inner">
			<form action="#" class="form">
				<table class="table">
					<tr>
						<th>Key</th>
						<th width="250">&nbsp;</th>
					</tr>
					{% for apikey in all_apikeys %}
					<tr class="even">
						<td>
							<input type="text" size="40" value="{{apikey.id}}" />
							{% if apikey.note %}<br />{{apikey.note}}{% endif %}
						</td>
						<td class="last">
							<a href="{{ path('admin_api_infokey', {'apikey': apikey.id}) }}">Info</a> &middot;
							<a href="{{ path('admin_api_editkey', {'apikey': apikey.id}) }}">Edit</a>
						</td>
					</tr>
					{% endfor %}
				</table>
			</form>
		</div>
	</div>
</div>

{% endblock %}
{% block sidebar %}
{% endblock %}