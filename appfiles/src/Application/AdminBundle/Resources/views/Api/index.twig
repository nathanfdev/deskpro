{% extends 'AdminBundle::layout.twig' %}
{% block section 'integrations' %}
{% block sub_section 'api' %}
{% block content %}

<div style="text-align: right">
	<a class="dp-button green" href="{{ path('admin_api_newkey') }}">Create API Key</a>
	<br /><br />
</div>

<ul class="item-list">
	{% for apikey in all_apikeys %}
		<li>
			<div style="float:right">
				<ul class="controls">
					<li class="edit"><a href="{{ path('admin_api_editkey', {'id': apikey.id}) }}">view/edit</a></li>
					<li class="delete"><a href="{{ path('admin_api_delkey', {'id': apikey.id}) }}" onclick="return confirm('Are you sure?');">delete</a></li>
				</ul>
			</div>
			<strong>{{apikey.person.display_name}}</strong>
			{% if apikey.note %}<p>{{apikey.note}}</p>{% endif %}

			<p>HTTP Basic Auth: <input type="text" class="flat" value="{{apikey.id}}:{{apikey.code}}" style="width: 200px;" /></p>
		</li>
	{% else %}
		You have created no API keys.
	{% endfor %}
</ul>

{% endblock %}