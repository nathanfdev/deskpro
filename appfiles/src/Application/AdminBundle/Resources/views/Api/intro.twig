{% extends 'AdminBundle::layout.twig' %}
{% block content %}

<div class="block"><div class="content">
	<h2>Introduction to the API</h2>
	<div class="inner">
		<p>
			The API allows other applications to get information or perform actions on the helpdesk.
			You authorize applications by generating a secret <em>API key</em> that the service
			must send with every request.
		</p>
	</div>
</div></div>

{% if has_no_apikeys %}
	<div class="block"><div class="content">
		<h2>Create an API Key</h2>
		<div class="inner">
			<p>
				You currently have no API keys. Before you are able to integrate your apps into your helpdesk,
				you'll need to create a new API key.
			</p>
			<form action="{% path 'admin_api_newkey' %}" method="get">
				<div class="group navform wat-cf">
					<button class="button" type="submit">
						<img src="{% asset 'images/icons/tick.png' %}" alt="Save" /> Create a new API Key
					</button>
				</div>
			</form>
		</div>
	</div></div>
{% endif %}


{% endblock %}
{% block sidebar %}
	<div class="block notice">
		<h4>Need Help?</h4>
		<p>
			Read the <a href="">help pages</a> regarding API keys for more information.
		</p>
	</div>
{% endblock %}