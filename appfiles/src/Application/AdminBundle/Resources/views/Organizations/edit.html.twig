{% extends 'AdminBundle::layout_popout.html.twig' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/GeneralEdit.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
	window.DeskPRO_Page = new DeskPRO.Admin.PageHandler.GeneralEdit('organization', {{organization.id|default(0)}});

	{% if row_html %}
		window.DeskPRO_Page.updateParentListRow({{ row_html|json_encode|raw }});
	{% endif %}
}
</script>
{% endblock %}
{% block header %}
	<h1>{% if organization.id %}Edit Organization{% else %}New Organization{% endif %}</h1>
{% endblock %}
{% block content %}

<form action="{{ path('admin_organizations_edit', {'organization_id': organization.id|default(0)}) }}" method="post">
<input type="hidden" name="process" value="1" />

<div class="form-panel">
	<div class="row">
		<label>Name</label>
		{{ form_widget(form.name) }}
	</div>
</div>

<br /><br />

{{ form_rest(form) }}
</form>
{% endblock %}
{% block footer %}
	<button class="dp-button small save-trigger">Save</button>

{% endblock %}