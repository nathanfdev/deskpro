			<input type="text" name="labels" />
		</div>
	</div>
	<div class="type" title="Set Flag" data-rule-type="flag">
		<div class="choice">
			<select name="flag">
				<option value="blue">Blue</option>
				<option value="green">Green</option>
				<option value="orange">Orange</option>
				<option value="pink">Pink</option>
				<option value="purple">Purple</option>
				<option value="red">Red</option>
				<option value="yellow">Yellow</option>
			</select>
		</div>
	</div>
	<div class="type" title="Increase/Decrease Urgency" data-rule-type="urgency">
		<div class="choice">
			<input type="text" name="num" /><small>(Enter a negative number to have urgency decreased)</small>
		</div>
	</div>
	<div class="type" title="Set Urgency" data-rule-type="urgency_set">
		<div class="choice">
			<input type="text" name="num" />
		</div>
	</div>
	<div class="type" title="Ticket Reply" data-rule-type="reply">
		<div class="choice" style="display:block">
			<textarea name="new_reply" cols="80" rows="4"></textarea>
		</div>
	</div>
	{% if ticket_options.custom_ticket_fields %}
		{% for field in ticket_options.custom_ticket_fields %}
			<div class="type" title="Set Ticket Field: {{field.field_def.title}}" data-rule-type="ticket_field[{{field.field_def.id}}]">
				<div class="choice">
					{{ form_widget(field.form) }}
				</div>
			</div>
