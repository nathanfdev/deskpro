	<div class="type" title="Set User Organization" data-rule-type="person_organization_id">
		<div class="choice">
			<select name="person_organization_id">
				{% for id,title in ticket_options.people_organizations %}
					<option value="{{id}}">{{title}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	{% if ticket_options.custom_people_fields %}
		{% for field in ticket_options.custom_people_fields %}
			<div class="type" title="Set User Field: {{field.field_def.title}}" data-rule-type="people_field[{{field.field_def.id}}]">
				<div class="choice">
					{{ form_widget(field.form) }}
				</div>
			</div>
		{% endfor %}
	{% endif %}
	{% if trigger.event_trigger == 'new_ticket' %}
		<div class="type" title="Send new ticket notification" data-rule-type="notification_new_ticket">
			<div class="choice">
				Send to: <select name="send_to[]" multiple="multiple" size="5">
					<optgroup label="Users">
						<option value="person">User</option>
						<option value="people_participants">User participants</option>
					</optgroup>
					<optgroup label="Agents">
						<option value="default_agents">Agents (default based on preferences)</option>
						<option value="assigned_agent">Assigned agent</option>
						<option value="assigned_agent_team">Assigned agent team members</option>
						<option value="agent_participants">Agent participants</option>
					</optgroup>
					<optgroup label="Specific Agents">
						{% for id,label in term_options.agents %}
							<option value="agent.{{id}}">{{label}}</option>
						{% endfor %}
					</optgroup>
					<optgroup label="Specific Agent Teams">
						{% for id,label in term_options.agent_teams %}
							<option value="agent_team.{{id}}">{{label}}</option>
						{% endfor %}
					</optgroup>
				</select>
				From: <select name="from_address[]">
					<option value="">Default</option>
					{% for id,title in from_names %}
						<option value="{{id}}">{{title}}</option>
					{% endfor %}
				</select>
			</div>
		</div>
	{% endif %}
	{% if trigger.event_trigger == 'new_reply' %}
		<div class="type" title="Send new reply notification" data-rule-type="notification_new_reply">
			<div class="choice">
				Send to: <select name="send_to[]" multiple="multiple" size="5">
					<optgroup label="Users">
						<option value="person">User</option>
						<option value="people_participants">User participants</option>
					</optgroup>
					<optgroup label="Agents">
						<option value="default_agents">Agents (default based on preferences)</option>
						<option value="assigned_agent">Assigned agent</option>
