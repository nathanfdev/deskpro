{% extends 'AdminBundle::layout_popout.html.twig' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/TicketTriggersEdit.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
	window.DeskPRO_Page = new DeskPRO.Admin.PageHandler.TicketTriggersEdit({{trigger.id|default(0)}});

	{% if row_html %}
		DeskPRO_Page.updateParentListRow({{ row_html|json_encode|raw }});
	{% endif %}

	window.DeskPRO_Page.init_options_callback = function() {
		var count = 0;
		{% for action in trigger.terms %}
			var basename = 'terms['+count+']';
			window.DeskPRO_Page.criteriaEditor.addNewRow($('.criteria-form .search-terms'), basename, { type: '{{action.type}}', op: '{{term.op}}', choice: {{action.options|json_encode|raw}} });
			count++;
		{% endfor %}

		var count = 0;
		{% for action in trigger.actions %}
			var basename = 'actions['+count+']';
			window.DeskPRO_Page.actionsEditor.addNewRow($('.actions-form .search-terms'), basename, { type: '{{action.type}}', options: {{action.options|json_encode|raw}} });
			count++;
		{% endfor %}
	};
}
</script>
{% endblock %}
{% block header %}
	{% if trigger.trigger_type == 'trigger' %}
		<h1>{% if trigger.id %}Edit Trigger{% else %}New Trigger{% endif %}</h1>
	{% else %}
		<h1>{% if trigger.id %}Edit Escalation{% else %}New Escalation{% endif %}</h1>
	{% endif %}
{% endblock %}
{% block content %}

<form action="{{ path('admin_tickettriggers_edit', {'trigger_id': trigger.id|default(0)}) }}" method="post">
<input type="hidden" name="process" value="1" />

<div class="form-panel">
	<div class="row">
		<label>Title</label>
		{{ form_widget(form.title) }}
	</div>
	{% if form.event_trigger_option %}
		<div class="row">
			<label>Minutes until trigger is executed</label>
			{{ form_widget(form.event_trigger_option) }}
		</div>
	{% endif %}
	<div class="row">
		<label>Criteria</label>
		<div class="criteria-form search-form">
			<div class="search-terms"></div>
			<div class="term"><span class="add-term">+</span> Add a new action</div>
		</div>
	</div>
	<div class="row">
		<label>Actions</label>
		<div class="actions-form search-form">
			<div class="search-terms"></div>
			<div class="term"><span class="add-term">+</span> Add a new action</div>
		</div>
	</div>
</div>

{{ form_rest(form) }}
</form>

<div class="criteria-tpl" style="display:none">
	<div class="row">
		<div class="term">
			<div class="type"></div>
			<div class="op"></div>
			<div class="choice"></div>
			<div class="remove">-</div>
		</div>
	</div>
	<div class="type" title="Originated interface" data-rule-type="creation_system">
		<div class="op">
			<select name="op">
				<option value="is">is</option>
				<option value="not">is not</option>
			</select>
		</div>
		<div class="choice">
			<select name="creation_system">
				<option value="web">Web interface</option>
				<option value="web.person">-- By user</option>
				<option value="web.agent">-- By agent on behalf of user</option>
				<option value="gateway">Email</option>
			</select>
		</div>
	</div>
	{% if term_options.gateway_names %}
	<div class="type" title="Receiving gateway account" data-rule-type="receiving_gateway">
		<div class="op">
			<select name="op">
				<option value="is">is</option>
				<option value="not">is not</option>
			</select>
		</div>
		<div class="choice">
			<select name="receiving_gateway">
				{% for id,label in term_options.gateway_names %}
					<option value="{{id}}">{{label}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	{% endif %}
	<div class="type" title="Subject" data-rule-type="subject">
		<div class="op">
			<select name="op">
				<option value="is">is</option>
				<option value="not">is not</option>
				<option value="contains">contains</option>
				<option value="not_contains">does not contain</option>
			</select>
		</div>
		<div class="choice">
			<input type="text" name="subject" value="" />
		</div>
	</div>
	<div class="type" title="Labels" data-rule-type="label">
		<div class="op">
			<select name="op">
				<option value="is">includes label</option>
				<option value="not">does not include label</option>
				{% if trigger.event_trigger == 'property_change' %}
					<option value="changed">Changed</option>
					<option value="changed_to">Changed to include</option>
					<option value="changed_from">Changed to remove</option>
				{% endif %}
			</select>
		</div>
		<div class="choice">
			<input type="text" name="label" value="" />
		</div>
	</div>
	<div class="type" title="Assigned Agent" data-rule-type="agent">
		<div class="op">
			<select name="op">
				<option value="is">is</option>
				<option value="not">is not</option>
				{% if trigger.event_trigger == 'property_change' %}
					<option value="changed">Changed</option>
					<option value="changed_to">Changed to</option>
					<option value="changed_from">Changed from</option>
					<option value="not_changed_to">Not changed to</option>
					<option value="not_changed_from">Not changed from</option>
				{% endif %}
			</select>
		</div>
		<div class="choice">
			<select name="agent">
				<option value="0">Unassigned</option>
				<option value="-1">Current Agent</option>
				{% for id,label in term_options.agents %}
					<option value="{{id}}">{{label}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	<div class="type" title="Participants" data-rule-type="participant">
		<div class="op">
			<select name="op">
				<option value="is">include</option>
				<option value="not">does not include</option>
				{% if trigger.event_trigger == 'property_change' %}
					<option value="changed">Changed</option>
					<option value="changed_to">Changed to include</option>
					<option value="changed_from">Changed to remove</option>
				{% endif %}
			</select>
		</div>
		<div class="choice">
			<select name="agent">
				<option value="-1">Current Agent</option>
				{% for id,label in term_options.agents %}
					<option value="{{id}}">{{label}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	{% if term_options.agent_teams %}
		<div class="type" title="Agent Team" data-rule-type="agent_team">
			<div class="choice">
				<div class="op">
					<select name="op">
						<option value="is">is</option>
						<option value="not">is not</option>
						{% if trigger.event_trigger == 'property_change' %}
							<option value="changed">Changed</option>
							<option value="changed_to">Changed to</option>
							<option value="changed_from">Changed from</option>
							<option value="not_changed_to">Not changed to</option>
							<option value="not_changed_from">Not changed from</option>
						{% endif %}
					</select>
				</div>
				<select name="agent_team">
					<option value="0">No team</option>
					<option value="-1">Any of current agents teams</option>
					{% for id,title in term_options.agent_teams %}
						<option value="{{id}}">{{title}}</option>
					{% endfor %}
				</select>
			</div>
		</div>
	{% endif %}
	<div class="type" title="Status" data-rule-type="status">
		<div class="op">
			<select name="op">
				<option value="is">is</option>
				<option value="not">is not</option>
				{% if trigger.event_trigger == 'property_change' %}
					<option value="changed">Changed</option>
					<option value="changed_to">Changed to</option>
					<option value="changed_from">Changed from</option>
					<option value="not_changed_to">Not changed to</option>
					<option value="not_changed_from">Not changed from</option>
				{% endif %}
			</select>
		</div>
		<div class="choice">
			<select name="status">
				<option value="open">Open</option>
				<option value="pending">Pending</option>
				<option value="resolved">Resolved</option>
				<option value="closed">Closed</option>
				<option value="hidden">Hidden (awaiting validating, spam)</option>
			</select>
		</div>
	</div>
	{% if term_options.products %}
		<div class="type" title="Product" data-rule-type="product">
			<div class="op">
				<select name="op">
					<option value="is">is</option>
					<option value="not">is not</option>
					{% if trigger.event_trigger == 'property_change' %}
						<option value="changed">Changed</option>
						<option value="changed_to">Changed to</option>
						<option value="changed_from">Changed from</option>
						<option value="not_changed_to">Not changed to</option>
						<option value="not_changed_from">Not changed from</option>
					{% endif %}
				</select>
			</div>
			<div class="choice">
				<select name="product">
					{% for id,label in term_options.products %}
						<option value="{{id}}">{{label}}</option>
					{% endfor %}
				</select>
			</div>
		</div>
	{% endif %}
	{% if term_options.departments %}
