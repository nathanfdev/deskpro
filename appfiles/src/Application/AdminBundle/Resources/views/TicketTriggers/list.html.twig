{% extends 'AdminBundle::layout.html.twig' %}
{% set page_handler = 'DeskPRO.Admin.ElementHandler.TicketTriggersPage' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/ElementHandler/TicketTriggersPage.js') }}"></script>
{% endblock %}
{% block pagetitle %}
	<h1>Triggers and Escalations</h1>
	<nav>
		<a class="clean-white" href="{{ path('admin_tickettriggers_new_choosetype') }}">Create New Trigger</a>
	</nav>
{% endblock %}
{% block page %}

{% macro trigger_row(trigger) %}
	<li class="item-row">
		<div class="dp-block-controls">
			<ul>
				<li class="dp-edit">
					<a href="{{ path('admin_tickettriggers_edit', {'trigger_id': trigger.id}) }}" class="popout-trigger"><span></span></a>
				</li>
			</ul>
		</div>
		<lable>{{ trigger.title }}</lable>
	</li>
{% endmacro %}

<h2>New Ticket Triggers</h2>
<ul class="item-list">
	<li class="trigger-val" data-trigger-name="urgency.base">
		Set the default urgency on new tickets to <input type="text" name="base_urgency" value="{{ sys_triggers['urgency.base'].actions[0][options][num]|default('0') }}" class="small" style="width: 40px" />
		<span class="loading-icon-small-inline" style="position: relative; top: 5px; display: none;"></span>
	</li>
	{% for trigger in triggers.new_ticket %}
		{{ _self.trigger_row(trigger) }}
	{% endfor %}
</ul>
<br />

{% if triggers.new_reply %}
<h2>New Repy Triggers</h2>
<ul class="item-list">
	<li class="trigger-val">
	{% for trigger in triggers.new_reply %}
		{{ _self.trigger_row(trigger) }}
	{% endfor %}
</ul>
<br />
{% endif %}

{% if triggers.new_reply %}
<h2>Ticket Update Triggers</h2>
<ul class="item-list">
	<li class="trigger-val">
	{% for trigger in triggers.property_change %}
		{{ _self.trigger_row(trigger) }}
	{% endfor %}
</ul>
<br />
{% endif %}

{% if triggers.time_open %}
<h2>Escalations based on the time a ticket has been open</h2>
<ul class="item-list">
	{% for trigger in triggers.time_open %}
		{{ _self.trigger_row(trigger) }}
	{% endfor %}
</ul>
<br />
{% endif %}


<h2>Escalations based on the time a user has been waiting for a reply</h2>
<ul class="item-list">
	<li class="trigger-val" data-trigger-name="auto_close.resolve_user_reply">
		Resolve a ticket when the agent has not replied for
		<input type="text" name="time" value="{{ sys_triggers['auto_close.resolve_user_reply'].getOptionTime()|default('0') }}" class="small" style="width: 40px" />
		<select name="scale">
			{% for scale,label in {'hours': 'Hours', 'days': 'Days', 'weeks': 'Weeks', 'months': 'Months'} %}
				<option value="{{ scale }}" {% if sys_triggers['auto_close.resolve_user_reply'].getOptionScale() == scale %}selected="selected"{% endif %}>{{ label }}</option>
			{% endfor %}
		</select>
		<span class="loading-icon-small-inline" style="position: relative; top: 5px; display: none;"></span>
	</li>
	{% for trigger in triggers.time_user_waiting %}
		{{ _self.trigger_row(trigger) }}
	{% endfor %}
</ul>
<br />

{% if triggers.time_total_user_waiting %}
<h2>Escalations based on the total time a user has been waiting in a ticket</h2>
<ul class="item-list">
	{% for trigger in triggers.time_total_user_waiting %}
		{{ _self.trigger_row(trigger) }}
	{% endfor %}
</ul>
<br />
{% endif %}

<h2>Escalations based on the total time an agent has been waiting for a user reply</h2>
<ul class="item-list">
	<li class="trigger-val" data-trigger-name="auto_close.resolve_agent_reply">
		Resolve a ticket when the user has not replied for
		<input type="text" name="time" value="{{ sys_triggers['auto_close.resolve_agent_reply'].getOptionTime()|default('0') }}" class="small" style="width: 40px" />
		<select name="scale">
			{% for scale,label in {'hours': 'Hours', 'days': 'Days', 'weeks': 'Weeks', 'months': 'Months'} %}
				<option value="{{ scale }}" {% if sys_triggers['auto_close.resolve_agent_reply'].getOptionScale() == scale %}selected="selected"{% endif %}>{{ label }}</option>
			{% endfor %}
		</select>
		<span class="loading-icon-small-inline" style="position: relative; top: 5px; display: none;"></span>
	</li>
	{% for trigger in triggers.time_agent_waiting %}
		{{ _self.trigger_row(trigger) }}
	{% endfor %}
</ul>
<br />

<h2>Escalations based on the time a ticket was resolved</h2>
<ul class="item-list">
	<li class="trigger-val" data-trigger-name="auto_close.close_resolved">
		Close a ticket when it has been resolved for
		<input type="text" name="time" value="{{ sys_triggers['auto_close.close_resolved'].getOptionTime()|default('0') }}" class="small" style="width: 40px" />
		<select name="scale">
			{% for scale,label in {'hours': 'Hours', 'days': 'Days', 'weeks': 'Weeks', 'months': 'Months'} %}
				<option value="{{ scale }}" {% if sys_triggers['auto_close.close_resolved'].getOptionScale() == scale %}selected="selected"{% endif %}>{{ label }}</option>
			{% endfor %}
		</select>
		<span class="loading-icon-small-inline" style="position: relative; top: 5px; display: none;"></span>
	</li>
	{% for trigger in triggers.time_agent_waiting %}
		{{ _self.trigger_row(trigger) }}
	{% endfor %}
</ul>

{% endblock %}
