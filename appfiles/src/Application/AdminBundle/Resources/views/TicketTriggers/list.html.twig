{% extends 'AdminBundle::layout.html.twig' %}
{% block section 'tickets' %}
{% block sub_section 'priorities' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/GeneralList.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
	window.DeskPRO_Page = new DeskPRO.Admin.PageHandler.GeneralList();
}
</script>
{% endblock %}
{% block content %}

<div class="table-list-wrap">
	<a class="icon tickets create-link popout-trigger" href="{{ path('admin_tickettriggers_new_choosetype') }}">Create Trigger</a>
	<h2>Triggers</h2>
	<table class="table-list" cellspacing="0" cellpadding="0" width="100%">
		<tbody id="teams_rows">
			{% for trigger in all_triggers %}
				{% include 'AdminBundle:TicketTriggers:list-row.html.twig' %}
			{% endfor %}
		</tbody>
	</table>
</div>

<br />

<div class="table-list-wrap">
	<a class="icon tickets create-link popout-trigger" href="{{ path('admin_ticketescalations_new_choosetype') }}">Create Escalation</a>
	<h2>Escalations</h2>
	<table class="table-list" cellspacing="0" cellpadding="0" width="100%">
		<tbody id="teams_rows">
			{% for trigger in all_escalations %}
				{% include 'AdminBundle:TicketTriggers:list-row.html.twig' %}
			{% endfor %}
		</tbody>
	</table>
</div>

<br />

{{urgency_page|raw}}

<br />

{{autoclose_page|raw}}

{% endblock %}