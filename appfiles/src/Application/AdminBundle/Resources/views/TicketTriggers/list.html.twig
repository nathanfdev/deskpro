{% extends 'AdminBundle::layout.html.twig' %}
{% set page_handler = 'DeskPRO.Admin.ElementHandler.TicketTriggersPage' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/ElementHandler/TicketTriggersPage.js') }}"></script>
{% endblock %}
{% block pagetitle %}
	<h1>Triggers and Escalations</h1>
	<nav>
		<a class="clean-white" href="{{ path('admin_tickettriggers_new_choosetype') }}">Create Trigger</a>
		<a class="clean-white" href="{{ path('admin_ticketescalations_new_choosetype') }}">Create Escalation</a>
	</nav>
{% endblock %}
{% block sidebar_right %}
<form action="{{ path('admin_ticketurgency_saveoptions') }}" method="post" id="urgency_options_form">
	<div class="dp-page-box" id="urgency_triggers">
		<div class="resource-item-list section-items">
			<header>
				<div class="controls">
					<button class="clean-white small save-trigger" style="display: none">Save Changes</button>
				</div>
				<h4>Urgency</h4>
			</header>
			<article>
				<ul>
					<li>
						Base urgency score of {{ form_widget(urgency_options_form.base_urgency, {'attr': {'class': 'single-num'}}) }}
					</li>
					<li>
						When the last user reply was
						{{ form_widget(urgency_options_form.time_options.user_reply, {'attr': {'class': 'single-num'}}) }}
						minutes ago, boost urgency by
						{{ form_widget(urgency_options_form.time_options.user_reply_num, {'attr': {'class': 'single-num'}}) }}
					</li>
					<li>
						When the ticket has been open for
						{{ form_widget(urgency_options_form.time_options.open, {'attr': {'class': 'single-num'}}) }}
						minutes, boost urgency by
						{{ form_widget(urgency_options_form.time_options.open_num, {'attr': {'class': 'single-num'}}) }}
					</li>
					<li>
						When the total user waiting time is more than
						{{ form_widget(urgency_options_form.time_options.user_waiting, {'attr': {'class': 'single-num'}}) }}
						minutes, boost urgency by
						{{ form_widget(urgency_options_form.time_options.user_waiting_num, {'attr': {'class': 'single-num'}}) }}
					</li>
				</ul>
			</article>
		</div>
	</div>
</form>

<form action="{{ path('admin_ticketautoclose_saveoptions') }}" method="post" id="autoclose_options_form">
	<div class="dp-page-box">
		<div class="resource-item-list section-items">
			<header>
				<div class="controls">
					<button class="clean-white small save-trigger" style="display: none">Save Changes</button>
				</div>
				<h4>Auto-Closing</h4>
			</header>
			<article>
				<ul>
					<li>
						Resolve a ticket with no activity after
						{{ form_widget(autoclose_options_form.resolve_agent_reply, {'attr': {'class': 'single-num'}}) }} minutes
						and an agent was last to reply
					</li>
					<li>
						Close a ticket with no activity after
						{{ form_widget(autoclose_options_form.close_agent_reply, {'attr': {'class': 'single-num'}}) }} minutes
						and an agent was last to reply
					</li>
					<li>
						Resolve a ticket with no activity after
						{{ form_widget(autoclose_options_form.resolve_user_reply, {'attr': {'class': 'single-num'}}) }} minutes
						and the user was last to reply
					</li>
					<li>
						Close a ticket with no activity after
						{{ form_widget(autoclose_options_form.close_user_reply, {'attr': {'class': 'single-num'}}) }} minutes
						and the user was last to reply
					</li>
				</ul>
			</article>
		</div>
	</div>
</form>
{% endblock %}
{% block page %}

{% if not all_triggers|length and not all_escalations|length %}
	You have not defined any triggers or escalations yet.
{% endif %}

{% if all_triggers|length %}
<h2>Triggers</h2>
<ul class="item-list">
	{% for trigger in all_triggers %}
		<li class="item-row">
			<div class="dp-block-controls">
				<ul>
					<li class="dp-edit">
						<a href="{{ path('admin_tickettriggers_edit', {'trigger_id': trigger.id}) }}" class="popout-trigger"><span></span></a>
					</li>
				</ul>
			</div>
			<lable>{{trigger.title}}</lable>
		</li>
	{% endfor %}
</ul>

<br />
{% endif %}

{% if all_escalations|length %}
<h2>Escalations</h2>
<ul class="item-list">
	{% for trigger in all_escalations %}
		<li class="item-row">
			<div class="dp-block-controls">
				<ul>
					<li class="dp-edit">
						<a href="{{ path('admin_tickettriggers_edit', {'trigger_id': trigger.id}) }}" class="popout-trigger"><span></span></a>
					</li>
				</ul>
			</div>
			<lable>{{trigger.title}}</lable>
		</li>
	{% endfor %}
</ul>
{% endif %}

{% endblock %}
