<!DOCTYPE HTML>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="robots" content="NOINDEX" />
	<meta http-equiv="X-UA-Compatible" content="IE=100" />

    <link rel="stylesheet" href="{{ asset('vendor/jquery/jquery-ui/css/smoothness/jquery-ui.css') }}" type="text/css" media="screen"  />
    <link rel="stylesheet" href="{{ asset('javascripts/DeskPRO/UI/ui.css') }}" type="text/css" media="screen" />
    <link rel="stylesheet" href="{{ asset('vendor/jquery/tipped/css/tipped.css') }}" type="text/css" media="screen" />
    <link rel="stylesheet" href="{{ asset('vendor/jquery/colorbox/colorbox.css') }}" type="text/css" media="screen" />
    <link rel="stylesheet" href="{{ asset('vendor/jquery/jcrop/css/jquery.Jcrop.css') }}" type="text/css" media="screen" />
    <link rel="stylesheet" href="{{ asset('vendor/jquery/chosen/chosen.css') }}" type="text/css" media="screen" />
    <link rel="stylesheet" href="{{ asset('vendor/jquery/jquery-checkbox/jquery.checkbox.css') }}" type="text/css" media="screen" />

    <link rel="stylesheet" href="{{ asset('vendor/jquery/markitup/markitup/skins/simple/style.css') }}" type="text/css" media="screen" />
    <link rel="stylesheet" href="{{ asset('vendor/jquery/markitup/markitup/sets/markdown/style.css') }}" type="text/css" media="screen" />

    <link rel="stylesheet" href="{{ asset('stylesheets/agent/dp-interface.css') }}" type="text/css" media="screen" />
    <link rel="stylesheet" href="{{ asset('stylesheets/agent/dp-source-pane.css') }}" type="text/css" media="screen" />
    <link rel="stylesheet" href="{{ asset('stylesheets/agent/dp-list-pane.css') }}" type="text/css" media="screen" />
    <link rel="stylesheet" href="{{ asset('stylesheets/agent/dp-content-pane.css') }}" type="text/css" media="screen" />
    <link rel="stylesheet" href="{{ asset('stylesheets/agent/dp-agent-chat.css') }}" type="text/css" media="screen" />
    <link rel="stylesheet" href="{{ asset('stylesheets/agent/navigation.css') }}" type="text/css" media="screen" />
    <link rel="stylesheet" href="{{ asset('stylesheets/agent/header.css') }}" type="text/css" media="screen" />
    <link rel="stylesheet" href="{{ asset('stylesheets/admin/main.css') }}" type="text/css" media="screen" />

    {# Bridge tries to auto-load these, but with the compiled scripts
    the detected path is incorrect so we have to hard-code them #}
    <script type="text/javascript">
    var Bridge = { options: { path: '{{ asset('vendor/jquery/tipped/js/bridge/') }}' } },
        Tipped = { options: { path: '{{ asset('vendor/jquery/tipped/js/tipped/') }}' } };
    </script>

    {{ html_js_pack('agent.vendors') }}
    {{ html_js_pack('agent.common') }}
    {{ html_js_pack('agent.deskpro-ui') }}
    {{ html_js_pack('admin.admin-ui') }}
    {{ html_js_pack('admin.admin-handlers') }}

    <script type="text/javascript" charset="utf-8">
		var DP_TINYMCE_URL = '{{ asset('javascripts/tiny_mce/tiny_mce.js') }}';
		var BASE_URL = '{{ path('user') }}';
		var ASSETS_BASE_URL = '{{ asset('') }}';
		if (!window.DESKPRO_URL_REGISTRY) window.DESKPRO_URL_REGISTRY = {};

		window._page_exec_stack = [];
		function _win_exec() {
			window.DeskPRO_Window = new DeskPRO.Admin.Window();
			window.DeskPRO_Window.initPage();

			if (window._page_exec) {
				window._page_exec_stack.push(_page_exec);
			}

			for (var i = 0; i < window._page_exec_stack.length; i++) {
				window._page_exec_stack[i]();
			}

			if (window.DeskPRO_Page) {
				DeskPRO_Page.initPage();
			}

			// Init all others too
			var re = /^DeskPRO_Page_/;
			for (i in window) {
				if (re.test(i)) {
					window[i].initPage();
				}
			}

			$('.admin-footer .licensed-to').click(function() {
				$('#license_info').fadeIn();
			});

			$('#license_info .close').click(function() {
				$('#license_info').fadeOut();
			});
		}

		{% block html_headjs_load %}{% endblock %}

		$(document).ready(function() {
			_win_exec();
		});
	</script>
	{% block html_head %}{% endblock %}
	{% block page_js_exec %}{% endblock %}
</head>
<body class="{% if is_demo %}is-demo{% endif %}">

<!-- BEGIN HEADER BAR -->
<div id="dp_header">

	<div id="dp_header_logo">
		<h1>Admin</h1>
	</div>
	<!-- BEGIN SEARCH SECTION -->
	<div id="dp_omnibox_wrap">
		<div id="dp_omnibox">
			<div class="searchBoxWrap">
				<input id="dpsearchbox" type="text" value="" name="search" autocomplete="off" />
			</div>
		</div>
	</div>
	<!-- END SEARCH SECTION -->

	<!-- BEGIN USER SECTION -->
	<div id="DP-UserSection">
		<div id="DP-userControl">
			<div class="currentUserAvatar">
				<div class="userWrapper">
					<a onclick="toggle_visibility('userSetting');"><img src="{{ app.user.getPictureUrl(20) }}" alt="" /></a>
				</div>
				<span class="dropdownIcon" onclick="toggle_visibility('userSetting');"></span>
			</div>
		</div>
		<!-- Header - User Control Dropdown -->
		<div id="userSetting" style="display:none;">
			<div class="userProfileDropdown" >
				<div class="userProfileDropdownHeader">
					<a onclick="toggle_visibility('userSetting');"><img src="{{ app.user.getPictureUrl(20) }}" alt="" /></a>
				</div>
				<ul>
					<li class="logggedAs"><p>Logged in as</p></li>
					<li class="currentUsername"><p>{{ app.user.display_name }}</p></li>
					<li class="setting" id="user_settings_link"><a>Settings</a></li>
					<li class="help"><a>Help</a></li>
					<li class="logout"><a href="{{ path('agent_logout') }}">Log out</a></li>
				</ul>
			</div>
		</div>
	<!-- END USER SECTION -->
	</div>

	<!-- BEGIN INTERFACE SECTION -->
	<div id="DP-InterfaceSwitcher">
		<div class="DP-adminSwitch">
			<div class="adminSwitcher">
				<a>Admin Interface<span class="dropdownIcon"></span></a>
			</div>
		</div>
		<!-- Header - Switch Button Interfaces- Dropdown -->
		<div id="interfacesToggle" style="display:none;">
		<div class="dropdownSwitcherWrap">
			<div class="switcherHeader">
				<a><span>Admin Interface</span></a>
			</div>
			<ul>
				<li><a class="admin" href="{{ path('agent') }}"><span class="check">Agent Interface</span></a></li>
				<li><a class="billing" href=""><span class="check">Billing Interface</span></a></li>
				<li><a class="report" href=""><span class="check">Report Interface</span></a></li>
				<li><a class="portal" href="{{ path('user') }}"><span class="check">User Interface</span></a></li>
			</ul>
		</div>
		</div>
	</div>
	<!-- END INTERFACE SECTION -->
</div>
<!-- /BEGIN HEADER BAR -->

<!-- BEGIN NAV BAR -->
<div id="dp_admin_nav">
	<div id="dp_admin_nav_sections" class="deskproPane">
		<ul>
			<li data-menu="#setup_menu">
				<a><span class="ticketNavIcon">Setup</span></a>
			</li>
			<li data-menu="#server_menu">
				<a><span class="ticketNavIcon">Server</span></a>
			</li>
			<li data-menu="#agents_menu">
				<a><span class="peopleNavIcon">Agents</span></a>
			</li>
			<li data-menu="#users_menu">
				<a><span class="peopleNavIcon">Users</span></a>
			</li>
			<li data-menu="#integrate_menu">
				<a><span class="ticketNavIcon integrate">Integrate</span></a>
			</li>
			<li data-menu="#tickets_menu">
				<a><span class="ticketNavIcon">Tickets</span></a>
			</li>
			<li data-menu="#chat_menu">
				<a><span class="chatNavIcon">Chat</span></a>
			</li>
			<li data-menu="#publish_menu">
				<a><span class="publishNavIcon">Publish</span></a>
			</li>
		</ul>
	</div>
</div>
<!-- /BEGIN NAV BAR -->
<div id="dp_page_wrap">

{% set pagetitle %}{% block pagetitle %}{% endblock %}{% endset %}
{% if pagetitle|trim|length %}
	<div id="dp_admin_pagetitle"><h1>{{ pagetitle|raw }}</h1></div>
{% endif %}

{% set prepage %}{% block prepage %}{% endblock %}{% endset %}
{% if prepage|trim|length %}
	<div id="dp_admin_prepage" class="admin-help-header">{{ prepage|raw }}</div>
{% endif %}

<div id="dp_admin_page">{% block content %}{% endblock %}</div>

{% include 'AdminBundle:Main:layout-menus.html.twig' %}

</div>
</body>
</html>
