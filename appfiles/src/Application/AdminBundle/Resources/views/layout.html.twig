{% if not section %}{% set section %}{% block section %}{% endblock %}{% endset %}{% endif %}
{% if not sub_section %}{% set sub_section %}{% block sub_section %}{% endblock %}{% endset %}{% endif %}
{% if not section %}{% set section = 'setup' %}{% endif %}
{% if not sub_section %}{% set sub_section = 'settings' %}{% endif %}
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>DeskPRO</title>
	<link rel="stylesheet" href="{{ asset('javascripts/jquery/jquery-ui/css/ui-lightness/jquery-ui.css') }}" type="text/css" media="screen"  />
	<link rel="stylesheet" href="{{ asset('javascripts/DeskPRO/UI/ui.css') }}" type="text/css" media="screen" />
	<link rel="stylesheet" href="{{ asset('javascripts/jquery/tipTip/tipTip.css') }}" type="text/css" media="screen"  />
	<link rel="stylesheet" href="{{ asset('javascripts/jquery/tipped/css/tipped.css') }}" type="text/css" media="screen" />

	<link rel="stylesheet" href="{{ asset('stylesheets/agent/common.css') }}" type="text/css" media="screen" />
	<link rel="stylesheet" href="{{ asset('stylesheets/agent/main.css') }}" type="text/css" media="screen" />
	{#
	<link rel="stylesheet" href="{{ asset('stylesheets/agent/ui-layout.css') }}" type="text/css" media="screen" />
	<link rel="stylesheet" href="{{ asset('stylesheets/agent/window-elements.css') }}" type="text/css" media="screen" />
	#}

	<script src="https://ajax.googleapis.com/ajax/libs/jquery/1.5.1/jquery.min.js"></script>
	<script type="text/javascript" src="http://ajax.microsoft.com/ajax/jquery.templates/beta1/jquery.tmpl.min.js"></script>
	<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.8.10/jquery-ui.min.js"></script>
	<script type="text/javascript" src="{{ asset('javascripts/jquery/jquery.cookie.js') }}"></script>
	<script type="text/javascript" src="{{ asset('javascripts/jquery/jquery.layout.min.js') }}"></script>
	<script type="text/javascript" src="{{ asset('javascripts/jquery/tipTip/jquery.tipTip.min.js') }}"></script>
	<script type="text/javascript" src="{{ asset('javascripts/jquery/tag-it/tag-it.js') }}"></script>
	<script type="text/javascript" src="{{ asset('javascripts/jquery/tipped/js/bridge/bridge.js') }}"></script>
	<script type="text/javascript" src="{{ asset('javascripts/jquery/tipped/js/bridge/adapters/jquery.js') }}"></script>
	<!--[if lt IE 9]><script type="text/javascript" src="{{ asset('javascripts/jquery/tipped/js/excanvas/excanvas.js') }}"></script><![endif]-->
	<script type="text/javascript" src="{{ asset('javascripts/jquery/tipped/js/spinners/spinners.js') }}"></script>
	<script type="text/javascript" src="{{ asset('javascripts/jquery/tipped/js/tipped/tipped.js') }}"></script>
	<script type="text/javascript" src="{{ asset('javascripts/jquery/jquery.sizes.min.js') }}"></script>
	<script type="text/javascript" src="{{ asset('javascripts/jquery/jquery.mousewheel.js') }}"></script>
	<script type="text/javascript" src="{{ asset('javascripts/mootools/mootools-core.min.js') }}"></script>

	<script type="text/javascript" src="{{ asset('javascripts/Orb/Orb.js') }}"></script>
	<script type="text/javascript" src="{{ asset('javascripts/Orb/Compat.js') }}"></script>

	<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/UI/Overlay.js') }}"></script>
	<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/UI/Menu.js') }}"></script>

	<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Form/InlineEdit.js') }}"></script>
	<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Form/RuleBuilder.js') }}"></script>

	<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/MessageBroker.js') }}"></script>

	<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Agent/InterfaceEffects.js') }}"></script>
	<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/Window.js') }}"></script>
	<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/Basic.js') }}"></script>

	<script type="text/javascript" charset="utf-8">
		var DP_TINYMCE_URL = '{{ asset('javascripts/tiny_mce/tiny_mce.js') }}';
		var BASE_URL = '{{ path('user') }}';
		var ASSETS_BASE_URL = '{{ asset('') }}';
		if (!window.DESKPRO_URL_REGISTRY) window.DESKPRO_URL_REGISTRY = {};

		function _win_exec() {
			window.DeskPRO_Window = new DeskPRO.Admin.Window();

			if (window._page_exec) {
				_page_exec();
			}

			if (window.DeskPRO_Page) {
				DeskPRO_Page.initPage();
			}
		}

		{% block html_headjs_load %}{% endblock %}

		$(document).ready(function() {
			_win_exec();
		});
	</script>
	{% block html_head %}{% endblock %}
	{% block page_js_exec %}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">

<div id="header">
	<div id="header-top">
		<div class="wrapper">
			<div class="left box-header">
				<a href="index.html#" title="" class="logo">DeskPRO</a>
			</div>

			<div class="left box-header select">
				<form id="search-form" action="index.html#" method="post">
					<input type="text" name="search" Value="Search" />
				</form>
			</div>

			<div class="left box-header  notifications">
				<ul>
					<li><span class="icn-bar tickets"></span><div class="counter"><span class="counter">12</span></div></li>
					<li><span class="icn-bar chat"></span><div class="counter"><span class="counter">2</span></div></li>
				</ul>
				<span class="white-drop"></span>
			</div>

			<div class="right box-header current-user">
				<div class="wrapper-top-bar">
					<div class="current-user-avatar">

					</div>
					<div class="current-user-name">
						<span>{{person.display_name}}</span>
					</div>
					<span class="white-drop"></span>

				</div>
			</div>

			<div class="right box-header actions">
				<div class="wrapper-top-bar">
					<ul>
						<li class="help"><a href="index.html" title="Help">Help</a></li>
						<li class="multi"><a href="index.html" title="Multilingual">Multilingual</a></li>
						<li class="keyboard"><a href="index.html" title="Toggle keyboard shortcuts">Keyboard</a></li>
						<li class="network active"><a href="index.html" title="Network status">Network</a></li>
						<li class="sound"><a href="index.html" title="Toggle sound notifications">Sound</a></li>
					</ul>
				</div>
			</div>

			<div class="right box-header admin-actions">
				<div class="wrapper-top-bar">
					<ul>
						<li class="admin"><a href="{{ path('agent') }}" title="Go to agent interface">Agent</a></li>
						<li class="billing"><a href="index.html" title="">Billing</a></li>
						<li class="reports"><a href="index.html" title="">Reports</a></li>
					</ul>
				</div>
			</div>

		</div>
	</div>

	<div id="header-bottom">
		<div class="wrapper">


			<div class="left box-header-bot nav">
				<div class="wrapper-top-bar">
					<ul>
						<li class="tickets-nav"><a href="index.html" title="">Tickets</a></li>
						<li class="chats-nav"><a href="index.html" title="">Chats</a></li>
						<li class="twitter-nav"><a href="index.html" title="">Twitter</a></li>
						<li class="facebook-nav"><a href="index.html" title="">Facebook</a></li>
						<li class="calls-nav"><a href="index.html" title="">Calls</a></li>
						<li class="users-nav"><a href="index.html" title="">Users</a></li>
						<li class="deals-nav"><a href="index.html" title="">Deals</a></li>
						<li class="calendar-nav"><a href="index.html" title="">Calendar</a></li>
						<li class="tasks-nav"><a href="index.html" title="">Tasks</a></li>
						<li class="publish-nav"><a href="index.html" title="">Publish</a></li>
						<li class="ideas-nav"><a href="index.html" title="">Ideas</a></li>
					</ul>
				</div>
			</div>

		</div>
	</div>
</div>

<div style="padding: 15px;">
	<table cellspacing="0" cellpadding="0" width="100%" id="pane_shell" class="{% if not nav %}no-nav{% endif %}">
		<tr>
			<td id="pane_content"><div id="content_wrap">{% block content %}{% endblock %}</div></td>
		</tr>
	</table>
</div>

</body>
</html>