<!DOCTYPE HTML>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="robots" content="NOINDEX" />
	<meta http-equiv="X-UA-Compatible" content="IE=100" />

	{{ dp_asset_html('agent_vendors_css') }}
	{{ dp_asset_html('agent_deskpro_ui_css') }}
	{{ dp_asset_html('agent_interface_css') }}
	{{ dp_asset_html('admin_interface_css') }}

	{{ dp_asset_html('agent_vendors') }}
	{{ dp_asset_html('agent_common') }}
	{{ dp_asset_html('agent_deskpro_ui') }}
    {{ dp_asset_html('admin_admin_ui') }}
    {{ dp_asset_html('admin_admin_handlers') }}

    <script type="text/javascript" charset="utf-8">
		var DP_TINYMCE_URL = '{{ asset('javascripts/tiny_mce/tiny_mce.js') }}';
		var BASE_URL = '{{ path('user') }}';
		var ASSETS_BASE_URL = '{{ asset('') }}';
		if (!window.DESKPRO_URL_REGISTRY) window.DESKPRO_URL_REGISTRY = {};

		window._page_exec_stack = [];
		function _win_exec() {
			window.DeskPRO_Window = new DeskPRO.Admin.Window();
			window.DeskPRO_Window.initPage();

			if (window._page_exec) {
				window._page_exec_stack.push(_page_exec);
			}

			for (var i = 0; i < window._page_exec_stack.length; i++) {
				window._page_exec_stack[i]();
			}

			if (window.DeskPRO_Page) {
				DeskPRO_Page.initPage();
			}

			// Init all others too
			var re = /^DeskPRO_Page_/;
			for (i in window) {
				if (re.test(i)) {
					window[i].initPage();
				}
			}
		}

		{% block html_headjs_load %}{% endblock %}

		$(document).ready(function() {
			_win_exec();
		});
	</script>
	{% block html_head %}{% endblock %}
	{% block page_js_exec %}{% endblock %}

	<script type="text/javascript" src="{{ asset('vendor/less/less.min.js') }}"></script>
</head>
<body class="{% if is_demo %}is-demo{% endif %}">

<!-- BEGIN HEADER BAR -->
<div id="dp_header">

	<div id="dp_header_logo">
		<h1>Admin</h1>
	</div>
	<!-- BEGIN SEARCH SECTION -->
	<div id="dp_omnibox_wrap">
		<div id="dp_omnibox">
			<div class="searchBoxWrap">
				<input id="dpsearchbox" type="text" value="" name="search" autocomplete="off" />
			</div>
		</div>
	</div>
	<!-- END SEARCH SECTION -->

	<!-- BEGIN USER SECTION -->
	<div id="DP-UserSection">
		<div id="DP-userControl">
			<div class="currentUserAvatar">
				<div class="userWrapper">
					<a onclick="toggle_visibility('userSetting');"><img src="{{ app.user.getPictureUrl(20) }}" alt="" /></a>
				</div>
				<span class="dropdownIcon" onclick="toggle_visibility('userSetting');"></span>
			</div>
		</div>
		<!-- Header - User Control Dropdown -->
		<div id="userSetting" style="display:none;">
			<div class="userProfileDropdown" >
				<div class="userProfileDropdownHeader">
					<a onclick="toggle_visibility('userSetting');"><img src="{{ app.user.getPictureUrl(20) }}" alt="" /></a>
				</div>
				<ul>
					<li class="logggedAs"><p>Logged in as</p></li>
					<li class="currentUsername"><p>{{ app.user.display_name }}</p></li>
					<li class="setting" id="user_settings_link"><a>Settings</a></li>
					<li class="help"><a>Help</a></li>
					<li class="logout"><a href="{{ path('admin_logout', {'auth': security_token('user_logout')}) }}">Log out</a></li>
				</ul>
			</div>
		</div>
	<!-- END USER SECTION -->
	</div>

	<!-- BEGIN INTERFACE SECTION -->
	<div id="DP-InterfaceSwitcher">
		<div class="DP-adminSwitch">
			<div class="adminSwitcher">
				<a>Admin Interface<span class="dropdownIcon"></span></a>
			</div>
		</div>
		<!-- Header - Switch Button Interfaces- Dropdown -->
		<div id="interfacesToggle" style="display:none;">
		<div class="dropdownSwitcherWrap">
			<div class="switcherHeader">
				<a><span>Admin Interface</span></a>
			</div>
			<ul>
				<li><a class="admin" href="{{ path('agent') }}"><span class="check">Agent Interface</span></a></li>
				<li><a class="billing" href=""><span class="check">Billing Interface</span></a></li>
				<li><a class="report" href="{{ path('report') }}"><span class="check">Report Interface</span></a></li>
				<li><a class="portal" href="{{ path('user') }}"><span class="check">User Interface</span></a></li>
			</ul>
		</div>
		</div>
	</div>
	<!-- END INTERFACE SECTION -->
</div>
<!-- /BEGIN HEADER BAR -->

{#

<li data-menu="#server_menu">
				<a><span class="server">Server</span></a>
			</li>

#}
<!-- BEGIN NAV BAR -->
<div id="dp_admin_nav">
	<div id="dp_admin_nav_sections" class="deskproPane">
		<ul>
			<li data-menu="#setup_menu">
				<a><span class="setup">Setup</span></a>
			</li>
			<li>
				<a href="{{ path('admin_agents') }}"><span class="agents">Agents</span></a>
			</li>
			<li data-menu="#users_menu">
				<a><span class="users">Users</span></a>
			</li>
		</ul>
		<div class="sep">-</div>
		<ul>
			<li>
				<a href="{{ path('admin_portal') }}"><span class="publish">Portal</span></a>
			</li>
			<li data-menu="#chat_menu">
				<a><span class="chat">Chat</span></a>
			</li>
			<li>
				<a><span class="twitter">Twitter</span></a>
			</li>
			<li>
				<a><span class="deals">Deals</span></a>
			</li>
			<li data-menu="#tickets_menu">
				<a><span class="tickets">Tickets</span></a>
			</li>
		</ul>
		<div class="sep">-</div>
		<ul>
			<li data-menu="#server_menu"><a><span class="server">Server</span></a></li>
		</ul>
	</div>
</div>
<!-- /BEGIN NAV BAR -->
<div id="dp_page_wrap">

{% set prepage %}{% block prepage %}{% endblock %}{% endset %}
{% if prepage|trim|length %}
	<div id="dp_admin_prepage" class="admin-help-header">
		<div class="open-btn">
			<span>&darr;</span>
		</div>
		<div class="bound-fade"></div>
		<div class="content">{{ prepage|raw }}</div>
	</div>
{% endif %}

{% set pagetitle %}{% block pagetitle %}{% endblock %}{% endset %}
{% if pagetitle|trim|length %}
	<div id="dp_admin_pagetitle">{{ pagetitle|raw }}</div>
{% endif %}

{% set sidebar %}{% block sidebar %}{% endblock %}{% endset %}
{% set sidebar_right %}{% block sidebar_right %}{% endblock %}{% endset %}
{% if sidebar|trim|length %}
	<div id="dp_admin_page_sidebar">{{ sidebar|raw }}</div>
{% endif %}
{% if sidebar_right|trim|length %}
	<div id="dp_admin_page_sidebar_right">{{ sidebar_right|raw }}</div>
{% endif %}

{% if app.session.hasFlash('saved') %}
	<div class="alert-message success">
		"{{ app.session.getFlash('saved') }}" was saved successfully
	</div>
{% endif %}
{% if app.session.hasFlash('deleted') %}
	<div class="alert-message success">
		"{{ app.session.getFlash('deleted') }}" was deleted successfully
	</div>
{% endif %}

<div id="dp_admin_page" class="{% if sidebar|trim|length %}with-sidebar{% endif %} {% if sidebar_right|trim|length %}with-sidebar-right{% endif %}">
	{% block content %}
		<div class="dp-page-box">
			<div class="page-content">
				{% block page %}{% endblock %}
			</div>
		</div>
	{% endblock %}
</div>

{% include 'AdminBundle:Main:layout-menus.html.twig' %}

</div>

{% set page_nav %}{% block page_nav %}{% endblock %}{% endset %}
{% if page_nav|trim|length %}
	<div id="dp_page_nav">
		<div class="inner-shadow"></div>
		{{ page_nav|raw }}
	</div>
{% endif %}

</body>
</html>
