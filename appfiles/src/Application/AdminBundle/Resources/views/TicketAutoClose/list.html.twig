{% extends 'AdminBundle::layout_subpage.html.twig' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/TicketAutoCloseList.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
window._page_exec_stack.push(function() {
	window.DeskPRO_Page_TicketAutoCloseList = new DeskPRO.Admin.PageHandler.TicketAutoCloseList('#ticket_autoclose');
});
</script>
{% endblock %}
{% block page_id "ticket_autoclose" %}
{% block content %}

<div class="admin-section-head in-page">
	<h1>Auto-close Settings</h1>
</div>

<form action="{{ path('admin_ticketautoclose_saveoptions') }}" method="post" id="autoclose_options_form">
	<div class="table-list-wrap">
		<table class="table-list" cellspacing="0" cellpadding="0" width="100%">
			<tbody>
				<tr>
					<td width="25%" align="center">
						Resolve a ticket with no activity after <br />
						{{ form_widget(autoclose_options_form.resolve_agent_reply, {'attr': {'size': 2}}) }}<br />
						and an agent was last to reply
					</td>
					<td width="25%" align="center">
						Close a ticket with no activity after <br />
						{{ form_widget(autoclose_options_form.close_agent_reply, {'attr': {'size': 2}}) }}<br />
						and an agent was last to reply
					</td>
					<td width="25%" align="center">
						Resolve a ticket with no activity after <br />
						{{ form_widget(autoclose_options_form.resolve_user_reply, {'attr': {'size': 2}}) }}<br />
						and the user was last to reply
					</td>
					<td width="25%" align="center">
						Close a ticket with no activity after <br />
						{{ form_widget(autoclose_options_form.close_user_reply, {'attr': {'size': 2}}) }}<br />
						and the user was last to reply
					</td>
				</tr>
			</tbody>
		</table>
	</div>

	<div style="text-align: center; padding-top: 10px;">
		<button class="dp-button">Save Options</button>
	</div>
</form>

{% endblock %}