{% extends 'AdminBundle::layout.html.twig' %}
{% block page %}

<form action="{{ path(route_basename~'edit', {'field_id': field.id|default(0)}) }}" method="post">
{{ form_widget(form.handler_class) }}

<div class="dp-form">
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Title</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.title) }}
		</div>
	</div>

	{% block form_required %}
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Require</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.required) }} Require user to input a value for this field
		</div>
	</div>
	{% endblock %}

	{% block form_extra_top %}{% endblock %}
	{% block form_extra %}{% endblock %}
</div>

<button class="btn primary save-trigger">Save</button>

</form>

{% endblock %}
