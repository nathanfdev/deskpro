{% extends 'AdminBundle::layout_popout.html.twig' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/FieldEdit.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
	window.DeskPRO_Page = new DeskPRO.Admin.PageHandler.FieldEdit({{ field.id|default(0) }});

	{% if saved %}
		DeskPRO_Page.tellParentUpdated();
		DeskPRO_Page.updateParentListRow({{ row_html|json_encode|raw }});
	{% endif %}
}
</script>
{% endblock %}
{% block header %}
	<h1>{% if field.id %}Edit Field{% else %}New Field{% endif %}</h1>
{% endblock %}
{% block content %}

{% set form_url %}{{ path(route_basename~'edit', {'field_id': field.id|default(0)}) }}{% endset %}

{{form.renderFormTag({'action': form_url, 'method':'POST'})|raw}}
{{form.renderHiddenTags()|raw}}

{% block edit_properties %}
<div class="form-panel">
	<div class="row">
		<label>Type</label>
		{{field.handler_class}}
	</div>

	<div class="row">
		<label>Title</label>
		{{form.field_properties.title.render()|raw()}}
	</div>
</div>
{% endblock %}

{% block custom_form %}{% endblock %}

</form>

{% endblock %}
{% block footer %}
	<button class="dp-button green save-trigger">Save</button>
	<button class="dp-button gray cancel-trigger">Cancel</button>
{% endblock %}