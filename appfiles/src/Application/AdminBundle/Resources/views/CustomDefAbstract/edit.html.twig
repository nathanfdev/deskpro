{% extends 'AdminBundle::layout.html.twig' %}
{% block content %}

{% set form_url %}{{ path(route_basename~'edit', {'field_id': field.id|default(0)}) }}{% endset %}

{{form.renderFormTag({'action': form_url, 'method':'POST'})|raw}}
{{form.renderHiddenTags()|raw}}

{% block edit_properties %}
<div class="form-panel">
	<div class="row">
		<label>Type</label>
		{{field.handler_class}}
	</div>

	<div class="row">
		<label>Title</label>
		{{form.field_properties.title.render()|raw()}}
	</div>
</div>
{% endblock %}

{% block custom_form %}{% endblock %}

<div style="margin-top: 15px; text-align: center;">
	<button class="dp-button green" type="submit">Save</button>
</div>

</form>

{% endblock %}
{% block sidebar %}
{% endblock %}