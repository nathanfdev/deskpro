{% extends 'AdminBundle::layout.twig' %}
{% block content %}

<div class="block" id="block-tables">
	<div class="content">
		<h2 class="title">Field Types</h2>
		<div class="inner">
			<form action="{% path route_basename~'edit' with ['field_id': 0] %}" class="form">
				<table class="table">
					<tr>
						<th class="first" width="10">&nbsp;</th>
						<th>Type</th>
					</tr>
					<tr class="even">
						<td><input type="radio" name="formfield[handler_class]" value="Application\DeskPRO\CustomFields\Handler\Text" /></td>
						<td>
							<strong>Text</strong><br />
							This is a simple one-line text box
						</td>
					</tr>
					<tr class="even">
						<td><input type="radio" name="formfield[handler_class]" value="Application\DeskPRO\CustomFields\Handler\Textarea" /></td>
						<td>
							<strong>Textarea</strong><br />
							This is a multi-line textarea.
						</td>
					</tr>
					<tr class="even">
						<td><input type="radio" name="formfield[handler_class]" value="Application\DeskPRO\CustomFields\Handler\Choice" /></td>
						<td>
							<strong>Choice</strong><br />
							This field lets the user choose one or more pre-defined options. This field can be rendered
							as a drop-down select box, a series of radio buttons, or a series of checkboxes.
						</td>
					</tr>
					<tr class="even">
						<td><input type="radio" name="formfield[handler_class]" value="Application\DeskPRO\CustomFields\Handler\MultipleChoice" /></td>
						<td>
							<strong>Multiple Choice</strong><br />
							This field presents multiple pre-defiend choices to a user, and lets the user choose amongst them.
						</td>
					</tr>
				</table>
				<div class="actions-bar wat-cf">
					<div class="actions">
						<button class="button" type="submit">
							Choose Type
						</button>
					</div>
				</div>
			</form>
		</div>
	</div>
</div>

{% endblock %}
{% block sidebar %}
{% endblock %}