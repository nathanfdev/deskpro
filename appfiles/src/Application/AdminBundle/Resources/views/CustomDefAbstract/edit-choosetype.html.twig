{% extends 'AdminBundle::layout_popout.html.twig' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/GeneralEdit.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
	window.DeskPRO_Page = new DeskPRO.Admin.PageHandler.GeneralEdit('', 0);
}
</script>
{% endblock %}
{% block header %}
	<h1>Choose field type</h1>
{% endblock %}
{% block content %}

<form action="{{ path(route_basename~'edit', {'field_id': 0}) }}" class="form">

<ul class="item-list">
	<li>
		<div style="float:left">
			<input type="radio" name="formfield[handler_class]" value="Application\DeskPRO\CustomFields\Handler\Text" />
		</div>
		<div style="margin-left: 50px;">
			<strong>Text</strong><br />
			This is a simple one-line text box. There are also some specialty types:<br />
			<input type="radio" name="formfield[handler_class]" value="Application\DeskPRO\CustomFields\Handler\TextUrl" /> URL<br />
			<input type="radio" name="formfield[handler_class]" value="Application\DeskPRO\CustomFields\Handler\TextEmail" /> Email addres<br />
		</div>
	</li>
	<li>
		<div style="float:left">
			<input type="radio" name="formfield[handler_class]" value="Application\DeskPRO\CustomFields\Handler\Textarea" />
		</div>
		<div style="margin-left: 50px;">
			<strong>Textarea</strong><br />
			This is a multi-line text box that can be used for longer entries like descriptions or notes.
		</div>
	</li>
	<li>
		<div style="float:left">
			<input type="radio" name="formfield[handler_class]" value="Application\DeskPRO\CustomFields\Handler\Choice" />
		</div>
		<div style="margin-left: 50px;">
			<strong>Choice</strong><br />
			This is a drop-down select box or radio buttons that let a user choose from a set of predefined options.
		</div>
	</li>
	<li>
		<div style="float:left">
			<input type="radio" name="formfield[handler_class]" value="Application\DeskPRO\CustomFields\Handler\ChoiceMulti" />
		</div>
		<div style="margin-left: 50px;">
			<strong>Mulitple Choice</strong><br />
			This is a select box or group of checkboxes that let a user choose multiple values from a set of predefined options.
		</div>
	</li>
	<li>
		<div style="float:left">
			<input type="radio" name="formfield[handler_class]" value="Application\DeskPRO\CustomFields\Handler\Date" />
		</div>
		<div style="margin-left: 50px;">
			<strong>Date</strong><br />
			Thie date field lets you select a date using a calendar widget.
		</div>
	</li>
</ul>

</form>

{% endblock %}
{% block footer %}
	<button class="dp-button green save-trigger">Continue</button>

{% endblock %}