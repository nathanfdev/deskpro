{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% extends layout_tpl ? layout_tpl : 'AdminBundle::layout.html.twig' %}
{% block page %}

<form action="{{ path(route_basename~'edit', {'field_id': 0}) }}" class="form">
{{ design.block_sections() }}

	{{ design.block_sections_item() }}
		<header><h3><label><input type="radio" name="fielddef[handler_class]" value="Application\DeskPRO\CustomFields\Handler\Text" checked="checked" /> Text</label></h3></header>
		<p>This is a simple one-line text box.</p>
	{{ design.block_sections_item_end() }}

	{{ design.block_sections_item() }}
		<header><h3><label><input type="radio" name="fielddef[handler_class]" value="Application\DeskPRO\CustomFields\Handler\Textarea" /> Textarea</label></h3></header>
		<p>This is a multi-line text box that can be used for longer entries like descriptions or notes.</p>
	{{ design.block_sections_item_end() }}

	{{ design.block_sections_item() }}
		<header><h3><label><input type="radio" name="fielddef[handler_class]" value="Application\DeskPRO\CustomFields\Handler\Choice" /> Choice</label></h3></header>
		<p>This is a set of predefined options presented as a drop-down select menu, radio buttons or checkboxes.</p>
	{{ design.block_sections_item_end() }}

	{#
	{{ design.block_sections_item() }}
		<header><h3><label><input type="radio" name="fielddef[handler_class]" value="Application\DeskPRO\CustomFields\Handler\Date" /> Date</label></h3></header>
		<p>Thie date field lets you select a date using a calendar widget.</p>
	{{ design.block_sections_item_end() }}
	#}

	{{ design.block_sections_item() }}
		<header><h3><label><input type="radio" name="fielddef[handler_class]" value="Application\DeskPRO\CustomFields\Handler\Display" /> Display</label></h3></header>
		<p>This is a widget field that lets you enter any kind of HTML for display purposes. It does not take any input.</p>
	{{ design.block_sections_item_end() }}

	<li class="footer">
		<button class="clean-white">Continue</button>
	</li>

{{ design.block_sections_end() }}

</form>
{% endblock %}
