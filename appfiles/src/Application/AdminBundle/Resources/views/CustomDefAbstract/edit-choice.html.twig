{% extends 'AdminBundle:CustomDefAbstract:edit.html.twig' %}
{% block form_extra %}
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Multiple Choice</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.multiple) }} Allow the user to select multiple options
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Expanded view</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.expanded) }} Show radio buttons or checkboxes instead of a select box
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Options</label>
		</div>
		<div class="dp-form-input">
			<div class="choices-builder" data-element-handler="DeskPRO.Admin.ElementHandler.ChoiceBuilder">
				<header>
					<input type="text" class="new-choice" value="" /> <button class="clean-white add-trigger">Add</button>
				</header>
				<div style="display: none" id="choice_extra_fields"></div>
				<ul class="list">
					{% for id,choice in editfield.choices %}
					<li class="item" data-choice-id="{{ id }}">
						<div class="controls"><ul><li class="remove"><a>remove</a></li></ul></div>
						<div class="controls right"><ul><li class="drag"><a>drag</a></li></ul></div>
						<div class="label">{{ choice }}</div>
						<input type="hidden" name="fielddef[choices][]" class="row-value" value="exist:{{ id }}:{{ choice }}" />
					</li>
					{% endfor %}
				</ul>
				<script type="text/x-deskpro-plain" class="row-tpl">
					<li class="item new" data-choice-id="new">
						<div class="controls"><ul><li class="remove"><a>remove</a></li></ul></div>
						<div class="controls right"><ul><li class="drag"><a>drag</a></li></ul></div>
						<div class="label"></div>
						<input type="hidden" name="fielddef[choices][]" class="row-value" value="" />
					</li>
				</script>
				<script type="text/x-deskpro-plain" id="move_options_overlay">
					<div id="overlay_wrapper" style="width: 400px; height: 160px; display: none;">
						<div class="overlay-title">
							<span class="close-trigger close-overlay"></span>
							<h4>Existing Values</h4>
						</div>
						<div class="overlay-content">
							<p>What should be done with the items that already have this value?</p>
							<select class="move-value"></select>
						</div>
						<div class="overlay-footer">
							<button class="clean-white save-trigger">Okay</button>
						</div>
					</div>
				</script>
			</div>
		</div>
	</div>
{% endblock %}
