{% extends 'AdminBundle::layout.html.twig' %}
{% block pagetitle %}
	<h1>Usergroups</h1>
	<nav>
		<a class="clean-white" href="{{ path('admin_usergroups_new') }}">Create Usergroup</a>
	</nav>
{% endblock %}
{% block page %}

{% if usergroups|length %}
<div class="check-grid item-list">
	<table width="100%">
		<thead>
			<tr>
				<th style="text-align:left">&nbsp; Usergroup</th>
				<th style="text-align:center" width="100">Number of members</th>
				<th style="text-align:left" width="50">&nbsp;</th>
			</tr>
		</thead>
		<tbody>
			<tr>
				<td>Everyone</td>
				<td style="text-align:center">
					<a href="{{ path('admin_usergroups_browse', {'id': '0'})}}">{{ member_counts[0]|default('0') }}</a>
				</td>
				<td>&nbsp;</td>
			</tr>
		{% for usergroup in usergroups %}
			<tr>
				<td>
					{{ usergroup.title }}
					{% if usergroup.note %}
						<div style="font-size: 9px; margin-left: 15px;">{{ usergroup.note }}</div>
					{% endif %}
				</td>
				<td style="text-align:center"><a href="{{ path('admin_usergroups_browse', {'id': usergroup.id})}}">{{ member_counts[usergroup.id]|default('0') }}</a></td>
				<td style="padding: 3px 3px 0 0; text-align: right;">
					<a href="{{ path('admin_usergroups_edit', {'id': usergroup.id}) }}"><span class="btn-edit-gear"></span></a>
				</td>
			</tr>
		{% endfor %}
		</tbody>
	</table>
</div>
{% else %}
	<p>
		You haven't created any usergroups yet.
	</p>
{% endif %}

{% endblock %}
