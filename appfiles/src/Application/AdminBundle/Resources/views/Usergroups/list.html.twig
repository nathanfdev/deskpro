{% extends 'AdminBundle::layout.html.twig' %}
{% block section 'crm' %}
{% block sub_section 'usergroups' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/UsergroupsList.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
	window.DeskPRO_Page = new DeskPRO.Admin.PageHandler.UsergroupsList();
}
</script>
{% endblock %}
{% block content %}

<div style="text-align:right; padding-bottom: 10px;">
	<a class="icon tickets popout-trigger" href="{{ path('admin_usergroups_edit', {'usergroup_id': '0'}) }}">Create New Usergroup</a>
</div>

<ul class="item-list">
	{% for usergroup in usergroups %}
		{% include 'AdminBundle:Usergroups:list-row.html.twig' %}
	{% endfor %}
</ul>

{% endblock %}