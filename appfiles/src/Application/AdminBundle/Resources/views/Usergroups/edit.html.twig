{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block pagebar %}
     <ul>
         <li><a href="{{ path('admin_usergroups') }}">Usergroups</a></li>
		 {% if usergroup.id %}
		 	<li>Edit Usergroup</li>
		 {% else %}
		 	<li>New Usergroup</li>
		 {% endif %}
     </ul>
{% endblock %}
{% block page %}

<form action="{{ path('admin_usergroups_edit', {'id': usergroup.id|default(0)}) }}" method="post">
{{ form_token('edit_usergroup') }}

<input type="hidden" name="process" value="1" />

<div class="dp-form">
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Title</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.title) }}
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Note / Description</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.note, {'attr': {'style': 'height: 50px'}}) }}
		</div>
	</div>

	{% if usergroup.id %}
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>Number of members</label>
			</div>
			<div class="dp-form-input">
				{{ member_count|default('0') }} (<a href="{{ path('admin_usergroups_browse', {'id': usergroup.id})}}">browse</a>)
			</div>
		</div>
	{% endif %}
</div>

<button class="clean-white">Save</button>

</form>

{% if usergroup.id %}
<div class="delete-link-wrap">
	<a href="{{ path('admin_usergroups_delete', {'id': usergroup.id, 'auth': security_token('delete_usergroup') }) }}" onclick="return confirm('Are you sure you want to delete this usergroup?');">delete</a>
</div>
{% endif %}

{% endblock %}
