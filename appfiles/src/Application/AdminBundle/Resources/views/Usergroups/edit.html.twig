{% extends 'AdminBundle::layout_popout.html.twig' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/AgentGroupEdit.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
	window.DeskPRO_Page = new DeskPRO.Admin.PageHandler.AgentGroupEdit({{usergroup.id|default(0)}});

	{% if row_html %}
		window.DeskPRO_Page.updateParent({{ usergroup.title|json_encode|raw}}, {{ row_html|json_encode|raw }});
	{% endif %}
}
</script>
{% endblock %}
{% block header %}
	<h1>{% if usergroup.id %}Edit Usergroup{% else %}New Usergroup{% endif %}</h1>
{% endblock %}
{% block content %}

<form action="{{ path('admin_usergroups_edit', {'usergroup_id': usergroup.id|default(0)}) }}" method="post">
<input type="hidden" name="process" value="1" />

<div class="form-panel">
	<div class="row">
		<label>Title</label>
		{{ form_field(form.title) }}
	</div>
	<div class="row">
		<label>Note / Description</label>
		{{ form_field(form.note) }}
	</div>
</div>

<br /><br />

</form>
{% endblock %}
{% block footer %}
	<button class="dp-button small save-trigger">Save</button>

{% endblock %}