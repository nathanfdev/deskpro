{% extends 'AdminBundle::layout.html.twig' %}
{% block pagetitle %}
	{% if usergroup %}
		<h1>Browsing {{ usergroup.title }} Members</h1>
	{% else %}
		<h1>Browsing All Members</h1>
	{% endif %}
	<nav>
		<a class="clean-white" href="{{ path('admin_usergroups') }}">&larr; Back to usergroups</a>
	</nav>
{% endblock %}
{% block page %}

{% if people|length %}
<div class="check-grid item-list">
	<table width="100%">
		<thead>
			<tr>
				<th style="text-align:left">&nbsp; Name</th>
				<th style="text-align:left">&nbsp; Organization</th>
				<th style="text-align:left">&nbsp; Email Address</th>
				<th style="text-align:left">&nbsp; Date Registered	</th>
			</tr>
		</thead>
		<tbody>
			{% for person in people %}
				<tr>
					<td>{{ person.display_name }}</td>
					<td>
						{% if person.organization %}
						{% if person.organization_position %}{{ person.organization_position }}, {% endif %}{{ person.organization.name }}
						{% else %}
							None
						{% endif %}
					</td>
					<td>{{ person.primary_email_address }}</td>
					<td>{{ person.date_created|date('Y-m-d') }}</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
</div>

<center>
	{% if pageinfo.prev %}<a href="{{ path('admin_usergroups_browse', {'id': usergroup.id|default('0'), 'page': pageinfo.prev}) }}">&lt;&lt;</a>{% endif %}
	{% for p in pageinfo.pages %}
		<a href="{{ path('admin_usergroups_browse', {'id': usergroup.id|default('0'), 'page': p}) }}">{{ p }}</a>
	{% endfor %}
	{% if pageinfo.next %}<a href="{{ path('admin_usergroups_browse', {'id': usergroup.id|default('0'), 'page': pageinfo.next}) }}">&gt;&gt;</a>{% endif %}
</center>

{% else %}
	<p>
		There are no users to show.
	</p>
{% endif %}

{% endblock %}
