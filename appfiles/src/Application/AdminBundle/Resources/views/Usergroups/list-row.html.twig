<li class="usergroup usergroup-{{usergroup.id}}" data-usergroup-id="{{usergroup.id}}">
	<div style="float:right">
		<ul class="controls">
			<li class="edit edit-trigger"><a href="{{ path('admin_usergroups_edit', {'usergroup_id': usergroup.id}) }}" class="popout-trigger">edit</a></li>
		</ul>
	</div>
	<div>
		<strong>{{usergroup.title}}</strong>
		{% if usergroup.note %}
			<small>{{usergroup.note}}</small>
		{% endif %}
	</div>
</li>