{% extends 'AdminBundle::layout.html.twig' %}
{% block pagetitle %}
	<h1>{% if department.id %}Edit Department{% else %}New Department{% endif %}</h1>
	<nav>
		<a class="clean-white" href="{{ path('admin_departments') }}">&larr; Back to Departments</a>
	</nav>
{% endblock %}
{% block page %}

<form action="{{ path('admin_departments_edit', {'department_id': department.id|default(0)}) }}" method="post">
<input type="hidden" name="process" value="1" />

<div class="dp-form">
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Title</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.title) }}
		</div>
	</div>

	{% if form.parent %}
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>Parent Department</label>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.parent) }}
			</div>
		</div>
	{% endif %}

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Enable tickets in this department?</label>
		</div>
		<div class="dp-form-input">
			<label>{{ form_widget(form.is_tickets_enabled) }} Enable</label>
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Enable chat in this department?</label>
		</div>
		<div class="dp-form-input">
			<label>{{ form_widget(form.is_chat_enabled) }} Enable</label>
		</div>
	</div>
</div>

{{ form_rest(form) }}

<button class="btn primary save-trigger">Save</button>
</form>

<div class="delete-link-wrap">
	<a href="{{ path('admin_departments_del', {'department_id': department.id}) }}">delete</a>
</div>
{% endblock %}
