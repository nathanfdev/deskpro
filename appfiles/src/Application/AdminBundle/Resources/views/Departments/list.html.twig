{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/DepartmentsList.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
	//window.DeskPRO_Page = new DeskPRO.Admin.PageHandler.DepartmentsList();

	$('table.structure-list tr .agent-team-selection').click(function(ev) {
		var btn = $(this), optionbox = null, tr = null;

		tr = btn.closest('tr');

		if (btn.data('optionbox')) {
			optionbox = btn.data('optionbox');
		} else {
			optionbox = new DeskPRO.UI.OptionBox({
				element: $('#optionbox_dep_' + tr.data('item-id')),
				onClose: function() {
					var countTeams  = optionbox.getCount('teams');
					var countAgents = optionbox.getCount('agents');

					var words = [];
					if (countAgents > 0) {
						words.push(countAgents + ' agents');
					}
					if (countTeams > 0) {
						words.push(countTeams + ' teams');
					}

					if (!words.length) {
						words = ['No agents'];
					}

					btn.text(words.join(', '));
				}
			});
			btn.data('optionbox', optionbox);
		}

		optionbox.open(ev);
	});

	$('table.structure-list tr .ug-selection').click(function(ev) {
		var btn = $(this), optionbox = null, tr = null;

		tr = btn.closest('tr');

		if (btn.data('optionbox')) {
			optionbox = btn.data('optionbox');
		} else {
			optionbox = new DeskPRO.UI.OptionBox({
				element: $('#optionbox_ug_' + tr.data('item-id')),
				onClose: function() {
					var count = optionbox.getCount('usergroups');

					if (count > 0) {
						btn.text(count + ' usergroups');
					} else {
						btn.text('No usergroups');
					}
				}
			});
			btn.data('optionbox', optionbox);
		}

		optionbox.open(ev);
	});
}
</script>
{% endblock %}
{% block pagetitle %}
	<nav>
		<button class="clean-white popout-trigger">Create New Department</button>
	</nav>
	Departments
{% endblock %}
{% block prepage %}
	Departments are like global helpdesk categories that split up your resources into logical groups.
{% endblock %}
{% block content %}

<div class="page-content">
	{{ design.structure_list() }}
		{% for department in all_departments %}
			{% include 'AdminBundle:Departments:list-row.html.twig' %}
		{% endfor %}
	{{ design.structure_list_end() }}
</div>

{% endblock %}
