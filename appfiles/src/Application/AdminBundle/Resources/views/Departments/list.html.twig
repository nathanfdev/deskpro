{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block pagebar %}
	<nav>
		<ul>
			<li class="add"><a id="newdep_open">Add New Department</a></li>
		</ul>
	</nav>
	<ul>
		<li>Departments</li>
	</ul>
{% endblock %}
{% block content %}
<div class="dp-page-box">
<div class="page-content" data-element-handler="DeskPRO.Admin.Departments.AjaxSave" data-reorder-url="{{ path('admin_departments_updateorders') }}">

	{{ design.helpbox() }}
	    <p>The department field is the primary grouping field for tickets and chats. For many helpdesks, this will be the only field configured. A typical set of departments would include "Sales", "Support" and "Billing".</p>
	{{ design.helpbox_end() }}

	{{ design.dpgrid({class: 'dep-list'}) }}
		{{ design.dpgrid_headerrow() }}
			{{ design.dpgrid_headercol({ class: 'l r tl tr', style: "width: 580px;"}) }}
				<h1>Department</h1>
			{{ design.dpgrid_headercol_end() }}
			{{ design.dpgrid_headercol({ class: 'l r tl tr l-margin r-margin', style: "width: 140px"}) }}
				<h1>Tickets</h1>
			{{ design.dpgrid_headercol_end() }}
			{{ design.dpgrid_headercol({ class: 'l r tl tr', style: "width: 140px"}) }}
				<h1>Chat</h1>
			{{ design.dpgrid_headercol_end() }}
		{{ design.dpgrid_headerrow_end() }}

		{% for department in all_departments %}
			{% include 'AdminBundle:Departments:list-row.html.twig' %}
		{% endfor %}
	{{ design.dpgrid_end() }}

<div id="editdep_overlay" style="width: 400px; height: 180px; display: none;">
	<div class="overlay-title">
		<span class="close-overlay"></span>
		<h4>Edit Department Title</h4>
	</div>
	<div class="overlay-content">
		<form class="dp-form" method="POST" action="{{ path('admin_departments_savetitle') }}">
			<div class="dp-form-row">
				<div class="dp-form-label">
					<label>Title</label>
				</div>
				<div class="dp-form-input">
					<input type="hidden" name="department_id" id="editdep_depid" value="" />
					<input type="text" name="title" id="editdep_title" value="" />
				</div>
			</div>
		</form>
	</div>
	<div class="overlay-footer">
		<button class="clean-white" id="editdep_savebtn">Save</button>
	</div>
</div>

<div id="newdep_overlay" style="width: 400px; height: 230px; display: none;">
	<div class="overlay-title">
		<span class="close-overlay"></span>
		<h4>New Department</h4>
	</div>
	<div class="overlay-content">
		<form class="dp-form" method="POST" action="{{ path('admin_departments_savenew') }}">
			<div class="dp-form-row">
				<div class="dp-form-label">
					<label>Title</label>
				</div>
				<div class="dp-form-input">
					<input type="text" name="title" id="newdep_title" value="" />
				</div>
			</div>

			<div class="dp-form-row">
				<div class="dp-form-label">
					<label>Parent</label>
				</div>
				<div class="dp-form-input">
					<select name="parent_id" id="newdep_parent_id">
						<option value="0">No Parent</option>
						{% for department in all_departments %}
							<option value="{{ department.id }}">{{ department.title }}</option>
						{% endfor %}
					</select>
				</div>
			</div>
		</form>
	</div>
	<div class="overlay-footer">
		<button class="clean-white" id="newdep_savebtn">Add</button>
	</div>
</div>

</div>

</div>
{% endblock %}
