{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% macro agentteam_selector(for_id, app, selected_agents, agents) %}
	<div class="optionbox" id="optionbox_dep_{{ for_id }}_{{ app }}">
		<section data-section-name="agents">
			<header>
				<input type="checkbox" class="all-check" />
				<h3>Agents</h3>
				<span class="selected-count" style="display: none">(<span class="num"></span>)</span>
				<input type="text" class="filter-box" placeholder="Filter..." />
			</header>
			<ul>
				{% for agent in agents %}
					<li><input type="checkbox" value="{{ agent.id }}" {% if agent.id in selected_agents %}checked="checked"{% endif %} /><label>{{ agent.display_name }}</label></li>
				{% endfor %}
			</ul>
		</section>
	</div>
{% endmacro %}

{% if not depth %}
<tbody>
{% endif %}
	<tr data-item-id="{{ department.id }}" class="depth-{{ depth|default(0) }} department department-{{department.id}} {% if department.parent %}is-sub parent-{{ department.parent.id }}{% endif %} {% if department.children|length %}has-children{% endif %}" data-department-id="{{department.id}}">
		<td class="title">
			<a href="{{ path('admin_departments_edit', {'department_id': department.id}) }}" class="popout-trigger" data-height="300">
				{{department.title}}
			</a>
		</td>
		<td width="35" class="controls border-left">
			<input type="checkbox" name="tickets" value="1" class="set-tickets-state onoff-slider" {% if department.is_tickets_enabled %}checked="checked"{% endif %} />
		</td>
		<td width="50" class="controls">
				<div class="tickets-enabled" {% if not department.is_tickets_enabled %}style="display: none"{% endif %}>
					<button class="clean-white small label-tickets-perms" data-element-handler="DeskPRO.Admin.Departments.AgentSelector" data-app="tickets" data-register-handler="true" data-department-id="{{ department.id }}">
						{% if not current_options_tickets[department.id] %}
							No agents
						{% else %}
							{{ current_options_tickets[department.id]|length }} agents
						{% endif %}
					</button>
				</div>
				<div class="disabled-state tickets-disabled" {% if department.is_tickets_enabled %}style="display: none"{% endif %}>disabled</div>
				{{ _self.agentteam_selector(department.id, 'tickets', current_options_tickets[department.id], agents) }}
			</td>
		<td width="35" class="controls border-left">
			<input type="checkbox" name="chat" value="1" class="set-chat-state onoff-slider" {% if department.is_chat_enabled %}checked="checked"{% endif %} />
		</td>
		<td width="50" class="controls">
			<div class="chat-enabled" {% if not department.is_chat_enabled %}style="display: none"{% endif %}>
				<button class="clean-white small label-chat-perms" data-element-handler="DeskPRO.Admin.Departments.AgentSelector" data-app="chat" data-register-handler="true" data-department-id="{{ department.id }}">
					{% if not current_options_chat[department.id] %}
						No agents
					{% else %}
						{{ current_options_chat[department.id]|length }} agents
					{% endif %}
				</button>
			</div>
			<div class="disabled-state chat-disabled" {% if department.is_chat_enabled %}style="display: none"{% endif %}>disabled</div>
			{{ _self.agentteam_selector(department.id, 'chat', current_options_chat[department.id], agents) }}
		</td>
	</tr>
	{% if department.children|length %}
		{% for sub_dep in department.children %}
			{% include 'AdminBundle:Departments:list-row.html.twig' with {'department': sub_dep, 'is_sub': true, 'depth': depth|default(0) + 1 } %}
		{% endfor %}
	{% endif %}
{% if not depth %}
</tbody>
{% endif %}
