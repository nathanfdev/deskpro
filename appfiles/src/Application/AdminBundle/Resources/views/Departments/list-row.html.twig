{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% macro agentteam_selector(for_id, selected_agents, selected_teams, agents, teams) %}
	<div class="optionbox" id="optionbox_dep_{{ for_id }}">
		{% if teams|length %}
		<section data-section-name="teams">
			<header>
				<input type="checkbox" class="all-check" />
				<h3>Teams</h3>
				<span class="selected-count" style="display: none">(<span class="num"></span>)</span>
				<input type="text" class="filter-box" placeholder="Filter..." />
			</header>
			<ul>
				{% for team in teams %}
					<li><input type="checkbox" value="{{ team.id }}" {% if team.id in selected_teams %}checked="checked"{% endif %} /><label>{{ team.name }}</label></li>
				{% endfor %}
			</ul>
		</section>
		{% endif %}
		<section data-section-name="agents">
			<header>
				<input type="checkbox" class="all-check" />
				<h3>Agents</h3>
				<span class="selected-count" style="display: none">(<span class="num"></span>)</span>
				<input type="text" class="filter-box" placeholder="Filter..." />
			</header>
			<ul>
				{% for agent in agents %}
					<li><input type="checkbox" value="{{ agent.id }}" {% if agent.id in selected_agents %}checked="checked"{% endif %} /><label>{{ agent.display_name }}</label></li>
				{% endfor %}
			</ul>
		</section>
	</div>
{% endmacro %}
{% macro ug_selector(for_id, selected_usergroups, usergroups) %}
	<div class="optionbox" id="optionbox_ug_{{ for_id }}">
		<section data-section-name="usergroups">
			<header>
				<input type="checkbox" class="all-check" />
				<h3>Usergroups</h3>
				<span class="selected-count" style="display: none">(<span class="num"></span>)</span>
				<input type="text" class="filter-box" placeholder="Filter..." />
			</header>
			<ul>
				{% for usergroup in usergroups %}
					<li><input type="checkbox" value="{{ usergroup.id }}" {% if usergroup.id in selected_usergroups %}checked="checked"{% endif %} /><label>{{ usergroup.title }}</label></li>
				{% endfor %}
			</ul>
		</section>
	</div>
{% endmacro %}

{% if not depth %}
<tbody>
{% endif %}
	<tr data-item-id="{{ department.id }}" class="depth-{{ depth|default(0) }} department department-{{department.id}} {% if department.parent %}is-sub parent-{{ department.parent.id }}{% endif %} {% if department.children|length %}has-children{% endif %}" data-department-id="{{department.id}}">
		<td class="title">
			<a href="{{ path('admin_departments_edit', {'department_id': department.id}) }}" class="popout-trigger" data-height="300">
				{{department.title}}
			</a>
		</td>
		<td width="35" class="controls">
			<input type="checkbox" name="tickets" value="1" class="set-tickets-state onoff-slider" {% if department.is_tickets_enabled %}checked="checked"{% endif %} />
		</td>
		<td width="35" class="controls">
			<input type="checkbox" name="chat" value="1" class="set-chat-state onoff-slider" {% if department.is_chat_enabled %}checked="checked"{% endif %} />
		</td>
		<td width="50" class="controls">
			<button class="clean-white ug-selection" data-element-handler="DeskPRO.Admin.Departments.UsergroupSelector" data-register-handler="true" data-department-id="{{ department.id }}">
				{% if current_options[department.id].usergroup %}
					{{ current_options[department.id].usergroup|length }} usergroups
				{% else %}
					No usergroups
				{% endif %}
			</button>
			{{ _self.ug_selector(department.id, current_options[department.id].usergroup, usergroups) }}
		</td>
		<td width="50" class="controls">
			<button class="clean-white agent-team-selection" data-element-handler="DeskPRO.Admin.Departments.AgentSelector" data-register-handler="true" data-department-id="{{ department.id }}">
				{% if not current_options[department.id].person and not current_options[department.id].agent_team %}
					No agents
				{% else %}
					{% if current_options[department.id].person %}
						{{ current_options[department.id].person|length }} sgents{% if current_options[department.id].agent_team|length %},{% endif %}
					{% endif %}
					{% if current_options[department.id].agent_team %}
						{{ current_options[department.id].agent_team|length }} teams
					{% endif %}
				{% endif %}
			</button>
			{{ _self.agentteam_selector(department.id, current_options[department.id].person, current_options[department.id].agent_team, agents, teams) }}
		</td>
	</tr>
	{% if department.children|length %}
		{% for sub_dep in department.children %}
			{% include 'AdminBundle:Departments:list-row.html.twig' with {'department': sub_dep, 'is_sub': true, 'depth': depth|default(0) + 1 } %}
		{% endfor %}
	{% endif %}
{% if not depth %}
</tbody>
{% endif %}
