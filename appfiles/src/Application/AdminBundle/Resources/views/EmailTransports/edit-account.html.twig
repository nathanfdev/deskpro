{% set page_handler = 'DeskPRO.Admin.ElementHandler.EditEmailTransportPage' %}
{% extends 'AdminBundle::layout.html.twig' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/ElementHandler/EditEmailTransportPage.js') }}"></script>
{% endblock %}
{% block pagetitle %}
	<h1>{% if transport.id %}Edit Outgoing Email Account{% else %}New Outgoing Email Account{% endif %}</h1>
	<nav>
		<a class="clean-white" href="{{ path('admin_emailtrans_list') }}">&larr; Back to the list</a>
	</nav>
{% endblock %}
{% block page %}

<form id="transport_form" action="{{ path('admin_emailtrans_editaccount', {'id': transport.id|default(0)}) }}" method="post">
{{ form_token('edit_transport') }}

<input type="hidden" name="process" value="1" />

<div class="dp-form">
	{% if transport.match_type == 'all' %}
		<input type="hidden" name="transport[match_type]" value="all" />
	{% endif %}
	{% if transport.match_type != 'all' %}
		<div class="dp-form-row-group" data-element-handler="DeskPRO.Admin.ElementHandler.RadioExpander" data-group-class="dp-input-group" data-expand-class="dp-group-options">
			<div class="dp-form-row">
				<div class="dp-form-label">
					<label>When should this account be used?</label>
				</div>
				<div class="dp-form-input">
					<div class="dp-input-group">
						<label>
							<input type="radio" class="option-trigger email-address-type" name="transport[match_type]" value="exact" {% if not edittrans.match_type or edittrans.match_type == 'exact' %}checked="checked"{% endif %} />
							Exact address
						</label>
						<div class="dp-group-options" style="display: none">
							Email address: {{ form_widget(form.match_email, { 'attr': { 'class': 'small email-address-pattern', 'style': 'width:400px' }}) }}
						</div>
					</div>

					<div class="dp-input-group">
						<label>
							<input type="radio" class="option-trigger email-address-type" name="transport[match_type]" value="domain" {% if edittrans.match_type == 'domain' %}checked="checked"{% endif %} />
							Every address at a domain
						</label>
						<div class="dp-group-options" style="display: none">
							Domain: *@{{ form_widget(form.match_domain, { 'attr': { 'class': 'small email-domain-pattern', 'style': 'width:400px' }}) }}
						</div>
					</div>

					<div class="dp-input-group">
						<label>
							<input type="radio" class="option-trigger" name="transport[match_type]" value="regex" {% if edittrans.match_type == 'regex' %}checked="checked"{% endif %} />
							Addresses that match a regular expression
						</label>
						<div class="dp-group-options" style="display: none">
							Pattern: {{ form_widget(form.match_regex, { 'attr': { 'class': 'small', 'style': 'width:400px' }}) }}
						</div>
					</div>
				</div>
			</div>
		</div>
	{% endif %}

	<div class="dp-form-row-group" data-element-handler="DeskPRO.Admin.ElementHandler.RadioExpander" data-group-class="dp-input-group" data-expand-class="dp-group-options">
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>Account Information</label>
				<span class="test-button test-account-settings primary"><span class="lightning-small-icon"></span> Test Settings</span>
			</div>
			<div class="dp-form-input">
				<div class="dp-input-group">
					<label>
						<input type="radio" class="option-trigger" name="transport[transport_type]" value="mail" {% if transport.transport_type == 'mail' %}checked="checked"{% endif %} />
						PHP mail()
					</label>
				</div>

				<div class="dp-input-group">
					<label>
						<input type="radio" class="option-trigger" name="transport[transport_type]" value="smtp" {% if not transport.transport_type or transport.transport_type == 'smtp' %}checked="checked"{% endif %} />
						SMTP Account
					</label>
					<div class="dp-group-options" style="display: none">
						<table cellspacing="0" cellpadding="0" width="100%">
							<tr>
								<td width="80">Host:</td>
								<td>
									{{ form_widget(form.smtp_options.host, {'attr': {'class': 'small'}}) }}<br />
								</td>
							</tr>
							<tr>
								<td>Secure:</td>
								<td>{{ form_widget(form.smtp_options.secure, {'attr': {'class': 'small'}}) }}</td>
							</tr>
							<tr>
								<td>Port:</td>
								<td>{{ form_widget(form.smtp_options.port, {'attr': {'class': 'small', 'style': 'width: 100px'}}) }}</td>
							</tr>
							<tr>
								<td>Username:</td>
								<td>{{ form_widget(form.smtp_options.username, {'attr': {'class': 'small'}}) }}</td>
							</tr>
							<tr>
								<td>Password:</td>
								<td>{{ form_widget(form.smtp_options.password, {'attr': {'class': 'small'}}) }}</td>
							</tr>
						</table>
					</div>
				</div>

				<div class="dp-input-group">
					<label>
						<input type="radio" class="option-trigger" name="transport[transport_type]" value="gmail" {% if transport.transport_type == 'gmail' %}checked="checked"{% endif %} />
						Google Apps
					</label>
					<div class="dp-group-options" style="display: none">
						<table cellspacing="0" cellpadding="0" width="100%">
							<tr>
								<td width="120">Full Email Address:</td>
								<td>{{ form_widget(form.gmail_options.username, {'attr': {'class': 'small'}}) }}</td>
							</tr>
							<tr>
								<td>Password:</td>
								<td>{{ form_widget(form.gmail_options.password, {'attr': {'class': 'small'}}) }}</td>
							</tr>
						</table>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="dp-form-row-group" data-element-handler="DeskPRO.Admin.ElementHandler.RadioExpander" data-group-class="dp-input-group" data-expand-class="dp-group-options">
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>Backup Account</label>
				<span class="test-button test-account-settings backup" {% if not transport.backup_transport_type %}style="display: none"{% endif %}><span class="lightning-small-icon"></span> Test Settings</span>
			</div>
			<div class="dp-form-input">
				<div class="dp-input-group">
					<label>
						<input type="radio" class="option-trigger transport-type-backup none" name="transport[backup_transport_type]" value="mail" {% if not transport.backup_transport_type %}checked="checked"{% endif %} />
						Do not use a backup account
					</label>
				</div>

				<div class="dp-input-group">
					<label>
						<input type="radio" class="option-trigger transport-type-backup" name="transport[backup_transport_type]" value="mail" {% if transport.backup_transport_type == 'mail' %}checked="checked"{% endif %} />
						PHP mail()
					</label>
				</div>

				<div class="dp-input-group">
					<label>
						<input type="radio" class="option-trigger transport-type-backup" name="transport[backup_transport_type]" value="smtp" {% if transport.backup_transport_type == 'smtp' %}checked="checked"{% endif %} />
						SMTP Account
					</label>
					<div class="dp-group-options" style="display: none">
						<table cellspacing="0" cellpadding="0" width="100%">
							<tr>
								<td width="80">Host:</td>
								<td>
									{{ form_widget(form.backup_smtp_options.host, {'attr': {'class': 'small'}}) }}<br />
								</td>
							</tr>
							<tr>
								<td>Secure:</td>
								<td>{{ form_widget(form.backup_smtp_options.secure, {'attr': {'class': 'small'}}) }}</td>
							</tr>
							<tr>
								<td>Port:</td>
								<td>{{ form_widget(form.backup_smtp_options.port, {'attr': {'class': 'small', 'style': 'width: 100px'}}) }}</td>
							</tr>
							<tr>
								<td>Username:</td>
								<td>{{ form_widget(form.backup_smtp_options.username, {'attr': {'class': 'small'}}) }}</td>
							</tr>
							<tr>
								<td>Password:</td>
								<td>{{ form_widget(form.backup_smtp_options.password, {'attr': {'class': 'small'}}) }}</td>
							</tr>
						</table>
					</div>
				</div>

				<div class="dp-input-group">
					<label>
						<input type="radio" class="option-trigger transport-type-backup" name="transport[backup_transport_type]" value="gmail" {% if transport.backup_transport_type == 'gmail' %}checked="checked"{% endif %} />
						Google Apps
					</label>
					<div class="dp-group-options" style="display: none">
						<table cellspacing="0" cellpadding="0" width="100%">
							<tr>
								<td width="120">Full Email Address:</td>
								<td>{{ form_widget(form.backup_gmail_options.username, {'attr': {'class': 'small'}}) }}</td>
							</tr>
							<tr>
								<td>Password:</td>
								<td>{{ form_widget(form.backup_gmail_options.password, {'attr': {'class': 'small'}}) }}</td>
							</tr>
						</table>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<button class="clean-white">Save</button>
</form>

<div id="test_settings_overlay" style="width: 400px; height: 200px; overflow:auto; display: none;">
	<div class="overlay-title">
		<span class="close-overlay close-trigger"></span>
		<h4>Test Outgoing Email</h4>
	</div>
	<div class="overlay-content">
		<div style="margin-bottom: 3px;">Send a test email to: <input type="text" class="small" name="send_to" value="{{ app.user.primaryEmailAddress() }}" /></div>
		From email address: <input type="text" class="small" name="send_from" id="test_send_from" value="" />
		<div class="result">
			<div class="is-loading loading-icon-big"><br /><br /></div>
			<div class="is-not-loading">
				<div class="success">
					No errors were reported, but you should confirm that you recieved the test email.
				</div>
				<div class="error">
					There was an error while trying to send the test email: <span class="error-msg"></span>
				</div>
			</div>
		</div>
	</div>
	<div class="overlay-footer">
		<button
			class="clean-white test-trigger"
			data-url="{{ path('admin_emailtrans_testaccount') }}"
		>Test Now</button>
	</div>
</div>

{% endblock %}
