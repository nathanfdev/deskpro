{% macro block_sections() %}
	<div class="block-sections">
		<ul>
{% endmacro %}
{% macro block_sections_end() %}
		</ul>
	</div>
{% endmacro %}

{% macro block_sections_item() %}
	<li>
{% endmacro %}
{% macro block_sections_item_end() %}
	</li>
{% endmacro %}



{% macro structure_table(options) %}
	<div class="structure-table">
		<table
			{% if options.id %}id="{{ options.id }}"{% endif %}
			cellspacing="0"
			cellpadding="0"
			width="100%"
			border="0"
			class="{% if options.save_order_url %}with-reorderable{% endif %} structure-list"
			{% if options.save_order_url %}data-reorder-save-url="{{ options.save_order_url }}"{% endif %}
		>
{% endmacro %}

{% macro structure_table_end() %}
		</table>
	</div>
{% endmacro %}
