{% extends 'AdminBundle:CustomDefAbstract:edit.html.twig' %}
{% block pagetitle %}
	<h1>
		{% if field.id %}
			Edit Field: {{ field.title }}
		{% else %}
			New Field: {{ phrase(field.getHandlerClassPhrase()) }}
		{% endif %}
	</h1>
	<nav>
		<a class="clean-white" href="{{ path('admin_customdefpeople') }}">Back to list</a>
	</nav>
{% endblock %}
