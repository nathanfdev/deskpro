{% extends 'AdminBundle::layout_popout.html.twig' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/GeneralEdit.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
	window.DeskPRO_Page = new DeskPRO.Admin.PageHandler.GeneralEdit('workflow', {{workflow.id|default(0)}}, 'DeskPRO_Page_TicketWorkflows');

	{% if row_html %}
		window.DeskPRO_Page.updateParentListRow({{ row_html|json_encode|raw }});
	{% endif %}
}
</script>
{% endblock %}
{% block page_id "ticket_workflows" %}
{% block header %}
	<h1>{% if workflow.id %}Edit Workflow{% else %}New Workflow{% endif %}</h1>
{% endblock %}
{% block content %}

<form action="{{ path('admin_ticketworks_edit', {'workflow_id': workflow.id|default(0)}) }}" method="post">
{{ form_hidden(form) }}
<input type="hidden" name="process" value="1" />

<div class="form-panel">
	<div class="row">
		<label>Title</label>
		{{ form_field(form.title) }}
	</div>
</div>

<br /><br />

</form>
{% endblock %}
{% block footer %}
	<button class="dp-button small save-trigger">Save</button>

{% endblock %}