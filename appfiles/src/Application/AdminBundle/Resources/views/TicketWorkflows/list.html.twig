{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block pagetitle %}
	<h1>Ticket Workflows</h1>
	<nav>
		<a class="clean-white" href="{{ path('admin_ticketworks_edit', {'workflow_id': '0'}) }}">Create New Workflow</a>
	</nav>
{% endblock %}
{% block prepage %}
	Ticket workflows give you the ability to describe the current state the ticket may
	be in outside of the usual helpdesk status. For example, "Waiting for funds."
{% endblock %}
{% block content %}
<div class="dp-page-box">

<div class="page-content">
	{{ design.structure_table({ 'save_order_url': path('admin_ticketworks_updateorders') }) }}
		{% for workflow in all_workflows %}
		{% include 'AdminBundle:TicketWorkflows:list-row.html.twig' %}
	{% endfor %}
	{{ design.structure_table_end() }}
</div>

</div>
{% endblock %}
