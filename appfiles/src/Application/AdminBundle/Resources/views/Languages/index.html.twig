{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% extends 'AdminBundle::layout.html.twig' %}
{% block pagetitle %}
	<h1>Languages</h1>
	<nav>
		<a class="clean-white" href="{{ path('admin_langs_newlang') }}">Create New Language</a>
	</nav>
{% endblock %}
{% block page %}
<h1>Languages</h1>
<ul class="item-list">
	{% for lang in languages %}
		<li>
			<div class="dp-block-controls">
				<ul>
					<li class="dp-edit">
						<a href="{{ path('admin_langs_editlang', {'language_id': lang.id}) }}" class="popout-trigger"><span></span></a>
					</li>
				</ul>
			</div>
			<label>{{ lang.title }}</label>
		</li>
	{% endfor %}
</ul>
{% endblock %}
