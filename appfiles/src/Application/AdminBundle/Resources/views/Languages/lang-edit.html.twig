{% extends 'AdminBundle:Languages:lang-layout.html.twig' %}
{% block pagetitle %}
	<h1>{{ language.title }}</h1>
{% endblock %}
{% block page %}

<form action="{{ path('admin_langs_editlang', {'language_id': language.id|default(0)}) }}" method="post">
<input type="hidden" name="process" value="1" />

<div class="dp-form">
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Title</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.title) }}
		</div>
	</div>
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Locale</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.locale) }}
		</div>
	</div>
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Language Pack</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.language_package) }}
		</div>
	</div>
</div>

<button class="clean-white">Save</button>

</form>

{% if language.id != 1 %}
	<div style="width: 70%; text-align: right">
		<a class="delete-link" href="{{ path('admin_langs_dellang', {'language_id': language.id}) }}" onclick="return confirm('Are you sure you want to delete this language? Custom phrases will be removed, and things (e.g., tickets) classified using this language will have their language unset.');">Delete Language</a>
	</div>
{% endif %}

{% endblock %}
