{% extends 'AdminBundle:Languages:lang-layout.html.twig' %}
{% block pagetitle %}
	<h1>{{ language.title }}</h1>
{% endblock %}
{% block page %}

<form action="{{ path('admin_langs_editlang', {'language_id': language.id|default(0)}) }}" method="post">
<input type="hidden" name="process" value="1" />

<div class="dp-form">
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Title</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.title) }}
		</div>
	</div>
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Locale</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.locale) }}
		</div>
	</div>
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Language Pack</label>
		</div>
		<div class="dp-form-input">
			{{ form_widget(form.language_package) }}
		</div>
	</div>
</div>

<button class="clean-white">Save</button>

</form>

{% endblock %}
