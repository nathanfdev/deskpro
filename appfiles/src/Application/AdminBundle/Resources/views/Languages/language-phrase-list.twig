{% extends 'AdminBundle::layout.twig.html' %}
{% block content %}

<div class="block" id="block-tables">
	<div class="content">
		<h2 class="title">Phrases</h2>
		<div class="inner">
			{% for group, phrases in all_phrases %}
				<table class="table">
					<tr>
						<th class="first" colspan="4">{{group}}</th>
					</tr>
					{% for phrase_name, phrase in phrases %}
						<tr>
							<td width="10"><!--TODO: Icon--></td>
							<td>{{phrase_name}}</td>
							<td>{{phrase}}</td>
							<td width="50" style="text-align: right;"><a href="{{ path('admin_langs_editphrase', {'lang_id': lang.id, 'phrase_name': phrase_name}) }}">Edit</a>
						</tr>
					{% endfor %}
				</table>
			{% endfor %}
		</div>
	</div>
</div>

{% endblock %}
{% block sidebar %}

{% endblock %}