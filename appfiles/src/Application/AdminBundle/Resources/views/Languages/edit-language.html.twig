{% extends 'AdminBundle::layout_popout.html.twig' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/LanguageEdit.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
	window.DeskPRO_Page = new DeskPRO.Admin.PageHandler.LanguageEdit({{language.id|default(0)}});

	{% if row_html %}
		window.DeskPRO_Page.updateParentListRow({{ row_html|json_encode|raw }});
	{% endif %}
}
</script>
{% endblock %}
{% block header %}
	<h1>{% if language.id %}Edit Language{% else %}New Language{% endif %}</h1>
{% endblock %}
{% block content %}

<form action="{{ path('admin_langs_editlang', {'language_id': language.id|default(0)}) }}" method="post">
<input type="hidden" name="process" value="1" />

<div class="form-panel">
	<div class="row">
		<label>Title</label>
		{{ form_field(form.title) }}
	</div>
	{% if form.parent_id %}
		<div class="row">
			<label>Parent language</label>
			{{ form_field(form.parent_id) }}
		</div>
	{% endif %}
</div>

<br /><br />

</form>
{% endblock %}
{% block footer %}
	<button class="dp-button green save-trigger">Save</button>
	<button class="dp-button gray cancel-trigger">Cancel</button>
{% endblock %}