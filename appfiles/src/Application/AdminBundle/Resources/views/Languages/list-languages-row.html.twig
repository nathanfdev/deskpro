<li class="language language-{{language.id}}" data-language-id="{{language.id}}">
	<div style="float:right">
		<ul class="controls">
			<li class="edit edit-trigger"><a href="{{ path('admin_langs_editlang', {'language_id': language.id}) }}" class="popout-trigger" data-height="300">edit</a></li>
			<li class="view"><a href="{{ path('admin_langs_phrases', {'language_id': language.id}) }}">edit phrases</a></li>
		</ul>
	</div>
	<div>
		<div {% if language.depth %}language="margin-left: {{ language.depth * 10 }}"{% endif %}>
		<strong>{{language.title}}</strong>
		{% if language.note %}
			<br />
			<small>{{language.note}}</small>
		{% endif %}
	</div>
</li>