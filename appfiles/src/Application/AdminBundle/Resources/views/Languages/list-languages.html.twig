{% extends 'AdminBundle::layout.html.twig' %}
{% block section 'crm' %}
{% block sub_section 'usergroups' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/LanguagesList.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
	window.DeskPRO_Page = new DeskPRO.Admin.PageHandler.LanguagesList();
}
</script>
{% endblock %}
{% block content %}

<div style="text-align:right; padding-bottom: 10px;">
	<a class="icon tickets popout-trigger" href="{{ path('admin_langs_editlang', {'language_id': '0'}) }}" data-height="350">Create New Language</a>
</div>

<ul class="item-list">
	{% for language in language_hierarchy %}
		{% include 'AdminBundle:Languages:list-languages-row.html.twig' %}
	{% endfor %}
</ul>

{% endblock %}