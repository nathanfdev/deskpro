{% extends 'AdminBundle::layout.html.twig' %}
{% block page_nav %}
	<section>
		<header>
			<h4>Banning</h4>
		</header>
		<article>
			<ul>
				<li class="{% if this_page == 'ban_emails' %}on{% endif %}">
					<span class="count" id="ban_count_emails">{{ counts.emails|default(0) }}</span>
					<a href="{{ path('admin_banning_emails') }}">Email Addresses</a>
				</li>
				<li class="{% if this_page == 'ban_ips' %}on{% endif %}">
					<span class="count" id="ban_count_ips">{{ counts.ips|default(0) }}</span>
					<a href="{{ path('admin_banning_ips') }}">IP Addresses</a>
				</li>
			</ul>
		</article>
	</section>
{% endblock %}
