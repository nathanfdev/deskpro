{% extends 'AdminBundle::layout.html.twig' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/Banning.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
	window.DeskPRO_Page = new DeskPRO.Admin.PageHandler.Banning();
}
</script>
{% endblock %}
{% block sub_section 'labels' %}
{% block content %}

<div class="table-list-wrap">
	<a class="icon tickets create-link popout-trigger" id="new_ip_ban_btn">New IP Ban</a>
	<h2>Banned IP Addresses</h2>
	<table class="table-list" cellspacing="0" cellpadding="0" width="100%">
		<tbody id="ip_rows">
			{% for ip in banned_ips %}
				{% include 'AdminBundle:Banning:ip-row.html.twig' %}
			{% endfor %}
		</tbody>
	</table>
</div>

<br />

<div class="table-list-wrap">
	<a class="icon tickets create-link popout-trigger" id="new_email_ban_btn">New Email Ban</a>
	<h2>Banned Email Addresses</h2>
	<table class="table-list" cellspacing="0" cellpadding="0" width="100%">
		<tbody id="email_rows">
			{% for email in banned_emails %}
				{% include 'AdminBundle:Banning:email-row.html.twig' %}
			{% endfor %}
		</tbody>
	</table>
</div>

<div id="ip_ban_overlay" class="overlay" style="display:none">
	<input type="hidden" class="save-url" value="{{ path('admin_banning_newip') }}?ip={ip}" />

	Ban IP Address: <input type="text" name="ip" value="" style="width: 200px;" />
	<br />
	<small>Examples: 192.168.1.1 or 192.168.*</small>

	<div style="text-align:center; margin-top: 15px;">
		<button class="dp-button x-small green save-trigger">Save Ban</button>
	</div>
</div>

<div id="email_ban_overlay" class="overlay" style="display:none">
	<input type="hidden" class="save-url" value="{{ path('admin_banning_newemail') }}?email={email}" />

	Ban IP Address: <input type="text" name="email" value="" style="width: 200px;" />
	<br />
	<small>Examples: baduser@example.com, *@spammy-domain.com, *@spammy-domain.*</small>

	<div style="text-align:center; margin-top: 15px;">
		<button class="dp-button x-small green save-trigger">Save Ban</button>
	</div>
</div>

{% endblock %}