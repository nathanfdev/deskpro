{% extends 'AdminBundle::layout.html.twig' %}
{% block pagebar %}
	<nav>
		<ul>
			<li><a href="{{ path('admin_license_input') }}">Change License Code</a></li>
		</ul>
	</nav>
	<ul>
		<li>Your License</li>
	</ul>
{% endblock %}
{% block page %}

<div class="dp-form">
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>License ID</label>
		</div>
		<div class="dp-form-input">
			{{ lic.getLicenseId() }}
		</div>
	</div>
	{% if lic.isDemo() %}
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>Demo</label>
			</div>
			<div class="dp-form-input">
				This is a fully-functional demo license with no limitations on the number of agents.
			</div>
		</div>
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>Demo Expiry</label>
			</div>
			<div class="dp-form-input">
				This demo will expire on {{ lic.getExpireDate()|date('M j, Y') }}. Contact <a href="mailto:support@deskpro.com">support@deskpro.com</a> if you need more time.
			</div>
		</div>
	{% else %}
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>Agents</label>
			</div>
			<div class="dp-form-input">
				{% if not lic.getMaxAgents() %}
					Unlimited
				{% else %}
					{{ lic.getMaxAgents() }}
				{% endif %}
			</div>
		</div>
	{% endif %}
</div>

{% endblock %}
