{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% extends 'AdminBundle::layout.html.twig' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/GeneralList.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
</script>
{% endblock %}
{% block pagetitle %}
	<nav>
		<button class="clean-white ">Create New Priority</button>
	</nav>
	Ticket Priorities
{% endblock %}
{% block prepage %}
	Ticket priorities offer a way for you to set the importance of a ticket.
{% endblock %}
{% block content %}

<div class="page-content">
	{{ design.structure_list({'no_reorder': true}) }}
		{% for priority in all_priorities %}
			{% include 'AdminBundle:TicketPriorities:list-row.html.twig' %}
		{% endfor %}
	{{ design.structure_list_end() }}
</div>

{% endblock %}
