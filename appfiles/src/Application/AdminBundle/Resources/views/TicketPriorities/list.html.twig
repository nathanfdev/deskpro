{% extends 'AdminBundle::layout_popout.html.twig' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/GeneralList.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
	window.DeskPRO_Page_TicketPriorities = new DeskPRO.Admin.PageHandler.GeneralList('#ticket_priorities');
};
</script>
{% endblock %}
{% block page_id "ticket_priorities" %}
{% block content %}

<div style="text-align:right; padding-bottom: 10px;">
	<a class="icon tickets popout-trigger" href="{{ path('admin_ticketpris_edit', {'priority_id': '0'}) }}" data-height="350" data-width="400">Create New Priority</a>
</div>

<ul class="item-list">
	{% for priority in all_priorities %}
		{% include 'AdminBundle:TicketPriorities:list-row.html.twig' %}
	{% endfor %}
</ul>

{% endblock %}