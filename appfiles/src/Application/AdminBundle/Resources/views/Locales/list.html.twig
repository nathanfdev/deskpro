{% extends 'AdminBundle::layout.html.twig' %}
{% block section 'crm' %}
{% block sub_section 'usergroups' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/TicketCategoriesList.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
	window.DeskPRO_Page = new DeskPRO.Admin.PageHandler.TicketCategoriesList();
}
</script>
{% endblock %}
{% block content %}

<div style="text-align:right; padding-bottom: 10px;">
	<a class="icon tickets popout-trigger" href="{{ path('admin_locales_edit', {'locale_id': '0'}) }}" data-height="350" data-width="400">Create New Locale</a>
</div>

<ul class="item-list">
	{% for locale in all_locales %}
		{% include 'AdminBundle:Locales:list-row.html.twig' %}
	{% endfor %}
</ul>

{% endblock %}