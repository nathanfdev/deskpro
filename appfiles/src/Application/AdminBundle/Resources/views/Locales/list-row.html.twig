<li class="locale locale-{{locale.id}}" data-locale-id="{{locale.id}}">
	<div style="float:right">
		<ul class="controls">
			<li class="edit edit-trigger"><a href="{{ path('admin_locales_edit', {'locale_id': locale.id}) }}" class="popout-trigger" data-height="350" data-width="400">edit</a></li>
		</ul>
	</div>
	<div>
		<strong>{{locale.title}}</strong> ({{locale.locale}})
		<br /><small>Using language: <a href="{{ path('admin_langs_phrases', {'language_id': locale.language.id}) }}">{{locale.language.title}}</a></small>
	</div>
</li>