{% extends 'AdminBundle::layout_subpage.html.twig' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/GeneralList.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
window._page_exec_stack.push(function() {
	window.DeskPRO_Page_CustomDefTickets = new DeskPRO.Admin.PageHandler.GeneralList('#custom_def_tickets');
});
</script>
{% endblock %}
{% block page_id "custom_def_tickets" %}
{% block content %}

<div style="text-align: right">
	<a class="dp-button green popout-trigger" href="{{ path(route_basename~'new_choosetype') }}">Create New Field</a>
	<br /><br />
</div>

<ul class="item-list">
	{% for field in fields %}
		{% include 'AdminBundle:CustomDefAbstract:list-row.html.twig' %}
	{% else %}
		<li>
			You have no custom fields defined.
		</li>
	{% endfor %}
</ul>

{% endblock %}
{% block sidebar %}
{% endblock %}