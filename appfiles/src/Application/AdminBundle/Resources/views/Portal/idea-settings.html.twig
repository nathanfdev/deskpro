{% set this_page = 'idea_settings' %}
{% extends 'AdminBundle:Portal:layout.html.twig' %}
{% block pagetitle %}
	<h1>Ideas Settings</h1>
{% endblock %}
{% block page %}
<div class="setting_field_row">
	<h4>User Submission</h4>
	<div class="setting_fields">
		<div class="field_row">
			<label><input type="checkbox" name="settings[core.helpdesk_enabled]" {% if app.getSetting('core.helpdesk_enabled') %}checked="checked"{% endif %} />
				Allow users to submit ideas</label>
			<label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<input type="checkbox" name="settings[core.helpdesk_enabled]" {% if app.getSetting('core.helpdesk_enabled') %}checked="checked"{% endif %} />
				Require users to log in or register before they can submit ideas</label>
			<label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<input type="checkbox" name="settings[core.helpdesk_enabled]" {% if app.getSetting('core.helpdesk_enabled') %}checked="checked"{% endif %} />
				Require users to validate their email addresses before an idea is visible</label>
			<label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<input type="checkbox" name="settings[core.helpdesk_enabled]" {% if app.getSetting('core.helpdesk_enabled') %}checked="checked"{% endif %} />
				Require all ideas to be manually validated by agents</label>
			<label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<input type="checkbox" name="settings[core.helpdesk_enabled]" {% if app.getSetting('core.helpdesk_enabled') %}checked="checked"{% endif %} />
				Show a CAPTCHA on submission form</label>
		</div>
	</div>
</div>

<footer class="setting_field_row" style="text-align: center">
	<button class="clean-white">Save Settings</button>
</footer>

{% endblock %}
