{% set this_page = 'portal_editor' %}
{% set admin_page_class = 'with-top' %}
{% extends 'AdminBundle:Portal:layout.html.twig' %}
{% block html_head %}
	<script src="{{ asset('vendor/codemirror/codemirror.js') }}" type="text/javascript"></script>
	<link rel="stylesheet" href="{{ asset('vendor/codemirror/codemirror.css') }}" type="text/css" />
	<link rel="stylesheet" href="{{ asset('vendor/codemirror/default.css') }}" type="text/css" />

	<script src="{{ asset('vendor/colorpicker/js/colorpicker.js') }}" type="text/javascript"></script>
	<script src="{{ asset('vendor/colorpicker/js/eye.js') }}" type="text/javascript"></script>
	<script src="{{ asset('vendor/colorpicker/js/utils.js') }}" type="text/javascript"></script>
	<link rel="stylesheet" href="{{ asset('vendor/colorpicker/css/colorpicker.css') }}" type="text/css" />
{% endblock %}
{% block page_nav_portal %}
	{% if app.getSetting('user.portal_enabled') %}
	<div style="text-align: center; padding-top: 4px;">
		<button class="clean-white" id="portal_colors_trigger"><span>Color Editor</span></button>
	</div>
	{% endif %}
{% endblock %}
{% block pagebar %}
	<ul>
		<li>Portal</li>
	</ul>
{% endblock %}
{% block pagebar_after %}
	<div class="portal-toggle">
		{% if app.getSetting('user.portal_enabled') %}
			<a class="toggle-btn" href="{{ path('admin_portal_toggle', {enable: '0'}) }}"><em>Click to disable</em></a>
		{% else %}
		<a class="toggle-btn disabled" href="{{ path('admin_portal_toggle', {enable: '1'}) }}"><em>Click to enable</em></a>
		{% endif %}
		<p>If you do not want a public facing website you can disable the portal. You will still be able to accept tickets from the email gateways,
		and use HTML widgets on your website, but the user portal will be disabled and traces of the public website such as links in emails
		will be removed.</p>
	</div>
{% endblock %}
{% block content %}
{% include 'AdminBundle:Portal:portal-color-editor.html.twig' %}

	{% if app.getSetting('user.portal_enabled') %}
		<div
			class="dp-page-box"
			id="admin_portal_editor"
			data-element-handler="DeskPRO.Admin.ElementHandler.PortalEditor"
			data-portal-url="{{ app.request.getBaseUrl() }}/?admin_portal_controls=1"
			data-url-update-orders="{{ path('admin_portal_updateblockorder') }}"
			data-url-block-toggle="{{ path('admin_portal_blocktoggle', {pid: '_PID_'}) }}"
		>
			<div id="portal_iframe_loading"><h1>Loading Editor</h1></div>
			<iframe id="portal_iframe" frameborder="0" marginheight="0" marginwidth="0" scrolling="no" style="border:0;margin:0;padding:0;"></iframe>

			<script type="text/x-deskpro-tmpl" id="admin_portal_block_html_edit_tpl">
				<section class="dp-html-editor">
					<div class="overlay-title">
						<span class="close-overlay close-trigger"></span>
						<h4>Edit</h4>
					</div>
					<div class="overlay-content">
						<textarea></textarea>
					</div>
					<div class="overlay-footer">
						<button class="save-trigger clean-white">Save</button>
					</div>
				</section>
			</script>
		</div>
	{% else %}
		<div class="dp-page-box">
			<div class="editor-disabled">
				<p>
					The portal is currently disabled. This means you have turned off your public facing website
					at {{ app.getSetting('core.deskpro_url') }}.
				</p>
				<p>
					Click the button above to re-enable the portal. Or use HTML widgets from the <a href="{{ path('admin_tickets_editor') }}">ticket editor</a>
					to embed DeskPRO into your own site.
				</p>
			</div>
		</div>
	{% endif %}
{% endblock %}
