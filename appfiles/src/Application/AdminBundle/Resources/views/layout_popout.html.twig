<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
<head>
	<link rel="shortcut icon" href="{{ path('favicon', {}, true) }}" />
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
	<title>DeskPRO</title>

	<link rel="stylesheet" href="{{ asset('vendor/jquery/jquery-ui/css/smoothness/jquery-ui.css') }}" type="text/css" media="screen"  />
	<link rel="stylesheet" href="{{ asset('javascripts/DeskPRO/UI/ui.css') }}" type="text/css" media="screen" />

	<link rel="stylesheet" href="{{ asset('stylesheets/agent/common.css') }}" type="text/css" media="screen" />
	<link rel="stylesheet" href="{{ asset('stylesheets/agent/ui-layout.css') }}" type="text/css" media="screen" />
	<link rel="stylesheet" href="{{ asset('stylesheets/agent/window-elements.css') }}" type="text/css" media="screen" />
	<link rel="stylesheet" href="{{ asset('stylesheets/agent/admin/interface-popout.css') }}" type="text/css" media="screen" />

	<!--[if IE 8]>
	<link rel="stylesheet" href="{{ asset('stylesheets/agent/interface-ie.css') }}" type="text/css" media="screen" />
	<![endif]-->

	<style type="text/css">
		html,body {
			height: 100%;
		}

		body.popout #pane_shell {
			top: 0;
		}

		body.popout #content_wrap {
			max-width: 10000px;
		}
	</style>

	<script src="{{ asset('build/agent-vendors.js') }}"></script>

	<script src="{{ asset('javascripts/Orb/Orb.js') }}"></script>
	<script src="{{ asset('javascripts/Orb/Class.js') }}"></script>
	<script src="{{ asset('javascripts/Orb/Util/Options.js') }}"></script>
	<script src="{{ asset('javascripts/Orb/Util/Events.js') }}"></script>
	<script type="text/javascript" src="{{ asset('javascripts/Orb/Compat.js') }}"></script>

	<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/UI/Overlay.js') }}"></script>
	<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/UI/Menu.js') }}"></script>

	<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Form/InlineEdit.js') }}"></script>
	<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Form/RuleBuilder.js') }}"></script>

	<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/MessageBroker.js') }}"></script>

	<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/Window.js') }}"></script>
	<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PopoutWindow.js') }}"></script>
	<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/Basic.js') }}"></script>

	<script type="text/javascript" charset="utf-8">
		var DP_TINYMCE_URL = '{{ asset('javascripts/tiny_mce/tiny_mce.js') }}';
		var BASE_URL = '{{ path('user') }}';
		var ASSETS_BASE_URL = '{{ asset('') }}';
		if (!window.DESKPRO_URL_REGISTRY) window.DESKPRO_URL_REGISTRY = {};

		window._page_exec_stack = [];
		function _win_exec() {
			window.DeskPRO_Window = new DeskPRO.Admin.PopoutWindow();
			if (window._page_exec) {
				window._page_exec_stack.push(_page_exec);
			}

			for (var i = 0; i < window._page_exec_stack.length; i++) {
				window._page_exec_stack[i]();
			}

			if (window.DeskPRO_Page) {
				DeskPRO_Page.initPage();
			}

			// Init all others too
			var re = /^DeskPRO_Page_/;
			for (i in window) {
				if (re.test(i)) {
					window[i].initPage();
				}
			}
		}

		{% block html_headjs_load %}{% endblock %}

		$(document).ready(function() {
			_win_exec();
		});
	</script>
	{% block html_head %}{% endblock %}
	{% block page_js_exec %}{% endblock %}
</head>
<body id="{% block page_id %}{% endblock %}" class="{% block body_class %}{% endblock %} popout">
<div class="wrap ui-layout-center">
<div id="header">{% block header %}{% endblock %}</div>

<div id="content" class="ui-layout-content" style="padding: 10px;">{% block content %}{% endblock %}</div>

{% set footer_block %}{% block footer %}{% endblock %}{% endset %}
{% if footer_block %}<div id="footer">{{footer_block|raw}}</div>{% endif %}

</div>
</body>
</html>

