{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block pagetitle %}
	<h1>Test Page</h1>
{% endblock %}
{% block page %}

{{ design.dpgrid() }}
	{{ design.dpgrid_headerrow() }}
		{{ design.dpgrid_headercol({ class: 'l r tl tr', style: "width: 700px;"}) }}
			<h1>Department</h1>
		{{ design.dpgrid_headercol_end() }}
		{{ design.dpgrid_headercol({ class: 'l r tl tr l-margin r-margin', style: "width: 85px"}) }}
			<h1>Tickets</h1>
		{{ design.dpgrid_headercol_end() }}
		{{ design.dpgrid_headercol({ class: 'l r tl tr', style: "width: 85px"}) }}
			<h1>Chat</h1>
		{{ design.dpgrid_headercol_end() }}
	{{ design.dpgrid_headerrow_end() }}

	{{ design.dpgrid_content() }}
		{{ design.dpgrid_col({ class: 'l r', style: "width: 700px;"}) }}
			Department
		{{ design.dpgrid_col_end() }}

		{{ design.dpgrid_col({ class: 'l r l-margin r-margin alt', style: "width: 85px"}) }}
			Tickets
		{{ design.dpgrid_col_end() }}

		{{ design.dpgrid_col({ class: 'l r alt', style: "width: 85px"}) }}
			Chat
		{{ design.dpgrid_col_end() }}
	{{ design.dpgrid_content() }}
{{ design.dpgrid_end() }}


<Br />
<Br /><Br /><Br /><Br /><Br /><Br /><Br /><Br />
<button class="clean-white" id="open_overlay_btn">Open Overlay</button>

{#
	- overlay-title and overlay-footer are optional
	- you must always specify a width/height on the wrapper, if you need it to be dynamic
	then you'll need to hack that in using the events on Overlay
	- the inner content must always be called overlay-content
#}
<div id="overlay_wrapper" style="width: 400px; height: 400px; display: none;">
	<div class="overlay-title">
		<span class="close-overlay"></span>
		<h4>Overlay Title</h4>
	</div>
	<div class="overlay-content">
		<p>Overlay Content</p>
	</div>
	<div class="overlay-footer">
		<button class="clean-white">Overlay Footer</button>
	</div>
</div>


<script type="text/javascript">
	$(document).ready(function() {
		var overlay = new DeskPRO.UI.Overlay({
			triggerElement: $('#open_overlay_btn'),
			contentElement: $('#overlay_wrapper')
		});
	});
</script>
{% endblock %}
