<body class="{% if is_demo %}is-demo{% endif %}">

<!-- BEGIN HEADER BAR -->
<div id="dp_header">
	<div id="dp_header_logo">
		<h1>Admin</h1>
	</div>
	<!-- BEGIN SEARCH SECTION -->
	<div id="dp_omnibox_wrap">
		<div id="dp_omnibox">
			<div class="searchBoxWrap">
				<input id="dpsearchbox" type="text" value="" name="search" autocomplete="off" />
			</div>
		</div>
	</div>
	<!-- END SEARCH SECTION -->

	<!-- BEGIN USER SECTION -->
	<div id="DP-UserSection">
		<div id="DP-userControl">
			<div class="currentUserAvatar">
				<div class="userWrapper">
					<a onclick="toggle_visibility('userSetting');"><img src="{{ app.user.getPictureUrl(20) }}" alt="" /></a>
				</div>
				<span class="dropdownIcon" onclick="toggle_visibility('userSetting');"></span>
			</div>
		</div>
		<!-- Header - User Control Dropdown -->
		<div id="userSetting" style="display:none;">
			<div class="userProfileDropdown" >
				<div class="userProfileDropdownHeader">
					<a onclick="toggle_visibility('userSetting');"><img src="{{ app.user.getPictureUrl(20) }}" alt="" /></a>
				</div>
				<ul>
					<li class="logggedAs"><p>Logged in as</p></li>
					<li class="currentUsername"><p>{{ app.user.display_name }}</p></li>
					<li class="setting" id="user_settings_link"><a>Settings</a></li>
					<li class="help"><a>Help</a></li>
					<li class="logout"><a href="{{ path('agent_logout') }}">Log out</a></li>
				</ul>
			</div>
		</div>
	<!-- END USER SECTION -->
	</div>

	<!-- BEGIN INTERFACE SECTION -->
	<div id="DP-InterfaceSwitcher">
		<div class="DP-adminSwitch">
			<div class="adminSwitcher">
				<a onclick="toggle_visibility('interfacesToggle');">Agent Interface<span class="dropdownIcon"></span></a>
			</div>
		</div>
		<!-- Header - Switch Button Interfaces- Dropdown -->
		<div id="interfacesToggle" style="display:none;">
		<div class="dropdownSwitcherWrap"  onclick="toggle_visibility('interfacesToggle');">
			<div class="switcherHeader">
				<a><span>Agent Interface</span></a>
			</div>
			<ul>
				<li><a class="admin" href="{{ path('admin') }}"><span class="check">Admin Interface</span></a></li>
				<li><a class="billing" href=""><span class="check">Billing Interface</span></a></li>
				<li><a class="report" href=""><span class="check">Report Interface</span></a></li>
				<li><a class="portal" href="{{ path('user') }}"><span class="check">User Interface</span></a></li>
			</ul>
		</div>
		</div>
	</div>
	<!-- END INTERFACE SECTION -->
</div>
