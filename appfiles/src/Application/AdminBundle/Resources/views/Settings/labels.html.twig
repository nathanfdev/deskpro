{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block pagebar %}
	<ul>
		<li>Labels</li>
	</ul>
{% endblock %}
{% block page_nav %}
<div>
	<section class="top">
		<header>
			<h4>Label Types</h4>
		</header>
		<article>
			<ul>
				<li class="{% if label_type == 'all' %}on{% endif %}">
					<span class="count" id="labels_count_all">{{ def_counts.TOTAL|default(0) }}</span>
					<a href="{{ path('admin_labels', {'label_type': 'all'}) }}">All</a>
				</li>
				<li class="{% if label_type == 'articles' %}on{% endif %}">
					<span class="count" id="labels_count_articles">{{ def_counts.articles|default(0) }}</span>
					<a href="{{ path('admin_labels', {'label_type': 'articles'}) }}">Articles</a>
				</li>
				<li class="{% if label_type == 'deals' %}on{% endif %}">
					<span class="count" id="labels_count_deals">{{ def_counts.deals|default(0) }}</span>
					<a href="{{ path('admin_labels', {'label_type': 'deals'}) }}">Deals</a>
				</li>
				<li class="{% if label_type == 'downloads' %}on{% endif %}">
					<span class="count" id="labels_count_downloads">{{ def_counts.downloads|default(0) }}</span>
					<a href="{{ path('admin_labels', {'label_type': 'downloads'}) }}">Downloads</a>
				</li>
				<li class="{% if label_type == 'feedback' %}on{% endif %}">
					<span class="count" id="labels_count_feedback">{{ def_counts.feedback|default(0) }}</span>
					<a href="{{ path('admin_labels', {'label_type': 'feedback'}) }}">Feedback</a>
				</li>
				<li class="{% if label_type == 'news' %}on{% endif %}">
					<span class="count" id="labels_count_news">{{ def_counts.news|default(0) }}</span>
					<a href="{{ path('admin_labels', {'label_type': 'news'}) }}">News</a>
				</li>
				<li class="{% if label_type == 'organizations' %}on{% endif %}">
					<span class="count" id="labels_count_organizations">{{ def_counts.organizations|default(0) }}</span>
					<a href="{{ path('admin_labels', {'label_type': 'organizations'}) }}">Organizations</a>
				</li>
				<li class="{% if label_type == 'people' %}on{% endif %}">
					<span class="count" id="labels_count_people">{{ def_counts.people|default(0) }}</span>
					<a href="{{ path('admin_labels', {'label_type': 'people'}) }}">People</a>
				</li>
				<li class="{% if label_type == 'tasks' %}on{% endif %}">
					<span class="count" id="labels_count_tasks">{{ def_counts.tasks|default(0) }}</span>
					<a href="{{ path('admin_labels', {'label_type': 'tasks'}) }}">Tasks</a>
				</li>
				<li class="{% if label_type == 'tickets' %}on{% endif %}">
					<span class="count" id="labels_count_tickets">{{ def_counts.tickets|default(0) }}</span>
					<a href="{{ path('admin_labels', {'label_type': 'tickets'}) }}">Tickets</a>
				</li>
			</ul>
		</article>
	</section>
</div>
{% endblock %}
{% block page %}
<div
	data-element-handler="DeskPRO.Admin.ElementHandler.LabelsPage"
	data-delete-url="{{ path('admin_labels_del', {'label_type': label_type}) }}"
	data-rename-url="{{ path('admin_labels_rename', {'label_type': label_type}) }}"
>

<nav class="page-top-hugnav">
	<ul>
		<li>
			Sort:
			<a href="{{ path('admin_labels', {'label_type': label_type}) }}" style="{% if not order_by or order_by == 'alpha' %}font-weight: bold{% endif %}">Alphabetical</a>
			/
			<a href="{{ path('admin_labels', {'label_type': label_type, 'order_by': 'count'}) }}" style="{% if order_by == 'count' %}font-weight: bold{% endif %}">Usage Count</a>
		</li>
	</ul>
	<br class="clear" />
</nav>

<div class="new-label">
	<form action="{{ path('admin_labels_new') }}" method="POST" id="new_label_form">
		<input type="hidden" name="display_type" value="{{ label_type }}" />
		<input type="text" placeholder="new label" value="" name="label" /> <button class="clean-white small">Add Label</button><br />
		<div class="types">
			Types:
			<label><input type="checkbox" name="types[]" {% if label_type == 'all' or label_type == 'articles' %}checked="checked"{% endif %} value="articles" /> Articles</label>
			<label><input type="checkbox" name="types[]" {% if label_type == 'all' or label_type == 'deals' %}checked="checked"{% endif %} value="deals" /> Deals</label>
			<label><input type="checkbox" name="types[]" {% if label_type == 'all' or label_type == 'downloads' %}checked="checked"{% endif %} value="downloads" /> Downloads</label>
			<label><input type="checkbox" name="types[]" {% if label_type == 'all' or label_type == 'feedback' %}checked="checked"{% endif %} value="feedback" /> Feedback</label>
			<label><input type="checkbox" name="types[]" {% if label_type == 'all' or label_type == 'news' %}checked="checked"{% endif %} value="news" /> News</label>
			<label><input type="checkbox" name="types[]" {% if label_type == 'all' or label_type == 'organizations' %}checked="checked"{% endif %} value="organizations" /> Organizations</label>
			<label><input type="checkbox" name="types[]" {% if label_type == 'all' or label_type == 'people' %}checked="checked"{% endif %} value="people" /> People</label>
			<label><input type="checkbox" name="types[]" {% if label_type == 'all' or label_type == 'tasks' %}checked="checked"{% endif %} value="tasks" /> Tasks</label>
			<label><input type="checkbox" name="types[]" {% if label_type == 'all' or label_type == 'tickets' %}checked="checked"{% endif %} value="tickets" /> Tickets</label>
		</div>
	</form>
</div>

<ul class="labels-list" id="labels_list">
	{% for label,count in labels %}
		{% include 'AdminBundle:Settings:labels-row.html.twig' %}
	{% endfor %}
</ul>
<br class="clear" />

</div>
{% endblock %}
