{% extends 'AdminBundle::layout.html.twig' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/SettingsLabels.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
	window.DeskPRO_Page = new DeskPRO.Admin.PageHandler.SettingsLabels();
	DeskPRO_Page.setMetaData('newLabelUrl', '{{ path('admin_labels_ajaxnew', {'label_type': label_type}) }}');
	DeskPRO_Page.setMetaData('delLabelUrl', '{{ path('admin_labels_ajaxdel', {'label_type': label_type}) }}');
}
</script>
{% endblock %}
{% block sub_section 'labels' %}
{% block content %}

<div style="text-align:right; padding-bottom: 10px;">
	<a class="icon tickets" href="{{ path('admin_labels', {'label_type': 'tickets'}) }}">Tickets</a>
	&middot;
	<a class="icon tickets" href="{{ path('admin_labels', {'label_type': 'people'}) }}">People</a>
	&middot;
	<a class="icon tickets" href="{{ path('admin_labels', {'label_type': 'organizations'}) }}">Organizations</a>
</div>

<ul class="item-list">
	<li class="create">
		<input type="text" name="label" value="" style="width: 200px;" /> <button class="dp-button small save-trigger">Create New Label</button>
	</li>
	{% for label in all_labels %}
		{% include 'AdminBundle:Settings:labels-row.html.twig' %}
	{% endfor %}
</ul>

<div id="rename_label_overlay" class="rename-label overlay" style="display:none">
	<input type="hidden" class="rename-url" value="{{ path('admin_labels_rename', {'label_type': label_type}) }}?old_label={old_label}&amp;new_label={new_label}" />
	Rename <strong class="old-label">label</strong> to:<br />
	<input type="text" class="new-label" value="" style="width: 99%" />
	
	<div style="text-align:center; margin-top: 15px;">
		<button class="dp-button x-small green save-trigger">Rename</button>
	</div>
</div>

{% endblock %}