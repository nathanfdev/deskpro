{% extends 'AdminBundle::layout.html.twig' %}
{% set page_handler = 'DeskPRO.Admin.ElementHandler.UserModePage' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/ElementHandler/UserModePage.js') }}"></script>
{% endblock %}
{% block pagetitle %}
	<h1>User Registration</h1>
{% endblock %}
{% block page %}

<form action="{{ path('admin_settings_usermode_save') }}" method="POST" id="mode_form">
	<ul class="item-list user-registration">
		<li {% if not app.getSetting('core.user_mode') or app.getSetting('core.user_mode') == 'open' %}class="on"{% endif %}>
			<h3>
				<label>
					<input type="radio" name="mode" value="open" {% if not app.getSetting('core.user_mode') or app.getSetting('core.user_mode') == 'open' %}checked="checked"{% endif %}> Open Helpdesk
				</label>
			</h3>
			<p>
				With an open helpdesk, anyone can register a new account and log in.
			</p>
		</li>

		<li {% if app.getSetting('core.user_mode') == 'external' %}class="on"{% endif %}>
			<h3>
				<label>
					<input type="radio" name="mode" value="external" {% if app.getSetting('core.user_mode') == 'external' %}checked="checked"{% endif %}> External Authentication
				</label>
			</h3>
			<p>
				This mode closes your helpdesk to registration, but allows users to log in with credentials from an external database, such
				as your website member base, LDAP or Active Directory.
			</p>
			<div class="show-on">
				<div class="dp-form">
					<div class="dp-form-row">
						<div class="dp-form-label">
							<label>Registration URL</label>
							<em class="desc">When users want to register, this link will be provided.</em>
						</div>
						<div class="dp-form-input">
							<input type="text" name="" />
						</div>
					</div>

					<div class="dp-form-row">
						<div class="dp-form-label">
							<label>External Source Configuration</label>
							<em class="desc">You have not configured an external user source yet.</em>
						</div>
						<div class="dp-form-input">
							<select	name="">
								<option>Active Directory</option>
								<option>LDAP</option>
								<option>XenForo</option>
								<option>vBulletin</option>
								<option>phpBB</option>
								<option>Magento</option>
								<option>Joomla</option>
								<option>Drupal</option>
								<option>WordPress</option>
							</select> <button class="clean-white small">Configure &rarr;</button>
						</div>
					</div>
				</div>
			</div>
		</li>

		<li {% if app.getSetting('core.user_mode') == 'closed_agent_validation' %}class="on"{% endif %}>
			<h3>
				<label>
					<input type="radio" name="mode" value="closed_agent_validation" {% if app.getSetting('core.user_mode') == 'closed_agent_validation' %}checked="checked"{% endif %}> Closed with agent validation
				</label>
			</h3>
			<p>
				This mode allows users to register on the helpdesk, but before their accounts become active, an agent must manually validate the account.
			</p>
		</li>

		<li {% if app.getSetting('core.user_mode') == 'closed' %}class="on"{% endif %}>
			<h3>
				<label>
					<input type="radio" name="mode" value="closed" {% if app.getSetting('core.user_mode') == 'closed' %}checked="checked"{% endif %}> Closed
				</label>
			</h3>
			<p>
				With a closed helpdesk, there is no way for users to create new accounts. Only
				agents are allowed to manually create users.
			</p>
		</li>
	</ul>

	<div id="save_btn_wrap" style="display: none; text-align: center; margin-top: 10px;">
		<div class="is-not-loading">
			<button class="clean-white large">Switch Registration Modes</button>
		</div>
	</div>
	<div class="is-loading loading-icon">&nbsp;</div>
</form>

{% endblock %}
