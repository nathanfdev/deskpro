<li data-label="{{label.label}}">
	<div style="float:right">
		<ul class="controls">
			<li class="edit rename-trigger"><a href="">rename</a></li>
			<li class="delete delete-trigger"><a href="">delete</a></li>
		</ul>
	</div>
	<span style="background-color: #FFF67A; padding: 4px; font-size: 10px;">{{ label_counts[label.label]|default('0') }}</span>
	{{label.label}}
</li>