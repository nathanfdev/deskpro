{% extends 'AdminBundle::layout_subpage.html.twig' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/TicketUrgencyList.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
window._page_exec_stack.push(function() {
	window.DeskPRO_Page_TicketUrgencyList = new DeskPRO.Admin.PageHandler.TicketUrgencyList('#ticket_urgency');
});
</script>
{% endblock %}
{% block page_id "ticket_urgency" %}
{% block content %}

<form action="{{ path('admin_ticketurgency_saveoptions') }}" method="post" id="urgency_options_form">
	<div class="table-list-wrap">
		<h2>Basic Urgency Options</h2>
		<table class="table-list" cellspacing="0" cellpadding="0" width="100%">
			<tbody>
				<tr>
					<td width="25%" align="center">
						Base urgency score:<br />
						{{ form_widget(urgency_options_form.base_urgency, {'attr': {'size': 2}}) }}
					</td>
					<td width="25%" align="center">
						When the last user reply was<br />
						{{ form_widget(urgency_options_form.time_options.user_reply, {'attr': {'size': 2}}) }}
						minutes ago,<br />boost urgency by
						{{ form_widget(urgency_options_form.time_options.user_reply_num, {'attr': {'size': 2}}) }}
					</td>
					<td width="25%" align="center">
						When the ticket has been open for<br />
						{{ form_widget(urgency_options_form.time_options.open, {'attr': {'size': 2}}) }}
						minutes,<br />boost urgency by
						{{ form_widget(urgency_options_form.time_options.open_num, {'attr': {'size': 2}}) }}
					</td>
					<td width="25%" align="center">
						When the total user waiting time is more than<br />
						{{ form_widget(urgency_options_form.time_options.user_waiting, {'attr': {'size': 2}}) }}
						minutes,<br />boost urgency by
						{{ form_widget(urgency_options_form.time_options.user_waiting_num, {'attr': {'size': 2}}) }}
					</td>
				</tr>
			</tbody>
		</table>
	</div>

	<br />

	<div class="table-list-wrap">
		<h2>User Importance Boosting</h2>
		<table class="table-list" cellspacing="0" cellpadding="0" width="100%">
			<tbody>
				<tr>
					<td width="20%" align="center">
						1<br />
						{{ form_widget(urgency_options_form.user_options.importance_num_1, {'attr': {'size': 2}}) }}
					</td>
					<td width="20%" align="center">
						2<br />
						{{ form_widget(urgency_options_form.user_options.importance_num_2, {'attr': {'size': 2}}) }}
					</td>
					<td width="20%" align="center">
						3<br />
						{{ form_widget(urgency_options_form.user_options.importance_num_3, {'attr': {'size': 2}}) }}
					</td>
					<td width="20%" align="center">
						4<br />
						{{ form_widget(urgency_options_form.user_options.importance_num_4, {'attr': {'size': 2}}) }}
					</td>
					<td width="20%" align="center">
						5<br />
						{{ form_widget(urgency_options_form.user_options.importance_num_5, {'attr': {'size': 2}}) }}
					</td>
				</tr>
			</tbody>
		</table>
	</div>

	<div style="text-align: center; padding-top: 10px;">
		<button class="dp-button">Save Options</button>
	</div>

	<br /><br />

	<table width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td valign="top" width="50%" style="padding-right:5px;">

	<div class="table-list-wrap">
		<a class="icon tickets create-link popout-trigger" href="{{ path('admin_tickettriggers_new_choosetype', {'with-urgency': 1}) }}">Create Trigger</a>
		<h2>Urgency Triggers</h2>
		<table class="table-list" cellspacing="0" cellpadding="0" width="100%">
			<tbody id="teams_rows">
				{% for trigger in all_triggers %}
					{% include 'AdminBundle:TicketTriggers:list-row.html.twig' %}
				{% endfor %}
			</tbody>
		</table>
	</div>

	</td><td valign="top" width="50%" style="padding-left:5px;">

	<div class="table-list-wrap">
		<a class="icon tickets create-link popout-trigger" href="{{ path('admin_ticketescalations_new_choosetype', {'with-urgency': 1}) }}">Create Escalation</a>
		<h2>Urgency Escalations</h2>
		<table class="table-list" cellspacing="0" cellpadding="0" width="100%">
			<tbody id="teams_rows">
				{% for trigger in all_escalations %}
					{% include 'AdminBundle:TicketTriggers:list-row.html.twig' %}
				{% endfor %}
			</tbody>
		</table>
	</div>

	</td></tr></table>
</form>

{% endblock %}