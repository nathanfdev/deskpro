{% set page_handler = 'DeskPRO.Admin.ElementHandler.EditEmailGatewayPage' %}
{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/ElementHandler/EditEmailGatewayPage.js') }}"></script>
{% endblock %}
{% block pagebar %}
	<ul>
		<li><a href="{{ path('admin_emailgateways') }}">Email Gateways</a></li>
		{% if gateway.id %}
			<li>Edit Gateway</li>
		{% else %}
			<li>New Gateway</li>
		{% endif %}
	</ul>
{% endblock %}
{% block page %}

<form id="gateway_form" action="{{ path('admin_emailgateways_edit', {'id': gateway.id|default('0')}) }}" method="post">
{{ form_token('edit_gateway') }}

<input type="hidden" name="process" value="1" />

<div class="dp-form">
	<input type="hidden" name="gateway[connection_type]" value="pop3" />
	<input type="hidden" name="gateway[gateway_type]" value="tickets" />

	<div class="dp-form-row-group" data-element-handler="DeskPRO.Admin.ElementHandler.RadioExpander" data-group-class="dp-input-group" data-expand-class="dp-group-options">
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>Account Information</label>
			</div>
			<div class="dp-form-input">
				<div class="dp-input-group">
					<label>
						<input type="radio" class="option-trigger" name="gateway[connection_type]" value="pop3" {% if not gateway.connection_type or gateway.connection_type == 'pop3' %}checked="checked"{% endif %} />
						POP3 Account
					</label>
					<div class="dp-group-options" style="display: none">
						<table cellspacing="0" cellpadding="0" width="100%">
							<tr>
								<td width="100">Host:</td>
								<td>
									{{ form_widget(form.pop3_options.host, {'attr': {'class': 'small'}}) }}<br />
								</td>
							</tr>
							<tr>
								<td>Secure:</td>
								<td>{{ form_widget(form.pop3_options.secure, {'attr': {'class': 'small'}}) }}</td>
							</tr>
							<tr>
								<td>Port:</td>
								<td>{{ form_widget(form.pop3_options.port, {'attr': {'class': 'small', 'style': 'width: 100px'}}) }}</td>
							</tr>
							<tr>
								<td>Username:</td>
								<td>{{ form_widget(form.pop3_options.username, {'attr': {'class': 'small'}}) }}</td>
							</tr>
							<tr>
								<td>Password:</td>
								<td>{{ form_widget(form.pop3_options.password, {'attr': {'class': 'small'}}) }}</td>
							</tr>
						</table>
						<div class="test-row">
							<span class="test-button test-account-settings primary"><span class="lightning-small-icon"></span> Test Settings</span>
						</div>
					</div>
				</div>

				<div class="dp-input-group">
					<label>
						<input type="radio" class="option-trigger" name="gateway[connection_type]" value="gmail" {% if gateway.connection_type == 'gmail' %}checked="checked"{% endif %} />
						Google Apps
					</label>
					<div class="dp-group-options" style="display: none">
						<table cellspacing="0" cellpadding="0" width="100%">
							<tr>
								<td width="120">Full Email Address:</td>
								<td>{{ form_widget(form.gmail_options.username, {'attr': {'class': 'small'}}) }}</td>
							</tr>
							<tr>
								<td>Password:</td>
								<td>{{ form_widget(form.gmail_options.password, {'attr': {'class': 'small'}}) }}</td>
							</tr>
							{% if not gateway.id %}
								<tr>
									<td>Create SMTP Account</td>
									<td>
										<label>
											<input type="checkbox" name="gmail_create_smtp" value="1" checked="checked" />
											Also create an SMTP account for outgoing email using the same credentials
										</label>
									</td>
								</tr>
							{% endif %}
						</table>
						<div class="test-row">
							<span class="test-button test-account-settings primary"><span class="lightning-small-icon"></span> Test Settings</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Addresses</label>
			<p>List the addresses you expect this gateway account accept email for.</p>
		</div>
		<div class="dp-form-input">
			<div class="choices-builder" id="gateway_addresses">
				<header>
					<select class="new-choice-type">
						<option value="exact">Email</option>
						<option value="domain">Domain</option>
						<option value="regex">Regex</option>
					</select>
					<input type="text" class="new-choice" value="" style="width: 280px !important" /> <button class="clean-white add-trigger">Add</button>
				</header>
				<div style="display: none" id="choice_extra_fields"></div>
				<ul class="list">
					{% for adr in gateway.addresses %}
					<li class="item {% if gateway.default_address.id == adr.id %}is-default{% endif %}" data-address-id="{{ adr.id }}">
						<div class="default"><label><span>Default</span> <input type="radio" class="default-address-radio" name="default_address" value="{{ adr.match_type }}:{{ adr.match_pattern }}" {% if gateway.default_address.id == adr.id %}checked="checked"{% endif %} /></label></div>
						<div class="controls"><ul><li class="remove"><a>remove</a></li></ul></div>
						<div class="label">{{ adr.title }}</div>
					</li>
					{% endfor %}
				</ul>
				<script type="text/x-deskpro-plain" class="row-tpl">
					<li class="item new" data-choice-id="new">
						<div class="default"><label><span>Default</span> <input type="radio" class="default-address-radio" name="default_address" value="" /></label></div>
						<div class="controls"><ul><li class="remove"><a>remove</a></li></ul></div>
						<div class="label"></div>
						<input type="hidden" name="new_address[%id%][match_type]" class="row-value-type" value="" />
						<input type="hidden" name="new_address[%id%][match_pattern]" class="row-value" value="" />
					</li>
				</script>
			</div>
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Enabled</label>
		</div>
		<div class="dp-form-input">
			<label>
				{{ form_widget(form.is_enabled) }}
				Yes, process email from this account
			</label>
		</div>
	</div>
</div>

<button class="clean-white">Save</button>
</form>

<div id="test_settings_overlay" style="width: 400px; height: 200px; overflow:auto; display: none;">
	<div class="overlay-title">
		<span class="close-overlay close-trigger"></span>
		<h4>Test Incoming Email Account</h4>
	</div>
	<div class="overlay-content">
		This will test the connection to your email account.
		<div class="result">
			<div class="is-loading loading-icon-big"><br /><br /></div>
			<div class="is-not-loading">
				<div class="success">
					No errors were reported.
				</div>
				<div class="error">
					There was an error while trying to connect to your email account: <span class="error-msg"></span>
				</div>
			</div>
		</div>
	</div>
	<div class="overlay-footer">
		<button
			class="clean-white test-trigger"
			data-url="{{ path('admin_emailgateways_testaccount') }}"
		>Test Now</button>
	</div>
</div>

{% if gateway.id %}
	<div class="delete-link-wrap">
		<a href="{{ path('admin_emailgateways_del', {id: gateway.id, security_token: security_token('delete_gateway') }) }}" onclick="return confirm('Are you sure you want to delete this gateway? Email sent to this inbox will no longer be processed.');">delete</a>
	</div>
{% endif %}
{% endblock %}
