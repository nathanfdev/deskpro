{% extends 'AdminBundle::layout_popout.html.twig' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/GeneralEdit.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
	window.DeskPRO_Page = new DeskPRO.Admin.PageHandler.GeneralEdit('gateway', {{gateway.id|default(0)}});

	{% if row_html %}
		window.DeskPRO_Page.updateParentListRow({{ row_html|json_encode|raw }});
	{% endif %}
}
</script>
{% endblock %}
{% block page_id "email_gateways" %}
{% block header %}
	<h1>{% if gateway.id %}Edit Gateway{% else %}New Gateway{% endif %}</h1>
{% endblock %}
{% block content %}

<form action="{{ path('admin_emailgateways_edit', {'gateway_id': gateway.id|default(0)}) }}" method="post">
<input type="hidden" name="process" value="1" />

<div class="form-panel">
	<div class="row">
		<label>Title</label>
		{{ form_widget(form.name) }}
	</div>
	<div class="row">
		<label>Email Address</label>
		{{ form_widget(form.address) }}
	</div>

	<div class="row">
		<label>POP3 Connection Information</label>
		<table cellpadding="0" cellspacing="0" width="100%">
			<tr>
				<td>Server<br />{{ form_widget(form.connection_options.server) }}</td>
				<td>Port<br />{{ form_widget(form.connection_options.port, {'size':4}) }}</td>
				<td>{{ form_widget(form.connection_options.ssl) }} SSL</td>
			</tr>
		</table>
		<table cellpadding="0" cellspacing="0" width="100%" style="margin-top: 5px;">
			<tr>
				<td width="50%">Username<br />{{ form_widget(form.connection_options.username) }}</td>
				<td>Password<br />{{ form_widget(form.connection_options.password) }}</td>
			</tr>
		</table>
	</div>
</div>

<br /><br />

{{ form_rest(form) }}
</form>
{% endblock %}
{% block footer %}
	<button class="dp-button small save-trigger">Save</button>

{% endblock %}