{% extends 'AdminBundle::layout_subpage.html.twig' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/GeneralList.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
window._page_exec_stack.push(function() {
	window.DeskPRO_Page_EmailGatewaysList = new DeskPRO.Admin.PageHandler.GeneralList('#email_gateways');
});
</script>
{% endblock %}
{% block page_id "email_gateways" %}
{% block content %}

<div style="text-align:right; padding-bottom: 10px;">
	<a class="icon tickets popout-trigger" href="{{ path('admin_emailgateways_edit', {'gateway_id': '0'}) }}" data-height="400" data-width="580">Create New Gateway</a>
</div>

<ul class="item-list">
	{% for gateway in all_gateways %}
		{% include 'AdminBundle:EmailGateways:list-row.html.twig' %}
	{% endfor %}
</ul>

{% endblock %}