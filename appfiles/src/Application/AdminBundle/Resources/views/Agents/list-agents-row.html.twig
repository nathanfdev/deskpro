<tr class="agent person-{{agent.person.id}}" data-person-id="{{agent.person.id}}">
	<td>
		{{person.display_name}}<br />
		{{person.primary_email_address}}
	</td>
	<td>
		<ul class="comma-list">
			{% for team in person.agent.teams %}
				<li class="team-{{team.id}}-name">{{team.name}}</li>
			{% endfor %}
		</ul>
	</td>
	<td>
		<ul>
			{% if person.agent.access.access_agent %}<li>Agent</li>{% endif %}
			{% if person.agent.access.access_admin %}<li>Admin</li>{% endif %}
			{% if person.agent.access.access_reports %}<li>Reports</li>{% endif %}
			{% if person.agent.access.access_billing %}<li>Billing</li>{% endif %}
		</ul>
	</td>
	<td>
		<ul class="comma-list">
			{% for dep in agent.departments %}
				<li>{{dep.title}}</li>
			{% endfor %}
		</ul>
	</td>
	<td>
		<ul class="comma-list">
			{% for usergroup in person.usergroups %}
				<li>{{usergroup.title}}</li>
			{% endfor %}
		</ul>
	</td>
	<td class="controls">
		<a class="popout-trigger" href="{{ path('admin_agents_edit', {'person_id': person.id}) }}"><img src="{{ asset('images/icons/cog.png') }}" title="Edit" alt="Edit" /></a>
	</td>
</tr>