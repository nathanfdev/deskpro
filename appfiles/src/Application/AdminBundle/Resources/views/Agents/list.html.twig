{% extends 'AdminBundle::layout.html.twig' %}
{% block section 'tickets' %}
{% block sub_section 'priorities' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/GeneralList.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
	window.DeskPRO_Page = new DeskPRO.Admin.PageHandler.GeneralList();
}
</script>
{% endblock %}
{% block content %}

<div style="text-align:right; padding-bottom: 10px;">
	<a class="icon tickets popout-trigger" href="{{ path('admin_agents_new') }}" data-height="350" data-width="400">Create Agent</a>
</div>

<table class="table-list" cellspacing="0" cellpadding="0" width="100%">
	<thead>
		<tr>
			<td>Agent</td>
			<td>Teams</td>
			<td>Zones</td>
			<td>Departments</td>
			<td>Permissions</td>
			<td>&nbsp;</td>
		</tr>
	</thead>
	{% if grouping %}
		{% for group in grouping %}
			{% include 'AdminBundle:Agents:list-grouped-agents-row.html.twig' %}
		{% endfor %}
	{% else %}
		<tbody>
			{% for person in all_agents %}
				{% include 'AdminBundle:Agents:list-agents-row.html.twig' %}
			{% endfor %}
		</tbody>
	{% endif %}
</table>

{% endblock %}