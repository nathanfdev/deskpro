{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block pagetitle %}
	<h1>Agents</h1>
	<nav>
		<a class="clean-white" href="{{ path('admin_agents_new') }}">Create Agent</a>
	</nav>
{% endblock %}
{% block prepage %}
    <p>Agents are anybody with access to the agent or admin interface of your helpdesk and will often include individuals with a range of roles within your organisation.</p>

    <p>You can control which of the 4 interfaces (agent/billing/reports/admin) your agents are allowed to view as well as manage extensive permission controls for those working in the agent interface.</p>

    <p>Agent teams are for helpdesks that want to assign tickets to a group of agents instead of or as well as to an individual agent. A typical use is to have Tier 1 or Tier 2 support agents. The agent team concept is to enable group ticket assignment; you should use agent permission groups to manage group permissions.</p>

    <p>Agent Permission groups make it easy to assign the same permissions to multiple agents.</p>
{% endblock %}
{% block sidebar_right %}
	<div class="dp-page-box">
		<div class="resource-item-list icon-group">
			<header>
				<div class="controls">
					<a class="clean-white small" href="{{ path('admin_agents_teams_new') }}">New</a>
				</div>
				<h4>Teams</h4>
			</header>
			<article>
				<ul>
					{% for team in all_teams %}
						<li class="agent-team team-{{team.id}}" data-team-id="{{team.id}}">
							<a class="title" href="{{ path('admin_agents_teams_edit', {'team_id': team.id}) }}">{{team.name}}</a>
							<div class="icon-list">
								<ul>
									{% for id in team_member_ids[team.id] %}
										{% set agent = all_agents[id] %}
										<li><img src="{{ agent.getPictureUrl(30) }}" class="tipped" title="{{ agent.display_name }}" /></li>
									{% endfor %}
								</ul>
								<br class="clear" />
							</div>
						</li>
					{% else %}
						<li>
							You have not created any teams. <a href="{{ path('admin_agents_teams_new') }}">Click here</a> to create one now.
						</li>
					{% endfor %}
				</ul>
			</article>
		</div>
	</div>

	<div class="dp-page-box">
		<div class="resource-item-list">
			<header>
				<div class="controls">
					<a class="clean-white small" href="{{ path('admin_agents_groups_new') }}">New</a>
				</div>
				<h4>Permission Groups</h4>
			</header>
			<article>
				<ul>
					{% for usergroup in all_usergroups %}
						<li class="usergroup usergroup-{{usergroup.id}}" data-usergroup-id="{{usergroup.id}}">
							<a class="title" href="{{ path('admin_agents_groups_edit', {'usergroup_id': usergroup.id}) }}">{{usergroup.title}}</a>
							<div class="icon-list">
								<ul>
									{% for id in usergroup_member_ids[usergroup.id] %}
										{% set agent = all_agents[id] %}
										<li><img src="{{ agent.getPictureUrl(30) }}" class="tipped" title="{{ agent.display_name }}" /></li>
									{% endfor %}
								</ul>
								<br class="clear" />
							</div>
						</li>
					{% else %}
						You have not created any permission groups. <a href="{{ path('admin_agents_groups_new') }}">Click here</a> to create one now.
					{% endfor %}
				</ul>
			</article>
		</div>
	</div>
{% endblock %}

{% block content %}
<div class="dp-page-box">

<div class="page-content agent-listing">
	<ul>
		{% for person in all_agents %}
			<li class="agent">
				<div class="inner">
					<section class="name">
						<img src="{{ person.getPictureUrl(38) }}" />
						<h4><a href="{{ path('admin_agents_edit', {'person_id': person.id} )}}">{{person.display_name}}</a></h4>
						<address>{{person.primary_email_address}}</address>
					</section>
					<section class="zones">
						<ul>
							<li class="agent">agent</li>
							<li class="admin">admin</li>
							<li class="reports">reports</li>
							<li class="billing">billing</li>
						</ul>
					</section>
					<section class="info">
						<ul>
							<li>
								<label>Departments:</label>
								<div class="items">
									{% for dep_id in agents_to_deps[person.id] %}{% set dep = all_departments[dep_id] %}{{ dep.full_title }}{% if not loop.last %},{% endif %}
									{% else %}
										<em>None</em>
									{% endfor %}
								</div>
							</li>
							<li>
								<label>Teams:</label>
								<div class="items">
									{% for team_id in agent_to_teams[person.id] %}{% set team = all_teams[team_id] %}{{ team.name }}{% if not loop.last %},{% endif %}
									{% else %}
										<em>None</em>
									{% endfor %}
								</div>
							</li>
							<li>
								<label>Groups:</label>
								<div class="items">
									{% if agent_to_groups[person.id] %}
										{% for usergroup_id in agent_to_groups[person.id]  %}{% set usergroup = all_usergroups[usergroup_id] %}{{ usergroup.title }}{% if not loop.last %}, {% endif %}{% endfor %}{% if overrides_counts[person.id] %}, +{{ overrides_counts[person.id] }} overrides{% endif %}
									{% else %}
										{% if overrides_counts[person.id] %}
											{{ overrides_counts[person.id] }} specific permissions
										{% else %}
											<em>No permissions</em>
										{% endif %}
									{% endif %}
								</div>
							</li>
						</ul>
					</section>
					<br class="clear" />
				</div>
			</li>
		{% endfor %}
	</ul>
<div>

</div>
{% endblock %}
