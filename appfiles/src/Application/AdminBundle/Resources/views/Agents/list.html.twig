{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block pagetitle %}
	<nav>
		<button class="clean-white popout-trigger">Create Agent</button>
	</nav>
	Agents
{% endblock %}

{% block sidebar_right %}
	<div class="dp-page-box">
		<div class="resource-item-list icon-group">
			<header>
				<div class="controls">
					<button class="clean-white small">New</button>
				</div>
				<h4>Teams</h4>
			</header>
			<article>
				<ul>
					{% for team in all_teams %}
						<li class="agent-team team-{{team.id}}" data-team-id="{{team.id}}">
							<span class="title">{{team.name}}</span>
							<div class="icon-list">
								<ul>
									{% for id in team_member_ids[team.id] %}
										{% set agent = all_agents[id] %}
										<li><img src="{{ agent.getPictureUrl(30) }}" class="tipped" title="{{ agent.display_name }}" /></li>
									{% endfor %}
								</ul>
								<br class="clear" />
							</div>
						</li>
					{% endfor %}
				</ul>
			</article>
		</div>
	</div>

	<div class="dp-page-box">
		<div class="resource-item-list">
			<header>
				<div class="controls">
					<button class="clean-white small">New</button>
				</div>
				<h4>Permission Groups</h4>
			</header>
			<article>
				<ul>
					{% for usergroup in all_usergroups %}
						<li class="usergroup usergroup-{{usergroup.id}}" data-usergroup-id="{{team.id}}">
							<span class="title">{{usergroup.title}}</span>

						</li>
					{% endfor %}
				</ul>
			</article>
		</div>
	</div>
{% endblock %}

{% block content %}
<div class="dp-page-box">

<div class="page-content agent-listing">
	<ul>
		{% for person in all_agents %}
			<li class="agent person-{{agent.person.id}}" data-person-id="{{agent.person.id}}">
				<div class="inner">
					<section class="name">
						<img src="{{ person.getPictureUrl(38) }}" />
						<h4><a href="">{{person.display_name}}</a></h4>
						<address>{{person.primary_email_address}}</address>
					</section>
					<section class="zones">
						<ul>
							<li class="agent">agent</li>
							<li class="admin">admin</li>
							<li class="reports">reports</li>
							<li class="billing">billing</li>
						</ul>
					</section>
					<section class="info">
						<ul>
							<li>
								<label>Departments:</label>
								<div class="items">
									{% for dep in agent.departments %}
										{{ dep.full_title }}{% if not loop.last %},{% endif %}
									{% else %}
										<em>None</em>
									{% endfor %}
								</div>
							</li>
							<li>
								<label>Teams:</label>
								<div class="items">
									{% for team in person.agent.teams %}
										{{ team.name }}{% if not loop.last %},{% endif %}
									{% else %}
										<em>None</em>
									{% endfor %}
								</div>
							</li>
							<li>
								<label>Groups:</label>
								<div class="items">
									{% for usergroup in person.usergroups %}
										{{ usergroup.title }}{% if not loop.last %},{% endif %}
									{% else %}
										<em>None</em>
									{% endfor %}
								</div>
							</li>
						</ul>
					</section>
					<br class="clear" />
				</div>
			</li>
		{% endfor %}
	</ul>
<div>

</div>
{% endblock %}
