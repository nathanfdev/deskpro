{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block pagebar %}
	<nav>
		<ul>
			<li><a href="{{ path('admin_agents_new') }}">Add Agent</a></li>
		</ul>
	</nav>
	<ul>
		<li>Agents</li>
	</ul>
{% endblock %}
{% block prepage %}
	<div style="padding: 10px 10px 0 10px;">
		{{ design.helpbox() }}
			<p>Agents are anybody with access to the agent or admin interface of your helpdesk and will often include individuals with a range of roles within your organisation.</p>
			<p>Agent teams are for helpdesks that want to assign tickets to a group of agents instead of or as well as to an individual agent. A typical use is to have Tier 1 or Tier 2 support agents. The agent team concept is to enable group ticket assignment; you should use agent permission groups to manage group permissions.</p>
		{{ design.helpbox_end() }}
	</div>
{% endblock %}
{% block sidebar_right %}
	<div class="dp-page-box">
		<div class="resource-item-list icon-group">
			<header>
				<div class="controls">
					<a class="clean-white small" href="{{ path('admin_agents_teams_new') }}">New</a>
				</div>
				<h4>Teams</h4>
			</header>
			<article>
				<ul>
					{% for team in all_teams %}
						<li class="agent-team team-{{team.id}}" data-team-id="{{team.id}}">
							<a class="title" href="{{ path('admin_agents_teams_edit', {'team_id': team.id}) }}">{{team.name}}</a>
							<div class="icon-list">
								<ul>
									{% for id in team_member_ids[team.id] %}
										{% set agent = all_agents[id] %}
										<li><img src="{{ agent.getPictureUrl(30) }}" class="tipped" title="{{ agent.display_name }}" /></li>
									{% endfor %}
								</ul>
								<br class="clear" />
							</div>
						</li>
					{% else %}
						<li>
							You have not created any teams. <a href="{{ path('admin_agents_teams_new') }}">Click here</a> to create one now.
						</li>
					{% endfor %}
				</ul>
			</article>
		</div>
	</div>

	<div class="dp-page-box">
		<div class="resource-item-list">
			<header>
				<div class="controls">
					<a class="clean-white small" href="{{ path('admin_agents_groups_new') }}">New</a>
				</div>
				<h4>Permission Groups</h4>
			</header>
			<article>
				<ul>
					{% for usergroup in all_usergroups %}
						<li class="usergroup usergroup-{{usergroup.id}}" data-usergroup-id="{{usergroup.id}}">
							<a class="title" href="{{ path('admin_agents_groups_edit', {'usergroup_id': usergroup.id}) }}">{{usergroup.title}}</a>
							<div class="icon-list">
								<ul>
									{% for id in usergroup_member_ids[usergroup.id] %}
										{% set agent = all_agents[id] %}
										<li><img src="{{ agent.getPictureUrl(30) }}" class="tipped" title="{{ agent.display_name }}" /></li>
									{% endfor %}
								</ul>
								<br class="clear" />
							</div>
						</li>
					{% else %}
						You have not created any permission groups. <a href="{{ path('admin_agents_groups_new') }}">Click here</a> to create one now.
					{% endfor %}
				</ul>
			</article>
		</div>
	</div>
{% endblock %}

{% block content %}
<div class="dp-page-box">

<div class="page-content agent-listing" style="padding-top: 0;">

	<div class="content-table">
		<table width="100%">
			<thead>
				<tr>
					<th class="single-title">Agent</th>
					<th class="r-col" width="16"><img title="Can access the agent interface" src="{{ asset('images/admin/icons/zone-agent.png') }}" /></th>
					<th class="r-col" width="16"><img title="Can access the admin interface" src="{{ asset('images/admin/icons/zone-admin.png') }}" /></th>
					<th class="r-col" width="16"><img title="Can access the reporting interface" src="{{ asset('images/admin/icons/zone-reports.png') }}" /></th>
					<th class="r-col" width="16"><img title="Can access the billing interface" src="{{ asset('images/admin/icons/zone-billing.png') }}" /></th>
				</tr>
			</thead>
			<tbody>
				{% for person in all_agents %}
					<tr>
						<td class="title">
							<img src="{{ person.getPictureUrl(28) }}" align="left" style="margin-right: 6px;" />
							<h4><a href="{{ path('admin_agents_edit', {'person_id': person.id} )}}">{{person.display_name}}</a></h4>
							<address>{{person.primary_email_address}}</address>
						</td>
						<td class="prop r-col">{% if person.can_agent %}<img src="{{ asset('images/agent/icons/check.png') }}" />{% else %}&nbsp;{% endif %}</td>
						<td class="prop r-col">{% if person.can_admin %}<img src="{{ asset('images/agent/icons/check.png') }}" />{% else %}&nbsp;{% endif %}</td>
						<td class="prop r-col">{% if person.can_reports %}<img src="{{ asset('images/agent/icons/check.png') }}" />{% else %}&nbsp;{% endif %}</td>
						<td class="prop r-col">{% if person.can_billing %}<img src="{{ asset('images/agent/icons/check.png') }}" />{% else %}&nbsp;{% endif %}</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>

	{#
	<ul>
		{% for person in all_agents %}
			<li class="agent">
				<div class="inner">
