{% extends 'AdminBundle::layout_popout.html.twig' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/AgentTeamEdit.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
	window.DeskPRO_Page = new DeskPRO.Admin.PageHandler.AgentTeamEdit({{team.id|default(0)}});

	{% if row_html %}
		window.DeskPRO_Page.updateParent({{team.name|json_encode|raw}}, {{ row_html|json_encode|raw }});
	{% endif %}
}
</script>
{% endblock %}
{% block header %}
	<h1>{% if usergroup.id %}Edit Team{% else %}New Team{% endif %}</h1>
{% endblock %}
{% block content %}

<form action="{{ path('admin_agents_teams_edit', {'team_id': team.id|default(0)}) }}" method="post">
<input type="hidden" name="process" value="1" />


<div class="form-panel">
	<div class="row">
		<label>Title</label>
		<input type="text" name="team[name]" value="{{team.name}}" style="width: 90%" />
	</div>
</div>

</form>

{% endblock %}
{% block footer %}
	<button class="dp-button green save-trigger">Save</button>
	<button class="dp-button gray cancel-trigger">Cancel</button>
{% endblock %}