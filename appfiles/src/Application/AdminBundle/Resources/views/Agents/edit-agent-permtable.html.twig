{% macro perm_col(title, usergroup_values, permgroup, name, depends_on) %}
	{% set perm_fname_flat = permgroup ~ '_' ~ name %}
	<tr
		class="permrow perm-{{ permgroup }}_{{ name }}"
		data-permgroup="{{ permgroup }}"
		data-permname="{{ name }}"
		{% if depends_on %}data-depends-on="{{ depends_on }}"{% endif %}
	>
		<td width="37" class="prop effective highlight no-border" id="effective_lbl_{{ perm_fname_flat }}">
			<span class="on">ON</span>
			<span class="off">OFF</span>
		</td>
		<td class="title">{{ title|raw }}</td>
		<td class="prop">
			<input
				class="onoff-slider override-perm"
				type="checkbox"
				name="permissions[{{ permgroup }}][override][{{ name }}]"
				id="perm_val_override_{{ perm_fname_flat }}"
				value="1"
				{% if usergroup_values['override'][permgroup ~ '.' ~ name] %}checked="checked"{% endif %}
			/>
			{# Other permission values #}
			{% for id, ug in usergroup_values %}
				{% if id and id != 'override' %}
					<input
						type="hidden"
						class="ug-perm-val"
						data-ug-id="{{ id }}"
						name="permissions[{{ permgroup }}][{{ id }}][{{ name }}]"
						id="perm_val_{{ id }}_{{ perm_fname_flat }}"
						value="{% if ug[permgroup ~ '.' ~ name] %}1{% else %}0{% endif %}"
					/>
				{% endif %}
			{% endfor %}
		</td>
	</tr>
{% endmacro %}

<nav class="check-grid-tabs">
	<ul data-element-handler="DeskPRO.ElementHandler.SimpleTabs" data-trigger-elements="> li">
		<li class="on" data-tab-for="#permgroup_tickets"><span>Tickets</span></li>
		<li data-tab-for="#permgroup_people"><span>People and Organizations</span></li>
		<li data-tab-for="#permgroup_chat"><span>Chat</span></li>
		<li data-tab-for="#permgroup_publish"><span>Publish</span></li>
	</ul>
</nav>

{# TICKET PERMISSIONS #}
<div id="permgroup_tickets" style="display: none">
	<div class="check-grid">
		<table width="100%">
			<thead>
				<tr>
					<th colspan="2" style="text-align: left">Description</th>
					<th width="60">Overrides</th>
				</tr>
			</thead>
			<tbody>
				{{ _self.perm_col('User ticket application', usergroup_values, 'tickets', 'use') }}
				{{ _self.perm_col('Create tickets', usergroup_values, 'tickets', 'create', 'tickets_use') }}
			</tbody>
			<tbody>
				{{ _self.perm_col('View own and teams tickets', usergroup_values, 'tickets', 'view_own', 'tickets_use') }}
				{{ _self.perm_col('Modify own and teams tickets', usergroup_values, 'tickets', 'modify_own', 'tickets_use') }}
				{{ _self.perm_col('Delete own and teams tickets', usergroup_values, 'tickets', 'delete_own', 'tickets_use') }}
				{{ _self.perm_col('Resolve own and teams tickets', usergroup_values, 'tickets', 'resolve_own', 'tickets_use') }}
			</tbody>
			<tbody>
				{{ _self.perm_col('View unassigned tickets', usergroup_values, 'tickets', 'view_unassigned', 'tickets_use') }}
				{{ _self.perm_col('Modify unassigned tickets', usergroup_values, 'tickets', 'modify_unassigned', 'tickets_view_unassigned') }}
				{{ _self.perm_col('Delete unassigned tickets', usergroup_values, 'tickets', 'delete_unassigned', 'tickets_view_unassigned') }}
				{{ _self.perm_col('Resolve unassigned tickets', usergroup_values, 'tickets', 'resolve_unassigned', 'tickets_view_unassigned') }}
			</tbody>
			<tbody>
				{{ _self.perm_col('View others tickets', usergroup_values, 'tickets', 'view_others', 'tickets_use') }}
				{{ _self.perm_col('Modify others tickets', usergroup_values, 'tickets', 'modify_others', 'tickets_view_others') }}
				{{ _self.perm_col('Delete others tickets', usergroup_values, 'tickets', 'delete_others', 'tickets_view_others') }}
				{{ _self.perm_col('Resolve others tickets', usergroup_values, 'tickets', 'resolve_others', 'tickets_view_others') }}
			</tbody>
		</table>
	</div>
</div>
{# /TICKET PERMISSIONS #}

