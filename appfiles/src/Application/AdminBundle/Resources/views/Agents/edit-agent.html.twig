{% extends 'AdminBundle::layout.html.twig' %}
{% block html_head %}
{% endblock %}
{% block page_js_exec %}
{% endblock %}
{% block pagetitle %}
	<h1>Agent: {{ agent.name }}</h1>
{% endblock %}
{% block content %}
<div class="dp-page-box agent-edit">
	<div class="page-content">
		<div class="permissions-table">
			<table cellspacing="0" cellpadding="0">
				<thead>
					<tr>
						<th width="300" style="text-align: left">
							<select id="permission_type_switcher">
								<option>Departments</option>
								<option>Ticket Permissions</option>
							</select>
						</th>
						<th width="5">&nbsp;</th>
						<th width="100">Group A</th>
						<th width="100">Group B</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>Use ticket system</td>
						<td><input type="checkbox" class="onoff-slider" /></td>
						<td><input type="checkbox" class="onoff-slider" /></td>
						<td><input type="checkbox" class="onoff-slider" /></td>
					</tr>
					<tr>
						<td>Create tickets</td>
						<td><input type="checkbox" class="onoff-slider" /></td>
						<td><input type="checkbox" class="onoff-slider" /></td>
						<td><input type="checkbox" class="onoff-slider" /></td>
					</tr>
				</tbody>
				<tbody>
					<tr>
						<td>View own and teams tickets</td>
						<td><input type="checkbox" class="onoff-slider" /></td>
						<td><input type="checkbox" class="onoff-slider" /></td>
						<td><input type="checkbox" class="onoff-slider" /></td>
					</tr>
					<tr>
						<td>Modify own and teams tickets</td>
						<td><input type="checkbox" class="onoff-slider" /></td>
						<td><input type="checkbox" class="onoff-slider" /></td>
						<td><input type="checkbox" class="onoff-slider" /></td>
					</tr>
					<tr>
						<td>Delete own and teams tickets</td>
						<td><input type="checkbox" class="onoff-slider" /></td>
						<td><input type="checkbox" class="onoff-slider" /></td>
						<td><input type="checkbox" class="onoff-slider" /></td>
					</tr>
					<tr>
						<td>Resolve own and teams tickets</td>
						<td><input type="checkbox" class="onoff-slider" /></td>
						<td><input type="checkbox" class="onoff-slider" /></td>
						<td><input type="checkbox" class="onoff-slider" /></td>
					</tr>
				</tbody>
				<tbody>
					<tr>
						<td>View unassigned tickets</td>
						<td><input type="checkbox" class="onoff-slider" /></td>
						<td><input type="checkbox" class="onoff-slider" /></td>
						<td><input type="checkbox" class="onoff-slider" /></td>
					</tr>
					<tr>
						<td>Modify unassigned tickets</td>
						<td><input type="checkbox" class="onoff-slider" /></td>
						<td><input type="checkbox" class="onoff-slider" /></td>
						<td><input type="checkbox" class="onoff-slider" /></td>
					</tr>
					<tr>
						<td>Delete unassigned tickets</td>
						<td><input type="checkbox" class="onoff-slider" /></td>
						<td><input type="checkbox" class="onoff-slider" /></td>
						<td><input type="checkbox" class="onoff-slider" /></td>
					</tr>
					<tr>
						<td>Resolve unassigned tickets</td>
						<td><input type="checkbox" class="onoff-slider" /></td>
						<td><input type="checkbox" class="onoff-slider" /></td>
						<td><input type="checkbox" class="onoff-slider" /></td>
					</tr>
				</tbody>
				<tbody>
					<tr>
						<td>View others tickets</td>
						<td><input type="checkbox" class="onoff-slider" /></td>
						<td><input type="checkbox" class="onoff-slider" /></td>
						<td><input type="checkbox" class="onoff-slider" /></td>
					</tr>
					<tr>
						<td>Modify others tickets</td>
						<td><input type="checkbox" class="onoff-slider" /></td>
						<td><input type="checkbox" class="onoff-slider" /></td>
						<td><input type="checkbox" class="onoff-slider" /></td>
					</tr>
					<tr>
						<td>Delete others tickets</td>
						<td><input type="checkbox" class="onoff-slider" /></td>
						<td><input type="checkbox" class="onoff-slider" /></td>
						<td><input type="checkbox" class="onoff-slider" /></td>
					</tr>
					<tr>
						<td>Resolve others tickets</td>
						<td><input type="checkbox" class="onoff-slider" /></td>
						<td><input type="checkbox" class="onoff-slider" /></td>
						<td><input type="checkbox" class="onoff-slider" /></td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>
</div>

{#
<form action="{{ path('admin_agents_edit', {'person_id': person.id|default(0)}) }}" method="post">
<input type="hidden" name="process" value="1" />

<div class="form-panel">
	<div class="row">
		<label>First and Last Name</label>
		{{ form_widget(form.first_name) }}
		{{ form_widget(form.last_name) }}
	</div>
	<div class="row">
		<label>Email Address</label>
		{{ form_widget(form.email) }}
	</div>
	<div class="row">
		<label>Password</label>
		{{ form_widget(form.password) }}
	</div>
	<div class="row">
		<label>Access Zones</label>
		<div class="field">{{ form_widget(form.access_zones) }}</div>

	</div>
	<div class="row">
		<label>Teams</label>
		<div class="field checkselect" style="max-height: 100px; overflow: auto; padding: 5px;">{{ form_widget(form.agent_teams) }}</div>
		<br class="clear" />
	</div>
	<div class="row">
		<label>Department Permissions</label>
		<div class="field checkselect" style="max-height: 100px; overflow: auto;">{{ form_widget(form.allowed_departments) }}</div>
		<br class="clear" />
	</div>
	{% if form.usergroups %}
	<div class="row">
		<label>Agent Groups</label>
		<div class="field checkselect" style="max-height: 100px; overflow: auto;">{{ form_widget(form.usergroups) }}</div>
		<br class="clear" />
	</div>
	{% endif %}
</div>

</form>
#}
{% endblock %}
{% block footer %}
	<button class="dp-button small save-trigger">Save</button>

{% endblock %}
