{% extends 'AdminBundle::layout.html.twig' %}
{% block html_head %}
{% endblock %}
{% block page_js_exec %}
{% endblock %}
{% block pagetitle %}
	<h1>Agent: {{ agent.name }}</h1>
{% endblock %}
{% block page %}

<div class="dp-form">
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Name</label>
		</div>
		<div class="dp-form-input">
			<input style="width:200px;" type="text" name="agent[first_name]" value="{{ agent.first_name }}" />
			<input style="width:200px;" type="text" name="agent[last_name]" value="{{ agent.last_name }}" />
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Email</label>
		</div>
		<div class="dp-form-input">
			<input style="width:409px;" type="text" name="agent[email]" value="{{ agent.primary_email_address }}" />
		</div>
	</div>

	{% if all_teams or all_usergroups %}
	<table cellspacing="0" cellpadding="0" width="100%"><tr>
		{% if all_teams %}
			<td width="50%">
				<div class="dp-form-row">
					<div class="dp-form-label">
						<label>Teams</label>
					</div>
					<div class="dp-form-input">
						<div class="checkbox-rows">
							<ul>
								{% for team in all_teams %}
								<li>
									<label>
										<input type="checkbox" name="agent[teams][]" value="{{ team.id }}" />
										{{ team.name }}
									</label>
								</li>
								{% endfor %}
							</ul>
						</div>
					</div>
				</div>
			</td>
		{% endif %}

		{% if all_usergroups %}
			<td width="50%">
				<div class="dp-form-row">
					<div class="dp-form-label">
						<label>Permission Groups</label>
					</div>
					<div class="dp-form-input">
						<div class="checkbox-rows">
							<ul>
								{% for usergroup in all_usergroups %}
								<li>
									<label>
										<input type="checkbox" name="agent[usergroups][]" value="{{ usergroup.id }}" />
										{{ usergroup.title }}
									</label>
								</li>
								{% endfor %}
							</ul>
						</div>
					</div>
				</div>
			</td>
		{% endif %}
	</tr></table>
	{% endif %}

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Department Access Permissions</label>
		</div>
		<div class="dp-form-input">
			<div class="check-grid" style="max-height: 200px; overflow: auto; width: 70%;">
				<table width="100%">
					<thead>
						<tr>
							<th>Department</th>
							<th width="60">Tickets</th>
							<th width="60">Chat</th>
						</tr>
					</thead>
					<tbody>
						{% for dep in departments %}
							<tr>
								{% if dep.children|length %}
									<td class="title title-group">{{ dep.title }}</td>
									<td class="prop">&nbsp;</td>
									<td class="prop">&nbsp;</td>
								{% else %}
									<td class="title">{{ dep.title }}</td>
									<td class="prop"><input class="onoff-slider" type="checkbox" name="dep_perms[{{ dep.id }}][tickets]" value="1" /></td>
									<td class="prop"><input class="onoff-slider" type="checkbox" name="dep_perms[{{ dep.id }}][chat]" value="1" /></td>
								{% endif %}
							</tr>
							{% if dep.children %}
								{% for subdep in dep.children %}
									<tr>
										<td class="title">&nbsp;&nbsp;&nbsp;&nbsp; {{ subdep.title }}</td>
										<td class="prop"><input class="onoff-slider" type="checkbox" name="dep_perms[{{ subdep.id }}][tickets]" value="1" /></td>
										<td class="prop"><input class="onoff-slider" type="checkbox" name="dep_perms[{{ subdep.id }}][chat]" value="1" /></td>
									</tr>
								{% endfor %}
							{% endif %}
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Permissions</label>
			<div class="check-grid" style="max-height: 200px; overflow: auto; width: 70%;">
				<table width="100%">
					<thead>
						<tr>
							<th>Permission</th>
							<th width="60">Overrides</th>
							{% for group in all_usergroups %}
								<th width="60">{{ group.title }}</th>
							{% endfor %}
						</tr>
					</thead>
					<tbody>
						
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>

