{% extends 'AdminBundle::layout.html.twig' %}
{% block pagetitle %}
	<h1>New Agent</h1>
	<nav>
		<a class="clean-white" href="{{ path('admin_agents') }}">&larr; Back to Agents</a>
	</nav>
{% endblock %}
{% block page %}

{% if errors|length %}
<div class="alert-message block-message error">
	<strong>Please correct the following problem(s):</strong>
	<ul>
		{% if errors.email %}<li>Please enter a valid email address</li>{% endif %}
		{% if errors.name %}<li>Please enter a first and last name</li>{% endif %}
		{% if errors.password %}<li>Please enter an initial password</li>{% endif %}
		{% if not errors.password and errors.password2 %}<li>The second password box did not match the first. Please type in both passwords again.</li>{% endif %}
	</ul>
</div>
{% endif %}

<form action="{{ path('admin_agents_new') }}" method="post">
<input type="hidden" name="process" value="1" />

<div class="dp-form">
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Name</label>
		</div>
		<div class="dp-form-input">
			<input style="width:200px;" type="text" name="agent[first_name]" value="" placeholder="First Name" />
			<input style="width:200px;" type="text" name="agent[last_name]" value="" placeholder="Last Name" />
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Email</label>
		</div>
		<div class="dp-form-input">
			<input style="width:409px;" type="text" name="agent[email]" value="" />
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Initial Password</label>
		</div>
		<div class="dp-form-input">
			<input style="width:200px;" type="password" name="agent[password]" value="" placeholder="Password" />
			<input style="width:200px;" type="password" name="agent[password2]" value="" placeholder="Repeat Password" />
		</div>
	</div>
</div>

<button class="clean-white">Create agent and continue &rarr;</button>

</form>

{% endblock %}
