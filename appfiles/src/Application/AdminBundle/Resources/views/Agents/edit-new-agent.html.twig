{% extends 'AdminBundle::layout.html.twig' %}
{% block pagetitle %}
	<h1>New Agent</h1>
	<nav>
		<a class="clean-white" href="{{ path('admin_agents') }}">&larr; Back to Agents</a>
	</nav>
{% endblock %}
{% block page %}

<form action="{{ path('admin_agents_new') }}" method="post">
<input type="hidden" name="process" value="1" />

<div class="dp-form">
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Name</label>
		</div>
		<div class="dp-form-input">
			<input style="width:200px;" type="text" name="agent[first_name]" value="" placeholder="First Name" />
			<input style="width:200px;" type="text" name="agent[last_name]" value="" placeholder="Last Name" />
		</div>
	</div>

	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Email</label>
		</div>
		<div class="dp-form-input">
			<input style="width:409px;" type="text" name="agent[email]" value="" />
		</div>
	</div>
</div>

<button class="clean-white">Create agent and continue &rarr;</button>

</form>

{% endblock %}
