{% extends 'AdminBundle::layout.html.twig' %}
{% block section 'tickets' %}
{% block sub_section 'priorities' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/EmailProperties.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
	window.DeskPRO_Page = new DeskPRO.Admin.PageHandler.EmailProperties();
}
</script>
{% endblock %}
{% block content %}

<div class="pane">
	<div id="email_properties_tabs" class="pane-tabs nosel">
		<ul>
			<li class="tab-trigger tab-gateways on" data-tab-for=".tab-content.tab-gateways"><a>Email Gateways</a></li>
			<li class="tab-trigger tab-froms" data-tab-for=".tab-content.tab-froms"><a>From Addresses</a></li>
		</ul>
	</div>
	<div class="tab-box-content pane-content">
		<div class="tab-content tab-gateways on" data-tab-trigger=".tab-trigger.ticket-gateways">
			{{sections.gateways|raw}}
		</div>
		<div class="tab-content tab-froms" data-tab-trigger=".tab-trigger.ticket-froms">
			{{sections.froms|raw}}
		</div>
	</div>
</div>

{% endblock %}