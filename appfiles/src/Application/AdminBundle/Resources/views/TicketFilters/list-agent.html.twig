{% for group in filters_grouped %}
	<h2>{{ group.person.display_name }}</h4>
	<ul class="item-list">
		{% for filter in group.filters %}
		<li class="ticket-fitler ticket-filter-{{filter.id}}" data-filter-id="{{filter.id}}">
			<div style="float:right">
				<ul class="controls">
					<li class="edit edit-trigger"><a href="{{ path('admin_tickets_filters_edit', {'filter_id': filter.id}) }}" class="popout-trigger">edit</a></li>
				</ul>
			</div>
			<strong>{{filter.title}}</strong><br />
			{{ filter.summary_phrase }}
		</li>
		{% endfor %}
	</ul>
{% else %}
	There are no agent filters.
{% endfor %}