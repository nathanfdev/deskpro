{% extends 'AdminBundle::layout_popout.html.twig' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/TicketFilterEdit.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
	window.DeskPRO_Page = new DeskPRO.Admin.PageHandler.TicketFilterEdit({{filter.id|default(0)}});

	window.DeskPRO_Page.init_options_callback = function() {
		var count = 0;
		var terms = {{filter.terms|json_encode|raw}};
		if (terms) {
			Array.each(terms, function(info, x) {
				var basename = 'terms[initial_' + x + ']';
				window.DeskPRO_Page.criteriaEditor.addNewRow($('.criteria-form .search-terms'), basename, {
					type: info.type,
					op: info.op,
					options: info.options
				});
			});
		}
	};

	{% if is_saved %}
	DeskPRO_Window.getMessageBroker().sendMessage('agent.ticket-filters-updated');
	{% endif %}
}
</script>
{% endblock %}
{% block page_id "ticket_filters" %}
{% block header %}
	<h1>{% if filter.id %}Edit Filter{% else %}New Filter{% endif %}</h1>
{% endblock %}
{% block content %}

<form action="{{ path('admin_tickets_filters_edit', {'filter_id': filter.id|default(0)}) }}" method="post">
<input type="hidden" name="process" value="1" />

<div class="form-panel">
	<div class="row">
		<label>Title</label>
		<input type="text" name="filter[title]" value="{{filter.title}}" />

		{% if not filter.id %}
		<input type="hidden" name="filter[person_id]" value="{{filter.person.id|default(0)}}" />
		<input type="hidden" name="filter[agent_team_id]" value="{{filter.agent_team.id|default(0)}}" />
		<input type="hidden" name="filter[is_global]" value="{{ filter.is_global + 0 }}" />
		{% endif %}
	</div>
	<div class="row">
		<label>Criteria</label>
		<div class="criteria-form search-form">
			<div class="search-terms"></div>
			<div class="term"><span class="add-term">+</span> Add a new criteria</div>
		</div>
	</div>
</div>

</form>

{% include 'DeskPRO:Common:ticket-search-criteria.html.twig' with { 'classname': 'criteria-tpl', 'term_options': term_options } %}

{% endblock %}
{% block footer %}
	<button class="dp-button small save-trigger">Save</button>

{% endblock %}