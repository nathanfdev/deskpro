{% extends 'AdminBundle::layout.html.twig' %}
{% block pagebar %}
	<ul>
		<li><a href="{{ path('admin_tickets_filters') }}">Ticket Filters</a></li>
		<li>New Filter</li>
	</ul>
{% endblock %}
{% block page %}

<form action="{{ path('admin_tickets_filters_edit', {'filter_id': 0}) }}" class="dp-form">
<input type="hidden" name="is_new" value="1" />

<div class="dp-form-row-group" data-element-handler="DeskPRO.Admin.ElementHandler.RadioExpander" data-group-class="dp-input-group" data-expand-class="dp-group-options">
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>Agent Access</label>
		</div>
		<div class="dp-form-input">
			<div class="dp-input-group">
				<label>
					<input type="radio" name="filter_visibility" value="filter_global" checked="checked" />
					Global filter that can be used by everyone
				</label>
			</div>

			<div class="dp-input-group">
				<label>
					<input type="radio" name="filter_visibility" value="filter_agent_team" />
					Only allow a specific team to use this filter
				</label>
				<div id="agent_required_group" class="dp-group-options" style="display: none">
					Select the team that can use this filter: <select name="filter[agent_team_id]">
						{% for k,v in agent_team_names %}
							<option value="{{k}}">{{v}}</option>
						{% endfor %}
					</select>
				</div>
			</div>

			<div class="dp-input-group">
				<label>
					<input type="radio" name="filter_visibility" value="filter_agent_team" />
					Only allow a specific agent to use this filter
				</label>
				<div id="agent_required_group" class="dp-group-options" style="display: none">
					Select the agent that can use this filter: <select name="filter[person_id]">
						{% for k,v in agent_names %}
							<option value="{{k}}">{{v}}</option>
						{% endfor %}
					</select>
				</div>
			</div>
		</div>
	</div>
</div>

<button class="clean-white">Continue</button>

</form>
{% endblock %}
