{% extends 'AdminBundle::layout.html.twig' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/GeneralList.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
window._page_exec_stack.push(function() {
	window.DeskPRO_Page_EmailFromsList = new DeskPRO.Admin.PageHandler.GeneralList('#email_froms');
});
</script>
{% endblock %}
{% block page_id "email_froms" %}
{% block content %}

<div style="text-align:right; padding-bottom: 10px;">
	<a class="icon tickets popout-trigger" href="{{ path('admin_emailfroms_new') }}" data-height="400" data-width="580">Create New From Address</a>
</div>

<ul class="item-list">
	{% for email_from in all_email_froms %}
		{% include 'AdminBundle:EmailFroms:list-row.html.twig' %}
	{% endfor %}
</ul>

{% endblock %}