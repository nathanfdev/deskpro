{% set layout_tpl = 'AdminBundle:Portal:layout.html.twig' %}
{% set this_page = 'kb_fields' %}
{% extends 'AdminBundle:CustomDefAbstract:edit.html.twig' %}
{% block pagetitle %}
	<h1>
		{% if field.id %}
			Edit Field: {{ field.title }}
		{% else %}
			New Field: {{ phrase(field.getHandlerClassPhrase()) }}
		{% endif %}
	</h1>
	<nav>
		<a class="clean-white" href="{{ path('admin_customdefarticles') }}">Back to list</a>
	</nav>
{% endblock %}
