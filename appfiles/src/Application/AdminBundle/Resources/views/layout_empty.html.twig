<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
<head>
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
	<title>DeskPRO</title>

	<link rel="stylesheet" href="{{ asset('javascripts/jquery/jquery-ui/css/ui-lightness/jquery-ui.css') }}" type="text/css" media="screen"  />
	<link rel="stylesheet" href="{{ asset('javascripts/DeskPRO/UI/ui.css') }}" type="text/css" media="screen" />
	<link rel="stylesheet" href="{{ asset('javascripts/jquery/tipTip/tipTip.css') }}" type="text/css" media="screen"  />

	<link rel="stylesheet" href="{{ asset('stylesheets/agent/common.css') }}" type="text/css" media="screen" />
	<link rel="stylesheet" href="{{ asset('stylesheets/agent/ui-layout.css') }}" type="text/css" media="screen" />
	<link rel="stylesheet" href="{{ asset('stylesheets/agent/window-elements.css') }}" type="text/css" media="screen" />
	<link rel="stylesheet" href="{{ asset('stylesheets/agent/admin/interface.css') }}" type="text/css" media="screen" />

	<!--[if IE 8]>
	<link rel="stylesheet" href="{{ asset('stylesheets/agent/interface-ie.css') }}" type="text/css" media="screen" />
	<![endif]-->

	<style type="text/css">
		body.popout #pane_shell {
			top: 0;
		}

		body.popout #content_wrap {
			max-width: 10000px;
		}
	</style>

	<script type="text/javascript" src="http://ajax.googleapis.com/ajax/libs/jquery/1.6.1/jquery.js"></script>
	<script type="text/javascript" src="http://ajax.googleapis.com/ajax/libs/jqueryui/1.8.13/jquery-ui.min.js"></script>
	<script type="text/javascript" src="{{ asset('javascripts/jquery/jquery.cookie.js') }}"></script>
	<script type="text/javascript" src="{{ asset('javascripts/jquery/jquery.layout.min.js') }}"></script>
	{# <script type="text/javascript" src="{{ asset('javascripts/tiny_mce/jquery.tinymce.js') }}"></script> #}

	<script type="text/javascript" src="{{ asset('javascripts/jquery/tipTip/jquery.tipTip.min.js') }}"></script>
	<script type="text/javascript" src="{{ asset('javascripts/jquery/tag-it/tag-it.js') }}"></script>
	<script type="text/javascript" src="{{ asset('javascripts/jquery/jquery.sizes.min.js') }}"></script>
	<script type="text/javascript" src="{{ asset('javascripts/jquery/jquery.mousewheel.js') }}"></script>
	<script type="text/javascript" src="{{ asset('javascripts/mootools/mootools-core.min.js') }}"></script>

	<script type="text/javascript" src="{{ asset('javascripts/Orb/Orb.js') }}"></script>
	<script type="text/javascript" src="{{ asset('javascripts/Orb/Compat.js') }}"></script>

	<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/UI/Overlay.js') }}"></script>
	<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/UI/Menu.js') }}"></script>

	<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Form/InlineEdit.js') }}"></script>
	<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Form/RuleBuilder.js') }}"></script>

	<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/MessageBroker.js') }}"></script>

	<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/Window.js') }}"></script>
	<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/Basic.js') }}"></script>

	<script type="text/javascript" charset="utf-8">
		var DP_TINYMCE_URL = '{{ asset('javascripts/tiny_mce/tiny_mce.js') }}';
		var BASE_URL = '{{ path('user') }}';
		var ASSETS_BASE_URL = '{{ asset('') }}';
		if (!window.DESKPRO_URL_REGISTRY) window.DESKPRO_URL_REGISTRY = {};

		function _win_exec() {
			window.DeskPRO_Window = new DeskPRO.Admin.Window();

			if (window._page_exec) {
				_page_exec();
			}

			if (window.DeskPRO_Page) {
				DeskPRO_Page.initPage();
			}
		}

		{% block html_headjs_load %}{% endblock %}

		$(document).ready(function() {
			_win_exec();
		});
	</script>
	{% block html_head %}{% endblock %}
	{% block page_js_exec %}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %} popout">

{% set nav %}{% block nav %}{% endblock %}{% endset %}

<table cellspacing="0" cellpadding="0" width="100%" id="pane_shell" class="{% if not nav %}no-nav{% endif %}">
	<tr>
		{% if nav %}<td id="pane_nav">{{ nav|raw }}</td>{% endif %}
		<td id="pane_content"><div id="content_wrap">{% block content %}{% endblock %}</div></td>
	</tr>
</table>

</body>
</html>

