{% set this_page = 'feedback_cats' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% import 'AdminBundle:Common:admin-macros.html.twig' as admin %}
{% extends 'AdminBundle:Portal:layout.html.twig' %}
{% block pagetitle %}
	<h1>Idea Categories</h1>
	<nav>
		<a class="clean-white" href="{{ path('admin_feedback_cats_edit', {'category_id': '0'}) }}">Create New Category</a>
	</nav>
{% endblock %}
{% block content %}
<div class="dp-page-box">

<div class="page-content">
	{{ design.structure_table({ 'save_order_url': path('admin_feedback_cats_updateorders') }) }}
		{% for category in all_categories %}
			{% include 'AdminBundle:Ideas:cats-row.html.twig' %}
		{% endfor %}
	{{ design.structure_table_end() }}
</div>

</div>
{% endblock %}
