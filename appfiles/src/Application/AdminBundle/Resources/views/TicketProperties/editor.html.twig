{% extends 'AdminBundle::layout.html.twig' %}
{% block section 'tickets' %}
{% block sub_section 'editor' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/TicketEditor.js') }}"></script>
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/TicketEditor.js') }}"></script>
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/TicketEditorAgent.js') }}"></script>
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/EditorSave.js') }}"></script>
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/EditorRedraw.js') }}"></script>
<link rel="stylesheet" href="{{ asset('stylesheets/agent/admin/ticket-editor.css') }}" />
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
	window.DeskPRO_Page = new DeskPRO.Admin.PageHandler.TicketEditor($(document), {
		saveUrl: '{{ path('admin_tickets_editor_dep_save', {'department_id': department.id}) }}'
	});

	{% if current_state %}
		DeskPRO_Page.redrawData = {{current_state|json_encode|raw}};
	{% endif %}
}
</script>
{% endblock %}
{% block content %}

<div id="custom_field_rendered" style="display:none">
	{% for field in custom_ticket_fields %}
	<div class="ticket_field_{{field.field_def.id}}">
		{{ form_widget(field.formView) }}
	</div>
	{% endfor %}
	{% for field in custom_people_fields %}
	<div class="people_field_{{field.field_def.id}}">
		{{ form_widget(field.formView) }}
	</div>
	{% endfor %}
</div>

<div id="ticket_editor_head">
	<h1>Editor for <em>{{department.title}}</em></h1>
</div>

<table cellpadding="0" cellspacing="0" width="100%" style="margin-top: 15px;"><tr><td width="50%" valign="top" style="padding-right: 7px;" class="dep-editor" id="user_dep_editor">

	<div class="head">
		<h1>User Ticket Form</h1>
	</div>
	<div class="field-list-wrap">
		<ul class="field-list">
			<li class="title">Core Fields</li>
			<li class="original field-item system-field category" data-item-type="ticket_category" >Category</li>
			<li class="original field-item system-field product" data-item-type="ticket_product" >Product</li>
			<li class="original field-item system-field priority" data-item-type="ticket_priority" >Priority</li>
			<li class="title">Ticket Fields</li>
			{% for field in custom_ticket_fields %}
			<li class="original ticket_field_{{field.field_def.id}} field-item" data-field-name="{{field.field_def.getTypeName()}}" data-item-id="{{field.field_def.id}}" data-item-type="ticket_field">
				{{field.title}}
			</li>
			{% endfor %}
			<li class="title">Person Fields</li>
			{% for field in custom_people_fields %}
			<li class="original people_field_{{field.field_def.id}} field-item" data-field-name="{{field.field_def.getTypeName()}}" data-item-id="{{field.field_def.id}}" data-item-type="people_field">
				{{field.title}}
			</li>
			{% endfor %}
		</ul>
		<br class="clear"/>
	</div>

	<div class="editor-option-top" style="margin-top: 10px;">
		<input type="text" id="user_dep_name" value="{{ phrase('obj_departments.' ~ department.id ~ '_title_user')|default(department.title) }}" />
	</div>

	<div id="user_dep_editor_default">
	<ul class="item-list display_item_list">
		<li class="no_elements_message">
			You have not enabled any fields. To add a field, drag one from above.
		</li>
	</ul>
	</div>

	<div class="editor-option-bottom">
		<label>
			<input type="checkbox" id="enable_captcha" value="1" {% if user_section.options.enable_captcha %}checked="checked"{% endif %} /> Enable CAPTCHA
		</label>
	</div>

</td><td width="50%" valign="top" style="padding-left: 7px;" class="dep-editor" id="agent_dep_editor">

	<div class="head">
		<h1>Agent Ticket View</h1>
	</div>
	<div class="field-list-wrap">
		<ul class="field-list">
			<li class="title">Core Fields</li>
			<li class="original field-item system-field category" data-item-type="ticket_category" >Category</li>
			<li class="original field-item system-field product" data-item-type="ticket_product" >Product</li>
			<li class="original field-item system-field priority" data-item-type="ticket_priority" >Priority</li>
			<li class="original field-item system-field workflow" data-item-type="ticket_workflow" >Workflow</li>
			<li class="title">Ticket Fields</li>
			{% for field in custom_ticket_fields %}
			<li class="original ticket_field_{{field.field_def.id}} field-item" data-field-name="{{field.field_def.getTypeName()}}" data-item-id="{{field.field_def.id}}" data-item-type="ticket_field">
				{{field.title}}
			</li>
			{% endfor %}
		</ul>
		<br class="clear"/>
	</div>
	<div class="agent-sections-wrap" id="agent_dep_editor_default">
		<div class="agent-section properties-box">
			<div class="head">
				<h4>Properties Box</h4>
			</div>
			<ul class="item-list display_item_list">
				<li class="no_elements_message">
					You have not enabled any fields. To add a field, drag one from above.
				</li>
			</ul>
		</div>
	</div>

	<div class="agent-section-tab" id="agent_dep_editor_toptabs">
		<div class="agent-section-tab-title">
			<button class="dp-button x-small add-group-btn">Add Tab</button>
			<h4>Top Tabs</h4>
		</div>
		<div class="agent-sections-wrap">
		</div>
	</div>

	<div class="agent-section-tab" id="agent_dep_editor_middletabs">
		<div class="agent-section-tab-title">
			<button class="dp-button x-small add-group-btn">Add Tab</button>
			<h4>Middle Tabs</h4>
		</div>
		<div class="agent-sections-wrap">
		</div>
	</div>

	<div class="agent-section-tab" id="agent_dep_editor_bodytabs">
		<div class="agent-section-tab-title">
			<button class="dp-button x-small add-group-btn">Add Tab</button>
			<h4>Main Tabs</h4>
		</div>
		<div class="agent-sections-wrap">
		</div>
	</div>

</td></tr></table>

<div style="margin-top: 15px; text-align: center">
	<button class="dp-button" id="editor_save_btn">Save</button>
</div>

{# Menus #}
<ul id="department_switcher_editor" class="menu department_id" style="display:none">
	{% for dep in departments %}
		<li><a href="{{ path('admin_tickets_editor_dep', {'department_id': dep.id}) }}">{{dep.title}}</a></li>
	{% endfor %}
</ul>
<ul id="field_menu" class="menu" style="display:none">
	{% for field in custom_ticket_fields %}
		<li data-item-name="{{field.title}}" data-item-id="ticket_field.{{field.field_def.id}}">{{field.title}}</li>
	{% endfor %}
</ul>

{% include 'AdminBundle:TicketProperties:editor-templates.html.twig' %}
{% endblock %}