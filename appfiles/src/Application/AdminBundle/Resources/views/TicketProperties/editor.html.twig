{% extends 'AdminBundle::layout.html.twig' %}
{% block section 'tickets' %}
{% block sub_section 'editor' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/TicketEditor.js') }}"></script>
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/TicketEditor.js') }}"></script>
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/TicketEditorAgent.js') }}"></script>
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/EditorSave.js') }}"></script>
<style type="text/css">
#ticket_editor_head {
	border-bottom: 1px solid #ccc;
	margin: -10px -10px 0 -10px;
	padding: 0 0 10px 3px;
}

#ticket_editor_head h1 {
	font-size: 25px;
	font-weight: normal;
}

#ticket_editor_head h1 em {
	font-style: normal;
	background-color: #E6EEF7;
	border: 1px solid #B0BFCF;
	border-left: 1px solid transparent;
	border-right: 1px solid transparent;
	border-top: 1px solid transparent;
	padding:  1px 1px 0 1px;

	-moz-border-radius: 3px;
	border-radius: 3px;
}

#ticket_editor_head h1 em:hover {
	cursor: pointer;

	border: 1px solid #B0BFCF;

	background-color: #E6EEF7;
	-moz-border-radius: 3px;
	border-radius: 3px;
}

.dep-editor h1 {
	background-color: #BACADE;

	-moz-border-radius-topleft: 5px;
	-moz-border-radius-topright: 5px;
	-moz-border-radius-bottomright: 0px;
	-moz-border-radius-bottomleft: 0px;
	border-top-left-radius: 5px;
	border-top-right-radius: 5px;
	border-bottom-right-radius: 0px;
	border-bottom-left-radius: 0px;

	padding: 4px 0 4px 8px;
	color: #fff;
	font-weight: normal;
}

.dep-editor .head h1 {
	font-size: 18px;
}

.dep-editor .head button {
	float: right;
	margin: 2px 4px 0 0;
}



.display-item {
	background-color: #E4E7EB;
	padding: 3px;
	border: 1px solid #C2C6CC;
	margin: 4px 8px 4px 8px;
	list-style-type: none;

	-moz-border-radius: 0px;
	border-radius: 0px;
}

.display-item:hover {
	cursor: move;
	background-color: #fff;
}

.display_item_list {
	-moz-border-radius: 0px !important;
	border-radius: 0px !important;
}

.display_item_list.drop-active {

}
.display_item_list.drop-active li {
	background-color: #EDECC2;
}

.display_item_list.droppable-hover li {
	background-color: #FFFB8C;
}

.display_item_list li {
	background-color: #F0F1F5;
	font-size: 10px;
	cursor: move;
}

.display_item_list li .remove {
	color: #820D0D;
	padding-right: 5px;
	margin-right: 3px;
	border-right: 1px solid #D0D2D6;
	cursor: pointer;
}
.display_item_list li .edit-rules {
	cursor: pointer;
}
.display_item_list li .edit-options {
	cursor: pointer;
	padding-left: 5px;
	margin-left: 3px;
	border-left: 1px solid #D0D2D6;
}

.field-list-wrap {
	background-color: #F2F2F2;
	padding: 8px;
}

.field-list {

}

.field-item {
	display: block;
	float: left;
	background-color: #E0E0D7;
	border: 1px solid #9E9C88;

	padding:  0 3px 0 3px;

	-moz-border-radius: 3px;
	border-radius: 3px;

	font-size: 10px;
	margin-right: 7px;
	margin-bottom: 2px;

	cursor: move;
}

.field-item.system-field {
	background-color: #D8EDED;
}

.field-item.disabled {
	background-color: #B3B3B3 !important;
	color: #595959 !important;
}

.agent-section {
	margin-top: 10px;
}

.agent-sections-wrap .agent-section .head {
	background-color: #D0D2D6;

	padding: 3px;

	-moz-border-radius-topleft: 5px;
	-moz-border-radius-topright: 5px;
	-moz-border-radius-bottomright: 0px;
	-moz-border-radius-bottomleft: 0px;
	border-top-left-radius: 5px;
	border-top-right-radius: 5px;
	border-bottom-right-radius: 0px;
	border-bottom-left-radius: 0px;
}

.agent-sections-wrap .agent-section .head h4 {
	font-size: 14px;
	font-weight: normal;
}

.agent-section-tab {
	background: #E6EEF7;
	padding:  5px;
	border: 1px solid #ACC7E6;
	margin-top: 5px;
}

.agent-section-tab-title {

}

.agent-section-tab-title h4 {
	font-size: 15px;
}

.agent-section-tab-title .add-group-btn {
	float: right;
	font-size: 10px;
	padding: 0 3px 0 3px;
}

.agent-section .head .remove {
	display: none;
	float: right;

	color: #447AB8;
	cursor: pointer;
	font-size: 10px;
	padding:  3px 3px 0 0;
}

.agent-section .head:hover .remove {
	display: block;
}
</style>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
	window.DeskPRO_Page = new DeskPRO.Admin.PageHandler.TicketEditor($(document), {
		saveUrl: '{{ path('admin_tickets_editor_dep_save', {'department_id': department.id}) }}'
	});
}
</script>
{% endblock %}
{% block content %}

<div id="ticket_editor_head">
	<h1>Editor for <em>{{department.title}}</em></h1>
</div>

<table cellpadding="0" cellspacing="0" width="100%" style="margin-top: 15px;"><tr><td width="50%" valign="top" style="padding-right: 7px;" class="dep-editor" id="user_dep_editor">

	<div class="head">
		<h1>User Ticket Form</h1>
	</div>
	<div class="field-list-wrap">
		<ul class="field-list">
			<li class="original field-item system-field category" data-item-type="ticket_category" data-item-id="ticket_category">Category</li>
			<li class="original field-item system-field product" data-item-type="ticket_product" data-item-id="ticket_product">Product</li>
			<li class="original field-item system-field priority" data-item-type="ticket_priority" data-item-id="ticket_priority">Priority</li>
			{% for field in custom_fields %}
			<li class="original ticket_field_{{field.field_def.id}} field-item" data-item-id="{{field.field_def.id}}" data-item-type="ticket_field">
				{{field.title}}
			</li>
			{% endfor %}
		</ul>
		<br class="clear"/>
	</div>
	<ul class="item-list display_item_list" style="margin-top: 10px;">
		<li class="no_elements_message">
			You have not enabled any fields. To add a field, drag one from above.
		</li>
	</ul>

</td><td width="50%" valign="top" style="padding-left: 7px;" class="dep-editor" id="agent_dep_editor">

	<div class="head">
		<h1>Agent Ticket View</h1>
	</div>
	<div class="field-list-wrap">
		<ul class="field-list">
			<li class="original field-item system-field category" data-item-type="ticket_category" data-item-id="ticket_category">Category</li>
			<li class="original field-item system-field product" data-item-type="ticket_product" data-item-id="ticket_product">Product</li>
			<li class="original field-item system-field workflow" data-item-type="ticket_workflow" data-item-id="ticket_workflow">Workflow</li>
			<li class="original field-item system-field priority" data-item-type="ticket_priority" data-item-id="ticket_priority">Priority</li>
			{% for field in custom_fields %}
			<li class="original ticket_field_{{field.field_def.id}} field-item" data-item-id="{{field.field_def.id}}" data-item-type="ticket_field">
				{{field.title}}
			</li>
			{% endfor %}
		</ul>
		<br class="clear"/>
	</div>
	<div class="agent-sections-wrap">
		<div class="agent-section properties-box">
			<div class="head">
				<h4>Properties Box</h4>
			</div>
			<ul class="item-list display_item_list">
				<li class="no_elements_message">
					You have not enabled any fields. To add a field, drag one from above.
				</li>
			</ul>
		</div>
	</div>

	<div class="agent-section-tab">
		<div class="agent-section-tab-title">
			<button class="dp-button x-small add-group-btn">Add Tab</button>
			<h4>Top Tabs</h4>
		</div>
		<div class="agent-sections-wrap">
		</div>
	</div>

	<div class="agent-section-tab">
		<div class="agent-section-tab-title">
			<button class="dp-button x-small add-group-btn">Add Tab</button>
			<h4>Middle Tabs</h4>
		</div>
		<div class="agent-sections-wrap">
		</div>
	</div>

	<div class="agent-section-tab">
		<div class="agent-section-tab-title">
			<button class="dp-button x-small add-group-btn">Add Tab</button>
			<h4>Main Tabs</h4>
		</div>
		<div class="agent-sections-wrap">
		</div>
	</div>

</td></tr></table>

<div style="margin-top: 15px; text-align: center">
	<button class="dp-button" id="editor_save_btn">Save</button>
</div>

{# Menus #}
<ul id="department_switcher_editor" class="menu department_id" style="display:none">
	{% for dep in departments %}
		<li><a href="{{ path('admin_tickets_editor_dep', {'department_id': dep.id}) }}">{{dep.title}}</a></li>
	{% endfor %}
</ul>
<ul id="field_menu" class="menu" style="display:none">
	{% for field in custom_fields %}
		<li data-item-name="{{field.title}}" data-item-id="ticket_field.{{field.field_def.id}}">{{field.title}}</li>
	{% endfor %}
</ul>

{% include 'AdminBundle:TicketProperties:editor-templates.html.twig' %}
{% endblock %}