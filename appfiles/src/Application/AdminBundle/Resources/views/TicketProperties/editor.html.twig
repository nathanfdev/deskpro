{% set this_page = 'ticket_editor' %}
{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/ElementHandler/TicketEditor.js') }}"></script>
<script type="text/javascript">
var TICKET_DISPLAY_DATA = {{ page_data|json_encode|raw }};
</script>
{% endblock %}
{% block page_nav %}
<div>
	<section class="top">
		{% if is_default and not (not department and section == 'create') %}<div class="disable-overlay"></div>{% endif %}
		<header>
			<h4>Ticket Elements</h4>
		</header>
		<article id="ticket_elements">
			<ul>
				<li class="draggable irremovable" data-item-id="ticket_department"><label>Department</label></li>
				{% if section == 'create' %}
					<li class="draggable irremovable" data-item-id="message"><label>Ticket Message</label></li>
					<li class="draggable irremovable" data-item-id="ticket_subject"><label>Ticket Subject</label></li>
					<li class="draggable" data-item-id="attachments"><label>Attachments</label></li>
				{% endif %}
				<li class="draggable" data-item-id="ticket_category"><label>Category</label></li>
				<li class="draggable" data-item-id="ticket_product"><label>Product</label></li>
				<li class="draggable" data-item-id="ticket_priority"><label>Priority</label></li>
				{% for field in custom_ticket_fields %}
					<li class="draggable" data-item-id="ticket_field[{{field.field_def.id}}]">
						<label>{{field.title}}</label>
					</li>
				{% endfor %}
				<li class="draggable" data-item-id="captcha"><label>CAPTCHA</label></li>
			</ul>
		</article>
	</section>

	<section class="top">
		<header>
			<h4>Add to your website</h4>
		</header>
		<article id="ticket_elements">
			<ul>
				<li><label>Direct Link</label></li>
				<li><label>Popup Window Link</label></li>
				<li><label>Embed Widget</label></li>
			</ul>
		</article>
	</section>
</div>
{% endblock %}
{% block pagebar %}
	<ul>
		<li>Ticket Form Editor</li>
	</ul>
{% endblock %}
{% block content %}

<div style="padding: 10px 10px 0 10px">
{{ design.helpbox() }}
	<p>
		You can edit the form a user sees when they go to submit a ticket. Just drag options from the left into the area below
		to enable more fields.
	</p>
{{ design.helpbox_end() }}
</div>

<div class="pagetop-option">
	<input type="checkbox" class="onoff-slider" id="per_department_check" data-update-url="{{ path('admin_tickets_editor_toggleper') }}" {% if app.getSetting('core_tickets.per_department_form') %}checked="checked"{% endif %}/> Enable custom layouts for each department
	{% if app.getSetting('core_tickets.per_department_form') %}
		<div class="sub">
			Editing the layout for: <span id="department_switcher" class="switcher"><span>{% if department %}{{ department.full_title }}{% else %}Default Layout{% endif %}</span></span>
		</div>
	{% endif %}
</div>

<div class="content-tabs">
	<nav>
		<ul>
			<li {% if section == 'create' %}class="on"{% endif %}>
				<a href="{{ path('admin_tickets_editor_dep', {'department_id': department.id|default('0')}) }}">New Ticket Form</a>
			</li>
			<li {% if section == 'view' %}class="on"{% endif %}>
				<a href="{{ path('admin_tickets_editor_dep', {'department_id': department.id|default('0'), 'section': 'view'}) }}">View Ticket Page</a>
			</li>
			<li class="{% if section == 'modify' %}on{% endif %}">
				<a href="{{ path('admin_tickets_editor_dep', {'department_id': department.id|default('0'), 'section': 'modify'}) }}">Modify Ticket Form</a>
			</li>
		</ul>
		<br />
	</nav>

	{% if not (not department and section == 'create') %}
	<div class="editor-toggle-alt-view">
		<input
			type="checkbox"
			class="onoff-slider"
			id="alternative_view_toggle"
			data-enable="{{ path('admin_tickets_editor_dep_init', {department_id: department.id|default(0), section: section}) }}"
			data-disable="{{ path('admin_tickets_editor_dep_revert', {department_id: department.id|default(0), section: section}) }}"
			{% if not is_default %}checked="checked"{% endif %}
		/>
		Enable alternative layout for {% if section == 'view' %}View Ticket Page{% else %}Modify Ticket Form{% endif %}
	</div>
	{% endif %}

	<section>
		<form
			action="{{ path('admin_tickets_editor_dep_save', {'department_id': department.id|default(0), 'section': section }) }}"
			method="post"
			class="dp-page-box"
			id="admin_ticket_editor"
			data-element-handler="DeskPRO.Admin.ElementHandler.TicketEditor"
			data-section="{{section}}"
		>
		{% if is_default and not (not department and section == 'create') %}<div class="disable-overlay"></div>{% endif %}

		<ul id="admin_ticket_editor_items" class="dp-form">
			<li class="no-items-notice">
				Drag and drop fields from the left onto this area to start designing your form.
			</li>
		</ul>

		<div class="save-row">
			<div class="is-not-loading">
				<button class="clean-white save-trigger">Save Form</button>
			</div>
			<div class="is-loading" style="padding-top: 7px">
				<div class="loading-icon-flat">&nbsp;</div>
			</div>
		</div>
		</form>
	</section>
</div>

{############################
 # Main row template
 ############################}
<script type="text/x-deskpro-plain" id="editor_row_tpl">
	<li class="form-item dp-form-row">
		<div class="dp-block-controls">
			<ul>
				<li class="dp-edit edit-field-trigger"><span></span></li>
				<li class="dp-remove remove-field-trigger"><span></span></li>
			</ul>
		</div>
		<div class="dp-form-label">
			<label class="field-title"></label>
		</div>
		<article class="dp-form-input"></article>

		<div class="field-options-overlay" style="width: 550px; height: 260px; display: none;">
			<div class="overlay-title">
				<span class="close-trigger close-overlay"></span>
				<h4>Field Options</h4>
			</div>
			<div class="overlay-content">
				<div class="dp-form">
					<div class="choices-container"></div>
					<div class="dp-form-row">
						<div class="dp-form-label">
							<label>
								Only show this field when
								<select name="term_match_type">
									<option value="all">all</option>
									<option value="any">any</option>
								</select>
								of these terms match
							</label>
						</div>
						<div class="dp-form-input">
							<div class="criteria-form search-form">
								<div class="search-terms"></div>
								<div class="term"><span class="add-term">+</span> Add a new criteria</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</li>
</script>

{############################
 # For choice-type fields, allow selection of which options to display
 ############################}
<script type="text/x-deskpro-plain" id="field_options_choices_tpl">
	<div class="dp-form-row">
		<div class="dp-form-label">
			<label>
				<input type="checkbox" class="custom_options" name="custom_options" value="1" /> Customize choices to display
			</label>
		</div>
		<div class="dp-form-input custom-options" style="display:none"></div>
	</div>
</script>

{############################
 # Subject
 ############################}
<script type="text/x-deskpro-plain" id="rendered_field_ticket_subject">
	<div class="subject">
		<input type="text" />
	</div>
</script>

{############################
 # Department
 ############################}
<script type="text/x-deskpro-plain" id="rendered_field_ticket_department">
	<div class="subject">
		<select><option></option><option>------------------</option></select>
	</div>
</script>

{############################
 # Message field
 ############################}
<script type="text/x-deskpro-plain" id="rendered_field_message">
	<div class="message">
		<textarea class="message-input" style="height: 80px"></textarea>
	</div>
</script>

{############################
 # Attachments field
 ############################}
<script type="text/x-deskpro-plain" id="rendered_field_attachments">
	<div class="attachments">
		<input type="file" /> <button class="clean-white small">Upload</button>
	</div>
</script>

{############################
 # Category field value
 ############################}
<script type="text/x-deskpro-plain" id="rendered_field_ticket_category">
	<div class="ticket-category">
		<select class="ticket-category-input field-value">
			<option>Choose a category...</option>
			{% for id,label in term_options.ticket_categories_full %}
				<option value="{{id}}">{{label}}</option>
			{% endfor %}
		</select>
	</div>
</script>

{############################
 # Product field value
 ############################}
<script type="text/x-deskpro-plain" id="rendered_field_ticket_product">
	<div class="ticket-product">
		<select class="ticket-product-input field-value">
			<option>Choose a product...</option>
			{% for id,label in term_options.products %}
				<option value="{{id}}">{{label}}</option>
			{% endfor %}
		</select>
	</div>
</script>

{############################
 # Priority field value
 ############################}
<script type="text/x-deskpro-plain" id="rendered_field_ticket_priority">
	<div class="ticket-priority">
		<select class="ticket-priority-input field-value">
			<option>Choose a priority...</option>
			{% for id,label in term_options.priorities %}
				<option value="{{id}}">{{label}}</option>
			{% endfor %}
		</select>
	</div>
</script>

{############################
 # Custom fields
 ############################}

{% for field in custom_ticket_fields %}
	<script type="text/x-deskpro-plain" id="rendered_field_ticket_field_{{field.id}}">
		<div class="ticket-field field-value">
			{{ render_custom_field_form(field) }}
		</div>
	</script>
{% endfor %}

{############################
 # Captcah field rnedered
 ############################}
<script type="text/x-deskpro-plain" id="rendered_field_captcha">
	<div class="captcha">
		<img src="{{ asset('images/admin/captcha-example.png') }}"
	</div>
</script>


{############################
 # Criteria options
 ############################}
<div id="criteria_tpl" class="search-builder-tpl" style="display:none">
	<div class="row">
		<div class="term">
			<div class="type"></div>
			<div class="op"></div>
			<div class="options"></div>
			<div class="remove">-</div>
		</div>
	</div>
	{% if term_options.products %}
		<div class="type" title="Product" data-rule-type="product">
			<div class="op">
				<select name="op">
					<option value="is">is</option>
					<option value="not">is not</option>
				</select>
			</div>
			<div class="options">
				<select name="product">
					{% for id,label in term_options.products %}
						<option value="{{id}}">{{label}}</option>
					{% endfor %}
				</select>
			</div>
		</div>
	{% endif %}
	{% if term_options.ticket_categories_full %}
		<div class="type" title="Category" data-rule-type="category">
			<div class="op">
				<select name="op">
					<option value="is">is</option>
					<option value="not">is not</option>
				</select>
			</div>
			<div class="options">
				<select name="category">
					{% for id,label in term_options.ticket_categories_full %}
						<option value="{{id}}">{{label}}</option>
					{% endfor %}
				</select>
			</div>
		</div>
	{% endif %}
	{% if term_options.priorities %}
		<div class="type" title="Priority" data-rule-type="priority">
			<div class="op">
				<select name="op">
					<option value="is">is</option>
					<option value="not">is not</option>
					<option value="lt">is less than</option>
					<option value="gt">is greater than</option>
				</select>
			</div>
			<div class="options">
				<select name="priority">
					{% for id,label in term_options.priorities %}
						<option value="{{id}}">{{label}}</option>
					{% endfor %}
				</select>
			</div>
		</div>
	{% endif %}
	{% if term_options.ticket_workflows %}
		<div class="type" title="Workflow" data-rule-type="workflow">
			<div class="op">
				<select name="op">
					<option value="is">is</option>
					<option value="not">is not</option>
				</select>
			</div>
			<div class="options">
				<select name="workflow">
					{% for id,label in term_options.ticket_workflows %}
						<option value="{{id}}">{{label}}</option>
					{% endfor %}
				</select>
			</div>
		</div>
	{% endif %}
</div>

<div class="optionbox" id="department_ob">
	<section data-section-name="department">
		<header>
			<h3>Switch to department</h3>
			<input type="text" class="filter-box" placeholder="Filter..." />
		</header>
		<ul>
			<li class="top first emphasis">
				<input
					type="radio"
					name="dep_radio"
					value="0"
					{% if not department %}checked="checked"{% endif %}
					data-refresh-url="{{ path('admin_tickets_editor_dep', {'department_id': '0', 'section': section}) }}"
				/>
				<label>Default Layout</label>
			</li>
			{% for dep in department_hierarchy %}
				<li
					class="top {% if dep.children %}group-title{% endif %} item-{{ dep.id }}"
					data-item-id="{{ dep.id }}"
					data-full-title="{{ dep.title }}"
				>
					{% if not dep.children %}
					<input
						type="radio"
						name="dep_radio"
						value="{{ dep.id }}"
						{% if department.id == dep.id %}checked="checked"{% endif %}
						data-refresh-url="{{ path('admin_tickets_editor_dep', {'department_id': dep.id, 'section': section}) }}"
					/>
					{% endif %}
					<label>{{ dep.title }}</label>
				</li>
				{% if dep.children %}
					{% for subdep in dep.children %}
						<li
							class="child item-{{ subdep.id }} child-of-{{ dep.id }}"
							data-item-id="{{ dep.id }}"
							data-parent-id="{{ dep.id }}"
							data-full-title="{{ dep.title }} &gt; {{ subdep.title }}"
						>
							<span class="elbow-end"></span>
							<input
								type="radio"
								name="dep_radio"
								value="{{ subdep.id }}"
								{% if department.id == dep.id %}checked="checked"{% endif %}
								data-refresh-url="{{ path('admin_tickets_editor_dep', {'department_id': subdep.id, 'section': section}) }}"
							/>
							<label>{{subdep.title}}</label>
						</li>
					{% endfor %}
				{% endif %}
			{% endfor %}
		</ul>
	</section>
</div>
{% endblock %}
