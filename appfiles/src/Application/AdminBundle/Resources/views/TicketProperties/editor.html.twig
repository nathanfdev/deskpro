{% set this_page = 'ticket_editor' %}
{% extends 'AdminBundle::layout.html.twig' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/ElementHandler/TicketEditor.js') }}"></script>
{% endblock %}
{% block page_nav %}
<div>
	<section class="top">
		<header>
			<h4>Ticket Elements</h4>
		</header>
		<article id="ticket_elements">
			<ul>
				<li class="draggable" data-item-id="ticket_category"><label>Category</label></li>
				<li class="draggable" data-item-id="ticket_product"><label>Product</label></li>
				<li class="draggable" data-item-id="ticket_priority"><label>Priority</label></li>
				{% for field in custom_ticket_fields %}
					<li class="draggable" data-item-id="ticket_field[{{field.field_def.id}}]">
						<label>{{field.title}}</label>
					</li>
				{% endfor %}
				<li class="draggable" data-item-id="captcha"><label>CAPTCHA</label></li>
			</ul>
		</article>
	</section>
</div>
{% endblock %}
{% block pagetitle %}
	<h1>
		Ticket Form	Editor:
		<select id="department_switcher">
			<option
				value="0"
				data-refresh-url="{{ path('admin_tickets_editor_dep', {'department_id': 0}) }}"
			>Default</option>
			<option>--------------</option>
			{% for id,title in department_names %}
				<option
					value="{{id}}"
					{% if department_id == id %}checked="checked"{% endif %}
					data-refresh-url="{{ path('admin_tickets_editor_dep', {'department_id': id}) }}"
				>{{title}}</option>
			{% endfor %}
		</select>
	</h1>
{% endblock %}
{% block content %}
<div
	class="dp-page-box"
	id="admin_ticket_editor"
	data-element-handler="DeskPRO.Admin.ElementHandler.TicketEditor"
>

<ul id="admin_ticket_editor_items" class="dp-form">
	<li class="no-items-notice">
		Drag and drop fields from the left onto this area to start designing your form.
	</li>
</ul>

{############################
 # Main row template
 ############################}
<script type="text/x-deskpro-plain" id="editor_row_tpl">
	<li class="form-item dp-form-row">
		<div class="dp-block-controls">
			<ul>
				<li class="dp-edit edit-field-trigger"><span></span></li>
				<li class="dp-remove remove-field-trigger"><span></span></li>
			</ul>
		</div>
		<div class="dp-form-label">
			<label class="field-title"></label>
		</div>
		<article class="dp-form-input"></article>
	</li>
</script>

{############################
 # Category field value
 ############################}
<script type="text/x-deskpro-plain" id="rendered_field_ticket_category">
	<div class="ticket-category">
		<select class="ticket-category-input">
			<option>Choose a category...</option>
		</select>
	</div>
</script>

{############################
 # Product field value
 ############################}
<script type="text/x-deskpro-plain" id="rendered_field_ticket_product">
	<div class="ticket-product">
		<select class="ticket-product-input">
			<option>Choose a category...</option>
		</select>
	</div>
</script>

{############################
 # Priority field value
 ############################}
<script type="text/x-deskpro-plain" id="rendered_field_ticket_priority">
	<div class="ticket-priority">
		<select class="ticket-priority-input">
			<option>Choose a priority...</option>
		</select>
	</div>
</script>

{############################
 # Custom fields
 ############################}

{% for field in custom_ticket_fields %}
	<script type="text/x-deskpro-plain" id="rendered_field_ticket_field_{{field.id}}">
		<div class="ticket-field">
			{{ render_custom_field_form(field) }}
		</div>
	</script>
{% endfor %}

{############################
 # Captcah field rnedered
 ############################}
<script type="text/x-deskpro-plain" id="rendered_field_captcha">
	<div class="captcha">
		<img src="{{ asset('images/admin/captcha-example.png') }}"
	</div>
</script>


{############################
 # Criteria options
 ############################}
<div id="criteria_tpl" class="search-builder-tpl" style="display:none">
	<div class="row">
		<div class="term">
			<div class="type"></div>
			<div class="op"></div>
			<div class="options"></div>
			<div class="remove">-</div>
		</div>
	</div>
	{% if term_options.products %}
		<div class="type" title="Product" data-rule-type="product">
			<div class="op">
				<select name="op">
					<option value="is">is</option>
					<option value="not">is not</option>
				</select>
			</div>
			<div class="options">
				<select name="product">
					{% for id,label in term_options.products %}
						<option value="{{id}}">{{label}}</option>
					{% endfor %}
				</select>
			</div>
		</div>
	{% endif %}
	{% if term_options.ticket_categories_full %}
		<div class="type" title="Category" data-rule-type="category">
			<div class="op">
				<select name="op">
					<option value="is">is</option>
					<option value="not">is not</option>
				</select>
			</div>
			<div class="options">
				<select name="category">
					{% for id,label in term_options.ticket_categories_full %}
						<option value="{{id}}">{{label}}</option>
					{% endfor %}
				</select>
			</div>
		</div>
	{% endif %}
	{% if term_options.priorities %}
		<div class="type" title="Priority" data-rule-type="priority">
			<div class="op">
				<select name="op">
					<option value="is">is</option>
					<option value="not">is not</option>
					<option value="lt">is less than</option>
					<option value="gt">is greater than</option>
				</select>
			</div>
			<div class="options">
				<select name="priority">
					{% for id,label in term_options.priorities %}
						<option value="{{id}}">{{label}}</option>
					{% endfor %}
				</select>
			</div>
		</div>
	{% endif %}
	{% if term_options.ticket_workflows %}
		<div class="type" title="Workflow" data-rule-type="workflow">
			<div class="op">
				<select name="op">
					<option value="is">is</option>
					<option value="not">is not</option>
				</select>
			</div>
			<div class="options">
				<select name="workflow">
					{% for id,label in term_options.ticket_workflows %}
						<option value="{{id}}">{{label}}</option>
					{% endfor %}
				</select>
			</div>
		</div>
	{% endif %}
</div>


</div>
{% endblock %}
