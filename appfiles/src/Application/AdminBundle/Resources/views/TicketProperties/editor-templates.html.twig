<script id="agent_section" type="text/x-jquery-tmpl">
	<div class="agent-section display_item display_item_group" data-item-type="group">
		<div class="head display_item_group_data">
			<span class="tab-remove remove">remove tab</span>
			<input type="text" name="title" style="width: 100px; font-size: 10px; padding: 1px;" value="Tab Title" />
		</div>
		<ul class="item-list display_item_list">
			<li class="no_elements_message">
				You have not added any fields. To add a field, drag one from above.
			</li>
		</ul>
	</div>
</script>

<script id="display_item_ticket_field_tpl" type="text/x-jquery-tmpl">
	<li id="display_item_${idClass}" class="ticket_field ${idClass} display_item"  data-field-name="${fieldName}" data-item-type="ticket_field" data-id-class="${idClass}" data-item-id="${itemId}" data-el-id="${elId}">
		<div style="float:right">
			<span class="remove">Remove this</span>
			<span class="edit-rules"><span class="tipped" data-tipped="rule_builder_${elId}" data-tipped-options="inline:true, closeButton: true, hideOn: false, showOn: 'click', target: 'self', hook: {target:  'leftmiddle', tooltip: 'righttop' }, maxWidth: 600, hideOnClickOutside: true, onHide: DeskPRO_Page.resetFormItems">Edit display rules</span></span>
			<span class="field-options"><span class="tipped" data-tipped="field_options_${elId}" data-tipped-options="inline:true, closeButton: true, hideOn: false, showOn: 'click', target: 'self', hook: {target:  'leftmiddle', tooltip: 'righttop' }, maxWidth: 600, hideOnClickOutside: true, onHide: DeskPRO_Page.resetFormItems">Field options</span></span>
		</div>

		<strong>${name}</strong><br />

		{% include 'AdminBundle:TicketProperties:editor-rules-part.html.twig' %}
	</li>
</script>

