<script id="display_item_ticket_category_tpl" type="text/x-jquery-tmpl">
	<li id="display_item_${idClass}" class="display_item_category ${idClass} display_item" data-item-type="ticket_category" data-id-class="${idClass}" data-el-id="${elId}">
		<div style="float:right">
			<span class="remove">Remove this</span>
			<span class="edit-rules"><span class="tipped" data-tipped="rule_builder_${elId}" data-tipped-options="inline:true, closeButton: true, hideOn: false, showOn: 'click', target: 'self', hook: {target:  'leftmiddle', tooltip: 'righttop' }, maxWidth: 600, hideOnClickOutside: true, onHide: DeskPRO_Page.resetFormItems">Edit display rules</span></span>
			<span class="edit-options"><span class="tipped" data-tipped="option_selection_${elId}" data-tipped-options="inline:true, closeButton: true, hideOn: false, showOn: 'click', target: 'self', hook: {target:  'leftmiddle', tooltip: 'righttop' }, maxWidth: 600, hideOnClickOutside: true, onHide: DeskPRO_Page.resetFormItems">Choose categories</span></span>
		</div>

		<strong>${name}</strong><br />

		<div id="option_selection_${elId}" data-id-class="${idClass}" style="display:none; margin-bottom: 11px;">
			Choose which categories to enable:
			<div style="width: 300px; height: 100px; overflow: auto;">
				<ul class="checkbox-list">
					<li><input type="checkbox" name="ticket_categories[]" value="0" checked="checked" /> None</li>
					{% for cat in ticket_options.ticket_categories_hierarchy %}
						<li><input type="checkbox" name="ticket_categories[]" value="{{cat.id}}" checked="checked" /> {{cat.title}}</li>
						{% if cat.children %}
							{% for subcat in cat.children %}
								<li style="margin-left: 10px;"><input type="checkbox" name="ticket_categories[]" value="{{subcat.id}}" checked="checked" /> {{subcat.title}}</li>
							{% endfor %}
						{% endif %}
					{% endfor %}
				</ul>
			</div>

			{% include 'AdminBundle:TicketProperties:editor-rules-part.html.twig' %}
		</div>
	</li>
</script>

