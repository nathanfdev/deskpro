{% extends 'AdminBundle::layout.html.twig' %}
{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% block pagebar %}
	<nav>
		<ul>
			<li><a href="{{ path('admin_customdeftickets_new_choosetype') }}">Add New Field</a></li>
		</ul>
	</nav>
	<ul>
		<li>Ticket Fields</li>
	</ul>
{% endblock %}
{% block content %}
<div
	class="dp-page-box"
	data-element-handler="DeskPRO.Admin.ElementHandler.TicketPropertiesList"
	data-set-setting-url="{{ path('admin_settings_set', {'setting_name': '_SETTING_NAME_', 'security_token': security_token('set_setting')}) }}"
	data-set-field-url="{{ path('admin_customdeftickets_setenabled', {'field_id': '00000'})|replace({'00000': '_FIELD_ID_'}) }}"
>

{{ design.block_sections() }}

	{{ design.block_sections_item() }}
		<header>
			<h3><a href="{{ path('admin_departments') }}">Departments</a></h3>
			<span class="count">{{counts.department}}</span>
			<div class="check-control">
				<input type="checkbox" {% if app.getSetting('core.enable_departments') %}checked="checked"{% endif %} class="onoff-slider" data-setting-name="core.enable_departments" />
			</div>
		</header>
		<p>
			Departments organize your helpdesk into separate compartments that handle different things. For example, Sales and Support.
		</p>
	{{ design.block_sections_item_end() }}

	{{ design.block_sections_item() }}
		<header>
			<h3><a href="{{ path('admin_products') }}">Products</a></h3>
			<span class="count">{{counts.product}}</span>
			<div class="check-control">
				<input type="checkbox" {% if app.getSetting('core.enable_products') %}checked="checked"{% endif %} class="onoff-slider" data-setting-name="core.enable_products" />
			</div>
		</header>
		<p>
			Products are a type of categorization that you can use across the entire helpdesk. Create a product, which
			is usually a real product or service your company offers, and use it categorize all kinds of content
			like tickets, ideas and articles.
		</p>
	{{ design.block_sections_item_end() }}

	{{ design.block_sections_item() }}
		<header>
			<h3><a href="{{ path('admin_ticketcats') }}">Ticket Categories</a></h3>
			<span class="count">{{counts.ticket_category}}</span>
			<div class="check-control">
				<input type="checkbox" {% if app.getSetting('core.enable_ticket_categories') %}checked="checked"{% endif %} class="onoff-slider" data-setting-name="core.enable_ticket_categories" />
			</div>
		</header>
		<p>
			Categories are a general organization field usually used to handle grouping tickets within a department.
		</p>
	{{ design.block_sections_item_end() }}

	{{ design.block_sections_item() }}
		<header>
			<h3><a href="{{ path('admin_ticketpris') }}">Ticket Priorities</a></h3>
			<span class="count">{{counts.ticket_priority}}</span>
			<div class="check-control">
				<input type="checkbox" {% if app.getSetting('core.enable_ticket_priorities') %}checked="checked"{% endif %} class="onoff-slider" data-setting-name="core.enable_ticket_priorities" />
			</div>
		</header>
		<p>
			Priorities rate how important a ticket is.
		</p>
	{{ design.block_sections_item_end() }}

	{{ design.block_sections_item() }}
		<header>
			<h3><a href="{{ path('admin_ticketworks') }}">Ticket Workflows</a></h3>
			<span class="count">{{counts.ticket_workflow}}</span>
			<div class="check-control">
				<input type="checkbox" {% if app.getSetting('core.enable_ticket_workflows') %}checked="checked"{% endif %} class="onoff-slider" data-setting-name="core.enable_ticket_workflows" />
			</div>
		</header>
		<p>
			Workflows can be used to record where in the lifetime a ticket currently is.
		</p>
	{{ design.block_sections_item_end() }}

	{% for field in fields %}
		{{ design.block_sections_item() }}
			<header>
				<h3><a class="popout-trigger" href="{{ path('admin_customdeftickets_edit', {'field_id': field.id}) }}">{{ field.title }}</a></h3>
				<div class="check-control">
					<input type="checkbox" {% if field.is_enabled %}checked="checked"{% endif %} class="onoff-slider" data-field-id="{{ field.id }}" />
				</div>
			</header>
			<p>Custom field: {{ phrase(field.handler_class_phrase) }}</p>
		{{ design.block_sections_item_end() }}
	{% endfor %}

{{ design.block_sections_end() }}

</div>
{% endblock %}
