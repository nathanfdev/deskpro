{% import 'AdminBundle:Common:design-macros.html.twig' as design %}
{% extends 'AdminBundle::layout.html.twig' %}
{% block prepage %}
	This page lets you customize the options displayed on the ticket form.
{% endblock %}
{% block pagetitle %}
	<nav>
		<button class="clean-white">Create Ticket Field</button>
	</nav>
	Ticket Fields
{% endblock %}
{% block content %}
<div class="dp-page-box">

{{ design.block_sections() }}

	{{ design.block_sections_item() }}
		<header>
			<h3><a href="{{ path('admin_departments') }}">Departments</a></h3>
			<span class="count">{{counts.department}}</span>
			<div class="check-control">
				<input type="checkbox" checked="checked" class="onoff-slider" />
			</div>
		</header>
		<p>
			Departments organize your helpdesk into separate compartments that handle different things. For example, Sales and Support.
		</p>
	{{ design.block_sections_item_end() }}

	{{ design.block_sections_item() }}
		<header>
			<h3><a href="{{ path('admin_products') }}">Products</a></h3>
			<span class="count">{{counts.product}}</span>
			<div class="check-control">
				<input type="checkbox" checked="checked" class="onoff-slider" />
			</div>
		</header>
		<p>
			Products are a type of categorization that you can use across the entire helpdesk. Create a product, which
			is usually a real product or service your company offers, and use it categorize all kinds of content
			like tickets, ideas and articles.
		</p>
	{{ design.block_sections_item_end() }}

	{{ design.block_sections_item() }}
		<header>
			<h3><a href="{{ path('admin_ticketcats') }}">Ticket Categories</a></h3>
			<span class="count">{{counts.ticket_category}}</span>
			<div class="check-control">
				<input type="checkbox" checked="checked" class="onoff-slider" />
			</div>
		</header>
		<p>
			Categories are a general organization field usually used to handle grouping tickets within a department.
		</p>
	{{ design.block_sections_item_end() }}

	{{ design.block_sections_item() }}
		<header>
			<h3><a href="{{ path('admin_ticketpris') }}">Ticket Priorities</a></h3>
			<span class="count">{{counts.ticket_priority}}</span>
			<div class="check-control">
				<input type="checkbox" checked="checked" class="onoff-slider" />
			</div>
		</header>
		<p>
			Priorities rate how important a ticket is.
		</p>
	{{ design.block_sections_item_end() }}

	{{ design.block_sections_item() }}
		<header>
			<h3><a href="{{ path('admin_ticketworks') }}">Ticket Workflows</a></h3>
			<span class="count">{{counts.ticket_workflow}}</span>
			<div class="check-control">
				<input type="checkbox" checked="checked" class="onoff-slider" />
			</div>
		</header>
		<p>
			Workflows can be used to record where in the lifetime a ticket currently is.
		</p>
	{{ design.block_sections_item_end() }}

	{% for field in fields %}
		{{ design.block_sections_item() }}
			<header>
				<h3><a class="popout-trigger" href="{{ path('admin_customdeftickets_edit', {'field_id': field.id}) }}">{{ field.title }}</a></h3>
				<div class="check-control">
					<input type="checkbox" checked="checked" class="onoff-slider" />
				</div>
			</header>
			<p>Custom field: {{ phrase(field.handler_class_phrase) }}</p>
		{{ design.block_sections_item_end() }}
	{% endfor %}

{{ design.block_sections_end() }}

</div>
{% endblock %}
