{% extends 'AdminBundle::layout.html.twig' %}
{% block section 'tickets' %}
{% block sub_section 'priorities' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/TicketProperties.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
	window.DeskPRO_Page = new DeskPRO.Admin.PageHandler.TicketProperties();
}
</script>
{% endblock %}
{% block content %}

<div class="pane">
	<div id="ticket_properties_tabs" class="pane-tabs nosel">
		<ul>
			<li class="tab-trigger tab-categories on" data-tab-for=".tab-content.tab-categories"><a>Categories</a></li>
			<li class="tab-trigger tab-priorities" data-tab-for=".tab-content.tab-priorities"><a>Priorities</a></li>
			<li class="tab-trigger tab-workflows" data-tab-for=".tab-content.tab-workflows"><a>Workflows</a></li>
			<li class="tab-trigger tab-custom-def" data-tab-for=".tab-content.tab-custom-def"><a>Fields</a></li>
		</ul>
	</div>
	<div class="tab-box-content pane-content">
		<div class="tab-content tab-categories on" data-tab-trigger=".tab-trigger.ticket-categories">
			{{tabs.categories|raw}}
		</div>
		<div class="tab-content tab-priorities" data-tab-trigger=".tab-trigger.ticket-priorities">
			{{tabs.priorities|raw}}
		</div>
		<div class="tab-content tab-workflows" data-tab-trigger=".tab-trigger.ticket-workflows">
			{{tabs.workflows|raw}}
		</div>
		<div class="tab-content tab-custom-def" data-tab-trigger=".tab-trigger.custom-def">
			{{tabs.custom_def|raw}}
		</div>
	</div>
</div>

{% endblock %}