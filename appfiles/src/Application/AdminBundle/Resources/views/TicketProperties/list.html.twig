{% extends 'AdminBundle::layout.html.twig' %}
{% block section 'tickets' %}
{% block sub_section 'properties' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/TicketProperties.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
	window.DeskPRO_Page = new DeskPRO.Admin.PageHandler.TicketProperties();
}
</script>
{% endblock %}
{% block content %}

<ul class="item-list system-list">
	<li class="system-item dark">
		<div style="float:right">
			<ul class="controls">
				<li class="edit"><a href="{{ path('admin_departments') }}">Manage Departments</a> &rarr;</li>
			</ul>
			<ul class="controls reverse">
				<li><span class="count">{{counts.department}}</span> departments</li>
			</ul>
		</div>
		Departments
	</li>
	<li class="system-item dark">
		<div style="float:right">
			<ul class="controls">
				<li class="edit"><a href="{{ path('admin_products') }}">Manage Products</a> &rarr;</li>
			</ul>
			<ul class="controls reverse">
				<li><span class="count">{{counts.product}}</span> products</li>
			</ul>
		</div>
		Products
	</li>
	<li class="system-item">
		<div style="float:right">
			<ul class="controls">
				<li class="edit"><a class="popout-trigger" href="{{ path('admin_ticketcats') }}">Manage Categories</a></li>
			</ul>
			<ul class="controls reverse">
				<li><span class="count">{{counts.ticket_category}}</span> categories</li>
			</ul>
		</div>
		Ticket Categories
	</li>
	<li class="system-item">
		<div style="float:right">
			<ul class="controls">
				<li class="edit"><a class="popout-trigger" href="{{ path('admin_ticketpris') }}">Manage Priorities</a></li>
			</ul>
			<ul class="controls reverse">
				<li><span class="count">{{counts.ticket_priority}}</span> priorities</li>
			</ul>
		</div>
		Ticket Priorities
	</li>
	<li class="system-item">
		<div style="float:right">
			<ul class="controls">
				<li class="edit"><a class="popout-trigger" href="{{ path('admin_ticketworks') }}">Manage Workflows</a></li>
			</ul>
			<ul class="controls reverse">
				<li><span class="count">{{counts.ticket_workflow}}</span> workflows</li>
			</ul>
		</div>
		Ticket Workflows
	</li>
</ul>

<div style="margin: 19px 0 4px 0;">
	<a style="float: right" class="dp-button green popout-trigger" href="{{ path('admin_customdeftickets_new_choosetype') }}">Create A New Field</a>
	<h2 style="font-size: 15px; padding-top: 6px;">Your fields</h2>
	<br class="clear" />
</div>

<ul class="item-list">
	{% for field in fields %}
		<li class="field-{{field.id}}">
			<div style="float:right">
				<ul class="controls">
					<li class="edit"><a class="popout-trigger" href="{{ path('admin_customdeftickets_edit', {'field_id': field.id}) }}">Edit</a></li>
				</ul>
			</div>
			<strong>{{field.title}}</strong>
			<div style="font-size: 90%">{{ phrase(field.handler_class_phrase) }}</div>
		</li>
	{% else %}
		<li>
			You have no custom fields defined.
		</li>
	{% endfor %}
</ul>

{% endblock %}