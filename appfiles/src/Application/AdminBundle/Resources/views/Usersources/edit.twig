{% extends 'AdminBundle::layout.twig' %}
{% block content %}

{% set form_url %}{% path 'admin_usersources_edit' with {'usersource_id':usersource.id|default(0)} %}{% endset %}

{{form.renderFormTag({'action': form_url, 'method':'POST'})|raw}}
{{form.renderHiddenTags()|raw}}

<div class="block" id="block-tables">
	<div class="content">
		<h2 class="title">Usersource Properties</h2>
		<div class="inner">
			<table class="table">
				<tr class="even">
					<td>Type</td>
					<td>{{usersource.handler_class}}</td>
				</tr>
				<tr>
					<td>Title</td>
					<td><input type="text" name="usersource[basic_properties][title]" value="{{usersource.title}}" size="40" /></td>
				</tr>
			</table>
		</div>
	</div>
</div>

{{rendered_type_form|raw}}

<div class="block">
	<div class="content">
		<div class="innter" style="padding: 10px">
			<div class="group navform wat-cf">
				<button class="button" type="submit">
					<img src="{% asset 'images/icons/tick.png' %}" alt="Save" /> Save
				</button>
			</div>
		</div>
	</div>
</div>

</form>

{% endblock %}
{% block sidebar %}
{% endblock %}