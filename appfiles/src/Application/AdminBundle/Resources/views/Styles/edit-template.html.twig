{% extends 'AdminBundle::layout_popout.html.twig' %}
{% block html_head %}
{#<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/StyleEdit.js') }}"></script>#}
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
	//window.DeskPRO_Page = new DeskPRO.Admin.PageHandler.StyleEdit({{style.id|default(0)}});
	$('button.save-trigger').click(function() {
		$('form:first').submit();
	});
}
</script>
{% endblock %}
{% block header %}
	<h1>Edit {{template_name}}</h1>
{% endblock %}
{% block content %}

<form action="{{ path('admin_styles_edittemplate', {'style_id': style.id, 'template_name': template_name}) }}" method="post">
<input type="hidden" name="process" value="1" />

<textarea class="text_area" name="template_contents" rows="20" cols="80" style="width: 99%; font-family: Monaco, 'Courier New', monospace;">{{template_contents}}</textarea>

</form>
{% endblock %}
{% block footer %}
	<button class="dp-button small save-trigger">Save</button>

{% endblock %}