{% extends 'AdminBundle::layout.html.twig' %}
{% block section 'crm' %}
{% block sub_section 'usergroups' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/StyleTemplatesList.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
	window.DeskPRO_Page = new DeskPRO.Admin.PageHandler.StyleTemplatesList();
}
</script>
{% endblock %}
{% block content %}

<h1 style="font-size: 14pt;margin-bottom: 10px;">Templates in {{style.title}}</h1>

{% for bundle, template_list in template_files %}
	<h3>{{bundle}}</h3>
	<ul class="item-list">
		{% for template in template_list %}
			{% include 'AdminBundle:Styles:list-templates-row.html.twig' %}
		{% endfor %}
	</ul>
	<br /><br />
{% endfor %}

{% endblock %}