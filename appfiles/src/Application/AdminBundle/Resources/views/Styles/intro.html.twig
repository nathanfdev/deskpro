{% extends 'AdminBundle::layout.html.twig' %}
{% block content %}

<div class="block"><div class="content">
	<h2>Introduction to Styles</h2>
	<div class="inner">
		<p>
			Styles control the <span class="highlight">look and feel</span> of your visual helpdesk. By editing a style you can change
			the color scheme and layout.
		</p>
		<p>
			A style is comprised of <span class="highlight">stylesheets</span> that control things like colors and fonts and sizes,
			and <span class="highlight">templates</span> that control the HTML markup that generates any given page.
		</p>
		<p>
			Any style can have <span class="highlight">sub-styles</span> that inherit all properties from their parents. This allows you to
			create similar styles that only change in some specific way (for example, color scheme or layout).
		</p>
	</div>
</div></div>

{% if has_no_styles %}
	<div class="block"><div class="content">
		<h2>Create a Style</h2>
		<div class="inner">
			<p>
				You currently have no styles defined. This means that the default system style is used. Create a style to start
				customizing your sites appearance. Don't worry, you can revert changes at any time if you make a mistake and
				the style won't be publicly visible until you choose to enable it.
			</p>
			<form action="{{ path('admin_styles_newstyle') }}" method="get">
				<div class="group navform wat-cf">
					<button class="button" type="submit">
						<img src="{{ asset('images/icons/tick.png') }}" alt="Save" /> Create a new style
					</button>
				</div>
			</form>
		</div>
	</div></div>
{% endif %}


{% endblock %}
{% block sidebar %}
	<div class="block notice">
		<h4>Need Help?</h4>
		<p>
			Read the <a href="">help pages</a> regarding styles for more information about things like how stylesheets work and the template syntax.
		</p>
	</div>
{% endblock %}