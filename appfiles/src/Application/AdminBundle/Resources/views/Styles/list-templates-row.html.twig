<li class="template {% if template in changed_templates %}customized{% endif %}" data-template-name="{{template}}">
	<div style="float:right">
		<ul class="controls">
			<li class="edit edit-trigger"><a href="{{ path('admin_styles_edittemplate', {'style_id': style.id, 'template_name': template}) }}" class="popout-trigger">edit</a></li>
			{% if template in changed_templates %}
				<li class="delete delete-trigger"><a href="{{ path('admin_styles_reverttemplate', {'style_id': style.id, 'template_name': template}) }}" onclick="return confirm('Are you sure you want to revert this template? Your custom changes will be lost forever.');">revert</a></li>
			{% endif %}
		</ul>
	</div>
	<div>
		{{template}}
	</div>
</li>