{% extends 'AdminBundle::layout_popout.html.twig' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Admin/PageHandler/StyleEdit.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
	window.DeskPRO_Page = new DeskPRO.Admin.PageHandler.StyleEdit({{style.id|default(0)}});

	{% if row_html %}
		window.DeskPRO_Page.updateParentListRow({{ row_html|json_encode|raw }});
	{% endif %}
}
</script>
{% endblock %}
{% block header %}
	<h1>{% if style.id %}Edit Style{% else %}New Style{% endif %}</h1>
{% endblock %}
{% block content %}

<form action="{{ path('admin_styles_editstyle', {'style_id': style.id|default(0)}) }}" method="post">
<input type="hidden" name="process" value="1" />

<div class="form-panel">
	<div class="row">
		<label>Title</label>
		{{ form_widget(form.title) }}
	</div>
	<div class="row">
		<label>Note / Description</label>
		{{ form_widget(form.note) }}
	</div>
	{% if form.parent_id %}
		<div class="row">
			<label>Parent Style</label>
			{{ form_widget(form.parent_id) }}
		</div>
	{% endif %}
</div>

<br /><br />

</form>
{% endblock %}
{% block footer %}
	<button class="dp-button small save-trigger">Save</button>

{% endblock %}