<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
<head>
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
	<title>Web App Theme</title>
	<link rel="stylesheet" href="{% asset 'static/stylesheets/base.css' %}" type="text/css" media="screen" />
	<link rel="stylesheet" href="{% asset 'static/stylesheets/themes/blue/style.css' %}" type="text/css" media="screen" />
	<script type="text/javascript" charset="utf-8" src="{% asset 'static/javascripts/jquery-1.3.min.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'static/javascripts/jquery.scrollTo.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'static/javascripts/jquery.localscroll.js' %}"></script>
</head>
<body>
	<div id="container">
		<div id="header">
			<h1><a href="index.html">DeskPRO Tech Interface</a></h1>
			<div id="user-navigation">
				<ul class="wat-cf">
					<li><a href="#">Profile</a></li>
					<li><a href="#">Settings</a></li>
					<li><a class="logout" href="#">Logout</a></li>
				</ul>
			</div>
			<div id="main-navigation">
				<ul class="wat-cf">
					<li class="first"><a href="#block-text">Dashboard</a></li>
					<li class="active"><a href="#block-text">Tickets</a></li>
				</ul>
			</div>
		</div>
		<div id="wrapper" class="wat-cf">
			<div id="main">
				{% block content%}{%endblock%}
				<div id="footer">
					<div class="block">
						<p>Copyright &copy; 2010 Your Site.</p>
					</div>
				</div>
			</div>
			<div id="sidebar">
				<div class="block">
					<h3>Simple Block</h3>
					<div class="content">
						<p>Lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</p>
					</div>
				</div>
				<div class="block">
					{% block sidebar %}{% endblock %}
				</div>
			</div>
		</div>
	</div>
</body>
</html>

