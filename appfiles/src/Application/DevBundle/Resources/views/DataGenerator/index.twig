<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">
<head>
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
	<title>Data Generator</title>
</head>
<body>

<form action="{% path 'dev_datagen_run' %}" method="post">
	<h3>Users</h3>
	Number of users: <input type="text" name="num_users" value="10000" /><br />
	How many are agents: <input type="text" name="num_agents" value="20" /><br />
	<hr />
	Number of companies: <input type="text" name="num_companies" value="1500" /><br />
	Number of usergroups: <input type="text" name="num_companies" value="4" /><br />
	<hr />
	Max labels per person: <input type="text" name="max_labels_per_person" value="4" />
	<hr />
	Number of int custom fields: <input type="text" name="num_custom_user_int" value="1" />
	Max range for each: <input type="text" name="custom_user_int_max[]" value="5" size="3" /> <input type="text" name="custom_user_int_max[]" value="10" size="3" /> <input type="text" name="custom_user_int_max[]" value="15" size="3" />
	<hr />
	Number of text custom fields: <input type="text" name="num_custom_user_string" value="1" />
	<hr />
	Number of select custom fields: <input type="text" name="num_custom_user_select" value="1" />
	Max number of selected options for each: <input type="text" name="custom_int_max[]" value="5" size="1" /> <input type="text" name="custom_int_max[]" value="10" size="3" /> <input type="text" name="custom_int_max[]" value="15" size="5" />

	<h3>Tickets</h3>
	Number of tickets: <input type="text" name="num_tickets" value="300000" /><br />
	Number of departments: <input type="text" name="num_departments" value="3" /><br />
	Number of categories: <input type="text" name="num_categories" value="8" /><br />
	Number of priorities: <input type="text" name="num_priorities" value="5" /><br />
	Number of products: <input type="text" name="num_products" value="20" /><br />
	Number of total participants in all tickets: <input type="text" name="num_participants" value="150000" /><br />
	Chance of a ticket having an attachment: <input type="text" name="chance_ticket_attach" value="20" /><br />
	Min start date of a ticket: <input type="text" name="ticket_start_date" value="2010-01-01" /><br />
	Max start date of a ticket: <input type="text" name="ticket_start_date" value="2010-11-30" /><br />
	Max labels per ticket: <input type="text" name="max_labels_per_person" value="10" />
	<hr />
	Number of int custom_ticket fields: <input type="text" name="num_custom_ticket_int" value="1" />
	Max range for each: <input type="text" name="custom_ticket_int_max[]" value="5" size="3" /> <input type="text" name="custom_ticket_int_max[]" value="10" size="3" /> <input type="text" name="custom_ticket_int_max[]" value="15" size="3" />
	<hr />
	Number of text custom_ticket fields: <input type="text" name="num_custom_ticket_string" value="1" />
	<hr />
	Number of select custom_ticket fields: <input type="text" name="num_custom_ticket_select" value="1" />
	Max number of selected options for each: <input type="text" name="custom_ticket_int_max[]" value="5" size="1" /> <input type="text" name="custom_ticket_int_max[]" value="10" size="3" /> <input type="text" name="custom_ticket_int_max[]" value="15" size="5" />

	<h3>Done</h3>
	New database name: <input type="text" name="dbname" value="{{dbname_generated}}" />	<input type="submit" value="Create database and fill" />
</form>

</body>
</html>