{% if id or classname %}
	{# if given an id or classname then we want a wrapper #}
	<div {% if id %}id="{{ id }}"{% endif %} class="{{ classname }}" style="display:none">
	<div class="row">
		<div class="term">
			<div class="remove">-</div>
			<div class="controls">
				<div class="type"></div>
				<div class="op"></div>
				<div class="options"></div>
			</div>
		</div>
	</div>
	<div class="type" title="Choose criteria..." data-rule-type="">
	</div>
{% endif %}
	{% if with_change_terms %}
		<div class="type" title="Performer" data-rule-type="action_performer">
			<div class="op">
				<select name="op" class="op">
					<option value="is">is</option>
					<option value="not">is not</option>
				</select>
			</div>
			<div class="options">
				<select name="action_performer">
					<option value="agent">Agent</option>
					<option value="user">User</option>
				</select>
			</div>
		</div>
	{% endif %}
	<div class="type" title="Originated interface" data-rule-type="creation_system" data-term-type="GenericMenuTerm" data-term-triggers="interface,orig-interface,original-interface">
		<div class="op">
			<select name="op" class="op">
				<option value="is">is</option>
				<option value="not">is not</option>
			</select>
		</div>
		<div class="options">
			<select name="creation_system">
				<option value="web">Web interface</option>
				<option value="web.person">-- By user</option>
				<option value="web.agent">-- By agent on behalf of user</option>
				<option value="gateway">Email</option>
			</select>
		</div>
	</div>
	{% if term_options.email_gateway_addresses %}
	<div class="type" title="Gateway address" data-rule-type="email_gateway_address" data-term-type="GenericMenuTerm" data-term-triggers="gateway,email-account">
		<div class="op">
			<select name="op" class="op">
				<option value="is">is</option>
				<option value="not">is not</option>
			</select>
		</div>
		<div class="options">
			<select name="receiving_gateway">
				{% for id,label in term_options.email_gateway_addresses %}
					<option value="{{id}}">{{label}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	{% endif %}
	<div class="type" title="Subject" data-rule-type="subject">
		<div class="op">
			<select name="op" class="op">
				<option value="is">is</option>
				<option value="not">is not</option>
				<option value="contains">contains</option>
				<option value="not_contains">does not contain</option>
			</select>
		</div>
		<div class="options">
			<input type="text" name="subject" value="" />
		</div>
	</div>
	<div class="type" title="Labels" data-rule-type="label" data-rule-handler="DeskPRO.Agent.RuleBuilder.LabelsTerm" data-label-type="tickets" data-term-type="GenericInputTerm" data-term-triggers="label,labelled,labels">
		<div class="op">
			<select name="op" class="op">
				<option value="is">is</option>
				<option value="not">is not</option>
				{% if with_change_terms %}
					<option value="changed">Changed</option>
					<option value="changed_to">Changed to include</option>
					<option value="changed_from">Changed to remove</option>
				{% endif %}
			</select>
		</div>
		<div class="options">
			{% include 'DeskPRO:Common:rulebuilder-labels-options.html.twig' %}
		</div>
	</div>
	<div class="type" title="Assigned Agent" data-rule-type="agent" data-term-type="GenericMenuTerm" data-term-triggers="agent">
		<div class="op">
			<select name="op" class="op">
				<option value="is">is</option>
				<option value="not">is not</option>
				{% if with_change_terms %}
					<option value="changed">Changed</option>
					<option value="changed_to">Changed to</option>
					<option value="changed_from">Changed from</option>
					<option value="not_changed_to">Not changed to</option>
					<option value="not_changed_from">Not changed from</option>
				{% endif %}
			</select>
		</div>
		<div class="options">
			<select name="agent">
				<option value="0">Unassigned</option>
				<option value="-1">Current Agent</option>
				{% for id,label in term_options.agents %}
					<option value="{{id}}">{{label}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	<div class="type" title="Subscribers" data-rule-type="participant" data-term-type="GenericMenuTerm" data-term-triggers="followers">
		<div class="op">
			<select name="op" class="op">
				<option value="is">include</option>
				<option value="not">does not include</option>
				{% if with_change_terms %}
					<option value="changed">Changed</option>
					<option value="changed_to">Changed to include</option>
					<option value="changed_from">Changed to remove</option>
				{% endif %}
			</select>
		</div>
		<div class="options">
			<select name="agent">
				<option value="-1">Current Agent</option>
				{% for id,label in term_options.agents %}
					<option value="{{id}}">{{label}}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	{% if term_options.agent_teams %}
		<div class="type" title="Agent Team" data-rule-type="agent_team" data-term-type="GenericMenuTerm" data-term-triggers="team,agent-team">
			<div class="op">
				<select name="op" class="op">
					<option value="is">is</option>
					<option value="not">is not</option>
					{% if with_change_terms %}
						<option value="changed">Changed</option>
						<option value="changed_to">Changed to</option>
						<option value="changed_from">Changed from</option>
						<option value="not_changed_to">Not changed to</option>
						<option value="not_changed_from">Not changed from</option>
					{% endif %}
				</select>
			</div>
			<div class="options">
				<select name="agent_team">
					<option value="0">No team</option>
					<option value="-1">Any of current agents teams</option>
					{% for id,title in term_options.agent_teams %}
						<option value="{{id}}">{{title}}</option>
					{% endfor %}
				</select>
			</div>
		</div>
	{% endif %}
	<div class="type" title="Status" data-rule-type="status" data-term-type="GenericMenuTerm" data-term-triggers="status">
		<div class="op">
			<select name="op" class="op">
				<option value="is">is</option>
				<option value="not">is not</option>
				{% if with_change_terms %}
					<option value="changed">Changed</option>
					<option value="changed_to">Changed to</option>
					<option value="changed_from">Changed from</option>
					<option value="not_changed_to">Not changed to</option>
					<option value="not_changed_from">Not changed from</option>
				{% endif %}
			</select>
		</div>
		<div class="options">
			<select name="status">
				<option value="awaiting_agent">Awaiting Agent</option>
				<option value="awaiting_user">Awaiting User</option>
				<option value="resolved">Resolved</option>
				<option value="closed">Closed</option>
				<option value="hidden">Hidden (awaiting validating, spam)</option>
			</select>
		</div>
	</div>
	<div class="type" title="Date created" data-rule-type="date_created" data-rule-handler="DeskPRO.Agent.RuleBuilder.DateTerm" data-term-type="GenericDateTerm" data-term-triggers="date-created">
		<div class="op">
			<select name="op" class="op">
				<option value="lte">before</option>
				<option value="gte">after</option>
				<option value="between">between</option>
			</select>
		</div>
		<div class="options">
			{% include 'DeskPRO:Common:rulebuilder-date-options.html.twig' %}
		</div>
	</div>
	<div class="type" title="Date resolved" data-rule-type="date_resolved" data-rule-handler="DeskPRO.Agent.RuleBuilder.DateTerm" data-term-triggers="date-resolved">
		<div class="op">
			<select name="op" class="op">
				<option value="lte">before</option>
				<option value="gte">after</option>
				<option value="between">between</option>
			</select>
		</div>
		<div class="options">
			{% include 'DeskPRO:Common:rulebuilder-date-options.html.twig' %}
		</div>
	</div>
	<div class="type" title="Date closed" data-rule-type="date_closed" data-rule-handler="DeskPRO.Agent.RuleBuilder.DateTerm">
		<div class="op">
			<select name="op" class="op">
				<option value="lte">before</option>
				<option value="gte">after</option>
				<option value="between">between</option>
			</select>
		</div>
		<div class="options">
			{% include 'DeskPRO:Common:rulebuilder-date-options.html.twig' %}
		</div>
	</div>
	<div class="type" title="Date of last agent reply" data-rule-type="date_last_agent_reply" data-rule-handler="DeskPRO.Agent.RuleBuilder.DateTerm">
		<div class="op">
			<select name="op" class="op">
				<option value="lte">before</option>
				<option value="gte">after</option>
				<option value="between">between</option>
			</select>
		</div>
		<div class="options">
			{% include 'DeskPRO:Common:rulebuilder-date-options.html.twig' %}
		</div>
	</div>
	<div class="type" title="Date of last user reply" data-rule-type="date_last_user_reply" data-rule-handler="DeskPRO.Agent.RuleBuilder.DateTerm">
		<div class="op">
			<select name="op" class="op">
				<option value="lte">before</option>
				<option value="gte">after</option>
				<option value="between">between</option>
			</select>
		</div>
		<div class="options">
			{% include 'DeskPRO:Common:rulebuilder-date-options.html.twig' %}
		</div>
	</div>
	{% if term_options.products %}
		<div class="type" title="Product" data-rule-type="product" data-term-type="GenericMenuTerm" data-term-triggers="prod,product">
			<div class="op">
				<select name="op" class="op">
					<option value="is">is</option>
					<option value="not">is not</option>
					{% if with_change_terms %}
						<option value="changed">Changed</option>
						<option value="changed_to">Changed to</option>
						<option value="changed_from">Changed from</option>
						<option value="not_changed_to">Not changed to</option>
						<option value="not_changed_from">Not changed from</option>
					{% endif %}
				</select>
			</div>
			<div class="options">
				<select name="product">
					{% for id,label in term_options.products %}
						<option value="{{id}}">{{label}}</option>
					{% endfor %}
				</select>
			</div>
		</div>
	{% endif %}
	{% if term_options.departments_hierarchy %}
		<div class="type" title="Department" data-rule-type="department" data-term-type="GenericMenuTerm" data-term-triggers="dep,department">
			<div class="op">
				<select name="op" class="op">
					<option value="is">is</option>
					<option value="not">is not</option>
					{% if with_change_terms %}
						<option value="changed">Changed</option>
						<option value="changed_to">Changed to</option>
						<option value="changed_from">Changed from</option>
						<option value="not_changed_to">Not changed to</option>
						<option value="not_changed_from">Not changed from</option>
					{% endif %}
				</select>
			</div>
			<div class="options">
				<select name="department">
					{% for dep in term_options.departments_hierarchy %}
						<option value="{{dep.id}}">{{dep.title}}</option>
						{% if dep.children %}
							<option value="{{dep.id}}">{{dep.title}}</option>
							{% for subdep in dep.children %}
								<option value="{{subdep.id}}">-- {{subdep.title}}</option>
							{% endfor %}
						{% endif %}
					{% endfor %}
				</select>
			</div>
		</div>
	{% endif %}
	{% if term_options.categories %}
		<div class="type" title="Category" data-rule-type="category" data-term-type="GenericMenuTerm" data-term-triggers="cat,category">
			<div class="op">
				<select name="op" class="op">
					<option value="is">is</option>
					<option value="not">is not</option>
					{% if with_change_terms %}
						<option value="changed">Changed</option>
						<option value="changed_to">Changed to</option>
						<option value="changed_from">Changed from</option>
						<option value="not_changed_to">Not changed to</option>
						<option value="not_changed_from">Not changed from</option>
					{% endif %}
				</select>
			</div>
			<div class="options">
				<select name="category">
					{% for id,label in term_options.categories %}
						<option value="{{id}}">{{label}}</option>
					{% endfor %}
				</select>
			</div>
		</div>
	{% endif %}
	<div class="type" title="Urgency" data-rule-type="urgency" data-term-type="GenericInputTerm" data-term-triggers="urgency">
		<div class="op">
			<select name="op" class="op">
				<option value="is">is</option>
				<option value="not">is not</option>
				<option value="lte">&lt;=</option>
				<option value="gte">&gt;=</option>
				{% if with_change_terms %}
					<optgroup label="Changed">
						<option value="changed">Changed</option>
						<option value="changed_to">Changed to</option>
						<option value="changed_from">Changed from</option>
						<option value="not_changed_to">Not changed to</option>
						<option value="not_changed_from">Not changed from</option>
					</optgroup>
					<optgroup label="Changed (ranged)">
						<option value="changed_to_gte">Changed to &gt;=</option>
						<option value="changed_to_lte">Changed to &lt;=</option>
						<option value="changed_from_gte">Changed from &gt;=</option>
						<option value="changed_from_lte">Changed from &lt;=</option>
						<option value="not_changed_to_gte">Not changed to &gt;=</option>
						<option value="not_changed_from_lte">Not changed from &lt;=</option>
					</optgroup>
				{% endif %}
			</select>
		</div>
		<div class="options">
			<input type="text" size="4" value="" name="num" />
		</div>
	</div>
	{% if term_options.priorities %}
		<div class="type" title="Priority" data-rule-type="priority" data-term-type="GenericMenuTerm" data-term-triggers="pri,priority">
			<div class="op">
				<select name="op" class="op">
					<option value="is">is</option>
					<option value="not">is not</option>
					<option value="lte">is less than</option>
					<option value="gte">is greater than</option>
					{% if with_change_terms %}
						<option value="changed">Changed</option>
						<option value="changed_to">Changed to</option>
						<option value="changed_from">Changed from</option>
						<option value="not_changed_to">Not changed to</option>
						<option value="not_changed_from">Not changed from</option>
					{% endif %}
				</select>
			</div>
			<div class="options">
				<select name="priority">
					{% for id,label in term_options.priorities %}
						<option value="{{id}}">{{label}}</option>
					{% endfor %}
				</select>
			</div>
		</div>
	{% endif %}
	{% if term_options.ticket_workflows %}
		<div class="type" title="Workflow" data-rule-type="workflow" data-term-type="GenericMenuTerm" data-term-triggers="work,workflow">
			<div class="op">
				<select name="op" class="op">
					<option value="is">is</option>
					<option value="not">is not</option>
					{% if with_change_terms %}
						<option value="changed">Changed</option>
						<option value="changed_to">Changed to</option>
						<option value="changed_from">Changed from</option>
						<option value="not_changed_to">Not changed to</option>
						<option value="not_changed_from">Not changed from</option>
					{% endif %}
				</select>
			</div>
			<div class="options">
				<select name="workflow">
					{% for id,label in term_options.ticket_workflows %}
						<option value="{{id}}">{{label}}</option>
					{% endfor %}
				</select>
			</div>
		</div>
	{% endif %}
	{% if term_options.custom_ticket_fields %}
		{% set op_lang = {'is': 'is', 'not': 'is not', 'contains': 'contains', 'notcontains': 'does not contain', 'gt': 'is greater than', 'lt': 'is less than'} %}
		{% for field in term_options.custom_ticket_fields %}
			<div class="type" title="{{field.field_def.title}}" data-rule-group="Ticket Fields" data-rule-type="ticket_field[{{field.field_def.id}}]">
				<div class="op">
					<select name="op" class="op">
						{% if search_context == 'filter' %}
							{% for op in field.field_def.getFilterCapabilities(search_context) %}
								<option value="{{op}}">{{op_lang[op]}}</option>
							{% endfor %}
						{% else %}
							{% for op in field.field_def.getSearchCapabilities(search_context) %}
								<option value="{{op}}">{{op_lang[op]}}</option>
							{% endfor %}
						{% endif %}
					</select>
				</div>
				<div class="options">
					{{ form_widget(field.formView) }}
				</div>
			</div>
		{% endfor %}
	{% endif %}
	{% include 'DeskPRO:Common:people-search-criteria.html.twig' with {'with_rule_group': true, 'term_options': people_term_options, 'id': false, 'classname': false} %}

{% if id or classname %}
</div>
{% endif %}
