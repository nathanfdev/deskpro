{% if not button_type %}{% set button_type = 'button' %}{% endif %}
{% if button_type == 'icon' %}
	<a href="{{ path('user_login_authenticate', {'usersource_id': usersource.id}) }}"><img src="{{ asset('images/icons/social_media_mini_icons/facebook.png') }}" /></a>
{% elseif button_type == 'button' %}
	<a class="small btn" href="{{ path('user_login_authenticate', {'usersource_id': usersource.id}) }}">
		<span style="background-image: url('{{ asset('images/icons/social_media_mini_icons/facebook.png') }}')">Facebook</span>
	</a>
{% elseif button_type == 'login_tab' %}
	<span class="login-with-facebook">Facebook</span>
{% endif %}
