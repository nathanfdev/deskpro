{% extends 'DeskPRO:emails_user:layout.html.twig' %}
{% import 'DeskPRO:emails_user:layout-macros.html.twig' as layout %}
{% block email_teaser_link %}
	View your ticket online at:<br />
	<a href="{{ url_full('user_tickets_view_auth', {'ticket_ref': ticket.ref, 'ticket_auth': ticket.access_code}) }}">
		{{ url_display('user_tickets_view_auth', {'ticket_ref': ticket.ref, 'ticket_auth': ticket.access_code}) }}
	</a>
{% endblock %}
{% block content %}
	<!--ACCESS CODE: (#{{ticket.access_code}})-->
	{{ layout.section_start() }}
		An agent has replied to your ticket.
	{{ layout.section_end() }}

	{{ layout.section_start() }}
		{% for message in messages|reverse %}
			{% include 'DeskPRO:emails_common:ticket-message.html.twig' with {'message': message} %}
		{% endfor %}
	{{ layout.section_end() }}
{% endblock %}