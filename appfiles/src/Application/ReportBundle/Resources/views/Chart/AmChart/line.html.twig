<script type="text/javascript">
    var params = {
        bgcolor:"#FFFFFF"
    };

    var setting_url = '{{ path('report_chart_get_settings', {'dashboard_stat_id': dashboard_stat.id, '_format': 'xml'}) }}';

    var data_url = '{{ path('report_chart_get_data', {'dashboard_stat_id': dashboard_stat.id, '_format': 'xml'}) }}';

    var vars = {
        path: "/static/vendor/amcharts/flash/",

        settings_file: setting_url,
        //data_file: data_url
    };

    if (swfobject.hasFlashPlayerVersion("8"))
    {
        swfobject.embedSWF("/static/vendor/amcharts/flash/am" + 'line' + ".swf", 'my_chart', "100%", "100%", "8.0.0", "/static/vendor/amcharts/flash/expressInstall.swf", vars, params);
    }
    else if (this.isJavaScriptSupported()) {
        this.chart = new AmCharts.AmFallback();
        this.chart.settingsFile = vars.settings_file;
        this.chart.dataFile = vars.data_file;
        this.chart.pathToImages = "/static/vendor/amcharts/javascript/images/";
        this.chart.type = 'line';
        this.chart.write('my_chart');
    }
</script>
<div id="my_chart"></div>