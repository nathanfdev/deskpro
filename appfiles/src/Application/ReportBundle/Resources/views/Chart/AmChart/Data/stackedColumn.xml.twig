<?xml version="1.0" encoding="UTF-8"?>
<chart>
	<series>
		{% for series in chart.series %}
			<value xid="{{ loop.index0 }}">{{ series }}</value>
		{% endfor %}
	</series>
	<graphs>
		{% for graphs in chart.graphs %}
			<graph gid="{{ loop.index }}">
				{% for point in graphs.data %}
					<value xid="{{ loop.index0 }}">{{ point }}</value>
				{% endfor %}
			</graph>
		{% endfor %}
	</graphs>
</chart>
