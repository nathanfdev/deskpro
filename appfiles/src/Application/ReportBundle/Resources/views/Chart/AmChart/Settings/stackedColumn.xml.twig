<?xml version="1.0" encoding="UTF-8"?>
<settings>
	<type>column</type>
	<font>Tahoma</font>
	<redraw>1</redraw>
	<colors>{{ chart.getColorCodes|join(',') }}</colors>

	<strings>
		<no_data>{{ chart.getNoDataLabel }}</no_data>
	</strings>

	<column>
		<type>stacked</type>
		<width>85</width>
		<spacing>0</spacing>
		<grow_time>0</grow_time>
		<sequenced_grow>1</sequenced_grow>
	</column>

	<plot_area>
		<margins>
			<left>50</left>
			<top>30</top>
			<right>30</right>
			<bottom>30</bottom>
		</margins>
	</plot_area>

	<legend>
		<enabled>0</enabled>
	</legend>

	<values>
		<category>
			<frequency>1</frequency>
			<start_from>0</start_from>
		</category>
	</values>

	<balloon>
		<text_color>FFFFFF</text_color>
		<text_size>16</text_size>
	</balloon>

	<graphs>
		{% for label in chart.labels %}
			<graph gid="{{ loop.index }}">
				<type>column</type>
				<title>{{ label|default('') }}</title>
				<balloon_text>
					{% if chart.getFormatterIdentifier == 'time_formatter' %}
						<![CDATA[{{ label|default('') }}: {value}{{ chart.formatData(chart.getMax, { 'format': 'unit' }) }}]]>
					{% else %}
						<![CDATA[{{ label|default('') }}: {value}{{ chart.getDisplayUnits }}]]>
					{% endif %}
				</balloon_text>
			</graph>
		{% endfor %}
	</graphs>

	<data>
		<chart>
			<series>
				{% for series in chart.series %}
					<value xid="{{ loop.index0 }}">{{ series }}</value>
				{% endfor %}
			</series>
			<graphs>
				{% for graphs in chart.graphs %}
					<graph gid="{{ loop.index }}">
						{% for point in graphs.data %}
							{% if chart.getFormatterIdentifier == 'time_formatter' %}
								<value xid="{{ loop.index0 }}">{{ chart.formatData(point, { 'format': 'value', 'normalize_to': chart.getMax }) }}</value>
							{% else %}
								<value xid="{{ loop.index0 }}">{{ chart.formatData(point) }}</value>
							{% endif %}
						{% endfor %}
					</graph>
				{% endfor %}
			</graphs>
		</chart>
	</data>

</settings>
