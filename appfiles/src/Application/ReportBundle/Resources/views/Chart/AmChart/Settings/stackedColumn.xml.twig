<?xml version="1.0" encoding="UTF-8"?>
<settings>
	<type>column</type>
	<font>Tahoma</font>
	<redraw>1</redraw>
	<colors>{{ chart.getColorCodes|join(',') }}</colors>

	<strings>
		<no_data>{{ chart.getNoDataLabel }}</no_data>
	</strings>

	<column>
		<type>stacked</type>
		<width>85</width>
		<spacing>0</spacing>
		<grow_time>0</grow_time>
		<sequenced_grow>1</sequenced_grow>
	</column>

	<plot_area>
		<margins>
			<left>50</left>
			<top>30</top>
			<right>30</right>
			<bottom>30</bottom>
		</margins>
	</plot_area>

	<legend>
		<enabled>0</enabled>
	</legend>

	<values>
		<category>
			<frequency>1</frequency>
			<start_from>0</start_from>
		</category>
	</values>

	<balloon>
		<text_color>FFFFFF</text_color>
		<text_size>16</text_size>
	</balloon>

	<graphs>
		{% for label in chart.labels %}
			<graph gid="{{ loop.index }}">
				<type>column</type>
				<title>{{ label|default('no group') }}</title>
				<balloon_text>
					<![CDATA[{{ label|default('no group') }}: {value}]]>
				</balloon_text>
			</graph>
		{% endfor %}
	</graphs>

</settings>
