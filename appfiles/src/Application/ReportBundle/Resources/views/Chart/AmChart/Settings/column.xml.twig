<?xml version="1.0" encoding="UTF-8"?>
<settings>
  <type>column</type>
  <font>Tahoma</font>
  <column>
    <type></type>
    <width>85</width>
    <spacing>0</spacing>
    <grow_time>0</grow_time>
    <sequenced_grow>true</sequenced_grow>
  </column>

  <plot_area>
    <margins>
      <left>40</left>
      <top>40</top>
      <right>40</right>
      <bottom>40</bottom>
    </margins>
  </plot_area>

  <legend>
    <enabled>true</enabled>
  </legend>

  <values>
    <category>
      <frequency>1</frequency>
      <start_from>0</start_from>
    </category>
  </values>

  <graphs>
    {% for label in chart.labels %}
      <graph gid="{{ loop.index }}">
        <type>column</type>
        <title>{{ label }}</title>
      </graph>
    {% endfor %}
  </graphs>
  
</settings>
