<?xml version="1.0" encoding="UTF-8"?>
<settings>

	<redraw>1</redraw>

	<strings>
		<no_data>{{ chart.getNoDataLabel }}</no_data>
	</strings>

	<plot_area>
		<margins>
			<left>50</left>
			<top>30</top>
			<right>30</right>
			<bottom>30</bottom>
		</margins>
	</plot_area>

	<legend>
	  <enabled>0</enabled>
	</legend>

	<indicator>
		<x_balloon_enabled>false</x_balloon_enabled>
	</indicator>

	<balloon>
		<only_one>1</only_one>
		<text_color>000000</text_color>
	</balloon>

	<graphs>
		{% for label in chart.labels %}
			<graph gid="{{ loop.index }}">
				<axis>left</axis>
				<title>{{ label|default('no group') }}</title>
				<balloon_text>
					<![CDATA[{{ label|default('no group') }}: {value}]]>
				</balloon_text>
			</graph>
		{% endfor %}
	</graphs>

</settings>
