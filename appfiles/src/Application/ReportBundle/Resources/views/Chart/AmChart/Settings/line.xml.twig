<?xml version="1.0" encoding="UTF-8"?>
<settings> 
       
  <digits_after_decimal>2</digits_after_decimal>

  <plot_area>
    <margins>
      <left>40</left>
      <top>20</top>
      <right>30</right>
      <bottom>40</bottom>
    </margins>
  </plot_area>
  
  <legend>
    <enabled>false</enabled>
    <values>
      <enabled>false</enabled>
      <width>44</width>
      <align>left</align>
      <text><![CDATA[: {value}]]></text>
     </values>
  </legend>
  
  <graphs>
    <graph gid="1">
      <axis>left</axis>
      <title>Open Tickets</title>
      <color>#FFCC00</color>
      <balloon_text>
        <![CDATA[{value}]]>
      </balloon_text>
    </graph>
  </graphs>
  
</settings>
