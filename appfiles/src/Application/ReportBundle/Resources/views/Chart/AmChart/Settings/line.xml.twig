<?xml version="1.0" encoding="UTF-8"?>
<settings>

	<redraw>1</redraw>
	<colors>{{ chart.getColorCodes|join(',') }}</colors>

	<strings>
		<no_data>{{ chart.getNoDataLabel }}</no_data>
	</strings>

	<plot_area>
		<margins>
			<left>50</left>
			<top>30</top>
			<right>30</right>
			<bottom>30</bottom>
		</margins>
	</plot_area>

	<legend>
	  <enabled>0</enabled>
	</legend>

	<indicator>
		<x_balloon_enabled>false</x_balloon_enabled>
	</indicator>

	<balloon>
		<only_one>1</only_one>
		<text_color>FFFFFF</text_color>
		<text_size>16</text_size>
	</balloon>

	<error_messages>
		<color>#cccccc</color>
	</error_messages>

	<graphs>
		{% for label in chart.labels %}
			<graph gid="{{ loop.index }}">
				<axis>left</axis>
				<title>{{ label|default('') }}</title>
				<balloon_text>
					<![CDATA[{{ label|default('') }}: {value}{{ chart.getDisplayUnits }}]]>
				</balloon_text>
			</graph>
		{% endfor %}
	</graphs>

	<data>
		<chart>
			<series>
				{% for series in chart.series %}
					<value xid="{{ loop.index0 }}">{{ series }}</value>
				{% endfor %}
			</series>
			<graphs>
				{% for graphs in chart.graphs %}
					<graph gid="{{ loop.index }}">
						{% for point in graphs.data %}
							<value xid="{{ loop.index0 }}">{{ chart.formatData(point) }}</value>
						{% endfor %}
					</graph>
				{% endfor %}
			</graphs>
		</chart>
	</data>
</settings>
