<?xml version="1.0" encoding="UTF-8"?>
<settings>
	<redraw>true</redraw>

	<strings>
		<no_data>{{ chart.getNoDataLabel }}</no_data>
	</strings>

	<pie>
		<radius>25%</radius>
		<colors>{{ chart.getColorCodes|join(',') }}</colors>
	</pie>

	<animation>
		<start_time>0</start_time>
	</animation>

	<balloon>
		<text_color>FFFFFF</text_color>
		<text_size>16</text_size>
		<show>
			<![CDATA[{title}: {value}{{ chart.getDisplayUnits }}]]>
		</show>
	</balloon>

	<data_labels>
		<show>
			<![CDATA[{title}: {percents}%]]>
		</show>
	</data_labels>

	<error_messages>
		<color>#cccccc</color>
	</error_messages>

	<legend>
		<enabled>0</enabled>
	</legend>

	<data>
		<pie>
			{% for slice in chart.slices %}
				<slice title="{{ slice.label|default('') }}">{{ chart.formatData(slice.value) }}</slice>
			{% endfor %}
		</pie>
	</data>

</settings>
