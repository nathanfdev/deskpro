<?xml version="1.0" encoding="UTF-8"?>
<settings>
	<redraw>true</redraw>

	<strings>
		<no_data>{{ chart.getNoDataLabel }}</no_data>
	</strings>

	<pie>
		<radius>25%</radius>
		<colors>{{ chart.getColorCodes|join(',') }}</colors>
	</pie>

	<animation>
		<start_time>0</start_time>
	</animation>

	<balloon>
		<text_color>FFFFFF</text_color>
		<text_size>16</text_size>
		<show>
			{% if chart.getFormatterIdentifier == 'time_formatter' %}
				<![CDATA[{title}: {value}{{ chart.formatData(chart.getMax, { 'format': 'unit' }) }}]]>
			{% else %}
				<![CDATA[{title}: {value}]]>
			{% endif %}
		</show>
	</balloon>

	<data_labels>
		<show>
			<![CDATA[{title}: {percents}%]]>
		</show>
	</data_labels>

	<legend>
		<enabled>0</enabled>
	</legend>

	<data>
		<pie>
			{% for slice in chart.slices %}
				{% if chart.getFormatterIdentifier == 'time_formatter' %}
					<slice title="{{ slice.label|default('') }}">{{ chart.formatData(slice.value, { 'format': 'value', 'normalize_to': chart.getMax }) }}</slice>
				{% else %}
					<slice title="{{ slice.label|default('') }}">{{ chart.formatData(slice.value) }}</slice>
				{% endif %}
			{% endfor %}
		</pie>
	</data>

</settings>
