<?xml version="1.0" encoding="UTF-8"?>
<settings>
	<redraw>true</redraw>
	
	<strings>
		<no_data>{{ chart.getNoDataLabel }}</no_data>
	</strings>
	
	<pie>
		<radius>25%</radius>
	</pie>

	<animation>
		<start_time>0</start_time>
	</animation>

	<balloon>
		<text_color>000000</text_color>
	</balloon>

	<data_labels>
		<show>
			<![CDATA[{title}: {percents}%]]>
		</show>
	</data_labels>

	<legend>
		<enabled>0</enabled>
	</legend>
</settings>
