<script type="text/javascript">
	$(function() {
	      $('#dashboard-chart-{{ dashboard_stat.id }} .sparkline').sparkline('html', { width: '100%', height: '25px'});
	});
</script>

<div class="variation-change-chart" id="dashboard-chart-{{ dashboard_stat.id }}">
	{% if chart.isChartRenderable %}
		<div class="main">
			<table>
				<tr>
					<td class="prev">
						<span class="value">{{ chart.getFirstDataPoint() }}</span>
						<span class="label">{{ chart.getFirstDataPoint(false) }}</span>
					</td>
					<td class="variation direction direction-up-red">
						<span class="amount">{{ chart.calculateVariation(true) }}%</span>
					</td>
					<td class="actual">
						<span class="value">{{ chart.getLastDataPoint() }}</span>
						<span class="label">{{ chart.getLastDataPoint(false) }}</span>
					</td>
				</tr>
			</table>
		</div>
	
		<div class="footer">
		      <span class="sparkline">{{ chart.dataPoints|join(',') }}</span>
		</div>
	{% else %}
		<div class="chart-not-renderable">{{ chart.getNoDataLabel }}</div>
	{% endif %}
</div>