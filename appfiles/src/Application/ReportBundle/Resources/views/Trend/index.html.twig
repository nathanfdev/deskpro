{% extends 'ReportBundle::layout.html.twig' %}
{% block page %}

<script type="text/javascript">
    $(function() {
        $('.sparkline').sparkline('html', { width: '100%', height: '25px'}); 
    });
</script>

<ul class="tabs">
	<li><a href="{{ path('report_trend_index') }}">Trends</a></li>
	
	{% for dashboard in dashboards %}
		<li class="{{ (loop.index0 == 0) ? 'margin-left' : '' }}"><a href="{{ path('report_trend_dashboard_view', { 'dashboard_id': dashboard.id }) }}">{{ dashboard.title }}</a></li>
	{% endfor %}
	<li><a href="{{ path('report_trend_dashboard_edit', { 'dashboard_id': 0 }) }}" class="new">New</a></li>
</ul>

<div class="table-list-wrap">
	
        <table class="table-list stat-list" cellspacing="0" cellpadding="0" width="100%">
                <thead>
                        <tr>
                                <th width="25"></th>
                                <th>Title</th>
                                <th width="200">Author</th>
                                <th width="150">Trend</th>
				<th width="60">Amount</th>
				<th width="60">Variation</th>
                                <th width="16" class="icon"></th>
                                <th width="16" class="icon"></th>
                                <th width="16" class="icon"></th>
                        </tr>
                </thead>
                <tbody>
                        {% for stat in stats %}
                                <tr>
                                        <td class="{{stat.starred ? 'starred' : ''}}"></td>
                                        <td><a href="{{ path('report_trend_view', { 'stat_id': stat.id }) }}">{{stat.title}}</a></td>
                                        <td>{{stat.authorName}}</td>
                                        <td><span class="sparkline">{{ stat.trendPoints|join(',') }}</span></td>
					<td class="center">{{ stat.amount }}</td>
					<td class="center {{ (stat.variation > 0) ? 'down' : 'up' }}">{{ stat.variation }}</td>
                                        <td class="icon"><a href="{{ path('report_trend_view', { 'stat_id': stat.id }) }}" title="View Trend"><img src="{{ asset('images/report/icons/view.png') }}" alt="[View]"/></a></td>
                                        <td class="icon"><a href="{{ path('report_trend_edit', { 'stat_id': stat.id }) }}" title="Edit Trend"><img src="{{ asset('images/report/icons/edit.png') }}" alt="[Edit]"/></a></td>
                                        <td class="icon"><a href="{{ path('report_trend_clone', { 'stat_id': stat.id }) }}" title="Clone Trend"><img src="{{ asset('images/report/icons/clone.png') }}" alt="[Clone]"/></a></td>
                                </tr>
                        {% endfor %}
                </tbody>
        </table>
</div>

{% endblock %}