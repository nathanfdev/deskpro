{% extends 'ReportBundle::layout.html.twig' %}
{% block page %}

<script type="text/javascript">
    $(function() {
        $('.sparkline').sparkline('html', {width: '100px', height: '25px'}); 
    });
</script>

<h3>Reports</h3>

<div class="table-list-wrap">
        <h2>Stats</h2>
        
        <table class="table-list stat-list" cellspacing="0" cellpadding="0" width="100%">
                <thead>
                        <tr>
                                <th width="25"></th>
                                <th>Title</th>
                                <th width="200">Author</th>
                                <th width="100">Trend</th>
				<th width="100">Amount</th>
				<th width="100">Variation</th>
                                <th width="25"></th>
                                <th width="25"></th>
                                <th width="25"></th>
                        </tr>
                </thead>
                <tbody>
                        {% for stat in stats %}
                                <tr>
                                        <td class="{{stat.starred ? 'starred' : ''}}"></td>
                                        <td><a href="{{ path('trend_view', { 'stat_id': stat.id }) }}">{{stat.title}}</a></td>
                                        <td>{{stat.authorName}}</td>
                                        <td><span class="sparkline">{{ stat.trendPoints|join(',') }}</span></td>
					<td class="center">{{ stat.amount }}</td>
					<td class="center">{{ stat.variation }}</td>
                                        <td><a href="{{ path('trend_view', { 'stat_id': stat.id }) }}"><img src="{{ asset('images/report/icons/view.png') }}" alt="[View]"/></a></td>
                                        <td><a href="{{ path('trend_edit', { 'stat_id': stat.id }) }}"><img src="{{ asset('images/report/icons/edit-small.png') }}" alt="[Edit]"/></a></td>
                                        <td><a href="{{ path('trend_clone', { 'stat_id': stat.id }) }}"><img src="{{ asset('images/report/icons/clone.png') }}" alt="[Clone]"/></a></td>
                                </tr>
                        {% endfor %}
                </tbody>
        </table>
</div>

{% endblock %}