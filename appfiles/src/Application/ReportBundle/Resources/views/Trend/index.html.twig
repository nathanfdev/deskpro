{% extends 'ReportBundle::layout.html.twig' %}

{% import "ReportBundle:Common:macros.html.twig" as stat_macros %}

{% block html_head %}
{{ dp_asset_html('report_dashboard') }}
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
	window.DeskPRO_Page = new DeskPRO.Report.PageHandler.Trend();
}
</script>
{% endblock %}
{% block page %}

<script type="text/javascript">
	$(function() {
		$('.sparkline').sparkline('html', { width: '100%', height: '25px'});
	});
</script>

<ul class="tabs">
	<li><a href="{{ path('report_trend_index') }}">Trends</a></li>

	{% for dashboard in dashboards %}
		<li class="{{ (loop.index0 == 0) ? 'margin-left' : '' }}"><a href="{{ path('report_trend_dashboard_view', { 'dashboard_id': dashboard.id }) }}">{{ dashboard.title }}</a></li>
	{% endfor %}
	<li class="new"><a href="{{ path('report_trend_dashboard_new') }}" class="new">New Dashboard</a></li>
</ul>

<div class="table-list-wrap">

	<table class="table-list stat-list" cellspacing="0" cellpadding="0" width="100%">
		<thead>
			<tr>
				<th width="20"></th>
				<th>Title</th>
				<th width="100">Group By</th>
				<th width="100">Updates</th>
				<th width="200">Author</th>
				<th width="200">Trend</th>
				<th width="60" class="center">Prev</th>
				<th width="60" class="center">Current</th>
				<th width="90" class="center">Difference %</th>
				<th width="10"></th>
				<th width="16" class="icon"></th>
				<th width="16" class="icon"></th>
			</tr>
		</thead>
		<tbody>
			{% for stat in stats %}
				<tr>
					<td class="{{ stat.starred ? 'starred' : '' }}"></td>
					<td>{{ stat.title }}</td>
					<td>{{ stat.getGroupingName }} </td>
					<td class="period">{{ stat.period }}</td>
					<td>{{ stat.authorName }}</td>
					<td><span class="sparkline">{{ stat.trendPoints|join(',') }}</span></td>
					{% for prev_value in stat.getEndData(2) %}
						<td class="prev-value">{{ stat.formatData(prev_value, chart.getDisplayUnits)|default('-') }}</td>
					{% endfor %}
					<td class="center difference {{ stat_macros.difference_class(stat.difference, stat.variation) }}">{{ stat.difference(true) }}%</td>
					<td></td>
					<td class="icon">
						{% if stat.isEditable %}
							<a href="{{ path('report_trend_edit', { 'stat_id': stat.id }) }}" class="edit-trend" title="Edit Trend"><img src="{{ asset('images/report/icons/edit.png') }}" alt="[Edit]"/></a></td>
						{% endif %}
					<td class="icon">
						{% if stat.isClonable %}
							<a href="{{ path('report_trend_clone', { 'stat_id': stat.id }) }}" class="clone-trend" title="Clone Trend"><img src="{{ asset('images/report/icons/clone.png') }}" alt="[Clone]"/></a>
						{% endif %}
					</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
</div>

<div id="edit_overlay_wrapper" style="width: 700px; height: 450px; display: none;">
	<div class="overlay-title">
		<span class="close-overlay"></span>
		<h4>Edit Trend</h4>
	</div>
	<div class="overlay-content">
	</div>
	<div class="overlay-loader">
		<img src="{{ asset('images/spinners/loading-big-circle.gif') }}" alt="Loading..." />
	</div>
	<div class="overlay-footer">

	</div>
</div>

<div id="clone_overlay_wrapper" style="width: 700px; height: 650px; display: none;">
	<div class="overlay-title">
		<span class="close-overlay"></span>
		<h4>Clone Trend</h4>
	</div>
	<div class="overlay-content">

	</div>
	<div class="overlay-loader">
		<img src="{{ asset('images/spinners/loading-big-circle.gif') }}" alt="Loading..." />
	</div>
	<div class="overlay-footer">

	</div>
</div>

{% endblock %}
