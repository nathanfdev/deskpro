<form action="{{ path('report_trend_edit', {'stat_id': stat.id|default(0)}) }}" method="post">
	<input type="hidden" name="process" value="1" />
	
	<div class="dp-form">
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>Title</label>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.title) }}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>Disable the report?</label>
			</div>
			<div class="dp-form-input">
				<label>{{ form_widget(form.disabled) }} Disable</label>
			</div>
		</div>
	</div>

	{{ form_rest(form) }}

	<button class="btn primary save-trigger">Save</button>
</form>