<form id="edit_trend_form" action="{{ path('report_trend_edit', {'stat_id': stat.id|default(0)}) }}" method="post">
	<input type="hidden" name="process" value="1" />

	<div class="dp-form">
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>Title</label>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.title) }}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>Difference</label>
				<span>Is a positive number good, bad or neutral?</span>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.variation) }}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>Star the statistic?</label>
				<span>Starred statistic display at the top of the trend list</span>
			</div>
			<div class="dp-form-input">
				<label>{{ form_widget(form.starred) }} Starred</label>
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>Disable the statistic?</label>
				<span>Disabling the statistic will cause future data to be unavailable</span>
			</div>
			<div class="dp-form-input">
				<label>{{ form_widget(form.disabled) }} Disable</label>
			</div>
		</div>

	</div>

	{{ form_rest(form) }}

	<button class="btn primary save-trigger" id="edit_trend_save">Save</button>
</form>

<script type="text/javascript">
	$(function() {
		var self     = this;

		$('#edit_trend_save').click(function(ev) {
			$('#edit_overlay_wrapper .overlay-loader').css('display', 'block');

			ev.preventDefault();
			ev.stopPropagation();

			var form = $('#edit_trend_form');
			var postData = form.serializeArray();

			$.ajax({
				url: form.attr('action'),
				type: 'POST',
				data: postData,
				dataType: 'json',
				success: function(data) {
					// Just do a redict for now
					self.location = data.redirect;
				}
			});
		});
	});
</script>
