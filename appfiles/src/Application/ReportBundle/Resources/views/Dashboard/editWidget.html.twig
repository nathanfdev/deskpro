<form action="{{ form_route }}" method="post" id="{{ form_id }}">
	<input type="hidden" name="process" value="1" />

	<div class="dp-form">
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>Title</label>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.title, { 'placeholder': 'test' }) }}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>Chart Type</label>
			</div>
			<div class="dp-form-input chart-type-select">
				{{ form_widget(form.chart_type) }}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>Display Grouping Data?</label>
				<span>Select yes to display the data grouped by {{ stat.getGroupingName }}</span>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.display_grouping) }}
			</div>
		</div>

		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>Data Range</label>
				<span>How many {{ stat.getRunPeriodLength() }} worth of data do you want to display?</span>
			</div>
			<div class="dp-form-input">
				{{ form_widget(form.number_data_points) }}
			</div>
		</div>
	</div>

	{{ form_rest(form) }}

	<button class="btn primary save-trigger">Save</button>
</form>
