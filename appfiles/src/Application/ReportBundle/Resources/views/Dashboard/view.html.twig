{% extends 'ReportBundle::layout.html.twig' %}
{% block html_head %}
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Report/PageHandler/Dashboard.js') }}"></script>
<script type="text/javascript" src="{{ asset('javascripts/DeskPRO/Report/Dashboard/Widget.js') }}"></script>
{% endblock %}
{% block page_js_exec %}
<script type="text/javascript" charset="utf-8">
function _page_exec() {
        window.DESKPRO_URL_REGISTRY['report_dashboard_ajaxfetchwidgets']  = '{{ path('report_dashboard_ajaxfetchwidgets', {'dashboard_id': dashboard.id }) }}';
	window.DeskPRO_Page = new DeskPRO.Report.PageHandler.Dashboard({{ dashboard.id }});
}
</script>
{% endblock %}
{% block page %}

        <span class="dashboard-state">
                <a id="report-dashboard-set-editable" href="#" class="clean-white">Edit</a>
                <a id="report-dashboard-set-viewable" href="#" style="display: none" class="clean-white">Close Edit</a>
        </span>
        
        <div id="report-dashboard-options">
                <h2>Grid Options</h2>
                <div>
                        <label>Number Columns</label>
                        <div id="report-dashboard-options-num-columns-slider"></div>
                </div>
	</div>
        
        <div id="report-dashboard">
                <div id="grid-lines">
                        <ul id="report-dashboard-grid">
                        </ul>
                        <div style="clear: both"></div>
                </div>
        </div>
        
        <div id="overlay_wrapper" style="width: 600px; height: 400px; display: none;">
                <div class="overlay-title">
                        <span class="close-overlay"></span>
                        <h4>Add Dashboard Chart</h4>
                </div>
                <div class="overlay-content">
                        
                </div>
                <div class="overlay-footer">
                        
                </div>
        </div>
        
        {% include 'ReportBundle:Dashboard:widget.html.twig' %}
        
        <script id="dashboard_widget_select" type="text/x-jquery-tmpl">
                <table class="table-list stat-list" cellspacing="0" cellpadding="0" width="100%">
                        <thead>
                                <tr>
                                        <th width="16"></th>
                                        <th>Title</th>
                                        <th width="200">Author</th>
                                        <th width="16" class="icon"></th>
                                </tr>
                        </thead>
                        <tbody>
                                {% for stat in all_stats %}
                                        <tr>
                                                <td class="{{stat.starred ? 'starred' : ''}}"></td>
                                                <td>{{stat.title}}</td>
                                                <td>{{stat.authorName}}</td>
                                                <td class="icon"><a href="" title="Add Chart" class="add-chart"><img src="{{ asset('images/report/icons/add.png') }}" alt="[Add]"/></a></td>
                                        </tr>
                                {% endfor %}
                        </tbody>
                </table>
        </script>
        
        <script id="dashboard_widget_edit" type="text/x-jquery-tmpl">
                Edit widget
        </script>
        
{% endblock %}