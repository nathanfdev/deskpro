{% extends 'ReportBundle::layout.html.twig' %}
{% block page %}

        <div class="report-dashboard-options">
		<form id="report-dashboard-options-form">
			<h2>Grid Options</h2>
			<p>
				<label># Columns</label>
				<input type="text" name="num-columns" id="options-num-columns" value="4" />
				<input type="submit" value="Build" />
			</p>
		</form>
	</div>
        
        <div id="report-dashboard-grid">
                <div id="grid-lines">
                        <div class="slot"></div>
                        <div class="slot"></div>
                        <div class="slot"></div>
                        <div class="slot"></div>
                        
                        <ul id="report-dashboard-grid">
                                {% for dashboard_stat in dashboard_stats %}
                                        <li class="slot">
                                                <span class="inner">
                                                        <span class="grid-slot-toolbar ui-corner-all">
                                                                {{ dashboard_stat.stat.title }}
                                                                <a href="#" class="close">
                                                                        <img src="{{ asset('images/report/icons/close.png') }}" alt="[x]" />
                                                                </a>
                                                        </span>
                                                        <span class="grid-slot-content"></span>
                                                </span>
                                        </li>
                                {% endfor %}
                                <li class="slot new-placeholder">
                                       <a href="#" id="open_overlay_btn">Add Chart</a> 
                                </li>
                        </ul>
                        <div style="clear: both"></div>
                </div>
        </div>
        
        <div id="overlay_wrapper" style="width: 600px; height: 400px; display: none;">
                <div class="overlay-title">
                        <span class="close-overlay"></span>
                        <h4>Add Dashboard Chart</h4>
                </div>
                <div class="overlay-content">
                        
                </div>
                <div class="overlay-footer">
                        
                </div>
        </div>
        
        <script type="text/javascript">
                $(document).ready(function() {
                        var overlay = new DeskPRO.UI.Overlay({
                                triggerElement: $('#open_overlay_btn'),
                                contentElement: $('#overlay_wrapper')
                        });
			
			$("#report-dashboard-grid").sortable({
				handle: '.grid-slot-toolbar'
			});
			$("#report-dashboard-grid").disableSelection();
			$("#report-dashboard-grid li").resizable({
				helper: "ui-resizable-helper",
				placeholder: "ui-state-highlight",
				resize: function(event, ui) {
					ui.size.height = ui.originalSize.height;
				}

			});
			
                });
                
        </script>
        
{% endblock %}