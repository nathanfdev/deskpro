<script>
pageMeta.class = 'DeskPRO.Agent.PageFragment.Page.Person';
pageMeta.title = '{{ person.display_name|e('js') }}';
pageMeta.person_id = {{person.id}};
</script>

<div class="profile">
	<div class="main">
		<div class="header">
			<h1 class="editable hover-edit" data-editable-for=".inline-editable .name">{{person.display_name}}</h1>
			<div class="organization hover-edit">
				<span class="name">{{person.organization.name}}</span>
				<span class="position">{{person.organization_position}}</span>
			</div>
			<div class="email hover-edit">
				<div class="primary">{{person.primary_email.email}}</div>
			</div>
		</div>

		<div class="section notes">
			<span class="new-note trigger">new note</span>
			<h5>Notes</h5>
			<div class="new-note-form" style="display:none">
				<textarea name="note"></textarea>
				<div style="float:right">
					<span class="saving trigger">saving...</span>
					<span class="save trigger">save</span><br/>
					<span class="cancel trigger">cancel</span>
				</div>
			</div>
			<div>
				<dl class="note-list" data-limit="5">
					{% for note in notes %}
						{% include 'TechBundle:Person:note-li.twig' with ['note': note] %}
					{% endfor %}
				</dl>
				{% if note_pages %}
					<ul class="pages">
						{% for i in note_pages %}
							<li class="page-{{i}} {%if i == 1 %}active{%endif%}" data-page="{{i}}">{{i}}</li>
						{% endfor %}
					</ul>
				{% endif %}
			</div>
		</div>

		<div class="section">
			<h5>User Stream</h5>
			<div>
				<ul class="stream">
					<li>
						<span class="time">14 mins</span>
						<span class="who">John Doe</span>
						<span class="what">updated profile fields <a href="">phone number and email address</a></span>
					</li>
					<li>
						<span class="time">42 mins</span>
						<span class="who">John Doe</span>
						<span class="what">created new ticket <a href="">trouble</a></span>
					</li>
					<li>
						<span class="time">1 day ago</span>
						<span class="who">System</span>
						<span class="what">auto-closed ticket <a href="">something or other</a></span>
					</li>
					<li>
						<span class="time">2 days</span>
						<span class="who">Ben</span>
						<span class="what">replied to ticket <a href="">something or other</a></span>
					</li>
					<li>
						<span class="time">2 days</span>
						<span class="who">John Doe</span>
						<span class="what">created ticket <a href="">something or other</a></span>
					</li>
					<li>
						<span class="time">2 days</span>
						<span class="who">John Doe</span>
						<span class="what">registered</span>
					</li>
				</ul>
			</div>
		</div>
	</div>

	<div class="side">
		<div class="section contact">
			<span class="add trigger" data-add-type="im">add im</span>
			<span class="add trigger" data-add-type="address">add address</span>
			<span class="add trigger" data-add-type="phone">add phone</span>
			<h5>Contact</h5>
			<div class="content">
				{% include 'TechBundle:Person:contact-section.twig' with ['person': person] %}
			</div>
		</div>
		
		<div class="section">
			<h5>Tickets</h5>
			<div>
				<ul class="simple">
					<li class="tip" title="In Support 42 minutes ago, awaiting tech"><a href="">trouble</a></li>
					<li class="tip" title="In Sales 2 days ago, closed"><a href="">something or other</a></li>
				</ul>
			</div>
		</div>

		<div class="section">
			<h5>Leads</h5>
			<div>
				<ul class="simple">
					<li><a href="">Sale</a> for $2495</li>
				</ul>
			</div>
		</div>

		<div class="section tags">
			<h5>Labels</h5>
			<div>
				<div class="tags-field">
					<ul class="tagit">
						<li>Tag1</li>
						<li>Tag2</li>
					</ul>
				</div>
			</div>
		</div>
	</div>
	
	<div class="contact-add-tpl im new" style="display:none">
		<input type="hidden" name="contact_type" value="instant_message" />
		{{contact_fields_tpl.instant_message.protocol.render|raw}}
		{{contact_fields_tpl.instant_message.im.render(['placeholder': 'ID/Nickname'])|raw}}
		{{contact_fields_tpl.instant_message.comment.render()|raw}}
		<div>
			<span class="saving trigger">saving...</span>
			<span class="save trigger">save</span>
			<span class="close trigger">cancel</span>
		</div>
	</div>
	<div class="contact-add-tpl address new" style="display:none">
		<input type="hidden" name="contact_type" value="address" />
		{{contact_fields_tpl.address.address.render()|raw}}<br />
		{{contact_fields_tpl.address.country.render(['size': 10, 'placeholder': 'Country'])|raw}}
		{{contact_fields_tpl.address.comment.render()|raw}}
		<div>
			<span class="saving trigger">saving...</span>
			<span class="save trigger">save</span>
			<span class="close trigger">cancel</span>
		</div>
	</div>
	<div class="contact-add-tpl phone new" style="display:none">
		<input type="hidden" name="contact_type" value="phone" />
		{{contact_fields_tpl.phone.country_code.render(['size': 4, 'placeholder': 'Country Code'])|raw}}
		{{contact_fields_tpl.phone.phone.render(['placeholder': 'Phone Number'])|raw}}
		{{contact_fields_tpl.phone.comment.render()|raw}}
		<div>
			<span class="saving trigger">saving...</span>
			<span class="save trigger">save</span>
			<span class="close trigger">cancel</span>
		</div>
	</div>
	
	<div class="org-edit-dlg" style="display:none" title="Organization">
		<select name="organization_id">{{org_options|raw}}</select>
		<br />
		Position: <input type="text" name="organization_position" value="{{person.organization_position}}" />
	</div>

	<div class="email-edit-dlg" style="display:none" title="Contact Emails">
		<ul class="emails-list">
			{% include 'TechBundle:Person:email-dlg-li.twig' with ['person': person] %}
		</ul>
		<div class="add-email">
			New email: <input type="text" class="new-email-input" value="" /> <input type="button" class="new-email-btn" value="Add" />
		</div>
	</div>
	<div class="inline-editable" style="display:none">
		<div class="name">
			{{form.findField('basic_fields.first_name').render()|raw}}
			{{form.findField('basic_fields.last_name').render()|raw}}
			<input type="hidden" name="action" value="name" />
		</div>
	</div>
</div>