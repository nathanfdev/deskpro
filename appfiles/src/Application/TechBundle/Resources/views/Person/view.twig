<script>
pageMeta.class = 'DeskPRO.Agent.PageFragment.Page.Person';
pageMeta.title = '{{ person.display_name|e(js) }}';
pageMeta.person_id = {{person.id}};
</script>

<div class="profile">
	<div class="main">
		<div class="header">
			<h1 class="editable" data-editable-for=".inline-editable .name">{{person.display_name}}</h1>
			<div class="organization">
				<span class="name">{{person.organization.name}}</span>
				<span class="position">{{person.organization_position}}</span>
			</div>
			<div class="email">
				<div class="primary">{{person.primary_email.email}}</div>
			</div>
		</div>

		<div class="section">
			<h5>Notes</h5>
			<div>
				<dl>
					<dt>Jane</dt>
					<dd>Some note by Jane</dd>

					<dt>Ben</dt>
					<dd>Some note by Ben</dd>

					<dt>Ben</dt>
					<dd>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Pellentesque at lacus nisi, quis facilisis ante. Morbi nec aliquet risus. Suspendisse potenti. Ut sit amet dolor sed diam porttitor feugiat et nec ipsum</dd>
				</dl>
				<ul class="pages">
					<li class="active">1</li>
					<li>2</li>
					<li>3</li>
				</ul>
			</div>
		</div>

		<div class="section">
			<h5>User Stream</h5>
			<div>
				<ul class="stream">
					<li>
						<span class="time">14 minutes ago</span>
						<span class="who">John Doe</span>
						<span class="what">updated profile fields <a href="">phone number and email address</a></span>
					</li>
					<li>
						<span class="time">42 minutes ago</span>
						<span class="who">John Doe</span>
						<span class="what">created new ticket <a href="">trouble</a></span>
					</li>
					<li>
						<span class="time">1 day ago</span>
						<span class="who">System</span>
						<span class="what">auto-closed ticket <a href="">something or other</a></span>
					</li>
					<li>
						<span class="time">2 days ago</span>
						<span class="who">Ben</span>
						<span class="what">replied to ticket <a href="">something or other</a></span>
					</li>
					<li>
						<span class="time">2 days ago</span>
						<span class="who">John Doe</span>
						<span class="what">created ticket <a href="">something or other</a></span>
					</li>
					<li>
						<span class="time">2 days ago</span>
						<span class="who">John Doe</span>
						<span class="what">registered</span>
					</li>
				</ul>
			</div>
		</div>
	</div>

	<div class="side">
		<div class="section">
			<h5>Contact</h5>
			<div>
				<dl class="contact">
					<dt>Phone</dt>
					<dd>+1 705-492-6224</dd>

					<dt>Address</dt>
					<dd>APT-8 1120 Clarence Street, North Bay, Ontario, Canada</dd>

					<dt>IM</dt>
					<dd>(MSN) chris.nadeau@deskpro.com</dd>
				</dl>
			</div>
		</div>
		
		<div class="section">
			<h5>Tickets</h5>
			<div>
				<ul class="simple">
					<li class="tip" title="In Support 42 minutes ago, awaiting tech"><a href="">trouble</a></li>
					<li class="tip" title="In Sales 2 days ago, closed"><a href="">something or other</a></li>
				</ul>
			</div>
		</div>

		<div class="section">
			<h5>Leads</h5>
			<div>
				<ul class="simple">
					<li><a href="">Sale</a> for $2495</li>
				</ul>
			</div>
		</div>

		<div class="section closed">
			<h5>Chat Logs</h5>
			<div style="display: none">
				<ul class="simple">
					<li><a href="">untitled</a> 2 days ago</li>
					<li><a href="">Pre-sales questions</a> 2 days ago</li>
				</ul>
			</div>
		</div>
	</div>

	<div class="email-edit-dlg" style="display:none" title="Contact Emails">
		<ul class="emails-list">
			{% include 'TechBundle:Person:email-dlg-li' with ['person': person] %}
		</ul>
		<div class="add-email">
			New email: <input type="text" class="new-email-input" value="" /> <input type="button" class="new-email-btn" value="Add" />
		</div>
	</div>
	<div class="inline-editable" style="display:none">
		<div class="name">
			{{form.findField('basic_fields.first_name').render()|raw}}
			{{form.findField('basic_fields.last_name').render()|raw}}
			<input type="hidden" name="action" value="name" />
		</div>
	</div>
</div>


