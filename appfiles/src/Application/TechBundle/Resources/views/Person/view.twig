{% extends 'TechBundle::layout' %}
{% block extra_head %}

{% endblock %}
{% block content %}

{% set form_url %}{% route 'tech_people_view' with ['person_id': person.id] %}{% endset %}
{{form.renderFormTag(['action': form_url])|raw}}
{{form.renderHiddenTags()|raw}}

<div class="block" id="block-tables">
	<div class="content">
		<h2 class="title">
			{% if person.id %}
				#{{person.id}}: {{person.display_name}}
			{% else %}
				New Person
			{% endif %}
		</h2>

		<div class="inner">
			<table class="table">
				<tr class="even">
					<td>Full Name</td>
					<td>{{form.findField('basic_fields.full_name').render()|raw}}</td>
				</tr>
				<tr class="even">
					<td>Informal Name</td>
					<td>{{form.findField('basic_fields.informal_name').render()|raw}}</td>
				</tr>
				<tr class="even">
					<td>Nickname</td>
					<td>{{form.findField('basic_fields.nick_name').render()|raw}}</td>
				</tr>
			</table>
		</div>

		<h3 class="title">Local Login</h3>
		<div class="inner">
			<table class="table"
				<tr class="even">
					<td>Username</td>
					<td>{{form.findField('basic_fields.username').render()|raw}}</td>
				</tr>
				<tr class="even">
					<td>Password</td>
					<td>{{form.findField('basic_fields.password').render()|raw}}</td>
				</tr>
			</table>
		</div>

		<h3 class="title">Email Addresses</h3>
		<div class="inner">
			<table class="table"
				<tr class="even">
					<td width="10">x</td>
					<td>Address</td>
				</tr>
				{% for email in person.emails %}
					<tr>
						<td><input type="checkbox" name="edit_person[del_emails][]" value="{{email.id}}" /></td>
						<td>{{email.email}}</td>
					</tr>
				{% endfor %}
				<tr>
					<td>&nbsp;</td>
					<td>New: {{form.new_email.render()|raw}}</td>
				</tr>
			</table>
		</div>

		<h3>Custom Fields</h3>
		<div class="inner">
			<table class="table"
				{% for info in custom_fields %}
					<tr class="even">
						<td>{{info.field_def.title}}</td>
						<td>{{info.form_field.render()|raw}}</td>
					</tr>
				{% endfor %}
			</table>
		</div>
	</div>
</div>

<input type="submit" value="Save" />

</form>

{% endblock %}
{% block sidebar %}
	{% for assoc in person.usersource_assoc %}
		<div class="block">
			<div class="sidebar-block">
				<h4>
					{{assoc.usersource.title}}:
					{% if assoc.identity_friendly %}
						{{assoc.identity_friendly}}
					{% else %}
						{{assoc.identity}}
					{% endif %}
				</h4>
				<hr />
					First used: {{assoc.created_at|date("Y-m-d")}}<br />
					Last used: {{assoc.last_used_at|date("Y-m-d")}}<br />
				<hr />
				<small>
					{% for k, v in assoc.data %}
						{{k}}: {{v}}<br />
					{% endfor %}
				</small>
			</div>
		</div>
	{% endfor %}
{% endblock %}