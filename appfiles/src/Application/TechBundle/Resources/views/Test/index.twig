<!DOCTYPE html>
<html>
<head>
	<meta charset="UTF-8"/>
	<meta name="robots" content="NOINDEX" />
	<meta http-equiv="X-UA-Compatible" content="IE=100" />
	<title>DeskPRO</title>

	<link rel="stylesheet" href="{% asset 'javascripts/jquery/jquery-ui/css/ui-lightness/jquery-ui.css' %}" type="text/css" media="screen"  />
	<link rel="stylesheet" href="{% asset 'javascripts/jquery/tipTip/tipTip.css' %}" type="text/css" media="screen"  />
	<link rel="stylesheet" href="{% asset 'stylesheets/agent/interface.css' %}" type="text/css" media="screen" />

	<!--[if IE 8]>
	<link rel="stylesheet" href="{% asset 'stylesheets/agent/interface-ie.css' %}" type="text/css" media="screen" />
	<![endif]-->

	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/jquery/jquery.min.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/jquery/jquery-ui/jquery-ui.min.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/jquery/jquery.layout.min.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/jquery/tipTip/jquery.tipTip.min.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/mootools/mootools-core.min.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/Orb/Orb.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/Orb/Compat.js' %}"></script>
	
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Form/InlineEdit.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Form/RuleBuilder.js' %}"></script>

	<!-- Agent Interface sources -->
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/Window.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/Shells/ThreePaned.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/TabManager.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/PageFragment/Basic.js' %}"></script>

	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/PageFragment/ListPane/Basic.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/PageFragment/ListPane/PeopleSearch.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/PageFragment/ListPane/TicketSearch.js' %}"></script>

	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/PageFragment/NavPane/Basic.js' %}"></script>

	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/PageFragment/Page/Ticket.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/DeskPRO/Agent/PageFragment/Page/Person.js' %}"></script>

	<script type="text/javascript">
		var BASE_URL = '{% route 'index' %}';
		$(document).ready(function() {
			window.DeskPRO_Window = new DeskPRO.Agent.Window();
			//window.DeskPRO_Window.runPageRouteFromElement($('#window_header_nav .people'));
			//agent_tester.loadTicketPane();
		});
	</script>
</head>
<body>

<div id="window_head" class="ui-layout-north">
	<div id="window_head_top">
		<div class="logo">DeskPRO</div>
		<div class="current-user">
			{{person.display_name}}
		</div>
	</div>

	<div id="window_header_nav">
		<ul>
			<li data-route="navpane:{% route 'tech_ticketsearch_filterspane' %}" data-route-alt="listpane:{% route 'tech_ticketsearch' %}">Tickets</li>
			<li class="people" data-route="navpane:{% route 'tech_peoplesearch_labelspane' %}" data-route-alt="listpane:{% route 'tech_peoplesearch' %}">People</li>
		</ul>
	</div>
</div>

<div id="pane_shell" class="ui-layout-center">
	<div id="pane_nav" class="ui-layout-west">

	</div>
	<div id="pane_shell_inner" class="ui-layout-center">
		<div id="pane_list" class="ui-layout-west">
			
			<script type="text/javascript" charset="utf-8">
				$(document).ready(function() {
					var editor = new DeskPRO.Form.RuleBuilder($('#rules-tpl'));
					editor.addNewRow($('#rules'), 'rule[123]', {
						rule_type: 'department',
						op: 'not',
						choice: {
							department: 2
						}
					});
					
					$('#add_rule_btn').data('add-count', 0).click(function() {
						var count = parseInt($(this).data('add-count'));
						var basename = 'newrule['+count+']';
						
						$(this).data('add-count', count+1);
						
						editor.addNewRow($('#rules'), basename);
					});
				});
			</script>


			<input type="button" value="Add Rule" id="add_rule_btn" />
			<div id="rules">
			</div>
			<div id="rules-tpl" style="display:none">
				<div class="row">
					<div class="type"></div>
					<div class="op"></div>
					<div class="choice"></div>
					<div class="remove">-</div>
				</div>
				<div class="type" title="Department" data-rule-type="department">
					<div class="op">
						<select name="op">
							<option value="is">is</option>
							<option value="not">is not</option>
						</select>
					</div>
					<div class="choice">
						<select name="department">
							<option value="1">Sales</option>
							<option value="2">Support</option>
						</select>
					</div>
				</div>
				<div class="type" title="Priority" data-rule-type="priority">
					<div class="op">
						<select name="op">
							<option value="is">is</option>
							<option value="not">is not</option>
							<option value="lt">less than</option>
							<option value="lte">less than or equal to</option>
							<option value="gt">greater than</option>
							<option value="gte">greater than or equal to</option>
						</select>
					</div>
					<div class="choice">
						<input type="text" value="" name="priority" />
					</div>
				</div>
			</div>


		</div>
		<div id="pane_content" class="ui-layout-center">
			<div id="pane_tabbar">
				<ul id="pane_tabs"></ul>
				<div class="close-btn">x</div>
			</div>
			<div id="page" class="ui-layout-content">

				TEST PAGE

			</div>
		</div>
	</div>
</div>

</body>
</html>