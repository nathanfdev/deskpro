<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
<head>
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
	<title>Web App Theme</title>
	<link rel="stylesheet" href="{% asset 'stylesheets/base.css' %}" type="text/css" media="screen" />
	<link rel="stylesheet" href="{% asset 'stylesheets/themes/blue/style.css' %}" type="text/css" media="screen" />
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/jquery/jquery.min.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/jquery/jquery.scrollTo.js' %}"></script>
	<script type="text/javascript" charset="utf-8" src="{% asset 'javascripts/jquery/jquery.localscroll.js' %}"></script>
	{% block extra_head %}{%endblock%}
</head>
<body>
	<div id="container">
		<div id="header">
			<h1><a href="index.html">DeskPRO Tech Interface</a></h1>
			<div id="user-navigation">
				<ul class="wat-cf">
					<li>
						<span style="color: #fff; ">Hello, {{person.display_name}} &middot;</span>
						<a class="logout" href="{% route 'user_logout' %}">Logout</a>
					</li>
				</ul>
			</div>
			<div id="main-navigation">
				<ul class="wat-cf">
					<li class="first"><a href="{% route 'tech_dashboard' %}">Dashboard</a></li>
					<li class=""><a href="{% route 'tech_admin_fields' %}">User Fields</a></li>
					<li class=""><a href="{% route 'tech_admin_usersources' %}">User Sources</a></li>
				</ul>
			</div>
		</div>
		<div id="wrapper" class="wat-cf">
			<div id="main">
				{% block content%}{%endblock%}
			</div>
			<div id="sidebar">
				{% block sidebar %}{% endblock %}
			</div>
		</div>
	</div>
</body>
</html>

