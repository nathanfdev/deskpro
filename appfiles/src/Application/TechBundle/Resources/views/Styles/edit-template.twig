{% extends 'TechBundle::layout' %}
{% block content %}

<div class="block" id="block-forms">
	<div class="content">
		<h2 class="title">Forms</h2>
		<div class="inner">
			<form action="#" method="get" class="form">
				<div class="group">
					<label class="label">Template</label>
					<strong>{{template_name}}</strong>
					<input type="hidden" name="template_name" value="{{template_name}}" />
				</div>
				<div class="group">
					<label class="label">Contents</label>
					<textarea class="text_area" name="template_contents" rows="10" cols="80">{{template_contents}}</textarea>
				</div>
				<div class="group navform wat-cf">
					<button class="button" type="submit">
						<img src="{% asset 'images/icons/tick.png' %}" alt="Save" /> Save
					</button>
					<a href="#header" class="button">
						<img src="{% asset 'images/icons/cross.png' %}" alt="Cancel"/> Cancel
					</a>
				</div>
			</form>
		</div>
	</div>
</div>

{% endblock %}
{% block sidebar %}
	{% include 'TechBundle:Styles:_style_sidebar' %}
{% endblock %}