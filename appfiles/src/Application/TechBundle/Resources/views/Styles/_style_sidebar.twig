<div class="block">
	<h3>Styles</h3>
	<div class="content">
		{% for style in all_styles %}
			{% if style.depth %}
				{% for i in 0..style.depth %}--{% endfor %}
			{% endif %}
			<a href="{% route 'tech_admin_styles_view' with ['id': style.id] %}">{{style.title}}</a>
		{% endfor %}
	</div>
</div>