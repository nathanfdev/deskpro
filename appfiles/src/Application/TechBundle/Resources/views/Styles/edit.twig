{% extends 'TechBundle::layout' %}
{% block content %}

<div class="block">
	<div class="content">
		<h2 class="title">{% if style.id %}Edit Style{% else %}Create Style{% endif %}</h2>
		<div class="inner">
			<form action="{% route 'tech_admin_styles_editstyle' with ['style_id': style.id] %}" method="post">
				<input type="hidden" name="process" value="1" />
				<div class="group">
					<label class="label">Title</label>
					{{form.username.getRawValue.render}}
				</div>
				<div class="group">
					<label class="label">Parent</label>
					{{form.parent_id.getRawValue.render}}
				</div>
				<div class="group">
					<label class="label">Note</label>
					{{form.parent_id.getRawValue.render}}
				</div>
				<div class="group navform wat-cf">
					<button class="button" type="submit">
						<img src="{% asset 'static/images/icons/tick.png' %}" alt="Save" /> Save
					</button>
					{% if style.id %}
						<a href="#header" class="button">
							<img src="{% route 'tech_admin_styles_editstyle' with ['style_id': style.id] %}" alt="Cancel"/> Cancel
						</a>
					{% endif %}
				</div>
			</form>
		</div>
	</div>
</div>

{% endblock %}

{% block sidebar %}
{% endblock %}