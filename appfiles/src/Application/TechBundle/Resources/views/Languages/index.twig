{% extends 'TechBundle::layout.twig' %}
{% block content %}

<div class="block" id="block-tables">
	<div class="content">
		<div style="float: right; padding: 5px 5px 0 0;">
			<a href="{% path 'tech_admin_langs_newlang' %}" class="button">
				<img src="{% asset 'images/icons/tick.png' %}" alt="New Style" /> Create New Language
			</a>
		</div>
		<h2 class="title">Language</h2>
		<div class="inner">
			<form action="#" class="form">
				<table class="table">
					<tr>
						<th class="first" width="10">&nbsp;</th>
						<th>Language</th>
						<th width="50">Locale</th>
						<th width="150">&nbsp;</th>
					</tr>
					{% for lang in all_langs %}
					<tr class="even">
						<td><input type="radio" name="default_lang_id" value="{{lang.id}}" /></td>
						<td>
							{% if lang.depth %}
								{% for i in 0..lang.depth %}--{% endfor %}
							{% endif %}
							{{lang.title}}
						</td>
						<td>
							{{lang.locale}}
						</td>
						<td class="last">
							<a href="{% path 'tech_admin_langs_phrases' with ['lang_id': lang.id] %}">Phrases</a> &middot;
							<a href="{% path 'tech_admin_langs_editlang' with ['lang_id': lang.id] %}">Properties</a>
						</td>
					</tr>
					{% endfor %}
				</table>
				<div class="actions-bar wat-cf">
					<div class="actions">
						<button class="button" type="submit">
							Change Default Language
						</button>
					</div>
				</div>
			</form>
		</div>
	</div>
</div>

{% endblock %}
{% block sidebar %}
{% endblock %}