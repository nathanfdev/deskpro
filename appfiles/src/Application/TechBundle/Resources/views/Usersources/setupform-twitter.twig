<div class="block">
	<div class="content">
		<h2 class="title">Twitter Options</h2>
		<div class="inner">
			<div class="group">
				<label class="label">Twitter Consumer Key</label>
				<input type="text" name="form_data[consumer_key]" value="{{form_data.consumer_key}}" size="40" />
			</div>
			<div class="group">
				<label class="label">Twitter Consumer Secret</label>
				<input type="text" name="form_data[consumer_secret]" value="{{form_data.consumer_secret}}" size="40" />
			</div>
		</div>
	</div>
</div>