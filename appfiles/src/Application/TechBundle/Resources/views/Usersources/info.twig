{% extends 'TechBundle::layout' %}
{% block content %}

<div class="block" id="block-tables">
	<div class="content">
		<h2 class="title">Usersources #{{usersource.id}}</h2>
		<div class="inner">
			<form action="#" class="form">
				<table class="table">
					<tr>
						<td>Typename</td>
						<td>{{usersource.typename}}</td>
					</tr>
					<tr>
						<td>Title</td>
						<td>{{usersource.title}}</td>
					</tr>
					<tr>
						<td>Adapter Class</td>
						<td>{{usersource.adapter_class}}</td>
					</tr>
					<tr>
						<td>Is Enabled</td>
						<td>{% if usersource.is_enabled %}Yes{%else%}No{%endif%}</td>
					</tr>
				</table>
			</form>
		</div>
	</div>
</div>

{% endblock %}
{% block sidebar %}
{% endblock %}