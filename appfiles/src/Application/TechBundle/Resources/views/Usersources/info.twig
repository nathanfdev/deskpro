{% extends 'TechBundle::layout' %}
{% block content %}

<div class="block" id="block-tables">
	<div class="content">
		<h2 class="title">Usersources #{{usersource.id}}</h2>
		<div class="inner">
			<form action="#" class="form">
				<table class="table">
					<tr>
						<td>Type</td>
						<td>{{usersource.handler_class}}</td>
					</tr>
					<tr>
						<td>Title</td>
						<td>{{usersource.title}}</td>
					</tr>
					<tr>
						<td>Is Enabled</td>
						<td>{% if usersource.is_enabled %}Yes{%else%}No{%endif%}</td>
					</tr>
					<tr>
						<td>Options</td>
						<td>
							<textarea style="width: 95%; height: 200px;">
{% for k, v in usersource.options %}
{{k}}: {{v}}
{% endfor %}
</textarea>
						</td>
					</tr>
				</table>
			</form>
		</div>
	</div>
</div>

{% endblock %}
{% block sidebar %}
{% endblock %}