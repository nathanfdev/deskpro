<script>
pageMeta.class = 'DeskPRO.Agent.PageFragment.ListPane.TicketSearch';
</script>

<div class="search-results">
	<table class="list" cellspacing="0" width="100%">
		<thead>
			<tr>
				<th>Subject</th>
				<th>Department</th>
				<th>Opened</th>
				<th>User</th>
			</tr>
		</thead>
		<tbody>
			{% for ticket in tickets %}
			<tr data-route="person:{% path 'tech_ticket_view' with ['ticket_id': ticket.id] %}">
				<td>{{ticket.subject}}</td>
				<td>{{ticket.department.title}}</td>
				<td>{{ticket.date_created|date('Y-m-d')}}</td>
				<td>{{ticket.person.name}}</td>
			</tr>
			{% else %}
			<tr>
				<td colspan="4">No tickets</td>
			</tr>
			{% endfor %}
		</tbody>
	</table>
</div>