{% extends 'UserBundle::layout-partial-aware.html.twig' %}
{% block breadcrumb %}
	<li><a href="{{ path('user_ideas') }}">Ideas</a></li>
{% endblock %}
{% block content %}
<div class="dp-content-block portal_kb with-handler" {% if is_partial_request() == 'portal' %}data-element-handler="DeskPRO.User.ElementHandler.Ideas"{% endif %}>
	<div class="dp-box">
		<div class="dp-box-header">
			<div class="dp-box-options">
				<select>
					<option>Sort by: Votes</option>
					<option>Sort by: Date</option>
				</select>
			</div>
			<h1>Ideas</h1>
		</div>

		<div class="dp-box-content-wrapper">
			<div class="dp-box-nav">
				<ul>
					<li class="dp-title">Status</li>
					<li><a>All</a></li>
					<li class="on"><a>Popular</a></li>
					<li><a>New</a></li>
					<li>
						<a>Active</a>
						<ul>
							<li><a>Accepted</a></li>
							<li><a>In Progress</a></li>
							<li><a>Considering</a></li>
						</ul>
					</li>
					<li>
						<a>Closed</a>
						<ul>
							<li><a>Declined</a></li>
							<li><a>Finished</a></li>
						</ul>
					</li>
				</ul>
				<ul class="sep">
					<li class="dp-title">Category</li>
					<li class="on"><a>All</a></li>
					{% for cat in idea_cats %}
						<li><a href="{{ path('user_ideas', {'status': status, 'slug': idea_cat_objs[cat.id].url_slug}) }}">{{ cat.title }}</a></li>
					{% endfor %}
				</ul>
			</div>
			<div class="dp-box-content dp-with-nav">
				<ul class="dp-ideas-list">
					{% for idea in ideas %}
						<li>
							<div class="vote">
								<span></span>
								<em>{{ num_votes_this|default(0) }}</em>
							</div>
							<div class="item">
								<h3><a href="{{ path('user_ideas_view', {'slug': idea.url_slug}) }}">{{idea.title}}</a></h3>
							</div>
						</li>
					{% else %}
						<li>There are no ideas with those specificiations.</li>
					{% endfor %}
				</ul>
			</div>
			<br class="dp-clear" style="clear:left" />
		</div>
	</div>
</div>
{% endblock %}
