{% extends 'UserBundle::layout.html.twig' %}
{% block content %}
<div style="float:left; width: 190px;">
	{% include 'UserBundle:Ideas:category-list.html.twig' %}
</div>

<div style="margin-left:200px;">
	<div style="float:left; width:80px">
		{{idea.num_votes}} votes
	</div>
	<div style="margin-left:90px">
		<div style="float:right">
			{{idea.date_created|date('Y-m-d')}}
		</div>

		<small>
		<a href="{{ path('user_ideas') }}">Ideas</a> /
		{% for cat in category_path %}
			<a href="{{ path('user_ideas_cat', {'slug': cat.url_slug}) }}">{{cat.title}}</a> /
		{% endfor %}
		<a href="{{ path('user_ideas_cat', {'slug': category.url_slug}) }}">{{category.title}}</a>
		</small>
		<h4>{{idea.title}}</h4>

		{{idea.content_html|raw}}

		<div style="background-color: #eee; padding: 10px; margin-top: 8px;">
			<form action="{{ path('user_ideas_vote', {'idea_id': idea.id}) }}" method="post">
				You have {{num_votes_remain}} votes remaining.
				<br />
				{% if num_votes_this %}
					You've used {{num_votes_this}} votes on this idea. Change your vote:
				{% else %}
					Vote on this idea:
				{% endif %}
				<input type="radio" value="1" name="vote" {% if num_votes_this == 1 or not num_votes_this %}checked="checked"{% endif %}/>1
				<input type="radio" value="2" name="vote" {% if num_votes_this == 2 %}checked="checked"{% endif %}/>2
				<input type="radio" value="3" name="vote" {% if num_votes_this == 3 %}checked="checked"{% endif %}/>3
				<input type="submit" value="vote" />
			</form>
		</div>
	</div>
</div>

<br style="clear:both" />

{% if comments_widget %}
	{{comments_widget|raw}}
{% else %}
	<div style="background-color: #eee; padding: 10px; margin-top: 15px;">
		<form action="{{ path('user_ideas_newcomment', {'idea_id': idea.id}) }}" method="post">
		Name: <input type="text" name="new_comment[name]" /> (public)<br />
		Email: <input type="text" name="new_comment[email]" /> (private, never revealed)<br />
		<textarea name="new_comment[content]" cols="80" rows="5"></textarea>
		<input type="submit" value="Submit" />
		</form>
		<hr />

		{% for comment in comments %}
			<div style="background-color: #fff; padding: 6px; margin: 10px;">
				<em>{{comment.name}}</em>:<br />
				{{comment.content_html|raw}}
			</div>
		{% endfor %}
	</div>
{% endif %}

{% endblock %}