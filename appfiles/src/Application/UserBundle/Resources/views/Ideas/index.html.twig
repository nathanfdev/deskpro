{% extends 'UserBundle::layout.html.twig' %}
{% block content %}

<div style="float:left; width: 190px;">
	{% include 'UserBundle:Ideas:category-list.html.twig' %}
</div>

<div style="margin-left: 200px;">

	<div style="background-color: #eee; padding: 3px;">
		{% if not category %}
			<a href="{{ path('user_ideas') }} ">New</a> |
			<a href="{{ path('user_ideas_status', {'status': 'accepted'}) }} ">Accepted</a> |
			<a href="{{ path('user_ideas_status', {'status': 'declined'}) }} ">Declined</a> |
			<a href="{{ path('user_ideas_status', {'status': 'completed'}) }} ">Completed</a>
		{% else %}
			<a href="{{ path('user_ideas_cat', {'slug': category.url_slug}) }} ">New</a> |
			<a href="{{ path('user_ideas_cat_status', {'slug': category.url_slug, 'status': 'accepted'}) }} ">Accepted</a> |
			<a href="{{ path('user_ideas_cat_status', {'slug': category.url_slug, 'status': 'declined'}) }} ">Declined</a> |
			<a href="{{ path('user_ideas_cat_status', {'slug': category.url_slug, 'status': 'completed'}) }} ">Completed</a>
		{% endif %}
	</div>

	<table cellpadding="0" cellspacing="0" width="100%" border="0">
		{% for idea in ideas %}
			<tr>
				<td width="80">
					{{ idea.num_votes }} votes
				</td>
				<td>
					<a href="{{ path('user_ideas_view', {'slug': idea.url_slug}) }}">{{idea.title}}</a>
					{{idea.content_html|raw}}
				</td>
			</tr>
		{% endfor %}
	</table>
</div>

<br style="clear:both" />

{% endblock %}