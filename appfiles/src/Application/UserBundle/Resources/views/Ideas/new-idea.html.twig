{% extends 'UserBundle::layout.html.twig' %}
{% block content %}

<form action="{{ path('user_ideas_newidea') }}" method="post">
<input type="hidden" name="process" value="1" />

	<small><strong>Category:</strong></small><br />
	{{ form_widget(form.category_id) }}

	<br />

	<small><strong>Short Summary:</strong></small><br />
	{{ form_widget(form.title) }}

	<br />

	<small><strong>Description or details:</strong></small><br />
	{{ form_widget(form.content) }}

	<br />

	How many of your {{num_votes_remain}} remaining votes would you like to spend on this idea?<br />
	{{ form_widget(form.votes) }}

	<br /><br />

	<input type="submit" value="Submit Idea" />

	{{ form_rest(form) }}
</form>
{% endblock %}