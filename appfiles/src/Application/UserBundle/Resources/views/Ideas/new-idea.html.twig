{% extends 'UserBundle::layout-partial-aware.html.twig' %}
{% block head %}
<script src="{{ asset('javascripts/DeskPRO/User/ElementHandler/NewIdea.js') }}"></script>
{% endblock %}
{% block breadcrumb %}
	<li><a href="{{ path('user_ideas') }}">Ideas</a></li>
	<li><a href="{{ path('user_ideas_newidea') }}">Submit Idea</a></li>
{% endblock %}
{% block content %}

<div
	class="dp-content-block dp-newidea-page with-handler"
	data-element-handler="DeskPRO.User.ElementHandler.NewIdea"
	data-suggestions-url="{{ path('user_search_similarto', {'content_type': 'idea'}) }}"
>
	<div class="dp-box">
		<div class="dp-box-header">
			<h1>Submit an Idea</h1>
		</div>

		<div class="dp-box-content-wrapper">
			<div class="dp-box-content dp-form">
				<form action="{{ path('user_ideas_newidea') }}" method="post">
				<input type="hidden" name="process" value="1" />
			</div>
		</div>
	</div>
</div>

<div class="page-title">
	<h1>Submit Idea</h1>
</div>

<form action="{{ path('user_ideas_newidea') }}" method="post">
<input type="hidden" name="process" value="1" />

<div class="input-form">
<table cellspacing="0" cellpadding="0" width="100%">
	<tr>
		<td width="180">What is your idea?</td>
		<td>
			{{ form_widget(form.title) }}
			<div class="suggestions-box" style="display: none">
				Have you tried looking at these other ideas?
				<div class="results"></div>
			</div>
		</td>
	</tr>

	<tr>
		<td>Category</td>
		<td>{{ form_widget(form.category_id) }}</td>
	</tr>

	<tr>
		<td style="vertical-align: top; padding-top: 8px;">More details to explain your idea</td>
		<td>{{ form_widget(form.content) }}</td>
	</tr>

	<tr>
		<td>&nbsp;</td>
		<td>
			How many of your {{num_votes_remain}} remaining votes would you like to spend on this idea?<br />
			{{ form_widget(form.votes) }}
		</td>
	</tr>

	<tr class="foot">
		<td colspan="2">
			<button class="dp-button">Submit</button>
		</td>
	</tr>
</table>
</div>

	{{ form_rest(form) }}
</form>

</div>
{% endblock %}
