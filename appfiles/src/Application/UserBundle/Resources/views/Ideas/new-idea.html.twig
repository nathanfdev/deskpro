{% extends 'UserBundle::layout-partial-aware.html.twig' %}
{% block head %}
<script src="{{ asset('javascripts/DeskPRO/User/ElementHandler/NewIdea.js') }}"></script>
{% endblock %}
{% block breadcrumb %}
	<li><a href="{{ path('user_ideas') }}">Ideas</a></li>
	<li><a href="{{ path('user_ideas_newidea') }}">Submit Idea</a></li>
{% endblock %}
{% block content %}

<div
	class="dp-content-block dp-newidea-page with-handler"
	data-element-handler="DeskPRO.User.ElementHandler.NewIdea"
	data-suggestions-url="{{ path('user_search_similarto', {'content_type': 'idea'}) }}"
>
	<div class="dp-box">
		<div class="dp-box-header">
			<h1>Submit an Idea</h1>
		</div>

		<div class="dp-box-content-wrapper">
			<div class="dp-box-content dp-form">
				<form action="{{ path('user_ideas_newidea') }}" method="post">
				<input type="hidden" name="process" value="1" />

					{###############
					 # Email
					 ###############}

					{% include 'UserBundle:Common:form-email-login-row.html.twig' with { 'email_form_name': 'idea[person][email]' } %}

					{###############
					 # Name
					 ###############}
					<div class="dp-form-row">
						<div class="dp-form-label">
							<label>Your Name *</label>
						</div>
						<div class="dp-form-input">
							{{ form_widget(form.person.name) }}
						</div>
					</div>

					{###############
					 # Category
					 ###############}

					<div class="dp-form-row">
						<div class="dp-form-label">
							<label>Category *</label>
						</div>
						<div class="dp-form-input">
							{{ form_widget(form.category_id) }}
						</div>
					</div>

					{###############
					 # Title
					 ###############}

					<div class="dp-form-row">
						<div class="dp-form-label">
							<label>Summary *</label> <em class="note">A title or a brief summary of what your idea is about</em>
						</div>
						<div class="dp-form-input">
							{{ form_widget(form.title) }}
						</div>
					</div>

					<div class="dp-related-search" id="dp_newidea_related_container" style="display: none">
						<h4>We found the following ideas that may be similar to yours</h4>
						<div class="subline">Don't worry, you can click a title and you will remain on this page.</div>
						<div class="dp-list results">
						</div>
						<div class="more-link" style="display: none;">
							<a>View <span class="count">0</span> more results</a>
						</div>
					</div>

					{###############
					 # Description
					 ###############}

					<div class="dp-form-row">
						<div class="dp-form-label">
							<label>Description *</label> <em class="note">If you need to, you can go into more detail about your idea here</em>
						</div>
						<div class="dp-form-input">
							{{ form_widget(form.content) }}
						</div>
					</div>

					<input class="btn primary" type="submit" value="Submit Idea" />
				</form>
			</div>
		</div>
	</div>

	<script type="text/x-deskpro-plain" class="related-content-overlay-tpl">
		<div class="dp-overlay-outer dp-post-overlay">
		<div class="dp-overlay">
			<div class="dp-overlay-inner">
				<span class="dp-close-btn">close</span>
				<div class="dp-content">
					<span class="dp-open-full"><a>Open full page</a></span>
					<div class="dp-content-holder">
						<div class="dp-loading-msg">Loading</div>
					</div>
					<div class="dp-controls">
						<div class="dp-default dp-control-section">
							<button class="btn small dp-section-toggle primary dp-set-answered" data-toggle-section=".dp-confirm-answered">This is the same as my idea</button>
							<button class="btn small dp-not-answered">This isn't the same as my idea</button>
						</div>
						<div class="dp-confirm-answered dp-control-section" style="display:none">
							<p>Looks like you have found someone who had the same idea as you did. Does that mean you do not need to create a new one?</p>
							<button class="btn small primary dp-answererd" data-type="close">I do not want to submit a new idea</button>
							<button class="btn small dp-answererd" data-type="ticket">I still want to submit my idea</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</script>

</div>

{% endblock %}
