{% extends 'UserBundle::layout.html.twig' %}
{% import "UserBundle:Common:property-fields.html.twig" as property_fields %}
{% block content %}

<form action="{{ path('user_register_finish') }}" method="post">
{{ form_hidden(form) }}
<input type="hidden" name="process" value="1" />

<h1>Choose a password</h1>
<table cellspacing="5" cellpadding="0" border="0" width="100%"><tr>
	<td>
		Password: {{ form_field(form.password) }}<br />
		Repeat: {{ form_field(form.password2) }}
	</td>
</tr></table>

<h1>Information</h1>
<table cellspacing="5" cellpadding="0" border="0" width="100%">
	{% for f in custom_fields %}
		<tr>
			<td>
				<small>{{ phrase(f.field_def) }}</small><br />
				{{ form_field(f.form, {}, {}, ['UserBundle:Common:custom-field-forms.html.twig']) }}
			</td>
		</tr>
	{% endfor %}
</table>

<input type="submit" value="Submit" />

{% endblock %}