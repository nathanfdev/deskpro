{% extends 'UserBundle:Register:finish.html.twig' %}
{% block finish_pre %}
	<div style="background-color: #f8f8f8; border: 2px solid #ccc; padding: 10px; margin-bottom: 15px;">
		<h1 style="font-size: 18px">Thank you</h1>
		<p>
			Thank you for submitting your ticket! You can view your ticket online here:
		</p>

		<div style="background-color: #fff; text-align: center; padding: 5px; margin: 10px;">
			<a href="{{ path('user_tickets_view', {'ticket_ref': ticket.ref}) }}">
				{{ url('user_tickets_view', {'ticket_ref': ticket.ref}) }}
			</a>
		</div>

		{% if ticket.hidden_status == 'validating' %}
			<p>
				<strong style="color:#B31010">But wait</strong>! Before your ticket will be read by
				our agents, you need to validate your email address. Check your email ({{ticket.person_email.email}})
				for our confirmation link.
			</p>
		{% endif %}
	</div>

{% endblock %}