{% extends 'UserBundle::layout.html.twig' %}
{% block breadcrumb %}
	<li><a href="{{ path('user_register') }}">Register</a></li>
{% endblock %}
{% block content %}
<div class="register">

<div class="page-title">
	<h1>{{ phrase('user.profile.register') }}</h1>
</div>

<form action="" method="post">
<input type="hidden" name="process" value="1" />
<div class="input-form">
	<table cellspacing="0" cellpadding="0" width="100%">
		<tr>
			<td width="160">{{ phrase('user.label_your_name') }}</td>
			<td>
				{{ form_widget(form.person.name) }}
			</td>
		</tr>
		<tr>
			<td width="160">{{ phrase('user.label_your_email') }}</td>
			<td>
				{{ form_widget(form.person.email) }}
			</td>
		</tr>
		<tr>
			<td width="160">{{ phrase('user.profile.label_password') }}</td>
			<td>
				{{ form_widget(form.person.password) }}
			</td>
		</tr>
		<tr>
			<td width="160">{{ phrase('user.profile.label_repeat_password') }}</td>
			<td>
				{{ form_widget(form.person.password2) }}
			</td>
		</tr>

		<tr>
			<td width="160">{{ phrase('user.label_captcha') }}</td>
			<td>
				{% include 'UserBundle:Common:recaptcha.html.twig' %}
			</td>
		</tr>

		<tr class="foot">
			<td colspan="2">
				<button class="dp-button">{{ phrase('user.profile.register_btn') }}</button>
			</td>
		</tr>
	</table>
</div>
</form>

</div>
{% endblock %}
