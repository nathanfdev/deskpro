<div id="omni_search" class="with-handler portal_omni_search" data-element-handler="DeskPRO.User.ElementHandler.OmniSearch">
	<div class="nav">
		<ul style="float:right">
			<li><a href="{{ path('user_register') }}">Register for free</a></li>
			<li><a href="{{ path('user_login') }}" id="omni_login_button">Log In</a></li>
		</ul>
		<ul>
			<li><a href="{{ path('user_articles') }}">Knowledgebase</a></li>
			<li><a href="{{ path('user_news') }}">News</a></li>
			<li><a href="{{ path('user_downloads') }}">Downloads</a></li>
			<li><a href="{{ path('user_feedback') }}">Feedback</a></li>
		</ul>
		<br class="clear" />
		
		<div id="omni_login_box" style="display: none">
			<div class="login-form">
				<form action="{{ path('user_login_authenticate_local') }}" method="post">
				<table cellspacing="0" cellpadding="0" width="100%"><tr>
					<td width="50%">
						<small>Email Address:</small><br />
						<input type="text" name="email" value="" />
					</td>
					<td width="50%">
						<small>Password:</small><br />
						<input type="password" name="password" value="" />
					</td>
				</tr><tr><td colspan="2" style="text-align: right;">
					<a style="" href="{{ path('user_login_resetpass') }}">Lost your login?</a>
					<button class="dp-button x-small">Log In</button>
				</td></tr></table>
				</form>

			</div>
		</div>
	</div>
	<div class="searchbar">
		<form action="{{ path('user_search') }}" method="GET">
			<input type="text" name="query" id="omni_search_txt" value="{{ query }}" placeholder="Ask a question, suggest an feedback or search the helpdesk here" />
			<button class="dp-button">Search</button>
		</form>
		<div class="example">
			Example: "<a href="" class="example-query">Pricing</a>",
			"<a href="" class="example-query">How do I add an account?</a>" or
			"<a href="" class="example-query">Latest version download</a>"
		</div>

		<div id="omni_search_menu_wrap">
			<div class="omni_search_menu">
				<div class="results">

				</div>

				<div class="create">
					<p>None of these results what you were looking for?</p>
					<ul class="links">
						<li class="ticket"><a href="{{ path('user_tickets_new') }}"><span>Subimt a new ticket</span></a></li>
						<li class="feedback"><a href="{{ path('user_feedback_newfeedback') }}"><span>Subimt an feedback</span></a></li>
						<li class="chat"><a href="#" class="dp-chat-trigger"><span>Chat with an agent</span></a></li>
					</ul>
					<br class="clear" />
				</div>
			</div>
		</div>
	</div>
</div>