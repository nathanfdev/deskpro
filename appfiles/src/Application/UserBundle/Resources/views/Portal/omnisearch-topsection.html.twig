<div id="omni_search" class="with-handler portal_omni_search" data-element-handler="DeskPRO.User.ElementHandler.OmniSearch">
	<form action="{{ path('user_search') }}" method="GET">
		<input type="text" name="query" id="omni_search_txt" value="{{ query }}" placeholder="Ask a question, suggest an idea or search the helpdesk here" />
		<button class="dp-button">Search</button>
	</form>
	<div class="example">
		Example: "<a href="" class="example-query">Pricing</a>",
		"<a href="" class="example-query">How do I add an account?</a>" or
		"<a href="" class="example-query">Latest version download</a>"
	</div>

	<div id="omni_search_menu_wrap">
		<div class="omni_search_menu">
			<div class="results">
				
			</div>

			<div class="create">
				<p>None of these results what you were looking for?</p>
				<ul class="links">
					<li class="ticket"><a href="{{ path('user_tickets_new') }}"><span>Subimt a new ticket</span></a></li>
					<li class="idea"><a href="{{ path('user_ideas_newidea') }}"><span>Subimt feedback</span></a></li>
					<li class="chat"><a href="#" class="dp-chat-trigger"><span>Chat with an agent</span></a></li>
				</ul>
				<br class="clear" />
			</div>
		</div>
	</div>
</div>