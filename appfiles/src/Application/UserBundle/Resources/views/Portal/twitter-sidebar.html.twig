<div class="sidebar-item portal_twitter">
	<div class="heading">
		<h2>@<a href="http://twitter.com/{{ twitter_name }}">{{ twitter_name }}</a></h2>
	</div>

	<div class="content-list">
		{% for item in feed_items %}
			<div class="item icon-twitter">
				{{ item.description|raw }}
			</div>
		{% endfor %}
	</div>

	<div class="more-link">
		see more @<a href="http://twitter.com/{{ twitter_name }}">{{ twitter_name }} on twitter</a>
	</div>
</div>