<div class="content-item portal_kb with-handler" data-element-handler="DeskPRO.User.ElementHandler.Kb">
	<div class="heading">
		{% if show_cat_switcher %}
		<div style="float:right">
			<select class="kb-cat-choose">
				<option value="0">All</option>
				{% for cat in cats %}
					<option value="{{cat.id}}">{{ '--'|repeat(cat.depth) }}{{ cat.title }}</option>
				{% endfor %}
			</select>
		</div>
		{% endif %}
		<h2><a href="{{ path('user_articles') }}">{{ title|default('Knowledgebase') }}</a></h2>
	</div>
	<div class="content-list">
		<ul>
			{{ html|raw }}
		</ul>
	</div>
</div>