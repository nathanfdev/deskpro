{% if ideas|length %}
	<div class="dp-sidebar-block dp-ideas-block">
		<div class="dp-box-header">
			<h3><a href="{{ path('user_ideas', {'status': 'new'}) }}">Newest Ideas</a></h3>
		</div>
		<ul class="dp-content-list">
			{% for idea in ideas %}
				<li>
					{% include 'UserBundle:Ideas:voting-widget.html.twig' %}
					<a href="{{ path('user_ideas_view', {'slug': idea.url_slug}) }}">{{idea.title}}</a>
				</li>
			{% endfor %}
		</ul>
		<div class="dp-more" style="clear:left">
			<a href="{{ path('user_ideas', {'status': 'new'}) }}">View more ideas &rarr;</a>
		</div>
	</div>
{% endif %}
