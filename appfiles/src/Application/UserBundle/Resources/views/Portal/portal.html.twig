{% extends 'UserBundle::layout.html.twig' %}
{% block head %}
	<script type="text/javascript">
	DeskPRO_Window.PAGE = new DeskPRO.User.Page.Portal();
	</script>

	{% for path in portal_page.css_assets %}
		<link rel="stylesheet" href="{{ asset(path) }}" type="text/css" />
	{% endfor %}
	{% for path in portal_page.js_assets %}
		<script src="{{ asset(path) }}" type="text/javascript"></script>
	{% endfor %}
{% endblock %}
{% block content %}
	{{ portal_page.content|raw }}
{% endblock %}
{% block sidebar %}
	{{ portal_page.sidebar|raw }}
{% endblock %}