<div class="sidebar-item portal_kb">
	<div class="heading">
		<h2><a href="{{ path('user_news') }}">{{ title|default('News') }}</a></h2>
	</div>

	<div class="content-list">
		{% for news in news_entries %}
			<div class="item">
				<div class="cal-date small" title="Posted: {{ news.date_created|date('M d Y @ H:i:s') }}">
					<div class="month">{{ news.date_created|date('M')|upper }}</div>
					<div class="day">{{ news.date_created|date('d') }}</div>
				</div>
				<a href="{{ path('user_news_view', {'slug': news.url_slug}) }}">{{ news.title }}</a>
				<div class="info-line">
					By {{ news.person.display_name }} in <a href="{{ path('user_news', {'slug': news.category.url_slug}) }}">{{ news.category.title }}</a>
				</div>
			</div>
		{% endfor %}
	</div>

	<div class="more-link">
		<a href="{{ path('user_news') }}">more...</a>
	</div>
</div>