{% if downloads|length %}
	<div class="dp-sidebar-block dp-downloads-block">
		<div class="dp-box-header">
			<h3><a href="{{ path('user_downloads') }}">Downloads</a></h3>
		</div>
		<ul class="dp-content-list">
			{% for download in downloads %}
				<li>
					<div class="dp-faded-container">
						<span class="dp-icon-file dp-icon-{{ download.blob.extension }}"><a href="{{ path('user_downloads_file', {'slug': download.url_slug}) }}">{{ download.title }}</a></span>
						<div class="dp-bound-faded"></div>
					</div>
					<div class="meta">
						{{ download.filename }}, {{ download.readable_filesize }}
					</div>
				</li>
			{% endfor %}
		</ul>
		<div class="dp-more" style="clear:left">
			<a href="{{ path('user_downloads') }}">View more downloads &rarr;</a>
		</div>
	</div>
{% endif %}
