<div class="sidebar-item portal_downloads">
	<div class="heading">
		<h2><a href="{{ path('user_downloads') }}">{{ title|default('Downloads') }}</a></h2>
	</div>

	<div class="content-list">
		{% for download in downloads %}
			<div class="item icon-{{ download.blob.extension }}">
				<a href="{{ path('user_downloads_file', {'slug': download.url_slug}) }}">{{ download.title }}</a>
				<div class="info-line">
					{{ download.filename }}, {{ download.readable_filesize }}
				</div>
			</div>
		{% endfor %}
	</div>

	<div class="more-link">
		<a href="{{ path('user_downloads') }}">more...</a>
	</div>
</div>