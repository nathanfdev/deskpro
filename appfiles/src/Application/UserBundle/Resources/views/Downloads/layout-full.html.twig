{% extends is_partial_request() ? 'UserBundle::layout-partial.html.twig' : 'UserBundle::layout.html.twig' %}
{% block content %}
<div class="dp-content-block portal_kb">
	<div class="dp-box">
		<div class="dp-box-header">
			{% if category %}
				<h1><a href="{{ path('user_downloads', {'slug': category.url_slug}) }}">Downloads: {{category.title}}</a></h1>
			{% else %}
				<h1><a href="{{ path('user_downloads') }}">Downloads</a></h1>
			{% endif %}
		</div>

		<div class="dp-box-content-wrapper">
			{% block downloads_browse %}{% endblock %}
		</div>
	</div>
</div>
{% endblock %}
