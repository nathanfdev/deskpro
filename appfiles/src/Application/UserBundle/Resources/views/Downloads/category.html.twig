{% extends 'UserBundle::layout.html.twig' %}
{% block content %}
<small>
<a href="{{ path('user_downloads') }}">Downloads</a> /
{% for cat in category_path %}
	{% if not loop.last %}
		<a href="{{ path('user_downloads_cat', {'slug': cat.url_slug}) }}">{{cat.title}}</a> /
	{% endif %}
{% endfor %}
</small>
<h3 style="margin:0;">{{category.title}}</h3>
<hr />

<div style="float:left; widows: 190px;">
	{% if category.children|length %}
		{% include 'UserBundle:Downloads:category-list.html.twig' with {'categories': category.children} %}
	{% endif %}
</div>

<div style="margin-left: 200px">
	<table cellpadding="0" cellspacing="0" width="100%" border="0">
		{% for download in downloads %}
			<tr>
				<td>
					<a href="{{ path('user_downloads_file', {'slug': download.url_slug}) }}">{{ download.title }}</a>
				</td>
				<td>
					{{ download.blob.filename }} ({{download.blob.readable_filesize}})
				</td>
				<td width="120">
					{{article.date_created|date('Y-m-d')}}
				</td>
			</tr>
		{% endfor %}
	</table>
</div>

<br style="clear:left" />

{% endblock %}