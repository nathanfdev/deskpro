{% extends 'UserBundle::layout.html.twig' %}
{% block breadcrumb %}
	<li><a href="{{ path('user_search_labels') }}">Search Labels</a></li>
{% endblock %}
{% block content %}
<div class="label-search">

<table cellspacing="0" cellpadding="0" width="100%" class="header"><tr>
	<td width="45%">
		<div class="search-box">
			<form action="{{ path('user_search_labels') }}" method="get">
				<h3>Find pages labelled with:</h3>
				<input type="text" name="label" value="{{ label }}" /> <button class="dp-button x-small">Find</button>
			</form>
		</div>
	</td>
	<td>
		<div class="tag-cloud">
			<h3>Or choose one of these popular labels:</h3>
			<ul>
				{% for c_label,css_class in cloud %}
					<li class="{{css_class}}"><a href="{{ path('user_search_labels', {'label': c_label}) }}">{{ c_label }}</a></li>
				{% endfor %}
			</ul>
		</div>
	</td>
</table>

{# Articles #}
{% if results.articles.results|length %}
<div class="content-item">
	<div class="heading">
		<h2><a class="button" href="{{ path('user_search_labels', {'label': label, 'type': 'articles'}) }}">Articles</a></h2>
	</div>

	<div class="tab-contents">
		<div class="with-handler"
			data-element-handler="DeskPRO.User.ElementHandler.MoreLoader"
			data-load-url="{{ path('user_search_labels', {'label': label, 'type': 'articles', 'page': '00000'})|replace({'00000': '{page}'}) }}"
		>
			<div class="content-list">
				<ul>
					{% include 'UserBundle:Search:label-search-items.html.twig' with {'typename': 'articles', 'results': results.articles.results, 'show_more': results.articles.show_more} %}
				</ul>
			</div>
			{% if results.articles.show_more %}
			<div class="content-more">
				<div class="is-not-loading">
					<a class="button" href="{{ path('user_search_labels', {'label': label, 'type': 'articles', 'page': page+1}) }}">More</a>
				</div>
				<div class="is-loading">
					<center><img src="{{ asset('images/loading-big-circle.gif') }}" alt="" /></center>
				</div>
			</div>
			{% endif %}
		</div>
	</div>
</div>
{% endif %}

