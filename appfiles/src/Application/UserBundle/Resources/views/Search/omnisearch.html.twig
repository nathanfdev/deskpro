<ul>
	{% for res in results %}
		{% if res.type == 'article' %}
			<li class="article">
				<a href="{{ path('user_articles_article', {'slug': res.object.url_slug}) }}">
					<span>{{ res.object.title }}</span>
				</a>
			</li>
		{% elseif res.type == 'feedback' %}
			<li class="feedback">
				<a href="{{ path('user_feedback_view', {'slug': res.object.url_slug}) }}">
					<span>{{ res.object.title }}</span>
				</a>
			</li>
		{% endif %}
	{% endfor %}
</ul>
