<ul>
	{% for res in results %}
		{% if res.type == 'article' %}
			<li class="article">
				<a href="{{ path('user_articles_article', {'slug': res.object.url_slug}) }}">
					<span>{{ res.object.title }}</span>
				</a>
			</li>
		{% elseif res.type == 'idea' %}
			<li class="idea">
				<a href="{{ path('user_ideas_view', {'slug': res.object.url_slug}) }}">
					<span>{{ res.object.title }}</span>
				</a>
			</li>
		{% endif %}
	{% endfor %}
</ul>
<div class="more-link">
	<a href="{{ path('user_search', {'query': query}) }}">See more results &rarr;</a>
</div>