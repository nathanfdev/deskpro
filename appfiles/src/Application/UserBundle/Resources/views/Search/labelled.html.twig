{% extends 'UserBundle::layout.html.twig' %}
{% block content %}

<div style="margin: 10px; padding:  10px; background-color: #F7F8FA; border: 1px solid #BCC2CF; text-align: center;">
	Pages labelled with
	<input type="text" value="{{labels}}" id="search_labels" style="width: 150px;" />
	<input type="submit" value="view" onclick="window.location='{{ path('user_search_labels', {'labels': '__label__'}) }}'.replace('__label__', $('#search_labels').val());" />
</div>

{% if is_search %}
	{% if not results %}
		<strong>No results, try using different terms.</strong>
	{% else %}
		{% for result in results %}
			<div style="background-color: #FAFAFA; border-top: 2px solid #DBDBDB; padding: 8px 3px 8px 3px;">
				{% if result.document.type == 'article' %}
					<strong><a href="{{ path('user_articles_article', {'slug': result.object.url_slug}) }}">{{ result.object.title }}</a></strong><br />
					{{result.object.excerpt_html|raw}}
				{% elseif result.document.type == 'download' %}
					<strong><a href="{{ path('user_downloads_file', {'slug': result.object.url_slug}) }}">{{ result.object.title }}</a></strong><br />
				{% elseif result.document.type == 'idea' %}
					<strong><a href="{{ path('user_ideas_view', {'slug': result.object.url_slug}) }}">{{ result.object.title }}</a></strong><br />
					{{result.object.content_html|raw}}
				{% elseif result.document.type == 'news' %}
					<strong><a href="{{ path('user_ideas_view', {'slug': result.object.url_slug}) }}">{{ result.object.title }}</a></strong><br />
					{{result.object.intro_html|raw}}
				{% endif %}
			</div>
		{% endfor %}
	{% endif %}
{% endif %}

{% endblock %}