<div class="feedback_vote_menu_wrap" style="display: none">
	<div class="feedback_vote_menu">
		<span class="close-trigger">x</span>
		You have up to <span class="votes-allowed"></span> votes to cast on this feedback. How many do you want to use?
		<br />
		<ul>
			<li class="num-0 on" data-num="0">&nbsp;None&nbsp;</li>
			{% for i in 1..app.getSetting('core_feedback.max_votes_feedback') %}
				<li class="num-{{ i }} num" data-num="{{ i }}">{{ i }}</li>
			{% endfor %}
		</ul>
		<br class="clear" />
	</div>
</div>