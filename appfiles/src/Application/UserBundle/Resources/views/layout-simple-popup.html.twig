<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
<head>
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
	<title>DeskPRO</title>

	{% set disable_agent_bar = true %}
	{% include 'UserBundle:Common:resources.html.twig' %}

	<script type="text/javascript">
		window.DeskPRO_Window = new DeskPRO.User.Window();
		$(document).ready(function() {
			window.DeskPRO_Window.initPage();
		});
	</script>

	{% block head %}{% endblock %}
</head>
<body class="simple-popup">
<div id="container">
	<div id="page">{% block content %}{% endblock %}</div>
</div>
</body>
</html>