		$(document).ready(function() {
			$('#deskpro_search').focus(function(ev) {
				var el = $(this);
				var assist = $('#dp_search_assist');

				var pos = el.offset();
				var w = el.outerWidth();
				var h = el.outerHeight();

				assist.css({
					top: pos.top + h,
					left: pos.left,
					width: w
				});
				assist.show();
			});
			$('#deskpro_search').blur(function(ev) {
				$('#dp_search_assist').hide();
			});
		});
	</script>
