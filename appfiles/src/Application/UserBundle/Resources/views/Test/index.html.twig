<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
<head>
	<link rel="shortcut icon" href="{{ path('favicon', {}, true) }}" />
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
	<title>{% block page_title %}{{ app.getSetting('core.deskpro_name') }}{% endblock %}</title>

	{% include 'UserBundle:Common:resources.html.twig' %}
	{% include 'UserBundle:Common:page-init.html.twig' %}

	{% block head %}{% endblock %}
</head>
<body>

<div class="container">
	<div class="span-24">
		<div id="header">
			<div class="logo">
				<h1>
					<a href="{{ path('user') }}">{{ app.getSetting('core.deskpro_name') }}</a>
				</h1>
			</div>
			<div class="nav">
				<ul>
					<li><a href="{{ path('user') }}">Home</a></li>
					<li><a href="{{ path('user_search') }}">Search</a></li>
					<li><a href="{{ path('user_articles') }}">Articles</a></li>
					<li><a href="{{ path('user_downloads') }}">Downloads</a></li>
					<li><a href="{{ path('user_news') }}">News</a></li>
					<li><a href="{{ path('user_ideas') }}">Ideas</a></li>
					{% if app.user.id %}
						<li><a href="{{ path('user_tickets') }}">Tickets</a></li>
					{% endif %}
				</ul>
			</div>
		</div>
	</div>

	<hr class="space">

	<div class="span-16">
		{% block content %}{% endblock %}
	</div>

	<div class="span-4 colborder last">
		{% block sidebar %}{% endblock %}
	</div>
</div>

</body>
</html>