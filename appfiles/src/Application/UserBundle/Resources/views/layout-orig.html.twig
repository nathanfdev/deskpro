<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
<head>
	<link rel="shortcut icon" href="{{ path('favicon', {}, true) }}" />
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
	<title>{% block page_title %}{{ app.getSetting('core.deskpro_name') }}{% endblock %}</title>

	{% include 'UserBundle:Common:resources.html.twig' %}
	{% include 'UserBundle:Common:page-init.html.twig' %}

	{{ portal_css(['sidebar', 'pagetop']) }}
	{{ portal_js(['sidebar', 'pagetop']) }}

	{% block head %}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">

<div class="container">
	<div class="span-24">
		<div id="header">
			<div class="logo">
				<h1>
					<a href="{{ path('user') }}">{{ app.getSetting('core.deskpro_name') }}</a>
				</h1>
			</div>
		</div>
	</div>
</div>

<hr class="space" />

<div class="container" id="content_container">
	<div class="span-24">
		<div id="pagetop">
			{{ portal_section('pagetop') }}
		</div>
	</div>
	
	<div class="span-17">
		<div id="content">
			{% set breadcrumb %}{% block breadcrumb %}{% endblock %}{% endset %}
			{% if breadcrumb|trim|length %}
				<div class="breadcrumb">
					<ul>
						<li><a href="{{ path('user') }}">Helpdesk</a></li>
						{{ breadcrumb }}
					</ul>
				</div>
			{% endif %}

			{% block content %}{% endblock %}
		</div>
	</div>

	<div class="span-7 last">
		<div id="sidebar">
			{% block sidebar %}
				{{ portal_section('sidebar') }}
			{% endblock %}
		</div>
	</div>

	<div class="span-24">
		<div id="copy_footer">
			<a class="up" href="#" onclick="$(document).scrollTop(0); return false;">Top</a>
			<a href="http://www.deskpro.com/">Helpdesk software by <em>DeskPRO</em></a>
		</div>
	</div>
</div>

<hr class="space" />

<div class="container">
	<div class="span-24">
		<div id="footer">
			<ul class="links">
				<li><a href="{{ app.getSetting('core.site_url') }}">{{ app.getSetting('core.site_name') }}</a></li>
			</ul>
		</div>
	</div>
</div>


{% if not app.getSetting('user.disable_chat_element') %}
	{% include 'UserBundle:Common:chat-loader.html.twig' %}
{% endif %}
</body>
</html>