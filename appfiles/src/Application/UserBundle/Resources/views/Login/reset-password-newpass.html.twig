{% extends 'UserBundle::layout.html.twig' %}
{% block content %}
<div class="dp-content-block dp-passreset-page">
	<div class="dp-box">
		<div class="dp-box-header">
			<h1>Reset Password</h1>
		</div>
		<div class="dp-box-content-wrapper">
			<div class="dp-box-content dp-form">
				<form action="{{ path('user_login_resetpass_newpass', {'code': code}) }}" class="form login" method="post">
					<div class="dp-form-row">
						<div class="dp-form-label">
							<label>New Password</label>
						</div>
						<div class="dp-form-input">
							<input type="password" value="" name="password" id="password" size="40" />
						</div>
					</div>
					<div class="dp-form-row">
						<div class="dp-form-label">
							<label>Repeat Password</label>
						</div>
						<div class="dp-form-input">
							<input type="password" value="" name="password2" id="password2" size="40" />
						</div>
					</div>

					<input class="btn primary" type="submit" value="Reset Password" />
				</form>
			</div>
		</div>
	</div>
</div>
{% endblock %}
