{% extends 'UserBundle::layout.html.twig' %}
{% block content %}
<h1>Reset Password</h1>

<div class="login_method_wrap">
	<div class="content login_method_content">
		<form action="{{ path('user_login_resetpass_newpass', {'code': code}) }}" class="form login" method="post">
			<input type="hidden" name="process" value="1" />
			<table cellspacing="10" cellpadding="0" border="0">
				<tr>
					<td>New Password:</td>
					<td><input type="password" value="" name="password" id="password" size="40" /></td>
				</tr>
				<tr>
					<td>Repeat Password:</td>
					<td><input type="password" value="" name="password2" id="password2" size="40" /></td>
				</tr>
				<tr>
					<td>&nbsp;</td>
					<td><input type="submit" value="Reset Password" /></td>
				</tr>
			</table>
		</form>
	</div>
</div>

{% endblock %}