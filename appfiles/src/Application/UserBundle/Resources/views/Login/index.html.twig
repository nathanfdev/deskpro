{% extends 'UserBundle::layout.html.twig' %}
{% block content %}
<h1>Log In</h1>

<div class="login_method_wrap">
	<div class="content login_method_content">
		<form action="{{ path('user_login_authenticate_local') }}" class="form login" method="post">
			{% if return %}
				<input type="hidden" name="return" value="{{return}}" />
			{% endif %}
			{% if invalid_login %}
				<p>Invalid login. Please try again.</p>
			{% endif %}
			<table cellspacing="10" cellpadding="0" border="0">
				<tr>
					<td>Email:</td>
					<td><input type="text" value="" name="email" id="email" size="40" tabindex="1" /></td>
				</tr>
				<tr>
					<td>Password <small>(<a href="{{ path('user_login_resetpass') }}">lost?</a>)</small>:</td>
					<td><input type="password" value="" name="password" id="password" size="40" tabindex="2" /></td>
				</tr>
				<tr>
					<td>&nbsp;</td>
					<td><input type="submit" value="Log In" /></td>
				</tr>
			</table>
		</form>
	</div>
</div>
{% endblock %}