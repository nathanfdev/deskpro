{% extends 'UserBundle::layout.html.twig' %}
{% block content %}
<h1>Reset Password</h1>

<div class="login_method_wrap">
	<div class="content login_method_content">
		<form action="{{ path('user_login_resetpass_send') }}" class="form login" method="post">
			{% if invalid_email %}
				<p>We do not have any accounts with that email address.</p>
			{% endif %}
			<table cellspacing="10" cellpadding="0" border="0">
				<tr>
					<td>Your Email:</td>
					<td><input type="text" value="" name="email" id="email" size="40" /></td>
				</tr>
				<tr>
					<td>&nbsp;</td>
					<td><input type="submit" value="Continue" /></td>
				</tr>
			</table>
		</form>
	</div>
</div>

<br /><br />

<h2>Already have a reset code?</h2>
<p>If you already have a reset code from your email, you can input it here to continue to the reset form.</p>

<form action="{{ path('user_login_resetpass_send') }}" class="form login" method="post">
	{% if invalid_code %}
		<p>The code you entered is invalid. It may be expired, try requesting a new one above.</p>
	{% endif %}
	<table cellspacing="10" cellpadding="0" border="0">
		<tr>
			<td>Reset Code:</td>
			<td><input type="text" value="" name="reset_code" id="reset_code" size="40" /></td>
		</tr>
		<tr>
			<td>&nbsp;</td>
			<td><input type="submit" value="Continue" /></td>
		</tr>
	</table>
</form>


{% endblock %}