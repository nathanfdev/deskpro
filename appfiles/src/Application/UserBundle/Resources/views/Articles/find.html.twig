{% extends 'UserBundle:Articles:layout.html.twig' %}
{% block breadcrumb %}
	<li><a href="{{ path('user_articles') }}">Knowledgebase</a></li>
	<li><a href="{{ path('user_articles_filter') }}">Find</a></li>
{% endblock %}
{% block kb_find %}
	<div class="content-filters">
		<form action="{{ path('user_articles_filter') }}" method="post">
		<table cellspacing="0" cellpadding="0" width="100%">
			<tr>
				<td>Category:</td>
				<td>Product:</td>
				<td rowspan="2"><button>Find</button></td>
			</tr>
			<tr>
				<td>
					<select name="category_id">
						<option value="0">All</option>
						{% for cat in kb_cats %}
							<option value="{{cat.id}}" {% if search_options.category_id == cat.id %}selected="selected"{% endif %}>{{ '--'|repeat(cat.depth) }}{{ cat.title }}</option>
						{% endfor %}
					</select>
				</td>
				<td>
					<select name="product_id">
						<option value="0">All</option>
						{% for prod in products %}
							<option value="{{prod.id}}" {% if search_options.product_id == prod.id %}selected="selected"{% endif %}>{{ '--'|repeat(prod.depth) }}{{ prod.title }}</option>
						{% endfor %}
					</select>
				</td>
			</tr>
		</table>
		</form>
	</div>
	<div class="content-list">
		<ul>
			{% for article in articles %}
			<li class="article">
				<div class="info-line" style="float:right">
					<ul>
						<li class="comments" title="Comments"><span>{{ 0 }}</span></li>
						<li class="views" title="Views"><span>{{ article.view_count }}</span></li>
					</ul>
				</div>
				<h4><a href="{{ path('user_articles_article', {'slug': article.url_slug}) }}">{{ article.title }}</a></h4>
			</li>
			{% endfor %}
		</ul>
	</div>
	<div class="content-pages">
		<div class="num-info">
			{{ num_results }} results sorted by
			<select name="order_by">
				<option value="id.desc" {% if search_options.order_by == 'id.desc' %}selected="selected"{% endif %}>Date</option>
				<option value="view_count.desc" {% if search_options.order_by == 'view_count.desc' %}selected="selected"{% endif %}>Popularity</option>
			</select>
		</div>
		<div class="pager">
			{% if pageinfo.prev %}
				<a href="{{ path('user_articles_filter', {'page': pageinfo.prev}) }}?{{ search_options_url }}">Prev</a>
			{% endif %}
			{% for page in pageinfo.pages %}
				{% if page == pageinfo.curpage %}
					[{{ page }}]
				{% else %}
					<a href="{{ path('user_articles_filter', {'page': page}) }}?{{ search_options_url }}">{{ page }}</a>
				{% endif %}
			{% endfor %}
			{% if pageinfo.next %}
				<a href="{{ path('user_articles_filter', {'page': pageinfo.next}) }}?{{ search_options_url }}">Next</a>
			{% endif %}
		</div>
	</div>
{% endblock %}