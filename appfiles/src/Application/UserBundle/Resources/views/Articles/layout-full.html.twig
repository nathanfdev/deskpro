{% extends is_partial_request() ? 'UserBundle::layout-partial.html.twig' : 'UserBundle::layout.html.twig' %}
{% block head %}
{% if do_portal %}
	<script src="{{ asset('javascripts/DeskPRO/User/ElementHandler/Kb.js') }}"></script>
{% endif %}
{% endblock %}
{% block content %}
<div class="content-item portal_kb with-handler" {% if is_partial_request() == 'portal' %}data-element-handler="DeskPRO.User.ElementHandler.PortalKb"{% endif %}>
	<div class="heading">
		<div class="heading-tabs">
			<ul>
				<li {% if block('kb_browse')|trim|length %}class="on"{% endif %} data-tab-for=".browse"><a href="{{ path('user_articles') }}">Browse</a></li>
				<li {% if block('kb_find')|trim|length %}class="on"{% endif %} data-tab-for=".find"><a href="{{ path('user_articles_filter') }}">Find</a></li>
				{% if section_counts.new %}
					<li {% if block('kb_recent')|trim|length %}class="on"{% endif %} data-tab-for=".recent"><a href="{{ path('user_articles_recent') }}">New <em>({{ section_counts.new }})</em></a></li>
				{% endif %}
				{% if section_counts.popular %}
					<li {% if block('kb_popular')|trim|length %}class="on"{% endif %} data-tab-for=".popular"><a href="{{ path('user_articles_popular') }}">Popular <em>({{ section_counts.popular }})</em></a></li>
				{% endif %}
			</ul>
		</div>
		<h2><a href="{{ path('user_articles') }}">{{ title|default('Knowledgebase') }}</a></h2>
	</div>

	<div class="tab-contents">
		<div class="{% if block('kb_browse')|trim|length %}on{% endif %} browse tab-content">{% block kb_browse %}{% endblock %}</div>
		<div class="{% if block('kb_find')|trim|length %}on{% endif %} find tab-content">{% block kb_find %}{% endblock %}</div>
		<div class="{% if block('kb_recent')|trim|length %}on{% endif %} recent tab-content">{% block kb_recent %}{% endblock %}</div>
		<div class="{% if block('kb_popular')|trim|length %}on{% endif %} popular tab-content">{% block kb_popular %}{% endblock %}</div>
	</div>

	<div class="loading-tpl" style="display: none">
		<div class="loading" style="text-align: center; padding: 15px;"><img src="{{ asset('images/loading-big-circle.gif') }}" alt="" /></div>
	</div>
</div>
{% endblock %}