{% extends 'UserBundle::layout.html.twig' %}
{% block content %}

{% include 'UserBundle:Articles:category-list.html.twig' %}

<table cellpadding="0" cellspacing="0" width="100%" border="0">
	<tr>
		<td width="33%" valign="top" style="vertical-align:top">
			<h3 style="margin: 0; padding: 5px; background-color: #ccc">
				Newest
			</h3>
			{% for article in newest_articles %}
				&middot; <a href="{{ path('user_articles_article', {'article_id': article.id, 'slug': article.slug}) }}">{{ article.title }}</a><br />
			{% endfor %}
		</td>
		<td width="33%" valign="top" style="vertical-align:top">
			<h3 style="margin: 0; padding: 5px; background-color: #ccc">
				Top Rated
			</h3>
			{% for article in top_rated_articles %}
				&middot; <a href="{{ path('user_articles_article', {'article_id': article.id, 'slug': article.slug}) }}">{{ article.title }}</a><br />
			{% endfor %}
		</td>
	</tr>
</tr>

{% endblock %}