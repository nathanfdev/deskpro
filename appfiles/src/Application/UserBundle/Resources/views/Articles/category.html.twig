{% extends 'UserBundle::layout.html.twig' %}
{% block content %}
<small>
<a href="{{ path('user_articles') }}">Articles</a> / 
{% for cat in category_path %}
	{% if not loop.last %}
		<a href="{{ path('user_articles_cat', {'category_id': cat.id}) }}">{{cat.title}}</a> /
	{% endif %}
{% endfor %}
</small>
<h3 style="margin:0;">{{category.title}}</h3>
<hr />

{% if category.children|length %}
	{% include 'UserBundle:Articles:category-list.html.twig' with {'categories': category.children} %}
	<hr />
{% endif %}

<table cellpadding="0" cellspacing="0" width="100%" border="0">
	{% for article in articles %}
		<tr>
			<td>
				<a href="{{ path('user_articles_article', {'article_id': article.id, 'slug': article.slug}) }}">{{ article.title }}</a>
				{% if article.excerpt %}
					{{article.excerpt_html}}
				{% endif %}
			</td>
			<td width="120">
				{{article.created_at|date('Y-m-d')}}
			</td>
		</tr>
	{% endfor %}
</table>

{% endblock %}