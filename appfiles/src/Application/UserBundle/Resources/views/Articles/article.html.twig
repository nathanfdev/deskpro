{% extends 'UserBundle::layout.html.twig' %}
{% block head %}
	<meta property="og:url" content="{{ path('user_articles_article', {'slug': article.id}) }}" />
	<meta property="og:title" content="{{article.title}}" />
	<meta property="og:type" content="article" />
{% endblock %}
{% block breadcrumb %}
	<li><a href="{{ path('user_articles') }}">Knowledgebase</a></li>
	{% for categories in all_categories %}
		{% if loop.index0 == 0 %}
			{% for c in categories %}
				<li><a href="{{ path('user_articles', {'slug': c.url_slug}) }}">{{c.title}}</a></li>
			{% endfor %}
		{% endif %}
	{% endfor %}
	<li><a href="{{ path('user_articles_article', {'slug': article.url_slug}) }}">{{article.title}}</a></li>
{% endblock %}
{% block content %}
<div class="article">

	<div class="cal-date" title="{{ article.date_created|date('M d Y @ H:i:s') }}">
		<div class="month">{{ article.date_created|date('M')|upper }}</div>
		<div class="day">{{ article.date_created|date('d') }}</div>
	</div>
	<div class="page-title">
		<h1>{{ article.title }}</h1>
		<div class="info-line">
			By {{ article.by_line }}
			{% if all_categories|length > 1 %}
				<br /><strong>Cross-posted into:</strong>
				{% for categories in all_categories -%}
					{% for c in categories -%}
						<a href="{{ path('user_articles_cat', {'slug': c.url_slug}) }}">{{c.title}}</a>{% if not loop.last %} / {% endif %}
					{% endfor %}{%- if not loop.last %}, {% endif %}
				{% endfor %}
			{% endif %}
		</div>
	</div>

	<div class="post">{{ article.content_html|raw }}</div>

	{% include 'UserBundle:Common:content-subscribe.html.twig' with {'page_type': 'article', 'page_id': article.id} %}

	{% include 'UserBundle:Common:labels-box.html.twig' with {'labels': article.labels} %}

	{% include 'UserBundle:Common:rating-bar.html.twig' with {'content_object': article} %}

	{% if comments_widget %}
			{{comments_widget|raw}}
	{% else %}
		<div class="content-item">
			<div class="heading"><h2>Comments</h2></div>
			<div class="content-list">
				<ul class="comments">
					<li class="new-comment">
						<form action="{{ path('user_articles_newcomment', {'article_id': article.id}) }}" method="post">
							<table cellspacing="0" cellpadding="0">
								{% if is_user_guest() %}
									<tr>
										<td>Name:</td>
										<td><input type="text" name="new_comment[name]" /> (public)</td>
									</tr>
									<tr>
										<td>Email:</td>
										<td><input type="text" name="new_comment[email]" /> (private, never revealed)</td>
									</tr>
								{% else %}
									<tr>
										<td>Name:</td>
										<td>{{ app.user.display_name }} (public)</td>
									</tr>
								{% endif %}
								<tr>
									<td>&nbsp;</td>
									<td>
										<textarea name="new_comment[content]" cols="80" rows="5"></textarea><br/>
										<div style="text-align: right">
											<input type="submit" value="comment" />
										</div>
									</td>
								</tr>
							</table>
						</form>
					</li>

					{% for comment in comments %}
						{% include 'UserBundle:Common:comment.html.twig' %}
					{% endfor %}
				</ul>
			</div>
		</div>
	{% endif %}
</div>

{% endblock %}
