{% extends 'UserBundle::layout.html.twig' %}
{% block head %}
	<meta property="og:url" content="{{ path('user_articles_article', {'slug': article.id}) }}" />
	<meta property="og:title" content="{{article.title}}" />
	<meta property="og:type" content="article" />
{% endblock %}
{% block content %}
<h4>{{article.title}}</h4>
<hr />
{% for categories in all_categories %}
	&middot; {% for c in categories %}
		<a href="{{ path('user_articles_cat', {'slug': c.url_slug}) }}">{{c.title}}</a>{% if not loop.last %} / {% endif %}
	{% endfor %}
	<br />
{% endfor %}
<hr />

{% include 'UserBundle:Common:related-content-side.html.twig' %}
{{article.content_html|raw}}

<br style="clear:both" />

{% if facebook_like %}
<div style="margin: 10px;">
	{{facebook_like|raw}}
</div>
{% endif %}
<div style="background-color: #eee; padding: 10px; margin-top: 8px;">
	<form action="{{ path('user_articles_rate', {'article_id': article.id}) }}" method="post">
		{% if rating_this %}
			{% if rating_this > 1 %}
				You found this article helpful
			{% else %}
				You didn't like this article
			{% endif %}
		{% else %}
			<input type="radio" value="1" name="rating" {% if rating_this == 1 or not rating_this %}checked="checked"{% endif %}/> This article was helpful
			<input type="radio" value="-1" name="rating" {% if rating_this == -1 %}checked="checked"{% endif %}/> This article was not helpful
			<input type="submit" value="vote" />
		{% endif %}
	</form>
</div>

{% if comments_widget %}
	{{comments_widget|raw}}
{% else %}
	<div style="background-color: #eee; padding: 10px; margin-top: 15px;">
		<form action="{{ path('user_articles_newcomment', {'article_id': article.id}) }}" method="post">
		Name: <input type="text" name="new_comment[name]" /> (public)<br />
		Email: <input type="text" name="new_comment[email]" /> (private, never revealed)<br />
		<textarea name="new_comment[content]" cols="80" rows="5"></textarea>
		<input type="submit" value="Submit" />
		</form>
		<hr />

		{% for comment in comments %}
			<div style="background-color: #fff; padding: 6px; margin: 10px;">
				<em>{{comment.name}}</em>:<br />
				{{comment.content_html|raw}}
			</div>
		{% endfor %}
	</div>
{% endif %}

{% endblock %}