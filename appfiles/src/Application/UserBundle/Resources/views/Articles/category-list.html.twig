<table cellpadding="0" cellspacing="0" width="100%" border="0">
	<tr>
		{% for cat in categories %}
			{% if loop.index0 is divisibleby(2) %}</tr><tr>{% endif %}
			<td width="33%" valign="top" style="vertical-align:top">
				<h3 style="margin: 0; padding: 5px; background-color: #ccc"><a href="{{ path('user_articles_cat', {'slug': cat.url_slug}) }}">{{ cat.title }}</a></h3>
				{% if cat.children|length %}
					<div style="font-size:11px; background-color: #eee; border-bottom: 1px solid #ccc; padding: 3px;">
						{% for subcat in cat.children %}
						<a href="{{ path('user_articles_cat', {'slug': subcat.url_slug}) }}">{{ subcat.title }}</a>{% if not loop.last %}, {% endif %}
						{% endfor %}
					</div>
				{% endif %}
				{% if newest_cat_articles[cat.id]|length %}
					<div>
					{% for article in newest_articles[cat.id] %}
						&middot; <a href="{{ path('user_articles_article', {'slug': article.url_slug}) }}">{{ article.title }}</a><br />
					{% endfor %}
					</div>
				{% endif %}
			</td>
		{% endfor %}
	</tr>
</table>