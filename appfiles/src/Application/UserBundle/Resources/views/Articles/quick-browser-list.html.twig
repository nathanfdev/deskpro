{% for article in articles %}
	<li>
		<h4><a href="{{ path('user_articles_article', {'slug': article.url_slug}) }}">{{ article.title }}</a></h4>
		<div class="info-line">
			<ul>
				<li class="comments" title="Comments"><span>{{ rand(1, 50) }}</span></li>
				<li class="views" title="Views"><span>{{ rand(100, 2000) }}</span></li>
			</ul>
		</div>
	</li>
{% else %}
	<li>There are no articles in this category.</li>
{% endfor %}