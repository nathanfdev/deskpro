{% for article in articles %}
	<li>
		<h4><a href="{{ path('user_articles_article', {'slug': article.url_slug}) }}">{{ article.title }}</a></h4>
		<div class="info-line">
			<ul>
				<li>{{ article.date_created|date('M j') }}</li>
				<li>{{ article.category_names }}</li>
			</ul>
		</div>
	</li>
{% else %}
	<li>There are no articles in this category.</li>
{% endfor %}