{% if is_partial_request() == 'portal' %}
	{# This whole wrapper template #}
	{% set extend_tpl = 'UserBundle::layout-partial.html.twig' %}
	{% set do_portal = true %}
{% elseif is_partial_request() %}
	{# A partial page with only content (tab-contents) #}
	{% set extend_tpl = 'UserBundle:Articles:layout-partial.html.twig' %}
{% else %}
	{# A normal page load #}
	{% set extend_tpl = 'UserBundle::layout.html.twig' %}
{% endif %}
{% extends extend_tpl %}

{% block head %}
{% if do_portal %}
	<script src="{{ asset('javascripts/DeskPRO/User/ElementHandler/Kb.js') }}"></script>
{% endif %}
{% endblock %}
{% block content %}
<div class="content-item portal_kb with-handler" {% if do_portal %}data-element-handler="DeskPRO.User.ElementHandler.Kb"{% endif %}>
	<div class="heading">
		<div class="heading-tabs">
			<ul>
				<li {% if block('kb_browse')|trim|length %}class="on"{% endif %} data-tab-for=".browse"><a href="{{ path('user_articles') }}">Browse</a></li>
				<li {% if block('kb_find')|trim|length %}class="on"{% endif %} data-tab-for=".find"><a href="{{ path('user_articles_filter') }}">Find</a></li>
				<li {% if block('kb_recent')|trim|length %}class="on"{% endif %} data-tab-for=".recent"><a href="{{ path('user_articles_recent') }}">Recent</a></li>
				<li {% if block('kb_popular')|trim|length %}class="on"{% endif %} data-tab-for=".popular"><a href="{{ path('user_articles_popular') }}">Popular</a></li>
			</ul>
		</div>
		<h2><a href="{{ path('user_articles') }}">{{ title|default('Knowledgebase') }}</a></h2>
	</div>

	<div class="tab-contents">
		<div class="{% if block('kb_browse')|trim|length %}class="on"{% endif %} browse tab-content">{% block kb_browse %}{% endblock %}</div>
		<div class="{% if block('kb_find')|trim|length %}class="on"{% endif %} find tab-content">{% block kb_find %}{% endblock %}</div>
		<div class="{% if block('kb_recent')|trim|length %}class="on"{% endif %} recent tab-content">{% block kb_recent %}{% endblock %}</div>
		<div class="{% if block('kb_popular')|trim|length %}class="on"{% endif %} popular tab-content">{% block kb_popular %}{% endblock %}</div>
	</div>
</div>
{% endblock %}