<ul class="dp-browse-list">
	{% for cat in categories %}
		{% if loop.index0 != 0 and loop.index0 % 2 == 0 %}</ul><ul class="dp-browse-list">{% endif %}
		<li>
			<h3><a href="{{ path('user_articles', {'slug': cat.url_slug}) }}">{{ cat.title }}</a></h3>
			<ul>
				{% for article in category_articles[cat.id] %}
					<li><a href="{{ path('user_articles_article', {'slug': article.url_slug}) }}">{{ article.title }}</a></li>
				{% endfor %}
			</ul>
			<a href="{{ path('user_articles', {'slug': cat.url_slug}) }}" class="view-more">View all {{ category_counts[cat.id] }} articles</a>
		</li>
	{% endfor %}
</ul>
