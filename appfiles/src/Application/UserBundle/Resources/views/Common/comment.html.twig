<li {% if comment.person.is_agent == 2 %}class="agent"{% endif %}>
	<div class="avatar" style="background-image: url('{{ path('serve_default_picture', {'s': 30}) }}');"></div>
	<div class="post">
		<div class="byline">
			<span class="time">{{ comment.date_created|date('M j, Y') }}</span>
			<cite>{{ comment.getUserName() }}</cite>
		</div>
		<div class="message">
			{{ comment.content_html|raw }}
		</div>
	</div>
</li>
