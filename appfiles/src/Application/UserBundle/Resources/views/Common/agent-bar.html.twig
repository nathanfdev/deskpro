<div id="agent_bar">
	<div id="header-top">
		<div class="wrapper">
			<div class="left box-header current-user">
				<div class="wrapper-top-bar">
					<div class="current-user-avatar">
						<img src="{{ app.user.getPictureUrl(16) }}" alt="" />
					</div>
					<div class="current-user-name">
						<span>{{ app.user.display_name }}</span>
					</div>
					<span class="white-drop"></span>

				</div>

				<div class="wrap-dropdown user-drop">
					<ul>
						<li class="ticket-noti"><a id="user_settings_link">Settings</a></li>
						<li class="ticket-noti"><a href="">Set status: away</a></li>
						<li class="ticket-noti"><a href="{{ path('agent_logout') }}">Log Out</a></li>
					</ul>
				</div>
			</div>
			
			{# notifications start #}
			<div class="left box-header notifications" id="notifications_wrap" data-menu-handler="DeskPRO.Agent.WindowElement.MainMenu.Notifications" style="display:none">
				<ul class="noti-menu">
					<li style="display:none"><div class="counter"><span class="counter" id="tickets_counter">0</span></div><span class="icn-bar tickets">Tickets</span></li>
					<li style="display:none"><div class="counter"><span class="counter" id="chats_counter">0</span></div><span class="icn-bar chat">Chat</span></li>
				</ul>
				<span class="white-drop"></span>

				<div class="wrap-dropdown noti-drop">
					<ul id="notifications_list">
					</ul>
					<div class="bot-noti">
						<a class="mark-all-read">Mark all as read</a>
					</div>
				</div>
			</div>
			{# notifications end #}

			<div class="right box-header admin-actions">
				<div class="wrapper-top-bar">
					<ul>
						<li class="admin"><a href="{{ path('admin') }}" target="_blank">Admin</a></li>
						<li class="agent"><a href="{{ path('agent') }}" target="_blank">Admin</a></li>
						<li class="billing"><a href="">Billing</a></li>
						<li class="reports"><a href="">Reports</a></li>
					</ul>
				</div>
			</div>

		</div>
	</div>
</div>