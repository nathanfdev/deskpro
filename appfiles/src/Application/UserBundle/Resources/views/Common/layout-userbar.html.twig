<div id="dp_userbar">
	{% if app.user.is_guest %}
		Welcome back, guest &middot;
		<a href="{{ path('user_login') }}" id="dp_login_link">Log In</a> &middot; <a href="{{ path('user_register') }}">Sign Up</a>
	{% else %}
		Welcome back, {{ app.user.display_name }} &middot;
		{% if app.user.HelpdeskUser.ticket_count %}
			<a href="{{ path('user_tickets') }}">View my {{ app.user.HelpdeskUser.ticket_count }} Tickets</a> &middot;
		{% endif %}
		<a href="{{ path('user_profile') }}">Edit My Profile</a> &middot;
		<a href="{{ path('user_logout', {'auth': security_token('user_logout') }) }}">Log Out</a>
	{% endif %}
</div>
