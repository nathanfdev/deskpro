<div id="dp_inline_login_row" class="dp-inline-login dp-inline-login-email {% if login_error %}open{% endif %}">
	{% if app.user.is_guest %}
		{% if login_error %}
		<div class="alert-message error dp-inline-login-err">
			The email address or password you entered is invalid. Please try again or <a href="{{ path('user_login_resetpass') }}">click here</a> if you have lost your password.
		</div>
		{% endif %}

		<div class="dp-form-row {% if error_fields[form_key_prefix ~ 'email'] %}dp-error{% endif %}">
			<div class="dp-form-label">
				<label>Your Email Address *</label> <em class="desc">If you are a registered user, please <a href="{{ path('user_login') }}" class="dp-inline-login-open">log in</a>.</em>
			</div>
			<div class="dp-form-input">
				<input type="text" id="dp_inline_login_email" name="{{ email_form_name }}" value="{{ initial_value }}" />
				{% if error_fields[form_key_prefix~'email'] %}
					<div class="dp-error-explain">
						Enter a valid email address
					</div>
				{% endif %}
			</div>
		</div>

		<div class="dp-form-row dp-inline-login-pass">
			<div class="dp-form-label">
				<label>Password</label>
			</div>
			<div class="dp-form-input">
				<input type="password" id="dp_inline_login_pass" />
				<div class="dp-loading">
					Logging in...
				</div>
				<div class="dp-btn-row">
					<button class="btn primary dp-login-trigger">Log In</button>
					<button class="btn dp-inline-login-open">Cancel</button>
				</div>
			</div>
		</div>
	{% else %}
		<div class="dp-form-row">
			<div class="dp-form-label">
				<label>Your Email Address</label></em>
			</div>
			<div class="dp-form-input">
				{{ app.user.primary_email_address }}
				<input type="hidden" id="dp_inline_login_email" name="{{ email_form_name }}" value="{{ app.user.primary_email_address }}" />
			</div>
		</div>
	{% endif %}
</div>
