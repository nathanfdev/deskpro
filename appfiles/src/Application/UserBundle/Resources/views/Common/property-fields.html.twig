{% macro form_department_select(form_name, departments_hierarchy, selected_id) %}
	{{ _self.form_hierarchy_select(form_name, departments_hierarchy, selected_id) }}
{% endmacro %}
{% macro form_category_select(form_name, categories_hierarchy, selected_id) %}
	{{ _self.form_hierarchy_select(form_name, categories_hierarchy, selected_id) }}
{% endmacro %}
{% macro form_hierarchy_select(form_name, options_hierarchy, selected_id) %}
	<select name="{{form_name}}">
		<option value=""></option>
		{% for opt in options_hierarchy %}
			{% if opt.children %}
				<optgroup label="{{opt.title}}">
			{% else %}
				<option value="{{opt.id}}" {% if opt.id == selected_id %}selected="selected"{% endif %}>{{opt.title}}</option>
			{% endif %}
			{% if opt.children %}
				{% for subopt in opt.children %}
					<option value="{{subopt.id}}" {% if subopt.id == selected_id %}selected="selected"{% endif %}>{{subopt.title}}</option>
				{% endfor %}
			{% endif %}
			{% if opt.children %}
				</optgroup>
			{% endif %}
		{% endfor %}
	</select>
{% endmacro %}