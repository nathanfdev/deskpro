<!-- DeskPRO Chat Loader -->
<script type="text/javascript">
var DpChat_Options = DpChat_Options || {};
DpChat_Options.staticUrl = '{{ asset_url('') }}';
DpChat_Options.deskproUrl = '{{ url('user') }}';
DpChat_Options.protocol = ('https:' == document.location.protocol ? 'https' : 'http');
{% if constant('DP_DEBUG') %}var DpChat_EnableDebug = true;{% endif %}

(function() {
	var scr = document.createElement('script');
	scr.src = '{{ asset('javascripts/DeskPRO/User/Chat/DpChat.js') }}';
	scr.setAttribute('async', 'true');
	document.documentElement.firstChild.appendChild(scr);
})();
</script>
<!-- /DeskPRO Chat Loader -->
