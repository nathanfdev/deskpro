{% set breadcrumb %}{% block breadcrumb %}{% endblock %}{% endset %}
{% if not breadcrumb|trim|length %}{% set breadcrumb = false %}{% endif %}
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
<head>
	<link rel="shortcut icon" href="{{ path('favicon', {}, true) }}" />
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
	<title>{% block page_title %}{{ app.getSetting('core.deskpro_name') }}{% endblock %}</title>

	{{ html_js_pack('user.vendors') }}
	{{ html_js_pack('user.common') }}

	<link rel="stylesheet" href="{{ asset('javascripts/DeskPRO/UI/ui.css') }}" type="text/css" media="screen, projection">
	<link rel="stylesheet" href="{{ asset('stylesheets/user/main.css') }}" type="text/css" media="screen, projection">

	<script type="text/javascript">
		var BASE_URL = '{{ path('user') }}';
		var ASSETS_BASE_URL = '{{ asset('') }}';
		var DESKPRO_PERSON_ID = {{ app.user.id|default(0) }};
	</script>
	<script type="text/javascript">
		window.DeskPRO_Window = new DeskPRO.User.Window();
		$(document).ready(function() {
			window.DeskPRO_Window.initPage();
		});
	</script>

	<meta property="og:site_name" content="{{ app.getSetting('core.site_name')|default(app.getSetting('core.core.helpdesk_name')) }}" />
	{% if app.getSetting('core.facebook_admins') %}<meta property="fb:admins" content="{{ app.getSetting('core.facebook_admins') }}" />{% endif %}

	{{ portal_css(['sidebar', 'pagetop']) }}
	{{ portal_js(['sidebar', 'pagetop']) }}

	{% block head %}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}{% if breadcrumb %}dp-with-breadcrumb{% endif %}">

<div id="dp_header">
	<h1><a href="{{ path('user') }}">{{ app.getSetting('core.deskpro_name') }}</a></h1>
	<h2>{{ app.getSetting('core.deskpro_tagline') }}</h2>
</div>

<div id="dp_search_assist" style="display: none;">
	<div class="results"></div>
	<div class="foot">
		<h4>Did not find what you were looking for?</h4>
		<ul>
			<li class="ticket"><a href="{{ path('user_tickets_new') }}">Create Ticket</a></li>
			<li class="idea"><a href="{{ path('user_ideas_newidea') }}">Create Idea</a></li>
			<li class="chat dp-chat-trigger no-omni-trigger"><a href="#">Chat Live</a></li>
		</ul>
		<br class="dp-clear" style="clear:left" />
	</div>
</div>

{% if app.user.is_guest %}
<div id="dp_login_box_title"><a href="{{ path('user_login') }}">Log In</a></div>
<div id="dp_login_box" class="with-handler" data-element-handler="DeskPRO.User.ElementHandler.LoginBox">
	<form action="{{ path('user_login_authenticate_local') }}" class="form login" method="post">
		<div class="dp-login-box-inner">
			<dl>
				<dt>Email</dt>
				<dd><input type="text" value="" name="email" id="dp_login_email" size="40" tabindex="1" /></dd>
			</dl>
			<div class="dp-login-section">
				<dl>
					<dt>Password <em class="forgot"><a href="{{ path('user_login_resetpass') }}">lost?</a></em></dt>
					<dd><input type="password" value="" name="password" id="dp_login_password" size="40" tabindex="2" /></dd>
				</dl>
				<div style="float:right">
					{% for usersource in app.usersources %}
						{% if usersource.isCapable('button') %}
							{{ render_usersource(usersource, 'button', {'button_type': 'icon'}) }}
						{% endif %}
					{% endfor %}
				</div>
				<input class="btn" type="submit" value="Log In" />
			</div>
			<div class="dp-reset-section" style="display: none">
				<div class="dp-reset-desc">
					Forgot your password? Fill in your email address above, and then
					click the button below.
					<br />
					<div class="dp-btn-row">
						<div class="not-loading">
							<button class="btn small dp-do-send">Send Reset Instructions</button>
							<br /><a class="back">or go back to the login form</a>
						</div>
						<div class="is-loading">
							Please Wait
						</div>
					</div>
				</div>
				<div class="dp-reset-sent" style="display: none">
					If we have an account with this email address, then we have sent you
					instructions on how to reset your password.

					<center><br /><br /><a class="back">Go back to the login form</a></center>
				</div>
			</div>
		</div>
	</form>
</div>
{% endif %}

<div id="dp_page">
	<div id="dp_header_bar">
		{% include 'UserBundle:Common:layout-userbar.html.twig' %}
		<div id="dp_search_bar" class="with-handler" data-element-handler="DeskPRO.User.ElementHandler.OmniSearch">
			<form action="{{ path('user_search') }}" method="GET">
				<input type="text" id="deskpro_search" {% if app.search_query %}value="{{ app.search_query }}"{% endif %} placeholder="Enter a question, keyword or topic..." autocomplete="off" />
				<button class="btn primary">Search</button>
			</form>
		</div>
	</div>

	<div id="dp_sidebar">
		{% block sidebar %}
			{{ portal_section('sidebar') }}
		{% endblock %}
	</div>

	{% if breadcrumb %}
		<div id="dp_breadcrumb">
			<ul>
				<li><a href="{{ path('user') }}">Helpdesk</a></li>
				{{ breadcrumb }}
			</ul>
		</div>
	{% endif %}

	<div id="dp_content">
		{% if app.session.hasFlash('new_ticket') %}
			<div class="dp-content-block">
				<div class="dp-box">
					<div class="dp-box-content-wrapper">
						<div class="dp-box-content">
							<div class="alert-message block-message success">
								<p>Your ticket has been created successfully.</p>
								{% if app.session.hasFlash('new_ticket_validating_email') %}
									<p>
										<strong class="warn">Note:</strong> Since this is your first time submitting
										 a ticket from {{ app.session.flash('new_ticket_validating_email') }}, you must
										 validate your email address before our agents will respond. Check your email now
										 and click the validation link we sent you.
									 </p>
								{% elseif app.session.hasFlash('new_ticket_email') %}
									<p>Our agents will respond to your email address at {{ app.session.flash('new_ticket_email') }}.</p>
								{% endif %}
							</div>
						</div>
					</div>
				</div>
			</div>
		{% endif %}

		{% block content %}{% endblock %}
	</div>

	<div id="dp_footer">
		Powered by <a href="http://www.deskpro.com/">DeskPRO</a> customer service platform
	</div>
</div>

{% if false and not app.getSetting('user.disable_chat_element') %}
	{% include 'UserBundle:Common:chat-loader.html.twig' %}
{% endif %}
</body>
</html>
