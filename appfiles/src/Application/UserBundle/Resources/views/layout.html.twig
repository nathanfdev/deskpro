<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
<head>
	<link rel="shortcut icon" href="{{ path('favicon', {}, true) }}" />
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
	<title>DeskPRO</title>

	{% include 'UserBundle:Common:resources.html.twig' %}

	<script type="text/javascript">
		window.DeskPRO_Window = new DeskPRO.User.Window();
		$(document).ready(function() {
			window.DeskPRO_Window.initPage();
		});
	</script>

	<meta property="og:site_name" content="{{ app.getSetting('core.core.site_name')|default(app.getSetting('core.core.helpdesk_name'))}}" />
	{% if app.getSetting('core.facebook_admins') %}<meta property="fb:admins" content="{{app.getSetting('core.facebook_admins')}}" />{% endif %}

	{% block head %}{% endblock %}
</head>
<body>
{% if app.user.is_agent %}
	{% include 'UserBundle:Common:agent-bar.html.twig' %}
{% endif %}
<div id="container">
	<div id="topnav">
		<ul style="float:right; padding-right: 8px;">
			{% if app.user.id %}
				<li>Welcome, <a href="{{ path('user_profile') }}">{{app.user.display_name}}</a> &middot; <a href="{{ path('user_logout') }}">Log Out</a></li>
			{% else %}
				<li>Welcome, Guest &middot; <a href="{{ path('user_login') }}">Log In</a></li>
			{% endif %}
		</ul>
		<ul>
			<li class="btn"><a href="{{ path('user') }}">Home</a></li>
			<li class="btn"><a href="{{ path('user_search') }}">Search</a></li>
			<li class="btn"><a href="{{ path('user_articles') }}">Articles</a></li>
			<li class="btn"><a href="{{ path('user_downloads') }}">Downloads</a></li>
			<li class="btn"><a href="{{ path('user_news') }}">News</a></li>
			<li class="btn"><a href="{{ path('user_ideas') }}">Ideas</a></li>
			{% if app.user.id %}
				<li class="btn"><a href="{{ path('user_tickets') }}">Tickets</a></li>
			{% endif %}
		</ul>
	</div>
	<div id="page">{% block content %}{% endblock %}</div>
</div>

{% include 'UserBundle:Common:chat-loader.html.twig' %}
</body>
</html>