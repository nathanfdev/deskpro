{% extends 'UserBundle::layout.html.twig' %}
{% block content %}

<div style="background-color: #f8f8f8; border: 2px solid #ccc; padding: 10px; margin-bottom: 15px;">
		<h1 style="font-size: 18px">Thank you</h1>
		<p>
			Thank you for submitting your ticket! You should get a confirmation email shortly.
		</p>

		{% if ticket.hidden_status == 'validating' %}
			<p>
				<strong style="color:#B31010">Important</strong>! Before your ticket will be read by
				our agents, you need to validate your email address. Check your email ({{ticket.person_email.email}})
				for our confirmation link.
			</p>
		{% endif %}
	</div>
{% endblock %}