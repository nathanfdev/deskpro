{% extends 'UserBundle::layout.html.twig' %}
{% import "UserBundle:Common:property-fields.html.twig" as property_fields %}
{% block head %}
<script type="text/javascript" src="{{ path('data_interface_data', {'types': ['tickets']}) }}"></script>
<script src="{{ asset('javascripts/DeskPRO/User/ElementHandler/NewTicket.js') }}"></script>
{% endblock %}
{% block breadcrumb %}
	{% if is_user_loggedin() %}
		<li><a href="{{ path('user_tickets') }}">Your Tickets</a></li>
		<li><a href="{{ path('user_tickets_new') }}">New Ticket</a></li>
	{% else %}
		<li><a href="{{ path('user_tickets_new') }}">New Ticket</a></li>
	{% endif %}
{% endblock %}
{% block content %}
<div class="new-ticket with-handler" data-element-handler="DeskPRO.User.ElementHandler.NewTicket">

<div class="page-title">
	<h1>Submit a ticket</h1>
</div>

<form action="{{ path('user_tickets_new') }}" method="post">
<input type="hidden" name="process" value="1" />

<div class="input-form">
<table cellspacing="0" cellpadding="0" width="100%">
	<tr>
		<td>Name</td>
		<td>
			{{ form_widget(form.person.name) }}
		</td>
	</tr>

	{% if form.person.email %}
		<tr>
			<td>Email Address</td>
			<td>
				{{ form_widget(form.person.email) }}
			</td>
		</tr>
	{% endif %}

	<tr>
		<td width="160">Subject</td>
		<td>
			{{ form_widget(form.ticket.subject) }}
		</td>
	</tr>

	<tr>
		<td>Department</td>
		<td>
			{{ property_fields.form_department_select('newticket[ticket][department_id]', ticket_options.departments_hierarchy, ticket.department_id, 'department_id') }}
		</td>
	</tr>
	<tr>
		<td>{{ phrase('core_tickets.category') }}</td>
		<td id="category_select_wrap">
			{{ property_fields.form_category_select('newticket[ticket][category_id]', ticket_options.ticket_categories_hierarchy, ticket.category_id, 'category_id') }}
		</td>
	</tr>
	{% if form.ticket.product_id %}
	<tr>
		<td>{{ phrase('core.product') }}</td>
		<td>
			{{ form_widget(form.ticket.product_id, {'class': 'product_id'}) }}
		</td>
	</tr>
	{% endif %}
	{% if form.ticket.priority_id %}
	<tr>
		<td>{{ phrase('core_tickets.priority') }}</td>
		<td>
			{{ form_widget(form.ticket.priority_id, {'class': 'priority_id'}) }}
		</td>
	</tr>
	{% endif %}

	<tr>
		<td style="vertical-align: top; padding-top: 8px;">Message</td>
		<td>
			{{ form_widget(form.ticket.message) }}
		</td>
	</tr>

	<tr class="foot">
		<td colspan="2">
			<button class="dp-button">Submit</button>
		</td>
	</tr>
</table>
</div>

{{ form_rest(form) }}
</form>

</div>
{% endblock %}