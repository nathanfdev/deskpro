{% extends 'UserBundle::layout.html.twig' %}
{% import "UserBundle:Common:property-fields.html.twig" as property_fields %}
{% block head %}
<script type="text/javascript">
var ticketReader = {
	getCategoryId: function() {
		var cat = $('select.category_id');
		var catId = cat.val();

		var subCat = $('.sub-options-category_id.sub-options-' + catId);
		if (subCat.length) {
			var subCatId = $('select', subCat).val();
			return parseInt(subCatId) || 0;
		}

		return parseInt(catId) || 0;
	},
	getPriorityId: function() {
		var cat = $('select.priority_id');
		var catId = cat.val();

		var subCat = $('.sub-options-priority_id.sub-options-' + catId);
		if (subCat.length) {
			var subCatId = $('select', subCat).val();
			return parseInt(subCatId) || 0;
		}

		return parseInt(catId) || 0;
	},
	getProductId: function() {
		var cat = $('select.product_id');
		var catId = cat.val();

		var subCat = $('.sub-options-product_id.sub-options-' + catId);
		if (subCat.length) {
			var subCatId = $('select', subCat).val();
			return parseInt(subCatId) || 0;
		}

		return parseInt(catId) || 0;
	},
	getOrganizationId: function() {
		return {{ app.user.organization.id|default(0) }};
	},
	getWorkflow: function() {
		return 0;
	}
};
</script>
<script type="text/javascript">
{{ ticket_display_js|raw }}
</script>
<script src="{{ asset('javascripts/DeskPRO/User/ElementHandler/NewTicket.js') }}"></script>
{% endblock %}
{% block breadcrumb %}
	{% if is_user_loggedin() %}
		<li><a href="{{ path('user_tickets') }}">Your Tickets</a></li>
		<li><a href="{{ path('user_tickets_new') }}">New Ticket</a></li>
	{% else %}
		<li><a href="{{ path('user_tickets_new') }}">New Ticket</a></li>
	{% endif %}
{% endblock %}
{% block content %}

{% if not set_dep_id %}<div class="without-js">{% include 'UserBundle:NewTicket:new-ticket-nojs-preform.html.twig' %}</div>{% endif %}

<div
	class="dp-content-block dp-newticket-page with-handler {% if not set_dep_id %}require-js{% endif %}"
	data-element-handler="DeskPRO.User.ElementHandler.NewTicket"
	data-suggestions-url="{{ path('user_search_similarto', {'content_type': 'article'}) }}"
>
	<div class="dp-box">
		<div class="dp-box-header">
			<h1>Contact Us</h1>
		</div>
		<div class="dp-box-content-wrapper">
			<div class="dp-box-content dp-form">
				{% if errors|length %}
					<div class="alert-message error">
						Oops! There are mistakes with your form. Correct the highlighted feels and then try again.
						<!--
						{{ debug_var(error_fields) }}
						{{ debug_var(errors) }}
						-->
					</div>
				{% endif %}
				<form action="{{ path('user_tickets_new') }}" method="post" id="dp_newticket_form" enctype="multipart/form-data" class="with-form-validator">
				<input type="hidden" name="preticket_status_id" id="dp_newticket_preticket_status_id" value="" />
				<input type="hidden" name="process" value="1" />

				{###############
				 # Email
				 ###############}

				{% include 'UserBundle:Common:form-email-login-row.html.twig' with { 'email_form_name': 'newticket[person][email]', 'form_key_prefix': 'person.', 'initial_value': newticket.person.email, 'mode': 'advanced' } %}


				{###############
				 # Name
				 ###############}
				<div class="dp-form-row {% if error_fields['person.name'] %}dp-error{% endif %}">
					<div class="dp-form-label">
						<label>Your Name *</label>
					</div>
					<div class="dp-form-input">
						{{ form_widget(form.person.name, {
							'attr': {
								'data-field-validators': 'DeskPRO.Form.LengthValidator',
								'data-min-len': 2
							}
						}) }}
						<div class="dp-error-explain">
							Please enter your name
						</div>
					</div>
				</div>

				{#--- FIELDS CONTAINER ---#}
				<div id="fields_container">
					{# First time outputs items in order and visible depending on the page data #}
					{% include 'UserBundle:NewTicket:field-list-loop.html.twig' with {'page_data': default_page_data, 'mode': 'default', 'page_data_field_ids': page_data_field_ids }%}

					{# Second time outputs the remaining order invisible, JS will handle reordering when changing departments #}
					{% include 'UserBundle:NewTicket:field-list-loop.html.twig' with {'page_data': default_page_data, 'mode': 'non_default', 'page_data_field_ids': page_data_field_ids }%}
				</div>
				{#--- FIELDS CONTAINER ---#}

				<div class="dp-related-search" id="dp_newticket_related_container" style="display: none">
					<h4>We found the following content that may answer your question</h4>
					<div class="subline">Don't worry, you can click a title and you will remain on this page.</div>
					<div class="dp-list results">
					</div>
					<div class="more-link" style="display: none;">
						<a>View <span class="count">0</span> more results</a>
					</div>
				</div>

				<div class="dp-footer">
					<input class="btn primary" type="submit" value="Submit" />
				</div>

				</form>
			</div>
		</div>
	</div>

	<script type="text/x-deskpro-plain" class="related-content-overlay-tpl">
		<div class="dp-overlay-outer dp-post-overlay">
		<div class="dp-overlay">
			<div class="dp-overlay-inner">
				<span class="dp-close-btn">close</span>
				<div class="dp-content">
					<span class="dp-open-full"><a>Open full page</a></span>
					<div class="dp-content-holder">
						<div class="dp-loading-msg">Loading</div>
					</div>
					<div class="dp-controls">
						<div class="dp-default dp-control-section">
							<button class="btn small dp-section-toggle primary dp-set-answered" data-toggle-section=".dp-confirm-answered">This answered my question</button>
							<button class="btn small dp-not-answered">This did not answer my question</button>
						</div>
						<div class="dp-confirm-answered dp-control-section" style="display:none">
							<p>We are happy we were able to answer your question. Do you still want to email us?</p>
							<button class="btn small primary dp-answererd" data-type="close">I do not need to contact you anymore</button>
							<button class="btn small dp-answererd" data-type="ticket">I still want to submit a question</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</script>
</div>
{% endblock %}
