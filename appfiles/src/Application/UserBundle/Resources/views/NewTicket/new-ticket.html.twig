{% extends 'UserBundle::layout.html.twig' %}
{% import "UserBundle:Common:property-fields.html.twig" as property_fields %}
{% block head %}
<script type="text/javascript">
{{ ticket_display_js|raw }}
</script>
<script src="{{ asset('javascripts/DeskPRO/User/ElementHandler/NewTicket.js') }}"></script>
{% endblock %}
{% block breadcrumb %}
	{% if is_user_loggedin() %}
		<li><a href="{{ path('user_tickets') }}">Your Tickets</a></li>
		<li><a href="{{ path('user_tickets_new') }}">New Ticket</a></li>
	{% else %}
		<li><a href="{{ path('user_tickets_new') }}">New Ticket</a></li>
	{% endif %}
{% endblock %}
{% block content %}
<div
	class="dp-content-block dp-newticket-page with-handler"
	data-element-handler="DeskPRO.User.ElementHandler.NewTicket"
	data-suggestions-url="{{ path('user_search_similarto', {'content_type': 'article'}) }}"
>
	<div class="dp-box">
		<div class="dp-box-header">
			<h1>Contact Us</h1>
		</div>
		<div class="dp-box-content-wrapper">
			<div class="dp-box-content dp-form">
				<form action="{{ path('user_tickets_new') }}" method="post" id="dp_newticket_form" enctype="multipart/form-data">
				<input type="hidden" name="preticket_status_id" id="dp_newticket_preticket_status_id" value="" />
				<input type="hidden" name="process" value="1" />

				{###############
				 # Email
				 ###############}

				{% include 'UserBundle:NewTicket:user-email.html.twig' %}

				<div class="dp-newticket-non-login">
				{###############
				 # Name
				 ###############}
				<div class="dp-form-row">
					<div class="dp-form-label">
						<label>Your Name *</label>
					</div>
					<div class="dp-form-input">
						{{ form_widget(form.person.name) }}
					</div>
				</div>

				{###############
				 # Department
				 ###############}
				<div class="dp-form-row">
					<div class="dp-form-label">
						<label>{{ phrase('user.department') }} *</label>
					</div>
					<div class="department_id_wrapper with-sub-options dp-form-input">
						<select name="newticket[ticket][department_id]" class="department_id parent-option">
							<option value=""></option>
							{% for id,info in ticket_options.departments_hierarchy %}
								<option value="{{id}}">{{info.title}}</option>
							{% endfor %}
						</select>
						{% for parent_id, parent_info in ticket_options.departments_hierarchy %}
							{% if parent_info.children|length %}
							<div class="dp-sub-options sub-options-department_id sub-options-{{parent_id}}" style="display: none">
								<select class="sub_department_id">
									<option value=""></option>
									{% for id,info in parent_info.children %}
										<option value="{{id}}">{{info.title}}</option>
									{% endfor %}
								</select>
							</div>
							{% endif %}
						{% endfor %}
					</div>
				</div>

				{###############
				 # Category
				 ###############}
				<div class="dp-form-row ticket_category standard-field ticket-display-field" style="display: none">
					<div class="dp-form-label">
						<label>{{ phrase('user.tickets.category') }}</label>
					</div>
					<div class="dp-form-input with-sub-options">
						<select name="newticket[ticket][category_id]" class="parent-option category_id">
							<option value=""></option>
							{% for id,info in ticket_options.ticket_categories_hierarchy %}
								<option value="{{id}}">{{info.title}}</option>
							{% endfor %}
						</select>
						{% for parent_id, parent_info in ticket_options.ticket_categories_hierarchy %}
							{% if parent_info.children|length %}
							<div class="dp-sub-options sub-options-category_id sub-options-{{parent_id}}" style="display: none">
								<select class="sub_category_id">
									<option value=""></option>
									{% for id,info in parent_info.children %}
										<option value="{{id}}">{{info.title}}</option>
									{% endfor %}
								</select>
							</div>
							{% endif %}
						{% endfor %}
					</div>
				</div>

				{###############
				 # Product
				 ###############}
				{% if form.ticket.product_id %}
				<div class="dp-form-row ticket_product standard-field ticket-display-field" style="display: none">
					<div class="dp-form-label">
						<label>{{ phrase('user.product') }}</label>
					</div>
					<div class="dp-form-input with-sub-options">
						<select name="newticket[ticket][product_id]" class="parent-option product_id">
							<option value=""></option>
							{% for id,info in ticket_options.products_hierarchy %}
								<option value="{{id}}">{{info.title}}</option>
							{% endfor %}
						</select>
						{% for parent_id, parent_info in ticket_options.products_hierarchy %}
							{% if parent_info.children|length %}
							<div class="dp-sub-options sub-options-product_id sub-options-{{parent_id}}" style="display: none">
								<select class="sub_product_id">
									<option value=""></option>
									{% for id,info in parent_info.children %}
										<option value="{{id}}">{{info.title}}</option>
									{% endfor %}
								</select>
							</div>
							{% endif %}
						{% endfor %}
					</div>
				</div>
				{% endif %}

				{###############
				 # Priority
				 ###############}
				{% if form.ticket.priority_id %}
				<div class="dp-form-row ticket_priority standard-field ticket-display-field" style="display: none">
					<div class="dp-form-label">
						<label>{{ phrase('user.tickets.priority') }}</label>
					</div>
					<div class="dp-form-input">
						{{ form_widget(form.ticket.priority_id, {'class': 'priority_id'}) }}
					</div>
				</div>
				{% endif %}

				{###############
				 # Custom Fields
				 ###############}

				{% for f in custom_fields %}
					<div class="dp-form-row custom-field ticket_field_{{f.id}} ticket-display-field" style="display: none">
						<div class="dp-form-label">
							<label>{{f.title}}</label>
						</div>
						<div class="dp-form-input">{{ render_custom_field_form(f) }}</div>
					</div>
				{% endfor %}

				{###############
				 # Subject
				 ###############}
				<div class="dp-form-row">
					<div class="dp-form-label">
						<label>{{ phrase('user.tickets.subject') }} *</label>
					</div>
					<div class="dp-form-input">
						{{ form_widget(form.ticket.subject) }}
					</div>
				</div>

				<div class="dp-related-search" id="dp_newticket_related_container" style="display: none">
					<h4>We found the following content that may answer your question</h4>
					<div class="subline">Don't worry, you can click a title and you will remain on this page.</div>
					<div class="dp-list results">
					</div>
					<div class="more-link" style="display: none;">
						<a>View <span class="count">0</span> more results</a>
					</div>
				</div>

				<div class="dp-form-row">
					<div class="dp-form-label">
						<label>What is your question?</label>
					</div>
					<div class="dp-form-input">
						<textarea class="dp-message" id="newticket_ticket_message" name="newticket[ticket][message]"></textarea>
					</div>
				</div>
				<div class="dp-form-row">
					<div class="dp-form-label">
						<label>Attachments</label> <em class="desc">You may upload an attachment less than 5 MB</em>
					</div>
					<div class="dp-form-input">
						<input type="file" />
					</div>
				</div>

				<div class="dp-footer">
					<input class="btn primary" type="submit" value="Submit" />
				</div>

				</div> {# /dp-newticket-non-login #}
				</form>
			</div>
		</div>
	</div>
</div>

<script type="text/x-deskpro-plain" id="dp_related_overlay_tpl">
	<div class="dp-overlay-outer dp-post-overlay">
	<div class="dp-overlay">
		<div class="dp-overlay-inner">
			<span class="dp-close-btn">close</span>
			<div class="dp-content">
				<span class="dp-open-full"><a>Open full page</a></span>
				<div class="dp-content-holder">
					<div class="dp-loading-msg">Loading</div>
				</div>
				<div class="dp-controls">
					<div class="dp-default dp-control-section">
						<button class="btn small dp-section-toggle primary dp-set-answered" data-toggle-section=".dp-confirm-answered">This answered my question</button>
						<button class="btn small dp-not-answered">This did not answer my question</button>
					</div>
					<div class="dp-confirm-answered dp-control-section" style="display:none">
						<p>We are happy we were able to answer your question. Do you still want to email us?</p>
						<button class="btn small primary dp-answererd" data-type="close">I do not need to contact you anymore</button>
						<button class="btn small dp-answererd" data-type="ticket">I still want to submit a question</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</script>
{% endblock %}
