{% extends 'UserBundle::layout.html.twig' %}
{% import "UserBundle:Common:property-fields.html.twig" as property_fields %}
{% block head %}
<script type="text/javascript">
{{ ticket_display_js|raw }}
</script>
<script src="{{ asset('javascripts/DeskPRO/User/ElementHandler/NewTicket.js') }}"></script>
{% endblock %}
{% block breadcrumb %}
	{% if is_user_loggedin() %}
		<li><a href="{{ path('user_tickets') }}">Your Tickets</a></li>
		<li><a href="{{ path('user_tickets_new') }}">New Ticket</a></li>
	{% else %}
		<li><a href="{{ path('user_tickets_new') }}">New Ticket</a></li>
	{% endif %}
{% endblock %}
{% block content %}
<div class="new-ticket with-handler" data-element-handler="DeskPRO.User.ElementHandler.NewTicket">

<div class="page-title">
	<h1>Submit a ticket</h1>
</div>

<form action="{{ path('user_tickets_new') }}" method="post">
<input type="hidden" name="process" value="1" />

<div class="input-form">
<table cellspacing="0" cellpadding="0" width="100%">
	<tr>
		<td width="160">Name</td>
		<td>
			{{ form_widget(form.person.name) }}
		</td>
	</tr>

	{% if form.person.email %}
		<tr>
			<td>Email Address</td>
			<td>
				{{ form_widget(form.person.email) }}
			</td>
		</tr>
	{% endif %}

	<tr>
		<td>Subject</td>
		<td>
			{{ form_widget(form.ticket.subject) }}
		</td>
	</tr>

	<tr>
		<td>Department</td>
		<td>
			<select name="newticket[ticket][department_id]" class="department_id">
				<option value=""></option>
				{% for id,info in ticket_options.departments_hierarchy %}
					<option value="{{id}}">{{info.title}}</option>
				{% endfor %}
			</select>
			{% for parent_id, parent_info in ticket_options.departments_hierarchy %}
				{% if parent_info.children|length %}
				<div class="sub-options sub-options-department_id sub-options-{{parent_id}}" style="display: none">
					<select name="newticket[ticket][department_id]" class="sub_department_id">
						<option value=""></option>
						{% for id,info in parent_info.children %}
							<option value="{{id}}">{{info.title}}</option>
						{% endfor %}
					</select>
				</div>
				{% endif %}
			{% endfor %}
		</td>
	</tr>

	<tr class="ticket_category standard-field ticket-display-field" style="display: none">
		<td>{{ phrase('core_tickets.category') }}</td>
		<td id="category_select_wrap" class="with-sub-options">
			<select name="newticket[ticket][category_id]" class="parent-option category_id">
				<option value=""></option>
				{% for id,info in ticket_options.ticket_categories_hierarchy %}
					<option value="{{id}}">{{info.title}}</option>
				{% endfor %}
			</select>
			{% for parent_id, parent_info in ticket_options.ticket_categories_hierarchy %}
				{% if parent_info.children|length %}
				<div class="sub-options sub-options-category_id sub-options-{{parent_id}}" style="display: none">
					<select name="newticket[ticket][category_id]" class="sub_category_id">
						<option value=""></option>
						{% for id,info in parent_info.children %}
							<option value="{{id}}">{{info.title}}</option>
						{% endfor %}
					</select>
				</div>
				{% endif %}
			{% endfor %}
		</td>
	</tr>
	{% if form.ticket.product_id %}
	<tr class="ticket_product standard-field ticket-display-field" style="display: none">
		<td>{{ phrase('core.product') }}</td>
		<td class="with-sub-options">
			<select name="newticket[ticket][product_id]" class="parent-option product_id">
				<option value=""></option>
				{% for id,info in ticket_options.products_hierarchy %}
					<option value="{{id}}">{{info.title}}</option>
				{% endfor %}
			</select>
			{% for parent_id, parent_info in ticket_options.products_hierarchy %}
				{% if parent_info.children|length %}
				<div class="sub-options sub-options-product_id sub-options-{{parent_id}}" style="display: none">
					<select name="newticket[ticket][product_id]" class="sub_product_id">
						<option value=""></option>
						{% for id,info in parent_info.children %}
							<option value="{{id}}">{{info.title}}</option>
						{% endfor %}
					</select>
				</div>
				{% endif %}
			{% endfor %}
		</td>
	</tr>
	{% endif %}
	{% if form.ticket.priority_id %}
	<tr class="ticket_priority standard-field ticket-display-field" style="display: none">
		<td>{{ phrase('core_tickets.priority') }}</td>
		<td>
			{{ form_widget(form.ticket.priority_id, {'class': 'priority_id'}) }}
		</td>
	</tr>
	{% endif %}
	{% for f in custom_fields %}
		<tr class="custom-field ticket_field_{{f.id}} ticket-display-field" style="display: none">
			<td>{{f.title}}</td>
			<td>{{ render_custom_field_form(f) }}</td>
		</tr>
	{% endfor %}

	<tr>
		<td style="vertical-align: top; padding-top: 8px;">Message</td>
		<td>
			{{ form_widget(form.ticket.message) }}
		</td>
	</tr>

	<tr class="foot">
		<td colspan="2">
			<button class="dp-button">Submit</button>
		</td>
	</tr>
</table>
</div>

{{ form_rest(form) }}
</form>

</div>
{% endblock %}