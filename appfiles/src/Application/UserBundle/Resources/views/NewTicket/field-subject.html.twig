<div class="dp-form-row {% if error_fields['ticket.subject'] %}dp-error{% endif %}">
	<div class="dp-form-label">
		<label>{{ phrase('user.tickets.subject') }} *</label>
	</div>
	<div class="dp-form-input">
		{{ form_widget(form.ticket.subject, {
			'attr': {
				'data-field-validators': 'DeskPRO.Form.LengthValidator',
				'data-min-len': 5
			}
		}) }}
		<div class="dp-error-explain">
			Please enter a subject of at least 5 characters
		</div>
	</div>
</div>
