var DpNewTicket_Controller = {
	init: function() {
		document.getElementById(DpNewTicket_Options.intoElement).innerHTML = '<iframe id="dp_newticket_iframe" width="100%" allowTransparency="true" border="0" frameborder="0" marginwidth="0" marginheight="0" scrolling="no" style="border: none; margin: 0; padding: 0; width: 100%; height: '+DpNewTicket_Options.initialHeight+'px; background: transparent; overflow: hidden;"></iframe>';
		document.getElementById(DpNewTicket_Options.intoElement).style.display = 'block';

		this.iframe = document.getElementById('dp_newticket_iframe');
		this.iframe.src = '{{ app.request.getUriForPath('') }}/tickets/new-simple{% if set_dep_id %}/{{ set_dep_id }}{% endif %}';
	},
	bindFn: function(fn, context) {
		return function() {
			var args = Array.prototype.slice.call(arguments, 1);
			return fn.apply(context, args);
		};
	},
	acceptMessage: function(id, data) {
		switch(id) {
			case 'height':
				this.setHeight(data);
				break;
		}
	},
	setHeight: function(h) {
		this.iframe.style.height = h + 'px';
	},
};
DpNewTicket_Controller.init();
