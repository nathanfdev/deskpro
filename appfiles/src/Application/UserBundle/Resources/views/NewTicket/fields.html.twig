{% for item in page_data %}

{% if (mode == 'default' and item.field_type == 'message') or (mode =='non_default' and item.id not in page_data_field_ids) %}
<div data-field-id="message" class="dp-form-row ticket-display-field message {% if error_fields['ticket.message'] %}dp-error{% endif %}" {% if mode == 'non_default' %}style="display: none"{% endif %}>
	<div class="dp-form-label">
		<label>What is your question?</label>
	</div>
	<div class="dp-form-input">
		{{ form_widget(form.ticket.message, {
			'attr': {
				'class': 'dp-message',
				'data-field-validators': 'DeskPRO.Form.LengthValidator',
				'data-min-len': 10
			}
		}) }}
		<div class="dp-error-explain">
			Please enter at least 10 characters
		</div>
	</div>
</div>
{% endif %}

{% if (mode == 'default' and item.field_type == 'attachments') or (mode =='non_default' and item.id not in page_data_field_ids) %}
<div data-field-id="attachments" class="dp-form-row ticket-display-field attachments" {% if mode == 'non_default' %}style="display: none"{% endif %}>
	<div class="dp-form-label">
		<label>Attachments</label> <em class="desc">You may upload an attachment less than 5 MB</em>
	</div>
	<div class="dp-form-input">
		{% include 'UserBundle:Common:form-upload-input.html.twig' %}
	</div>
</div>
{% endif %}

{###############
 # Category
 ###############}
{% if ticket_options.ticket_categories_hierarchy %}
{% if (mode == 'default' and item.field_type == 'ticket_category') or (mode =='non_default' and item.id not in page_data_field_ids) %}
<div data-field-id="ticket_category" class="dp-form-row ticket_category standard-field ticket-display-field {% if error_fields['ticket.category_id'] %}dp-error{% endif %}" {% if mode == 'non_default' %}style="display: none"{% endif %}>
	<div class="dp-form-label">
		<label>{{ phrase('user.tickets.category') }}</label>
	</div>
	<div class="dp-form-input with-sub-options">
		<select name="newticket[ticket][category_id]" class="parent-option category_id">
			<option value=""></option>
			{% for id,info in ticket_options.ticket_categories_hierarchy %}
				<option value="{{id}}">{{info.title}}</option>
			{% endfor %}
		</select>
		{% for parent_id, parent_info in ticket_options.ticket_categories_hierarchy %}
			{% if parent_info.children|length %}
			<div class="dp-sub-options sub-options-category_id sub-options-{{parent_id}}" style="display: none">
				<select class="sub_category_id">
					<option value=""></option>
					{% for id,info in parent_info.children %}
						<option value="{{id}}">{{info.title}}</option>
					{% endfor %}
				</select>
			</div>
			{% endif %}
		{% endfor %}
		<div class="dp-error-explain">
			Please choose a category
		</div>
	</div>
</div>
{% endif %}
{% endif %}

{###############
 # Product
 ###############}
{% if ticket_options.products_hierarchy %}
{% if (mode == 'default' and item.field_type == 'ticket_product') or (mode =='non_default' and item.id not in page_data_field_ids) %}
<div data-field-id="ticket_product" class="dp-form-row ticket_product standard-field ticket-display-field {% if error_fields['ticket.product_id'] %}dp-error{% endif %}" {% if mode == 'non_default' %}style="display: none"{% endif %}>
	<div class="dp-form-label">
		<label>{{ phrase('user.product') }}</label>
	</div>
	<div class="dp-form-input with-sub-options">
		<select name="newticket[ticket][product_id]" class="parent-option product_id">
			<option value=""></option>
			{% for id,info in ticket_options.products_hierarchy %}
				<option value="{{id}}">{{info.title}}</option>
			{% endfor %}
		</select>
		{% for parent_id, parent_info in ticket_options.products_hierarchy %}
			{% if parent_info.children|length %}
			<div class="dp-sub-options sub-options-product_id sub-options-{{parent_id}}" style="display: none">
				<select class="sub_product_id">
					<option value=""></option>
					{% for id,info in parent_info.children %}
						<option value="{{id}}">{{info.title}}</option>
					{% endfor %}
				</select>
			</div>
			{% endif %}
		{% endfor %}
		<div class="dp-error-explain">
			Please choose a product
		</div>
	</div>
</div>
{% endif %}
{% endif %}

{###############
 # Priority
 ###############}
{% if form.ticket.priority_id %}
{% if (mode == 'default' and item.field_type == 'ticket_priority') or (mode =='non_default' and item.id not in page_data_field_ids) %}
<div data-field-id="ticket_priority" class="dp-form-row ticket_priority standard-field ticket-display-field {% if error_fields['ticket.priority_id'] %}dp-error{% endif %}" {% if mode == 'non_default' %}style="display: none"{% endif %}>
	<div class="dp-form-label">
		<label>{{ phrase('user.tickets.priority') }}</label>
	</div>
	<div class="dp-form-input">
		{{ form_widget(form.ticket.priority_id, {'class': 'priority_id'}) }}
		<div class="dp-error-explain">
			Please choose a priority
		</div>
	</div>
</div>
{% endif %}
{% endif %}

{###############
 # Custom Fields
 ###############}

{% for f in custom_fields %}
	{% if (mode == 'default' and item.field_type == 'ticket_field' and item.field_id == f.id) or (mode =='non_default' and item.id not in page_data_field_ids) %}
	<div data-field-id="ticket_field[{{f.id}}]" class="dp-form-row custom-field ticket_field_{{f.id}} ticket-display-field" {% if mode == 'non_default' %}style="display: none"{% endif %}>
		<div class="dp-form-label">
			<label>{{f.title}}</label>
		</div>
		<div class="dp-form-input">{{ render_custom_field_form(f) }}</div>
	</div>
	{% endif %}
{% endfor %}

{% if captcha_html %}
	{% if (mode == 'default' and item.field_type == 'captcha') or (mode =='non_default' and item.id not in page_data_field_ids) %}
	<div data-field-id="captcha" class="dp-form-row ticket-display-field captcha">
		<div class="dp-form-label">
			<label>Please prove you are human!</label>
		</div>
		<div class="dp-form-input">
			{{ captcha_html|raw }}
			<div class="dp-error-explain">
				The code you entered is incorrect.
			</div>
		</div>
	</div>
	{% endif %}
{% endif %}

{% endfor %}
