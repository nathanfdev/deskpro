{% extends 'UserBundle::layout-simple-popup.html.twig' %}
{% block content %}
<div class="dp-content-block dp-ticket-page with-handler" data-element-handler="DeskPRO.User.ElementHandler.TicketView">
	<div class="dp-box">
		<div class="dp-box-header">
			<h4>{{ phrase('user.tickets.feedback_message_title', {'name': message.person.display_name}) }}</h4>
		</div>

		<div class="dp-box-content-wrapper">
			<div class="dp-box-content">
				<form action="{{ path('user_tickets_feedback_save', {'ticket_ref': ticket.ref, 'message_id': message.id}) }}" method="post">
				<div class="dp-form">
					<div class="dp-form-row">
						<div class="dp-form-label">
							<label>{{ phrase('user.tickets.was_reply_helpful') }}</label>
						</div>
						<div class="dp-form-input">
							<label><input type="radio" name="rating" value="1" {% if feedback.rating == 1 %}checked="checked"{% endif %} /> {{ phrase('user.tickets.rate_helpful') }}</label>
							&nbsp;&nbsp;&nbsp;
							<label><input type="radio" name="rating" value="0" {% if feedback.rating == -1 %}checked="checked"{% endif %} /> {{ phrase('user.tickets.rate_unhelpful') }}</label>
						</div>
					</div>

					<div class="dp-form-row">
						<div class="dp-form-label">
							<label>{{ phrase('user.tickets.feedback_message_leave_comment') }}</label>
						</div>
						<div class="dp-form-input">
							<textarea name="message" style="width: 95%; height: 60px;">{{ feedback.message }}</textarea>
						</div>
					</div>

					<input class="btn primary" type="submit" value="{{ phrase('user.tickets.feedback_message_submit_btn') }}" />
				</div>
				</form>
			</div>
		</div>
	</div>
</div>
{% endblock %}
