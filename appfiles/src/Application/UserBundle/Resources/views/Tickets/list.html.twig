{% extends 'UserBundle::layout.html.twig' %}
{% block breadcrumb %}
	<li><a href="{{ path('user_tickets') }}">Tickets</a></li>
{% endblock %}
{% block content %}

{% if active_tickets %}
<div class="dp-content-block dp-ticketlist-page dp-open-tickets">
	<div class="dp-box">
		<div class="dp-box-header">
			<div class="dp-box-options">
				<a class="btn small" href="{{ path('user_tickets_new') }}">New Ticket</a>
			</div>
			<h1>Open Tickets</h1>
		</div>
		<div class="dp-box-content-wrapper">
			<div class="dp-box-content">
				<ul class="dp-ticketlist">
					{% for ticket in active_tickets %}
						<li>
							<h4><a href="{{ path('user_tickets_view', {'ticket_ref': ticket.public_id }) }}">{{ ticket.subject }}</a></h4>
							<ul class="dp-meta">
								<li>{{ ticket.date_created|date('M j Y') }}</li>
								{% if ticket.department %}
									<li>Department: {{ phrase(ticket.department) }}</li>
								{% endif %}
								{% if ticket.agent %}
									<li>Agent: {{ ticket.agent.display_name }}</li>
								{% endif %}
							</ul>
						</li>
					{% endfor %}
				</ul>
			</div>
		</div>
	</div>
</div>
{% endif %}

{% if resolved_tickets %}
<div class="dp-content-block dp-ticketlist-page dp-open-tickets">
	<div class="dp-box">
		<div class="dp-box-header">
			<h1>Closed Tickets</h1>
		</div>
		<div class="dp-box-content-wrapper">
			<div class="dp-box-content">
				<ul class="dp-ticketlist">
					{% for ticket in active_tickets %}
						<li>
							<h4><a href="{{ path('user_tickets_view', {'ticket_ref': ticket.public_id }) }}">{{ ticket.subject }}</a></h4>
							<ul class="dp-meta">
								<li>{{ ticket.date_created|date('M j Y') }}</li>
								<li>Department: {{ phrase(ticket.department) }}</li>
								{% if ticket.agent %}
									<li>Agent: {{ ticket.agent.display_name }}</li>
								{% endif %}
							</ul>
						</li>
					{% endfor %}
				</ul>
			</div>
		</div>
	</div>
</div>
{% endif %}

{% endblock %}
