{% extends 'UserBundle::layout.html.twig' %}
{% block breadcrumb %}
	<li><a href="{{ path('user_tickets') }}">Tickets</a></li>
{% endblock %}
{% block content %}

{% if active_tickets %}
<div class="with-handler" data-element-handler="DeskPRO.User.ElementHandler.TicketList">
<div class="dp-content-block dp-ticketlist-page dp-open-tickets">
	<div class="dp-box">
		<div class="dp-box-header">
			<h1>Open Tickets</h1>
		</div>
		<div class="dp-box-content-wrapper">
			<div class="dp-box-content">
				<ul class="dp-ticketlist">
					{% for ticket in active_tickets %}
						<li>
							<h4><a href="{{ path('user_tickets_view', {'ticket_ref': ticket.public_id }) }}">{{ ticket.subject }}</a></h4>
							<ul class="dp-meta">
								<li>{{ ticket.date_created|date('M j Y') }}</li>
								{% if ticket.department %}
									<li>Department: {{ phrase(ticket.department) }}</li>
								{% endif %}
								{% if last_messages[ticket.id] %}
									<li>
										Last activity by
										{% if last_messages[ticket.id].person.id == app.user.id %}
											you
										{% else %}
											{{ last_messages[ticket.id].person.display_name }}
										{% endif %}
										(<span class="timeago" title="{{ last_messages[ticket.id].date_created|date('c') }}">{{ last_messages[ticket.id].date_created|date('M j Y h:ia') }}</span>)
									</li>
								{% endif %}
								<li>
									<a class="close-ticket-trigger" href="{{ path('user_tickets_close', {'ticket_ref': ticket.public_id, 'back': 'list'}) }}">Close</a>
								</li>
							</ul>
						</li>
					{% endfor %}
				</ul>
			</div>
		</div>
	</div>
</div>
{% endif %}

{% if resolved_tickets %}
<div class="dp-content-block dp-ticketlist-page dp-open-tickets">
	<div class="dp-box">
		<div class="dp-box-header">
			<h1>Closed Tickets</h1>
		</div>
		<div class="dp-box-content-wrapper">
			<div class="dp-box-content">
				<ul class="dp-ticketlist">
					{% for ticket in active_tickets %}
						<li>
							<h4><a href="{{ path('user_tickets_view', {'ticket_ref': ticket.public_id }) }}">{{ ticket.subject }}</a></h4>
							<ul class="dp-meta">
								<li>{{ ticket.date_created|date('M j Y') }}</li>
								<li>Department: {{ phrase(ticket.department) }}</li>
								{% if last_messages[ticket.id] %}
									<li>
										Last activity by {{ last_messages[ticket.id].person.display_name }}
										(<span class="timeago" title="{{ last_messages[ticket.id].date_created|date('c') }}">{{ last_messages[ticket.id].date_created|date('M j Y h:ia') }}</span>)
									</li>
								{% endif %}
							</ul>
						</li>
					{% endfor %}
				</ul>
			</div>
		</div>
	</div>
</div>
{% endif %}

</div>
{% endblock %}
