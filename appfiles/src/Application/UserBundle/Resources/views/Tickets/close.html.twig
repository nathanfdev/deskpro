{% extends 'UserBundle::layout.html.twig' %}
{% block breadcrumb %}
	<li><a href="{{ path('user_tickets') }}">Tickets</a></li>
	<li><a href="{{ path('user_tickets_view', {'ticket_ref': ticket.public_id}) }}">{{ ticket.subject }}</a></li>
{% endblock %}
{% block content %}
<div class="dp-content-block dp-ticket-page with-handler" data-element-handler="DeskPRO.User.ElementHandler.TicketView">
	<div class="dp-box">
		<div class="dp-box-header">
			<h4>Close Ticket: {{ ticket.subject }}</h4>
		</div>

		<div class="dp-box-content-wrapper">
			<div class="dp-box-content">
				<form action="{{ path('user_tickets_close', {'ticket_ref': ticket.ref}) }}" method="post">
				<input type="hidden" name="process" value="1" />
				<div class="dp-box-section">
					<p>
						<strong>Are you sure you want to close your ticket?</strong> Once your ticket is closed,
						our agents will no longer respond and you will not be able to reply. If you need more help
						you will need to open a new ticket.
					</p>

					<center><button class="btn primary">Close my ticket</button></center>
				</div>

				{% if not exist_feedback %}
					<div class="dp-box-section">
						<div class="dp-form">
							<div class="dp-form-row">
								<div class="dp-form-label">
									<label>Optionally take a moment to tell us how we did</label>
								</div>
								<div class="dp-form-input">
									<label><input type="radio" name="rating" value="1" {% if exist_feedback.rating == 1 %}checked="checked"{% endif %} /> Helpful</label>
									&nbsp;&nbsp;&nbsp;
									<label><input type="radio" name="rating" value="0" {% if exist_feedback.rating == -1 %}checked="checked"{% endif %} /> Not Helpful</label>
								</div>
							</div>

							<div class="dp-form-row">
								<div class="dp-form-label">
									<label>Do you have any feedback?</label>
								</div>
								<div class="dp-form-input">
									<textarea name="message" style="width: 95%; height: 60px;">{{ exist_feedback.message }}</textarea>
								</div>
							</div>

							<center><input class="btn primary" type="submit" name="with_feedback" value="Close my tiket and submit my feedback" /></center>
						</div>
					</div>
				{% endif %}
				</form>
			</div>
		</div>
	</div>
</div>
{% endblock %}
