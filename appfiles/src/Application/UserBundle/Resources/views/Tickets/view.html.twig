{% extends 'UserBundle::layout.html.twig' %}
{% block page_title %}
	{{ ticket.subject }} - Your Tickets
{% endblock %}
{% block head %}
<style type="text/css">
ul.attachment-list {
	margin-top: 10px;
	padding-top: 5px;
	border-top: 1px solid #C5CDD4;
	padding-left: 8px;

	background: #FFFFFF; /* old browsers */
	background: -moz-linear-gradient(top, #FFFFFF 0%, #F7F8F9 100%); /* firefox */
	background: -webkit-gradient(linear, left top, left bottom, color-stop(0%,#FFFFFF), color-stop(100%,#F7F8F9)); /* webkit */
	filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#FFFFFF', endColorstr='#F7F8F9',GradientType=0 ); /* ie */
}

ul.attachment-list > li {
	line-height: 18px;
	padding-top: 2px;
	padding-bottom: 2px;
}
ul.attachment-list > li span.size {
	font-size: 7pt;
	color: #5E5E5E;
}

ul.attachment-list > li img.preview {
	text-align: right;
	vertical-align: middle;
	margin-right: 6px;
}

.feedback-link {
	font-size: 10px;
	margin-top: 8px;
	margin-bottom: -8px;
	text-align: right;
}
</style>

<script type="text/javascript">
$(document).ready(function() {
	$('.feedback-link a').click(function(ev) {
		ev.preventDefault();

		window.open(
			$(this).attr('href'),
			'feedback',
			"status=no,toolbar=no,location=no,menubar=no,resizable=no,scrollbars=yes,height=400,width=500"
		);
	});
});
</script>
{% endblock %}
{% block content %}
<div class="dp-content-block dp-ticket-page">
	<div class="dp-box">
		<div class="dp-box-header">
			<h1>{{ ticket.subejct }}</h1>
		</div>
		<div class="dp-box-content-wrapper">
			<div class="dp-box-content">
				{% if ticket.hidden_status == 'validating' %}
					<div style="background-color: #FFF9DE; border: 2px solid #C4BEA3; margin-bottom: 15px; padding: 8px;">
						<strong style="color:#B31010">Important</strong>! You still need to validate your
						email address ({{ticket.person_email.email}}) before your ticket will be read by our agents.
						Check your email now and click on the link.
					</div>
				{% endif %}

				<div class="dp-ticket-info">
					<dl>
						{% if ticket.department %}
							<dt>{{ phrase('user.tickets.department') }}</dt>
							<dd>
								{{ ticket.department.full_title }}
							</dd>
						{% endif %}
					</dl>
				</div>
			</div>
		</div>
	</div>
</div>


