{% extends 'UserBundle::layout.html.twig' %}
{% block content %}

{% if ticket.hidden_status == 'validating' %}
	<div style="background-color: #FFF9DE; border: 2px solid #C4BEA3; margin-bottom: 15px; padding: 8px;">
		<strong style="color:#B31010">Important</strong>! You still need to validate your
		email address ({{ticket.person_email.email}}) before your ticket will be read by our agents.
		Check your email now and click on the link.
	</div>
{% endif %}

<h1 style="border-bottom: 2px solid #ddd; margin-bottom: 10px; padding-bottom: 3px;">{{ ticket.subject }}</h1>

<table cellspacing="5" cellpadding="0" border="0" width="100%"><tr>
	<td>
		<small>{{ phrase('core_tickets.department') }}</small><br />
		{{ phrase(ticket.department) }}
	</td>
	{% if ticket.category %}
	<td>
		<small>{{ phrase('core_tickets.category') }}</small><br />
		{{ phrase(ticket.category) }}
	</td>
	{% endif %}
	{% if ticket.product %}
	<td>
		<small>{{ phrase('core_tickets.product') }}</small><br />
		{{ phrase(ticket.product) }}
	</td>
	{% endif %}
	{% if ticket.priority %}
	<td>
		<small>{{ phrase('core_tickets.priority') }}</small><br />
		{{ phrase(ticket.priority) }}
	</td>
	{% endif %}
	<td>
		<small>{{ phrase('core_tickets.status') }}</small><br />
		{{ phrase('core_tickets.status_' ~ ticket.status) }}
	</td>
	<td>
		<small>{{ phrase('core_tickets.agent') }}</small><br />
		{{ ticket.agent.display_name|default(phrase('core.unassigned')) }}
	</td>
</tr></table>

{% for message in ticket.displayable_messages %}
	<div style="border: 2px solid #ddd; margin-bottom: 15px;">
		<div style="background-color: #ddd;">
			<img src="{{ message.person.getPictureUrl(50) }}" alt="" style="float:left; margin-right: 6px; "/>
			{{ message.person.display_name }}
			<br style="clear:left" />
		</div>
		<div style="padding: 10px">
			{{ message.message_html|raw }}
		</div>
	</div>
{% endfor %}

{% endblock %}