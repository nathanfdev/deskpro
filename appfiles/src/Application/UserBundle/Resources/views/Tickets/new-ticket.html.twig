{% extends 'UserBundle::layout.html.twig' %}
{% import "UserBundle:Common:property-fields.html.twig" as property_fields %}
{% block content %}

<form action="{{ path('user_tickets_new') }}" method="post">
{{ form_hidden(form) }}
<input type="hidden" name="process" value="1" />

<h1>Contact Information</h1>
<table cellspacing="5" cellpadding="0" border="0" width="100%">
	<tr>
		<td>
			<small>First Name</small> {{ form_field(form.person.first_name) }}<br />
			<small>First Name</small> {{ form_field(form.person.last_name) }}<br />
		</td>
	</tr>

	{% if form.email_address %}
		<tr>
			<td>
				<small>Email Address</strong><br />
				{{ form_field(form.email_address) }}
			</td>
		</tr>
	{% endif %}
</tr></table>

<h1>Ticket</h1>
<table cellspacing="5" cellpadding="0" border="0" width="100%"><tr>
	<td>
		<small>Department</small><br />
		{{ property_fields.form_department_select('newticket[ticket][department_id]', ticket_options.departments_hierarchy, ticket.department_id) }}
	</td>
	<td>
		<small>{{ phrase('core_tickets.category') }}</small><br />
		{{ property_fields.form_department_select('newticket[ticket][category_id]', ticket_options.ticket_categories_hierarchy, ticket.category_id) }}
	</td>
	<td>
		<small>{{ phrase('core.product') }}</small><br />
		{{ form_field(form.ticket.product_id) }}
	</td>
	<td>
		<small>{{ phrase('core_tickets.priority') }}</small><br />
		{{ form_field(form.ticket.priority_id) }}
	</td>
</tr></table>

<table cellspacing="5" cellpadding="0" border="0" width="100%">
	{% for f in custom_fields %}
		<tr>
			<td>
				<small>{{ phrase(f.field_def) }}</small><br />
				{{ form_field(f.form, {}, {}, ['UserBundle:Common:custom-field-forms.html.twig']) }}
			</td>
		</tr>
	{% endfor %}
</table>

<div style="margin: 10px 0 10px 0;">
	{{ form_field(form.ticket.subject) }}
	{{ form_field(form.ticket_message) }}
</div>

<input type="submit" value="Submit" />

{% endblock %}