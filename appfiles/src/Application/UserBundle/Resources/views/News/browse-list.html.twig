{% extends 'UserBundle:News:layout.html.twig' %}
{% block breadcrumb %}
	<li><a href="{{ path('user_news') }}">News</a></li>
	{% for cat in category_path %}
		<li><a href="{{ path('user_news', {'slug': cat.url_slug}) }}">{{cat.title}}</a></li>
	{% endfor %}
{% endblock %}
{% block news_list %}
<div class="with-handler"
		data-element-handler="DeskPRO.User.ElementHandler.MoreLoader"
		data-load-url="{{ path('user_news_list', {'page': '00000', 'per_page': per_page})|replace({'00000': '{page}'}) }}"
	>
	<ul class="dp-news-list">
		{% include 'UserBundle:News:browse-news-list.html.twig' %}
	</ul>
	<div class="dp-footer">
		<button class="btn">View all 23 entries</button>
	</div>
</div>
{% endblock %}
