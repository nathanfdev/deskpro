{% extends 'UserBundle:News:layout.html.twig' %}
{% block breadcrumb %}
	<li><a href="{{ path('user_news') }}">News</a></li>
	{% for cat in category_path %}
		<li><a href="{{ path('user_news', {'slug': cat.url_slug}) }}">{{cat.title}}</a></li>
	{% endfor %}
{% endblock %}
{% block news_posts %}
<div class="content-filters">
	Category:
	<select name="category_id" class="category_id" onchange="window.location = $(this).val();">
		<option value="{{ path('user_news') }}">All</option>
		{% for cat in news_cats %}
			<option value="{{ path('user_news', {'slug': news_cat_objs[cat.id].url_slug}) }}" {% if category.id == cat.id %}selected="selected"{% endif %}>{{ '--'|repeat(cat.depth) }}{{ cat.title }}</option>
		{% endfor %}
	</select>
</div>
<div class="content-list">
	<ul>
		{% include 'UserBundle:News:browse-news-posts.html.twig' %}
	</ul>
</div>
{% endblock %}