{% for news in news_entries %}
	<li class="{% if show_more and loop.last %}has-more{% endif %}">
		<div style="float:right">
			<div class="cal-date" title="{{ idea.date_created|date('M d Y @ H:i:s') }}" style="margin-bottom: 4px;">
				<div class="month">{{ idea.date_created|date('M')|upper }}</div>
				<div class="day">{{ idea.date_created|date('d') }}</div>
			</div>
			<div class="info-line">
				<ul>
					<li class="comments" title="Comments" style="width: 46px; text-align: center; display: block; padding: 0;"><span>{{ rand(1, 50) }}</span></li>
				</ul>
			</div>
		</div>
		<h4><a href="{{ path('user_news_view', {'slug': news.url_slug}) }}">{{ news.title }}</a></h4>
		<div class="message">
			{{ news.excerpt_html|raw }}
		</div>
		<div class="more-link"><a href="">Read the rest of this news article {% if news.count_words_after_excerpt > 0 %}({{ news.count_words_after_excerpt}} more words){% endif %} &rarr;</a></div>
	</li>
{% endfor %}