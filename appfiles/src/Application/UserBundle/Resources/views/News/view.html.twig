{% extends 'UserBundle::layout.html.twig' %}
{% block head %}
	<meta property="og:url" content="{{ path('user_news_cat', {'slug': cat.id}) }}" />
	<meta property="og:title" content="{{post.title}}" />
	<meta property="og:type" content="blog" />
{% endblock %}
{% block content %}
<div style="float:left; width: 190px;">
	{% include 'UserBundle:News:category-list.html.twig' %}
</div>

<div style="margin-left:200px;">
	<div style="float:right">
		{{post.date_created|date('Y-m-d')}}
	</div>
	<h4>{{post.title}}</h4>

	{% include 'UserBundle:Common:related-content-side.html.twig' %}
	{{post.content_html|raw}}
</div>

<br style="clear:both" />

{% if facebook_like %}
<div style="margin: 10px;">
	{{facebook_like|raw}}
</div>
{% endif %}

{% if comments_widget %}
	{{comments_widget|raw}}
{% else %}
	<div style="background-color: #eee; padding: 10px; margin-top: 15px;">
		<form action="{{ path('user_news_newcomment', {'post_id': post.id}) }}" method="post">
		Name: <input type="text" name="new_comment[name]" /> (public)<br />
		Email: <input type="text" name="new_comment[email]" /> (private, never revealed)<br />
		<textarea name="new_comment[content]" cols="80" rows="5"></textarea>
		<input type="submit" value="Submit" />
		</form>
		<hr />

		{% for comment in comments %}
			<div style="background-color: #fff; padding: 6px; margin: 10px;">
				<em>{{comment.name}}</em>:<br />
				{{comment.content_html|raw}}
			</div>
		{% endfor %}
	</div>
{% endif %}

{% endblock %}