<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html>
<head>
	<script type="text/javascript">
		var BASE_URL = '{{ path('user') }}';
		var ASSETS_BASE_URL = '{{ asset('') }}';
		var DESKPRO_PERSON_ID = {{ app.user.id|default(0) }};

		{% if constant('DP_DEBUG') %}
			DP_DEBUG = true;
		{% else %}
			DP_DEBUG = false;
		{% endif %}
	</script>

	{% if app.isDebug() %}
		{{ dp_asset_html('user_vendors') }}
		{{ dp_asset_html('user_common') }}
	{% else %}
		{{ dp_asset_html('user') }}
	{% endif %}

	<link id="dp_stylesheet" rel="stylesheet" type="text/css" href="{{ app.request.getBaseUrl() }}/dp/res/user/main.css?{{ app.style.css_updated|date('u')|crc32 }}" media="screen,print" />
	<!--[if IE ]><link href="{{ asset('stylesheets/user/main-ie.css') }}" rel="stylesheet" type="text/css"><![endif]-->

	<script src="{{ asset('javascripts/DeskPRO/TouchCaller.js') }}" type="text/javascript"></script>
	<script src="{{ asset('javascripts/DeskPRO/WordHighlighter.js') }}" type="text/javascript"></script>
	<script src="{{ asset('javascripts/DeskPRO/User/WebsiteWidget/OverlayWin.js') }}" type="text/javascript"></script>

	<script type="text/javascript">
		var OverlayWin = new DeskPRO.User.WebsiteWidget.OverlayWin();
		$(document).ready(function() {
			OverlayWin.initPage();
		});
	</script>
</head>
<body id="dp_overlay">

<div id="left_pane">
	<div class="search-area">
		<input id="search_box" type="text" placeholder="Search for something..." />
		<span id="search_box_clear" style="display: none">x</span>
		<button id="search_box_go">Search</button>
	</div>
	<div class="list-area">
		<ul id="new_content_list">
			{% for content in newest_content %}
				<li class="{{ content.type }}">
					<a href="{{ content.item.getLink() }}" class="view-item">{{ content.item.title }}</a>
				</li>
			{% endfor %}
		</ul>
		<ul id="search_content_list" style="display: none"></ul>
	</div>
</div>
<div id="right_pane">
	<div class="head-area with-handler" data-element-handler="DeskPRO.ElementHandler.SimpleTabs">
		<ul id="dp_overlay_navtabs">
			<li data-tab-for="#newticket" class="on">Contact our agents</li>
			<li data-tab-for="#newfeedback">Submit feedback</li>
			<li data-tab-for="#newchat">Chat with us live</li>
		</ul>
	</div>
	<div class="body-area" id="right_pane_body">
		{################################################
		 # New Ticket
		 ################################################}

		<div id="newticket">
			<form action="{{ path('user_widget_newticket') }}" method="POST" id="dp_newticket_form" class="with-form-validator">
				{{ form_token('newticket_widget') }}
				<div class="form-row">
					<table cellspacing="0" cellpadding="0" width="98%"><tr><td width="50%" style="padding-right: 10px;">
						<div class="dp-form-row {% if error_fields['person.name'] %}dp-error{% endif %} dp-form-row-person_name">
							<div class="dp-form-label">
								<label>Your Name *</label>
							</div>
							<div class="dp-form-input">
								{{ form_widget(form.person.name, {
									'attr': {
										'data-field-validators': 'DeskPRO.Form.LengthValidator',
										'data-min-len': 2,
										'placeholder': 'Your Name'
									}
								}) }}
								<div class="dp-error-explain">
									Please enter your name
								</div>
							</div>
						</div>
					</td><td width="50%" style="padding-left: 10px;">
						<div class="dp-form-row dp-form-row-person_email">
							<div class="dp-form-label">
								<label>Your Email Address *</label>
							</div>
							<div class="dp-form-input">
								<input type="text" id="dp_newticket_email" name="newticket[person][email]" value="" placeholder="Your Email Address" data-field-validators="DeskPRO.Form.LengthValidator" data-min-len="4" />
								<div class="dp-error-explain">
									Please enter your name
								</div>
							</div>
						</div>
					</td></tr></table>
				</div>

				<div class="form-row">
					<table cellspacing="0" cellpadding="0" width="98%"><tr><td>
						{% include 'UserBundle:NewTicket:field-subject.html.twig' %}
					</td></tr></table>
				</div>

				<div class="form-row">
					<table cellspacing="0" cellpadding="0" width="98%"><tr><td>
						{% include 'UserBundle:NewTicket:field-department.html.twig' %}
					</td></tr></table>
				</div>

				<div class="form-row">
					<table cellspacing="0" cellpadding="0" width="98%"><tr><td>
						{% include 'UserBundle:NewTicket:field-message.html.twig' %}
					</td></tr></table>
				</div>

				<div class="form-row">
					<table cellspacing="0" cellpadding="0" width="98%"><tr><td>
						<button class="dp-button">Send Message</button>
					</td></tr></table>
				</div>
			</form>
			<div class="thank-you" id="dp_newticket_done" style="display: none">
				<h2>Thank you</h2>
				<p>Thank you for submitting your ticket. Our agents will get back to you as soon as they can.</p>
			</div>
		</div>


		{################################################
		 # New Feedback
		 ################################################}

		<div id="newfeedback">

		</div>

		{################################################
		 # New Chat
		 ################################################}

		<div id="newchat">

		</div>
	</div>
</div>

</body>
</html>
