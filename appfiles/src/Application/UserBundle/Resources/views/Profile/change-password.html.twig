{% extends 'UserBundle::layout.html.twig' %}
{% block content %}
	{% if invalid_current_password %}You entered your current password incorrectly{% endif %}
	{% if invalid_repeat_password %}You didn't enter the same password in both fields{% endif %}
		
	<form action="{{ path('user_profile_changepassword') }}" method="post">
		<input type="hidden" name="process" value="1" />
		Current password: <input type="password" name="current_password" value="" /><br />
		New password: <input type="password" name="password" value="" /><br />
		Repeat: <input type="password" name="password2" value="" /><br />
		<br />
		<input type="submit" value="Reset Password" />
	</form>
{% endblock %}