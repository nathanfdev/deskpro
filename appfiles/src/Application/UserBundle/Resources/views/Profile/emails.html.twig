{% extends 'UserBundle::layout.html.twig' %}
{% block content %}

<table cellspacing="0" cellpadding="0" width="100%">
	{% for email in app.user.emails %}
		<tr>
			<td>
				{{email.email}}
				{% if not email.is_validated %}
				<div style="float:right">
					This email is not validated yet. <a href="{{ path('user_profile_emails_validate', {'email_id': email.id}) }}">Validate it now</a>.
				</div>
				{% endif %}
			</td>
			<td><a href="{{ path('user_profile_emails_remove', {'email_id': email.id}) }}">remove</a></td>
			<td>
				{% if email.id == app.user.primary_email.id %}
					Default email
				{% else %}
					<a href="{{ path('user_profile_emails_setdefault', {'email_id': email.id}) }}">Set as default email</a>
				{% endif %}
			</td>
		</tr>
	{% endfor %}
	<tr><td colspan="3">
		<form action="{{ path('user_profile_emails_new') }}" method="post">
		New email address: <input type="text" name="new_email" value="" size="40" />
		<input type="submit" value="Save" />
		</form>
	</td></tr>
</table>

{% endblock %}