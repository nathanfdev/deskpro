{% extends 'UserBundle::layout.html.twig' %}
{% block head %}
<style type="text/css">
ul.attachment-list {
	margin-top: 10px;
	padding-top: 5px;
	border-top: 1px solid #C5CDD4;
	padding-left: 8px;

	background: #FFFFFF; /* old browsers */
	background: -moz-linear-gradient(top, #FFFFFF 0%, #F7F8F9 100%); /* firefox */
	background: -webkit-gradient(linear, left top, left bottom, color-stop(0%,#FFFFFF), color-stop(100%,#F7F8F9)); /* webkit */
	filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#FFFFFF', endColorstr='#F7F8F9',GradientType=0 ); /* ie */
}

ul.attachment-list > li {
	line-height: 18px;
	padding-top: 2px;
	padding-bottom: 2px;
}
ul.attachment-list > li span.size {
	font-size: 7pt;
	color: #5E5E5E;
}

ul.attachment-list > li img.preview {
	text-align: right;
	vertical-align: middle;
	margin-right: 6px;
}
</style>
{% endblock %}
{% block breadcrumb %}
	<li><a href="{{ path('user_tickets') }}">Tickets</a></li>
	<li><a href="{{ path('user_tickets_view', {'ticket_ref': ticket.public_id}) }}">{{ ticket.subject }}</a></li>
{% endblock %}
{% block content %}
<div class="content-item">
	<div class="heading">
		<h2>{{ ticket.subject }}</h2>
	</div>
	<div class="content-list" style="margin-bottom: 8px;">
		<div class="item def-list">
			<dl>
				<dt>{{ phrase('core_tickets.department') }}</dt>
				<dd>{{ phrase_object(ticket.department, 'full') }}</dd>

			{% if ticket.category %}
				<dt>{{ phrase('core_tickets.category') }}</dt>
				<dd>{{ phrase_object(ticket.category, 'full') }}</dd>
			{% endif %}

			{% if ticket.product %}
				<dt>{{ phrase('core_tickets.product') }}</dt>
				<dd>{{ phrase_object(ticket.product, 'full') }}</dd>
			{% endif %}

			{% if ticket.priority %}
				<dt>{{ phrase('core_tickets.priority') }}</dt>
				<dd>{{ phrase_object(ticket.priority) }}</dd>
			{% endif %}

				<dt>{{ phrase('core_tickets.status') }}</dt>
				<dd>{{ phrase('core_tickets.status_' ~ ticket.status) }}</dd>

				<dt>{{ phrase('core_tickets.agent') }}</dt>
				<dd>{{ ticket.agent.display_name|default(phrase('core.unassigned')) }}</dd>

				<dt>Ticket Starter</dt>
				<dd>{{ ticket.person.display_name }} &lt;{{ ticket.person.email_address }}&gt;</dd>

				{% if user_participants|length %}
					<dt>CCed</dt>
					<dd>
						<ul>
							{% for part in user_participants %}
								<li>
									{{ part.person.display_name }} &lt;{{ part.person.email_address }}&gt;
								</li>
							{% endfor %}
						</ul>
					</dd>
				{% endif %}
			</dl>
		</div>
	</div>

	{% if ticket.status == 'open' or ticket.status == 'pending' %}
	<div style="text-align: right; padding: 0 4px 6px 0;">
		<form action="{{ path('user_tickets_close', {'ticket_ref': ticket.ref}) }}" method="GET">
		<button class="cupid-green">Close this ticket</button>
		</form>
	</div>
	{% endif %}

	<div class="content-list">
		<ul class="comments">
			{% for message in messages %}
				<li {% if message.person.is_agent == 2 %}class="agent"{% endif %}>
					<div class="author-line">
						<div class="avatar" style="background-image: url('{{ message.person.getPictureUrl(30) }}');"></div>
						<h4><span {% if loop.index == 2 %}title="This person is a helpdesk agent"{% endif %}>{{ message.person.display_name|default('Anonymous') }} {% if not message.person.is_agent %} &lt;{{ message.person.email_address }}&gt;{% endif %}</span></h4>
						<div class="date">{{ message.date_created|date('M j, Y') }}</div>
					</div>
					<div class="message">
						{{ message.message_html|raw }}

						{% if message_to_attach[message.id] %}
							<ul class="attachment-list">
								{% for attach_id in message_to_attach[message.id] %}
									{% set ticket_attach = attachments[attach_id] %}
									<li class="{% if ticket_attach.blob.isImage() %}is-image{% else %}icon icon-attachment icon-filetype-{{ticket_attach.blob.extension|default('none')}}{% endif %}" rel="message-{{message.id}}">
										{% if ticket_attach.blob.isImage() %}
											<img src="{{ path('serve_blob', {'blob_auth_id': ticket_attach.blob.auth_id, 's': 50, 'size-fit': '1'}) }}" alt="" class="preview" />
										{% endif %}
										<a href="{{ ticket_attach.blob.download_url }}" target="_blank">{{ticket_attach.blob.filename}}</a>
										<span class="size">({{ ticket_attach.blob.readable_filesize }})</span>
									</li>
								{% endfor %}
							</ul>
						{%endif%}
					</div>
				</li>
			{% endfor %}

			{% if ticket.status == 'open' or ticket.status == 'pending' %}
			<li class="new-comment">
				<form action="{{ path('user_tickets_addreply', {'ticket_ref': ticket.ref}) }}" method="post" enctype="multipart/form-data">
				<div>
						{{ form_widget(newreply_form.message, {'attr': {'style': 'width: 90%; height: 100px;'}}) }}
						<br />
						Attach a file: {{ form_widget(newreply_form.new_upload) }}
						<input type="submit" value="Add Reply" />
				</div>
				{{ form_rest(newreply_form) }}
				</form>
			</li>
			{% else %}
				<li>
					This ticket has been closed. If you still need help, <a href="{{ path('user_tickets_new') }}">submit a new ticket</a>.
				</li>
			{% endif %}
		</ul>
	</div>
</div>
{% endblock %}