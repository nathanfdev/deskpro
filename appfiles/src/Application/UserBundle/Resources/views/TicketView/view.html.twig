{% extends 'UserBundle::layout.html.twig' %}
{% block head %}
<style type="text/css">
ul.attachment-list {
	margin-top: 10px;
	padding-top: 5px;
	border-top: 1px solid #C5CDD4;
	padding-left: 8px;

	background: #FFFFFF; /* old browsers */
	background: -moz-linear-gradient(top, #FFFFFF 0%, #F7F8F9 100%); /* firefox */
	background: -webkit-gradient(linear, left top, left bottom, color-stop(0%,#FFFFFF), color-stop(100%,#F7F8F9)); /* webkit */
	filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#FFFFFF', endColorstr='#F7F8F9',GradientType=0 ); /* ie */
}

ul.attachment-list > li {
	line-height: 18px;
	padding-top: 2px;
	padding-bottom: 2px;
}
ul.attachment-list > li span.size {
	font-size: 7pt;
	color: #5E5E5E;
}

ul.attachment-list > li img.preview {
	text-align: right;
	vertical-align: middle;
	margin-right: 6px;
}
</style>
{% endblock %}
{% block breadcrumb %}
	<li><a href="{{ path('user_tickets') }}">Tickets</a></li>
	<li><a href="{{ path('user_tickets_view', {'ticket_ref': ticket.public_id}) }}">{{ ticket.subject }}</a></li>
{% endblock %}
{% block content %}
<div class="dp-content-block dp-ticket-page">
	<div class="dp-box">
		<div class="dp-box-header">
			{% if ticket.status == 'open' or ticket.status == 'pending' %}
				<div class="dp-status dp-status-open">Open</div>
			{% elseif ticket.status == 'resolved' %}
				<div class="dp-status dp-status-resolved">Resolved</div>
			{% elseif ticket.status == 'closed' %}
				<div class="dp-status dp-status-closed">Closed</div>
			{% endif %}
			<h1>{{ ticket.subject }}</h1>
		</div>
		<div class="dp-box-content-wrapper">
			<div class="dp-box-content">
				{# Ticket Info #}
				<div class="dp-ticket-info">
					<dl>
						<dt>{{ phrase('user.department') }}</dt>
						<dd>{{ phrase_object(ticket.department, 'full') }}</dd>

					{% if ticket.category %}
						<dt>{{ phrase('user.tickets.category') }}</dt>
						<dd>{{ phrase_object(ticket.category, 'full') }}</dd>
					{% endif %}

					{% if ticket.product %}
						<dt>{{ phrase('user.product') }}</dt>
						<dd>{{ phrase_object(ticket.product, 'full') }}</dd>
					{% endif %}

					{% if ticket.priority %}
						<dt>{{ phrase('user.tickets.priority') }}</dt>
						<dd>{{ phrase_object(ticket.priority) }}</dd>
					{% endif %}

						{% if ticket.person.id != app.user.id %}
							<dt>Ticket Starter</dt>
							<dd>{{ ticket.person.display_name }} &lt;{{ ticket.person.email_address }}&gt;</dd>
						{% endif %}

						{% if user_participants|length %}
							<dt>CCed</dt>
							<dd>
								<ul>
									{% for part in user_participants %}
										<li>
											{{ part.person.display_name }} &lt;{{ part.person.email_address }}&gt;
										</li>
									{% endfor %}
								</ul>
							</dd>
						{% endif %}
					</dl>
				</div>
				{# /Ticket Info #}

				{# Messages #}
				<div class="dp-messages">
					<ul>
						{% for message in ticket.displayable_messages %}
							<li class="{% if message.person.is_agent %}agent-reply{% endif %}">
								<div class="author">
									{% if message.person %}
										<img src="{{ message.person.getPictureUrl(60) }}" /><br />
									{% endif %}
									<strong>{{ message.person.display_name }}</strong>
								</div>
								<div class="post">
									<div class="dp-date">{{ message.date_created|date('M j Y h:ia') }}</div>
									{{ message.message_html|raw }}

									{% if ticket_message_attachments[message.id] %}
										<ul class="attachment-list">
											{% for attach_id in ticket_message_attachments[message.id] %}
												{% set ticket_attach = ticket_attachments[attach_id] %}
												<li class="{% if ticket_attach.blob.isImage() %}is-image{% else %}icon icon-attachment icon-filetype-{{ticket_attach.blob.extension|default('none')}}{% endif %}" rel="message-{{message.id}}">
													{% if ticket_attach.blob.isImage() %}
														<img src="{{ path('serve_blob', {'blob_auth_id': ticket_attach.blob.auth_id, 's': 50, 'size-fit': '1'}) }}" alt="" class="preview" />
													{% endif %}
													<a href="{{ ticket_attach.blob.download_url }}" target="_blank">{{ticket_attach.blob.filename}}</a>
													<span class="size">({{ ticket_attach.blob.readable_filesize }})</span>
												</li>
											{% endfor %}
										</ul>
									{%endif%}
								</div>
								{% if message.person.is_agent %}
									<div class="feedback-link">
										<a class="helpful" href="{{ path('user_tickets_feedback', {'ticket_ref': ticket.ref, 'message_id': message.id, 'rating': 1 }) }}">Helpful</a>
										<a class="not-helpful" href="{{ path('user_tickets_feedback', {'ticket_ref': ticket.ref, 'message_id': message.id, 'rating': -1 }) }}">Not Helpful</a>
									</div>
								{% endif %}
								<br class="dp-clear" style="clear:left" />
							</li>
						{% endfor %}

						{# New Reply #}
						<li class="new-reply">
							<div class="dp-form">
								<form action="{{ form_action }}" method="post">
									<div class="dp-form">
										<div class="dp-form-row">
											<div class="dp-form-label">
												<label>Add Reply</label>
											</div>
											<div class="dp-form-input">
												<textarea name="newreply[message]" cols="120" rows="5" placeholder="Type your reply here..."></textarea>
											</div>
										</div>
									</div>

									<div class="dp-form-row">
										<div class="dp-form-label">
											<label>Attachments</label> <em class="desc">You may upload an attachment less than 5 MB</em>
										</div>
										<div class="dp-form-input">
											{% include 'UserBundle:Common:form-upload-input.html.twig' %}
										</div>
									</div>

									<button class="btn primary" style="margin-top: 10px;">Submit Reply</button>
								</form>
							</div>
						</li>
						{# /New Reply #}
					</ul>
					{# /Messages #}
				</div>
			</div>
		</div>
	</div>
</div>

