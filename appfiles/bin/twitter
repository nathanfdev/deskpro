#!/usr/bin/env php
<?php

define('DP_ROOT', realpath(__DIR__ . '/../'));
require_once DP_ROOT.'/sys/autoload.php';
require_once DP_ROOT.'/config.php';

$env = 'dev';
if (isset($_SERVER['argv'][1])) {
	$env = trim($_SERVER['argv'][1]);
}

use Doctrine\ORM\EntityManager,
    Doctrine\ORM\Configuration;

$connectionOptions = $CONFIG['db'];

$cacheImpl = new \Doctrine\Common\Cache\ArrayCache;

$annotReader = new \Doctrine\Common\Annotations\AnnotationReader();
$annotReader->setAnnotationNamespaceAlias('Doctrine\\ORM\\Mapping\\', 'orm');

$driverImpl = new \Doctrine\ORM\Mapping\Driver\DriverChain();
$driverImpl->addDriver(new \Doctrine\ORM\Mapping\Driver\AnnotationDriver($annotReader, array(0 => DP_ROOT.'/appfiles/src/Application/DeskPRO/Entity')), 'Application\\DeskPRO\\Entity');

$config = new Configuration;
$config->setMetadataCacheImpl($cacheImpl);
$config->setQueryCacheImpl($cacheImpl);
$config->setMetadataDriverImpl($driverImpl);
$config->setEntityNamespaces(array('DeskPRO' => 'Application\\DeskPRO\\Entity'));
$config->setProxyDir(DP_ROOT.'/sys/cache/'.$env.'/doctrine/orm/Proxies');
$config->setProxyNamespace('Proxies');
$config->setAutoGenerateProxyClasses(true);
$config->setClassMetadataFactoryName('Doctrine\\ORM\\Mapping\\ClassMetadataFactory');

$em = EntityManager::create($connectionOptions, $config);

use Application\DeskPRO\Entity\TwitterStatus;
use Application\DeskPRO\Entity\TwitterStatusMention;
use Application\DeskPRO\Entity\TwitterStatusTag;
use Application\DeskPRO\Entity\TwitterStatusUrl;
use Application\DeskPRO\Entity\TwitterUser;

/**
 * Concrete Twitter API User Stream consuming class.
 *
 * @author Pierre Minnieur <pm@pierre-minnieur.de>
 */
class UserStreamConsumer extends \UserstreamPhirehose
{
	/**
	 * @var \Doctrine\ORM\EntityManager
	 */
	protected $em;

	/**
	 * @var array
	 */
	protected $log = array();

	/**
	 * Suppress Phirehose @error_log output.
	 *
	 * @param string $message
	 * @return void
	 */
	protected function log($message)
	{
		$this->log[] = $message;
	}

	/**
	 * Retrieve the Doctrine EntityManager instance.
	 *
	 * @return \Doctrine\ORM\EntityManager
	 */
	public function getEntityManager()
	{
		return $this->em;
	}

	/**
	 * Inject the Doctrine EntityManager instance.
	 *
	 * @param \Doctrine\ORM\EntityManager $em
	 * @return void
	 */
	public function setEntityManager(\Doctrine\ORM\EntityManager $em)
	{
		$this->em = $em;
	}

	/**
	 * Process raw streaming data.
	 *
	 * @param string $status
	 * @return void
	 */
	public function enqueueStatus($status) {
		// skip "ping -> pong"
		$status = trim($status);
		if (!strlen($status)) {
			return;
		}

		// decode json
		$status = json_decode($status, true);

		// check if status is a tweet
		if (isset($status['text'])) {
			echo 'TWEET ADDED W/ ID: '.$status['id_str'].PHP_EOL;
			return $this->processStatus($status);
		}

		// check friend list
		if (isset($status['friends'])) {
			return $this->processFriends($status['friends']);
		}

		if (isset($status['delete'])) {
			return $this->processDeletion($status['delete']);
		}

		// @TODO add elsewhat handling
		echo 'SOMETHING ELSE, LOOK:'.PHP_EOL;
		print_r($status); echo PHP_EOL.PHP_EOL;
	}

	/**
	 * Process a new Twitter status.
	 *
	 * @param array $tweet The Twitter status
	 * @return void
	 */
	protected function processStatus(array $tweet)
	{
		// check if Twitter status exists
		if ($this->em->getRepository('DeskPRO:TwitterStatus')->find($tweet['id_str'])) {
			return true;
		}

		// fetch Twitter user
		$user = $this->getUser($tweet['user']);

		// create Twitter status
		$status                 = new TwitterStatus();
		$status['id']           = $tweet['id_str'];
		$status['user']         = $user;
		$status['text']         = $tweet['text'];
		$status['is_truncated'] = $tweet['truncated'];
		$status['is_favorited'] = $tweet['favorited'];
		$status['is_archived']  = false;
		$status['date_created'] = new \DateTime($tweet['created_at']);
		$status['source']       = $tweet['source'];

		// @TODO add geo informations
		// $status['geo_latitude'] = $tweet['geo'][];
		// $status['geo_longitude'] = $tweet['geo'][];

		// persist entity
		$this->em->persist($status);

		// flush changes
		$this->em->flush();

		// @TODO add in_reply_* handling

		// fetch urls
		foreach ($tweet['entities']['urls'] as $url) {
			$this->processUrl($status, $url);
		}

		// flush changes
		$this->em->flush();

		// fetch hashtags
		foreach ($tweet['entities']['hashtags'] as $hashtag) {
			$this->processHashtag($status, $hashtag);
		}

		// flush changes
		$this->em->flush();

		// fetch mentions
		foreach ($tweet['entities']['user_mentions'] as $mention) {
			$this->processMention($status, $mention);
		}

		// flush changes
		$this->em->flush();
	}

	/**
	 * @param \Application\DeskPRO\Entity\TwitterStatus $status
	 * @param array $url
	 * @return \Application\DeskPRO\Entity\TwitterStatusUrl
	 */
	protected function processUrl(TwitterStatus $status, array $url)
	{
		$entity           = new TwitterStatusUrl();
		$entity['status'] = $status;
		$entity['url']    = $url['url'];
		$entity['starts'] = $url['indices'][0];
		$entity['ends']   = $url['indices'][1];

		$this->em->persist($entity);

		return $entity;
	}

	/**
	 * @param \Application\DeskPRO\Entity\TwitterStatus $status
	 * @param array $hashtag
	 * @return \Application\DeskPRO\Entity\TwitterStatusTag
	 */
	protected function processTag(TwitterStatus $status, array $tag)
	{
		$entity           = new TwitterStatusTag();
		$entity['status'] = $status;
		$entity['hash']   = $tag['text'];
		$entity['starts'] = $tag['indices'][0];
		$entity['ends']   = $tag['indices'][1];

		$this->em->persist($entity);

		return $entity;
	}

	/**
	 * @param \Application\DeskPRO\Entity\TwitterStatus $status
	 * @param array $hashtag
	 * @return \Application\DeskPRO\Entity\TwitterStatusMention
	 */
	protected function processMention(TwitterStatus $status, array $mention)
	{
		$entity = new TwitterStatusMention();
		$entity['status'] = $status;

		// @TODO check if Twitter user exists
		$entity->setUserId($mention['id_str']);

		$entity['starts'] = $mention['indices'][0];
		$entity['ends']   = $mention['indices'][1];

		$this->em->persist($entity);

		return $entity;
	}

	/**
	 * Retrieve (and create, if needed) a Twitter user.
	 *
	 * @param array $user An array of Twitter user data
	 * @return \Application\DeskPRO\Entity\TwitterUser
	 */
	protected function getUser(array $user)
	{
		// check if Twitter user exists
		$entity = $this->em->getRepository('DeskPRO:TwitterUser')->find($user['id_str']);
		if ($entity) {
			return $entity;
		}

		// create Twitter user
		$entity                      = new TwitterUser();
		$entity['id']                = $user['id_str'];
		$entity['name']              = $user['name'];
		$entity['screen_name']       = $user['screen_name'];
		$entity['profile_image_url'] = $user['profile_image_url'];
		$entity['language']          = $user['lang'];
		$entity['is_protected']      = $user['protected'];
		$entity['is_verified']       = $user['verified'];
		$entity['location']          = $user['location'];
		$entity['is_geo_enabled']    = $user['geo_enabled'];

		// persist entity
		$this->em->persist($entity);

		// flush changes
		$this->em->flush();

		return $entity;
	}

	/**
	 * Process friend list (list of Twitter users following).
	 *
	 * @param array $friendIds List of Twitter users following
	 * @return void
	 */
	protected function processFriends(array $friendIds)
	{

	}


	/**
	 * Process a deletion.
	 *
	 * @param array $deletion Data of deletion
	 * @return Boolean
	 */
	protected function processDeletion(array $deletion)
	{
		// delete a Twitter status
		if (isset($deletion['status'])) {
			$status = $this->em->getRepository('DeskPRO:TwitterStatus')
				->find($deletion['status']['id_str']);

			$this->em->delete($status);
			$this->em->flush();

			return true;
		}
	}
}

// @TODO make configurable
define('TWITTER_CONSUMER_KEY',    '8F0tLXjdjVDDsovNjWJw');
define('TWITTER_CONSUMER_SECRET', '2naz7yxp6TBnEXwP9EnzLC0WU2Vwg60vm17tMntOo');

// fork process for each Twitter account
foreach ($em->getRepository('DeskPRO:TwitterAccount')->findAll() as $account) {
	// fork process
	$pid = pcntl_fork();

	/**
	 * FAILURE
	 */
	if (-1 === $pid) {
		throw new \Exception(sprintf('Forking for account "%s" failed', $account['id']));

	/**
	 * PARENT
	 */
	} else if (0 < $pid) {
		// @TODO add inter process communication
		pcntl_wait($status);

	/**
	 * CHILD
	 */
	} else {
		// initialize User Stream consumer
		$stream = new UserStreamConsumer($account['oauth_token'], $account['oauth_token_secret']);
		$stream->setEntityManager($em);

		// start consuming
		$stream->consume();

		// @TODO add inter process communication
	}
}
