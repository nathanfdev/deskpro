#!/usr/bin/env php
<?php

define('DP_ROOT', realpath(__DIR__ . '/../'));
require_once DP_ROOT.'/sys/autoload.php';
require_once DP_ROOT.'/config.php';

$env = 'dev';
if (isset($_SERVER['argv'][1])) {
	$env = trim($_SERVER['argv'][1]);
}

$connectionOptions = $CONFIG['db'];

$cacheImpl = new \Doctrine\Common\Cache\ArrayCache;

$annotReader = new \Doctrine\Common\Annotations\AnnotationReader();
$annotReader->setAnnotationNamespaceAlias('Doctrine\\ORM\\Mapping\\', 'orm');

$driverImpl = new \Doctrine\ORM\Mapping\Driver\DriverChain();
$driverImpl->addDriver(new \Doctrine\ORM\Mapping\Driver\AnnotationDriver($annotReader, array(0 => DP_ROOT.'/appfiles/src/Application/DeskPRO/Entity')), 'Application\\DeskPRO\\Entity');

$config = new \Doctrine\ORM\Configuration;
$config->setMetadataCacheImpl($cacheImpl);
$config->setQueryCacheImpl($cacheImpl);
$config->setMetadataDriverImpl($driverImpl);
$config->setEntityNamespaces(array('DeskPRO' => 'Application\\DeskPRO\\Entity'));
$config->setProxyDir(DP_ROOT.'/sys/cache/'.$env.'/doctrine/orm/Proxies');
$config->setProxyNamespace('Proxies');
$config->setAutoGenerateProxyClasses(true);
$config->setClassMetadataFactoryName('Doctrine\\ORM\\Mapping\\ClassMetadataFactory');

$em = \Doctrine\ORM\EntityManager::create($connectionOptions, $config);

define('TWITTER_CONSUMER_KEY',    \Orb\Service\Twitter\Oauth::getConsumerKey());
define('TWITTER_CONSUMER_SECRET', \Orb\Service\Twitter\Oauth::getConsumerSecret());

// fork process for each Twitter account
foreach ($em->getRepository('DeskPRO:TwitterAccount')->findAll() as $account) {
	// fork process
	$pid = pcntl_fork();

	/**
	 * FAILURE
	 */
	if (-1 === $pid) {
		throw new \Exception(sprintf('Forking for account "%s" failed', $account['id']));

	/**
	 * PARENT
	 */
	} else if (0 < $pid) {
		// @TODO add inter process communication
		pcntl_wait($status);

	/**
	 * CHILD
	 */
	} else {
		// initialize User Stream consumer
		$consumer = new \Orb\Service\Phirehose\Consumer\UserStream($account['oauth_token'], $account['oauth_token_secret']);
		$consumer->setEntityManager($em);

		// start consuming
		$consumer->consume();

		// @TODO add inter process communication
	}
}
